						"pointId": 6766
					},
					{
						"sceneId": 3,
						"position": [
							2569.368,
							-76.1,
							3382.662
						],
						"pointId": 6767
					}
				]
			},
			"dialogs": [
				{
					"id": 741650201,
					"content": "Không thể nào... Rõ ràng ta đã đạt đến cảnh giới \"Không Lùi Bước\". Tại sao lại bị giáng xuống cảnh giới này?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650202
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650202,
					"content": "Ta cũng không thể khống chế được Biển Khởi Nguyên nữa rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650203
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650203,
					"content": "Tại sao, tại sao lại như thế? Tại sao các người lại làm như vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650204
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650204,
					"content": "Thế giới mới không thể ra đời, tất cả mọi người đều phải chết trong lớp vỏ của giấc mơ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650205
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650205,
					"content": "Ngươi mới là người cần phải tỉnh khỏi giấc mơ của mình đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650206,
					"content": "Chuyện tận thế tất nhiên là cần mọi người trên toàn thế giới nghĩ cách với nhau rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650207,
					"content": "Ta hiểu rồi, là do Thánh Kiếm. Nó không đứng về phía ta. Mỗi lần nó ra tay đều cắt bớt ý chí chúng sinh quanh người của ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650208
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650208,
					"content": "Mãi cho đến cuối cùng, nhân tính phàm trần yếu ớt của ta... đã quay trở về bản thể.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650209,
						741650215
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650209,
					"content": "Biển Khởi Nguyên sẽ không lan tràn nhanh đến thế đâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741650210
					]
				},
				{
					"id": 741650210,
					"content": "Ta đã phát hiện ra điều đó từ sớm, giá trị điền vào \"mô thức thế giới\" đầu tiên đã thay đổi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650211
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650211,
					"content": "Có ai đó đã điều khiển sức mạnh sinh mạng, lại có ai đó đã mở ra vương quốc của thú.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650212
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650212,
					"content": "Còn có một \"biến số\", đó chính là ngươi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650213
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650213,
					"content": "Người mà sẽ chứng kiến tất cả, chứng kiến con cá voi nuốt chửng tất cả bị đánh bại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650214
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650214,
					"content": "Hóa ra là vậy, hóa ra là như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650221
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650221,
					"content": "Ta cũng từng mơ giấc mơ như thế, muốn trở thành người như thế. Thế nhưng giấc mơ đó vừa vỡ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650222
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650222,
					"content": "Tất cả những gì ta làm đều không có ý nghĩa, chỉ như một giấc mơ trống rỗng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650223
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650223,
					"content": "Không, thậm chí còn không bằng một giấc mộng. Ít ra giấc mộng không có hại, còn ta... Không, các người, còn họ nữa, đều đã phải hy sinh rất nhiều vì chuyện này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650224
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650224,
					"content": "Narzissenkreuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650225
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650225,
					"content": "Ồ, là cô sao. Ta không phát hiện ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650226
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650226,
					"content": "Anh có biết rốt cuộc tôi là ai không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650227
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650227,
					"content": "Tên chỉ dùng để xưng hô thôi. Trong linh hồn của cô có hai màu sắc, tôi đều quen với cả hai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650228
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650228,
					"content": "Viện trưởng Lyris không biết đã xảy ra chuyện gì, cô ấy ôm lấy Mary-Ann đến hơi thở cuối cùng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650229
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650229,
					"content": "Cô ấy không thể hiểu được hiện tại và tương lai quá mức phức tạp, chỉ muốn giữ lại quá khứ. Vì vậy, cô ấy làm việc mà mình giỏi nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650230
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650230,
					"content": "Tôi tên là Ann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650231
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650231,
					"content": "Vậy thì chào cô, Ann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650232
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650232,
					"content": "Tôi bằng lòng tha thứ cho anh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650233
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650233,
					"content": "Cô đang nói gì thế? Ngay từ đầu kế hoạch của ta đã mang mục đích cao thượng như thánh thần, không hề có ý riêng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650234
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650234,
					"content": "Không ai có thể đánh giá ta, phán xét ta, hay là tha thứ cho ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650235
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650235,
					"content": "Có lẽ mục đích của anh rất cao thượng, nhưng sự điên cuồng của anh đã làm tổn thương đến rất nhiều người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650236
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650236,
					"content": "Đến cả biểu thức số học còn điền sai, vậy thì sẽ có vấn đề gì khi được tha thứ lúc phạm sai lầm chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650237
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650237,
					"content": "...Cô nói đúng, tôi xin lỗi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650238
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650238,
					"content": "Vậy thì quay về cùng chúng tôi đi, Narzissenkreuz. Anh cần phải gặp những người khác nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650239
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650239,
					"content": "Tuy tên này đã trở nên dịu lại, nhưng yêu cầu này có hơi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650240
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650240,
					"content": "Không thành vấn đề.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650241
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650241,
					"content": "Ơ! Bình thường người ta phải đấu tranh tâm lý hồi lâu, xong đợi chúng tôi khuyên can nữa mới đúng chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650242
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650242,
					"content": "Cũng như những gì ta đã nói, ta không hề cảm thấy tội lỗi. Tuy đại nghiệp đã thất bại, nhưng thế giới vẫn được cứu rỗi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650243
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650243,
					"content": "Cứ mặc cho người khác quở trách và cười nhạo ta đi. Trong lòng ta giờ đã trống trải, chỉ còn lại một khát vọng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650244
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650244,
					"content": "Là cái gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650245
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650245,
					"content": "Ta muốn quay lại thuở ban đầu, khi các dũng sĩ Narzissenkreuz vẫn chưa bước lên con đường ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650246
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650246,
					"content": "Thế nhưng đã không thể làm được, thứ quyết định vận mệnh con người chẳng bao giờ là chính họ. Giờ ta đã mất cả khả năng điều khiển giấc mơ của bản thân rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650247
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650247,
					"content": "#Được rồi, kỵ sĩ {NICKNAME}, sau khi chuẩn bị sẵn sàng thì chúng ta sẽ phong ấn vùng biển này và rời khỏi đây thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650215,
					"content": "Con cá voi đó đã bị đánh bại rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741650216
					]
				},
				{
					"id": 741650216,
					"content": "Ta vốn nên nhận ra rằng, giá trị đầu vào của \"mô thức thế giới\" ban đầu đã thay đổi. Một \"biến số\" đã giáng xuống đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650217
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650217,
					"content": "Không phải mọi thứ đến từ bên ngoài vũ trụ đều có thể được gọi là \"giáng lâm\" hay \"biến số\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650218
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650218,
					"content": "Hóa ra ta đã tính sót một \"biến số\", đó chính là ngươi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650219
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650219,
					"content": "Người chứng kiến, người ghi chép, người thiết kế tất cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650220
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650220,
					"content": "Chỉ có người ngang hàng với cả một thế giới mới gánh vác được danh hiệu này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650221
					],
					"speakerTitle": "Narzissenkreuz"
				}
			]
		},
		{
