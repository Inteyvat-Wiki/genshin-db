			"dialogs": [
				{
					"id": 741650301,
					"content": "Không thể nào... Rõ ràng ta đã đạt đến cảnh giới \"Không Lùi Bước\". Tại sao lại bị giáng xuống cảnh giới này?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650302
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650302,
					"content": "Ta cũng không thể khống chế được Biển Khởi Nguyên nữa rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650303
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650303,
					"content": "Tại sao, tại sao lại như thế? Tại sao các người lại làm như vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650304
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650304,
					"content": "Thế giới mới không thể ra đời, tất cả mọi người đều phải chết trong lớp vỏ của giấc mơ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650305
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650305,
					"content": "Ngươi mới là người cần phải tỉnh khỏi giấc mơ của mình đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650306,
					"content": "Chuyện tận thế tất nhiên là cần mọi người trên toàn thế giới nghĩ cách với nhau rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650307,
					"content": "Ta hiểu rồi, là do Thánh Kiếm. Nó không đứng về phía ta. Mỗi lần nó ra tay đều cắt bớt ý chí chúng sinh quanh người của ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650308
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650308,
					"content": "Mãi cho đến cuối cùng, nhân tính phàm trần yếu ớt của ta... đã quay trở về bản thể.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650309
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650309,
					"content": "Biển Khởi Nguyên sẽ không lan tràn nhanh đến thế đâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741650310
					]
				},
				{
					"id": 741650310,
					"content": "Ta đã phát hiện ra điều đó từ sớm, giá trị điền vào \"mô thức thế giới\" đầu tiên đã thay đổi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650311
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650311,
					"content": "Có ai đó đã điều khiển sức mạnh sinh mạng, lại có ai đó đã mở ra vương quốc của thú.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650312
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650312,
					"content": "Còn có một \"biến số\", đó chính là ngươi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650313
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650313,
					"content": "Người mà sẽ chứng kiến tất cả, chứng kiến con cá voi nuốt chửng tất cả bị đánh bại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650314
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650314,
					"content": "Hóa ra là vậy, hóa ra là như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650315
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650315,
					"content": "Ta cũng từng mơ giấc mơ như thế, muốn trở thành người như thế. Thế nhưng giấc mơ đó vừa vỡ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650316
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650316,
					"content": "Tất cả những gì ta làm đều không có ý nghĩa, chỉ như một giấc mơ trống rỗng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650317
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650317,
					"content": "Không, thậm chí còn không bằng một giấc mộng. Ít ra giấc mộng không có hại, còn ta... Không, các người, còn họ nữa, đều đã phải hy sinh rất nhiều vì chuyện này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650318
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650318,
					"content": "Narzissenkreuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650319
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650319,
					"content": "Ồ, là cô sao. Ta không phát hiện ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650320
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650320,
					"content": "Anh có biết rốt cuộc tôi là ai không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650321
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650321,
					"content": "Tên chỉ dùng để xưng hô thôi. Trong linh hồn của cô có hai màu sắc, tôi đều quen với cả hai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650322
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650322,
					"content": "Viện trưởng Lyris không biết đã xảy ra chuyện gì, cô ấy ôm lấy Mary-Ann đến hơi thở cuối cùng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650323
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650323,
					"content": "Cô ấy không thể hiểu được hiện tại và tương lai quá mức phức tạp, chỉ muốn giữ lại quá khứ. Vì vậy, cô ấy làm việc mà mình giỏi nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650324
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650324,
					"content": "Tôi tên là Ann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650325
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650325,
					"content": "Vậy thì chào cô, Ann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650326
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650326,
					"content": "Tôi bằng lòng tha thứ cho anh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650327
					],
					"speakerTitle": "Ann"
				},
