			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Kaji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721330101,
					"content": "Xin chào! Xin lỗi đã làm phiền. Hy vọng bạn có thể nghe tôi nói.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330102
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721330102,
					"content": "Sao rồi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721330103
					]
				},
				{
					"id": 721330103,
					"content": "Đừng ở lại trên hòn đảo này quá lâu, dạo gần đây phạm vi khuếch tán của Họa Thần ngày càng rộng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330104
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721330104,
					"content": "Họa Thần?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721330105
					]
				},
				{
					"id": 721330105,
					"content": "Đúng vậy, từ khi người của Quân Sangonomiya đến đây phá hủy vật trấn giữ hồn phách Thần Rắn trên đảo, Họa Thần đã khuếch tán khắp nơi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330106
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721330106,
					"content": "Như bạn thấy đó, mây đen che kín trời, mưa không ngớt, đều là do Họa Thần gây ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330107
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721330107,
					"content": "Thời gian này, các thợ mỏ hết người này đến người khác đổ bệnh, mất đi lý trí, phải chạy sang các đảo khác...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330108
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721330108,
					"content": "Mọi người đều đi hết, trên đảo chẳng còn ai cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330109
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721330109,
					"content": "Nhưng trớ trêu là nhờ Họa Thần làm loạn mà Shogunate và phản quân không còn liều mạng đấu đá như trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330110
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721330110,
					"content": "Hừm, nếu không vì bọn họ đánh nhau làm hỏng vật trấn giữ của Ogosho điện hạ thì hòn đảo đâu ra nông nỗi này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330111
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721330111,
					"content": "Nào là hiệp hội, nào là rồng rắn, có liên quan gì đến tôi chứ! Bọn họ đánh nhau cũng chưa từng hỏi ý kiến của tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330112
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721330112,
					"content": "Bạn còn ở lại đây làm gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721330113
					]
				},
				{
					"id": 721330113,
					"content": "Làm gì? Đây là nhà của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330114
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721330114,
					"content": "Người nhà của bạn đâu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721330115
					]
				},
				{
					"id": 721330115,
					"content": "Ở một nơi an toàn, cảm ơn bạn đã quan tâm. Họ cũng đang chờ tôi đón họ trở về.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330116
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721330116,
					"content": "Không ai muốn rời khỏi hòn đảo này. Chúng tôi là người một nhà, đi nơi khác chỉ có thể làm thuê cho người khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330117
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721330117,
					"content": "Cho nên phải có người ở lại, nghĩ cách dọn dẹp sạch sẽ nơi này, để họ có nhà để về.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330118
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721330118,
					"content": "Haiz, đúng là đau đầu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330119
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721330119,
					"content": "Tôi có thể giúp được gì không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721330120
					]
				},
				{
					"id": 721330120,
					"content": "Nếu là người khác đường đột yêu cầu giúp đỡ, có lẽ tôi sẽ bật cười thành tiếng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330121
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721330121,
					"content": "Nhưng bạn là người ngoại quốc, lại có thể vào sâu trong Inazuma như vậy, cũng không giống người không có bản lĩnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330122
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721330122,
					"content": "Tôi nói thẳng, vật trấn giữ kia làm phiền tôi rất lâu rồi, hy vọng bạn có thể giúp tôi tìm cách sửa nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330123
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721330123,
					"content": "Không khí ở đây quá tệ, chắc là do vật trấn giữ bị phá hủy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330124
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721330124,
					"content": "Nhưng khi đến gần vật trấn giữ phải thật cẩn thận, nếu nhìn chằm chằm vào nó, nó sẽ phóng ra một luồng năng lượng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330125
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721330125,
					"content": "Mặc dù vô hại nhưng nó lại khiến người ta cảm thấy khó chịu, giống như...nó đang đẩy bạn ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330126
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721330126,
					"content": "Hình như vật trấn giữ bị thiếu bộ phận nào đó, có lẽ lắp vào là có thể sửa được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330127
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721330127,
					"content": "Đương nhiên đây chỉ là suy đoán của tôi, đến bây giờ tôi còn chưa biết rốt cuộc nó bị lỗi chỗ nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330128
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721330128,
					"content": "Vì vậy nếu bạn muốn giúp, thì nhờ bạn sửa vật trấn giữ này trước vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330129
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721330129,
					"content": "Nhưng vẫn câu nói cũ, nếu bạn cũng không thể sửa được thì đừng nên ở lại đây lâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaji"
				}
			]
		}
	]
}