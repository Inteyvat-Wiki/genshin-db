							"2"
						],
						"stepId": 7217602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tiểu Đệ Kujirai",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721760202,
					"content": "Ây, khó quá sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760203
					],
					"speakerTitle": "Tiểu Đệ Kujirai"
				},
				{
					"id": 721760203,
					"content": "Vừa nãy chỉ là trạng thái không tốt lắm thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760204,
					"content": "Mọi người có muốn thử lại không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760205
					],
					"speakerTitle": "Tiểu Đệ Kujirai"
				},
				{
					"id": 721760205,
					"content": "#Đương nhiên rồi! {NICKNAME}, chúng ta phải để Tiểu Đệ Kujirai biết sự lợi hại của mình chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760206,
					"content": "Làm lại nào!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760207
					]
				},
				{
					"id": 721760207,
					"content": "Được thôi! Mục tiêu là tìm thấy Temari trong thời gian quy định!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tiểu Đệ Kujirai"
				}
			]
		},
		{
			"id": 7217607,
			"completionStepIds": [
				7217605
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7217605",
							"2"
						],
						"stepId": 7217605,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tiểu Đệ Kujirai",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721760702,
					"content": "Thật lợi hại, nhanh như vậy đã tìm ra rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760703
					],
					"speakerTitle": "Tiểu Đệ Kujirai"
				},
				{
					"id": 721760703,
					"content": "#Hơ hơ, {NICKNAME} là Nhà Lữ Hành đã trải qua bao nhiêu trận chiến, đi qua bao nhiêu quốc gia đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760704,
					"content": "Wa! Chẳng lẽ, Mondstadt cũng đã từng đi qua sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760705
					],
					"speakerTitle": "Tiểu Đệ Kujirai"
				},
				{
					"id": 721760705,
					"content": "Đương nhiên.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760706
					]
				},
				{
					"id": 721760706,
					"content": "Thật lợi hại! Em nghe chị đó nói rằng, Mondstadt có rất nhiều cảnh đẹp, giống như Di Tích Dvalin thật cao thật cao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760707,
						721760708
					],
					"speakerTitle": "Tiểu Đệ Kujirai"
				},
				{
					"id": 721760707,
					"content": "Là Phế Tích Phong Long.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760709
					]
				},
				{
					"id": 721760709,
					"content": "Ừm, không biết là ngọn tháp đó cao, hay là Thiên Thủ của tướng quân đại nhân cao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760710
					],
					"speakerTitle": "Tiểu Đệ Kujirai"
				},
				{
					"id": 721760710,
					"content": "Tiểu Đệ Kujirai, tại sao em lại ở một mình ngoài thành?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760711,
					"content": "Bởi vì lúc chị em đi bắt cá, trách em làm cá sợ chạy mất, nên để em tự đi chơi một mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760712
					],
					"speakerTitle": "Tiểu Đệ Kujirai"
				},
				{
					"id": 721760712,
					"content": "Có lần, em gặp Nhà Mạo Hiểm đó. Chị ấy thấy em buồn quá, nên tặng rất nhiều Temari, để em tìm \"Nhà Lữ Hành có lòng tham\" để chơi cùng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760713
					],
					"speakerTitle": "Tiểu Đệ Kujirai"
				},
				{
					"id": 721760713,
					"content": "Nhà Lữ Hành có lòng tham...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760714
					]
				},
				{
					"id": 721760714,
					"content": "Đâu phải là lòng tham! Mà là lo lắng! Lo lắng Tiểu Đệ Kujirai chơi một mình sẽ buồn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760715
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760715,
					"content": "Đúng vậy, em cũng cảm thấy mọi người rất tốt bụng, em cũng rất vui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760716
					],
					"speakerTitle": "Tiểu Đệ Kujirai"
				},
				{
					"id": 721760716,
					"content": "Một mình ở vùng ngoại ô...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760717
					]
				},
				{
					"id": 721760717,
					"content": "Một đứa trẻ như em ở nơi hoang dã này, không sợ gặp nguy hiểm sao? Mà em còn đem theo đồ tốt ở trên người nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760718,
					"content": "Mọi người thật tốt bụng. Nhưng xin đừng lo lắng, Nhà Mạo Hiểm đó có dạy em, chỉ cần thao tác đặc biệt một chút, là Temari sẽ biến thành bom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760719
					],
					"speakerTitle": "Tiểu Đệ Kujirai"
				},
				{
					"id": 721760719,
					"content": "Nguy hiểm quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760720
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760720,
					"content": "Không nguy hiểm đâu! Hilichurl nè, Slime nè, kẻ xấu nè, em đều cho nổ sợ chạy hết rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760721
					],
					"speakerTitle": "Tiểu Đệ Kujirai"
				},
				{
					"id": 721760721,
					"content": "Là nguy hiểm cho em đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760722
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760722,
					"content": "Đúng rồi, nếu mọi người muốn chơi Temari với bạn bè...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760723
					],
					"speakerTitle": "Tiểu Đệ Kujirai"
				},
				{
					"id": 721760723,
					"content": "Em sẽ để lại một Temari ở đây! Quy tắc của nó là vầy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760724
					],
					"speakerTitle": "Tiểu Đệ Kujirai"
				},
				{
					"id": 721760724,
					"content": "Khi giấu Temari, phải giấu xong trong thời gian một bài hát. Người đi tìm, cũng phải tìm thấy trong thời gian một bài hát. Như vậy mới công bằng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760725
					],
					"speakerTitle": "Tiểu Đệ Kujirai"
				},
				{
					"id": 721760725,
					"content": "Hiểu rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760726
					]
				},
				{
					"id": 721760726,
					"content": "Cứ nghĩ tới việc chúng ta đang chơi với một quả bom, cảm giác thật đáng sợ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760727,
					"content": "Đừng sợ, chị ấy còn nói với em \"nó chỉ nổ kẻ xấu thôi, đại khái là vậy\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760728
					],
					"speakerTitle": "Tiểu Đệ Kujirai"
				},
				{
					"id": 721760728,
					"content": "\"Đại khái\"?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760729
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760729,
					"content": "Vậy, em đi chỗ khác chơi đây! Tạm biệt mọi người!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tiểu Đệ Kujirai"
				},
				{
					"id": 721760708,
					"content": "Vậy sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760709
					]
				}
			]
		}
	]
}