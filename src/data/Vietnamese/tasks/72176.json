				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Tiểu Đệ Kujirai",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721760101,
					"content": "#Hi! {NICKNAME}, ở chỗ em có món đồ tốt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760102
					],
					"speakerTitle": "Tiểu Đệ Kujirai"
				},
				{
					"id": 721760102,
					"content": "#Cám ơn, {F#chị}{M#anh} không có hứng thú.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760103
					]
				},
				{
					"id": 721760103,
					"content": "Thật đáng thương, nhỏ tuổi như vậy đã bị ép làm mấy chuyện đáng ngờ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760104,
					"content": "Không phải đâu! Em muốn chơi Temari với mọi người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760105
					],
					"speakerTitle": "Tiểu Đệ Kujirai"
				},
				{
					"id": 721760105,
					"content": "Chơi Temari?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760106,
					"content": "Nói đơn giản là, em sẽ đem giấu Temari vào một nơi nào đó. Trong thời gian một bài hát, nếu mọi người có thể tìm thấy, thì sẽ thắng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760107
					],
					"speakerTitle": "Tiểu Đệ Kujirai"
				},
				{
					"id": 721760107,
					"content": "Temari chơi như vậy sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760108
					]
				},
				{
					"id": 721760108,
					"content": "Í? Là một Nhà Mạo Hiểm dạy em đó. Chị ấy còn nói...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760109
					],
					"speakerTitle": "Tiểu Đệ Kujirai"
				},
				{
					"id": 721760109,
					"content": "\"Kujirai, hãy nhớ kỹ. Em phái nói là \"Nếu bạn thắng, thì sẽ nhận được món đồ tốt\".\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760110
					],
					"speakerTitle": "Tiểu Đệ Kujirai"
				},
				{
					"id": 721760110,
					"content": "Cho nên, nếu mọi người thắng thì sẽ nhận được món đồ tốt đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760111
					],
					"speakerTitle": "Tiểu Đệ Kujirai"
				},
				{
					"id": 721760111,
					"content": "#Có đồ tốt kìa! {NICKNAME}, tôi thấy chơi cùng một đứa trẻ cũng là chuyện phải làm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760112,
						721760115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760112,
					"content": "Mà tôi vẫn thấy Temari không phải chơi như vậy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760113
					]
				},
				{
					"id": 721760113,
					"content": "Có lẽ đây là cách chơi chỉ có dân địa phương mới biết, đừng để ý mấy tiểu tiết này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760114,
					"content": "Em là Tiểu Đệ Kujirai phải không? Chúng tôi sẽ chơi với em!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760116,
					"content": "Yeah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tiểu Đệ Kujirai"
				},
				{
					"id": 721760115,
					"content": "Được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760116
					]
				}
			]
		},
		{
			"id": 7217602,
			"completionStepIds": [
				7217602
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
