			},
			"dialogs": [
				{
					"id": 414130701,
					"content": "Ừm! Cảnh sắc ở đây vẫn là đẹp nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130702,
						414130703
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130702,
					"content": "Phong cảnh đẹp quá.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130704
					]
				},
				{
					"id": 414130704,
					"content": "Phải, tôi rất thích nơi này, mỗi khi rảnh rỗi vẫn hay đến đây, ngắm phong cảnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130705
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130705,
					"content": "Đến đây để khỏi phải làm gì hết chứ gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130706,
					"content": "Ha ha ha, bị bạn đoán trúng rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130707
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130707,
					"content": "Cảnh đẹp thế này, có ly rượu táo nữa thì còn gì bằng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130708
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130708,
					"content": "Nhà Lữ Hành, Lễ Hội Hoa Gió của Mondstadt, bạn thích không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130709,
						414130710
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130709,
					"content": "Mang đậm tình người, lại rất đông vui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130711
					]
				},
				{
					"id": 414130711,
					"content": "Nhưng vẫn có thắc mắc, đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130712
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130712,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130713
					]
				},
				{
					"id": 414130713,
					"content": "Tôi biết bạn muốn hỏi gì. \"Hoa Gió\" là gì? \"Hoa Gió\" và \"Lễ Hội Hoa Gió\" nghĩa là gì trong mắt Phong Thần Barbatos đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130714
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130714,
					"content": "Như bạn thấy đó, người dân Mondstadt mỗi người mỗi lựa chọn. Có người chọn Bồ Công Anh, có người chọn Cúc Cánh Quạt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130715
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130715,
					"content": "\"Hoa Gió\" trong lòng mỗi người, hình như đều khác nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130716,
					"content": "Đúng vậy. Không có đáp án duy nhất, cũng không có \"Hoa Gió\" tồn tại thật sự.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130717
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130717,
					"content": "Ủa... không tồn tại sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130718,
					"content": "Từ \"Hoa Gió\" này, lúc đầu chỉ là mật mã mà người dân Mondstadt thời xưa dùng để liên lạc với nhau trong cuộc chiến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130719
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130719,
					"content": "Người thời đó thường nói, gió càng to, gốc rễ của \"Hoa Gió\" càng vững chắc, hoa cũng nở càng rực rỡ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130720
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130720,
					"content": "Theo tôi thì, nó không tồn tại, nhưng có ở khắp nơi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130721
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130721,
					"content": "Nó là linh hồn hướng đến tự do, là dũng khí theo đuổi hướng gió... Mọi điều tốt đẹp, đáng được chúc phúc, đều có thể là \"Hoa Gió\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130722
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130722,
					"content": "Thứ có vẻ không tồn tại, nhưng lại có ở khắp nơi, giống như gió vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130723
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130723,
					"content": "Ha ha, bạn nói không sai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130724
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130724,
					"content": "Vì vậy, Phong Thần Barbatos sẽ không định nghĩa \"Hoa Gió\" là gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130725
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130725,
					"content": "Hoa chúc phúc, hoa kính yêu, hoa tình yêu. Mỗi người đều có \"Hoa Gió\" thuộc về mình, mỗi người đều có quyền tự do định nghĩa về nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130726
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130726,
					"content": "Bông hoa mà thành phố tự do Mondstadt dâng cho phong thần, quả nhiên vô cùng tự do.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130727,
					"content": "Tôi cũng thích cảm giác tự do",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130728
					]
				},
				{
					"id": 414130728,
					"content": "Tôi biết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130729
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130729,
					"content": "Mọi người sẽ vì có chung chí hướng mà đi cùng nhau, thứ đưa bạn và tôi gặp nhau, chắc chắn là ngọn gió tự do.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130730
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130730,
					"content": "Nó đến từ tận cùng cuộc hành trình, rìa của thế giới. Đến từ trong tim bạn, không bao giờ ngừng nghỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130731
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130731,
					"content": "\"Ai đã vuốt ve gương mặt mang thương tích nhưng cương nghị của bạn\\nBên dòng suối nhỏ\\nBên tảng đá lớn\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130732
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130732,
					"content": "\"Ai đã ôm chặt linh hồn mệt mỏi mà cao quý của bạn\\nTrong giấc mộng\\nTrên trời cao\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130733
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130733,
					"content": "\"Bạn dấu yêu\\nTôi nắm lấy tay bạn\\nDẫn bạn đi giữa đèn hoa trong đêm\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130734
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130734,
					"content": "\"Kể lại từ đầu cho bạn\\nBài nhạc tự do và giấc mơ trong ngày lễ\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130710,
					"content": "Tham gia cùng mọi người, vô cùng vui vẻ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130711
					]
				},
				{
					"id": 414130703,
					"content": "Bầu không khí thật tuyệt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130704
					]
				}
			]
		},
