			},
			"dialogs": [
				{
					"id": 414130201,
					"content": "Đội trưởng Jean, chúng tôi đến rồi này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130202,
					"content": "Nhà Lữ Hành! A, không, ở đây nên gọi bạn là Kỵ Sĩ Danh Dự mới phải.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130203
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 414130203,
					"content": "Chắc bạn đã nghe nói rồi phải không, bạn là \"Ngôi Sao Lễ Hội Hoa Gió\" lần này, sẽ đại diện cho người dân Mondstadt dâng \"Hoa Gió\" cho phong thần Barbatos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130204
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 414130204,
					"content": "Nhưng... lần này hình như hơi khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130205
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 414130205,
					"content": "Có chúng tôi, và cả tên hát rong, Lễ Hội Hoa Gió lần này có phải sẽ vô cùng đông vui không!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130206,
					"content": "Phải. Cảm ơn các bạn đã đến với Mondstadt, cũng hy vọng sau này các bạn sẽ tiếp tục tận hưởng cuộc sống ở Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130207
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 414130207,
					"content": "Điển Lễ Hoa Gió sắp bắt đầu. Ngôi Sao Lễ Hội Hoa Gió, bạn đã chọn được \"Hoa Gió\" chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130208
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 414130208,
					"content": "Chúng ta phải chọn một loại hoa, dâng nó cho phong thần, đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130209,
					"content": "Đúng vậy, bạn hãy cân nhắc kỹ nhé. Đừng quên là, lựa chọn của bạn đại diện cho toàn Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130210
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 414130210,
					"content": "Venti, bạn thích hoa gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130211
					]
				},
				{
					"id": 414130211,
					"content": "Hả? Thật xảo quyệt, hỏi thẳng tôi luôn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130212
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130212,
					"content": "Ừ hừm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130213
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 414130213,
					"content": "Ở chỗ này thì đừng nói chuyện riêng nhé hai bạn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130214,
					"content": "Ha ha, bị trách rồi kìa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130215
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130215,
					"content": "Đừng để ý đến tôi, chọn loại mình thích là được. Tôi tin vào gu thẩm mỹ của bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130216
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130216,
					"content": "Vậy, Kỵ Sĩ Danh Dự, lựa chọn của bạn là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130217,
						414130219,
						414130221,
						414130223,
						414130225,
						414130227
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 414130217,
					"content": "Bồ Công Anh",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130218
					]
				},
				{
					"id": 414130218,
					"content": "Ồ! Lựa chọn của đông đảo người ủng hộ, \"Hoa Gió\" nhất định là Bồ Công Anh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130229,
					"content": "Hãy đại diện cho người Mondstadt, dâng \"Hoa Gió\" lên Tượng Phong Thần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jean"
				},
				{
					"id": 414130219,
					"content": "Cúc Cánh Quạt",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130220
					]
				},
				{
					"id": 414130220,
					"content": "Ồ! Lựa chọn của đông đảo người ủng hộ, \"Hoa Gió\" nhất định là Cúc Cánh Quạt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130221,
					"content": "Hoa Cecilia",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130222
					]
				},
				{
					"id": 414130222,
					"content": "Ồ! Giống với ý kiến của Beatrice, \"Hoa Gió\" là Hoa Cecilia ít được chú ý nhưng lại có lượng người ủng hộ nhất định!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130223,
					"content": "Tiểu Đăng Thảo",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130224
					]
				},
				{
					"id": 414130224,
					"content": "Ồ! Giống với ý kiến của Nimrod, \"Hoa Gió\" là Tiểu Đăng Thảo thắp sáng đêm tối!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130225,
					"content": "Hoa Ngọt",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130226
					]
				},
				{
					"id": 414130226,
					"content": "Ồ! Giống với ý kiến của Sucrose, \"Hoa Gió\" là Hoa Ngọt không ngừng sinh sôi từ xưa đến nay!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130227,
					"content": "Quả Móc Câu",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130228
					]
				},
				{
					"id": 414130228,
					"content": "Ồ! Giống với ý kiến của Razor, \"Hoa Gió\" là Quả Móc Câu chích chích tê tê!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130229
					],
					"speakerTitle": "Paimon"
				}
			]
		},
