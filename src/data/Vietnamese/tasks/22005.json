				"points": []
			},
			"dialogs": [
				{
					"id": 220050101,
					"content": "Rốt cuộc là ở đâu chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050102
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050102,
					"content": "Đang làm gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220050103
					]
				},
				{
					"id": 220050103,
					"content": "Ú ù! Bạn từ đâu chui ra vậy? Sao không thấy tiếng động gì hết...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050104
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050104,
					"content": "Tôi ư? Tôi là một học giả đang nghiên cứu các kiến trúc và di vật cổ đại trên Quy Li Nguyên. Bạn... Bạn có thể gọi tôi là Bao'er",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050105
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050105,
					"content": "Tôi quá chú tâm nghiên cứu nên đánh rơi mất chiếc túi bên mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050106
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050106,
					"content": "Bên trong đó chứa báu... à không là văn vật tôi mất rất nhiều thời gian để tìm ra chúng, bạn có muốn giúp tôi tìm không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050107,
						220050108,
						220050109
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050107,
					"content": "Tôi biết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220050110
					]
				},
				{
					"id": 220050110,
					"content": "Vậy thì tốt quá, chắc chỉ ở gần đây thôi... Hoặc có lẽ xa hơn một chút, bạn tìm cẩn thận nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050108,
					"content": "Là chiếc túi như thế nào?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220050111
					]
				},
				{
					"id": 220050111,
					"content": "Chỉ là... Chiếc túi rất bình thường mà mọi người hay dùng, bên trong là một chiếc hộp vuông...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050112
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050112,
					"content": "Sao lại dùng thứ này để đựng văn vật ư? Thật ra là vì dễ bảo quản ấy mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050113
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050113,
					"content": "Hơn nữa, tôi còn đặt bên trong vài lớp quần áo để làm đệm, văn vật bên trong sẽ không bị ảnh hưởng gì cả. Bạn mau tìm giúp tôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050109,
					"content": "Là văn vật như thế nào?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220050114
					]
				},
				{
					"id": 220050114,
					"content": "Là một món văn vật rất quý giá, có nói ra bạn cũng không hiểu đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050115
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050115,
					"content": "Chỉ có những người am hiểu như tôi mới có thể nhận biết được giá trị thực sự của nó, nhờ cả vào bạn rồi, mau đi tìm giúp tôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bao'er"
				}
			]
		},
