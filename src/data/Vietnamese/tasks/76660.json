					"nextDialogs": [
						766600107
					]
				},
				{
					"id": 766600107,
					"content": "Chúng tôi chỉ là rất vui khi được gặp cô thôi! Hihi, Katheryne vẫn là tốt nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766600108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766600108,
					"content": "Cảm ơn sự nhiệt tình của hai vị... Xin lỗi, có lẽ tôi chưa hiểu được sự hài hước này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766600109
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 766600109,
					"content": "#Nhưng dù sao đi nữa, chào mừng {F#cô}{M#cậu} đến với Nod-Krai, vùng đất tràn đầy cơ hội.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766600110
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 766600110,
					"content": "#Tôi tin {F#cô}{M#cậu} nhất định sẽ trải qua những cuộc phiêu lưu vĩ đại, giành được những kho báu vô song ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766600111
					],
					"speakerTitle": "Katheryne"
				},
				{
