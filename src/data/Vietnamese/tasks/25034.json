			"dialogs": [
				{
					"id": 250340501,
					"content": "Cảm ơn vì đã cứu tụi em.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340502
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250340502,
					"content": "Grào... Grào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340503
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250340503,
					"content": "#Nơi này cách bộ tộc quá xa, em không thể nào báo tin cho chị Illapa được. Nếu {F#chị}{M#anh} không đến, Qica chắc chắn sẽ bị bắt đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340504
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250340504,
					"content": "Em tới đây làm gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250340505
					]
				},
				{
					"id": 250340505,
					"content": "Chúng em đến đây tập leo núi. Nhưng leo được nửa chừng thì cả hai đều đói lả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340506
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250340506,
					"content": "Vì vậy, em và Qica đi hái quả. Ai ngờ mải hái quả, nên đã đi xa quá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340507
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250340507,
					"content": "Đến khi ăn no, chúng em đã đi rất xa rồi. Về nhà chắc chắn sẽ lại bị mẹ mắng cho một trận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340508
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250340508,
					"content": "#Một lần nữa cảm ơn {F#chị}{M#anh} đã cứu em, số Cacahuatl này là em vừa mới hái được, cho {F#chị}{M#anh} đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340509
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250340509,
					"content": "Chúng ta mau về thôi, Qica, đi nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340510
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250340510,
					"content": "Grào! Gràooo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qica"
				}
			]
		}
