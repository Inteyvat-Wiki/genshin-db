			"dialogs": [
				{
					"id": 250340101,
					"content": "Cậu ấy không thích các người, đi ra đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340102
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250340102,
					"content": "Nhãi ranh... Ngươi biết con Saurian này ư? Nó có liên quan gì đến ngươi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340103
					],
					"speakerTitle": "Tên Cướp Bực Bội"
				},
				{
					"id": 250340103,
					"content": "Grào... Grào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340104
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250340104,
					"content": "Nhìn kìa, con Saurian này mất kiên nhẫn rồi. Ranh con, cút sang một bên, bọn ta không đánh trẻ con.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340105
					],
					"speakerTitle": "Tên Cướp Bực Bội"
				},
				{
					"id": 250340105,
					"content": "Các anh em, lấy cái túi ra đây. Hừ hừ, con Saurian này chắc chắn sẽ bán được giá cao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340106
					],
					"speakerTitle": "Tên Cướp Bực Bội"
				},
				{
					"id": 250340106,
					"content": "Không được lại đây! Tiến thêm bước nữa ta sẽ ra tay!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340107
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250340107,
					"content": "Ra, ra tay? Ngươi? Hahahaha, các anh em, nó muốn đánh nhau với tụi mình!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340108
					],
					"speakerTitle": "Tên Cướp Bực Bội"
				},
				{
					"id": 250340108,
					"content": "Sợ quá đi mất, nhóc con. Nhưng nếu ngươi đã lên tiếng thách thức, vậy thì đừng trách ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340109
					],
					"speakerTitle": "Tên Cướp Bực Bội"
				},
				{
					"id": 250340109,
					"content": "Grào! Gràooo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340110
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250340110,
					"content": "Ặc, con Saurian này dữ đấy nhỉ... Nhóc con, ngươi cứ ngủ cho ngon giấc đi nhé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340111,
						250340112
					],
					"speakerTitle": "Tên Cướp Bực Bội"
				},
				{
					"id": 250340111,
					"content": "Người phải ngủ một giấc là các ngươi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250340113
					]
				},
				{
					"id": 250340113,
					"content": "#{F#Chị gái}{M#Anh trai}! Họ là kẻ xấu! Họ muốn bắt cóc Qica!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340114
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250340114,
					"content": "Grào, grào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340115
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250340115,
					"content": "#...Hỡi hảo hán đi ngang qua. Chỉ cần {F#cô}{M#cậu} không can thiệp vào chuyện này, anh em tôi sẽ nhớ ân tình này và chia cho {F#cô}{M#cậu} một phần tiền sau khi mọi chuyện xong xuôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340116,
						250340117
					],
					"speakerTitle": "Tên Cướp Bực Bội"
				},
				{
					"id": 250340116,
					"content": "Không được làm hại đến Qica.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250340118
					]
				},
				{
					"id": 250340118,
					"content": "Vậy là không còn gì để nói rồi. Được thôi, vậy thì theo luật. Chúng ta sẽ so tài cao thấp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340119
					],
					"speakerTitle": "Tên Cướp Bực Bội"
				},
				{
					"id": 250340119,
					"content": "Đáng ghét, anh em đâu, xông lên!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tên Cướp Bực Bội"
				},
				{
					"id": 250340117,
					"content": "Ai cần cái đó của ngươi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250340118
					]
				},
				{
					"id": 250340112,
					"content": "Vậy các ngươi cũng đừng trách ta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250340113
					]
				}
			]
		},
