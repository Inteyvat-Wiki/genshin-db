					"\"Tiểu Hoàng Tử\""
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706660201,
					"content": "Meo! \"Thật xuất sắc, chúc mừng bạn đã đột phá thí luyện cấp bài thủ, bây giờ bạn đã là Bài Thủ Cao Cấp rồi!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706660202
					],
					"speakerTitle": "\"Tiểu Hoàng Tử\""
				},
				{
					"id": 706660202,
					"content": "Meo? \"Chỉ hoàn thành một lần thí luyện đã trở thành Bài Thủ Cao Cấp? Haiz, bởi vì hầu hết mọi người đều xem chơi bài là một trò giải trí, nên họ không quá coi trọng nó...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706660203
					],
					"speakerTitle": "\"Tiểu Hoàng Tử\""
				},
				{
					"id": 706660203,
					"content": "\"Nói cách khác, số người chơi nghiêm túc chỉ là số ít, nhưng mà, dù chỉ là giải trí thì cũng có giá trị của sự đầu tư nghiêm túc.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706660204
					],
					"speakerTitle": "\"Tiểu Hoàng Tử\""
				},
				{
					"id": 706660204,
					"content": "Meo! \"À đúng rồi, bây giờ bạn đã được tôi công nhận, cũng có thể khiêu chiến ván bài của những người chơi khác trong quán rượu, ừm... chắc họ sẽ thích bạn.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706660205
					],
					"speakerTitle": "\"Tiểu Hoàng Tử\""
				},
				{
					"id": 706660205,
					"content": "Những người khác?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706660206
					]
				},
				{
					"id": 706660206,
					"content": "Meo. \"Ừm, đương nhiên là giống tôi, là mèo trong quán rượu... đừng xem thường họ.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706660207
					],
					"speakerTitle": "\"Tiểu Hoàng Tử\""
				},
				{
					"id": 706660207,
					"content": "Meo~ \"Đến lúc đó cứ để Shuyun cầm bài cho họ, được rồi, như thường lệ, phải nói một điều!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706660208
					],
					"speakerTitle": "\"Tiểu Hoàng Tử\""
				},
				{
					"id": 706660208,
					"content": "#\"{NICKNAME}, hy vọng bạn sẽ trải nghiệm được thú vui của \"Thất Thánh Triệu Hồi\"!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"Tiểu Hoàng Tử\""
				}
			]
		},
