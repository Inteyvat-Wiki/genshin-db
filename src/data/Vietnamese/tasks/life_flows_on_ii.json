				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 414220101,
					"content": "Tôi đã nói rõ với Rhodeia rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220102
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220102,
					"content": "Cô ấy là người nổi tiếng nhất, và cũng là người mạnh nhất trong số các mật thám Tinh Linh Nước Trong chúng tôi. Nhưng cô ấy nhớ nhung vị thủy thần tiền nhiệm, trốn khỏi Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220103
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220103,
					"content": "Tôi cũng không về được Fontaine, nên tôi nói cho các bạn biết toàn bộ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220104
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220104,
					"content": "Tinh Linh Nước Trong chúng tôi từng phân bố trong các sông suối hồ ao trên toàn lục địa, đa phần đều là mật thám của Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220105
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220105,
					"content": "Chà! Thủy thần đang lên kế hoạch gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414220106,
					"content": "Người trước kia không có kế hoạch gì, chỉ muốn giống với nước, nối liền lục địa, kết nối mọi người với nhau. Nhưng cùng với sự biến mất của cô ấy, nhiều tinh linh đã cắt đứt liên hệ với Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220107
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220107,
					"content": "Giống như Rhodeia mạnh mẽ nhất, không công nhận thủy thần mới, chỉ muốn sống mãi với giấc mộng trước kia. Rhodeia, chỉ cần một vùng nước bình yên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220108
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220108,
					"content": "Nhưng cô ấy đã phát hiện ra tôi, tưởng tôi là sát thủ của Fontaine. Nên cô ấy làm cho nước sông đắng nghét, để tiêu diệt tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220109
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220109,
					"content": "Nhưng rõ ràng lúc đầu bạn yếu đuối như vậy thì sao cô ấy lại hoảng hốt như thế chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414220110,
					"content": "Ý thức chủ đạo của Tinh Linh Nước Trong, rất dễ sụp đổ do dung hòa một ý thức nhỏ có ác niệm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220111
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220111,
					"content": "Tôi luôn ngưỡng mộ Rhodeia, nên nhờ vào Slime Thủy, tôi nhảy giữa sông nước, rời Fontaine đến đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220112
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220112,
					"content": "Ngoài sát thủ phản bội nhiệm vụ, thì chắc không có Tinh Linh Nước Trong khác cố chấp như tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220113
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220113,
					"content": "Ở một mức độ nào đó, nghe có vẻ rất lợi hại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414220114,
					"content": "#Nhưng tôi cũng vậy, là người được {NICKNAME} đưa qua khắp các nước. So với thành tựu vĩ đại của tôi, bạn còn kém một chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414220115,
					"content": "Này.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414220116
					]
				},
				{
					"id": 414220116,
					"content": "Tôi đã giải thích rõ với cô ấy, chắc không lâu nữa nước sẽ hết đắng. Cuối cùng cô ấy vẫn hỏi tôi, có muốn hòa vào nguồn nước của Khinh Sách không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220117
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220117,
					"content": "Vậy bạn đến để từ biệt sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414220118,
					"content": "Tôi còn một thông tin muốn truyền đạt. Các bạn hãy theo tôi tới Thanh Tuyền Trấn lần nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Endora"
				}
			]
		},
		{
			"id": 4142202,
			"completionStepIds": [
				4142202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4142202",
