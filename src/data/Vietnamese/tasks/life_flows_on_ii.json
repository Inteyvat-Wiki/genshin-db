				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lão Finch"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414220201,
					"content": "Finch, Finch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220202
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220202,
					"content": "Ối, làm ông hết hồn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220203
					],
					"speakerTitle": "Lão Finch"
				},
				{
					"id": 414220203,
					"content": "Endora học rất nhanh. Ngạc nhiên cũng là điều đương nhiên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414220204,
					"content": "Chỉ là cảm thấy, biết gọi ông là Finch thì thật sự rất giống cô ấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220205
					],
					"speakerTitle": "Lão Finch"
				},
				{
					"id": 414220205,
					"content": "A...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414220206,
					"content": "\"Ngày nào cũng có một đứa trẻ loạng choạng đến, một mình khám phá mọi thứ trên thế gian. Tất cả những thứ mà cậu nhìn thấy đều trở thành một phần trong cậu!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220207
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220207,
					"content": "\"Đứa bé này cứ thế tiến về trước, cả một đời đều vậy.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220208
					],
					"speakerTitle": "Lão Finch"
				},
				{
					"id": 414220208,
					"content": "Ông biết bài thơ này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220209
					],
					"speakerTitle": "Lão Finch"
				},
				{
					"id": 414220209,
					"content": "Cuộc sống chúng tôi khác xa với cuộc sống các bạn. Vì vậy chúng ta có thể không hiểu nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220210
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220210,
					"content": "Nhưng cuộc sống của chúng ta như nhau. Vẫn luôn trong quá trình đón nhận những thứ mới mẻ và bước ngoặt mới, tuôn trào ra biển.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220211
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220211,
					"content": "Vì vậy cô ấy nói: \"Khi tất cả ngôi sao trên trời đêm lụi tàn, tất cả dòng suối và giấc mơ đều sẽ quy tụ về đại dương mênh mông. Lúc ấy chúng ta sẽ gặp lại nhau.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220212
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220212,
					"content": "...Ừm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220213
					],
					"speakerTitle": "Lão Finch"
				},
				{
					"id": 414220213,
					"content": "Dòng nước cuộc sống vẫn chảy xuôi dòng, hãy bước đi, đừng dừng lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220214
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220214,
					"content": "Ha ha ha, quả nhiên là cô ấy. Lại còn cái giọng điệu xem ông là con nít đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220215
					],
					"speakerTitle": "Lão Finch"
				},
				{
					"id": 414220215,
					"content": "Được rồi, hãy để ông yên tĩnh một mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220216
					],
					"speakerTitle": "Lão Finch"
				},
				{
					"id": 414220216,
					"content": "#Vậy thì {NICKNAME}, chúng ta cũng nên nói lại cho Connor rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4142203,
			"completionStepIds": [
				4142203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4142203",
							"2"
						],
						"stepId": 4142203,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Connor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414220301,
					"content": "Ồ ồ, các bạn tới rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220302
					],
					"speakerTitle": "Connor"
				},
				{
					"id": 414220302,
					"content": "Tôi đoán nếu các bạn ra tay, chắc sự việc sẽ được giải quyết ổn thỏa nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220303,
						414220304
					],
					"speakerTitle": "Connor"
				},
				{
					"id": 414220303,
					"content": "Đương nhiên rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414220305
					]
				},
				{
					"id": 414220305,
					"content": "Chắc mấy ngày nữa nước sẽ hết đắng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414220306,
					"content": "Ồ, tôi hiểu tôi hiểu. Dù loại bỏ được nguyên do, thì cũng phải đợi chút thời gian để nước sạch trở lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220307
					],
					"speakerTitle": "Connor"
				},
				{
					"id": 414220307,
					"content": "Vậy tôi sẽ liên lạc với Hiệp Hội Nhà Mạo Hiểm kết thúc vụ án. Thực sự rất cảm ơn hai bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Connor"
				},
				{
					"id": 414220304,
					"content": "Mặc dù quá trình có hơi phức tạp...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414220305
					]
				}
			]
		},
		{
			"id": 4142204,
			"completionStepIds": [
				4142204
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4142204",
							"2"
						],
						"stepId": 4142204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 414220401,
					"content": "Tộc chúng tôi bày tỏ sự yêu thích bằng cách hòa hai dòng nước lại với nhau. Như vậy sẽ chung sống mà không có sự ngăn cách.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220402
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220402,
					"content": "Nhưng để hiểu rõ những sinh mệnh khác trên thế giới lại không đơn giản. Vì thế chúng tôi đã quan sát, nghiên cứu, mô phỏng và hóa thành hình dáng động vật. Cũng có thể nói rằng hình dạng của chúng đã trở thành môt phần của chúng tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220403
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220403,
					"content": "Nhìn dòng sông trôi, Endora bắt đầu suy nghĩ về đề tài sâu xa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414220404,
					"content": "Trước đây tôi cũng chưa từng nghĩ xem cuộc sống sau này sẽ thế nào. Trước đây tôi cứ nghĩ hòa vào làm một với Rhodeia là được rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220405
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220405,
					"content": "Nhưng Rhodeia có vẻ không vui. Chính cô ấy cũng hiểu, cô ấy đang chờ dòng nước sạch trở nên vẩn đục.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220406,
						414220407
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220406,
					"content": "Vậy nên lựa chọn của bạn là?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414220408
					]
				},
				{
					"id": 414220408,
					"content": "Cho dù là Rhodeia hay người ở Thanh Tuyền Trấn đều không muốn để tôi bước lên con đường của cô ấy. Nhưng chắc chắn cô ấy còn chán ghét cuộc sống của Fontaine hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220409
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220409,
					"content": "Cuộc sống các bạn thật sự rất kỳ diệu, vậy nên tôi cũng không thể đưa ra lời khuyên có ích gì. Nhưng tôi cảm thấy, sống vui vẻ vẫn sẽ tốt hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414220410,
					"content": "Vì vậy, tôi quyết định chọn một con đường chưa ai chọn. Vì cuộc hành trình với họ rất vui, tôi muốn sau này ngày nào cũng được vui như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220411
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220411,
					"content": "Tôi muốn đi cùng các bạn. Đi xem hoa cỏ và áng mây nơi chân trời trước khi dòng suối cuộc sống chảy ra biển.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220412,
						414220413
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414220412,
					"content": "Rất hoan nghênh bạn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414220415
					]
				},
				{
					"id": 414220415,
					"content": "#Nhưng nếu vậy thì tôi không thể độc chiếm sự vinh hạnh được {NICKNAME} đưa đi khắp bảy nước được rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414220413,
					"content": "Hay là đổi Paimon đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414220414
					]
				},
				{
					"id": 414220414,
					"content": "Này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414220407,
					"content": "Cho nên bạn đã từ chối cô ấy sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414220408
					]
				}
			]
