				},
				{
					"id": 711345202,
					"content": "Gì chứ? Vẫn chưa... chưa quên món Trà Mật Hoa Ngọt Bùng Nổ đó à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
