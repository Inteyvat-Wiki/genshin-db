				]
			},
			"dialogs": [
				{
					"id": 711340101,
					"content": "Ồ! Trông dáng vẻ bận rộn đó kìa, đang tìm chỗ uống trà nghỉ ngơi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340102
					],
					"speakerTitle": "Xuanji"
				},
				{
					"id": 711340102,
					"content": "Có trà để uống à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711340103
					]
				},
				{
					"id": 711340103,
					"content": "Đúng vậy, trong vài dặm quanh đây chỉ có quán trà nhỏ này thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340104
					],
					"speakerTitle": "Xuanji"
				},
				{
					"id": 711340104,
					"content": "Vậy có những loại trà gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711340105,
					"content": "À... Ừm... Có... có Trà Mật Hoa Ngọt Bùng Nổ, ừm, đúng vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340106
					],
					"speakerTitle": "Xuanji"
				},
				{
					"id": 711340106,
					"content": "Là một thức uống đặc biệt được kết hợp giữa Hoa Ngọt và Mật Hoa Lừa Dối. Uống vào thấy nóng, hậu vị mát lạnh, có tác dụng giải tỏa mệt mỏi, không nơi nào có được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340107
					],
					"speakerTitle": "Xuanji"
				},
				{
					"id": 711340107,
					"content": "Ồ! Trà này chưa từng nghe bao giờ! Cảm giác sẽ rất ngon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711340108,
					"content": "Đáng tiếc là tôi đã dùng hết nguyên liệu, mà vườn nguyên liệu bên cạnh lại rất nguy hiểm, phải hái Hoa Ngọt, lại phải đối phó với <color=#00E1FFFF>Hoa Lừa Dối Cháy Rực</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340118
					],
					"speakerTitle": "Xuanji"
				},
				{
					"id": 711340118,
					"content": "Giả sử có đủ nguyên liệu để duy trì quán trà nhỏ này, thì trả thêm chút thù lao cũng đâu có sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340109
					],
					"speakerTitle": "Xuanji"
				},
				{
					"id": 711340109,
					"content": "Nhưng tiếc là bây giờ... thật ngại quá, hay là các vị tới nơi khác thử xem? Tôi sẽ đến Hiệp Hội Nhà Mạo Hiểm nhờ họ giúp hái nguyên liệu rồi hẵng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340110
					],
					"speakerTitle": "Xuanji"
				},
				{
					"id": 711340110,
					"content": "Tin tốt đây, chúng tôi chính là nhà mạo hiểm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711340111
					]
				},
				{
					"id": 711340111,
					"content": "À... Khụ khụ... Cái này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340112
					],
					"speakerTitle": "Xuanji"
				},
				{
					"id": 711340112,
					"content": "Không sai, Trà Mật Hoa Ngọt Bùng Nổ, nhất định phải uống bằng được. Chuyện hái nguyên liệu cứ để chúng tôi giúp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711340113,
					"content": "Hoa Lừa Dối ở đó... nhiều như đá trên Minh Viên Sơn vậy! Các vị đừng nên mạo hiểm thế...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340114
					],
					"speakerTitle": "Xuanji"
				},
				{
					"id": 711340114,
					"content": "...Nếu thật sự nhiều như vậy thì chỗ này nên gọi là Núi Hoa Lừa Dối mới đúng chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711340115,
					"content": "Hmm... Tôi nhớ ra rồi, thật ra tôi và Hiệp Hội Nhà Mạo Hiểm có thỏa thuận hợp tác... Tức là, để hai vị tùy tiện giúp đỡ thế này thì không hay lắm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340116
					],
					"speakerTitle": "Xuanji"
				},
				{
					"id": 711340116,
					"content": "Sao anh kỳ lạ vậy, có nhà mạo hiểm giúp đỡ mà còn không đồng ý...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711340117,
					"content": "Tóm lại, trà tuy ngon nhưng thời điểm không phù hợp, haha, mời các vị về cho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340119
					],
					"speakerTitle": "Xuanji"
				},
				{
					"id": 711340119,
					"content": "Được rồi, được rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711340120,
					"content": "#({NICKNAME} nói xem, nếu chúng ta không nghe lời anh ta, trực tiếp đi lấy nguyên liệu về thì liệu có trà để uống không nhỉ?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711340121,
					"content": "(Thật muốn thử món trà đó quá đi!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7113403,
			"completionStepIds": [
				7113403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7113403",
							"2"
						],
						"stepId": 7113403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xuanji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711340301,
					"content": "Ơ? Vị khách quan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340302
					],
					"speakerTitle": "Xuanji"
				},
				{
					"id": 711340302,
					"content": "Nguyên liệu đây, lên trà đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711340303
					]
				},
				{
					"id": 711340303,
					"content": "Cái gì? Các vị thực sự đi giải quyết đám <color=#00E1FFFF>Hoa Lừa Dối Cháy Rực</color> đó rồi à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340304
					],
					"speakerTitle": "Xuanji"
				},
				{
					"id": 711340304,
					"content": "Quả thực bên đó có không ít Hoa Lừa Dối, nhưng với chúng tôi thì vẫn không đáng là bao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711340305,
					"content": "Không ít cơ à? À không không, đương nhiên là tôi biết, haha, hai vị quả thật là rất dũng cảm, bái phục, bái phục.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340306
					],
					"speakerTitle": "Xuanji"
				},
				{
					"id": 711340306,
					"content": "(Cũng may hai vị đây không sao... Không thì mình thật đáng trách... Xem ra lần sau phải đổi cái cớ khác...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340307
					],
					"speakerTitle": "Xuanji"
				},
				{
					"id": 711340307,
					"content": "Hừm, bây giờ anh hết trốn tránh rồi nhỉ, chúng tôi muốn uống Trà Mật Hoa Ngọt Bùng Nổ đặc biệt kia ngay bây giờ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711340308,
					"content": "Được... Được... Tôi đi chuẩn bị ngay...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340309
					],
					"speakerTitle": "Xuanji"
				},
				{
					"id": 711340309,
					"content": "(Ghét thật... Làm kiểu gì đây... sẽ không khó đâu nhỉ?! Chỉ cần trộn lẫn Hoa Ngọt với Mật Hoa Lừa Dối là được nhỉ?!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340310
					],
					"speakerTitle": "Xuanji"
				},
				{
					"id": 711340310,
					"content": "Xuanji vẻ mặt khó coi, nhưng vẫn cầm lấy nguyên liệu các bạn mang tới, cho hết vào một ly. Giây lát sau, anh ta lại lấy một ít ra khỏi ly, nhưng sau cùng vẫn cho vào lại.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						711340311
					]
				},
				{
					"id": 711340311,
					"content": "Sau đó, anh ta đậy nắp rồi lắc thật mạnh. Không lâu sau, một thứ chất lỏng màu nâu với bọt lạ nổi bên trên được đưa đến trước mặt bạn.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						711340312
					]
				},
				{
					"id": 711340312,
					"content": "Bạn cảm thấy có gì đó không đúng, nhưng Paimon cầm lấy thứ đó, một hơi uống hết sạch.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						711340313
					]
				},
				{
					"id": 711340313,
					"content": "Phụt, phì phì... Đây là thứ gì vậy, tôi chưa từng uống thứ gì kinh khủng như vậy... Quán trà này của anh sao vẫn mở cửa được vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711340314,
					"content": "Haha... Thật xin lỗi! Để lưỡi của quý cô phải chịu thiệt thòi rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340315
					],
					"speakerTitle": "Xuanji"
				},
				{
					"id": 711340315,
					"content": "Chút thành ý này, xin hãy nhận cho! Xem như đó là lời xin lỗi cho lưỡi của cô, cũng coi như thù lao vì đã tìm nguyên liệu về cho tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340316
					],
					"speakerTitle": "Xuanji"
				},
				{
					"id": 711340316,
					"content": "Hmm... Được rồi, tuy kỹ năng pha trà của anh không ổn, nhưng tính cách của anh rất tốt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711340317,
					"content": "Haha, cảm ơn... Dù sao thì cũng nhờ hai vị mà nguyên liệu tôi cần đã có đủ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711340318
					],
					"speakerTitle": "Xuanji"
				},
				{
					"id": 711340318,
					"content": "Nếu không còn chuyện gì thì hai vị mau chóng quay về đi, dù sao đây cũng là nơi hoang vắng, không biết chừng sẽ gặp nguy hiểm gì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xuanji"
				}
			]
		},
