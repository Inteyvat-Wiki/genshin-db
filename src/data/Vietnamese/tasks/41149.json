			"dialogs": [
				{
					"id": 411490301,
					"content": "Nghe nói là đơn đặc biệt...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411490302
					]
				},
				{
					"id": 411490302,
					"content": "Phải rồi, bạn tới thật đúng lúc. Lúc trước, tiên sinh Wallit đã đặt một phần Bánh Xốp ở chỗ chúng tôi, tiền cũng đã trả rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411490303
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 411490303,
					"content": "Sau đó, anh ấy bảo chúng tôi lát nữa đưa đến một nơi phía Nam của Hẻm Núi Minh Quán...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411490304
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 411490304,
					"content": "Nhưng không biết tại sao, gần đây yêu cầu giao món càng ngày càng nhiều, chúng tôi không đủ nhân lực.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411490305
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 411490305,
					"content": "Nếu bạn đồng ý thì hãy giúp tôi chạy việc một chuyến nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				}
