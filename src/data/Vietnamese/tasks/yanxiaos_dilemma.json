					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030402,
					"content": "Bạn sao lại muốn đưa cơm cho anh ta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030403
					]
				},
				{
					"id": 220030403,
					"content": "Hỏi làm gì, anh ta là người cô độc ở Liyue, chỉ quen mỗi mình tôi, cũng chỉ dám đến tìm tôi ăn ké.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030404
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030404,
					"content": "Còn lý do? Muốn biết lý do tôi làm cơm cho anh ta, được thôi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030405
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030405,
					"content": "Hơn nữa, nếu tôi không lo cơm nước cho anh ta, anh ta đến Địch Hoa Châu lại phát điên thì làm sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030406
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030406,
					"content": "Sao bạn vẫn đứng đây! Mau đi đi! Còn chần chừ gì nữa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yanxiao"
				}
			]
