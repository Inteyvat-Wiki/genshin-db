			},
			"dialogs": [
				{
					"id": 220030101,
					"content": "Hừm, cũng chịu thua với cái mặt dày của nó, ăn ké mà ăn nhiều thế cơ chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030102
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030102,
					"content": "Đang làm gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030103
					]
				},
				{
					"id": 220030103,
					"content": "Tôi? Đang làm cơm cho kẻ nào đó ăn ké.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030104
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030104,
					"content": "Cà ngày dài an nhàn như vậy, bảo đến nhà trọ phụ việc cũng không chịu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030105
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030105,
					"content": "Ngày ngày câu cá mà có bắt được con cá nào to mấy đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030106
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030106,
					"content": "Nếu không có tôi thì sớm muộn cũng chết đói bên cạnh nhà khách rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030107
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030107,
					"content": "Thôi vậy, không khẩu nghiệp nữa, nói anh ta có nghe thấy đâu, mà có nghe thấy cũng giả vờ như không nghe thấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030108
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030108,
					"content": "Nếu bạn rảnh, giúp tôi hái ít rau về đây, ở đây không đủ dùng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030109
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030109,
					"content": "Cũng không cần nhiều, chỉ cần 1 quả <color=#00E1FFFF>Ớt Tuyệt Vân</color>, và một <color=#00E1FFFF>Đài Sen</color> thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030110,
						220030112
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030110,
					"content": "Tôi biết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030111
					]
				},
				{
					"id": 220030111,
					"content": "Bạn tìm thấy rồi thì tôi sẽ bắt đầu nấu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030112,
					"content": "Nhà trọ có nhiều rau như vậy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030113
					]
				},
				{
					"id": 220030113,
					"content": "Tiền đó là dành cho ông chủ, còn anh ta ăn ké có đưa tiền đâu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030114
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030114,
					"content": "Những món này là do tôi tự trả tiền...hừm, đúng là tôi nợ anh ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030115
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030115,
					"content": "Được thôi, bạn mau đi đi nhớ về sớm đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yanxiao"
				}
			]
		},
