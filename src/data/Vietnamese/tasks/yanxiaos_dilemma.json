			"dialogs": [
				{
					"id": 220030601,
					"content": "Cơm đưa đến chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030602
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030602,
					"content": "Đến rồi, anh ấy nói...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030603
					]
				},
				{
					"id": 220030603,
					"content": "Hừm, bạn không phải nói nữa, tên ăn ké đó lại nói lời cảm ơn xuông phải không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030604
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030604,
					"content": "Mấy năm nay nghe đến phát chán rồi, cảm ơn cái con khỉ, có gì mà cảm ơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030605
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030605,
					"content": "Có thời gian nói lời cảm ơn, có thời gian đi câu cá, chi bằng đi đến nhà trọ làm công lấy tiền còn hơn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030606
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030606,
					"content": "Ờ quên, nói những lời với bạn làm gì, đây là phần thưởng cho bạn, cầm lấy rồi đi làm việc của bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yanxiao"
				}
			]
		},
		{
