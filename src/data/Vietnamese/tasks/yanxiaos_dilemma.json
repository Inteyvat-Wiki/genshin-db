						220030703
					]
				},
				{
					"id": 220030703,
					"content": "Chúng tôi là...bạn bè lâu năm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030704
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220030704,
					"content": "Ừm...Trước kia đi Địch Hoa Châu đã làm một việc mà tôi nhất định phải làm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030705
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220030705,
					"content": "Toàn bộ cảng Liyue, chỉ có nhà khách này cho tôi ở nhờ, có đầu bếp lo cơm nước cho tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030706
					],
					"speakerTitle": "Jiangxue"
				},
				{
