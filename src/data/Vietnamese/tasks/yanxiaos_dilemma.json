			"dialogs": [
				{
					"id": 220030301,
					"content": "Bạn đợi ở đây, tôi nấu xong rồi bạn mang qua đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030302
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 220030302,
					"content": "Cái mặt có ý gì đấy, tôi không bắt bạn làm không công đâu, sẽ trả phí tương ứng.",
					"roleType": "TALK_ROLE_NPC",
