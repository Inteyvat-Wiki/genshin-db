				},
				{
					"id": 220030502,
					"content": "Đây là đồ ăn Yanxiao làm cho bạn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030503
					]
				},
				{
					"id": 220030503,
					"content": "Chả trách mùi thơm cứ bay ra từ đâu đó, nấu nướng cũng không tồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030504
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220030504,
					"content": "Cám ơn bạn, khi quay về nhớ chuyển lời cảm ơn của tôi cho anh ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiangxue"
				}
			]
		},
