			"dialogs": [
				{
					"id": 220070101,
					"content": "Rốt cuộc là rơi ở đâu nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070102
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220070102,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220070103
					]
				},
				{
					"id": 220070103,
					"content": "Sự việc là thế này... Trong lúc khảo sát di tích, tôi bị quái vật tấn công...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070104
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220070104,
					"content": "Vì quá sợ hãi nên bỏ quên văn vật vừa mới đào được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070105
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220070105,
					"content": "Sau khi quái vật bỏ đi, tôi có quay lại tìm nhưng không thấy nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070106
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220070106,
					"content": "Tìm hết một lượt xung quanh không có tung tích gì, tôi thầm nghĩ văn vật chắc hẳn bị quái vật lấy đi mất rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070107
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220070107,
					"content": "Bạn có thể giúp tôi tìm nó được không? Nếu tìm thấy hãy cất vào chiếc hộp này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bao'er"
				}
			]
		},
