					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150470418,
					"content": "Tôi nghe Ifa nói Iktomisaur thích ăn Nấm Sừng Phát Sáng nhất, vừa hay tôi có mang theo đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470419
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470419,
					"content": "Tốt quá! Cứ cho nó ăn là tâm ý tương thông thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470420
					],
					"speakerTitle": "Mualani"
				},
				{
