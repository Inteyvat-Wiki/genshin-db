			"dialogs": [
				{
					"id": 150470101,
					"content": "Đến rồi à! Nhân viên ở đây hình như có việc gấp nên vắng mặt hết cả, nhưng mà tôi đã hiểu cách chơi... À nhầm, cách hoàn thành thử nghiệm rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470102
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470102,
					"content": "Được, vậy thì hướng dẫn chúng tôi với nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150470103,
					"content": "Nói đơn giản thì một bên cần lên thuyền, một bên phát tín hiệu cho nhân viên Saurian. Dùng sự hợp tác ăn ý của hai phía để đưa thuyền đến đích an toàn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470104
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470104,
					"content": "#Nếu nói đến ăn ý, tôi rất có lòng tin vào sự phối hợp giữa tôi và {NICKNAME} đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470105
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470105,
					"content": "Thật sao? Khoác lác là dễ bị lật thuyền lắm nhé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150470106,
					"content": "Này, Paimon, đừng nói mấy lời xui xẻo như vậy chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470107
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470107,
					"content": "Được rồi... Vậy chúc thuận buồm xuôi gió nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150470108,
					"content": "Haha, nhất định rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470109
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470109,
					"content": "Thật ra tôi rất muốn ngồi thuyền đó. Thường ngày tôi quen lướt sóng độ khó cao rồi, thay đổi khẩu vị cho mới mẻ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470110,
						150470111
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470110,
					"content": "Tôi cũng lái Thuyền Gió đến phát chán rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470112
					]
				},
				{
					"id": 150470112,
					"content": "Woa... Ăn ý quá luôn á! Chắc chắn đây là bằng chứng cho sự gắn kết của chúng ta rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470113
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470113,
					"content": "Tôi không đợi được nữa rồi, phải bơm căng khí cho bộ đồ bơi rồi nhảy lên thuyền thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470111,
					"content": "Để tôi gửi tín hiệu cho.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470112
					]
				}
			]
		},
