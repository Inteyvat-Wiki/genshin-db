			"dialogs": [
				{
					"id": 752190101,
					"content": "#A... Bên đó, là {NICKNAME} đúng không? Xin hãy dừng bước!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190102
					],
					"speakerTitle": "Huqiru"
				},
				{
					"id": 752190102,
					"content": "Ở đây có...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190103
					],
					"speakerTitle": "Huqiru"
				},
				{
					"id": 752190103,
					"content": "Ồ, sao vậy? Có chuyện gì cần giúp đỡ à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752190104,
					"content": "Haha, không phải, các vị có một bưu phẩm chuyển phát nhanh. Thật trùng hợp, tôi còn đang nghĩ phải đi đâu tìm các vị đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190105
					],
					"speakerTitle": "Huqiru"
				},
				{
					"id": 752190105,
					"content": "Và các vị đã xuất hiện trước mặt tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190106
					],
					"speakerTitle": "Huqiru"
				},
				{
					"id": 752190106,
					"content": "Ồ, là ai gửi đến vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752190107,
					"content": "À, bưu phẩm này đã trải qua một hành trình dài, được chuyển giao nhiều lần mới có thể từ Hiệp Hội Nhà Mạo Hiểm chuyển đến chỗ bưu tá Dòng Dõi Vườn Treo đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190108
					],
					"speakerTitle": "Huqiru"
				},
				{
					"id": 752190108,
					"content": "Dù sao thì tình hình Natlan dạo này cũng khá đặc biệt, thương đội cũng ngừng hoạt động một khoảng thời gian rồi. Tôi không thấy viết tên người gửi, nhưng xem chữ ký thì... hình như là đến từ Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190109
					],
					"speakerTitle": "Huqiru"
				},
				{
					"id": 752190109,
					"content": "Xem ra hai vị cũng có nhiều bạn bè ở Fontaine đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190110,
						752190111
					],
					"speakerTitle": "Huqiru"
				},
				{
					"id": 752190110,
					"content": "Vậy thì tôi xin nhận nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752190112
					]
				},
				{
					"id": 752190112,
					"content": "Đúng là Hỏa Thần phù hộ, vừa mới nhận được chuyển phát nhanh là đã tìm thấy người nhận hàng ngay. Vậy là công việc hôm nay đã có một khởi đầu tốt đẹp rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190113
					],
					"speakerTitle": "Huqiru"
				},
				{
					"id": 752190113,
					"content": "Được rồi, tôi đi giao những bưu phẩm khác đây, chúc các vị mọi việc đều thuận lợi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190114
					],
					"speakerTitle": "Huqiru"
				},
				{
					"id": 752190114,
					"content": "Ừm, công việc thuận lợi nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752190115,
					"content": "Gửi từ Fontaine đến... Trông có vẻ khá nhẹ, nhìn nó giống một bức thư hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752190116,
					"content": "Chúng ta mau mở ra xem thử đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752190117,
					"content": "Ồ, là do Charlotte gửi đến. Ừm, hóa ra là ảnh chụp lúc rời khỏi Fontaine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752190118,
					"content": "Rõ ràng mới chụp cách đây không lâu, nhưng lại cảm thấy như đã qua rất lâu rồi vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752190119,
					"content": "Hihi, chúng ta cất kỹ tấm ảnh này thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752190111,
					"content": "Ừm, cứ giao cho tôi là được!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752190112
					]
				}
			]
		}
	]
