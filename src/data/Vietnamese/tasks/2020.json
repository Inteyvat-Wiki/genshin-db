					"Raiden Shogun"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20200501,
					"content": "Cô thua rồi, Ei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200502
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200502,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200503
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200503,
					"content": "...Đúng vậy, tôi đã thua rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200504
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200504,
					"content": "Tại sao cô không tin tưởng vào thần dân, tin tưởng vào sức mạnh nguyện vọng của họ chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200505
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200505,
					"content": "Những nguyện vọng đó đã vượt qua khoảng cách, vượt qua không gian và thời gian, đã không còn thứ gì có thể ngăn cản rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200506,
						20200507,
						20200508
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200506,
					"content": "Khi mọi người đã toàn tâm hợp lực...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200509
					]
				},
				{
					"id": 20200509,
					"content": "Đây là thứ mà bạn đã đúc kết được từ Liyue sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200510
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200510,
					"content": "Đúng vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200511
					]
				},
				{
					"id": 20200511,
					"content": "Một quốc gia luôn hướng về phía trước, bỏ thần linh lại phía sau sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200512
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200512,
					"content": "Vậy thì tại sao chúng ta lại từ bỏ việc cùng nhau tiến về phía trước chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200513
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200513,
					"content": "...Tiến về phía trước đã lấy đi của chúng ta những gì, tôi và cô đều đã từng chứng kiến qua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200514
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200514,
					"content": "Chỉ có vĩnh hằng, chỉ có vĩnh hằng mới có thể...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200515
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200515,
					"content": "Thiên Lý... đối với tôi mà nói là một thứ không ra gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200516
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200516,
					"content": "Nhìn chung thì cô chỉ muốn mãi mãi bảo vệ cho Inazuma yêu dấu, đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200517
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200517,
					"content": "Những gì cô nói nghe có vẻ nhẹ nhàng quá nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200518
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200518,
					"content": "Nhưng quốc gia này, có phải có giá trị tồn tại của vĩnh hằng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200519
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200519,
					"content": "Mất đi nguyện vọng, mất đi sự đổi mới, chỉ là một quốc gia đang tồn tại, đó chỉ là một cái vỏ rỗng mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200520
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200520,
					"content": "Nếu đã như vậy, thì cho dù diệt vong thì cũng có làm sao chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200521
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200521,
					"content": "Miko, rút lời ngông cuồng đó lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200522
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200522,
					"content": "Một sự vĩnh hằng bất biến trải dài thiên thu vạn thế, chính là lời hứa của tôi đối với thần dân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200523
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200523,
					"content": "Nhưng thứ mà thần dân của cô muốn, không phải là lời hứa của cô, thứ mà họ muốn chính là \"sự dõi theo\" của cô đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200524
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200524,
					"content": "...Vision sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200525
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200525,
					"content": "Tuổi thọ của con người chỉ có trăm năm, họ sẽ không đủ sức để gánh vác những thứ đã mất đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200526
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200526,
					"content": "Người đã trải qua tất cả như tôi, mới có thể soi sáng đường cho họ đến với \"vĩnh hằng\" chân chính.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200527
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200527,
					"content": "Haiz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200528
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200528,
					"content": "...Nhưng mà \"vĩnh hằng\" đối với cô mà nói, thật quá tàn nhẫn đấy Ei à.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200529
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200529,
					"content": "Đối với tôi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200530
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200530,
					"content": "Cô không những không dõi theo thần dân, cũng đã không dõi theo chính bản thân mình nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200531
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200531,
					"content": "Mấy trăm năm nay, chỉ một mình cô ngồi ở đây, hẳn là rất cô đơn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200532
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200532,
					"content": "Điều này là cần thiết...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200533
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200533,
					"content": "Nếu không tiến về phía trước, thì sẽ bỏ lỡ rất nhiều thứ... Cô tồn tại trong vĩnh hằng, không phải cũng đã mất đi rất nhiều thứ sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200534
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200534,
					"content": "Rõ ràng cô đang rất cô độc, nhưng lại chỉ vì bảo vệ cho sự \"vĩnh hằng\" mà tự mình kéo dài quãng thời gian đó đến vô hạn sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200535
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200535,
					"content": "Nói cho tôi nghe, bầu trời nơi đây từng rất u ám... tại sao bây giờ lại tràn đầy ánh sáng chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200536
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200536,
					"content": "Đây là \"Nhất Tâm Tịnh Thổ\" của cô, là thế giới nội tâm của cô.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200537
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200537,
					"content": "Thực ra... cô đã rất vui khi gặp lại tôi, cô đã sớm không thể chịu đựng được sự cô độc này rồi đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200538
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200538,
					"content": "Tôi... không còn gì để nói.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200539
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200539,
					"content": "Nhưng tôi lại có rất nhiều chuyện muốn nói với cô. À đúng rồi, để tôi kể những chuyện đã xảy ra trong mấy trăm năm nay cho cô nghe nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200540
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200540,
					"content": "Chuyện của mấy trăm năm, phải kể bao lâu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200541
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200541,
					"content": "Trí nhớ của hồ ly tốt lắm, mỗi một câu chuyện trong mấy trăm năm nay tôi đều không quên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200542
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200542,
					"content": "Cho nên có lẽ cần phải kể mấy trăm năm đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200543
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200543,
					"content": "Hahaha... Miko, tôi vốn tưởng rằng đã không còn cơ hội để gặp lại cô rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200544
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200544,
					"content": "Gặp lại cô, có thể nói đây là biến số của vĩnh hằng... nhưng cũng rất vui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200545
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200545,
					"content": "Hì, nếu cô đã thành thật như vậy rồi, vậy thì chúng ta vẫn là bạn tốt của nhau nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200546
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200546,
					"content": "Trông cô thật trẻ con.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200547
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200547,
					"content": "Nhưng mà, nếu như tôi đã thua kế hoạch của mọi người, vậy thì tôi cũng sẽ thuận theo ý nguyện, phế bỏ Lệnh Truy Lùng Vision.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200548
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200548,
					"content": "Nhưng đối với vĩnh hằng, đối với sự đổi mới của quốc gia này, tôi sẽ phải tiếp tục suy nghĩ thêm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200549
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200549,
					"content": "Hầy, người tính khí trẻ con trước giờ luôn là cô đấy Ei à.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200507,
					"content": "Sẽ có thể vượt qua sức tưởng tượng của thần linh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200509
					]
				},
				{
					"id": 20200508,
					"content": "Thậm chí còn có thể làm thay công việc của thần.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200509
					]
				}
			]
		},
