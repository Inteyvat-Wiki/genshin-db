				{
					"id": 20210103,
					"content": "Chủ yếu là do công lao của Yae Miko.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210105
					]
				},
				{
					"id": 20210105,
					"content": "Ồ, vậy sao... tôi lo lắng quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20210106,
					"content": "Vậy lần này Miko tìm chúng ta, không lẽ là để cảm ơn sao? Hihi... chúng ta mau đi tìm cô ấy đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20210104,
					"content": "Là nguyện vọng của mọi người đã được truyền đạt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
