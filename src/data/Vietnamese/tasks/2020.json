			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Raiden Shogun"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20200301,
					"content": "Để ta nghĩ xem, chuyện gì đã khiến ngươi quay trở lại đây gặp ta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200302
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200302,
					"content": "Sự liều lĩnh của ngươi, là để bảo vệ dân chúng, hay chỉ là... do muốn gặp được ta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200303,
						20200304
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200303,
					"content": "Fatui đã giật dây Raiden Shogun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200305
					]
				},
				{
					"id": 20200305,
					"content": "Gọi ta từ trong cõi vĩnh hằng ra đây, không lẽ chỉ là để nói những thứ này thôi sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200306
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200306,
					"content": "Ngươi đang xem thường ta sao. Chuyện Truy Lùng Vision ta đương nhiên là biết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200307
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200307,
					"content": "Cô biết được mọi chuyện bên ngoài sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200308
					]
				},
				{
					"id": 20200308,
					"content": "Không hẳn, chuyện ta biết chỉ liên quan đến \"vĩnh hằng\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200309
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200309,
					"content": "Bao gồm cả việc ban bố Lệnh Truy Lùng Vision, cũng do ta phê chuẩn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200310
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200310,
					"content": "Còn những việc của Fatui gây ra, chưa uy hiếp đến sự vĩnh hằng, nếu không... bọn chúng đã sớm bị quét sạch rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200311,
						20200312
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200311,
					"content": "Nhưng Lệnh Truy Lùng Vision...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200313
					]
				},
				{
					"id": 20200313,
					"content": "Nguyện vọng vốn là thứ gây bất lợi cho vĩnh hằng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200314
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200314,
					"content": "Ngươi hẳn là không để ý được, theo đuổi nguyện vọng... sẽ luôn khiến người ta mất đi nhiều thứ hơn chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200315
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200315,
					"content": "Vả lại, chuyện thu hồi Vision cũng sẽ không khiến ai phải bỏ mạng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200316
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200316,
					"content": "Kẻ mất đi sinh mạng, không phải là những tên cố chấp theo đuổi nguyện vọng sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200317
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200317,
					"content": "Teppei...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200318
					]
				},
				{
					"id": 20200318,
					"content": "Nhà lữ hành, ngươi là một sự tồn tại đặc biệt trong mắt ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200319
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200319,
					"content": "Trên người ngươi có vô số điều bất ổn, nói cách khác, khoảng cách của ngươi với \"vĩnh hằng\" là xa nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200320
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200320,
					"content": "Cho nên, ta không yêu cầu ngươi phải hiểu, ta chỉ thay thiên hạ nhân gian thi hành con đường của \"vĩnh hằng\" mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200321
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200321,
					"content": "Đây là \"Nhất Tâm Tịnh Thổ\" của cô sao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200322
					]
				},
				{
					"id": 20200322,
					"content": "Đây là không gian cấu tạo từ ý thức của cô, đúng chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200323
					]
				},
				{
					"id": 20200323,
					"content": "Đúng vậy, ngươi hiểu cũng khá rõ đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200324
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200324,
					"content": "Hừm, ngươi đang tìm... một cơ hội để làm ta lung lay ý chí, đúng chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200325
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200325,
					"content": "Tôi không muốn tranh luận với cô.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200326
					]
				},
				{
					"id": 20200326,
					"content": "Tôi sẽ trực tiếp \"bác bỏ\" lập luận của cô.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200327
					]
				},
				{
					"id": 20200327,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200328
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200328,
					"content": "Được rồi, \"kẻ chống lại vĩnh hằng\", hãy cho ta xem... sự giác ngộ của ngươi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200312,
					"content": "Đã khiến người dân mất đi rất nhiều.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200313
					]
				},
				{
					"id": 20200304,
					"content": "Lệnh Truy Lùng Vision không nên được ban bố.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200305
					]
				}
			]
		},
		{
			"id": 202005,
