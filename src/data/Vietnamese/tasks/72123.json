					"Hideaki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721230501,
					"content": "Hừm, thì ra là ngươi muốn cản trở ta kiếm tiền.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230502
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230502,
					"content": "Các ngươi đúng là không biết tốt xấu, dám động đến cả Lôi Anh Đào, Miko đại nhân sẽ không tha cho các ngươi đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230503
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230503,
					"content": "Bớt khoác lác đi, các ngươi cũng không xem mình đã động đến ai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230504
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230504,
					"content": "Kẻ cản trở chuyện làm ăn của chúng ta là bọn Nhà Lữ Hành kia, nếu không ra tay thì công việc kinh doanh của chúng ta sẽ tiêu tùng mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230505
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230505,
					"content": "Haha, thân thể yếu ớt này mà cũng dám ra oai trước mặt ta sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Đội Tiên Phong Fatui"
				}
			]
		},
