				"objectNames": [
					"Miyuki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721230401,
					"content": "Lôi Anh Đào thế nào rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230402
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230402,
					"content": "Đã xử lý hết \"tiểu xảo\" của Đạo Bảo Đoàn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230403
					]
				},
				{
					"id": 721230403,
					"content": "Rất tốt, vậy thì tình trạng của Lôi Anh Đào cũng sẽ ổn định lại, Miko đại nhân cũng sẽ yên tâm hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230404
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230404,
					"content": "Những kẻ to gan đó dám đánh cắp sức mạnh của Lôi Anh Đào để trục lợi, đúng là không thể tha thứ được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230405
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230405,
					"content": "Và bạn nói trong doanh trại Đạo Bảo Đoàn có một kết tinh hội tụ sức mạnh của Lôi Anh Đào? Quá nguy hiểm, nhất định phải xử lý thật nhanh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230406
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230406,
					"content": "Trước đây đã làm phiền bạn quá nhiều, lần này tôi không thể để bạn hành động một mình nữa, tôi cũng sẽ đi cùng để xử lý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230407
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230407,
					"content": "Việc không thể chậm trễ, chúng ta đi thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Miyuki"
				}
			]
		},
		{
			"id": 7212305,
			"completionStepIds": [
				7212315
			],
