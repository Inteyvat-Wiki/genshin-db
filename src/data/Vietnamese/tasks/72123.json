					"Miyuki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721230701,
					"content": "Đừng...đừng đuổi theo nữa, chạy ba vòng rồi vẫn quay về chỗ cũ, ta thật sự không chạy nổi nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230702
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230702,
					"content": "Vì lợi ích mà cấu kết với người ngoài, các ngươi thật độc ác! Dù có phải chạy thêm 10 vòng ta cũng sẽ không tha cho ngươi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230703
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230703,
					"content": "Phù...Nhà Lữ Hành, trông bạn có vẻ nhẹ nhõm, rắc rối lúc nãy giải quyết xong rồi đúng không, cảm ơn bạn đã giúp tôi nhiều việc như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230704
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230704,
					"content": "Sức mạnh của Lôi Anh Đào tuyệt đối không thể để rơi vào tay loại người đó, huống hồ còn có Fatui đứng sau chuyện này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230705
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230705,
					"content": "Rất khó đoán được rốt cuộc bọn Fatui muốn chơi trò gì, tóm được tên kia tôi nhất định phải hỏi cho rõ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230706
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230706,
					"content": "Việc còn lại cứ giao cho tôi, nơi Quân Shogunate đóng quân tôi biết, tên xấu xa này chạy không thoát đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Miyuki"
				}
			]
		},
