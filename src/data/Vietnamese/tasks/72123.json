			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hideaki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721230204,
					"content": "Đừng, đừng giết ta, chuyện Lôi Anh Đào không liên quan gì đến ta cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230205
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230205,
					"content": "Sao ngươi biết bọn ta đến vì chuyện Lôi Anh Đào? Ngươi thực sự đã làm sai chuyện gì đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721230206,
					"content": "Có lẽ những thứ giống Lôi Nguyên Bản cũng là có được bằng thủ đoạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721230207,
					"content": "Ta...các ngươi...chuyện này thì liên quan gì đến các ngươi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230208
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230208,
					"content": "Ta nhận ủy thác của người khác.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230209
					]
				},
				{
					"id": 721230209,
					"content": "Đúng, bọn ta nhận ủy thác của người khác, hành động vì công lý! Đạo Bảo Đoàn rốt cuộc đã làm gì với Lôi Anh Đào, thứ này từ đâu mà có, mau khai thật đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721230210,
					"content": "Nếu không ngoan ngoãn nói ra, hừm, kiếm của Nhà Lữ Hành rất lợi hại đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721230211,
					"content": "Ta nói ta nói! Mấy cây này dù sao cũng không ai chăm sóc, ta dẫn anh em đến mượn sức mạnh của chúng kiếm chác chút ít có sao chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230212
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230212,
					"content": "Có một người mua có hứng thú với Lôi Anh Đào, họ còn cung cấp cả công cụ và chỉ cách lấy được sức mạnh của Lôi Anh Đào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230213
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230213,
					"content": "Chỉ cần bọn ta làm theo lời họ, rạch một vết trên cây, hihi, rồi nhẹ nhàng dùng công cụ hút lấy sức mạnh của Lôi Anh Đào là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230214
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230214,
					"content": "Sau đó đổ sức mạnh vào kết tinh này là bọn ta có thể kiếm được bảo bối bằng ba tòa nhà của Hiệp Hội Tenryou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230215
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230215,
					"content": "Người mua đưa ra một số tiền rất lớn, loại tiểu tốt như ngươi cả đời cũng tiêu không hết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230216
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230216,
					"content": "Nếu ngươi chịu thả ta ra, ta sẽ chia cho ngươi một phần, ngươi một ta chín. Thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230217,
						721230218
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230217,
					"content": "Có ít quá không.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230219
					]
				},
				{
					"id": 721230219,
					"content": "Cái gì? Đáng ghét, ta đã tốt bụng cho ngươi đường sống, đợi người mua đến, các ngươi sẽ phải khóc lóc van xin Hideaki ta tha thứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230220
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230220,
					"content": "Khẩu khí cũng lớn nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721230221,
					"content": "Đồ nhãi nhép, kiêu ngạo gì chứ, anh em ta sẽ dẫn người đến cứu ta ngay thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230222
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230222,
					"content": "Các ngươi có kéo cả trăm người đến cũng chưa chắc động được đến một sợi tóc của Paimon ta đâu, Nhà Lữ Hành sẽ xử lý hết các ngươi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721230223,
					"content": "Yamada, con nhóc này nói các ngươi không làm gì được nó, còn không ra tay đi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230224
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230224,
					"content": "Yamada? Là ai vậy...tiêu rồi! Nhà Lữ Hành, mau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721230225,
					"content": "Hả? Chẳng có ai mà nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721230218,
					"content": "Đang nằm mơ à.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230219
					]
				}
			]
		},
		{
			"id": 7212303,
			"completionStepIds": [
				7212306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7212306",
							"2"
						],
						"stepId": 7212306,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Miyuki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721230301,
					"content": "Bạn có phát hiện ra gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230302
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230302,
					"content": "Về Hideaki...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230303
					]
				},
				{
					"id": 721230303,
					"content": "Có chuyện như vậy sao? Nhưng chút thủ đoạn của bọn Đạo Bảo Đoàn lại có thể gây ra hậu quả nghiêm trọng như vậy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230304
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230304,
					"content": "Lôi Anh Đào khô héo nói không chừng còn có lý do khác...Tôi có một số phỏng đoán, không biết có đúng không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230305
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230305,
					"content": "Nói vậy có nghĩa là sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230306
					]
				},
				{
					"id": 721230306,
					"content": "Nơi đây là Kannazuka, dù là tín ngưỡng của người Inazuma hay Sangonomiya, thì cũng đều không thể soi sáng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230307
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230307,
					"content": "Sau khi ban bố lệnh truy lùng, quân Shogunate và phản quân thường xảy ra xung đột ở đây, người của quân đội cũng không quan tâm có ảnh hưởng đến Lôi Anh Đào hay không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230308
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230308,
					"content": "Như Miko đại nhân nói, đó đều là \"người có công\", không thể giảng đạo lý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230309
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230309,
					"content": "Đền của chúng tôi đã chuẩn bị tinh thần cho việc này từ lâu rồi, nhưng tôi không ngờ tình trạng của Lôi Anh Đào lại tồi tệ đến vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230310
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230310,
					"content": "Tóm lại, ưu tiên hàng đầu là phải xử lý gọn gàng tiểu xảo của bọn Đạo Bảo Đoàn, Nhà Lữ Hành, tôi có thể nhờ bạn lần nữa không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230311,
						721230313
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230311,
					"content": "Không thành vấn đề.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230312
					]
				},
				{
					"id": 721230312,
					"content": "Tuyệt đối không được lơ là, vì Lôi Anh Đào mỏng manh nên rất nguy hiểm, dưới cây còn có đại nhân trấn thủ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230315
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230315,
					"content": "À mà không nên nói nhiều, bạn, xem như tôi chưa nói gì đi. Tóm lại, nhất định phải cẩn thận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230316
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230316,
					"content": "Tôi cũng cần một chút thời gian để giải quyết tình hình. Dù sao thì vấn đề này cũng vẫn còn điểm nghi ngờ: rốt cuộc ai là người đứng sau Đạo Bảo Đoàn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230317
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230317,
					"content": "Mọi chuyện ngày càng phức tạp, đúng là khó giải quyết...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230313,
					"content": "Xử lý cũng dễ thôi mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230314
					]
				},
				{
					"id": 721230314,
					"content": "E là không đơn giản, vì Lôi Anh Đào mỏng manh nên rất nguy hiểm, dưới cây còn có đại nhân trấn thủ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230315
					],
					"speakerTitle": "Miyuki"
				}
			]
		},
		{
			"id": 7212304,
			"completionStepIds": [
				7212314
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
