			},
			"dialogs": [
				{
					"id": 721230602,
					"content": "Xui xẻo, đụng phải thứ gì đây chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230603
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230603,
					"content": "Bọn người vô liêm sỉ các ngươi, dám cấu kết với Fatui, sự trừng phạt của Narukami đại nhân sớm muộn gì cũng sẽ giáng xuống đầu các ngươi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230604
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230604,
					"content": "Đừng, đừng tưởng các ngươi có thể lừa ta, cản trở việc làm ăn của ta mà còn muốn kéo cả ta vào, không có cửa đâu! Ta còn một chiêu cuối.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hideaki"
				}
			]
		},
		{
