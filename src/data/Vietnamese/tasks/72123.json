				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721230901,
					"content": "Nói vậy, chắc bạn biết vị trí của Lôi Anh Đào nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230902
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230902,
					"content": "...Nhìn phản ứng của bạn, tôi biết, chắc bạn vẫn chưa biết vị trí của Lôi Anh Đào. Cũng khó trách, dù gì bạn cũng là Nhà Lữ Hành từ nơi khác đến, nên đó là điều đương nhiên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230903
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230903,
					"content": "Năm cây Lôi Anh Đào đó không khó tìm, chỉ cần đi dọc theo <color=#00E1FFFF>bờ biển phía tây</color>, <color=#00E1FFFF>từ cực bắc</color> của hòn đảo nơi doanh Trại Kujou tọa lạc đến <color=#00E1FFFF>cực bắc của Tatarasuna</color> là sẽ thấy được 3 cây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230904
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230904,
					"content": "Hai cây còn lại, một cây mọc trên vách núi ở <color=#00E1FFFF>phía tây bắc Tatarasuna</color>, một cây mọc ở trên vách núi ở <color=#00E1FFFF>phía tây nam Tatarasuna</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230905
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230905,
					"content": "Bây giờ tôi đã chỉ hướng đi cho bạn, mọi thứ sẽ dễ dàng hơn. Vậy thì chuyện của Lôi Anh Đào nhờ bạn nhé, nhớ cẩn thận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Miyuki"
				}
			]
		}
