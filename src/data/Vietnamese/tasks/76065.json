					}
				]
			},
			"dialogs": [
				{
					"id": 760650101,
					"content": "Đến rồi à.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650102
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650102,
					"content": "Không ngờ Columbina lại ở đây.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650103
					]
				},
				{
					"id": 760650103,
					"content": "#Ừm, giờ {F#cô}{M#cậu} cũng đến rồi, vậy nên, chúng ta đều ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650104
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650104,
					"content": "Nói như thể cô biết tôi sẽ đến vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650105
					]
				},
				{
					"id": 760650105,
					"content": "#Tôi không biết là khi nào, nhưng rồi {F#cô}{M#cậu} cũng sẽ đến thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650106
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650106,
					"content": "#Giống như giữa mặt trăng và Teyvat luôn tồn tại một lực hấp dẫn liên kết chúng lại với nhau. {F#Cô}{M#Cậu} sẽ luôn tìm được tôi, không phải sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650107
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650107,
					"content": "#Đến đây nào, cùng ngồi xuống đi, tôi đã để dành chỗ cho {F#cô}{M#cậu} rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650108
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650108,
					"content": "#Lần trước trên phi thuyền của {F#cô}{M#cậu}, chúng ta ngắm nhìn Teyvat. Lần này, cùng ngắm nhìn trời sao nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650109
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650109,
					"content": "Ninnin và các tiền bối đã bị thu hút bởi bầu trời đầy sao này. Nơi đó nhất định cũng có lực hấp dẫn khác biệt. Tôi có thể cảm nhận được điều đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650110
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650110,
					"content": "Ninnin và những thông điệp mà cô ấy gửi đi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650111
					]
				},
				{
					"id": 760650111,
					"content": "Đừng lo, cô ấy không gặp nguy hiểm đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650112
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650112,
					"content": "Cô ấy đã an toàn đi được một quãng đường rất xa, xa đến mức tôi không còn cảm nhận được sức mạnh mà mình đã dùng để hộ tống cô ấy nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650113
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650113,
					"content": "Nhưng mà, tôi rất tò mò...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650114
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650114,
					"content": "Tò mò về điều gì thế?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650115
					]
				},
				{
					"id": 760650115,
					"content": "Ừm, nhiều lắm. Chẳng hạn như, thông điệp của Kẻ Quan Sát Mặt Trăng sẽ được người khác tiếp nhận chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650116
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650116,
					"content": "Người nhận được, hoặc những tồn tại khác... họ sẽ là ai nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650117
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650117,
					"content": "Họ sẽ nghĩ gì? Liệu trong lòng họ có cả tình yêu lẫn hận thù giống chúng ta không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650118
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650118,
					"content": "Liệu họ có giống chúng ta, dù bị Vực Sâu bủa vây nhưng vẫn bị bầu trời đầy sao tuyệt đẹp và huyền bí trên cao thu hút không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650119
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650119,
					"content": "Liệu họ có giống chúng ta, cũng muốn tìm kiếm những người khác, rồi vẫy tay chào và nói rằng: \"Chào bạn mới, rất vui được làm quen với bạn\" không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650120
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650120,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650121
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650121,
					"content": "Ở nơi sâu thẳm của bầu trời đầy sao này, liệu còn nền văn minh nào chưa bị bóng tối nuốt chửng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650122
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650122,
					"content": "Tôi nghĩ sẽ có đó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650123
					]
				},
				{
					"id": 760650123,
					"content": "Hửm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650124
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650124,
					"content": "Phi thuyền của chúng tôi, từng nhận được một đoạn thông điệp.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650125
					]
				},
				{
					"id": 760650125,
					"content": "Thông điệp gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650126
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650126,
					"content": "Nội dung hữu ích bị thiếu gần hết.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650127
					]
				},
				{
					"id": 760650127,
					"content": "Nhưng chắc chắn nó thuộc về một nền văn minh trí tuệ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650128
					]
				},
				{
					"id": 760650128,
					"content": "Bị thiếu... Là vì đã đi một chặng đường quá xa sao...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650129
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650129,
					"content": "Nhưng chỉ cần như vậy thôi, cũng đủ khiến người ta vui vẻ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650130
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650130,
					"content": "#À đúng rồi, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650131
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650131,
					"content": "Hửm?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650132
					]
				},
				{
					"id": 760650132,
					"content": "#Quê hương ban đầu của {F#cô}{M#cậu}, cũng ở nơi sâu trong đó phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650133
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650133,
					"content": "#Nếu có một ngày, {F#cô}{M#cậu} muốn quay về nơi bắt đầu hành trình, dọn dẹp nơi đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650134
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650134,
					"content": "#Tôi rất sẵn lòng giúp một tay, giống như {F#cô}{M#cậu} từng giúp tôi dọn dẹp mặt trăng vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650135
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650135,
					"content": "Thế thì tôi sẽ không quên mời cô đâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650136
					]
				},
				{
					"id": 760650136,
					"content": "Mở thêm một bữa tiệc nữa à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650137
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650137,
					"content": "Mở thêm một bữa tiệc nữa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650138
					]
				},
				{
					"id": 760650138,
					"content": "Vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650139
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650139,
					"content": "#Gọi là \"Đêm Trở Về\" đi, {F#cô}{M#cậu} thấy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650140
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650140,
					"content": "Có thể là ban ngày mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650141
					]
				},
				{
					"id": 760650141,
					"content": "Vậy thì chơi từ sáng đến tận đêm khuya. Gọi tất cả những người bạn tốt cùng tham gia nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650142
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650142,
					"content": "Nghe rất vui đấy chứ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650143
					]
				},
				{
					"id": 760650143,
					"content": "Mong rằng đêm đó sẽ đến vào một ngày đẹp trời. Đến trong sự sum họp của những người bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Columbina"
				}
			]
		}
	]
}