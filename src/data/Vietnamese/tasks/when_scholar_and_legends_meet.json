			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Soraya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718220301,
					"content": "Bạn đã đem mẫu về chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220302
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220302,
					"content": "Đã đem về rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718220303
					]
				},
				{
					"id": 718220303,
					"content": "Bạn vất vả rồi, hãy cho tôi xem một chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220304
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220304,
					"content": "...Ừm, Mẫu Đất này hình như không có gì đặc biệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220305
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220305,
					"content": "Bạn muốn có chuyện gì đặc biệt xảy ra sao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718220306
					]
				},
				{
					"id": 718220306,
					"content": "Dựa theo truyền thuyết, Di Tiêu Đạo Thiên Chân Quân để bảo vệ Cảng Liyue, đã dùng chiếc sừng khoẻ mạnh của mình để nâng đỡ Thiên Hoành Sơn sắp sụp đổ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220307
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220307,
					"content": "Tôi còn tưởng, ít nhất sẽ phát hiện một số mảnh \"Sừng\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220308
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220308,
					"content": "Quả nhiên truyền thuyết cũng chỉ là truyền thuyết mà thôi... hoặc là, cuộc đại chiến ấy đã xảy ra cách đây quá lâu, căn bản đã mất hết dấu vết rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220309
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220309,
					"content": "Nhưng có thể thu thập được Mẫu Đất của Thiên Hoành Sơn cũng không tồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220310
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220310,
					"content": "Nhà Lữ Hành, bạn có thể đi cùng tôi một đoạn đường không? Tôi muốn đi lên phía trên, cũng không xa lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220311,
						718220312
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220311,
					"content": "Cứ để tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718220313
					]
				},
				{
					"id": 718220313,
					"content": "Lần này... tôi muốn tới chỗ cao nhìn xuống Thiên Hoành Sơn, quan sát một chút địa hình nơi này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220314
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220314,
					"content": "Trong truyền thuyết, Nham Vương Đế Quân và rất nhiều tiên nhân đều tham gia lần đại chiến đó, còn suýt nữa khiến Thiên Hoành Sơn sụp đổ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220315
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220315,
					"content": "Nếu cuộc chiến khốc liệt đến mức độ đó... Thì có lẽ tôi có thể nhìn ra một số thứ từ địa hình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220312,
					"content": "Bạn lại muốn đi tìm cái gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718220313
					]
				}
			]
		},
		{
			"id": 7182206,
			"completionStepIds": [
				7182206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182206",
							"2"
						],
						"stepId": 7182206,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Soraya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718220601,
					"content": "Cuối cùng cũng đến được đây...con đường này khó đi thật, lại còn nhiều ma vật như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220602
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220602,
					"content": "Địa hình quanh đây... hình như cũng không có gì đặc biệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220603
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220603,
					"content": "Ơ? Cái gì ở trên cây kia, một chiếc đèn tiêu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220604
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220604,
					"content": "Sao ở đây lại có đèn tiêu? Lẽ nào có người đến đây bái tế vị tiên nhân kia rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220605
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220605,
					"content": "Để tôi xem trên đèn viết gì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220606
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220606,
					"content": "\"Vạn thế an khang, thiên hạ thái bình.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220607,
						718220608
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220607,
					"content": "Một nguyện vọng to lớn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718220609
					]
				},
				{
					"id": 718220609,
					"content": "Đúng vậy. Nhưng nguyện vọng này... Nói thế nào nhỉ, có to tát quá không? Không giống bái tế, cũng không giống \"nguyện vọng\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220610
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220610,
					"content": "Nó lại giống như nguyện vọng của các tiên nhân trong truyền thuyết Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220611
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220611,
					"content": "Rốt cuộc là ai đã viết nguyện vọng này lên đèn? Thật kỳ lạ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220612
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220612,
					"content": "Ừm, dù sao thì ít ra cũng có người nhớ đến đây thả đèn tiêu, vị tiên nhân kia chắc cũng sẽ rất vui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220613
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220613,
					"content": "Cảm ơn bạn đã cùng tôi đi xa như vậy, tôi vẫn muốn ở đây nghiên cứu thêm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220614
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220614,
					"content": "Đúng rồi, những thứ này bạn hãy nhận lấy, cứ xem như thù lao vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
