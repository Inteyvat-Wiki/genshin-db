			"trigger": {
				"objectNames": [
					"Soraya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718220101,
					"content": "Thiên Hoành Sơn...Di Tiêu Đạo Thiên Chân Quân...Ừm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220102
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220102,
					"content": "Đang nghĩ gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718220103
					]
				},
				{
					"id": 718220103,
					"content": "À, tôi đang nghiên cứu lịch sử và truyền thống Tết Hải Đăng Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220104
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220104,
					"content": "Tôi nghe nói tạo hình của \"Đèn Minh Tiêu\" lần này sẽ là một vị tiên nhân tên là \"Di Tiêu Đạo Thiên Chân Quân\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220105
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220105,
					"content": "Dựa theo truyền thuyết mà tôi thu thập được, vị tiên nhân đó hình như cũng từng theo Nham Vương Đế Quân chinh chiến ở thời đại nào đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220106
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220106,
					"content": "Tuy có nhiều giả thuyết khác nhau trong các loại sách sử về thời gian cụ thể và danh tính kẻ địch...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220107
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220107,
					"content": "Nhưng theo những giả thuyết ghi chép lưu truyền trong nhân gian, đều nói rằng vị tiên nhân này đã hy sinh rồi. Hơn nữa vị tiên nhân này còn dùng sừng của mình nâng đỡ Thiên Hoành Sơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220108
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220108,
					"content": "Cho nên tôi đến Thiên Hoành Sơn là muốn khảo sát thực địa một chút, thiết nghĩ nếu đủ may mắn, chưa biết chừng có thể tìm thấy gì đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220109
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220109,
					"content": "Nhưng ma vật trong Thiên Hoành Sơn nhiều quá, sau khi tôi xác định địa điểm khảo sát lại phát hiện con đường tới đó toàn là ma vật, căn bản là không thể vượt qua nổi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220110
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220110,
					"content": "Nhà Lữ Hành, nếu bạn đồng ý, có thể giúp tôi qua đó tìm kiếm một chút, rồi mang về một ít \"Mẫu Đất\" được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220111
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220111,
					"content": "Mẫu...Đất?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718220112
					]
				},
				{
					"id": 718220112,
					"content": "Ừm... đây là cách nói trong Giáo Viện, thực ra chính là đất đai thuộc khu vực đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220113
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220113,
					"content": "Tuy trong truyền thuyết Liyue, vị Di Tiêu Đạo Thiên Chân Quân đó dùng sừng của mình nâng đỡ Thiên Hoành Sơn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220114
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220114,
					"content": "Nhưng đứng ở góc độ học thuật mà nói, tôi cho rằng trong thành phần địa chất có lẽ sẽ tồn tại một số thành phần không giống với bình thường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220115
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220115,
					"content": "Vậy nên, bạn hãy giúp tôi tới đó lấy một phần Mẫu Đất về nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				}
			]
		},
		{
			"id": 7182202,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
