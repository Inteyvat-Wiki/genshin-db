					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nasejuna",
					"Sorush",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732560401,
					"content": "Nhìn này, thời khắc của vận mệnh sắp đến rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560402
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560402,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732560403
					]
				},
				{
					"id": 732560403,
					"content": "Hmm, rõ ràng chỉ là một cánh cửa cơ quan bình thường thôi mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732560404,
					"content": "E hèm, ý tôi là chỉ cần mở cửa cơ quan ở đây thì chúng ta sẽ có thể đi vào trong di tích.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560405
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560405,
					"content": "Nghĩ đến chuyện lần đầu đi vào di tích của người Dahri, là lòng tôi có hơi kích động rồi đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560406
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560406,
					"content": "Ơ? Nhìn dáng vẻ tự tin của anh trước đây, tôi còn tưởng anh đã từng khám phá qua rất nhiều di tích rồi chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732560407,
					"content": "À, mặc dù không đích thân thăm dò, nhưng bằng cách nghiên cứu \"Sổ Tay Điều Tra Của Rene\" do học giả cổ đại để lại thì tôi cũng cảm thấy như thể mình đang ở hiện trường vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560408
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560408,
					"content": "\"Sổ Tay Điều Tra Của Rene\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732560409
					]
				},
				{
					"id": 732560409,
					"content": "Mọi người cũng chưa từng nghe nói sao? Tôi còn tưởng chỉ những người sống trong sa mạc như tôi mới không biết danh tiếng của vị học giả này chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560410
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560410,
					"content": "Sổ tay này ghi lại rất nhiều thông tin của Người Dahri. Theo cách nói của tác giả thì người này đã từng tìm thấy kiến thức \"siêu phàm\" trong di tích này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560411
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560411,
					"content": "Sao mà càng nghe càng cảm thấy không đáng tin vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732560412,
					"content": "Tạm thời bỏ qua chuyện này đi. Tóm lại thì với cuốn sổ này trong tay, có thể nói việc đi vào di tích Dahri là chuyện nhỏ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560413
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560413,
					"content": "Nếu không tin thì chúng ta có thể kiểm chứng trước! Ví dụ như nếu muốn phá giải cơ quan ở đây thì... Ừm, tìm thấy rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560414
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560414,
					"content": "<color=#00E1FFFF>\"Xoay bánh răng để hiển thị cả ba biểu tượng, kết nối hình chữ nhật với biểu tượng hình tam giác ở đáy mà không thay đổi hình tam giác đó\"</color>, tóm lại cứ làm thử theo tôi nói là được.",
					"roleType": "TALK_ROLE_NPC",
