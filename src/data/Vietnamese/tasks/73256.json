			"dialogs": [
				{
					"id": 732562401,
					"content": "Quả đúng là sứ giả đại nhân và Yasnapati của người, dù là cơ quan của Dahri hay là ma vật của Dev đều không thể cản đường mọi người tiến bước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562402
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562402,
					"content": "Ơ? Nasejuna, anh vào đây từ khi nào vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732562403,
					"content": "Tôi luôn ở ngoài này chiêm ngưỡng tư thế chiến đấu anh dũng của mọi người! Nhìn thấy mọi người đã có được Thánh Ca Khvarena nên tôi liền theo vào thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562404
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562404,
					"content": "Mọi người cực khổ rồi, hay là giao Thánh Ca Khvarena cho tôi giữ đi. Nếu vậy thì, nói sao đây nhỉ, sẽ khiến tôi có cảm giác tham gia hơn chăng?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562405
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562405,
					"content": "Nhưng anh vốn đâu có góp sức gì nhiều đâu. Zurvan cũng từng dặn dò chúng tôi là không nên tùy tiện giao Thánh Ca Khvarena cho người khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732562406,
					"content": "Không thể nói vậy được. Hơn nữa tôi đã tìm hiểu nhiều về Thánh Ca Khvarena rồi, hay là để tôi nghiên cứu trước nhé, vậy thì sẽ tiện cho những chuyện sau này hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562407
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562407,
					"content": "Ví dụ như việc tại sao Thánh Ca Khvarena lại được giấu ở bên dưới những di tích này chẳng hạn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562408
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562408,
					"content": "Bây giờ không phải là lúc kể chuyện đâu, Nasuraia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562409
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732562409,
					"content": "Đúng vậy, chúng ta nên nhanh chóng đến nơi giấu Khvarena Lớn tiếp theo nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732562410,
					"content": "Đợi khi thu thập đủ toàn bộ Khvarena Lớn rồi nghe anh kể chuyện cũng chưa muộn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732562411,
					"content": "Vậy... cũng được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nasejuna"
				}
			]
