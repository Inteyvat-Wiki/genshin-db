			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nasejuna",
					"Sorush"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732560601,
					"content": "Xem ra cuối cùng chúng ta cũng đến được trung tâm của di tích rồi, vậy thì để tôi, người có nhiều nghiên cứu về di tích Dahri nhất giải thích cho mọi người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560602
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560602,
					"content": "Theo ghi chép thì nơi này ban đầu là cơ sở thử nghiệm, để người Dahri nghiên cứu và kiểm tra hiệu suất của các cơ quan. Thánh Ca Khvarena nằm ở nơi thử nghiệm sâu nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560603
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560603,
					"content": "Nếu muốn đến đó thì trước hết...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560604
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560604,
					"content": "Lúc nãy còn nói là mình có nghiên cứu, bây giờ lại ngang nhiên lật sách!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732560605,
					"content": "Dù sao thì kết cấu di tích nơi này cũng quá phức tạp. Những thiết bị thần bí mà người Dahri thiết lập, tôi nghĩ không ai có thể không xem mô tả mà nói rõ được nguyên lý vận hành của nó đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560606
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560606,
					"content": "Để tôi xem... Ừm, hiểu rồi. Xem ra chỗ chúng ta đang đứng là trung tâm điều khiển của cả cơ sở thử nghiệm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560607
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560607,
					"content": "Muốn đến chỗ Thánh Ca Khvarena thì phải khởi động cả hệ thống điều khiển của di tích mới được. Để khởi động hệ thống điều khiển, phải giải quyết vấn đề về nguồn năng lượng trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560608
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560608,
					"content": "Mặc dù nghe nói người Dahri sẽ dùng sức mạnh ô uế để điều khiển cơ quan và ma vật, nhưng di tích này hình như không dùng sức mạnh ô uế để làm nguồn năng lượng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560609
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560609,
					"content": "Ngược lại là vận hành bằng một nguồn năng lượng được gọi là vật chất Azosite. Chúng được lấy từ năng lượng nguyên tố thuần túy và ngưng tụ thành khối.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560610
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560610,
					"content": "Nói cách khác, chỉ cần có thể tìm được Khối Năng Lượng này là sẽ có thể cung cấp năng lượng cho phần lõi, những vấn đề còn lại cũng có thể dễ dàng giải quyết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560611
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560611,
					"content": "Nghe có vẻ rắc rối, nếu có thể giải quyết bằng chiến đấu thì tốt quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560612
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732560612,
					"content": "Vậy thì chúng ta bắt đầu đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732560613
					]
				},
				{
					"id": 732560613,
					"content": "Ồ, tràn đầy năng lượng, không hổ danh là Yasnapati của sứ giả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560614
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560614,
					"content": "Nếu vậy thì việc tìm Khối Năng Lượng giao cho các vị nhé. Đây là bản đồ vẽ lại kết cấu của cơ sở thử nghiệm, tôi nghĩ mọi người sẽ cần dùng đến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560615
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560615,
					"content": "Tôi còn có việc phải nghiên cứu, tôi sẽ ở đây chờ mọi người quay lại. Có sứ giả đi cùng mọi người, chắc chắn là bất khả chiến bại rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560616
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560616,
					"content": "Có vấn đề gì thì cứ nghiên cứu bản đồ nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nasejuna"
				}
			]
		},
