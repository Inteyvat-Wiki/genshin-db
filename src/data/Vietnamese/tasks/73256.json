			},
			"dialogs": [
				{
					"id": 732561201,
					"content": "Quả nhiên là vấn đề của những thiết bị chuyển tiếp này, động lực do Lõi Năng Lượng truyền ra không truyền được cho chúng, phải tìm cách kết nối chúng với nhau mới được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732561202
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732561202,
					"content": "Hơn nữa những thiết bị chuyển tiếp này đều bị kết tinh phong ấn rồi, nhưng di tích rõ ràng chưa từng sử dụng năng lượng ô uế, lẽ ra không bị Khvarena chú ý mới đúng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732561203
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732561203,
					"content": "Cách giải thích duy nhất chính là, nơi này đã bị người điều khiển được Khvarena cố tình phong tỏa. Nhưng là vì muốn giấu giếm thứ gì chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732561204
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732561204,
					"content": "Hừm, những chuyện này để sau đi. Nhiệm vụ cấp bách bây giờ là dùng sức mạnh của Khvarena để xử lý đống Tinh Thạch Xám đã phong ấn những thiết bị này đã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732561205
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732561205,
					"content": "Ừm... Ở gần đây chắc sẽ có \"Farrwick\" chứa sức mạnh Khvarena, sứ giả đại nhân cũng cảm nhận được nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732561206
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732561206,
					"content": "Ưm... Hừ, đương nhiên rồi, ngươi đang hoài nghi uy lực của dũng sĩ Pari ta đây sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732561207
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732561207,
					"content": "Tôi nào dám chứ, vậy nhờ sứ giả đại nhân dẫn đường cho chúng tôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732561208
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732561208,
					"content": "Chỉ cần tìm thấy Farrwick để xử lý Tinh Thạch Xám, sau đó tiếp tục điều khiển thiết bị hỗn biến để kết nối với các thiết bị chuyển tiếp là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nasejuna"
				}
			]
		},
