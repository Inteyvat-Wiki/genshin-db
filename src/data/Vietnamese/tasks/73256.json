					"nextDialogs": [
						732560713
					]
				},
				{
					"id": 732560714,
					"content": "Cảm thấy quen quen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732560715
					]
				},
				{
					"id": 732560713,
					"content": "Ồ, tràn đầy năng lượng, không hổ danh là Yasnapati của sứ giả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560717
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560715,
					"content": "Đúng vậy, bên trong cỗ máy khổng lồ lúc trước chúng ta từng điều khiển ở Sumeru chẳng phải cũng có thiết bị giống như vậy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732560716,
					"content": "Ồ, không ngờ các vị đã từng tiếp xúc qua với thiết bị này, vậy thì đơn giản rồi.",
