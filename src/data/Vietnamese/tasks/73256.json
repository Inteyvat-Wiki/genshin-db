			"dialogs": [
				{
					"id": 732562001,
					"content": "Dưới đất xuất hiện một khẩu pháo to kỳ lạ, ý là muốn chúng ta bắn cỗ máy khổng lồ ở bên đó sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732562002,
					"content": "Ừm... Thiết kế tâm lý thật đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732562003,
					"content": "Trí tưởng tượng của Bóng Trắng Bay Bay phong phú thật đấy, lúc nãy không phải Nasuraia đã nói rồi sao, nơi này được cải tạo từ nơi thử nghiệm tính năng cơ quan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562004
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732562004,
					"content": "Chắc thiết bị mà chúng ta vừa mở chính là thứ dùng để khởi động nơi thử nghiệm này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562005
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732562005,
					"content": "Tuy đã được cải tạo, nhưng vẫn chưa gỡ bỏ những cơ quan ban đầu, đây xem như đã giúp chúng ta rất nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562006
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732562006,
					"content": "Vậy thì, Yasnapati của ta, nhiệm vụ điều khiển khẩu đại pháo này giao cho ngươi rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sorush"
				}
			]
		},
