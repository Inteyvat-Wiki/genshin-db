			},
			"dialogs": [
				{
					"id": 732562301,
					"content": "Sứ giả đại nhân, và Yasnapati của người, e là tôi chỉ có thể giúp được đến đây thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562302
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562302,
					"content": "Lại sao nữa vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732562303
					]
				},
				{
					"id": 732562303,
					"content": "Theo ghi chép trong văn hiến, con đường tiếp theo đây sẽ đầy nguy hiểm, không phải là thứ mà thân xác phàm nhân này chịu được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562304
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562304,
					"content": "Từ đây đi vào, chính là nơi mà người Dahri xưa dùng để thử nghiệm cơ quan. Trong đó còn có một cơ quan thử nghiệm khổng lồ chưa hoàn thành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562305
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562305,
					"content": "Dựa theo ghi chép của người Dahri xưa, tuy chưa phát huy tác dụng, nhưng nơi đây từng được cải tạo thành công trình phòng thủ để chống ma vật tấn công.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562306
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562306,
					"content": "Rất kỳ lạ phải không, rõ ràng là người Dahri đã kích hoạt tai họa ô uế, nhưng lại tạo ra cơ quan chống lại ma vật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562307
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562307,
					"content": "Nhưng nếu chúng ta đã khởi động hệ thống điều khiển của cả di tích, thì tin chắc cơ quan phòng ngự trong nơi thử nghiệm này cũng đã được khởi động rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562308
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562308,
					"content": "Còn Thánh Ca Khvarena mà chúng ta cần tìm chắc sẽ được giấu trong cỗ máy khổng lồ này. Tuy nó cản bước tiến của tôi, nhưng đối với các vị chắc hẳn sẽ dễ như trở bàn tay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562309
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562309,
					"content": "Vì để thu thập đủ Thánh Ca Khvarena, xin cho phép tôi đợi các vị ở đây nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562310
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562310,
					"content": "Dù sao thì ngươi cũng chỉ là nhân loại mà thôi, yêu cầu này cũng xem như hợp lý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562311
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732562311,
					"content": "Mong người ân chuẩn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562312
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562312,
					"content": "Tuy Nasejuna rút lui giữa đường, nhưng tôi lại cảm thấy nhẹ nhàng hơn nhiều đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
