			"dialogs": [
				{
					"id": 732150201,
					"content": "Xin chào, xin chào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150202
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 732150202,
					"content": "Chào nhóc con! Còn nhớ chúng tôi không!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732150203,
					"content": "Bông Trắng Bay Bay đáng ghét, tôi không phải nhóc con! Các bạn còn nhớ bài hát tôi đã dạy chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150204
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 732150204,
					"content": "Đương nhiên rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732150205
					]
				},
				{
					"id": 732150205,
					"content": "Tốt quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150206
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 732150206,
					"content": "Vậy các bạn phải hứa với tôi, dù tôi có quên bài hát của mình đi nữa... các bạn cũng phải nhớ kỹ nó đấy nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranakin"
				}
			]
		},
