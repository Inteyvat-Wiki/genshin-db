			"dialogs": [
				{
					"id": 732150101,
					"content": "Xin chào, bạn Nara! Ồ... Hình như có gì đó muốn nói với bạn, mà không nhớ nổi, nhưng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150102
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 732150102,
					"content": "Không sao, gặp lại các bạn là chúng tôi vui lắm rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732150103,
					"content": "Ừm, cảm ơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150104,
						732150106
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 732150104,
					"content": "Về \"Mawtiyima\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732150105
					]
				},
				{
					"id": 732150105,
					"content": "Mawtiyima không nói gì nữa, nhưng cô ấy rất khỏe. Cũng đang hồi phục dần, rừng rậm... cảm ơn các bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 732150106,
					"content": "Về chuyện lãng quên...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732150107
					]
				},
				{
					"id": 732150107,
					"content": "Lãng quên...? Ừ, vì đã tiêu hao hết sức lực, \"Kusava\". Nên cũng sẽ trôi đi, trí nhớ. Từng chút từng chút một, giống như giọt sương...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranaga"
				}
			]
		},
