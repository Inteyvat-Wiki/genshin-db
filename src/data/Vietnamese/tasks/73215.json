					"nextDialogs": [
						732150402
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 732150402,
					"content": "Xin chào! Gần đây bạn thế nào rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732150403,
					"content": "Tốt lắm, tại sao lại tới đây, các bạn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150404
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 732150404,
					"content": "Hả...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732150405,
					"content": "Ừm... Thấy thật phiền nhiễu, chúng tôi. Tuy nhất định là có lý do, nhưng tại sao các bạn lại tới, không rõ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150406
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 732150406,
					"content": "Dù sao chúng tôi cũng rất quen thuộc với nơi này, cùng trải qua biết bao chuyến mạo hiểm với các bạn mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732150407,
					"content": "...? Hả... Vậy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150408
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 732150408,
					"content": "Những gì chúng ta đã trải qua trước kia, anh ta không còn nhớ nữa rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
