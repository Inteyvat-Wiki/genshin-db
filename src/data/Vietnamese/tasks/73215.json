			"dialogs": [
				{
					"id": 732150501,
					"content": "Xin chào! Nara Vàng! Cả bạn nữa, bé Bông Trắng Bay Bay!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150502
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 732150502,
					"content": "Hứ, tôi không có nhỏ! Sao bạn không nhìn lại mình đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732150503,
					"content": "Này, tôi cũng không nhỏ! À... đúng rồi, các bạn tới đây làm gì thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150504
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 732150504,
					"content": "Chỉ là quay lại thăm các bạn mà thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732150505
					]
				},
				{
					"id": 732150505,
					"content": "Cũng đúng, dù sao trước kia chúng ta đã cùng đánh bại rất nhiều người xấu, cùng nhau ca hát, cùng nhau cứu \"Ô y a\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732150506,
					"content": "\"Mawtiyima\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150507
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 732150507,
					"content": "Ừ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732150508,
					"content": "Ừm... xin lỗi nhé... chắc hẳn những gì các bạn nói đều là sự thật. Nhưng tôi lại không nhớ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150509
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 732150509,
					"content": "Ừm...! Không sao, không sao đâu! Bạn đừng buồn mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732150510,
					"content": "(Anh ta thật sự không còn nhớ nữa...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
