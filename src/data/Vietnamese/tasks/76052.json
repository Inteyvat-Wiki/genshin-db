			"dialogs": [
				{
					"id": 760520101,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520102
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760520102,
					"content": "Columbina, cô vẫn ổn chứ? Trông cô hơi thiếu sức sống đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520103,
					"content": "Là hai người à. Tôi không sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520104
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760520104,
					"content": "(Lại đang suy nghĩ về vấn đề mặt trăng sao...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520105
					]
				},
				{
					"id": 760520105,
					"content": "Tôi có thể làm gì cho cô không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520106
					]
				},
				{
					"id": 760520106,
					"content": "Tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520107
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760520107,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520108
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760520108,
					"content": "Không sao, dù chỉ là chút phiền muộn nho nhỏ thì nói ra cũng sẽ đỡ hơn đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520109,
					"content": "Tôi có hơi... muốn uống đồ uống ở quán rượu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520110
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760520110,
					"content": "Hả?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520111,
					"content": "...Ừm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520112
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760520112,
					"content": "Xin lỗi! Vừa rồi tôi hơi ngạc nhiên. Vì cô rất ít khi nhắc đến thứ mà cô muốn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520113,
					"content": "Hơn nữa, không ngờ lại chỉ là... đồ uống thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520114,
					"content": "Thấy đơn giản quá hả?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520115
					]
				},
				{
					"id": 760520115,
					"content": "Có thể tôi nghĩ ít nhất cũng phải là điều ước đặc biệt gì đó, kiểu như \"hãy hái mặt trăng xuống cho tôi\" chẳng hạn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520116,
					"content": "À, hình như tôi cũng có thể hiểu được. Bây giờ Columbina không thể hành động theo ý mình, đến quán rượu không chừng cũng khó như đi hái mặt trăng vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520117,
					"content": "Không chỉ bây giờ đâu. Trước đây khi ở trong Fatui, chẳng ai muốn bắt tôi cả, nhưng khi ra ngoài đi dạo thì mọi người vẫn sẽ né ra xa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520118
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760520118,
					"content": "(Quan Chấp Hành thứ ba... Đúng là danh hiệu này sẽ khiến những người không hiểu về cô ấy phải e sợ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520119
					]
				},
				{
					"id": 760520119,
					"content": "Ể? Nhưng mà... tự nhiên tôi thấy nguyện vọng này cũng không khó khăn lắm đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520120,
					"content": "#Nếu chỉ yêu cầu đồ uống kiểu quán rượu thì {NICKNAME} cũng biết làm mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520121,
					"content": "...Thật sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520122
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760520122,
					"content": "Nhìn dáng vẻ mong chờ của cô, ngược lại làm tôi thấy căng thẳng đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520123,
					"content": "Có yêu cầu gì về khẩu vị không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520124
					]
				},
				{
					"id": 760520124,
					"content": "Khẩu vị...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520125
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760520125,
					"content": "Tôi chưa từng thử đồ uống ở bên ngoài, nên không thể đưa ra yêu cầu cụ thể...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520126
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760520126,
					"content": "Không được quá nặng đô?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520127
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760520127,
					"content": "Nặng đô là sao nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520128,
					"content": "Giống như áo khoác của Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520129
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760520129,
					"content": "Sao càng so sánh càng mơ hồ thế!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520130,
						760520131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520130,
					"content": "Chắc là muốn loại đồ uống nhẹ nhàng nhỉ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520132
					]
				},
				{
					"id": 760520132,
					"content": "#Được thôi. Cho {F#cô}{M#cậu} chọn đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760520131,
					"content": "Cứ giao cho tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520132
					]
				}
			]
		},
