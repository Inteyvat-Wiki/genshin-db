					"Bertrand"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726950201,
					"content": "Ừm... Nếu Máy Thu Thập Nguyên Liệu mỗi hoàn thành một bước là phải đổ nguyên liệu vào máy, mỗi lần chế tạo phải lặp lại ba lần, thì việc thu thập nguyên liệu sẽ trở nên quá rắc rối.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950202
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950202,
					"content": "Tôi phải nghĩ ra cách để cải thiện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bertrand"
				}
			]
		},
		{
			"id": 7269503,
			"completionStepIds": [
				7269503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7269503",
							"2"
						],
						"stepId": 7269503,
						"stateName": "QUEST_STATE_UNFINISHED"
