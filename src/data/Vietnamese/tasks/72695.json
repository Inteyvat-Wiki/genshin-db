			"trigger": {
				"objectNames": [
					"Bertrand"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726950101,
					"content": "Bertrand!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726950102,
					"content": "#{NICKNAME} và Paimon đó à, đến đúng lúc lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950103
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950103,
					"content": "Cỗ máy độc nhất vô nhị... \"Cỗ Máy Khổng Lồ\" của tôi đã xử lý xong những nguyên liệu bạn thu thập được rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950104
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950104,
					"content": "Kết quả thế nào?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726950105
					]
				},
				{
					"id": 726950105,
					"content": "Dù sao cũng là máy do tôi chế tạo, sao có thể có vấn đề được! Đừng có nhìn tôi như thế, kỹ thuật của tôi đã được rèn giũa ở Fontaine đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950106
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950106,
					"content": "Tốt xấu gì tôi cũng là người Fontaine, không ai trên thế giới này hiểu việc chế tạo và vận hành máy móc chính xác hơn chúng tôi đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950107
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950107,
					"content": "Lần trước chẳng qua là do chuẩn bị vội vàng, lại không có ai giúp thu thập nguyên liệu thử vận hành nên mới dẫn đến việc đồ chơi bị nổ, lần này rồi sẽ khác!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950108
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950108,
					"content": "Vậy sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726950109,
					"content": "Nếu lần này đồ chơi vẫn nổ, thì khoản tiền cuối cùng và nửa đời sau của tôi cũng sẽ nổ tung theo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950110
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950110,
					"content": "Dù bạn không tin tôi thì cũng phải tin vào ý thức của tôi khi đã đặt cược cuộc sống của mình vào việc này chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950111
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950111,
					"content": "Trước đây, tôi không nghĩ rằng việc sản xuất đồ chơi là một nghề đòi hỏi sự ý thức như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726950112,
					"content": "Được rồi được rồi, tiếp theo là phải thực hiện giai đoạn kế tiếp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950113
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950113,
					"content": "Để đảm bảo an toàn, tôi muốn hỏi các bạn, trong ba bước, chúng ta đã hoàn thành \"thu thập nguyên liệu\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950114
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950114,
					"content": "Vậy bước tiếp theo là \"thu thập hạt nhân\" hay \"thu thập năng lượng\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950115,
						726950118
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950115,
					"content": "\"Thu thập hạt nhân\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726950116
					]
				},
				{
					"id": 726950116,
					"content": "Chúc mừng... bạn đã trả lời sai. Nếu bạn thật sự đi thu thập hạt nhân, vậy thì bạn sẽ góp một phần công sức cho việc hủy hoại nửa đời sau của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950117
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950117,
					"content": "Đáp án đúng là \"nạp nguyên tố\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950121
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950121,
					"content": "Tóm lại... cái gọi là \"nạp nguyên tố\" chính là mang theo \"Máy Thu Thập Nguyên Liệu\" đứng ở nơi bị nguyên tố ảnh hưởng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950122
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950122,
					"content": "Ví dụ tôi muốn thu thập nguyên tố Thủy, thì mang theo \"Máy Thu Thập Nguyên Liệu\" đứng ở giữa sông một lúc, tôi muốn thu thập nguyên tố Lôi thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950123
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950123,
					"content": "Thì phải bị sét đánh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726950124,
					"content": "Ôi, đúng là Nhà Mạo Hiểm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950125
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950125,
					"content": "Tôi tin vào thể chất của những Nhà Mạo Hiểm như các bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950126
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950126,
					"content": "Tin vào thể chất sao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726950127
					]
				},
				{
					"id": 726950127,
					"content": "Thật ra tiếp xúc với sinh vật nguyên tố là cách tốt nhất, lúc trước khi du lịch ở Inazuma, tôi có đánh dấu ba nơi thường có sinh vật nguyên tố xuất hiện...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950128
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950128,
					"content": "Vốn dĩ tôi nghĩ nếu thật sự không có trợ thủ, thì tôi sẽ tự mình lén ngồi thuyền đến những nơi đó để tiếp xúc với sinh vật nguyên tố.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950129
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950129,
					"content": "Vậy thì quá nguy hiểm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726950130,
					"content": "Bây giờ chẳng phải đã có các bạn rồi sao, các bạn đến đó thử vận may đi, xem có sinh vật nguyên tố không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950131
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950131,
					"content": "Việc \"nạp nguyên tố\" giao cho các bạn đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950118,
					"content": "\"Thu thập năng lượng\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726950119
					]
				},
				{
					"id": 726950119,
					"content": "Haha, mặc dù nghe có vẻ đúng, nhưng thật ra không phải \"thu thập năng lượng\" mà là \"nạp nguyên tố\", không ngờ cả hai đáp án tôi đưa ra đều không phải đáp án đúng đúng không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950120
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950120,
					"content": "Anh ta cười thật đáng ghét.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950121
					],
					"speakerTitle": "Paimon"
				}
			]
		},
