				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bertrand"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726950301,
					"content": "Thế nào, sử dụng máy thu thập nguyên liệu vẫn suôn sẻ chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950302
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950302,
					"content": "Rất suôn sẻ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726950303
					]
				},
				{
					"id": 726950303,
					"content": "Máy Thu Thập Nguyên Liệu này cũng là niềm tự hào của tôi, cho dù là thu thập nguyên liệu như ngày hôm qua, hay lưu trữ sức mạnh nguyên tố như hiện giờ, thì đều có thể thực hiện một cách thuần thục.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950304
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950304,
					"content": "Thật ra tôi cũng có ý định đặt một cái tên mới cho \"Máy Thu Thập Nguyên Liệu\" này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950305
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950305,
					"content": "Tôi thấy cái tên \"Máy Thu Thập Nguyên Liệu\" cũng hay mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950306,
						726950307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726950306,
					"content": "Đúng vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726950308
					]
				},
				{
					"id": 726950308,
					"content": "Vậy sao, tôi lại thấy định nghĩa chưa rõ ràng lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950309
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950309,
					"content": "Được, cứ giao \"Máy Thu Thập Nguyên Liệu\" cho tôi, lần này cũng vậy, quá trình sản xuất thử nghiệm cần phải quan sát, nhất là liên quan đến sức mạnh nguyên tố.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950310
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950310,
					"content": "Chắc là phải đợi đến khi phản ứng nguyên tố bên trong \"Cỗ Máy Khổng Lồ\" ổn định rồi mới có thể tiếp tục công đoạn tiếp theo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950311
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950311,
					"content": "Đến lúc đó lại nhờ các bạn nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950307,
					"content": "Rất thích hợp.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726950308
					]
				}
			]
		}
	]
}