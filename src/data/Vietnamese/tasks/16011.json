				{
					"id": 160111204,
					"content": "Nhưng nửa sau của kế hoạch... dựa vào nỗi nhớ dẫn dắt để thoát khỏi Địa Mạch... thật ra tôi cũng không chắc lắm, haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111205
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111205,
					"content": "#Nói thật thì, lúc đó nếu thử nghiệm tách rời Roland của {NICKNAME} không thành công thì anh định làm sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 160111206,
					"content": "Ừm... Ban đầu bước này tôi định giao cho Barbatos thực hiện, nhưng sau khi nghe xong, anh ấy lập tức giới thiệu với tôi người phù hợp hơn... \"Người phương xa đuổi theo gió\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111207
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111207,
					"content": "#Sự thật chứng minh rằng, chúng tôi đã đặt niềm tin đúng chỗ. Cảm ơn {F#cô}{M#cậu} nhiều, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111208
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111208,
					"content": "Vậy lỡ như tôi không thành công thì sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160111209
					]
				},
				{
					"id": 160111209,
					"content": "Vậy có lẽ sẽ phải làm phiền Barbatos, thổi tôi từ phía sói, trở về phía con người chăng?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111210
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111210,
					"content": "...Nhưng dù sao, cái giá phải trả cũng không nhỏ, tỷ lệ thành công cũng chưa chắc cao... Hơn nữa tôi cũng không muốn anh ấy phải tốn sức cho chuyện như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111211,
						160111212
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111211,
					"content": "...Huy động sức mạnh của thần linh...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160111213
					]
				},
				{
					"id": 160111213,
					"content": "Ừm, hỏi hay đấy, một cốc rượu bồ công anh hảo hạng, cứ lấy tiền riêng tôi cất trong ngăn kéo bàn làm việc mà trả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111214
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111214,
					"content": "Làm gì có chuyện dễ như vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 160111212,
					"content": "...Sẽ phải trả giá như thế nào?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160111213
					]
				},
				{
					"id": 160111215,
					"content": "Về đội viễn chinh...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160111216
					]
				},
				{
					"id": 160111216,
					"content": "Ừm, sau khi đánh bại hình ảnh phản chiếu của Roland, trong thời gian ngắn chắc Cuộc Săn Hoang Dã sẽ không còn đủ sức tổ chức phản công nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111217
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111217,
					"content": "Ngoại trừ một số người sẽ ở lại căn cứ Nod-Krai để trực, thì số còn lại sẽ chia thành nhiều đợt lần lượt trở về.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111218
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111218,
					"content": "Albedo và Durin cũng sẽ trở về cùng đợt quân viễn chinh đầu tiên, mọi người chắc sẽ sớm gặp lại họ thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111219,
					"content": "Về tương lai của anh...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160111220
					]
				},
				{
					"id": 160111220,
					"content": "#Tương lai của tôi à... Chắc {F#cô}{M#cậu} cũng đã nghe từ Barbatos hoặc Hội Ma Nữ rồi, tôi đã từng thấy một số hình ảnh phản chiếu của tương lai trên bàn bói nước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111221
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111221,
					"content": "\"Thảm họa Vực Sâu đến từ phương Bắc?\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160111222
					]
				},
				{
					"id": 160111222,
					"content": "#Đúng vậy, theo tình hình hiện tại... tương lai đó có lẽ đã được thay đổi rồi, nhờ có {F#cô}{M#cậu}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111223
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111223,
					"content": "Nhưng sau khi tôi xử lý xong những việc vặt trong Đội Kỵ Sĩ, tôi vẫn phải quay lại phương Bắc một chuyến... Còn nhiều công việc phải giải quyết ở căn cứ mới tại Nod-Krai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111224
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111224,
					"content": "Nhóm kỵ sĩ đầu tiên tự nguyện ở lại cứ điểm còn chưa được luân chuyển về, nên sao tôi có thể bỏ mặc họ được chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111225
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111225,
					"content": "Nói nghe hay vậy, chắc không phải là muốn tiếp tục ném hết công việc ở Mondstadt cho Jean đấy chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 160111226,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111227
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111227,
					"content": "...Không phải chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111228,
						160111229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 160111228,
					"content": "Anh không định phản bác gì sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160111230
					]
				},
				{
					"id": 160111230,
					"content": "Haha, đùa thôi mà, sau này hai người sẽ thường bắt gặp tôi ở Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111229,
					"content": "Đừng chỉ mỉm cười vậy chứ!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160111230
					]
				},
				{
					"id": 160111231,
					"content": "Không còn vấn đề gì nữa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160111232
					]
				},
				{
					"id": 160111232,
					"content": "Ừm, vậy để tôi hóng gió thêm một lúc nữa, làn gió quê nhà vẫn là loại rượu say đắm lòng người nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varka"
				}
			]
		}
	]
}