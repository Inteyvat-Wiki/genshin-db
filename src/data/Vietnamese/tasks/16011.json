			"dialogs": [
				{
					"id": 160110701,
					"content": "Đây là... bên trong \"trái tim\" của sói à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110702
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110702,
					"content": "...! Roland!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varka"
				}
			]
		},
		{
			"id": 1601109,
			"completionStepIds": [
				1601109
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1601109",
							"2"
						],
						"stepId": 1601109,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Roland"
				],
				"points": [
					{
						"sceneId": 20336,
						"position": [
							387.989,
							123.18,
							197.075
						],
						"pointId": 1
					},
					{
						"sceneId": 20336,
						"position": [
							387.824,
							111.946,
							237.497
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 160110901,
					"content": "...Như ngươi mong muốn, Kỵ Sĩ Bắc Phong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110902
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110902,
					"content": "Haha, hơi khác với những gì ta tưởng tượng, ngươi trông có vẻ không điên loạn như trong ký ức của \"mảnh vỡ\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110903
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110903,
					"content": "Ta chưa bao giờ đi chệch khỏi con đường đúng đắn. Còn ngươi hiện tại không giống một anh hùng có thể giết rồng chút nào, mà giống một kỵ sĩ lạc lõng... lang thang quá lâu hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110904
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110904,
					"content": "Chúng ta cũng như nhau thôi. Có vẻ cả hai đều không ở trạng thái mạnh nhất của mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110905
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110905,
					"content": "Quân đội của Rerir đã bị đánh bại, còn \"ta\" được Vực Sâu tạo ra đương nhiên cũng chỉ là bóng dáng không hoàn chỉnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110906
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110906,
					"content": "Sức mạnh đã đạt đến cực hạn của Roland, nhưng tâm trí vẫn mãi dừng lại ở khoảnh khắc nhuốm máu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110907
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110907,
					"content": "Vì vậy, \"ta\" cũng không đúng... và kỵ sĩ không thể chấp nhận bản thân đứng yên tại chỗ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110908
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110908,
					"content": "Sau khi cứu ngươi khỏi sự bất công, dẫn dắt ngươi gia nhập Vực Sâu, ta sẽ chấn chỉnh lại bản thân và tiếp tục đi theo con đường kỵ sĩ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110909
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110909,
					"content": "Ha, bên ngoài chịu không nổi sự giày vò của ngươi nữa đâu... Nhưng sự cố chấp của ngươi quả đúng như ta tưởng, xem ra ta không thể thuyết phục ngươi rồi phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110910
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110910,
					"content": "Đức tính mà kỵ sĩ tôn thờ sẽ không bị ngôn từ vấy bẩn, cho dù ngôn từ đó cao quý đến đâu. Cả hai chúng ta đều không thể thuyết phục nhau, và ngươi cũng đã biết điều này từ lâu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110911
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110911,
					"content": "Nếu không, tại sao các ngươi lại đặt tất cả hy vọng vào \"một ý niệm\" của Boreas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110912
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110912,
					"content": "Nhưng giờ đây thanh kiếm dùng để chứa đựng Linh Hồn Sói của ngươi đã sớm vỡ vụn, thứ ngươi đang cầm trong tay chẳng qua chỉ là ảo ảnh mang hình hài của nó mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110913
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110913,
					"content": "Dù ngươi có dùng thủ đoạn gì cũng vô ích, cũng chẳng còn viện binh nào để trông chờ nữa... Nơi đây chính là \"đường cùng\" của ngươi, người viễn chinh cô độc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110914
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110914,
					"content": "Haha, chưa nói đến thủ đoạn, còn viện binh... chẳng phải ở đây còn có một vị sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110915
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110915,
					"content": "...Sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110916
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110916,
					"content": "Từ đầu đến cuối, đối tượng ta cần thuyết phục chỉ có một mình người đó thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110917
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110917,
					"content": "Nơi đây là \"trái tim\" của Ma Thần Bắc Phong Andrius đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110918
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110918,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110919
					],
					"speakerTitle": "Andrius"
				},
				{
					"id": 160110919,
					"content": "Này! Nghe thấy chưa nào Andrius!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110920
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110920,
					"content": "Hãy mau tỉnh lại đi! Rõ ràng là Ma Thần Bắc Phong, còn muốn bị Vực Sâu kiểm soát bao lâu nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110921
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110921,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110922
					],
					"speakerTitle": "Andrius"
				},
				{
					"id": 160110922,
					"content": "Nếu đây là sự giãy giụa cuối cùng của ngươi, thì ta thật thất vọng đấy, Kỵ Sĩ Bắc Phong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110923
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110923,
					"content": "Khí thế và ước nguyện không thể tạo ra phép màu, thế giới này không bao giờ nhân từ như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110924
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110924,
					"content": "...Trở về...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110925
					],
					"speakerTitle": "Andrius"
				},
				{
					"id": 160110925,
					"content": "...Trở về... Địa Mạch...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110926
					],
					"speakerTitle": "Andrius"
				},
				{
					"id": 160110926,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110927
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110927,
					"content": "...Đây chính là lựa chọn của \"ta\"... ký ức của \"ta\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110928
					],
					"speakerTitle": "Andrius"
				},
				{
					"id": 160110928,
					"content": "...Đây là câu trả lời... mà \"ta\" tìm thấy ở cuối hành trình sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110929
					],
					"speakerTitle": "Andrius"
				},
				{
					"id": 160110929,
					"content": "\"And{RUBY#[D]Boreas}rius\"... Bức thư của ngài, tôi đã cẩn thận đưa đến trái tim của \"ngài\" rồi đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110930
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110930,
					"content": "A... Kỵ Sĩ Bắc Phong à, hãy nhìn đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110931
					],
					"speakerTitle": "Andrius"
				},
				{
					"id": 160110931,
					"content": "...Đây là điều duy nhất \"Só{RUBY#[S]ta}i\" - có thể làm cho \"con {RUBY#[S]mọi người}người\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110932
					],
					"speakerTitle": "Andrius"
				},
				{
					"id": 160110932,
					"content": "...Thay mặt loài người trên mặt đất, tôi xin gửi lời cảm ơn đến ngài, Vua Sói.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110933
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110933,
					"content": "Boreas... đang trở về Địa Mạch. Tại sao? Thanh kiếm của ngươi đã vỡ tan rồi, rõ ràng đã không còn bất kỳ thứ gì để gửi gắm linh hồn nữa. Không, hay là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110934
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110934,
					"content": "Khí thế và ước nguyện không thể tạo ra phép màu... Điều đó ta đương nhiên biết rõ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110935
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110935,
					"content": "...Nhưng ngay từ đầu, thứ để gửi gắm linh hồn... đâu chỉ có \"kiếm\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110936
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110936,
					"content": "Vua Sói, từng ban sức mạnh linh hồn cho đàn sói dưới trướng, giúp trái tim của chúng mạnh mẽ hơn, nanh vuốt cũng sắc bén hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110937
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 160110937,
					"content": "...Dù \"ta\" không có ý định như vậy, nhưng \"trái tim\" của người phàm cũng sẽ bị linh hồn Vua Sói cắn xé, nuốt chửng, đồng hóa... cũng như cưỡng chế hòa lẫn người và sói vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110938
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 160110938,
					"content": "...Dùng trái tim người phàm để gửi gắm linh hồn Ma Thần... Đây sẽ là con đường không thể quay lại, nhưng tôi sẽ không ngăn cản một kỵ sĩ bước lên hành trình của chính mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110939
					],
					"speakerTitle": "\"The Captain\""
				},
				{
					"id": 160110939,
					"content": "Tim ngươi, linh hồn ngươi... cũng đang cùng sụp đổ sao?... Ra là thế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110940
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110940,
					"content": "\"Cừu con làm sao buộc được chuông vào trái tim sói\"... ngươi đã từng hỏi như vậy đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110941
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110941,
					"content": "Câu trả lời của ta là... Để con sói tự nuốt lấy \"trái tim\" này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110942
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110942,
					"content": "Phần linh hồn sói gửi gắm trên thanh kiếm chỉ là một đòn đánh lừa, niềm tin và ký ức thật sự được chứa đựng trong trái tim của ngươi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110943
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110943,
					"content": "Để không bị phát hiện, nên đã cố tình để linh hồn của Vua Sói hòa với của ngươi, rồi bị ta nuốt chửng... Từ trước đến giờ, ngươi đều mang gánh nặng như vậy để chiến đấu sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110944
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110944,
					"content": "So với quyết tâm của Vua Sói... thì sự hy sinh này chẳng là gì cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110945
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110945,
					"content": "Ý chí kiên cường, chiến thuật xuất sắc... nhưng đây không phải là cách chiến đấu mà một kỵ sĩ nên có. Chính vì thế, lựa chọn của ngươi là sai lầm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110946
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110946,
					"content": "Linh hồn của ngươi đã hòa làm một với Andrius. Khi nó hoàn toàn hòa mình vào Địa Mạch, ngươi cũng sẽ rơi xuống cùng nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110947
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110947,
					"content": "Khi đó, dù là Barbatos hay lữ khách bên cạnh ngươi, cũng đều không thể định vị linh hồn ngươi trong Địa Mạch, huống chi là đưa ngươi ra khỏi đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110948
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110948,
					"content": "Ngươi thua rồi và ta cũng vậy. Rất tiếc, giờ ta đã không thể cứu rỗi ngươi nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110949
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110949,
					"content": "...Cầu mong linh hồn ngươi được yên nghỉ cùng gió Bắc, người viễn chinh cô độc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110950
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110950,
					"content": "...Haha, cô độc sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110951
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110951,
					"content": "Xin lỗi nhé... Tuy ta cũng từng nghĩ rằng, kết cục cùng ngươi về với Địa Mạch, có phải đã rất viên mãn rồi không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110952
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110952,
					"content": "Nhưng đáng tiếc, khác với Roland năm đó, bên ngoài vẫn còn rượu ngon và bạn bè đang chờ ta khải hoàn, vậy nên...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110953
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110953,
					"content": "Ta chưa định chấp nhận số phận đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110954
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110954,
					"content": "Leng keng! Có thư của anh đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
