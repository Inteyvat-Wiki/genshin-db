			},
			"dialogs": [
				{
					"id": 160110201,
					"content": "Hự...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110202
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110202,
					"content": "...Kiếm vẫn còn nguyên vẹn? Nhưng không cảm nhận được Linh Hồn Sói trên đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110203
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110203,
					"content": "(...Có vẻ như nơi đây không còn là \"hiện thực\" nữa, mà là không gian được tạo ra bởi ý thức của Bắc Phong hòa lẫn với Roland.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110204
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110204,
					"content": "Phía sau không còn đường lui, phía trước lại là \"miệng sói\"... Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110205
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110205,
					"content": "Ha, thế thì cứ thẳng tiến vào trong thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varka"
				}
			]
		},
