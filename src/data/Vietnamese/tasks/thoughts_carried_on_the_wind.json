				"points": []
			},
			"dialogs": [
				{
					"id": 411350201,
					"content": "Đại đội trưởng rốt cuộc đang ở đâu... xảy ra chuyện lớn như vậy, cũng không biết anh ấy có nhận được tin tức không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350202
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350202,
					"content": "Nhưng cho dù anh ấy nhận được tin tức, có lẽ cũng không thể trở lại trong phút chốc, haiz...",
					"roleType": "TALK_ROLE_NPC",
