					"Godwin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411350101,
					"content": "Không biết Glory thế nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350102
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350102,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350103
					]
				},
				{
					"id": 411350103,
					"content": "Bạn... là Nhà Lữ Hành à? Bây giờ bên ngoài rất nguy hiểm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350104
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350104,
					"content": "Nếu bạn muốn tìm một nơi an toàn để lánh nạn, thì hãy mau về thành Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350105
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350105,
					"content": "Bạn không vào thành sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350106
					]
				},
				{
					"id": 411350106,
					"content": "Ừm... tôi tạm thời chưa thể về được, suy cho cùng tôi cũng là một kỵ sĩ Tây Phong... trong thời điểm này không thể chùn bước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350107
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350107,
					"content": "Mặc dù vì một số lý do, tôi không thể trở về thành Mondstadt để giúp đỡ, nhưng tôi có thể làm một chút gì đó ở bên ngoài.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350108
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350108,
					"content": "Sau khi thiên thạch rơi xuống, rất nhiều ma vật đã bị ảnh hưởng bởi thiên thạch và trở nên đặc biệt hung dữ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350109
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350109,
					"content": "Nếu như mặc kệ chúng, chắc chắn sẽ dẫn đến thảm hoạ, tôi đang chuẩn bị đi dọn sạch bọn chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350110
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350110,
					"content": "Một mình bạn có sao không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350111
					]
				},
				{
					"id": 411350111,
					"content": "Ừm, mặc dù có rất nhiều ma vật... tôi sẽ ổn thôi, chỉ cần cẩn thận đối phó là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350112
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350112,
					"content": "Nhưng chỉ có một mình tôi, không biết phải đánh đến bao giờ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350113
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350113,
					"content": "Nhà Lữ Hành, nếu bạn đồng ý, có thể giúp tôi tiêu diệt một vài doanh trại của quái vật không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350114,
						411350116
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350114,
					"content": "Được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350115
					]
				},
				{
					"id": 411350115,
					"content": "Vậy phiền bạn rồi, quả thực đã giúp tôi một việc lớn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350116,
					"content": "Tại sao không tìm đội kỵ sĩ giúp đỡ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350117
					]
				},
				{
					"id": 411350117,
					"content": "Tìm đội Kỵ Sĩ giúp đỡ... ờ, chuyện này, thực sự không được... tôi có nỗi khổ riêng, bạn đừng gặng hỏi thêm nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350118
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350118,
					"content": "Bạn làm ơn hãy giúp tồi đi, tiêu diệt một vài doanh trại của quái vật, cũng coi như giúp đỡ đội kỵ sĩ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Godwin"
				}
			]
		},
		{
