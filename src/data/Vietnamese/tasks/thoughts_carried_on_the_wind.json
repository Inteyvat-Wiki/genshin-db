			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Godwin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411350301,
					"content": "Các bạn đã giải quyết xong hết đám quái vật rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350302
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350302,
					"content": "Ừm, giải quyết xong rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350303
					]
				},
				{
					"id": 411350303,
					"content": "Cảm ơn bạn, nhà lữ hành. Tạm thời đám ma vật đó đã không còn là mối đe doạ nữa rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350304
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350304,
					"content": "Bạn cũng mau trở về thành đi, trong tình hình này còn bắt bạn phải chạy lung tung bên ngoài, thực ngại quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350305
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350305,
					"content": "À, sau đó... khi bạn trở về thành, có thể giúp tôi lưu ý một chuyện không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350306
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350306,
					"content": "Rất đơn giản! Chỉ, chỉ cần giúp tôi để ý một chút là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350307
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350307,
					"content": "Rốt cuộc là có chuyện gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350308
					]
				},
				{
					"id": 411350308,
					"content": "Cái đó, sau khi bạn quay về thành, có thể giúp tôi xem tình hình của Glory không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350309
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350309,
					"content": "Cô ấy vẫn luôn ở trong thành, sẽ không có nguy hiểm gì, nhưng tôi vẫn rất lo lắng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350310
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350310,
					"content": "Bạn hãy giúp tôi đến xem tình hình của cô ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350311
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350311,
					"content": "Tôi biết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350312
					]
				},
				{
					"id": 411350312,
					"content": "Cảm ơn bạn, nhà lữ hành. Phải rồi, xin bạn... đừng nói cho Glory là tôi đang ở đây, hãy... hãy nói là tôi vẫn đang làm nhiệm vụ ở một nơi rất xa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350313
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350313,
					"content": "Xin lỗi, làm ơn, hãy nói với cô ây như vậy, tôi có nỗi khổ riêng, nhờ cả vào bạn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Godwin"
				}
			]
		},
		{
			"id": 4113504,
