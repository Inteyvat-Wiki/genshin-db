				"objectNames": [
					"Glory"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411350401,
					"content": "Cầu mong Godwin bình an vô sự...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350402
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 411350402,
					"content": "Godwin nhờ tôi đến thăm bạn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350403
					]
				},
				{
					"id": 411350403,
					"content": "Godwin? Bạn, bạn biết anh ấy đang ở đâu sao? Tôi rất lo cho anh ấy, đã rất lâu không có tin tức gì của anh ấy cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350404
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 411350404,
					"content": "Anh ấy vẫn đang làm nhiệm vụ ở một nơi rất xa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350405
					]
				},
				{
					"id": 411350405,
					"content": "Là... là vậy sao? Vậy thì tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350406
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 411350406,
					"content": "Nếu không có chuyện thiên thạch, tôi đã muốn đến đội kỹ sĩ hỏi thăm tung tích của anh ấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350407
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 411350407,
					"content": "Tôi vẫn luôn ở trong thành, vì vậy rất an toàn. Nhưng anh ấy đang chấp hành nhiệm vụ bên ngoài nhỉ, nếu mọi nơi trên thế giới đều có thiên thạch rơi, thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350408
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 411350408,
					"content": "Haiz, mong anh ấy bình yên vô sự.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350409
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 411350409,
					"content": "Anh ấy chắc chắn sẽ bình yên vô sự.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350410
					]
				},
				{
					"id": 411350410,
					"content": "Cảm ơn bạn, nếu được như vậy là tốt nhất. Đúng rồi, nếu bạn bằng lòng có thể giúp tôi một việc không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350411
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 411350411,
					"content": "Tôi gặp tiểu thư Flora mua một phần hạt bồ công anh, vốn định tìm người giúp tôi đến nơi cao gieo xuống... để gió đem chúng đến cho Godwin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350412
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 411350412,
					"content": "Tình hình trong thành bạn cũng biết đấy, nhất thời không thể tìm ai giúp...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350413
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 411350413,
					"content": "Vừa hay bạn đến rồi, bạn có đồng ý giúp tôi đem những hạt bồ công anh này cho Godwin không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350414
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 411350414,
					"content": "Không thành vấn đề.",
