			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"A Meng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210280101,
					"content": "#{F#Chị}{M#Anh} đến đúng lúc lắm, em đang định đi tìm {F#chị}{M#anh} đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280102,
						210280103
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210280102,
					"content": "Có chuyện gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280105
					]
				},
				{
					"id": 210280105,
					"content": "Bố nói, đường đến Sumeru rất xa, nên cần chuẩn bị một số dược liệu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280106
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210280106,
					"content": "Thuốc trị đau đầu, đau bụng, say nắng... còn phải có thêm thuốc giải rượu, thuốc tiêu hóa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280107
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210280107,
					"content": "Tại sao phải cần có thuốc giải rượu nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210280108,
					"content": "Cần phải dùng khi bàn chuyện làm ăn mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280109
					]
				},
				{
					"id": 210280109,
					"content": "Sao? Bàn chuyện làm ăn thì có liên quan gì đến thuốc giải rượu chứ! Không lẽ uống càng nhiều thì làm việc càng thuận lợi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210280110,
					"content": "Nói chung thì bố muốn em đến Nhà Thuốc Bubu hỏi thử số thuốc này đã chuẩn bị đến đâu rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280111
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210280111,
					"content": "#{F#Chị}{M#Anh} có thể đi với em không? Có một số chuyện em muốn nhờ {F#chị}{M#anh} giúp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280112,
						210280113
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210280112,
					"content": "Đi thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280115
					]
				},
				{
					"id": 210280115,
					"content": "Chúng ta đi thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210280113,
					"content": "#Em... có việc gì cần {F#chị}{M#anh} giúp đỡ sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280114
					]
				},
				{
					"id": 210280114,
					"content": "Mình đi qua kia hẵng nói nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280115
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210280103,
					"content": "Em chuẩn bị cho chuyến du lịch đến đâu rồi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280104
					]
				},
				{
					"id": 210280104,
					"content": "Phần lớn đều do bố chuẩn bị cả rồi... nhưng bố cũng có giao cho em một nhiệm vụ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280105
					],
					"speakerTitle": "A Meng"
				}
			]
		},
		{
