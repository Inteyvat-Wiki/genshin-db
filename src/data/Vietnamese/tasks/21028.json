			},
			"dialogs": [
				{
					"id": 210280401,
					"content": "#Cám ơn {F#chị}{M#anh}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280402
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210280402,
					"content": "Ừm, số này có lẽ đủ để làm thuốc rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280403
					],
					"speakerTitle": "Gui"
				},
				{
					"id": 210280403,
					"content": "Số thuốc chống say nắng này sẽ được chuyển đến cho bố em vào đợt sau nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280404
					],
					"speakerTitle": "Gui"
				},
				{
					"id": 210280404,
					"content": "Vậy thì làm phiền anh rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280405
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210280405,
					"content": "#Cái này tặng anh nè, cảm ơn {F#chị}{M#anh} đã giúp em, chúng ta quay về thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280406
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210280406,
					"content": "Hihi, bố em nghe được tin này nhất định sẽ rất vui mừng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280407
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210280407,
					"content": "Meng à, em đợi chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280408
					],
					"speakerTitle": "Gui"
				},
				{
					"id": 210280408,
					"content": "Sao thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280409
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210280409,
					"content": "Em không phải đang kiểm thuốc sao? Vẫn còn chưa kiểm xong mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280410
					],
					"speakerTitle": "Gui"
				},
				{
					"id": 210280410,
					"content": "Hả...? Ban nãy em đã kiểm tra lâu lắm rồi mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280411
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210280411,
					"content": "Ban nãy chỉ kiểm được một chút thôi, còn nữa này, tiếp tục nhé bạn nhỏ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280412
					],
					"speakerTitle": "Gui"
				},
				{
					"id": 210280412,
					"content": "Huhu... được rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "A Meng"
				}
			]
