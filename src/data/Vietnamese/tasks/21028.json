				"points": []
			},
			"dialogs": [
				{
					"id": 210280201,
					"content": "Xin chào, mọi người đến để bốc thuốc sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280202
					],
					"speakerTitle": "Gui"
				},
				{
					"id": 210280202,
					"content": "Ủa? Đây không phải là Meng sao? Sao em lại đến đây vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280203
					],
					"speakerTitle": "Gui"
				},
				{
					"id": 210280203,
					"content": "À ừm, hiểu rồi, em đến đây để hỏi chuyện thuốc thang đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280204
					],
					"speakerTitle": "Gui"
				},
				{
					"id": 210280204,
					"content": "Yên tâm em nhé, số thuốc em cần trên cơ bản đã chuẩn bị xong rồi, sẽ phân đợt giao đi cho bố em.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280205
					],
					"speakerTitle": "Gui"
				},
				{
					"id": 210280205,
					"content": "Nhưng mà số lượng thuốc mà bố em cần khá lớn, nên trong tiệm có chút kẹt hàng, vì vậy có một số thuốc vẫn chưa đủ nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280206
					],
					"speakerTitle": "Gui"
				},
				{
					"id": 210280206,
					"content": "Để xem thử, ừm... chủ yếu là hơi bị thiếu Bạc Hà, cho nên chưa làm được thuốc chống say nắng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280207
					],
					"speakerTitle": "Gui"
				},
				{
					"id": 210280207,
					"content": "Dù sao thì ngoài việc chuẩn bị thuốc cho bố em ra thì cũng cần phải chữa trị cho người khác mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280208
					],
					"speakerTitle": "Gui"
				},
				{
					"id": 210280208,
					"content": "Vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280209,
						210280211
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210280209,
					"content": "#Chắc sắp đến lượt {F#chị}{M#anh} ra tay rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280210
					]
				},
				{
					"id": 210280210,
					"content": "#Hì hì, cảm ơn {F#chị}{M#anh}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280213
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210280213,
					"content": "#Vậy chuyện thuốc thang em nhờ vào {F#chị}{M#anh} nhé, em phải ở đây để kiểm tra lại số thuốc, bố em dặn em phải làm vậy đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280214
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210280214,
					"content": "Đứa nhóc này nghiêm túc thật...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280215
					],
					"speakerTitle": "Gui"
				},
				{
					"id": 210280215,
					"content": "Vậy em vào đây nhé, hóa đơn thuốc đều ở trong đây cả rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280216
					],
					"speakerTitle": "Gui"
				},
				{
					"id": 210280216,
					"content": "Ối... nhiều vậy sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280217
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210280217,
					"content": "Em cứ kiểm trước nhé, vẫn còn khá nhiều đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280218
					],
					"speakerTitle": "Gui"
				},
				{
					"id": 210280218,
					"content": "Hả? Còn nữa sao?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210280211,
					"content": "Nhưng cần phải trả thù lao nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280212
					]
				},
				{
					"id": 210280212,
					"content": "#Hì hì, không thành vấn đề! Cảm ơn {F#chị}{M#anh}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280213
					],
					"speakerTitle": "A Meng"
				}
			]
		},
