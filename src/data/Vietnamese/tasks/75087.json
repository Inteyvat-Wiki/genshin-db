					"nextDialogs": [
						750870509
					]
				},
				{
					"id": 750870509,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} à? Không ngờ nhóc dám khiêu chiến đối thủ to hơn mình nhiều lần đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870510,
					"content": "Wrrooo...",
