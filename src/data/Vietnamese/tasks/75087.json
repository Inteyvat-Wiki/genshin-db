			"dialogs": [
				{
					"id": 750876301,
					"content": "Chào mừng đến với Học Viện Bay Pakpaka!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750876302,
						750876303
					],
					"speakerTitle": "Cisik"
				},
				{
					"id": 750876302,
					"content": "Đang làm gì ở đây vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750876304
					]
				},
				{
					"id": 750876304,
					"content": "Cung cấp hướng dẫn và trợ giúp cần thiết cho các học viên. Hiện giờ không còn giống như trước nữa, phải biết là trước đây không có dịch vụ tận tình như vậy đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750876305
					],
					"speakerTitle": "Cisik"
				},
				{
					"id": 750876305,
					"content": "Nhưng có một lần, chắc là do lời nói của huấn luyện viên hơi... nghiêm khắc nhỉ? Mà học viên đó cũng là một người nóng tính... Haiz, cảnh tượng lúc đó tôi không muốn nhắc lại luôn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750876306
					],
					"speakerTitle": "Cisik"
				},
				{
					"id": 750876306,
					"content": "Tóm lại, từ đó về sau, học viện bay đã thay đổi phương châm dạy học. Ai nỡ giận người luôn tươi cười, ai mà không thích được khen ngợi chứ, phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cisik"
				},
				{
					"id": 750876303,
					"content": "Đi trước đây...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750876307
					]
				},
				{
					"id": 750876307,
					"content": "Chúc một ngày vui vẻ nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cisik"
				}
