			"dialogs": [
				{
					"id": 750870901,
					"content": "Sao lại là Bánh Quy Saurus vậy? Hơn nữa bức thư bên cạnh là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870902,
					"content": "Quả nhiên là do Quilla giở trò! Nhưng không ngờ lại vì lý do này... Paran đúng là xui xẻo mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870903,
					"content": "Nhưng khi nghĩ đến việc Taruka và Oberon có thể bị nhốt trong doanh trại phía trước, nếu không giải quyết thì cũng thấy áy náy... Hơn nữa, suy cho cùng thì họ cũng không sai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870904,
					"content": "#Hmm... {NICKNAME}, chúng ta hãy tìm cách cứu họ ra nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870905,
					"content": "Nếu có thể <color=#00E1FFFF>trà trộn vào nhóm Iktomisaur tuần tra</color>, nói không chừng sẽ lẻn vào bên trong được đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
