			"dialogs": [
				{
					"id": 750870501,
					"content": "Vì các người đã tìm tới đây, nên ta cũng không cần đóng vai thương nhân nữa rồi nhỉ? Ta đã chịu đựng đủ việc phải đối phó với những tên ngốc rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870502
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750870502,
					"content": "Cô còn dám đổ hết tội lên đầu người khác à? Cô khiến bọn tôi bị hiểu lầm đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870503,
					"content": "Ta là kẻ xấu thì tất nhiên phải làm việc xấu rồi. Mà các ngươi bị ba tên ngốc đó hiểu lầm chẳng phải chứng tỏ ta đã làm tốt sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870504
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750870504,
					"content": "Haha, bây giờ ta sẽ làm ra những chuyện còn tệ hơn nữa! Các ngươi đừng hòng trốn thoát.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870505
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750870505,
					"content": "Lên đi! Cục Bông!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870506
					],
					"speakerTitle": "Quilla"
				},
				{
