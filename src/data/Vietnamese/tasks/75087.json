					"nextDialogs": [
						750870553
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870553,
					"content": "#Ồ! Oberon đã chặn đường bay lên, tiếp đến {REALNAME[ID(2)|SHOWHOST(true)]} sẽ tấn công trực tiếp. Quả là đòn phối hợp đẹp mắt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870554
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870554,
					"content": "Chúng đã gây ra không ít sát thương cho Cục Bông rồi! Có phải đã đánh vào chân không? Hãy tưởng tượng cảm giác ngón chân va vào góc bàn nào! Đối thủ trông có vẻ rối loạn, không thể tiếp tục hành động!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870555,
						750870557,
						750870560,
						750870562
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870555,
					"content": "Tấn công, nhưng tôi là người đánh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870556
					]
				},
				{
					"id": 750870556,
					"content": "#Dù đó cũng là một lựa chọn... Nhưng đây là cơ hội hiếm có để {REALNAME[ID(2)|SHOWHOST(true)]} thể hiện mà! Đừng giành chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870565
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870565,
					"content": "Hrooo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870566
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750870566,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870567
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870567,
					"content": "#Ồ? {REALNAME[ID(2)|SHOWHOST(true)]} và Oberon hình như đang có kế hoạch gì đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870568
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870568,
					"content": "Bánh Quy Saurus! Bánh Quy Saurus ở đâu ra vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870569
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870569,
					"content": "Ahroowr! Harooh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870570
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750870570,
					"content": "Chẳng lẽ là giấu dưới cánh à? Quả là gian xảo mà... Taruka chắc đã vất vả đối phó lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870571
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870571,
					"content": "Wrrooo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870572
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750870572,
					"content": "Này! Không phải lúc này! Dừng lại!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870573
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750870573,
					"content": "Hả? Cục Bông phớt lờ mệnh lệnh, lao thẳng về phía Bánh Quy Saurus! Cám dỗ của việc hồi phục 5 điểm thể lực là quá lớn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870574
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870574,
					"content": "Nó không hề nhận ra! Chính nó mới là kẻ bị mắc bẫy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870575
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870575,
					"content": "#Tóm lại, một trận đấu theo lượt đã diễn ra.\\n{REALNAME[ID(2)|SHOWHOST(true)]} tất nhiên rất dũng cảm, dù không thể trở thành học viên xuất sắc tại trường bay, nhưng vẫn có thể hỗ trợ đồng đội.\\nĐiều bất ngờ là, ngay cả Oberon cũng rất có ích. Nhờ vào kích thước lớn hơn một chút so với những con Qucusaur thông thường, nó đã phong tỏa chiến trường trên không và tung một đòn tấn công mạnh mẽ vào Cục Bông...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750870576
					]
				},
				{
					"id": 750870576,
					"content": "Quilla dường như không có bất kỳ khả năng chiến đấu nào. Sau khi Cục Bông mất đi ý chí chiến đấu, cô ta cũng buộc phải rút lui.\\n\"Đồ phá luật! Lần sau... lần sau ta sẽ không để ngươi thắng như vậy đâu! Hãy đợi đấy!\"\\nSau khi nói xong câu thoại mà một kẻ phản diện hay nói, cô ta chạy trốn cùng với Cục Bông.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750870577
					]
				},
				{
					"id": 750870577,
					"content": "Ôi, tôi quên hỏi cô ta nhốt Taruka ở đâu rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870578
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870578,
					"content": "Wrooo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870579
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750870579,
					"content": "Đừng buồn, Taruka chắc chắn sẽ không có chuyện gì đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870580
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870580,
					"content": "Rawr! Raaaawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870581
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870581,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} cũng nghĩ như vậy đúng không? Bây giờ chúng ta hãy đưa Oberon trở về thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870557,
					"content": "Thuyết phục đối phương đầu hàng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870558
					]
				},
				{
					"id": 750870558,
					"content": "Nếu có thể giải quyết vấn đề chỉ bằng lời nói thì trên thế giới này còn tranh chấp nữa sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870559
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870559,
					"content": "Khụ... Ý tôi là khả năng thành công sẽ rất thấp đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870565
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870560,
					"content": "Sử dụng đạo cụ thần kỳ để thu phục.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870561
					]
				},
				{
					"id": 750870561,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870565
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870562,
					"content": "Tranh thủ bây giờ chạy trốn thôi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870563
					]
				},
				{
					"id": 750870563,
					"content": "Wooo... Rrrooo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870564
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870564,
					"content": "#Ối, {REALNAME[ID(2)|SHOWHOST(true)]} nản chí rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870565
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870545,
					"content": "Phòng thủ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870546
					]
				},
				{
					"id": 750870546,
					"content": "Đang hai đấu một mà lại chọn phòng thủ là sao? Đối thủ không thể tấn công hai mục tiêu cùng lúc mà, chẳng phải sẽ lãng phí một lượt sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870552
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870547,
					"content": "Đạo cụ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870548
					]
				},
				{
					"id": 750870548,
					"content": "Dùng Bánh Quy Saurus hồi phục 5 điểm thể lực!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870549
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870549,
					"content": "...Nhưng thực sự không cần thiết mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870552
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870550,
					"content": "Chạy trốn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870551
					]
				},
				{
					"id": 750870551,
					"content": "Tình hình đang có lợi mà sao vẫn nghĩ đến việc chạy trốn thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870552
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870519,
					"content": "Phòng thủ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870520
					]
				},
				{
					"id": 750870520,
					"content": "Rooo... Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870521
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870521,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} cho rằng phòng thủ là quá thận trọng, lãng phí cơ hội tốt, nên đã chọn tư thế tấn công!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870530
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870522,
					"content": "Đạo cụ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870523
					]
				},
				{
					"id": 750870523,
					"content": "Chúng ta làm gì có đạo cụ nào để sử dụng chứ! Ngay cả việc đặt bẫy thú cũng đã quá muộn rồi mà?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870524
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870524,
					"content": "Rooo... Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870525
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870525,
					"content": "#Ồ! {REALNAME[ID(2)|SHOWHOST(true)]} đã chuẩn bị tấn công!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870530
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870526,
					"content": "Chạy trốn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870527
					]
				},
				{
					"id": 750870527,
					"content": "Bây giờ không phải lúc để chạy trốn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870528
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870528,
					"content": "Wrrooo... Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870529
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870529,
					"content": "#Ngay cả {REALNAME[ID(2)|SHOWHOST(true)]} cũng biết kìa! Nó đã chuẩn bị tư thế tấn công rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870530
					],
					"speakerTitle": "Paimon"
				}
			]
		},
