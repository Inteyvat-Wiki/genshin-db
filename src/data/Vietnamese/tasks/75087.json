						750870508
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870508,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}! Tôi chọn cậu!",
