			"dialogs": [
				{
					"id": 750870701,
					"content": "Ơ? Taruka! Em về rồi à!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870702,
					"content": "#{M#Anh}{F#Chị} {NICKNAME}! May mà {F#hai chị}{M#anh chị} không sao... Em đã giải thích tình hình cho chị em rồi. Lamizana quả là một kẻ ngốc, đúng như em nghĩ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870703
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750870703,
					"content": "Harooh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870704
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750870704,
					"content": "Đúng vậy, còn ngốc hơn cả ngươi nữa đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870705
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750870705,
					"content": "Wrooo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870706
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750870706,
					"content": "#Thôi nào, nó đã xa em lâu như vậy, chắc cũng rất bất an. Hơn nữa, màn phối hợp giữa nó và {REALNAME[ID(2)|SHOWHOST(true)]} vừa rồi cũng rất tuyệt đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870707,
					"content": "Vẫn còn có thể tiến bộ hơn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870708
					]
				},
				{
					"id": 750870708,
					"content": "Ừm, nó vẫn chỉ là một chú Saurian nhỏ thôi. Chỉ cần Taruka chăm sóc tốt, sau này nó chắc chắn sẽ trở thành một con Qucusaur xuất sắc!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870709,
					"content": "Rooohh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870710
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750870710,
					"content": "Sao em về được vậy? Có người tìm thấy và cứu em ra sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870711,
					"content": "Em tự chạy thoát đấy. Ban đầu em định đưa Oberon đi cùng, nhưng nó ham ăn Bánh Quy Saurus quá, dù có thuyết phục thế nào cũng không chịu động đậy. Em tức giận quá nên đã đi một mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870712
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750870712,
					"content": "Hả? Dễ dàng như vậy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870713,
					"content": "Sau khi nắm được đường đi của mấy con Saurian canh gác, em phát hiện vẫn có cơ hội nên đã trốn thoát rất suôn sẻ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870714
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750870714,
					"content": "Biết đâu Taruka mới là người đáng tin cậy nhất ở đây đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870715
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870715,
					"content": "Các vị đến rồi sao? Tôi đang định đi tìm tên lừa đảo đó để tính sổ... Và còn, còn gửi lời xin lỗi chính thức nữa... Là do tôi đoán bừa, suýt nữa vu oan cho người tốt rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870716,
						750870718
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750870716,
					"content": "Quá muộn rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870717
					]
				},
				{
					"id": 750870717,
					"content": "Đúng vậy! Chuyện đã kết thúc rồi anh mới xuất hiện, không phải cướp công thì là gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870720
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870720,
					"content": "Tôi không còn lời nào để nói. Cho dù là thù lao đã hứa trước đó hay phần bồi thường bây giờ, tôi cũng sẽ trả. À, các vị cũng có thể đánh tôi nếu thấy cần thiết!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870721
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750870721,
					"content": "Tôi cũng là một người đàn ông, khi cần chịu trách nhiệm sẽ không thoái thác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870722,
						750870724
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750870722,
					"content": "#Để {REALNAME[ID(2)|SHOWHOST(true)]} cho ăn một đấm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870723
					]
				},
				{
					"id": 750870723,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870726
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870726,
					"content": "Đau quá! Còn chưa chạm đến mà đã thấy đau rồi! Xin hãy nương tay chút nhé... Cũng xin hãy nương chân luôn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870727
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750870727,
					"content": "Vừa rồi còn nói mình là đàn ông chân chính, tuyệt đối không thoái thác. Thật không ra gì mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870728,
					"content": "#Kệ vậy. Chúng ta cũng không phải là những người nhỏ mọn. Đúng không, {NICKNAME}, {REALNAME[ID(2)|SHOWHOST(true)]}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870729
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870729,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870730
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870730,
					"content": "Cảm ơn mọi người đã rộng lượng. Trường bay... ừm, mặc dù không có cổng, nhưng xin hãy hiểu rằng, cánh cổng ở đây lúc nào cũng mở rộng chào đón các vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870731
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750870731,
					"content": "#Ừm, thấy {F#hai chị}{M#anh chị} và {REALNAME[ID(2)|SHOWHOST(true)]} có mối quan hệ tốt như vậy, em cũng muốn học hỏi bí quyết nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870732
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750870732,
					"content": "Hihi, tốt thôi. Nếu sau này có thời gian thì sẽ quay lại chơi ấy mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870724,
					"content": "#Hãy để {REALNAME[ID(2)|SHOWHOST(true)]} đá vào ngón chân anh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870725
					]
				},
				{
					"id": 750870725,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870726
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870718,
					"content": "Tôi sẽ yêu cầu bồi thường! Và cả phần thưởng tham gia nữa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870719
					]
				},
				{
					"id": 750870719,
					"content": "#Hóa ra {NICKNAME} vẫn còn nhớ đến phần thưởng tham gia à...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870720
					],
					"speakerTitle": "Paimon"
				}
			]
		},
