					"nextDialogs": [
						750870307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870307,
					"content": "Wooo... Rrrooo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870308
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750870308,
					"content": "Hừm, dù sao thì cũng đưa nó rời khỏi đây trước đã!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870309,
					"content": "Dù sao cũng đã tìm thấy Oberon rồi, chúng ta cũng không cần trốn tránh nữa nhỉ? Tung tích của Taruka vẫn rất đáng lo ngại... Phải nhanh lên thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
