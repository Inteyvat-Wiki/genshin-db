					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750870511,
					"content": "Rawr! Raaaawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870512
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870512,
					"content": "Oberon trông không được khỏe. Không biết có phải vì lo lắng khi bị tách khỏi Taruka hay là do đã ăn quá nhiều Bánh Quy Saurus nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870513,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} có phải muốn cổ vũ nó nên mới dũng cảm đứng ra bảo vệ chúng ta không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870514,
					"content": "Trên đời này có rất nhiều việc không thể giải quyết chỉ bằng sự dũng cảm. So với thứ hư vô đó thì sức mạnh áp đảo vẫn đáng tin cậy hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870515
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750870515,
					"content": "Tấn công!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870516
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750870516,
					"content": "#Không thể tin nổi! {REALNAME[ID(2)|SHOWHOST(true)]} đã né được đòn tấn công của đối phương! Đây chính là sở trường của Tepetlisaur, ngay cả vua của bầu trời cũng không thể làm gì nó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870517,
						750870519,
						750870522,
						750870526
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870517,
					"content": "Tấn công.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870518
					]
				},
				{
					"id": 750870518,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} đã chuẩn bị tấn công!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870530
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870530,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870531
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870531,
					"content": "Đã trúng mục tiêu! Nhưng... chỉ gây ra một lượng sát thương nhỏ!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870532
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870532,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870533
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870533,
					"content": "Không sao, né đòn và tấn công trúng đích đã là rất đáng khen rồi! Phù, mới chỉ có một lượt thôi mà sao thấy mệt mỏi thế này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870534
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870534,
					"content": "Đến lượt của ta rồi nhỉ? Tấn công!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870535
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750870535,
					"content": "#Trước đòn tấn công mạnh mẽ của đối thủ, {REALNAME[ID(2)|SHOWHOST(true)]} đã chuyển sang tư thế phòng thủ! Nó đã chặn được đòn tấn công!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870536
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870536,
					"content": "Không ngờ sau khi tấn công xong lại tự động chọn phòng thủ. Đúng là phá luật mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870537
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750870537,
					"content": "Cách để thắng trong trận đấu theo lượt là đừng chơi theo lượt!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870538
					]
				},
				{
					"id": 750870538,
					"content": "Tiếp theo nên làm gì đây?",
