					"Yuuya",
					"Kurosawa Kyounosuke"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20050101,
					"content": "Kỳ lạ, nghe nói Hiệp Hội Tenryou trực thuộc sự quản lý của Shogun, quản lý các vấn đề an ninh trật tự của Inazuma, lệnh truy lùng Vision cũng do họ thực hiện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050102,
					"content": "Nhưng vì sao họ lại ra tay với người của mình chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050103,
					"content": "Không hiểu được...chờ đã, bên đó có cãi nhau kìa, chúng ta qua đó xem thử trước đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050104,
					"content": "Lương thực cứu tế tháng này, anh định không đưa phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050105
					],
					"speakerTitle": "Oomori"
				},
				{
					"id": 20050105,
					"content": "Cả nhà chúng tôi đều đang chờ số lương thực này để sống đấy! Hôm nay không nói rõ ràng thì anh đừng hòng đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050106
					],
					"speakerTitle": "Yuuya"
				},
				{
					"id": 20050106,
					"content": "Đã nói bao nhiêu lần rồi, tôi không biết lương thực cứu tế gì cả...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050107
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050107,
					"content": "Còn bịp bợm ư, đó chính là lương thực cứu tế chứ không phải cho samurai các người bỏ túi riêng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050108
					],
					"speakerTitle": "Oomori"
				},
				{
					"id": 20050108,
					"content": "Là samurai thì muốn làm gì làm sao! Tôi phải đến Hiệp Hội Tenryou để kiện anh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050109
					],
					"speakerTitle": "Yuuya"
				},
				{
					"id": 20050109,
					"content": "Lương thực cứu tế là...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050110
					]
				},
				{
					"id": 20050110,
					"content": "Ai đấy? Đồng bọn với Kurosawa sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050111
					],
					"speakerTitle": "Oomori"
				},
				{
					"id": 20050111,
					"content": "Không không không, chúng tôi chỉ là người qua đường thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050112,
					"content": "Nghe mọi người cãi nhau nên muốn qua hóng hớt thử.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050113,
					"content": "Thì ra là vậy. Vậy bạn giúp chúng tôi phân xử đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050114
					],
					"speakerTitle": "Oomori"
				},
				{
					"id": 20050114,
					"content": "Đây là samurai tên là Kurosawa, người của Quân Shogunate. Quân Shogunate phân phát lương thực cứu tế cho vùng này, anh ta là người phụ trách.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050115
					],
					"speakerTitle": "Oomori"
				},
				{
					"id": 20050115,
					"content": "Trước đây chúng tôi chỉ cần tìm anh ta là lãnh được lương thực ngay, nhưng đột nhiên bây giờ anh ta không phát nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050116
					],
					"speakerTitle": "Oomori"
				},
				{
					"id": 20050116,
					"content": "Chắc chắn do anh ta nổi lòng tham nên muốn một mình nuốt hết số lương thực này! Nhưng nếu không có chúng, chúng tôi sẽ đói mất!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050117
					],
					"speakerTitle": "Oomori"
				},
				{
					"id": 20050117,
					"content": "Chẳng ai nghĩ đến cảm nhận của chúng tôi cả...trước đây còn tưởng anh ấy là người tốt, bây giờ xem ra anh ấy cũng chẳng khác gì với những samurai kia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050118
					],
					"speakerTitle": "Yuuya"
				},
				{
					"id": 20050118,
					"content": "Chả trách ngay cả Vision cũng bị lấy lại, có lẽ Raiden Shogun trị quốc cũng không cần loại người này hỗ trợ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050119
					],
					"speakerTitle": "Yuuya"
				},
				{
					"id": 20050119,
					"content": "Thì ra đây là người mà Ayaka nói sao, nhưng vì sao Ayaka lại muốn chúng ta giúp hạng người này chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050120,
					"content": "Thôi thì chúng ta hỏi tên samurai Kurosawa nghĩ thế nào trước đã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
