					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050803
					],
					"speakerTitle": "Ken"
				},
				{
					"id": 20050803,
					"content": "Chút tiền này chẳng đáng kể gì, đây chỉ là bước đầu tiên để anh em chúng ta làm giàu thôi!",
					"roleType": "TALK_ROLE_NPC",
