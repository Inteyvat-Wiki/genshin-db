			"trigger": {
				"objectNames": [
					"Kurosawa Kyounosuke"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20050501,
					"content": "Lương thực cứu tế gì chứ, tôi chưa từng nghe đến chuyện này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050502
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050502,
					"content": "Không biết những người này nghe được tin đồn ở đâu, lại muốn chạy đến đây lừa tôi. Nực cười, nếu tôi giấu giếm lương thực cứu tế thì có nghèo rớt mùng tơi như vậy không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050503
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050503,
					"content": "Nhà tôi còn chẳng có gì để ăn...không có chuyện gì thì tránh ra đi, tôi còn phải làm việc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050504
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050504,
					"content": "Nghe nói anh bị mất Vision...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050505
					]
				},
				{
					"id": 20050505,
					"content": "Đúng thế. Người của Quân Shogunate nói tôi bất mãn với lệnh truy lùng Vision, lúc nào cũng lười nhác, lại còn nói tôi có lỗi với Raiden Shogun, nên đã thu hồi Vision của tôi rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050506
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050506,
					"content": "Lạ vậy, anh là người thi hành lệnh truy lùng Vision mà, sao lại bất mãn chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050507,
					"content": "Nói thật là tôi cũng không nhớ rõ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050508
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050508,
					"content": "Tôi chỉ nhớ lúc đó hình như tháng nào tôi cũng làm một số việc, nhưng bây giờ không còn muốn làm nữa rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050509
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050509,
					"content": "Không những không nhớ mà cứ thấy trong lòng không thoải mái...cứ như ai nợ tôi cái gì vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050510
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050510,
					"content": "Có liên quan đến lương thực cứu tế không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050511,
					"content": "Tôi không hề chiếm lương thực làm của riêng! Vẫn là câu nói đó, nếu có lương thực cứu tế để lấy thì ai muốn phải sống cực khổ như tôi vậy chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050512
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050512,
					"content": "Hơn nữa nhà tôi vừa bị Đạo Bảo Đoàn cướp bóc...đúng rồi, lúc nãy tôi đuổi theo chúng đến đây thì đột nhiên bị chặn lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050513
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050513,
					"content": "Nếu các người không tin thì hãy đi giáo huấn đám Đạo Bảo Đoàn một trận rồi hỏi thử chúng xem nhà tôi có lương thực cứu tế không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050514
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050514,
					"content": "Ừm...trông anh ấy không giống đang nói dối.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050515,
					"content": "Nhưng cũng không thể xác định...chúng ta hãy bắt một người của Đạo Bảo Đoàn hỏi thử xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050516,
					"content": "Đi theo dấu vết mà Đạo Bảo Đoàn để lại chắc sẽ tìm được chúng thôi. Nhân lúc chúng chưa chạy xa, chúng ta hãy mau đuổi theo đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
