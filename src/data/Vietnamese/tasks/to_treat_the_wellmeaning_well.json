			},
			"dialogs": [
				{
					"id": 20050201,
					"content": "Đáng ghét, sao lại thế này...tiền của tôi, đó là số tiền mà chúng tôi vất vả trộm về đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050202
					],
					"speakerTitle": "Ken"
				},
				{
					"id": 20050202,
					"content": "Lão đại, mau nghĩ cách đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050203
					],
					"speakerTitle": "Ken"
				},
				{
					"id": 20050203,
					"content": "Khụ khụ...trông có vẻ có bản lĩnh đấy, không biết có hứng thú gia nhập Đạo Bảo Đoàn không, cùng chúng tôi suy tính đại sự?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050204,
						20050205
					],
					"speakerTitle": "Tadao"
				},
				{
					"id": 20050204,
					"content": "Hãy kể chuyện của Kurosawa cho tôi nghe trước.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050206
					]
				},
				{
					"id": 20050206,
					"content": "Kurosawa? À à...tôi nhớ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050207
					],
					"speakerTitle": "Tadao"
				},
				{
					"id": 20050207,
					"content": "Các người được hắn cử đến sao? Xúi quẩy thật, đáng lẽ tôi không nên tiện đường ghé đến nhà hắn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050208
					],
					"speakerTitle": "Tadao"
				},
				{
					"id": 20050208,
					"content": "Nhà của Kurosawa thế nào? Có rất nhiều lương thực chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050209,
					"content": "Lương thực? Không có không có, đã vậy trong nhà còn lộn xộn, chỉ có...một chiếc hộp trông có vẻ đặc biệt, tôi đoán trong đó chắc chắn là báu vật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050210
					],
					"speakerTitle": "Tadao"
				},
				{
					"id": 20050210,
					"content": "Định là khi trở về sẽ mở ra xem vì tôi sợ bị người khác dòm ngó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050211
					],
					"speakerTitle": "Tadao"
				},
				{
					"id": 20050211,
					"content": "Nhưng lại bị các người bắt được, thôi thì dùng chiếc hộp này để chuộc chúng tôi vậy, thấy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050212
					],
					"speakerTitle": "Tadao"
				},
				{
					"id": 20050212,
					"content": "Xem như có thành ý đó, mau mở ra xem thử đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050213,
					"content": "A!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050214
					],
					"speakerTitle": "Ken"
				},
				{
					"id": 20050214,
					"content": "Đây là!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050215
					],
					"speakerTitle": "Tadao"
				},
				{
					"id": 20050215,
					"content": "Giấy, giấy nợ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050216
					],
					"speakerTitle": "Gou"
				},
				{
					"id": 20050216,
					"content": "Lại còn rất nhiều nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050217,
					"content": "Hình như là giấy nợ viết cho Aoi ở Tiệm Tạp Hóa, woa...nợ nhiều tiền thế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050218,
					"content": "Rốt cuộc là chuyện gì thế...chúng ta đến Tiệm Tạp Hóa hỏi đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050219,
					"content": "Ê, các người đi đi! Cẩn thận lần sau đừng để chúng tôi bắt được nữa đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050220,
					"content": "Được được! Cám ơn cám ơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050221
					],
					"speakerTitle": "Ken"
				},
				{
					"id": 20050221,
					"content": "Lấy giấy nợ chuộc thân...thì có tính là chúng ta đã hời không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050222
					],
					"speakerTitle": "Gou"
				},
				{
					"id": 20050222,
					"content": "Mau đi đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tadao"
				},
				{
					"id": 20050205,
					"content": "Nghe nói các người cướp sạch nhà của Kurosawa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050206
					]
				}
			]
		},
