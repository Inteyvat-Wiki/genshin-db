						"stepId": 200505,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Kurosawa Kyounosuke"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20050401,
					"content": "Sao chỉ còn một mình anh ở đây thế, hai người vừa nãy vây lấy anh đâu rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050402,
					"content": "Tôi nói với họ nếu còn không đi, thì tôi sẽ rút đao, nên họ đi mất rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050403
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050403,
					"content": "Quả nhiên là có hiệu quả hơn việc khuyên bằng lời. Có lẽ sau này tôi cũng nên...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050404
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050404,
					"content": "Chuyện của Đạo Bảo Đoàn đã điều tra được chưa? Tôi không lừa các bạn đúng không!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050405
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050405,
					"content": "Thật ra...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050406
					]
				},
				{
					"id": 20050406,
					"content": "Mọi việc là như vầy. Thực ra đúng là anh đã phát lương thực cho mọi người, chỉ là, số lương thực này do anh tự móc tiền túi ra mua đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050407,
					"content": "Sao có thể...trước kia tôi đã từng là người như vậy sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050408
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050408,
					"content": "Tôi chẳng còn ấn tượng gì hết. Cho dù bạn nói những chuyện này cho tôi biết thì tôi cũng không nhớ nổi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050409
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050409,
					"content": "Vì sao trước đây tôi lại làm thế? Vậy chẳng phải tự chuốc khổ vào thân sao? Khó hiểu thật...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050410
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050410,
					"content": "Nhưng quả thật lúc nãy khi cầm thanh đao để uy hiếp hai người họ, tôi cũng cảm thấy cơ thể mình đang phản kháng một cách bản năng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050411,
						20050412
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050411,
					"content": "Thanh đao này....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050413
					]
				},
				{
					"id": 20050413,
					"content": "Đây đã từng là thanh đao của cha tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050414
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050414,
					"content": "Còn nhớ lúc tôi còn nhỏ, đã có lần trộm thanh đao này từ chỗ của cha, muốn khoe khoang với mấy đứa nhỏ hàng xóm một chút, cuối cùng là bị cha mắng cho một trận ra trò.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050415
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050415,
					"content": "Ông ấy nói với tôi...nói gì nhỉ...kỳ lạ thật, tôi lại không nhớ gì rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050416
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050416,
					"content": "Sau khi Vision bị cướp đi, hình như tôi đã quên đi rất nhiều chuyện. Trong ký ức là một khoảng trống lớn, cho dù suy nghĩ thế nào cũng không nhớ lại được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050417
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050417,
					"content": "Chỉ nhớ hình như cha có nói, trên thanh đao này là lý tưởng của cả cuộc đời ông. Trước lúc rời khỏi thế gian này, còn tận tay giao lại thanh đao cho tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050418
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050418,
					"content": "Còn nói với tôi là, cầm lấy thanh đao này, thì hãy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050419
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050419,
					"content": "Ừm...nhìn kỹ thì, trên chuôi đao hình như có khắc chữ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050420,
					"content": "Nhà Lữ Hành có thể nhìn ra trên đó khắc gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050421,
					"content": "Là \"nhân nghĩa\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050422
					]
				},
				{
					"id": 20050422,
					"content": "Nhân nghĩa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050423
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050423,
					"content": "Nếu nói vậy, thì hình như có thể hiểu được rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050424
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050424,
					"content": "Có lẽ bất chấp việc nợ nần chồng chất, cũng muốn cho người khác có được hạnh phúc, chính là nguyện vọng lớn nhất trước kia của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050425
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050425,
					"content": "Nhưng \"nhân nghĩa\" thì có tác dụng gì? Tôi làm theo đạo lý này, dùng tiền của mình để mua lương thực cứu giúp họ, kết quả thì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050426
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050426,
					"content": "Hiệp Hội Tenryou cướp mất Vision của tôi, còn những người được tôi giúp đỡ cũng không muốn hiểu tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050427
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050427,
					"content": "Điều mỉa mai nhất là tôi còn cảm thấy đau lòng khi rút đao uy hiếp họ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050428
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050428,
					"content": "Tôi không làm được người tốt, mà người xấu cũng làm không xong! Rốt cuộc...rốt cuộc tôi phải làm thế nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050429
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050429,
					"content": "Lại là một người đáng thương...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050430,
					"content": "Về việc nợ nần của anh ấy, khi nào rảnh chúng ta thử nói với Thoma xem sao, Hiệp Hội Yashiro chắc sẽ hỗ trợ anh ấy mà nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050431,
					"content": "Nói chung không thể để anh ấy bán đi thanh đao mà mình trân trọng nhất được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050432,
						20050433
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050432,
					"content": "Mất đi Vision...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050434
					]
				},
				{
					"id": 20050434,
					"content": "Ừm...thì ra mất đi nguyện vọng lại là chuyện đáng sợ như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050435
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050435,
					"content": "May mà bạn không có Vision, đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050436
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050436,
					"content": "Chúng ta hãy đến chỗ người mất Vision tiếp theo đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050433,
					"content": "Hình như thực sự rất đáng sợ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050434
					]
				},
				{
					"id": 20050412,
					"content": "Có thể cho chúng tôi xem một chút không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050413
					]
				}
			]
		},
		{
			"id": 200505,
			"completionStepIds": [
				200506
			],
			"beginWay": "TALK_BEGIN_MANUAL",
