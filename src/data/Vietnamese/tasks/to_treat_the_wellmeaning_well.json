						20050804
					],
					"speakerTitle": "Tadao"
				},
				{
					"id": 20050804,
					"content": "Bắt đầu từ hôm nay, tôi sẽ dẫn dắt mọi người gây dựng danh tiếng trong nghề trộm này, để tiếng tăm của chúng ta ngày càng vang dội!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050805
					],
					"speakerTitle": "Tadao"
				},
				{
					"id": 20050805,
					"content": "Hoan hô lão đại!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050806
					],
					"speakerTitle": "Gou"
				},
				{
					"id": 20050806,
					"content": "...Xem ra chúng chính là Đạo Bảo Đoàn mà chúng ta cần tìm, hãy dạy dỗ chúng một trận nào.",
					"roleType": "TALK_ROLE_NPC",
