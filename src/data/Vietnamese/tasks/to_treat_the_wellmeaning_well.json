			"dialogs": [
				{
					"id": 20050301,
					"content": "\"Tiệm Tạp Hóa Tsukumomono\", không gì là không có. Quý khách muốn mua gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050302
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050302,
					"content": "Hay là...muốn nghe ngóng gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050303
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050303,
					"content": "Giấy nợ này...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050304
					]
				},
				{
					"id": 20050304,
					"content": "Ha ha, thì ra là bạn của Kurosawa, quý khách đến trả nợ giúp Kurosawa sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050305
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050305,
					"content": "Đâu có, chúng tôi chỉ muốn hỏi thăm về lai lịch của tờ giấy nợ này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050306,
					"content": "Vì sao Kurosawa lại nợ nhiều tiền thế, anh ta đã mua thứ gì quý giá ở đây sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050307,
					"content": "Để tôi nhớ lại xem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050308
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050308,
					"content": "Kurosawa định kỳ sẽ mua một lượng lớn lương thực ở chỗ chúng tôi, nhưng anh ấy dùng tiền lương của mình để mua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050309
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050309,
					"content": "Gần đây giá lương thực tăng cao, lương của Kurosawa không đủ để chi nữa, nên anh ấy bắt đầu ghi giấy nợ, để đổi lấy lượng lương thực như cũ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050310
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050310,
					"content": "Thì ra đây chính là nguồn gốc của \"lương thực cứu tế\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050311,
					"content": "Nhưng vì sao Kurosawa cứ phải mua lượng lương thực như cũ nhỉ? Nếu giá thành tăng cao thì mua ít một chút là được rồi mà?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050312,
					"content": "Quý khách nghĩ xem, dân chúng trước khi nhận lương thực cứu tế, chắc chắn sẽ suy đi tính lại xem số lương thực này sẽ cầm cự được bao lâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050313
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050313,
					"content": "Họ tính tới tính lui, ngày đêm đối chiếu, cuối cùng phát hiện lượng lương thực nhận về lại ít hơn dự tính...Kurosawa cho rằng như vậy sẽ khiến họ rất thất vọng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050314
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050314,
					"content": "Vì nghĩ cho cảm nhận của họ, nên Kurosawa thà tự mình chịu một khoản nợ để đổi lấy lượng lương thực như cũ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050315
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050315,
					"content": "Thực tế thì số lương thực này là do Kurosawa tự mình mua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050316,
					"content": "Bọn họ không hề cám ơn Kurosawa mà ngược lại còn không ngừng trách mắng anh ấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050317,
					"content": "Thái độ của con người luôn bị hoàn cảnh chi phối, khi đối mặt với khó khăn, đa số người ta đều không nghĩ nhiều như thế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050318
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050318,
					"content": "Theo tôi thấy, nếu ngay từ khi bắt đầu anh ấy công khai nguồn gốc của lương thực cứu tế, thì có lẽ bây giờ sẽ ít phiền phức hơn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050319
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050319,
					"content": "Đương nhiên cũng chỉ ít đi một chút thôi. Việc mà anh ấy làm vốn dĩ chẳng mang lại kết quả gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050320
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050320,
					"content": "Còn về việc vì sao anh ấy mua lương thực cứu tế, vì sao không muốn để lại tên họ cho người khác cảm kích...thì tôi cũng không rõ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050321
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050321,
					"content": "Nếu các bạn hiếu kỳ, có thể đi hỏi thẳng anh ấy mà?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050322
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050322,
					"content": "Anh ấy đã không còn nhớ nữa rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050323
					]
				},
				{
					"id": 20050323,
					"content": "Ồ...hình như anh ấy vừa bị lấy mất Vision...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050324
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050324,
					"content": "Vậy thì phiền phức đấy...nếu Kurosawa không trả hết nợ, thì chỉ còn cách bán luôn thanh đao mà anh ấy rất xem trọng đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050325
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050325,
					"content": "Đao? Đó là gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050326,
					"content": "Kurosawa không nói với bạn sao? Anh ấy có một thanh đao rất quý giá, thường mang theo bên mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050327
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050327,
					"content": "Tôi cũng đã từng hỏi thăm lai lịch của thanh đao đó, thì được biết là do cha anh tặng, cho dù giá có cao thế nào đi nữa cũng sẽ không bán.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050328
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050328,
					"content": "Lúc đó tôi còn thấy tiếc, vì tôi nghĩ mọi vật trên thế gian này đều được định giá. Chỉ cần ra đúng giá thì bất cứ thứ gì cũng có thể mua được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050329
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050329,
					"content": "Các bạn cũng có thể hỏi thử anh ấy về thanh đao này, không chừng câu trả lời mà các bạn đang tìm kiếm đang nằm ở thanh đao này đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050330
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050330,
					"content": "Đương nhiên trước lúc đó, xin mời quý khách hãy thanh toán hóa đơn lần này đã...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050331
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050331,
					"content": "Nhưng chúng tôi đâu có mua gì nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050332
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050332,
					"content": "Ha ha, \"tình báo\" cũng là một món hàng, không phải sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050333
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050333,
					"content": "Nhưng tình báo về Kurosawa không đắt, vì anh ấy không hề dặn chúng tôi phải bảo mật. Để tôi tính xem...chỉ cần 2000 Mora là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050334
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050334,
					"content": "Được thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050335
					]
				},
				{
					"id": 20050335,
					"content": "Ít ra thì chúng ta đã biết về nguồn gốc của lương thực cứu tế cũng như thanh đao mà Kurosawa luôn mang theo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050336
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050336,
					"content": "Nào, đi tìm Kurosawa hỏi thử xem anh ấy có thể nhớ được gì không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 200504,
			"completionStepIds": [
				200505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
