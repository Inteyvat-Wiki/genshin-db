					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730590201,
					"content": "Aranaga, họ đến rồi kìa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590202
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730590202,
					"content": "Ừm ừm, đến rồi, đến rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590203
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730590203,
					"content": "#Đến rồi à, Nara {NICKNAME} và Bông Trắng Bay Bay. Chào mừng các bạn, cả ba chúng tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590204
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730590204,
					"content": "Đến rồi, mặt trăng. Đến lúc rồi, thời khắc trồng hoa. Các bạn đã chuẩn bị xong chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590205
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730590205,
					"content": "Tôi chuẩn bị xong rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730590206
					]
				},
				{
					"id": 730590206,
					"content": "Ừm, tôi cũng vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730590207,
					"content": "Vậy thì... Aranakin, Aragaru, chúng ta hãy bắt đầu nghi thức thôi nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590208
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730590208,
					"content": "\"Về đi, về đi, giấc mộng vườn hoa, ký ức rừng sâu...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590209
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730590209,
					"content": "\"Hãy đón chào, để chúng ta: \"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590210
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730590210,
					"content": "\"Giấc mơ ngày càng sâu, niềm vui không tan đi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590211
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730590211,
					"content": "\"Chúc mừng nào, để chúng ta: \"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590212
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730590212,
					"content": "\"Quả lựu hát vang, quả táo vỗ tay!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590213
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730590213,
					"content": "Các Aranara trồng xuống những bông hoa khô héo, theo lời bài đồng dao vang lên trong gió, những bông hoa sống lại lần nữa như một kì tích...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730590214
					]
				},
				{
					"id": 730590214,
					"content": "Wow... Ba bông hoa này sống lại rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730590215,
					"content": "Đúng vậy, vì \"Mawtiyima\" nhân từ và thương xót. Vì cô ấy muốn để ký ức này có cơ hội được hồi sinh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590216
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730590216,
					"content": "Ừm! Dù chúng tôi không còn nhớ các bạn, ký ức cũng sẽ... à, sẽ hòa vào gân lá và rễ cây, biến thành lá xanh, biến thành vòng sinh trưởng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590217
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730590217,
					"content": "Hoặc biến thành những con sâu béo ú cho những con sâu khác ăn, những con sâu đó sẽ để lại thứ gì đó để nuôi dưỡng cỏ cây, để chúng ta cùng nhau lớn lên!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590218
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730590218,
					"content": "Nhưng mà... các bạn vẫn không nhớ chúng tôi, phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730590219,
					"content": "Ừm... Bởi vì, đó không chỉ là ký ức chỉ thuộc về riêng tôi và bạn... Những việc đã trải qua trong quá khứ, chúng ta đã phân phát hết cho tất cả cỏ cây trong rừng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590220
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730590220,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730590221
					]
				},
				{
					"id": 730590221,
					"content": "Nhưng không sao, chúng ta là bạn mới rồi mà, đúng không!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590222
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730590222,
					"content": "Ừm! Bạn mới!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aragaru"
				}
			]
		},
