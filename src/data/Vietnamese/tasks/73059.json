				"points": []
			},
			"dialogs": [
				{
					"id": 730590101,
					"content": "\"Quả lựu hát vang, quả táo vỗ tay...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590102
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730590102,
					"content": "Xin chào, ông Khayyam! Sao ông lại ở đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730590103,
					"content": "À à, xin chào, xin chào. Bạn nhỏ tóc trắng và... ầy... xin lỗi nha, bạn nhỏ, đầu óc của ta không nhớ rõ nữa, hễ thời gian qua lâu một chút là ta không nhớ được tên...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590104
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730590104,
					"content": "#Gọi cháu {NICKNAME} là được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730590105
					]
				},
				{
					"id": 730590105,
					"content": "Haha... Được thôi, các cháu là người trước đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590106
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730590106,
					"content": "Đúng rồi! Bọn cháu là hai \"Javan\" đó đây... những người thanh niên dũng cảm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730590107,
					"content": "À... Vậy hãy cho ta biết, \"Aranara\" có còn nhớ ta không? Có còn nhớ tất cả mọi người không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590108
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730590108,
					"content": "À... chuyện này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590109,
						730590112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730590109,
					"content": "Họ vẫn nhớ ông.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730590110
					]
				},
				{
					"id": 730590110,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730590111,
					"content": "Vậy sao... Nhưng ta không thể nhìn thấy họ, cũng không thể nghe được họ nói nhớ ta như thế nào... Đúng là đáng tiếc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590114
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730590114,
					"content": "Haha... Ta không gặp được họ nữa rồi. Ta đã quá già, không thấy được dáng vẻ của họ, không nghe được âm thanh của họ... Vuột mất rồi, đã bỏ lỡ mất rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590115
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730590115,
					"content": "Khụ khụ... Xin lỗi, ta đi trước nhé. Có lẽ chỉ có thể chờ vào kỳ tích mà thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590116
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730590116,
					"content": "Kỳ tích không thể lý giải, cũng không thể theo đuổi, chỉ có thể chờ đợi mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590117
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730590117,
					"content": "Khayyam loạng choạng bỏ đi...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 730590112,
					"content": "Họ không còn nhớ ông.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730590113
					]
				},
				{
					"id": 730590113,
					"content": "Nhưng mà... chúng ta vẫn có thể kết bạn với họ thêm lần nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590114
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7305902,
