			"dialogs": [
				{
					"id": 760320201,
					"content": "Này nhóc, có biết tự ý xông vào cấm địa sẽ có kết cục gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760320202
					],
					"speakerTitle": "Oprichniki Fatui"
				},
				{
					"id": 760320202,
					"content": "...Tôi vừa mới biết mà! Vì là lần đầu phạm tội chưa có kinh nghiệm. Hay là thế này, anh cho tôi thêm một cơ hội được không?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760320203
					],
					"speakerTitle": "Người Khả Nghi"
				},
				{
					"id": 760320203,
					"content": "Cho tôi thêm một cơ hội, lần sau tôi đảm bảo sẽ không để anh bắt được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760320204
					],
					"speakerTitle": "Người Khả Nghi"
				},
				{
					"id": 760320204,
					"content": "Đùa gì vậy, <color=#00E1FFFF>lũ chuột nhắt thèm khát báu vật</color>, một con cũng không thể tha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760320205
					],
					"speakerTitle": "Oprichniki Fatui"
				},
				{
					"id": 760320205,
					"content": "Haiz! Ngay bây giờ biết đâu đứa nhóc đó đã dọn sạch đồ đi rồi, còn ở đây so đo với tôi làm gì!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760320206
					],
					"speakerTitle": "Người Khả Nghi"
				},
				{
					"id": 760320206,
					"content": "Kết cục có thế nào không đến lượt ngươi lo. Giơ tay chịu trói đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Oprichniki Fatui"
				}
			]
		}
	]
