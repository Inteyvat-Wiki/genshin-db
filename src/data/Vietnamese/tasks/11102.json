			"trigger": {
				"objectNames": [
					"Xiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111020201,
					"content": "Là hai người... tôi vẫn còn nhớ hai người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020202
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020202,
					"content": "Tôi đang ở đây dọn dẹp sinh vật nhiễm Yêu Tà, xem ra đã gây trở ngại cho hai vị rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020203
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020203,
					"content": "(Í, hình như anh ấy khách khí quá rồi...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020204,
					"content": "Anh ở đây trừ yêu diệt ma, làm sao có thể nói là gây trở ngại cho chúng tôi chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020205,
					"content": "Vì ma vật dị biến là do tôi mà ra, chúng nhiễm Nghiệp Chướng của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020206
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020206,
					"content": "Dị biến, Nghiệp Chướng... A, lẽ nào...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020207,
						111020208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020207,
					"content": "Nhưng trong \"Hộ Pháp Tiên Chúng Dạ Xoa Lục\" từng nhắc...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111020209
					]
				},
				{
					"id": 111020209,
					"content": "Đúng vậy, hình như tôi vẫn nhớ Xiao có danh xưng Hộ Pháp Dạ Xoa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020210,
					"content": "Thì ra là vậy... à... ừm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020211,
					"content": "Xiao đáng thương quá đi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020212,
					"content": "...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020213,
						111020214
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020213,
					"content": "Chúng tôi vừa biết được quá khứ của anh qua sách...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111020215
					]
				},
				{
					"id": 111020215,
					"content": "Ừm, là mấy câu chuyện phiếm của văn nhân mấy trăm năm trước ấy mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020216
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020216,
					"content": "Vạn vật biến hoá vô thường, tất thảy đều là bể khổ. Ý chí của Dạ Xoa chưa từng kèm theo sự thương cảm và nước mắt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020217
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020217,
					"content": "Những đồng liêu đã mất của tôi cũng sẽ không thích người đời sau phán đoán như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020218
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020218,
					"content": "Ừm, ừm... ngại quá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020219,
					"content": "Không sao. Tôi đang tới một hang động để diệt trừ yêu khí tà ma, xin phép đi trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020220
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020220,
					"content": "Đưa, đưa chúng tôi theo với, chúng tôi nhất định sẽ được việc!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020221,
					"content": "Không cần, tôi quen đi một mình, huống hồ những dị biến này cũng bắt nguồn từ tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020222
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020222,
					"content": "Coi như tôi đền bù lúc nãy thất lễ đi! Được không?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020223,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020224
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020224,
					"content": "...Theo tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020214,
					"content": "Chúng tôi vừa đọc Hộ Pháp Tiên Chúng Dạ Xoa Lục.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111020215
					]
				},
				{
					"id": 111020208,
					"content": "Xiao chính là \"Vị Dạ Xoa cuối cùng\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111020209
					]
				}
			]
		},
