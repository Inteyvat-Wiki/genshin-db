			},
			"dialogs": [
				{
					"id": 111020401,
					"content": "Tà khí nơi này khiến người ta sởn tóc gáy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020402,
					"content": "Tôi sẽ dùng Vũ Điệu Trừ Yêu để diệt trừ Nghiệp Chướng nơi này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020403
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020403,
					"content": "Hãy cố gắng giữ bình tĩnh, cẩn thận đừng để tà niệm Ma Thần làm nhiễu loạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xiao"
				}
			]
		},
		{
			"id": 1110206,
			"completionStepIds": [
				1110205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1110205",
							"2"
						],
						"stepId": 1110205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111020601,
					"content": "Sinh vật nhiễm Yêu Tà nhiều như vậy, đúng là dị thường... Nếu không sớm diệt trừ, hậu quả sẽ rất khó lường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020602
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020602,
					"content": "Vừa nãy hai người có nhắc đến Tinh Nguyệt Thiên Quân, là chuyện gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020603
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020603,
					"content": "Để tôi kể cho Xiao nghe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020604,
					"content": "Những người đó... bị kẻ giả làm \"tiên nhân thực hiện nguyện vọng\" lừa đảo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020605
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020605,
					"content": "Xiao là một tiên nhân, liệu có sức mạnh thực hiện nguyện vọng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020606,
					"content": "Liyue xưa kia sẽ không yêu cầu những thứ không cần lao động mà vẫn có được như thế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020607
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020607,
					"content": "Thứ mà người dân Liyue mấy ngàn năm trước cần là sức mạnh bảo vệ mảnh đất họ đang sống.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020608
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020608,
					"content": "Nhưng đối với người ở thời đại này, đúng là tiên nhân thực hiện nguyện vọng sẽ có sức hấp dẫn hơn nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020609,
					"content": "Nhưng, dù thời đại này yếu ớt tới mức nào, cũng không liên quan đến tôi. Tôi chỉ biết tuân theo ý chỉ sơ khai của Đế Quân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020610
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020610,
					"content": "Paimon hình như lại nói sai rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020611,
					"content": "A... đúng rồi! Kẻ giả tiên nhân đó mang theo Bách Vô Cấm Kỵ Lục, còn dùng nó để trừ ma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020612,
					"content": "Có chuyện này sao? Hừ... tên ngốc. Chỉ đuổi ma chứ không trừ ma, thảo nào yêu dị đều tụ lại đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020613
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020613,
					"content": "Cứ như vậy, e là sẽ vượt quá sự khống chế của tôi... nhất định phải thu hồi Bách Vô Cấm Kỵ Lục từ tay hắn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020614,
						111020615
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020614,
					"content": "Chỉ \"thu hồi\" vẫn không đủ nhỉ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111020616
					]
				},
				{
					"id": 111020616,
					"content": "Không hổ danh là bạn tốt của tôi! Paimon cũng nghĩ vậy, nhất định phải cho tên dám lừa bịp chúng ta đó một bài học nhớ đời.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020617
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020617,
					"content": "Vừa khéo chỗ chúng ta có vị tiên nhân thật... Nếu Xiao ra tay, hắn nhất định sẽ không dám giả mạo tiên nhân nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020618,
					"content": "Không được. Tôi chỉ trảm yêu ma, không giết người phàm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020619
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020619,
					"content": "Đâu có bảo anh giết hắn đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020620,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020621
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020621,
					"content": "Nếu có thể khiến hắn không làm chuyện gian ác nữa, thì rất có ích với Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020622
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020622,
					"content": "Tôi có một cách, theo \"Cảnh Pháp Kẻ Mộng Du\", dùng giấc mơ khiến hồn phách rời khỏi cơ thể để tu hành...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020623
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020623,
					"content": "Nhưng cũng có thể dùng cách này, triệu gọi hồn phách người khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020624
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020624,
					"content": "Ồ, quả đúng là Tiên pháp!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020625,
						111020626
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020625,
					"content": "Dạng như \"báo mộng\" à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111020627
					]
				},
				{
					"id": 111020627,
					"content": "Phép này cần chuẩn bị nghi thức. Hãy giúp tôi tìm 1 lư hương, 7 ngọn đèn, và 1 số vật có thể giảm nhiệt độ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020628
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020628,
					"content": "Vật giảm nhiệt độ... Băng Vụ Hoa chắc là được?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020629
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020629,
					"content": "Nhưng lư hương và 7 ngọn đèn, hình như không phải thứ có thể tuỳ tiện nhặt được?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020630
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020630,
					"content": "Hai người biết 2 bức Tượng Đá Dạ Xoa bên cạnh thương lộ phía Nam Thiên Hoành Sơn không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020631
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020631,
					"content": "Dân chúng Liyue ngày trước từng xây miếu thờ phụng Dạ Xoa ở gần đó, ắt là có thể tìm được một số vật dụng cúng tế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020632
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020632,
					"content": "#Sau khi tìm đủ những thứ này, đêm xuống lại đến Tượng Đá Dạ Xoa tìm tôi, tôi sẽ dạy {F#cô}{M#cậu} thi triển phép thuật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020626,
					"content": "Chỉ e sẽ làm hắn sợ hết hồn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111020627
					]
				},
				{
					"id": 111020615,
					"content": "Tôi muốn cho hắn một bài học.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111020616
					]
				}
			]
