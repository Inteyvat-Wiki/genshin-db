			"dialogs": [
				{
					"id": 250350801,
					"content": "Hai này... Ba này... Đủ rồi. Tốt quá, mấy món đồ bị thất lạc đều đã tìm thấy hết rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350802
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350802,
					"content": "...Chờ đã, món đồ này có phải do Tundama gửi không nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350803
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350803,
					"content": "#Thù lao đây, cảm ơn {F#cô}{M#cậu} đã giúp đỡ nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350804
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350804,
					"content": "Haiz, đúng là tôi phải đi nói chuyện với cái cậu Tundama này mới được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Michica"
				}
			]
		},
