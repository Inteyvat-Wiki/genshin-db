							"2"
						],
						"stepId": 2503501,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Michica"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250350101,
					"content": "Cái đám ăn hại này. Sao lại mất mấy món hàng rồi. Đã dặn đừng có làm mấy trò mèo khi đi giao đồ rồi mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350102
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350102,
					"content": "Đã xảy ra chuyện gì sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250350103
					]
				},
				{
					"id": 250350103,
					"content": "Có vài Bưu Tá không nghe lời, làm mất hàng mà người ta gửi đi rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350104
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350104,
					"content": "Haiz, họ đều không nhận ra là việc này đang ảnh hưởng đến danh tiếng của Dòng Dõi Vườn Treo hay sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350105
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350105,
					"content": "Đi giao đồ thì cứ đi giao cho cẩn thận, gặp sườn núi thì cứ vượt qua như bình thường thôi. Việc gì mà lại tự nhiên đi chơi trò trượt xuống giữa đường thế không biết?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350106
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350106,
					"content": "Tôi đã nói bao nhiêu lần rồi, nhưng cái đám thanh niên đó có chịu nghe đâu. Suốt ngày chỉ mải mê theo đuổi sự kích thích...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350107
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350107,
					"content": "Haiz, tôi còn phải đi nhờ người để tìm số hàng đó về nữa. Ai mà rảnh chứ? Để nghĩ xem nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350108,
						250350111
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350108,
					"content": "Để tôi giúp một tay.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250350109
					]
				},
				{
					"id": 250350109,
					"content": "#{F#Cô}{M#Cậu} đồng ý giúp tôi sao? Thế tốt quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350110
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350110,
					"content": "Trong thời gian ngắn tôi cũng không tìm được người có thể giúp đỡ, nếu tự mình đi tìm, thì Trạm Bưu Tá lại không còn ai trông coi nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350117
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350117,
					"content": "#Tôi cũng sẽ không để {F#cô}{M#cậu} phải mò kim đáy bể đâu. Tôi biết đám nhóc đó thường đi từ đâu, cũng có thể đoán được nơi những món đồ đó bị thất lạc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350118
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350118,
					"content": "#Để tôi đánh dấu địa điểm những món đồ bị thất lạc, nhờ cả vào {F#cô}{M#cậu} nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350111,
					"content": "Mấy món đồ đó rất lớn à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250350112
					]
				},
				{
					"id": 250350112,
					"content": "Không lớn đâu. Nhưng chính vì không lớn, mỗi lần tìm kiếm đều rất rắc rối. Haiz, mấy cái tên ẩu đoảng đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350113
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350113,
					"content": "#...Nếu {F#cô}{M#cậu} có thời gian, có thể giúp tôi đi tìm mấy món hàng đó không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350114
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350114,
					"content": "Hiện giờ nhân lực của Trạm Bưu Tá cũng không đủ, nếu tôi tự đi tìm thì sẽ không còn ai trông coi nơi này nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350115
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350115,
					"content": "Không thành vấn đề, cứ để tôi giúp.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250350116
					]
				},
				{
					"id": 250350116,
					"content": "#Vậy tốt quá! Cảm ơn {F#cô}{M#cậu} nhiều!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350117
					],
					"speakerTitle": "Michica"
				}
			]
		},
