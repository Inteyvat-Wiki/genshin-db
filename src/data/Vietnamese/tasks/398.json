			"dialogs": [
				{
					"id": 3980301,
					"content": "Rất cảm ơn các bạn! Cuối cùng mọi chuyện cũng kết thúc rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980302
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 3980302,
					"content": "Do ảnh hưởng bởi tai họa của rồng, rất nhiều tuyến đường thương mại bị ách tắc. Lương thực hoa màu không đáng nói... Chứ rượu mà mất nguồn hàng thì đúng là chuyện lớn rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980303
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 3980303,
					"content": "Tôi không dám nghĩ đến những tháng ngày không có rượu để nhâm nhi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980304
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 3980304,
					"content": "Hy vọng tuyến đường thương mại sẽ sớm được khôi phục.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nimrod"
				}
			]
		},
