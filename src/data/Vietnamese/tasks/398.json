			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Amber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3980101,
					"content": "Hả, là các bạn sao! Kỵ Sĩ Danh Dự thắng trận trở về rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980102
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980102,
					"content": "#Hì hì, {NICKNAME} đã chiến đấu rất kiên cường với Dvalin đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980103,
					"content": "Ừm, các bạn mới về hôm qua phải không? Đội trưởng Jean đã quay về Mondstadt trước và kể cho tất cả mọi người kỳ tích của các bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980104
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980104,
					"content": "Không biết phải đợi đến bao giờ tôi mới có được cơ hội như vậy cơ chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980105,
						3980108
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980105,
					"content": "Tất cả là nhờ sự chỉ dẫn của Amber.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980106
					]
				},
				{
					"id": 3980106,
					"content": "Không phải vậy đâu, có thể giải quyết sự việc trong yên bình như vậy, là nhờ cả vào các bạn mới đúng",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980107
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980107,
					"content": "Trước kia, khi tôi dẫn các bạn đến Mondstadt cũng đơn giản chỉ là thực hiện trách nhiệm của Kỵ Sĩ Trinh Thám mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980111
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980111,
					"content": "Hihi, đừng khách sáo. Amber ở đây đợi chúng tôi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980112,
					"content": "Ề, tuy nhiệm vụ lần này không phải đi xa, thế nhưng tôi cũng không nhàn rỗi vậy đâu... Bạn xem nè, tôi đang bận giải quyết việc tồn đọng đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980113
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980113,
					"content": "\"Giải quyết việc tồn đọng\" ư? Thành Mondstadt lại xảy ra chuyện gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980114,
					"content": "Ừm đúng vậy... Khi không có đội trưởng Jean đứng ra chỉ huy, đám ma vật xung quanh thành Mondstadt lại trỗi dậy, chuẩn bị \"tổng tấn công\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980115
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980115,
					"content": "Rất may là tôi đã sớm phát hiện, cứ điểm của Hilichurl tiến gần đến thành Mondstadt một cách bất thường",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980116
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980116,
					"content": "Hả, tôi vẫn còn nhớ lần đầu tiên chúng ta gặp mặt, Amber đang xử lý một trong số những doanh trại của chúng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980117,
					"content": "Đúng vậy, nếu chúng ta không sớm đề phòng, thành Mondstadt sẽ gặp nguy hiểm mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980118,
						3980121
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980118,
					"content": "Đánh đuổi chúng là được mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980119
					]
				},
				{
					"id": 3980119,
					"content": "Ừm, thế nhưng sự việc vẫn rất đáng ngờ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980120
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980120,
					"content": "Đám Hilichurl chắc là không có năng lực phát động tổng tấn công đâu nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980123
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980123,
					"content": "Chính vì thế chúng tôi cho rằng kẻ đứng sau làm trò chính là Giáo Đoàn Vực Sâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980124
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980124,
					"content": "Chúng thao túng đám Hilichurl sao? Hừm... Nếu chúng ta không giải thoát cho Dvalin thì nó ắt hẳn cũng bị thao túng như vậy rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980125,
					"content": "Đúng vậy. Là Kỵ Sĩ Trinh Thám tôi cần phải theo dõi Giáo Đoàn Vực Sâu nhiều hơn nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980126
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980126,
					"content": "Á, thật là ngại quá đi. Rõ ràng là các bạn vừa chiến thắng trở về, tôi lại nhắc đến những chuyện nghiêm túc như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980127
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980127,
					"content": "Đúng rồi! Trước kia tôi từng hứa dắt các bạn đi ăn Thịt Nướng Mật Ong, sau đó lại vì mối hiểm họa của rồng mà quên mất...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980128
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980128,
					"content": "Hay là lần này coi như ăn mừng chiến thắng, tôi mời các bạn vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980129
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980129,
					"content": "Được được! Cho dù Amber có quên đi chăng nữa, Paimon cũng sẽ nhắc nhở!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980130,
					"content": "Hì hì, tôi cũng lâu rồi không ăn Thịt Nướng Mật Ong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980131
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980131,
					"content": "Các bạn đến quán <color=#00E1FFFF>Người Săn Hươu</color> đợi tôi nhé, sau khi thu dọn xong đám chiến trường này tôi sẽ quay về!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980121,
					"content": "Thế nhưng tại sao Hilichurl lại...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980122
					]
				},
				{
					"id": 3980122,
					"content": "Quả là kỳ lạ, đám Hilichurl chắc là không có năng lực phát động tổng tấn công đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980123
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980108,
					"content": "Hy vọng \"cơ hội\" như vậy, đừng xuất hiện quá nhiều...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980109
					]
				},
				{
					"id": 3980109,
					"content": "Hả... Nói vậy cũng đúng, suy cho cùng có được hòa bình cũng không phải việc dễ dàng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980110
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980110,
					"content": "Lần này cũng may nhờ có các bạn mới có thể giải quyết sự việc trong yên bình như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980111
					],
					"speakerTitle": "Amber"
				}
			]
		},
