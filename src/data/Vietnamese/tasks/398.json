			},
			"dialogs": [
				{
					"id": 3980201,
					"content": "Thì ra là đại nhân Dvalin, một trong \"Tứ Phong Thủ Hộ\" ư... Người dân Mondstadt không nên lãng quên sự hy sinh của ngài ấy chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980202
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 3980202,
					"content": "Trong cái rủi lại có cái may, mối quan hệ giữa chúng tôi và đại nhân Dvalin - \"Rồng Đông Phong\" vẫn còn cứu vãn được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980203
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 3980203,
					"content": "May là có các bạn và đội trưởng Jean của Đội Kỵ Sĩ, quả là con người khiêm tốn, thật thà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980204
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 3980204,
					"content": "Nhờ có Đội Kỵ Sĩ Tây Phong, Mondstadt sau này vẫn sẽ yên bình tự do như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				}
			]
		},
