			},
			"dialogs": [
				{
					"id": 3980401,
					"content": "Sự nhộn nhịp đã quay trở lại rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980402
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 3980402,
					"content": "Nguy hiểm, tai ương! Hãy mạo hiểm, hãy nhiệt huyết!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980403
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 3980403,
					"content": "Hiệp Hội Nhà Mạo Hiểm! Cuối cùng thì! Cũng thoát khỏi những tháng ngày sống chung với những ủy thác bắt chó bắt mèo rồi! Kỷ nguyên mạo hiểm mới sắp được bắt đầu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980404
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 3980404,
					"content": "Người bạn trẻ, mau đến gia nhập Hiệp Hội Nhà Mạo Hiểm đi! Trong thời khắc nước sôi lửa bỏng như vậy, cùng nhau vượt qua tai ương của rồng, cứu lấy Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980405
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 3980405,
					"content": "Thật ra...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980406
					]
				},
				{
					"id": 3980406,
					"content": "... Hả, gì cơ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980407
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 3980407,
					"content": "Mối hiểm họa của rồng đã được giải quyết? Tôi đã bỏ lỡ buổi diễn thuyết của Đội Trưởng Đại Diện rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980408
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 3980408,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980409
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 3980409,
					"content": "Sao Phong Ma Long sao không kiên trì thêm chút nữa! Chúng tôi còn chưa ra trận mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyrus"
				}
			]
		},
		{
			"id": 39807,
			"completionStepIds": [
				39807
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
