				"objectNames": [
					"Amber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3980901,
					"content": "Mối hiểm họa của rồng đã kết thúc rồi, vậy tiếp theo các bạn có kế hoạch gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980902
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980902,
					"content": "#Có lẽ sẽ rời khỏi Mondstadt, đi khắp 7 vương quốc để tiếp tục hành trình tìm lại người thân thất lạc của {F#cô ấy}{M#anh ấy}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980903,
					"content": "Là như vậy sao... Vậy là phải tạm thời rời xa nhau rồi ư...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980904,
						3980905
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980904,
					"content": "Tôi cũng không nỡ rời xa Mondstadt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980906
					]
				},
				{
					"id": 3980906,
					"content": "Không sao hết! Bất kể đi về đâu, chỉ cần là nơi gió có thể đến, bạn vẫn mãi là đồng đội của Đội Kỵ Sĩ Tây Phong, là Kỵ Sĩ Danh Dự!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980907,
						3980908
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980907,
					"content": "Nghe theo hướng gió!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980909
					]
				},
				{
					"id": 3980909,
					"content": "Ừm! Mondstadt sẽ luôn chào đón bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980910
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980910,
					"content": "Hì hì, ăn thôi, cứ nói chuyện mà không ăn thịt sẽ nguội mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980911
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980911,
					"content": "Ừm, ngon quá đi. Không hổ danh là món ăn được Amber giới thiệu, thật là quá đã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980912
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980912,
					"content": "Đương nhiên rồi, tuy tôi không có tài nấu nướng, nhưng khả năng thưởng thức món ăn của tôi cũng không tồi đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980913
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980913,
					"content": "Á, đúng rồi tôi xém chút là quên kể cho bạn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980914
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980914,
					"content": "Đội trưởng Jean đang đợi bạn ở <color=#00E1FFFF>Đại Giáo Đường</color> đó, hình như là có liên quan đến chuyện Đàn Thiên Không... Mau đến đó đi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980908,
					"content": "Sau này nhất định sẽ quay trở lại.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980909
					]
				},
				{
					"id": 3980905,
					"content": "Tôi cũng không nỡ rời xa mọi người ở Đội Kỵ Sĩ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980906
					]
				}
			]
		},
