						3982102
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 3982102,
					"content": "Thật là phấn khởi khi nghe Đội Trưởng Đại Diện tường thuật lại sự kiện Phong Ma Long.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3982103
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 3982103,
					"content": "Thật không thể ngờ sự thật lại như vậy, Đội Kỵ Sĩ suýt nữa là mở kế hoạch càn quét rồi... Xem ra chúng tôi quá hấp tấp rồi.",
