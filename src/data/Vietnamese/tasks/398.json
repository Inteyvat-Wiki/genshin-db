			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sara",
					"Kaeya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3980701,
					"content": "Hôm nay quý khách muốn gọi món gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980702
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 3980702,
					"content": "Hừm... Thật là vô tình mà, cứ thế mà phớt lờ \"người bạn chân thành\" này sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980703,
						3980705
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980703,
					"content": "Không để ý nên không nhìn thấy anh mà thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980704
					]
				},
				{
					"id": 3980704,
					"content": "#Haha... Xem ra sau trận đại chiến, {F#cô}{M#cậu} không chỉ tiến bộ về thực lực, mà còn có cả đức tính \"hài hước\" của kỵ sĩ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980707
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980707,
					"content": "Với thân phận là một kỵ sĩ, có thể đứng bên cạnh anh hùng mới nổi của Mondstadt thật là điều vinh dự.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980708
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980708,
					"content": "Tên Kaeya lại ba hoa rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980709,
					"content": "Haha, điều tôi nói đều là thật lòng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980710,
						3980714
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980710,
					"content": "Anh đứng ở đây làm gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980711
					]
				},
				{
					"id": 3980711,
					"content": "Tôi đang tìm một nơi yên tĩnh để suy nghĩ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980712
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980712,
					"content": "Rõ ràng các kỵ sĩ khác đang vất vả dọn dẹp chiến trường...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980713,
					"content": "Suy nghĩ cũng là một chuyện vất vả mà, hơn nữa tôi thấy việc dọn dẹp rất nhẹ nhàng ấy chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980717
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980717,
					"content": "Hừm? Vậy anh đang nghĩ gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980718,
					"content": "Nghĩ đến... Giáo Đoàn Vực Sâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980719
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980719,
					"content": "Rồng hoành hành, Đội Trưởng Kỵ Sĩ phải đi xa để thảo phạt rồng. Đây là cơ hội ngàn vàng của Giáo Đoàn Vực Sâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980720
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980720,
					"content": "#Nếu {F#cô}{M#cậu} là Giáo Đoàn Vực Sâu, {F#cô}{M#cậu} sẽ chỉ phái vài tên Hilichurl đi \"nắm bắt cơ hội tốt như vậy\" sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980721,
						3980722
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980721,
					"content": "Chỉ có vài tên Hilichurl tấn công, quả là kỳ lạ thật...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980723
					]
				},
				{
					"id": 3980723,
					"content": "Để có thể hiểu rõ được chân tướng, tôi sẽ âm thầm theo dõi hành động tiếp theo của chúng là gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980724
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980724,
					"content": "Đến khi các vị khiến cho Phế Tích Phong Long trời long đất lở, tiếng la hét của bọn Hilichurl vang lên ngoài thành...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980725
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980725,
					"content": "Tôi cuối cùng đã phát hiện ra được kẻ khả nghi ẩn nấp ở trong thành Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980726
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980726,
					"content": "Trong thành sao?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980727,
					"content": "Đúng vậy, khi các kỵ sĩ phải chiến đấu ở ngoài thành, trong thành sẽ là lúc phòng ngự yếu nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980728
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980728,
					"content": "Chính vì vậy, tôi đã cố thủ trong thành... Chiến đấu một phen với kẻ xâm nhập đến từ Giáo Đoàn Vực Sâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980729
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980729,
					"content": "Nhờ một vài thủ đoạn nhỏ, tôi đã có được tin tức tình báo mới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980730
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980730,
					"content": "Tin tình báo đó là: Đám quái vật Giáo Đoàn Vực Sâu có thể liên kết lại với nhau là do có kẻ chỉ đạo đằng sau chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980731
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980731,
					"content": "Kẻ chỉ đạo... Giáo Đoàn Vực Sâu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980732
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980732,
					"content": "Kế hoạch biến Dvalin thành vũ khí chiến đấu cũng là do kẻ chỉ đạo này bày trò.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980733
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980733,
					"content": "Dùng \"thủ đoạn\" nào mới có thể lấy được những thông tin này vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980734
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980734,
					"content": "Haha... Có thể xem như tôi có tài năng hơn người về mặt \"ngôn ngữ\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980735
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980735,
					"content": "#Kẻ chỉ đạo đó còn được Giáo Đoàn Vực Sâu gọi là... \"{F#Hoàng tử}{M#Công chúa} điện hạ\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980736
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980736,
					"content": "#\"{F#Hoàng tử}{M#Công chúa}\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980737
					]
				},
				{
					"id": 3980737,
					"content": "Thông tin tình báo chia sẻ đến đây thôi, tôi thấy Amber đang đến kìa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980738
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980738,
					"content": "Cô ấy đang giận tôi vì tôi không cùng cô ấy tham gia kế hoạch tác chiến ngoài thành đây mà... Tôi xin mạn phép rút lui trước, tránh cơn thịnh nộ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980739
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980739,
					"content": "Tên Kaeya quả nhiên chạy mất tiêu rồi! Đúng là làm chuyện mờ ám nên cứ nơm nớp lo sợ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980740,
						3980742
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980740,
					"content": "Thật ra anh ấy đang âm thầm theo dõi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980741
					]
				},
				{
					"id": 3980741,
					"content": "Thật vậy sao? Ừm... Bạn cẩn thận không là bị lời lẽ đường mật của hắn làm xiêu lòng đó?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980744
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980744,
					"content": "Tạm thời không nhắc đến hắn nữa. Vất vả cả buổi, hiện giờ bụng tôi cứ réo liên tục, chúng ta đi gọi món đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980745
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980745,
					"content": "Tiểu thư Sara, tôi muốn gọi món Thịt Nướng Mật Ong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980742,
					"content": "Đúng vậy! Quả là một tên láu cá!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980743
					]
				},
				{
					"id": 3980743,
					"content": "Đội Trưởng Kỵ Binh mà lại không làm gương cho người khác, hừm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980744
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980722,
					"content": "Vậy thì sự thật đằng sau là...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980723
					]
				},
				{
					"id": 3980714,
					"content": "Anh lại có ý đồ gì đó?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980715
					]
				},
				{
					"id": 3980715,
					"content": "Tôi ư? Không phải, hoàn toàn ngược lại thì có. Tôi đang suy nghĩ xem \"người khác\" đang có ý đồ gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980716
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980716,
					"content": "Tôi đang tìm một nơi yên tĩnh để suy nghĩ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980717
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980705,
					"content": "Thì ra là Kaeya, người bạn chân thành của tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980706
					]
				},
				{
					"id": 3980706,
					"content": "Ồ... Sự nhiệt tình của tôi đã được hồi đáp rồi, đây gọi là sự mê hoặc của chân thành phải không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
