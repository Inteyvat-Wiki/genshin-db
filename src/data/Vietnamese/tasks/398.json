					"nextDialogs": [
						3982104
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 3982104,
					"content": "Có điều, không biết người dân đến khi nào mới có thể tha thứ... Tha thứ ở mức độ nào nữa...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3982105
					],
					"speakerTitle": "Huffman"
				},
