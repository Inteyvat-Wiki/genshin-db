			"trigger": {
				"objectNames": [
					"Cosanzeana"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740490101,
					"content": "#Là {NICKNAME} và Paimon, người đã mang tặng hoa xứ lạ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490102
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490102,
					"content": "Xin chào Cosanzeana. Hoa chúng tôi đem tới sinh trưởng thế nào rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490103,
					"content": "Ừm... Cosanzeana cả ngày nay chưa tới xem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490104
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490104,
					"content": "Ủa, không phải bạn rất yêu thích hoa à, sao vẫn chưa đi xem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490105,
					"content": "Hoa xứ lạ, hiếm thấy như vậy, Cosanzeana tất nhiên rất muốn tới chăm sóc nó. Nhưng chỉ nghĩ tới cảnh nó tàn úa, Cosanzeana lại sợ không dám đi nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490106
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490106,
					"content": "Nghĩ nhiều tới mức này sao?... Chi bằng chúng ta cùng nhau đi xem! Nếu có gặp phải chuyện gì, chúng tôi sẽ giúp bạn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490107,
					"content": "Lo sợ cũng không phải là cách.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490108
					]
				},
				{
					"id": 740490108,
					"content": "#...Đúng đúng, chúng ta cùng đi thôi! Có Paimon và {NICKNAME} giúp đỡ, Cosanzeana tự tin hơn rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cosanzeana"
				}
			]
		},
		{
			"id": 7404902,
			"completionStepIds": [
				7404905
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
