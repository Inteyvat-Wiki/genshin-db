							4866.675
						],
						"pointId": 340300089
					}
				]
			},
			"dialogs": [
				{
					"id": 740490201,
					"content": "Huhu... Bông hoa yêu quý của tôi, hư hết rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490202
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490202,
					"content": "Thật là đáng tiếc... Thì ra hoa không sống được là do Nguyên Thể Khe Nứt phá hoại sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490203,
					"content": "Từ giờ Cosanzeana sẽ canh chừng ở đây, một bước cũng không rời!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490204
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490204,
					"content": "Bình tĩnh nào, Cosanzeana, chúng ta cùng nhau nghĩ cách! Nhưng tại sao Nguyên Thể Khe Nứt lại đến phá hoại vườn hoa nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490205,
						740490206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490205,
					"content": "Lúc trước Cosanzeana mang hoa khác về...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490207
					]
				},
				{
					"id": 740490207,
					"content": "Không có! Hừ, mấy kẻ xấu xa này, chỉ dám gây chuyện sau lưng! Tức quá đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490208
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490208,
					"content": "Wa... Không ngờ lại có lúc Cosanzeana tức giận như vậy. Có vẻ rất đau lòng cho những bông hoa này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490209,
					"content": "Nhưng mà, nghĩ lại thì khi Cosanzeana tới gần, Nguyên Thể Khe Nứt cũng không chủ động tránh né nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490210,
					"content": "Có lẽ, thứ thu hút Nguyên Thể Khe Nứt không phải là hoa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490211
					]
				},
				{
					"id": 740490211,
					"content": "Đúng vậy, có khả năng, chúng ta thử điều tra xung quanh vườn hoa xem sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490206,
					"content": "...Có bị Nguyên Thể Khe Nứt phá hoại không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490207
					]
				}
			]
		},
		{
			"id": 7404903,
			"completionStepIds": [
				7404908
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
