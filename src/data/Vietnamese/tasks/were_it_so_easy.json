				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cosanzeana"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2454.509,
							245.636,
							4866.675
						],
						"pointId": 340300089
					}
				]
			},
			"dialogs": [
				{
					"id": 740490301,
					"content": "#{NICKNAME} thật là lợi hại, \"đùng\" cái là đã biến cơ quan xấu xí này thành linh kiện đẹp đẽ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490302
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490302,
					"content": "Như vậy là vườn hoa sẽ không bị làm phiền nữa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490303
					]
				},
				{
					"id": 740490303,
					"content": "Tuy đã bị phá hoại một chút, nhưng số hoa còn lại có vẻ vẫn ổn. Nguyên Thể Khe Nứt sẽ không dám tới gây rối nữa, hoa của Cosanzeana có thể sinh sôi nảy nở rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490304,
					"content": "Thật tốt quá... Cosanzeana cũng đã học được một bài học, là phải luôn chú ý chăm sóc những bông hoa quý giá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490305
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490305,
					"content": "#{NICKNAME} và Paimon đã tặng hoa cho Cosanzeana, còn giúp Cosanzeana bảo vệ vườn hoa. Cosanzeana phải báo đáp thế nào đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490306
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490306,
					"content": "Đừng khách sáo như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490307,
					"content": "#À phải rồi, những bông hoa Cosanzeana hái, những bông hoa quý giá nhất! Tặng cho {NICKNAME} và Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490308
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490308,
					"content": "#Ồ! Những bông hoa quý giá như vậy, hay {NICKNAME} cũng mở một vườn hoa, đem chúng trồng xuống...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490309,
					"content": "Đây chẳng phải là Tidalga sao? Tidalga cũng được coi là hoa à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490310,
					"content": "Tidalga là thực vật, lại rất xinh đẹp, tất nhiên cũng là hoa rồi. Đây chính là từ môn \"sinh học\" của con người, để trở thành người trồng hoa giỏi, Cosanzeana đã học một chút, hihi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490311
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490311,
					"content": "Cứ thấy có gì đó sai sai, nhưng Paimon cũng không hiểu mấy thứ lý thuyết phân loại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490312,
					"content": "Từ nay Cosanzeana sẽ luôn cố gắng để trở thành một người trồng hoa giỏi. Nghe nói, người trồng hoa giỏi sẽ gây giống ra loài hoa mới, đem đi tham gia hội chợ làm vườn đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490313
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490313,
					"content": "Cosanzeana cũng phải gây giống chủng loại mới, để thắng \"giải thưởng\" tại hội chợ làm vườn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490314
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490314,
					"content": "Tinh thần của Cosanzeana tuy là rất tốt, có điều vẫn có không ít nhầm lẫn khó giải thích...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490315,
					"content": "Tham gia hội chợ làm vườn, là để đem chủng loại mới do mình gây giống đến cho con người đánh giá và thưởng thức sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490316,
					"content": "Thẩm mỹ và cảm quan của Cosanzeana rất khác biệt... Loài hoa mới mà cô ấy gây giống liệu có hơi kỳ lạ đối với con người không nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490317,
					"content": "Paimon thật biết quan tâm tới sự nghiệp làm vườn của Cosanzeana.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490318
					]
				},
				{
					"id": 740490318,
					"content": "Tất nhiên rồi! Paimon còn là giáo viên dạy làm vườn của Cosanzeana. Cosanzeana tham gia mà đoạt giải, Paimon cũng sẽ nở mày nở mặt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490319,
						740490323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490319,
					"content": "Đừng quá quan tâm giải thưởng, quan trọng nhất vẫn là niềm vui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490320
					]
				},
				{
					"id": 740490320,
					"content": "...Cũng đúng ha! Hoa do tự mình gây giống, Cosanzeana cảm thấy đẹp là đủ rồi! Những đánh giá của người ngoài cũng chẳng quan trọng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490321,
					"content": "Cosanzeana phải chăm sóc vườn hoa thật tốt, ngắm nhìn những bông hoa xinh đẹp, mỗi ngày đều sẽ vui vẻ hạnh phúc!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490322,
					"content": "Ừm! Cosanzeana sẽ khiến những bông hoa này sinh sôi nảy nở!",
					"roleType": "TALK_ROLE_NPC",
