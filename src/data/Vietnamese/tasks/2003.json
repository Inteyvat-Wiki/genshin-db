			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Thoma"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20030101,
					"content": "Cuối cùng cũng đến rồi, Thoma đâu? Thoma đâu rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030102,
					"content": "Haiz...chẳng lẽ tên Thoma đó không giữ lời sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030103,
					"content": "Ai nói không giữ lời, tôi còn đang đau lòng vì các bạn quên chuyện của tôi đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030104
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030104,
					"content": "Chuyện, chuyện gì thế này! Chó cũng nói chuyện sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030105,
					"content": "Ha ha ha...có gì ngạc nhiên đâu, các bạn lần đầu tiên thấy tôi như vậy à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030106,
						20030107
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030106,
					"content": "Thoma là...chó?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030108
					]
				},
				{
					"id": 20030108,
					"content": "Ơ...các bạn chưa thấy qua chuyện tương tự như thế ở Liyue sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030109
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030109,
					"content": "Vậy hả, hình như trong phút chốc tôi đã hiểu ra rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030110,
						20030111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030110,
					"content": "Sai ở đâu sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030112
					]
				},
				{
					"id": 20030112,
					"content": "Ha ha ha ha...được rồi được rồi, không đùa nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030113
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030113,
					"content": "Ê! Sao bạn lại như vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030114,
					"content": "Thật ra thì lúc ở Đảo Ritou, và cả ở phòng trà nữa, chờ các bạn hơi lâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030115
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030115,
					"content": "Vì vậy tôi đã nghĩ ra cách tiếp đón đặc biệt này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030116
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030116,
					"content": "Nhưng...xin hãy cho phép tôi được trịnh trọng gửi lời xin lỗi đến hai bạn, vì các \"khảo nghiệm\" trước kia là hình thức bắt buộc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030117
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030117,
					"content": "Nó quyết định việc tôi có thể đưa các bạn đến trước mặt tiểu thư Kamisato hay không, quyết định việc chúng ta có thể trở thành bạn đồng hành...dám đối mặt với sấm sét hay không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030118
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030118,
					"content": "Đừng tưởng nghiêm túc lại thì tôi sẽ tha thứ cho bạn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030119,
					"content": "Á...làm hơi lố rồi sao, xin lỗi mà xin lỗi mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030120,
						20030121
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030120,
					"content": "Vậy...kết quả khảo nghiệm đâu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030122
					]
				},
				{
					"id": 20030122,
					"content": "Ngay từ khi bắt đầu, bạn đã không để mình bị trói buộc vào những \"quy tắc\" đó đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030123
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030123,
					"content": "Vì ý chí của bạn chưa từng bị dao động, cũng như chưa từng bị khuất phục.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030124
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030124,
					"content": "Ngày xưa chúng tôi cũng đã quen một người như thế, chỉ có điều, sau khi sấm sét vụt qua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030125,
						20030126
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030125,
					"content": "Bạn đang nói đến người bạn đó của Kazuha...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030127
					]
				},
				{
					"id": 20030127,
					"content": "Ồ! Ngay cả các bạn cũng biết chuyện của anh ấy sao, xem ra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030128
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030128,
					"content": "...Hào quang của anh ấy cũng không yếu chút nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030129
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030129,
					"content": "Cho nên chúng tôi có thể đi gặp \"Shirasagi Himegimi\" được chưa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030130
					]
				},
				{
					"id": 20030130,
					"content": "Đương nhiên không thành vấn đề rồi, tôi sẽ đưa các bạn đến Phủ Kamisato của Hiệp Hội Yashiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030131
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030131,
					"content": "Nhưng trước đó, mong hai bạn đi cùng tôi đến xem nơi này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030132
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030132,
					"content": "Hả? Nơi nào thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030133,
					"content": "Chỉ cần sống trên Đảo Narukami thì không thể xem thường thứ to lớn đang được xây dựng ở đó - \"Tượng Trăm Mắt Nghìn Tay\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030126,
					"content": "Bạn đang nói đến người đã thiệt mạng trong \"Ngự Tiền Quyết Đấu\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030127
					]
				},
				{
					"id": 20030121,
					"content": "Người đồng hành đối mặt với sấm sét có nghĩa là...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030122
					]
				},
				{
					"id": 20030111,
					"content": "Nhưng rõ ràng đây là một con chó mà?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030112
					]
				},
				{
					"id": 20030107,
					"content": "Vậy thì Thoma con người ở đâu rồi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030108
					]
				}
			]
		},
		{
			"id": 200302,
			"completionStepIds": [
				200302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200302",
							"2"
						],
						"stepId": 200302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Thoma"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20030201,
					"content": "Bao trùm tượng thần này là một bầu không khí tiêu điều...người bình thường sẽ không đến nơi này đâu nhỉ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030202,
					"content": "Ơ, nhìn kỹ thì trên đó đều đang khảm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030203,
					"content": "Vision.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030204
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030204,
					"content": "Vision! Có nghĩa là những Vision lấy được từ lệnh Truy Lùng Vision đều được dát lên tượng thần này sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030206,
					"content": "Tại sao Shogun lại phát lệnh truy lùng Vision chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030207
					]
				},
				{
					"id": 20030205,
					"content": "Quả nhiên các bạn đã từng nghe nói đến lệnh Truy Lùng Vision.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030206
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030207,
					"content": "Trước khi giải thích chuyện này, chắc các bạn cũng biết, cũng giống như Mondstadt là thành phố \"tự do\", Liyue là thành đô \"khế ước\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030208
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030208,
					"content": "Thì Inazuma...lại là quốc gia của sự \"vĩnh hằng\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030209
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030209,
					"content": "Raiden Shogun vừa là người thống trị tối cao của Inazuma vừa là thần linh của Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030210
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030210,
					"content": "Sự vĩnh hằng bất biến qua hàng ngàn hàng vạn triều đại chính là ý chí của \"cô ta\", của một người nắm giữ quốc gia này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030211
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030211,
					"content": "Vì điều này, cô đã dựa vào Hiệp Hội Tam Cực để ổn định nền chính trị quốc gia, dùng lệnh bế quan tỏa cảng để cắt đứt lưu thông của con người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030212
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030212,
					"content": "Shogun muốn duy trì một loại trạng thái tĩnh cho Inazuma, mặc cho dòng sông thời gian vẫn chảy ở hai phía, duy chỉ có Inazuma là bất biến giữa dòng đời vạn biến, cứ như thế tiến đến \"sự vĩnh hằng\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030213
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030213,
					"content": "Mỗi một vị thần đều có cách nghĩ của riêng mình nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030214,
					"content": "Đây cũng chỉ là suy nghĩ của tôi. Còn về nguyên nhân của việc ban hành lệnh Truy Lùng Vision gần đây thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030215
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030215,
					"content": "Có lẽ do Shogun cho rằng Vision sẽ đem lại nguồn sức mạnh \"cải cách\" cho nhân dân, mà cái \"vĩnh hằng\" trong mắt Shogun thì không được phép có sự tồn tại của \"bất ổn\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030216
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030216,
					"content": "Vì thế Raiden Shogun đã cử thuộc hạ của Hiệp Hội Tenryou đi khắp nơi để thu thập rồi khảm từng viên từng viên Vision vào tượng thần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030217
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030217,
					"content": "Cho nên \"Tượng Trăm Mắt Nghìn Tay\" này được xem là biểu tượng cho \"sự vĩnh hằng\" của Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030218
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030218,
					"content": "Nói vậy thì Raiden Shogun đó cũng hơi ích kỷ nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030219,
					"content": "Ha ha, cũng chỉ có những người từ nơi khác đến như các bạn mới dám thẳng thắn phê bình cách làm của Raiden Shogun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030220
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030220,
					"content": "Nhưng...tôi cũng đồng ý với ý kiến này. Lệnh truy lùng Vision là thứ không nên tồn tại, ngay từ ngày đầu tiên ban bố lệnh truy lùng này, tiểu thư Kamisato đã quyết định sẽ chống đối đến cùng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030221
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030235,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030223,
					"content": "Vừa nãy là...tiếng gì thế?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030224
					]
				},
				{
					"id": 20030221,
					"content": "#Ơ? {NICKNAME} sao thế? Trông bạn hơi lạ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030222,
					"content": "Hả? Tiếng gì? Tôi không nghe thấy, vừa xảy ra chuyện gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030223
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030225,
					"content": "Hình như tôi nghe được...\"nguyện vọng\" của người khác.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030226
					]
				},
				{
					"id": 20030224,
					"content": "Đúng thế, bạn chạm vào tượng thần, sau đó thì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030226,
					"content": "Nguyện vọng?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030227
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030227,
					"content": "Ừm...vậy điều này đã chứng minh được một cách nói...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030228
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030228,
					"content": "Các bạn có từng nghe điều này chưa? Khi nguyện vọng của một người quá mãnh liệt thì sẽ đến được tai của thần linh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030229
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030229,
					"content": "Đó chính là nguồn gốc của Vision...tức là, Vision đại diện cho nguyện vọng của người đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030230
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030230,
					"content": "Nếu những lời bạn nói khi nãy là thật...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030231
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030232,
					"content": "Vision không phải tượng trưng cho sức mạnh, mà là \"nguyện vọng\" sao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030233
					]
				},
				{
					"id": 20030231,
					"content": "Vậy xem ra...những người dân này còn cố chấp hơn tôi tưởng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030232
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030233,
					"content": "Được rồi, các du khách Đảo Narukami, đã đến lúc đến trạm kế tiếp - Phủ Kamisato rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030234
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030234,
					"content": "Cuối cùng cũng phải đi rồi sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
