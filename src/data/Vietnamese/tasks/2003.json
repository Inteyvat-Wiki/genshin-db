					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030402,
					"content": "Dẫu sao cũng đã nhìn thấy Quần Ngọc Các rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030404
					]
				},
				{
					"id": 20030404,
					"content": "Chào mừng đến với Phủ Kamisato, tiểu thư chờ hai vị đã lâu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030405
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030405,
					"content": "Là Shirasagi Himegimi mà bạn vẫn luôn nhắc đến phải không, cô ấy ở đâu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030406,
					"content": "Hừm...hừm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030407
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030407,
					"content": "Phía sau bình phong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030408,
					"content": "Ha ha, là đại tiểu thư của Hiệp Hội Yashiro, tiểu thư Kamisato thường tiếp khách như thế đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030409
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030409,
					"content": "Cũng có thể nói đây là tập tục cả trăm năm nay của Hiệp Hội Yashiro, mong hãy thông cảm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030410,
						20030411
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030410,
					"content": "Tôi hiểu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030412
					]
				},
				{
					"id": 20030412,
					"content": "Dù sao cũng là Shirasagi Himegimi cao quý mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030413,
					"content": "Hai vị vượt đại dương xa xôi, đường xa mệt mỏi, đến phủ lại chỉ có thể gặp nhau như thế này, xin thứ lỗi cho lễ nghĩa không chu toàn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030414
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030414,
					"content": "Tôi luôn chờ hai vị đến, qua lời kể của Thoma, tôi cũng tin rằng hai vị có sức mạnh \"thay đổi thời cuộc\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030415
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030415,
					"content": "Inazuma bây giờ, dưới việc ban hành lệnh truy lùng Vision, nguyện vọng của người dân đang bị chà đạp không thương tiếc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030416
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030416,
					"content": "Tuy Hiệp Hội Yashiro phục vụ cho Shogun, nhưng vì chức trách của họ nên đó cũng là nơi gần gũi nhất với dân chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030417
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030417,
					"content": "Quyền lực của hiệp hội vốn xuất phát từ sự tin tưởng của nhân dân, nếu bỏ mặc làm ngơ trước tình hình này, thì sao có thể yên giấc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030418
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030418,
					"content": "Nhà Lữ Hành, xin bạn hãy cho tôi mượn sức mạnh, chúng ta nhất định có thể...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030419,
						20030420
