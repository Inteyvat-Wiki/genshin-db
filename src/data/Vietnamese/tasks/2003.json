					"id": 20030422,
					"content": "Tôi đã nói rồi, tiểu thư...như thế không được đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030423
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030423,
					"content": "Tôi chuẩn bị đi đây.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030424
					]
				},
