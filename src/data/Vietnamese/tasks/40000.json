			"dialogs": [
				{
					"id": 400000201,
					"content": "Xin chào! Bạn cũng muốn chơi thử \"Cờ Cơ Quan\" sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000202
					],
					"speakerTitle": "Ruijin"
				},
				{
					"id": 400000202,
					"content": "\"Cờ Cơ Quan\"... là gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400000203
					]
				},
				{
					"id": 400000203,
					"content": "Ồ, xem ra bạn không biết... \"Cờ Cơ Quan\" là một \"trò chơi\" có thể chơi ở trên bàn do tôi phát minh ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000204
					],
					"speakerTitle": "Ruijin"
				},
				{
					"id": 400000204,
					"content": "Bạn có thấy những món đồ bày trên bàn không? Đây đều là những đạo cụ được sử dụng trong \"Cờ Cơ Quan\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000205
					],
					"speakerTitle": "Ruijin"
				},
				{
					"id": 400000205,
					"content": "Có vẻ rất phức tạp...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400000206
					]
				},
				{
					"id": 400000206,
					"content": "Nhìn phức tạp vậy thôi nhưng thật ra rất dễ chơi, chỉ cần chơi vài ván là sẽ nắm được quy tắc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000207
					],
					"speakerTitle": "Ruijin"
				},
				{
					"id": 400000207,
					"content": "Thế nào, bạn có muốn thử không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000208,
						400000209
					],
					"speakerTitle": "Ruijin"
				},
				{
					"id": 400000208,
					"content": "Bao nhiêu tiền... một ván?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400000210
					]
				},
				{
					"id": 400000210,
					"content": "Không không, chẳng phải đang là Tết Hải Đăng sao, đúng lúc tôi cũng muốn xem ý kiến của mọi người về \"Cờ Cơ Quan\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000211
					],
					"speakerTitle": "Ruijin"
				},
				{
					"id": 400000211,
					"content": "Cho nên chỉ cần một chiếc Đèn Tiêu là có thể chơi một ván.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000212
					],
					"speakerTitle": "Ruijin"
				},
				{
					"id": 400000212,
					"content": "Nếu bạn muốn chơi, hãy đem Đèn Tiêu đến tìm tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000213
					],
					"speakerTitle": "Ruijin"
				},
				{
					"id": 400000213,
					"content": "Thế nào, thử xem, ván đầu tiên tôi sẽ không thu Đèn Tiêu của bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ruijin"
				},
				{
					"id": 400000209,
					"content": "Chơi một ván mắc lắm nhỉ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400000210
					]
				}
