				"points": []
			},
			"dialogs": [
				{
					"id": 400700401,
					"content": "Một vài ngọn núi trên đảo đã mất đi cây cối và mạch nước, cho hỏi có cách nào khai thông chúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700402
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400700402,
					"content": "Tôi biết một người có thể giúp việc này. Ở tầng trên là người bạn đồng hành của tôi, Con Tim Băng Giá, hãy đến đó hỏi thử xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Con Tim Rực Lửa"
				}
			]
		},
		{
			"id": 4007005,
			"completionStepIds": [
				4007005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007005",
							"2"
						],
						"stepId": 4007005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Con Tim Băng Giá",
					"Xinyan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400700501,
					"content": "Các người là ai? Sao lại đến đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700502
					],
					"speakerTitle": "Con Tim Băng Giá"
				},
				{
					"id": 400700502,
					"content": "Xin chào, chúng tôi muốn mượn sức mạnh của cô để khai thông những ngọn núi trên đảo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700503
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400700503,
					"content": "Núi? Ồ, tôi hiểu rồi... Các người cũng muốn trở thành nghệ sĩ âm nhạc vĩ đại đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700504
					],
					"speakerTitle": "Con Tim Băng Giá"
				},
				{
					"id": 400700504,
					"content": "Hả, vậy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400700505,
					"content": "Đúng vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700506
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400700506,
					"content": "Đã như vậy thì chúng ta là những người cùng chí hướng. Dù yếu đuối đến mấy, tôi cũng sẽ góp một phần sức lực cho các bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700507
					],
					"speakerTitle": "Con Tim Băng Giá"
				},
				{
					"id": 400700507,
					"content": "Hãy đem cánh hoa của tôi gieo vào điểm cuối nơi giao thoa của âm nhạc, và những gì đã từng chìm vào lòng đất sẽ tái hiện theo âm nhạc. Chỉ cần có âm nhạc, cuộc sống sẽ tiếp tục thăng hoa trên thế giới này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700508
					],
					"speakerTitle": "Con Tim Băng Giá"
				},
				{
					"id": 400700508,
					"content": "...Cảm ơn cô.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinyan"
				}
			]
		},
		{
			"id": 4007010,
			"completionStepIds": [
				4007010
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007010",
							"2"
						],
						"stepId": 4007010,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xinyan",
					"Mona",
					"Kaedehara Kazuha"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400701001,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701002
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701002,
					"content": "Cuối cùng cũng đã đến lúc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701003
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701003,
					"content": "Các bạn, tôi từng ước một điều rằng, sẽ cùng với người không ngờ tới tổ chức một buổi biểu diễn. Hôm nay tôi đã tìm được câu trả lời đó trên hòn đảo này rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701004
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701004,
					"content": "Người đã biến hòn đảo này thành một dàn nhạc cụ khổng lồ nhiều năm trước, không ai biết tên hay diện mạo của người đó, nhưng người đó chắc chắn là một trong những nghệ sĩ âm nhạc vĩ đại nhất của Teyvat này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701005
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701005,
					"content": "Tôi chưa từng nghĩ mình có thể nhìn thấy một nhạc cụ như vậy. Không ngờ rằng chúng ta sẽ có thể biểu diễn khi thủy triều lên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701006
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701006,
					"content": "Xinyan sẽ chơi nhạc rock sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400701007
					]
				},
				{
					"id": 400701007,
					"content": "Không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701008
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701008,
					"content": "Âm nhạc là món quà dành cho tri kỷ, vì vậy... tôi sẽ chọn cách phù hợp nhất để hợp tấu với vị cư dân này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701009
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701009,
					"content": "Hôm nay tôi sẽ không chơi nhạc rock, tôi sẽ cho mọi người thưởng thức tiết mục mới!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701010
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701010,
					"content": "...Phù.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701011
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701011,
					"content": "Thế nào? Tôi chơi ổn chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701012
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701012,
					"content": "Vô cùng tuyệt vời.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701013
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701013,
					"content": "Tôi chưa từng nghe qua loại hợp tấu như vậy bao giờ, thú vị lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701014
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400701014,
					"content": "Lại còn tao nhã nữa! Tôi không biết phải nói thế nào... nói chung là nó rất đặc biệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701015,
						400701016
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400701015,
					"content": "Màn trình diễn rất có phong cách.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400701017
					]
				},
				{
					"id": 400701017,
					"content": "Hì hì, cảm ơn mọi người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701018
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701018,
					"content": "Vậy là, nguyện vọng của tôi xem như đã hoàn thành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701019
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701019,
					"content": "Cô còn muốn làm gì nữa không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701020
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701020,
					"content": "Hết rồi. Đêm nay tôi có thể ngủ ngon rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701021
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701021,
					"content": "Tiếp theo mọi người đều rảnh đúng không? Tôi có một đề nghị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701022
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400701022,
					"content": "Tôi muốn tới doanh trại Fatui một chuyến để xác nhận lại tình hình bên đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701023
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400701023,
					"content": "Hửm? Hóa ra các bạn cũng phát hiện ra doanh trại Fatui rồi à.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701024
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701024,
					"content": "Đợi đã, Mona cũng biết sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701025
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400701025,
					"content": "Tôi là nhà chiêm tinh thiên tài mà, hơn nữa không phải tôi đã nói sao? Bàn bói nước đã khôi phục lại một chút. Tôi có thể thông qua xem bói để cảm nhận được tình hình nơi này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701026
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701026,
					"content": "Hả, ở đây có cả Fatui sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701027
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701027,
					"content": "Đúng. Hôm nay lúc Fischl tách nhóm, tôi cũng đã cho cô ấy biết chuyện này. Nếu gặp phải Fatui thì cô ấy sẽ trốn ngay, chắc sẽ không gặp nguy hiểm gì đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701028
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701028,
					"content": "Hóa ra là thế, vậy tôi cũng nói thật vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701029
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400701029,
					"content": "Kể rõ chuyện gặp phải doanh trại Fatui và thiết bị kỳ lạ vào ngày đầu tiên lên đảo...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400701030
					]
				},
				{
					"id": 400701030,
					"content": "Thiết bị kỳ lạ, Fatui đầu óc không bình thường... ý của mọi người là những thứ này có liên quan tới ảo cảnh gần đây sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701031
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701031,
					"content": "Không chắc lắm. Nhưng tôi cảm thấy hẳn là có mối liên hệ nào đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701032
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400701032,
					"content": "Cũng có lý, vậy mau tới doanh trại kia xem thử thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701016,
					"content": "Màn trình diễn rất thú vị.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400701017
					]
				}
			]
		},
		{
			"id": 4007016,
			"completionStepIds": [
				4007016
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
