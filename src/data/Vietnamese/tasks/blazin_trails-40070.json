			"dialogs": [
				{
					"id": 400701701,
					"content": "Đến rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701702
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400701702,
					"content": "Ơ? Fischl?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701703
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701703,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701704
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400701704,
					"content": "Là Fischl thật kìa! Fischl!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400701705,
					"content": "...Hừ, tới rồi sao, đám gia thần ngu ngốc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701706
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400701706,
					"content": "Hả, à ừm, đã lâu không gặp!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701707
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400701707,
					"content": "Không lâu như vậy đâu nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701708
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701708,
					"content": "À... tiểu thư và tôi phát hiện ra luồng khí kỳ lạ nên đã chạy tới đây trước. Không ngờ, các vị... các vị lại tới nhanh hơn tưởng tượng nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701709
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400701709,
					"content": "Oz hình như có chút căng thẳng đúng không? Hay là do mình tưởng tượng nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400701710,
					"content": "Vương Đô U Ám sắp tới, bổn công chúa còn phải chuẩn bị nghi thức chúc phúc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701711
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400701711,
					"content": "Tiểu thư lại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701712
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400701712,
					"content": "Một mình ta hành động cũng được, Oz, nếu ngươi sợ đi vào trong bóng tối thì cứ trở lại nơi có ánh sáng đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701713
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400701713,
					"content": "Tiểu thư, cái này không giống như lời mà tiểu thư nên nói với tôi chút nào. Tôi là người hầu, là ánh nhìn của tiểu thư, tôi không thể bỏ cô lại được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701714
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400701714,
					"content": "...Bớt nhìn ta bằng ánh mắt dò xét đó đi! Tóm, tóm lại, bây giờ vẫn chưa tới lúc giải thích.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701715
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400701715,
					"content": "Ối ối, tiểu thư!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701716
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400701716,
					"content": "Các vị, thật xin lỗi, tâm trạng của tiểu thư đang không tốt, xin đừng để ý. Cho tôi xin lỗi trước vì không thể tiếp đón chu đáo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701717
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400701717,
					"content": "...Chậc, tách nhóm lâu vậy mà tâm trạng vẫn không tốt lên à.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701718
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701718,
					"content": "Thấy Fischl ở đây thì tôi cảm thấy là ảo cảnh sắp tới sẽ có liên quan tới cô ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701719
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701719,
					"content": "Ừm. Lúc tới gần ảo cảnh có liên quan tới mình, tôi cũng có thể cảm nhận được bầu không khí quen thuộc nào đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701720
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400701720,
					"content": "Tôi cũng vậy. Mặc dù không thể giải thích rõ, nhưng vẫn cảm thấy như có thứ gì đó rất thú vị sắp xuất hiện vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701721
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701721,
					"content": "Ừm. Có thể Fischl và Oz đã có cảm nhận đó rồi... Có lẽ Fischl không muốn đối mặt với ảo cảnh của mình nên mới nóng nảy như thế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701722
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701722,
					"content": "Sao lại như vậy chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701723
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400701723,
					"content": "Có lẽ trong ảo cảnh đó có ẩn chứa bí mật nào đó mà cô ấy không muốn để ai biết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701724
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701724,
					"content": "Mọi người, chúng ta tạm nghỉ ở đây đi. Đợi ảo cảnh xuất hiện thì đáp án cũng sẽ được vạch trần thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
		{
			"id": 4007018,
