					"Xinyan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400701601,
					"content": "Lạ thật, suốt chặng đường chỉ có ma vật trên đảo, không hề có Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400701602,
					"content": "Dấu vết đóng quân và thiết bị vẫn còn đây, nhưng lại không thấy ai, kỳ lạ thật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701603
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701603,
					"content": "(Mình vẫn cho rằng, rất có thể những ảo cảnh này có liên quan tới thiết bị kia. Thoạt nhìn thì nó đã bị hỏng, nhưng có lẽ đây mới là nguyên nhân của vấn đề.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400701604
					]
				},
				{
					"id": 400701604,
					"content": "(...Nếu thiết bị đó khiến người ta sản sinh ảo giác, vậy tại sao ảo giác lại biến mất? Hay vẫn còn điều gì đó mà chúng ta chưa biết?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400701605
					]
				},
				{
					"id": 400701605,
					"content": "(Không tìm thấy ai, là vì họ đã biến mất, hay là họ đang trốn tránh chúng ta?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400701606
					]
				},
				{
					"id": 400701606,
					"content": "Được rồi, để bói thử xem nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701607
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701607,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701608
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701608,
					"content": "Hả? Đây là... sức mạnh đang di chuyển?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701609
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701609,
					"content": "Các vị, tôi không thể tìm ra tung tích của Fatui, bàn bói nước lại bị mờ rồi, nhưng lần này tôi có thể cảm nhận được là có luồng năng lượng nào đó đang hội tụ lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701610
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701610,
					"content": "Địa điểm là... ở hòn đảo bên kia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701611
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701611,
					"content": "Lần này sẽ là ảo cảnh liên quan tới ai đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701612
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701612,
					"content": "Hừm... qua đó xem thử đi, nói không chừng sẽ có manh mối đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
		{
			"id": 4007017,
			"completionStepIds": [
				4007017
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
