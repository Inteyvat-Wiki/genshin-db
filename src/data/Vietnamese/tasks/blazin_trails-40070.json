			},
			"dialogs": [
				{
					"id": 400701801,
					"content": "Chuyện làm được cũng đã làm hết rồi, chỉ còn lại hai ngọn núi kia là chưa thể giải quyết thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400701802,
					"content": "Chúng ta cứ suy nghĩ tiếp đi, rồi sẽ có cách mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701803
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701803,
					"content": "Ban nãy tôi đã nhìn kỹ rồi, mấy ngọn núi trên đảo hơn phân nửa đều có mạch nước và thực vật, chúng cùng nhau tạo thành một hệ thống kết nối các ngọn núi với nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701804
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701804,
					"content": "Nhưng hiện tại núi đã bị sập, nên thực vật và mạch nước không thể kết nối được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701805
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701805,
					"content": "Nếu như tất cả được kết nối thì nó sẽ tạo thành \"Nhạc Cụ Khổng Lồ\" mà Albedo đã nói trong thư.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701806
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400701806,
					"content": "Ừm, tôi nhất định phải làm được chuyện này... để tôi đi hỏi bông hoa đó xem nó có cách gì không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinyan"
				}
			]
		},
