			"dialogs": [
				{
					"id": 741500301,
					"content": "Các cháu xong việc rồi à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500302
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500302,
					"content": "Vâng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741500303
					]
				},
				{
					"id": 741500303,
					"content": "Chúng cháu đã dọn dẹp sạch sẽ rồi, Molli cũng đã cho mèo ăn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741500304,
					"content": "Ông Benoit, có một đống rương cũ rất bẩn cạnh nhà, có cần dọn luôn không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741500305,
					"content": "Rương? À, không cần đâu, đó là rương mà ta dùng để đựng đồ cũ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500306
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500306,
					"content": "Có một ít đồ gia dụng và vật trang trí có từ trước khi ta dọn đến đây. Bỏ đi thì tiếc, để trong nhà thì lại không hợp với phong cách nội thất, thế nên để ở đó vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500307
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500307,
					"content": "Ta hiếm khi đụng đến chúng, nơi này cũng toàn là người văn minh nên không ai trộm... Cứ để ở đó đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500308
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500308,
					"content": "Ông Leroy, cháu đã giúp đỡ ông rồi đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500309
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500309,
					"content": "Tất nhiên rồi, Molli. Lúc về nhà thì thay ông hỏi thăm ba mẹ cháu nhé, như vậy thì ông sẽ càng biết ơn cháu hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500310
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500310,
					"content": "Bánh ngọt và tiền tiêu vặt đều ở đây, qua đây chia phần nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500311
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500311,
					"content": "Không cần đâu, cháu chỉ muốn sờ Nana thêm chút nữa thôi, được không ạ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500312
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500312,
					"content": "Được chứ. Cẩn thận móng vuốt của nó nhé, khi chán rồi thì qua đây ăn bánh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500313
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500313,
					"content": "Cha, sao lại ra khỏi nhà thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500314
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500314,
					"content": "Mấy đứa con không ở nhà với cha, cha thấy chán lắm, nên ra khỏi nhà hít thở không khí thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500315
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500315,
					"content": "Morticia, xem kìa... Chúng ta mới đi mấy ngày thôi mà cha đã không vui rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500316
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500316,
					"content": "Nhưng nếu như cha biết chúng ta mang món quà gì về tặng, thì cha chắc chắn sẽ tha thứ cho chúng ta nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500317
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500317,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500318
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741500318,
					"content": "Quà? Hai đứa mang gì về vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500319
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500319,
					"content": "Chắc chắn là món đồ tuyệt vời rồi. Cha nhìn này, Morticia biết cha thích những thứ vừa đắt vừa đẹp, nên cô ấy tự mình chọn cho cha đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500320
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500320,
					"content": "Cảm ơn nhé, con gái.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500321
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500321,
					"content": "Chuyện con nên làm thôi mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500322
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741500322,
					"content": "À phải rồi, có hai vị khách này đến nhà cha chơi lúc hai con không ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500323
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500323,
					"content": "Xin chào. Cha tôi là một người hiền lành, rất thích trẻ con, thật mừng khi các vị đến chơi cùng ông ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500324
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500324,
					"content": "Nhưng giờ tôi và vợ đã về rồi, để chúng tôi thay các vị bầu bạn với ông ấy thì hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500325
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500325,
					"content": "Hai con về là được rồi, cho cha xem quà đi nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500326
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500326,
					"content": "Cha, chúng ta vào nhà đã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500327
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741500327,
					"content": "Được rồi Athos, con nhớ mang đồ ngọt và tiền công cho hai người trẻ tuổi này nhé. Họ đã giúp cha quét nhà, lại còn cho Nana ăn đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500328
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500328,
					"content": "À, cả cô bé bên cạnh nữa, cho cô bé một ít đồ ngọt nhé. Cha vào nhà trước đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500329
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500329,
					"content": "Ông Leroy, Nana cho cháu sờ bụng này... Ủa? Ông ấy đâu rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500330
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500330,
					"content": "Em tìm cha anh sao? Anh là con rể ông ấy, em cứ hiểu là con của ông ấy đi. Anh tên là Athos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500331
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500331,
					"content": "Em biết con rể nghĩa là gì, anh là chồng của con gái ông ấy đúng không!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500332
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500332,
					"content": "Haha, em biết nhiều thật đấy. Cha của anh đã vào nhà rồi, cảm ơn em đã chơi với ông ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500333
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500333,
					"content": "Đây là đồ ngọt của em, sau này có anh và vợ anh ở cùng ông ấy rồi, em không cần đến cũng được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500334
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500334,
					"content": "Về nhà sớm đi, ở bên ngoài lâu là người nhà của em lo đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500335
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500335,
					"content": "Em không cảm thấy phiền gì đâu, với cả em cũng đã hứa với ông Leroy rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500336
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500336,
					"content": "Em nghĩ chắc ông ấy vẫn cần em giúp đỡ, cho mèo ăn hay tưới cây gì đó. Giúp được ông ấy em vui lắm, em sẽ đến đây nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500337
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500337,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500338
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500338,
					"content": "Chậc, thế thì phiền lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500339
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500339,
					"content": "Hửm, anh sao thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500340
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500340,
					"content": "Không có gì. Anh có chuyện này muốn bàn với em. À, không phải là bàn, mà là có chuyện cần nhờ em.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500341
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500341,
					"content": "Vâng, anh có chuyện gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500342
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500342,
					"content": "Anh cho em đồ ngọt và tiền tiêu vặt, sau này em đừng đến đây nữa nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500343
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500343,
					"content": "Sao vậy? Có phải em đã làm sai gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500344
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500344,
					"content": "Không, em không làm gì sai cả. Chẳng qua cha của anh không được khỏe, dạo này lại mất ngủ trầm trọng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500345
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500345,
					"content": "Anh và vợ lo cho sức khỏe ông ấy, thế nên muốn ông ấy có thể yên tĩnh nghỉ ngơi. Cháu hiểu mà, phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500346
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500346,
					"content": "Ông Leroy không khỏe sao... Em hiểu rồi, sau này em sẽ mang thêm nhiều Trái Bulle đến cho ông ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500347
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500347,
					"content": "Khi em ăn nhiều đồ ngọt bị đau bụng, cha em sẽ bảo em ăn ít đồ ngọt lại, ăn nhiều hoa quả lên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500348
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500348,
					"content": "Ông Leroy ăn nhiều hoa quả là sẽ khỏe hơn cho mà xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500349
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500349,
					"content": "...Haiz, kệ vậy, cứ thế đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500350
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500350,
					"content": "Còn hai vị nữa, để tôi trả cho hai vị đồ ngọt và tiền công.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500351
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500351,
					"content": "Tiếp theo tôi có chuyện cần nói rõ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500352
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500352,
					"content": "Tôi thay mặt cho nhà Leroy để nói về vấn đề này: Tôi hy vọng sau này các vị không đến làm phiền cuộc sống của chúng tôi nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500353
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500353,
					"content": "Hai vị tuy trẻ tuổi, nhưng tôi tin là hai vị có thể hiểu được. Cho nên đừng đến đây nữa nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500354
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500354,
					"content": "Vậy nhé, tôi đi trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500355
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500355,
					"content": "Tại sao lại không thể đến nữa nhỉ? Tò mò quá, ông Leroy rất tốt bụng mà, vậy thì tại sao anh ấy lại không cho chúng ta đến nữa chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500356
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500356,
					"content": "Đúng vậy. Lời nói của người này tuy lịch sự, nhưng có hơi lạnh lùng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500357
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741500357,
					"content": "#Kệ vậy, ngày mai em vẫn muốn đến thăm ông Leroy, {F#hai chị}{M#anh chị} thì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500358
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500358,
					"content": "Cũng đến nữa nhé! Nana đáng yêu lắm, em muốn sờ nó tiếp, với cả ông Leroy còn cho em đồ ngọt nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500359,
						741500361
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500359,
					"content": "#{F#Hai chị}{M#Anh chị} sẽ đến.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741500360
					]
				},
				{
					"id": 741500360,
					"content": "Hứa vậy nhé, cùng nhau đến thăm Nana và chơi với ông Leroy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500361,
					"content": "Để khi nào rảnh đã.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741500362
					]
				},
				{
					"id": 741500362,
					"content": "Được, vậy lần sau gặp lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Molli"
				}
			]
		},
