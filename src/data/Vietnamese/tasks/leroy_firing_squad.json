			"dialogs": [
				{
					"id": 741490601,
					"content": "Giao báo đó hả? Để ở cửa đi, ta ra lấy sau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490602
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490602,
					"content": "(Hôm nay đã giúp ông Benoit làm việc nhà rồi, quấy rầy người khác nghỉ ngơi nhiều lần thì thật bất lịch sự. Đã hẹn với ông ấy ngày mai gặp thì đợi đến khi đó mới quay lại vậy.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gõ một cái"
				}
			]
