			},
			"dialogs": [
				{
					"id": 741500101,
					"content": "Cảm ơn cháu, Molli. Đôi mắt tím xinh đẹp của cháu bắt nguồn từ chính tấm lòng lương thiện của cháu đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500102
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500102,
					"content": "Hihi, vậy sao ạ? Ông Leroy có thích con búp bê mà cháu tặng lần trước không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500103
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500103,
					"content": "Ông rất thích, rất đáng yêu. Ông còn dọn chỗ để bày nó trên bàn ăn cơm đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500104
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500104,
					"content": "Vậy chắc là nó vui lắm! Hôm nay thì sao? Có cần cháu đỡ ông đi dạo không, hoặc đi lấy báo hộ cũng được?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500105
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500105,
					"content": "Cháu có thể đọc báo giúp ông nếu ông nhìn không rõ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500106
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500106,
					"content": "Mẹ cháu nói với cháu là nên làm việc tốt mỗi ngày, cô gia sư còn bắt cháu nộp bài văn viết về người tốt việc tốt trong tuần này nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500107
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500107,
					"content": "À, ý cháu không phải là cháu giúp ông để viết văn, nhưng nếu được thì cháu cũng mong là mình có thể giúp gì đó cho ông.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500108
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500108,
					"content": "Haha, không cần đâu. Cháu cứ xin phép ba mẹ cháu là cháu thường xuyên qua chỗ ông chơi đã là giúp ông nhiều lắm rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500109
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500109,
					"content": "Dạ, ông Leroy, cháu có nói với ba mẹ rồi, nhưng hình như họ không vui cho lắm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500110
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500110,
					"content": "Vậy cháu vẫn sẽ đến chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500111
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500111,
					"content": "Vâng ạ. Cho dù ba mẹ không cho cháu đến thì cháu vẫn sẽ đến. Chúng ta đã hứa rồi mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500112
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500112,
					"content": "Haha. Molli, cháu đúng là đứa trẻ biết giữ lời hứa, ông Leroy rất thích cháu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500113
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500113,
					"content": "Hai vị khách nhiệt tình, chào mừng các cháu đến chơi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500114
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500114,
					"content": "...Khụ, bọn cháu không định làm phiền cả hai nói chuyện đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741500115,
					"content": "Có làm phiền không ạ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741500116
					]
				},
				{
					"id": 741500116,
					"content": "Không sao, không sao, các cháu không làm phiền gì cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500117
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500117,
					"content": "Molli bé nhỏ này đang vất vả ngược xuôi để làm bài tập về nhà, đúng lúc ghé đến chỗ ta thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500118
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500118,
					"content": "Cô bé muốn giúp ta chuyện gì đó, như vậy là sẽ có thể viết văn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500119
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500119,
					"content": "Không phải cháu làm chuyện tốt là vì bài tập về nhà đâu, ít nhất là thế...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500120
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500120,
					"content": "Ông tin cháu là đứa bé ngoan, tất nhiên không phải làm việc tốt chỉ vì bài tập về nhà rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500121
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500121,
					"content": "Giống như hai vị khách trẻ tuổi này chẳng hạn, họ chắc không phải vì công việc nên mới đến đây đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500122
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500122,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741500123
					]
				},
				{
					"id": 741500123,
					"content": "Chuyện đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741500124,
					"content": "Đừng để ý, đùa chút thôi. Các cháu sẽ không giận lão già này đâu nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500125
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500125,
					"content": "Người trẻ tuổi luôn có nhiều thời gian, nếu các cháu đã tình nguyện đến đây, còn ta lại thích có người trẻ tuổi bên cạnh, vậy thì sao mà ta không đồng ý được chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500126
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500126,
					"content": "Ta có việc cho các cháu đây. Chỗ này đông người qua lại, trước cửa rất nhanh bám bụi, sau nhà cũng không quét mấy ngày rồi. Phiền các cháu giúp ta dọn dẹp nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500127
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500127,
					"content": "À ừm... Được thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741500128,
					"content": "Molli, cháu có muốn chơi với mèo của ông một lúc không? Nhân tiện thưởng cho nó một miếng cá nhé, nó tên là Nana đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500129
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500129,
					"content": "Nó được kế thừa tên của một chú chó mà ông từng nuôi... Tiếc là con gái ông đã bế theo lúc đi lấy chồng xa rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500130
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500130,
					"content": "Vâng, thưa ông Leroy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500131
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500131,
					"content": "Các cháu đi làm việc đi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Benoit Leroy"
				}
			]
		},
