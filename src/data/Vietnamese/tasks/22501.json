				"points": []
			},
			"dialogs": [
				{
					"id": 225010101,
					"content": "Ừm... Câu này không ổn. Ôi, không nói được thì phải đi xem xem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225010102
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225010102,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225010103
					]
				},
				{
					"id": 225010103,
					"content": "Xin chào, tôi Qingzhou, là nhà thơ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225010104
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225010104,
					"content": "Gần đây tại hạ gặp một câu thơ hay, mà không biết phải viết tiếp như thế nào, suy nghĩ đến tận bây giờ mà vẫn chưa ra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225010105
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225010105,
					"content": "Gần đây trời có hiện tượng lạ, nhiều thiên thạch rơi xuống đất, cảnh tượng này thật hiếm có trên đời.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225010106
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225010106,
					"content": "Tôi nghĩ, nếu đến gần thiên thạch để xem và tìm cảm hứng thì câu thơ này không chừng sẽ hình thành...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225010107
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225010107,
					"content": "Không, không thích hợp lắm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225010108
					]
				},
				{
					"id": 225010108,
					"content": "Không thích hợp lắm? Bạn bắt đầu nói từ đâu thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
				}
			]
		},
