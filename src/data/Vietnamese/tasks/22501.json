			"dialogs": [
				{
					"id": 225010201,
					"content": "\"Không thích hợp lắm\" mà bạn nói là ý gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225010202
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225010202,
					"content": "Chạm vào thiên thạch sẽ chìm vào giấc ngủ say...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225010203
					]
				},
				{
					"id": 225010203,
					"content": "Ồ, tôi cũng có nghe nói về chuyện này, nhưng nếu chỉ đứng gần nhìn thì chắc không có chuyện gì đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225010204
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225010204,
					"content": "Bạn có thể bảo đảm là không chạm vào thiên thạch không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225010205
					]
				},
				{
					"id": 225010205,
					"content": "Chuyện này... chuyện này tôi tự biết phải làm thế nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
