			"dialogs": [
				{
					"id": 747090101,
					"content": "#Hai người vất vả rồi, {NICKNAME} và Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747090102
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747090102,
					"content": "Tôi đã đại khái nắm được bệnh tình của những con cá này, cũng đã điều chế vài phương thuốc bí truyền của Melusine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747090103
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747090103,
					"content": "Pha loại thảo dược đặc biệt này vào bể nước sẽ có thể giúp chúng bình tĩnh lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747090104
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747090104,
					"content": "Tức là biến cả bể nước thành nơi điều trị luôn sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747090105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747090105,
					"content": "Nghĩ kỹ lại thì... đây đúng là chuyện chỉ có Sigewinne mới làm được thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747090106,
						747090107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747090106,
					"content": "Nhưng mà, cách này chỉ tạm thời xoa dịu bệnh tình thôi phải không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747090108
					]
				},
				{
					"id": 747090108,
					"content": "Đúng vậy, tôi cần đưa những loài cá có đặc điểm khác nhau đến đây để \"khám sức khỏe\" thì mới có thể tìm ra nguyên nhân chính xác được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747090109
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747090109,
					"content": "Tiếp theo, tôi sẽ dựa vào đặc tính của cá để liệt kê những bệnh nhân cụ thể.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747090110
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747090110,
					"content": "Rồi nhờ hai người chú ý đến những con cá như vậy nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747090107,
					"content": "Để giải quyết vấn đề, vẫn phải tìm ra nguyên nhân đã...",
