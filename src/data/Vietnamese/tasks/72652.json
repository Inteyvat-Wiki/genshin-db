				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"???"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726520101,
					"content": "Xin chào Nhà Lữ Hành! Dạo này thế nào? Có hứng thú giúp đỡ Đội thuyền Nam Thập Tự không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520102,
						726520103
					],
					"speakerTitle": "???"
				},
				{
					"id": 726520102,
					"content": "Đội thuyền Nam Thập Tự...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726520104
					]
				},
				{
					"id": 726520104,
					"content": "Ờ...à hahaha, xin lỗi xin lỗi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520105
					],
					"speakerTitle": "???"
				},
				{
					"id": 726520105,
					"content": "Tôi là Muzhen, kỹ thuật viên trưởng của \"Ngôi Sao Chết Chóc\". Tôi chỉ ở trong cabin chứ không ra ngoài nhiều, bạn không biết tôi cũng bình thường thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520106
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726520106,
					"content": "Kết quả thì bị đại ca Hải Long đá bay ra đây, haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520107
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726520107,
					"content": "\"Vận động bộ xương lười biếng đi! Phơi nắng cũng không hại gì!\" Đại ca nói như vậy rồi đuổi tôi lên bờ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520108
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726520108,
					"content": "Nhưng anh ta còn không dám bước xuống thuyền, hễ đứng trên mặt đất là ngất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520109,
						726520110
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726520109,
					"content": "Vậy sao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726520111
					]
				},
				{
					"id": 726520111,
					"content": "Ôi thật xin lỗi. Cứ lo kể chuyện người khác mà quên mất việc chính",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520112
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726520112,
					"content": "Để chuẩn bị kỹ thuật cho chuyến hành trình tiếp theo của chị đại Beidou, tôi phải nhờ bạn làm chút chuyện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520113
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726520113,
					"content": "Trước đây những việc này đều là chị đại tự làm, vì là người cầm đầu của \"Nam Thập Tự\", phải có ý thức tự giác đi đầu trong việc khám phá những mối nguy hiểm chưa biết...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520114
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726520114,
					"content": "Đó là quy tắc của \"Nam Thập Tự\" chúng tôi, bất kể ai trong chúng tôi trở thành lão đại, thì cũng đều phải thực hiện nghĩa vụ này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520115
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726520115,
					"content": "Vả lại chị đại có đơn hàng ở Inazuma cần ưu tiên hoàn thành trước, không thể vì chút chuyện nhỏ này mà chậm trễ được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520116
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726520116,
					"content": "Vậy nên đẩy cho chúng tôi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726520117,
					"content": "Hihi, không phải là tôi không giỏi đánh nhau...mà trên thuyền ai cũng có việc, đều rất bận, không thể đi được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520118
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726520118,
					"content": "Được rồi, không nói nhiều nữa. Chuyện là thế này",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520119
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726520119,
					"content": "Chủ của đơn hàng sau cần một lô hàng mẫu, là linh kiện của một cỗ máy di tích đặc biệt được sản xuất tại đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520120
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726520120,
					"content": "Theo như phân tích ghi chép mà chủ nhân giao cho chúng tôi, những cỗ máy...hoặc sinh vật đó, đang ẩn náu ở quần đảo Inazuma, rất thú vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520121,
						726520125,
						726520130
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726520121,
					"content": "Chủ nhân...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726520122
					]
				},
				{
					"id": 726520122,
					"content": "Thế nào, muốn thăm dò bí mật làm ăn của \"Nam Thập Tự\" sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520123
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726520123,
					"content": "Haha, đừng căng thằng, nếu tôi biết, tôi cũng vui vẻ nói cho bạn biết...nhưng về luật thì đây là \"tội chết\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520124
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726520124,
					"content": "Cho nên rất xin lỗi. Chủ nhân là ai tôi cũng không biết, và cũng không quan trọng với bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520134
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726520134,
					"content": "Nó ở đâu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726520135
					]
				},
				{
					"id": 726520135,
					"content": "Ôi, bạn hỏi đúng rồi đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520136
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726520136,
					"content": "Vấn đề là, tôi cũng không biết bọn nó đang ở đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520137
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726520137,
					"content": "Nhưng ở một số nơi trên đảo đã xuất hiện một số hiện tượng nguyên tố Lôi kỳ lạ. Theo quan sát của tôi, tần suất của chúng rất khác với hoạt động nguyên tố Lôi trên đảo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520138
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726520138,
					"content": "Tôi nghĩ chúng ta nên điều tra những khu vực khác thường trước, rất có thể nó sẽ có kết quả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520139
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726520139,
					"content": "Tiện thể nếu nó có tạo ra bất kỳ sản phẩm phụ nào, hãy đem về cho tôi nghiên cứu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520140
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726520140,
					"content": "Yên tâm, thù lao tôi sẽ trả đủ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726520125,
					"content": "Sinh vật máy móc...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726520126
					]
				},
				{
					"id": 726520126,
					"content": "...Ừm, công nhân mỏ của Vực Đá Sâu cũng từng đào được những thứ như vậy, nghe nói có liên quan tới thảm họa năm trăm năm trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520127
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726520127,
					"content": "Nói tóm lại, chúng đều là...vật không may, đáng sợ nhưng cũng rất thú vị...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520128
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726520128,
					"content": "Cứ nghĩ đến nó ở đây là không nhịn được, thật sự muốn gỡ ra xem cho đỡ ngứa tay...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520129
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726520129,
					"content": "Nhưng bạn không phải nhân viên kỹ thuật, bạn sẽ không hiểu được tâm trạng này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520134
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726520130,
					"content": "Thú vị...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726520131
					]
				},
				{
					"id": 726520131,
					"content": "Ừm...bạn không muốn chính tay gỡ một chiếc để thử cảm giác sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520132
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726520132,
					"content": "Không muốn lắm...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726520133,
					"content": "Hừm, được rồi...có lẽ chỉ những nhân viên kỹ thuật mới hiểu được nhiệt huyết của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726520134
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726520110,
					"content": "Có việc gì cần giúp không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726520111
					]
				},
				{
					"id": 726520103,
					"content": "Tôi có quen bạn sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726520104
					]
				}
			]
		}
	]
}