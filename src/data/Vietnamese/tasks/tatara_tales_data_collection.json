			"dialogs": [
				{
					"id": 721170101,
					"content": "Nhà Lữ Hành, bạn đến đúng lúc lắm. Chắc dữ liệu đã thu thập đủ rồi, đã đến lúc đi thu hồi những đèn hiệu đó rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721170102,
						721170104
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721170102,
					"content": "Không thành vấn đề.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721170103
					]
				},
				{
					"id": 721170103,
					"content": "Vậy giao cho bạn nhé, đi sớm về sớm, đừng để đám Fatui phát hiện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721170104,
					"content": "Sao bạn biết?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721170105
					]
				},
				{
					"id": 721170105,
					"content": "Đèn hiệu này thông thường khi chế tạo sẽ đính kèm sổ tay hướng dẫn sử dụng chi tiết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721170106
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721170106,
					"content": "Với trường hợp khác nhau, trong hướng dẫn cũng chỉ ra các khoảng thời gian thu thập dữ liệu được khuyến nghị khác nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721170107
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721170107,
					"content": "Thứ như Họa Thần thuộc về năng lượng bí ẩn, tôi bèn tính toán dựa theo thời gian dài nhất... Tóm lại, việc thu hồi đèn hiệu phiền bạn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				}
			]
		},
