			"dialogs": [
				{
					"id": 721170301,
					"content": "Sao rồi? Đèn hiệu đều thu hồi đủ rồi chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721170302
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721170302,
					"content": "Đã thu hồi đủ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721170303
					]
				},
				{
					"id": 721170303,
					"content": "Tốt quá rồi. Lát nữa tôi sẽ dựa theo những dữ liệu này để cải tạo thiết bị một chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721170304
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721170304,
					"content": "Có điều dạo này hoạt động của đám Fatui kia càng ngày càng quái dị, hình như chúng đều tập trung ở khu vực hạt nhân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721170305
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721170305,
					"content": "Hy vọng chúng không có mưu đồ xấu xa nào đó... Hoặc đừng có làm chuyện gì để chúng ta không xử lý nổi...",
