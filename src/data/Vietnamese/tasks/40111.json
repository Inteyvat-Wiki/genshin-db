			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaeya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401111301,
					"content": "Ồ, còn có gì muốn nói không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111302,
						401111306,
						401111310
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401111302,
					"content": "Về Thất Thánh Triệu Hồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401111303
					]
				},
				{
					"id": 401111303,
					"content": "Dạo này loại thẻ bài này đang rất phổ biến, và đã trở thành một phần trong cuộc sống của mỗi người. Có thể thấy mọi người chơi ở khắp mọi nơi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111304
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401111304,
					"content": "Hơn nữa còn có người vì giữ đầu óc tỉnh táo để chơi bài mà cai cả rượu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111305
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401111305,
					"content": "Chậc, Diona mà nghe thấy chuyện này chắc sẽ rất vui nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111306,
						401111310
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401111306,
					"content": "Người của Đội Kỵ Sĩ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401111307
					]
				},
				{
					"id": 401111307,
					"content": "Yên tâm yên tâm, mọi người đều ổn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111308
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401111308,
					"content": "Tôi từng thử kéo đội trưởng Jean chơi cùng, nhưng vừa chơi được chút là cô ấy đã bị ai đó gọi đi. Haiz, thật hết cách. Chỉ có thể nói là \"ai cũng có trách nhiệm riêng\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111309
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401111309,
					"content": "Nhưng thấy giải đấu tổ chức thành công như vậy, mọi người đều rất vui, chắc là cô ấy cũng thấy nhẹ nhõm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111302,
						401111310
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401111310,
					"content": "Hẹn gặp lại vào hôm khác.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401111311
					]
				},
				{
					"id": 401111311,
					"content": "#Được, nếu có dịp thì tôi vẫn muốn cùng {F#cô}{M#cậu} chơi một ván Thất Thánh Triệu Hồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				}
			]
		},
