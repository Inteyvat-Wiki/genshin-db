				"points": []
			},
			"dialogs": [
				{
					"id": 401115101,
					"content": "Trận đấu của cô gái hồ ly với Sango cái gì đó komi thật khiến ta rạo rực, mồ hôi trên trán cứ như nước sôi vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115102
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401115102,
					"content": "Đúng vậy đấy. Đại ca à, cả Đảo Ritou cũng biết đại ca phấn khích thế nào mà. Nhưng Bang Arataki vẫn đang chờ, cũng đến lúc nên về rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115103
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401115103,
					"content": "Chờ thêm chút nữa đi. Ít ra thì cũng phải để ta và bạn thân ta chơi thêm ván cuối chứ... Yêu cầu này có quá đáng đâu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115104,
						401115107
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401115104,
					"content": "Vậy thì chơi một ván.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401115105
					]
				},
				{
					"id": 401115105,
					"content": "Bạn chí cốt! Ngươi đúng là bạn chí cốt của ta mà! Đúng là chỉ có ngươi mới hiểu được ngọn lửa chơi bài của ta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115106
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401115106,
					"content": "...Thật hết cách.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401115107,
					"content": "Không chơi nữa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401115108
					]
				},
				{
					"id": 401115108,
					"content": "...Được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115109
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401115109,
					"content": "Đàn ông sẽ không rơi nước mắt. Ta không trách ngươi đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				}
			]
		},
