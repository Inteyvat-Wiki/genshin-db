			"dialogs": [
				{
					"id": 401115201,
					"content": "Sara, có rảnh để nói chuyện không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115202
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 401115202,
					"content": "Chúc mừng cô đã chiến thắng, Sangonomiya Kokomi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115203
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 401115203,
					"content": "May nhờ có lời nhắc nhở của Sara nên tôi mới thắng, rất cảm ơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115204
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 401115204,
					"content": "Không có gì. Ai cũng sẽ hiểu chiến lược mới là thứ để giành chiến thắng mà. Nhưng dù thế nào thì đó cũng là một trận đấu thú vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115205
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 401115205,
					"content": "Lần này Sara không đăng ký thi đấu thì đúng là đáng tiếc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115206
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 401115206,
					"content": "Tôi e là sẽ không thắng được cô.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115207
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 401115207,
					"content": "Đừng nói vậy. Tôi nghĩ Sara cũng giống tôi, mong được giao lưu cách chơi bài, suy nghĩ chiến lược và so tài với những người bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115208
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 401115208,
					"content": "...Có lẽ vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115209
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 401115209,
					"content": "Tôi hiểu rồi. Nếu đã như vậy, trước khi cô rời khỏi Đảo Narukami thì chúng ta cùng chơi một ván Thất Thánh Triệu Hồi đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115210
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 401115210,
					"content": "Luôn sẵn lòng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sangonomiya Kokomi"
				}
			]
