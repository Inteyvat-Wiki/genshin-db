						401111402
					],
					"speakerTitle": "Eichendorff"
				},
				{
					"id": 401111402,
					"content": "Không ngờ Timmie lại thắng... tôi cũng xem như... thua trong vinh dự.",
					"roleType": "TALK_ROLE_NPC",
