			"dialogs": [
				{
					"id": 401115301,
					"content": "Tôi thấy cô gọi cô ấy là đại nhân youkai, có lý do nào cho việc này không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115302
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401115302,
					"content": "Nói chi tiết cho tôi biết đi, nói không chừng sẽ có ích cho bài viết của tôi đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115303
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401115303,
					"content": "Hở? Tôi chỉ sợ tôi nói sai thôi, dù sao thì kinh nghiệm làm youkai của tôi cũng rất ít mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115304
					],
					"speakerTitle": "Kirara"
				},
				{
					"id": 401115304,
					"content": "Được rồi, thế Đậu Phụ Rán thì có liên quan gì với hồ ly vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115305
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401115305,
					"content": "Ôi, bị hỏi đến đói bụng luôn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115306
					],
					"speakerTitle": "Kirara"
				},
				{
					"id": 401115306,
					"content": "Hay là tôi dẫn cô đi ăn Ramen Đậu Phụ Rán của Inazuma nhé, vừa ăn vừa giải thích.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kirara"
				}
			]
		}
