				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401111101,
					"content": "Thắng rồi thắng rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111102,
						401111106
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 401111102,
					"content": "Chúc mừng Timmie!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401111103
					]
				},
				{
					"id": 401111103,
					"content": "#Cảm ơn {F#chị}{M#anh}. Như vậy thì mẹ chắc chắn cũng sẽ vui đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111104
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 401111104,
					"content": "Mẹ Grace luôn ủng hộ em tham gia thi đấu, em phải tặng hết phần thưởng cho mẹ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111105
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 401111105,
					"content": "Ước gì cha cũng có thể nhìn thấy em bây giờ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timmie"
				},
				{
					"id": 401111106,
					"content": "Tạm biệt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401111107
					]
				},
				{
					"id": 401111107,
					"content": "Tạm biệt, Thất Thánh Triệu Hồi thật thú vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timmie"
				}
			]
		},
		{
			"id": 4011112,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4011101",
							"2"
						],
						"stepId": 4011101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mika",
					"Huffman"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401111201,
					"content": "Kết thúc rồi sao? Em đến trễ rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111202
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401111202,
					"content": "Mika, thật tiếc khi em không nhìn thấy. Đội trưởng Kaeya... đã thua rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111203
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 401111203,
					"content": "Hả?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111204
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401111204,
					"content": "Anh, cụ thể là sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111205
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401111205,
					"content": "Anh không nghiên cứu gì về Thất Thánh Triệu Hồi, chỉ dựa vào cuộc thảo luận của mọi người để hiểu rõ tình hình thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111206
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 401111206,
					"content": "Ban đầu, đội trưởng Kaeya rất nhanh đã hạ được thẻ bài đầu tiên của đối thủ, chiếm ưu thế lớn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111207
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 401111207,
					"content": "Nhưng hình như đó là chiến lược của đối phương nhỉ? Đứa trẻ tên Timmie dựa vào những hiệp trước để tích trữ thẻ bài trên tay... và cuối cùng bùng nổ với sức mạnh đáng kinh ngạc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111208
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 401111208,
					"content": "Không... Có lẽ kết quả của ván đấu đó đã được quyết định ngay từ khi đội trưởng Kaeya rút trúng lượt \"đi sau\" rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111209
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 401111209,
					"content": "Haiz, anh muốn đi uống một ly giải sầu quá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111210
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 401111210,
					"content": "Anh, anh bình tĩnh đi, giờ không phải là lúc để mượn rượu giải sầu đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111211
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401111211,
					"content": "Theo em biết về đội trưởng Kaeya thì anh ấy cũng sẽ không muốn nhìn thấy anh buồn như vậy đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111212
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401111212,
					"content": "Hay là chúng ta cũng học chơi bài đi? Nói không chừng lần sau còn được đấu với đội trưởng Kaeya đó! Haha... Nhưng sợ là sẽ thua rất thảm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111213
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401111213,
					"content": "Haha, em nói đúng, Mika.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huffman"
				}
			]
		},
		{
			"id": 4011113,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
