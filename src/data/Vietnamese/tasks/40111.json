					"Charlotte"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401111501,
					"content": "\"Đội Trưởng Kỵ Binh Tây Phong đối đầu với Thiên Tài Trẻ Tuổi Bất Bại, thành phố trong hồ đầy rẫy nhân tài\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111502
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401111502,
					"content": "Ừm, tiêu đề này khen đủ nhiều rồi, nhưng thiếu chút \"điểm nhấn\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111503
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401111503,
					"content": "\"Người Chơi Hệ Não hàng đầu của Đội Kỵ Sĩ Tây Phong đã thua Cậu Bé Đầu Cầu trong Năm Hiệp\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111504
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401111504,
					"content": "\"Tuyển Thủ Hạt Giống đã bị Ngựa Ô lội ngược dòng\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111505
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401111505,
					"content": "Ừm, vẫn nên dùng cái đầu tiên nhỉ?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Charlotte"
				}
			]
		},
