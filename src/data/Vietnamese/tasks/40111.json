					"Qian"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401113301,
					"content": "Xin chào, tôi là Charlotte, phóng viên của Tòa Soạn Chim Hơi Nước đến từ Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113302
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401113302,
					"content": "Có thể cho tôi xin chút thời gian không? Tôi muốn làm một cuộc phỏng vấn ngắn với anh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113303
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401113303,
					"content": "Khụ, cô hỏi đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113304
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 401113304,
					"content": "Anh liên tục thắng trận, nhưng đến trận cuối lại thua đường chủ Hu Tao của Vãng Sinh Đường, bỏ lỡ chức vô địch, có vẻ khá đáng tiếc nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113305
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401113305,
					"content": "Anh đánh giá thế nào về giải đấu này?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113306
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401113306,
					"content": "...Chuyện này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113307
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 401113307,
					"content": "Cô muốn câu trả lời để viết lên báo hay là cảm nhận thật sự của tôi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113308
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 401113308,
					"content": "Tất nhiên là cảm nhận thật rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113309
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401113309,
					"content": "Haiz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113310
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 401113310,
					"content": "Mặc dù chơi bài bảy phần là nhờ kỹ thuật, ba phần là nhờ may mắn... Nhưng lần này gieo sáu viên xúc xắc cùng màu, vậy thì dù tôi có là thần thì cũng thắng không nổi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qian"
				}
			]
		},
		{
