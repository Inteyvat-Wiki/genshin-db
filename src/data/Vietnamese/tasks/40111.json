				"points": []
			},
			"dialogs": [
				{
					"id": 401113201,
					"content": "Nghe nói giải đấu đường phố Thất Thánh Triệu Hồi được tổ chức rất náo nhiệt, nhiều tuyển thủ thích chơi bài thậm chí còn đăng ký cả hai bên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113202
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 401113202,
					"content": "Đối với tôi thì... thỉnh thoảng theo trào lưu cũng không sao, nhưng tôi vẫn thích chơi cờ hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113203
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 401113203,
					"content": "Suy cho cùng thì những trò giải trí này chỉ khác nhau về hình thức. Bạn bè được quây quần bên nhau sẽ đáng quý hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ningguang"
				}
			]
		},
		{
			"id": 4011133,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
