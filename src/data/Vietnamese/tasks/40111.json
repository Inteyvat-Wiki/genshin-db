			"dialogs": [
				{
					"id": 401113101,
					"content": "Kể ra thì chị Beidou cũng biết chơi Thất Thánh Triệu Hồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113102
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 401113102,
					"content": "Ừm, kỹ năng chơi bài của chị ấy cũng xếp nhất nhì trong đội thuyền Nam Thập Tự đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113103
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 401113103,
					"content": "Hay là anh bạn Kazuha giới thiệu được không? Tôi ngưỡng mộ chị Beidou đã lâu, từ lâu đã muốn kết bạn với chị ấy, nhưng mãi chưa có cơ hội.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113104
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 401113104,
					"content": "Được. Đến lúc đó xin đường chủ nương tay nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				}
			]
		},
		{
			"id": 4011132,
