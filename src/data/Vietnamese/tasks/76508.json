				]
			},
			"dialogs": [
				{
					"id": 765080301,
					"content": "#Ái chà! Đây không phải là {NICKNAME} danh tiếng lẫy lừng sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080302
					],
					"speakerTitle": "Taraneh"
				},
				{
					"id": 765080302,
					"content": "Tôi tưởng mời được cô Nilou đã là điều may mắn nhất rồi, không ngờ vẫn còn cao thủ trong cao thủ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080303
					],
					"speakerTitle": "Taraneh"
				},
				{
					"id": 765080303,
					"content": "#Khen {NICKNAME} thêm nữa nào, tôi thích nghe đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080304
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 765080304,
					"content": "Ơ? Đây không phải nên là lời thoại của tôi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765080305,
					"content": "Đúng vậy! Cùng một từ nhưng khi phát ra từ miệng của tham mưu Paimon thì sẽ thanh thoát nhẹ nhàng hơn. Giống như âm thanh của Ukulele vậy, mềm mại du dương, vô cùng đáng yêu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080306
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 765080306,
					"content": "Còn nếu là tôi nói... thì sẽ như một tay trống uống hết nửa thùng rượu rồi đánh ra nhịp trống mạnh mẽ và đầy nhịp điệu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080307
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 765080307,
					"content": "Tất nhiên, theo lời dạy của Iansan thì nên tận dụng bàn đạp trống trầm càng nhiều càng tốt, tốt nhất là nên liên tục như súng tự động vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080308
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 765080308,
					"content": "Thế thì dù chúng ta có nói cùng một lời thoại thì cũng không có cảm giác luyên thuyên, mà giống như bổ sung đủ các tông và còn giúp vào đúng nhịp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080309
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 765080309,
					"content": "Còn, còn có thể như vậy sao? Nghe hơi lùng bùng rồi đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765080310,
					"content": "Nusta nói đúng điểm mấu chốt rồi đó... Nhịp điệu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080311
					],
					"speakerTitle": "Taraneh"
				},
				{
					"id": 765080311,
					"content": "Vũ đạo của chúng ta tự do và phóng khoáng, nhưng cũng không thể hoàn toàn không có sự ràng buộc được. Ít nhất thì những động tác quan trọng nhất vẫn cần phải đúng nhịp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080312
					],
					"speakerTitle": "Taraneh"
				},
				{
					"id": 765080312,
					"content": "Vũ đạo mới gần đây đã sắp xếp xong động tác rồi, nhưng những người mới... cùng các Saurian mới đến trải nghiệm đều chưa quen bắt đúng nhịp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080313
					],
					"speakerTitle": "Taraneh"
				},
				{
					"id": 765080313,
					"content": "#Vậy thì, nhờ {NICKNAME} đến hướng dẫn phần nhịp điệu nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080314
					],
					"speakerTitle": "Taraneh"
				},
				{
					"id": 765080314,
					"content": "#Nếu có {F#cô}{M#cậu} thì người mới và Saurian mới chắc chắn sẽ có thể tập trung cao độ và tiếp thu nhanh chóng đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080315,
						765080316
					],
					"speakerTitle": "Taraneh"
				},
				{
					"id": 765080315,
					"content": "Được! Nhịp của tôi luôn đúng và chắc chắn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765080317
					]
				},
				{
					"id": 765080317,
					"content": "#Vậy... tôi sẽ cổ vũ cho {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765080318,
					"content": "#Ừm... Và cổ vũ cho mọi người mà {NICKNAME} hướng dẫn nữa!",
