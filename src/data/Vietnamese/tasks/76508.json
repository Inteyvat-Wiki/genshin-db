			},
			"dialogs": [
				{
					"id": 765080101,
					"content": "Gần đây Cư Dân Suối Nước đang tổ chức sự kiện gì sao? Hình như có thêm khách du lịch nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765080102,
					"content": "Bên kia có một vị khách Sumeru... đang biểu diễn múa cho mọi người xem sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765080103,
					"content": "Ai da, đại anh hùng lấp lánh và tham mưu Paimon đáng yêu cũng tới rồi sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080104
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 765080104,
					"content": "#Xin được gửi lời chào đến {F#cô}{M#cậu}. Vị chiến binh có cả sức mạnh lẫn khả năng vũ đạo, và cũng là nhà tận hưởng cuộc sống mà tôi kính trọng nhất!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080105
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 765080105,
					"content": "Hmm, vị tiểu thư này nhìn quen quen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765080106,
					"content": "#Hơn nữa, sao cô biết khi {NICKNAME} nhảy múa thì trông rất vui vẻ vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765080107,
					"content": "#Đương nhiên là tôi từng thấy {M#cậu ấy}{F#cô ấy} nhảy múa vui vẻ trước Đấu Trường Lửa Thánh rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080108
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 765080108,
					"content": "#Sau khi chụp hình chung, tôi đã tìm một nơi kín đáo, vừa ăn Bánh Quy Saurus vừa xem vũ đạo chúc phúc của {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080109
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 765080109,
					"content": "#Nhảy múa là phải thật thoải mái! Làm tôi cũng muốn nhảy phụ họa cho {NICKNAME} đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080110,
						765080112
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 765080110,
					"content": "À, tôi nhớ ra rồi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765080111
					]
				},
				{
					"id": 765080111,
					"content": "Tôi rất vinh dự!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080114
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 765080114,
					"content": "Quay lại chuyện chính, gần đây có một vài người bạn Sumeru đến thăm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080115
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 765080115,
					"content": "Sau khi thương lượng với Mutota, Amina, Pacal và Mualani, Hội Hoa Vũ chúng tôi quyết định hợp tác với Con Của Tiếng Vang và Cư Dân Suối Nước để tiếp đãi họ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080116
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 765080116,
					"content": "Xem ra sẽ có không ít lính đánh thuê của Eremite nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765080117,
					"content": "Để tôi đoán xem, có phải khi du lịch ở sa mạc, mọi người đã quen nhau trong lúc so tài rồi trở thành bạn bè của nhau không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765080118,
					"content": "Hah, cũng gần giống vậy đó! Nhưng không phải chúng tôi so tài với nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080119
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 765080119,
					"content": "Lúc chúng tôi tổ chức bữa tiệc nướng thịt ở phía nam Sa Mạc Hadramaveth thì đã thu hút một bầy Kền Kền Đỏ hung hãn. Chúng chọn ngay lúc chúng tôi ăn uống no say mới ra tay...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080120
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 765080120,
					"content": "Chúng rất xảo quyệt, chúng tôi đã chống chọi một lúc nhưng không hiệu quả, bị chúng lợi dụng địa hình để đánh cho sức cùng lực kiệt, chỉ có thể rút lui trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080121
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 765080121,
					"content": "Không ngờ, một đội lính đánh thuê đã xuất hiện trên đường rút lui của chúng tôi, rồi nhảy một vũ điệu chiến đấu bí ẩn với lũ Kền Kền Đỏ đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080122
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 765080122,
					"content": "Có vẻ như Kền Kền Đỏ hiểu được ý nên đã rút lui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080123
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 765080123,
					"content": "Dùng... dùng vũ đạo chiến đấu để đuổi Kền Kền Đỏ đi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080124,
						765080125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765080124,
					"content": "Là tư thế múa kỳ lạ đã dọa cho chúng chạy mất...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765080126
					]
				},
				{
					"id": 765080126,
					"content": "Rất thần kỳ đúng không? Chúng tôi cũng rất tò mò về điệu nhảy đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080127
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 765080127,
					"content": "Sau khi thu dọn doanh trại xong, chúng tôi đã cùng nhau ăn uống say sưa, chờ đến khi no say rồi mới bắt đầu trao đổi kỹ năng nhảy múa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080128
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 765080128,
					"content": "Nếu như có ma vật hoặc dã thú nào khác làm phiền, thì chúng tôi sẽ cùng xông lên xử lý!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080129
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 765080129,
					"content": "Không tới hai tuần, chúng tôi đã trở thành chiến hữu và bạn nhảy chí cốt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080130
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 765080130,
					"content": "Trước khi chia tay, chúng tôi đã hẹn nhau rằng sau này còn phải chính thức ghé thăm doanh trại của đối phương để tiếp tục \"giao lưu vũ đạo\". Lần này chính là khởi đầu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080131
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 765080131,
					"content": "#Nói ra thì, hình như trước đây chúng ta chưa từng tham gia qua loại... sự kiện giao lưu vũ đạo giữa bạn bè Sumeru và Natlan nhỉ, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080132,
						765080133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765080132,
					"content": "Đúng là mới lạ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765080134
					]
				},
				{
					"id": 765080134,
					"content": "Đây là cơ hội hiếm có, hãy đến hướng dẫn cho chúng tôi nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080135
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 765080135,
					"content": "Mualani cũng có mặt đấy. Cô ấy được xem là người đại diện vũ đạo vui vẻ nhất trong số chúng tôi rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080136
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 765080136,
					"content": "Hơn nữa, bạn bè Eremite còn bỏ ra rất nhiều tiền để mời vũ công nổi tiếng ở địa phương đến làm người dẫn đội và cố vấn cho phía Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080137
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 765080137,
					"content": "Tôi nghĩ, chắc chắn các vị cũng biết cô vũ công đó rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080138
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 765080138,
					"content": "Hình như tôi đã đoán được là ai rồi. Hihi, lát nữa chúng ta cùng cho cô ấy một bất ngờ lớn đi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080139,
						765080140
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765080139,
					"content": "Được đó, tôi muốn tham gia!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765080141
					]
				},
				{
					"id": 765080141,
					"content": "Hahaha! Vậy là càng thêm náo nhiệt hơn rồi. Theo lời của Mualani thì là bầu không khí đã lên đến đỉnh điểm rồi đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080142
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 765080142,
					"content": "Đi thôi, chúng ta đi tìm Taraneh nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nusta"
				},
				{
					"id": 765080140,
					"content": "Không thể bỏ lỡ những sự kiện như vậy được!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765080141
					]
				},
				{
					"id": 765080133,
					"content": "Tôi muốn xem thử.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765080134
					]
				},
				{
					"id": 765080125,
					"content": "Hay là hai bên đã quen biết nhau từ trước vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765080126
					]
				},
				{
					"id": 765080112,
					"content": "Sau này tôi chắc chắn sẽ nhớ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765080113
					]
				},
				{
					"id": 765080113,
					"content": "Vậy chứng tỏ tôi vẫn chưa đủ chăm chỉ, không để lại thành tích nổi bật gì, vẫn phải cố gắng nhiều hơn nữa rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080114
					],
					"speakerTitle": "Nusta"
				}
			]
		},
