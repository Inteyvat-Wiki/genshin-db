					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"???",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101200201,
					"content": "Ai đấy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200202
					],
					"speakerTitle": "Schubert"
				},
				{
					"id": 101200202,
					"content": "Xin chào, chúng tôi đến để...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101200203,
					"content": "Xin chào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200204,
						101200206
					],
					"speakerTitle": "Schubert"
				},
				{
					"id": 101200204,
					"content": "Xin, xin chào...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200205
					]
				},
				{
					"id": 101200205,
					"content": "Xin chào? Ta không nghe nhầm chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200208
					],
					"speakerTitle": "Schubert"
				},
				{
					"id": 101200208,
					"content": "Hừ, ngọn cỏ ven đường mà cũng dám tùy tiện đến chào hỏi ta à.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200209
					],
					"speakerTitle": "Schubert"
				},
				{
					"id": 101200209,
					"content": "Quả nhiên là người từ nơi khác đến, ngay cả ta cũng không biết. Ta là Schubert Lawrence, hậu duệ của quý tộc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200210
					],
					"speakerTitle": "Schubert"
				},
				{
					"id": 101200210,
					"content": "Muốn chào hỏi ta sao, phải chú ý cách ăn nói vào, như vậy thì ta nghe mới lọt tai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200211
					],
					"speakerTitle": "Schubert"
				},
				{
					"id": 101200211,
					"content": "Nếu nghe hiểu những gì ta nói thì bây giờ ngươi phải quỳ xuống, khiêm tốn tự giới thiệu kèm theo lời xin lỗi, như vậy mới là lễ nghi cơ bản!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200212
					],
					"speakerTitle": "Schubert"
				},
				{
					"id": 101200212,
					"content": "Chà! Sao phức tạp vậy, nghe không hiểu gì cả?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101200213,
					"content": "Hừ, trong thời đại trọng lễ nghĩa đó thì lễ nghi cơ bản này, là thường thức cần có khi gặp quý tộc!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200214
					],
					"speakerTitle": "Schubert"
				},
				{
					"id": 101200214,
					"content": "Nếu như dám chào hỏi thất lễ như vậy, ít nhất là sẽ phải chịu vài roi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200215
					],
					"speakerTitle": "Schubert"
				},
				{
					"id": 101200215,
					"content": "Thời thế bây giờ, ai cũng không biết lễ độ chừng mực, hủ bại đến chướng mắt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200216,
						101200217
					],
					"speakerTitle": "Schubert"
				},
				{
					"id": 101200216,
					"content": "Thật phiền phức.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200218
					]
				},
				{
					"id": 101200218,
					"content": "Ngươi nói cái gì? Ngươi đang chất vấn sự tôn nghiêm của quý tộc à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200219
					],
					"speakerTitle": "Schubert"
				},
				{
					"id": 101200219,
					"content": "Ta nói cho ngươi biết, cho dù gia tộc Lawrence hiện giờ có thất thế, nhưng hậu duệ như ta nhất định sẽ phục hưng được ánh hào quang cũ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200220
					],
					"speakerTitle": "Schubert"
				},
				{
					"id": 101200220,
					"content": "Người xung quanh càng thản nhiên thì ta càng phải bảo vệ sự tôn nghiêm của quý tộc. Dẫu sao thì từ khi ta sinh ra đã đặc biệt rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200221
					],
					"speakerTitle": "Schubert"
				},
				{
					"id": 101200221,
					"content": "Tôi còn chưa nói gì cả...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200222
					]
				},
				{
					"id": 101200222,
					"content": "Thôi, lời nói của ngươi ta nghe không lọt tai, ta không muốn nói chuyện với đám thường dân như ngươi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200223
					],
					"speakerTitle": "Schubert"
				},
				{
					"id": 101200223,
					"content": "Hơn nữa, ta cũng không có nghĩa vụ phải dạy cho ngươi sự lễ phép.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200224
					],
					"speakerTitle": "Schubert"
				},
				{
					"id": 101200224,
					"content": "Ta còn việc quan trọng phải làm, đi trước đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Schubert"
				},
				{
					"id": 101200217,
					"content": "Chẳng trách sao giới quý tộc cũ lại thất thế.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200218
					]
				},
				{
					"id": 101200206,
					"content": "Sao thế?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200207
					]
				},
				{
					"id": 101200207,
					"content": "Sao thế à? Ta không nghe nhầm chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200208
					],
					"speakerTitle": "Schubert"
				}
			]
		},
		{
			"id": 1012003,
			"completionStepIds": [
				1012005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
