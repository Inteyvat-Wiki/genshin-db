				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Amber",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101200301,
					"content": "Ồ, là Kỵ Sĩ Danh Dự sao! Tôi vừa định đi trinh sát thì gặp bạn ở đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200302
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 101200302,
					"content": "Hử? Nhìn vẻ mặt của bạn, hình như gặp phải chuyện không vui hả?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200303
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 101200303,
					"content": "Chuyện mà đội trưởng Jean ủy thác cho chúng tôi... có vẻ như thất bại rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200304,
						101200305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101200304,
					"content": "Chuyện dài lắm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200306
					]
				},
				{
					"id": 101200306,
					"content": "Đừng nản lòng, thất bại là chuyện thường tình mà. Tôi cũng đâu phải lúc nào cũng tìm được tin tình báo có ích đâu nè.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200307
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 101200307,
					"content": "Cho nên, phấn chấn lên nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200308,
						101200309
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 101200308,
					"content": "Cảm ơn Amber.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200310
					]
				},
				{
					"id": 101200310,
					"content": "Hì hì. Hay là vậy đi, tôi sẽ nghĩ cách giúp bạn nhé, bạn đang gặp phải chuyện gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200311
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 101200311,
					"content": "Đội trưởng Jean nhờ chúng tôi đi làm quen với Schubert Lawrence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101200312,
					"content": "Nhưng khi gặp thì chúng tôi mới thấy tính cách của người này kỳ lạ quá, hắn vốn không định nghe người khác nói chuyện...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101200313,
					"content": "À à, tôi biết người này! Chắc là hắn đã nói các bạn không biết lễ độ đúng không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200314,
						101200315
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 101200314,
					"content": "Xem ra Amber cũng nghe đồn rồi nhỉ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200316
					]
				},
				{
					"id": 101200316,
					"content": "Ha ha, tôi cũng từng bị dạy dỗ vài lần, người của nhà Lawrence có hơi kỳ lạ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200317
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 101200317,
					"content": "Tất cả họ đều thế sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101200318,
					"content": "Họ cảm thấy quý tộc thì cần phải có đặc quyền của quý tộc thôi, có thể lý giải được... Nhưng tôi vẫn thấy họ bị cổ hủ lỗi thời quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200319
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 101200319,
					"content": "Nhưng mà, gia tộc đó cũng có một ngoại lệ đặc biệt, chính là đồng đội của tôi, Eula!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200320
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 101200320,
					"content": "Đồng, đồng đội?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101200321,
					"content": "Đúng vậy, cô ấy là người của nhà Lawrence, nhưng cũng là đội trưởng tiểu đội 4 của Đội Kỵ Sĩ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200322,
						101200323
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 101200322,
					"content": "Nhưng Jean có nói là nhà Lawrence xem Đội Kỵ Sĩ như kẻ thù mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200324
					]
				},
				{
					"id": 101200324,
					"content": "Vì Eula là trường hợp đặc biệt, cô ấy khác với những người trong gia tộc, có cách suy nghĩ và hành động riêng của mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200325
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 101200325,
					"content": "Nói cách khác, cô ấy không để tâm đến những luật lệ trong gia tộc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200326
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 101200326,
					"content": "À, nếu muốn biết làm sao để nói chuyện với nhà Lawrence thì cô ấy biết rõ nhất. Bạn đến gặp cô ấy là hiểu thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200327
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 101200327,
					"content": "Tôi không hiểu cho lắm, nếu Eula là người nhà Lawrence, vậy thì tại sao Jean lại tìm chúng tôi mà không trực tiếp đi nhờ Eula?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200328
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101200328,
					"content": "Chuyện này cũng khá dài dòng. Nói đơn giản thì do Eula đã gia nhập Đội Kỵ Sĩ, nên người nhà của cô ấy đều rất không thích cô ấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200329
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 101200329,
					"content": "Trong mắt của họ thì Eula giống như kẻ phản bội.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200330,
						101200331
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 101200330,
					"content": "Thật cá tính.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200332
					]
				},
				{
					"id": 101200332,
					"content": "Hì hì, nhưng cô ấy rất thân thiện, chỉ cần bạn hỏi là cô ấy sẽ chỉ cách bạn giao tiếp với Schubert thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200333
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 101200333,
					"content": "Sáng nay hình như cô ấy đã ra ngoài tuần tra, bạn có thể đến Núi Vọng Phong để tìm cô ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200334
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 101200334,
					"content": "Ừm ừm, cảm ơn Amber, chúng tôi đi đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200335
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101200335,
					"content": "Chúc hai bạn may mắn nhé! Tôi đi do thám tiếp đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 101200331,
					"content": "Chuyện này cũng dễ hiểu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200332
					]
				},
				{
					"id": 101200323,
					"content": "Người của nhà Lawrence có thể gia nhập Đội Kỵ Sĩ sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200324
					]
				},
				{
					"id": 101200315,
					"content": "Hình như Amber từng trải qua rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200316
					]
				},
				{
					"id": 101200309,
					"content": "Đúng là phong cách của Amber.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200310
					]
				},
				{
					"id": 101200305,
					"content": "Không phải là lỗi của chúng tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200306
					]
				}
			]
		},
