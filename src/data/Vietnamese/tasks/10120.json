	"talks": [
		{
			"id": 1012001,
			"completionStepIds": [
				1012001
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1012001",
							"2"
						],
						"stepId": 1012001,
