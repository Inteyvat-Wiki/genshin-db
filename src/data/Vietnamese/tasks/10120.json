					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101200802,
					"content": "Hừm... tôi không có ấn tượng với cái tên này, nhưng gần đây có một người kỳ lạ hay đi quanh đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200803
					],
					"speakerTitle": "Michelle"
				},
				{
					"id": 101200803,
					"content": "Cứ đi vòng vòng rồi lại viết vẽ gì đó, không biết đang làm gì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200804
					],
					"speakerTitle": "Michelle"
				},
				{
					"id": 101200804,
					"content": "Nếu đó là người mà hai người cần tìm thì có thể đến chỗ tường thành xem thử.",
					"roleType": "TALK_ROLE_NPC",
