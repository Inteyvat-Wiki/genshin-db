			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jean",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101200101,
					"content": "#Kỵ Sĩ Danh Dự, cảm ơn {F#cô}{M#cậu} đã đến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200102
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 101200102,
					"content": "#Vào thẳng vấn đề nhé, Đội Kỵ Sĩ hiện giờ có một việc khá quan trọng muốn ủy thác cho {F#cô}{M#cậu}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200103,
						101200105
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 101200103,
					"content": "Đội Kỵ Sĩ vẫn bận rộn như mọi khi nhỉ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200104
					]
				},
				{
					"id": 101200104,
					"content": "Ừm, gần đây có nhiều sóng gió, cho dù là tôi hay là thành viên nào trong Đội Kỵ Sĩ Mondstadt cũng không dám lơ là dù chỉ một giây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200107
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 101200107,
					"content": "Gần đây tôi nhận được rất nhiều tình báo, nói rằng người của gia tộc Lawrence đang qua lại với Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200108
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 101200108,
					"content": "Fatui, lại là chúng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101200109,
					"content": "Còn gia tộc Lawrence, là ai vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101200110,
					"content": "Mondstadt trước đây từng có một thời kỳ bị thống trị bởi giới quý tộc cũ. Sự tự do giành được từ bạo chúa Tháp Cô Vương đã bị những quý tộc này gắn lên xiềng xích.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200111
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 101200111,
					"content": "\"Kỵ Sĩ Bồ Công Anh\" đời đầu là Vennessa đã khởi nghĩa lật đổ sự thống trị của giới quý tộc cũ, lập ra Đội Kỵ Sĩ Tây Phong, nên Mondstadt mới có được ngày hôm nay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200112
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 101200112,
					"content": "Còn giới quý tộc mang lại xiềng xích cho Mondstadt, chính là gia tộc Lawrence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200113
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 101200113,
					"content": "À, hình như tôi hiểu rồi. Vậy bây giờ hậu duệ của đám người xấu đó lại muốn cấu kết với Fatui sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101200114,
					"content": "Trước mắt chỉ là nghi ngờ, chưa có chứng cứ xác thực nào. Tôi mời hai người đến là để điều tra chuyện này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200115,
						101200116
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 101200115,
					"content": "Tại sao lại là tôi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200117
					]
				},
				{
					"id": 101200117,
					"content": "Bởi vì trước đây, quý tộc cũ và Đội Kỵ Sĩ vẫn luôn đối đầu với nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200118
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 101200118,
					"content": "Đội Kỵ Sĩ đã mất rất nhiều thời gian mới hóa giải mâu thuẫn đôi bên. Nhưng hậu duệ của giới quý tộc đó vẫn xem Đội Kỵ Sĩ như kẻ thù...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200119
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 101200119,
					"content": "Dù cho chúng tôi có dùng thái độ gì để nói chuyện với họ đi nữa cũng không có kết quả, thậm chí còn phản tác dụng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200120
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 101200120,
					"content": "Tuy có thể áp dụng lệnh \"điều tra\" với họ, nhưng nếu thực sự họ bị oan thì mối thù giữa đôi bên lại càng sâu đậm thêm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200121
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 101200121,
					"content": "Như vậy những nỗ lực trước đây sẽ trở nên uổng phí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200122
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 101200122,
					"content": "Nhưng tôi cũng là Kỵ Sĩ Danh Dự mà...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200123
					]
				},
				{
					"id": 101200123,
					"content": "#Trong Đội Kỵ Sĩ, {F#cô}{M#cậu} là người thích hợp ra mặt nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200124
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 101200124,
					"content": "#{F#Cô}{M#Cậu} cũng không cần quá nhấn mạnh thân phận kỵ sĩ của mình. {F#Cô}{M#Cậu} từ nơi xa tới đây, không giống như \"phần lớn\" người trong thành, từ góc độ này có thể tìm thấy chủ đề chung với nhà quý tộc đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200125
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 101200125,
					"content": "Sau khi kết thân với hắn, có lẽ sẽ moi được thông tin về Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200126
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 101200126,
					"content": "Không hổ danh là đội trưởng Jean! Suy nghĩ thật chu đáo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101200127,
					"content": "Quá khen rồi, đây chỉ là kinh nghiệm tích lũy được qua những lần xử lý vấn đề về ngoại giao thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200128
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 101200128,
					"content": "Quý tộc Lawrence đó tên là Schubert, gần đây hắn thường đi dạo ở phía bắc thành Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200129
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 101200129,
					"content": "Tính cách của người này rất khó gần, nhưng nếu xử sự đúng mực thì chắc sẽ không có vấn đề gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200130,
						101200131
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 101200130,
					"content": "Cứ giao cho tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200132
					]
				},
				{
					"id": 101200132,
					"content": "#Cảm ơn sự hỗ trợ của {F#cô}{M#cậu}. Nếu gặp khó khăn gì thì hãy đến đây nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jean"
				},
				{
					"id": 101200131,
					"content": "Hy vọng mọi việc thuận lợi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200132
					]
				},
				{
					"id": 101200116,
					"content": "Đây không phải là việc trong nội bộ Đội Kỵ Sĩ sao.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200117
					]
				},
				{
					"id": 101200105,
					"content": "Đúng là phong cách của đội trưởng Jean.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200106
					]
				},
				{
					"id": 101200106,
					"content": "Nếu có thể thì tôi cũng muốn hàn huyên thêm vài câu. Nhưng vì an toàn của Thành Mondstadt, tôi vẫn phải đặt công việc lên hàng đầu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200107
					],
					"speakerTitle": "Jean"
				}
			]
		},
		{
			"id": 1012002,
			"completionStepIds": [
				1012003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
