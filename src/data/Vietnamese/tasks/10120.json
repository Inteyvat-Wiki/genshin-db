					"speakerTitle": "Hertha"
				},
				{
					"id": 101200703,
					"content": "Người của nhà Lawrence, đa số đều không chịu chủ động xuất hiện trước mặt Kỵ Sĩ Tây Phong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200704
					],
					"speakerTitle": "Hertha"
				},
				{
					"id": 101200704,
					"content": "Vậy cũng tốt, nếu làm ảnh hưởng đến việc phân phối quân nhu thì lại phiền phức thêm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200705
					],
					"speakerTitle": "Hertha"
				},
				{
					"id": 101200705,
					"content": "Hai người lên trên xem thử đi, không chừng sẽ tìm được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
