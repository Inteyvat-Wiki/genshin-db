			"dialogs": [
				{
					"id": 101200401,
					"content": "Ra tay nhanh quá, chúng đều là mục tiêu mà tôi theo dõi trong thời gian dài.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200402
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 101200402,
					"content": "Vậy lần này công lao đều thuộc về hai người rồi đó, đúng là \"tiên hạ thủ vi cường\"!... Mối thù này, tôi sẽ ghi nhớ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200403
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 101200403,
					"content": "...Hử?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101200404,
					"content": "Đợi đã, ghi thù?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200405
					]
				},
				{
					"id": 101200405,
					"content": "#Đúng vậy, tôi nghe thấy tiếng động lớn nên vội chạy đến, phát hiện {F#cô}{M#cậu} đang chiến đấu với Fatui, lại còn đang chiếm thế thượng phong nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200406
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 101200406,
					"content": "Nếu tôi còn không ra tay thì sẽ không còn lại gì cho tôi mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200407
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 101200407,
					"content": "Nhưng mà, cũng may hai người không bị thương, chiến đấu với nhiều Fatui như vậy là một chuyện rất nguy hiểm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200408,
						101200409
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 101200408,
					"content": "Tôi đã quen chiến đấu với Fatui rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200410
					]
				},
				{
					"id": 101200410,
					"content": "Tuy không hiểu lắm, nhưng cảm ơn cô đã quan tâm đến sự an toàn của chúng tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101200411,
					"content": "Hả? Sao tôi lại quan tâm đến an toàn của kẻ thù chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200412
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 101200412,
					"content": "Nhưng ban nãy cô có nói \"may mà hai người không bị thương\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101200413,
					"content": "Ý tôi là nếu như hai người bị thương thì tôi không những bị tranh công, mà còn phải phụ trách vác hai người về thành nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200414
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 101200414,
					"content": "Như vậy hai người lại gây thêm phiền phức cho tôi! Mối thù này lại càng sâu thêm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200415
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 101200415,
					"content": "Có cả cách giải thích này nữa sao?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101200416,
					"content": "Cô chắc là Eula đúng không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200417
					]
				},
				{
					"id": 101200417,
					"content": "Đúng vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200418
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 101200418,
					"content": "Đúng là cô ấy cũng thật kỳ lạ... Tuy cũng không đến nỗi là không thể giao tiếp được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101200419,
					"content": "Này, bình phẩm người mới gặp là \"kỳ lạ\", khoan hãy bàn đến lễ nghi của quý tộc, đây cũng xem như là sự bất lịch sự trong giao tiếp thường ngày đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200420
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 101200420,
					"content": "Nhưng mà, sao hai người lại biết tên tôi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200421
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 101200421,
					"content": "#{NICKNAME} là Kỵ Sĩ Danh Dự của Đội Kỵ Sĩ Tây Phong, chúng tôi đang muốn điều tra một quý tộc tên là Schubert Lawrence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101200422,
					"content": "Nhưng hắn rất chú trọng lễ nghi, nên hoàn toàn không muốn nói chuyện với chúng tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101200423,
					"content": "Ha ha, tôi hiểu rồi, ông ấy là chú của tôi, tính của ông ấy là thế đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200424
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 101200424,
					"content": "Nhưng mà, sao lại phải điều tra ông ấy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200425
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 101200425,
					"content": "Hắn có vẻ đang có âm mưu với Fatui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200426
					]
				},
				{
					"id": 101200426,
					"content": "Ra là vậy, ha ha, thật to gan, dám đứng trước mặt tôi nói xấu người nhà tôi sao. Thù này tôi sẽ ghi nhớ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200427
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 101200427,
					"content": "Không phải, đây là ủy thác của đội trưởng Jean! Hơn nữa chỉ dừng lại ở việc nghi ngờ mà thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200428,
						101200429
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101200428,
					"content": "Cô không tò mò sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200430
					]
				},
				{
					"id": 101200430,
					"content": "Trong mắt người Mondstadt, nhà Lawrence đều là người xấu, cho nên nếu vì lời đồn nào đó mà bị nghi ngờ thì cũng không có gì lạ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200431
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 101200431,
					"content": "Hừm, cũng có lý, dẫu sao trước đây gây nghiệp quá nên danh tiếng cũng không được tốt cho lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200432
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101200432,
					"content": "Ra là cô cũng nghĩ như thế sao... Vậy mối thù này ghim thêm lần nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200433
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 101200433,
					"content": "Rõ ràng là cô nói vậy trước mà?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200434
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101200434,
					"content": "Ha ha, thú vị lắm, lần đầu gặp mặt đã khiến tôi ghi thù đủ 3 lần, lâu lắm rồi tôi mới gặp người thú vị như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200435,
						101200436
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 101200435,
					"content": "Đây là chuyện \"thú vị\" ư?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200437
					]
				},
				{
					"id": 101200437,
					"content": "Hai người đến đây là để học lễ nghi của nhà Lawrence, như vậy mới có thể nói chuyện được với chú tôi đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200438
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 101200438,
					"content": "Ừm, là Amber giới thiệu chúng tôi đến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200439
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101200439,
					"content": "Không vấn đề gì, tôi có thể dạy cho hai người. Giờ thì cứ quay về Mondstadt đã nhé, phải tìm nơi có người thì mới luyện tập được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200440,
						101200441
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 101200440,
					"content": "Nhưng cô có thù dai không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200442
					]
				},
				{
					"id": 101200442,
					"content": "Hai chuyện khác nhau mà. Nếu đã là ủy thác của Jean và được Amber giới thiệu đến thì tôi cũng phải nể mặt chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Eula"
				},
				{
					"id": 101200441,
					"content": "Cô có nhân cơ hội báo thù không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200442
					]
				},
				{
					"id": 101200436,
					"content": "Sao trông cô vui vậy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200437
					]
				},
				{
					"id": 101200429,
					"content": "Cô không lo lắng sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200430
					]
				},
				{
					"id": 101200409,
					"content": "Tôi rất giỏi chiến đấu mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200410
					]
				}
			]
		},
