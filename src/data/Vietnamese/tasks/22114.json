			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Linling"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221140501,
					"content": "Các bạn kiểm tra xong hết chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140502,
						221140504
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140502,
					"content": "Xong hết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140503
					]
				},
				{
					"id": 221140503,
					"content": "Vậy thì tốt quá, tôi cũng chuẩn bị tương đối rồi, đợi một lát để tôi kiểm kê lại toàn bộ nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140506
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140506,
					"content": "Đúng rồi! Thứ này cho bạn đó, coi như quà cảm ơn, hãy nhận đi nhé. Đợi một lát nữa tôi đi kiểm kê hàng hóa, lần này không được để xảy ra sai sót...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140504,
					"content": "Bạn không có ngồi viết thơ chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140505
					]
				},
				{
					"id": 221140505,
					"content": "Đương nhiên là không rồi! Tôi cũng phải biết đâu là việc quan trọng chứ, hiện giờ không phải thời gian viết thơ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140506
					],
					"speakerTitle": "Linling"
				}
			]
		},
		{
			"id": 2211406,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2211402",
							"2"
						],
						"stepId": 2211402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Linling"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221140601,
					"content": "Huhu... Từ nay về sau không được viết thơ nữa, phải tập trung làm việc mới được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140602,
						221140607,
						221140612
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140602,
					"content": "Công việc vẫn là thứ quan trọng nhất.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140603
					]
				},
				{
					"id": 221140603,
					"content": "Tôi biết rồi. Nhưng từ sáng đến tối, năm này qua năm khác chỉ làm một việc... Sẽ có lúc cảm thấy nhàm chán.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140604
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140604,
					"content": "Hơn nữa những công việc lặt vặt như vậy không có giá trị gì cả, cũng không có ai quản lý, chả mấy chốc lại mất tập trung...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140605
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140605,
					"content": "Haizz, tuy Tiểu An luôn nói những câu như \"mỗi một công việc đều có giá trị quan trọng\", \"mỗi một công việc đều có tính quyết định\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140606
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140606,
					"content": "Thế nhưng nếu đúng như vậy tại sao mọi người vẫn kén cá chọn canh khi tìm việc cơ chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140607,
					"content": "Công việc là phải chịu trách nhiệm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140608
					]
				},
				{
					"id": 221140608,
					"content": "Tôi chỉ đôi khi nhờ bạn giúp mà thôi, còn phần lớn vẫn phải tự giải quyết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140609
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140609,
					"content": "Phụ trách công việc... Tôi đương nhiên là biết. Nhưng nhiều lúc bận rộn lại muốn làm mèo lười, chính vì vậy mới nhờ bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140610
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140610,
					"content": "Nếu thực sự nhàn rỗi sẽ tìm cách nghĩ ra việc để làm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140611
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140611,
					"content": "Trời ơi, nói những thứ này cũng vô ích, vì bạn vẫn chưa đi làm mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140612,
					"content": "Sao bạn lại muốn làm thơ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140613
					]
				},
				{
					"id": 221140613,
					"content": "Sao đột nhiên lại hỏi vấn đề này? Tôi nghĩ là... Bạn cảm thấy con người vì sao phải làm việc?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140614
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140614,
					"content": "Cá nhân tôi cho rằng, nếu \"làm việc chỉ là để làm\" thì thật là vô vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140615
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140615,
					"content": "Nói thế nào nhỉ, con người cần phải có ước mơ phải không? Một \"ước mơ\" hoàn toàn khác biệt so với công việc đầy phức tạp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140616
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140616,
					"content": "Có như vậy, cho dù mệt mỏi, căng thẳng đến mức nào, vẫn có \"ước mơ\" khiến bản thân được thư giãn trong chốc lát.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140617
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140617,
					"content": "Thế nhưng đây chỉ là suy nghĩ của tôi mà thôi, còn những Nhà Mạo Hiểm thì tôi không biết họ nghĩ như thế nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140618
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140618,
					"content": "Xét cho cùng bọn họ sống là vì ước mơ, còn tôi cần một công việc để níu kéo lại bản thân...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140619
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140619,
					"content": "Nhưng mà, haha... Bạn có thể coi tôi như một bài học, \"ước mơ\" vẫn chỉ là \"ước mơ\" còn khi làm việc thì phải thực tế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linling"
				}
			]
		},
