			"dialogs": [
				{
					"id": 221140701,
					"content": "\"Thợ đóng thùng\" như tôi vừa không lành nghề, lại không có vật liệu để dùng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140702,
						221140708
					],
					"speakerTitle": "Tiểu An"
				},
				{
					"id": 221140702,
					"content": "\"Thợ đóng thùng\" là gì vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140703
					]
				},
				{
					"id": 221140703,
					"content": "Ồ, chính là nói nhừng như tôi chuyên làm thùng gỗ, hiện giờ vẫn thiếu một miếng gỗ là có thể hoàn thành thùng gỗ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140704
					],
					"speakerTitle": "Tiểu An"
				},
				{
					"id": 221140704,
					"content": "Nhưng mà miếng gỗ duy nhất mà tôi có chất lượng lại không tốt, nó hơi ngắn. Nếu mà sử dụng sẽ làm cả chiếc thùng mất giá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140705
					],
					"speakerTitle": "Tiểu An"
				},
				{
					"id": 221140705,
					"content": "Nếu đi tìm miếng gỗ mới, không biết bao giờ mới có thể hoàn thành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140706
					],
					"speakerTitle": "Tiểu An"
				},
				{
					"id": 221140706,
					"content": "Ngày giao thùng sắp đến gần rồi. Thôi vậy, méo mó có hơn không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140707
					],
					"speakerTitle": "Tiểu An"
				},
				{
					"id": 221140707,
					"content": "Haizz, trên cõi đời này không biết có bao nhiêu người \"thợ đóng thùng\" gặp khó khăn như tôi nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tiểu An"
				},
				{
					"id": 221140708,
					"content": "Công việc của Linling...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140709
					]
				},
				{
					"id": 221140709,
					"content": "Công việc của cô ấy? Ồ, cô ấy cũng từng nhờ các bạn thông kê thuyền bè phải không? Chuyện này tôi biết hết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140710
					],
					"speakerTitle": "Tiểu An"
				},
				{
					"id": 221140710,
					"content": "Không cần phải ngạc nhiên như vậy, chỉ cần kết quả cuối cùng tốt, tôi sẽ không để ý quá trình đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140711
					],
					"speakerTitle": "Tiểu An"
				},
				{
					"id": 221140711,
					"content": "Hơn nữa, việc trả công cho các bạn là cô ấy tự nguyện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140712
					],
					"speakerTitle": "Tiểu An"
				},
				{
					"id": 221140712,
					"content": "Có điều số liệu không kiểm tra lại, cứ như vậy báo cáo lên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140713
					],
					"speakerTitle": "Tiểu An"
				},
				{
					"id": 221140713,
					"content": "Khiến tôi rất tức giận với thái độ làm việc thiếu trách nhiệm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tiểu An"
				}
			]
		},
