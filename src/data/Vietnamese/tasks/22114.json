			"dialogs": [
				{
					"id": 221140201,
					"content": "Haizz đúng thật là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140202
					],
					"speakerTitle": "Tiểu An"
				},
				{
					"id": 221140202,
					"content": "Về chuyện của Linling...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140203
					]
				},
				{
					"id": 221140203,
					"content": "Hửm? Bạn hỏi chuyện về Linling ư, ồ cô ấy... Nói thế nào nhỉ, cô ấy không thích hợp với công việc này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140204
					],
					"speakerTitle": "Tiểu An"
				},
				{
					"id": 221140204,
					"content": "Nói một cách cụ thể là... Số liệu cô ấy báo cáo lên sai sót quá nhiều,",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140205
					],
					"speakerTitle": "Tiểu An"
				},
				{
					"id": 221140205,
					"content": "Số liệu của tuần này chỉ có một hai ngày là chính xác, cho dù là nhìn sơ cũng còn tính chính xác hơn cô ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140206
					],
					"speakerTitle": "Tiểu An"
				},
				{
					"id": 221140206,
					"content": "Thái độ làm việc như vậy tôi làm sao có thể an tâm giao việc cho cô ấy được chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140207
					],
					"speakerTitle": "Tiểu An"
				},
				{
					"id": 221140207,
					"content": "Chỉ là việc đếm thuyền...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140208
					]
				},
				{
					"id": 221140208,
					"content": "Khi làm việc, cho dù là bất kể việc gì đi chăng nữa cũng không được thêm hai từ \"chỉ là\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140209
					],
					"speakerTitle": "Tiểu An"
				},
				{
					"id": 221140209,
					"content": "Chỉ cần một miếng gỗ ngắn hơn bình thường một chút sẽ hạ thấp chất lượng của cả thùng gỗ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140210
					],
					"speakerTitle": "Tiểu An"
				},
				{
					"id": 221140210,
					"content": "Công việc cũng giống như vậy, chỉ cần một phút lơ đãng sẽ làm hỏng toàn bộ quá trình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140211
					],
					"speakerTitle": "Tiểu An"
				},
				{
					"id": 221140211,
					"content": "Trong việc thống kê tàu bè, nếu số lượng đếm không đúng, các công việc sau đó cũng không thể chuẩn xác được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140212
					],
					"speakerTitle": "Tiểu An"
				},
				{
					"id": 221140212,
					"content": "Công việc mà không chuẩn xác chắc chắn sẽ kéo theo hậu quả nặng nề. Cho dù có được sửa chữa kịp thời, cũng lãng phí rất nhiều thời gian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140213
					],
					"speakerTitle": "Tiểu An"
				},
				{
					"id": 221140213,
					"content": "Nói như vậy, các bạn đã hiểu chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140214,
						221140219
					],
					"speakerTitle": "Tiểu An"
				},
				{
					"id": 221140214,
					"content": "Tôi hiểu rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140215
					]
				},
				{
					"id": 221140215,
					"content": "...Có điều hiện tại bến cảng đang thiếu người, việc đuổi việc... Chắc sẽ không xảy ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140216
					],
					"speakerTitle": "Tiểu An"
				},
				{
					"id": 221140216,
					"content": "Nói thế nào nhỉ... Có \"một miếng gỗ ngắn\" vẫn tốt hơn nhiều việc \"thiếu một cái thùng gỗ\" phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140217
					],
					"speakerTitle": "Tiểu An"
				},
				{
					"id": 221140217,
					"content": "Người phụ trách kiểm kê hàng hóa có việc bận đột xuất không thể đến được, các bạn về nói với Linling đến đây giúp việc đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140218
					],
					"speakerTitle": "Tiểu An"
				},
				{
					"id": 221140218,
					"content": "Nếu công việc này không gây ra vấn đề gì lớn, đợi cho đến khi người phụ trách quay lại, cô ấy có thể tiếp tục thống kê thuyền bè rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140224
					],
					"speakerTitle": "Tiểu An"
				},
				{
					"id": 221140224,
					"content": "Ừm... Lần này xem như là \"bài thử thách\" đi, cũng cho cô ấy một cơ hội.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140225
					],
					"speakerTitle": "Tiểu An"
				},
				{
					"id": 221140225,
					"content": "Đưa cho Linling và bảo cô ấy kiểm kê theo hóa đơn hàng, sau khi làm xong nhớ ghi chú ở mặt phía sau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140226
					],
					"speakerTitle": "Tiểu An"
				},
				{
					"id": 221140226,
					"content": "Còn nữa, các bạn chuyển lời đến Linling, bảo cô ấy phải trấn tĩnh lại, nếu còn xuất hiện sai sót sẽ không có cơ hội lần thứ hai đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tiểu An"
				},
				{
					"id": 221140219,
					"content": "Tôi sẽ nói với Linling...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140220
					]
				},
				{
					"id": 221140220,
					"content": "Các bạn trở về nói gì? Đuổi việc? Không đâu, tạm thời không đuổi việc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140221
					],
					"speakerTitle": "Tiểu An"
				},
				{
					"id": 221140221,
					"content": "Hiện tại bến cảng đang thiếu người, nói thế nào nhỉ... Có \"một miếng gỗ ngắn\" vẫn tốt hơn nhiều việc \"thiếu một cái thùng gỗ\" phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140222
					],
					"speakerTitle": "Tiểu An"
				},
				{
					"id": 221140222,
					"content": "Người phụ trách kiểm kê hàng hóa có việc bận đột xuất không thể đến được, các bạn về nói với Linling đến đây giúp việc đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140223
					],
					"speakerTitle": "Tiểu An"
