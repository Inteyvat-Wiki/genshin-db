				},
				{
					"id": 221140302,
					"content": "Tiểu An sẽ cho bạn một cơ hội.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140303
					]
				},
				{
					"id": 221140303,
					"content": "Thật sao?! Vậy thì tốt quá, quá tốt rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140304
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140304,
					"content": "Í? Kiểm kê hàng hóa sao? Thôi xong rồi, tôi chưa làm qua bao giờ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140305
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140305,
					"content": "Nếu lại làm sai tôi chắc chắn sẽ đi đời, không được, phải chuẩn bị kỹ càng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140306
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140306,
					"content": "Phải đọc lại những quy tắc trong việc kiểm kê hàng hóa... Và những mẫu viết tiêu chuẩn nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140307
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140307,
					"content": "Bạn có thể xác nhận giúp tôi số lượng hàng không? Xem số lượng hàng có đúng và đủ như hóa đơn này không là được, sau khi làm xong tôi sẽ kiểm tra cẩn thận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140308,
						221140311
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140308,
					"content": "Tôi biết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140309
					]
				},
				{
					"id": 221140309,
					"content": "Nhờ cả vào bạn đó! Tôi sẽ ở đây làm công tác chuẩn bị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140310
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140310,
					"content": "Lần này không được để xảy ra sai sót...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140311,
					"content": "Giao cho chúng tôi đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140312
					]
				},
				{
					"id": 221140312,
					"content": "Không được. Kiểm kê hàng hóa còn phức tạp hơn cả thống kê tàu bè, phải đích thân tôi xử lý mới được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140313
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140313,
					"content": "Cho nên nhờ các bạn kiểm tra số lượng hàng hóa trước nhé, tôi lát nữa sẽ kiểm kê cụ thể sau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linling"
				}
			]
		},
		{
			"id": 2211405,
			"completionStepIds": [
				2211405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
