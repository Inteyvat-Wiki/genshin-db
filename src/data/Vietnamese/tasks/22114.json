			},
			"dialogs": [
				{
					"id": 221140101,
					"content": "Xong rồi, lần này xong rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140102
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140102,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140103
					]
				},
				{
					"id": 221140103,
					"content": "Huhu... Tiểu An nói tôi không phù hợp với công việc này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140104
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140104,
					"content": "Như vậy là bị đuổi việc rồi sao? Phải làm thế nào đây, huhu... Rõ ràng là tôi ngày nào cũng làm việc cẩn thận...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140105,
						221140111
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140105,
					"content": "Tại sao đột ngột lại...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140106
					]
				},
				{
					"id": 221140106,
					"content": "Này... Trước kia tôi từng nhờ bạn... Đếm thuyền hộ tôi phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140107
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140107,
					"content": "Vì quá tin tưởng vào năng lực của bạn, tôi không kiểm tra lại mà sử dụng luôn số liệu đó báo cáo lên trên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140108
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140108,
					"content": "Kết quả là rất nhiều số liệu bị sai... Tiểu An nổi cơn lôi đình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140109
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140109,
					"content": "Bạn có thể đi nói với Tiểu An giúp tôi được không? Tôi, tôi về sau nhất định làm việc chăm chỉ! Tôi sẽ cố gắng không nhờ bạn nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140110
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140110,
					"content": "Nhưng mà tôi không dám đi hỏi anh ấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140111,
					"content": "Là vì việc thống kê thuyền lần trước có sai sót?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140112
					]
				},
				{
					"id": 221140112,
					"content": "Đúng vậy, trước kia tôi từng nhờ bạn đếm thuyền hộ tôi phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140113
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140113,
					"content": "Vì quá tin tưởng vào năng lực của bạn, tôi không kiểm tra lại mà sử dụng luôn số liệu đó báo cáo lên trên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140114
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140114,
					"content": "Nhưng tôi cũng chỉ thi thoảng nhờ bạn thôi, còn lại phần lớn là tôi tự làm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140115
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140115,
					"content": "Hai bên lẫn lộn, sai ở đâu cũng không biết, Tiểu An nổi cơn lôi đình...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140116
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140116,
					"content": "Bạn có thể đi nói với Tiểu An giúp tôi được không? Tôi, tôi về sau nhất định làm việc chăm chỉ! Tôi sẽ cố gắng không nhờ bạn nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140117
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140117,
					"content": "Nhưng mà tôi không dám đi hỏi anh ấy...",
					"roleType": "TALK_ROLE_NPC",
