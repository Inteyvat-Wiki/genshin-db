				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Salsa",
					"Ubu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740230101,
					"content": "Phù, như vậy nhìn vừa mắt hơn nhiều. Dù Salsa nhìn thấy cũng sẽ tự hào về chúng ta, đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740230102,
					"content": "Cướp! Có cướp... Ban ngày ban mặt mà có cướp đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230103
					],
					"speakerTitle": "Ubu"
				},
				{
					"id": 740230103,
					"content": "Cái gì! Cướp ở đâu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740230104,
					"content": "Đang nói hai người đó! Không chỉ phá hoại tác phẩm của tôi, mà còn lấy đi rương báu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230105,
						740230107
					],
					"speakerTitle": "Ubu"
				},
				{
					"id": 740230105,
					"content": "Thì ra đúng là người của hiệp hội làm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230106
					]
				},
				{
					"id": 740230106,
					"content": "Tôi làm gì? Phải hỏi hai người đã làm gì mới đúng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230109
					],
					"speakerTitle": "Ubu"
				},
				{
					"id": 740230109,
					"content": "Vậy là, những thứ xấu xí này là kiệt tác của anh sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740230110,
					"content": "Thật thô lỗ, cái gì gọi là thứ xấu xí chứ? Hai người không biết gì về nghệ thuật sắp đặt sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230111
					],
					"speakerTitle": "Ubu"
				},
				{
					"id": 740230111,
					"content": "Có vẻ như nền giáo dục thẩm mỹ của Fontaine vẫn còn một chặng đường dài... À mà hai người nhìn không giống người Fontaine nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230112
					],
					"speakerTitle": "Ubu"
				},
				{
					"id": 740230112,
					"content": "#Chúng tôi không phải người Fontaine. Tôi là Paimon, còn đây là {NICKNAME}, cũng là thành viên của Hiệp Hội Nhà Mạo Hiểm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230113,
						740230115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740230113,
					"content": "Là thành viên của tổ chức tà ác.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230114
					]
				},
				{
					"id": 740230114,
					"content": "Đúng vậy, nhưng không mặc đồng phục. Vì vậy không phải là kẻ áo xanh tà ác, thật tốt quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740230117,
					"content": "Tôi tên Ubu, là nhà mạo hiểm kiêm nghệ sĩ sắp đặt. Nhìn cách hai người nói chuyện chắc là thường ngày cũng hành sự lỗ mãng như vậy... Chuyện lần này coi như bỏ qua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230118
					],
					"speakerTitle": "Ubu"
				},
				{
					"id": 740230118,
					"content": "Hả? Thật ra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740230119,
					"content": "Thế nào? Nếu muốn nói cảm ơn gì đó thì tranh thủ đi, tôi còn phải đi khôi phục tác phẩm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230120
					],
					"speakerTitle": "Ubu"
				},
				{
					"id": 740230120,
					"content": "Cảm ơn thì không có, nhưng tôi đang rất tức giận đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230121
					],
					"speakerTitle": "Salsa"
				},
				{
					"id": 740230121,
					"content": "Salsa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740230122,
					"content": "Có Salsa ở đây, Paimon không cần phải sợ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230123
					],
					"speakerTitle": "Salsa"
				},
				{
					"id": 740230123,
					"content": "Kẻ áo xanh tà ác, bẫy ngươi đặt đã bị bọn ta phá hủy hết rồi! Hãy từ bỏ ý đồ dùng bẫy tà ác để hủy diệt Fontaine xinh đẹp này đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230124
					],
					"speakerTitle": "Salsa"
				},
				{
					"id": 740230124,
					"content": "Ý đồ cái gì? Khoan đã, phá hủy hết... Các người đã phá hủy hết tác phẩm nghệ thuật của tôi rồi sao?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230125
					],
					"speakerTitle": "Ubu"
				},
				{
					"id": 740230125,
					"content": "Cũng không phải phá hủy gì, chỉ là sắp xếp lại một chút, để chúng trông hài hòa với khung cảnh xung quanh thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740230126,
					"content": "Các người... Những kẻ tầm thường thì biết gì về nghệ thuật chứ! Nghệ thuật sắp đặt của tôi, tác phẩm của tôi... đều đã trở thành những thứ tầm thường như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230127
					],
					"speakerTitle": "Ubu"
				},
				{
					"id": 740230127,
					"content": "Nhưng những thứ đó có thể gọi là nghệ thuật sao? Mặc dù tôi không hiểu cho lắm, nhưng khiến người xem thấy khó chịu thì sao được gọi là nghệ thuật nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740230128,
					"content": "Tất nhiên rồi, ranh giới của nghệ thuật là do nghệ sĩ quyết định. Tác phẩm của họ tất nhiên cũng sẽ được gọi là nghệ thuật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230129
					],
					"speakerTitle": "Ubu"
				},
				{
					"id": 740230129,
					"content": "Ai là nghệ sĩ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230130
					],
					"speakerTitle": "Salsa"
				},
				{
					"id": 740230130,
					"content": "Tất nhiên là tôi rồi, nghệ sĩ sắp đặt vĩ đại, Ubu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230131
					],
					"speakerTitle": "Ubu"
				},
				{
					"id": 740230131,
					"content": "Nếu vậy, với tư cách là người sáng lập \"liên minh nghệ sĩ đánh đổ tổ chức tà ác, bảo vệ tương lai Fontaine\", tôi phủ nhận đó là nghệ thuật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230132
					],
					"speakerTitle": "Salsa"
				},
				{
					"id": 740230132,
					"content": "Đánh... đánh đổ cái gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230133,
						740230135
					],
					"speakerTitle": "Ubu"
				},
				{
					"id": 740230133,
					"content": "Đánh đổ tổ chức tà ác.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230134
					]
				},
				{
					"id": 740230134,
					"content": "Thường là để chỉ những người dùng nghệ thuật sắp đặt để phá hủy phong cảnh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740230136,
					"content": "Đùa cái gì vậy, tôi chưa từng nghe nói tới liên minh đánh đổ gì đó. Cô bé này dựa vào đâu mà nói tác phẩm của tôi không phải nghệ thuật chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230137
					],
					"speakerTitle": "Ubu"
				},
				{
					"id": 740230137,
					"content": "Bởi vì tôi là họa sĩ, nên cũng được xem là một nghệ sĩ, tất nhiên là tôi có tư cách rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230138
					],
					"speakerTitle": "Salsa"
				},
				{
					"id": 740230138,
					"content": "Hả? Cô bé à, nghệ sĩ không phải là trò trẻ con, không phải muốn làm là có thể làm. Phải có tác phẩm, phải được mọi người công nhận...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230139
					],
					"speakerTitle": "Ubu"
				},
				{
					"id": 740230139,
					"content": "Vậy thì anh lấy đâu ra tư cách chứ? Tác phẩm của anh chính là... những cái bẫy tà ác đó sao? Có ai công nhận nó không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230140
					],
					"speakerTitle": "Salsa"
				},
				{
					"id": 740230140,
					"content": "Đó là vì có quá nhiều kẻ tầm thường, không thể hiểu được sự tinh tế. Nghệ thuật chân chính luôn là thứ mà ít người cảm nhận được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230141,
						740230143
					],
					"speakerTitle": "Ubu"
				},
				{
					"id": 740230141,
					"content": "Hãy bắt đầu với nghệ thuật mà mọi người có thể hiểu được đã.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230142
					]
				},
				{
					"id": 740230142,
					"content": "Đúng vậy, nếu không có ai hiểu, thì cơ bản là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740230145,
					"content": "Không... Sao có thể chứ! Tác phẩm của tôi rất hoàn hảo, không thể có vấn đề được. Chỉ là các người không hiểu mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230146
					],
					"speakerTitle": "Ubu"
				},
				{
					"id": 740230146,
					"content": "Đáng ghét, tôi sẽ không từ bỏ đâu, cứ chờ xem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230147
					],
					"speakerTitle": "Ubu"
				},
				{
					"id": 740230147,
					"content": "Ubu lảo đảo rời đi...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740230148
					]
				},
				{
					"id": 740230148,
					"content": "Đúng là một kẻ thù ngoan cố, nhưng tôi cũng sẽ không dễ dàng từ bỏ. Dù sao tương lai của nghệ thuật Fontaine cũng phụ thuộc vào tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230149
					],
					"speakerTitle": "Salsa"
				},
				{
					"id": 740230149,
					"content": "Ai cũng có sự nghiệp để phấn đấu cả.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230150
					]
				},
				{
					"id": 740230150,
					"content": "Đây có phải là chuyện tốt không? Chắc là phải nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740230143,
					"content": "Cũng tức là không một ai hiểu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230144
					]
				},
				{
					"id": 740230144,
					"content": "Nghe có vẻ như là một sự thất bại nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740230135,
					"content": "Bây giờ xem ra là muốn lật đổ anh đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230136
					]
				},
				{
					"id": 740230115,
					"content": "Xin chào đồng đội.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230116
					]
				},
				{
					"id": 740230116,
					"content": "Đến tên cũng không biết thì không thể gọi là đồng đội được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740230107,
					"content": "Ôi, là kẻ áo xanh tà ác!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230108
					]
				},
				{
					"id": 740230108,
					"content": "Ơ, ăn cướp mà còn nói năng kỳ lạ, hôm nay là ngày gì vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230109
					],
					"speakerTitle": "Ubu"
				}
			]
		},
		{
			"id": 7402302,
			"completionStepIds": [
				7402304
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7402304",
							"2"
						],
						"stepId": 7402304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 740230201,
					"content": "Hmm... Đồ vật ở đây trông có vẻ hơi chướng mắt... Có vẻ giống những thứ xấu xí trước đây từng gặp...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230202
					],
					"speakerTitle": "Paimon"
				},
