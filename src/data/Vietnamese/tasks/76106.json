			},
			"dialogs": [
				{
					"id": 761060401,
					"content": "Fatui mà bản lĩnh chỉ đến thế thôi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761060402
					]
				},
				{
					"id": 761060402,
					"content": "#Người mới bây giờ sao toàn nói chuyện khó nghe thế nhỉ...? Khoan đã, nhìn kỹ thì {F#cô}{M#cậu} không giống người mới được tuyển vào lần này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761060403
					],
					"speakerTitle": "Veroslava"
				},
				{
					"id": 761060403,
					"content": "Còn định nói dối để trà trộn vào đây sao? Bị nhìn thấu rồi nhé! Mau bắt lấy chúng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Veroslava"
				}
			]
		},
		{
			"id": 7610605,
