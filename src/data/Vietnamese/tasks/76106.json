			"dialogs": [
				{
					"id": 761060101,
					"content": "#Hmm? Trông {F#cô}{M#cậu} có vẻ lạ mặt, là người mới à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
