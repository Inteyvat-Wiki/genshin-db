			},
			"dialogs": [
				{
					"id": 761060501,
					"content": "Lần đầu gặp mặt, tôi chính là đối thủ cũ không đội trời chung của các người đây!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761060502
					]
				},
				{
					"id": 761060502,
					"content": "Đáng ghét, không ngờ lại bị kẻ địch tập kích... Tất cả xông lên!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
