				"objectNames": [
					"Veroslava"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761060201,
					"content": "...Ừm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761060202
					]
				},
				{
					"id": 761060202,
					"content": "#Tôi nói thế là vì muốn tốt cho {F#cô}{M#cậu} đấy. Không có việc gì thì đừng đến chỗ cục thiết kế nhé, đặc biệt là tầng hai! Nếu hấp thụ quá nhiều Kuuvahki... nhẹ thì đau đầu, nặng thì nôn mửa. Đừng bảo là tôi chưa cảnh báo nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Veroslava"
				}
			]
		},
		{
			"id": 7610603,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Veroslava"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761060301,
					"content": "Thật sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761060302
					]
				},
				{
					"id": 761060302,
					"content": "Đương nhiên rồi! Bất kỳ ai làm việc trong đó đều sẽ được phát thêm một ly rượu táo. Thử nghĩ xem, nếu không có hại cho cơ thể thì làm gì có chuyện tốt như vậy chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761060303
					],
					"speakerTitle": "Veroslava"
				},
				{
					"id": 761060303,
					"content": "Hơn nữa, trước đây tôi đã tận mắt chứng kiến ở chỗ Dòng Dõi Sương Nguyệt! Trên đầu những chấp tế của họ đều mọc sừng, thử nói xem có bình thường không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761060304
					],
					"speakerTitle": "Veroslava"
				},
				{
					"id": 761060304,
					"content": "Ra là vậy... Cảm ơn đã nhắc nhở.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761060305
					]
				},
				{
					"id": 761060305,
					"content": "Nghe thật đáng sợ quá! Liệu... liệu có biến thành quái vật không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761060306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761060306,
					"content": "#Haiz, toàn giao cho người mới vào làm mấy việc nguy hiểm... {F#Cô}{M#Cậu} phải cẩn thận đấy, đừng ở trong đó quá lâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Veroslava"
				}
			]
		},
		{
			"id": 7610604,
			"completionStepIds": [
				7610601
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
