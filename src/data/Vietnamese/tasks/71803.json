						718030512
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 718030512,
					"content": "Nhưng uỷ thác tìm mèo kia... người uỷ thác hình như đã chuyển nhà rồi, liên lạc với họ chắc cũng cần chút thời gian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030513
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 718030513,
					"content": "Trước khi người uỷ thác qua đây, nhóc con này do tôi chăm sóc tạm vậy.",
