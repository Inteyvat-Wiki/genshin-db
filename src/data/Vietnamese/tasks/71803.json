			"dialogs": [
				{
					"id": 718030301,
					"content": "Meo..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030302
					],
					"speakerTitle": "Ash"
				},
				{
					"id": 718030302,
					"content": "Í? Sao lại có mèo con ở đây, lẽ nào tiếng kêu ban nãy là của nó?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030303,
					"content": "Meo... meo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030304,
						718030308
					],
					"speakerTitle": "Ash"
				},
				{
					"id": 718030304,
					"content": "Mèo con màu xám...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030305
					]
				},
				{
					"id": 718030305,
					"content": "Mèo con màu xám... đi lạc bên ngoài...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030306,
					"content": "A! Trước kia Lan nhắc đến một uỷ thác tìm mèo... lẽ nào nó chính là con mèo đó? Hình như tên Ash...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030307,
					"content": "Không ngờ lại tìm thấy nó ở đây... lẽ nào nó trốn gần đây suốt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030311,
					"content": "Vì có Vua Mũ Đá Hilichurl ở đây nên không ai dám qua tìm nó... nó cũng không dám ra ngoài, đành trốn ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030312,
					"content": "May mà chúng ta đến, nếu không chẳng biết nó còn phải ở đây đến bao giờ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030313,
					"content": "Meo... meo meo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030314,
						718030317
					],
					"speakerTitle": "Ash"
				},
				{
					"id": 718030314,
					"content": "Meo... meo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030315
					]
				},
				{
					"id": 718030315,
					"content": "Ấy, bạn đang làm gì thế, như vậy nó cũng không hiểu nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030316,
					"content": "Chúng ta đem nó về cho Lan là được, bảo cô ấy trả Ash cho người uỷ thác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030319,
					"content": "Meo...Meo! Meo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030320,
						718030322
					],
					"speakerTitle": "Ash"
				},
				{
					"id": 718030320,
					"content": "Meo...Meo! Meo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030321
					]
				},
				{
					"id": 718030321,
					"content": "Bạn có bắt chước nó thì nó cũng không nghe hiểu! Chúng ta mau đưa nó về đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030322,
					"content": "Hình như nó cũng trả lời rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030323
					]
				},
				{
					"id": 718030323,
					"content": "Sao bạn nghe hiểu được... Bỏ đi, chúng ta mau đưa nó về đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030317,
					"content": "Mang nó về cho Lan đi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030318
					]
				},
				{
					"id": 718030318,
					"content": "Ừm, cũng chỉ có thể làm vậy. Mang Ash về cho Lan, bảo Lan trả cho người uỷ thác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030319
					],
					"speakerTitle": "Paimon"
				},
				{
