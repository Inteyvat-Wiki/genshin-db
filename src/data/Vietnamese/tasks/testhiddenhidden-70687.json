				]
			},
			"dialogs": [
				{
					"id": 706870101,
					"content": "Quý khách, mời qua bên này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706870102
					],
					"speakerTitle": "Sói Nhỏ"
				},
				{
					"id": 706870102,
					"content": "Bạn của tiểu thư ma nữ, cũng là tiểu thư ma nữ biết bói toán đã mang đến cho hai vị một món quà mới!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706870103
					],
					"speakerTitle": "Sói Nhỏ"
				},
				{
					"id": 706870103,
					"content": "Woa, quả cầu pha lê đẹp quá! Hơn nữa trông có vẻ đắt tiền, bán cho Margaret biết đâu có thể bán được mười triệu, không, là hai mươi triệu Mora đấy nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706870104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706870104,
					"content": "Khụ... Đùa thôi mà. Vậy, cái này dùng để làm gì thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706870105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706870105,
					"content": "Tiểu thư ma nữ biết bói toán nói: \"Đã là ma nữ thì phải có quả cầu thủy tinh cho ra hồn mới được\". Có nó, khách khứa biết đâu sẽ thấy được sân khấu siêu lợi hại mà trước đây chưa từng thấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706870106
					],
					"speakerTitle": "Sói Nhỏ"
				},
				{
					"id": 706870106,
					"content": "Tôi cũng không rõ ý nghĩa lắm, dù sao tôi cũng chỉ là một nhân viên lễ tân bình thường, có nhìn chằm chằm vào quả cầu cũng chỉ thấy được bộ dạng của mình thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706870107
					],
					"speakerTitle": "Sói Nhỏ"
				},
				{
					"id": 706870107,
					"content": "A, đúng rồi, cái hộp này cũng là quà mà tiểu thư ma nữ tặng cho hai vị đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706870108
					],
					"speakerTitle": "Sói Nhỏ"
				},
				{
					"id": 706870108,
					"content": "\"Nếu có thể đứng trên sân khấu bí ẩn và cống hiến cho khán giả một màn trình diễn đặc sắc, thì sẽ tìm thấy vật phẩm quý giá được cất trong chiếc hộp này\"... Cô ấy nói như vậy đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706870109
					],
					"speakerTitle": "Sói Nhỏ"
				},
				{
					"id": 706870109,
					"content": "Vật, vật phẩm quý giá?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706870110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706870110,
					"content": "Nếu nhân viên lễ tân mà nói quá nhiều thì sẽ phá hỏng sự bí ẩn của câu chuyện. Vậy thì, xin mời hai vị dũng cảm tiến về phía sân khấu mới như thường lệ nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sói Nhỏ"
				}
			]
		}
	]
}