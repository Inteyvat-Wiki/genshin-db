				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ooshima Junpei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722140401,
					"content": "Ồ chất lượng của Thịt Rừng này... thật cảm ơn các bạn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140402
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140402,
					"content": "Chốc nữa tôi sẽ làm vài món! Ăn mấy phần thịt này rồi, chắc chắn tôi sẽ có thể tạc nhanh hơn nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140403
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140403,
					"content": "Hai việc này có liên quan đến nhau sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140404
					]
				},
				{
					"id": 722140404,
					"content": "Ăn được thịt ngon thì mới có sức làm việc chứ! Trước đó cứ ăn cá, tôi cảm thấy chẳng còn sức lực để cầm đục nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140405
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140405,
					"content": "Tôi còn đang lo lắng nếu cứ như vậy, không chừng sẽ kéo dài thời gian điêu khắc... Cũng may bạn đã tìm được thịt giúp tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140406
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140406,
					"content": "Dù sao thì làm việc cho người... à cho mèo, mấy việc như trì hoãn thì tránh được thì nên tránh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140407
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140407,
					"content": "Tóm lại tôi sẽ mau chóng làm xong bức tượng này, ngài Guuji Đại Diện nói sau khi làm xong bức tượng này, nhất định sẽ có chuyện tốt xảy ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140408
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140408,
					"content": "Tuy rằng không biết là chuyện tốt gì, nhưng... tôi cũng rất là mong đợi đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140409
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140409,
					"content": "Một khoảng thời gian sau, các bạn nhớ đến đền thần xem tác phẩm của tôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ooshima Junpei"
				}
			]
		}
	]
}