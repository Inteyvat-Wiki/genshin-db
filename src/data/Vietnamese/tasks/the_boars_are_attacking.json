			},
			"dialogs": [
				{
					"id": 4680201,
					"content": "Có thể giúp được gì không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4680202
					]
				},
				{
					"id": 4680202,
					"content": "Đây là...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680203
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680203,
					"content": "...Là Nhà Lữ Hành à, quả thật là người nhiệt tình!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680204
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680204,
					"content": "Hiện nay là thời điểm quan trọng để nho sinh trưởng, nhưng không biết heo rừng từ đâu đến, đi thành đàn, nhìn ngó địa bàn này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680205
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680205,
					"content": "Một mình ông không đuổi đi được, con trai hiện lại không có ở nhà, chỉ có thể nhìn chúng nó hoành hành ở đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680206
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680206,
					"content": "Nếu cháu có thể dạy dỗ bọn heo rừng này, ông nhất định sẽ tạ ơn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tunner"
				}
			]
		},
		{
			"id": 46803,
