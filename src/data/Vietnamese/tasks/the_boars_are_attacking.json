					"content": "Cháu còn có việc...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4680302
					]
				},
				{
					"id": 4680302,
					"content": "Vậy sao, vậy ông chỉ có thể đợi con trai nghỉ lễ quay lại rồi dạy dỗ bọn này sau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tunner"
				}
			]
		},
		{
			"id": 46804,
			"completionStepIds": [],
