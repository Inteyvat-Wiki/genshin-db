					"Tunner"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4680401,
					"content": "Chào quý khách, con trai ông có nhắn gửi gì cho cháu không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680601,
						4680701,
						4680801
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680601,
					"content": "Bạn là?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4680602
					]
				},
				{
					"id": 4680602,
					"content": "Ông sao? Mấy đứa trong tửu trang đều gọi ông là Tunner, là nông dân của Tửu Trang Dawn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680603
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680603,
					"content": "Tổ tông nhà ông đều cày ở cánh đồng này, nếu cháu nếm được rượu nho nào ngon ở đây, ông dám cá có 8, 9 phần là được ủ bằng nho ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680604
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680604,
					"content": "Cho nên những đời ông chủ ở tửu trang này đều đối xử với mọi người rất tốt, không để thiếu ăn thiếu mặc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680605
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680605,
					"content": "Nhưng nghĩ tới việc con cháu cũng làm nông cả đời, hình như cũng không phải việc gì tốt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680601,
						4680701,
						4680801
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680701,
					"content": "Con trai ông?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4680702
					]
				},
				{
					"id": 4680702,
					"content": "Guy! Nó tên Guy, con trai yêu quý của ông!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680703
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680703,
					"content": "Sao cơ! Cháu chưa từng nghe nói cái tên này? Haha, không sao, cháu sớm muộn cũng biết nó, toàn Mondstadt đều sẽ biết đến nó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680704
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680704,
					"content": "Nó sẽ trở thành Kỵ Sĩ Tây Phong ưu tú nhất Mondstadt, nó nói với ông như vậy, ông đương nhiên là tin tưởng con trai ông.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680705
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680705,
					"content": "Í, nghĩ đến nó lúc nhỏ, vì để nó không phải làm nông cả đời như ông, ông đã đặt hết tâm huyết vào nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680706
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680706,
					"content": "Tên nhóc này cũng rất giỏi, 16 tuổi đã làm kỵ sĩ tập sự, nhà ông phải đợi nó đổi đời...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680601,
						4680701,
						4680801
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680801,
					"content": "Tạm biệt",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4680802
					]
				},
				{
					"id": 4680802,
					"content": "Tạm biệt, nếu gặp Guy con ông, hãy nói với nó, kêu nó rảnh hãy về thăm nhà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tunner"
				}
			]
		},
