			"dialogs": [
				{
					"id": 190361901,
					"content": "Ủa? Không phải bạn đang đi tìm tên nhóc Shikanoin đó sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361902
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361902,
					"content": "Điều tra? Sao tôi lại phải đi điều tra mấy chuyện vớ vẩn của hắn chứ. Hừ! Chỉ là tôi ở trong thành chán quá nên muốn ra ngoài đi dạo thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361903
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361903,
					"content": "Được rồi, cứ kệ tôi, lo việc của mình đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
