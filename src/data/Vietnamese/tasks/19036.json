			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ryuuji",
					"Sango"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190361401,
					"content": "Nếu như Nhà Lữ Hành kia không rảnh, vậy phải làm sao đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361402
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361402,
					"content": "Đó là vấn đề của anh, ai bảo anh tự ý nhận mấy chuyện phiền phức thế này chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361403
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361403,
					"content": "Ái chà, anh may mắn thật đấy, vị cứu tinh của anh tới rồi kìa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361404
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361404,
					"content": "Sao? Tốt quá rồi! Nhà Lữ Hành, bạn tới rồi à.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361405
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361405,
					"content": "Đừng lo, tôi rất rảnh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361406
					]
				},
				{
					"id": 190361406,
					"content": "Đây chính là vừa nhắc người rảnh rỗi là người rảnh rỗi tới ngay đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361407
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361407,
					"content": "Hội trưởng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361408
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361408,
					"content": "Hội trưởng mới là người rảnh rỗi hơn Nhà Lữ Hành đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361409
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361409,
					"content": "Không nhé, tôi bận lắm. Tôi bận đứng đây... cả ngày đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361410
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361410,
					"content": "Cho dù đó là ủy thác không muốn nhận đi nữa thì lý do của hội trưởng cũng tùy tiện quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361411
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361411,
					"content": "Ủy thác không muốn nhận?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361412
					]
				},
				{
					"id": 190361412,
					"content": "Đúng vậy... Đó là lý do tại sao tôi làm phiền bạn, để tôi giải thích cụ thể.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361413
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361413,
					"content": "Gần đây, một người quan trọng trong Hiệp Hội Tenryou đã mất tích, cũng không có cách nào để liên lạc được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361414
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361414,
					"content": "Vì đủ thứ lý do khác nhau nên Hiệp Hội Tenryou không tiện truy tìm công khai, nên đành lén lút ủy thác cho chúng tôi tìm kiếm người này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361415
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361415,
					"content": "Tên người này là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361416
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361416,
					"content": "Kujou Sara, vị đại tướng này đã mất tích.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361417
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361417,
					"content": "...Nếu vị đại tướng đó thật sự mất tích thì chắc Hiệp Hội Tenryou đã lật tung cả Inazuma lên rồi đó hội trưởng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361418
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361418,
					"content": "Nhà Lữ Hành, bạn đừng nghe hội trưởng nói bậy. Thật ra người mất tích có tên là Shikanoin Heizou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361419
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361419,
					"content": "Cậu ta là thám tử đặc biệt của hiệp hội, tuy cấp bậc chỉ là lính tuần tra, nhưng lại rất giỏi, rất được hiệp hội coi trọng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361420
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361420,
					"content": "Hả? Còn giỏi hơn tôi à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361421
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361421,
					"content": "Hội trưởng, cô không muốn giúp cũng được, ít nhất cũng đừng làm phiền người ta chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361422
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361422,
					"content": "Xin lỗi nhé Nhà Lữ Hành, tuy rằng tôi đã nhận ủy thác này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361423
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361423,
					"content": "Nhưng bạn cũng thấy rồi đấy, hội trưởng... cô ấy không muốn dính líu đến chuyện này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361424,
						190361425
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361424,
					"content": "Do thù lao quá ít sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361426
					]
				},
				{
					"id": 190361426,
					"content": "Đoán sai! 0 điểm về chỗ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361427
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361427,
					"content": "Nếu muốn biết lý do thì để tôi nói, tôi sẽ không bao giờ quan tâm tới chuyện của tên nhóc đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361428
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361428,
					"content": "Còn điều gì hạnh phúc hơn việc \"Shikanoin mất tích\" chứ... có thì chỉ có thể là \"Shikanoin mất tích một trăm năm\" thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361429
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361429,
					"content": "E hèm... Tóm lại là hội trưởng Sango có chút mâu thuẫn với Heizou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361430
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361430,
					"content": "Tôi hiểu rồi... làm cùng nghề thì khó tránh khỏi xích mích.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361431
					]
				},
				{
					"id": 190361431,
					"content": "E hèm... bạn hiểu lầm rồi, có lẽ còn nghiêm trọng hơn thế nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361432
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361432,
					"content": "Hội trưởng nói, Heizou chính là người cản đường cô ấy đến với thánh đường chân tướng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361433
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361433,
					"content": "Là chó cản đường!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361434
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361434,
					"content": "Thôi mà... mặc dù tính cách của Heizou có hơi... ừm... khác thường chút, nhưng chắc chắn là một người tốt, với lại Heizou cũng từng dạy tôi rất nhiều thứ nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361435
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361435,
					"content": "Cho nên, dù hội trưởng không cho phép thì tôi cũng không thể đứng nhìn được. Ít nhất là tôi có thể chuyển giao ủy thác cho người mà tôi tin tưởng, ví dụ như Nhà Lữ Hành đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361436,
						190361437
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361436,
					"content": "Hiểu rồi, anh đang đẩy việc đúng không.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361438
					]
				},
				{
					"id": 190361438,
					"content": "À... Không, không phải đâu! Cái đó... Hiệp Hội Tenryou tất nhiên là sẽ trả thù lao đầy đủ, ngoài ra tôi cũng sẽ góp thêm một chút vào nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361439
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361439,
					"content": "Cho nên hy vọng Nhà Lữ Hành bạn có thể nhận ủy thác này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361440
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361440,
					"content": "Nếu như Heizou thật sự gặp nạn thì tôi nghĩ cậu ấy sẽ an toàn hơn khi có bạn ở đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361441,
						190361445
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361441,
					"content": "Anh rất thân thiết với anh ấy à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361442
					]
				},
				{
					"id": 190361442,
					"content": "Thực tế thì mối quan hệ giữa chúng tôi rất tốt, nhưng hội trưởng Sango luôn yêu cầu tôi phải giữ khoảng cách với cậu ấy, cũng không cho tôi thể hiện rằng tôi rất thân với cậu ấy luôn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361443
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361443,
					"content": "Cho nên khi người khác hỏi tới thì tôi thường đáp rằng chỉ gặp Heizou vài lần, nếu hôm nay không xảy ra chuyện này thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361444
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361444,
					"content": "E hèm... Giờ khoan nói tới chuyện này đã, bạn tìm cậu ấy giúp tôi được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361449
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361449,
					"content": "Hiểu rồi, tôi đi ngay đây.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361450
					]
				},
				{
					"id": 190361450,
					"content": "Ừm, chỉ có nhiêu đó thôi. Xin hãy cất kỹ thư ủy thác của hiệp hội, nếu như tìm thấy Heizou thì cứ tới thẳng hiệp hội báo cáo là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361445,
					"content": "Được chứ, nhưng tôi cần thêm thông tin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361446
					]
				},
				{
					"id": 190361446,
					"content": "Tốt quá! Chúng tôi chỉ biết rằng trước khi mất tích thì Heizou rất quan tâm đến đảo Watatsumi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361447
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361447,
					"content": "Trong thời gian chiến tranh, hình như cậu ấy đã làm nhiệm vụ trên đảo Watatsumi. Sau khi chiến tranh kết thúc, cậu ấy cũng thường xuyên tới hòn đảo đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361448
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361448,
					"content": "Tôi nghe nói Nhà Lữ Hành bạn có mối quan hệ khá thân thiết với Sangonomiya, tôi nghĩ bạn có thể lấy đó làm điểm xuất phát cho cuộc điều tra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361449
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361437,
					"content": "Hiểu rồi, anh là người trung gian.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361438
					]
				},
				{
					"id": 190361425,
					"content": "Do manh mối quá ít sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361426
					]
				}
			]
		},
		{
			"id": 1903615,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1903606",
							"2"
						],
						"stepId": 1903606,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190361501,
					"content": "Nhà Lữ Hành, hãy nhanh chóng xuất phát nhé, hy vọng Heizou sẽ không gặp chuyện gì nguy hiểm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361502
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361502,
					"content": "Hãy cho tôi biết thêm về người tên Shikanoin Heizou này.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361503
					]
				},
				{
					"id": 190361503,
					"content": "Về Heizou à? Cậu ấy là một người đầy sức sống! Nói rất nhiều, tính tình hoạt bát, năng lượng tràn trề, chưa bao giờ thấy cậu ấy tỏ vẻ gì trì trệ cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361504
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361504,
					"content": "Hội trưởng bảo cậu ấy giống như một con ruồi bay vo ve xung quanh vậy, chắc do cậu ấy luôn tìm được những thiếu sót trong mọi chuyện chăng?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361505
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361505,
					"content": "Nói như vậy thì tôi nghĩ Heizou không chỉ là một con ruồi bình thường, mà phải là một con ruồi cao cấp ấy nhỉ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361506
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361506,
					"content": "Dù có bịt mũi, che mắt, đậy tai lại thì Heizou vẫn có thể tìm được chính xác từng sai sót nhỏ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361507
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361507,
					"content": "Rất thần kỳ đúng không, cứ như cậu ấy đang dựa vào một thứ gì đó ngoài năm giác quan chính vậy, giác quan thứ sáu chăng? Hay trực giác gì đó chăng?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361508,
						190361510
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361508,
					"content": "Phép so sánh này rất mới mẻ, lần sau đừng so sánh nữa nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361509
					]
				},
				{
					"id": 190361509,
					"content": "À, hội trưởng luôn nói tôi không biết nói chuyện, xem ra quả nhiên là thế...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361510,
					"content": "Phép so sánh này quá tệ, tôi muốn nghe thêm vài câu nữa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361511
					]
				},
				{
					"id": 190361511,
					"content": "E hèm... Hay là hẹn hôm khác nói tiếp nhé... hội trưởng đang ngó chúng ta kìa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				}
			]
		},
		{
