			},
			"dialogs": [
				{
					"id": 190361601,
					"content": "Vẫn chưa lên đường sao? Hay là đã thay đổi ý định rồi? Dính líu đến tên đó quả là không sáng suốt tí nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361602
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361602,
					"content": "Tôi muốn biết giữa cô và anh ta có xích mích gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361603
					]
				},
				{
					"id": 190361603,
					"content": "Nếu hắn thật sự mất tích luôn thì tôi sẽ xem đó như là ngày lễ trọng đại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361604
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361604,
					"content": "(Mỉm cười, tỏ vẻ lịch sự.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361605
					]
				},
				{
					"id": 190361605,
					"content": "Đừng nhìn tôi như vậy chứ! Haha, cũng phải cho phép người ta ngứa mắt với vài kẻ chứ nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361606
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361606,
					"content": "Nói tóm lại, tốt hơn hết là bạn hãy nhanh chóng khởi hành, trước khi tên đó lại gây ra phiền phức khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361607
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361607,
					"content": "À đúng rồi, nếu thật sự vô tình tìm thấy di vật gì đó của hắn thì cũng nói tôi biết nhé, để tôi ăn mừng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				}
			]
		},
