			"dialogs": [
				{
					"id": 190361701,
					"content": "Úi, đây là... là đội trưởng Đội Cá Kiếm 2! Tôi là Shibata, phụ trách canh giữ nơi này, xin hỏi đội trưởng cần gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361702
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 190361702,
					"content": "Tôi đến đây để hỏi thăm một người.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361703
					]
				},
				{
					"id": 190361703,
					"content": "Mô tả ngắn gọn cho Shibata nghe.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						190361704
					]
				},
				{
					"id": 190361704,
					"content": "Là anh chàng thám tử đó đúng không, tôi biết anh ta, tên là Shikanoin Heizou, trước đây anh ta thường đi dạo quanh nơi này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361705
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 190361705,
					"content": "Lúc đó đại nhân Sangonomiya còn cử tôi đi theo dõi anh ta nữa, do sợ anh ta có mưu đồ bất chính ấy mà, nhưng sau này mới thấy anh ta như đang dạo chơi ở vùng ngoại ô thì đúng hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361706
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 190361706,
					"content": "Để tôi nhớ xem, hình như dạo này cũng có người nhìn thấy anh ta hoạt động ở phía đông Sangonomiya. Nếu cần thì có thể đến đó xem thử.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shibata"
				}
			]
		},
