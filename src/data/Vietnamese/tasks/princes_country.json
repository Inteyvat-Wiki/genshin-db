					"nextDialogs": [],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290822,
					"content": "Cô ấy về rồi. Chúng ta cũng phải về rồi nhỉ, Freminet còn việc cần làm mà?",
