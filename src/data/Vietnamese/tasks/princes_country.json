						401290817
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290817,
					"content": "Cảm ơn nữ thần. Đúng rồi, Freminet, về việc chế tác vương miện...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290818
					],
					"speakerTitle": "Zuria Destree"
				},
