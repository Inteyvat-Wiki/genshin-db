			},
			"dialogs": [
				{
					"id": 401290901,
					"content": "Đây chính là di tích dưới nước mà Freminet tìm thấy sao? Hơi đồ sộ, cũng hơi khác so với những gì tôi tưởng tượng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290902,
					"content": "Không phải di tích dưới nước, mà là vương quốc thủy yêu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290903
					]
				},
				{
					"id": 401290903,
					"content": "Được rồi, ý tôi là... tôi còn tưởng sẽ được thấy một thế giới cổ tích thực sự, ví dụ như những căn nhà sặc sỡ của thủy yêu, còn có cây cầu hình cầu vồng nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290904,
					"content": "Xin lỗi... Thật ra tôi đã nghĩ đến việc trang trí, nhưng do vấn đề nhân lực và thời gian, nên...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290905
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290905,
					"content": "Không sao, giờ là lúc để tưởng tượng mà!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290906
					]
				},
				{
					"id": 401290906,
					"content": "#Này! {NICKNAME} nhập tâm nhanh quá đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290907,
					"content": "#Chứng tỏ {NICKNAME} đã lĩnh hội được tinh thần này rồi, Paimon cũng cố lên nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290908
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290908,
					"content": "Hứ, đừng xem thường tôi chứ! Tôi sẽ không chùn bước đâu, giờ tôi sẽ vào... chế độ Paimon tưởng tượng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290909
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290909,
					"content": "E hèm... Hỡi các dũng sĩ trẻ tuổi! Ta là Paimon, nữ thần bảo vệ của nơi này. Các người tới đây có việc gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290910
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290910,
					"content": "Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290911
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290911,
					"content": "Hỡi nữ thần cao quý, chúng tôi là bạn đồng hành của hoàng tử Thelxie, tới đây để giúp cậu ấy tìm lại vinh quang đã mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290912
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290912,
					"content": "Ồ... Tìm lại vinh quang à! Nữ thần ta đây có vinh quang vàng, vinh quang bạc và vinh quang đồng, đâu là thứ mà hoàng tử đã đánh mất?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290913,
					"content": "Hả?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290914
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290914,
					"content": "Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290915
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290915,
					"content": "Paimon, lại tấu hài đấy à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290916
					]
				},
				{
					"id": 401290916,
					"content": "Đâu có! Đây chính là thử thách của nữ thần! Nữ thần ta đây đã kiểm tra và thấy được trong lòng các ngươi đều không có sự tham lam, quả là những dũng sĩ đáng được tôn trọng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290917
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290917,
					"content": "Vậy thì hãy tiếp nhận phần thưởng của nữ thần. Ta sẽ đem toàn bộ vinh quang vàng, vinh quang bạc và vinh quang đồng ra tặng cho các ngươi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290918
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290918,
					"content": "Cả vị hoàng tử này nữa, nữ thần ta sẽ tặng thêm cho ngươi vinh quang bảy màu, chúc cho tương lai của ngươi sẽ tỏa sáng rực rỡ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290919
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290919,
					"content": "-.. -... .-- -...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290920
					],
					"speakerTitle": "Thelxie"
				},
				{
					"id": 401290920,
					"content": "Cảm ơn sự chúc phúc của nữ thần, giờ tôi cảm thấy thân thể tràn đầy sức mạnh rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290921
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290921,
					"content": "Tôi... tôi cũng vậy... Woa, lời khích lệ của nữ thần trong truyền thuyết là đây sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290922
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290922,
					"content": "Nữ thần Paimon thật là lợi hại!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290923
					]
				},
				{
					"id": 401290923,
					"content": "Hihi. Hỡi các dũng sĩ, hãy đi đánh bại ma vật đang chiếm đóng vương quốc ngay nào! Ở đây, các ngươi nhất định sẽ tìm được thứ mình muốn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
