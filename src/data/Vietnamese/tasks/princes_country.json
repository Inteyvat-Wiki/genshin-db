			"dialogs": [
				{
					"id": 401290101,
					"content": "Con trai của cô đã đỡ hơn chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290102
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290102,
					"content": "Cảm ơn đã quan tâm, hiện tại vẫn khá ổn định. Bác sĩ riêng đã nói hôm nay có thể thử đưa thằng bé ra ngoài cho khuây khỏa rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290103
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290103,
					"content": "Cô Zuria! Freminet! Chúng tôi đến rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290104,
					"content": "Haha, xem ra mọi người đều đến đông đủ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290105
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290105,
					"content": "Thật ra vẫn thiếu một người, phải không? Hihi, tôi biết nó đang ở đâu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290106,
					"content": "Này... Thelxie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290107,
					"content": "-.. -... .-- -...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290108
					],
					"speakerTitle": "Thelxie"
				},
				{
					"id": 401290108,
					"content": "Chà! Thelxie đã có thêm một thanh kiếm và một tấm khiên! Ngầu quá đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290109,
					"content": "Thelxie có vũ khí trông càng hăng hái hơn đấy. Tay nghề của Freminet thật khiến người ta phải ngưỡng mộ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290110
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290110,
					"content": "Còn có chúng tôi giúp nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290111,
					"content": "#Ừm, {NICKNAME} rất có khiếu thẩm mỹ, nguyên liệu tìm được đều rất tuyệt vời.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290112
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290112,
					"content": "#Đúng rồi, cô Zuria vừa nói là sau chuyến thám hiểm thì nên có một buổi lễ đăng quang để hạ màn. Vậy nguyên liệu để làm vương miện... có thể nhờ {NICKNAME} được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290113
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290113,
					"content": "#Lát nữa trên đường đi tiện tìm cũng được. Vốn dĩ tôi định tự mình giải quyết, nhưng giờ tôi thấy, nguyên liệu do {F#cô}{M#cậu} tìm chắc sẽ đẹp hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290114
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290114,
					"content": "Cứ để tôi lo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290115
					]
				},
				{
					"id": 401290115,
					"content": "Xem ra mọi thứ đều sẵn sàng rồi, chúng ta xuất phát thôi nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290116,
					"content": "Xin đợi một lát, tôi đang nghĩ, dù sao Thelxie đã có diện mạo hoàn toàn mới rồi, hay là giờ chúng ta cập nhật cuốn sách tranh nhỉ. Mọi người thấy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290117
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290117,
					"content": "Woa! Nghe hay đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290118,
					"content": "Phải vẽ gì đây?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290119
					]
				},
				{
					"id": 401290119,
					"content": "Điều chỉnh trên nền tảng sẵn có thì sao? Ít nhất đừng khiến nội dung bức tranh bi thương như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290120
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290120,
					"content": "Loại bỏ những phần buồn bã và vẽ những màu sắc tươi đẹp lên à? Nghe cũng được đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290121,
					"content": "Vậy để tôi vẽ cho, tuy tôi không phải người giỏi vẽ vời, nhưng trong công việc cũng tiếp xúc khá nhiều. Về nội dung cụ thể thì mọi người cứ nói ra suy nghĩ của mình nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290122
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290122,
					"content": "Tôi nghĩ... Trước tiên là vẽ vũ khí, hoàng tử cầm thanh kiếm dũng mãnh và tấm khiên kiên cố. Chứng tỏ bản thân đã vượt qua suy sụp, quyết tâm tuyên chiến với cái ác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290123
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290123,
					"content": "Được, vẽ vũ khí lên... Còn gì nữa không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290124
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290124,
					"content": "Tôi thấy cần phải thêm bạn đồng hành! Lần này Thelxie đã có bạn đồng hành sát cánh bên cạnh, cậu ấy sẽ không phải chiến đấu một mình nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290125,
					"content": "Được, vẽ thêm đồng hành... Còn gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290126
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290126,
					"content": "Còn màu sắc nữa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290127
					]
				},
				{
					"id": 401290127,
					"content": "Màu sắc... được! Màu sắc rất quan trọng, con đường phía trước sẽ không xám xịt, mà sẽ rất rực rỡ và tràn đầy hy vọng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290128
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290128,
					"content": "Không ngờ nó lại trở thành một bức tranh đầy hứng khởi như vậy... Tốt quá, ý tưởng của mọi người rất tuyệt vời!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290129
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290129,
					"content": "Thật tuyệt. Xem ra mọi người rất có tinh thần, Thelxie trông hăng hái nhất!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290130
					],
					"speakerTitle": "Paimon"
				},
