					"nextDialogs": [
						401290813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290813,
					"content": "Cảm ơn, như vậy là trang thứ hai cũng xong rồi. Chuyến mạo hiểm của Thelxie ngày càng tiến gần tới hồi kết, cậu ấy sẽ lên ngôi vua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290814
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290814,
					"content": "Mà con trai của mẹ, chắc chắn lúc đó con sẽ phấn chấn trở lại, phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290815
					],
					"speakerTitle": "Zuria Destree"
				},
