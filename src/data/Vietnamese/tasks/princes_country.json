					"nextDialogs": [
						401290832
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290832,
					"content": "Đừng làm khó Freminet nữa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290833
					]
				},
				{
					"id": 401290833,
					"content": "Hihi, được rồi. Vậy hôm nay không phiền Freminet làm việc nữa, hai hôm nữa gặp lại nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290834
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290834,
					"content": "Cảm ơn... được rồi... hẹn hai hôm nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290835
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290835,
					"content": "Hai ngày nữa gặp!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290836
					]
				},
				{
					"id": 401290836,
					"content": "Tôi hy vọng, tất cả những người đang gặp khó khăn đều được thấy những thứ tốt đẹp, được thấy những phép màu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Freminet"
				}
			]
