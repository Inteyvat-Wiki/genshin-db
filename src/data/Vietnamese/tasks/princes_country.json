					"nextDialogs": [
						401290609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290609,
					"content": "Cậu ấy giống như một hoàng tử thực thụ, tôi nghĩ... không có khó khăn nào có thể ngăn cản được cậu ấy.",
