						401290827
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290827,
					"content": "Có lẽ là vì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290828
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290828,
					"content": "Gì vậy?",
