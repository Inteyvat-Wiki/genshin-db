			"trigger": {
				"objectNames": [
					"Gui"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110090301,
					"content": "Hai vị đến bốc thuốc sao? Cho hỏi có đơn thuốc không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090302
					],
					"speakerTitle": "Gui"
				},
				{
					"id": 110090302,
					"content": "Thanh Tâm, Bách Hợp Lưu Ly, Túi Lưu Ly, mỗi loại nửa cân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090303
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090303,
					"content": "Cái này là phương thuốc gì vậy? Cô định ăn thay cơm sao... Đây, chỗ này là tất cả hàng dự trữ của tiệm chúng tôi rồi đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090304
					],
					"speakerTitle": "Gui"
				},
				{
					"id": 110090304,
					"content": "Cảm ơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090305
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090305,
					"content": "Ăn, ăn thiệt kìa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090306,
					"content": "Trong ánh mắt hoảng hốt của mọi người, Shenhe đã quét sạch nguyên liệu thuốc trước mặt.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						110090307
					]
				},
				{
					"id": 110090307,
					"content": "Hết đói rồi, cảm ơn đã chiếu cố.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090308,
						110090309
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090308,
					"content": "Mùi vị thế nào...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090310
					]
				},
				{
					"id": 110090310,
					"content": "Không ngon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090311
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090311,
					"content": "Tuy có mùi thơm nhẹ, nhưng khi ăn nhiều thì chỉ còn lại vị đắng, chát và chua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090312
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090312,
					"content": "Tại sao Shenhe lại thà ăn mấy thứ này chứ không ăn món bình thường trong tiệm ăn vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090313,
					"content": "Nếu như tôi có nhiều Mora tới vậy thì tôi sẽ tới nhà hàng cao cấp nhất để ăn cho đã cái bụng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090314,
					"content": "Bởi vì tôi không chắc rằng sau này bản thân có ở lại đây không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090315
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090315,
					"content": "Thức ăn trần gian đúng là rất ngon, nhưng nếu tôi phải quay về trong núi thì mùi vị của thức ăn ngon sẽ cản trở việc tu luyện của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090316
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090316,
					"content": "Cho nên chỉ nếm thử thôi là cách tốt nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090317
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090317,
					"content": "#Trở về trong núi... {NICKNAME}, không lẽ người này là tiên nhân thật sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090318,
					"content": "Chuyện của tôi tạm thời không nhắc nữa, tiếp theo hai vị có dự định gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090319
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090319,
					"content": "Đúng ha! Suýt nữa quên mất, chúng tôi định tham gia cuộc thi trùng tu Quần Ngọc Các!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090320,
					"content": "Nhưng mà lãng phí nhiều thời gian vậy chắc không đuổi kịp họ rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090321,
					"content": "Thì ra là vậy, ban nãy tôi đi ngang cũng có nghe thấy chuyện này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090322
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090322,
					"content": "Hì hì... nếu như chiến thắng thì có thể hỏi Ningguang bất cứ điều gì đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090323,
					"content": "Shenhe cũng đến đây tham dự sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090324,
					"content": "Đúng là tôi đến đây vì chuyện trùng tu Quần Ngọc Các, nhưng tôi không định tham gia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090325
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090325,
					"content": "Giờ đây được hai vị chiếu cố, tôi cũng sẽ giúp đỡ hai vị. Yên tâm, tôi không cần hai vị phải báo đáp đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090326
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090326,
					"content": "Woa... vậy sao được chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090327,
					"content": "Nhưng mà nếu có tiên nhân giúp đỡ thì mọi chuyện sẽ dễ dàng hơn nhiều rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090328,
						110090329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090328,
					"content": "Vậy chúng ta cùng nhau hành động thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090330
					]
				},
				{
					"id": 110090330,
					"content": "Vậy thì đừng chậm trễ nữa, tôi đang có một phương án tác chiến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090331
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090331,
					"content": "Hay quá! Có Shenhe lập kế hoạch thì nhất định sẽ thành công!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090332
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090332,
					"content": "Thành công hay không thì tôi không biết, nhưng có lẽ sẽ có hiệu quả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090333
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090333,
					"content": "Kế hoạch là chỉ cần vặn cổ hết những tên gần vạch đích hơn thì chúng ta sẽ là người chiến thắng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090334
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090334,
					"content": "...Không phải chứ, sao cô lại có thể làm vậy được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090335
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090335,
					"content": "Sao lại không? Tôi nghe nói trong mỗi cuộc thi thì người ta đều sẽ toan tính loại trừ nhau mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090336
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090336,
					"content": "Nhưng chúng ta cũng có thể đường đường chính chính giành chiến thắng mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090337
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090337,
					"content": "\"Minh Hà Phù Sinh Thạch\", \"Lõi Thần Kỳ\", và \"Bùa Chú Tiên Gia\"... Chúng ta chỉ cần tìm những thứ này là được rồi, đầu tiên là Phù Sinh Thạch...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090338
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090338,
					"content": "Tôi cứ nghĩ tại sao trong tiệm lại có lời qua tiếng lại, thì ra là các bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090339
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 110090339,
					"content": "Baizhu! Anh cũng đến rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090340
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090340,
					"content": "Tiểu thư Ningguang cần mua một số thuốc, nhưng mà dược liệu trong tiệm thì không đủ, cho nên tôi mới đi chuẩn bị thêm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090341
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 110090341,
					"content": "Hử, tiểu thư Ningguang cần nhiều thuốc như vậy để làm gì nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090342
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090342,
					"content": "Tôi cũng không rõ, nghe nói cô ấy muốn trùng tu Quần Ngọc Các, có lẽ là để đề phòng tai nạn chăng? Nói chung thì việc riêng của khách hàng, tôi không tiện hỏi nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090343
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 110090343,
					"content": "Cô ấy còn mượn Qiqi ở chỗ tôi nữa, Nhà Thuốc Bubu đang rất thiếu người, các vị có muốn kiếm một công việc bán thời gian không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090344
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 110090344,
					"content": "Thôi, chúng tôi đang có việc khác phải làm rồi... À nói chứ, Baizhu học cao hiểu rộng, anh có từng nghe qua \"Minh Hà Phù Sinh Thạch\" không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090345
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090345,
					"content": "Là loại dùng cho Quần Ngọc Các sao? Tôi nhớ trong quyển \"Thất Tàng Sơn Kinh\" có nhắc qua, khi kích hoạt Minh Hà Phù Sinh Thạch sẽ có thể bay lên chín tầng mây, rất hiếm thấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090346
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 110090346,
					"content": "Có tài liệu cho rằng loại Phù Sinh Thạch này đã bị khai thác hết rồi. Cho nên tôi nghĩ Thương Hội Phi Vân sẽ có nhiều thông tin hơn tôi đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090347
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 110090347,
					"content": "Ra là vậy, vậy chúng ta đến đó hỏi thử xem sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090348
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090348,
					"content": "Cảm ơn nhé Baizhu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090349
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090349,
					"content": "Đừng khách sáo, chúc thuận lợi nhé! Nếu có gì cần thì cứ đến Nhà Thuốc Bubu tìm tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 110090329,
					"content": "Hoan nghênh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090330
					]
				},
				{
					"id": 110090309,
					"content": "Có ngon thật không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090310
					]
				}
			]
		},
