			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ningguang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110090101,
					"content": "Hôm nay triệu tập các vị là có một chuyện muốn tuyên bố.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090102
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090102,
					"content": "Có lẽ một số người đã nghe tin này rồi, thực ra là tôi đang dự định trùng tu Quần Ngọc Các.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090103
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090103,
					"content": "Trùng tu Quần Ngọc Các? Đây là một dự án lớn đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090104
					],
					"speakerTitle": "Hongfei"
				},
				{
					"id": 110090104,
					"content": "Gần đây đúng là có lời đồn này, chẳng trách giá vật liệu xây dựng lại tăng vọt như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090105
					],
					"speakerTitle": "Changgui"
				},
				{
					"id": 110090105,
					"content": "Quần Ngọc Các rất có ý nghĩa với đại nhân Ningguang, nếu có thể tham gia vào dự án này sẽ là một cơ hội lớn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090106
					],
					"speakerTitle": "Zhicheng"
				},
				{
					"id": 110090106,
					"content": "Đại nhân Ningguang, có việc gì cần chúng tôi giúp không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090107
					],
					"speakerTitle": "Hongfei"
				},
				{
					"id": 110090107,
					"content": "Đừng gấp. Vài ngày trước, khi mà tin tức truyền ra, đã có không ít người liên hệ với tôi, họ mong muốn tham gia dự án này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090108
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090108,
					"content": "Trước mắt đúng là tôi có vài việc cần ủy thác cho các vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090109
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090109,
					"content": "Địa điểm xây dựng đã được chọn, các loại nguyên liệu cũng đã chuẩn bị xong, nhưng vẫn còn ba vật phẩm đang chưa biết thế nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090110
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090110,
					"content": "Ba vật phẩm này chính là \"Minh Hà Phù Sinh Thạch\", \"Lõi Thần Kỳ\", và \"Bùa Chú Tiên Gia\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090111
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090111,
					"content": "...Xin lỗi vì sự thiếu hiểu biết của tôi, ngoài Minh Hà Phù Sinh Thạch ra thì hai thứ kia tôi chưa từng nghe nói qua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090112
					],
					"speakerTitle": "Changgui"
				},
				{
					"id": 110090112,
					"content": "Phù Sinh Thạch với diện tích đủ lớn mới có tên là \"Minh Hà\", đây chính là nền móng cơ bản để nâng Quần Ngọc Các lên cao. Còn Lõi Thần Kỳ chính là lõi trung tâm của kết cấu hệ thống bên trong Quần Ngọc Các.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090113
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090113,
					"content": "Còn Bùa Chú Tiên Gia chính là dùng để kết hợp giữa thiết bị máy móc và thuật pháp tiên gia, cũng không thể thiếu được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090114
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090114,
					"content": "Tuy đây là ba nguyên liệu hiếm, nhưng tin rằng với nhân lực tài lực của các vị đây thì việc tìm được chúng cũng chỉ là vấn đề thời gian thôi đúng chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090115
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090115,
					"content": "Binh quý thần tốc, lấy hiệu suất làm đầu. Tôi sẽ mua nguyên liệu mà các vị tìm được với giá tốt. Ngoài ra, ba người tìm đủ nguyên liệu đầu tiên sẽ có cơ hội đề ra câu hỏi với tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090116
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090116,
					"content": "Dù là vấn đề gì thì tôi cũng sẽ trả lời. Tôi tin rằng mức thù lao tôi đưa ra sẽ không khiến các vị thất vọng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090117
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090117,
					"content": "Tuy những thứ này khó tìm, nhưng nếu như có thể đổi lại kế hoạch phát triển Liyue của năm sau thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090118
					],
					"speakerTitle": "Changgui"
				},
				{
					"id": 110090118,
					"content": "Đây đúng là mối hời đó, ai có thể lấy được thông tin từ đại nhân Ningguang thì người đó sẽ nắm được tiên cơ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090119
					],
					"speakerTitle": "Zhicheng"
				},
				{
					"id": 110090119,
					"content": "Haha, trùng hợp quá! Không lâu trước đây tôi vừa nghe được tin đồn liên quan tới Phù Sinh Thạch. Các vị, thất lễ quá, tôi xin đi trước một bước!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090120
					],
					"speakerTitle": "Hongfei"
				},
				{
					"id": 110090120,
					"content": "Đáng ghét... tôi cũng phải nhanh chóng xuất phát, không thể để chậm trễ được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090121
					],
					"speakerTitle": "Changgui"
				},
				{
					"id": 110090121,
					"content": "Trùng tu Quần Ngọc Các... chuyện quan trọng như vậy, chúng ta cũng phải đi xem thử mới được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090122,
					"content": "Các bạn ban nãy cũng nghe được chuyện mà tôi nói rồi chứ. Thế nào? Có hứng thú tham gia vụ này không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090123
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090123,
					"content": "Có thật là cái gì cũng có thể hỏi không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090124
					]
				},
				{
					"id": 110090124,
					"content": "Chỉ cần đó là chuyện tôi biết, thì ắt sẽ thành thật trả lời.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090125
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090125,
					"content": "#(Nói không chừng có thể hỏi được chuyện của {M#em gái}{F#anh trai} mình...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090126
					]
				},
				{
					"id": 110090126,
					"content": "Thật sao? Vậy tôi muốn hỏi tiểu thư Ningguang kinh doanh như thế nào vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090127,
					"content": "Có được bí quyết của tiểu thư Ningguang thì chúng ta sẽ không sợ thiếu Mora rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090128,
					"content": "Haha, đương nhiên là được. Nhưng mà truyền thụ được bao nhiêu thì cũng phải xem xem biểu hiện của hai vị đã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090129
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090129,
					"content": "Chuyện trùng tu Quần Ngọc Các chiếm một diện tích đất lớn, tôi đã chọn khu đất trống ở bên ngoài Hoàng Kim Ốc rồi. Nguyên liệu mà các vị thu thập được có thể giao qua bên đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090130
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090130,
					"content": "Tôi còn có việc nên không thể đến hiện trường cùng các vị. Nếu các vị đến đó thì cứ liên hệ với thư ký của tôi là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090131
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090131,
					"content": "Cơ hội hiếm có đấy, đừng để bị người khác phỗng tay trên nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090132
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090132,
					"content": "Tiểu thư Ningguang quả là người bận rộn... thôi chúng ta cũng mau chóng xuất phát thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090133,
					"content": "#Đầu tiên là phải rời khỏi Ngọc Kinh Đài... Ấy? {NICKNAME}, không khí bên kia hình như có gì đó kì lạ đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090134,
					"content": "Tiểu thư, tôi thấy cô phong thái ngời ngời, khí chất bất phàm, vừa nhìn qua là biết được tiểu thư rất có tố chất để giành chiến thắng trong cuộc đua lần này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090135
					],
					"speakerTitle": "Liu Mặt Sẹo"
				},
				{
					"id": 110090135,
					"content": "Ở đây tôi có vài tình báo về những nguyên liệu đó, chúng ta tìm chỗ vắng vẻ hơn để nói nhé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090136
					],
					"speakerTitle": "Liu Mặt Sẹo"
				},
				{
					"id": 110090136,
					"content": "Không cần đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090137
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090137,
					"content": "Đừng nói thế chứ. Ấy, đừng đi mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090138
					],
					"speakerTitle": "Liu Mặt Sẹo"
				},
				{
					"id": 110090138,
					"content": "Còn đứng đó làm gì, mau đuổi theo đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090139
					],
					"speakerTitle": "Liu Mặt Sẹo"
				},
				{
					"id": 110090139,
					"content": "Dạ dạ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qiang"
				}
			]
		},
		{
			"id": 1100902,
			"completionStepIds": [
				1100902
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1100902",
							"2"
						],
						"stepId": 1100902,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Shenhe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110090201,
					"content": "Hehe, tiểu thư, lần này cô hết đường chạy rồi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090202
					],
					"speakerTitle": "Liu Mặt Sẹo"
				},
				{
					"id": 110090202,
					"content": "Yên tâm, chúng tôi không phải người xấu. Chỉ cần đưa tiền là sẽ có tình báo ngay, đôi bên đều có lợi mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090203
					],
					"speakerTitle": "Liu Mặt Sẹo"
				},
				{
					"id": 110090203,
					"content": "Đại ca, sao em thấy trên người cô ta luôn tỏa ra cái khí chất gì đó rất khác. Tóc cũng màu trắng nữa, khác với người thường...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090204
					],
					"speakerTitle": "Qiang"
				},
				{
					"id": 110090204,
					"content": "Vậy thì sao? Tính bỏ qua miếng mồi ngon thế này à, vậy tiền nợ của chúng ta tính sao đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090205
					],
					"speakerTitle": "Liu Mặt Sẹo"
				},
				{
					"id": 110090205,
					"content": "Tôi nói rồi, tôi không cần tình báo của các người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090206
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090206,
					"content": "Nếu các người ban nãy không nghe rõ thì tôi sẽ nhắc lại lần nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090207
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090207,
					"content": "Haiz... Tiểu thư, đã lớn như vậy rồi mà sao kiến thức hạn hẹp thế nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090208
					],
					"speakerTitle": "Liu Mặt Sẹo"
				},
				{
					"id": 110090208,
					"content": "Đây không phải là chuyện cô cần hay không cần, chỉ cần ngoan ngoãn lấy tiền ra, đưa cho chúng tôi là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090209
					],
					"speakerTitle": "Liu Mặt Sẹo"
				},
				{
					"id": 110090209,
					"content": "Tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090210
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090210,
					"content": "Đừng lôi thôi nữa! Ngươi có tiền, không qua mắt được ta đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090211
					],
					"speakerTitle": "Liu Mặt Sẹo"
				},
				{
					"id": 110090211,
					"content": "Ngươi ban đầu tới Lưu Ly Đình, gọi đầy bàn đồ ăn xong chỉ nếm thử một chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090212
					],
					"speakerTitle": "Liu Mặt Sẹo"
				},
				{
					"id": 110090212,
					"content": "Sau đó lại đến Tân Nguyệt Hiên, Vạn Dân Đường, món nào cũng gọi, nhưng mỗi món chỉ ăn đúng một miếng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090213
					],
					"speakerTitle": "Liu Mặt Sẹo"
				},
				{
					"id": 110090213,
					"content": "Nếu ngươi không phải là thiên kim tiểu thư thì làm gì có cái thói quen xa xỉ đó chứ? Nếu giàu sang như vậy thì chia cho bọn ta một ít đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090214
					],
					"speakerTitle": "Liu Mặt Sẹo"
				},
				{
					"id": 110090214,
					"content": "Hừm, sư phụ từng dặn dò là không nên động thủ trong cảng Liyue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090215
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090215,
					"content": "Kệ vậy, có lẽ đây là số mệnh rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090216
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090216,
					"content": "Đại ca, có cái gì đó rất không đúng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090217
					],
					"speakerTitle": "Qiang"
				},
				{
					"id": 110090217,
					"content": "Sợ gì chứ, chúng ta bán tình báo thì phạm tội gì, ả ta dám động thủ thì ta kiện đến ả ta phá sản mới thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090218,
						110090219
					],
					"speakerTitle": "Liu Mặt Sẹo"
				},
				{
					"id": 110090218,
					"content": "Chính là chúng đó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090220
					]
				},
				{
					"id": 110090220,
					"content": "Hừm! Lại là các ngươi sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090221
					],
					"speakerTitle": "Zheng"
				},
				{
					"id": 110090221,
					"content": "Thiên Nham Quân? Sao Thiên Nham Quân lại đến đây rồi... cái tên lo chuyện bao đồng, có tin ta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090222
					],
					"speakerTitle": "Liu Mặt Sẹo"
				},
				{
					"id": 110090222,
					"content": "Im miệng! Còn dám uy hiếp người khác sao, đi theo bọn tôi ngay!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090223
					],
					"speakerTitle": "Zheng"
				},
				{
					"id": 110090223,
					"content": "Ối ối... đại nhân nóng tính quá, nghe tôi giải thích đã...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090224
					],
					"speakerTitle": "Liu Mặt Sẹo"
				},
				{
					"id": 110090224,
					"content": "Đám lưu manh bao vây cô gái tóc trắng đã bị Thiên Nham Quân bắt đi.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						110090225
					]
				},
				{
					"id": 110090225,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090226,
						110090227
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090226,
					"content": "Cô không sao chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090228
					]
				},
				{
					"id": 110090228,
					"content": "...Shenhe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090229
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090229,
					"content": "Shenhe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090230,
					"content": "Tên của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090231
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090231,
					"content": "#À à, thì ra cô tên là Shenhe sao! Tôi tên là Paimon, còn người này là {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090232,
					"content": "Tôi đã từng nghe qua rồi. Ban nãy, cảm ơn các bạn đã giúp tôi giải vây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090233
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090233,
					"content": "Tuy tôi cũng có thể tự mình giải quyết được. Có lẽ chỉ cần nắm lấy đầu bọn chúng đập xuống đất ba lần là sẽ hàng phục được chúng thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090234
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090234,
					"content": "Hả! Cô nghĩ tới cách giải quyết bạo lực vậy sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090235
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090235,
					"content": "Ở đây là cảng Liyue, cho nên phải tuân thủ theo pháp luật Liyue đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090236,
					"content": "Pháp... luật?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090237
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090237,
					"content": "Shenhe chưa từng nghe qua pháp luật sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090238
					]
				},
				{
					"id": 110090238,
					"content": "Tôi thật sự chưa nghe qua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090239
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090239,
					"content": "Có phải không vậy, vậy trước đây cô...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090241
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090241,
					"content": "Hình như có âm thanh gì đó...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090242
					]
				},
				{
					"id": 110090242,
					"content": "Là bụng của tôi kêu, bởi vì tôi chưa ăn no.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090243
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090243,
					"content": "Cô thừa nhận cũng thẳng thắn ghê...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090244
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090244,
					"content": "Nói ra thì ban nãy nghe thấy đám người đó nói, cô gọi rất nhiều món, nhưng mỗi món chỉ ăn một miếng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090245
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090245,
					"content": "Như vậy thì chắc chắn là ăn không no rồi! Cô có muốn ăn gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090246
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090246,
					"content": "Thanh Tâm, Bách Hợp Lưu Ly, Túi Lưu Ly... tôi thường hay ăn những thứ này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090247
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090247,
					"content": "Những thứ này là dược liệu mà...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090248
					]
				},
				{
					"id": 110090248,
					"content": "Dược liệu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090249
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090249,
					"content": "Có vẻ như không giải thích được rồi... Nhà Thuốc Bubu ở gần đây, hay là chúng ta đưa Shenhe đi ăn một bữa no nê nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090250
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090250,
					"content": "Dù sao thì có thực mới vực được đạo mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090227,
					"content": "Yên tâm, không sao rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090228
					]
				},
				{
					"id": 110090219,
					"content": "Các ngươi dám chèn ép người khác.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090220
					]
				}
			]
		},
		{
			"id": 1100903,
