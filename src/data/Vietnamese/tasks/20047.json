			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Doolan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200470101,
					"content": "Không có phương án nào hoàn mỹ cho việc mạo hiểm! Cứ kéo dài như vậy, thì đến lúc nào mới có thể tiến triển?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470102
					],
					"speakerTitle": "Patchi Hiếu Kì"
				},
				{
					"id": 200470102,
					"content": "Cho dù không có phương án hoàn mỹ, cũng phải có sự chuẩn bị hoàn hảo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470103
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470103,
					"content": "Các bạn đang cãi gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200470104
					]
				},
				{
					"id": 200470104,
					"content": "Ồ, chúng tôi chuẩn bị đi thám hiểm <color=#00E1FFFF>Thiên Phong Thần Điện</color>, nhưng cô Patchi lại không có kinh nghiệm mạo hiểm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470105
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470105,
					"content": "Hiện nay Thiên Phong Thần Điện có ma vật hoành hành, còn có thủ vệ di tích đáng sợ... cứ tự tiện xông vào, chỉ sợ nguy hiểm đến tính mạng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470106
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470106,
					"content": "Vì để cùng với Patchi... không phải, vì để đảm bảo sự an toàn của chúng tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470107
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470107,
					"content": "Tôi đang thuyết phục cô ấy, thiết kế một kế hoạch mạo hiểm không có sơ sót nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470108
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470108,
					"content": "Nhưng nếu tôi đi xung quanh điều tra, nói không chừng Patchi sẽ xông thẳng vào thần điện luôn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470109
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470109,
					"content": "Tôi phải ở đây trông chừng cô ấy, xin bạn giúp tôi đi xung quanh điều tra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470110,
						200470113
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470110,
					"content": "Tôi biết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200470111
					]
				},
				{
					"id": 200470111,
					"content": "Tốt quá rồi, phải nhìn kỹ một chút, bất kể chi tiết nào cũng sẽ ảnh hưởng đến việc thành bại của mạo hiểm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470112
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470112,
					"content": "Bất kể phát hiện ra gì, đều đem về cho tôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470113,
					"content": "Vậy tôi đến trông chừng tiểu thư Patchi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200470114
					]
				},
				{
					"id": 200470114,
					"content": "Không, không được! Trong kế hoạch cũ có rất nhiều chi tiết, tôi phải thảo luận lại với cô ấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470115
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470115,
					"content": "Bạn mau đi điều tra manh mối mới đi, năn nỉ bạn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Doolan"
				}
			]
		},
