				},
				{
					"id": 200470302,
					"content": "Có những phát hiện này...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200470303
					]
				},
				{
					"id": 200470303,
					"content": "...Hóa ra là vậy, hóa ra là vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470304
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470304,
					"content": "Về cơ bản là như thế.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200470305
					]
				},
				{
					"id": 200470305,
					"content": "Đều là những manh mối rất có giá trị, vất vả cho bạn rồi, những thứ này là quà cảm ơn tặng bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470306
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470306,
					"content": "Patchi! Kế hoạch mạo hiểm lại có thể cập nhật rồi.",
