			"dialogs": [
				{
					"id": 3770201,
					"content": "Các bạn đến rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770202
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3770202,
					"content": "#Í? Bạn không phải là... {NICKNAME} sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770203,
						3770204
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3770203,
					"content": "Đây không phải là... Jean sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3770205
					]
				},
				{
					"id": 3770205,
					"content": "Trước tiên, người tôi liên hệ không phải chỉ có một.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770206
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3770206,
					"content": "Tiếp đến, vị này chỉ là Jean, không phải đội trưởng Jean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770207
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3770207,
					"content": "#Đây là người mà Kỵ Sĩ Danh Dự như {F#cô}{M#cậu}, cũng không thể tiếp xúc đến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770208
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3770208,
					"content": "Thật là bất ngờ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770209
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3770209,
					"content": "Tuy rằng đã nghe chuyện về Đàn Thiên Không, nhưng không ngờ là bạn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770210
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3770210,
					"content": "Vậy thì, sự thanh tẩy của tiếng đàn có thể giúp Phong Ma Long khôi phục lý trí... việc này cũng là thật sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770211
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3770211,
					"content": "#Đúng vậy! Hiện tại {NICKNAME} luôn là người tích cực nhất trong việc giải quyết vấn đề của Phong Ma Long.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770212
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3770212,
					"content": "Không hổ danh là ngôi sao mới của Đội Kỵ Sĩ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770213
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3770213,
					"content": "Tuy rằng cứ có cảm giác đã vượt qua giới hạn pháp luật...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3770214,
					"content": "Hừ. Sự giải thích hoang đường liên quan đến thần thoại này, khó tin cũng là chuyện bình thường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770215
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3770215,
					"content": "Nhưng cũng không sao. Chúng ta có thể bảo nhà thơ biểu diễn bài hát đó lần nữa, để thuyết phục...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770216
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3770216,
					"content": "Tôi tin mọi người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770217
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3770217,
					"content": "Thuyết phục vị đội trưởng cố chấp à... hửm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770218
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3770218,
					"content": "Dvalin là Rồng Đông Phong trong Tứ Phong Thủ Hộ, tôi vẫn không thể hiểu được nguyên nhân nó phản bội.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770219
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3770219,
					"content": "Nhưng nếu trong trận chiến bảo vệ Mondstadt nhiều năm trước, nó bị máu độc xâm hại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770220
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3770220,
					"content": "Sau khi thức tỉnh lại bị Pháp Sư Vực Sâu khống chế, vậy thì nó sẽ trở nên thân bất do kỷ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770221
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3770221,
					"content": "...Nhưng những lời này, tuyệt đối không thể được nói ra bởi Đội Trưởng Đại Diện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770222
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3770222,
					"content": "Đội Kỵ Sĩ do chịu áp lực ngoại giao từ phía Fatui, nên khó có thể biểu lộ thiện ý với Phong Ma Long.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770223
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3770223,
					"content": "Như vậy sẽ bị cho rằng chúng tôi đang dung túng, cho nên tôi chỉ có thể hành động bí mật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770224
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3770224,
					"content": "Hừ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770225
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3770225,
					"content": "Đây cũng là một trong những nguyên nhân tôi không thích đội Kỵ Sĩ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770226
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3770226,
					"content": "Nhưng tôi lại không ngờ đến, cô lại tin tưởng người lạ mặt lai lịch bất minh này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770227
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3770227,
					"content": "#<color=#00E1FFFF>Tiền bối</color> là người nghiêm túc và cẩn thận, chẳng phải cũng tin tưởng {M#anh ấy}{F#cô ấy} sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770228
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3770228,
					"content": "Đã nói đừng gọi tôi là tiền bối... thôi cũng được, cũng là một lần hợp tác hiếm có.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770229,
						3770230
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3770229,
					"content": "Tiền bối?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3770231
					]
				},
				{
					"id": 3770231,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770232
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3770232,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770233
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3770233,
					"content": "Xem ra có một quá khứ không nên hỏi đến...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3770234,
					"content": "Tóm lại tôi đã đoán được tung tích của Đàn Thiên Không rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770235
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3770235,
					"content": "(Tuyệt lắm! Thật nhìn không ra cô ấy còn có biệt tài đánh trống lảng...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770236
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3770236,
					"content": "Bản chất của sự xung đột giữa Thành Mondstadt và Snezhnaya chính là sự xung đột giữa 7 đất nước và 7 vị thần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770237
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3770237,
					"content": "Băng Thần thống lĩnh Fatui, đang thèm muốn sức mạnh mà Phong Thần để lại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770238
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3770238,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770239,
						3770240
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3770239,
					"content": "Cho nên họ mới đưa ra yêu cầu tiếp quản thành phố?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3770241
					]
				},
				{
					"id": 3770241,
					"content": "Đúng vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770242
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3770242,
					"content": "Nếu ý đồ giết chết Phong Long bị đội kỵ sĩ ngăn chặn, vậy thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770243
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3770243,
					"content": "Đàn Thiên Không, là sức mạnh Phong Thần duy nhất mà họ có thể có được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770244
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3770244,
					"content": "Có rất nhiều thành viên Fatui còn sót lại trong thành Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770245
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3770245,
					"content": "Tôi đã moi được tin tức từ bọn họ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770246
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3770246,
					"content": "Tin tức mà Diluc có được là, bọn Fatui không để Đàn Thiên Không ở khách sạn Goth.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770247
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3770247,
					"content": "Có thể bọn họ cũng không muốn quá khoa trương, để thánh vật trộm được ở nơi công khai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770248
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3770248,
					"content": "Tôi hiểu tôi hiểu. Nếu làm lớn việc này ra, thì sẽ trở thành nguy cơ ngoại giao nghiêm trọng rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770249
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3770249,
					"content": "Ha... quan hệ giữa 7 quốc gia chính là như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770250
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3770250,
					"content": "Người phương xa, đã chuẩn bị xuất phát chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3770240,
					"content": "Cho nên họ mới muốn giết chết Dvalin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3770241
					]
				},
				{
					"id": 3770230,
					"content": "(Giả bộ không nghe thấy từ này.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3770231
					]
				},
				{
					"id": 3770204,
					"content": "Tại sao đội trưởng lại ở đây?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3770205
					]
				}
			]
		},
