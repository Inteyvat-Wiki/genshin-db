				"points": []
			},
			"dialogs": [
				{
					"id": 726890101,
					"content": "Hai bạn đến rất đúng giờ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726890102
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726890102,
					"content": "Sau hai buổi thực hành, hiểu biết của bạn về nghệ thuật cắm hoa đã tăng lên rất nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726890103
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726890103,
					"content": "Vì vậy, chủ đề hoa hôm nay sẽ thay đổi một chút, sẽ mở ra một vùng đất mới trong kết cấu tư duy của hai bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726890104
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726890104,
					"content": "Chúng tôi chuẩn bị xong rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726890105
					]
				},
				{
					"id": 726890105,
					"content": "Hmm... cô nói vậy khiến tôi đột nhiên cảm thấy lo lắng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726890106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726890106,
					"content": "Haha, đừng lo lắng, thả lỏng toàn thân, tâm tịnh khí hòa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726890107
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726890107,
					"content": "Với tài năng của hai vị, sau khi suy ngẫm về \"chủ đề hoa\", trong đầu liền hiện lên một bức tranh tương ứng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726890108,
						726890111
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726890108,
					"content": "Quá khen rồi, xin hãy chỉ bảo thêm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726890109
					]
				},
				{
					"id": 726890109,
					"content": "Vậy thì, chủ đề hôm nay là \"Đồng Xanh Yên Ả, Gió Thoảng Sinh Hoa\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726890110
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726890110,
					"content": "Hai vị sẽ đưa ra đáp án thế nào đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726890111,
					"content": "Tôi còn chuyện khác phải làm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726890112
					]
				},
				{
					"id": 726890112,
					"content": "Không sao. Khi cắm hoa cần phải tâm bình khí lặng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726890113
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726890113,
					"content": "Đợi khi hai bạn hoàn thành công việc, loại bỏ tạp niệm. Chắc chắn sẽ tạo ra được một vườn hoa hoàn chỉnh như yêu cầu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fushizome"
				}
			]
		},
		{
			"id": 7268903,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
