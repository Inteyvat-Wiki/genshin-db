			"dialogs": [
				{
					"id": 140340101,
					"content": "Cuối cùng, các bạn đã đến gần giáo {RUBY#[D]mật thất}đường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340102
					],
					"speakerTitle": "Clorinde",
					"speakerSubtitle": "Clorinde Nhập Vai"
				},
				{
					"id": 140340102,
					"content": "Xung quanh toát lên vẻ chẳng lành, các bạn đã cảm nhận được kẻ địch đang ở rất gần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340103
					],
					"speakerTitle": "Clorinde",
					"speakerSubtitle": "Clorinde Nhập Vai"
				},
				{
					"id": 140340103,
					"content": "(Lạ thật... Có một cảm giác không được thoải mái... Sao thế nhỉ?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340104
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 140340104,
					"content": "Tiếp theo... sẽ là thời khắc quyết chiến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340105
					],
					"speakerTitle": "Clorinde",
					"speakerSubtitle": "Clorinde Nhập Vai"
				},
				{
					"id": 140340105,
					"content": "Chúng ta đi thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340106
					],
					"speakerTitle": "Lyney",
					"speakerSubtitle": "Thợ Săn Marechaussee"
				},
				{
					"id": 140340106,
					"content": "Florian, chờ đã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340107
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340107,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340108
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340108,
					"content": "Anh ở bên ngoài chờ chúng tôi đi, đừng vào đó. Anh đã từng bị Thực Hồn Thú khống chế qua, nó rất có thể sẽ lại xâm nhập vào ý thức của anh lần nữa để khống chế anh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340109
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340109,
					"content": "Hơn nữa nếu ở gần bản thể của nó như vậy, lỡ như bị xâm chiếm thì có thể sẽ biến thành thứ gì đó khác thường đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340110
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340110,
					"content": "Chính vì như vậy nên tôi mới muốn đi... Và tôi sẽ đi tiên phong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340111
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340111,
					"content": "...! Anh định...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340112
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340112,
					"content": "Đúng vậy, tôi muốn dụ nó xâm nhập vào cơ thể của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340113
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340113,
					"content": "Như vậy quá nguy hiểm. Trong trường hợp xấu nhất thì tôi có thể buộc phải lấy mạng anh. Anh có hiểu được mức độ nghiêm trọng của việc này không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340114
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340114,
					"content": "Tôi hiểu, nhưng như vậy thì mục tiêu của mọi người sẽ rõ ràng hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340115
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340115,
					"content": "Nó sẽ không dễ dàng thoát khỏi cơ thể dễ bị điều khiển, cô cũng không cần nghĩ tới khả năng bạn đồng hành của mình bị xâm nhập.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340116
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340116,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340117
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340117,
					"content": "Clorinde, cô không giống tôi. Cô là một Thợ Săn Marechaussee mạnh mẽ và ngay thẳng. Đây là sai lầm tôi phạm phải, vậy thì cũng nên để tôi tự mình gánh chịu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340118
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340118,
					"content": "Nói cách khác... Tôi buộc phải làm như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340119
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340119,
					"content": "Cứ coi như tôi dùng danh dự của mình để quyết đấu với cô nhé. Xin đừng nương tay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340120
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340120,
					"content": "...Được, tôi hiểu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340121
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340121,
					"content": "Florian, nhân danh Đấu Sĩ Đại Diện, tôi chấp nhận yêu cầu quyết đấu của anh, và xin được tỏ lòng kính trọng đến anh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340122
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340122,
					"content": "...Cảm ơn cô.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340123
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340123,
					"content": "Đi thôi, đã đến lúc bắt tay vào công việc rồi. Hãy để ma vật run rẩy dưới lưỡi kiếm của thợ săn một lần nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clorinde"
				}
			]
		},
