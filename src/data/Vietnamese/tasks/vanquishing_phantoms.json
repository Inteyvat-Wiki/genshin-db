				},
				{
					"id": 140340303,
					"content": "Thật sao? Không để cho người khác đến xem rồi ghi nhớ tên của họ sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140340304,
					"content": "Không. Đây là lựa chọn của họ, đây chính là con đường của Thợ Săn Marechaussee.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340305
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340305,
					"content": "Cho dù là tôi thì cũng chỉ hy vọng được tiếp tục công việc với tư cách là một Đấu Sĩ Đại Diện. Tôi không mong mọi người nhớ đến thân phận Thợ Săn Marechaussee của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340306
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340306,
					"content": "Điều này thật khác với con đường của ảo thuật gia. Nhưng mà, tôi thích quyết định của Clorinde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340307
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140340307,
					"content": "Chờ đã, tôi chợt nhớ ra. Nếu không dùng hiệu ứng đặc biệt gì đó thì sao vũ khí của chúng ta lại phát sáng ở trận chiến cuối cùng vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140340308,
					"content": "Vì Thợ Săn Marechaussee trước kia sẽ thêm phép thuật khắc chế ma vật vào trong vũ khí của mình. Khi cảm nhận được ma vật thì chúng sẽ phát ra ánh sáng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340309
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340309,
					"content": "Ồ! Chẳng trách sao chúng ta đã phong ấn được nó. Tôi cứ tưởng là kỹ năng triệu hồi đã thực sự có tác dụng chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340310
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140340310,
					"content": "Chắc ít nhiều gì cũng có tác dụng đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340311
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340311,
					"content": "Ồ? Nói vậy nghĩa là sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340312
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140340312,
					"content": "Thực Hồn Thú bị phong ấn này, tôi nghĩ nó đến cùng một thời đại với những Thợ Săn Marechaussee kia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340313
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340313,
					"content": "Những cái tên mà mọi người đọc ra, đều là tên của những thợ săn anh dũng nhất đã tiêu diệt vô số đồng loại của nó. Nghe đến những cái tên này, nó rõ ràng đã hoảng sợ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340314
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340314,
					"content": "Thì ra cái tên còn có tác dụng như vậy sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140340315,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340316
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340316,
					"content": "Navia, lúc nãy khi \"Triệu Hồi\", cô nói...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340317
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340317,
					"content": "Hả? Ah—hahaha! Đó, đó là lời nói thật, à không, là lời nói thật trong kịch bản! Cô cứ nghe đi là được, đừng bảo tôi nhắc lại nữa nhé. Tôi xấu hổ lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340318
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140340318,
					"content": "Cảm ơn cô vì đã nói vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340319
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340319,
					"content": "Thôi được rồi, bạn bè với nhau mà, khách sáo làm gì chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340320
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140340320,
					"content": "À ừm... Đừng nói chuyện này nữa! Tôi đi trước đây, mọi người cũng đừng để bị bỏ lại đó nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340321
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140340321,
					"content": "Ah... Cô ấy trốn mất rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140340322,
					"content": "Vậy tôi cũng đi trước đây. Hôm nay tôi đã chứng kiến được một câu chuyện rất hấp dẫn, tôi có thể về chia sẻ cho mọi người cả đêm rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340323
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140340323,
					"content": "Hẹn gặp lại.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140340324
					]
				},
				{
					"id": 140340324,
					"content": "Ừm, hẹn khi khác gặp lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340325
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140340325,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340326
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340326,
					"content": "#{NICKNAME}... Nếu tên của {F#cô}{M#cậu} không được ai nhớ đến, chuyến hành trình của {F#cô}{M#cậu} không được ai ca tụng, vậy thì {F#cô}{M#cậu} nghĩ chuyến hành trình đó có ý nghĩa gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340327
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340327,
					"content": "(...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140340328
					]
				},
				{
					"id": 140340328,
					"content": "Cho dù không được nhớ đến, thì quãng thời gian ở cùng bạn bè sẽ luôn có ý nghĩa. Tương lai mà tôi cùng những người bạn đồng hành tạo nên cũng sẽ có ý nghĩa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140340329
					]
				},
				{
					"id": 140340329,
					"content": "...Câu trả lời hay lắm. Tôi sẽ ghi nhớ lấy nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340330
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340330,
					"content": "Vậy cô nghĩ sao về điều đó?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140340331
					]
				},
				{
					"id": 140340331,
					"content": "Tôi sao? Hah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340332
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340332,
					"content": "\"Về vấn đề này, Thợ Săn Marechaussee đó đã không nói thêm gì nữa.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340333
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340333,
					"content": "\"Hãy để màn đêm thanh vắng trả lời thay cho cô ấy vậy...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clorinde"
				}
			]
		}
	]
}