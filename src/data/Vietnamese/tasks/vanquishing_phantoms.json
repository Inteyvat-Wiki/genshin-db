			"dialogs": [
				{
					"id": 140340201,
					"content": "Thế là, ma vật đã bị hạ gục, phù thủy đã bị đánh bại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340202
					],
					"speakerTitle": "Clorinde",
					"speakerSubtitle": "Clorinde Nhập Vai"
				},
				{
					"id": 140340202,
					"content": "Sau đó, vương thành lại chào đón những ngày tháng hòa bình. Những quan thần bị mê hoặc kia cũng đã thấy được tội lỗi mà mình phạm phải...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340203
					],
					"speakerTitle": "Clorinde",
					"speakerSubtitle": "Clorinde Nhập Vai"
				},
				{
					"id": 140340203,
					"content": "Có người đã nhớ tên của những vị anh hùng đó, họ đã cứu lấy đất nước này... Tất nhiên cũng sẽ có người đã tiếp tục cuộc sống của mình mà chẳng biết gì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340204
					],
					"speakerTitle": "Clorinde",
					"speakerSubtitle": "Clorinde Nhập Vai"
				},
				{
					"id": 140340204,
					"content": "Và đây chính là câu chuyện về Thợ Săn Marechaussee. Họ truy lùng những bóng ma và xua đuổi chúng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340205
					],
					"speakerTitle": "Clorinde",
					"speakerSubtitle": "Clorinde Nhập Vai"
				},
				{
					"id": 140340205,
					"content": "Dù mọi người có ghi nhớ hay không thì họ vẫn sẽ luôn bảo vệ thành phố này, bảo vệ cuộc sống của mọi người...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340206
					],
					"speakerTitle": "Clorinde",
					"speakerSubtitle": "Clorinde Nhập Vai"
				},
				{
					"id": 140340206,
					"content": "Phù... Vậy đây xem như là kết thúc của câu chuyện rồi nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340207
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 140340207,
					"content": "Ừm, mọi người đã có được một cái kết tốt đẹp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340208
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340208,
					"content": "Câu chuyện rất hay. Lúc đầu cứ tưởng chỉ là một câu chuyện phiêu lưu bình thường thôi, nhưng càng đến cuối thì lại càng cảm thấy nó được thiết kế rất tài tình và chỉn chu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340209
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 140340209,
					"content": "Đặc biệt là trận quyết chiến cuối cùng đó, làm y như thật vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340210
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 140340210,
					"content": "À ừm... Đúng vậy, haha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340211
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140340211,
					"content": "Ah... Đúng là không ngờ món vũ khí mà chúng ta lấy được từ chỗ \"kho báu\" đó lại có tác dụng như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340212
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140340212,
					"content": "Đúng vậy, khi chúng phát sáng trên tay còn làm tôi giật mình nữa chứ. Vừa rồi tôi nghiên cứu lại nhưng không thấy nó phát sáng nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340213
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 140340213,
					"content": "À, số vũ khí này đều là đạo cụ, nên sẽ bị thu hồi đúng không? Tôi đặt ở đây nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340214
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 140340214,
					"content": "Furina chơi có vui không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340215
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340215,
					"content": "Đương nhiên rồi. Lần sau nếu có kịch bản nào khác thì nhớ gọi tôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340216
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 140340216,
					"content": "Được, không thành vấn đề.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340217
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340217,
					"content": "Vậy tôi về trước đây. Tôi vẫn còn muốn chiêm nghiệm thêm trên đường đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340218
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 140340218,
					"content": "Khi nào Florian tỉnh lại thì hãy chuyển lời chào của tôi đến cho anh ấy nhé. Vất vả cho anh ấy thật, chắc cũng mệt quá nên ngủ mất rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340219
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 140340219,
					"content": "Cô nói đúng, anh ấy đã vất vả rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340220
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340220,
					"content": "Ừm, khi khác chúng ta lại gặp nhau nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340221
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 140340221,
					"content": "Bây giờ... Tôi hỏi được rồi chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340222
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140340222,
					"content": "Tôi nghĩ chắc là được rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340223
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140340223,
					"content": "Chuyện này rốt cuộc là thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340224
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140340224,
					"content": "...Thì ra mọi người đã phát hiện rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340225
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340225,
					"content": "Ahaha... Cảnh nhắm mắt trong hang động... Rất khó để chúng tôi không chú ý xung quanh đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340226
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140340226,
					"content": "Tôi cố nhịn đến bây giờ mới hỏi! Do Clorinde xem như không có chuyện gì xảy ra, và Furina có vẻ như cũng không hề nhận ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340227
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140340227,
					"content": "Có vẻ như không ai trong chúng ta muốn vén bức màn này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340228
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140340228,
					"content": "Ể? Mọi người đang nói gì đó?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340229,
						140340231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140340229,
					"content": "Mọi người đang nói gì đó?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140340230
					]
				},
				{
					"id": 140340230,
					"content": "#Sao! Thì ra {F#cô}{M#cậu} cũng...! A... Xin lỗi xin lỗi, bây giờ {F#cô}{M#cậu} bịt tai lại cũng còn kịp đó! Hay là để tôi giúp {F#cô}{M#cậu} bịt cho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340233
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140340233,
					"content": "Chuyện này... Có hơi muộn rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340234
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140340234,
					"content": "Hả? Chẳng lẽ ý mọi người là... Những chuyện vừa rồi không phải là tình tiết được sắp đặt sẵn trong kịch bản sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340235
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140340235,
					"content": "Nói cách khác là ngay từ đầu, đây không phải là một Đoàn Kịch Trên Bàn bình thường rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340236
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340236,
					"content": "Haaaaaả!!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340237
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140340237,
					"content": "Ồn quá... Nhức đầu quá đi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340238
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340238,
					"content": "Anh mau đứng dậy nào! Chuyện này rốt cuộc là sao đây!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340239
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140340239,
					"content": "Ahhhhh! Đừng, đừng lắc nữa! Đầu tôi...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340240
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340240,
					"content": "Florian giải thích đầu đuôi câu chuyện cho mọi người nghe...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						140340241
					]
				},
				{
					"id": 140340241,
					"content": "Tôi, tôi không nghe nhầm đó chứ? Mọi người đã bịa ra nửa sau của kịch bản ngay tại hiện trường sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340242
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140340242,
					"content": "Việc nói dối tuy là rất đáng ghét, nhưng câu chuyện của Florian cũng rất tốt. Khả năng ứng biến của Clorinde cũng vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340243
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140340243,
					"content": "Cứ như ảo thuật gia lên sân khấu đã phát hiện ra mình quên mang đạo cụ, nhưng vẫn tạo ra được một màn ảo thuật hấp dẫn khác để thay thế vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340244
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140340244,
					"content": "Nếu tôi biết kho báu có vấn đề, thì chắc đã sợ chết khiếp và quay đầu bỏ chạy rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340245
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140340245,
					"content": "Mọi thứ đều không vượt ngoài tầm kiểm soát đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340246
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340246,
					"content": "Cái đối với cô mà nói là không vượt ngoài tầm kiểm soát, nhưng lại có thể hù người ta sợ chết khiếp đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340247
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140340247,
					"content": "Chắc tại tôi quen rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340248
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340248,
					"content": "Chậc... Cuộc sống của cô thú vị thật... Thảo nào khi làm quản trò thì trường hợp nào cô cũng ứng phó được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340249
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140340249,
					"content": "Còn về Florian...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340250
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340250,
					"content": "...Tôi không có gì để phản bác. Tôi sẽ đến chỗ đội hiến binh để khai rõ tội lỗi của mình và chấp nhận hình phạt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340251
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340251,
					"content": "Tôi thì nghĩ là anh đã bị trừng phạt đủ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340252
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340252,
					"content": "...Sao cơ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340253
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340253,
					"content": "Tuy ban đầu bị danh lợi làm cho mù quáng, nhưng hành vi trong trận quyết chiến của anh đã chứng tỏ anh là một Thợ Săn Marechaussee đủ tiêu chuẩn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340254
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340254,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340255
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340255,
					"content": "Đối với thành phố này, việc anh tiếp tục làm tốt công việc của Thợ Săn Marechaussee có lẽ còn quan trọng hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340256
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340256,
					"content": "Nhưng mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340257
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340257,
					"content": "Tất nhiên, anh phải mang chìa khóa đi trả và xin lỗi hai Thợ Săn Marechaussee kia, đồng thời cũng phải chấp nhận điều kiện đền bù mà họ đưa ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340258
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340258,
					"content": "...Tôi hiểu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340259
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340259,
					"content": "Ngoài ra... Anh cũng đã chứng minh được danh dự của mình trong trận \"quyết đấu\" với tôi rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340260
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340260,
					"content": "...! Được... Tôi sẽ làm theo lời cô nói. Tôi... Tôi sẽ đem trả lại hai chiếc chìa khóa đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340261
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340261,
					"content": "Cảm ơn mọi người. Tôi sẽ không lãng phí cơ hội thứ hai mà mọi người đã trao cho tôi đâu. Tôi xin thề với tư cách là một Thợ Săn Marechaussee.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340262
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340262,
					"content": "Vậy thì... Hẹn gặp lại nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340231,
					"content": "Thực ra tôi cũng phát hiện rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140340232
					]
				},
				{
					"id": 140340232,
					"content": "Sao! Thì ra Paimon cũng không phát hiện ra sao? A... Xin lỗi xin lỗi, bây giờ Paimon bịt tai lại cũng còn kịp đó! Hay là để tôi giúp Paimon bịt cho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340233
					],
					"speakerTitle": "Navia"
				}
			]
		},
