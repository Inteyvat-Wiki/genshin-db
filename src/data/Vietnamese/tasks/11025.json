				"points": []
			},
			"dialogs": [
				{
					"id": 110240301,
					"content": "Tôi vẫn muốn ở đây thêm một chút, sau này e là sẽ ngày càng ít có những dịp hồi tưởng lại như thế này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240302,
						110240305,
						110240308
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110240302,
					"content": "\"Ma Thần Muối\", có chút đáng thương...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110240303
					]
				},
				{
					"id": 110240303,
					"content": "Vào thời kỳ chiến tranh ma thần, tiêu chuẩn đánh giá thiện ác đúng sai khác với bây giờ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240304
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110240304,
					"content": "Đương nhiên là tôi cũng hy vọng rằng cô ấy có thể sinh ra trong một thời đại dịu dàng hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110240305,
					"content": "Di vật sẽ tăng sức mạnh của Osial sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110240306
					]
				},
				{
					"id": 110240306,
					"content": "Tuy \"hũ muối\" và \"thước muối\" cũng có quyền năng, nhưng nó chẳng đáng là gì đối với Osial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240307
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110240307,
					"content": "Nếu có một ngày hắn hồi phục nguyên khí, ngóc đầu trở lại... ha, chắc chắn sẽ bị đánh bại lần nữa thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110240308,
					"content": "Vậy bây giờ anh dự định làm gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110240309
					]
				},
				{
					"id": 110240309,
					"content": "#Câu hỏi hay đấy, nếu là trước kia, có lẽ tôi sẽ cho {F#cô}{M#cậu} câu trả lời vô cùng chi tiết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240310
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110240310,
					"content": "Nhưng hiện giờ... ừm, đại khái là muốn tiếp tục làm tròn chức trách một vị khách khanh của Vãng Sinh Đường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240311
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110240311,
					"content": "#Nhưng nếu {F#cô}{M#cậu} tìm được niềm vui trong hành trình lần này, thì chi bằng chúng ta vẫn tiếp tục đồng hành trong lần \"ghi chép\" tiếp theo đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				}
			]
		}
	]
}