			"dialogs": [
				{
					"id": 706970101,
					"content": "#{NICKNAME}! Không ngờ lại gặp {F#cô}{M#cậu} ở Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970102
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706970102,
					"content": "Đây là lần đầu tiên tôi đến một nơi lạnh như này, toàn bộ trải nghiệm đều rất mới mẻ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970103
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706970103,
					"content": "Chơi ném tuyết, nặn người tuyết, à phải rồi, còn cả truyện tranh nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970104
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706970104,
					"content": "Thật không ngờ, bộ truyện \"Chiến Ký Đấu Sĩ Lửa\" thịnh hành ở Inazuma lại cũng có độc giả ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970105
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706970105,
					"content": "Tôi đã có cuộc trò chuyện thú vị về truyện tranh với mấy người bạn đến từ Natlan, rồi bỗng ngứa tay nên đã làm luôn bảng mô hình nhân vật trong truyện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970106
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706970106,
					"content": "#À phải rồi, {F#cô}{M#cậu} có nghe qua \"Chiến Ký Đấu Sĩ Lửa\" chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970107
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706970107,
					"content": "Trò chuyện với Yoimiya về chuyện \"Đội Đặc Nhiệm Đấu Sĩ Lửa\"...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						706970108
					]
				},
				{
					"id": 706970108,
					"content": "#Thật trùng hợp khi bạn của {F#cô}{M#cậu} cũng thích bộ truyện này, đúng là một cơ duyên kỳ diệu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970109
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706970109,
					"content": "Vậy tặng mọi người bảng mô hình này nhé! Đấu Sĩ Lửa Fietena, rất hợp với \"Đội Đặc Nhiệm Đấu Sĩ Lửa\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				}
			]
		}
