			"dialogs": [
				{
					"id": 200690201,
					"content": "Hoa như thế nào rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690202
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690202,
					"content": "Đã chôn xong rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690203
					]
				},
				{
					"id": 200690203,
					"content": "Cám ơn bạn nhé, vậy cứ để chúng ở trên núi tuyết một chút xem sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690204
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690204,
					"content": "Hu hu, cảm ơn bạn đã giúp đỡ, hãy nhận lấy số thù lao này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690205
					],
					"speakerTitle": "Flora"
				}
			]
		},
