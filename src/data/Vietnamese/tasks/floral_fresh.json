					"speakerTitle": "Flora"
				},
				{
					"id": 200690317,
					"content": "Anh ấy còn nói, nếu muốn thử nghiệm, thì môi trường nhiệt độ thấp của ngọn núi tuyết gần đây sẽ rất thích hợp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690318
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690318,
					"content": "Nhưng tôi nghe nói trên núi nguy hiểm lắm, trong nhất thời cũng không tìm được Nhà Mạo Hiểm nào chịu giúp đỡ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690319
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690319,
					"content": "Nhà Lữ Hành, bạn có thể giúp tôi mang ba hộp hoa này vùi trong núi tuyết được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690320,
						200690321
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690320,
					"content": "Cứ để tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690322
					]
				},
				{
					"id": 200690322,
					"content": "Cám ơn bạn đã đồng ý giúp tôi, để tôi nghĩ xem... nghe nói núi tuyết rất lớn, cũng như có nhiều khu vực khác nhau, hiệu quả bảo quản chắc cũng sẽ khác nhau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690323
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690323,
					"content": "Ưm, vẫn nên so sánh hiệu quả với nhau thì tốt hơn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690324
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690324,
					"content": "Nhờ bạn giúp tôi lần lượt đặt những đóa hoa này ở <color=#00E1FFFF>cạnh Thất Thiên Thần Tượng</color>, <color=#00E1FFFF>cửa vào của một hang động trên núi tuyết</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690325
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690325,
					"content": "Sau đó <color=#00E1FFFF>tìm một vùng nước trong núi tuyết</color>...ao hồ gì cũng được, rồi đặt một hộp hoa ở bờ hồ nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690326
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690326,
					"content": "Lần này nhờ bạn cẩn thận giúp tôi nha, đừng làm hỏng chúng đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690321,
					"content": "Muốn vùi ở đâu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690322
					]
				},
				{
					"id": 200690311,
					"content": "Bán hết trong ngày thì tốt rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690312
					]
				},
				{
					"id": 200690312,
					"content": "Đương nhiên rồi, nhưng ngày nào cũng có một hai nhánh hoa không ai mua cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690313
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690313,
					"content": "Tuy chỉ có một hai nhánh, nhưng tôi cũng không muốn chúng bị héo một cách phí phạm như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690314
					],
					"speakerTitle": "Flora"
				}
			]
		},
