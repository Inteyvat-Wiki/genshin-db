			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Flora"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200690101,
					"content": "Những bông hoa này nhìn ủ rũ quá, thật đáng tiếc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690102
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690102,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690103
					]
				},
				{
					"id": 200690103,
					"content": "Vì thường có người đến đây mua hoa tươi để tặng, nên mỗi ngày tôi đều cắt sẵn hoa để dành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690104
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690104,
					"content": "Nhưng những bông hoa đã cắt đó không giữ được bao lâu, nếu không bán hết trong ngày sẽ héo khô hết...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690105
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690105,
					"content": "Tuy tôi đã thử rất nhiều cách, nhưng sau một ngày, đa phần hoa đều không còn đẹp để ngắm nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690106
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690106,
					"content": "Rốt cuộc có cách nào giữ hoa tươi lâu hơn không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690107,
						200690111
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690107,
					"content": "Dùng cách bảo quản thức ăn...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690108
					]
				},
				{
					"id": 200690108,
					"content": "Tôi nghe Người Săn Hươu Sara nói, họ sẽ để thức ăn chưa dùng hết ở nơi mát mẻ, hoặc dùng khối băng để bảo quản...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690109
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690109,
					"content": "Trước kia tôi cũng đã từng thử cách này. Nhưng dùng trực tiếp khối băng để bảo quản, thì không biết tại sao màu sắc cũng như hình dáng của hoa lại trở nên vô cùng kỳ cục.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690110
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690110,
					"content": "Không phải héo, cũng không còn tươi, nhưng nói chung là không ngắm được nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690114
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690114,
					"content": "Tôi đã hỏi rất nhiều người, sau đó thì Sayid... bạn biết người đó không? Là người học giả đó đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690115
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690115,
					"content": "Có một hôm anh ấy đến mua hoa, và nói với tôi rằng, anh ấy đã từng đọc được một cách \"đông lạnh hoa\" trong sách.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690116
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690116,
					"content": "Cụ thể là, dùng một cái bình đựng hoa, rồi đặt nó ở gần tảng băng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690117
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690117,
					"content": "Anh ấy còn nói, nếu muốn thử nghiệm, thì môi trường nhiệt độ thấp của ngọn núi tuyết gần đây sẽ rất thích hợp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690118
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690118,
					"content": "Nhưng tôi nghe nói trên núi nguy hiểm lắm, trong nhất thời cũng không tìm được Nhà Mạo Hiểm nào chịu giúp đỡ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690119
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690119,
					"content": "Nhà Lữ Hành, bạn có thể giúp tôi mang ba hộp hoa này vùi trong núi tuyết được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690120,
						200690121
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690120,
					"content": "Cứ để tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690122
					]
				},
				{
					"id": 200690122,
					"content": "Cám ơn bạn đã đồng ý giúp tôi, để tôi nghĩ xem... nghe nói núi tuyết rất lớn, cũng như có nhiều khu vực khác nhau, hiệu quả bảo quản chắc cũng sẽ khác nhau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690123
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690123,
					"content": "Ưm, vẫn nên so sánh hiệu quả với nhau thì tốt hơn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690124
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690124,
					"content": "Nhờ bạn giúp tôi lần lượt đặt những đóa hoa này ở <color=#00E1FFFF>cạnh Thất Thiên Thần Tượng</color>, <color=#00E1FFFF>bờ hồ trên núi</color> với lại...<color=#00E1FFFF>cửa vào hang động</color> trên núi tuyết nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690121,
					"content": "Muốn vùi ở đâu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690122
					]
				},
				{
					"id": 200690111,
					"content": "Bán hết trong ngày thì tốt rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690112
					]
				},
				{
					"id": 200690112,
					"content": "Đương nhiên rồi, nhưng ngày nào cũng có một hai nhánh hoa không ai mua cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690113
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690113,
					"content": "Tuy chỉ có một hai nhánh, nhưng tôi cũng không muốn chúng bị héo một cách phí phạm như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690114
					],
					"speakerTitle": "Flora"
				}
			]
		},
