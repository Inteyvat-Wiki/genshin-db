			"dialogs": [
				{
					"id": 200360301,
					"content": "Bạn đã làm xong chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360302
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360302,
					"content": "Gió trên đỉnh thật mạnh...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200360303
					]
				},
				{
					"id": 200360303,
					"content": "Như vậy mới tốt, có thể đem bồ công anh bay xa hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360304
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360304,
					"content": "Như vậy, nói không chừng Godwin có thể nhận được, những lời tôi nói với anh ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360305
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360305,
					"content": "Bạn đưa tay ra, để tôi chạm được... hãy cầm lấy, đây là quà cảm ơn của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360306
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360306,
					"content": "Tôi còn có rất nhiều lời muốn nói với Godwin, sau này, nói không chừng còn phải làm phiền bạn nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Glory"
				}
