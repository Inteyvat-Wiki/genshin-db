			"dialogs": [
				{
					"id": 200360201,
					"content": "Bạn về rồi, thu thập được Bồ Công Anh chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360202
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360202,
					"content": "Đã đủ cả rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200360203
					]
				},
				{
					"id": 200360203,
					"content": "Cám ơn bạn, hãy đặt hạt Bồ Công Anh vào tay tôi, được không? Tôi không nhìn thấy, sợ làm nó rớt mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360204
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360204,
					"content": "Nhiêu đây đủ chưa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200360205
					]
				},
				{
					"id": 200360205,
					"content": "Hãy đặt hạt bồ công anh vào tay tôi trước đã, như vậy tôi mới cảm nhận được nó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360206
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360206,
					"content": "Nhiêu đây đủ rồi, tôi phải nói với chúng những điều muốn gửi đến Godwin mới được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360207
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360207,
					"content": "Ồ... bạn hãy bịt tai lại, đừng nghe lén, đây là lời tình tứ của những người yêu nhau. Bạn chắc cũng... hihi, bạn đã có qua cảm giác này chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360208
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360208,
					"content": "Được rồi. Bạn hãy đem những hạt bồ công anh này đến tượng Phong Thần, sau đó đem nó rải vào không trung, để cho Phong Thần đại nhân đem chúng đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360209
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360209,
					"content": "Hy vọng Phong Thần đại nhân, có thể đem nó đến bên cạnh Godwin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Glory"
				}
			]
		},
