				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200360101,
					"content": "...Godwin... rốt cuộc đến khi nào mới có thể quay lại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360102
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360102,
					"content": "Xin chào...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200360103
					]
				},
				{
					"id": 200360103,
					"content": "Giọng nói này... là Nhà Lữ Hành đến từ phương xa phải không? Cám ơn Phong Thần đại nhân, nhất định là ngọn gió của ngài ấy đưa bạn đến đây... bạn hãy nghe thỉnh cầu của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360104
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360104,
					"content": "Bạn trai... của tôi, kỵ sĩ Tây Phong Godwin đã rời khỏi Mondstadt rất lâu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360105
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360105,
					"content": "Lâu như vậy rồi, tôi cũng không nhận được tin tức của anh ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360106
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360106,
					"content": "Tôi rất lo cho Godwin. Anh ấy phải chiến đấu với đám Hilichurl phiền phức, còn có Giáo Đoàn Vực Sâu mà anh ấy từng nhắc đến với tôi, nếu anh ấy bị thương thì phải làm sao, mà đã lâu vậy rồi, nếu anh ấy gặp được nữ kỵ sĩ dịu dàng nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360107
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360107,
					"content": "Xin, xin lỗi! Tôi lảm nhảm nhiều quá! Tôi nghe mẹ nói, Bồ Công Anh có thể mang theo tâm niệm của con người, được gió đưa đến nơi xa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360108
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360108,
					"content": "Cho nên việc thỉnh cầu của tôi là... có thể phiền bạn đi đến Phong Khởi Địa thu thập 3 hạt bồ công anh không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360109,
						200360110
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360109,
					"content": "Không thành vấn đề.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200360111
					]
				},
				{
					"id": 200360111,
					"content": "Cám ơn bạn, mong Phong Thần bảo vệ bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360110,
					"content": "Còn có việc khác.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200360112
					]
				},
				{
					"id": 200360112,
					"content": "Đợi chút! Năn nỉ bạn, với Nhà Lữ Hành như bạn mà nói, đây chỉ là việc nhỏ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Glory"
				}
			]
		},
