			"dialogs": [
				{
					"id": 120200401,
					"content": "Haiz, không biết đại nhân Sangonomiya nghĩ cái gì, tại sao lại chấp nhận đàm phán hòa bình chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200402
					],
					"speakerTitle": "Yoshihisa"
				},
				{
					"id": 120200402,
					"content": "Đúng vậy... đám người của Hiệp Hội Tenryou vốn không đáng tin, tôi còn nghe nói chúng âm thầm cấu kết với Fatui, muốn đánh trả lại chúng ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200403
					],
					"speakerTitle": "Tsuneo"
				},
				{
