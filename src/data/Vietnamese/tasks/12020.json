						120200509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120200509,
					"content": "Ở đây hình như xảy ra chuyện gì rồi, mau đến xem thử xem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120200510,
					"content": "Báo cáo đại nhân Sangonomiya, tên thương nhân này hành tung khả nghi, đã bị tôi tóm được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200511
					],
					"speakerTitle": "Matsuda"
				},
				{
					"id": 120200511,
					"content": "Theo quan sát của chúng tôi, tên này chỉ mua mà không bán trong một thời gian dài, nhưng hàng hóa bên cạnh lại không thấy đâu, rất có khả năng đã được chuyển đến Hiệp Hội Tenryou rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200512
					],
					"speakerTitle": "Matsuda"
				},
				{
					"id": 120200512,
					"content": "Tôi... tôi không có...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200513
					],
					"speakerTitle": "Naruse"
				},
				{
					"id": 120200513,
					"content": "Được rồi. Mọi người bình tĩnh lại, nghe theo lời tôi bảo, hít một hơi thật sâu... thế nào... đỡ hơn chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200514
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120200514,
					"content": "Matsuda, Uchimura, tôi biết là các anh lo cho sự an toàn của Đảo Watatsumi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200515
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120200515,
					"content": "Nhưng mà, trước tiên không cần biết là vị tiên sinh này có phạm lỗi hay không, ít nhất thì cũng cho người ta một cơ hội để giải thích đã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200516
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120200516,
					"content": "Có tội thì đương nhiên sẽ xử, còn vô tội thì không được đổ oan. Trên Đảo Watatsumi cần phải tôn trọng sự công bằng, không thể phán quyết bừa bãi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200517
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120200517,
					"content": "Vị thương nhân này, anh có thể giải thích cho chúng tôi nghe về chuyện hàng hóa không, để tiện cho chúng tôi ra phán quyết!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200518
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120200518,
					"content": "Được, đương nhiên là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200519
					],
					"speakerTitle": "Naruse"
				},
				{
					"id": 120200519,
					"content": "Tôi làm ăn trên Đảo Watatsumi, cũng đã tích lũy được một lô hàng. Tôi vốn muốn tích trữ thêm một lúc để bán cho được giá... Haiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200520
					],
					"speakerTitle": "Naruse"
				},
				{
					"id": 120200520,
					"content": "Không ngờ rằng, đám Fatui đó đã cướp hàng của tôi! Bị cướp đã khổ rồi, còn bị các vị đổ oan cho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200521
					],
					"speakerTitle": "Naruse"
				},
				{
					"id": 120200521,
					"content": "Hừ, ai mà biết được lời ngươi nói có đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200522,
						120200523
					],
					"speakerTitle": "Uchimura"
				},
				{
					"id": 120200522,
					"content": "Trên đường chúng tôi đến...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120200524
					]
				},
				{
					"id": 120200524,
					"content": "Nhưng điều đó không thể chứng minh được hàng hóa của hắn là bị đám Fatui cướp!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200525
					],
					"speakerTitle": "Uchimura"
				},
				{
					"id": 120200525,
					"content": "Hơn nữa, Hiệp Hội Tenryou và Fatui đã cấu kết với nhau! Hắn đưa hàng cho Fatui thì có khác gì đưa cho Hiệp Hội Tenryou chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200526
					],
					"speakerTitle": "Uchimura"
				},
				{
					"id": 120200526,
					"content": "Sao? Hiệp Hội Tenryou và Fatui đã cấu kết với nhau sao? Thông tin này từ đâu mà đến thế, tôi hoàn toàn không biết!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200527
					],
					"speakerTitle": "Naruse"
				},
				{
					"id": 120200527,
					"content": "Hơn nữa, dù giữa bọn họ có cấu kết với nhau thì cũng đâu có liên quan gì đến tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200528
					],
					"speakerTitle": "Naruse"
				},
				{
					"id": 120200528,
					"content": "Chiến tranh cũng kết thúc rồi, Hiệp Hội Tenryou làm gì còn móc nối với Fatui nữa chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200529
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120200529,
					"content": "Trước đó không lâu chính chúng tôi còn gặp cả gia chủ nhà Kujou, giờ đây hắn có lẽ đã không còn làm chuyện đáng xấu hổ này nữa đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200530
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120200530,
					"content": "Mà hình như những người lính ban nãy cũng đang bàn về chuyện này... Kokomi, cô biết chuyện này chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200531
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120200531,
					"content": "Tôi đúng là có nghe qua trong báo cáo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200532
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120200532,
					"content": "Nhưng không lâu sau chúng tôi sẽ đàm phán với Hiệp Hội Tenryou. Lần đàm phán này do chính nhà Kamisato với danh nghĩa phe trung lập đứng ra tổ chức.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200533
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120200533,
					"content": "Tôi và Kujou Sara sẽ dẫn theo một số thị vệ để thương lượng kế hoạch cho sau này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200534
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120200534,
					"content": "Nhưng trong thời khắc quan trọng này, tôi lại nghe thấy một số tin đồn, nói rằng nhà Kujou vẫn đang móc nối với Fatui, họ muốn toàn lực hủy diệt Đảo Watatsumi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200535
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120200535,
					"content": "Nếu như là vậy thì cuộc đàm phán này chính là cái bẫy, có khả năng nhà Kamisato cũng đã tham gia dàn xếp...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200536
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120200536,
					"content": "Vị thương nhân này, anh có chắc là hàng hóa của anh đã bị Fatui cướp đi không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200537
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120200537,
					"content": "Đương nhiên là thật rồi, hãy tin tôi! Bọn Fatui sau khi cướp xong đã chạy về phía kia, rất có thể chúng có căn cứ bí mật ở gần đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200538
					],
					"speakerTitle": "Naruse"
				},
				{
					"id": 120200538,
					"content": "Vậy thì tốt, sự việc này quan trọng, hay là để chúng tôi giúp anh lấy lại hàng hóa về nhé. Nếu như mọi thứ đều thuận lợi thì anh sẽ được chứng minh sự trong sạch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200539
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120200539,
					"content": "Nhưng nếu Fatui thực sự có liên quan đến Hiệp Hội Tenryou, thì tôi cũng hy vọng anh phối hợp điều tra nhé, anh thấy thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200540
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120200540,
					"content": "Tôi đồng ý, cảm ơn đại nhân Sangonomiya đã ra tay tương trợ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200541
					],
					"speakerTitle": "Naruse"
				},
				{
					"id": 120200541,
					"content": "Matsuda, Uchimura, còn các anh thì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200542
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120200542,
					"content": "Chúng tôi hoàn toàn nghe theo sự sắp xếp của đại nhân Sangonomiya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200543
					],
					"speakerTitle": "Matsuda"
				},
				{
					"id": 120200543,
					"content": "#Vậy thì tốt. {NICKNAME}... à không, đội trưởng Đội Cá Kiếm 2, có thể cùng tôi đi điều tra chuyện này không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200544,
						120200547
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120200544,
					"content": "Đương nhiên là được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120200545
					]
				},
				{
					"id": 120200545,
					"content": "Haha... vậy thì để tôi xem thử, xem xem bạn có trưởng thành hơn so với trước đây không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200546
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120200546,
					"content": "Tôi cũng sẽ hướng dẫn bạn một số thứ thuộc về sở trường của tôi... đi theo tôi nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120200547,
					"content": "Tuân lệnh!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120200548
					]
				},
				{
					"id": 120200548,
					"content": "Haha... không cần nghiêm túc thế. Dù sao thì bây giờ cũng là thời bình rồi mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200549
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120200549,
					"content": "Huống chi bạn cũng không ở lại Đảo Watatsumi lâu... Cứ xem tôi như bạn bè là được rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120200523,
					"content": "Đúng là có thấy Fatui...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120200524
					]
				}
			]
		},
		{
			"id": 1202006,
			"completionStepIds": [
				1202009
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1202009",
							"2"
						],
						"stepId": 1202009,
						"stateName": "QUEST_STATE_UNFINISHED"
