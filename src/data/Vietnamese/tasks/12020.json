			"dialogs": [
				{
					"id": 120200501,
					"content": "Nói! Có phải ngươi đã lén lén mua hàng hóa từ Đảo Watatsumi để chuyển cho Hiệp Hội Tenryou không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200502
