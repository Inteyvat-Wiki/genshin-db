					"Gorou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120200101,
					"content": "May mà các bạn ở đây, không thôi thì bọn chúng đã xổng mất rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200102
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 120200102,
					"content": "Trong tay bạn là túi gấm của Kokomi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120200103,
					"content": "Để tôi xem...! Dày thật đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120200104,
					"content": "Thực ra ngoài chỗ này ra, trên người tôi còn có 5 cái nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200105
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 120200105,
					"content": "Nhiều thế!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120200106,
					"content": "Đại nhân Sangonomiya trước giờ chưa bao giờ tính sai, cho nên những túi gấm này hơi bị nhiều chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200107
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 120200107,
					"content": "Nhưng cũng may nhờ có những túi gấm này mà chúng tôi mới ứng phó được nhiều tình huống phức tạp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200108
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 120200108,
					"content": "Nhiều túi gấm như thế, Kokomi đã phải viết bao lâu nhỉ. Mỗi một tình huống đều phải suy nghĩ, nghĩ đến thôi cũng thấy đau hết cả đầu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120200109,
					"content": "Đội trưởng lần này về Đảo Watatsumi là để tiếp quản lại Đội Cá Kiếm 2 đúng không? Chúng tôi nhớ đội trưởng lắm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200110,
						120200111
					],
					"speakerTitle": "Koutoku"
				},
				{
					"id": 120200110,
					"content": "Đội Cá Kiếm 2 vẫn còn sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120200112
					]
				},
				{
					"id": 120200112,
					"content": "Đại nhân Sangonomiya nói bây giờ đã là thời bình, cho nên quân số trong đội phải giảm lại để giúp đỡ người dân hồi phục sản xuất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200113
					],
					"speakerTitle": "Koutoku"
				},
				{
					"id": 120200113,
					"content": "Một nửa binh sĩ vẫn đang duy trì tình trạng sẵn sàng để hỗ trợ cho các tiểu đội khác, còn một nửa thì chuyển sang các công việc như tuần tra, tu sửa, trồng trọt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200114
					],
					"speakerTitle": "Koutoku"
				},
				{
					"id": 120200114,
					"content": "Hai ngày trước tôi nghe thấy đồng đội phản ánh rằng họ không muốn được chuyển đi làm thợ xây, họ muốn ở lại tiền tuyến để chiến đấu hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200115
					],
					"speakerTitle": "Koutoku"
				},
				{
					"id": 120200115,
					"content": "Mọi người trong quân kháng chiến vẫn như vậy nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120200116,
					"content": "Đúng rồi! Nói ra thì Kokomi có gọi chúng tôi đến để tham dự lễ ban thưởng. Gorou, bạn có biết Kokomi đang ở đâu không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120200117,
					"content": "Đại nhân Sangonomiya có lẽ đang ở Làng Bourou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200118
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 120200118,
					"content": "Nghe nói ở đó xảy ra chuyện gì đó nên đích thân đại nhân Sangonomiya đến đó xử lý rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200119
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 120200119,
					"content": "#Chúng ta cũng phải đi thôi... À, {NICKNAME}, bạn tiện thể thăm hỏi các binh sĩ trên đường nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200120
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 120200120,
					"content": "Gần đây tôi có cảm giác không ít binh sĩ đột nhiên trở nên nóng nảy, nhưng tôi không biết tại sao, họ lại không muốn nói cho tôi nghe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200121
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 120200121,
					"content": "Trước đây ai có phiền não gì cũng đều nói với tôi cả, nhưng giờ thấy họ cứ giấu giếm sao sao ấy... Tôi lo rằng họ gặp phải vấn đề gì đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200122,
						120200123
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 120200122,
					"content": "Để tôi thử xem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120200124
					]
				},
				{
					"id": 120200124,
					"content": "Đúng vậy, chúng tôi cũng muốn hàn huyên với các binh sĩ kháng chiến!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120200125,
					"content": "#Vậy thì chúng ta xuất phát thôi {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120200123,
					"content": "Tôi tiện thể đi thăm các đồng đội cũ luôn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120200124
					]
				},
				{
					"id": 120200111,
					"content": "Mọi người dạo này thế nào rồi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120200112
					]
				}
			]
		},
