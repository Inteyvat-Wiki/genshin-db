				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Gorou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120200601,
					"content": "Đây hình như là nơi hẹn với Kokomi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120200602,
					"content": "Nhà lữ hành, bạn còn nhớ ở đây chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120200603,
					"content": "Lần trước khi đến Đảo Watatsumi, chúng ta hình như đã đi qua chỗ này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120200604,
					"content": "Lúc đó, bạn còn được thăng chức đội trưởng Đội Cá Kiếm 2 nữa. Không biết lâu như vậy rồi các binh sĩ có còn nhớ bạn không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120200605,
					"content": "Trên Đảo Watatsumi có lẽ đã thay đổi rất nhiều! Hay là chúng ta đi xung quanh xem thử nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200627
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120200627,
					"content": "Ủa, đó không phải là Gorou sao? Chúng ta qua đó xem thử đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120200606,
					"content": "\"Kẻ địch đông đảo, tìm cách đột phá; Phe ta đông đảo, cần phải toàn thắng...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200607
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 120200607,
					"content": "\"Kẻ địch trên biển, ắt sẽ có thuyền; Phá hủy thuyền chiến, ắt sẽ thành công...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200608
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 120200608,
					"content": "Đại nhân Gorou, đã có kết luận gì chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200609
					],
					"speakerTitle": "Toshihiko"
				},
				{
					"id": 120200609,
					"content": "Ừm, dựa theo túi gấm của đại nhân Sangonomiya để lại, có thể phán đoán rằng Fatui nhất định có thuyền neo ở đâu đó nên mới hung hăng như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200610
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 120200610,
					"content": "Chúng ta có thể chia thành hai đội, một đội thu hút sự chú ý của chúng, đội còn lại sẽ đi phá hủy thuyền của chúng, cắt đứt đường trốn thoát của Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200611
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 120200611,
					"content": "Nhưng đại nhân Sangonomiya có nói là, nếu như binh lực không đủ thì không nên chia quân, nếu không sẽ rất dễ bị thọt một cánh, dẫn đến đại bại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200612
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 120200612,
					"content": "Hay là chúng ta quay về xin chi viện nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200613
					],
					"speakerTitle": "Koutoku"
				},
				{
					"id": 120200613,
					"content": "E rằng sẽ không kịp đâu, khi quan sát động tĩnh của chúng, tôi đoán rằng chúng sắp rời khỏi đây rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200614
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 120200614,
					"content": "Trong túi gấm của đại nhân Sangonomiya còn có ghi, \"khi đang mai phục, không được manh động\". Nếu như lần này binh lực không đủ thì chỉ còn cách bỏ cuộc thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200615
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 120200615,
					"content": "Không lẽ phải đứng nhìn bọn chúng rời khỏi đây sao? Tôi không cam tâm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200616
					],
					"speakerTitle": "Toshihiko"
				},
				{
					"id": 120200616,
					"content": "Thực ra, trong túi gấm của đại nhân còn một câu là \"Khi đến đường cùng, ắt có viện quân\". Nhưng tôi không hiểu viện quân ở đây là chỉ ai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200617
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 120200617,
					"content": "Gorou, bạn ở đây làm gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120200618,
					"content": "A! Đội trưởng đã về Đảo Watatsumi rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200619
					],
					"speakerTitle": "Koutoku"
				},
				{
					"id": 120200619,
					"content": "Chúng tôi đến đây để chi viện cho bạn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120200620
					]
				},
				{
					"id": 120200620,
					"content": "#Tốt quá rồi! Túi gấm của đại nhân quả nhiên không bao giờ sai... {NICKNAME}, bạn đến đúng lúc lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200621
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 120200621,
					"content": "Gần đây tàn dư của Fatui liên tục làm loạn, lần này chúng tôi đã bắt được hành tung của chúng, nên đã mai phục trước ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200622
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 120200622,
					"content": "Nhưng do nhân lực của tôi không đủ nên không thể chia quân ra hai đường... bạn có thể giúp đỡ tôi không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200623
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 120200623,
					"content": "Được thôi. Nói không chừng Fatui đang có mưu đồ gì đó, chúng tôi cũng sẽ không ngồi yên đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200624
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120200624,
					"content": "Tốt lắm! Vậy thì tôi sẽ dẫn người đi phá hủy thuyền của chúng, sau đó chúng ta hội hợp với nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200625
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 120200625,
					"content": "Cẩn thận nhé, chúng tôi sẽ đi nhanh thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200626
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 120200626,
					"content": "Xem ra mọi người trong quân kháng chiến đều nhớ đến chúng ta! Vậy thì chúng ta phải giúp họ giải quyết nhanh gọn vấn đề trước mắt mới được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
