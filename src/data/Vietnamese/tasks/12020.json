						120200409,
						120200410
					],
					"speakerTitle": "Yoshihisa"
				},
				{
					"id": 120200409,
					"content": "Tôi về để ăn mừng với mọi người.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120200411
					]
				},
				{
					"id": 120200411,
					"content": "Chuyện ban nãy có thể kể cho đội trưởng nghe không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200412
					],
					"speakerTitle": "Yoshihisa"
				},
				{
					"id": 120200412,
					"content": "Đừng đừng, đội trưởng là do đại nhân Sangonomiya đề bạt, nói không chừng cũng muốn chủ trương hòa bình...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200413
					],
					"speakerTitle": "Tsuneo"
				},
				{
					"id": 120200413,
					"content": "Đội trưởng đáng lẽ phải thấu hiểu cho tụi mình chứ? Nhưng thôi cẩn thận vẫn hơn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200414
					],
					"speakerTitle": "Yoshihisa"
				},
				{
					"id": 120200414,
					"content": "À, hoan nghênh đội trưởng trở về Đảo Watatsumi! Chúng tôi ở đây vẫn rất ổn, mọi chuyện đều tốt đẹp!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200415
					],
					"speakerTitle": "Yoshihisa"
				},
				{
					"id": 120200415,
					"content": "Đại nhân Sangonomiya hình như đang ở trong làng, đội trưởng có thể qua đó để gặp đại nhân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200416
					],
					"speakerTitle": "Tsuneo"
				},
				{
					"id": 120200416,
					"content": "Ừm... Hình như họ đang lén lén nói chuyện gì đó. Nhưng nếu họ không chịu nói thì thôi vậy, chúng ta vào làng trước đi.",
