			"dialogs": [
				{
					"id": 120200201,
					"content": "Bạn là... đội trưởng Đội Cá Kiếm 2 sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200202
					],
					"speakerTitle": "Denjirou"
				},
				{
					"id": 120200202,
					"content": "Tôi nhận ra rồi! May nhờ có đội trưởng nên Đảo Watatsumi mới có được hòa bình như hôm nay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200203
					],
					"speakerTitle": "Denjirou"
				},
				{
					"id": 120200203,
					"content": "Tôi tuy không phải là thành viên của Đội Cá Kiếm 2, nhưng khi tôi vừa đến Tatarasuna thì đã trông thấy đội trưởng rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200204
					],
					"speakerTitle": "Denjirou"
				},
				{
					"id": 120200204,
					"content": "Lúc đó hai bên đang giao tranh, đội trưởng một mình cầm kiếm lướt qua ba kẻ địch, rồi hất tung một lúc năm tên samurai, trông oai phong lắm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200205
					],
					"speakerTitle": "Denjirou"
				},
				{
					"id": 120200205,
					"content": "Nếu có gì cần giúp đỡ thì hãy nói với tôi nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200206
					],
					"speakerTitle": "Denjirou"
				},
				{
					"id": 120200206,
					"content": "Về những chuyện xảy ra gần đây...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120200207
					]
				},
				{
					"id": 120200207,
					"content": "Mọi người rất nóng nảy... thực ra, tôi cũng cảm nhận được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200208
					],
					"speakerTitle": "Denjirou"
				},
				{
					"id": 120200208,
					"content": "Có lẽ ý thức của mọi người vẫn còn đang trong trận chiến. Lúc còn trong chiến trận, có thể phải hy sinh bất kỳ lúc nào, nên mọi người đều rất căng thẳng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200209
					],
					"speakerTitle": "Denjirou"
				},
				{
					"id": 120200209,
					"content": "Giờ chiến tranh đột nhiên kết thúc, mọi người phát hiện ra không biết phải quay về với cuộc sống thường ngày thế nào... Haha, tôi thấy cũng không vấn đề gì, qua một thời gian rồi sẽ ổn thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200210
					],
					"speakerTitle": "Denjirou"
				},
				{
					"id": 120200210,
					"content": "Chuyện khác thì tôi không biết. Nhưng mà có đại nhân Sangonomiya ở đây thì Đảo Watatsumi nhất định sẽ không sao, tôi tin chắc là vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200211
					],
					"speakerTitle": "Denjirou"
				},
				{
					"id": 120200211,
					"content": "Giờ đội trưởng cũng đã quay về, nơi đây sẽ càng thêm an toàn! Nếu như có yêu cầu gì thì cứ đến tìm tôi nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200212
					],
					"speakerTitle": "Denjirou"
				},
				{
					"id": 120200212,
					"content": "Anh ta nhiệt tình thật... chúng ta đi hỏi thử người khác xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
