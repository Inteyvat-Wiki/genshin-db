			},
			"dialogs": [
				{
					"id": 120200301,
					"content": "Hơ hơ... hòa bình... thật tuyệt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200302
					],
					"speakerTitle": "Arisawa"
				},
				{
					"id": 120200302,
					"content": "Ủa? Trông bạn quen thế...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200303
					],
					"speakerTitle": "Arisawa"
				},
				{
					"id": 120200303,
					"content": "Hình như tôi đã gặp qua ở đâu rồi... nhất thời không nhớ được. Các bạn tìm tôi có chuyện gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200304
					],
					"speakerTitle": "Arisawa"
				},
				{
					"id": 120200304,
					"content": "Về những chuyện xảy ra gần đây...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120200305
					]
				},
				{
					"id": 120200305,
					"content": "Mọi người đang rất nóng nảy sao? Tôi không cảm thấy như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200306
					],
					"speakerTitle": "Arisawa"
				},
				{
					"id": 120200306,
					"content": "Có thể do tôi bình thường không thích nói chuyện với mọi người nên tôi không cảm nhận được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200307
					],
					"speakerTitle": "Arisawa"
				},
				{
					"id": 120200307,
					"content": "Hòa bình khó cầu, nhất định phải tận hưởng mới được... Có thể ở đây hít thở gió biển, tắm nắng mặt trời, cuộc đời còn gì sung sướng hơn thế chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200308
					],
					"speakerTitle": "Arisawa"
				},
				{
					"id": 120200308,
					"content": "Xin lỗi, tôi không thể giải đáp cho bạn rồi, nhưng bạn có thể đi hỏi đại nhân Sangonomiya, chuyện gì đại nhân cũng biết cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200309
					],
					"speakerTitle": "Arisawa"
				},
				{
					"id": 120200309,
					"content": "Úi... anh ta sắp ngủ luôn rồi. Thôi chúng ta đừng làm phiền anh ta, đi hỏi người khác vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
