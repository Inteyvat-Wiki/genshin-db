					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200407
					],
					"speakerTitle": "Tsuneo"
				},
				{
					"id": 120200407,
					"content": "Mọi người đang bàn chuyện gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120200408,
					"content": "#Đội trưởng {NICKNAME} về rồi sao?",
					"roleType": "TALK_ROLE_NPC",
