					"speakerTitle": "Matsuda"
				},
				{
					"id": 120200502,
					"content": "Ta sớm đã biết một thương nhân Hiệp Hội Tenryou như ngươi đến Đảo Watatsumi buôn bán là có ý đồ rồi, khai mau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200503
					],
					"speakerTitle": "Matsuda"
				},
				{
					"id": 120200503,
					"content": "Oan, oan cho tôi quá...",
