					}
				]
			},
			"dialogs": [
				{
					"id": 761170101,
					"content": "...Ừm, ủy thác này đúng là được hoàn thành rất tốt. Cảm ơn sự nỗ lực của cô nhé, Jahoda. Xin hãy nhận phần thù lao này nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 761170102,
					"content": "Ây da, tôi đã nói là không có vấn đề gì mà... Hihi, thù lao cũng nhiều đấy chứ. Nếu còn ủy thác nào kiếm được tiền thì tìm thêm giúp tôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170103
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170103,
					"content": "Được rồi, cô chờ một lát nhé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170104
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 761170104,
					"content": "Ơ? Đây là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170105
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170105,
					"content": "Này Katheryne, món trang sức đó là để đăng ủy thác treo thưởng phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170106
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170106,
					"content": "Trực giác của cô rất chuẩn xác đó. Đúng vậy, đây đúng là món đồ mà ngài Ihanti đã gửi tại hiệp hội để đăng ủy thác treo thưởng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170107
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 761170107,
					"content": "Tôi nhận ủy thác này, cô cho tôi thông tin đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170108
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170108,
					"content": "Nhưng thù lao cho nhiệm vụ này không nhiều, hơn nữa giờ món trang sức này trên thị trường cũng chẳng đáng giá là bao, có lẽ chưa phù hợp với yêu cầu của cô đâu, Jahoda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170109
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 761170109,
					"content": "Không sao đâu, cứ đưa tôi đi. Coi như tôi làm từ thiện với ủy thác này vậy, thỉnh thoảng cũng phải tích đức mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170110
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170110,
					"content": "Haha... Được rồi, Vậy cô đợi một chút...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170111,
						761170112
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 761170111,
					"content": "Lại nhận ủy thác sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761170113
					]
				},
				{
					"id": 761170113,
					"content": "Dù sao thì bình thường tôi cũng chẳng có việc gì khác, không lẽ cứ ở trong phòng vuốt ve Ashru hoài, thế thì sếp Nef... À ừm, sếp sẽ đuổi tôi đi mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170114
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170114,
					"content": "#{NICKNAME}, Paimon, hai người tài năng như vậy, hay là giúp tôi làm ủy thác đi? Tiền kiếm được thì chúng ta chia đều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170115
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170115,
					"content": "#Ủy, ủy thác á... Cô hỏi {NICKNAME} đi, {NICKNAME} là chuyên gia trong mấy việc này mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170116,
						761170117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761170116,
					"content": "Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761170118
					]
				},
				{
					"id": 761170118,
					"content": "Chắc chắn không phải chuyện gì to tát đâu, tôi lạ gì Ihanti đâu mà. Anh ta nhát gan lắm, không ủy thác việc gì lớn đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170119
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170119,
					"content": "Cô Jahoda, đây là chi tiết ủy thác mà anh Ihanti đã đăng, cô xem qua nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170120
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 761170120,
					"content": "Để tôi xem cái tên nhát gan đó đăng gì nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170121
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170121,
					"content": "...Chậc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170122
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170122,
					"content": "Sao thế? Là ủy thác khó nhằn à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761170123,
					"content": "Không phải đâu. Chỉ là không ngờ Ihanti trước đây còn chẳng dám tự tay giết gà, giờ lại đăng cả ủy thác đòi mạng người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170124,
						761170125
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170124,
					"content": "Đòi... đòi mạng người á?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761170126
					]
				},
				{
					"id": 761170126,
					"content": "#{F#Cô}{M#Cậu} á? Hahaha... Nhìn là biết ngay cực kỳ thượng tôn pháp luật mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170127
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170127,
					"content": "Yên tâm, tôi đùa thôi. Trong ủy thác chỉ viết là cần lấy lại một vài món đồ từ tay đám trộm cướp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170128
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170128,
					"content": "Nhưng đám trộm cướp ấy mà, tiền là mạng, mạng là tiền. Thế chẳng phải là một ủy thác \"đòi mạng người\" sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170129
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170129,
					"content": "#Đi theo tôi. Tôi có cách đối phó với đám trộm cướp đó, không chừng {F#cô}{M#cậu} còn chẳng cần ra tay đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170125,
					"content": "Nói trước nha, tôi là người thượng tôn pháp luật đấy nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761170126
					]
				},
				{
					"id": 761170117,
					"content": "Được thôi, để xem thử là ủy thác gì nào?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761170118
					]
				},
				{
					"id": 761170112,
					"content": "Bận rộn thật đấy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761170113
					]
				}
			]
		},
