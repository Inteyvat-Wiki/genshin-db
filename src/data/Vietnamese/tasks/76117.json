			"dialogs": [
				{
					"id": 761170401,
					"content": "Phù... phù...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170402
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170402,
					"content": "Ai đến vậy? Tôi không có tiền đâu... Chẳng có gì hết, nếu muốn lấy mạng tôi thì cứ việc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170403
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170403,
					"content": "Ihanti, tôi mang đồ của anh về rồi đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170404
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170404,
					"content": "...Jahoda? Có phải cô không? Tôi nghe thấy giọng cô, nhưng tôi chẳng nhìn rõ nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170405
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170405,
					"content": "Là tôi đây, Ihanti. Tôi đang đứng trước mặt anh đây. Bệnh nặng thế này, sao không đến tìm tôi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170406
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170406,
					"content": "Một con chó hoang khốn đốn dù sắp chết cũng không dám đặt chân vào thành phố xa hoa... Vì nó đã từng nếm trải quá nhiều đòn roi của người giàu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170407
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170407,
					"content": "Tôi không phải là người như thế, cả... sếp Nef cũng vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170408
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170408,
					"content": "Vậy tôi càng không thể đến được. Nhỡ có người biết hai cô có lòng tốt, thế thì có khi ngày nào hai cô cũng phải có lòng tốt mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170409
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170409,
					"content": "Không ai dám làm chuyện thiếu suy nghĩ như thế trước mặt sếp đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170410
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170410,
					"content": "Nhưng cô thì luôn lén làm việc tốt, rồi sau đó lại bị chính những người từng được cô giúp đỡ đâm sau lưng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170411
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170411,
					"content": "Tôi đã học được rất nhiều điều từ sếp, giờ không ai có thể làm tổn thương tôi nữa, sau này cũng vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170412
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170412,
					"content": "Cô cứ luôn không chịu thu lại lòng tốt của mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170413
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170413,
					"content": "Đây là chuyện riêng của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170414
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170414,
					"content": "Heh, chắc đấy là lý do khiến đại ca rất coi trọng cô.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170415
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170415,
					"content": "Có lẽ đó là lý do tôi sống đến bây giờ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170416
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170416,
					"content": "Hahaha... Khụ... khụ khụ! Cô nói đúng, Jahoda, cô nói đúng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170417
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170417,
					"content": "...Được rồi, Ihanti, có việc gì tôi giúp được thì cứ nói đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170418
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170418,
					"content": "Cô vẫn cứ như thế, không sợ tôi bỗng dưng lừa cô một khoản hả? Hoặc đào cho cô một cái hố to đùng thì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170419
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170419,
					"content": "Anh sẽ không làm thế đâu, chúng ta quen nhau lâu rồi mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170420
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170420,
					"content": "Chỉ vì chuyện đó thôi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170421
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170421,
					"content": "Hơn nữa, anh đã thế này rồi thì còn uy hiếp tôi thế nào được nữa chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170422
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170422,
					"content": "Hah! Cũng coi như có chút tiến bộ. Cứu một con rắn độc xương cốt đã rã rời thì cũng khá an toàn đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170423
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170423,
					"content": "Vậy thì giúp tôi một việc đi. Hãy cuộn bức tranh trong túi lại rồi nhét vào túi của tôi, tôi không còn sức nhấc nó lên nữa rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170424
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170424,
					"content": "Đây là bức tranh mà tôi cùng vẽ với vợ và con gái, cũng là thứ duy nhất tôi còn quan tâm trên cõi đời này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170425
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170425,
					"content": "Những thứ khác đối với tôi đều chẳng còn ý nghĩa nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170426
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170426,
					"content": "Anh của ngày xưa mà nghe được câu này, hẳn là sẽ cười lăn cười bò cho mà xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170427
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170427,
					"content": "Tiếc là... những thứ mà trước đây tôi vô cùng coi trọng, cuối cùng không cứu được vợ tôi, cũng chẳng cứu nổi cuộc đời tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170428
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170428,
					"content": "Có lẽ đây chính là số phận của đạo tặc nhỉ. Những thứ cướp đoạt được, cuối cùng cũng bị người khác cướp mất, rồi sẽ lại trở về với hai bàn tay trắng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170429
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170429,
					"content": "Mặt dây chuyền mà tôi dùng để đăng ủy thác, cũng là chút tài sản cuối cùng của tôi đấy... Haha... Mà cũng không thể gọi là \"của tôi\" được nữa rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170430
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170430,
					"content": "Đây là món trang sức đầu tiên anh trộm được. Anh đã kể với tôi rất nhiều lần rồi. Anh còn kể cho tôi nghe về thủ đoạn đã dùng, cả biểu cảm của tên nhà giàu khi phát hiện mình bị trộm đồ nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170431
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170431,
					"content": "Đúng thế, giờ nó là của cô rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170432
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170432,
					"content": "Chủ nhân của món trang sức này là ai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170433
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170433,
					"content": "Là một người Snezhnaya, tên là Holomov, trước đây từng sống ở Nod-Krai. Nhưng giờ chắc đã quay về Snezhnaya rồi, cô định...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170434
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170434,
					"content": "Tôi không còn là kẻ trộm nữa, cũng sẽ không chiếm những thứ trộm được làm của riêng. Món trang sức này vốn là của ai, thì nên trả lại cho người đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170435
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170435,
					"content": "Haha... hahaha...! Cô đúng là... đúng là một kẻ ngốc nghếch đấy, Jahoda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170436
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170436,
					"content": "Đại ca nói đúng, người như cô mà đi làm kẻ trộm, e là cả đời cũng... khụ khụ... cũng chẳng giàu nổi... khụ khụ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170437
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170437,
					"content": "Khụ khụ... khụ... khụ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170438
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170438,
					"content": "Thôi đừng nói nữa. Để tôi đi tìm bác sĩ cho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170439
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170439,
					"content": "Không cần đâu, cứ để tôi đến nơi tôi phải đến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170440
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170440,
					"content": "Anh...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170441
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170441,
					"content": "Jahoda, cô biết quy tắc đại ca đã đặt ra mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170442
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170442,
					"content": "\"Kẻ khao khát sự yên nghỉ thì xứng đáng được yên nghỉ.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170443
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170443,
					"content": "Cứ thực hiện điều đó đi, cô hiểu ý tôi mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170444
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170444,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170445
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170445,
					"content": "Tôi biết rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170446
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170446,
					"content": "Tôi rất vui vì người đến giúp tôi lại là cô, Jahoda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170447
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170447,
					"content": "Tiếc là tôi chẳng có gì quý giá để tặng cô cả. Nếu muốn thì cứ lấy con búp bê vải này đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170448
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170448,
					"content": "Đây là... Nhưng những con búp bê đó, không phải tôi đã bảo anh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170449
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170449,
					"content": "À, đừng hiểu lầm. Đây là tôi tự làm đấy. Còn những con búp bê trước đây cô làm, tôi đã đốt hết chúng như lời cô dặn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170450
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170450,
					"content": "Thế nào hả, trước khi mắt tôi mù hẳn thì tay nghề của tôi vẫn ra gì lắm đấy chứ nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170451
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170451,
					"content": "Cầm lấy đi, Jahoda. Coi như đây là món quà cuối cùng của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170452
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170452,
					"content": "Tôi sẽ quay lại thăm anh sau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170453
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170453,
					"content": "Đi đi, tạm biệt nhé, Jahoda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170454
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170454,
					"content": "Cảm ơn cô.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ihanti"
				}
			]
		},
