			"dialogs": [
				{
					"id": 761170501,
					"content": "Ừm, ủy thác đã hoàn thành rồi. Đợi chút nhé, để tôi lấy thù lao từ hiệp hội...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170502
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 761170502,
					"content": "Cô Jahoda, sắc mặt cô không được tốt lắm. Cô gặp chuyện gì khó khăn phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170503
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 761170503,
					"content": "Không sao đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170504
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170504,
					"content": "Vậy cô chờ một chút, tôi đi lấy thù lao ngay đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170505
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 761170505,
					"content": "Jahoda, cô không sao chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761170506
					]
				},
				{
					"id": 761170506,
					"content": "Tuy nói là không gọi bác sĩ cho anh ta... Nhưng Ihanti trông có vẻ rất khó chịu, hay là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761170507,
					"content": "Không cần đâu. Tôi đã nói là sẽ tuân thủ quy tắc thì phải tuân thủ quy tắc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170508
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170508,
					"content": "Lúc trước, anh ta với cô là...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761170509
					]
				},
				{
					"id": 761170509,
					"content": "Lúc trước, anh ta là \"đồng nghiệp\" của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170510
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170510,
					"content": "Tuy Ihanti rất nhát gan, nhưng lại là người kiếm tiền giỏi nhất trong tất cả mọi người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170511
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170511,
					"content": "Trong khi những người khác chỉ đơn thuần là đi lừa đảo và cướp bóc, thì anh ta lại có thể dùng đủ mọi thủ đoạn để khiến người ta tự nguyện đưa tiền.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170512
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170512,
					"content": "Khi tôi còn là đồng nghiệp với Ihanti, anh ta thường dạy tôi cách ăn nói, còn dẫn tôi đi ăn đồ ngon khắp nơi nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170513
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170513,
					"content": "Anh ta là bạn của cô sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761170514
					]
				},
				{
					"id": 761170514,
					"content": "Bạn bè ư? Hah, đương nhiên là không rồi. Ở cái chốn quỷ tha ma bắt đó sẽ chẳng có ai ngu ngốc đến mức kết bạn với người khác đâu. Chúng tôi cùng lắm chỉ coi nhau là người quen thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170515
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170515,
					"content": "Anh ta chăm sóc tôi như vậy cũng chỉ để khoe khoang sức mạnh trước mặt tôi thôi. Dẫn theo một đàn em như tôi cũng sẵn tiện tăng uy thế cho bản thân mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170516
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170516,
					"content": "Nhưng trước đây anh ta quả thật đã từng chăm sóc tôi, giờ tôi giúp lại, cũng chỉ đơn giản là muốn trả ân tình đó mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170517
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170517,
					"content": "Được rồi, cô hãy nhận số thù lao này nhé. Cô Jahoda, cảm ơn cô đã giúp đỡ hiệp hội!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170518
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 761170518,
					"content": "#Ừm, phần này là cho {F#cô}{M#cậu}, {NICKNAME}. Cảm ơn nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170519
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170519,
					"content": "Tôi phải về Hội Đồng Bí Mật đây. Nhỡ đâu sếp đột nhiên muốn làm gì đó mà không tìm thấy tôi, thì kiểu gì cũng lại phàn nàn cho xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170520
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170520,
					"content": "(...Tuy nói là không tìm bác sĩ, nhưng mua ít thuốc giảm đau đem qua cũng được mà nhỉ.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170521
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170521,
					"content": "(Chắc chắn sếp sẽ có cách, nhờ sếp giúp đỡ cùng lắm thì lương tháng này coi như bỏ... Ừm, cũng không thể bỏ hết được, hay là bỏ một nửa nhỉ...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170522
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170522,
					"content": "(Đúng rồi, cứ làm vậy đi. Tốt nhất là ngày mai đem thuốc tới cho Ihanti đã...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jahoda"
				}
			]
		},
