			"dialogs": [
				{
					"id": 761170301,
					"content": "Tôi nhận thua rồi, dừng tay, dừng tay đi mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170303
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170303,
					"content": "Như thế từ đầu thì có phải bớt được bao nhiêu chuyện rồi không. Tiền đây cầm đi, tìm bác sĩ nào uy tín vào nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170304
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170304,
					"content": "...Ý cô là sao hả? Thương hại tôi đấy à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170305
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170305,
					"content": "Đừng nói nhiều, cầm lấy tiền đi. Rồi muốn ném đi hay dùng để thuê người tới đánh tôi thì tùy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170306
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170306,
					"content": "Đói khát và đau đớn khắp người đều không dễ chịu gì, đừng tự chuốc khổ vào mình nữa, Kaleva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170307
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170307,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170308
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170308,
					"content": "Mấy thứ lấy được từ cái tên bệnh tật đó, tôi đã để bên cạnh rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170309
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170309,
					"content": "Bên trong ngoài một ít tiền lẻ ra thì chỉ có một bức tranh và một con búp bê rách. Tiền thì tôi tiêu hết rồi, mấy thứ khác vẫn chưa kịp vứt đi, ở đằng kia kìa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170310
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170310,
					"content": "Được. Câu hỏi cuối cùng, anh vừa gọi Ihanti là \"bệnh tật\", ý là sao hả?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170311
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170311,
					"content": "Thì nghĩa đen thôi. Hắn ta bệnh đến mức trông chẳng còn ra con người nữa rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170312
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170312,
					"content": "Khi tôi gặp Ihanti, hắn ta nằm sấp bất động dưới đất, tôi còn tưởng là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170313
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170313,
					"content": "...Sau đó, tôi nhặt cái túi ở bên cạnh rồi đi thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170314
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170314,
					"content": "Đánh dấu vị trí lần cuối cùng anh nhìn thấy Ihanti cho tôi đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170315
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170315,
					"content": "Lần cuối cùng á? Để tôi nghĩ xem nào... Chắc là ở đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170316
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170316,
					"content": "#Được rồi. {NICKNAME}, Paimon, chúng ta đi thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170317
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170317,
					"content": "Tôi phải trực tiếp đem trả những thứ đã lấy lại cho người ủy thác mới được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jahoda"
				}
			]
		},
