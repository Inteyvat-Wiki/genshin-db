				]
			},
			"dialogs": [
				{
					"id": 761170201,
					"content": "...Chậc, đúng là nghèo rớt mồng tơi, chẳng có cái gì cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170202
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170202,
					"content": "Này, Kaleva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170203
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170203,
					"content": "Ai thế... Ồ, Jahoda, đúng là khách quý ghé thăm đấy! Có chuyện gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170204
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170204,
					"content": "Không có gì đâu. Mấy hôm trước anh đã cướp đi vài món đồ của một người tên là Ihanti đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170205
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170205,
					"content": "Anh cầm lấy số tiền này rồi đưa đồ ra đây đi. Hôm nay tôi tốt bụng, cứ coi như tôi mua lại món đồ từ tay anh vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170206
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170206,
					"content": "Không hổ danh là người được Nefer chống lưng đấy. Cách hành sự này... thật văn minh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170207
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170207,
					"content": "Vậy nếu tôi không đưa thì cô định làm gì nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170208
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170208,
					"content": "...Kaleva, xin anh đấy, liệu anh và đám anh em ngốc nghếch của anh có thể cư xử như người bình thường được một lần không hả?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170209
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170209,
					"content": "Jahoda à, cô chạy từ xa đến đây để mua đồ từ tay một tên trộm cướp sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170210
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170210,
					"content": "Miếng thịt đã nuốt rồi, tôi còn có thể nhả ra cho cô được nữa sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170211
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170211,
					"content": "Sao có cảm giác cuộc đàm phán này thất bại rồi ấy nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761170212,
					"content": "Phù...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170213
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170213,
					"content": "Là lỗi của tôi, Kaleva. Đáng lẽ tôi không nên bắt chước sếp Nef đi trao đổi với mấy người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170214
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170214,
					"content": "Đám ngốc nghếch mấy người chỉ hiểu được ngôn ngữ đàm phán là nắm đấm thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170215
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170215,
					"content": "#Nào, {NICKNAME}, chúng ta hạ gục chúng thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170216
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170216,
					"content": "Coi thường ai vậy hả? Các anh em xông lên! Thù mới nợ cũ, hôm nay chúng ta đòi lại bằng hết!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaleva"
				}
			]
		},
		{
			"id": 7611703,
