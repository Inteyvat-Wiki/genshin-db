				"points": []
			},
			"dialogs": [
				{
					"id": 726580101,
					"content": "Xin chào! Có muốn thử tự tay trồng một chậu hoa không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580102
					],
					"speakerTitle": "Sakuya"
				},
				{
					"id": 726580102,
					"content": "Trồng hoa gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726580103
					]
				},
				{
					"id": 726580103,
					"content": "Ồ, bạn có hứng thú không? Không hiểu cũng không sao, để tôi tóm tắt cho bạn hiểu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580104
					],
					"speakerTitle": "Sakuya"
				},
				{
					"id": 726580104,
					"content": "Tôi là Sakuya, một người làm vườn và kinh doanh một số lĩnh vực liên quan đến hoa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580105
					],
					"speakerTitle": "Sakuya"
				},
				{
					"id": 726580105,
					"content": "Hahaha, tuy nói là kinh doanh, nhưng thật ra phần lớn thời gian là giúp người ta giao hoa, hoặc \"cắm hoa\" cho các tiệm hoa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580106
					],
					"speakerTitle": "Sakuya"
				},
				{
					"id": 726580106,
					"content": "Cắm hoa là...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726580107
					]
				},
				{
					"id": 726580107,
					"content": "Hở? Bạn không biết sao? \"Cắm hoa\" là một việc rất quan trọng ở Inazuma đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580108
					],
					"speakerTitle": "Sakuya"
				},
				{
					"id": 726580108,
					"content": "Mặc dù nói một cách đơn giản, \"cắm hoa\" tức là cắt tỉa hoa và các loại cây khác rồi sắp xếp chúng lại theo kiểu phù hợp...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580109
					],
					"speakerTitle": "Sakuya"
				},
				{
					"id": 726580109,
					"content": "Nhưng trong thao tác cụ thể...Khi cắt hoa và cây, cần phải nắm được tình trạng của nó, và cẩn thận cắt tỉa những chỗ không cần thiết...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580110
					],
					"speakerTitle": "Sakuya"
				},
				{
					"id": 726580110,
					"content": "Khi cắm, còn phải điều chỉnh cách cắm cho phù hợp với bối cảnh cụ thể. Đôi khi thậm chí còn phải kỹ đến góc độ của từng cành hoa vươn ra ngoài...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580111
					],
					"speakerTitle": "Sakuya"
				},
				{
					"id": 726580111,
					"content": "Từng chi tiết này đều cần được nghiên cứu tỉ mỉ, thật sự là...hết sức rườm rà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580112
					],
					"speakerTitle": "Sakuya"
				},
				{
					"id": 726580112,
					"content": "Ngay cả đối với một người yêu thích cắm hoa như tôi, thì công việc này cũng đủ làm cho tôi mệt mỏi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580113
					],
					"speakerTitle": "Sakuya"
				},
				{
					"id": 726580113,
					"content": "Trước đây tôi có một tiệm hoa ở trong thành, nhưng ở đó quá ồn ào, tôi không thể bình tĩnh để cắm hoa được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580114
					],
					"speakerTitle": "Sakuya"
				},
				{
					"id": 726580114,
					"content": "Cho nên tôi đã đóng cửa tiệm, chỉ nhận khách ở gần ruộng hoa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580115
					],
					"speakerTitle": "Sakuya"
				},
				{
					"id": 726580115,
					"content": "Nhưng mà...tuy đã yên tĩnh hơn, nhưng cũng ít khách hơn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580116
					],
					"speakerTitle": "Sakuya"
				},
				{
					"id": 726580116,
					"content": "Vì vậy, tôi đã đặc biệt lập ra một kế hoạch quảng bá để quảng cáo \"Tiệm Hoa Sakuya\" của mình với người dân trong thành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580117
					],
					"speakerTitle": "Sakuya"
				},
				{
					"id": 726580117,
					"content": "Tôi gọi kế hoạch này là... \"Giấc Mơ Hoa\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580118
					],
					"speakerTitle": "Sakuya"
				},
				{
					"id": 726580118,
					"content": "Kế hoạch cụ thể là...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726580119
					]
				},
				{
					"id": 726580119,
					"content": "Cụ thể là hoạt động để khách hàng tự tay trồng hoa, sau đó tự tay cắm hoa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726580120
					],
					"speakerTitle": "Sakuya"
				},
				{
					"id": 726580120,
					"content": "Nếu bạn có hứng thú và muốn trải nghiệm thì cứ nói với tôi. Trồng hoa hay cắm hoa cũng đều rất thú vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sakuya"
				}
			]
		}
	]
}