			"dialogs": [
				{
					"id": 401190801,
					"content": "Sau mỗi lần đưa người nào đó ra khỏi ảo cảnh, tôi cũng một mình lên đây một lúc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190802
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 401190802,
					"content": "Khi họ làm ra nhiều thứ trong ảo cảnh, họ vui lắm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190803
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 401190803,
					"content": "Nhưng khi biết những thứ này không thể mang ra ngoài thì trở nên rất phiền não. Một là không nỡ, hai là tiếc nuối bỏ đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190804
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 401190804,
					"content": "Chị Idyia có buồn không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190805
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401190805,
					"content": "...Tuy thỉnh thoảng cũng thấy cô đơn, nhưng chị không buồn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190806
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 401190806,
					"content": "Có người sẽ phá hủy những thứ mình đã tạo ra lúc rời khỏi ảo cảnh. Nhưng một số lại khác, ví dụ như những cư dân mà mọi người nhìn thấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190807
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 401190807,
					"content": "Lúc rời khỏi, họ sẽ nhờ dùng Eidolon Thủy mô phỏng bản thân, thay họ bảo vệ tạo vật trong đây, giống như canh giữ ước mơ của họ vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190808
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 401190808,
					"content": "Nghe lãng mạn quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401190809,
					"content": "Ừm, tuy không biết cuộc sống của họ ở ngoài ra sao, nhưng chỉ cần nghĩ đến họ có thể thực hiện ước mơ như trong đây thì tôi đã vui rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190810
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 401190810,
					"content": "Giống như tôi đang chờ họ ở điểm đích của ước mơ vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190811
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 401190811,
					"content": "Idyia tốt bụng quá.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401190812
					]
				},
				{
					"id": 401190812,
					"content": "Ơ... Có sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190813
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 401190813,
					"content": "Tôi chỉ cảm thấy, mỗi ước mơ và nguyện vọng đều giống như một đốm sáng trong bình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190814
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 401190814,
					"content": "Dù còn đang trên đường theo đuổi ước mơ, hay đã đạt được ước mơ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190815
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 401190815,
					"content": "Chỉ cần nhớ lại đốm sáng thuộc về mình, thì sẽ có thể mỉm cười thật tươi. Như vậy là đã đủ rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190816
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 401190816,
					"content": "Klee lúc này cũng cảm thấy rất vui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190817
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401190817,
					"content": "Haha, vậy thì cũng xem như đã báo đáp được ân tình của Alice năm xưa rồi. Sa mạc dù sao cũng là vũng lầy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190818
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 401190818,
					"content": "Vậy tôi đặt một biệt danh cho cô nhé, gọi là Tinh Linh Bùn Lầy đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190819
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401190819,
					"content": "Dám cười tôi hả! Có tin tôi nuốt chửng Paimon không!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190820
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 401190820,
					"content": "...Tuy đã để mọi người nhìn thấy mặt thảm hại, nhưng ảo cảnh sau khi khôi phục đã nhộn nhịp lại rồi. Cho nên cứ chơi thoải mái nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190821
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 401190821,
					"content": "Vì ước mơ của mọi người!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401190822
					]
				},
				{
					"id": 401190822,
					"content": "Đúng đó, Klee cũng muốn cùng mọi người...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190823
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401190823,
					"content": "Ngồi xe bay thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Klee"
				}
			]
