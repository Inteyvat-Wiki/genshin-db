			"dialogs": [
				{
					"id": 401190201,
					"content": "A, Eula và Collei về rồi sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401190202,
					"content": "Ừm, khi buổi diễn sắp kết thúc, chúng tôi nhận được tin do Idyia nhờ Giọt Nước Nhỏ mang đến, nên đến trước chờ mọi người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190203
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401190203,
					"content": "Vậy anh Lessig...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190204
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 401190204,
					"content": "Anh ấy ôm hết việc tay chân, dùng sức quá mức nên bây giờ đang ngủ ngon lành trong phòng rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190205
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 401190205,
					"content": "Ừm, có hơi áy náy thật...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190206
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 401190206,
					"content": "Cứ xem tất cả những gì anh ta làm là để chuộc tội đi. Làm xong hết mới ngủ ngon được, vốn dĩ nên như vậy mà. Kệ đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190207
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401190207,
					"content": "Vậy sao... Ừm, vậy chúng ta tranh thủ đi sửa Ảo Cảnh Veluriyam đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190208
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 401190208,
					"content": "Đây là nơi ban đầu chúng ta gặp Giọt Nước Nhỏ mà?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401190209,
					"content": "Đúng, lõi của Ảo Cảnh Veluriyam chính là Đèn Chiếu lớn nhất, còn toàn bộ ảo cảnh chính là một Hình Chiếu khổng lồ nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190210
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 401190210,
					"content": "Tất cả mọi thứ chúng ta nhìn thấy đều do nó tạo ra sao? Thật không thể tin được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190211
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 401190211,
					"content": "Bây giờ sẽ là giống như trước đây, dùng \"Hình Chiếu\" trong lõi để sửa sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401190212,
					"content": "Đúng, chính là vậy. Paimon hiểu nhanh thật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190213
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 401190213,
					"content": "Hihi, sửa bao nhiêu lần rồi, dù sao cũng phải nhớ chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401190214,
					"content": "Vậy thì bắt đầu đi, đây chính là bước cuối cùng rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190215
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 401190215,
					"content": "Chà! Đột nhiên thấy tràn đầy sức lực ghê!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
