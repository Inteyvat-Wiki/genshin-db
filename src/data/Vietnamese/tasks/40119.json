			"dialogs": [
				{
					"id": 401190401,
					"content": "Thành công rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401190402,
					"content": "Nhưng cái vòng không chuyển động...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190403
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 401190403,
					"content": "Linh kiện đã về với lõi ảo cảnh, hình dạng của cái vòng đó cũng đã được ghép đủ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190404
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 401190404,
					"content": "Haha, vậy là không sao rồi. Giống như vết thương sẽ từ từ lành lại, không chừng một buổi tối yên tĩnh nào đó Vòng Trung Tâm sẽ chuyển động lại đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190405
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 401190405,
					"content": "Ồ? Tôi còn tưởng cô có thể khiến nó chuyển động ngay chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190406
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401190406,
					"content": "Chuyện này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190407
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 401190407,
					"content": "Hửm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401190408,
					"content": "Ai cũng đang mong chờ hình dạng ban đầu của ảo cảnh, và cả dáng vẻ xinh đẹp của Idyia đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190409
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 401190409,
					"content": "Klee cũng muốn nhìn thấy dáng vẻ dùng phép thuật của chị Idyia! Chắc là rất lợi hại!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190410
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401190410,
					"content": "Mọi người đang nói gì vậy... Tại sao Klee cũng biết thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401190411,
					"content": "Paimon không phát hiện ra sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401190412
					]
				},
				{
					"id": 401190412,
					"content": "Đang nói về... \"hình dạng thật của tiểu thư Linh Vật\" đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190413
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401190413,
					"content": "Trước đó có nói, Idyia tuyệt đối không giống như bản thân nghĩ. Cô ấy có sức mạnh riêng của mình, trong số chúng ta cũng có người cảm nhận được điểm này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190414
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 401190414,
					"content": "\"Quân Sư\" từ đầu đã phát hiện rồi sao? Tôi chỉ nhận ra điều đó sau khi nói chuyện với Eula thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190415
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 401190415,
					"content": "\"Quân Sư\" trông có vẻ thong dong, nhưng lại trở thành người đầu tiên phát hiện sự thật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190416
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401190416,
					"content": "Tôi thấy anh cũng biết khá rõ đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190417
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401190417,
					"content": "Mọi người... đều biết hết rồi sao... Tôi đảm bảo là không phải cố ý che giấu đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190418
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 401190418,
					"content": "Chỉ là... đối với khách vào nhầm ảo cảnh thì dáng vẻ bây giờ của tôi sẽ dễ giao tiếp với nhau hơn. Tôi... tôi không muốn bị nhìn với ánh mắt sợ hãi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190419,
						401190420
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 401190419,
					"content": "Không ngờ thật!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401190421
					]
				},
				{
					"id": 401190421,
					"content": "Hả? Rốt cuộc là gì vậy? Mọi người tại sao lại biết?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401190422,
					"content": "Ừm... Nói sao nhỉ, cư dân trong ảo cảnh không có Vision, nhưng tôi cảm nhận được sức mạnh nguyên tố Thủy từ trên người họ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190423
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 401190423,
					"content": "Lúc xem tiểu thuyết thì tôi nghĩ đến một khả năng. Eidolon Thủy có thể biến hình, nên cũng sẽ biến được thành hình dạng người thường đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190424
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 401190424,
					"content": "Nhạy bén thật...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190425
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 401190425,
					"content": "Vậy, cho phép tôi tự giới thiệu lại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190426
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 401190426,
					"content": "Tôi chính là Tinh Linh Nước Trong lưu vong đến đây lúc Thủy Thần cũ qua đời, tôi tên Idyia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190427
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 401190427,
					"content": "Không ngờ lại là Tinh Linh Nước Trong...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401190428
					]
				},
				{
					"id": 401190428,
					"content": "Chị Idyia đẹp quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190429
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401190429,
					"content": "Hic... Đột nhiên dùng chân thân của mình để nói chuyện có hơi ngại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190430
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 401190430,
					"content": "Dáng vẻ đẹp như vậy thì nên thoải mái thể hiện ra mới phải.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190431
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401190431,
					"content": "Tôi không can đảm đến mức đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190432
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 401190432,
					"content": "Ủa? Vậy không lẽ những người trước đó chúng ta gặp...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190433
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401190433,
					"content": "Tôi nghĩ, chân thân của những cư dân nguyên tố Thủy này đã không còn ở đây nữa đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190434
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401190434,
					"content": "Đúng vậy, khi họ muốn rời khỏi, tôi sẽ đưa họ đến rìa sa mạc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190435
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 401190435,
					"content": "Những \"linh kiện\" trước đây thật ra đều là quà của họ để lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190436
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 401190436,
					"content": "Nhưng tôi luôn rất tò mò nguyên nhân họ vào đây... Nên đã dùng \"Đèn Chiếu\" tạo ra cảnh tượng mong muốn của họ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190437
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 401190437,
					"content": "\"Có thể thực hiện nguyện vọng, nhưng dù thực hiện được thì cũng chỉ giới hạn trong chiếc bình.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190438
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 401190438,
					"content": "Chuyện là vậy đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190439
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 401190439,
					"content": "Đúng là vầng sáng lung linh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190440
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401190440,
					"content": "Vậy là, linh kiện rơi ra từ lõi ảo cảnh không phải trở về với chủ nhân của nó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190441
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 401190441,
					"content": "Mà là có linh kiện rơi vào vị trí tương ứng trước, rồi \"chủ nhân\" và \"khu vực\" liên quan với chúng mới được ảo hóa ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190442
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 401190442,
					"content": "Nhưng bây giờ \"linh kiện\" đều đã được thu hồi rồi, không lẽ họ cũng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190443
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 401190443,
					"content": "Yên tâm, họ không biến mất đâu... Chỉ cần tôi không quên họ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190444
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 401190444,
					"content": "Dù là chê bai hay cãi lộn với nhau... nhưng ở trong ảo cảnh này thì họ mãi mãi là bạn của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190445
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 401190445,
					"content": "\"Xe bay\" và anh \"đạo diễn\" đều rất thú vị! Klee sẽ không quên đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190446
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401190446,
					"content": "Tôi cũng vậy, tôi sẽ không quên chuyến thám hiểm kỳ ảo này đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190447
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 401190447,
					"content": "Haha, được rồi, cũng đến lúc để Vòng Trung Tâm chuyển động lại rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190448
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 401190448,
					"content": "Trông cậy vào cô rồi, \"Linh Vật\" dịu dàng như nước trong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190449
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 401190449,
					"content": "Hồi hộp quá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190450
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401190450,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190451
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 401190451,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190452
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 401190452,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401190453
					]
				},
				{
					"id": 401190453,
					"content": "Ủa... Không phải chứ, sao lại không có phản ứng gì... Không lẽ là do sự cố trước đó mà không đủ sức mạnh sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190454
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 401190454,
					"content": "Nguy rồi... Lúc nãy mọi người còn tâng bốc mình như vậy... mình cũng hùng hồn bốc phét nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190455
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 401190455,
					"content": "Huhu... Cho tôi chiếc bình để trốn vào đi! Tôi muốn trốn một trăm năm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190456
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 401190456,
					"content": "Ơ... Thì cô đang ở trong chiếc bình rồi đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190457
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401190457,
					"content": "Làm sao đây... Vậy là không thể cho mọi người nhìn thấy hình dạng ban đầu của ảo cảnh rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190458
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 401190458,
					"content": "Thật ra, tôi có một kế này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190459
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 401190459,
					"content": "\"Quân Sư\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190460
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 401190460,
					"content": "Idyia, nếu được thì có thể cho tôi mượn \"Hộp Shinrou\" trong lõi ảo cảnh không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190461
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 401190461,
					"content": "Hình như tôi từng nghe qua tên này, chờ một lát...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190462
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 401190462,
					"content": "Đây này, có phải nó không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190463
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 401190463,
					"content": "Ồ! Chiếc vỏ sò lớn quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190464
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401190464,
					"content": "Cổ vật mà trước đó Kokomi nhắc đến, thì ra được cất giấu trong này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190465
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401190465,
					"content": "Ừm, nó là pháp khí trong Đền Mouun trước đây, được làm từ vỏ của một con youkai tên \"Shinkirou\". Nó có thể lắng nghe nguyện vọng của người cầu nguyện để tích lũy \"shinki\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190466
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 401190466,
					"content": "Mấy trăm năm trước, vật này thất lạc bên ngoài theo cuộc chinh chiến của Yashiori đời cuối.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190467
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 401190467,
					"content": "Viên ngọc tương ứng đáng lẽ sẽ cảm nhận được vị trí của chiếc hộp. Không ngờ chiếc hộp lại bị cất giấu trong lõi ảo cảnh, viên ngọc cũng mất đi ánh sáng từ đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190468
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 401190468,
					"content": "Hả? Tại sao vậy ạ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190469
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401190469,
					"content": "Nếu như giam âm thanh trong một căn phòng rất sâu, thì bên ngoài cũng sẽ không nghe thấy đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190470
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401190470,
					"content": "A! Hiểu rồi, vỏ sò quá ham chơi nên bị giam trong phòng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190471
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401190471,
					"content": "Vậy tôi cũng hiểu rồi! Lõi ảo cảnh dạo này bị hao mòn... nên tiểu thư \"Quân Sư\" mới lần theo viên ngọc đến đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190472
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 401190472,
					"content": "(Nghe giống la bàn tầm bảo của mình quá...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401190473
					]
				},
				{
					"id": 401190473,
					"content": "Quay lại chủ đề chính. Đáng lẽ khi rời khỏi đền thờ thì pháp khí này cũng sẽ nhanh chóng bị mất linh khí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190474
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 401190474,
					"content": "Nhưng trong ảo cảnh này, rất nhiều người đã để lại nguyện vọng và quà của mình, trở thành \"vật tế\" cho nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190475
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 401190475,
					"content": "Thì ra nó lợi hại đến vậy sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190476
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 401190476,
					"content": "Đúng vậy, nó có thể giúp Idyia tu sửa ảo cảnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190477
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 401190477,
					"content": "Nhưng mà... tôi phải làm thế nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190478
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 401190478,
					"content": "Rất đơn giản, dùng nguyện vọng để đánh thức nó là được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190479
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 401190479,
					"content": "Ví dụ... Tên của tôi là Sangonomiya Kokomi, là Thánh Pháp Sư của Đảo Watatsumi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190480
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 401190480,
					"content": "Nguyện vọng của tôi là dùng tư duy và quyết sách của mình, giúp mọi người trên Đảo Watatsumi và những người tôi quý trọng... có thể sống hạnh phúc hơn nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190481
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 401190481,
					"content": "Idyia, nguyện vọng của cô là gì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190482
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 401190482,
					"content": "Nguyện vọng của tôi? Tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190483
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 401190483,
					"content": "Nguyện vọng của tôi là, những người từng đến Ảo Cảnh Veluriyam, không chỉ ở trong ảo cảnh, mà cả bên ngoài ảo cảnh cũng có thể thực hiện được ước mơ mà họ thật sự muốn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190484
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 401190484,
					"content": "Dù tôi biết... làm đường ray cho xe bay ở ngoài ảo cảnh rất phi thực tế, và tôi cũng biết Maymunah vẫn sẽ quay về làm học giả...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190485
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 401190485,
					"content": "Tôi biết trình độ sáng tác của Zosimos vẫn cần trau dồi thêm, về đến Fontaine vẫn sẽ phải vất vả nhiều. Theo đuổi ước mơ không hề đơn giản như vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190486
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 401190486,
					"content": "Nhưng tôi vẫn rất hy vọng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190487
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 401190487,
					"content": "Rất hy vọng họ có thể đạt được điều ước của mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Idyia"
				},
				{
					"id": 401190420,
					"content": "Cũng có cảm nhận được đôi chút...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401190421
					]
				}
