			"dialogs": [
				{
					"id": 401190601,
					"content": "Ồ, chị Idyia lại trở về hình dạng cũ rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190602
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401190602,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190603
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 401190603,
					"content": "Cô vẫn ổn chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401190604
					]
				},
				{
					"id": 401190604,
					"content": "Những lời khen của mọi người và những câu hỏi tò mò hiện lên trong đầu tôi... Tôi đã nói ra rất nhiều điều xấu hổ. Tôi... tôi đã mất hết can đảm để sống tiếp rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190605
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 401190605,
					"content": "Đừng nói như vậy, rõ ràng là những ước nguyện rất tuyệt vời mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190606
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 401190606,
					"content": "Đúng đó, Idyia không phải ước cho mình, mà là ước cho người khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190607
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 401190607,
					"content": "Tôi cũng có một vài người bạn như vậy! Hành động vì ước nguyện của người khác, nỗ lực không ngừng vì nụ cười của họ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190608
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 401190608,
					"content": "Tôi nghĩ... người như vậy mới là cao thượng nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190609
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 401190609,
					"content": "Đừng khen tôi nữa, tôi... tôi thật sự không quen... tôi xấu hổ lắm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190610
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 401190610,
					"content": "Người như tôi cũng được nhiều người khen ngợi... giống như là đang nằm mơ vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190611
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 401190611,
					"content": "Bây giờ ảo cảnh đã khôi phục rồi, cũng xem như trả xong nợ cho anh ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190612
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401190612,
					"content": "Ơ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190613
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401190613,
					"content": "Sao vậy? Klee.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190614
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401190614,
					"content": "Em đột nhiên có rất nhiều ước nguyện! Muốn ngồi xe bay, còn muốn leo lên cái vòng quay lớn đó xem thử nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190615
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401190615,
					"content": "Chị Idyia, có cách nào để lên đó không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190616
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401190616,
					"content": "Có thì có, nhưng chỉ đứng được rất ít người thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190617
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 401190617,
					"content": "#Klee lên một mình cũng không vui... Hức, {M#anh}{F#chị} Kỵ Sĩ Danh Dự ơi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190618
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401190618,
					"content": "Hân hạnh được phục vụ, tiểu thư \"Ma Nữ\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401190619
					]
				},
				{
					"id": 401190619,
					"content": "Thật sao, cái đó nhìn cao quá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401190620,
					"content": "Nếu lỡ bất cẩn ngã xuống thì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190621
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401190621,
					"content": "...Thì Paimon vẫn đang bay mà?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401190622
					]
				},
				{
					"id": 401190622,
					"content": "#Tôi, tôi lo cho {NICKNAME} thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401190623
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401190623,
					"content": "Không sao, tôi sẽ đi chung, tôi cũng lâu rồi không lên đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Idyia"
				}
			]
		},
