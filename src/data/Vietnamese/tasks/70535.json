				]
			},
			"dialogs": [
				{
					"id": 705350201,
					"content": "Dạ! Klee biết rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350202
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705350202,
					"content": "Nhưng mà... cá vừa nổ xong là tươi nhất đó! Đem nướng thêm chút là vừa giòn vừa thơm ngon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350203
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705350203,
					"content": "Bé Klee đừng lo, Jean đã dặn dò chị trước rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350204
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705350204,
					"content": "Chị đã đặt món ở quán Người Săn Hươu rồi. Mấy ngày nay họ sẽ chọn cá ngon vừa được câu từ trong hồ lên để chế biến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350205
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705350205,
					"content": "Cộng thêm gia vị và nước sốt mà Klee thích nhất, thêm cả trà bánh mà chị chuẩn bị... Chắc chắn sẽ ngon như lúc em nổ cá đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350206
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705350206,
					"content": "Dạ! Vậy thì em sẽ nghe theo chị Lisa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350207
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705350207,
					"content": "Mấy ngày này Klee sẽ chuyên tâm chơi \"Hành Trình Bùng Nổ Của Dodoco\", sẽ không đi nổ cá, không gây phiền phức cho bạn của anh Albedo nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350208
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705350208,
					"content": "#Vậy Klee đi tìm {M#anh}{F#chị} Kỵ Sĩ Danh Dự và Paimon đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350209
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705350209,
					"content": "Hihi, có ai muốn tìm chúng tôi thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350210,
						705350211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705350210,
					"content": "Hiếm khi thấy Lisa và Klee xuất hiện chung với nhau đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705350212
					]
				},
				{
					"id": 705350212,
					"content": "#{M#Anh}{F#Chị} Kỵ Sĩ Danh Dự! Còn có Paimon nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350213
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705350213,
					"content": "#Klee vừa muốn đi tìm hai người đó, không lẽ có phép thuật nào đã báo tin cho {M#anh}{F#chị} Kỵ Sĩ Danh Dự sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350214
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705350214,
					"content": "Chà! Hai cưng đến đúng lúc lắm, không cần chị phải cất công viết thư nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350215,
						705350216
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705350215,
					"content": "Là tấm lòng của Klee đã gọi chúng tôi đến đấy!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705350217
					]
				},
				{
					"id": 705350217,
					"content": "Chúng tôi đang khá rảnh, nên định đến đây tìm sách đọc... Nhưng \"Hành Trình Bùng Nổ Của Dodoco\" là gì vậy? Nghe có vẻ thú vị hơn sách bình thường nhiều đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705350218,
					"content": "Là trò chơi mới mà chị Lisa đã làm cho Klee đó, tên cũng cùng nhau đặt ra. Paimon vừa nghe là đã nhớ rồi, thông minh thật đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350219
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705350219,
					"content": "Lisa biết thiết kế trò chơi sao! Tôi còn tưởng trí tuệ của Lisa... thuộc về mấy quyển sách chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705350220,
					"content": "Haha, chỉ là tham khảo trò chơi \"Nấm Nổ Lăn Tròn\" từ thời còn đi học thôi, sau đó cải tiến lại nên cũng không tốn nhiều công sức...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350221
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705350221,
					"content": "Chỉ cần để bé Klee vui vẻ trải qua \"giai đoạn đặc biệt\" này, thì thiết kế thêm vài trò cũng đáng mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350222
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705350222,
					"content": "Giai đoạn đặc biệt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705350223
					]
				},
				{
					"id": 705350223,
					"content": "À nhớ rồi, lúc nãy hình như có nhắc đến bạn của Albedo đúng không? Dạo này Mondstadt xảy ra chuyện gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705350224,
					"content": "Cũng không quá nghiêm trọng đâu, nhưng đúng là nên xử lý cẩn thận...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350225
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705350225,
					"content": "Dạo này Hồ Rượu Trái Cây xuất hiện loài cá đến từ Sumeru, nếu để chúng sinh sôi thì sẽ ảnh hưởng đến hệ sinh thái dưới nước của Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350226
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705350226,
					"content": "Cũng may khi bé Klee lén ra ngoài chơi đã phát hiện loài cá lạ này. Ừm... đã bắt lên vài con rồi đi hỏi Kaeya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350227
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705350227,
					"content": "Nếu không có Klee thì khi mọi người phát hiện ra chúng, cá vốn có trong hồ đã bị đuổi sang nơi khác rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350228
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705350228,
					"content": "Nếu như hệ sinh thái dưới nước biến đổi, sẽ ảnh hưởng đến chất lượng nước của Hồ Rượu Trái Cây, rồi sẽ ảnh hưởng đến ngành rượu... Trở thành vấn đề kinh tế của cả Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350229
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705350229,
					"content": "Hihi, lần này Klee lập công rồi! Sau khi đội trưởng Jean biết còn biểu dương Klee nữa đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350230,
						705350231
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705350230,
					"content": "Klee lập công lớn rồi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705350232
					]
				},
				{
					"id": 705350232,
					"content": "Không ngờ lại xảy ra chuyện này! Nguy hiểm thật!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705350233,
					"content": "Giờ đội điều tra đã phái vài thành viên đi thăm dò Hồ Rượu Trái Cây, nhằm tìm ra sào huyệt của loài cá lạ đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350234
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705350234,
					"content": "Trong giai đoạn này, để tránh kinh động đến \"kẻ xâm nhập\", Klee không thể mang \"báu vật\" của em ấy chạy lung tung được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350235
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705350235,
					"content": "Thiết bị của đội điều tra rất nhạy, gây nổ trong một khoảng cách nhất định quanh hồ sẽ ảnh hưởng đến kết quả thăm dò.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350236
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705350236,
					"content": "Jean nói là để Klee ở trong thành mãi thì em ấy cũng chán.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350237
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705350237,
					"content": "Mà Albedo đang bận cải tiến thiết bị thí nghiệm của đội du kích, Kaeya cũng vừa đi công tác, nên nhiệm vụ trông chừng em ấy đã giao cho chị đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350238
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705350238,
					"content": "#Giờ đã không còn chán nữa rồi! Klee rất mong chờ vào \"Hành Trình Bùng Nổ Của Dodoco\" mà chị Lisa phát minh đó! Klee muốn chơi cùng {M#anh}{F#chị} Kỵ Sĩ Danh Dự và Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350239,
						705350240
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705350239,
					"content": "Cùng chơi nào!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705350241
					]
				},
				{
					"id": 705350241,
					"content": "Ừm, trò \"Hành Trình Bùng Nổ Của Dodoco\" được đặt ở khu vườn bên kia, đơn hàng của quán Người Săn Hươu cũng sẽ giao tới đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350242
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705350242,
					"content": "Vừa thưởng thức món ngon, hoa thơm gió mát, lại vừa chơi cùng bé Klee. Cơ hội hiếm có đấy, nhớ tận hưởng nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350243
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705350243,
					"content": "Ơ, vậy là... Lisa không đi chung với chúng tôi à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350244
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705350244,
					"content": "Chị là người thiết kế trò chơi, nên nếu tham gia sẽ phạm luật đó, cũng sẽ ảnh hưởng đến niềm vui của mọi người khi chơi mất...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350245
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705350245,
					"content": "Hơn nữa, thân là thủ thư thì chị phải có mặt ở đây chứ, trách nhiệm cơ bản mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350246
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705350246,
					"content": "Nghe như lại tìm lý do để không phải ra ngoài nữa rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350247
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705350247,
					"content": "Ngoan nào. Mấy cưng hãy chơi với bé Klee nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705350248,
						705350249
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705350248,
					"content": "Được thôi, cứ yên tâm!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705350250
					]
				},
				{
					"id": 705350250,
					"content": "Được rồi, vậy chúng ta gặp lại sau nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705350249,
					"content": "Vất vả rồi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705350250
					]
				},
				{
					"id": 705350240,
					"content": "Chơi đến tối luôn!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705350241
					]
				},
				{
					"id": 705350231,
					"content": "Jean biểu dương đúng mà!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705350232
					]
				},
				{
					"id": 705350216,
					"content": "Là phép thuật đã gọi chúng tôi đến đấy!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705350217
					]
				},
				{
					"id": 705350211,
					"content": "Hình như là cả hai vừa quyết định chuyện gì đó sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705350212
					]
				}
			]
		},
