			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Soraya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220060301,
					"content": "Cám ơn bạn, Nhà Lữ Hành. Phù... Vừa rồi dọa tội chết khiếp, Đạo Bảo Đoàn ngày càng ngông cuồng rồi",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060302
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060302,
					"content": "Bạn là ai?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060303
					]
				},
				{
					"id": 220060303,
					"content": "Tôi là Soraya, một học giả thực địa, hiện tại tôi đang nghiên cứu ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060304
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060304,
					"content": "Vài ngày trước, lần theo manh mối tôi tìm được một di tích, tại đây phát hiện ra đĩa ngọc có niên đại vào khoảng chiến tranh ma thần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060305
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060305,
					"content": "Thế nhưng khi vừa lấy được đĩa ngọc, chuẩn bị rời khỏi di tích liền bị Đạo Bảo Đoàn tấn công, sau một hồi chạy trốn cuối cùng vẫn bị bọn chúng bắt được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060306
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060306,
					"content": "Nếu như không có các bạn, tôi cũng như đĩa ngọc sẽ gặp nguy hiểm, cảm ơn các bạn một lần nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060307
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060307,
					"content": "Bạn cũng là học giả ư?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060308
					]
				},
				{
					"id": 220060308,
					"content": "... Cũng? Vẫn còn học giả khác đang tiến hành nghiên cứu ở đây sao, tên của người đó là gì vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060309
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060309,
					"content": "Bao'er ư... Đợi một lát, trong nhóm Đạo Bảo Đoàn tấn công tôi, cũng có kẻ nhắc đến cái tên như vậy, chúng nói \"sao có thể để Bao'er một mình chiếm đoạt báu vật được\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060310
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060310,
					"content": "Lại có sự việc trùng hợp như vậy chăng... Rất xin lỗi vì tò mò nhưng có thể kể cho tôi nghe về người có tên là Bao'er được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060311
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060311,
					"content": "Sự việc là thế này...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060312
					]
				},
				{
					"id": 220060312,
					"content": "... \"Bao'er\" đưa địa điểm chỉ định cho bạn lại đúng là chỗ tôi chọn. Có sự \"trùng hợp\" đáng ngờ như vậy quả là khó tin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060313
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060313,
					"content": "Nếu thực sự là thành viên của Đạo Bảo Đoàn, vậy thì theo suy đoán của tôi chúng đã sớm theo dõi tôi và đợi thời cơ... \"Cướp lấy báu vật\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060314
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060314,
					"content": "Người có tên \"Bao'er\" muốn một mình độc chiếm báu vật nên đã ra tay trước, nhưng chỉ dựa vào một mình sức lực của cô ta thì khó có thể tìm hết một khoảng đất rộng lớn như vậy, vì vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060315
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060315,
					"content": "Xem ra... Nhà Lữ Hành cũng bị lợi dụng mất rồi. E rằng vị trí lần này cũng là do cô ta chọn sẵn rồi, chỉ có điều đồng bọn của cô ta và tôi đều nhanh hơn bạn một bước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060316
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060316,
					"content": "Không đáng ngại, trước mắt chỉ là phán đoán của tôi thôi, thế nhưng cái tên \"Bao'er\"... Thực sự rất đáng ngờ, có lẽ đây là một cái tên giả hoặc là biệt danh mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060317
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060317,
					"content": "Nhà Lữ Hành, bạn có thể có thể hợp tác với tôi được không? Cho dù thế nào cũng không thể để đĩa ngọc rơi vào tay kẻ khả nghi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060318,
						220060319
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060318,
					"content": "Không thành vấn đề.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060320
					]
				},
				{
					"id": 220060320,
					"content": "Cám ơn bạn, có điều nếu bạn tay trắng quay lại chắc chắn sẽ khiến cô ta nghi ngờ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060321
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060321,
					"content": "Hay là thế này đi, ở đây tôi có một món đồ không quý giá lắm, bạn đưa cho cô ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060322
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060322,
					"content": "Tuy chỉ là món mồi nhỏ, nhưng đủ để yên lòng cô ta trong chốc lát.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060325
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060325,
					"content": "Bây giờ hãy mau quay về đi. Tuy Đạo Bảo Đoàn bị bạn đánh cho tơi tả, nhưng do hành động một mình chắc chắn bọn chúng không có cách nào thông báo cho ả biết về chuyện này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060326
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060326,
					"content": "À còn nữa, nếu ả tiếp tục nhờ bạn đi tìm thứ gì đó và bạn thực sự tìm thấy hãy mang chúng đến cho tôi. Hiện tại tôi đang ở Nhà trọ Vọng Thư.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060327
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060327,
					"content": "Hừm, tuy khả năng có hạn... Tôi sẽ cố gắng bảo vệ văn vật nhiều nhất có thể.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060319,
					"content": "Tay trắng quay về sẽ khiến cô ta nghi ngờ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060323
					]
				},
				{
					"id": 220060323,
					"content": "Ừm, cũng có lý, hay là như vậy, ở đây tôi có một món đồ không quý giá lắm, bạn đưa cho cô ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060324
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060324,
					"content": "Tuy chỉ là món mồi nhỏ, nhưng đủ để yên lòng cô ta trong chốc lát.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060325
					],
					"speakerTitle": "Soraya"
				}
			]
		},
