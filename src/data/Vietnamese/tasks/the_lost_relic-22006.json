			"dialogs": [
				{
					"id": 220060601,
					"content": "Sao bạn đi lâu thế, có phát hiện gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060602,
						220060603
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220060602,
					"content": "Tôi tìm thấy một thứ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060604
					]
				},
				{
					"id": 220060604,
					"content": "Hả... Tuy món đồ này cũng không tệ, nhưng so với thứ mà tôi đang tìm kiếm thì khác khá xa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060605
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220060605,
					"content": "Còn món văn vật này tạm thời cứ để tôi bảo quản. Bạn yên tâm tôi nhất định sẽ tận dụng được giá trị tối đa của nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060609
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220060609,
					"content": "Bạn thật vất vả quá, những thứ này tôi cho bạn đó, mau nhận đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060610
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220060610,
					"content": "Haizz, điều lo lắng nhất bây giờ là món văn vật ấy vẫn chưa thể tìm thấy, thật khiến người khác lo lắng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220060603,
					"content": "Đây là món đồ bạn đang tìm sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060606
					]
				},
				{
					"id": 220060606,
					"content": "Tuy món đồ này không tồi, nhưng không phải thứ tôi đang tìm kiếm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060607
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220060607,
					"content": "Món đồ như vậy chắc chắn bạn không biết cách bảo quản đâu, còn có thể làm hỏng nó đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060608
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220060608,
					"content": "Hay là để tôi bảo quản hộ cho, tôi nhất định sẽ tận dụng được giá trị tối đa của nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060609
					],
					"speakerTitle": "Bao'er"
				}
			]
