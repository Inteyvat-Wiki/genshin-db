			"dialogs": [
				{
					"id": 220060701,
					"content": "May quá, đĩa ngọc không bị hỏng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060702,
						220060706
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060702,
					"content": "Khi bị chúng vây bắt sao bạn không giao thứ này cho chúng chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060703
					]
				},
				{
					"id": 220060703,
					"content": "Một món văn vật có thể làm tài liệu cho học giả nghiên cứu, cũng có thể làm cảm hứng cho nghệ thuật gia hoặc trưng bày cho người dân chiêm ngưỡng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060704
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060704,
					"content": "Nhưng tuyệt đối không thể dung túng cho bọn cướp đem bán nó, điều này không chỉ là nỗi ô nhục với văn vật mà còn chà đạp lên lịch sử.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060705
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060705,
					"content": "Tôi không tha thứ cho những ai vấy bẩn văn vật và chà đạp lên lịch sử.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060706,
					"content": "Chiếc đĩa ngọc này...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060707
					]
				},
				{
					"id": 220060707,
					"content": "Hửm? Bạn có hứng thú với chiếc đĩa này sao? Bạn muốn tìm hiểu giá trị thực sự của nó hay là giá trị đồng tiền vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060708
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060708,
					"content": "Tôi chỉ đùa mà thôi, chiếc đĩa ngọc này ghi lại lịch sử thời kỳ chiến tranh ma thần, ồ mà hình như nhắc đến cuộc đấu tranh giữa hai bộ tộc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060709
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060709,
					"content": "Việc giải mã chúng có thể bổ sung vào kho tài liệu còn thiếu trong kho sách của Giáo Viện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060710
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060710,
					"content": "Có điều những \"tài liệu còn thiếu\" sớm được bổ sung rồi, chỉ là tôi không được phép xem mà thôi...",
