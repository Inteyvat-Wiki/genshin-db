			"dialogs": [
				{
					"id": 220060101,
					"content": "Rốt cuộc là ở đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060102
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220060102,
					"content": "Bạn lại rơi thứ gì sao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060103
					]
				},
				{
					"id": 220060103,
					"content": "Lần này không phải \"rơi mất\", chỉ là mới bắt đầu tìm kiếm! Thế nhưng tìm thế nào cũng không tìm thấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060104
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220060104,
					"content": "Rốt cuộc là ở đâu cơ chứ, khó khăn lắm mới xác định được vị trí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060105
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220060105,
					"content": "Bạn đến giúp tôi tìm đi, thứ văn vật quý giá như vậy, tuyệt đối không thể để lưu lạc ra bên ngoài!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060106,
						220060107
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220060106,
					"content": "Được rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060108
					]
				},
				{
					"id": 220060108,
					"content": "Bạn qua bên kia tìm, còn tôi ở đây tìm tiếp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060109
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220060109,
					"content": "Nhất định phải tìm ra được nó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220060107,
					"content": "Lần này lại là thứ văn vật thế nào cơ chứ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060110
					]
				},
				{
					"id": 220060110,
					"content": "Là một thứ... Rất cổ! Có thể truy ngược về... 1000 năm trước, à không phải nói là thời kỳ chiến tranh ma thần mới đúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060111
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220060111,
					"content": "Tóm lại là thứ rất quý giá, không thể để nó rơi vào tay người ngoài! Bạn mau tìm giúp tôi nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bao'er"
				}
			]
		},
