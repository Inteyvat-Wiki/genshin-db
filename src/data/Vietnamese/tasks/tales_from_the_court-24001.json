			"dialogs": [
				{
					"id": 240010401,
					"content": "Barea! Cục cưng ơi, cưng đi đâu vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010402
					],
					"speakerTitle": "Staelle"
				},
				{
					"id": 240010402,
					"content": "Nó tìm một nơi yên tĩnh, tự cho bản thân một kỳ nghỉ nhỏ ấy mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010403
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010403,
					"content": "Cảm ơn sĩ quan Blathine nhé. Tiểu thuyết tiếp theo của tôi chắc chắn sẽ nhắc tới cô!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010404
					],
					"speakerTitle": "Staelle"
				},
				{
					"id": 240010404,
					"content": "Cảm ơn, nhưng mong cô đừng lãng phí giấy mực cho chuyện này. Không ai hứng thú với cuộc sống đời thường của sĩ quan đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010405
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010405,
					"content": "Tôi sẽ viết câu chuyện cực kỳ kịch tính... bảo đảm thú vị!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010406
					],
					"speakerTitle": "Staelle"
				},
				{
					"id": 240010406,
					"content": "Lời hứa thú vị này của cô đã khiến tâm trạng tôi kịch tính luôn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010407
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010407,
					"content": "Nhưng phần kết thì vẫn cần phải suy nghĩ! Để tôi nghĩ xem nên viết ai làm đồng đội của cô...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Staelle"
				}
			]
