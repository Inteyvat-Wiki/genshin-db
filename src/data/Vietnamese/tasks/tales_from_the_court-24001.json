			"dialogs": [
				{
					"id": 240010101,
					"content": "Mong cô giúp đỡ, khi nãy tôi đang nghĩ cốt truyện cho tiểu thuyết, sơ ý để Barea chạy mất rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010102
					],
					"speakerTitle": "Staelle"
				},
				{
					"id": 240010102,
					"content": "Cô có chắc là Barea không bị bỏ lại trên ghế Viện Ca Kịch hay bị buộc ở cửa nhà vệ sinh chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010103
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010103,
					"content": "Tôi đều tìm cả rồi. Bên dưới chỗ ngồi cũng tìm một lượt, nhưng vẫn không thấy Barea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010104
					],
					"speakerTitle": "Staelle"
				},
				{
					"id": 240010104,
					"content": "Barea nhỏ bé, lẽ nào bị người ta dắt đi, hay đi theo ai đó rồi sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010105
					],
					"speakerTitle": "Staelle"
				},
				{
					"id": 240010105,
					"content": "Cô Staelle, tôi chắc chắn Barea sẽ không lặp lại sai lầm lần thứ hai đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010106
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010106,
					"content": "Nhưng Barea còn nhỏ như vậy... Tuổi nhỏ sẽ liên tục mắc những sai lầm giống nhau, không chừng Barea còn thấy vui nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010107
					],
					"speakerTitle": "Staelle"
				},
				{
					"id": 240010107,
					"content": "Tuổi của Barea không nhỏ như cô nghĩ đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010108,
						240010109
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010108,
					"content": "Barea là...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240010110
					]
				},
				{
					"id": 240010110,
					"content": "Là chó của cô Staelle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010111
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010111,
					"content": "Là người thân của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010112
					],
					"speakerTitle": "Staelle"
				},
				{
					"id": 240010112,
					"content": "Người thân của cô ấy vừa đi lạc mất rồi, cô ấy đang tìm tôi giúp đỡ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010113
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010113,
					"content": "...Cô Staelle, xung quanh đây chúng ta tìm cả rồi, Barea có lẽ đã chạy ra bên ngoài.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010114
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010114,
					"content": "Vậy chúng ta ra ngoài xem sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010115
					],
					"speakerTitle": "Staelle"
				},
				{
					"id": 240010115,
					"content": "Tôi đề nghị cô ở lại trong thành. Với bộ váy như vậy, dù có tìm được Barea thì cô cũng không thể đuổi kịp nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010116
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010116,
					"content": "Nhảm nhí, chỉ cần nghe thấy tôi là Barea sẽ chạy đến ngay!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010117
					],
					"speakerTitle": "Staelle"
				},
				{
					"id": 240010117,
					"content": "Vậy khi nãy chúng ta tìm quanh Viện Ca Kịch khá lâu, e là nó không nghe thấy thật rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010118
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010118,
					"content": "Để Barea ngoan ngoãn về với cô Staelle, một mình tôi không chắc xử lý được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010119
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010119,
					"content": "Vì trách nhiệm, tôi không thể rời khỏi vị trí quá lâu, càng không thể để các đồng nghiệp cũng rời vị trí như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010120
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010120,
					"content": "Nhà Lữ Hành, nếu bạn đồng ý, có thể giúp đỡ chúng tôi không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010121,
						240010122
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010121,
					"content": "Không thành vấn đề...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240010124
					]
				},
				{
					"id": 240010124,
					"content": "Chuyện này cứ quyết định vậy đi, phiền bạn cùng tôi đi ra ngoài tìm thử nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010125
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010125,
					"content": "Với thể lực và cân nặng của Barea, chắc nó không thể chạy quá xa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010126
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010126,
					"content": "Barea rất khỏe mạnh đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010127
					],
					"speakerTitle": "Staelle"
				},
				{
					"id": 240010127,
					"content": "Nếu cô nói về đời sống tinh thần của Barea thì tôi rất đồng ý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010128
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010128,
					"content": "Vậy xuất phát thôi, lỡ như Barea cảm thấy tự do sẽ vui hơn thì sẽ còn chạy xa hơn nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010129
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010129,
					"content": "Này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Staelle"
				},
				{
					"id": 240010122,
					"content": "Sĩ quan cũng phải lo chuyện này à...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240010123
					]
				},
				{
					"id": 240010123,
					"content": "Công dân của Đại Sảnh Fontaine cần giúp, tôi không có lý do để chối từ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010124
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010109,
					"content": "Có chuyện phiền phức gì sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240010110
					]
				}
			]
