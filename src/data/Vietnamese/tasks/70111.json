			},
			"dialogs": [
				{
					"id": 701110301,
					"content": "Gì vậy trời, hết cả hồn, ầm ĩ cả buổi hóa ra chỉ là pháo hoa thôi à...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 701110302,
					"content": "Thật là rực rỡ... Đi theo Đại Nhân Narukami Ogosho chinh chiến bao năm, tôi chưa từng thấy hoa lửa nào đẹp đến thế...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110303
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110303,
					"content": "Ra vậy, đây chính là cảnh tượng kỳ diệu mà điện hạ Yu Huangyi muốn tôi chiêm ngưỡng sao... Thật khiến tôi kinh ngạc và vui mừng tột độ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110304
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110304,
					"content": "\"Đêm tối như ngọc đen, giữa mây hoa chen bóng, thân tựa bọt giữa dòng; Bỗng chốc hóa lặng thinh, sao tan mưa tản chìm vào hư không...\" Ôi, thật là tao nhã...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110305
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110305,
					"content": "Dù chưa biết tao nhã ở chỗ nào... nhưng thôi kệ, không sao là được rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
