			},
			"dialogs": [
				{
					"id": 701110101,
					"content": "Quý khách, xin dừng bước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110102
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110102,
					"content": "Bỏ qua những chi tiết rườm rà, tôi có một việc muốn nhờ. Hôm trước, điện hạ Yu Huangyi của Liyue đã gửi cho tôi một báu vật hiếm có, nhưng đến giờ vẫn chưa tới...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110103
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110103,
					"content": "Tôi nghi là nó đã bị những người thủ hộ của nơi này đoạt mất. Nếu quý khách thấy báu vật mà điện hạ Yu Huangyi nhắc đến, có thể giúp tôi lấy lại không? Tới lúc đó, tôi nhất định sẽ gửi quà đáp lễ xứng đáng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				}
			]
		},
		{
			"id": 7011102,
			"completionStepIds": [
				7011102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7011102",
							"2"
						],
						"stepId": 7011102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Soga Sumidanoryu Sakon Shigehira"
				],
				"points": [
					{
						"sceneId": 103,
						"position": [
							322.275,
							205.963,
							571.86
						],
						"pointId": 229
					}
				]
			},
			"dialogs": [
				{
					"id": 701110201,
					"content": "Chúng tôi về rồi này! Xem thử đi, đây có phải báu vật đó không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 701110202,
					"content": "Ôi, cảm kích vô cùng, cảm kích vô cùng! Cảm ơn hai vị đã giúp đỡ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110203
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110203,
					"content": "Vậy không chần chừ nữa, tôi mở ngay đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110204
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110204,
					"content": "Đây, đây là...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110205
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110205,
					"content": "Oái! Cái này sắp phát nổ đấy à?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 701110206,
					"content": "Điện hạ Yu Huangyi sẽ không hại tôi đâu... Hay là nó đã bị những người thủ hộ tìm thấy rồi cải tạo thành thứ gọi là \"đạn nổ\"?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110207
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110207,
					"content": "Thật là xấu hổ, nhưng tôi lại chẳng biết cách tháo gỡ đạn nổ... Đành chịu thôi, ném nó ra ngoài vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110208
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110208,
					"content": "Đừng lo! Tôi còn nhớ có một vị điện hạ từ Hyperborea hình như từng nói về cách ném đạn nổ thần thánh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110209
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110209,
					"content": "\"Phải đếm đến ba, không được nhiều hơn, cũng không được ít hơn. Không được đếm bốn, cũng không được đếm hai, năm là đếm nhiều rồi. Khi đếm đến ba...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110210
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110210,
					"content": "Nói nhiều quá rồi! Không ném ngay đi là nổ thật đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
