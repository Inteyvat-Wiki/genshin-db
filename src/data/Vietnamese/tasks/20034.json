			"dialogs": [
				{
					"id": 200340101,
					"content": "Được rồi...hôm nay cũng phải cố gắng hoàn thành ủy thác!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340102,
						200340106
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340102,
					"content": "Năng nổ nhỉ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200340103
					]
				},
				{
					"id": 200340103,
					"content": "Đương nhiên rồi, làm nhà mạo hiểm rất thú vị mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340104
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340104,
					"content": "Nhưng mà...hì hì, khi thực hiện ủy thác, vẫn còn nhiều việc chưa quen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340105
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340105,
					"content": "Nhà Lữ Hành, có thể cùng tôi thực hiện ủy thác một lần nữa không? Tôi vẫn còn việc muốn học hỏi bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340108
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340108,
					"content": "Vậy chúng ta mau xuất phát đi, ủy thác hôm nay là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340109
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340109,
					"content": "Ừm...lại là hộ tống Khí Cầu Vận Chuyển...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340106,
					"content": "Muốn tôi đi cùng cô sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200340107
					]
				},
				{
					"id": 200340107,
					"content": "Có được không? Hì hì, tôi có rất nhiều việc muốn hỏi bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340108
					],
					"speakerTitle": "Anna"
				}
			]
		},
