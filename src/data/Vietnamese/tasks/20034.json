					"content": "Tiền bối Bennett vẫn luôn đáng tin cậy như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340302
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340302,
					"content": "Tiền bối Fischl... những gì cô ấy nói vẫn mạnh mẽ hơn bao giờ hết!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340303,
						200340308
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340303,
					"content": "Về Bennett.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200340304
					]
				},
				{
					"id": 200340304,
					"content": "Bạn nói tiền bối Bennett?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340305
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340305,
					"content": "Khi tôi mới vào hiệp hội, tiền bối Bennett đã giải đáp cho tôi rất nhiều vấn đề, và cũng giúp tôi rất nhiều việc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340306
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340306,
					"content": "Nhưng tôi nghe nói, tiền bối Bennett rất xui xẻo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340307
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340307,
					"content": "Đúng là không công bằng, rõ ràng là một người tốt như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340313
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340313,
					"content": "Phù...vậy là cũng đã hoàn thành ủy thác, cảm ơn Nhà Lữ Hành, bây giờ tôi về hiệp hội báo cáo đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340314
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340314,
					"content": "Nhưng tại sao mấy ngày liên tiếp tôi đều phải hộ tống khí cầu nhỉ...hiệp hội không còn ủy thác khác sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340308,
					"content": "Về Fischl.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200340309
					]
				},
				{
					"id": 200340309,
					"content": "Tiền bối Fischl...ừm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340310
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340310,
					"content": "Cô ấy, cô ấy cũng rất đáng tin cậy! Kỹ thuật bắn tên rất tốt, cũng từng thực hiện rất nhiều ủy thác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340311
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340311,
					"content": "Mặc dù những lời cô ấy nói...tôi cũng không hiểu cho lắm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340312
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340312,
					"content": "Nhưng cô ấy cũng là một...là một nhà mạo hiểm giàu kinh nghiệm! Không, không đúng, là điều tra viên!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340313
					],
					"speakerTitle": "Anna"
				}
			]
		},
