				"points": []
			},
			"dialogs": [
				{
					"id": 200340201,
					"content": "Fischl, lúc nãy cô đi quá nhanh, rất nguy hiểm đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340202
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 200340202,
					"content": "Quả Báo Sấm Sét của bổn công chúa tuyệt đối sẽ không tha cho tà ác nảy sinh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340203
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 200340203,
					"content": "Tiền bối Fischl và tiền bối Bennett, xin chào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340204
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340204,
					"content": "Là Anna à, cả Nhà Lữ Hành nữa, các bạn đến đây thực hiện ủy thác của hiệp hội sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340205
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 200340205,
					"content": "Ồ! Là người được bổn công chúa chúc phúc thần thánh, nghĩ lại đúng là sợi dây vận mệnh đã đưa bạn đến đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340206
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 200340206,
					"content": "Tiểu thư rất bất ngờ khi gặp bạn ở đây, cô ấy rất vui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340207
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 200340207,
					"content": "Tôi đi cùng Anna để thực hiện ủy thác.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200340208
					]
				},
				{
					"id": 200340208,
					"content": "Đúng vậy, tôi và Nhà Lữ Hành đang hộ tống khí cầu vận chuyển.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340209
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340209,
					"content": "Nhưng mà đột nhiên tôi nhìn thấy một đám Đạo Bảo Đoàn xông về phía chúng tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340210
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340210,
					"content": "Xin lỗi xin lỗi, là do tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340211
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 200340211,
					"content": "Vốn dĩ tôi và Fischl đã nhận ủy thác, phải điều tra tung tích của một đám Đạo Bảo Đoàn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340212
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 200340212,
					"content": "Khó khăn lắm Oz mới nắm được hướng đi của đối phương, khi chúng tôi chuẩn bị đi bắt bọn chúng...Tôi vấp phải một cành cây bên đường và ngã lăn ra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340213
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 200340213,
					"content": "Bọn Đạo Bảo Đoàn thấy có động tĩnh liền quay đầu bỏ chạy, chúng tôi chỉ biết đuổi theo phía sau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340214
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 200340214,
					"content": "Không cần lo lắng. Ánh sáng trừng phạt màu tím xanh được định sẵn để phán xét số phận của kẻ thủ ác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340215
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 200340215,
					"content": "Nhưng tiểu thư, người thực sự ra tay bắt bọn thủ ác là Nhà Lữ Hành...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340216
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 200340216,
					"content": "O, Oz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340217
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 200340217,
					"content": "Nói chứ, lần này cảm ơn các bạn rất nhiều, may mà có các bạn chặn lại phía trước!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340218
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 200340218,
					"content": "Xem ra hôm nay tôi thật may mắn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340219
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 200340219,
					"content": "Có thể giúp được các bạn là tốt rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200340220
					]
				},
				{
					"id": 200340220,
					"content": "Hì hì, vậy chúng ta đưa đám Đạo Bảo Đoàn này về hiệp hội trước đi, trên đường thực hiện ủy thác các bạn cũng phải cẩn thận nhé, nhất là để ý dưới chân!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bennett"
				}
			]
		},
