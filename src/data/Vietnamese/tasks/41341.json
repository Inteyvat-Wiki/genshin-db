			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bé Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413410201,
					"content": "#Quý, quý khách, chào {F#chị}{M#anh}, nếu... nếu muốn nghỉ ngơi xin hãy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410203
					],
					"speakerTitle": "Bé Yu"
				},
				{
					"id": 413410203,
					"content": "#{F#Chị}{M#Anh} đến tặng Đèn Tiêu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410204
					]
				},
				{
					"id": 413410204,
					"content": "Tặng Đèn Tiêu...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410205
					],
					"speakerTitle": "Bé Yu"
				},
				{
					"id": 413410205,
					"content": "Yu, Đèn Tiêu này tặng bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410206
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410206,
					"content": "Mengmeng? Í, Đèn Tiêu này là bạn làm ư? Cảm...cảm ơn bạn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410207
					],
					"speakerTitle": "Bé Yu"
				},
				{
					"id": 413410207,
					"content": "#Là {F#chị}{M#anh} này dạy mình làm đó, thực ra không khó lắm, bạn... bạn thích chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410208
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410208,
					"content": "Đèn Tiêu này làm rất đẹp! Mình thích lắm, mình còn đang buồn vì không biết lấy đâu ra thời gian để làm Đèn Tiêu này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410209
					],
					"speakerTitle": "Bé Yu"
				},
				{
					"id": 413410209,
					"content": "Cảm ơn bạn, Mengmeng, lát nữa mình sẽ đi nhờ người tới giúp treo chiếc Đèn Tiêu này lên trước cửa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410210,
						413410211
					],
					"speakerTitle": "Bé Yu"
				},
				{
					"id": 413410210,
					"content": "Tại sao phải nhờ người tới giúp treo Đèn Tiêu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410212
					]
				},
				{
					"id": 413410212,
					"content": "Cái này à, ừm... cha em sức khoẻ không tốt, không thể tới treo Đèn Tiêu. Em lại lùn tí, chắc chắn cũng không treo lên nổi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410213
					],
					"speakerTitle": "Bé Yu"
				},
				{
					"id": 413410213,
					"content": "Muốn treo Đèn Tiêu lên cửa, chỉ còn cách đi nhờ người xung quanh tới giúp...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410214,
						413410215
					],
					"speakerTitle": "Bé Yu"
				},
				{
					"id": 413410214,
					"content": "Để tôi giúp cho.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410216
					]
				},
				{
					"id": 413410216,
					"content": "#{F#Chị}{M#Anh} đồng ý giúp ư? Vậy thì tốt quá, cảm ơn {F#chị}{M#anh}. Em còn đang lo nếu đi tìm người giúp đỡ thì ai sẽ trông cửa tiệm giúp đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bé Yu"
				},
				{
					"id": 413410215,
					"content": "Được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410216
					]
				},
				{
					"id": 413410211,
					"content": "Trong nhà không có ai treo Đèn Tiêu ư?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410212
					]
				}
			]
		},
		{
			"id": 4134104,
			"completionStepIds": [
				4134104
