				"points": []
			},
			"dialogs": [
				{
					"id": 413410101,
					"content": "Làm Đèn Tiêu khó quá đi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410102
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410102,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410103
					]
				},
				{
					"id": 413410103,
					"content": "#{F#Chị}{M#Anh}, {F#chị}{M#anh} biết làm Đèn Tiêu không? Mengmeng không biết làm Đèn Tiêu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410104
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410104,
					"content": "Xuyên qua xuyên lại, không cẩn thận là sẽ rơi mất, hoặc là làm đứt mất dây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410105
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410105,
					"content": "Meng vốn dĩ muốn làm Đèn Tiêu tặng cho Yu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410106
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410106,
					"content": "Yu luôn phải trông coi tiệm trà, không có thời gian chơi, cũng không có thời gian làm Đèn Tiêu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410107
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410107,
					"content": "Nhưng chắc là Yu cũng có ước nguyện muốn xin nhỉ, cho nên Mengmeng muốn làm một chiếc Đèn Tiêu tặng cho Yu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410108,
						413410109
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410108,
					"content": "#Để {F#chị}{M#anh} giúp em làm nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410110
					]
				},
				{
					"id": 413410110,
					"content": "Nhưng, Mengmeng muốn tự mình làm sau đó tặng cho Yu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410111
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410111,
					"content": "Hơn nữa, Mengmeng muốn biết bí quyết làm Đèn Tiêu, như vậy Meng còn có thể kể cho Yu nghe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410112
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410112,
					"content": "#{F#Chị}{M#Anh}, có thể... có thể dạy Mengmeng làm Đèn Tiêu không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410113
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410113,
					"content": "Không thành vấn đề.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410114
					]
				},
				{
					"id": 413410114,
					"content": "#Cám ơn {F#chị}{M#anh}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410115
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410115,
					"content": "Đèn Tiêu như vậy là xem như... làm xong rồi nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410116
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410116,
					"content": "#Cảm ơn {F#chị}{M#anh}! Chúng ta mau đi tặng Đèn Tiêu cho Yu đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410109,
					"content": "#{F#Chị}{M#Anh} làm một cái cho em là được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410110
					]
				}
			]
		},
		{
			"id": 4134102,
			"completionStepIds": [
				4134102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
