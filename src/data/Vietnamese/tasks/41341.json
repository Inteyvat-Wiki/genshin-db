			"dialogs": [
				{
					"id": 413410701,
					"content": "Hình như là hai đứa vẫn đang chơi, xem ra không cần quá lo lắng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413410702,
					"content": "Nhưng bầu không khí bây giờ, hình như không nên lại gần?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410703,
						413410704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413410703,
					"content": "Muốn nghe xem chúng đang nói gì...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410705
					]
				},
				{
					"id": 413410705,
					"content": "Làm vòng hoa cho bố của Yu, ông ấy sẽ khá lên một chút ư?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410706
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410706,
					"content": "Mình không biết...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410707
					],
					"speakerTitle": "Bé Yu"
				},
				{
					"id": 413410707,
					"content": "Trong sách nói, chỉ cần sống vui vẻ, dù mắc bệnh cũng sẽ khỏi rất nhanh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410708
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410708,
					"content": "Mengmeng cảm thấy, Yu đã hiểu chuyện như vậy, ngày ngày đều bận rộn trông cửa tiệm, bố của Yu chắc chắn là rất vui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410709
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410709,
					"content": "Nhưng, có lúc bố vẫn mắng mình... \"Đừng có rúc ở trong nhà mãi, ra ngoài chơi nhiều vào\" gì gì đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410710
					],
					"speakerTitle": "Bé Yu"
				},
				{
					"id": 413410710,
					"content": "\"Con không chơi cùng Mengmeng, nó sẽ vặt sạch hoa xung quanh đấy.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410711
					],
					"speakerTitle": "Bé Yu"
				},
				{
					"id": 413410711,
					"content": "Ở đây có rất nhiều hoa, làm sao ngắt hết được... Chờ một lát, mình làm một vòng hoa cho bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410712
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410712,
					"content": "Cảm ơn bạn, Mengmeng, chúng ta cũng nên trở về thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410713
					],
					"speakerTitle": "Bé Yu"
				},
				{
					"id": 413410713,
					"content": "Được... Vậy chờ khi bố bạn khoẻ lại, có phải bạn sẽ có thời gian không? Lúc đó mình sẽ lại tới tìm bạn chơi cùng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410714
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410714,
					"content": "Ừm, bố mình nhất định sẽ khoẻ lại nhanh thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410715
					],
					"speakerTitle": "Bé Yu"
				},
				{
					"id": 413410715,
					"content": "#Ấy?! {F#Chị}{M#Anh}... {F#Chị}{M#Anh} tới đây từ bao giờ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410716,
						413410717
					],
					"speakerTitle": "Bé Yu"
				},
				{
					"id": 413410716,
					"content": "Vừa mới thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410718
					]
				},
				{
					"id": 413410718,
					"content": "Ừm ừm ừm... em... em...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410719
					],
					"speakerTitle": "Bé Yu"
				},
				{
					"id": 413410719,
					"content": "Tết Hải Đăng vui vẻ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410720
					]
				},
				{
					"id": 413410720,
					"content": "#{F#Chị}{M#Anh} cũng vậy nhé, Tết Hải Đăng vui vẻ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410721
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410721,
					"content": "Tết... tết Hải Đăng vui vẻ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410722
					],
					"speakerTitle": "Bé Yu"
				},
				{
					"id": 413410722,
					"content": "#Cái đó, cảm ơn {F#chị}{M#anh} giúp đỡ, những thứ này mong {F#chị}{M#anh} nhận lấy. Bố nói, nhờ vả người khác giúp đỡ phải chuẩn bị thù lao tử tế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410723
					],
					"speakerTitle": "Bé Yu"
				},
				{
					"id": 413410723,
					"content": "Chúng em... chúng em phải về cửa tiệm trước rồi, đi thôi Mengmeng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410724
					],
					"speakerTitle": "Bé Yu"
				},
				{
					"id": 413410724,
					"content": "#Ừm, chúng em về nhé, cảm ơn {F#chị}{M#anh}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410717,
					"content": "Chẳng nghe thấy gì .",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410718
					]
				},
				{
					"id": 413410704,
					"content": "Nghe xem chúng đang nói gì đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410705
					]
				}
			]
		},
