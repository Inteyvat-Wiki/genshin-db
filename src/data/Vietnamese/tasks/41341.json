				"objectNames": [
					"Bé Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413410401,
					"content": "#Đèn tiêu này treo lên thật là đẹp, cảm ơn {F#chị}{M#anh}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410402
					],
					"speakerTitle": "Bé Yu"
				},
				{
					"id": 413410402,
					"content": "Vậy thì Yu... chúng ta đi chơi thôi, mình biết một nơi, hoa ở đó đẹp lắm luôn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410403
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410403,
					"content": "#Vừa rồi {F#chị}{M#anh} dạy mình làm Đèn Tiêu, sau khi tới đó mình cũng sẽ dạy bạn làm, được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410404
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410404,
					"content": "Chuyện này... không được, mình còn phải thu dọn cửa tiệm, mặc dù không có nhiều khách lắm, nhưng trong tiệm nhất định phải giữ sạch sẽ mới được, đây là điều bố mình luôn dặn dò.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410405
					],
					"speakerTitle": "Bé Yu"
				},
				{
					"id": 413410405,
					"content": "Vậy...vậy chúng ta không làm Đèn Tiêu, tới đó trò chuyện một lát được không? Một lát thôi rồi về, sẽ không làm lỡ thời gian của bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410406
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410406,
					"content": "Nhưng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410407,
						413410408
					],
					"speakerTitle": "Bé Yu"
				},
				{
					"id": 413410407,
					"content": "#Để {F#chị}{M#anh} giúp quét dọn cửa tiệm cho.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410409
					]
				},
				{
					"id": 413410409,
					"content": "#Ấy? Được không vậy? Chuyện này cũng... cũng phiền {F#chị}{M#anh} quá rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410410
					],
					"speakerTitle": "Bé Yu"
				},
				{
					"id": 413410410,
					"content": "#Chúng em chỉ đi một lát thôi, một lát là về, sẽ không làm lỡ thời gian của {F#chị}{M#anh}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410411
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410411,
					"content": "#Vậy thì phiền {F#chị}{M#anh}, cảm ơn {F#chị}{M#anh}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410408,
					"content": "#Chuyện quét dọn cứ giao cho {F#chị}{M#anh}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410409
					]
				}
			]
		},
		{
			"id": 4134107,
