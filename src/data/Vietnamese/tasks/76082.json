			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Maite",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760141701,
					"content": "Woa! Tên này có vẻ to hơn lúc trước nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760141702,
					"content": "Haha, đương nhiên rồi đấy. Ăn nhiều Quả Lakka mà em vất vả tìm được, quý ngài Sa Hoàng bây giờ còn tròn trịa hơn cả Paimon luôn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141703
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141703,
					"content": "Này! Đừng có lấy chị đây ra so sánh với mấy thứ kỳ quặc này nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760141704,
					"content": "#Woa! Sao thế nhỉ? Sau khi nhìn thấy {M#anh trai}{F#chị gái} {NICKNAME}, có vẻ đột nhiên hăng hái hơn hẳn... phải nói là phấn khích hơn ấy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141705
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141705,
					"content": "#Hình như là muốn đấu với {F#chị}{M#anh} {NICKNAME}... Ha, là do lúc trước bị đánh không ngóc đầu dậy nổi nên không phục à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141706,
						760141708
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141706,
					"content": "Vừa hay đúng ý!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141707
					]
				},
				{
					"id": 760141707,
					"content": "#Cẩn thận nhé {M#đại ca}{F#chị đại}. Tên này giờ đã mạnh hơn trước rồi đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141708,
					"content": "Hả? Bây giờ sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141709
					]
				},
				{
					"id": 760141709,
					"content": "#Cũng không cần phải theo ý nó. Đợi khi {M#anh trai}{F#chị gái} có hứng thú rồi đáp lại thử thách của nó cũng được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141710
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141710,
					"content": "Nó bây giờ cũng xem như đang được em để mắt rồi, em nói thì nó vẫn sẽ nghe theo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141711
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141711,
					"content": "Nào, ngoan, ngồi xuống đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141712
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141712,
					"content": "Gì mà như chó em nuôi thế?! Mà không đúng, chẳng phải cua luôn ngồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
