				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Maite"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760141401,
					"content": "#Sao vậy? {M#Anh trai}{F#Chị gái} còn chuyện gì muốn hỏi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141402,
						760141406,
						760141409,
						760141413,
						760141426
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141402,
					"content": "Về con cua đó...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141403
					]
				},
				{
					"id": 760141403,
					"content": "Haiz, tên đó tuy trông rất đáng sợ nhưng thực ra lại rất hiền lành. Giờ không còn khối đá kỳ lạ đó, có lẽ nó sẽ trở lại bình thường thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141404
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141404,
					"content": "Còn bây giờ, cứ để nó trốn kỹ mà sám hối đi đã. Dù có là do bị ảnh hưởng đi chăng nữa, việc xấu thì cũng đã làm rồi, đám cua nhỏ bị nó gây tổn thương vẫn đang phải chịu đau đớn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141405
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141405,
					"content": "Giống như tên tổng đốc xấu xa bị tấm gương mê hoặc mà đạo tặc Reed Miller đối phó lúc đầu. Tìm bao nhiêu lý do cũng vô nghĩa, muốn ăn năn thì phải có hành động thực tế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141406,
					"content": "Về loại đá kỳ lạ đó...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141407
					]
				},
				{
					"id": 760141407,
					"content": "Hì, đó chính là Đá Khát{RUBY#[D]Đá Twardowska} Vọng có thể điều khiển lòng người... ừm, chị Hidimbi nói tên nó là vậy thì phải?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141408
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141408,
					"content": "Khụ, tóm lại, xem ra cũng giống như tảng đá lớn bên Sương Nguyệt, là thứ rơi từ trên trời xuống. Nếu nó đã bay mất rồi thì chắc cũng không gây nguy hiểm gì cho chúng ta nữa đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141409,
					"content": "Về Bang Ốc Biển...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141410
					]
				},
				{
					"id": 760141410,
					"content": "#Ừm? {F#Chị}{M#Anh} muốn biết về Bang Ốc Biển à? Không vấn đề gì, vì {F#chị}{M#anh} đã là bạn của Bang Ốc Biển rồi nên muốn hỏi gì cũng được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141411
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141411,
					"content": "#Tụi em là... ừm, một \"tổ chức phối hợp và tương trợ\" giữa những người đồng trang lứa cùng đi trên một con đường. Tuy độ tuổi của {F#chị}{M#anh} có lẽ không thể tham gia cùng bọn em được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141412
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141412,
					"content": "Nhưng nếu ở Thị Trấn Nasha có chuyện gì cần \"phối hợp và tương trợ\", chỉ cần là chuyện em có thể giúp được thì cứ nói với em nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141413,
					"content": "Về người kỳ lạ lúc trước...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141414
					]
				},
				{
					"id": 760141414,
					"content": "#À, {F#chị}{M#anh} nói đến vị tư tế màu tím đó à. Tạm thời chưa ra tay với chúng ta, thì ít nhất hiện tại vẫn chưa phải kẻ thù. Chuyện của người đó chúng ta cũng cố gắng đừng xen vào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141415
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141415,
					"content": "Tò mò có ngày rước họa vào thân. Chị Katya cũng có dặn rằng cố gắng đừng tiếp xúc với đám người kỳ quặc ở Sương Nguyệt. Ngay cả một đạo tặc nhỏ bé như em, trước đây cũng suýt bị họ bắt để hiến tế cho Nguyệt Thần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141416
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141416,
					"content": "Hiến tế?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141417
					]
				},
				{
					"id": 760141417,
					"content": "Đúng vậy, đám người đó tà ma lắm, nghe nói còn lấy máu của những người khác nhau để... ừm, nghĩ thôi đã thấy sợ, thôi không nói nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141418
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141418,
					"content": "May mà lúc đó người bắt em là một đứa nhóc ngây ngô không biết gì, chỉ cần kể cho nó vài câu chuyện là đã chịu tha cho em rồi. Nếu không thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141419
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141419,
					"content": "#Thật, thật ra em cũng không sợ đâu, đạo tặc đương nhiên là không sợ rồi! Em chỉ muốn khuyên {F#chị}{M#anh} một câu, nên tránh dính dáng đến chuyện của họ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141420
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141420,
					"content": "A đúng rồi, suýt quên, lúc trước đã hứa chia sẻ nguồn tình báo. Những chuyện về Dòng Dõi Sương Nguyệt đều là chị Hidimbi nói cho em biết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141421
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141421,
					"content": "Nếu muốn tìm chị ấy... ừm, chắc vẫn còn ở gần Thị Trấn Nasha nhỉ? Chỉ cần hỏi thăm một chút thì chắc sẽ nhanh chóng tìm được thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141422,
						760141424
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141422,
					"content": "Chắc cô ấy sẽ ẩn mình một thời gian...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141423
					]
				},
				{
					"id": 760141423,
					"content": "#Hửm? Ra là {F#chị}{M#anh} đã gặp Hidimbi rồi sao? Chuyện ẩn mình em không nghe chị ấy nói... thôi được, sau này em sẽ hỏi lại sau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141424,
					"content": "Nghe mà thấy không đáng tin chút nào...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141425
					]
				},
				{
					"id": 760141425,
					"content": "Đừng lo, chị ấy uy tín lắm. Maite em đã đảm bảo như vậy rồi, không cần đa nghi thế đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141426,
					"content": "Tạm biệt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141427
					]
				},
				{
					"id": 760141427,
					"content": "Vâng, đi đường thuận lợi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maite"
				}
			]
		},
		{
			"id": 7601417,
			"completionStepIds": [
				7608202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
