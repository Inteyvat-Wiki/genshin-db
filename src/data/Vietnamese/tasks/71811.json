			"dialogs": [
				{
					"id": 718110412,
					"content": "Chuyện về \"Máy Ảnh\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718110401
					]
				},
				{
					"id": 718110401,
					"content": "Bạn đã giao xong chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110402
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 718110402,
					"content": "Giao hết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718110403
					]
				},
				{
					"id": 718110403,
					"content": "Cảm ơn, phiền bạn quá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110404
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 718110404,
					"content": "À, cái \"Máy Ảnh\" này cho bạn, cảm ơn bạn đã giúp đỡ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110405,
						718110406
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 718110405,
					"content": "Thật ngại quá...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718110407
					]
				},
				{
					"id": 718110407,
					"content": "Không sao không sao, bạn đã giúp đỡ chúng tôi rồi mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110408
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 718110408,
					"content": "Đây cũng không phải là thứ gì đó quý giá, đây là hàng dùng thử của bên Fontaine khi chúng tôi nhập hàng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110409
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 718110409,
					"content": "Tuy cái này có chút khác biệt so với bản chính thức... Nhưng trên cơ bản thì cũng có đầy đủ tính năng cho bạn trải nghiệm rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110410
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 718110410,
					"content": "...Nếu bạn thấy dùng tốt thì hãy đi quảng cáo cho mọi người giúp tôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110411
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 718110411,
					"content": "...Dù sao thì cũng cảm ơn bạn đã giúp đỡ! Cái \"Máy Ảnh\" này cho bạn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xu"
				},
				{
					"id": 718110406,
					"content": "Cái này mắc lắm đó...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718110407
					]
				}
			]
		},
