					"nextDialogs": [
						718110503
					]
				},
				{
					"id": 718110503,
					"content": "\"Máy Ảnh\"... À, vài ngày trước bà có đến Thương Hội Phi Vân để nhờ họ chụp vài tấm hình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110504
					],
					"speakerTitle": "A Sơn Bà Bà"
				},
				{
					"id": 718110504,
					"content": "Cháu đặc biệt mang ảnh đã in ra cho bà à? Cám ơn nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "A Sơn Bà Bà"
