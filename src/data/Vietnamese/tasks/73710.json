			"dialogs": [
				{
					"id": 737100101,
					"content": "♪~♪♪~♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100102
					],
					"speakerTitle": "Nón Trống Tròn"
				},
				{
					"id": 737100102,
					"content": "♫♫~♫~♫♫~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100103
					],
					"speakerTitle": "Ngọn Lửa Hân Hoan"
				},
				{
					"id": 737100103,
					"content": "Chúng tôi về rồi này, Haniyyah, Souka!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100104,
					"content": "Từ xa đã nghe thấy tiếng bước chân vui vẻ của Nón Trống Tròn và Ngọn Lửa Hân Hoan rồi. Xem ra lần này đã chơi rất vui đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100105
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737100105,
					"content": "Từ xa thế này mà cũng biết chúng vui sao? Đến giờ tôi vẫn chưa phân biệt được cảm xúc qua tiếng bước chân của các Nấm Quỷ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100106
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 737100106,
					"content": "Xem ra tôi còn phải học nhiều lắm... Biển học vô bờ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100107
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 737100107,
					"content": "Hì hì, cảm giác chuyến đi lần này thật sự rất khác biệt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100108,
					"content": "Đưa các Nấm Quỷ đi chơi một vòng rồi quay về gần Công Viên Nấm Nhỏ, cảm giác giống như là chơi mệt rồi về nhà ăn cơm vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100109,
					"content": "Hay là bây giờ chúng ta chụp ảnh chung đi? Tôi thấy nhiều nhật ký du lịch nổi tiếng trên tờ báo Chim Hơi Nước đều ghép những bức ảnh trong chuyến đi theo thứ tự thời gian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100110,
					"content": "Ngôi Sao Bạc nói tôi mới nhớ ra, mấy năm nay ở bên các Nấm Quỷ quá quen rồi nên chẳng chụp ảnh chung mấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100111
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737100111,
					"content": "Ừm! Hai người đều rất hiểu nghi thức \"kết thúc hoàn hảo\" đấy nhỉ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100112
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 737100112,
					"content": "♪♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100113
					],
					"speakerTitle": "Nón Trống Tròn"
				},
				{
					"id": 737100113,
					"content": "♫♫~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100114
					],
					"speakerTitle": "Ngọn Lửa Hân Hoan"
				},
				{
					"id": 737100114,
					"content": "Được rồi, vậy thì dùng máy ảnh này của Nón Trống Tròn, đặt lên giá đỡ rồi hẹn giờ để chụp chung nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100115,
					"content": "Khi nào Haniyyah và Souka bớt bận, chúng ta sẽ lại cùng ra ngoài chơi thật vui vẻ như thế này nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100147
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100147,
					"content": "Tuyệt vời!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100116,
					"content": "Mà nói chứ, Nón Trống Tròn chụp ảnh đẹp lắm đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100117,
					"content": "Tôi đã chọn ra mấy tấm đẹp, để chung với ảnh của chúng ta, Haniyyah và Souka cũng có thể xem luôn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100118,
						737100119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100118,
					"content": "Paimon đã tính toán hết rồi à...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737100120
					]
				},
				{
					"id": 737100120,
					"content": "Còn nữa, còn nữa... Nào, Haniyyah và Souka, tôi có mang quà về cho hai người đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100121,
					"content": "Là Macaron mà dạo trước hai người chưa kịp thử đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100122,
					"content": "Ủa! Tôi chỉ nói đùa thôi, vẫn còn nhớ sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100123
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 737100123,
					"content": "Ngôi Sao Bạc... thật cảm động...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100124
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737100124,
					"content": "Để sau này không gây phiền phức như vậy nữa, tôi phải sửa thói quen này thôi. Trước khi đi chơi phải lên kế hoạch chu đáo... không được chỉ dừng lại trên giấy tờ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100125
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737100125,
					"content": "Khi trò chuyện thư giãn với bạn bè thân thiết, những điều tự nhiên nói ra cũng phản ánh suy nghĩ thật lòng mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100126,
						737100127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100126,
					"content": "Paimon mua lúc nào thế?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737100128
					]
				},
				{
					"id": 737100128,
					"content": "Lúc chụp ảnh ở Đại Sảnh Fontaine ấy mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100129,
					"content": "#Lúc {NICKNAME} đang cùng Nón Trống Tròn ngắm cảnh, tôi đã nhờ một nhóc bán báo mua giúp, còn đưa cho nhóc ấy một ít tiền công chạy việc nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100130,
					"content": "#Yên tâm đi, tôi cũng đã chuẩn bị cả phần của {NICKNAME} rồi, sao mà tôi quên được chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100131,
					"content": "#Tôi đã dặn nhóc bán báo đó kỹ càng rồi, vào cửa hàng là phải tìm ngay món mà {NICKNAME} thích ăn nhất đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100132,
					"content": "Nhưng mà chúng ta đã ăn hết các loại bánh ngọt ở Đại Sảnh Fontaine rồi, nên chắc không có gì mới mẻ nữa đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100133,
						737100134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100133,
					"content": "Miễn là bánh ngọt do Paimon mua thì đều ngon!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737100135
					]
				},
				{
					"id": 737100135,
					"content": "#Thật sao? Hì hì... Vậy sau này tôi sẽ mua cho {NICKNAME} nhiều hơn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100136,
					"content": "Tiếc là không có món bánh ngọt dành riêng cho các Nấm Quỷ nhỉ... Giá mà có thể ôm các Nấm Quỷ, rồi cùng nhau thưởng thức một bàn đầy món ngon thì tuyệt biết mấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100137,
					"content": "Chuyện này thì không cần lo đâu. Trong cuốn \"Lý Luận Tổng Hợp Về Nấm Quỷ\" mà tôi hoàn thiện, đã có nghiên cứu sâu về loại thực phẩm mà Nấm Quỷ thích ăn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100138
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737100138,
					"content": "Mục tiêu là tìm ra những nguyên liệu chung giữa Nấm Quỷ và loài người, để các đồng đội không phải ăn Rau Câu Kỳ Diệu với đủ vị suốt cả năm nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100139
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737100139,
					"content": "Rồi sẽ có ngày tôi tìm ra được nguyên liệu phù hợp với vị giác của cả loài người và Nấm Quỷ, làm ra những món ăn ngon mà cả hai đều thích!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100140
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737100140,
					"content": "Đến lúc bắt tay vào nấu thì cứ để tôi đảm nhận! Để tránh Haniyyah làm cháy cái nồi thứ mười một.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100141
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 737100141,
					"content": "Xem ra ngày chúng ta ngồi ăn uống cùng các Nấm Quỷ cũng không còn xa nữa rồi nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100142,
						737100143
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100142,
					"content": "Chỉ chờ tin vui từ Haniyyah nữa thôi đó!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737100144
					]
				},
				{
					"id": 737100144,
					"content": "Vậy thì hãy thường xuyên ghé Công Viên Nấm Nhỏ chơi nhé, chúng tôi và các Nấm Quỷ luôn chờ hai người tới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100145
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737100145,
					"content": "Chưa biết chừng, bất ngờ sẽ đến sớm hơn mong đợi đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100146
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 737100146,
					"content": "♪!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nón Trống Tròn"
				},
				{
					"id": 737100143,
					"content": "Chỉ chờ bữa tiệc thịnh soạn của Souka nữa thôi đó!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737100144
					]
				},
				{
					"id": 737100134,
					"content": "Paimon chủ động mua cho thì phải khác chứ!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737100135
					]
				},
				{
					"id": 737100127,
					"content": "Tôi còn không biết luôn đó...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737100128
					]
				},
				{
					"id": 737100119,
					"content": "Paimon chu đáo quá!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737100120
					]
				}
			]
		}
	]
