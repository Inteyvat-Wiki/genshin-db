					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130618,
					"content": "Sucrose",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130619
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130619,
					"content": "Dạ, đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130620
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130620,
					"content": "Trông chừng nhà mạo hiểm này, đem hắn trở về doanh trại đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
