					"nextDialogs": [
						412130303
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130303,
					"content": "Bạn chưa quay về sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130304
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130304,
					"content": "Đây không phải là nhà mạo hiểm lỗ mãng ở Mondstadt sao? Anh ta cũng theo Cyrus đến núi tuyết thám hiểm à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130305,
					"content": "Lạnh lạnh lạnh quá đi, hu hu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130306
					],
					"speakerTitle": "Pallad Lỗ Mãng"
				},
				{
					"id": 412130306,
					"content": "Sau khi được tôi cứu khỏi hố tuyết, bạn vẫn ở đây sao?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130307
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130307,
					"content": "Tôi cũng có muốn đâu, chỉ là tôi bị lạc đường thôi mà! Xin lỗi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130308
					],
					"speakerTitle": "Pallad Lỗ Mãng"
				},
				{
					"id": 412130308,
					"content": "Phù phù... lạnh chết được, không thể đi nổi được nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130309
					],
					"speakerTitle": "Pallad Lỗ Mãng"
				},
				{
					"id": 412130309,
					"content": "Haiz, Pallad, anh thật coi thường chuyến đi đến núi tuyết này quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130310
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130310,
					"content": "Chúng ta dẫn anh ta về vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130311
					]
				},
				{
					"id": 412130311,
					"content": "Được sao? Giờ anh ta như vậy, e rằng phải đỡ thì mới có thể về được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130312
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130312,
					"content": "Dù không thể thì cũng không để anh ta ở đây được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130313,
					"content": "Nói cũng phải... Xin lỗi Nhà Lữ Hành, tôi, tôi thay anh ta xin lỗi bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130314
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130314,
					"content": "Còn có thời gian suy nghĩ cho người khác sao? Lo cho bản thân mình trước đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130315
					],
					"speakerTitle": "???"
				},
				{
					"id": 412130315,
					"content": "A! Là Fatui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130316,
					"content": "Hẳn là các người cũng biết mục đích của tôi khi đến đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130317
					],
					"speakerTitle": "Vadim"
				},
				{
					"id": 412130317,
					"content": "Giao thanh kiếm ra, không thì đừng hòng rời khỏi đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130318
					],
					"speakerTitle": "Vadim"
				},
				{
					"id": 412130318,
					"content": "Không được, đừng giao thanh kiếm cho chúng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130319,
						412130320
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130319,
					"content": "Đương nhiên là không thể giao rồi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130321
					]
				},
				{
					"id": 412130321,
					"content": "Rất khí thế! Tiêu diệt chúng đi nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130322,
					"content": "Pallad, để tôi dẫn anh đến nơi an toàn, mau lên!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130323
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130323,
					"content": "Thật là ngây thơ! Không ai được phép rời khỏi đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130324
					],
					"speakerTitle": "Vadim"
				},
				{
					"id": 412130324,
					"content": "Lấy thanh kiếm đó làm quà dâng hiến cho đại nhân Signora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vadim"
				},
				{
					"id": 412130320,
					"content": "Không ai có thể đoạt lấy thứ này!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130321
					]
				}
			]
		},
