					"nextDialogs": [
						412130611
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130611,
					"content": "Cây Cấp Đông chết ở chỗ này, không lẽ do nó không thể hấp thu sức mạnh bị ô nhiễm sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130612
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130612,
					"content": "Sức mạnh nguyên tố sau khi được Nhà Lữ Hành thanh tẩy không chỉ khiến sinh vật hồi sinh, thậm chí còn khiến nó mạnh hơn nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130613
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130613,
					"content": "Sức mạnh sinh lực sẽ khiến nó không ngừng hồi sinh... Xem ra, sau này còn phải liên tục chiến đấu nữa rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130614,
						412130615
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130614,
					"content": "Chuyện này còn phiền phức hơn cả tưởng tượng nữa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130616
					]
				},
				{
					"id": 412130616,
					"content": "Tôi cũng chưa từng gặp phải chuyện này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130617
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130617,
					"content": "Nói gì đi nữa thì đây cũng là thu hoạch ngoài ý muốn rồi.",
					"roleType": "TALK_ROLE_NPC",
