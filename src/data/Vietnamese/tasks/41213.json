					"Sucrose"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412130201,
					"content": "Thật lợi hại, lần đầu tiên tôi được nhìn thấy loại vũ khí như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130202
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130202,
					"content": "Bạn cũng thật lợi hại, bất kể là tư thế chiến đấu hay khí thế vung kiếm đều rất hoàn hảo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130203
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130203,
					"content": "Bạn quá khen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130204
					]
				},
				{
					"id": 412130204,
					"content": "Thanh kiếm này thật đặc biệt, rõ ràng không có ý muốn nghiên cứu sâu, nhưng mắt lại cứ bị hấp dẫn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130205
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130205,
					"content": "Tôi lại cảm thấy so với thuộc tính của kiếm thì cái này giống với thuộc tính của bạn hơn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130206,
					"content": "Thanh kiếm đơn thần bí nguy hiểm và hấp dẫn, ừm, không sai đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130207
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130207,
					"content": "Giao cho bạn thứ quan trọng như vậy, đúng là ngài Albedo rất tin tưởng bạn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130208,
						412130209
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130208,
					"content": "Chuyện này tôi cũng rất bất ngờ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130210
					]
				},
				{
					"id": 412130210,
					"content": "Khì khì, lòng tin này cũng là đánh đổi bằng bản lĩnh mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130211,
					"content": "Tôi cũng cảm thấy vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130212
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130212,
					"content": "Nhưng trước khi giao cho bạn, kiếm vẫn chưa hấp thu được nhiều năng lượng... Sao ngài Albedo có thể phát hiện sự khác biệt của nó nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130213
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130213,
					"content": "Cảm hứng chớp nhoáng thường không có quy luật. Ví dụ như tôi muốn ăn thịt nướng mật ong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130214,
					"content": "À, nếu nói vậy thì hôm nay tôi vẫn chưa ăn gì nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130215
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130215,
					"content": "Làm xong thí nghiệm là vội đến tìm các bạn, nhưng trên đường lại gặp nhà mạo hiểm mắc kẹt trong tuyết, tôi đã mất khá nhiều thời gian để cứu cậu ấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130216
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130216,
					"content": "(Ục.. ục...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130217
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130217,
					"content": "Tiếng ban nãy là tiếng đói bụng sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130218
					]
				},
				{
					"id": 412130218,
					"content": "Á á á! Không, không phải như thế...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130219
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130219,
					"content": "Đừng ngại ngùng thế, cứ nói lên suy nghĩ của bạn nào",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130220,
					"content": "Nhưng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130221
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130221,
					"content": "Vậy tôi nói trước: Tôi đói bụng, tôi muốn ăn cơm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130222,
						412130223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130222,
					"content": "Đói bụng rồi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130224
					]
				},
				{
					"id": 412130224,
					"content": "Bụng... bụng đói rồi, muốn ăn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130225
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130225,
					"content": "Hơ ơ! Thật xấu hổ quá đi mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130226
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130226,
					"content": "Không đâu, thừa nhận đói bụng thì sẽ càng ăn ngon miệng hơn thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130227,
					"content": "Là thế sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130228
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130228,
					"content": "Đúng vậy! Cho nên hãy ráng tỉnh táo đi tìm thức ăn nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130229,
					"content": "Nếu có thể, tôi muốn ăn Thịt Nướng Mật Ong trong tiết trời lạnh giá này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130223,
					"content": "Tôi muốn ăn cơm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130224
					]
				},
				{
					"id": 412130209,
					"content": "Rất cảm ơn ngài ấy đã tin tưởng tôi như vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130210
					]
				}
			]
		},
