			"dialogs": [
				{
					"id": 412130101,
					"content": "Albedo! Chúng tôi lại đến rồi đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130102,
					"content": "Hửm? Hình như Albedo không ở đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130103,
					"content": "Đi điều tra rồi sao, hay là lại đi vẽ những bản phác thảo bí ẩn rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130104,
					"content": "A! Là các bạn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130105
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130105,
					"content": "Đây chẳng phải Sucrose sao, sao bạn lại ở đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130106,
					"content": "Nghiên cứu của tôi vừa kết thúc, hôm nay tôi có khoảng 5 tiếng 26 phút rảnh rỗi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130107
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130107,
					"content": "Cho nên tôi đến để hỏi thăm chuyện tôi nhờ các bạn làm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130108
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130108,
					"content": "Thời gian thật chính xác, bạn là đồng hồ hình người sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130109,
					"content": "Không không không, chuyện này không có gì đáng khen cả, bạn khách sáo quá rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130110
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130110,
					"content": "Người ta đâu có khen bạn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130111,
					"content": "Nhà Lữ Hành, tôi, tôi có thể hỏi không? Chuyện tôi nhờ bạn điều tra việc mà Albedo che giấu vẫn thuận lợi chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130112
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130112,
					"content": "Nếu giác quan của tôi không có vấn đề, thì đã hơn một tuần rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130113,
					"content": "Tôi còn tưởng bạn quên rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130114
					]
				},
				{
					"id": 412130114,
					"content": "Cái gì...!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130115
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130115,
					"content": "Một, một tuần?! Rõ ràng tôi... á!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130116
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130116,
					"content": "Hic, tôi quá chăm chú vào việc nghiên cứu nên quên mất chuyện này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130117
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130117,
					"content": "Nên nói là khái niệm thời gian của cô ấy quá mạnh hay quá yếu đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130118,
					"content": "Cho nên! Bạn đã biết câu trả lời rồi đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130119,
						412130120
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130119,
					"content": "Ừm, có thể nói là vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130121
					]
				},
				{
					"id": 412130121,
					"content": "Tuyệt quá, có thể nói cho tôi nghe không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130122
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130122,
					"content": "Paimon, bạn thấy thế nào?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130123
					]
				},
				{
					"id": 412130123,
					"content": "Ừm... nói với cô ấy có lẽ không sao đâu nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130124,
					"content": "Nhìn cũng được, chỉ cần không sờ vào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130125,
					"content": "Khoan đã, các bạn đang nói gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130126
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130126,
					"content": "Đây là...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130127,
						412130128
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130127,
					"content": "Đây là chuyện Albedo che giấu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130129
					]
				},
				{
					"id": 412130129,
					"content": "Là một thanh kiếm rất lợi hại, không được chạm tay vào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130130,
					"content": "Ừm... Đây là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130131
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130131,
					"content": "!!Đây, đây là!! Tôi chưa từng được thấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130132
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130132,
					"content": "Khì khì, hãy tận hưởng đi! Không biết tại sao ngay cả tôi cũng có cảm giác thành tựu kỳ lạ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130133,
					"content": "Thật lợi hại, lần đầu tiên tôi được thấy vũ khí thần kỳ như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130134
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130134,
					"content": "Tôi mơ hồ có thể cảm thấy sức mạnh đang chảy chậm rãi bên trong thanh kiếm... nó giống như một sinh vật sống.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130135
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130135,
					"content": "Cảm giác rõ ràng vậy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130136,
					"content": "Có lẽ là do tôi từng học thuật giả kim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130137
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130137,
					"content": "Tôi không dám sử dụng phép tu từ quá tuyệt đối, nhưng thật sự là có cảm giác \"chảy\". Tuy cách nói này rất nghiêm trọng... Vốn, vốn dĩ tôi sẽ không dùng đến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130138
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130138,
					"content": "Hãy tin tôi, bình thường tôi tuyệt đối không dùng cách nói mơ hồ này đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130139
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130139,
					"content": "Được được được, tôi biết rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130140
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130140,
					"content": "Nhà Lữ Hành, cho hỏi... bạn có thể dùng thanh kiếm này để chiến đấu không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130141
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130141,
					"content": "Tôi muốn tìm hiểu thêm, nhưng tôi không thể sử dụng nó, đành phải nhờ bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130142,
						412130143
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130142,
					"content": "Bí mật, đừng để Albedo biết.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130144
					]
				},
				{
					"id": 412130144,
					"content": "Vậy thì tìm một nơi thích hợp gần đây đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130143,
					"content": "Tìm một nơi khó bị phát hiện sẽ tốt hơn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130144
					]
				},
				{
					"id": 412130128,
					"content": "Đây là đáp án bạn muốn biết.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130129
					]
				},
				{
					"id": 412130120,
					"content": "Điều tra rõ ràng hết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130121
					]
				}
			]
		},
		{
			"id": 4121302,
