					"nextDialogs": [
						412130507
					]
				},
				{
					"id": 412130507,
					"content": "Sao đến tôi cũng có cảm giác chột dạ nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130508,
					"content": "Tôi, tôi chỉ là... Xin lỗi xin lỗi, tôi chỉ đi ngang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130509
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130509,
					"content": "Hừm, tôi nghĩ, có thứ gì đó thu hút bạn rồi đúng không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130510
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130510,
					"content": "Tôi đã nói chuyện thanh kiếm cho Sucrose nghe rồi, xin lỗi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130511
					]
				},
				{
					"id": 412130511,
					"content": "Nói cho cô ấy nghe hết rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130512
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130512,
					"content": "Chỉ nói cho cô ấy nghe lai lịch với thuộc tính của thanh kiếm thôi, không có để cô ấy chạm vào nó! Điều này chúng tôi vẫn nhớ mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130513,
					"content": "Kệ vậy, dù sao cũng không thể giấu được thêm bao lâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130514
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130514,
					"content": "Sucrose rất thích nghiên cứu các kiến thức và bí mật, đúng là rất thích hợp để nguyên cứu thuật giả kim",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130515
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130515,
					"content": "...Tôi không dám gây phiền phức nữa! Tôi hứa trước nghiên cứu mới của tôi đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130516
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130516,
					"content": "Tôi thì không sợ phiền phức, chỉ lo cho sự an nguy của các bạn thôi. Lần sau chú ý hơn nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130517
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130517,
					"content": "À đúng rồi, nhà mạo hiểm ở bên kia có chuyện gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130518
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130518,
					"content": "Ban nãy tôi phụ trách bảo vệ Pallad, tôi nghĩ anh ta không bị thương đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130519
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130519,
					"content": "Lạnh... lạnh chết mất...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130520
					],
					"speakerTitle": "Pallad Lỗ Mãng"
				},
				{
					"id": 412130520,
					"content": "Hình như bị cảm lạnh rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130521
					],
					"speakerTitle": "Paimon"
				},
				{
