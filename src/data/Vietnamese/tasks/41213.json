						412130503
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130503,
					"content": "Albedo đại nhân, chúng tôi không phải cố ý...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130504
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130504,
					"content": "Sucrose, bạn không phải đang sắp xếp tài liệu sao? Sao lại đột nhiên chạy đến chỗ này.",
