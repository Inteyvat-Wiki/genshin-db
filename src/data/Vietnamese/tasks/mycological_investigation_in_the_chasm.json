			},
			"dialogs": [
				{
					"id": 710500701,
					"content": "Đã hái nấm về rồi đây.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500702
					]
				},
				{
					"id": 710500702,
					"content": "Ừm ừm, đa tạ đa tạ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500703
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500703,
					"content": "Có sự giúp đỡ của bạn, việc điều tra của tôi giống như... có câu nói của Liyue nên nói thế nào nhỉ, \"giống như hổ gắn thêm cánh vậy đó\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500704
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500704,
					"content": "Như hổ mọc cánh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500705
					]
				},
				{
					"id": 710500705,
					"content": "Đúng, quả nhiên là như hổ mọc cánh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500706
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500706,
					"content": "Số nấm này sao lại thế chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500707
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500707,
					"content": "Vậy thì kỳ lạ quá, loại nấm này quả thật giống y đúc một loại nấm ở Sumeru, nhưng sao lại phát sáng, là do sinh trưởng trong bóng tối nên mới sản sinh ra nguyên tố huỳnh quang sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500708
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500708,
					"content": "Nhưng nếu đã tiến hóa ra nguyên tố huỳnh quang, thì tại sao bản thể của nó lại không có chút gì thay đổi chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500709,
						710500710
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500709,
					"content": "Hoàn toàn không hiểu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500711
					]
				},
				{
					"id": 710500711,
					"content": "Ừm... Nói đơn giản thì, nấm sẽ tiến hóa để thích hợp với môi trường, nhưng bản thể của loại nấm này thì rõ ràng là chủng loại thích hợp sống ở môi trường rừng rậm hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500712
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500712,
					"content": "Cho nên, loại nấm này vốn dĩ sinh trưởng ở Sumeru, điểm này thì không có gì phải nghi ngờ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500713
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500713,
					"content": "Vậy thứ phát sáng là...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500714
					]
				},
				{
					"id": 710500714,
					"content": "Nấm không phải là sinh vật nguyên thủy ở Vực Đá Sâu, chứng tỏ việc phát sáng không phải là sản phẩm tiến hóa, mà là bị ảnh hưởng bởi sinh thái bất thường...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500715
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500715,
					"content": "Có lẽ là do mảnh vỡ đã rớt từ trên trời xuống rồi hấp thụ năng lượng của nó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500716,
						710500717
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500716,
					"content": "Mảnh vỡ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500718
					]
				},
				{
					"id": 710500718,
					"content": "Haha... Ừm? Vừa nãy bạn nói gì, mảnh vỡ? À, là tôi nói, chắc chắn là do mảnh vỡ của nấm khi rơi từ trên trời xuống đã tạo ra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500719
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500719,
					"content": "Tạo ra biến dị ngẫu nhiên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500720
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500720,
					"content": "Chắc chắn là vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500721
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500721,
					"content": "Ừm, có thể thu thập số nấm này thật cảm ơn bạn, vất vả cho bạn rồi, hãy đi nghỉ ngơi đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500722
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500722,
					"content": "Tôi phải nghiên cứu thêm về loại nấm này, nếu có người bên cạnh sẽ ảnh hưởng đến tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500717,
					"content": "Mảnh vỡ gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500718
					]
				},
				{
					"id": 710500710,
					"content": "Có vấn đề gì sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500711
					]
				}
			]
		}
	]
