			"dialogs": [
				{
					"id": 710500401,
					"content": "Về loại nấm này...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500402
					]
				},
				{
					"id": 710500402,
					"content": "Có nên nói rằng không hổ danh là nhà mạo hiểm kinh nghiệm phong phú không nhỉ, nhanh như vậy đã có phát hiện rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500403
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500403,
					"content": "Hửm? Có chắc rằng đây là nấm thu thập được ở đây không, có hơi kỳ lạ đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500404
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500404,
					"content": "Dưới lòng đất không thể mọc nấm sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500405
					]
				},
				{
					"id": 710500405,
					"content": "Cũng không phải là không thể mọc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500406
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500406,
					"content": "Chỉ là nó khá giống với một loại nấm ở Sumeru...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500407
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500407,
					"content": "Chỉ có một loại thì không đủ lắm... Nếu có đủ số lượng mẫu thì không chừng có thể phát hiện ra gì đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500408
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500408,
					"content": "Phải đủ số mẫu mới được... Dù gì cũng do bạn lấy về, thì chắc chắn sẽ biết ở đâu còn chứ... chi bằng đi hái thêm cho tôi nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500409
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500409,
					"content": "Bạn hái đủ nấm cho tôi, thì tôi sẽ trả cho bạn thù lao thật xứng đáng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500410
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500410,
					"content": "Bao nhiêu nấm là đủ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500411
					]
				},
				{
					"id": 710500411,
					"content": "Ừm... Để tôi nghĩ xem, hãy hái trước 8 cây đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500412
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500412,
					"content": "Không sao đâu, chỉ cần bạn đem đến, thì nhất định sẽ có tiền mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khedive"
				}
			]
		},
		{
			"id": 7105007,
