			"dialogs": [
				{
					"id": 230120301,
					"content": "Đã tìm được mèo về rồi sao, vất vả cho các bạn quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120302
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230120302,
					"content": "Có vẻ như \"tiếng mèo\" mà mọi người học được cũng không tồi đâu nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120303
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230120303,
					"content": "Số thù lao này cho các bạn, xin hãy nhận lấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120304
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230120304,
					"content": "Người có thể học \"tiếng mèo\" nhanh như vậy hiếm lắm, biết đâu lần sau tôi còn phải nhờ mọi người giúp đỡ đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120305
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230120305,
					"content": "Meo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230120306
					]
				},
				{
					"id": 230120306,
					"content": "Có thể nói tiếng người được rồi! Tiểu thư Sareh không phải mèo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230120307,
					"content": "Tôi có thể nhìn ra bạn muốn nói \"không vấn đề gì\" từ biểu cảm của bạn đấy. Nhưng mà... phát âm lần này của bạn sai rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120308
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230120308,
					"content": "Nhưng không sao, sau này tôi sẽ tiếp tục dạy \"tiếng mèo\" cho bạn, chúng ta cùng nhau học tập nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sareh"
				}
			]
		},
