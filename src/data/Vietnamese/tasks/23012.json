			"dialogs": [
				{
					"id": 230121101,
					"content": "Lúc trước tôi cũng có giao tiếp nghiêm túc với mèo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230121102
					]
				},
				{
					"id": 230121102,
					"content": "Bạn đang nhắc đến \"Neko\" sao? Nhưng Neko là mèo biết nói tiếng người, nên chắc không tính là \"tiếng mèo\" đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230121103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230121103,
					"content": "Đúng, nhưng xem như trao đổi, bạn phải mang một con mèo nhỏ về giúp tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230121104,
						230121105
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230121104,
					"content": "Không thành vấn đề.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230121108
					]
				},
				{
					"id": 230121108,
					"content": "Như vậy là hai bạn đã đồng ý với tôi rồi đúng không? Cảm ơn các bạn nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230121109
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230121109,
					"content": "Khụ, khụ khụ... vậy mọi người hãy nghe cho kỹ, đây là \"tiếng định hình của mèo\" mà tôi mất một khoảng thời gian rất dài mới tổng kết ra được đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230121105,
					"content": "Cách thức tìm mèo ở mỗi thành phố đều không giống nhau nhỉ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230121106
					]
				},
				{
					"id": 230121106,
					"content": "Hahaha... đúng vậy, nghĩ lại thì chúng tôi cũng đã giúp người ta đi tìm mèo ở rất nhiều thành phố rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230121107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230121107,
					"content": "Nên nói là ai cũng thích mèo hay nên nói... mỗi một người nuôi mèo đều gặp phải chuyện phiền phức như vậy đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230121108
					],
					"speakerTitle": "Paimon"
				}
			]
		},
