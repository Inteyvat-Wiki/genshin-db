				"points": []
			},
			"dialogs": [
				{
					"id": 4670101,
					"content": "Món tiếp theo làm gì nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670102
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670102,
					"content": "Hử? Các bạn cũng là những Nhà Mạo Hiểm gần đây sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670103
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670103,
					"content": "Là nhà lữ hành đi ngang qua thôi. Bạn đang chuẩn bị nấu cơm sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4670104,
					"content": "Là Nhà Lữ Hành à, chào mừng chào mừng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670105
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670105,
					"content": "Tôi là Lynn, chuyên gia sinh tồn của Hiệp Hội Nhà Mạo Hiểm, như bạn thấy tôi đang nghiên cứu nấu nướng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670106
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670106,
					"content": "Kỳ thực \"ăn no rồi lên đường\", là điều đầu tiên trong \"quy tắc sinh tồn bên ngoài\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670107
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670107,
					"content": "Đồ rừng! Tôi rất thích.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4670108,
					"content": "Bạn của tôi cũng rất giỏi nấu ăn, đúng không đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670801,
						4670901
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4670801,
					"content": "Chỉ biết một số thứ đơn giản...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4670802
					]
				},
				{
					"id": 4670802,
					"content": "Không sao, nồi đã chuẩn bị sẵn sàng rồi, để tôi xem tài nghệ của bạn đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670803
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670803,
					"content": "Chuyên gia sinh tồn đích thân hướng dẫn, cơ hội hiếm gặp!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4671001
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4671001,
					"content": "Tôi bỏ vào chút nấm rơm và thịt trong thùng, hãy làm thử một món <color=#00E1FFFF>Xiên Thịt Gà Nấm</color> đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670901,
					"content": "Đúng vậy, tôi cũng thích nấu ăn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4670902
					]
				},
				{
					"id": 4670902,
					"content": "Ồ! Nồi đã chuẩn bị sẵn sàng rồi, để tôi xem tài nghệ của bạn đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670903
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670903,
					"content": "Có cơ hội so tài nấu nướng thật hiếm gặp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4671001
					],
					"speakerTitle": "Lynn"
				}
			]
		},
