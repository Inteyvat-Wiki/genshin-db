					"speakerTitle": "Lynn"
				},
				{
					"id": 4670304,
					"content": "(rộp rộp)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670305
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670305,
					"content": "Ừm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670306
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670306,
					"content": "(nuốt nước miếng)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4670307,
					"content": "Oa... một mùi vị khó tả, miễn cưỡng đạt tiêu chuẩn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670308
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670308,
					"content": "#Hở? Chắc là {NICKNAME} chưa phát huy tốt, không tính không tính!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4670309,
					"content": "Ừm, cần phải luyện tập nhiều hơn, bạn có rất nhiều tiềm năng đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670310
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670310,
					"content": "Trong túi tôi còn một ít nguyên liệu sống, tặng cho bạn, xem như quà đáp lễ bữa ăn này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670311
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670311,
					"content": "Í? Vậy không được, bạn không có đồ để nấu phải làm sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4670312,
					"content": "Không sao, khi <color=#00E1FFFF>thám hiểm bên ngoài</color> có thể thu thập rất nhiều nguyên liệu, các bạn cũng có thể để ý lấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670313
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670313,
					"content": "<color=#00E1FFFF>Quán ăn Người Săn Hươu</color> cũng có bán món ăn và nguyên liệu, lúc rảnh có thể đến xem thử.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670314
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670314,
					"content": "Ừ ừ, cảm ơn thông tin của bạn... Này! để lại một ít Xiên Thịt Gà Nấm cho tôi chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
