			"dialogs": [
				{
					"id": 700501001,
					"content": "Hửm? Tiểu thư Guijarro đâu rồi? Vừa rồi cô ấy còn ở đây mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501002,
						700501003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501002,
					"content": "Bị Huyền Văn Thú tha đi rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501004
					]
				},
				{
					"id": 700501004,
					"content": "Đừng nói những lời đáng sợ đó chứ! Chắc chắn cô ấy lại nghĩ về tình tiết mới mà chạy lung tung rồi. Chúng ta đi xung quanh tìm cô ấy đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501005,
					"content": "Địa hình của ruộng trà bên kia rất cao, tìm từ bên kia trước nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501006
					]
				},
				{
					"id": 700501006,
					"content": "Phải tìm từ chỗ cao trước nhỉ? Ừm! Cứ làm thế đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501003,
					"content": "Đừng nói là nội dung tiểu thuyết của cô ấy đã thành sự thật đấy nhé?",
					"roleType": "TALK_ROLE_PLAYER",
