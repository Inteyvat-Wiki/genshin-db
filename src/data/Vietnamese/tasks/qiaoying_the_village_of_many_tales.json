			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Guijarro"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2163.671,
							286.632,
							1547.632
						],
						"pointId": 311400056
					}
				]
			},
			"dialogs": [
				{
					"id": 700500501,
					"content": "...Nhìn xem, đã nói nó chỉ là một con mèo vô cùng bình thường rồi mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700500502,
					"content": "Không ngờ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500503
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500503,
					"content": "Meo? Meo... Meo meo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500504,
						700500506
					],
					"speakerTitle": "Mèo Con Hoang Mang"
				},
				{
					"id": 700500504,
					"content": "Meo meo có biết Huyền Văn Thú không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500505
					]
				},
				{
					"id": 700500505,
					"content": "Meo...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500508
					],
					"speakerTitle": "Mèo Con Hoang Mang"
				},
				{
					"id": 700500508,
					"content": "Mèo con bất lực quay người bỏ đi...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						700500509
					]
				},
				{
					"id": 700500509,
					"content": "Nhưng mà... Liệu con mèo này có phải là Huyền Văn Thú lúc nhỏ không? Nó sẽ ẩn náu trong Làng Kiều Anh như thế, đợi đến khi trưởng thành sẽ dọn sạch tất cả cây trà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500510
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500510,
					"content": "Tiểu thư Guijarro, sao lại là cô... Tôi đã nói với cô rồi, Huyền Văn Thú không phải giống loài ôn hòa như thế đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500511
					],
					"speakerTitle": "Hung Fan"
				},
				{
					"id": 700500511,
					"content": "Ối, tiểu thư Hung Fan! Thật trùng hợp, sao cô cũng tới đây rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500512
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500512,
					"content": "Haiz... Đừng luôn nhắc những \"vụ án tội phạm\" gì đó ở chỗ chúng tôi nữa... Lỡ bọn trẻ tưởng thật thì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500513
					],
					"speakerTitle": "Hung Fan"
				},
				{
					"id": 700500513,
					"content": "Hai người quen nhau à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500514
					]
				},
				{
					"id": 700500514,
					"content": "Đúng thế, lúc tôi tới đây đã nhờ vị tiểu thư này chuyển hành lý giúp đó. Tôi còn hỏi thăm rất nhiều vấn đề liên quan đến truyền thuyết dân gian nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500515
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500515,
					"content": "Tôi đã nói rất nhiều lần rồi, Huyền Văn Thú sẽ không xuất hiện trong làng, nhưng tiểu thư Guijarro cứ nằng nặc không tin. Còn nói cái gì mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500516
					],
					"speakerTitle": "Hung Fan"
				},
				{
					"id": 700500516,
					"content": "Không xuất hiện, cũng sẽ có cách tìm kiếm tư liệu kiểu không xuất hiện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500517
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500517,
					"content": "Lại nữa rồi... Ôi, tiểu thư Guijarro ơi, tôi không khuyên nổi cô nữa rồi. Nhưng dù thế nào thì cô cũng đừng có rời khỏi làng mà đi lung tung nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500518
					],
					"speakerTitle": "Hung Fan"
				},
				{
					"id": 700500518,
					"content": "Huyền Văn Thú là mãnh thú thực sự tồn tại. Nếu vô tình gặp phải nó thì... Chậc, tóm lại thì cô tuyệt đối đừng rời khỏi làng một mình nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500519
					],
					"speakerTitle": "Hung Fan"
				},
				{
					"id": 700500519,
					"content": "Hung Fan bất lực rời đi, nhìn còn mệt mỏi hơn cả con mèo ban nãy...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						700500520
					]
				},
				{
					"id": 700500520,
					"content": "Được rồi, nếu tiểu thư Hung Fan đã nói thế, vậy thì chúng ta chỉ có thể đi chỗ khác tìm tư liệu thôi. Nào, đi theo tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500506,
					"content": "Thành thật xin lỗi, chúng tôi nhận nhầm mèo rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500507
					]
				},
				{
					"id": 700500507,
					"content": "Meo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500508
					],
					"speakerTitle": "Mèo Con Hoang Mang"
				}
			]
		},
		{
