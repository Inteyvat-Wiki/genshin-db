					"nextDialogs": [
						700501509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501509,
					"content": "Đúng thế. Tôi cũng nghĩ ra phương pháp mà nhân vật chính dùng để đuổi Huyền Văn Thú đi rồi. Dùng phương pháp này để kết thúc câu chuyện, chắc chắn... chắc chắn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501510
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501510,
					"content": "Ồ! Còn có phương pháp lợi hại nào sao?",
					"roleType": "TALK_ROLE_NPC",
