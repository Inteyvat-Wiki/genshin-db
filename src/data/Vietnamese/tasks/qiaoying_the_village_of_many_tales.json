						"sceneId": 3,
						"position": [
							2276.275,
							287.313,
							1542.857
						],
						"pointId": 311400058
					}
				]
			},
			"dialogs": [
				{
					"id": 700500601,
					"content": "Sao rồi? Cái này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500602
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500602,
					"content": "Vạc trà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500603
					]
				},
				{
					"id": 700500603,
					"content": "Đúng vậy! Chính là cái... cái gì nhỉ? Tóm lại... Là một thứ rất đặc biệt! Hơn nữa nó còn ở chính giữa làng, tôi cảm thấy nó chắc chắn có ý nghĩa đặc biệt gì đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500604
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500604,
					"content": "Ừm... Mọi người nói xem, Huyền Văn Thú liệu có sống ở trong đó không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500605,
						700500606
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500605,
					"content": "Nếu viết như thế thì sẽ thành tiểu thuyết giả tưởng mất.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500607
					]
				},
				{
					"id": 700500607,
					"content": "Nếu mà viết như thế thì cứ có cảm giác trong tiểu thuyết của cô sẽ còn xuất hiện các nhân tố như tiên nhân đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700500608,
					"content": "Loại tiểu thuyết trinh thám này, cứ cảm thấy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500609
					]
				},
				{
					"id": 700500609,
					"content": "...Ô! Biểu cảm của các bạn rất hay. Có phải cảm thấy nếu lấy Huyền Văn Thú làm chủ đề để viết tiểu thuyết trinh thám... thì vụ án này sẽ hết sức \"hoang đường\" không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500610
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500610,
					"content": "Đúng là hơi có cảm giác như vậy. Dù sao thì tiểu thuyết trinh thám cũng khó có thể lấy chủ đề này để phát triển nội dung mà nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700500611,
					"content": "Khoan đã, lẽ nào cô...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500612
					]
				},
				{
					"id": 700500612,
					"content": "#Ừm, {NICKNAME} rất nhạy bén. Thật không hổ danh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500613
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500613,
					"content": "Không sai. Thứ mà tôi muốn viết chính là \"vụ án hoang đường đến mức không có khả năng xảy ra\". Phản ứng của tiểu thư Hung Fan và các bạn rất thú vị, tôi sẽ ghi vào trong tiểu thuyết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500614
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500614,
					"content": "Về phần Huyền Văn Thú thì... Nó là \"tội phạm\" trong câu chuyện của tôi. Một Huyền Văn Thú trong truyền thuyết sẽ ăn thịt kẻ xấu trong làng, nhưng lại chưa có ai thực sự gặp được nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500615
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500615,
					"content": "Vào một ngày lễ, có một người trong làng bị người ta phát hiện đã bị sát hại ở bên ngoài, trông có vẻ là bị mãnh thú tấn công...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500616
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500616,
					"content": "Nhưng vào buổi lễ ngày hôm sau, nhân vật chính của tôi lại gặp được nạn nhân vốn dĩ đã chết kia. Sau đó, lại xuất hiện thêm một người chết nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500617
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500617,
					"content": "Sau đó thì sao? Sau đó thì sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700500618,
					"content": "Chưa nghĩ ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500619
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500619,
					"content": "...Tôi muốn rời khỏi đây quá.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500620
					]
				},
				{
					"id": 700500620,
					"content": "Đừng mà, chờ tôi viết xong sẽ gửi cho các bạn hai cuốn. Tôi còn có một việc quan trọng muốn nhờ các bạn giúp tôi đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500621
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500621,
					"content": "Chẳng phải tiểu thư Hung Fan luôn nói là tôi không nên rời khỏi làng một mình sao? Chuyện này tôi rất nghe lời đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500622
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500622,
					"content": "Nhưng bây giờ... Có các bạn thì không còn xem như một mình nữa rồi. Vậy là tôi cũng có thể ra khỏi làng đi dạo một chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500623
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500623,
					"content": "Đương nhiên, tôi sẽ không đi quá xa đâu! Các bạn bằng lòng giúp tôi chuyện này chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500624,
						700500625
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500624,
					"content": "Được thôi... Để có thể đọc được đoạn sau của tiểu thuyết...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500627
					]
				},
				{
					"id": 700500627,
					"content": "Vậy thì, chúng ta đi về phía kia nhé? Tôi có một chỗ rất muốn đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500625,
					"content": "Thù lao phải được trả theo đúng quy tắc đó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500626
					]
				},
				{
					"id": 700500626,
					"content": "Đương nhiên rồi. Các bạn cứ yên tâm nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500627
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500606,
					"content": "Vậy là không còn liên quan gì đến tiểu thuyết trinh thám rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500607
					]
				}
			]
		},
		{
			"id": 7005008,
