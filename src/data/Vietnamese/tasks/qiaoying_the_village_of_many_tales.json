			},
			"dialogs": [
				{
					"id": 700501201,
					"content": "Tiểu thư Guijarro! Sao cô lại ở đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501202,
					"content": "...Không đúng, cái kiểu đột nhiên tìm ra manh mối này thì đột ngột quá. Hơn nữa, một người nếu bị trói ở đây cả đêm thì liệu có còn suy nghĩ được gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501203
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501203,
					"content": "Chà... Hoàn toàn rơi vào trầm tư rồi. Cô ấy đã tìm được tư liệu quan trọng gì rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501204,
					"content": "Giống như là đang gặp trở ngại lớn hơn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501205
					]
				},
				{
					"id": 700501205,
					"content": "#...{NICKNAME}, Paimon, các bạn đến rất đúng lúc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501206
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501206,
					"content": "Có thể nhờ các bạn trói tôi vào cọc gỗ không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501207
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501207,
					"content": "Tôi, tôi không nghe nhầm đấy chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501208,
					"content": "Mời hai bạn trói tay tôi lại, sau đó buộc tôi lên một thân cây bằng tư thế hai tay treo cao. Ừm... Cùng là gỗ nên chắc cũng không khác gì mấy nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501209
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501209,
					"content": "Tôi không muốn trở thành nghi phạm trong tiểu thuyết đâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501210
					]
				},
				{
					"id": 700501210,
					"content": "Xin hãy yên tâm, tôi đã viết xong tuyên bố miễn trừ trách nhiệm rồi. Tất cả sự cố xảy ra vào lúc này đều do bản thân tôi chịu trách nhiệm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501211
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501211,
					"content": "Không phải chuyện này. Sao cô lại đột nhiên muốn chúng tôi trói cô lại chứ? Cô có phạm tội gì đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501212,
					"content": "Nhưng nhân vật chính trong tiểu thuyết của tôi phải bị các dân làng trói tay treo ở đây. Ở bên ngoài cả đêm, chờ đợi sự phán quyết của Huyền Văn Thú.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501213
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501213,
					"content": "Tình tiết tiếp theo là nhân vật chính vốn đã lường trước được tình huống này, nên đã dùng thủ đoạn nào đó để sống sót. Trải qua một đêm dài, thế là vạch trần được chân tướng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501214
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501214,
					"content": "...Nhưng tôi hoàn toàn không biết người bị trói trong một đêm sẽ có cảm giác gì. Dù là giọng điệu, cách suy nghĩ, năng lực hành động, tôi đều không biết gì cả!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501215
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501215,
					"content": "Cho nên tôi muốn nhờ các bạn trói tôi lại, để tôi ở chỗ này một đêm. Thế là tôi sẽ có thể trải nghiệm cảm giác đó rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501216,
						700501217
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501216,
					"content": "Không được, thế thì quá nguy hiểm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501218
					]
				},
				{
					"id": 700501218,
					"content": "...A. Còn một cách, nhưng cách này chưa chắc có hiệu quả tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501219
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501219,
					"content": "Đó chính là, tôi đứng ở đây cả đêm trong tư thế giơ cao hai tay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501220
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501220,
					"content": "Hay là... Đừng viết cuốn tiểu thuyết kia nữa nhé. Thế này rất dễ làm người ta hiểu lầm đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501221,
					"content": "Nhân vật chính trong tiểu thuyết của cô sao mà thảm thế...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501222
					]
				},
				{
					"id": 700501222,
					"content": "Cầu xin đó! Đây là bước mấu chốt nhất rồi. Tiểu thuyết của tôi cũng sắp hoàn thành rồi! Nếu dùng cách này thì các bạn sẽ không cần phạm tội...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501223
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501223,
					"content": "Vốn dĩ chúng tôi có cần đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501224,
					"content": "Vốn dĩ chúng tôi có cần đâu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501225
					]
				},
				{
					"id": 700501225,
					"content": "À... Chuyện đó, không cần phiền phức như thế. Chỉ cần ở bên cạnh tôi là được, kẻo tôi tìm tư liệu mà giữa đường lại bị người ta kéo đi, hoặc bị dã thú tha đi thì hỏng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501226
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501226,
					"content": "Để xem nào... Cân nhắc đến bầu không khí trong tiểu thuyết, quả nhiên còn phải đi lên chỗ cao nhất mới được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501227
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501227,
					"content": "Ơ kìa? Chờ chúng tôi đã nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501228,
					"content": "Các bạn và Guijarro cùng leo lên chỗ cao nhất của ruộng trà...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						700501229
					]
				},
				{
					"id": 700501229,
					"content": "Phù... Hơi, hơi lạnh... Nhưng rất có cảm giác đắm chìm vào trong tác phẩm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501230
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501230,
					"content": "Cô thật sự muốn giơ hai tay và đứng ở đây suốt đêm sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501231,
					"content": "Đúng thế, tôi đã quyết định rồi. Dù sao thì viết tiểu thuyết cũng phải đánh đổi một vài thứ mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501232
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501232,
					"content": "Vậy tôi nhờ các bạn trông chừng bên cạnh tôi nhé. Chỉ cần một đêm là được...",
