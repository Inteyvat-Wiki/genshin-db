			"dialogs": [
				{
					"id": 700500801,
					"content": "Những thứ này là lồng đèn sao? Trông có vẻ là lồng đèn hình con cá nhỉ, thật thú vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500802
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500802,
					"content": "Mấy cái tay cầm này là để nâng chiếc lồng đèn này lên sao? Ừm... Kiểu cấu tạo tháo lắp này, chỉ cần thiết kế hợp lý thì có lén tăng thêm một hai đoạn cũng sẽ không bị người ta phát hiện...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500803
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500803,
					"content": "Không gian bên trong rất lớn, có thể thoải mái bỏ vào đó một số...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500804
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500804,
					"content": "Ngừng! Cất kỹ ý tưởng trong đầu xuống đáy lòng đi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500805
					]
				},
				{
					"id": 700500805,
					"content": "Hửm? À...! Haha, do thấy món đồ này thú vị nên tôi lại không ngừng nói ra suy nghĩ trong đầu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500806
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500806,
					"content": "Nếu đã có nhân tố như lồng đèn thế này, vậy thì tiểu thuyết của tôi chắc chắn sẽ chân thực hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500807
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500807,
					"content": "#Có thể nhờ {NICKNAME} chụp lại một bức ảnh cho chiếc đèn lồng hình cá này không? Tôi muốn lưu trữ một ít hình ảnh để tham khảo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500808,
						700500809
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500808,
					"content": "Kỹ thuật chụp ảnh của tôi lại sắp tiến bộ rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500810
					]
				},
				{
					"id": 700500810,
					"content": "#Vậy chuyện chụp ảnh nhờ vào {NICKNAME} nhé... À! Khi chụp thì hãy chụp hoàn chỉnh chiếc lồng đèn nhé, chuyện này rất quan trọng với tôi đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500811
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500811,
					"content": "Sử dụng nhân tố \"kích cỡ\" này để tạo ra âm mưu, có vẻ rất thú vị. Hmm, nhưng vấn đề trọng lượng thì phải giải quyết sao đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500809,
					"content": "Cứ để tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500810
					]
				}
			]
		},
