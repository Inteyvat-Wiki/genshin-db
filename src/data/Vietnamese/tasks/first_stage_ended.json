			"dialogs": [
				{
					"id": 3090201,
					"content": "Phù, cũng xem như giải quyết xong hết rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090202,
					"content": "Như vậy thì dòng chảy Nguyên Tố, tuần hoàn địa mạch của Mondstadt sẽ khôi phục lại chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090203,
					"content": "Có về xem tình hình của <color=#00E1FFFF>Đội Kỵ Sĩ</color> không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090204,
					"content": "Đương nhiên, nếu có việc gì thú vị hơn muốn làm, tôi cũng có thể đi cùng bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090205,
					"content": "Ví dụ như đến Mondstadt mua sắm... hoặc là đi xem <color=#00E1FFFF>Thất Thiên Thần Tượng</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090206,
					"content": "Lúc trước tôi ở trong đền của Tứ Phong Thủ Hộ, lấy được một vật giống như là được ngưng tụ từ gió.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090207,
					"content": "Ở Mondstadt, người dân gọi đó là \"Phong Thần Đồng\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090208,
					"content": "Cái tên này đại diện cho việc: Nó có tư cách được khảm vào trong khoang mắt của Thần Tượng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090209,
					"content": "Có truyền thuyết còn nói, là viên đá quý bị chim én lấy đi làm mắt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090210,
					"content": "Nhưng thật ra \"Phong Thần Đồng\" vốn không có hình dạng thật sự.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090212,
					"content": "Người có Vision sẽ thu thập nó, đem đến <color=#00E1FFFF>Thất Thiên Thần Tượng</color> để nhận được chúc phúc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090213,
					"content": "Tuy bạn không có Vision, nhưng bạn đã vượt ra khỏi quy tắc thông thường của thế giới này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090214,
					"content": "Nếu muốn thử, thì xuất phát thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090215,
					"content": "Thất Thiên Thần Tượng tại Phong Khởi Địa, chắc là bức tượng gần chúng ta nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090216,
					"content": "Rất mong đợi... lần này, không biết Thần sẽ trả lời bạn như thế nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
