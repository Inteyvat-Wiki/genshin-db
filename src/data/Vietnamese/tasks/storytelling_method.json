			"dialogs": [
				{
					"id": 728120201,
					"content": "Xong rồi, câu chuyện đến đây là kết thúc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120202
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 728120202,
					"content": "Tôi chưa từng thấy mệt mỏi như vậy, câu chuyện này thật sự phức tạp thế sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120203
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 728120203,
					"content": "Đây chính là hậu quả của việc không vạch sẵn dàn bài trước đấy. Không có sẵn khuôn khổ, mọi thứ trong câu chuyện sẽ rối tinh rối mù lên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120204
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 728120204,
					"content": "Trường hợp này, anh không hề nắm được phần cốt lõi của câu chuyện thì tình tiết có viết như thế nào cũng sẽ gãy gánh giữa đường thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120205
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 728120205,
					"content": "Haiz, tôi không có sức để cãi với anh nữa...Nhà Lữ Hành, cám ơn bạn đã đưa ra những...phán đoán này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120206
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 728120206,
					"content": "Những phán đoán này rất...có ích với tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120207
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 728120207,
					"content": "Bạn hãy nhận lấy món quà cám ơn này, tôi sẽ về viết tiểu thuyết tiếp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120208
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 728120208,
					"content": "Dàn ý và tình tiết, haiz...cái nào quan trọng hơn nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				}
