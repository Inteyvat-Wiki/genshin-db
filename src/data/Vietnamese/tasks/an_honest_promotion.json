						],
						"pointId": 340100766
					}
				]
			},
			"dialogs": [
				{
					"id": 756510101,
					"content": "#Dạo này {NICKNAME} làm ủy thác vất vả lắm đúng không? Tôi đã nhìn thấy hết rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510102,
					"content": "#Thân là một người dẫn đường chu đáo, tôi có trách nhiệm giúp {NICKNAME} thư giãn một chút. Tada! Mau nhìn xem đây là nơi nào này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510103,
						756510105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510103,
					"content": "Trên biển hiệu viết là, Bách Hóa Damoville.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510104
					]
				},
				{
					"id": 756510105,
					"content": "À, là nơi trú ngụ của những kẻ trộm Mora, cũng là nghĩa địa của ví tiền.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510106
					]
				},
				{
					"id": 756510104,
					"content": "Xin chào, chào mừng đến với Bách Hóa Damoville.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510107
					],
					"speakerTitle": "Boucicaut"
				},
				{
					"id": 756510106,
					"content": "Quý khách, nói như vậy không đúng lắm đâu. Bách Hóa Damoville luôn bán hàng với giá rẻ và chất lượng cao. Các vị có thể tham khảo giá cả mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510107
					],
					"speakerTitle": "Boucicaut"
				},
				{
					"id": 756510107,
					"content": "Đây không phải là cửa tiệm bình thường đâu. Đây là nơi lý tưởng để những người lao động vất vả có thể thư giãn bằng cách tiêu tiền đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510108,
					"content": "Nói đúng lắm, gần đây chúng tôi còn mở sự kiện giảm giá mua một tặng một nữa! Hoan nghênh tất cả khách hàng đến tham gia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510109
					],
					"speakerTitle": "Boucicaut"
				},
				{
					"id": 756510109,
					"content": "Mua thì tôi lỗ, không mua thì các vị lỗ đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510110
					],
					"speakerTitle": "Boucicaut"
				},
				{
					"id": 756510110,
					"content": "Lúc trước đi ngang qua, tôi có nhìn thấy áp phích sự kiện của Bách Hóa Damoville rồi, cho nên tôi đã ghi nhớ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510111,
					"content": "Tốn một phần tiền sẽ có thể mua hai phần hàng, nhìn thế nào cũng thấy có lời mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510112,
					"content": "#Tôi cứ có cảm giác không tiêu tiền ở đây thì cuộc sống của tôi sẽ có chút thiếu sót đấy... Hôm nay tôi sẽ dẫn theo {NICKNAME} cùng đi bù đắp sự tiếc nuối này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510113,
						756510114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510113,
					"content": "Paimon muốn mua gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510115
					]
				},
				{
					"id": 756510114,
					"content": "Paimon muốn bù đắp sự tiếc nuối như thế nào đây?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510115
					]
				},
				{
					"id": 756510115,
					"content": "Hihi, bí mật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510116,
					"content": "Vậy thì tôi không trả tiền đâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510117
					]
				},
				{
					"id": 756510117,
					"content": "#Hihi, hôm nay không cần {NICKNAME} trả tiền đâu, tôi có mang theo Mora đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510118,
					"content": "#Nào, hàng mà tôi đặt trước đó đã đến chưa? Tên người đặt hàng là Paimon và {NICKNAME} đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510119,
					"content": "Đã có rồi đây, hãy đợi chút nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510120
					],
					"speakerTitle": "Boucicaut"
				},
				{
					"id": 756510120,
					"content": "Chủ tiệm Boucicaut lấy ra một món hàng được đóng gói kỹ đến không thể đoán được là món gì. Paimon ở bên cạnh lấy ra một đống tiền lẻ. Nhìn thấy số tiền lẻ sắp phải rời xa như vậy, Paimon trông có chút không nỡ.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						756510121
					]
				},
				{
					"id": 756510121,
					"content": "Sau khi cùng Paimon mở gói đồ, bạn nhận ra đây là hai cuốn sổ ảnh.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 756510122,
					"content": "Cuối cùng cũng hoàn thành tâm nguyện rồi! Tôi đã chờ lâu lắm đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510123,
					"content": "Thường ngày chụp nhiều ảnh như vậy, bây giờ đã có chỗ để lưu lại rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510124,
					"content": "Tôi có thường thấy Paimon dùng máy ảnh đâu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510125
					]
				},
				{
					"id": 756510125,
					"content": "#Tôi có chụp ngay trước mặt đâu! Nhưng khi không ai để ý đến thì tôi đã chụp rất nhiều tấm hình về {NICKNAME} đó, hihi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510126,
						756510127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510126,
					"content": "Tôi có chút muốn xem đấy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510128
					]
				},
				{
					"id": 756510127,
					"content": "Mau cho tôi xem với!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510128
					]
				},
				{
					"id": 756510128,
					"content": "Bây giờ thì không được, đợi tôi chụp đầy sổ ảnh đã rồi tính.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510129,
						756510130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510129,
					"content": "Paimon thật nhỏ nhen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510131
					]
				},
				{
					"id": 756510130,
					"content": "Paimon thật xấu xa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510131
					]
				},
				{
					"id": 756510131,
					"content": "#Tôi không có như thế đâu nhé! Đây, cuốn sổ ảnh này cho {NICKNAME} đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510132,
					"content": "Tuy cuốn này có hơi mỏng, nhưng cũng có thể chứa được rất nhiều hình ảnh rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510133,
					"content": "Chúng ta đã đi qua rất nhiều nơi, thường giúp nhiều người chụp ảnh, nhưng lại không có nhiều ảnh để lại cho chính mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510134,
					"content": "Nếu có thể lưu lại nhiều ký ức về bản thân thì tốt quá, cho nên tôi đã mua hai quyển sổ ảnh này đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510135,
					"content": "Cho nên, đây là một món quà nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510136,
					"content": "Đúng vậy, mua một tặng một. Mỗi người một quyển, lúc đặt hàng trước thì tôi đã tính hết rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510137,
					"content": "#{NICKNAME} phải dùng ngay nhé, có thể chụp lại những nơi chúng ta từng đi qua, từ đó hồi tưởng lại những ký ức cũ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510138,
					"content": "#Đúng rồi, có muốn dùng máy ảnh của tôi để chụp không? Hình như {NICKNAME} chưa từng dùng qua nó thì phải?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510139,
					"content": "Trước đó tôi đã tốn rất nhiều công sức để đặt tiệm bách hóa làm riêng đấy, nếu không dùng thì tiếc lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510140,
						756510141
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510140,
					"content": "Vậy để tôi dùng thử.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510142
					]
				},
				{
					"id": 756510141,
					"content": "Cảm ơn nhé, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510142
					]
				},
				{
					"id": 756510142,
					"content": "Thích là được rồi. Đây là điều mà một người dẫn đường chu đáo nên làm mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510143
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510143,
					"content": "Đi nào! Tôi sẽ đi chụp ảnh cùng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}