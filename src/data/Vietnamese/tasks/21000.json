					"A Meng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210000301,
					"content": "Có...có thứ này nữa sao...làm em sợ chết khiếp...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000302
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210000302,
					"content": "#Cám ơn {F#chị}{M#anh}, chúng ta tiếp tục...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000303
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210000303,
					"content": "Ơ? Bình...bình trôi của em đâu rồi? Lúc nãy còn ở trên người em mà, sao không thấy đâu nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000304
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210000304,
