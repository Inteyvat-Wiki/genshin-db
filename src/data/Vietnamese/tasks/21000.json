				"points": []
			},
			"dialogs": [
				{
					"id": 210000101,
					"content": "Haiz, mình thật sự làm được sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000102
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210000102,
					"content": "Meng, sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000103
					]
				},
				{
					"id": 210000103,
					"content": "#Là {F#chị}{M#anh} à...chào {F#chị}{M#anh}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000104
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210000104,
					"content": "Meng, sao trông em có vẻ không vui vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210000105,
					"content": "Sao vậy? Bọn họ không cùng em chơi...trò hải tặc à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210000106,
					"content": "Ơ? Không phải, Lulu và Fei về nhà rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000107
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210000107,
					"content": "Em...muốn đi dạo một mình nên chưa về nhà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000108
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210000108,
					"content": "Bố mẹ em không lo lắng sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210000109,
					"content": "Bây giờ chắc là bố mẹ em vẫn còn đang làm việc chưa về.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000110
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210000110,
					"content": "#Không nói chuyện này nữa, em có thể hỏi {F#chị}{M#anh} một vấn đề không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000111,
						210000112
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210000111,
					"content": "Vấn đề gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000114
					]
				},
				{
					"id": 210000114,
					"content": "#{F#Chị}{M#Anh}, em từng nghe rất nhiều người nói về chuyện của {F#chị}{M#anh}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000115
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210000115,
					"content": "#Em thấy {F#chị}{M#anh} từng đi rất nhiều nơi, cũng từng trải qua rất nhiều chuyện...nói không chừng có thể cho em biết đáp án của vấn đề này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000116
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210000116,
					"content": "Ồ...sao đột nhiên Meng lại nghiêm túc vậy, rốt cuộc là vấn đề gì nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210000117,
					"content": "#{F#Chị}{M#Anh}, em muốn hỏi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000118
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210000118,
					"content": "Rốt cuộc một người phải như thế nào mới có thể \"trưởng thành\" ạ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000119,
						210000122
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210000119,
					"content": "Cần có thời gian để trưởng thành.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000120
					]
				},
				{
					"id": 210000120,
					"content": "#Ý {F#chị}{M#anh} là chỉ cần lớn lên, con người ta sẽ tự khắc trưởng thành sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000121
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210000121,
					"content": "Nhưng mà lớn rồi mới trưởng thành thì có muộn quá không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000124
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210000124,
					"content": "Ừm...nếu em muốn ra ngoài thành dạo chơi, mọi người có thể đi cùng em.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210000125,
					"content": "Vậy thì làm phiền quá, hơn nữa...chỉ ra ngoài thành thôi thì chắc cũng không có thu hoạch gì đặc biệt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000126
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210000126,
					"content": "#{F#Chị}{M#Anh}, em muốn nhờ hai người giúp em một việc khác...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000127
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210000127,
					"content": "Em nghe người ta nói, nếu có những phiền muộn không thể giải quyết, thì có thể viết những điều phiền muộn đó ra và bỏ vào một chiếc bình trôi, để những phiền muộn đó trôi theo dòng nước...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000128
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210000128,
					"content": "Như vậy, nói không chừng những phiền muộn cũng sẽ được giải quyết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000129
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210000129,
					"content": "Nhưng em nghe nói, bên ngoài có rất nhiều ma vật, em đi một mình sẽ không an toàn cho lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000130
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210000130,
					"content": "#Vì vậy, em muốn nhờ {F#chị}{M#anh} bảo vệ em...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000131,
						210000132
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210000131,
					"content": "Không thành vấn đề.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000133
					]
				},
				{
					"id": 210000133,
					"content": "#Cảm ơn {F#chị}{M#anh}. Em sẽ trả thù lao cho {F#chị}{M#anh}, đều là tiền em tự tiết kiệm được đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000134
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210000134,
					"content": "Vậy chúng ta xuất phát nào, đến sông Bích Thủy trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210000132,
					"content": "#Cứ giao cho {F#chị}{M#anh}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000133
					]
				},
				{
					"id": 210000122,
					"content": "Phải trải qua những chuyện đặc biệt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000123
					]
				},
				{
					"id": 210000123,
					"content": "Phải trải qua những chuyện đặc biệt...nhưng đến bây giờ, ngay cả bên ngoài cảng Liyue em còn chưa đi qua nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000124
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210000112,
					"content": "#Tạm thời {F#chị}{M#anh} không có thời gian để chơi cùng em...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000113
					]
				},
				{
					"id": 210000113,
					"content": "Hahaha, trò đó em thường chơi với Lulu và Fei, hai bạn ấy không có ở đây, em cũng không muốn chơi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000114
					],
					"speakerTitle": "A Meng"
				}
			]
		},
