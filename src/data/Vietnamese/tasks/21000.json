						210000503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210000503,
					"content": "Cũng...cũng không nhiều lắm. Em chỉ muốn biết, làm thế nào mới có thể trưởng thành thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000504
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210000504,
					"content": "Em đã tra rất nhiều tư liệu, cũng từng xem rất nhiều sách, nhưng càng xem sách, thì lại càng có nhiều chuyện em không hiểu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000505
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210000505,
					"content": "Hì hì, vì vậy em đã viết tất cả những vấn đề em không hiểu vào đó, hy vọng có thể có được đáp án.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000506
