			"dialogs": [
				{
					"id": 210000201,
					"content": "Sắp đến sông Bích Thủy rồi sao? Ừm...chúng ta chọn một chỗ thật đẹp để thả bình trôi đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000202
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210000202,
					"content": "Nếu muốn bình trôi trôi được xa, thì phải chọn vị trí ở thượng nguồn...",
					"roleType": "TALK_ROLE_NPC",
