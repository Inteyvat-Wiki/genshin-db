			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10220601,
					"content": "Đây không phải Bách Hợp Lưu Ly, Bách Hợp Lưu Ly sao có thể đánh người được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220602,
					"content": "Kẻ địch vượt quá sức tưởng tượng...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220603
					]
				},
				{
					"id": 10220603,
					"content": "Đây là ma vật có tên Hoa Lừa Dối.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220604
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220604,
					"content": "Hử? Những hoa này...? Thú vị đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220605
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220605,
					"content": "Bách Hợp Lưu Ly dùng để nguỵ trang, trồng cùng Hoa Lừa Dối khá lâu, lại tạo thành thứ thuốc cực phẩm. Trong hoạ có phúc... mau nhặt lấy những cánh hoa này đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220606
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220606,
					"content": "Còn có chuyện tốt như vậy? Những cánh hoa này có thể dùng trong Điển Lễ Tiễn Tiên không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220607,
					"content": "Đáng tiếc là không thể.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220608
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220608,
					"content": "A, sao lại như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220609,
					"content": "Xin hỏi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220610
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220610,
					"content": "Mọi người đang tìm Bách Hợp Lưu Ly?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220611
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220611,
					"content": "A! Là bạn! Ừm, à... chết rồi, không nhớ nổi tên...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220612,
						10220614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220612,
					"content": "Chào bạn, Ganyu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220613
					]
				},
				{
					"id": 10220613,
					"content": "Chào bạn, Nhà Lữ Hành, không ngờ bạn còn nhớ tên tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220617
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220617,
					"content": "Nhắc mới nhớ, hành trình Quần Ngọc Các của hai vị ra sao rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220618
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220618,
					"content": "Vì bạn không nói với chúng tôi làm thế nào để leo lên, nên chúng tôi tốn bao nhiêu sức lực mới tìm thấy đường đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220619
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220619,
					"content": "Ấy ấy ấy? Tôi, tôi chưa nói ư?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220620
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220620,
					"content": "Chúng tôi phải tự nghe ngóng mới biết đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220621,
						10220622
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220621,
					"content": "Vì không phải bí mật gì, nên không nhắc đến thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220623
					]
				},
				{
					"id": 10220623,
					"content": "Phải... phải đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220624
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220624,
					"content": "(Tiêu rồi, ta lại quên không nói rồi...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220625
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220625,
					"content": "Ừm? Cảm giác sắc mặt Ganyu không bình thường lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220626
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220626,
					"content": "Hơn nữa so với lần đầu gặp, khí chất cũng khang khác... hình như không có cảm giác nghiêm túc giống hồi đó?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220627
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220627,
					"content": "A... Vì lúc đó mang thân phận Sứ giả Thiên Quyền Tinh, nhưng hiện giờ chỉ là đang ngắm hoa mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220628
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220628,
					"content": "Ngắm hoa? Sao không ngắm trong thành, phải chạy đến tận đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220629
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220629,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220630
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220630,
					"content": "Ngọc Kinh Đài là nơi Đế Quân qua đời, ngắm hoa ở đó khiến người ta cô đơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220631
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220631,
					"content": "Mấy ngày gần đây, khi tôi làm việc gần Ngọc Kinh Đài, luôn đóng cửa sổ lại, tránh nhìn thấy phong cảnh bên ngoài...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220632
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220632,
					"content": "Ưm... xin lỗi, tôi không nên nhắc đến chủ đề này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220633
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220633,
					"content": "Không... là bản thân tôi không thể kiềm chế cảm xúc của bản thân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220634
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220634,
					"content": "Hai ngàn năm trước trong chiến tranh ma thần kết thúc, bảy vị thần sơ khai từng tụ họp ở Liyue chung vui với Đế Quân... Mà nay Thần vị đổi thay, đã có năm vị Thần ra đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220635
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220635,
					"content": "Có nghĩa là...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220636
					]
				},
				{
					"id": 10220636,
					"content": "Đúng vậy, nếu Đế Quân đã hồn quy trời cao, vậy bảy vị thần sơ khai chỉ còn lại đại nhân Barbatos của Mondstadt còn trên trần thế thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220666
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220666,
					"content": "Còn lại năm vị, bao gồm cả vị Raiden Shogun của Inazuma, đều đã không còn là người bạn cũ của 2000 năm trước nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220637
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220637,
					"content": "\"Bảy vị chấp chính trần thế\" hiện tại, Thảo Thần của Sumeru là trẻ nhất, chỉ mới năm trăm tuổi. Còn Nham Vương Đế Quân tại thế đã lâu, cũng hơn sáu ngàn năm rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220638
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220638,
					"content": "Cho nên, Liyue với ba ngàn bảy trăm năm lịch sử, từ khi mới tạo dựng đã do Đế Quân cai trị, chưa từng trải qua lễ \"tiễn biệt\" thần linh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220639
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220639,
					"content": "Vậy, đối với lễ \"tiễn biệt\" lần này, cô có cảm nhận gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220640
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220640,
					"content": "Haiz? Đột nhiên hỏi vậy, tôi cũng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220641
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220641,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220642
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220642,
					"content": "Là một người phàm, tôi cũng không thể tưởng tượng nổi một Liyue mất đi Đế Quân sẽ ra sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220643
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220643,
					"content": "Nhưng là Tiên... tôi nghĩ, sớm muộn gì tôi cũng sẽ chấp nhận sự thật. Nếu Đế Quân đã ra đi, thì thời đại thần tiên xác lập Khế Ước với Liyue cũng đã đi đến hồi kết rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220644
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220644,
					"content": "Hử? Bạn nói... là \"Tiên\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220645
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220645,
					"content": "Tôi... tôi là con lai giữa loài người và Kỳ Lân, có một nửa dòng máu tiên, thời chiến tranh ma thần cũng từng xông pha vì Đế Quân và Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220646
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220646,
					"content": "Sau khi chiến tranh kết thúc, tôi và Đế Quân đã ký Khế Ước, bắt đầu đảm nhận công việc thư ký cho Thất Tinh, rồi làm từ đó tới nay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220647,
						10220648
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220647,
					"content": "Thảo nào trên đầu bạn có sừng!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220649
					]
				},
				{
					"id": 10220649,
					"content": "Khụ...khụ khụ. Đổi chủ đề khác đi. Các bạn vừa mới nói, là đến tìm Bách Hợp Lưu Ly...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220650
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220650,
					"content": "Tôi cũng biết vị trí thu thập Bách Hợp Lưu Ly thiên nhiên, vừa khéo hái được một bông. Nếu không chê, xin hãy nhận lấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220651
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220651,
					"content": "Vậy thì cung kính không bằng tuân lệnh rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220652
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220652,
					"content": "Ấy? Trước khi hái bạn có hát không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220653
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220653,
					"content": "Đúng vậy, truyền thống này đương nhiên tôi biết rõ. Hãy yên tâm, bài tôi hát là dân ca của Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220654
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220654,
					"content": "Oa, bạn cẩn thận quá. Cảm ơn bạn, Ganyu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220655
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220655,
					"content": "Không, là tôi phải cảm ơn các bạn. Nếu không nhờ lần gặp gỡ này, tôi cũng không ngờ mình có thể góp một phần tâm sức cho nghi thức \"Lời Tạm Biệt Thể Xác Vĩnh Hằng\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220656
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220656,
					"content": "Tôi phải về làm việc rồi, chúc các bạn thuận buồm xuôi gió.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220657
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220657,
					"content": "Xem ra, những thứ cần chuẩn bị cho Điển Lễ Tiễn Tiên cũng hòm hòm rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220658
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220658,
					"content": "Chuyện ngắt hoa này, cũng khá thuận tiện, không có gì khó, nên mới để đến sau cùng",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220659
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220659,
					"content": "Tính cách của Zhongli rất phù hợp với việc khám phá.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220660
					]
				},
				{
					"id": 10220660,
					"content": "Ừ, nếu anh ấy buôn bán ở Liyue, chắc sẽ được hưởng thụ cuộc sống khởi nghiệp nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220661
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220661,
					"content": "Ha ha... Thực ra tôi cũng từng có ngày tháng ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220662
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220662,
					"content": "Khởi nghiệp, khai phá... Vạn sự khởi đầu nan, tình cảm bỏ vào cũng nhiều. Chờ đến khi mọi thứ vận hành bình thường cũng đã lâu rất lâu, tình cảm dần phai nhạt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220663
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220663,
					"content": "Phai nhạt nhiều rồi, sẽ phải nhìn lại bản thân. Nếu không cẩn thận điều chỉnh, linh hồn sẽ lưu lại vết thương, khó lòng cứu vãn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220664
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220664,
					"content": "Xem kìa! Ngữ khí này, vừa nghe là biết người từng trải!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220665
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220665,
					"content": "Được rồi, nếu việc đã xong xuôi, chúng ta cũng nên trở về Cảng Liyue rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220648,
					"content": "Thảo nào bạn lại quên mất việc cần nói!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220649
					]
				},
				{
					"id": 10220622,
					"content": "Chúng ta không nên mất công đi sai đường, hỏi thăm chút là được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220623
					]
				},
				{
					"id": 10220614,
					"content": "Chào bạn, Xiaomei.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220615
					]
				},
				{
					"id": 10220615,
					"content": "Wang Xiaomei? Đó, đó là ai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220616
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220616,
					"content": "Ganyu và Wang Xiaomei, quên sạch sành sanh rồi đúng không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220617
					],
					"speakerTitle": "Ganyu"
				}
			]
		},
		{
			"id": 102208,
			"completionStepIds": [
				102208
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"102208",
							"2"
						],
						"stepId": 102208,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Felix"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10220801,
					"content": "Đây là khách của Vãng Sinh Đường, ngài Zhongli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220802
					],
					"speakerTitle": "Felix"
				},
				{
					"id": 10220802,
					"content": "Thiên Nham Quân đang giám sát chúng tôi rất chặt, hiện là thời điểm nhạy cảm, đừng sơ suất manh động.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220803
					],
					"speakerTitle": "Felix"
				},
				{
					"id": 10220803,
					"content": "Thời điểm nhạy cảm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220804
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220804,
					"content": "Tiên nhân của Tuyệt Vân Gián cuối cùng đã ra tay rồi. Lần này họ tới e rằng không phải có ý tốt gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220805
					],
					"speakerTitle": "Felix"
				},
				{
					"id": 10220805,
					"content": "Là để khởi binh vấn tội ư?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220806
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220806,
					"content": "Khá chắc là như vậy. Nghe nói mấy vị trong Thất Tinh sớm đã đưa người đi nghênh đón... Hừ, nói là nghênh đón, đúng hơn là để chặn tiên nhân ngoài thành lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220807
					],
					"speakerTitle": "Felix"
				},
				{
					"id": 10220807,
					"content": "Nhưng thái độ hai bên đều rất cứng rắn, nhất thời lâm vào cục diện căng thẳng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220808
					],
					"speakerTitle": "Felix"
				},
				{
					"id": 10220808,
					"content": "...Sự tình đến nông nỗi này, cũng là lẽ tất nhiên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220809
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220809,
					"content": "Tiên nhân không công nhận Thất Tinh, chỉ công nhận Khế Ước với Nham Thần. Nếu họ quyết định tấn công, Cảng Liyue e là khó lòng chống đỡ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220810
					],
					"speakerTitle": "Felix"
				},
				{
					"id": 10220810,
					"content": "Nhưng Thất Tinh Liyue cũng sẽ không làm ngơ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220811
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220811,
					"content": "Hừ, ai chẳng biết thái độ của họ cứng rắn? Nhưng chính vì vậy, mâu thuẫn giữa người và tiên mới căng như dây đàn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220812
					],
					"speakerTitle": "Felix"
				},
				{
					"id": 10220812,
					"content": "Sau đó thì sao? Sao Fatui lại trở thành mục tiêu bị căm ghét?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220813
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220813,
					"content": "Hức... Không phải vì Ningguang kia ư...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220814
					],
					"speakerTitle": "Felix"
				},
				{
					"id": 10220814,
					"content": "Nói gì mà \"Trong lúc mây cuộn sóng vờn, muốn Thiên Nham Quân khống chế hoàn toàn hành động của Fatui\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220815
					],
					"speakerTitle": "Felix"
				},
				{
					"id": 10220815,
					"content": "Xì! Giờ mới nhớ ra phải hạn chế hành động của chúng ta? Thất tinh chẳng qua cũng chỉ vậy thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220816
					],
					"speakerTitle": "Felix"
				},
				{
					"id": 10220816,
					"content": "Tóm lại, Zhongli tiên sinh, anh là người hợp tác với đại nhân Childe, thái độ của anh cũng có phần đại diện cho thái độ của chúng tôi, nhưng đừng để người khác nắm được điểm yếu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220817
					],
					"speakerTitle": "Felix"
				},
				{
					"id": 10220817,
					"content": "Xem ra, những mâu thuẫn ở Cảng Liyue đều đã đạt đến giới hạn rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220818,
						10220819
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220818,
					"content": "Chúng tôi có thể làm gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220820
					]
				},
				{
					"id": 10220820,
					"content": "#Ý {F#cô}{M#cậu} là, muốn dùng thân phận trung lập để ra mặt thương lượng? Hay là muốn dùng vũ lực của bản thân để thay đổi cán cân nào đó?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220821
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220821,
					"content": "Hai con đường này, e rằng đều không dễ dàng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220822
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220822,
					"content": "A, đúng rồi! Zhongli tiên sinh. Tôi nghe nói Vãng Sinh Đường các anh hình như cũng bị cuốn vào xung đột này, đang đối đầu với quan quân tìm đến thì phải!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220823
					],
					"speakerTitle": "Felix"
				},
				{
					"id": 10220823,
					"content": "...Vậy là không ổn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220824
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220824,
					"content": "Tôi phải đi trước đây, đến Vãng Sinh Đường xem thử, hy vọng đường chủ Hu tạm thời ứng phó được... đừng gây ra đại loạn gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220825
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220825,
					"content": "#Nhà Lữ Hành, {F#cô}{M#cậu} cũng suy nghĩ thêm một chút đi. Tôi nghĩ, muốn ngăn cản vụ nổ bùng phát, chi bằng thử nghĩ xem kíp nổ ở đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220827
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220827,
					"content": "Hừ... Là kẻ cùng chí hướng với Fatui, xem ra dù có điểm lợi, cũng có cả rắc rối.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220828
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220828,
					"content": "Cho nên, vừa nãy kíp nổ mà Zhongli nói, là chỉ cái gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220829,
						10220830,
						10220831
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220829,
					"content": "Childe",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220832
					]
				},
				{
					"id": 10220832,
					"content": "Thì ra là vậy! Tôi... hình như tôi cũng hiểu rồi. Ừm, nếu nói ai là người mong chờ tình cảnh loạn lạc khắp thành này nhất, có lẽ chính là hắn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220833
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220833,
					"content": "Gã này, nhất định là nhân lúc tất cả mọi người bận rộn không ai quản được, bèn làm ra chuyện xấu gì rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220834
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220834,
					"content": "Nhưng, hiện giờ nên đi đâu tìm hắn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220835
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220835,
					"content": "Khi tất cả mọi sự hỗn loạn trở nên hỗn loạn cực điểm, hắn sẽ đi đâu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220836,
						10220837
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220836,
					"content": "Đi theo tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 10220837,
					"content": "Nơi mà hắn sẽ đi, chỉ có một.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 10220830,
					"content": "Tên có mái tóc màu cam kia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220832
					]
				},
				{
					"id": 10220831,
					"content": "Kẻ ngốc trả tiền cho tôi suốt cả quãng đường.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220832
					]
				},
				{
					"id": 10220819,
					"content": "Tôi không muốn đứng nhìn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220820
					]
				}
			]
		}
	]
