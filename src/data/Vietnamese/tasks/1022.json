			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 10220201,
					"content": "Có rất nhiều câu thần chú và những xấp giấy trắng ở đây. Chúng được dùng làm gì nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220202,
						10220203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220202,
					"content": "Xem ra là bức hình vẽ bùa chú.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220204
					]
				},
				{
					"id": 10220204,
					"content": "Bức hình trên này hình như đã thấy ở đâu đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220205,
					"content": "Tôi nhớ ra rồi, Bách Vô Cấm Kỵ Lục mà Childe cho bạn quả thực trông cũng giống như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220206,
					"content": "Ừm... tín vật có liên quan đến tiên nhân tại sao lại rơi vào tay Childe, đúng là đáng nghi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220207,
					"content": "Hơn nữa, không chỉ là \"tín vật\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220208
					]
				},
				{
					"id": 10220208,
					"content": "Đúng rồi, Lưu Vân Tá Phong Chân Quân từng nói, năm xưa khi Nham Vương gia tạo ra \"Bách Vô Cấm Kỵ Lục\", không phải dùng để làm tín vật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220209,
					"content": "Tác dụng vốn có bùa chú này là để phát huy thần lực trong trận chiến Ma Thần...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220210,
					"content": "Fatui sao chép Bách Vô Cấm Kỵ Lục là muốn thử tìm cách dẫn ra hiệu quả giống với bản chính ư?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220211,
					"content": "Hiệu quả phát huy thần lực trong chiến tranh, nghe có vẻ rất nguy hiểm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220212,
						10220213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220212,
					"content": "Xem ra Fatui còn có kế hoạch lớn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220214
					]
				},
				{
					"id": 10220214,
					"content": "Phức tạp thật, sau này phải đề phòng Childe hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220215,
					"content": "Được rồi, loanh quanh ở đây lâu như vậy, cũng sắp đến thời gian hẹn với Zhongli rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220216,
					"content": "Trạm cuối cùng của \"Hành trình chuẩn bị Điển Lễ Tiễn Tiên\"... tôi nhớ là ở Địch Hoa Châu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220217,
					"content": "Mau đi thôi, đừng đến muộn đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220213,
					"content": "Tờ giấy đưa cho tôi, chỉ là bản sao trong kế hoạch thôi nhỉ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220214
					]
				},
				{
					"id": 10220203,
					"content": "Có thể là muốn phục chế bản chính.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220204
					]
				}
			]
		},
		{
			"id": 102203,
			"completionStepIds": [
				102203
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"102203",
							"2"
						],
						"stepId": 102203,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhongli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10220301,
					"content": "Mọi người rất đúng giờ, tôi cũng vừa đến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220302
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220302,
					"content": "Quần Ngọc Các vui không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220303
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220303,
					"content": "Rộng lắm! Hoa lệ lắm, đắt đỏ lắm, là kiến trúc đắt đỏ nhất tôi từng thấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220304,
					"content": "Quả nhiên. Nếu Quần Ngọc Các xếp thứ hai, ở Liyue này không ai dám xếp thứ nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220305
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220305,
					"content": "Các bạn chắc đã từng gặp Ningguang. Trò chuyện ra sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220306
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220306,
					"content": "Cô ấy giàu có và thẳng thắn lắm, là người rất thân thiện!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220307,
					"content": "Nhưng \"thân thiện\" cũng là vũ khí của thương nhân.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220308
					]
				},
				{
					"id": 10220308,
					"content": "#Ừm, cách nhìn nhận của {F#cô ấy}{M#anh ấy} về Ningguang khác với tôi. {F#Cô ấy}{M#Anh ấy} cho rằng, Ngọc Hành Tinh thẳng thắn đáng tin hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220309,
					"content": "Ô? Các bạn còn gặp Keqing? Cô ấy đã nói gì với các bạn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220310
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220310,
					"content": "Cô ấy nói, \"Thời đại của Tiên nhân đã qua, nếu đến cả Thất Tinh của Liyue cũng không dám đối mặt với điều này, vậy tương lai của Liyue sẽ ra sao?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220311,
					"content": "Ha ha ha... bất kính thần tiên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220312
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220312,
					"content": "Đúng vậy, so với Keqing cái gì cũng dám nói thì Ningguang giống với thương nhân hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220313
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220313,
					"content": "#Tuy thân thiện, nhưng {F#cô}{M#cậu} không thể biết được chắc chắn cô ấy có chân thành không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220314,
						10220315
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220314,
					"content": "Ningguang là người có mưu lược.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220316
					]
				},
				{
					"id": 10220316,
					"content": "Ừm, cô ấy có thể ngồi lên vị trí hôm nay đều dựa vào bản thân. Nhân vật như vậy ắt hẳn có điểm bất phàm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220317
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220317,
					"content": "Tôi nghe nói, Quần Ngọc Các không ngừng mở rộng chính là điểm thể hiện chí hướng của cô ấy, là thứ quan trọng thứ hai trong cuộc đời của cô ấy. Cô ấy thà vứt bỏ vị trí Thiên Quyền, cũng sẽ không vứt bỏ Quần Ngọc Các.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220318
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220318,
					"content": "Quần Ngọc Các xếp thứ hai? Vậy xếp thứ nhất là?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220319,
					"content": "Đương nhiên là Mora rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220320,
						10220321
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220320,
					"content": "Rất có lý.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220322
					]
				},
				{
					"id": 10220322,
					"content": "Phải rồi, cô ấy tìm chúng ta đa phần là vì việc liên quan đến Fatui. Cô ấy nói sau khi Đế quân bị hại, Fatui thường xuyên gây phiền nhiễu ở Liyue, thật là xấu xa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220323,
					"content": "Fatui trước giờ luôn vậy, tôi chẳng bất ngờ chút nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220324
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220324,
					"content": "Hơn nữa họ đang mô phỏng cách tạo ra Bách Vô Cấm Kỵ Lục.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220325
					]
				},
				{
					"id": 10220325,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220326
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220326,
					"content": "Dù Fatui đang âm mưu điều gì, tóm lại, khi giao lưu với họ luôn cần phải cẩn trọng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220327
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220327,
					"content": "Xem ra, Địch Hoa Châu cũng có thứ cần dùng cho Điển Lễ Tiễn Tiên?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220328
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220328,
					"content": "Đúng vậy, hôm nay chúng ta cần tìm Bách Hợp Lưu Ly thiên nhiên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220329
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220329,
					"content": "Bách Hợp Lưu Ly? Tại sao phải đến đây tìm? Rõ ràng trong vườn ở Ngọc Kinh Đài có rất nhiều... Tôi nghe nói Khinh Sách Trang cũng có một ít.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220330
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220330,
					"content": "Đúng vậy, tôi nhớ lúc chúng ta gặp Bình Lão Lão, bà ấy đang ngắm hoa. Hay là đi hỏi Bình Lão Lão xem sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220331
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220331,
					"content": "Không... Đó đều được con người gây trồng, không thích hợp để dùng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220332
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220332,
					"content": "Bách Hợp Lưu Ly từng sinh trưởng rất nhiều ở Địch Hoa Châu, là một loại hoa vui tươi, biết lắng nghe tiếng hát của loài người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220333
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220333,
					"content": "Trước chiến tranh ma thần, Địch Hoa Châu vẫn là mảng lục địa. Do chiến tranh khiến núi lở, làm cho nơi này bị nước nhấn chìm, biến thành vùng ngập nước, Bách Hợp Lưu Ly gần như tuyệt chủng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220334
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220334,
					"content": "Hiện tại trong thành còn giữ một số chủng loại do con người gây trồng. Nhưng rất ít người biết, thực chất Bách Hợp Lưu Ly hoang dã vẫn chưa bị huỷ diệt hoàn toàn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220335
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220335,
					"content": "Bách Hợp Lưu Ly này mùi thơm nồng đượm, sau khi nghiền thành bột thì đặt trong lư hương của Hương Bất Tử, mới là truyền thống Tiễn Tiên hoàn chỉnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220336
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220336,
					"content": "#Có điều, muốn hái loài hoa này, vẫn cần {F#cô}{M#cậu} giúp đỡ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220337,
						10220339
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220337,
					"content": "Cần tôi làm việc sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220338
					]
				},
				{
					"id": 10220338,
					"content": "#Không, tôi cần {F#cô}{M#cậu} hát cho những đoá hoa kia nghe, để tăng mùi hương của nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220341
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220341,
					"content": "#Ặc... {NICKNAME}, trình độ hát hò của bạn ra sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220342,
						10220343
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220342,
					"content": "Biết chút ít.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220344
					]
				},
				{
					"id": 10220344,
					"content": "Thật không? Khó tin ghê...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220345
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220345,
					"content": "Hiệu quả ra sao, cứ thử là biết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220346
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220343,
					"content": "Tôi rất giỏi đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220344
					]
				},
				{
					"id": 10220339,
					"content": "Cần tôi... hát ư?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220340
					]
				},
				{
					"id": 10220340,
					"content": "#Chính xác, tiếng hát của {F#cô}{M#cậu} nhất định có thể khiến mùi thơm của hoa tăng vọt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220341
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220321,
					"content": "Tôi không bất ngờ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220322
					]
				},
				{
					"id": 10220315,
					"content": "Ningguang là người có chí hướng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220316
					]
				}
			]
		},
		{
			"id": 102204,
