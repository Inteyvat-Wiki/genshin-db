					"nextDialogs": [
						111031011
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111031011,
					"content": "Mau mở ra xem thử đi! Tôi tò mò quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031019
					],
					"speakerTitle": "Paimon"
