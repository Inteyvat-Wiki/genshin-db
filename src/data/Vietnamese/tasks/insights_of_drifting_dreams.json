					"Xiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111030501,
					"content": "Đạo cụ nghi thức đã tìm đủ chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030502
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030502,
					"content": "Lư hương và Đèn Thất Tinh này rất hoàn mỹ, thật giống với thứ đặc chế cho Tiên pháp... Hai người tìm được ở đâu vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030503
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030503,
					"content": "Từ chỗ Dạ Xoa tên Đồng Tước...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030504
					]
				},
				{
					"id": 111030504,
					"content": "Đồng Tước tiên sinh nhờ chúng tôi hỏi thăm anh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030505,
					"content": "Đồng Tước...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030506
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030506,
					"content": "...Thì ra là anh ấy, quả là có phong cách của anh ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030507
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030507,
					"content": "Quả nhiên Đồng Tước cũng không thể bỏ mặc Liyue... Mong Liyue của ngày hôm nay sẽ giúp anh ấy được yên nghỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030508
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030508,
					"content": "Vậy bây giờ bắt đầu chuẩn bị nghi thức nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030509
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030509,
					"content": "Đặt lư hương vào vị trí chính giữa, Đèn Thất Tinh xếp xung quanh, vật cực hàn điểm xuyết ở giữa, sau khi xếp xong chúng ta sẽ tiếp tục.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030510
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030510,
					"content": "Ừm, như vậy là được. Tiếp theo là điểm quan trọng của Cảnh Pháp Kẻ Mộng Du...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030511
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030511,
					"content": "Quá trình thi triển pháp thuật gồm 4 bước: Dâng hương, tịnh tâm, niệm chú, phóng tên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030512
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030512,
					"content": "A... phức tạp vậy à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030513,
					"content": "Tiên pháp chính là giác ngộ ngàn năm của tiên nhân Tuyệt Vân, bên trong thâm sâu khó lường, không thể coi nhẹ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030514
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030514,
					"content": "Nếu không sẽ có khả năng bị phản phệ, hồn phách thoát xác khó lòng quy hồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030515
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030515,
					"content": "Xin lỗi, tôi lại nói sai rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030516,
					"content": "\"Dâng hương\", chính là thắp một nén hương trên lư, trong lòng giữ sự thành kính với Nham Vương Đế Quân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030517
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030517,
					"content": "\"Tịnh tâm\", vứt bỏ mọi tạp niệm, xác định hình ảnh của đối tượng thi triển pháp thuật trong đầu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030518
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030518,
					"content": "\"Niệm chú\", đọc thần chú một cách có lực \"Đế Bà Dạ Xoa, tam thi áp giải\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030519
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030519,
					"content": "\"Phóng tên\", phóng mũi tên về phía hai tượng Dạ Xoa, xem như đã lập khế ước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030520
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030520,
					"content": "Nếu không có chuyện ngoài ý muốn, một lát sau hồn phách người đó sẽ xuất hiện ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030521,
						111030522
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030521,
					"content": "Tôi biết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030523
					]
				},
				{
					"id": 111030523,
					"content": "Không có câu hỏi gì khác thì mau bắt đầu thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030524
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030524,
					"content": "Tóm lại... Dâng hương trước nhỉ? Phải giữ lòng thành kính với Nham Vương Đế Quân...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030522,
					"content": "(Nuốt nước miếng)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030523
					]
				}
			]
		},
