			"dialogs": [
				{
					"id": 111030901,
					"content": "Mau dừng lại... ta, ta nhận thua! Ái ui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030902,
						111030904
					],
					"speakerTitle": "Tinh Nguyệt Thiên Quân"
				},
				{
					"id": 111030902,
					"content": "Lần này ngươi tin rồi chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030903
					]
				},
				{
					"id": 111030903,
					"content": "Tin, tin! Sắp bị các ngươi đánh tới nỗi hồn bay phách tán rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030906
					],
					"speakerTitle": "Tinh Nguyệt Thiên Quân"
				},
				{
					"id": 111030906,
					"content": "Vận xui gì thế này, lại gặp ngay kẻ ngáng đường như các ngươi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030907
					],
					"speakerTitle": "Tinh Nguyệt Thiên Quân"
				},
				{
					"id": 111030907,
					"content": "Xin hai vị đại tiên tha mạng, nhất định sẽ không có lần sau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030908
					],
					"speakerTitle": "Tinh Nguyệt Thiên Quân"
				},
				{
					"id": 111030908,
					"content": "Bọn ta không phải tiên nhân, tuy hồn phách ngươi là do bọn ta gọi, nhưng tiên nhân thật sự là vị này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030909
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030909,
					"content": "Ngươi suốt ngày vu khống lừa gạt, mạo danh thần tiên, đuổi tà mà không trừ, không quan tâm an nguy của chúng sinh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030910
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030910,
					"content": "Lâu dần chắc chắn sẽ nhiễm cái ác, bị yêu tà dụ dỗ sa đoạ, vạn kiếp chẳng thể vãn hồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030911
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030911,
					"content": "A...tôi...ngài là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030912
					],
					"speakerTitle": "Tinh Nguyệt Thiên Quân"
				},
				{
					"id": 111030912,
					"content": "Hình như hắn bị bá khí của Xiao doạ tới nỗi không nói nên lời rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030913,
					"content": "Xin hỏi... Tiên danh là?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030914,
						111030915
					],
					"speakerTitle": "Tinh Nguyệt Thiên Quân"
				},
				{
					"id": 111030914,
					"content": "Hàng Ma Đại Thánh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030916
					]
				},
				{
					"id": 111030916,
					"content": "Đúng là người! Không ngờ thật sự là người! Sinh thời lại có cơ hội được gặp Hàng Ma Đại Thánh, Hộ Pháp Dạ Xoa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030917
					],
					"speakerTitle": "Tinh Nguyệt Thiên Quân"
				},
				{
					"id": 111030917,
					"content": "Ngươi cũng biết chuyện của Xiao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030918
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030918,
					"content": "Đương nhiên, tôi thuộc nằm lòng ấy chứ! Ông nội tôi là học giả dân gian, từ nhỏ tôi đã nghe chuyện của Hàng Ma Đại Thánh mà lớn lên...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030919
					],
					"speakerTitle": "Tinh Nguyệt Thiên Quân"
				},
				{
					"id": 111030919,
					"content": "Nay cũng thường xuyên thu thập các loại sách liên quan đến Dạ Xoa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030920
					],
					"speakerTitle": "Tinh Nguyệt Thiên Quân"
				},
				{
					"id": 111030920,
					"content": "Nhưng từ khi tìm được Bách Vô Cấm Kỵ Lục trong di vật của ông nội tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030921
					],
					"speakerTitle": "Tinh Nguyệt Thiên Quân"
				},
				{
					"id": 111030921,
					"content": "Mới đầu chỉ là thích giả làm tiên nhân, nhưng càng dấn sâu vào tà lộ lại càng đi xa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030922
					],
					"speakerTitle": "Tinh Nguyệt Thiên Quân"
				},
				{
					"id": 111030922,
					"content": "Có chuyện như thế nữa... Vậy ngươi là người hâm mộ Xiao rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030923
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030923,
					"content": "Vâng vâng. Cảm ơn hai vị cho tôi cơ hội gặp Hàng Ma Đại Thánh, quả là như một giấc mơ vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030924
					],
					"speakerTitle": "Tinh Nguyệt Thiên Quân"
				},
				{
					"id": 111030924,
					"content": "Thật ra chúng tôi cũng không ngờ đến bước này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030925
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030925,
					"content": "Hôm nay, tôi nhân cơ duyên này, lập thề trước mặt Hàng Ma Đại Thánh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030926
					],
					"speakerTitle": "Tinh Nguyệt Thiên Quân"
				},
				{
					"id": 111030926,
					"content": "Từ nay nhất định sẽ hướng thiện, yên ổn qua ngày, không làm bại hoại danh dự của tiên nhân!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030927
					],
					"speakerTitle": "Tinh Nguyệt Thiên Quân"
				},
				{
					"id": 111030927,
					"content": "Ta sẽ ghi nhớ lời thề của ngươi... đi đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030928
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030928,
					"content": "Cảm... cảm ơn ngài tha thứ, và vì tất cả những gì ngài đã làm cho Liyue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030929
					],
					"speakerTitle": "Tinh Nguyệt Thiên Quân"
				},
				{
					"id": 111030929,
					"content": "Lời thề cuối cùng của hắn rất thành khẩn. Có lẽ thật sự sẽ không giả danh lừa bịp nữa đâu nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030930
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030930,
					"content": "Đúng rồi, Bách Vô Cấm Kỵ Lục còn chưa thu hồi, giao cho chúng tôi đi, sớm mai chúng tôi sẽ đến Nhà Trọ Vọng Thư tìm anh ta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030915,
					"content": "Hộ Pháp Dạ Xoa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030916
					]
				},
				{
					"id": 111030904,
					"content": "Cuối cùng cũng không tự xưng \"bổn tiên\" nữa nhỉ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030905
					]
				},
				{
					"id": 111030905,
					"content": "Không dám nữa, không dám nữa, sắp bị đánh tới nỗi hồn bay phách tán rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030906
					],
					"speakerTitle": "Tinh Nguyệt Thiên Quân"
				}
