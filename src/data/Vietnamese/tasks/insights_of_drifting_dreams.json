			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Đồng Tước"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111030101,
					"content": "Non xanh nước biếc hồn phiêu dạt, phù du nhàn tản đưa theo dòng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030102
					],
					"speakerTitle": "Đồng Tước"
				},
				{
					"id": 111030102,
					"content": "Ngại quá, làm ngắt nhã hứng của bạn rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030103,
					"content": "Chúng tôi muốn mượn lư hương và đèn nơi này một lát.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030104
					]
				},
				{
					"id": 111030104,
					"content": "...Đây đúng là chuyện hi hữu trên đời.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030105
					],
					"speakerTitle": "Đồng Tước"
				},
				{
					"id": 111030105,
					"content": "Đến miếu không cầu tiên, không bái thần, lại lấy lư hương đi mất, ha ha ha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030106
					],
					"speakerTitle": "Đồng Tước"
				},
				{
					"id": 111030106,
					"content": "Chúng tôi cũng biết là yêu cầu vô lễ, nhưng thật sự chỉ mượn một lát thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030107,
					"content": "Là nghi thức \"Cảnh Pháp Kẻ Mộng Du\" dùng à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030108
					],
					"speakerTitle": "Đồng Tước"
				},
				{
					"id": 111030108,
					"content": "A... sao bạn biết!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030109,
					"content": "Thời gian tôi ở miếu này chắc chắn còn dài hơn nhiều so với bạn tưởng tượng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030110
					],
					"speakerTitle": "Đồng Tước"
				},
				{
					"id": 111030110,
					"content": "Có thể vì sự chân thành? Tiên pháp cũng may mắn giác ngộ được một hai phần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030111
					],
					"speakerTitle": "Đồng Tước"
				},
				{
					"id": 111030111,
					"content": "Còn có việc này sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030112,
					"content": "Bỏ đi bỏ đi, các bạn cầm lấy này. Hôm nay có cơ hội giúp người cũng coi như một chuyện may mắn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030113
					],
					"speakerTitle": "Đồng Tước"
				},
				{
					"id": 111030113,
					"content": "...Còn ở lại đây, vốn cũng chẳng có ý nghĩa gì nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030114,
						111030116
					],
					"speakerTitle": "Đồng Tước"
				},
				{
					"id": 111030114,
					"content": "Hình như bạn có tâm sự?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030115
					]
				},
				{
					"id": 111030115,
					"content": "Không cần để ý, cần gì thì mau lấy đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Đồng Tước"
				},
				{
					"id": 111030116,
					"content": "Tóm lại... cảm ơn nhiều!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030117
					]
				},
				{
					"id": 111030117,
					"content": "Không có gì, muốn gì thì mau lấy đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Đồng Tước"
				}
			]
		},
		{
			"id": 1110302,
			"completionStepIds": [
				1110317
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1110301",
							"2"
						],
						"stepId": 1110301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 111030201,
					"content": "Lư hương này... chắc là không vấn đề gì chứ hả?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030202,
					"content": "Chí ít không rách nát như ngôi miếu này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030203,
					"content": "Tìm thấy lư hương xong... còn phải thu thập Đèn Thất Tinh gần đây, mau hành động đi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1110303,
			"completionStepIds": [
				1110303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1110303",
							"2"
						],
						"stepId": 1110303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 111030301,
					"content": "Í? Sao không có ai thế, vừa nãy rõ ràng còn ở đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030302,
					"content": "Không ngờ các bạn còn để ý tôi đi đâu về đâu... cứ tưởng các bạn lấy đồ xong là đi luôn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030330
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030330,
					"content": "A!... Là giọng tiên sinh ban nãy! Bạn, bạn đang ở đâu!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030303,
					"content": "Thân xác của tôi đã tan biến từ ngàn năm trước. Vừa rồi các bạn đã nhìn thấy ảo ảnh dựng nên bởi \"Phù Thế Lưu Hình Pháp\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030304,
					"content": "Nay bạn đem lư hương và Đèn Thất Tinh dùng cho Phù Thế Lưu Hình Pháp đi, đương nhiên không thể thấy tôi nữa rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030305,
						111030306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030305,
					"content": "Bạn là...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030308
					]
				},
				{
					"id": 111030308,
					"content": "Tôi vốn là tiểu tiên trong số Dạ Xoa, Nham Vương Đế Quân ban cho tiên danh Đồng Tước, ngàn năm trước không đủ thực lực đã chết nơi sa trường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030309,
					"content": "Hôm nay là ngày giỗ của tôi, nhìn ngắm Liyue là di nguyện của tôi, vì vậy mạo muội thi triển pháp thuật ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030310,
					"content": "Nói vậy, các bạn đến từ chỗ Hàng Ma Đại Thánh nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030311,
					"content": "Thì ra hai người quen nhau sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030312,
					"content": "Tôi có thể cảm nhận được mùi của anh ấy trên người các bạn... còn nữa, cả mùi Nghiệp Chướng nồng nặc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030313,
					"content": "Haiz... mấy ngàn năm nay, anh ấy vẫn luôn chịu đựng sự đau khổ kia sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030314,
					"content": "...Đúng là khiến tôi xấu hổ vô cùng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030315,
					"content": "Đừng nói vậy, Đồng Tước tiên sinh không phải đã hy sinh thân mình vì Liyue sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030316,
					"content": "Tính mạng tuy quý giá... nhưng so với những gì Hàng Ma Đại Thánh phải chịu đựng, cái chết chẳng qua là để tìm bình yên mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030317,
					"content": "Đồng Tước tiên sinh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030318,
					"content": "Ha ha, thật ngại quá. Sinh nhật phải vui vẻ chứ, nhưng ngày giỗ thì khó tránh khỏi thương cảm nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030319,
					"content": "Hiệu lực của Phù Thế Lưu Hình Pháp sắp hết, hai người hãy trân trọng, thay tôi hỏi thăm Hàng Ma Đại Thánh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030320,
						111030321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030320,
					"content": "Nhất định rồi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030322
					]
				},
				{
					"id": 111030322,
					"content": "Haiz, muốn ăn một lần \"Cá Li Hổ Nướng\" chính tông quá đi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030323,
					"content": "\"Sóng lớn ra khơi tìm Li Hổ, gió tuyết về núi trảm yêu tà...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030324,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030325,
					"content": "...Đã hoàn toàn biến mất rồi sao, hy vọng sẽ có người ghi nhớ vị Dạ Xoa tên Đồng Tước này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030326,
					"content": "Chúng ta cũng đi thôi? Sau này có thời gian lại đến thắp nén hương.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030321,
					"content": "Đồng Tước tiên sinh hãy bảo trọng...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030322
					]
				},
				{
					"id": 111030306,
					"content": "Gặp, gặp ma rồi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030307
					]
				},
				{
					"id": 111030307,
					"content": "Ha ha ha... nói vậy cũng không sai. Khoảng cách giữa Tiên và Quỷ vốn chỉ cách nhau trong gang tấc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030308
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1110305,
			"completionStepIds": [
