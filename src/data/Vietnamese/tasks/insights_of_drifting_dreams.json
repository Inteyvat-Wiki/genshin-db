				},
				{
					"id": 111030702,
					"content": "...Tạm vậy đã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030703
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030703,
					"content": "Còn lại giao cho tôi, hai người cứ chuẩn bị sẵn sàng \"nghênh đón\" hắn đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030704
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030704,
					"content": "Nơi này là... Hửm? Các ngươi trông quen quen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030705
					],
					"speakerTitle": "Tinh Nguyệt Thiên Quân"
				},
				{
					"id": 111030705,
					"content": "Cơ thể sao vậy nhỉ, cứ lâng lâng, cảm giác không có trọng lượng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030706,
						111030709
					],
					"speakerTitle": "Tinh Nguyệt Thiên Quân"
				},
				{
					"id": 111030706,
					"content": "Là dùng Tiên pháp triệu hồn phách ngươi tới đây.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030707
					]
				},
				{
					"id": 111030707,
					"content": "...Tiên pháp? Ha ha ha, dám giả làm tiên nhân trước mặt bổn tiên, không biết trời cao đất dày.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030708
					],
					"speakerTitle": "Tinh Nguyệt Thiên Quân"
				},
				{
					"id": 111030708,
					"content": "Đây là nơi nào, bổn tiên rõ ràng vừa mới ngủ ở Nhà Trọ Vọng Thư...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030712
					],
					"speakerTitle": "Tinh Nguyệt Thiên Quân"
				},
				{
					"id": 111030712,
					"content": "Phải rồi, ừm, thì ra là vậy, không hổ danh là bổn tiên, ha ha ha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030713
					],
					"speakerTitle": "Tinh Nguyệt Thiên Quân"
				},
				{
					"id": 111030713,
					"content": "Bổn tiên nhất định đang nằm mơ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030714
					],
					"speakerTitle": "Tinh Nguyệt Thiên Quân"
				},
				{
					"id": 111030714,
					"content": "Hừm... kẻ này hết thuốc cứu rồi, hình như không thể đạt đến hiệu quả chúng ta mong đợi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030715,
						111030716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030715,
					"content": "Đây không phải mơ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030717
					]
				},
				{
					"id": 111030717,
					"content": "Hả? Các ngươi nghĩ gì vậy, trong giấc mơ của bổn tiên sao có thể cho phép thứ gian trá như ngươi hỗn xược?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030718
					],
					"speakerTitle": "Tinh Nguyệt Thiên Quân"
				},
				{
					"id": 111030718,
					"content": "Ừm... hành động đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030716,
					"content": "Bởi vì... ngươi sẽ đau!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030717
					]
				},
				{
					"id": 111030709,
					"content": "Vì ngươi đã chết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030710
					]
				},
				{
					"id": 111030710,
					"content": "Chết, chết chết rồi!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030711
					],
					"speakerTitle": "Tinh Nguyệt Thiên Quân"
				},
				{
					"id": 111030711,
					"content": "Làm sao có thể, bổn tiên rõ ràng vừa mới ngủ ở Nhà Trọ Vọng Thư...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030712
					],
					"speakerTitle": "Tinh Nguyệt Thiên Quân"
				}
			]
