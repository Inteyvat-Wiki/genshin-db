			"dialogs": [
				{
					"id": 761850201,
					"content": "Trà uống kèm với tình báo, hương vị đúng là khác hẳn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850202,
						761850203
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761850202,
					"content": "(Ngồi thêm một lúc nữa vậy.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850204
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761850204,
					"content": "Ồ, đi thong thả nhé. Rảnh rỗi hãy ghé chơi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761850203,
					"content": "Tiệc trà cũng nên kết thúc rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850204
					],
					"speakerTitle": "Sandrone"
				}
			]
		}
