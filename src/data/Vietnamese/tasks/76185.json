			"dialogs": [
				{
					"id": 761850101,
					"content": "Ừm, trà và bánh đều ngon tuyệt. Cảm ơn tiểu thư Sandrone đã chiêu đãi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850102
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761850102,
					"content": "Không có gì, cô thích là được. Tôi còn mang theo một ít đồ ăn vặt mà Ashru thích. Đúng không nào? Ashru? Lại đây nào, ngoan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850103
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761850103,
					"content": "Meo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850104
					],
					"speakerTitle": "Ashru"
				},
				{
					"id": 761850104,
					"content": "Hy vọng tình hữu nghị giữa cô với Nod-Krai, cũng như với Hội Đồng Bí Mật, sẽ có ích cho việc hợp tác của chúng ta trong tương lai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850105
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761850105,
					"content": "Ừm, tôi cũng hy vọng thế. Nào, Ashru, thử cái này xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850106
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761850106,
					"content": "À, còn về việc trước đây hỏi thăm tiểu thư Sandrone...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850107
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761850107,
					"content": "Haha, đệm thịt của ngươi mềm thật đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850108
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761850108,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850109
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761850109,
					"content": "Tiểu thư Sandrone... Chẳng lẽ cô đang lợi dụng danh nghĩa tiệc trà để tới đây vuốt ve mèo à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850110
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761850110,
					"content": "Ơ...? Có, có sao? Không có chuyện đó đâu! Tôi cũng rất quan tâm đến việc giao du với Hội Đồng Bí Mật mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850111
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761850111,
					"content": "Lại đây nào, Ashru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850112
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761850112,
					"content": "Meo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850113
					],
					"speakerTitle": "Ashru"
				},
				{
					"id": 761850113,
					"content": "A...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850114
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761850114,
					"content": "Vậy thì chúng ta hãy nói cụ thể về việc \"giao du\" nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850115
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761850115,
					"content": "...Chậc, muốn... muốn vuốt ve mèo một chút thì sao chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850116
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761850116,
					"content": "Bình thường các động vật nhỏ đều không thích máy móc, mãi đến dạo trước khi nghiên cứu mảng ẩn số ở đây mới quen thân với Ashru, vuốt ve một chút thì có sao chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850117
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761850117,
					"content": "Ha... Được rồi, được rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850118
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761850118,
					"content": "Đi đi, Ashru. Dù sao ta cũng không cấm được ngươi thích thân thiết với ai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850119
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761850119,
					"content": "Meo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850120
					],
					"speakerTitle": "Ashru"
				},
				{
					"id": 761850120,
					"content": "Vuốt ve thỏa thích rồi thì đừng quên nói chuyện chính nhé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850121
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761850121,
					"content": "Đã nói là tôi rất quan tâm mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sandrone"
				}
			]
		},
