			"dialogs": [
				{
					"id": 751450101,
					"content": "Hỡi người được rồng chọn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450102,
					"content": "Núi Thánh đang ở ngay trước mặt... Hãy loại bỏ... kẻ địch trong bóng tối.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450103,
					"content": "Người được rồng chọn... Hãy tiến vào... Núi Thánh đi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450104,
					"content": "Rawr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450105
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751450105,
					"content": "Vừa rồi là... núi lửa phun trào sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751450106
					]
				},
				{
					"id": 751450106,
					"content": "#Đâu có, vừa rồi núi lửa rất yên ắng mà... {NICKNAME} thấy núi lửa phun trào sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450107,
					"content": "#{NICKNAME}? Cả {REALNAME[ID(2)|SHOWHOST(true)]} nữa? Sao lại trầm tư thế...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450108,
					"content": "Trông hệt như nhân vật thám tử đột nhiên tìm ra được sự thật trong tiểu thuyết trinh thám vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450109,
						751450112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450109,
					"content": "Tôi đã tìm được một \"sự thật\" khác rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751450110
					]
				},
				{
					"id": 751450110,
					"content": "(Kể lại cho Paimon nghe những gì vừa nhìn thấy...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751450111
					]
				},
				{
					"id": 751450111,
					"content": "#À, ý là đã thấy thứ tương tự như lúc gặp được {REALNAME[ID(2)|SHOWHOST(true)]} khi vừa mới đến Natlan sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450118,
					"content": "Và một số hình ảnh kỳ lạ nữa sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450119,
					"content": "Ehrr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450120
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751450120,
					"content": "#Khi đó {NICKNAME} đã nói là nhìn thấy những lời kỳ lạ... Hừm, tôi không nhìn thấy nên cũng không rõ, nhưng mà cảm giác có giống như là cùng một người đang nói không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450121,
					"content": "Chắc là cùng một người...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751450122
					]
				},
				{
					"id": 751450122,
					"content": "Nhưng lần này cả hai còn nhìn thấy... di tích khổng lồ và Vực Sâu sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450123,
					"content": "Và còn cả Núi Thánh... Hmm, người Natlan hình như đều gọi ngọn núi lửa đó là Núi Thánh nhỉ? Chẳng lẽ những gì cả hai nhìn thấy có liên quan tới ngọn núi lửa đó sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450124,
					"content": "#Tôi cứ cảm thấy người đã gửi {REALNAME[ID(2)|SHOWHOST(true)]} đến rất muốn chúng ta đi vào trong Núi Thánh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450125,
					"content": "#Không lẽ ở đó có thể giải mã được bí ẩn về thân thế của {REALNAME[ID(2)|SHOWHOST(true)]} sao... Nói không chừng còn có thể gặp được người nhà của nó nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450126,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450127
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751450127,
					"content": "Nói chung... Chúng ta hãy để ý các thông tin liên quan đến núi lửa vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450128,
					"content": "Đúng rồi! Cộng Đồng Trù Phú, một trong sáu bộ tộc của Natlan hình như tọa lạc bên chân núi lửa, nói không chừng chúng ta có thể đến đó để hỏi thăm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450112,
					"content": "Hung thủ của vụ án sát nhân bánh kem... chính là Paimon!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751450113
					]
				},
				{
					"id": 751450113,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450114
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751450114,
					"content": "Đáng ghét! Rõ ràng khi tôi lén ăn bánh kem không thấy bị ai nhìn trộm mà... Hừm, thôi bớt đùa đi, thứ tôi lén ăn là món Thịt Hầm Hỏa Diệm mới đúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450115,
					"content": "Vậy... cả hai vừa nãy đã thấy những gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450116,
					"content": "(Kể lại cho Paimon nghe những gì vừa nhìn thấy...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751450117
					]
				},
				{
					"id": 751450117,
					"content": "Lại nhìn thấy những lời kỳ lạ đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450118
					],
					"speakerTitle": "Paimon"
				}
			]
		},
