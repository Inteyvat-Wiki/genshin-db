			"dialogs": [
				{
					"id": 730160701,
					"content": "Chúng ta đã đánh bại khối sắt bự, hiện tại chỉ cần làm cho nước rút đi là có thể xuống dưới rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160702
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160702,
					"content": "Nhưng lâu rồi không tới, hiện tại tất cả đều đã khác xưa, nói không chừng dưới mặt đất cũng có khối sắt bự, có thể cảm nhận được mùi sắt, nên phải cẩn thận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160703
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160703,
					"content": "#Không cần lo, Nara {NICKNAME} có bản lĩnh. Nhưng Paimon, cũng yếu như Aranakula, cẩn thận bị nuốt mất nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160704
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160704,
					"content": "Ừm... Là Arabalika quá mạnh! Lúc trước chúng tôi cũng đã gặp rất nhiều Aranara, nhưng không ai có thể một chiêu đánh ngã Thủ Vệ Di Tích cả...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160705,
					"content": "Paimon biết quá ít về Aranara, nếu như là Aradasha, chỉ chớp mắt một cái đã giải quyết được khối sắt lớn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160706
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160706,
					"content": "Ararakalari của Aradasha đã từng mạnh nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160707
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160707,
					"content": "Đã từng? Vậy bây giờ thì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160708,
					"content": "Bây giờ Aradasha không có ở đây, vì thế Arabalika mới phải cố gắng tập luyện Ararakalari hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160709
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160709,
					"content": "Nếu tôi cũng có thể học được \"Ararakalari\" thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160710,
						730160714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160710,
					"content": "Vậy sau này chiến đấu đều giao hết cho Paimon nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160711
					]
				},
				{
					"id": 730160711,
					"content": "#Hì hì, để tôi bảo vệ {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160712,
					"content": "Paimon, cố lên!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160713
					]
				},
				{
					"id": 730160713,
					"content": "Cứ giao cho tôi! Có thể giao hết toàn bộ cho tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160718,
					"content": "Paimon hay mơ mộng, không biết là chuyện tốt hay chuyện xấu nữa. Nhưng bây giờ chúng ta phải tìm ra cơ quan của tảng đá để nước chảy đi, bằng không thì chẳng có cách nào xuống dưới lòng đất cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160719
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160719,
					"content": "Aranara có thể chui vào đất, nhưng không thể xuyên qua nước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160720
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160720,
					"content": "#Ừm, {NICKNAME}, chúng ta xem xét xung quanh đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160714,
					"content": "Paimon chắc không học được rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160715
					]
				},
				{
					"id": 730160715,
					"content": "Tôi cũng có thể học được nếu muốn học thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160716,
					"content": "Hầu hết những người nói như thế đều...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160717
					]
				},
				{
					"id": 730160717,
					"content": "Hay là chờ chúng ta tới nơi an toàn, ăn cơm, nghỉ ngơi cho khỏe rồi nhờ Arabalika dạy cho tôi nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160718
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7301610,
			"completionStepIds": [
				7301610
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301610",
							"2"
						],
						"stepId": 7301610,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Arabalika"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730161001,
					"content": "Hình như... hình như chúng đều hư cả rồi? Không cục cựa tí nào luôn! Dọa, dọa tôi sợ muốn chết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161002,
					"content": "Hứ, cái gì chứ, chẳng qua chỉ là mấy khối sắt rỉ sét thôi mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161003,
					"content": "Vana bây giờ rất nguy hiểm, Paimon lơ là thì sẽ chịu thiệt thòi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161004
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161004,
					"content": "Ừm... Arabalika nghiêm khắc quá đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161005,
					"content": "Là Paimon quá lơ là.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730161006
					]
				},
				{
					"id": 730161006,
					"content": "Vậy sao? ...Nếu như tôi cũng nghiêm khắc như Arabalika thì cũng sẽ mạnh được như vậy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161007
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161007,
					"content": "Paimon nên nghiêm khắc với bản thân chứ không phải với người khác.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730161008
					]
				},
				{
					"id": 730161008,
					"content": "Được thôi, vậy bắt đầu từ ngày mai tôi sẽ nghiêm khắc với bản thân mình hơn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161009,
					"content": "Tóm lại, nếu như tảng đá \"cành\" ở đây, vậy tiếp theo chỉ cần...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161010
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161010,
					"content": "Tìm ba tảng đá hướng về phía này là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161011
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161011,
					"content": "Bị, bị giành trả lời mất rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161012
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161012,
					"content": "Nói chứ thật không biết hình dung ra sao về sự khác biệt giữa cách nói chuyện của Arapandu và Arabalika nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161013,
						730161015
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161013,
					"content": "Nhưng như vậy dễ hiểu hơn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730161014
					]
				},
				{
					"id": 730161014,
					"content": "Thẳng thắn quả thật rất dễ hiểu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161017
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161017,
					"content": "Vì Arapandu nghĩ quá nhiều, Arabalika rất ít khi nghĩ ngợi. Tôi chỉ biết bảo vệ thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161018
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161018,
					"content": "Arapandu từng cùng Nara Varuna bảo vệ Vana, bọn họ cùng đánh đuổi bùn đen xui xẻo kia, sửa chữa Cỗ Máy Varuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161019
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161019,
					"content": "#Nara Varuna rời khỏi Vana rất lâu rồi, chắc {F#anh ấy}{M#cô ấy} cũng không tới Lễ Hội Utsava đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161020
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161020,
					"content": "Arapandu chắc cũng rõ. Đã không biết bao lâu rồi, thời gian đủ để một hạt giống trở thành đại thụ che trời, Nara đã rời khỏi Vana sẽ không quay trở lại nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161021
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161021,
					"content": "Nhưng Arapandu lại muốn sửa chữa Cỗ Máy Varuna, vì Vana, vì Lễ Hội Utsava, cũng vì Nara Varuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161022
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161022,
					"content": "Thì ra là vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161023
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161023,
					"content": "#Arabalika chưa từng gặp Nara Varuna, nhưng chuyện của {F#anh ấy}{M#cô ấy} cả Vana đều biết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161024
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161024,
					"content": "Arabalika sẽ không nghĩ nhiều như Arapandu. Arabalika chỉ cần biết mình đủ mạnh mẽ để bảo vệ Aranara và Vana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161025
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161025,
					"content": "Dù Nara Varuna không còn nữa, Aranara vẫn có thể sửa được Cỗ Máy Varuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161026
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161026,
					"content": "#Ừm! Hơn nữa còn có tôi và {NICKNAME} giúp đỡ mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161027
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161027,
					"content": "#Có gì đó không ổn, ở đây có mùi sắt. Giao cho bạn nhé Nara {NICKNAME}. Tôi ở đây chờ các bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161028
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161028,
					"content": "Không biết Arabalika cảm nhận được điều gì... Nhưng chuyện trong rừng sâu, chắc chắn Aranara hiểu rõ hơn chúng ta chứ nhỉ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161029
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161029,
					"content": "#{NICKNAME}, tóm lại chúng ta cứ tìm ba cái \"lá\" phân tán ở xung quanh thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161015,
					"content": "Không giống Aranara lắm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730161016
					]
				},
				{
					"id": 730161016,
					"content": "Có điều, thế nào mới là \"giống Aranara\" đây? Ừm... Không biết nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161017
					],
					"speakerTitle": "Paimon"
				}
			]
		},
