				},
				{
					"id": 730161602,
					"content": "Arabalika đang khen chúng ta kìa! Hì hì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161603,
					"content": "Bây giờ có thể đi xuống lòng đất rồi, mau theo kịp nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161604
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161604,
					"content": "Được, chúng ta đi theo Arabalika nào.",
