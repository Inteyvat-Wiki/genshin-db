			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arabalika",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730160301,
					"content": "Nara... và một Nara biết bay ư?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160302
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160302,
					"content": "#Đúng vậy, tôi là Paimon biết bay, còn đây là {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160303,
					"content": "Chắc bạn là Arabalika nhỉ, bạn chẳng sợ chúng tôi tí nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160304,
					"content": "Nara Vàng, có mùi của Arapandu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160305
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160305,
					"content": "À, cái này sao, đúng là Arapandu đã bảo chúng tôi tới đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160306,
					"content": "Không cảm nhận được ác ý. Nếu muốn ra tay với tôi, chắc phải nhân lúc khối sắt bự kia còn cử động được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160307
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160307,
					"content": "Đúng vậy, cái này gọi là \"nhân lúc Aranara gặp nguy\"... À không, không đúng, chúng tôi sẽ không bao giờ làm chuyện đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160308,
					"content": "Sao lại không làm? Nếu như tôi là kẻ địch thì bao vây kẻ địch là cách tốt nhất, ngay cả động vật đi săn còn biết dùng mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160309
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160309,
					"content": "À... Nghe cũng đúng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160310,
					"content": "Paimon lú mất rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160311
					]
				},
				{
					"id": 730160311,
					"content": "...Tóm, tóm lại chúng tôi sẽ không \"nhân lúc Aranara gặp nguy\" là được rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160312,
					"content": "Vì Aranara là bạn mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160313
					]
				},
				{
					"id": 730160313,
					"content": "#Đúng đúng đúng, đúng là vậy, vì Aranara là bạn! Tôi và {NICKNAME} sẽ không làm chuyện có lỗi với bạn bè!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160314,
					"content": "Hứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160315
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160315,
					"content": "Ừm... Sao cứ có cảm giác Arabalika không hài lòng vậy nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160316,
						730160318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160316,
					"content": "Do Paimon không để lại ấn tượng tốt đẹp lúc ban đầu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160317
					]
				},
				{
					"id": 730160317,
					"content": "Nhưng tôi cảm thấy mình không làm gì sai hết mà... Ừm... Tính tình của Aranara thật khó đoán...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160320,
					"content": "Đúng rồi, Arapandu từng nói, \"Ararakalari\" của Arabalika rất lợi hại. Vừa rồi Arabalika có thể đánh bại Thủ Vệ Di Tích, nhất định là dựa vào \"Ararakalari\" rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160321,
					"content": "Paimon cũng biết Ararakalari sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160322
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160322,
					"content": "...À, ờ! Đương nhiên là biết rồi! Chính là... chính là cái đó! Cái... năng lực cực kỳ, cực kỳ lợi hại đó đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160323,
					"content": "Hứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160324
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160324,
					"content": "Chậc! Cảm giác như lại bị xem thường rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160325,
					"content": "Bàn chuyện chính đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160326
					]
				},
				{
					"id": 730160326,
					"content": "Ừm... Chúng tôi tới để giúp sửa chữa Cỗ Máy Varuna! Ở đây chắc cũng có \"cành\" và \"lá\" của Cỗ Máy Varuna, nhưng hình như không thấy đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160327,
					"content": "\"Cành\" và \"lá\" cái gì, giống \"rễ\" hơn chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160328
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160328,
					"content": "Hả? Là vậy sao? Nhưng Arapandu có nói...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160329,
					"content": "Có một \"bộ rễ\" trải rộng khắp Vana, Cỗ Máy Varuna mới có thể lấy được toàn bộ sức mạnh từ Vana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160330
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160330,
					"content": "Ồ... Hình như cũng có lý đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160331
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160331,
					"content": "Hơn nữa, \"rễ\" nằm ở dưới mặt đất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160332
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160332,
					"content": "Tảng đá và khối sắt ở đây không thuộc về Aranara. Muốn xuống thì phải đánh bại khối sắt trước. Khối sắt rất mạnh, nhưng Nara Vàng cũng không yếu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160333
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160333,
					"content": "#Đương nhiên rồi, {NICKNAME} không biết đã đánh bại bao nhiêu khối sắt rồi đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160334
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160334,
					"content": "Ồ? Vậy thì hãy để Arabalika xem thử bản lĩnh của Nara nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160335
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160335,
					"content": "Ơ hay?! Sao Arabalika lại chui vào trong đất rồi... Ối! Lẽ nào là đang đi tới chỗ Thủ Vệ Di Tích sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160336
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160336,
					"content": "#{NICKNAME}, chúng ta mau đuổi theo Arabalika đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160318,
					"content": "Chắc là với ai thì Arabalika cũng như vậy đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160319
					]
				},
				{
					"id": 730160319,
					"content": "Sao lại vậy chứ? Rõ ràng bề ngoài đáng yêu như vậy mà tính cách lại kì quá chừng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160320
					],
					"speakerTitle": "Paimon"
				}
			]
		},
