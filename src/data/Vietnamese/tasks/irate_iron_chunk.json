					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161504,
					"content": "Trong di tích có Thủ Vệ, vậy thì chắc chắn chúng có thể động đậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730161505
					]
				},
				{
					"id": 730161505,
					"content": "Nói cũng đúng, cái này gọi là \"có tiếng có miếng\" đúng không? Dù sao với chúng thì chúng ta mới là người ngoài mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161506,
					"content": "#Nara {NICKNAME} và Paimon là người bên ngoài đến với Vana, Arabalika không phải, nên là do khối sắt bự kia không biết điều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161507
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161507,
					"content": "Khối sắt bự không biết điều, Arabalika sẽ dạy nó biết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161508
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161508,
					"content": "Hic... Paimon sẽ nghe lời mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161509,
					"content": "Paimon phải giữ lời đấy nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730161510
					]
				},
				{
					"id": 730161510,
					"content": "Đương nhiên rồi! Ngày mai... Không, bắt đầu ngay từ bây giờ luôn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161511,
					"content": "#Tảng đá ở đây, chỉ có Aranara mới có thể đánh thức nó. Nara {NICKNAME} và Paimon, việc còn lại cứ giao cho Arabalika đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161512
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161512,
					"content": "Ồ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161513,
					"content": "Vậy là việc sửa chữa Cỗ Máy Varuna lại tiến thêm một bước rồi! Đợi sửa Cỗ Máy Varuna xong, sẽ không còn nhiều bào tử bay khắp Rừng Apam nữa... Nhớ tới thôi đã thấy ngứa hết cả mũi rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161514,
					"content": "Cỗ Máy Varuna sẽ tinh lọc mưa, không còn mưa đen, cũng không còn nhiều \"Bào Tử\" như thế nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161515
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161515,
					"content": "Nhưng nấm thì chắc là vẫn sẽ có. Paimon phải cẩn thận, đừng như Aranakula, suýt tí bị nấm nuốt mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161516
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161516,
					"content": "Ừm... Tôi sẽ cẩn thận!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161517,
					"content": "#Ở đây đã không cần Arabalika nữa, tôi sẽ quay lại \"nơi dừng chân\" tìm Arapandu. Nara {NICKNAME} với Paimon có muốn đi cùng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161518,
						730161520
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161518,
					"content": "Vậy chúng ta đi thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730161519
					]
				},
				{
					"id": 730161519,
					"content": "Ừm. Vana nguy hiểm, đi cùng nhau an toàn hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161520,
					"content": "Vẫn còn chuyện khác.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730161521
					]
				},
				{
					"id": 730161521,
					"content": "#Nara {NICKNAME} và Paimon cẩn thận đấy, đừng lơ là. Aramuhukunda sẽ dõi theo các bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arabalika"
				}
			]
		},
