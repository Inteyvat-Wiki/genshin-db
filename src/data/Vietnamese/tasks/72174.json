			"trigger": {
				"objectNames": [
					"\"Người Lái Thuyền\""
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721740101,
					"content": "Bên sông...cây bách bạc trắng, cây ngải cứu bạc trắng, đá cũng bạc trắng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740102,
						721740103
					],
					"speakerTitle": "\"Người Lái Thuyền\""
				},
				{
					"id": 721740102,
					"content": "Cho hỏi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740104
					]
				},
				{
					"id": 721740104,
					"content": "Ồ...là khách à? Muốn lên thuyền sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740105
					],
					"speakerTitle": "\"Người Lái Thuyền\""
				},
				{
					"id": 721740105,
					"content": "Ái chà chà, nhìn kỹ thì là người ngoài...không được không được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740106,
						721740107
					],
					"speakerTitle": "\"Người Lái Thuyền\""
				},
				{
					"id": 721740106,
					"content": "Không được...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740108
					]
				},
				{
					"id": 721740108,
					"content": "Con thuyền lấp lánh bạc đi lên cung trăng này không dành cho bạn... đừng bước chân lên, đừng làm bẩn cánh buồm của tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740109
					],
					"speakerTitle": "\"Người Lái Thuyền\""
				},
				{
					"id": 721740109,
					"content": "Ái chà chà...sương mù giăng giăng...những ai chưa lên thuyền...nữ chủ nhân của căn phòng màu vàng sẽ giận đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740110
					],
					"speakerTitle": "\"Người Lái Thuyền\""
				},
				{
					"id": 721740110,
					"content": "Thuyền...? Ở đâu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740111
					]
				},
				{
					"id": 721740111,
					"content": "E hèm...chiếc thuyền lấp lánh bạc đó, chiếc thuyền của mặt trời và con cháu của núi, mọi người phải về nhà rồi, về ngôi nhà óng ánh trên cung trăng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740112
					],
					"speakerTitle": "\"Người Lái Thuyền\""
				},
				{
					"id": 721740112,
					"content": "Nhưng mà nhưng mà...một vài đứa trẻ bị lạc đường, đến bây giờ vẫn chưa lên thuyền...nữ chủ nhân sẽ nổi giận đấy, khủng khiếp lắm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740113,
						721740114
					],
					"speakerTitle": "\"Người Lái Thuyền\""
				},
				{
					"id": 721740113,
					"content": "Bạn có cần giúp gì không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740115
					]
				},
				{
					"id": 721740115,
					"content": "Mau lên thuyền, mau lên thuyền nào...đừng lạc đường nữa, đừng lưu luyến nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"Người Lái Thuyền\""
				},
				{
					"id": 721740114,
					"content": "Bạn có đang nghe tôi nói không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740115
					]
				},
				{
					"id": 721740107,
					"content": "Bạn đang nói gì thế?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740108
					]
				},
				{
					"id": 721740103,
					"content": "Bạn là ai?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740104
					]
				}
			]
		},
