						4520202
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520202,
					"content": "Không phải đàn sói, hình như là bộ lạc Hilichurl đang tập kích đội xe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520203
