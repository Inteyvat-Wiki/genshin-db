					"nextDialogs": [
						4520302
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 4520302,
					"content": "Chuyện nhỏ xíu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4520303,
					"content": "Gần đây bọn Hilichurl mượn uy danh của đàn sói, cũng trở nên hống hách hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520304
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520304,
					"content": "Là như vậy. Nhưng so với Hilichurl, đàn sói vẫn ngang ngược hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520305
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 4520305,
					"content": "Chúng nó... Buổi sáng vừa tập kích Thanh Tuyền Trấn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520306
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 4520306,
					"content": "Sao? Tập kích thị trấn?! Cũng hỗn xược quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520307
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520307,
					"content": "Đúng vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520308
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 4520308,
					"content": "Tôi nghĩ đàn sói gây chuyện xong rồi, là có thể lên đường, không ngờ lại gặp phải Hilichurl...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520309
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 4520309,
					"content": "Vậy giờ chúng ta đuổi theo, nói không chừng có thể nhìn thấy hiện trường để lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520310
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520310,
					"content": "Tôi đi trước nhé! Bạn hãy kiểm tra tổn thất đi. Xe hàng còn đi được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520311
					],
					"speakerTitle": "Amber"
				},
				{
