					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520204
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520204,
					"content": "Được rồi, bớt nói nhảm, chúng ta mau đến giúp đi.",
