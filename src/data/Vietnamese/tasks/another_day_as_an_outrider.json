			"dialogs": [
				{
					"id": 4520101,
					"content": "#A, Paimon và {NICKNAME}, tìm tôi có việc gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520102
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520102,
					"content": "Xin chào, Amber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520103,
						4520124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4520103,
					"content": "Amber, có một việc...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4520104
					]
				},
				{
					"id": 4520104,
					"content": "Amber, cô có quen tên nhóc trên Lang Lãnh không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4520105,
					"content": "A?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520106
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520106,
					"content": "Chính là người có quan hệ rất tốt với bạn đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4520107,
					"content": "Bạn đang nói gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520108
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520108,
					"content": "Kỳ lạ, hắn nói đợi cô ở chỗ cũ. Không lẽ cô đã quên hắn rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4520109,
					"content": "Bé Paimon, không lẽ ăn nhầm nấm rơm sinh ra ảo giác rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520110
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520110,
					"content": "Tôi hoàn toàn không hiểu gì hết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520111
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520111,
					"content": "Hừ... Nấm rơm không ăn được có màu gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4520112,
					"content": "Màu tím.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520113
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520113,
					"content": "...Hình như hai ngày trước có ăn qua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4520114,
					"content": "Chuyện này không quan trọng! Tôi không bị ngốc...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4520115,
					"content": "Cô thật sự không quen tên nhóc sống cùng với đàn sói chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4520116,
					"content": "Bạn đang nói gì cơ... không hiểu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520117
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520117,
					"content": "Nhưng mà, nói đến sói. Gần đây tôi đang điều tra một chuyện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520118
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520118,
					"content": "Đàn sói vốn chỉ hoạt động ở Lang Lãnh, gần đây to gan hơn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520119
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520119,
					"content": "Nghe nói, đã tập kích đội xe ở Vách Núi Mơ Màng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520120
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520120,
					"content": "Nếu rảnh, đến giúp tôi điều tra, được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520121,
						4520122
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520121,
					"content": "Không thành vấn đề.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4520123
					]
				},
				{
					"id": 4520123,
					"content": "Hì hì, thật đáng tin cậy, vậy chúng ta xuất phát thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520122,
					"content": "Chuyện chính quan trọng hơn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4520123
					]
				},
				{
					"id": 4520124,
					"content": "Xin chào, gần đây thế nào?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4520125
					]
				},
				{
					"id": 4520125,
					"content": "A, xem ra bạn rất rảnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520126
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520126,
					"content": "Hừm, thường sau khi nói câu này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4520127,
					"content": "Gần đây tôi rất bận. Trách nhiệm của Kỵ Sĩ Trinh Thám rất lớn mà, bạn có muốn đến giúp không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520129
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520129,
					"content": "Quả nhiên là câu này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520130,
						4520131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4520130,
					"content": "Không thành vấn đề.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4520132
					]
				},
				{
					"id": 4520132,
					"content": "Gần đây đàn sói bắt đầu tập kích đội xe men theo Vách Núi Mơ Màng rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520133
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520133,
					"content": "Bạn biết không? Đàn sói tuy là rất nguy hiểm, nhưng cũng có nguyên tắc của mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520134
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520134,
					"content": "Sói của Mondstadt thường không ra khỏi Lang Lãnh và núi Minh Quán.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520135
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520135,
					"content": "À à, nghe nói khu ấy tuy rất hoang sơ, nhưng cũng có quy định đặc biệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4520136,
					"content": "Đúng vậy. Cho nên đàn sói tập kích người ở Vách Núi Mơ Màng, quả thực rất kỳ lạ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520137
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520137,
					"content": "Nói đến sói, Amber cô quen tên nhóc trên Lang Lãnh không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4520138,
					"content": "Không quen, Mondstadt còn có người như vậy à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520139
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520139,
					"content": "Ơ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520140
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4520140,
					"content": "\"Cô gái màu đỏ, nhìn rất nóng\", chẳng lẽ không phải là Amber à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520141
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4520141,
					"content": "Bạn đang nói gì? Đó là gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520142
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520142,
					"content": "Tóm lại, tôi phải đi đến Vách Núi Mơ Màng điều tra rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520143
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520143,
					"content": "Các bạn cũng đi chung đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520131,
					"content": "Là việc gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4520132
					]
				}
			]
		},
