			"dialogs": [
				{
					"id": 711390601,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390602
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390602,
					"content": "Thế nào, Lingyuan? Cứ nhìn tôi chằm chằm, trên người tôi có thứ gì kỳ lạ sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390603
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711390603,
					"content": "Tôi chỉ đang nghĩ... Không, không có gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390604
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390604,
					"content": "Dù cô và rắn có yêu cầu thì tôi cũng sẽ không hóa lại thành hình người đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390605
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390605,
					"content": "Hihi, tôi đã từng yêu cầu cô đâu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390606
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711390606,
					"content": "...Bỏ đi. Đi thôi. Chẳng phải cô vẫn muốn ngắm nhìn vườn trà hiện tại sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lingyuan"
				}
			]
		},
		{
			"id": 7113907,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
