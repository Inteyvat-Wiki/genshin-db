				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711390501,
					"content": "Ồ! Không ngờ chúng ta lại thu thập được nhiều tiên lực như vậy rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390502,
						711390503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711390502,
					"content": "Không hổ danh là tôi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390505
					]
				},
				{
					"id": 711390505,
					"content": "Theo lời Fujin từng nói, số tiên lực này đều được sử dụng cho Ngọc Tế Lễ. Như vậy thì Làng Kiều Anh năm sau chắc sẽ được mùa bội thu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711390506,
					"content": "Lúc đó, tôi sẽ nhờ chú Luo chuẩn bị nhiều món ăn ngon cho tôi! Để nghĩ xem, như Bánh Trà, Bồ Câu, Thịt Viên Om, Xá Xíu Mật Ong, còn có...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711390507,
					"content": "Đúng rồi, còn có Trầm Ngọc Trà Lộ! Cái này phải ghi lại... Ơ? Ai vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711390508,
					"content": "Fu, Fujin?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711390509,
					"content": "Haha, xin lỗi, làm các vị giật mình rồi phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390510
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711390510,
					"content": "Cô đã có thể biến trở lại thành dạng người rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711390511,
					"content": "Đúng vậy. Không phải tôi từng nói rồi sao, chỉ cần nghỉ ngơi một thời gian là sẽ khôi phục lại dáng vẻ mà tôi thích thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390512
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711390512,
					"content": "#Cảm ơn các vị, trong thời gian tôi nghỉ ngơi đã giúp Ngọc Tế Lễ thu thập nhiều tiên lực như vậy. Mùa bội thu của năm nay, {NICKNAME} và Paimon là những người có công lớn nhất đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390513,
						711390514
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711390513,
					"content": "#Haha, đối với bổn {F#tiểu thư}{M#thiếu gia} mà nói thì dễ như trở bàn tay thôi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390515
					]
				},
				{
					"id": 711390515,
					"content": "Đúng rồi, bây giờ Fujin đã trở lại hình dạng con người, không còn phải bị nhốt trong nơi tối tăm này nữa. Tiếp theo cô có chuyện gì muốn làm không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711390516,
					"content": "Ừm... Tôi vẫn chưa nghĩ chi tiết. Có lẽ tôi sẽ đi dạo xung quanh đây trước nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390517
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711390517,
					"content": "Nhâm nhi tách trà của hiện tại, nghe kịch của hiện tại, gặp gỡ những con người của hiện tại... Haha, xin lỗi, cứ luôn nhấn mạnh chữ \"hiện tại\", cảm giác như tôi là một người cổ hủ vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390518
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711390518,
					"content": "Tuy nhiên, tôi rất thích từ \"hiện tại\". Những việc trước đây không làm được thì \"hiện tại\" sẽ có thể làm được. Những thứ trước đây không thực hiện được thì \"hiện tại\" sẽ thực hiện được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390519
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711390519,
					"content": "Sau này, tôi muốn đến Quy Li Tập xem thử, cũng đến cảng Liyue xem thử. Đi gặp con người đáng yêu mà họ nói, cũng muốn gặp lại Dược Quân...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390520
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711390520,
					"content": "Cần tôi đưa cô đi không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390521
					]
				},
				{
					"id": 711390521,
					"content": "Được đó. Tôi nhớ hình như Fujin nói là \"không thể rời khỏi nước ngọt quá lâu\", \"phải nhờ vào ấm trà của tiên gia để đi tới nơi thật xa\" gì đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390522
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711390522,
					"content": "Haha... Cảm ơn đã nhắc nhở, cũng cảm ơn vì đã có lòng giúp tôi. Nhưng tôi vẫn muốn ở lại Trầm Ngọc Cốc một thời gian để thưởng ngoạn phong cảnh quê nhà hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390523
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711390523,
					"content": "Còn việc đi xa, để tôi nghĩ xem... À, đợi khi Tiểu Mao lớn lên thì sao nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390524
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711390524,
					"content": "Vậy thì lâu quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390525
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711390525,
					"content": "Đùa thôi! Tóm lại, tôi vẫn định ở lại đây một thời gian, nhân tiện xem thử xem có thể thuyết phục được Lingyuan đi cùng tôi không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390526
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711390526,
					"content": "#Đúng rồi, {NICKNAME}! Trước khi các vị đi, tôi còn có một việc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390527
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711390527,
					"content": "Dù là Lingyuan hay tôi, cũng đều đã mang lại phiền phức cho các vị. Tiên lực của tôi cũng đã hồi phục một chút, để tôi ban cho các vị lời chúc phúc, bảo vệ các vị trên chặng đường tiếp theo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390528
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711390528,
					"content": "Haha, được rồi! Xem ra đã không còn vấn đề gì rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390529,
						711390530
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711390529,
					"content": "Cảm ơn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390532
					]
				},
				{
					"id": 711390532,
					"content": "#Một lần nữa... Cảm ơn {NICKNAME} và Paimon, vì tất cả những gì các vị đã làm cho tôi và Trầm Ngọc Cốc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711390530,
					"content": "Cảm giác như không có gì thay đổi nhỉ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390531
					]
				},
				{
					"id": 711390531,
					"content": "Dù sao thì \"vận may\" cũng không phải là thứ có thể nhìn thấy được ngay đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390532
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711390514,
					"content": "Có thể giúp được là tốt rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390515
					]
				},
				{
					"id": 711390503,
					"content": "#Không hổ danh là bổn {M#thiếu gia}{F#tiểu thư}!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390504
					]
				},
				{
					"id": 711390504,
					"content": "Này! Cũng đã qua lâu rồi, đừng có dùng cách nói chuyện kỳ lạ này nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390505
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7113906,
