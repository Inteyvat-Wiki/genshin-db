						711390903
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711390903,
					"content": "Hơn nữa, cô xem, tôi chỉ là một con cá bình thường, không biết nói chuyện... ục ục...",
					"roleType": "TALK_ROLE_NPC",
