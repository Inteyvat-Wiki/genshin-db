							1621.245,
							338.875,
							2414.79
						],
						"pointId": 311500192
					}
				]
			},
			"dialogs": [
				{
					"id": 711390301,
					"content": "Ơ, đây không phải là Lingyuan sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711390302,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390303
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390303,
					"content": "À, xin lỗi! Cô đang đi săn à? Chúng tôi vô tình làm phiền rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711390304,
					"content": "Tôi không đi săn. Các người cũng không có làm phiền tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390305
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390305,
					"content": "À, vậy là cô đang... ngẩn ngơ sao? Như là đang suy nghĩ về món ngon nào đó hả?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711390306,
					"content": "Tôi cũng không nghĩ tới chuyện của cô. Tôi chỉ đang suy tư thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390307
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390307,
					"content": "Suy tư... À khoan, vế trước của cô là có ý gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711390308,
					"content": "#Tôi đang suy nghĩ câu hỏi trước đó của {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390309
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390309,
					"content": "\"Nếu hoạt động của con người cũng là một phần của quy luật tự nhiên... Thì nên đối xử với con người như thế nào.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390310
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390310,
					"content": "Sau khi Fujin và rắn rời khỏi, đã rất lâu rồi tôi không tiếp xúc với loài người tụ họp thành nhóm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390311
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390311,
					"content": "Tiểu Mao cũng là con người mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711390312,
					"content": "#Tiểu Mao thuộc về con người định cư trong nhóm, không phải là con người tụ họp thành nhóm. Paimon và {NICKNAME} \"tụ họp\" thành bạn đồng hành, chứ không \"thuộc về\" {NICKNAME}. Đó là sự khác biệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390313,
						711390315
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390313,
					"content": "Cô cho rằng Tiểu Mao không phải là một phần của trật tự xã hội sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390314
					]
				},
				{
					"id": 711390314,
					"content": "Vẫn chưa hoàn toàn trở thành một phần của trật tự xã hội. Con người khi nhỏ đều sẽ như vậy, cho đến khi họ bị trật tự thôn tính hoàn toàn, cũng giống như tự nhiên vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390317
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390317,
					"content": "Đã rất lâu rồi tôi không tiếp xúc với những con người tụ họp thành nhóm. Có lẽ vì chán ghét, có lẽ vì sợ hãi, hoặc có thể là cả hai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390318,
						711390319
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390318,
					"content": "Vì họ lấn chiếm đất thuộc về tự nhiên sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390320
					]
				},
				{
					"id": 711390320,
					"content": "Tôi không biết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390321
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390321,
					"content": "Có lẽ không có sự phân biệt rõ ràng giữa \"chúng ta\" và \"bọn họ\", nhưng tôi không thể chắc chắn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390322
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390322,
					"content": "Trẻ con của con người sẽ đi cùng tôi, tộc của tôi cũng có những cá thể trẻ tuổi, vì tò mò mà chọn đi cùng con người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390323
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390323,
					"content": "Hả? Cá thể trẻ tuổi cùng tộc?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711390324,
					"content": "Đứa trẻ đó đã gặp phải người phàm ở trong núi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390325
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390325,
					"content": "Vì vậy, bây giờ tôi vẫn chưa thể trả lời câu hỏi này. Tôi cần tiếp tục quan sát con người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390326
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390326,
					"content": "Có nhiều điều tôi không hiểu. Tôi sẽ cố gắng hiểu, cho đến khi trả lời được câu hỏi đó như đã thống nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390319,
					"content": "Do Fujin vì họ mà chọn hy sinh bản thân sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390320
					]
				},
				{
					"id": 711390315,
					"content": "Cái này khó nói...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390316
					]
				},
				{
					"id": 711390316,
					"content": "Này! Đừng nói những điều kỳ lạ như vậy chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390317
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7113904,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7113904",
							"2"
						],
						"stepId": 7113904,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tiểu Mao",
					"Hautemontagne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711390401,
					"content": "Nghe chị Đại Sơn nói vậy, em cảm thấy \"nhạc kịch\" của Fontaine so với kịch ở đây cũng không khác nhau mấy nhỉ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390402
					],
					"speakerTitle": "Tiểu Mao"
				},
				{
					"id": 711390402,
					"content": "Hiệp sĩ, pháp sư, dũng sĩ, rồng hung ác, tàn sát lẫn nhau, cuối cùng chết hết!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390403
					],
					"speakerTitle": "Tiểu Mao"
				},
				{
					"id": 711390403,
					"content": "Điều quan trọng không phải là cái kết, mà là quá trình! Không phải mọi bi kịch đều có thể xem như một bộ phim võ thuật đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390404
					],
					"speakerTitle": "Hautemontagne"
				},
				{
					"id": 711390404,
					"content": "Còn nữa, ma tượng gì gì đó mà chị Đại Sơn nói lúc nãy, nghe có vẻ rất thú vị! Không biết so với A Lam thì cái nào to hơn nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390405
					],
					"speakerTitle": "Tiểu Mao"
				},
				{
					"id": 711390405,
					"content": "Hửm? A Lam?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390406
					],
					"speakerTitle": "Hautemontagne"
				},
				{
					"id": 711390406,
					"content": "Đúng rồi, hình như em chưa kể cho chị Đại Sơn nghe về chuyện của A Lam nhỉ? Thế này đi, chị kể cho em nghe câu chuyện về ma tượng gì gì đó, em sẽ kể cho chị nghe chuyện của A Lam nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tiểu Mao"
				}
			]
		},
