			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tiểu Mao",
					"Lingyuan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711390201,
					"content": "A Lam, A Lam, câu chuyện lần trước chị kể vẫn chưa có đoạn kết!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390202
					],
					"speakerTitle": "Tiểu Mao"
				},
				{
					"id": 711390202,
					"content": "Ừm. Nhớ rồi. Nhưng chị đổi ý rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390203
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390203,
					"content": "\"Đổi ý\" là ý gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390204
					],
					"speakerTitle": "Tiểu Mao"
				},
				{
					"id": 711390204,
					"content": "Đoạn kết của câu chuyện này sẽ giao cho em kể nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390205
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390205,
					"content": "Ơ?! A Lam xấu quá! Đã thỏa thuận là em sẽ kể cho chị nghe một câu chuyện, chị sẽ kể cho em một câu chuyện, nhưng bây giờ thành ra em phải kể hai câu chuyện rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390206
					],
					"speakerTitle": "Tiểu Mao"
				},
				{
					"id": 711390206,
					"content": "Chị chỉ là một con thú ngu ngốc. Chị không thể nghĩ ra một cái kết tốt đẹp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390207
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390207,
					"content": "Kết thúc mà chị nghĩ ra không có hậu, câu chuyện cũng không khiến ai vui vẻ. Vậy nên để em kể phần kết vẫn hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390208
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390208,
					"content": "Nhưng đây vẫn là chơi xấu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390209
					],
					"speakerTitle": "Tiểu Mao"
				},
				{
					"id": 711390209,
					"content": "Chị không phủ nhận. Để bồi thường, chị có thể đưa em đi xem cảnh vật tuyệt đẹp ở Linh Mông Sơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390210
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390210,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390211
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390211,
					"content": "Đừng làm vẻ mặt đó. Chị sẽ cho phép em... ngồi trên lưng chị khoảng năm phút. Mười phút cũng được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390212
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390212,
					"content": "Vậy... vậy cũng được. Để em nghĩ xem câu chuyện này nên kết thúc như thế nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tiểu Mao"
				}
			]
		},
		{
			"id": 7113903,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
