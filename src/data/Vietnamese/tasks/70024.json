					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700240101,
					"content": "Nhà Lữ Hành, xin mời qua đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 700240102,
					"content": "#Xin lỗi đã làm mất thời gian của {F#cô}{M#cậu}. Xin hỏi, {F#cô}{M#cậu} có hứng thú nhận ủy thác mới này không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240103,
						700240104
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 700240103,
					"content": "Xin cứ nói, đừng ngại.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240105
					]
				},
				{
					"id": 700240105,
					"content": "Là vầy, theo báo cáo mà hiệp hội nhận được gần đây, thì bọn Hilichurl ở ngoài thành đang tụ tập, muốn phá rối con đường kinh doanh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240106
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 700240106,
					"content": "Vì việc này, chúng tôi cũng đã phái đi không ít Nhà Mạo Hiểm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240107
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 700240107,
					"content": "Nhưng theo lời của những Nhà Mạo Hiểm, trong số những Hilichurl đang tụ tập đó, có một Hilichurl rất kỳ lạ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240108
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 700240108,
					"content": "Chúng tôi nghĩ rằng Hilichurl kỳ lạ đó có lẽ có liên quan đến việc gây rối lần này của Hilichurl...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240114
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 700240114,
					"content": "Vì vậy, chúng tôi cần người đi bắt hoặc ít ra cũng có thể đuổi tên kỳ lạ đó đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240109
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 700240109,
					"content": "Nhà Lữ Hành liệu có muốn nhận ủy thác này không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240110,
						700240111
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 700240110,
					"content": "Không thành vấn đề.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240112
					]
				},
				{
					"id": 700240112,
					"content": "#Cám ơn. Tôi đã đánh dấu vài địa điểm lên bản đồ của {F#cô}{M#cậu} rồi đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240113
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 700240113,
					"content": "Những nơi này đều có Hilichurl xuất hiện, hãy bắt đầu điều tra từ đó nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240115
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 700240115,
					"content": "Nếu gặp Hilichurl kỳ lạ đó... xin hãy cẩn thận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 700240111,
					"content": "Tôi sẽ chú ý.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240112
					]
				},
				{
					"id": 700240104,
					"content": "Xin hỏi là ủy thác gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240105
					]
				}
			]
		},
