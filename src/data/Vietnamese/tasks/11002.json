					"content": "Đương nhiên là chưa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020204
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020204,
					"content": "Vậy thì tại sao lại cứng rắn như vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110020205,
					"content": "Đây là phong cách của tôi, nếu trước khi làm một món đã nghĩ xong là làm gì, vậy thì chắc chắn là một món không có gì bất ngờ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020206
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020206,
					"content": "Đồng thời, nếu trước khi tìm đã nghĩ xong là tìm gì, vậy thì cũng không có gì bất ngờ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020207
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020207,
					"content": "Cũng sơ sài quá đi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110020208,
					"content": "Yên tâm đi, đặc sản của Vạn Dân Đường đều từ đó mà ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020209
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020209,
					"content": "Đi xung quanh xem trước đi, nếu tôi nhìn thấy nguyên liệu vừa ý sẽ nói cho bạn biết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xiangling"
				}
			]
