			"dialogs": [
				{
					"id": 765000101,
					"content": "#{NICKNAME}! Mau qua đây! Có một thứ siêu hay ho đây này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765000102,
					"content": "Tada! Đây là bảo bối tôi đã tốn rất nhiều công sức mới tìm được từ khu chợ lộn xộn này đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000103,
						765000104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765000103,
					"content": "Máy ảnh này... trông có vẻ cổ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765000106
					]
				},
				{
					"id": 765000106,
					"content": "Nghe người bán hàng thần bí đó nói đây là chiếc máy ảnh mà nhiếp ảnh gia siêu nổi tiếng của Fontaine mấy chục năm trước là ngài Pierre Leblanc từng dùng đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765000107,
					"content": "Nghe nói những bức ảnh ông ấy chụp bằng chiếc máy ảnh này đều rất được yêu thích, thỉnh thoảng còn được lên trang nhất của tờ báo Chim Hơi Nước nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765000108,
					"content": "#Nếu {NICKNAME} cũng dùng thì biết đâu cũng có thể chụp ra những tác phẩm để đời! Thậm chí còn có thể bán được với giá trên trời đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000109,
						765000112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765000109,
					"content": "Cái máy ảnh này... chắc không rẻ đâu nhỉ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765000110
					]
				},
				{
					"id": 765000110,
					"content": "Hihi, cũng tàm tạm thôi! Tôi cũng có để dành một chút quỹ dự phòng mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765000111,
					"content": "#Chỉ cần {NICKNAME} thích thì chút Mora này có đáng gì đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000116,
						765000117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765000116,
					"content": "Cảm ơn Paimon nhé. Tôi rất thích.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765000118
					]
				},
				{
					"id": 765000118,
					"content": "Tốt quá, thích là được rồi! Vừa hay chúng ta đã đến một đất nước mới, ở đây chắc chắn có rất nhiều thứ hay ho. Hãy chụp lại tất cả đi nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765000119,
					"content": "Cuốn album mới tôi cũng đã chuẩn bị sẵn rồi. Có phải là siêu chu đáo không!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765000120,
					"content": "Được rồi, chúng ta cùng đi khám phá những nơi thú vị đó nào! Xuất phát!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765000117,
					"content": "Tôi sẽ cố gắng dùng nó để chụp ra những bức ảnh đẹp.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765000118
					]
				},
				{
					"id": 765000112,
					"content": "Paimon không gặp phải gian thương đấy chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765000113
					]
				},
				{
					"id": 765000113,
					"content": "Yên tâm đi. Để đảm bảo không có sai sót, tôi đã nhờ một kỹ sư rất đáng tin cậy giúp giám định rồi, đây chính là mẫu máy mà ngài Leblanc đã dùng năm đó, không sai đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765000114,
					"content": "Hơn nữa, lúc kỹ sư tháo máy ra, còn phát hiện bên trong có một dấu ấn nhỏ khắc tên viết tắt của ông ấy nữa. Đây là bằng chứng độc nhất vô nhị đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765000115,
					"content": "Hừm, với tư cách người dẫn đường thì tôi rất đáng tin cậy đấy. Những lúc quan trọng thì sẽ không gây thất vọng đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000116,
						765000117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765000104,
					"content": "Paimon định kinh doanh đồ cổ à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765000105
					]
				},
				{
					"id": 765000105,
					"content": "Không phải! Đây là món quà bất ngờ mà tôi đã chuẩn bị đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000106
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}