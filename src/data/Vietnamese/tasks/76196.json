			"dialogs": [
				{
					"id": 761960301,
					"content": "Nhìn xem, chắc không sót gì chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960302
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960302,
					"content": "Ừm, không có vấn đề gì, vừa đủ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960303
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960303,
					"content": "Tôi thấy cô đã dùng Bạc Ánh Trăng xếp thành những hình ảnh rất thú vị trên mặt đất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960304
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960304,
					"content": "Đúng vậy! Cũng tốn khá nhiều công sức đấy, tôi nghĩ làm như thế sẽ khơi dậy được sự yêu thích của mọi người dành cho Bạc Ánh Trăng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960305
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960305,
					"content": "Nói đến chuyện này, tôi có nghe một câu chuyện dân gian ở Natlan kể rằng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960306
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960306,
					"content": "Một cô gái vốn sống trên ngôi sao, sau khi rơi xuống mặt đất, đã để lại những bức graffiti khổng lồ trên mặt đất để có thể trở về bầu trời.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960307
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960307,
					"content": "Sau đó, người cha mặt trời trên cao quả nhiên đã nhìn thấy lời cầu xin của cô và đưa cô trở về trời.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960308
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960308,
					"content": "Biết đâu cha cô ấy cũng có thể nhìn thấy hình ảnh do Dorota xếp ra, và từ đó trở thành người hâm mộ của Bạc Ánh Trăng nhỉ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960309
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960309,
					"content": "Haha! Nếu vậy thì tôi chính là đại sứ quảng bá Bạc Ánh Trăng xuất sắc nhất rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960310
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960310,
					"content": "Nhưng mà so với chuyện đó, tôi vẫn lo bị lũ chim trên trời nhòm ngó hơn, cô cũng biết đấy, lũ quạ hay gì đó rất thích những thứ sáng bóng mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960311
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960311,
					"content": "Cũng đúng nhỉ, hơn nữa ngoài quạ ra, cũng phải cẩn thận với Chuột Chũi Khịt Khịt và Chồn Đạo Bảo dưới đất nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960312
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960312,
					"content": "Và cả Lumi nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960313
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960313,
					"content": "Haha, đúng rồi! Còn có Lumi nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960314
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960314,
					"content": "Ya-ho?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960315
					],
					"speakerTitle": "Lumi"
				},
				{
					"id": 761960315,
					"content": "Cảm ơn cô đã giúp đỡ lúc nãy, tuy chỉ là một phần nhỏ trong bộ sưu tập của tôi, nhưng tặng cô đấy, xem như là tặng cho Lumi nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960316
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960316,
					"content": "Lumi, hôm nay thật là một ngày tuyệt vời!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960317
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960317,
					"content": "Ya-hoho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lumi"
				}
			]
