			"dialogs": [
				{
					"id": 761960201,
					"content": "Dorota! Sao cô lại ở đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960202
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960202,
					"content": "Linnea, cô đến đúng lúc lắm! Tôi vừa giới thiệu với mọi người về dáng vẻ tuyệt vời của Bạc Ánh Trăng đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960203
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960203,
					"content": "Bạc Ánh Trăng ơi là Bạc Ánh Trăng, trong thế giới dưới trăng này còn có đá quý nào hoàn hảo hơn ngươi chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960204
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960204,
					"content": "Nhìn kìa! Hình dạng hoàn hảo không tì vết, cảm giác trơn nhẵn như ngọc! Còn có màu trắng ngũ sắc lung linh, sức hấp dẫn nguyên tố tuyệt vời!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960205
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960205,
					"content": "Trong lòng tôi, chỉ có mặt trăng trên trời mới có thể sánh ngang thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960206
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960206,
					"content": "Bạc Ánh Trăng quả thật là loại khoáng thạch rất đẹp, tôi cũng đã sưu tầm một ít làm mẫu vật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960207
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960207,
					"content": "Đúng vậy! Tôi biết mà, chắc chắn cô sẽ hiểu tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960208
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960208,
					"content": "Nhưng mà, người hiểu Bạc Ánh Trăng nhất chắc chắn vẫn là tôi! Dù cô có là cố vấn của hiệp hội thì vị trí số một này tôi cũng không nhường đâu nhé, haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960209
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960209,
					"content": "À đúng rồi, thường ngày cô là người giảng bài cho các nhà mạo hiểm, hôm nay để tôi kiểm tra cô một chút nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960210
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960210,
					"content": "Tôi có ba viên Bạc Ánh Trăng đây, rất tiếc là trong đó có hai viên có khuyết điểm nhỏ, viên còn lại là báu vật của tôi, là tinh túy trong số Bạc Ánh Trăng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960211
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960211,
					"content": "Cô có thể phân biệt được đâu mới là viên Bạc Ánh Trăng hoàn hảo nhất không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960212
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960212,
					"content": "Để tôi xem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960213,
						761960220,
						761960225
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960213,
					"content": "Viên bên trái này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960214
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960214,
					"content": "(Ơ? Lumi đang...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960215,
						761960231
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960215,
					"content": "Chọn viên này vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960216
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960216,
					"content": "Linnea cũng có lúc nhìn lầm đấy, thực ra viên này có chút khuyết điểm nhỏ ở vị trí ít để mắt đến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960217
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960217,
					"content": "Ừm, lần này tôi thua rồi... nhưng lần sau tôi sẽ không thua dễ dàng như vậy đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960218
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960218,
					"content": "Được thôi, lúc nào cũng sẵn sàng đón tiếp!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960232
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960232,
					"content": "Tiện thể tham gia luôn buổi thẩm định Bạc Ánh Trăng do Dorota tổ chức, trải qua khoảng thời gian vui vẻ...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						761960219
					]
				},
				{
					"id": 761960219,
					"content": "Không ngờ mọi người nhiệt tình đến vậy, tiếc là những khoảnh khắc tuyệt vời như thế này luôn trôi qua trong chớp mắt... Cũng đến lúc phải dọn dẹp rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960233
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960233,
					"content": "Để tôi giúp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960234
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960234,
					"content": "Vậy thì tốt quá rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960231,
					"content": "Để tôi nghĩ thêm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960212
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960220,
					"content": "Viên ở giữa này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960221
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960221,
					"content": "(Hình như Lumi rất thích viên này.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960222,
						761960231
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960222,
					"content": "Chọn viên này vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960223
