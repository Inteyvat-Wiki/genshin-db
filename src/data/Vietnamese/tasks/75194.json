				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kulemana"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751940401,
					"content": "Phù... tốt quá rồi, từ kết quả thì tình hình núi lửa không tệ như dự đoán, lần này thì mọi người có thể ngủ ngon rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940402
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940402,
					"content": "Chuyện này vẫn phải cảm ơn hai người, nếu không nhờ hai người ra tay cứu giúp thì sẽ không thuận lợi thế này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940403
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940403,
					"content": "Xin hãy nhận lấy phần thù lao này, xem như quà tạ lỗi và lời cảm ơn từ tôi nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940404
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940404,
					"content": "Hihi, nếu vậy thì chúng tôi xin nhận nhé!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940405
					]
				},
				{
					"id": 751940405,
					"content": "Tiếp theo đây sẽ làm gì...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940406
					]
				},
				{
					"id": 751940406,
					"content": "Trong tay tôi còn một số hàng đang tồn đọng, chỉ cần vận hành thêm chút thì sẽ có kinh phí thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940407
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940407,
					"content": "Haha, đương nhiên rồi, lần này không có việc gấp gì, nên tôi sẽ làm ăn chân chính, hai người yên tâm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kulemana"
				}
			]
		},
		{
			"id": 7519405,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7519404",
							"3"
						],
						"stepId": 7519404,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kulemana"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751940501,
					"content": "10, 20... bán được nhiều tiền như vậy, kinh phí dạo này chắc là đủ rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940502,
						751940510
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940502,
					"content": "Không kiếm thêm chút sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940503
					]
				},
				{
					"id": 751940503,
					"content": "#Haha, không kiếm nữa đâu, phải biết dừng đúng lúc! Nếu không phải nhờ {F#cô}{M#cậu} không so đo với tôi, còn giúp tôi một việc, thì e là tôi đã sớm gặp rắc rối lớn vì số ngọc đó rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940504
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940504,
					"content": "Hơn nữa, ngày nào cũng chỉ nhắm đến tiền thì chán lắm. Đối với tôi thì kiếm tiền là một sở thích, quan sát núi lửa mới là cuộc sống.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940505
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940505,
					"content": "Tiền hết rồi thì có thể kiếm lại, nhưng lỡ vì sơ suất của chúng tôi khiến việc núi lửa phun trào không được cảnh báo trước, vậy thì đúng là lợi bất cập hại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940506
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940506,
					"content": "Phòng Quản Lý không cấp kinh phí sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940507
					]
				},
				{
					"id": 751940507,
					"content": "Chúng tôi chưa đăng ký. Dù sao thì công việc hằng ngày đã đủ khiến Phòng Quản Lý và các thủ lĩnh lo lắng rồi, sao có thể lại tăng thêm gánh nặng cho họ vào lúc này chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940508
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940508,
					"content": "Còn tôi và đồng đội thì khác. Chúng tôi thường kết hợp việc du lịch với kiếm tiền, nên đã quen với cuộc sống này rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940509
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940509,
					"content": "Trên đường đi tiện thể quan sát núi lửa cũng không phải chuyện khó, giống như việc hai người hay giúp đỡ những người đang gặp khó khăn ấy, dễ như trở bàn tay!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940510,
					"content": "Tạm biệt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940511
					]
				},
				{
					"id": 751940511,
					"content": "Đi thong thả nhé, hì hì, có duyên sẽ gặp lại!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kulemana"
				}
			]
		},
		{
