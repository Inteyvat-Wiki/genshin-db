						],
						"pointId": 11062
					},
					{
						"sceneId": 3,
						"position": [
							-2946.541,
							203.922,
							9783.725
						],
						"pointId": 11325
					},
					{
						"sceneId": 3,
						"position": [
							-2945.759,
							203.869,
							9785.573
						],
						"pointId": 11326
					}
				]
			},
			"dialogs": [
				{
					"id": 751940101,
					"content": "#Đợi đã, đợi đã, đây là hàng hóa, không mua thì đừng có động vào! Haiz... {F#Cô}{M#Cậu}, đúng rồi, người có mái tóc vàng đó. Đừng đi vội, để tôi xem thử nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940102
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940102,
					"content": "#Ồ! Đúng là vậy, mái tóc lấp lánh như mặt trời, đôi mắt sâu thẳm như Vương Quốc Dạ Thần... Tôi đoán, không, tôi chắc chắn, sau này {F#cô}{M#cậu} sẽ trở thành một nhân vật tài giỏi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940103
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940103,
					"content": "#Đến đây nào, chỗ tôi có một bộ trang sức ngọc kỳ diệu, chứa đựng nhiều giai điệu khác nhau, vừa khéo có thể xứng với một đại anh hùng như {F#cô}{M#cậu} đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940104
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940104,
					"content": "#Nhưng mà, đây là bảo vật vô giá. Người thường đến mua thì ít nhất tôi sẽ nói giá hơn 10 triệu Mora. Nhưng thấy {F#cô}{M#cậu} có duyên với những miếng ngọc này, tôi sẽ giảm giá cho 90%, thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940105
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940105,
					"content": "Woa, giảm 90% thì có khác gì đại hạ giá chứ! Đợi đã... Tính ra thì không phải vẫn là hơn một triệu Mora sao! Đắt quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751940106,
					"content": "Ầy, chịu thôi. Đây đã là giá vốn rồi, dù sao thì tiểu thương như chúng tôi cũng không dễ dàng gì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940107,
						751940108
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940107,
					"content": "Không nên kiếm kinh phí kiểu vậy đâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940109
					]
				},
				{
					"id": 751940109,
					"content": "#Thì ra {F#cô}{M#cậu} đã nghe thấy hết rồi. Ahaha, {F#cô}{M#cậu} thấy đấy tôi thích tự lảm nhảm như vậy thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940110
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940110,
					"content": "Haiz... Bị phát hiện rồi thì tôi nói thật vậy. Miếng ngọc này là tôi nhặt được, thực sự thì nó cũng không đáng giá như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940111
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940111,
					"content": "#Nhưng tôi cũng hết cách rồi. Như {F#cô}{M#cậu} đã nghe đó, chúng tôi rất thiếu kinh phí, đến cả tiền thuê người đến thu hồi dữ liệu phao nổi trên mặt nước cũng không có.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940112
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940112,
					"content": "Vậy thì không thu hồi nữa, dù sao vẫn tốt hơn lừa gạt người khác mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751940113,
					"content": "Không được... Nếu là tổ chức khác, thiếu kinh phí thì cũng chỉ dừng hoạt động, nhưng tổ chức chúng tôi còn phụ trách nhiệm vụ tình nguyện quan sát núi lửa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940114
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940114,
					"content": "Chúng tôi thả phao nổi cũng là để thu thập dữ liệu như nhiệt độ nước, từ đó kiểm tra hoạt động của núi lửa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940115
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940115,
					"content": "Núi lửa hiện nay hoạt động ngày càng mạnh, việc thu hồi phao nổi cũng phải đẩy nhanh tiến độ, nếu không sẽ xảy ra vấn đề lớn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940116
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940116,
					"content": "Do tôi bị thương, căn bản không thể phá được phao nổi chứ đừng nói tới việc thu hồi dữ liệu bên trong...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940117
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940117,
					"content": "#{NICKNAME}, hay là chúng ta giúp một tay đi! Dù sao thì chuyện núi lửa cũng có liên quan đến an nguy của mọi người, chúng ta không thể làm ngơ được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751940118,
					"content": "Thật, thật sao? Nếu đồng ý giúp tôi thì tôi sẽ tặng miếng ngọc này cho hai người! Xem như là thù lao, thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940119,
						751940120
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940119,
					"content": "Không phải nói là một triệu hả...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940121
					]
				},
				{
					"id": 751940121,
					"content": "Yên tâm đi, tuy không có nhiều, nhưng ngoài miếng ngọc ra, chắc chắn sẽ có thêm thù lao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940122
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940122,
					"content": "Hihi, chỉ cần có miếng ngọc là được rồi! Dù sao cũng vì những người ở cạnh núi lửa mà! Tóm lại, cứ yên tâm giao cho chúng tôi là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940123,
						751940124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751940123,
					"content": "Bắt đầu thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 751940124,
					"content": "Cần chuẩn bị một chút.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940125
					]
				},
				{
					"id": 751940125,
					"content": "Ừm, tôi thì bắt đầu bất cứ lúc nào cũng được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940120,
					"content": "A... Hóa ra chỉ có miếng ngọc thôi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940121
					]
				},
				{
					"id": 751940108,
					"content": "Giúp việc gì mà xứng đáng một triệu Mora chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940109
					]
				}
			]
		},
		{
			"id": 7519404,
			"completionStepIds": [
				7519404
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
