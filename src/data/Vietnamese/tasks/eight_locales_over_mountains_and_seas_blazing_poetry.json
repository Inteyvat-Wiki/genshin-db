			"dialogs": [
				{
					"id": 726770101,
					"content": "Cảnh sắc ở đây rất đặc biệt đúng không!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770102,
					"content": "Một tầng một tầng nước, màu sắc rất đặc biệt, Mm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770103,
						726770108,
						726770111
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726770103,
					"content": "Kho từ ngữ của Paimon và Kichiboushi thiếu thốn ghê...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770104
					]
				},
				{
					"id": 726770104,
					"content": "#Nhưng nó đặc biệt thật mà! Màu sắc này {NICKNAME} phải hình dung thế nào đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770105,
						726770106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770105,
					"content": "Giống nguyên tố Băng",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770107
					]
				},
				{
					"id": 726770107,
					"content": "Gì chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770113,
					"content": "#Nhưng mà cảnh sắc nơi này thực sự rất đặc biệt. {NICKNAME} còn nhớ vị họa sĩ trước đó không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770114,
						726770116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770114,
					"content": "Vermeer?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770115
					]
				},
				{
					"id": 726770115,
					"content": "Ừm! Chính là Vermeer đó! Lúc đó chúng ta còn giúp anh ta trang trí viên ngọc phát sáng siêu cấp lên hai bức tượng nữa đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770118,
					"content": "Sau đó anh ta còn tặng một bức tranh cho chúng ta nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770119,
					"content": "Là cái này sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770120
					]
				},
				{
					"id": 726770120,
					"content": "Ừm! Chính là cái này, Kichiboushi, xem nè!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770121,
					"content": "Mm! Giống quá! Là ảnh chụp sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770122
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726770122,
					"content": "Không phải, đây là do con người vẽ ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770123,
					"content": "Nhưng mà, tại sao con người đã biết chụp hình, lại còn phải vẽ tranh nữa nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770124
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726770124,
					"content": "#Ừm... cũng phải ha, tại sao vậy {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770125,
						726770127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770125,
					"content": "Bởi vì muốn tạo ra thứ chỉ thuộc về mình.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770126
					]
				},
				{
					"id": 726770126,
					"content": "Câu nói này hình như rất có đạo lý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770130,
					"content": "Với lại, bức ảnh mà bản thân vẽ ra sẽ có ý nghĩa hơn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770131
					]
				},
				{
					"id": 726770131,
					"content": "Ừm, vẽ từng nét từng nét vào bức tranh là một việc vất vả lắm đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770132,
					"content": "Hử... vậy thì chụp hình cho Kichiboushi có phải rất dễ, không vất vả, cho nên không có ý nghĩa đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770133
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726770133,
					"content": "Chà! Không phải thế, là bởi vì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770134,
					"content": "Vẽ sẽ tốn rất nhiều thời gian, Kichiboushi sẽ mệt đó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770135
					]
				},
				{
					"id": 726770135,
					"content": "Đúng vậy! Vẽ tốn nhiều thời gian lắm, Kichiboushi phải luôn đứng yên trong một tư thế sẽ rất mệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770136,
					"content": "Trước đó khi bị phong ấn vào tảng đá cũng đứng yên thế mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770137
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726770137,
					"content": "Cho nên, khi giải được ấn, chân hơi khó chịu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770138
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726770138,
					"content": "Chà, nghe thôi cũng thấy mệt rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770139,
					"content": "Nhưng mà, Paimon biết bay mà, chân chắc không bị mệt đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770140
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726770140,
					"content": "Này! Lúc bay cũng phải vận dụng sức mạnh toàn thân đó, mệt lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770141
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770141,
					"content": "Woa! Hoa bắt lửa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770142
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726770142,
					"content": "Nghe người ta nói hết đã chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770143
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770143,
					"content": "Liệt Hỏa Hoa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770144
					]
				},
				{
					"id": 726770144,
					"content": "Đúng ha, hình như trong Rừng Chinju không có Liệt Hỏa Hoa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770145,
					"content": "Kichiboushi muốn có không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770146
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770146,
					"content": "Muốn! Trông ấm lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770147
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726770147,
					"content": "#Vậy thì nhờ vào {NICKNAME} nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770148
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770148,
					"content": "#{NICKNAME}, muốn có nó. Cảm ơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770149
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726770149,
					"content": "Bake-Danuki nói chuyện có phong cách thật...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770127,
					"content": "Bởi vì máy ảnh mắc lắm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770128
					]
				},
				{
					"id": 726770128,
					"content": "Hả?! Máy ảnh mắc lắm sao? Chúng ta thường ngày hay chiến đấu, bơi lội, leo núi, lại còn té núi nữa, không biết có bị hư không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770129,
					"content": "Chậc, không ngờ đó, sau này phải cẩn thận mới được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770116,
					"content": "Ai vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770117
					]
				},
				{
					"id": 726770117,
					"content": "Là Vermeer đó! Lúc đó chúng ta còn giúp anh ta trang trí viên ngọc phát sáng siêu cấp lên hai bức tượng nữa đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770106,
					"content": "Giống nguyên tố Phong",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770107
					]
				},
				{
					"id": 726770108,
					"content": "Kho từ ngữ của Paimon và Kichiboushi phong phú ghê...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770109
					]
				},
				{
					"id": 726770109,
					"content": "Lợi hại như Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770110
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726770110,
					"content": "#Ờm... hình như ý của {NICKNAME} không phải thế đâu. Nhưng nói chung là... Kichiboushi rất thông minh đó! Hứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770111,
					"content": "Đúng là rất đặc biệt!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770112
					]
				},
				{
					"id": 726770112,
					"content": "#Ấy? Kho từ ngữ của {NICKNAME} có phải hơi thiếu thốn không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770113
					],
					"speakerTitle": "Paimon"
				}
			]
		},
