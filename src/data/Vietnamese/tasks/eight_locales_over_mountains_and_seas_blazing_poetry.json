						726771014
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771014,
					"content": "Paimon biết vẽ sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726771015
					]
				},
				{
					"id": 726771015,
					"content": "Không biết thì học!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771016
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771016,
					"content": "Vẽ tranh... nhưng mà vẽ khó lắm. Trước đây, thấy Utamarou vẽ, một tấm rất lâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771017
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726771017,
					"content": "Tại sao con người biết chụp hình, lại còn đi vẽ tranh, Mm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771018
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726771018,
					"content": "#Ừm... cũng phải ha, tại sao vậy {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771019,
						726771021
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771019,
					"content": "Bởi vì muốn tạo ra thứ chỉ thuộc về mình.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726771020
					]
				},
				{
					"id": 726771020,
					"content": "Câu nói này hình như rất có đạo lý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771024
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771024,
					"content": "Với lại, bức ảnh mà bản thân vẽ ra sẽ có ý nghĩa hơn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726771025
					]
				},
				{
					"id": 726771025,
					"content": "Ừm, vẽ từng nét từng nét vào bức tranh là một việc vất vả lắm đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771026
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771026,
					"content": "Hử... vậy thì chụp hình cho Kichiboushi có phải rất dễ, không vất vả, cho nên không có ý nghĩa đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771027
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726771027,
					"content": "Chà! Không phải thế, là bởi vì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771028
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771028,
					"content": "Vẽ sẽ tốn rất nhiều thời gian, Kichiboushi sẽ mệt đó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726771029
					]
				},
				{
					"id": 726771029,
					"content": "Đúng vậy! Vẽ tốn nhiều thời gian lắm, Kichiboushi phải luôn đứng yên trong một tư thế sẽ rất mệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771030
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771030,
					"content": "Trước đó khi bị phong ấn vào tảng đá cũng đứng yên thế mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771031
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726771031,
					"content": "Cho nên, khi giải được ấn, chân hơi khó chịu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771032
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726771032,
					"content": "Chà, nghe thôi cũng thấy mệt rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771033
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771033,
					"content": "Nhưng mà, Paimon biết bay mà, chân chắc không bị mệt đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771034
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726771034,
					"content": "Này! Lúc bay cũng phải vận dụng sức mạnh toàn thân đó, mệt lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771035
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771035,
					"content": "Woa! Hoa bắt lửa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771036
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726771036,
					"content": "Nghe người ta nói hết đã chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771037
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771037,
					"content": "Liệt Hỏa Hoa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726771038
					]
				},
				{
					"id": 726771038,
					"content": "Đúng ha, hình như trong Rừng Chinju không có Liệt Hỏa Hoa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771039
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771039,
					"content": "Kichiboushi muốn có không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771040
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771040,
					"content": "Muốn! Trông ấm lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771041
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726771041,
					"content": "#Vậy thì nhờ vào {NICKNAME} nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771042
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771042,
					"content": "#{NICKNAME}, muốn có nó. Cảm ơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771043
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726771043,
					"content": "...Hình như không có thành ý lắm, hay đây là phong cách nói chuyện của Bake-Danuki vậy nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771021,
					"content": "Bởi vì máy ảnh mắc lắm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726771022
					]
				},
				{
					"id": 726771022,
					"content": "Hả?! Máy ảnh mắc lắm sao? Chúng ta thường ngày hay chiến đấu, bơi lội, leo núi, lại còn té núi nữa, không biết có bị hư không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771023
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771023,
					"content": "Chậc, không ngờ đó, sau này phải cẩn thận mới được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771024
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771006,
					"content": "Giống nguyên tố Phong",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726771007
					]
				},
				{
					"id": 726771008,
					"content": "Kho từ ngữ của Paimon và Kichiboushi phong phú ghê...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726771009
					]
				},
				{
					"id": 726771009,
					"content": "Lợi hại như Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771010
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726771010,
					"content": "#Ờm... hình như ý của {NICKNAME} không phải thế đâu. Nhưng nói chung là... Kichiboushi rất thông minh đó! Hứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771013
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771011,
					"content": "Đúng là rất đặc biệt!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726771012
					]
				},
				{
					"id": 726771012,
					"content": "#Ấy? Kho từ ngữ của {NICKNAME} có phải hơi thiếu thốn không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771013
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
