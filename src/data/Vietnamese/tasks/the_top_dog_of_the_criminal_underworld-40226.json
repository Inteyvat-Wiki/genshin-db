					"content": "Navia và Clorinde đi cùng các bạn đến hội trường triển lãm.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						402260202
					]
				},
				{
					"id": 402260202,
					"content": "Rộng hơn tôi tưởng đấy, nhưng còn ít người quá, chưa đủ nhộn nhịp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260203
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 402260203,
					"content": "Chắc do triển lãm chưa chính thức bắt đầu, xem ra bên Jahoda còn khá nhiều việc cần giúp đỡ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402260204,
					"content": "Vậy bên này cứ để cho tôi và Clorinde lo, đợi khi hai người rảnh rỗi thì hoan nghênh ghé qua trải nghiệm sản phẩm của chúng tôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Navia"
				}
