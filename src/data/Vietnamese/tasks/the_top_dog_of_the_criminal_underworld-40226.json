			"dialogs": [
				{
					"id": 402260101,
					"content": "Soái Hạm... Người của bên tham gia triển lãm chắc đang làm thủ tục nhận phòng nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402260102,
					"content": "Cộng sự! Còn có Paimon nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260103
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 402260103,
					"content": "Là Navia, lâu rồi không gặp!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260104,
						402260105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402260104,
					"content": "Nếu tôi đoán không nhầm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402260106
					]
				},
				{
					"id": 402260106,
					"content": "Đúng vậy, Spina di Rosula cũng là một trong những bên tham gia triển lãm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260107
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 402260107,
					"content": "Ồ... người cầm quyền thế giới ngầm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402260108,
					"content": "Ồ... người cầm quyền thế giới ngầm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402260109,
					"content": "Haha, đó là cách gọi mới dành cho tôi à? Nghe có vẻ ngầu đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260110
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 402260110,
					"content": "Chúng tôi nhận một nhiệm vụ ủy thác, cụ thể là giúp đăng ký người tham gia triển lãm và xác minh hàng hóa trưng bày...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402260111,
					"content": "Vậy à, ngồi xuống nói chuyện đi, tôi vừa gọi một bàn toàn món ngon, Clorinde và Chevreuse để đồ xong cũng sẽ đến. Ồ! Vừa nhắc luôn đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260112
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 402260112,
					"content": "Đang giới thiệu chúng tôi à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260113
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 402260113,
					"content": "Clorinde và Chevreuse cũng đến à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402260114,
					"content": "Nod-Krai trật tự hỗn loạn, vô cùng nguy hiểm, xét đến ý nghĩa của Spina di Rosula đối với Fontaine, tôi không muốn vị hội trưởng đương nhiệm gặp chuyện gì ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260115
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 402260115,
					"content": "Với khả năng của tôi, tôi không thể tưởng tượng được mình có thể gặp chuyện gì, nhưng được đi du lịch cùng bạn bè cũng là chuyện vui mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260116
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 402260116,
					"content": "Nên tôi mới nói cô thong thả quá rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260117
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 402260117,
					"content": "Được rồi, hãy để tôi giới thiệu lại với mọi người, vệ sĩ hiện tại của tôi chính là Đấu Sĩ Đại Diện giỏi nhất toàn Fontaine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260118
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 402260118,
					"content": "Người cầm quyền thế giới ngầm và vệ sĩ của cô ấy... đã đăng ký xong rồi, còn Chevreuse?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402260119,
					"content": "Tôi thì không cần đăng ký đâu, tôi đến đây để xử lý công vụ, gần đây có nhiều vụ án lớn liên quan đến Nod-Krai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260120
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 402260120,
					"content": "Ồ ồ, vậy thì tôi không hỏi nhiều nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402260121,
					"content": "À đúng rồi, hàng hóa mà Spina di Rosula dùng để tham gia triển lãm cũng cần đăng ký nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402260122,
					"content": "Đây, một phát minh mới của Viện Khoa Học Fontaine, là loại hệ thống chuyển tiếp giúp người dùng giải phóng năng lượng Pneuma và Ousia trong chiến đấu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260123
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 402260123,
					"content": "Vậy là... một loại vũ khí à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402260124,
					"content": "Trong một thị trường không bị pháp luật hạn chế, vũ khí đương nhiên là một trong những mặt hàng được săn đón nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260125
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 402260125,
					"content": "Đúng là vậy thật, nhưng nói những chuyện này trước mặt Chevreuse cứ cảm giác hơi kỳ kỳ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402260126,
					"content": "Không sao, tôi đã đọc rất nhiều mô tả về \"vùng ngoài vòng pháp luật\" trong các tiểu thuyết tội phạm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260127
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 402260127,
					"content": "Với tư cách là một thám tử, nếu muốn làm việc ở nơi này, điều quan trọng nhất chính là tạm gác lại những quy tắc thông thường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260128
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 402260128,
					"content": "Vậy thì tôi xin phép đi trước, các đội viên còn đang đợi tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260129
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 402260129,
					"content": "Nếu tiện thì chúng tôi có thể dẫn mọi người đến hội trường nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402260130,
					"content": "Được đó! Vậy chúng ta đi ngay thôi, tôi cũng muốn xem có món nào muốn mua không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Navia"
				},
				{
					"id": 402260105,
					"content": "...Mọi người cũng đến tham gia triển lãm à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402260106
					]
				}
			]
		},
