			"dialogs": [
				{
					"id": 761910201,
					"content": "Ta đã ba lần bốn lượt nhắc nhở phải để mắt kỹ rồi, món hàng cực phẩm này là khách quen từ Snezhnograd chỉ định mua đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910202
					],
					"speakerTitle": "Alhoma"
				},
				{
					"id": 761910202,
					"content": "Cậu thì hay rồi, chuyển qua đây xong đổi tính hay gì? Sao bỗng nhiên lòng tốt trỗi dậy, đi phóng sinh mất vậy hả?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910203
					],
					"speakerTitle": "Alhoma"
				},
				{
					"id": 761910203,
					"content": "Đại ca, hãy nghe em giải thích đã, thật sự không phải lỗi của em, là đám Hilichurl...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910204
					],
					"speakerTitle": "Yelo"
				},
				{
					"id": 761910204,
					"content": "Hilichurl? Vậy mà cũng dám nói nữa à! Uy tín của Đạo Bảo Đoàn chúng ta sắp tan tành trong tay cậu rồi đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910205
					],
					"speakerTitle": "Alhoma"
				},
				{
					"id": 761910205,
					"content": "Nhưng em đánh không lại thật mà đại ca! Bọn chúng tên xanh lam tên xanh lục, ra tay còn dữ dằn hơn Người Xử Lý Nợ nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910206
					],
					"speakerTitle": "Yelo"
				},
				{
					"id": 761910206,
					"content": "(Xem ra hai tên này chính là đám buôn lậu...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910207
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761910207,
					"content": "...Ai đó?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910208
					],
					"speakerTitle": "Alhoma"
				},
				{
					"id": 761910208,
					"content": "Ây da Lumi! Chưa đến lúc xuất hiện đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910209
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761910209,
					"content": "Đây là thứ gì vậy... trông khá hiếm đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910210
					],
					"speakerTitle": "Alhoma"
				},
				{
					"id": 761910210,
					"content": "Này, đứa nhóc như thế chắc là đối phó được chứ? Món này trông cũng được đấy, lấy nó thay thế vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910211
					],
					"speakerTitle": "Alhoma"
				},
				{
					"id": 761910211,
					"content": "Vâng thưa đại ca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910212
					],
					"speakerTitle": "Yelo"
				},
				{
					"id": 761910212,
					"content": "Dám động đến Lumi à! Danh tiếng của Đạo Bảo Đoàn bị những kẻ như các người làm ô uế hết rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910213
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761910213,
					"content": "Ơ, Đạo Bảo Đoàn có danh tiếng gì đâu nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910214
					],
					"speakerTitle": "Yelo"
				},
				{
					"id": 761910214,
					"content": "Đừng có lải nhải với đứa nhóc đó nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alhoma"
				}
			]
		},
