			"dialogs": [
				{
					"id": 761910301,
					"content": "Thật sự là Capybara bạc, không phải nhuộm màu cũng không phải nhìn nhầm. Thật hiếm thấy, không thể tin nổi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910302
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761910302,
					"content": "Trước đây tốn bao công sức tìm ở Natlan mà chẳng thấy đâu, hoá ra là bị đám buôn lậu bắt mất rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910303
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761910303,
					"content": "Nhưng xem ra vẫn còn lành lặn... hihi, Capybara bạc, không ngờ được tận mắt nhìn thấy, để sờ xem loại bạc và loại thường có gì khác nhau không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910304
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761910304,
					"content": "...Nóng quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910305
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761910305,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910306
					],
					"speakerTitle": "Capybara"
				},
				{
					"id": 761910306,
					"content": "Suýt quên mất, ngươi vẫn đang ở trong nồi mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910307
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761910307,
					"content": "Hay là vì đã quen với Phlogiston Thể Lỏng ở Natlan nên nhiệt độ này chẳng là gì đối với ngươi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910308
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761910308,
					"content": "Dù sao thì ngươi cứ theo ta về trước đã nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910309
					],
					"speakerTitle": "Linnea"
				},
