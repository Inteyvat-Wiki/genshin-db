			"dialogs": [
				{
					"id": 735200101,
					"content": "Quý khách đã quyết định mua thông tin tình báo từ chỗ tôi rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200102
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200102,
					"content": "Ừm... Quả thật là tôi có chút tò mò về tình báo độc quyền mà cô nói đó, nhưng tôi phải nghe giá tiền trước đã! Nếu đắt quá thì chúng tôi không mua đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200103,
					"content": "Một giá một, một triệu Mora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200104
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200104,
					"content": "Đắt quá! Thôi bỏ đi! Một triệu Mora có thể mua được rất nhiều món ăn ngon đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200105,
					"content": "Chờ đã, để tôi xem... Ối! Paimon là vị khách thứ 1001 của ngày hôm nay này, nên tin tình báo đặc biệt giá gốc một triệu Mora này có thể lấy đi mà không tốn đồng nào rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200106
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200106,
					"content": "Ơ?! Có cả chuyện tốt vậy sao?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200107,
					"content": "Chờ đã, không phải là cái bẫy đó chứ! Câu trước miễn phí, câu sau là bắt phải mua gì đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200108,
					"content": "Không chịu thì thôi! Vị khách tiếp theo, vị khách tiếp...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200109
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200109,
					"content": "Đừng đừng đừng, coi như tôi sai, chúng tôi nghe mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200110,
					"content": "Thông tin độc quyền thứ nhất của Dori! Quý khách còn nhớ Vương Miện Trí Tuệ không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200111
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200111,
					"content": "Nhớ chứ, nghe nói chỉ có quán quân mới có tư cách đội vương miện đó, hình như là thứ rất quý giá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200112,
					"content": "Không sai, vương miện mà Sachin quyên góp cho Giáo Viện là một món đồ cổ vô cùng đắt đỏ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200113
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200113,
					"content": "Thế nhưng chính chiếc vương miện này, sau khi được quyên góp cho Giáo Viện thì từng bị Giáo Viện làm mất qua một lần!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200114
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200114,
					"content": "Ơ? Sao chúng tôi chưa từng nghe qua vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200115,
					"content": "Haha... Nếu ai cũng biết thì sao gọi là \"tin tức độc quyền\" chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200116
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200116,
					"content": "Đương nhiên, tình báo này không phải khi không mà có đâu, có người chứng kiến đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200117
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200117,
					"content": "Ở khu vực phía nam có một người trẻ tuổi tên là Kashmer, nếu quý khách có hứng thú thì có thể đi hỏi anh ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200118
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200118,
					"content": "Ám hiệu là... \"chuyện hai mươi năm trước\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dori"
				}
			]
		},
