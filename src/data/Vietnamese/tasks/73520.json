			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kashmer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735200203,
					"content": "Chuyện Hai Mươi Năm Trước",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735200204
					]
				},
				{
					"id": 735200204,
					"content": "...Xem ra tôi không nên nói lung tung. Lần trước uống say nói lảm nhảm mấy câu, rồi dạo này lúc nào cũng có người tới hỏi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200205
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200205,
					"content": "Nếu các bạn tò mò thì tôi kể lại vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200206
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200206,
					"content": "Hai mươi năm trước, tôi chỉ là một đứa trẻ sáu tuổi. Tôi không thể nhớ chính xác những gì đã xảy ra vào thời điểm đó. Cách đây một thời gian, tôi đã đọc cuốn nhật ký mà tôi viết khi còn là một đứa trẻ, và mơ hồ nhớ lại những chuyện lúc đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200207
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200207,
					"content": "Năm đó cũng có tổ chức Học Viện Tranh Bá, có tất cả ba vòng đấu, vòng cuối cùng là ở ngoại thành. Tôi năn nỉ mẹ đưa tôi ra ngoại thành xem, mẹ không đồng ý nên tôi đã lẻn đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200208
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200208,
					"content": "Sau đó thì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200209,
					"content": "Sau đó tôi bị lạc ở ngoại thành. Đồng không mông quạnh, không một bóng người. Tôi ngày càng sợ hãi và không kìm được nước mắt khóc òa lên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200210
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200210,
					"content": "Chính lúc đó, tôi đã nhìn thấy những sinh vật kỳ lạ... Tôi không còn nhớ chúng trông như thế nào, chỉ nhớ khi đó tôi nhìn thấy chúng thì không khóc nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200211
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200211,
					"content": "Sinh vật kỳ lạ, lẽ nào là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200212,
					"content": "(Là Aranara chăng.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735200213
					]
				},
				{
					"id": 735200213,
					"content": "Chúng đưa tôi đến nơi thi đấu. Tiếc là khi đến đó thì đã quá muộn, trận đấu đã kết thúc từ lâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200214
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200214,
					"content": "Ngay khi tôi đang chán nản, tôi đột nhiên nhìn thấy một sinh vật kỳ lạ đang kéo chiếc vương miện và bước đi chậm rãi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200215
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200215,
					"content": "Chiếc vương miện đó rất đẹp, tỏa sáng rực rỡ dưới ánh trăng, tôi không thể không nhìn theo nó. Tôi thấy nó giấu chiếc vương miện trong một cái hốc cây và biến mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200216
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200216,
					"content": "Tôi rất muốn được chạm vào chiếc vương miện đó. Nhưng đúng lúc này, giọng nói của mẹ tôi từ xa truyền đến. Hóa ra mẹ thấy tôi đi lạc nên gọi cả làng đi tìm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200217
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200217,
					"content": "Cuối cùng tôi cũng không được chạm vào chiếc vương miện đó. Mãi cho đến khi lớn lên, tôi nhìn thấy \"Vương Miện Trí Tuệ\" ở Học Viện Tranh Bá, mới chợt nhận ra rằng dường như đó là cùng một chiếc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200218
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200218,
					"content": "Được rồi... Anh có nhớ chiếc vương miện đó lần cuối cùng được đặt ở đâu không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200219,
					"content": "Hình như là Rừng Avidya, nhưng sau đó tôi có đi tìm mấy lần, đều không phát hiện ra chút manh mối nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200220
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200220,
					"content": "Cho dù tôi có nói cũng không ai tin. Haiz, ngay cả tôi cũng không nhớ rõ, có thể là lúc nhỏ tôi đã nằm mơ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200221
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200221,
					"content": "#Ừm... {NICKNAME}, chúng ta có cần đi tìm không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7352033,
			"completionStepIds": [],
