			"dialogs": [
				{
					"id": 735200301,
					"content": "Hình như ở đây có một hốc cây, nhưng bên trong trống rỗng, không có gì cả...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200302,
					"content": "Hửm? Đợi đã, hình như bên trong có một tờ giấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200303,
					"content": "\"Nara tốt bụng dạy Arakasyapa đọc chữ, Arakasyapa phải bảo vệ Nara...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200304,
					"content": "Như vậy là có ý gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
