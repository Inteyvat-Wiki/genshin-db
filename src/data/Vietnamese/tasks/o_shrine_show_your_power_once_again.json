			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Shouta"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220280101,
					"content": "#{F#Chị}{M#Anh} hãy nghe em nói!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280102
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280102,
					"content": "Lần trước khi cúng tế cho Miếu Thần, nguyện vọng của em đã được thực hiện...một chút xíu! Nhưng như vậy cũng xem như thần đã đáp lại em rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280103
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280103,
					"content": "Nguyện vọng của em là gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220280104
					]
				},
				{
					"id": 220280104,
					"content": "Nguyện vọng lần trước của em là hy vọng tác giả của bộ truyện tranh em thích có thể vẽ nhanh hơn, ra truyện liên tục cho em xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280105
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280105,
					"content": "Sau đó, vị tác giả đó đúng là ra liên tục hai tập luôn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280106
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280106,
					"content": "Nhưng mà...sau đó nghe nói tác giả đó lại nghỉ liên tục ba kỳ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280107,
						220280108
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280107,
					"content": "Nghe cũng công bằng nhỉ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220280109
					]
				},
				{
					"id": 220280109,
					"content": "Ừm...nhưng dù sao thì thần cũng đã nghe thấy điều ước của em. Có lẽ do em cúng tế chưa đủ thành ý nên chưa thể thực hiện được hết!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280110
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280110,
					"content": "Còn hôm nay, em sẽ dùng hết thành ý để cúng tế cho các Miếu Thờ khác luôn! Như vậy Miếu Thờ chắc chắn sẽ hiển linh để thực hiện điều ước của em.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280111
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280111,
					"content": "Em hỏi qua ba mẹ rồi, ở gần đây có hai Miếu Thờ, một cái ở gần Phòng Trà Komore, một cái ở bên đường phía ngoài thành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280112
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280112,
					"content": "#{F#Chị}{M#Anh} cảm thấy em nên đi ngôi miếu nào trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280108,
					"content": "Tính ra còn bị lỗ một kỳ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220280109
					]
				}
			]
		},
