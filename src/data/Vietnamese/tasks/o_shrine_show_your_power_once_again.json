			"dialogs": [
				{
					"id": 220280501,
					"content": "Là ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280502
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280502,
					"content": "Em nghe nói ngày trước có một ông chú cúng tế rất nhiều hạc giấy cho Miếu Thờ, cầu nguyện bình an cho Hanamizaka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280503
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280503,
					"content": "Về sau ở gần đó xảy ra hỏa hoạn, có một ngôi nhà tự nhiên bị cháy. May mắn sao đám cháy không bị lan ra bên ngoài...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280504
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280504,
					"content": "Mọi người đều nghĩ rằng đây là do thần phù hộ, vì vậy em cũng đã xếp rất nhiều hạc giấy mang đến đây này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280505
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280505,
					"content": "Vậy lần này, chúng ta cúng tế thứ gì sẽ tốt hơn nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280506
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280506,
					"content": "Giống chú kia cúng tế hạc giấy có thể sẽ được thần đáp lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280507
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280507,
					"content": "Nhưng theo em thấy, nếu cúng tế Kenpeito cho Miếu Thờ ở gần Phòng Trà Komore có vẻ như sẽ có thành ý hơn đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280508
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280508,
					"content": "Vả lại em cũng rất thích ăn Kenpeito nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280509
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280509,
					"content": "#{F#Chị}{M#Anh} cảm thấy sao?",
					"roleType": "TALK_ROLE_NPC",
