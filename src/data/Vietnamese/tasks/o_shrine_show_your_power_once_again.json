					"content": "Ngày trước có một ông bác cúng tế Thiết Khoáng Thạch cho Miếu Thờ, hy vọng võ nghệ sẽ được cải thiện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280903
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280903,
					"content": "Sau đó ông bác đó đi tham gia thi đấu, kết quả đã đánh bại hết các đối thủ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280904
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280904,
					"content": "Nhưng mà, theo ông bác đó nói, có vẻ như những đối thủ của bác ấy đều bị vấn đề về sức khỏe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280905,
						220280906
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280905,
					"content": "Không lẽ đây là suy nghĩ của thần ư...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280907
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280907,
					"content": "Nhưng dù sao thì mọi người cũng cảm thấy thần đã hiển linh. Cho nên em thấy cầu nguyện cho Miếu Thờ này có thể sẽ nhận được hồi đáp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280908
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280908,
					"content": "Vậy lần này, chúng ta cúng tế thứ gì sẽ tốt hơn nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280909
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280909,
					"content": "Giống ông bác kia cúng tế Thiết Khoáng Thạch có thể sẽ được thần đáp lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280910
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280910,
					"content": "Em cũng có lấy được vài mẩu thiết khoáng ở chỗ chú thợ rèn, chất lượng của chúng không được tốt nên chú thợ rèn đó tặng em luôn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280911
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280911,
					"content": "Còn nữa, trước đó em có nhặt một số rong biển, em mang về nấu rồi bỏ chút đường vào...là thành một món ăn ngon luôn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280912
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280912,
					"content": "Nhưng mà không biết thần có thích món rau trộn này không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280913
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280913,
					"content": "#{F#Chị}{M#Anh} cảm thấy thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280906,
					"content": "Mọi người đều lùi bước thì xem như bản thân đã tiến bước rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280907
					],
					"speakerTitle": "Shouta"
				}
			]
		},
