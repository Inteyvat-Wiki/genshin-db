					"speakerTitle": "Shouta"
				},
				{
					"id": 220280803,
					"content": "Ngày mai em sẽ đến xem thử xem có gì đặc biệt không!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280804
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280804,
					"content": "#À đúng rồi, cảm ơn {F#chị}{M#anh} đã đi theo em, thứ này em cho {F#chị}{M#anh}",
