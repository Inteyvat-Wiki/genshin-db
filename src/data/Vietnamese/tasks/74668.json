				"points": []
			},
			"dialogs": [
				{
					"id": 746680101,
					"content": "Ồ, có phải vừa rồi Thất Thiên Thần Tượng sáng bừng lên một cái đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680102,
					"content": "Thật kỳ lạ, trước đây từng xảy ra chuyện như vậy à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680103,
						746680105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680103,
					"content": "Thất Thiên Thần Tượng phát sáng là chuyện rất bình thường mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680107
					]
				},
				{
					"id": 746680107,
					"content": "#{NICKNAME} không cảm thấy khó chịu gì đấy chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680108,
						746680110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680108,
					"content": "Hửm? Nước... nước đang nói chuyện với tôi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680109
					]
				},
				{
					"id": 746680109,
					"content": "Vẫn còn tâm trạng nói đùa thế sao? Xem ra là không sao rồi nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680112,
					"content": "Nhưng mà sau khi ánh sáng phát ra thì không khí xung quanh cũng trở nên hơi ẩm ướt. Có lẽ nguyên nhân chính là do sức mạnh nguyên tố Thủy tỏa ra vừa rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680113,
					"content": "Hihi, nghe nói ở Fontaine nếu như có thể vận dụng tốt sức mạnh nguyên tố thì có thể lặn dưới nước, không chừng còn nhặt được kho báu dưới nước nữa đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680114,
					"content": "Giao cho bạn công việc vớt kho báu đấy, tôi... tôi phụ trách canh chừng trên bờ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680115,
						746680116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680115,
					"content": "Xuống nước một mình thì cô đơn lắm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680117
					]
				},
				{
					"id": 746680117,
					"content": "À ừm, nhưng... nhưng mà nước đáng sợ lắm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680118,
					"content": "Không chừng nếu sơ ý là sẽ bị cuốn trôi, không thể bay lên nổi luôn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680119,
					"content": "Giống như hồi trước gặp bạn ở Mondstadt vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680120,
					"content": "Vậy thì tôi sẽ kéo Paimon lên!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680121
					]
				},
				{
					"id": 746680121,
					"content": "Thật không? Vậy... vậy thì tôi đành xuống nước chung vậy. Nhưng nói là phải giữ lời đấy nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680116,
					"content": "Paimon có thể góp sức!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680117
					]
				},
				{
					"id": 746680110,
					"content": "Woa, tôi thấy như có thể dùng mang để hô hấp đây này...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680111
					]
				},
				{
					"id": 746680111,
					"content": "Tốt lắm, vậy mọc ra cái mang trước xem nào. Hừ, còn tâm trạng nói đùa thì xem ra là không sao rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680105,
					"content": "Hình như có nước toát ra đúng không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680106
					]
				},
				{
					"id": 746680106,
					"content": "Không hổ danh là quốc gia của Thủy Thần, đến cả Thất Thiên Thần Tượng cũng toát ra nước... Mà thứ ánh sáng vừa rồi không bình thường cho lắm nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680107
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}