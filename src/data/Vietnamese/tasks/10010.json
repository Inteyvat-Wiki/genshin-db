					"nextDialogs": [
						100100815
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 100100815,
					"content": "#{F#Chị}{M#Anh} Kỵ Sĩ Danh Dự, Paimon ơi, bây giờ Klee đang cần sự giúp đỡ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100816
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100816,
					"content": "À, tôi có thể làm chứng! Chúng tôi đã cùng Klee tiêu diệt đám Hilichurl và cả Slime tụ tập. Hơn nữa, chúng tôi đến đây là để hoàn thành \"bài tập\" đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100817
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100817,
					"content": "Paimon nói đúng đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100818
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100818,
					"content": "Vậy lũ cá ở đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100819
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 100100819,
					"content": "Ban nãy lúc đối phó với đám xấu xa ở hồ, Klee đã vô tình làm nổ tung... Nhưng mà khác hẳn với trước đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100820
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100820,
					"content": "Vậy là, lúc trước cố tình cho nổ đúng không?",
