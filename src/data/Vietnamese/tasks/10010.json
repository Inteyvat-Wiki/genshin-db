			"dialogs": [
				{
					"id": 100100101,
					"content": "Hmm... Dodoco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100102
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100102,
					"content": "Hmm, Klee kìa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100103,
					"content": "#{M#Anh}{F#Chị} Kỵ Sĩ Danh Dự! Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100104
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100104,
					"content": "#Mẹ nói là {F#chị}{M#anh} Kỵ Sĩ Danh Dự và Paimon sẽ cùng Klee giúp đỡ Dodoco, không ngờ là hai người đến nhanh như vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100105
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100105,
					"content": "Giúp đỡ Dodoco?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100106,
					"content": "...Thì ra đây là \"bài tập\" của Klee sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100107,
					"content": "#Hửm? {F#Hai chị}{M#Anh chị} muốn đi \"đập\" ai sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100108
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100108,
					"content": "À, chị không có ý định đi đập ai đâu. Klee biết mà đúng không, ý chị là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100109,
						100100113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100109,
					"content": "Là đi làm bài tập.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100100110
					]
				},
				{
					"id": 100100110,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100111
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100111,
					"content": "...Cảm ơn vì đã giải thích giùm nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100112,
					"content": "Ừm... Bài tập chính là, hmm, khó giải thích trực tiếp lắm. Tóm lại, \"bài tập\" chính là việc Klee muốn làm, và phải giúp Dodoco hoàn thành!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100119,
					"content": "Ồ, cảm ơn Paimon nhé! Tuy Klee không rõ lắm, nhưng hình như cũng hiểu được một chút rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100120
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100120,
					"content": "Vậy chúng ta lên đường thôi, đi giúp Dodoco nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100121
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100121,
					"content": "Khoan đã! Klee, em nói là muốn giúp Dodoco, vậy cụ thể là định làm gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100122,
					"content": "Ừm, mỗi Dodoco đều phải tìm được cỏ bốn lá màu đỏ, như vậy mới có thể trở thành một Dodoco khác biệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100123
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100123,
					"content": "Sau đó... Dodoco phải kết bạn với thật nhiều người, trải qua thử thách của \"Đại Ma Vương Dodo\", mới có thể trở thành...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100124
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100124,
					"content": "\"Đại Pháp Sư Dodo\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100125
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100125,
					"content": "...Ít nhất thì mẹ đã nói như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100126
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100126,
					"content": "Ồ, Đại Ma Vương quản chế Đại Pháp Sư... nghe cũng hợp lý đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100127,
					"content": "Vậy cụ thể chúng ta phải làm gì đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100128,
					"content": "Klee không biết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100129
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100129,
					"content": "#Nhưng mẹ bảo là {F#chị}{M#anh} Kỵ Sĩ Danh Dự và Paimon sẽ nói cho Klee biết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100130
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100130,
					"content": "Đúng, đúng rồi! Klee, xem cuốn sách này đi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100131,
					"content": "A, bên trong có một mẩu giấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100132
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100132,
					"content": "Vậy chúng ta cùng xem thử nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100133,
					"content": "\"...Điểm đầu tiên của thử thách, Dodoco đã đến khu rừng nơi lá cây thì thầm. Tại đó, phải tìm ra bí mật được chôn giấu, dưới vô vàn chướng ngại...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100134,
					"content": "Nghe giống như một phần câu chuyện về Dodoco vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100135,
					"content": "A, Klee biết nó ở đâu rồi! Chắc chắn là trong khu rừng nơi Klee thường cho nổ... à, thường chơi đùa với Dodoco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100136
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100136,
					"content": "#Klee, Dodoco, {M#anh}{F#chị} Kỵ Sĩ Danh Dự, Paimon, xuất phát nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100137
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100137,
					"content": "Được rồi! Xuất phát!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100113,
					"content": "Là có việc cần phải làm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100100114
					]
				},
				{
					"id": 100100114,
					"content": "Đúng vậy, là việc cần hoàn thành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100115,
					"content": "Ồ, vậy... việc Klee dùng bom nảy để đánh cá cũng là \"bài tập\" sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100116
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100116,
					"content": "Không, chắc không phải đâu! Đâu phải việc gì cũng được coi là \"bài tập\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100117,
					"content": "Klee không hiểu lắm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100118
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100118,
					"content": "Hmm, nói chung là theo lời Alice, bài tập chính là việc mà Klee phải hoàn thành!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100119
					],
					"speakerTitle": "Paimon"
				}
			]
		},
