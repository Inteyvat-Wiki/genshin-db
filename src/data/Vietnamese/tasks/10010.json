					"content": "Ưm, không có.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100308
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100308,
					"content": "Ah... Vậy phải làm sao đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100309,
					"content": "Hmm... Mẹ từng nói là, khi gặp khó khăn thì phải giải quyết nó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100310
