					"nextDialogs": [
						100100807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100807,
					"content": "Là mũ cho Dodoco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100808
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100808,
					"content": "Trong cộng đồng Dodoco, chỉ những Dodoco đặc biệt và lợi hại hơn người mới được Đại Ma Vương Dodo công nhận!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100809
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100809,
					"content": "Những Dodoco lợi hại này có trách nhiệm giúp đỡ và bảo vệ những Dodoco khác, vì thế nên Đại Ma Vương Dodo đã ban cho họ những chiếc mũ đặc biệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100810
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100810,
					"content": "Nhờ vậy, những Dodoco khác có thể nhận ra và tìm đến họ để nhờ giúp đỡ khi gặp khó khăn không thể tự giải quyết.",
