						100100507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100507,
					"content": "Nếu đội trưởng Jean đồng ý cho Klee nổ tung phòng giam thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100508
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100508,
					"content": "Ai lại dùng cách này chứ! À đúng rồi, thí luyện của Dodoco thì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100509,
					"content": "À, Klee tìm thấy rồi, nó nằm trong cái hố bom đã nổ lúc nãy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100510
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100510,
					"content": "Là một mảnh giấy mới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100511,
					"content": "Ừm, đây là chữ viết của mẹ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100512
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100512,
					"content": "\"Dodoco đã cho nổ tung tất cả chướng ngại chưa nhỉ? Đôi khi, cách thức trực tiếp lại là cách thức giàu tính thẩm mỹ nhất đấy. Sau đó, Dodoco đã đến địa điểm thử thách thứ hai...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100513,
					"content": "\"Thực ra đây cũng là điểm cuối rồi. Dù là một đứa trẻ năng động đến mấy, thì cũng phải biết kiểm soát thời gian hoạt động mỗi ngày, vậy thì...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100514,
					"content": "\"Bên bờ hồ nơi những vì sao rơi xuống, Dodoco đã vượt qua thử thách và nhận được phần thưởng cuối cùng. Nhưng liệu mọi chuyện có thực sự đơn giản như vậy không...?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100515,
					"content": "Nói đến sao và hồ thì chắc chắn là Hồ Sao Rơi rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100516,
					"content": "Vậy chúng ta ra bờ hồ xem thử đi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100517,
					"content": "Được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100518
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100518,
					"content": "Thật tò mò không biết phần thưởng cuối cùng là gì, biết đâu lại là một kho báu lợi hại đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
