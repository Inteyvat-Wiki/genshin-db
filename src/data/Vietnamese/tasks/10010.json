				},
				{
					"id": 100100303,
					"content": "Ừm, thì ra đây chính là \"vô vạn chướng ngại\" trong thử thách!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100304
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100304,
					"content": "Tuy nghe gần giống nhau, nhưng là \"vô vàn chướng ngại\" mới đúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100305,
					"content": "Tuy nhiên, theo gợi ý trong mảnh giấy, thứ chúng ta cần tìm hẳn là nằm dưới những chướng ngại này... Có manh mối nào khác không nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100306,
					"content": "Sao lúc này không có thứ gì đại loại như \"chỉ dẫn của Dodoco\" nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
