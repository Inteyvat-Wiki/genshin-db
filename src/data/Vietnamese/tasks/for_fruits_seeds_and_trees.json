			"dialogs": [
				{
					"id": 730350401,
					"content": "Phần giữa Cây Ashvattha dường như đang phát sáng... Đó có phải là Bija không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350402,
					"content": "Ây da, đúng là không dễ dàng chút nào, những thứ này cuối cùng cũng có thể giúp Rana hồi phục rồi này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350403,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350404
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350404,
					"content": "Hở?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350405,
						730350406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350405,
					"content": "Arama, bạn...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350407
					]
				},
				{
					"id": 730350407,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350408
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350408,
					"content": "Cây Ashvattha đã bị Marana gặm nhấm, không thể kết ra Bija nữa. Vì vậy chúng ta phải trồng Cây Ashvattha mới, vậy thì mới có thể giúp được các bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350409
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350409,
					"content": "Thế nhưng... Trồng cây không phải sẽ tốn rất, rất nhiều thời gian sao? Từ hạt giống thành một cái cây lớn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350410,
					"content": "Đừng lo lắng, tốc độ sinh trưởng của Cây Vasara có liên quan đến hạt giống. Cây Ashvattha đã giao hết tất cả sức mạnh cho tôi, cộng thêm ký ức chung của chúng ta và Quả Vasoma, sẽ ổn cả thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350411
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350411,
					"content": "Cám ơn bạn, Cây Ashvattha đầu tiên. Cám ơn các bạn, Araji, Arayama, Aramaha, tôi sẽ tận dụng ký ức mà các bạn để lại thật tốt, để Cây Ashvattha mới có thể kết nối lại con đường của những giấc mơ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350412
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350412,
					"content": "Cảm giác dường như Arama đã thay đổi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350413,
					"content": "Vậy sao? Tôi đã biết rất nhiều việc, học được rất nhiều từ, có được rất nhiều ký ức.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350414
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350414,
					"content": "Nhưng đừng lo. Tôi vẫn là tôi, các bạn vẫn là bạn của tôi. Tôi nhất định sẽ giúp các bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350415,
						730350416,
						730350417
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350415,
					"content": "Bija đó...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350419
					]
				},
				{
					"id": 730350419,
					"content": "Ở nơi sâu cùng trong Thánh Điện Ashvattha đã phong ấn Vanarana Xưa, hóa thân của Marana cũng ở trong đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350420
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350420,
					"content": "Nó sẽ không ngừng rót nọc rắn vào đất đai, vào Sarva, cho đến khi tất cả những thứ màu xanh úa tàn, tất cả các bông hoa đều khô héo, nước suối sẽ tỏa ra mùi hôi thối. Cho đến khi vạn vật chết đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350421
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350421,
					"content": "Chúng ta phải phá hủy nó. Chỉ có như vậy mới có thể trồng ra cái cây mạnh mẽ, kết thành Bija.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350416,
					"content": "Tôi tin vào bạn. Tiếp theo phải làm gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350419
					]
				},
				{
					"id": 730350417,
					"content": "Tôi hiểu rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350418
					]
				},
				{
					"id": 730350418,
					"content": "#Nara {NICKNAME} hiểu là được. Vậy thì không còn vấn đề gì nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350419
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350406,
					"content": "Chuyện gì đã xảy ra?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350407
					]
