			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Arama"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730350101,
					"content": "Arama!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350102,
					"content": "#Ừm! Nara {NICKNAME} và Paimon luôn tràn đầy năng lượng. Tựa như những quả Đào Zaytun đẫm sương sớm. Nhưng trông Paimon không vui. Gặp ác mộng rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350103
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350103,
					"content": "Tôi đã rất lo lắng, nghĩ rằng bạn đã bỏ chúng tôi đi mất...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350104,
					"content": "Gì cơ? Paimon thật kỳ lạ, tôi vẫn luôn ở đây mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350105,
						730350114
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350105,
					"content": "Paimon sao thế?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350106
					]
				},
				{
					"id": 730350106,
					"content": "Vì, vì Vanarana ở trong mộng cảnh, hơn nữa Lễ Hội Utsava còn vui đến thế, giống như đang nằm mơ vậy! Vì thế, tôi sợ đây thật sự chỉ là mơ, một khi tỉnh lại sẽ mất hết...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350107,
					"content": "#Chỉ còn lại tôi và {NICKNAME}, giống như khi chuyến đi vừa bắt đầu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350108,
					"content": "Nhưng, những điều trong mơ đều là thật cả. Tôi đã quan sát Nara. Ác mộng sẽ khiến Nara trở nên nhát gan, còn mộng đẹp có thể khiến Nara hạnh phúc giống như những điều ngoài giấc mơ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350109
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350109,
					"content": "Vì vậy dù Paimon có mơ thấy chúng tôi, mơ thấy Vanarana, cũng giống như thật sự đã gặp được chúng tôi, thật sự đã đến được Vanarana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350110,
						730350112
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350110,
					"content": "Hơn nữa Arama cũng ở đây mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350111
					]
				},
				{
					"id": 730350111,
					"content": "Đúng vậy! Tôi sẽ đợi bạn ở đây, khởi hành thôi nào, cùng đi đến Thánh Điện Ashvattha, như vậy mới có thể lấy được Bija, để Narana trở nên tốt hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350116
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350116,
					"content": "#...Ừm, nói đúng lắm. Hừm, chắc chắn là {NICKNAME} đã cho vài loại nấm kỳ lạ vào bữa tiệc ở Lễ Hội Utsava, nên tôi mới nghĩ đến những thứ này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350117,
					"content": "Chúng ta đi thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350112,
					"content": "Hơn nữa chúng ta còn phải giúp Rana.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350113
					]
				},
				{
					"id": 730350113,
					"content": "Ừm! Chúng ta xuất phát thôi nào, cùng đi đến Thánh Điện Ashvattha, như vậy mới có thể lấy được Bija, để Narana trở nên tốt hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350116
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350114,
					"content": "Đừng suy nghĩ nhiều, chúng ta đi thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350115
					]
				},
				{
					"id": 730350115,
					"content": "Ừm! Chúng ta đến Thánh Điện Ashvattha, lấy được Bija, thì có thể giúp Narana khoẻ lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350116
					],
					"speakerTitle": "Arama"
				}
			]
		},
		{
			"id": 7303502,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7303509",
							"2"
						],
						"stepId": 7303509,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"302821",
							"0"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arama",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730350201,
					"content": "#Nơi này không bị Marana gặm nhấm như chỗ Arayama, đúng là quá tốt. Nara {NICKNAME}, Paimon, đây là Cây Ashvattha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350202
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350202,
					"content": "Wow... Một cái cây thật kì lạ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350203,
					"content": "Paimon thật vô lễ! Cây Ashvattha sẽ tức giận đấy. Đây là một cái cây cực kì cực kì lợi hại đấy, cũng là Cây Vasara già nhất, già hơn tất cả Aranara và tất cả những câu chuyện của Aranara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350204
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350204,
					"content": "Mấy nghìn, hoặc có lẽ là nhiều hơn nữa số lần trăng mọc trước đó, Nữ Hoàng Aranyani đã hát vang ở đây. Khi đó cô ấy chỉ vừa mới rời khỏi Valuka, rừng vẫn chưa rậm rạp như bây giờ, mặt đất còn có rất nhiều cát.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350205
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350205,
					"content": "Ararakalari của cô ấy mạnh hơn tất cả các Aranara, vì bài hát của cô ấy gần giống với \"Bài Ca Cội Nguồn\" hơn. Vì vậy từ trong Sarva, Cây Ashvattha đã đáp lại lời kêu gọi của cô ấy mà mọc ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350206
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350206,
					"content": "Nữ Hoàng Aranyani nói với Cây Ashvattha, trong rừng sâu có rất nhiều Nara, họ rất thông minh, rất xinh đẹp, nhưng cũng rất cô đơn. Vì thế nếu muốn tăng cư dân trong rừng sâu thì phải kết bạn với họ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350207
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350207,
					"content": "Thế là Cây Ashvattha đã sinh ra một quả lựu vừa đẹp vừa đầy đặn. Trong quả lựu có rất nhiều hạt giống, và hạt giống đầu tiên mọc lên là Aramuhukunda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350208
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350208,
					"content": "Thế nên Aramuhukunda chính là Aranara đầu tiên, sau này tất cả hạt giống đều lớn lên, Aranara cũng nhiều như lá cây trên đại thụ. Chúng tôi và Nara đều là cư dân của rừng sâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350209
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350209,
					"content": "Vì vậy Cây Ashvattha rất lợi hại, rất quan trọng! Giống như việc Nara sinh em bé vậy, tất cả các Aranara đều là con của Cây Ashvattha, con của Nữ Hoàng Aranyani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350210
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350210,
					"content": "Vậy à... Xin lỗi nhé, Arama. Cây Ashvattha lợi hại thật đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350211,
						730350213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350211,
					"content": "Paimon nói mẹ của người khác kỳ lạ, đúng là vô lễ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350212
					]
				},
				{
					"id": 730350212,
					"content": "Ý tôi không phải vậy! Khụ khụ, kệ nó đi, Bija thì phải làm sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350214,
					"content": "Ừm. Giống như đất và mưa đều là những thứ cần thiết cho việc cành lá tươi tốt, đơm hoa kết trái, thì giấc mơ và ký ức cũng có thể nuôi dưỡng Cây Vasara. Hồi nãy tôi đã nói, Cây Ashvattha là Cây Vasara già nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350215
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350215,
					"content": "Thế nên bọn tôi mang đến ba Quả Vasoma của Araji, Arayama, Aramaha, muốn dâng chúng cho Cây Ashvattha. Như vậy, Cây Ashvattha có thể tích lũy sức mạnh kết ra trái vĩ đại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350216
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350216,
					"content": "Quả Vasoma của Araji, Arayama, Aramaha? Không phải Cây Vasara sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350217,
					"content": "Ừm, là Cây Vasara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350218
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350218,
					"content": "#Nara {NICKNAME}, hãy lại gần hơn, tiến gần hơn đến Cây Ashvattha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350219
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350219,
					"content": "Wow...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350220,
						730350221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350220,
					"content": "Thật thần kỳ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350222
					]
				},
				{
					"id": 730350222,
					"content": "Ừm. Tất cả các Aranara đều là con của cây này. Bạn đã gắn liền với tất cả các Aranara, mang theo tất cả những lời chúc phúc của Aranara, thế nên Cây Ashvattha cũng chúc phúc cho bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350223
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350223,
					"content": "Chỉ cần bạn đội vòng hoa, Cây Ashvattha sẽ công nhận bạn là con của rừng sâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350224
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350224,
					"content": "Ừm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350225
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350225,
					"content": "Tình trạng của Cây Ashvattha có chút bất ổn... Cảm thấy có hơi suy yếu. Có lẽ liên quan đến việc dạo gần đây Marana đang mọc khắp nơi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350226
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350226,
					"content": "Ừm. Dù thế nào thì tiếp theo chúng ta cũng phải vào giấc mơ của Cây Ashvattha, dâng Quả Vasoma cho Cây Mơ Mộng. Như vậy thì nó cũng sẽ hồi phục.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350227
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350227,
					"content": "#Sau đó sẽ giống như Sảnh Ashvattha trước đó đúng không? {NICKNAME} đưa tay ra, sau đó chúng ta \"xèo xèo\" một phát là đến được giấc mơ thần kỳ rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350228,
					"content": "#Ừm! Paimon thông minh. Nara {NICKNAME}, nếu bạn đã sẵn sàng thì cứ như trước đây, đưa tay ra, tiến vào giấc mơ của Cây Ashvattha nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350229,
						730350234
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350229,
					"content": "Không thành vấn đề.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350230
					]
				},
				{
					"id": 730350230,
					"content": "#Vừa rồi Arama cũng nhắc đến chuyện Marana, không biết chuyện gì sẽ xảy ra trong mơ! Nhưng đã có {NICKNAME} ở đây nên chắc chắn sẽ không có vấn đề gì!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350231,
						730350232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350231,
					"content": "(Đưa tay về phía Cây Ashvattha...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 730350232,
					"content": "Hay là chuẩn bị thêm tí nữa đi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350233
					]
				},
				{
					"id": 730350233,
					"content": "Ừm. Nếu chuẩn bị xong thì hãy nói với tôi. Tôi sẽ đi cùng các bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350234,
					"content": "Tôi phải chuẩn bị một chút...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350235
					]
				},
				{
					"id": 730350235,
					"content": "Ừm. Nếu chuẩn bị xong thì hãy nói với tôi. Tôi sẽ đi cùng các bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350221,
					"content": "Thật ảo diệu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350222
