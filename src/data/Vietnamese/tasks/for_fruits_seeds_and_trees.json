						],
						"stepId": 7303515,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Arama"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730350901,
					"content": "Cuối cùng cũng giải quyết xong... Nói vậy, lúc trước trong mộng cảnh Cây Vasara, cũng thấy được cái cây thần kỳ này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350902,
					"content": "#Xin lỗi, Nara {NICKNAME}. Xin lỗi Paimon. Tôi hoàn toàn không phát hiện ra giấc mơ của Cây Ashvattha đã bị Marana ăn mòn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350903
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350903,
					"content": "Vô số con sâu màu đen đang ăn mòn rễ của Cây Mơ Mộng ở Sarva. Dù đang mơ cũng có thể cảm nhận được bàn tay Marana đang khuấy đảo giấc mơ này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350904
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350904,
					"content": "Xin lỗi, lúc trước khi nhìn thấy Marana ở Sảnh Ashvattha, lẽ ra tôi phải biết rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350905
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350905,
					"content": "#Không sao cả! Bạn xem, có {NICKNAME} đây rồi, chẳng phải đều giải quyết nhẹ nhàng sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350906,
						730350907,
						730350909
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350906,
					"content": "Bija đó...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350912
					]
				},
				{
					"id": 730350912,
					"content": "#Có Quả Vasoma, ít nhiều chắc cũng giúp khôi phục được một ít năng lượng. Nara {NICKNAME}, nhờ bạn đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350913
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350913,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350914
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350914,
					"content": "Ừ tôi hiểu. Tuy không ngờ sẽ nhanh như vậy, nhưng tôi biết, vào lúc cần, sẽ biết phải làm gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350915
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350915,
					"content": "Giống như những đám mây sẽ hiểu được những hạt mưa rơi, nước mưa sẽ biết mình phải thấm vào mặt đất. Hạt giống biết mình phải lớn lên, trở thành cây to, đơm hoa kết trái.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350916
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350916,
					"content": "Arama nhìn có vẻ kỳ lạ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350917
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350917,
					"content": "Ừ, tôi đang nói chuyện với Cây Mơ Mộng. Hóa ra các bạn không nghe được à!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350918
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350918,
					"content": "Tuy lúc trước từng thấy Aranakin nói chuyện với Nấm... nhưng bình thường, con người không nói chuyện được với thực vật!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350919
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350919,
					"content": "Hóa ra là vậy! Tôi học được thêm kiến thức mới rồi. Cảm ơn Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350920
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350920,
					"content": "#Chuyện về Bija, Nara {NICKNAME}, Paimon, đừng lo. Chúng ta ra khỏi giấc mơ này đã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350907,
					"content": "Chuyện nhỏ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350908
					]
				},
				{
					"id": 730350908,
					"content": "Ừm... nhưng, cái này không ảnh hưởng gì đến Bija sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350912
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350909,
					"content": "Cũng không nhẹ nhàng như bạn nói...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350910
					]
				},
				{
					"id": 730350910,
					"content": "Dù sao cũng nhờ có bạn, nói thế nào thì bạn cũng đã giải quyết!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350911
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350911,
					"content": "Ừm... nhưng, cái này không ảnh hưởng gì đến Bija sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350912
					],
					"speakerTitle": "Paimon"
				}
			]
