			"dialogs": [
				{
					"id": 730350201,
					"content": "#Nơi này không bị Marana gặm nhấm như chỗ Arayama, đúng là quá tốt. Nara {NICKNAME}, Paimon, đây là Cây Ashvattha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350202
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350202,
					"content": "Wow... Một cái cây thật kì lạ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350203,
					"content": "Paimon thật vô lễ! Cây Ashvattha sẽ tức giận đấy. Đây là một cái cây cực kì cực kì lợi hại đấy, cũng là Cây Vasara già nhất, già hơn tất cả Aranara và tất cả những câu chuyện của Aranara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350204
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350604,
					"content": "Hàng ngàn, hay là nhiều mặt trăng trước đây, chúa tể của muôn loài cỏ cây đã hát ở đây. Khi đó, cô vừa rời khỏi Valuka, rừng vẫn chưa rậm rạp như bây giờ, trên mặt đất vẫn còn rất nhiều cát.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350605
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350205,
					"content": "Ararakalari của cô ấy mạnh hơn tất cả các Aranara, vì bài hát của cô ấy gần giống với \"Bài Ca Cội Nguồn\" hơn. Vì vậy từ trong Sarva, Cây Ashvattha đã đáp lại lời kêu gọi của cô ấy mà mọc ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350206
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350606,
					"content": "Cô nói với Cây Ashvattha rằng, trong rừng có rất nhiều Nara, họ rất thông minh, rất xinh đẹp, nhưng cũng rất cô đơn. Vì vậy, muốn tăng thêm cư dân cho khu rừng thì hãy kết bạn với họ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350607
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350207,
					"content": "Thế là Cây Ashvattha đã sinh ra một quả lựu vừa đẹp vừa đầy đặn. Trong quả lựu có rất nhiều hạt giống, và hạt giống đầu tiên mọc lên là Aramuhukunda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350208
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350208,
					"content": "Thế nên Aramuhukunda chính là Aranara đầu tiên, sau này tất cả hạt giống đều lớn lên, Aranara cũng nhiều như lá cây trên đại thụ. Chúng tôi và Nara đều là cư dân của rừng sâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350209
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350609,
					"content": "Vậy nên, Cây Ashvattha rất lợi hại, và cũng rất quan trọng! Giống như Nara sẽ sinh ra những Nara nhỏ vậy, tất cả Aranara đều là con của Cây Ashvattha, con của Thảo Thần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350610
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350210,
					"content": "Vậy à... Xin lỗi nhé, Arama. Cây Ashvattha lợi hại thật đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350211,
						730350213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350211,
					"content": "Paimon nói mẹ của người khác kỳ lạ, đúng là vô lễ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350212
					]
				},
				{
					"id": 730350213,
					"content": "Về Bija...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350214
					]
				},
				{
					"id": 730350212,
					"content": "Ý tôi không phải vậy! Khụ khụ, kệ nó đi, Bija thì phải làm sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350214,
					"content": "Ừm. Giống như đất và mưa đều là những thứ cần thiết cho việc cành lá tươi tốt, đơm hoa kết trái, thì giấc mơ và ký ức cũng có thể nuôi dưỡng Cây Vasara. Hồi nãy tôi đã nói, Cây Ashvattha là Cây Vasara già nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350215
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350215,
					"content": "Thế nên bọn tôi mang đến ba Quả Vasoma của Araji, Arayama, Aramaha, muốn dâng chúng cho Cây Ashvattha. Như vậy, Cây Ashvattha có thể tích lũy sức mạnh kết ra trái vĩ đại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350216
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350216,
					"content": "Quả Vasoma của Araji, Arayama, Aramaha? Không phải Cây Vasara sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350217,
					"content": "Ừm, là Cây Vasara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350218
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350218,
					"content": "#Nara {NICKNAME}, hãy lại gần hơn, tiến gần hơn đến Cây Ashvattha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350219
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350219,
					"content": "Wow...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350220,
						730350221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350220,
					"content": "Thật thần kỳ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350222
					]
				},
				{
					"id": 730350221,
					"content": "Thật ảo diệu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350222
					]
				},
				{
					"id": 730350222,
					"content": "Ừm. Tất cả các Aranara đều là con của cây này. Bạn đã gắn liền với tất cả các Aranara, mang theo tất cả những lời chúc phúc của Aranara, thế nên Cây Ashvattha cũng chúc phúc cho bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350223
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350223,
					"content": "Chỉ cần bạn đội vòng hoa, Cây Ashvattha sẽ công nhận bạn là con của rừng sâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350224
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350224,
					"content": "Ừm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350225
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350225,
					"content": "Tình trạng của Cây Ashvattha có chút bất ổn... Cảm thấy có hơi suy yếu. Có lẽ liên quan đến việc dạo gần đây Marana đang mọc khắp nơi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350226
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350226,
					"content": "Ừm. Dù thế nào thì tiếp theo chúng ta cũng phải vào giấc mơ của Cây Ashvattha, dâng Quả Vasoma cho Cây Mơ Mộng. Như vậy thì nó cũng sẽ hồi phục.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350227
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350227,
					"content": "#Sau đó sẽ giống như Sảnh Ashvattha trước đó đúng không? {NICKNAME} đưa tay ra, sau đó chúng ta \"xèo xèo\" một phát là đến được giấc mơ thần kỳ rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350228,
					"content": "#Ừm! Paimon thông minh. Nara {NICKNAME}, nếu bạn đã sẵn sàng thì cứ như trước đây, đưa tay ra, tiến vào giấc mơ của Cây Ashvattha nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350229,
						730350234
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350229,
					"content": "Không thành vấn đề.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350230
					]
				},
				{
					"id": 730350234,
					"content": "Tôi phải chuẩn bị một chút...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350235
					]
				},
				{
					"id": 730350230,
					"content": "#Vừa rồi Arama cũng nhắc đến chuyện Marana, không biết chuyện gì sẽ xảy ra trong mơ! Nhưng đã có {NICKNAME} ở đây nên chắc chắn sẽ không có vấn đề gì!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350231,
						730350232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350231,
					"content": "(Đưa tay về phía Cây Ashvattha...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 730350232,
					"content": "Hay là chuẩn bị thêm tí nữa đi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350233
					]
				},
				{
					"id": 730350233,
					"content": "Ừm. Nếu chuẩn bị xong thì hãy nói với tôi. Tôi sẽ đi cùng các bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350235,
					"content": "Ừm. Nếu chuẩn bị xong thì hãy nói với tôi. Tôi sẽ đi cùng các bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arama"
				}
			]
		},
		{
			"id": 7303509,
			"completionStepIds": [
				7303515
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7303515",
