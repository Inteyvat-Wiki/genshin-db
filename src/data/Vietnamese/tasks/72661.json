				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nantuck",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726610101,
					"content": "Ồ người câu cá trẻ tuổi, thật mừng khi gặp được bạn. Sao vậy, gặp rắc rối gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610102
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610102,
					"content": "Tôi là người hướng dẫn câu cá của bạn, có chuyện gì nói cho tôi nghe nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610103
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610103,
					"content": "Không ngờ là \"Ánh Trăng Biển\" à, Kujirai vẫn chấp nhất chuyện đó, cũng khó trách, dù sao tâm nguyện của cô ấy cũng là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610104
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610104,
					"content": "Haiz, cô ấy mà biết được sự thật về Ánh Trăng Biển, nhất định sẽ rất thất vọng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610105
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610105,
					"content": "Sự thật gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726610106
					]
				},
				{
					"id": 726610106,
					"content": "Thật ra năm xưa sau khi trở về, tôi đã không ngừng điều tra về Ánh Trăng Biển, sau đó cuối cùng đã tìm được manh mối trong một quyển sách cổ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610107
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610107,
					"content": "Dựa theo những manh mối đó, tôi đã đến nơi đó nghiên cứu, cuối cùng đã phát hiện điều bất ngờ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610108
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610108,
					"content": "Tôi đã đem những điều phát hiện được viết vào trong tác phẩm của tôi, gần đây dường như lượng tiêu thụ cũng khá tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610109
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610109,
					"content": "Đúng lúc có quyển tặng phẩm do biên tập để lại, mọi người hãy xem, toàn bộ sự thật về Ánh Trăng Biển đều ở trong đó rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610110
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610110,
					"content": "Tôi cũng muốn xem, để tôi xem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726610111,
					"content": "\"Sự thật về Ánh Trăng Biển thực chất là rùa biển\"...tên sách dài thật...Hả?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726610112,
					"content": "Rùa biển? Ánh Trăng Biển là rùa biển?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726610113,
					"content": "Đúng vậy, Ánh Trăng Biển chính là một con rùa biển.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610114
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610114,
					"content": "Vào buổi tối năm đó chúng tôi thấy được một con rùa biển trên lưng mọc đầy loại thực vật phát sáng giống như Tiểu Đăng Thảo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610115
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610115,
					"content": "Nó đang mang thai và đang lên bờ để đẻ trứng, do đó chúng tôi mới tìm được đường về nhà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610116
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610116,
					"content": "Cho nên hãy quay về nói với Kujirai những gì tôi đã nói. Dù sao đi nữa, con người vẫn phải đối diện với hiện thực.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610117
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610117,
					"content": "Nhưng mà, tuy là nói vậy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726610118
					]
				},
				{
					"id": 726610118,
					"content": "Xem ra bạn vẫn còn chưa tin ư? Nhưng nghiên cứu của tôi là có chứng cứ đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610119
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610119,
					"content": "Trong quyển sách cổ có đề cập đến, Ánh Trăng Biển là một sinh vật lâu đời, từ rất lâu rất lâu về trước, khi các loại sinh vật còn sinh sống trên lục địa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610120
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610120,
					"content": "Tổ tiên của bọn chúng đã sinh sống ở khu vực Long Tích Tuyết Sơn ngày nay, bây giờ vẫn còn tìm được một số hóa thạch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610121
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610121,
					"content": "Lần trước tôi đã tìm được một ít trong quặng ở <color=#00E1FFFF>phía tây Thung Lũng Rồng Ngủ</color>, nếu mọi người vẫn không tin, có thể đi tìm thử.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nantuck"
				}
			]
		},
