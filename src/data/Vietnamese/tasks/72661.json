			"dialogs": [
				{
					"id": 726610501,
					"content": "Sao chỉ có phần vỏ thôi vậy, thứ bên trong có vẻ như đã bị người khác lấy mất rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726610502,
					"content": "Ý?! Kẻ đó là...Đạo Bảo Đoàn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726610503,
					"content": "Không lẽ là bọn chúng đã lấy đi những thứ trong khoáng thạch sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726610504,
					"content": "Mau đi theo bọn chúng, xung quanh nhất định có doanh trại của chúng, thứ trong khoáng thạch nhất định có ở đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726610505,
					"content": "Chúng ta đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726610506
					]
				},
				{
					"id": 726610506,
					"content": "Chúng ta phải len lén, đừng để bị phát hiện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
