			"dialogs": [
				{
					"id": 726610701,
					"content": "Này, mọi người thấy mấy cục đá này đáng giá chứ? Mà lại giấu bên trong khoáng thạch, thật hiếm có.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610702
					],
					"speakerTitle": "Qi Cổ Điển"
				},
				{
					"id": 726610702,
					"content": "Cười chết mất, cái gì mà cục đá chứ, ngươi có học thức không vậy? Đây gọi là hóa thạch, hiểu không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610703
					],
					"speakerTitle": "Lin Chạy Trốn"
				},
				{
					"id": 726610703,
					"content": "Đáng giá lắm đó, chỉ một viên cũng đủ mua được một nửa Cảng Liyue! Mau quay về đọc thêm nhiều sách đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610704
					],
					"speakerTitle": "Lin Chạy Trốn"
				},
				{
					"id": 726610704,
					"content": "Thật sao? Đáng giá vậy sao? Vậy cộng thêm mấy thứ trong doanh trại, chúng ta chẳng phải có thể một bước lên mây đen rồi sao?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610705
					],
					"speakerTitle": "Klutzy Bazi"
				},
				{
					"id": 726610705,
					"content": "Là một bước lên mây! Ngươi cũng đọc thêm nhiều sách đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610706
					],
					"speakerTitle": "Lin Chạy Trốn"
				},
				{
					"id": 726610706,
					"content": "Này! Tên kia, mau giao hóa thạch ra đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726610707,
					"content": "A! Là ai?! Chết tiệt... Bị phát hiện rồi, anh em xông lên!",
					"roleType": "TALK_ROLE_NPC",
