			"dialogs": [
				{
					"id": 726610601,
					"content": "Các bạn cuối cùng đã về rồi, ủa? Jiawei không đến sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610602
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610602,
					"content": "Anh ấy bận đi làm chạn vương rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726610603
					]
				},
				{
					"id": 726610603,
					"content": "Hả? Anh ấy lập gia đình rồi sao? Ha ha, đúng là giống những gì anh ấy sẽ làm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610604
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610604,
					"content": "Dù sao thì tâm nguyện trước đó của anh ấy chính là thứ này...Được thôi, nếu vì lý do này thì tha thứ cho anh ấy vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610605
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610605,
					"content": "Vậy còn Nantuck thì sao? Mọi người tìm được chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610606
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610606,
					"content": "Anh ấy đã viết được một quyển sách bán chạy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726610607
					]
				},
				{
					"id": 726610607,
					"content": "Hả? Không ngờ anh ấy lại trở thành tác giả thật? Cũng giỏi thật đó, viết gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610608
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610608,
					"content": "Tôi biết tôi biết! Tên sách là \"Sự thật về Ánh Trăng Biển thực chất là rùa biển\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726610609,
					"content": "Ồ tên sách dài thật, là tiểu thuyết sao? Không tệ...tôi cũng mua một quyển xem thử...ủa? Đợi chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610610
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610610,
					"content": "Sự thật về Ánh Trăng Biển... Sự thật của Ánh Trăng Biển?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610611
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610611,
					"content": "Ừm...thực ra là rùa biển.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726610612
					]
				},
				{
					"id": 726610612,
					"content": "Tên này nói gì vậy? Sao lại có thể là rùa biển? Anh ấy quên rằng năm xưa chúng ta đã tận mắt thấy được Ánh Trăng Biển sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610613
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610613,
					"content": "Ban đầu chúng tôi cũng không tin...sau đó đã đến Tuyết Sơn và tìm được hóa thạch của Ánh Trăng Biển...quyển sách này, với hóa thạch, đây cầm lấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726610614,
					"content": "Không, tôi không tin, đây không phải sự thật...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610615
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610615,
					"content": "Mọi người không biết đâu, nhà \"Kujirai\" chúng tôi là gia đình thợ câu, cha tôi cũng là Thợ Câu Inazuma nổi tiếng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610616
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610616,
					"content": "Ông ấy đã dành gần mười năm trên biển để theo đuổi \"Ánh Trăng Biển\", có một lần, ông ấy suýt chút đã thành công rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610617
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610617,
					"content": "Tuy cuối cùng vẫn công cốc, nhưng ông ấy không từ bỏ, nếu có thể bắt được \"Ánh Trăng Biển\" trong truyền thuyết, thì đó là vinh dự cao nhất đối với thợ câu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610618
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610618,
					"content": "Nhưng vào lần ra biển tiếp theo...ông ấy đã không quay về nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610619
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610619,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610620
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610620,
					"content": "Cho nên tôi sẽ không tin những lời này đâu, hãy giúp tôi một tay!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610621
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610621,
					"content": "Vậy cô tính làm gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726610622
					]
				},
				{
					"id": 726610622,
					"content": "Giờ tôi sẽ quay về tìm những gì cha tôi để lại, ông ấy cả đời theo đuổi Ánh Trăng Biển, để lại rất nhiều tài liệu. Nhất định sẽ tìm được cách từ trong đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610623
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610623,
					"content": "Tôi đã chuẩn bị một số huấn luyện câu cá cho bạn, hãy đợi tin tốt của tôi, lúc đó phiền bạn rồi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kujirai Momiji"
				}
			]
		},
