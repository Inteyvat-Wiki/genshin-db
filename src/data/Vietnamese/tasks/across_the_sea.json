					"nextDialogs": [
						110100305
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100305,
					"content": "Ơ giọng nói này là... Teucer! Trời đất, là Teucer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100306
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100306,
					"content": "Hahaha... Đây là bất ngờ em chuẩn bị cho anh sao, Teucer? Anh còn tưởng phải về Snezhnaya mới gặp được em...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100307
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100307,
					"content": "Chị Tonia, anh Anthon nữa... Họ sao rồi? Vẫn ổn chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100308
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100308,
					"content": "Mọi người đều rất nhớ anh, chị Tonia luôn cầu nguyện trước bữa tối, cầu cho anh được bình an...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100309
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100309,
					"content": "...Khoan đã, không đúng, Teucer! Em đến Liyue bằng cách nào, sao anh không nhận được bất cứ tin tức gì..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100310
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100310,
					"content": "Ơ, chuyện này... Em thấy một con thuyền giống như bán đồ chơi, em còn tưởng anh ở trên đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100311
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100311,
					"content": "Xuống thuyền em cứ đi, sau đó gặp \"Tiểu Bảo Một Mắt\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100312
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100312,
					"content": "#\"Tiểu Bảo Một Mắt\" đuổi một kẻ xấu đi, rồi sau đó, em lại theo người tốt {NICKNAME} đến đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100313,
						110100315
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100313,
					"content": "Buôn lậu sao!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100314
					]
				},
				{
					"id": 110100314,
					"content": "Còn nữa... Teucer là em trai của \"Childe\" sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100316,
					"content": "Vậy xem ra tiền của Teucer chúng ta có thể yên tâm mà nhận rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100317,
					"content": "Nơi này quá nguy hiểm, gặp em anh rất vui, nhưng hãy đồng ý với anh, sau này không được mạo hiểm như vậy nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100318
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100318,
					"content": "Ừm, Teucer biết rồi, anh đừng giận em nhé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100319
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100319,
					"content": "Anh không giận, anh chỉ đang lo cho em thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100320
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100320,
					"content": "Nếu không phải gặp hai vị này, có thể Teucer đã gặp nguy hiểm rồi. Em cảm ơn họ chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100321
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100321,
					"content": "Ừm! Teucer rất lễ phép đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100322
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100322,
					"content": "Cuối cùng cũng để ý đến chúng tôi rồi sao, anh \"Childe\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100323,
					"content": "Hahaha, thật ngại quá, trò chuyện với người nhà lúc nào cũng phải ưu tiên hàng đầu, mong mọi người thông cảm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100324
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100324,
					"content": "Còn nữa, trước đây tuy chúng ta từng đối đầu, nhưng ngoài chuyện đó ra... chẳng phải chúng ta vẫn rất vui vẻ với nhau sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100325,
						110100326
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100325,
					"content": "Đây chỉ là đang diễn thôi đúng không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100327
					]
				},
				{
					"id": 110100327,
					"content": "Hehe, về \"chuyện đó\", chẳng qua chúng ta chỉ là con cờ thôi. Còn về chuyện thắng thua và dọn dẹp bàn cờ... thì cứ để cho những người bày ra trò đó đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100328
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100328,
					"content": "Điều tôi quan tâm là thắng thua giữa chúng ta thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100329
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100329,
					"content": "Thế nào, anh vẫn muốn thua thêm một lần sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100330
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100330,
					"content": "Hơ, tôi là Tartaglia mạnh lên mỗi giây, lần sau hãy chuẩn bị cho tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100331,
						110100332
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100331,
					"content": "Tôi cũng không còn là tôi của trước đây nữa rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100333
					]
				},
				{
					"id": 110100333,
					"content": "Này này, hai người đánh bây giờ luôn sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100334
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100334,
					"content": "Hahaha... Lần này bỏ đi, đánh nhau sẽ dạy hư trẻ con.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100335
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100335,
					"content": "#Đánh nhau? Anh và người tốt {NICKNAME} không thân nhau sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100336
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100336,
					"content": "#Không không, sao có thể chứ? {NICKNAME}, cảm ơn {F#cô}{M#cậu} đã đưa em trai tôi đến đây, an nguy của nó thật sự rất quan trọng với tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100337,
						110100338
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100337,
					"content": "Tôi vẫn sẽ đề phòng anh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100339
					]
				},
				{
					"id": 110100339,
					"content": "Có chuyện này... Đột nhiên tôi nhớ ra một chuyện...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100340
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100340,
					"content": "Teucer nói, anh trai của mình là \"người bán đồ chơi\" là thế nào? Anh không phải quan chấp hành của Fatui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100341
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100341,
					"content": "Khụ khụ... ừm... à! Chuyện đó sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100342
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100342,
					"content": "Suỵt... Vì trong mắt bọn trẻ con, bán đồ chơi là công việc khiến người khác ngưỡng mộ nhất nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100343
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100343,
					"content": "Hơn nữa, tôi cũng không muốn người nhà mình tiếp xúc với Fatui... nói cách khác là... mặt tối của Snezhnaya",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100344
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100344,
					"content": "Tuy những đứa em trưởng thành đều đã biết tôi làm việc cho nữ hoàng, nhưng trong mắt đứa em nhỏ nhất...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100345
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100345,
					"content": "Khụ khụ, tôi vẫn là người bán đồ chơi ở nước ngoài xuất sắc nhất Snezhnaya, tạm thời trực thuộc \"viện nghiên cứu đồ chơi\" tại Liyue!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100346
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100346,
					"content": "Đúng vậy đúng vậy, anh trai của em rất giỏi! Là bạn đồng hành của \"Tiểu Bảo Một Mắt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100347
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100347,
					"content": "Chuyện này ở trước mặt Teucer nhất định phải phối hợp với tôi, làm ơn nhé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100348
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100348,
					"content": "À đúng rồi, tiểu thư Ekaterina, chuyện thu tiền bây giờ tôi chuẩn bị làm ngay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100349
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100349,
					"content": "Đây là thấy tình thế bất lợi nên kiếm đường chuồn sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100350
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100350,
					"content": "Nhưng chuyện lúc nãy chúng ta đang nói, phiền đại nhân Childe xử lý nợ nần...? Thật sự có hơi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100351
					],
					"speakerTitle": "Ekaterina"
				},
				{
					"id": 110100351,
					"content": "Muốn cược sao. Dù sao cũng cược thua \"Người Xử Lý Nợ\", thì tiện thể hoạt động gân cốt luôn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100352
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100352,
					"content": "Anh phải đi bán đồ chơi rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100353
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100353,
					"content": "Đúng vậy. Tuy anh rất muốn ở cùng Teucer, nhưng anh có việc phải làm, hay là em ở cùng người đưa em đến nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100354
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100354,
					"content": "Lại bắt chúng tôi làm bảo mẫu sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100355
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100355,
					"content": "#Ừm! Teucer thích ở cùng người tốt {NICKNAME}, vả lại chúng ta cũng móc ngoéo rồi, hứa là phải chăm sóc cho Teucer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100356
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100356,
					"content": "#Ừm, Teucer thích ở cùng {F#cô}{M#cậu}, vả lại hai người cũng đã móc ngoéo, hứa là phải chăm sóc cho Teucer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100357,
						110100358
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100357,
					"content": "Hai anh em đồng lòng thật nhỉ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100359
					]
				},
				{
					"id": 110100359,
					"content": "Làm phiền nhé, số tiền này đưa cho các bạn, xem như tiền lương, hãy đưa Teucer dạo quanh Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100360
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100360,
					"content": "Nếu gặp tình huống bất đắc dĩ, hãy đến <color=#00E1FFFF>bờ hồ gần Cửa Biển Thanh Hư</color> tìm tôi, hẹn gặp lại!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100358,
					"content": "Nể tình Teucer...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100359
					]
				},
				{
					"id": 110100338,
					"content": "Tâm trạng lo lắng cho người nhà tôi có thể hiểu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100339
					]
				},
				{
					"id": 110100332,
					"content": "Sẽ tiếp đến cùng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100333
					]
				},
				{
					"id": 110100326,
					"content": "Anh còn dám nói...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100327
					]
				},
				{
					"id": 110100315,
					"content": "Teucer là em trai của \"Childe\" sao!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100316
					]
				}
			]
		},
