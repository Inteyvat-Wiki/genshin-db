			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Daipai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110100101,
					"content": "Cẩn thận, dạo gần đây không phải thời điểm tốt để tham quan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100102
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100102,
					"content": "Hử? gần đây xảy ra chuyện gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100103,
					"content": "Ừm. Tổng bộ nhận được báo cáo, có một số Thủ Vệ Di Tích lảng vảng ở khu vực vốn dĩ không nên xuất hiện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100104
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100104,
					"content": "Giáo đầu cử người truy tìm nguồn gốc của những cỗ máy cổ xưa đó, phát hiện ra dường như nó đột ngột xuất hiện từ một di tích.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100105
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100105,
					"content": "Ai đã đánh thức nó sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100106,
					"content": "Không biết, tình báo chúng tôi biết được quá ít.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100107
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100107,
					"content": "Hơn nữa di tích đó rất đìu hiu, bên trong thỉnh thoảng còn vọng ra tiếng \"rắc rắc\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100108
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100108,
					"content": "Trước khi được tổng bộ chấp thuận, chúng ta không được phép vào đó thăm dò.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100109,
						110100110
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100109,
					"content": "Đúng là cẩn thận vẫn hơn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100113
					]
				},
				{
					"id": 110100113,
					"content": "Tóm lại cách tốt nhất bây giờ là tăng cường tuần tra, tránh để người dân bị ảnh hưởng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100114
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100114,
					"content": "Ừm, người bình thường đụng phải Thủ Vệ Di Tích thì nguy hiểm lắm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100115,
					"content": "Tôi giúp được gì không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100116
					]
				},
				{
					"id": 110100116,
					"content": "Ừm, tấm lòng của bạn tôi rất cảm ơn, nhưng... lỡ vì việc này khiến bạn gặp nguy hiểm thì còn phiền hơn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100117
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100117,
					"content": "#{NICKNAME} đánh giỏi lắm, anh yên tâm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100118,
						110100120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100118,
					"content": "Không sao, tôi biết chút thuật phòng thân.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100119
					]
				},
				{
					"id": 110100119,
					"content": "Vậy sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100122
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100122,
					"content": "Đã như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100123
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100123,
					"content": "Hôm trước trên <color=#00E1FFFF>sườn đồi</color> tôi nhìn thấy một vài dấu chân của Thủ Vệ Di Tích, nhưng sau đó do lo việc cảnh báo người đi đường nên vẫn chưa kịp điều tra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100124
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100124,
					"content": "Ừm, bắt đầu điều tra từ manh mối này sao? Cứ giao cho chúng tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100125,
					"content": "Thiên Nham vững chắc, núi vững khó dời. Cảm ơn bạn, Nhà Lữ Hành. Đợi tôi tuần tra xong sẽ đến gặp các bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100120,
					"content": "Nói vậy hơi mất lịch sự, nhưng tôi có thể đánh mười người như anh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100121
					]
				},
				{
					"id": 110100121,
					"content": "Haha, các bạn trẻ thật tự tin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100122
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100110,
					"content": "Hiệu quả làm việc quá kém.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100111
					]
				},
				{
					"id": 110100111,
					"content": "Hả? Bạn vừa nói gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100112
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100112,
					"content": "Này, sao giọng của bạn lại giống lão gia Diluc lúc đánh giá đội kỵ sĩ vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100113
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1101002,
			"completionStepIds": [
				1101004
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1101004",
							"2"
						],
						"stepId": 1101004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Teucer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110100201,
					"content": "#{M#Anh}{F#Chị} nhìn kìa! To lớn quá, oai phong quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100202
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100202,
					"content": "Í, là đứa trẻ ăn mặc kỳ lạ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100203,
					"content": "#Lần đầu tiên em thấy ở khoảng cách gần như vậy đấy, {M#anh}{F#chị} biết nó sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100204,
						110100206
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100204,
					"content": "Là \"Thủ Vệ Di Tích\" bị hỏng phải không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100205
					]
				},
				{
					"id": 110100205,
					"content": "Sai rồi sai rồi, \"Thủ Vệ Di Tích\" cái gì, nó tên là \"Tiểu Bảo Một Mắt\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100208
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100208,
					"content": "\"Tiểu Bảo Một Mắt\"?... Thì ra vẫn còn cách gọi đáng yêu như vậy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100209,
					"content": "Ừm! Là anh trai em nói với em, anh trai em là người bán đồ chơi giỏi nhất, chuyên bán loại đồ chơi này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100210
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100210,
					"content": "Anh ấy làm việc ở \"viện nghiên cứu đồ chơi\" ở Liyue, \"Tiểu Bảo Một Mắt\" cũng ra đời ở đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100211
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100211,
					"content": "#Chắc {F#chị}{M#anh} cũng rất thích đồ chơi đúng không, mô hình của {F#chị}{M#anh} là mẫu mới nhất sao? Còn biết nói chuyện nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100212,
						110100214
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100212,
					"content": "Paimon và Thủ Vệ Di Tích đều không phải đồ chơi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100213
					]
				},
				{
					"id": 110100213,
					"content": "Đúng vậy! Không sai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100216,
					"content": "Vất vả cho các bạn rồi, có manh mối gì không... Hả? Bạn nhỏ ngoại quốc này là?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100217
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100217,
					"content": "Lúc nãy chúng tôi vô tình gặp nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100218,
					"content": "Không được đâu, bạn nhỏ. Khu vực này có cỗ máy giết người đang lảng vảng, rất nguy hiểm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100219
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100219,
					"content": "\"Cỗ máy giết người\"? Ý chú là giống như kia sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100220
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100220,
					"content": "Đúng vậy, bao gồm cả nó, lỡ nó đột ngột cử động thì nguy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100221
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100221,
					"content": "Chẳng phải cỗ máy giết người gì cả! \"Tiểu Bảo Một Mắt\" là người bạn chân chính, chú không được nói như vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100222
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100222,
					"content": "Cái... cái gì một mắt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100223
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100223,
					"content": "#{F#Chị}{M#Anh}, chú ấy đang nói xấu \"Tiểu Bảo Một Mắt\", nên chắc chắn chú ấy là người xấu, chúng ta mặc kệ chú ấy đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100224
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100224,
					"content": "Bạn nhỏ, tôi chỉ có ý tốt thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100225,
						110100226
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100225,
					"content": "Cậu bé không nghe anh nói nữa đâu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100227
					]
				},
				{
					"id": 110100227,
					"content": "Bó tay, tôi vốn dĩ không biết đối phó với trẻ con...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100228
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100228,
					"content": "Anh cứ tiếp tục làm việc của anh đi, chúng tôi sẽ đảm bảo an toàn cho cậu bé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100229,
					"content": "Đành vậy... Vậy tôi đi tuần tra xung quanh tiếp đây, các bạn hãy đưa bạn nhỏ này đến nơi an toàn, ở đây quá nguy hiểm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100230
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100230,
					"content": "Hừm hừm! \"Tiểu Bảo Một Mắt\" lại dọa được một kẻ xấu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100231,
						110100232
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100231,
					"content": "Bạn nhỏ, em tên gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100233
					]
				},
				{
					"id": 110100233,
					"content": "À, em là Teucer! Teucer từ Snezhnaya xa xôi đến Liyue tìm anh trai, nhưng Teucer chỉ có một mình, không biết anh trai ở đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100234
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100234,
					"content": "Từ Snezhnaya đến à..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100235
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100235,
					"content": "Đúng rồi, những lúc thế này... Cầm lấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100236
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100236,
					"content": "Hửm? Cái gì đây... nặng thế...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100237
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100237,
					"content": "Đây là...!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100238,
						110100239
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100238,
					"content": "Nhiều Mora quá!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100240
					]
				},
				{
					"id": 110100240,
					"content": "Đây là anh trai bảo Teucer mang theo bên mình, anh nói đưa nó cho người tốt, người tốt sẽ tốt với Teucer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100241
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100241,
					"content": "Có... có lý... Lẽ nào có thể từ Snezhnaya đến Liyue là nhờ vào cái này sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100242
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100242,
					"content": "Xem ra Teucer là một đứa bé nhà giàu, bán đồ chơi lại dễ kiếm tiền vậy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100243,
						110100244
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100243,
					"content": "Tôi nhận vậy!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100245
					]
				},
				{
					"id": 110100245,
					"content": "#Woa, thật sao! Cảm ơn người tốt {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100246
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100246,
					"content": "Vậy thì, móc ngoéo với Teucer đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100247
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100247,
					"content": "\"Móc ngoéo móc ngoéo không được nuốt lời, nuốt lời sẽ bị ném xuống sông băng. Sông băng lạnh, cánh đồng tuyết lạnh, lưỡi đóng băng!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100248
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100248,
					"content": "Đúng là bài đồng dao dữ dội mang phong cách đặc trưng của Snezhnaya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100249
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100249,
					"content": "Đã vậy thì đành làm bảo mẫu một thời gian vậy... Nhưng phải đi đâu để tìm anh trai nó đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100250,
						110100252
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100250,
					"content": "Nơi có liên quan mật thiết với Snezhnaya...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100251
					]
				},
				{
					"id": 110100251,
					"content": "Liên quan mật thiết với Snezhnaya... Đúng rồi, vậy thì đến <color=#00E1FFFF>Ngân hàng Bắc Quốc</color> hỏi xem sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100254
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100254,
					"content": "Bây giờ đi sao? Cuối cùng Teucer cũng sắp được gặp anh trai rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100252,
					"content": "<color=#00E1FFFF>Ngân hàng Bắc Quốc</color>?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100253
					]
				},
				{
					"id": 110100253,
					"content": "Ừm, ý hay! Đến đó hỏi xem sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100254
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100244,
					"content": "Tôi nhận vậy (Gặp anh trai nó rồi trả lại sau vậy...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100245
					]
				},
				{
					"id": 110100239,
					"content": "Rất nhiều rất nhiều Mora!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100240
					]
				},
				{
					"id": 110100232,
					"content": "Người nhà của em ở đâu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100233
					]
				},
				{
					"id": 110100226,
					"content": "Cứ giao cho tôi đi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100227
					]
				},
				{
					"id": 110100214,
					"content": "Ừm, ngưỡng mộ không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100215
					]
				},
				{
					"id": 110100215,
					"content": "Này! Sao tôi lại trở thành một thứ mới lạ vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100206,
					"content": "Coi chừng, nó rất khó đối phó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100207
					]
				},
				{
					"id": 110100207,
					"content": "Đúng vậy! \"Tiểu Bảo Một Mắt\" siêu... lợi hại, không có kẻ xấu nào thoát được khỏi bàn tay của nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100208
					],
					"speakerTitle": "Teucer"
				}
			]
		},
