			"dialogs": [
				{
					"id": 110100301,
					"content": "Như vậy không ổn đâu, Quan Chấp Hành đại nhân, sao ngài có thể...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100302
					],
					"speakerTitle": "Ekaterina"
				},
				{
					"id": 110100302,
					"content": "Thỉnh thoảng thôi, không sao không sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100303
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100303,
					"content": "Hả? Người này sao cũng ở đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100304,
					"content": "Anh! Anh, anh!",
