			"dialogs": [
				{
					"id": 752390101,
					"content": "Tên Zhaka đó... không làm xong việc là trốn mất, không biết là đã để số búp bê đó ở đâu rồi. Tôi phải khiếu nại mới được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752390102
					],
					"speakerTitle": "Kanei"
				},
				{
					"id": 752390102,
					"content": "Búp bê gì cơ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752390103
					]
				},
				{
					"id": 752390103,
					"content": "Là vài món đồ chơi nhỏ lấy nguyên mẫu từ Koholasaurus, tôi đang tô màu cho chúng ấy mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752390104
					],
					"speakerTitle": "Kanei"
				},
				{
					"id": 752390104,
					"content": "Nhưng học trò Zhaka của tôi dạo này không đến làm, cậu ấy vẫn còn ba con búp bê bán thành phẩm chưa được lên màu nữa, cũng không biết đang để ở đâu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752390105
					],
					"speakerTitle": "Kanei"
				},
				{
					"id": 752390105,
					"content": "Quý khách có thể giúp tôi tìm kiếm chúng không? Tôi nghĩ chắc là chúng ở gần đây thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
