			"dialogs": [
				{
					"id": 761390101,
					"content": "Ngành xuất bản cũng chẳng kiếm được tiền, hay là chỉ đầu tư thôi vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390102
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390102,
					"content": "Muốn xem thử vé đầu tư...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761390103
					]
				},
				{
					"id": 761390103,
					"content": "Được rồi, 2000 Mora một vé đầu tư, mỗi tuần tổng kết một lần, hihi, trong chiếc túi nhỏ này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390104
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390104,
					"content": "...Ối!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390105
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390105,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761390106
					]
				},
				{
					"id": 761390106,
					"content": "Không... không có gì, chỉ là không ngờ cô chủ Nefer cũng đến đây. Cô... cô cũng muốn mua vé đầu tư sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390107
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390107,
					"content": "Tôi không cần đâu, tôi chỉ cùng người bạn này đến đây xem thử thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390108
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761390108,
					"content": "Nghe nói công việc đầu tư của ông chủ Dhabit rất thành công, hôm nay đến xem quả đúng như lời đồn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390109
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761390109,
					"content": "Bình thường thôi mà, hahaha... Kinh doanh nhỏ thôi, chỉ là kiếm sống qua ngày thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390110
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390110,
					"content": "Thật sự có thể kiếm được tiền sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761390111
					]
				},
				{
					"id": 761390111,
					"content": "Đương nhiên rồi, ông chủ Dhabit là một người kinh doanh ưu tú, đầu tư theo anh ấy sẽ không lỗ đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390112
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761390112,
					"content": "Đúng... đúng... hahaha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390113
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390113,
					"content": "Để xem vận may hôm nay như thế nào...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761390114
					]
				},
				{
					"id": 761390114,
					"content": "#Hôm nay! Chính là hôm nay, thứ {F#cô}{M#cậu} vừa mua là... vé đầu tư ngắn hạn mà chúng tôi vừa ra mắt! Tổng kết lời lỗ ngay tức thì!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390115
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390115,
					"content": "Sao cảm thấy như anh vừa mới bịa ra những điều này vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761390116,
					"content": "#À... ừm, tóm lại, cảm ơn {F#cô}{M#cậu} đã mua vé đầu tư ngắn hạn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390117
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390117,
					"content": "#Đây là lợi nhuận đầu tư của {F#cô}{M#cậu}, chúc {F#cô}{M#cậu} một ngày tốt lành!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390118,
						761390119
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390118,
					"content": "Nói chung kiếm tiền là chuyện tốt...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761390120
					]
				},
				{
					"id": 761390120,
					"content": "Thật sao? Hihi, vậy mua cho tôi điêu khắc đường hình chú chim nhỏ nhé, tôi thích hình đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761390121,
					"content": "Vậy tôi cũng xin phép cáo từ. Ông chủ Dhabit đúng là thương nhân tốt có uy tín, chúc anh kinh doanh phát đạt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390122
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761390122,
					"content": "Cảm ơn lời chúc của cô chủ Nefer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390123
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390123,
					"content": "Còn một việc nữa, món hàng lần trước tôi nhờ cô chủ Nefer tìm giúp...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390124
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390124,
					"content": "Đã tìm thấy rồi, nhưng mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390125
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761390125,
					"content": "Anh đừng vội. Mọi thứ phải thực hiện từng bước một mới ổn thỏa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390126
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761390126,
					"content": "Vâng, cô chủ Nefer nói đúng... Vậy thì phiền cô rồi, tôi chỉ còn hy vọng vào mỗi cô thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
