			"dialogs": [
				{
					"id": 742480201,
					"content": "Đoàn Kịch Trên Bàn thú vị thật đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480202,
						742480203
					],
					"speakerTitle": "Columbina"
				},
				{
