				]
			},
			"dialogs": [
				{
					"id": 742480101,
					"content": "Columbina, Sandrone! Cảm ơn hai cô đã dành thời gian đến tham gia Đoàn Kịch Trên Bàn của chúng tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480102
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 742480102,
					"content": "Không có gì đâu, chúng tôi chưa chơi bao giờ, còn phải nhờ hai vị chỉ bảo thêm nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480103
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742480103,
					"content": "Không cần áp lực đâu, mọi người cứ tận hưởng niềm vui từ câu chuyện là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480104
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 742480104,
					"content": "Ừm, tôi rất mong chờ đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480105
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 742480105,
					"content": "Vậy để tôi giải thích sơ qua về bối cảnh của câu chuyện lần này nhé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480106
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 742480106,
					"content": "\"Đây là thời đại mà ma cà rồng và con người cộng sinh với nhau, câu chuyện diễn ra trong thành phố nơi hai chủng tộc cùng chung sống...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480107
					],
					"speakerTitle": "Clorinde",
					"speakerSubtitle": "Clorinde Nhập Vai"
				},
				{
					"id": 742480107,
					"content": "\"Mối quan hệ giữa loài người và ma cà rồng chưa đến mức gọi là thù địch, nhưng cũng không thể nói là hòa hợp. Và rồi, một vụ án mạng vào đêm khuya đã hoàn toàn phá vỡ sự cân bằng vi diệu này...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480108
					],
					"speakerTitle": "Clorinde",
					"speakerSubtitle": "Clorinde Nhập Vai"
				},
				{
					"id": 742480108,
					"content": "Ma cà rồng sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480109
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 742480109,
					"content": "Chính là chủng tộc sống bằng cách hút máu người, có thể coi là một tình tiết thường thấy trong tiểu thuyết. Columbina từng đọc qua chuyện tương tự nào chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480110
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 742480110,
					"content": "Ừm, hình như tôi từng đọc rồi. Vậy chúng ta cần làm gì trong câu chuyện này?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480111
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 742480111,
					"content": "Mọi người hãy quyết định nhân vật mà mình muốn đóng vai trong thế giới này đã. Miễn sao phù hợp với bối cảnh là được, không giới hạn thân phận hay nghề nghiệp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480112
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 742480112,
					"content": "Nhân vật muốn đóng vai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480113
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 742480113,
					"content": "Nếu khó mà tự quyết định được thì cũng có thể trao đổi với người khác, để họ quyết định hình tượng của cô trong thế giới này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480114
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 742480114,
					"content": "Ồ? Ý là... để người khác viết thiết lập bối cảnh hộ à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480115
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742480115,
					"content": "Ồ! Nghe có vẻ thú vị đấy! Chi bằng làm như thế đi! Thẻ nhân vật của tôi thì nhờ Clorinde viết giúp nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480116
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 742480116,
					"content": "Vậy thì nhân vật của tôi sẽ để Sandrone quyết định nhé. Tôi cũng sẽ thiết kế một nhân vật phù hợp với cô.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480117
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 742480117,
					"content": "Ha... được thôi. Tôi cũng đang không có nhiều ý tưởng về nghề nghiệp của mình trong câu chuyện lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480118
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742480118,
					"content": "Mọi người viết xong chưa! Hihi, để tôi xem của mình trước nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480119
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 742480119,
					"content": "\"Tôi là một thương nhân, thường đi lại trong thành phố nơi ma cà rồng và con người sinh sống...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480120
					],
					"speakerTitle": "Navia",
					"speakerSubtitle": "Thương Nhân Lang Thang"
				},
				{
					"id": 742480120,
					"content": "...Khoan đã. Quản trò, đây không phải là gần giống nhân vật trước kia của tôi sao! Ngay cả số liệu cũng giống hệt! Cô đây là đang lười biếng đúng không nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480121
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 742480121,
					"content": "Dù sao thì cuối cùng cô cũng sẽ dùng những cách kỳ quặc để gây khó dễ cho tôi thôi. Hơn nữa, tôi thấy vai diễn khôn ngoan và náo nhiệt này rất hợp với cô mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480122
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 742480122,
					"content": "...Này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480123
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 742480123,
					"content": "Haha. Vậy để tôi xem của tôi nhé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480124
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 742480124,
					"content": "\"Tôi là một ma cà rồng cực kỳ xấu xa. Ban ngày thích nằm ở nhà ngủ, chỉ khi trăng lên mới đi dạo trong vườn.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480125
					],
					"speakerTitle": "Columbina",
					"speakerSubtitle": "Ma Cà Rồng Cực Kỳ Xấu Xa"
				},
				{
					"id": 742480125,
					"content": "\"Tôi thích ca hát, dùng giọng ca để quyến rũ con mồi. Những ai từng thấy tôi mở mắt, đều không nhìn thấy được mặt trời mọc vào ngày hôm sau.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480126
					],
					"speakerTitle": "Columbina",
					"speakerSubtitle": "Ma Cà Rồng Cực Kỳ Xấu Xa"
				},
				{
					"id": 742480126,
					"content": "Ồ... Trong mắt Sandrone, tôi có hình tượng như vậy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480127
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 742480127,
					"content": "Hừ hừ, chẳng phải rất hợp với cô đấy sao? Mà còn rất thú vị nữa chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480128
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742480128,
					"content": "Được rồi, nhưng tôi vẫn muốn cố gắng làm một ma cà rồng tốt bụng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480129
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 742480129,
					"content": "Tùy cô thôi, để tôi xem cô viết gì nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480130
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742480130,
					"content": "\"Tôi là một đại tiểu thư quý tộc thanh lịch. Thường thích ở trong phòng mày mò những phát minh sáng tạo, ngủ rất muộn, thời gian nghỉ ngơi không điều độ...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480131
					],
					"speakerTitle": "Sandrone",
					"speakerSubtitle": "Thợ Săn Ma Cà Rồng"
				},
				{
					"id": 742480131,
					"content": "Này! Ai lại viết như thế trong phần giới thiệu bản thân chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480132
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742480132,
					"content": "Chậc... \"Nhưng đồng thời, tôi cũng là một thợ săn ma cà rồng, chỉ cần có người trong thành phố gặp nguy hiểm, tôi sẽ mang theo phát minh của mình đứng ra bảo vệ mọi người...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480133
					],
					"speakerTitle": "Sandrone",
					"speakerSubtitle": "Thợ Săn Ma Cà Rồng"
				},
				{
					"id": 742480133,
					"content": "...Hả? Như thế chẳng giống tôi chút nào cả!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480134
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742480134,
					"content": "Vậy sao? Tôi thấy giống mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480135
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 742480135,
					"content": "Nhưng mà xem ra thì nhân vật của Columbina và Sandrone lại đối đầu với nhau rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480136
					],
					"speakerTitle": "Navia",
					"speakerSubtitle": "Thương Nhân Lang Thang"
				},
				{
					"id": 742480136,
					"content": "Ừm, xem ra câu chuyện này sẽ có nhiều tiến triển thú vị đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480137
					],
					"speakerTitle": "Clorinde",
					"speakerSubtitle": "Clorinde Nhập Vai"
				},
				{
					"id": 742480137,
					"content": "Ôi! Tôi không đợi được nữa rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480138
					],
					"speakerTitle": "Navia",
					"speakerSubtitle": "Thương Nhân Lang Thang"
				},
				{
					"id": 742480138,
					"content": "Hah... Cứ có cảm giác sẽ có rất nhiều tiến triển phức tạp...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480139
					],
					"speakerTitle": "Sandrone",
					"speakerSubtitle": "Thợ Săn Ma Cà Rồng"
				},
				{
					"id": 742480139,
					"content": "Sợ rồi à? Sandrone. Có phải vì tôi là ma cà rồng cực kỳ xấu xa không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480140
					],
					"speakerTitle": "Columbina",
					"speakerSubtitle": "Ma Cà Rồng Cực Kỳ Xấu Xa"
				},
				{
					"id": 742480140,
					"content": "Hử? Là tôi đang nóng lòng muốn cho cô một trận thì đúng hơn đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sandrone",
					"speakerSubtitle": "Thợ Săn Ma Cà Rồng"
				}
			]
		},
