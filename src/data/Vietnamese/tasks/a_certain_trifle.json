				"points": []
			},
			"dialogs": [
				{
					"id": 740350101,
					"content": "A... Nhà Lữ Hành, rất vui được gặp bạn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350102,
						740350103
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350102,
					"content": "Anh vẫn ổn chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350104
					]
				},
				{
					"id": 740350104,
					"content": "Mắt thâm quầng, nói chuyện cũng không có sức lực, chi bằng nghỉ ngơi một lúc đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740350105,
					"content": "Tôi... tôi không thể nghỉ ngơi, tối qua thức cả đêm viết mấy bản thảo vẫn không được. Bây giờ tôi đang bắt đầu viết lại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350106
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350106,
					"content": "Nếu như bạn có chuyện cần tôi giúp, thì hãy đợi nhé... Có thể qua ngồi gần chỗ ngài Roialte, không chừng bên đó còn có cà phê nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350107
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350107,
					"content": "Tôi... tôi phải viết tiếp đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350108
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350108,
					"content": "Không được, dùng \"các đồng nghiệp thân mến\" cứ thấy không được trịnh trọng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350103,
					"content": "Anh nhìn có vẻ không ổn lắm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350104
					]
				}
			]
		},
