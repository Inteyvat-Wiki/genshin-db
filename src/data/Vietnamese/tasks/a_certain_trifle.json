					}
				]
			},
			"dialogs": [
				{
					"id": 740350201,
					"content": "#Nhà Lữ Hành, thật vui vì {F#cô}{M#cậu} ghé thăm, làm một tách cà phê nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350202,
						740350203
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350202,
					"content": "Nói đến thì...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350204
					]
				},
				{
					"id": 740350204,
					"content": "Trước đó tôi cũng muốn hỏi, nhưng... mấy người đó lớn tiếng quá, không dám nhắc đến luôn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350243
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740350243,
					"content": "Tôi còn tưởng sẽ bị đuổi thẳng ra chứ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350205
					]
				},
				{
					"id": 740350205,
					"content": "#Tại sao ư? Hahaha, đừng lo, bảo vệ đã để {F#cô}{M#cậu} vào thì sao chúng tôi phải cố tình đuổi {F#cô}{M#cậu} ra ngoài chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350206
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350206,
					"content": "Đây là một hình thức của trách nhiệm và quyền hạn rõ ràng. Xin chào Nhà Lữ Hành, tôi là Semaine, hân hạnh được gặp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350207,
						740350208
					],
					"speakerTitle": "Semaine"
				},
				{
					"id": 740350207,
					"content": "Xin chào.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350209
					]
				},
				{
					"id": 740350209,
					"content": "Semaine trước đây từng làm việc ở tòa án với tư cách là trợ lý thư ký. Vì một số... chuyện linh tinh nên bị điều về Sảnh Phúc Luật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350210
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350210,
					"content": "Nhiều vấn đề mà trước đây chúng tôi không xử lý được, đều nhờ anh ấy tìm ra cách giải quyết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350211
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350211,
					"content": "Quá khen rồi, tôi chẳng qua chỉ dựa vào kinh nghiệm làm việc trước đó, dùng giá trị đo lường của sự vật vào những việc liên quan thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350212
					],
					"speakerTitle": "Semaine"
				},
				{
					"id": 740350212,
					"content": "Tuy khi bắt tay vào công việc thực tế thỉnh thoảng sẽ gặp những thứ không thể đo lường, nhưng những lý luận về tình người mà ngài Roialte hiểu rõ đã giúp đỡ cho tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350213
					],
					"speakerTitle": "Semaine"
				},
				{
					"id": 740350213,
					"content": "Ý của anh là...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350214
					]
				},
				{
					"id": 740350214,
					"content": "Nói đơn giản thì, khi xử lý công việc, Semaine rất giỏi cân bằng cảm xúc, khiến mỗi người đều ý thức được mình rất quan trọng. Giống như cân bằng hai cán cân vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350215
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350215,
					"content": "Nếu như thật sự không cân bằng được, vậy tôi cũng có thể cung cấp một số \"sức nặng của ngôn từ\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350216,
						740350217
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350216,
					"content": "Iaune có vẻ rất đau khổ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350218
					]
				},
				{
					"id": 740350218,
					"content": "Đúng vậy, cảm giác anh ấy có thể ngất đi bất cứ lúc nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740350219,
					"content": "Đây là con đường mỗi người đều phải đi qua, nếu bây giờ tôi giúp Iaune viết xong tài liệu, vậy cậu ấy sẽ không thể nhớ bài học lần này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350220
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350220,
					"content": "Cậu ấy luôn có một số ảo tưởng phi thực tế về Sảnh Phúc Luật. Nhưng ảo tưởng chỉ dành cho người trẻ tuổi chứ không thuộc về nhân viên Sảnh Phúc Luật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350221
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350221,
					"content": "Và đơn giản là tôi không biết viết tài liệu thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350222
					],
					"speakerTitle": "Semaine"
				},
				{
					"id": 740350222,
					"content": "Anh cũng thẳng thắn thật đấy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350223
					]
				},
				{
					"id": 740350223,
					"content": "#Được rồi, vậy {F#cô}{M#cậu} đến đây rốt cuộc muốn làm gì? Có thể nói với tôi, xem liệu tôi có...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350224
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350224,
					"content": "Iaune đột nhiên khẩn trương chạy đến...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740350225
					]
				},
				{
					"id": 740350225,
					"content": "Thật xui xẻo quá mà... ngài Roialte, ngài có nắp phím máy đánh chữ dự phòng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350226
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350226,
					"content": "Lúc nãy khi tôi đang đánh chữ, đột nhiên phát hiện có một nắp phím không biết bị mất từ khi nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350227
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350227,
					"content": "Cậu đã tìm xung quanh chưa? Có thể bị rơi xuống đất rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350228
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350228,
					"content": "Hoặc kẹp trong sách, bị kẹp bên dưới hồ sơ... mấy chỗ đó cậu có tìm thử qua chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350229
					],
					"speakerTitle": "Semaine"
				},
				{
					"id": 740350229,
					"content": "Còn có trong ống bút và ngăn kéo nữa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350230
					]
				},
				{
					"id": 740350230,
					"content": "Và cả trong tóc và tách trà nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740350231,
					"content": "Tôi tìm qua hết rồi, ngay cả túi áo, đế giày cũng tìm qua một lượt rồi, đều không tìm thấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350232
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350232,
					"content": "Được rồi, cậu hãy đi hỏi cô Cornelia, nếu có \"phụ kiện thay thế\" thì chắc cũng đăng ký ở chỗ cô ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350233
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350233,
					"content": "Hay tôi tự đi mua một cái mới cho rồi, tìm Estelle đặt làm một cái nắp phím, cũng không tốn nhiều thời gian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350234
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350234,
					"content": "Ôi Iaune, sao cậu cứ phải tự bỏ tiền ra chứ? Đây là vật dụng công của Sảnh Phúc Luật, đăng ký ở chỗ cô Cornelia là chuyện đương nhiên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350235
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350235,
					"content": "Cái này thật ra cũng không tốn bao nhiêu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350236
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350236,
					"content": "Vấn đề ở đây không phải tốn nhiều hay ít mà là một vấn đề về trách nhiệm và quyền hạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350237
					],
					"speakerTitle": "Semaine"
				},
				{
					"id": 740350237,
					"content": "Chi phí sửa chữa vật dụng công của Sảnh Phúc Luật, vốn dĩ nên dùng tài khoản công của Sảnh Phúc Luật thanh toán.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350238
					],
					"speakerTitle": "Semaine"
				},
				{
					"id": 740350238,
					"content": "Nếu cậu tự trả khoản chi này, lại không xin giải chi, đến cuối năm kiểm kê chi phí công vụ thì khoản này sẽ không rõ ràng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350239
					],
					"speakerTitle": "Semaine"
				},
				{
					"id": 740350239,
					"content": "Được rồi! Được rồi! Tôi sẽ đến chỗ cô Cornelia ngay...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350240,
						740350241
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350240,
					"content": "Sao mua đồ thôi mà cũng phiền phức vậy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350242
					]
				},
				{
					"id": 740350242,
					"content": "Trong Sảnh Phúc Luật, đây lại là một việc bình thường. Chúng ta đi thôi, đi tìm cô Cornelia nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350241,
					"content": "Ngay cả việc chi trả cũng rắc rối đến vậy sao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350242
					]
				},
				{
					"id": 740350217,
					"content": "Các anh không thể giúp anh ấy sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350218
					]
				},
				{
					"id": 740350208,
					"content": "Xin hỏi anh là...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350209
					]
				},
				{
					"id": 740350203,
					"content": "Tại sao trước đây mấy người không thấy kinh ngạc khi nhìn thấy tôi vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350204
					]
				}
			]
