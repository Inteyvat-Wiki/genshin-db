			"dialogs": [
				{
					"id": 740350401,
					"content": "Xin chào, ngài Iaune, tôi có thể giúp gì cho anh không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350402
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350402,
					"content": "Xin chào, cô Cornelia. Xin hỏi chỗ cô có nắp phím máy đánh chữ dự phòng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350403
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350403,
					"content": "Sao cơ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350404
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350404,
					"content": "Máy đánh chữ của tôi bị thiếu mất một phím, tôi muốn đăng ký một cái nắp phím dự phòng để thay. Nếu không có... thì giúp tôi xin giải chi một cái cũng được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350405
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350405,
					"content": "Xin giải chi cho nắp phím... theo nguyên tắc thì không thành vấn đề.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350406
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350406,
					"content": "Anh hãy điền tên ở đây. Rồi viết \"vì máy đánh chữ hỏng, xin giải chi một nắp phím\", sau đó ký tên cùng tên phòng làm việc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350407
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350407,
					"content": "Được rồi, chắc tôi sẽ lấy được nắp phím trong hôm nay nhỉ, tôi còn đang có công việc cần xử lý gấp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350408
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350408,
					"content": "Anh Iaune, trước đây có từng xin giải chi vật dụng công chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350409
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350409,
					"content": "Xin giải chi vật dụng công không như anh nghĩ đâu... chúng tôi phải tổng kết đơn giải chi theo tháng, sau đó cuối tháng mới trình lên Sảnh Chính Luật xét duyệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350410
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350410,
					"content": "Việc xét duyệt này liên quan đến việc trả lương của cả Sảnh Phúc Luật, nếu số lượng xin giải chi quá nhiều, Sảnh Chính Luật có thể còn phải trình lên cho ngài Neuvillette xét duyệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350427
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350427,
					"content": "Đợi sau khi xét duyệt xong và ký tên mới chính thức giải chi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350411
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350411,
					"content": "Nếu ngài Neuvillette có nghi vấn với mục nào đó, nhân viên tương ứng sẽ phải nộp thêm giải trình bằng văn bản... mấy ngày nay chúng tôi đang chuẩn bị nộp đơn xin đợt đầu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350412
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350412,
					"content": "Ý của cô là, lỡ như tôi xui xẻo thì việc xin giải chi nắp phím này còn phải đợi ngài Neuvillette chấp thuận à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350413
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350413,
					"content": "Quy định là như vậy. Hơn nữa đơn xin giải chi tháng này khá lớn, rất có khả năng sẽ cần ngài Neuvillette xét duyệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350414
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350414,
					"content": "Ngài Neuvillette... chẳng phải chính là vị thẩm phán tối cao đó sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740350415,
					"content": "Chẳng qua chỉ là một cái nắp phím, còn cần ngài ấy ký tên... cứ cảm thấy có gì đó sai sai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350416,
						740350417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740350416,
					"content": "Còn cách nào khác không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350418
					]
				},
				{
					"id": 740350418,
					"content": "Tôi cũng nghĩ vậy, chỉ là một nắp phím thôi, thật sự không cần phiền đến ngài Neuvillette.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350419
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350419,
					"content": "Thật ra cũng có một cách khác. Ừm... anh có thể tự mua, sau đó tôi sẽ giúp anh ghi một biên lai công.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350420
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350420,
					"content": "Sau khi hoàn tất quy trình, chi phí được chuyển xuống, sẽ dùng tài khoản công chuyển chi phí tương ứng cho anh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350421
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350421,
					"content": "Vậy thì tốt quá! Cứ làm thế đi, một nắp phím cũng không tốn bao nhiêu, tôi vẫn trả được mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350422
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350422,
					"content": "Vậy nhờ anh ký tên ở đây, vẫn viết \"vì máy đánh chữ hỏng, xin giải chi một nắp phím\"... Anh sẽ đến chỗ cô Estelle để mua nắp phím à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350423
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350423,
					"content": "Đúng vậy, sao thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350424
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350424,
					"content": "Một lát nữa tôi sẽ mang tờ biên lai này đến nhờ ngài Roialte ký tên, sau đó đến chỗ cô Estelle để xác nhận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350425
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350425,
					"content": "Những việc này anh không cần lo, cứ đi mua nắp phím trước nhé, cứ giao cho tôi xử lý là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350426
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350426,
					"content": "Cảm ơn nhé. Cô thật tốt quá, cô Cornelia. Tôi sẽ đi mua nắp phím ngay... Đi nào Nhà Lữ Hành, chúng ta mau đi thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350417,
					"content": "Chi bằng đổi cách khác đi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350427
					]
				}
			]
