						411220504
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220504,
					"content": "Chỉ cần bạn đồng ý giúp đỡ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220505
					]
				},
				{
					"id": 411220505,
					"content": "Giúp đỡ? Giúp cái gì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220506
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220506,
					"content": "A? Lên chỗ cao nhất trong thành Mondstadt để ngắm thiên thạch, vậy, vậy cũng có chút nguy hiểm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220507
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220507,
					"content": "Mà còn là hai đứa trẻ, tôi phải báo cáo chuyện này với đội kỵ sĩ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220508
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220508,
