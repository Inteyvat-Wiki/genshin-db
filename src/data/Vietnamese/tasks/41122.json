			"dialogs": [
				{
					"id": 411220401,
					"content": "#Í? Chào {F#chị}{M#anh}, có việc gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220402
					],
					"speakerTitle": "Will"
				},
				{
					"id": 411220402,
					"content": "Về tình hình hiện tại...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220403
					]
				},
				{
					"id": 411220403,
					"content": "Em biết chứ, tụi em ra đây để xem thiên thạch. Chỉ cần nhìn thấy tụi em sẽ trở về, đừng lo lắng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220404
					],
					"speakerTitle": "Will"
				},
				{
					"id": 411220404,
					"content": "Ở trong thành cũng có thể thấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220405
					]
				},
				{
					"id": 411220405,
					"content": "Vậy phải lên một nơi thật cao mới được. Em đã thử rất nhiều lần, đều bị vệ binh kêu xuống, còn bị giáo huấn một trận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220406
					],
					"speakerTitle": "Will"
				},
				{
					"id": 411220406,
					"content": "Vì vậy em mới đưa Jill đến đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220407
					],
					"speakerTitle": "Will"
				},
				{
					"id": 411220407,
					"content": "Ông chú bên cạnh đồng ý giúp đỡ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220408
					]
				},
				{
					"id": 411220408,
					"content": "#Giúp đỡ? Ý của {F#chị}{M#anh} là, chú ấy sẽ đưa tụi em lên một nơi cao để xem thiên thạch hả?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220409
					],
					"speakerTitle": "Will"
				},
				{
					"id": 411220409,
					"content": "Không thể nào... Nhìn chú đó rất kỳ quặc, còn hung dữ nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220410
					],
					"speakerTitle": "Will"
				},
				{
					"id": 411220410,
					"content": "#{F#Chị}{M#Anh} mang theo thư lệnh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220411
					]
				},
				{
					"id": 411220411,
					"content": "Thật sao? Cho em xem đi. Oa... đúng là thư lệnh của đội kỵ sĩ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220412
					],
					"speakerTitle": "Will"
				},
				{
					"id": 411220412,
