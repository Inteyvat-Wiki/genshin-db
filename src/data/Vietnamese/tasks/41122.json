					"nextDialogs": [
						411220513
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220513,
					"content": "Bất kể đối tượng cam kết là ai, chỉ cần là chuyện đã hứa thì sẽ phải thực hiện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220514
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220514,
					"content": "Lần này đã làm phiền bạn rồi, chuyện còn lại cứ giao cho tôi, lát nữa tôi sẽ đưa chúng trở về thành Mondstadt.",
