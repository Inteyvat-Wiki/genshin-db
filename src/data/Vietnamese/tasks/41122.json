			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mack"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411220201,
					"content": "Chào bạn, tìm tôi có việc gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220202
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220202,
					"content": "Thư lệnh này...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220203
					]
				},
				{
					"id": 411220203,
					"content": "Thư lệnh? Thật là, để tôi xem nào... yêu cầu tôi quay lại thành để giúp đỡ xử lý công việc khác nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220204
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220204,
					"content": "Ôi, trở về thành cũng không phải vấn đề, nhưng bạn xem hai đứa trẻ đó, chúng vẫn chưa chịu về thành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220205
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220205,
					"content": "Cũng không biết người lớn trong nhà đi đâu hết, tôi cũng không thể bắt ép chúng về, vì vậy chỉ có thể tiếp tục ở đây trông coi chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220206
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220206,
					"content": "Trong tình hình này, nếu tôi về thành, lỡ hai đứa trẻ xảy ra chuyện gì phải làm sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220207
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220207,
					"content": "Tôi đã qua nói mấy lần, bây giờ chúng nó không chịu nghe tôi nói nữa rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220208
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220208,
					"content": "À, hay là... bạn qua khuyên chúng giúp tôi? Nói không chừng chúng sẽ nghe lời bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220209
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220209,
					"content": "Nếu như có thể thuyết phục chúng ngoan ngoãn về thành, vậy thì tôi cũng yên tâm trở về rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220210
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220210,
					"content": "Tôi đi thử xem sao.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220211
					]
				},
				{
					"id": 411220211,
					"content": "Vậy thì nhờ bạn nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mack"
				}
			]
		},
