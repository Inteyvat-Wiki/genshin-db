			},
			"dialogs": [
				{
					"id": 411220301,
					"content": "Í? Có việc gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220302
					],
					"speakerTitle": "Jill"
				},
				{
					"id": 411220302,
					"content": "Về tình hình hiện tại...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220303
					]
				},
				{
					"id": 411220303,
					"content": "Chuyện thiên thạch tụi em biết ạ. Có điều... chúng em vẫn chưa bao giờ nhìn thấy thiên thạch rơi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220304
					],
					"speakerTitle": "Jill"
				},
				{
					"id": 411220304,
					"content": "Will nói anh ấy biết một nơi tốt để ngắm thiên thạch, vì vậy tụi em đến đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220305
					],
					"speakerTitle": "Jill"
				},
				{
					"id": 411220305,
					"content": "Ở trong thành cũng có thể thấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220306
					]
				},
				{
					"id": 411220306,
					"content": "Nhưng nếu ở trong thành, phải đến một nơi thật cao mới có thể nhìn thấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220307
					],
					"speakerTitle": "Jill"
				},
				{
					"id": 411220307,
					"content": "Các chú vệ binh trong thành chắc chắn sẽ không để tụi em leo quá cao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220308
					],
					"speakerTitle": "Jill"
				},
				{
					"id": 411220308,
					"content": "Ông chú bên cạnh đồng ý giúp đỡ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220309
					]
				},
				{
					"id": 411220309,
					"content": "#Hả? Ý {F#chị}{M#anh} nói là ông chú kỳ lạ bên kia hả? Nhưng mà lúc nãy chú ấy đến nói chuyện rất hung dữ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220310
					],
					"speakerTitle": "Jill"
				},
				{
					"id": 411220310,
					"content": "Cũng không nói gì khác, chỉ một mực yêu cầu tụi em trở về...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220311
					],
					"speakerTitle": "Jill"
				},
				{
					"id": 411220311,
					"content": "Có điều, nếu chú ấy hứa sẽ đưa tụi em lên một nơi cao để xem thiên thạch, thì em nghĩ... về cũng được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220312
					],
					"speakerTitle": "Jill"
				},
				{
					"id": 411220312,
					"content": "#Nhưng {F#chị}{M#anh} hãy nói với Will đi, dù sao cũng là ý tưởng của bạn ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jill"
				}
			]
		},
