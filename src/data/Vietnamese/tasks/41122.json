			"trigger": {
				"objectNames": [
					"Huffman"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411220101,
					"content": "Haiz, xem ra cũng không còn cách nào khác...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220102
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411220102,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220103
					]
				},
				{
					"id": 411220103,
					"content": "Là bạn à. Là thế này... gần đây thiên thạch từ trên trời rơi xuống, chắc bạn cũng đã thấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220104
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411220104,
					"content": "Mặc dù may mắn là trong thành không bị tác động bởi thiên thạch, nhưng ngoài thành đang rất hỗn loạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220105
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411220105,
					"content": "Rất nhiều người đã vào thành lánh nạnv, còn có những người đang rơi vào hôn mê không rõ nguyên do, việc trong thành sắp rối tung rối mù lên rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220106
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411220106,
					"content": "Tôi muốn gọi tất cả các kỵ sĩ Tây Phong đang thực hiện nhiệm vụ bên ngoài trở về, phải xử lý chu toàn các công việc trong thành trước đã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220107
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411220107,
					"content": "Nhưng họ đang phân tán bên ngoài, hiện tại đội kỵ sĩ cũng không có nhân lực đi tìm họ lúc này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220108
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411220108,
					"content": "Bạn có thể giúp tôi mang thư lệnh này cho họ xem không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220109
					],
					"speakerTitle": "Huffman"
				}
			]
		},
		{
			"id": 4112202,
			"completionStepIds": [
				4112202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4112202",
							"2"
						],
						"stepId": 4112202,
						"stateName": "QUEST_STATE_UNFINISHED"
