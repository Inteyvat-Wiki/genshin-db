			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yabe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722760101,
					"content": "#Hì, bạn là {NICKNAME} đúng không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760102
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760102,
					"content": "Không biết bạn có nhớ tên của tôi không. Tôi là Yabe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760103
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760103,
					"content": "Xin chào, Yabe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722760104
					]
				},
				{
					"id": 722760104,
					"content": "Xin chào xin chào, hì hì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760105
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760105,
					"content": "Kể ra thì thân thủ của bạn cũng lợi hại nhỉ. Vừa đối mặt với Raiden Shogun, lại vừa tung hoành ở Enkanomiya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760106
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760106,
					"content": "Đúng vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722760107
					]
				},
				{
					"id": 722760107,
					"content": "Vậy thì quá tốt rồi. Tôi có manh mối về kho báu, nhưng có thể rất nguy hiểm. Bạn có hứng thú không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760108
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760108,
					"content": "Mặc dù tôi vốn rất thích những thứ bí ẩn, nhưng sau tất cả, tôi vẫn trân trọng cuộc sống nhỏ bé này hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760109
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760109,
					"content": "Tôi có hứng thú, nói tiếp đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722760110
					]
				},
				{
					"id": 722760110,
					"content": "Khi tuần tra ở Dainichi Mikoshi, tôi đã tìm được cái này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760111
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760111,
					"content": "Trông có vẻ chỉ là một phiến đá. Nhưng tôi có cảm giác nó có thể là mấu chốt của \"Kho Báu Bunkoku\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760112
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760112,
					"content": "Kho Báu Bunkoku?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722760113
					]
				},
				{
					"id": 722760113,
					"content": "Lịch sử cụ thể của Vương Quốc Đêm Trắng không được lưu truyền nhiều ở Đảo Watatsumi. Tôi cũng không rõ lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760114
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760114,
					"content": "Có một câu chuyện kể rằng, Bunkoku là tể tướng thứ hai trong lịch sử của Vương Quốc Đêm Trắng, cùng \"Người Con Của Mặt Trời\" bóc lột vơ vét nhân dân. Sau đó hắn giấu tài sản trong căn phòng bí mật của Dainichi Mikoshi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760115
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760115,
					"content": "Cuối cùng, hắn đã che giấu kho báu bằng pháp thuật lửa mặt trời, đồng thời triệu hồi ma quỷ và oán niệm trong địa mạch đến canh giữ kho báu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760116
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760116,
					"content": "Theo lý mà nói, Bunkoku có lẽ cũng có một cái tên cổ xưa như \"Tyeseus\" gì đó. Nhưng chẳng ai muốn ghi lại chi tiết câu chuyện về kẻ phản bội đáng khinh cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760117
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760117,
					"content": "Nói tiếp chuyện phiến đá đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722760118
					]
				},
				{
					"id": 722760118,
					"content": "Có lẽ phiến đá này chính là chìa khóa để mở mật thất kho báu Bunkoku. Tôi là một người hâm mộ lâu năm của thể loại truyền thuyết ma quái và những vụ việc bí ẩn như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760119
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760119,
					"content": "Trên phiến đá này... ừm... chính là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760120
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760120,
					"content": "Nói thật xem nào.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722760121
					]
				},
				{
					"id": 722760121,
					"content": "Thật ra khi tôi tìm thấy phiến đá này trong kho chứa của Dainichi Mikoshi, bên cạnh có một mảnh giấy ghi chú song ngữ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760122
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760122,
					"content": "Văn vật được lưu trữ trong thời kỳ quá độ có vẻ như đều được ghi chú bằng song ngữ. Mà ghi chú có viết, phiến đá này có liên quan trực tiếp với \"Bí Ẩn Bunkoku\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760123
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760123,
					"content": "Ghi chú còn nhắc đến có tổng cộng 8 phiến đá, hiện chỉ thu hồi được phiến đá này. Theo như ghi chép thì Mật Thất Bunkoku cũng ở vị trí gần đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760124
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760124,
					"content": "Vậy thì phiền các bạn qua đó xem xem. Tôi thực sự không quan tâm đến kho báu, có thể chứng kiến cái kết của \"Bí Ẩn Bunkoku\" là tôi vui rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yabe"
				}
			]
		},
