				},
				{
					"id": 722760807,
					"content": "Hừ, vậy thì mau rời khỏi đây đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760808
					],
					"speakerTitle": "Koyanagi"
				},
				{
					"id": 722760808,
					"content": "(Ai đó đã xuống đây trước.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722760809,
					"content": "(Có khi nào, kho báu đã bị họ lấy mất rồi không?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760810,
						722760812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722760810,
					"content": "Không thể nào.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722760811
					]
				},
				{
					"id": 722760811,
					"content": "Cũng phải, nếu họ đã thành công thì kho báu Bunkoku đã không còn là bí ẩn được lưu truyền cho đến ngày nay rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760814
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722760814,
					"content": "Các người lại đang lén lút to nhỏ cái gì đấy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760815
					],
					"speakerTitle": "Koyanagi"
				},
				{
					"id": 722760815,
					"content": "Không có gì, không có gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760816
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722760816,
					"content": "(Chúng ta sẽ tiếp tục điều tra ở đây chứ?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722760812,
					"content": "Đúng vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722760813
					]
				},
				{
					"id": 722760813,
					"content": "Không đúng không đúng. Nếu họ thành công thì kho báu Bunkoku đã được tìm thấy từ lâu rồi, chứ không trở thành bí ẩn cho đến bây giờ.",
