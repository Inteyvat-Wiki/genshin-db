					"Ying'er",
					"Timaeus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716600101,
					"content": "Các bạn về rồi à! Hiệu quả của Ma Dược Tuyết Sương thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600102,
						716600105
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716600102,
					"content": "Nếu có thể dùng ở bên ngoài bí cảnh thì tốt rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716600103
					]
				},
				{
					"id": 716600103,
					"content": "Đúng đúng đúng! Được như vậy sẽ ngon lành hơn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716600104,
					"content": "Ồ? Cảm giác như các bạn đánh giá cũng được ấy nhỉ, có thể nói chi tiết hơn không!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600108
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716600108,
					"content": "Nói chi tiết về trải nghiệm cho Timaeus nghe.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						716600109
					]
				},
				{
					"id": 716600109,
					"content": "Hoàn toàn khớp với những gì cô đã dự đoán đó, tiểu thư Ying'er!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600110
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716600110,
					"content": "Đã xác định được hướng hoàn thiện của Ma Dược Tuyết Sương rồi. Chúng ta cần phải giới hạn phạm vi thăng hoa của thuốc trong một phạm vi nhất định.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600111
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716600111,
					"content": "Có lẽ...lợi dụng đặc tính của bồ công anh, chế tạo ra phụ liệu đặc biệt, có thể khiến thuốc không bị ảnh hưởng bởi sự chuyển động không khí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600112
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716600112,
					"content": "Nhưng cách làm này chưa có tiền lệ, mà cũng không hề đơn giản, cần phải thử nghiệm thật nhiều mới chứng minh được tính khả thi của nó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600113
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716600113,
					"content": "Nghe không hiểu gì hết trơn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716600114,
					"content": "Nhưng mà tôi thấy rằng, tiểu thư Ying'er lần nào cũng đưa ra đề xuất rất quan trọng đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716600115,
					"content": "A ha, nhưng tôi không thể đưa ra dự đoán thực tế và chi tiết như vậy được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600116
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 716600116,
					"content": "Anh giả kim thuật sĩ à, anh đang cố gắng soi mói tâm tư của tôi, hay là đang khen tôi... hay là đang bày trò để làm tôi vui nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600117
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 716600117,
					"content": "Tôi, tôi chỉ là thấy kính phục học thức của tiểu thư Ying'er mà thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600118
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716600118,
					"content": "Được rồi được rồi, vậy anh phải cố gắng thêm nhé, có lẽ sau này còn phải vận dụng đến các kiến thức bên lề nữa đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600119
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 716600119,
					"content": "Khi nào anh nghiên cứu thành công, đừng quên nói cho tôi biết nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600120
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 716600120,
					"content": "Chuyện đó đương nhiên... Đến lúc đó tôi sẽ gửi ma dược tốt nhất đến cho tiểu thư Ying'er làm kỷ niệm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600121
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716600121,
					"content": "Nếu như tiểu thư Ying'er có thời gian, chi bằng cùng chúng tôi đến Vạn Dân Đường nhé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600122
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716600122,
					"content": "Lần \"giao lưu học thuật\" này kết thúc ở đây được rồi, Xuân Hương Diêu còn rất nhiều việc chờ tôi xử lý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600123
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 716600123,
					"content": "Khi nào rảnh, nhớ đến đây thường xuyên nha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600124
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 716600124,
					"content": "Nhất định rồi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716600125
					]
				},
				{
					"id": 716600125,
					"content": "Cảm ơn cô nha, tiểu thư Ying'er!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716600126,
					"content": "Ying'er rời đi.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						716600127
					]
				},
				{
					"id": 716600127,
					"content": "Haiz, rốt cuộc vẫn không nói ra được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600128
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716600128,
					"content": "Nhưng mà, gần đây đã gây nhiều phiền phức cho tiểu thư Ying'er rồi, không nên làm mất thời gian của cô ấy nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600129
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716600129,
					"content": "Bình tâm lại, chờ thời cơ thích hợp sẽ tốt hơn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600130
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716600130,
					"content": "Anh đang lẩm bẩm gì vậy, Timaeus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716600131,
					"content": "Không có gì!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600132
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716600132,
					"content": "Thời gian này làm phiền các bạn quá rồi! Như đã hứa, tôi sẽ mời hai bạn đến Vạn Dân Đường ăn một bữa no say.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600133
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716600133,
					"content": "Xém xíu tôi quên mất...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716600134
					]
				},
				{
					"id": 716600134,
					"content": "Đúng rồi, ăn ngon ăn ngon! Chúng ta đi mau đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716600135,
					"content": "Cùng Timaeus đến Vạn Dân Đường thưởng thức bữa ăn thịnh soạn.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						716600136
					]
				},
				{
					"id": 716600136,
					"content": "Ợ...! Ăn no ghê, thật thỏa mãn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716600137,
					"content": "Thật ra lần nghiên cứu này cũng thú vị lắm đó, Timaeus! Sau này nếu có đến Liyue, hãy nhớ rủ bọn tôi nha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600138,
						716600139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716600138,
					"content": "Paimon không quan tâm chuyện nghiên cứu đâu nhỉ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716600140
					]
				},
				{
					"id": 716600140,
					"content": "Nói gì dợ! Rõ ràng là tôi đã bỏ sức... bỏ sức ra để đi đường mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600141
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716600141,
					"content": "Tóm lại, rất cám ơn hai bạn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600142
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716600142,
					"content": "Nhưng sau khi về Mondstadt, tôi sẽ dốc toàn tâm toàn ý vào việc cải tiến Ma Dược Tuyết Sương, e rằng sẽ rất lâu sau mới đến Liyue được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600143
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716600143,
					"content": "Có lẽ không lâu sau lại phải nhờ các bạn gửi thư giúp. Lúc nãy tôi chưa kịp tỏ lòng cảm ơn với tiểu thư Ying'er.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600144
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716600144,
					"content": "Ủa? Hai người rõ ràng đã nói chuyện lâu như vậy mà, sao anh lại không nói trực tiếp với cô ấy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716600145,
					"content": "Hì hì! Tiểu thư Ying'er nói chuyện quả thật quá... đặc biệt! Tôi phải suy nghĩ trau chuốt từ ngữ, nên dĩ nhiên viết thư sẽ thích hợp hơn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600146
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716600146,
					"content": "Thời gian cấp bách, chúng ta mau chuẩn bị về Mondstadt thôi, tôi nóng lòng muốn bắt tay vào chế tạo Ma Dược Tuyết Sương hoàn hảo quá rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600147
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716600147,
					"content": "Sao tôi cứ thấy sau khi tạm biệt tiểu thư Ying'er xong, phản ứng của Timaeus cứ lạ lạ thế nào ấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600148
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716600148,
					"content": "Thật khó hiểu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716600139,
					"content": "Paimon chỉ muốn ăn ké thôi chứ gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716600140
					]
				},
				{
					"id": 716600105,
					"content": "Vẫn có thể phát triển thêm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716600106
					]
				},
				{
					"id": 716600106,
					"content": "Đúng vậy đó, ví dụ như... có thể khiến có phát huy tác dụng bên ngoài bí cảnh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716600107,
					"content": "Ừm, tôi đang thảo luận với tiểu thư Ying'er về vấn đề này, phiền các bạn hãy nói chi tiết hơn về trải nghiệm nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600108
					],
					"speakerTitle": "Timaeus"
				}
			]
		}
	]
}