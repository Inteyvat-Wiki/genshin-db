	"talks": [
		{
			"id": 2201701,
			"completionStepIds": [
				2201701
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201701",
							"2"
						],
						"stepId": 2201701,
						"stateName": "QUEST_STATE_UNFINISHED"
