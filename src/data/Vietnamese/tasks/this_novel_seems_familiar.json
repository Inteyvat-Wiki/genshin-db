		},
		{
			"id": 2201704,
			"completionStepIds": [
				2201706
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201706",
							"2"
						],
						"stepId": 2201706,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Shigeru",
					"Junkichi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220170401,
					"content": "Quyển tiểu thuyết kinh dị này tôi nhớ đã hot trong một thời gian dài, không phải rất được ưa chuộng sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170402
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170402,
					"content": "Sự thành công của quyển tiểu thuyết này đến từ việc thiết kế kịch bản và câu đố tinh tế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170403
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170403,
					"content": "Tuy có nhiều độc giả phản hồi là những kịch bản này quá bất ngờ, có nhiều chỗ không thể lý giải, nhưng tác giả vẫn muốn kiên trì với nguyên tác của mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170404
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170404,
					"content": "Làm như vậy thì quyển tiểu thuyết này mới khác biệt so với những quyển cùng loại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170405
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170405,
					"content": "Nhưng quyển tiểu thuyết này cũng có sườn bài cơ bản, chỉ khi kiên định và không dễ dãi thay đổi tình tiết quá nhiều thì mới có thể trở thành một bộ tiểu thuyết hay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170406
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170406,
					"content": "Cái...cái này, nhà lữ hành, còn quyển nào khác không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				}
			]
		},
		{
			"id": 2201705,
			"completionStepIds": [
				2201705
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201705",
							"2"
						],
						"stepId": 2201705,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Shigeru",
					"Junkichi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220170501,
					"content": "Quyển này sao? Lối kể truyện của quyển này rất hay, kịch bản và tình tiết cũng được lên kế hoạch cẩn trọng, được các nhà biên tập đánh giá rất cao, doanh số bán được cũng rất tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170502
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170502,
					"content": "...Vậy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170503
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170503,
					"content": "Quyển tiểu thuyết này quá xem trọng dàn bài và khuôn khổ, không để cho câu chuyện có chút không gian phát triển nào, đến cuối cùng tình tiết sau này toàn bị độc giả đoán trúng cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170504
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170504,
					"content": "Chính vì không có những câu chuyện mới mẻ gì nên quyển tiểu thuyết này đã mất dần độc giả, mất dần đi vị thế của mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170505
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170505,
					"content": "Dù cho là kịch bản hoặc tình tiết đi nữa, nếu như bị đóng trong cái khung cố định thì mỗi câu chuyện kể ra đều sẽ như nhau, hoàn toàn không có sức sống.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170506
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170506,
					"content": "Tôi không muốn tiểu thuyết của tôi cũng giống như vậy! Một câu chuyện hay thì đầu tiên phải có sức sống khác biệt với mọi người!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170507
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170507,
					"content": "Vả lại, nếu như...nếu như bản thân tác giả cũng không thấy có hứng thú với câu chuyện của mình, vậy thì làm sao để truyền lửa được cho độc giả đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170508
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170508,
					"content": "Anh Shigeru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170509
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170509,
					"content": "...Tôi biết rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170510
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170510,
					"content": "Không ngờ cái tên như anh cũng suy nghĩ được khá nhiều đấy, không hổ danh là tác giả của bộ \"Quỷ Võ Đạo\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170511
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170511,
					"content": "Thực ra, tôi không phải muốn giới hạn khả năng sáng tạo của anh. Nhưng tôi đã chứng kiến qua rất nhiều tác giả vì quá bay bổng nên đã tự hủy hoại tác phẩm của mình...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170512
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170512,
					"content": "Junkichi, tôi không biết rằng anh định nghĩa về sáng tạo là như thế nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170513
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170513,
					"content": "Tôi cho rằng nếu tác giả mà không có khả năng sáng tạo thì sẽ không thể nào làm ra được một tác phẩm xuất chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170514
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170514,
					"content": "Theo tôi thấy, đối với một tác giả mà nói, khả năng kiềm chế sáng tạo mới quan trọng hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170515,
						220170516
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170515,
					"content": "Vẫn chưa có được tiếng nói chung nhỉ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220170517
					]
				},
				{
					"id": 220170517,
					"content": "Anh Shigeru, tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170518
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170518,
					"content": "Nhưng mà người viết tiểu thuyết không phải là tôi, mà là anh, tôi chỉ là một biên tập đang cố gắng giúp anh hoàn thiện tác phẩm mà tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170519
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170519,
					"content": "Nếu anh thực sự kiên trì với ý tưởng của anh thì anh cứ sáng tác theo ý anh vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170520
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170520,
					"content": "Tôi không thể nói rằng tôi tán đồng ý kiến của anh, tôi chỉ có thể nói là tôi sẽ cố gắng để hiểu anh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170521
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170521,
					"content": "...Cảm ơn anh! Anh Shigeru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170522
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170522,
					"content": "Không sao, đây là việc mà tôi nên làm. Và dĩ nhiên, tôi hiểu cho anh, thì anh cũng phải hiểu cho tôi, ví dụ như...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170523
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170523,
					"content": "Sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170524
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170524,
					"content": "Ví dụ như, ngày hôm nay gần kết thúc rồi...bản thảo của anh đâu?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170516,
					"content": "Vẫn chưa thể thuyết phục được nhau nhỉ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220170517
					]
				}
			]
