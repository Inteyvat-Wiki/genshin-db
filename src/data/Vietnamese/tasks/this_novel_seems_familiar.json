				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Junkichi",
					"Shigeru"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220170101,
					"content": "Không viết nữa không viết nữa! Lần này có hối tôi thế nào cũng vô ích! Tôi không làm tác giả nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170102
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170102,
					"content": "Cái tên này...anh đã bảy lần nói đình công để uy hiếp tôi rồi đấy, có lần nào là làm thật đâu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170103
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170103,
					"content": "Hai người lại tranh cãi gì đó...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220170104
					]
				},
				{
					"id": 220170104,
					"content": "Bạn cuối cùng cũng đến rồi! Hãy giúp tôi vụ này nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170105
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170105,
					"content": "Lần trước sau khi bạn nói giúp cho tên này, anh ta tìm được lý do rồi càng ngày càng quá đáng, đặt ra cho tôi cả chục cái quy định!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170106
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170106,
					"content": "Nhỏ thì giới hạn tên riêng, lớn thì giới hạn tình tiết, không biết anh ta đặt ra cái tiêu chuẩn gì cho tiểu thuyết nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170107
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170107,
					"content": "Nếu đã vậy thì tôi còn viết tiểu thuyết gì nữa chứ, anh ta tự dựa theo dàn bài của anh ta rồi viết là được rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170108
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170108,
					"content": "Đó đều là những nguyên tắc và kinh nghiệm rút ra được của những bộ tiểu thuyết đã thành công trước đó đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170109
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170109,
					"content": "Vậy còn không phải là ép tôi viết như một tác phẩm khác sao? Vậy rốt cuộc là tôi viết tiểu thuyết hay là các \"tiền bối\" đó viết tiểu thuyết thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170110
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170110,
					"content": "Tôi sẽ không bao giờ viết những tiểu thuyết cứng nhắc đó. Muốn viết thì anh tự đi mà viết!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170111
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170111,
					"content": "Vả lại, không phải loại tác phẩm này của \"Nhà Xuất Bản Yae\" đều đang ế hàng sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170112
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170112,
					"content": "Đó chỉ là sai lầm trong chiến dịch quảng cáo thôi, không phải lỗi do nội dung tiểu thuyết...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170113
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170113,
					"content": "Cái này căn bản không liên quan đến chiến dịch quảng cáo gì cả, chỉ đơn giản là do cách viết của những tác giả đó có vấn đề.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170114
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170114,
					"content": "Anh chắc không để ý là mỗi quyển tiểu thuyết do \"Nhà Xuất Bản Yae\" phát hành, tôi đều sẽ đọc hết sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170115
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170115,
					"content": "Nhà lữ hành, bạn giúp tôi lấy vài cuốn tiểu thuyết đến đây, để tôi nói chuyện với anh ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170116,
						220170117
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170116,
					"content": "Cứ để tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 220170117,
					"content": "Bạn cần tiểu thuyết gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220170118
					]
				},
				{
					"id": 220170118,
					"content": "Bạn mang những cuốn tiểu thuyết xung quanh tới đây là được, tôi thường hay dùng những tiểu thuyết đó đế...cảnh cáo anh ta, rằng tuyệt đối không được viết thành như thế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				}
			]
		},
		{
