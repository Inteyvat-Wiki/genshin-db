						220170202
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170202,
					"content": "Hừ, nếu như để anh ta muốn viết gì thì viết mới là hủy hoại cả bộ tiểu thuyết đấy.",
					"roleType": "TALK_ROLE_NPC",
