						401730302
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730302,
					"content": "(Thế mà lại để tên đó trốn thoát! Ôi, tệ quá đi... Vừa rồi trông mình còn rất tự tin mà! Trời ơi! Hình tượng của mình...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730303
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730303,
					"content": "(Tuy cái tên Kokuchuu đó rất giỏi chạy trốn, nhưng mình cũng phải nghĩ ra một lời giải thích hợp lý mới được...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730304
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730304,
					"content": "Citlali! Cô đã bắt được tên Kokuchuu đó chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730305,
					"content": "Nhìn thấy trong hang động chỉ có mỗi mình bà thế kia, chắc là vẫn chưa rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730306
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730306,
					"content": "Chậc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730307
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730307,
					"content": "Tôi đã tạm tha cho hắn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730308
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730308,
					"content": "Nhưng tôi đã để lại ký hiệu trên người hắn ta rồi. Nếu hắn xuất hiện ở gần đây thì tôi sẽ theo dõi được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730309
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730309,
					"content": "Ra là bà giả vờ rời khỏi hang động, nhưng thật ra là nấp đi để giăng sẵn cái bẫy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730310
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730310,
					"content": "À! Là giống như lúc bắt Ororon à!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730311,
					"content": "Nhưng mà làm sao Citlali biết được cái tên đó sẽ tới đây chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730312,
					"content": "Vì tôi đã thả mồi nhử. Bản đồ Vùng Biển Lặng và mảnh cung đó, tôi cố ý đặt trên bàn, vì chúng có thể là mục đích của Kokuchuu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730313
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730313,
					"content": "Quả nhiên không lâu sau khi chúng ta rời đi, cái bẫy mà tôi để lại đã bị kích hoạt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730314
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730314,
					"content": "Sao cơ? Thì ra trong hang có bẫy thật!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730315,
					"content": "Tất nhiên, chỉ là tôi đã để chế độ tự động bỏ qua các người thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730316
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730316,
					"content": "Thấy chưa, tôi nói có sai đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730317
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730317,
					"content": "Kokuchuu hóa ra đã thật sự lợi dụng mình... Thì ra mục đích thực sự lại là thông tin về Vùng Biển Lặng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730318
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730318,
					"content": "Đúng thế. Ban đầu ta đã nghĩ là sao tên đó lại để mảnh ghép ở đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730319
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730319,
					"content": "Khi có được vị trí của Vùng Biển Lặng thì ta đã hiểu ra, mảnh vỡ đó chính là mồi nhử.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730320
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730320,
					"content": "Hắn ta biết Leyla chắc chắn sẽ gặp chuyện, mà bộ tộc cũng sẽ không bỏ mặc. Nhất định sẽ có người tới giúp Leyla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730321
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730321,
					"content": "Ồ! Có nghĩa là hắn ta định câu một người có năng lực thật sự để tới đây giúp hắn ta thấu thị mảnh vỡ này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730322,
					"content": "Đúng thế. Và người cắn câu là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730323
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730323,
					"content": "Xin lỗi, là cháu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730324
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730324,
					"content": "Và cũng có cả bà nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730325
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730325,
					"content": "Cái tên nhóc này! Bà là vì cháu đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730326
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730326,
					"content": "Dù sao đi nữa thì tên Kokuchuu này cũng thật xảo quyệt. Hắn lựa chọn phương án có rủi ro thấp nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730327
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730327,
					"content": "Đúng vậy. Nếu tên đó đi tìm Citlali thì chắc chưa đầy một phút là đã bị vạch trần rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730328
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730328,
					"content": "Nói đi cũng phải nói lại, tại sao Citlali lại tha cho hắn ta chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730329,
					"content": "À ừm... Vì ở đây không tiện thi triển toàn bộ sức mạnh. Hắn ta rất giỏi chạy trốn, nên nếu ép hắn ở lại đây thì có khi sẽ xảy ra chuyện mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730330
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730330,
					"content": "Chẳng lẽ là do chọn sai chỗ sao...? Thật xin lỗi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730331
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730331,
					"content": "Ban đầu vì để cứu Leyla, nên tôi muốn tìm một khu vực giàu năng lượng tâm linh nhất, nên đã tìm đến căn cứ của hiền giả điên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730332
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730332,
					"content": "Hiền giả điên...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730333
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730333,
					"content": "Đúng vậy. Người đó ở sau bức tường kia, nếu đánh thức thì cũng phiền phức đấy. Đó là lý do tôi quyết định không sử dụng hết khả năng của mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730334
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730334,
					"content": "Nhưng giờ vẫn còn một tin tốt: Đó là đã lấy lại được bản đồ và mảnh vỡ rồi. Bà Citlali đây cũng không phải người dễ dàng chịu thiệt đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730335
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730335,
					"content": "Tốt quá! Vậy là hắn ta chỉ có thể tay không chạy trốn thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730336
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730336,
					"content": "Nhưng có một tin xấu là: Hắn ta đã xem bản đồ đó rồi. Tuy vị trí khi Vùng Biển Lặng biến mất cũng không phải là bí mật gì lớn lắm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730337
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730337,
					"content": "Hả? Lo thật đấy! Tên đó sẽ không làm ra chuyện gì xấu xa chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730338
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730338,
					"content": "Đừng quá lo lắng, tôi sẽ truy tìm hắn ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730339
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730339,
					"content": "#Ngoài ra thì Leyla, nếu không phản đối thì ta muốn đưa bản đồ và mảnh vỡ này cho {NICKNAME}. Như vậy sẽ có thể giúp ích cho {F#cô}{M#cậu} ấy trong chuyến hành trình tương lai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730340
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730340,
					"content": "#Tất nhiên là không phản đối rồi! {NICKNAME} xứng đáng nhận được mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730341
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730341,
					"content": "Như vậy thì có quý giá quá không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401730342
					]
				},
				{
					"id": 401730342,
					"content": "#Dù sao thì bộ tộc cũng chẳng quan tâm. Nếu nó thực sự chỉ tới Vùng Biển Lặng, thì những nhà mạo hiểm như {F#cô}{M#cậu} chắc chắn sẽ không muốn bỏ lỡ nó đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730343
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730343,
					"content": "Đây là dự cảm của Bà Itztli đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730344
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730344,
					"content": "À ừm... Bà Itztli, còn một chuyện nữa, bây giờ cháu vẫn là một kẻ thiếu nhạy cảm tâm linh phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730345
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730345,
					"content": "Hỏi gì thế? Không phải là cậu đã nhận ra ảo ảnh của ta rồi sao? Mặc dù là ta đã cố tình để lộ sơ hở, nhưng đó không phải là thứ mà một kẻ không có chút nhạy cảm nào có thể nhìn thấu đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730346
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730346,
					"content": "Ororon, sau này rảnh rỗi thì phải dạy dỗ cậu ta nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730347
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730347,
					"content": "Còn học được đến đâu thì phải xem bản lĩnh của cậu rồi đấy, Leyla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730348
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730348,
					"content": "Tốt quá, cuộc sống thật kỳ diệu. Chỉ cần tiến về phía trước thì nói không chừng sẽ gặp được phân bón đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730349
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730349,
					"content": "Leyla, mừng cho anh. Sau này phải cùng nhau cố gắng nhé. Hy vọng chúng ta đều sẽ trở thành những cây bắp cải xinh đẹp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ororon"
				}
			]
		},
