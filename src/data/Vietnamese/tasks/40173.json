			"dialogs": [
				{
					"id": 401730101,
					"content": "Chào mọi người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730102
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730102,
					"content": "Citlali tới rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730103,
					"content": "Ừm, tôi đã đến chỗ thủ lĩnh để lấy thanh kiếm nghi lễ. Mượn sức mạnh của nó sẽ có thể hoàn thành vài việc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730104
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730104,
					"content": "Vẫn còn nhớ hôm nay chúng ta phải làm gì chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730105
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730105,
					"content": "Tất nhiên rồi. Chúng ta đều đang chờ Leyla tỉnh lại để hỏi cho rõ ràng xem đã xảy ra chuyện gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730106,
					"content": "Cháu cũng đã chuẩn bị sẵn đồ dự phòng theo lời bà dặn rồi. Hôm nay chắc hẳn sẽ không có sơ suất gì đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730107
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730107,
					"content": "Tốt lắm. Vậy không nói nhiều nữa, chúng ta bắt đầu thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730108
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730108,
					"content": "Citlali triệu hồi thanh kiếm nghi lễ có tên \"Tai Họa Eshu\".",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401730109
					]
				},
				{
					"id": 401730109,
					"content": "Hiến tế từ làn khói huyền bí. Những vì sao hiến tế cho màn đêm không trăng, vòng hoa mơ ước hiến tế cho cơn gió xoáy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730110
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730110,
					"content": "Hiến tế cho Chấp Chính Của Cái Chết. Phai mờ. Phai mờ. Phai mờ. Lặp lại ba lần, rồi lại ba lần nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730111
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730111,
					"content": "Woa! Đây là thần chú gì thế nhỉ? Tự nhiên thấy lạnh quá! Có phải có thứ gì đó đang đến không!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730112,
					"content": "Nói nhỏ thôi. Bây giờ không được làm phiền đến bà đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730113
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730113,
					"content": "Chúng ta, con cháu của vua tư tế, phải tuân theo giao ước cổ xưa, xé tan tấm rèm của màn đêm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730114
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730114,
					"content": "Ta là Citlali, hãy nghe lệnh ta. Ta là người chăm nom của ngày tận thế, ta là Ah K'ulbatil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730115
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730115,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730116
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730116,
					"content": "Nhìn kìa! Phần tinh thần của Leyla đang về với anh ấy rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730117
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730117,
					"content": "Ta sẽ xuyên qua màn đêm bằng lưỡi dao, xua đuổi mọi linh hồn không thuộc về vương quốc của người chết.\\n",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730118
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730118,
					"content": "Leyla! Hãy tuân lệnh ta, trở về vùng đất nơi mặt trời chiếu sáng, trở về con đường của riêng ngươi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730119
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730119,
					"content": "Thành, thành công rồi ư?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730120,
					"content": "Ơ... Ối? Đây là...? Các người...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730121
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730121,
					"content": "Ốiii! Bà Itztli! À không không... Đại tư tế Citlali! Xin... Xin hãy nương tay!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730122
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730122,
					"content": "Tên tiểu quỷ này, chắc là biết rõ mình đã làm gì rồi nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730123
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730123,
					"content": "Có biết là bản thân đã suýt chút nữa không thể quay về không hả? Tự biến mình thành cái vỏ rỗng thú vị lắm à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730124
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730124,
					"content": "Cháu xin lỗi... Hãy cứ trừng phạt cháu đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730125
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730125,
					"content": "Ồ? Nói thật lòng đó à? Thế thì mau về nhà nói lời từ biệt với cha mẹ đi. Bảo là:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730126
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730126,
					"content": "\"Tạm biệt cha mẹ, con thích cuộc sống như chiếc vỏ rỗng, nên đã quyết định nhờ Bà Itztli biến thành bức tượng đá, thay bà ấy trông nhà một trăm năm.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730127
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730127,
					"content": "Đừng mà, cháu biết lỗi rồi! Vô cùng cảm ơn đại tư tế Citlali đã cứu cháu trở về!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730128
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730128,
					"content": "Hừm, cảm ơn cháu của ta kìa. Nếu không phải nó phát hiện ra sự bất thường thì ta cũng chẳng muốn quan tâm đến chuyện này đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730129
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730129,
					"content": "Không có gì đâu, Leyla. Bà ấy khẩu xà tâm phật ấy mà, chúng tôi sẽ không trách anh đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730130
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730130,
					"content": "Mà có người đã lừa anh làm thế đúng không? Tên Kokuchuu đó hẳn là thủ phạm thực sự.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730131
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730131,
					"content": "Không... Không liên quan đến ngài Kokuchuu đâu. Là tôi muốn làm vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730132
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730132,
					"content": "Hở?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730133,
					"content": "Mặc dù ngài ấy là người đã chỉ cho tôi cách sử dụng di vật mạnh mẽ làm trung gian, nhưng chính tôi mới là người quyết định làm như vậy. Ngài ấy không ép buộc gì tôi cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730134
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730134,
					"content": "Xin lỗi, nếu muốn trách thì chỉ có thể trách tôi thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730135
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730135,
					"content": "Hah, tên tiểu quỷ này bị tẩy não thật rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730136
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730136,
					"content": "Ừm... Vậy mảnh vỡ làm trung gian đó là do tên Kokuchuu kia đem tới sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730137,
					"content": "Đúng thế. Ngài ấy nói đó là bảo vật có liên quan đến Vùng Biển Lặng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730138
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730138,
					"content": "Đó, vừa nhìn là biết đang lợi dụng anh mà! Lợi dụng anh để thấu thị đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730139,
					"content": "Nhưng tôi chỉ là một người không nhạy cảm tâm linh, chẳng học được phép thuật gì cả... Như vậy thì có giá trị gì để lợi dụng chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730140
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730140,
					"content": "Những người như tôi không thể cảm nhận được phần tinh thần cần thiết, ngay cả khi dành cả phần đời còn lại để thiền.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730141
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730141,
					"content": "Ngài Kokuchuu nói là nếu sử dụng các phương pháp khác để ép tôi thi triển phép thuật, khiến bản thân đắm mình vào lượng lớn tinh thần, thì tôi sẽ có cơ hội bắt được tung tích của chúng. Cho nên...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730142
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730142,
					"content": "Đây rõ ràng là biết sai mà còn cố lao vào đấy! Nếu không có Citlali thì anh đã không về được rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730143
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730143,
					"content": "Xin lỗi... Xin lỗi... Mọi người trong tộc đều rất tài năng, còn tôi lại là kẻ ngốc... Tôi chỉ không muốn làm một kẻ khác người nữa thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730144
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730144,
					"content": "Tôi hiểu mà... Leyla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730145
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730145,
					"content": "Có những hạt giống sẽ phát triển thành cây bắp cải xinh đẹp mà không cần nỗ lực nhiều, nhưng cũng có những hạt khác sẽ không bao giờ nảy mầm dù chúng có cố gắng đến đâu đi chăng nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730146
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730146,
					"content": "Tôi không biết tại sao lại như vậy, có lẽ đây là cuộc sống chăng? Luôn có nhiều chuyện không thể cưỡng cầu mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730147
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730147,
					"content": "Dù điều này nói ra khá vô ích, nhưng tôi hy vọng anh có thể tự mình điều chỉnh lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730148
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730148,
					"content": "Tóm lại thì có gì để nói sau đi. Bây giờ thì theo ta đến chỗ Matla kiểm tra sức khỏe trước đã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Citlali"
				}
			]
		},
		{
			"id": 4017302,
			"completionStepIds": [
				4017303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
