			"dialogs": [
				{
					"id": 401730201,
					"content": "Được rồi, tốt lắm... Sức khỏe không có vấn đề gì, chỉ là đói quá thôi. Quay về ăn nhiều thêm chút là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730202
					],
					"speakerTitle": "Matla"
				},
				{
					"id": 401730202,
					"content": "Vậy thì tốt quá. Tôi từng nghe nói là có tình trạng các bộ phận của cơ thể bị hoại tử do xuất hồn quá lâu đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730203
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730203,
					"content": "Nghe ghê quá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730204,
					"content": "Ừm, tóm lại thì Leyla, tuy trước đây chúng ta không quen biết nhau, nhưng bây giờ anh không sao là tốt rồi, mừng cho anh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730205
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730205,
					"content": "Thực ra thì Ororon, chỉ có anh không biết tôi thôi... Còn tôi thì đã nghe qua về anh từ lâu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730206
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730206,
					"content": "#Còn cả đại tư tế Citlali, {NICKNAME} và Paimon nữa. Chuyện về mọi người tôi đều biết cả...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730207
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730207,
					"content": "#Hả? Cả tôi và {NICKNAME} mà cũng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730208,
					"content": "Nói ra thì cũng ngại, mọi người đều là những người mà tôi mơ ước trở thành... Nhưng sự thật đã chứng minh, tôi chỉ có thể đứng ở ngoài mà ngưỡng mộ thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730209
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730209,
					"content": "Ai bảo tôi sinh ra đã là kẻ không nhạy cảm tâm linh chứ? Haha, nhưng không sao, tôi đã quen với những ngày tháng bị ngó lơ rồi. Cảm ơn mọi người đã cứu tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730210
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730210,
					"content": "Ororon, anh nói đúng... Có lẽ đây chính là cuộc sống. Sau này tôi sẽ không làm những chuyện nguy hiểm như vậy nữa, làm phiền mọi người rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730211
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730211,
					"content": "Leyla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730212,
					"content": "Không cần phải an ủi tôi đâu, haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730213
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730213,
					"content": "Ê, tên tiểu quỷ này đang nói cái gì thế? Nhìn ta đây này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730214
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730214,
					"content": "Ơ? Đại tư tế Citlali, có chuyện gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730215
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730215,
					"content": "Bảo nhìn thì nhìn cho kỹ đi, có cảm nhận được điều gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730216
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730216,
					"content": "Bà đang nói gì thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730217
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730217,
					"content": "#Này... {NICKNAME} nói xem, có phải trên mặt Citlali cũng có mấy chữ \"tốt bụng thích giúp đỡ\" không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730218,
					"content": "Đợi đã, hình như là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730219
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730219,
					"content": "Không biết có phải do ảo giác hay không, nhưng cảm thấy cơ thể của đại tư tế Citlali chỉ là ảo ảnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730220
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730220,
					"content": "Không... Chắc chắn là ảo giác rồi. Làm sao có thể nhìn ra được chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730221
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730221,
					"content": "Đợi đã, trò này... Là phép thuật mà mình đã dùng. Cơ thể thật của bà đã ở rất xa mọi người. Bà ấy đã lẻn đi rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730222
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730222,
					"content": "Thấy rồi đúng không? Cậu đã phát hiện ra đôi chút khác thường của tinh thần rồi đấy. Chúc mừng nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730223
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730223,
					"content": "Thật... thật sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730224
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730224,
					"content": "Nhưng mà bà đi đâu thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730225
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730225,
					"content": "Tên ngốc này, đương nhiên là đi \"câu cá\" rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730226
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730226,
					"content": "Có người đã đạp trúng bẫy trong hang. Có vẻ như tên Kokuchuu đó đã cắn câu rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730227
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730227,
					"content": "Sao cơ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730228,
					"content": "Chuyện phiếm thì để sau đi, gặp nhau ở hang động nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Citlali"
				}
			]
		},
