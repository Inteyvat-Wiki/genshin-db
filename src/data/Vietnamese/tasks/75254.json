			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tecuhtli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752540101,
					"content": "Chào mừng đến với Paititi trong mơ của Đảo Tete!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540102
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540102,
					"content": "Đi về phía trước là Quán Rượu Mật Ngọt và Quán Rượu Sương Sớm. Tôi là Tecuhtli, người tiếp đón của quán rượu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tecuhtli"
				}
			]
		},
		{
			"id": 7525402,
			"completionStepIds": [
				7525403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7525403",
							"2"
						],
						"stepId": 7525403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tecuhtli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752540201,
					"content": "#Bạn thân mến, nếu đã uống nước ép chào mừng của tôi rồi, vậy thì tôi sẽ cho {F#cô}{M#cậu} một lời khuyên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540202
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540202,
					"content": "#Nếu {F#cô}{M#cậu} chỉ là người bình thường đến nghỉ ngơi, thì đừng tới gần bờ phía bắc của Đảo Tete, ở đó không có thứ gì có thể giúp {F#cô}{M#cậu} thư giãn cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tecuhtli"
				}
			]
		},
		{
			"id": 7525403,
			"completionStepIds": [
				7525401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7525401",
							"2"
						],
						"stepId": 7525401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tecuhtli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752540309,
					"content": "Được rồi, vậy chuyện gì xảy ra với mắt của anh vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752540310
					]
				},
				{
					"id": 752540310,
					"content": "Haha, do một gã đầu trọc gây ra. Anh ta để lại dấu ấn này trên người tôi... Giờ anh ta cũng ở trên hòn đảo này. Hmm, tôi phải \"cảm ơn\" anh ta cho đàng hoàng mới được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540311
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540311,
					"content": "#Tôi biết sau khi nghe xong câu chuyện này, chắc chắn {F#cô}{M#cậu} cũng muốn trả thù cho tôi phải không? Nhưng không cần đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540312
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540312,
					"content": "Bạn thân mến, không ai nên cảm thấy bi thương trong ngày hè tuyệt đẹp này đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540313
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540313,
					"content": "Mời thưởng thức nước ép mà tôi đã chuẩn bị cho từng vị khách, hãy thoải mái tận hưởng khoảng thời gian nhàn nhã này nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540314
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540314,
					"content": "#{F#Cô}{M#Cậu} sẽ tìm thấy đồ uống của mình ở trên chiếc kệ đằng kia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tecuhtli"
				}
			]
		},
		{
			"id": 7525404,
