					"Tecuhtli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752540603,
					"content": "#Ồ? {F#Cô}{M#Cậu} hỏi mắt của tôi sao? Haha, đây là ba việc mà đàn ông nhất định phải tu luyện trong đời.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540604
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540604,
					"content": "Thứ nhất, một cơ thể đã trải qua sóng gió, chí ít phải có một vết sẹo, nếu không sẽ không thể ám chỉ người đàn ông này từng trải qua cuộc đời phức tạp, điều này khiến anh ta mất đi chiều sâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540605
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540605,
					"content": "Thứ hai, dùng trang phục hoặc trang sức để che vết sẹo, giữ thái độ khiêm tốn nhưng đừng che hết, nếu không người bên cạnh sẽ không nhận ra sự đặc biệt của người đàn ông này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540606
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540606,
					"content": "Thứ ba...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540607
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540607,
					"content": "Khoan đã, tôi không hề hỏi về mắt của anh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752540608
					]
				},
				{
					"id": 752540608,
					"content": "Phải không? Đúng vậy! Đây chính là điều thứ ba tôi muốn nói: Nếu người bên cạnh vẫn chưa chú ý thì nhất định phải nghĩ cách chủ động nhắc đến...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tecuhtli"
				}
			]
		},
