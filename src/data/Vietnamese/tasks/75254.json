			},
			"dialogs": [
				{
					"id": 752540509,
					"content": "Hình như chúng ta đã từng gặp nhau ở đâu rồi thì phải?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752540501
					]
				},
				{
					"id": 752540501,
					"content": "Đây là dấu ấn số phận đặt lên người phi phàm, để lần đầu gặp gỡ giữa hai ta cũng giống như sự tương phùng sau một thời gian dài xa cách vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540502
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540502,
					"content": "Nhìn chiếc bịt mắt như ác lang của tôi, chắc cũng đã nhận ra sự phi thường của tôi rồi nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tecuhtli"
				}
			]
		},
		{
			"id": 7525406,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
