			"dialogs": [
				{
					"id": 722070101,
					"content": "Vẫn chưa đủ...chưa đủ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722070102
					],
					"speakerTitle": "Shitoki"
				},
				{
					"id": 722070102,
					"content": "Kho báu mà anh trai để lại cho tôi đều nằm trong ốc biển đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722070103
					],
					"speakerTitle": "Shitoki"
				},
				{
					"id": 722070103,
					"content": "Ốc biển ơi ốc biển, nằm vương vãi khắp nơi...chỗ nào cũng là nó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722070104
					],
					"speakerTitle": "Shitoki"
				},
				{
					"id": 722070104,
					"content": "Là kho báu của anh trai đó...bây giờ tôi chưa đi được đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722070105,
						722070106
					],
					"speakerTitle": "Shitoki"
				},
				{
					"id": 722070105,
					"content": "Kho báu...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722070107
					]
				},
				{
					"id": 722070107,
					"content": "Lúc anh trai đi đến cái nơi ngoài biển sương mù, tư tế đại nhân đã rất tức giận...ông ấy nói linh hồn của anh ấy sẽ không bao giờ trở về nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722070108
					],
					"speakerTitle": "Shitoki"
				},
				{
					"id": 722070108,
					"content": "Nhưng anh ấy đã nói: \"Nơi đó có hoa đẹp, có biển trân châu...cha cũng chèo thuyền ở đó, dẫn theo em gái cùng vẫy tay nữa...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722070109
					],
					"speakerTitle": "Shitoki"
				},
				{
					"id": 722070109,
					"content": "Anh trai đã để lại kho báu của mình và không bao giờ trở về...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shitoki"
				},
				{
					"id": 722070106,
					"content": "Về anh trai...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722070107
					]
				}
