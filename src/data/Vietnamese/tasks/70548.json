						"stepId": 7054806,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lisa"
				],
				"points": [
					{
						"sceneId": 51203,
						"position": [
							2191.695,
							230.219,
							-780.41
						],
						"pointId": 1
					},
					{
						"sceneId": 51203,
						"position": [
							2194.736,
							230.089,
							-781.087
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 705480201,
					"content": "Ly này là Tiếng Tuyết Hừng Đông, mời thưởng thức.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480202
					]
				},
				{
					"id": 705480202,
					"content": "Tuyệt đấy, bé cưng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480203
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480203,
					"content": "Độ chua vừa phải, ngọt mà không ngán. Uống vào vị êm dịu, hậu vị lại nhẹ nhàng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480204
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480204,
					"content": "Tuy nhiên, uống xong ly đồ uống đặc biệt này, chị lại thấy tinh thần có vẻ phấn chấn hơn rồi đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480205
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480205,
					"content": "Không chừng cưng đã vô tình khám phá ra bí mật của Glenfidia, rồi pha ra thứ đồ uống giúp tỉnh táo còn tuyệt hơn cả cô ấy nữa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480206,
						705480207
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480206,
					"content": "Hay là điều chỉnh lại thành phần đồ uống một chút?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480208
					]
				},
				{
					"id": 705480208,
					"content": "Không sao, không vội đâu. Ánh mắt cưng đầy tò mò thế này, xem ra là có rất nhiều chuyện muốn hỏi chị đấy nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480209
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480209,
					"content": "Chúng ta trò chuyện, cưng cứ từ từ suy nghĩ, rồi sẽ sớm có ý tưởng thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480210
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480210,
					"content": "Hôm nay Lisa đã đòi lại được những cuốn sách nào vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480211
					]
				},
				{
					"id": 705480211,
					"content": "Vấn đề khiến chị đây vừa đau đầu, vừa dở khóc dở cười đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480212
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480212,
					"content": "Một đầu bếp mới tốt nghiệp từ Fontaine đến làm việc ở Khách Sạn Goth đã mượn cuốn \"Bách Khoa Toàn Thư Bánh Ngọt Mondstadt Ngàn Năm\" quý giá nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480213
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480213,
					"content": "Không ngờ cô ấy lại muốn dùng tư duy làm bánh ngọt để cải tiến các món thịt nhằm giảm bớt cảm giác dầu mỡ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480214,
						705480215
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480214,
					"content": "Món thịt có vị ngọt sao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480216
					]
				},
				{
					"id": 705480216,
					"content": "Đúng vậy. Nhìn từ kết quả thì cô ấy hơi lạm dụng Caramel, khiến những miếng thịt vốn nên thơm lừng lại trở nên ngọt đến khó chịu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480217
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480217,
					"content": "Caramel rõ ràng là một thứ rất lợi hại, cho vào đồ uống nào thì cũng sẽ không khiến người ta khó chịu. Thỉnh thoảng chị cũng thêm một thìa nhỏ vào trà chiều mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480218
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480218,
					"content": "Xem ra việc cải tiến món ăn, không phải cứ sáng tạo là tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480219
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480219,
					"content": "Lisa hình như còn mang theo một cuốn sổ nữa hả?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480220
					]
				},
				{
					"id": 705480220,
					"content": "Ồ, đây là nhân chứng cho công việc khác của chị hôm nay đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480221
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480221,
					"content": "...Chẳng mấy mà các thành viên của đội viễn chinh sẽ lần lượt trở về Mondstadt. Họ đã hoạt động bên ngoài khá lâu rồi, có lẽ khẩu vị cũng sẽ thay đổi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480222
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480222,
					"content": "Để nhập khẩu một lô nguyên liệu mới nhằm đáp ứng thói quen đã thay đổi của những kỵ sĩ này, Jean đã nhờ chị đi thăm hỏi khoảng mười gia đình đại diện và tiến hành vài cuộc điều tra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480223,
						705480224
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480223,
					"content": "Kế hoạch tỉ mỉ quá...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480225
					]
				},
				{
					"id": 705480225,
					"content": "Ừm, họ đã cống hiến rất nhiều cho Mondstadt, thời gian và mồ hôi nước mắt. Họ xứng đáng được mọi người tôn trọng và quan tâm chăm sóc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480226
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480226,
					"content": "Trong kết quả điều tra, nguyên liệu được nhắc đến nhiều nhất chính là Cacahuatl của Natlan, cùng với Ca Cao được làm từ loại thực vật kỳ lạ này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480227
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480227,
					"content": "Trong thư, có nhiều kỵ sĩ từng nói rằng họ thường dùng Ca Cao để bản thân luôn tràn đầy năng lượng. Chị cũng thử uống Ca Cao nóng rồi, cảm giác hiệu quả tỉnh táo chẳng kém gì cà phê đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480228
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480228,
					"content": "Dạo này có đến nơi nào khác nữa không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480229
					]
				},
				{
					"id": 705480229,
					"content": "Ý cưng là tranh thủ đi chơi bên ngoài sao? Bị cưng đoán trúng rồi này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480230
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480230,
					"content": "Để điều tra loại đồ uống ít phổ biến ở Mondstadt, chị đã ghé thăm Tửu Trang Dawn, cùng hầu gái trưởng Adelinde trò chuyện một hồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480231
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480231,
					"content": "Trên đường về còn gặp một kỵ sĩ nhỏ tên Ematol đang đi tuần. Cô ấy gặp ma vật nhưng lại không biết cách đối phó, nên đã hoảng hốt cầu cứu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480232
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480232,
					"content": "Chị đã cùng cô ấy đi vòng qua Lang Lãnh, dạy cho đám chó săn nóng nảy kia một bài học... Chẳng mấy khi có cơ hội vận động gân cốt như vậy, sảng khoái lắm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480233
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480233,
					"content": "Dạo này Lisa thích loại thực vật nào nhất?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480234
					]
				},
				{
					"id": 705480234,
					"content": "Ồ? Dùng từ thận trọng thật đấy, còn thêm cả từ \"dạo này\" vào nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480235
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480235,
					"content": "Là nghĩ rằng đã lâu không gặp nên chị đây thay đổi rồi sao... hay là cưng chẳng còn nhớ rõ chuyện trước đây nữa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480236,
						705480237
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480236,
					"content": "Dù sao thì Lisa cũng học nhiều hiểu rộng mà...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480238
					]
				},
				{
					"id": 705480238,
					"content": "Được đấy, khéo nói lắm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480239
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480239,
					"content": "Khi còn là học sinh, chị sẽ bị thu hút bởi những loài thực vật kỳ lạ trong sách, không ngừng mở rộng kiến thức, thoát ra khỏi vùng an toàn. Nhưng giờ thì chị đã quen với sự ổn định và khuôn phép rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480240
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480240,
					"content": "Như lời ví von của một chuyên gia pháp lý Liyue, cuộc sống của chị đây sắp đạt đến trạng thái \"an dưỡng tuổi già\" rồi, không còn là người hay thay đổi nữa đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480241
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480241,
					"content": "Chắc cưng còn nhớ, cách đây mấy năm khi cùng nhau phiêu lưu, cưng đã tìm cho chị một loại nguyên liệu giả kim có vị thanh ngọt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480242
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480242,
					"content": "Sở thích của chị chưa bao giờ thay đổi cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480243
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480243,
					"content": "Được, quyết định rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480244
					]
				},
				{
					"id": 705480244,
					"content": "Để tôi pha cho cô một ly cải tiến nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480245
					]
				},
				{
					"id": 705480245,
					"content": "Quả nhiên trí tuệ của cưng lại tiến bộ hơn rồi, chỉ gợi ý một chút thôi mà đã tìm được cảm hứng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480237,
					"content": "Thỉnh thoảng có thêm sở thích mới thì cũng hợp lý thôi, đúng không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480238
					]
				},
				{
					"id": 705480224,
					"content": "Đúng là sắp xếp rất chu đáo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480225
					]
				},
				{
					"id": 705480215,
					"content": "Suy nghĩ này cũng hơi khác thường nhỉ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480216
					]
				},
				{
					"id": 705480207,
					"content": "Để tôi điều chỉnh công thức rồi pha lại một ly khác nhé?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480208
					]
				}
			]
		},
