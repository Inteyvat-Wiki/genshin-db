						"position": [
							2194.736,
							230.089,
							-781.087
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 705480101,
					"content": "Ồ, có vẻ Hertha trở về làm việc rồi, Glenfidia cũng không thấy đâu... Quầy đồ uống giờ hoàn toàn do cưng phụ trách à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480102,
						705480103
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480102,
					"content": "Đúng vậy, chính là tôi đây!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480104
					]
				},
				{
					"id": 705480104,
					"content": "Tuyệt! Giờ chị đây có thể yên tâm gọi đồ mà không phải lo về chuyện... uống phải món đồ uống thần kỳ của tiểu đội hậu cần rồi suốt đêm trằn trọc không ngủ được, đành phải thức khuya làm việc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480105,
						705480106
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480105,
					"content": "Thức khuya làm việc... đã là chuyện quá khứ rồi nhỉ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480107
					]
				},
				{
					"id": 705480107,
					"content": "Đúng thế, giờ chị chỉ là một quản lý thư viện nhàn rỗi thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480108
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480108,
					"content": "Nếu số người trả sách quá hạn ít đi một chút, không phải cất công đến tận nhà đòi nữa, thì chị đây có thể đến trò chuyện với cưng sớm hơn và thử thêm vài kiệt tác của cưng rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480109,
						705480110
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480109,
					"content": "Vậy hôm nay muốn uống gì nào?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480111
					]
				},
				{
					"id": 705480111,
					"content": "Để chị nghĩ xem... Không có công thức nào đặc biệt thích cả, cứ pha cho chị một ly đồ uống giúp hồi phục năng lượng và cải thiện tâm trạng nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480112
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480112,
					"content": "Nếu có thể giúp chị ngủ thật thư giãn và thoải mái thì càng tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480113
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480113,
					"content": "(Quầy đồ uống đã có rất nhiều công thức kinh điển rồi, hãy chọn một loại trong số đó trước đã...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480114
					]
				},
				{
					"id": 705480114,
					"content": "(Lisa muốn hồi phục năng lượng, \"Tiếng Tuyết Hừng Đông\" chắc sẽ là một lựa chọn không tồi...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 705480110,
					"content": "Có yêu cầu đặc biệt gì về hương vị không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480111
					]
				},
				{
					"id": 705480106,
					"content": "Giờ chắc Lisa không bận như vậy nữa đâu nhỉ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480107
					]
				},
				{
					"id": 705480103,
					"content": "Nhân Viên Pha Chế Danh Dự rất hân hạnh được phục vụ!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480104
					]
				}
			]
		},
		{
			"id": 7054802,
			"completionStepIds": [
				7054806
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
