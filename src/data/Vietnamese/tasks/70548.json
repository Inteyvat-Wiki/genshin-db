			"dialogs": [
				{
					"id": 705480301,
					"content": "Xong rồi, tác phẩm mới pha chế riêng cho Lisa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480302
					]
				},
				{
					"id": 705480302,
					"content": "Mục tiêu là giúp Lisa ngủ sớm, có một giấc mơ yên bình, vậy hãy gọi nó là \"Tường Vi Mộng Lành\" nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480303
					]
				},
				{
					"id": 705480303,
					"content": "Từ phối màu đến kiểu ly đều đã được điều chỉnh, phong cách hoàn toàn khác so với ly đầu tiên...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480304
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480304,
					"content": "Xét riêng về ngoại hình thì đúng là kiểu chị thích rồi, để nếm thử hương vị xem thế nào nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480305
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480305,
					"content": "Ừm... Điểm tuyệt đối!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480306
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480306,
					"content": "Giống như... sau khi thưởng thức món bánh ngọt quý giá, dạo bước dọc theo Hồ Rượu Trái Cây, hít hà làn gió hồ dịu nhẹ, thư thái và nhàn nhã...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480307
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480307,
					"content": "Thực sự đã xua tan cảm giác mệt mỏi, nhưng cũng không khiến người ta quá hưng phấn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480308
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480308,
					"content": "Hơ... Cơn buồn ngủ kéo đến rồi, uống trước khi đi ngủ thì hiệu quả quá tuyệt vời...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480309
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480309,
					"content": "Đáng để chị viết riêng một bài ca ngợi ly đồ uống đặc biệt này, rồi trao cho cưng danh hiệu \"Thiên Tài Pha Chế Mới\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480310,
						705480311
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480310,
					"content": "Không cần trang trọng thế đâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480312
					]
				},
				{
					"id": 705480312,
					"content": "Nói đến chuyện này... Đúng là có thể tìm một ngày trời trong xanh, ánh nắng cũng không quá gắt để đi dạo bên hồ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480313
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480313,
					"content": "Nếu có cưng đi cùng, vừa đi vừa trò chuyện, chắc sẽ thư thái hơn nhiều...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480314
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480314,
					"content": "Rồi khi nào về, cưng lại pha cho chị một ly Tường Vi Mộng Lành như này, còn gì tuyệt vời hơn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480315,
						705480316
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480315,
					"content": "Nhất định rồi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480317
					]
				},
				{
					"id": 705480317,
					"content": "Haha. Giọng điệu nghiêm túc này, chị nhớ rồi đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480318
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480318,
					"content": "Tới lúc đó đừng tìm cớ trốn tránh đấy nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480316,
					"content": "Tôi sẽ dành thời gian đến mà!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480317
					]
				},
				{
					"id": 705480311,
					"content": "Lisa thích là được rồi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480312
					]
				}
