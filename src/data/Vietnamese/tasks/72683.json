			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Asagiri"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726830101,
					"content": "Khụ khụ... như vậy... vẫn không được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830102
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830102,
					"content": "Cứ kéo dài như vậy, bản thảo kỳ này sẽ không nộp được mất... hic...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830103,
						726830104
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830103,
					"content": "Xin chào...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726830105
					]
				},
				{
					"id": 726830105,
					"content": "Hở?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830106
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830106,
					"content": "Xin lỗi! Xin lỗi! Hôm nay tôi sẽ nộp bản thảo mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830107
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830107,
					"content": "Đợi đã, chúng tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726830108,
					"content": "Tiểu thư Moriko! Xin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830109
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830109,
					"content": "Hở? Thì ra không phải tiểu thư Moriko sao... may quá... khụ khụ! E hèm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830110
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830110,
					"content": "Tiểu thư Moriko là...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726830111
					]
				},
				{
					"id": 726830111,
					"content": "Tiểu thư Moriko là người phụ trách biên tập của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830112
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830112,
					"content": "Tôi là Asagiri, là một... ừm... xem như là một \"người vẽ tranh minh họa tự do\" đi. Tiểu thư Moriko... là biên tập viên điều hành phụ trách công việc của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830113
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830113,
					"content": "Vẽ tranh minh họa? Là cái gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726830114,
					"content": "Chắc các bạn cũng đã từng đọc tiểu thuyết trong Nhà Xuất Bản Yae rồi đúng không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830115
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830115,
					"content": "Bên trong những cuốn tiểu thuyết đó có một số trang chỉ có hình mà không có chữ đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830116
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830116,
					"content": "Những bức tranh chèn vào tiểu thuyết đó chính là \"tranh minh họa\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830117
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830117,
					"content": "Nếu trong tiểu thuyết có một số cảnh hoặc tình tiết quan trọng, hoặc khi tác giả muốn hình tượng nhân vật chính xuất hiện, một số tác giả sẽ chọn thêm vào đó một bức tranh minh họa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830118
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830118,
					"content": "Bằng cách này, không chỉ độc giả cảm thấy thoải mái hơn khi đọc tiểu thuyết mà nội dung của cả bộ tiểu thuyết cũng sẽ phong phú hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830119
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830119,
					"content": "Ồ... thì ra là vậy, tiểu thuyết cũng phức tạp quá ha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726830120,
					"content": "Tôi sẽ giới thiệu vài cuốn cho bạn! Ví dụ như cuốn kia... Khụ! Khụ khụ... khụ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830121
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830121,
					"content": "Cô không sao chứ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726830122
					]
				},
				{
					"id": 726830122,
					"content": "Không sao, không sao, tôi vốn dĩ không được khỏe, khi vẽ tranh minh họa thường hay thức khuya, đôi khi quên cả ăn cơm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830123
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830123,
					"content": "Khụ khụ... Sau đó thì sức khỏe ngày càng kém...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830124
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830124,
					"content": "Sức khỏe cô kém như vậy sao lại còn ở đây vẽ tranh? Không thể về nhà vẽ sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726830125,
					"content": "Tôi muốn lấy tư liệu nên mới đến đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830126
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830126,
					"content": "Dạo gần đây tôi hoàn toàn không còn cảm hứng vẽ, đã có một số tranh bị quá hạn nộp rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830127
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830127,
					"content": "Tiểu thư Moriko đã nhiều lần giúp tôi hoãn thời hạn, nếu tôi vẫn không nộp được, chắc chắn tiểu thư Moriko sẽ giận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830128
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830128,
					"content": "Tôi nghĩ nếu tôi có thể ra ngoài đi dạo, nói không chừng sẽ có được cảm hứng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830129
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830129,
					"content": "Kết quả là... haha... như các bạn thấy đó, đi chưa được bao lâu thì tôi đã không chịu nổi nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830130
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830130,
					"content": "Haiz, hay là tôi đến Hiệp Hội Nhà Mạo Hiểm treo ủy thác, nhờ nhà mạo hiểm nào đó có \"máy ảnh\" giúp đỡ vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830131
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830131,
					"content": "Ơ? \"Máy ảnh\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830132,
						726830134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726830132,
					"content": "Tôi có \"máy ảnh\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726830133
					]
				},
				{
					"id": 726830133,
					"content": "Hở?! Bạn có máy ảnh sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830135
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830135,
					"content": "Tôi, tôi sẽ nhờ nhà mạo hiểm dùng \"máy ảnh\" để đi chụp ảnh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830136
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830136,
					"content": "Tôi nghe nói, bên ngoài có rất nhiều nơi thú vị! Ví dụ như ngọn núi tuyết rất cao ở gần Mondstadt, và nơi có rất nhiều trụ ở Liyue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830137
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830137,
					"content": "Còn nữa còn nữa! Liyue có một nơi gọi là \"Tuyệt Vân Gián\", nghe nói ở đó có tiên nhân!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830138
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830138,
					"content": "Nơi ở của tiên nhân... nghĩ thôi đã thấy phấn khích rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830139
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830139,
					"content": "Vì lý do sức khỏe, tôi không thể tự mình đi đây đi đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830140
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830140,
					"content": "Nhưng, nếu bạn có thể giúp tôi ghi lại khung cảnh ở đó bằng \"Máy Ảnh\"... tôi sẽ có thể... khụ khụ! Khụ khụ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830141
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830141,
					"content": "Cô bình tĩnh lại chút!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830142,
						726830143
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726830142,
					"content": "Cứ giao cho tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726830144
					]
				},
				{
					"id": 726830144,
					"content": "Vậy sao!? Quá tốt rồi! Tôi, tôi có rất nhiều nơi muốn xem, chờ chút, tôi tìm cho bạn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830145
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830145,
					"content": "Đúng rồi, thù lao thì khỏi lo, tôi có để dành được một ít...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830146
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830146,
					"content": "Sổ tay của tôi đâu rồi nhỉ? Sổ tay, sổ tay...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830143,
					"content": "Tôi sẽ nghĩ cách.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726830144
					]
				},
				{
					"id": 726830134,
					"content": "Nhưng mà, \"máy ảnh\" thì có thể làm được gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726830135
					]
				},
				{
					"id": 726830104,
					"content": "Cho hỏi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726830105
					]
				}
			]
		}
	]
}