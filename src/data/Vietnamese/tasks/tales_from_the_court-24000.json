			"dialogs": [
				{
					"id": 240000201,
					"content": "Thật phiền phức... chút Mora cỏn con này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000202
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 240000202,
					"content": "Về \"Bản Đăng Ký Người Viện Trợ Bên Ngoài\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240000203
					]
				},
				{
					"id": 240000203,
					"content": "Thuật lại trải nghiệm của Livre và hỏi mượn tờ đơn...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						240000204
					]
				},
				{
					"id": 240000204,
					"content": "Haiz, Livre thật xui xẻo. Nhưng mà... tôi cũng không có dư bản nào.",
