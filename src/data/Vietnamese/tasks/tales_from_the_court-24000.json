			"dialogs": [
				{
					"id": 240000101,
					"content": "Để tôi lặp lại nhé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000102
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000102,
					"content": "Anh Livre, tôi rất hiểu yêu cầu của anh, và cũng rất sẵn lòng giúp đỡ, nhưng đơn đăng ký này... anh xem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000103
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 240000103,
					"content": "Người phụ trách là Clapiers, tất cả tài liệu mà anh cung cấp đều do anh ấy xử lý. Nên ngoài anh ấy ra thì chúng tôi không có quyền hạn để giải quyết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000104
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 240000104,
					"content": "Hiện tại anh ấy đang bận việc bên ngoài. Giấy tờ của anh phải được anh ấy đóng dấu thì mới đến quy trình thanh khoản của chúng tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000105
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 240000105,
					"content": "Được lắm! Tôi đến đây cũng phải lần thứ ba rồi, các người rốt cuộc có làm được không?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000106
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000106,
					"content": "Anh Livre xin bình tĩnh, văn phòng của Clapiers có hai người, ngoài anh ấy ra thì còn một người nữa là ngài Monthois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000107
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 240000107,
					"content": "Nhưng ngài Monthois đã cao tuổi, đang đợi nghỉ hưu nên lâu rồi không còn ngồi làm việc ở văn phòng, đến cả lương cũng không lấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000108
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 240000108,
					"content": "Được rồi, vậy tôi đến văn phòng của ông ấy là được, mau bảo ông ấy đem con dấu ra để tôi tự đóng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000109
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000109,
					"content": "Anh Livre, như vậy không được. Thứ nhất, chuyện này là trái quy định. Thứ hai, chìa khóa của con dấu đang nằm trong tay Clapiers, ngoài anh ấy ra thì không ai có thể lấy được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000110
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 240000110,
					"content": "Hơn nữa... tôi cũng phải đi xử lý việc khác đây... Mong anh tin tôi, hôm nay nhất định Clapiers sẽ quay lại và xử lý xong xuôi chuyện này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000111
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 240000111,
					"content": "Thôi được... Chúc cô một ngày vui vẻ, cô Cornelia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000112
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000112,
					"content": "Anh Livre cũng vậy nhé, chúc anh vui vẻ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000113
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 240000113,
					"content": "Cornelia vội vã rời đi...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						240000114
					]
				},
				{
					"id": 240000114,
					"content": "Hôm nay lại công cốc rồi... haiz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000115,
						240000116
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000115,
					"content": "Đã xảy ra chuyện gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240000117
					]
				},
				{
					"id": 240000117,
					"content": "Không có gì to tát, chỉ là tôi lại lãng phí mất nửa ngày quý báu mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000118
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000118,
					"content": "Tôi chịu hết nổi cái tên Clapiers này rồi! Palais Mermonia đã đặt mua vài kiện máy móc dây cót ở chỗ tôi, nhưng tới giờ vẫn chưa trả tiền!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000119
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000119,
					"content": "Lần đầu tôi tới tìm thì hắn nói do cuối tháng văn phòng phải niêm phong tài khoản để kiểm toán, phải đợi đến đầu tháng sau mới có thể chi trả được, nên tạm thời không tiếp nhận yêu cầu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000120
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000120,
					"content": "Đến lần thứ hai, hắn ta lại nói mực đóng dấu xài hết rồi, nhà cung cấp lại bị cháy kho hàng, phải tìm mua ở chỗ khác nên tạm thời không đóng dấu được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000121
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000121,
					"content": "Đến lần thứ ba, hắn ta nói \"Bản Đăng Ký Người Viện Trợ Bên Ngoài\" đã có thay đổi, tôi phải điền lại từ đầu. Nhưng bảng mẫu này hiện đã dùng hết, mẫu mới in phải đợi hôm sau mới có.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000122
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000122,
					"content": "Hôm nay tôi định tới lấy mẫu đơn đó thì hắn lại không ở văn phòng, trời ạ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000123
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000123,
					"content": "Ấy? Anh Livre, tôi có thể giúp gì không? Trông bộ dạng sầu não của anh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000124
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000124,
					"content": "Sĩ quan Rhemia, gặp được cô thật tốt quá, sự tình là thế này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000125
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000125,
					"content": "Livre kể lể dài dòng về chuyện đã xảy ra...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						240000126
					]
				},
				{
					"id": 240000126,
					"content": "Clapiers à... Giao thiệp với anh ta thực sự rất khó. Nhưng đúng là hôm nay anh ấy đã đi xử lý công việc ở Đảo Erinnyes, không ở Palais Mermonia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000127
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000127,
					"content": "Nhưng vấn đề vẫn là phải lấy được tờ đơn cho anh trước...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000128
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000128,
					"content": "Hả? Nhưng Clapiers nói là mẫu đó đã dùng hết rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000129
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000129,
					"content": "Tôi có cách giải quyết vấn đề của anh. Tôi nhớ có vài tiệm đối tác lâu năm của Palais Mermonia cũng từng gặp phải tình trạng tương tự.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000130
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000130,
					"content": "Họ giải quyết theo phương pháp cứ cách một khoảng thời gian lại đến Palais Mermonia để lấy những tờ đơn có thể dùng đến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000131
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000131,
					"content": "Như vậy một mặt có thể điền và nộp tài liệu nhanh chóng, mặt khác cũng sớm nắm được thông tin cập nhật của hồ sơ giấy tờ... Đây được gọi là \"đề phòng bất trắc\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000132
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000132,
					"content": "Lẽ nào... vì vậy mà tờ đơn mới bị lấy hết sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000133
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000133,
					"content": "Tóm lại, mấy cửa tiệm này chắc chắn có dư vài mẫu, chúng ta đi tìm họ để lấy là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000134
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000134,
					"content": "Hơn nữa, nếu họ nghe được chuyện anh phải chạy đi chạy lại ở Palais Mermonia, thì chắc chắn sẽ giúp đỡ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000135
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000135,
					"content": "À, chúng ta phải nhanh chóng đi lấy tờ đơn, điền đầy đủ thông tin rồi mang đến cho Clapiers trước giờ tan ca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000136
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000136,
					"content": "Nhà Lữ Hành, bạn có bằng lòng giúp đỡ anh Livre không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000137
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000137,
					"content": "Nhà Lữ Hành, rất mong được giúp đỡ! Chuyến này mà không xong thì đêm nay tôi lại không ngủ được mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000138,
						240000139
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000138,
					"content": "Được rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240000140
					]
				},
				{
					"id": 240000140,
					"content": "Bạn hãy giúp chúng tôi đến hai tiệm này để hỏi mượn Bản Đăng Ký Người Viện Trợ Bên Ngoài mới nhất là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000141
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000141,
					"content": "Để tôi xem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000142
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000142,
					"content": "Hãy đến xưởng rèn của Estelle và tiệm đồng hồ của Caron xem thử nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000143
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000143,
					"content": "Trước đây Estelle đã giúp sửa đèn đường, còn Caron thì giúp chỉnh lại đồng hồ cho Palais Mermonia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000144
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000144,
					"content": "Hai vị này không phải nhân viên của Palais Mermonia, nhưng thường được thuê xử lý công việc. Vì vậy ở chỗ họ nhất định sẽ có tờ đơn này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000145
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000145,
					"content": "Vậy phiền bạn rồi, lát nữa tôi và anh Livre cũng sẽ chia nhau đi hỏi thăm tình hình những tiệm khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000139,
					"content": "Vậy tôi cần phải làm gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240000140
					]
				},
				{
					"id": 240000116,
					"content": "Anh gặp phải chuyện gì sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240000117
					]
				}
			]
		},
