				{
					"id": 732030401,
					"content": "Bạn không giống người có Vision, nhưng lại có thể điều khiển sức mạnh của Nguyên Tố Thảo, hẳn không phải là một nhà mạo hiểm bình thường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030402
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030402,
					"content": "Nghe nói đúng là có một nhóm người tuy không có Vision nhưng vẫn có thể điều khiển sức mạnh nguyên tố, có điều những tin đồn liên quan đều rất tiêu cực, bạn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030403
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030403,
					"content": "Tóm lại tôi tin bạn là một người nhiệt tình tốt bụng, đừng lầm đường lạc lối nhé.",
					"roleType": "TALK_ROLE_NPC",
