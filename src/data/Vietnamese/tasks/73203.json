			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sabbah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731930501,
					"content": "Nếu không gặp được mấy bạn, e rằng tôi sẽ khó thấy được những bông hoa tường vi đó nảy mầm mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930502
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930502,
					"content": "Sớm biết như vậy thì đáng lẽ tôi nên mang vài quyển sách đến đây thay vì mang hạt giống.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930503,
						731930519
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930503,
					"content": "Cô không phải người ở đây hả?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930504
					]
				},
				{
					"id": 731930504,
					"content": "Bất ngờ lắm sao? Vậy xem như tôi đã hòa nhập vào nơi đây khá tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930505
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930505,
					"content": "Khi mới đến đây, tôi chưa thể thích nghi với mọi thứ từ ăn mặc, thức ăn cho đến thói quen sinh hoạt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930506
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930506,
					"content": "Nhưng theo thời gian, tôi đã dần chấp nhận mọi thứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930507
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930507,
					"content": "Nhưng bề ngoài nhìn như đã thích nghi không có nghĩa là trong thâm tâm đã chấp nhận hoàn cảnh của chính mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930508
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930508,
					"content": "Tường vi có thể nở rộ ở Thành Sumeru nhưng lại khó mà nở hoa ở nơi đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930509
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930509,
					"content": "Cô là học giả à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930510
					]
				},
				{
					"id": 731930510,
					"content": "Tôi... từng được gọi là học giả, nhưng bây giờ thì không phải.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930511
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930511,
					"content": "Tôi đã nói những lời đáng lý ra với thân phận của tôi không nên nói, hiểu những kiến thức mà đáng ra với thân phận của tôi không nên hiểu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930512
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930512,
					"content": "Việc này vi phạm điều cấm kị của Giáo Viện, vậy nên tôi không còn là học giả nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930513
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930513,
					"content": "Cô đã nói những gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930514
					]
				},
				{
					"id": 731930514,
					"content": "Sự tò mò là động lực để tìm kiếm trí tuệ, nhưng nó cũng là nguyên nhân dẫn đến tội lỗi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930515
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930515,
					"content": "Đây là điều tôi đã hiểu được sau khi bị lưu đày đến nơi đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930516
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930516,
					"content": "Vì lý do an toàn, tôi nghĩ không nên kể quá chi tiết thì hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930517
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930517,
					"content": "Vậy được thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930518
					]
				},
				{
					"id": 731930518,
					"content": "Khụ khụ, nhưng mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930535
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930535,
					"content": "Tôi cứ tưởng nhà mạo hiểm luôn vội lên đường, sau khi giúp đỡ rồi thì bạn sẽ không quay lại nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930536
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930536,
					"content": "Không ngờ lại nhiều lời với bạn như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930537
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930537,
					"content": "Ừm... Ở nơi này, không có nhiều người để tôi trải lòng cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930538
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930538,
					"content": "Sau này... bạn có rảnh đến bón phân cho chúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930539
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930539,
					"content": "Được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930540
					]
				},
				{
					"id": 731930540,
					"content": "Được, vậy tôi sẽ đợi bạn đến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930519,
					"content": "Tại sao phải trồng Tường Vi Sumeru?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930520
					]
				},
				{
					"id": 731930520,
					"content": "Có lẽ bạn chưa biết nhiều về Tường Vi Sumeru, loài thực vật này có rất nhiều công dụng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930521
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930521,
					"content": "Nó có thể dùng làm thức ăn, có thể dùng làm thuốc, làm quà, và có giá trị kinh tế rất cao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930522
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930522,
					"content": "Và đây chỉ là công dụng phổ biến trong cuộc sống hằng ngày của chúng ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930523
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930523,
					"content": "Hoa, lá, thân của Tường Vi Sumeru không phải lúc nào cũng như những gì chúng ta thấy ngày nay, chúng từng có nhiều hình dáng khác nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930524
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930524,
					"content": "Tôi nghĩ là do thay đổi về điều kiện địa lý khiến cho hình dạng đặc trưng của Tường Vi Sumeru có sự thay đổi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930525
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930525,
					"content": "Chúng ta có thể nhận được rất nhiều thông tin về mặt lịch sử và địa lý từ quá trình phát triển hình dạng của nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930526
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930526,
					"content": "Đây không phải chuyện có thể nói rõ trong đôi lời được, và cũng không phù hợp quy định khi giải thích với một nhà mạo hiểm đi ngang qua đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930527
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930527,
					"content": "Nếu bạn có hứng thú với sự biến hóa của thực vật thì hãy đến Giáo Viện, nơi đó có nền giáo dục về thực vật học hoàn thiện hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930528
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930528,
					"content": "Vậy nên là vì nghiên cứu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930529
					]
				},
				{
					"id": 731930529,
					"content": "Tôi đã không còn là học giả, không có điều kiện và tư cách để làm nghiên cứu nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930530
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930530,
					"content": "Còn về lý do thì... Haiz, bạn tò mò thật đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930531
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930531,
					"content": "Nơi ở trước đây của tôi trồng rất nhiều Tường Vi Sumeru, lúc chúng nở hoa rất đẹp, mỗi ngày tôi đều có thể ngắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930532
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930532,
					"content": "Nếu có thể thì tôi vẫn muốn giống như trước đây, mỗi ngày đều có chúng bầu bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930533
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930533,
					"content": "...Chỉ cần vậy thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930534
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930534,
					"content": "Tôi hiểu mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930535
					]
				}
			]
		},
		{
			"id": 7320301,
			"completionStepIds": [
				7320301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320301",
							"2"
						],
						"stepId": 7320301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Sabbah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732030101,
					"content": "Các bạn đến rồi đó à, đúng hẹn thật đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030102
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030102,
					"content": "Tôi đã làm món Gà Áp Chảo, nếu mọi người thấy đói thì có thể ngồi xuống cùng ăn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030103
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030103,
					"content": "Gà Áp Chảo! Hay quá, tôi muốn ăn một đĩa lớn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030104,
						732030105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732030104,
					"content": "Paimon, như vậy không tốt...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030106
					]
				},
				{
					"id": 732030106,
					"content": "A... Xin lỗi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732030107,
					"content": "Không sao đâu, đừng khách sáo với tôi làm gì. Thích ăn uống là chuyện bình thường mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030108
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030108,
					"content": "Lát nữa tôi sẽ mang thức ăn đi hâm nóng, rồi đóng gói sẵn cho các bạn, xem như cảm ơn các bạn vì đã giúp đỡ tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030109
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030109,
					"content": "Wow, Sabbah tốt bụng quá! Tường Vi mà cô trồng nhất định sẽ phát triển tốt theo như mong đợi của cô.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732030110,
					"content": "Haha, trong khoảng thời gian này, tôi vẫn luôn giữ ẩm cho đất, nên tình trạng của các chồi non khá tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030111
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030111,
					"content": "Chỉ là tốc độ sinh trưởng của chúng hơi chậm, làm người ta lo lắng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030112
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030112,
					"content": "Thông thường nếu hạt giống có trạng thái tốt, thì sẽ nhanh chóng nảy mầm, nhưng mấy cây này đến nay vẫn chưa có động tĩnh gì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030113
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030113,
					"content": "Không biết có phải do đất không đủ màu mỡ không, nếu cứ tình trạng thế này thì tôi sẽ bón phân thêm dưỡng chất cho đất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030114,
						732030115
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030114,
					"content": "Bón phân lần nữa đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030116
					]
				},
				{
					"id": 732030116,
					"content": "Vậy thì làm phiền các bạn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030117
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030117,
					"content": "Chuyện nhỏ thôi mà, cứ giao cho chúng tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732030115,
					"content": "Dùng năng lượng của Nguyên Tố Thảo thử xem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030116
					]
				},
				{
					"id": 732030105,
					"content": "Xin lỗi, Paimon là như vậy đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030106
					]
				}
			]
		},
		{
			"id": 7320303,
			"completionStepIds": [
				7320303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320303",
							"2"
						],
						"stepId": 7320303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sabbah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732030301,
					"content": "Lần nữa cảm ơn các bạn, tôi thật sự rất vui khi thấy được Tường Vi Sumeru sinh trưởng ở nơi này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030302
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030302,
					"content": "Trong lúc Sabbah và các bạn nói chuyện, những chiếc lá mới đang dần nhú ra...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732030303
					]
				},
				{
					"id": 732030303,
					"content": "Lá mới dần dần xòe ra, để lộ những nụ hoa mơn mởn...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732030304
					]
				},
				{
					"id": 732030304,
					"content": "Những nụ hoa dần dần hé nở, Tường Vi Sumeru mà Sabbah trồng cuối cùng cũng đã thấy được nhụy.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732030305
					]
				},
				{
					"id": 732030305,
					"content": "Cô ấy hái một đóa Tường Vi Sumeru, đưa cho bạn và Paimon.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732030306
					]
				},
				{
					"id": 732030306,
					"content": "Đừng làm vậy, Tường Vi mà Sabbah trồng vốn đã không nhiều rồi, mà giờ còn hái một đóa cho chúng tôi nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732030307,
					"content": "Không sao đâu, nếu không có các bạn giúp đỡ, Tường Vi Sumeru sẽ không thể nào nở hoa ở nơi đây được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030308,
						732030309
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030308,
					"content": "Chỉ là chuyện nhỏ thôi mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030310
					]
				},
				{
					"id": 732030310,
					"content": "Một vườn Tường Vi đương nhiên là rất bắt mắt, nhưng một đóa Tường Vi thì cũng có vẻ đẹp của riêng mình. Trước đây khi còn là học giả thì tôi đã có hứng thú với Tường Vi rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030311
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030311,
					"content": "Ồ, thì ra Sabbah là học giả sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732030312,
					"content": "Đúng vậy, tôi vẫn chưa nói với Paimon nữa. Tôi không phải cư dân của Làng Aaru, tôi... \"chuyển\" từ Giáo Viện tới đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030313
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030313,
					"content": "Tôi nói mà, Sabbah ăn nói lịch sự nho nhã, quả thật rất giống học giả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732030314,
					"content": "Tôi hiểu rồi, Sabbah trồng tường vi vì muốn tiếp tục nghiên cứu chúng đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732030315,
					"content": "Cũng không thể nói vậy được, niềm yêu thích của học giả đối với đối tượng nghiên cứu không nên chỉ nhằm vào mục đích nghiên cứu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030316
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030316,
					"content": "Là bởi vì yêu thích thế giới này, nên mới muốn tìm hiểu chúng, muốn tìm hiểu quy luật sinh mệnh của cỏ cây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030317
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030317,
					"content": "Lấy ví dụ như tôi, trước đây tôi từng nghiên cứu một đề tài về tác động của địa lý Sumeru đối với hình thái của loài Tường Vi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030318
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030318,
					"content": "Bạn nghĩ xem, nếu môi trường địa lý ở Sumeru thay đổi khác hoàn toàn với bây giờ, để thích ứng với điều kiện tự nhiên thì Tường Vi sẽ thay đổi như thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030319
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030319,
					"content": "Có khi nào sẽ trở thành loài thực vật dây leo không? Nếu như vậy thì ngày nay trên các bức tường của Giáo Viện không chừng cũng sẽ bao phủ bởi Tường Vi đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030320
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030320,
					"content": "Hoặc là sẽ nở thành cụm, nở ra hàng loạt, trông rất hoành tráng nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030321
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030321,
					"content": "Nói không chừng sẽ có nhiều màu sắc, như trắng này, đỏ này, vàng này... đó sẽ là một giống loài hoàn toàn mới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030322
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030322,
					"content": "Đương nhiên rồi, bây giờ rất ít người phát hiện ra giống loài mới, nuôi trồng giống loài mới như các học giả hàng đầu ngày xưa thì lại càng ít hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030323
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030323,
					"content": "Tôi muốn nói rõ một điều: Trên mỗi một đóa Tường Vi đều chứa đựng vô vàn khả năng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030324
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030324,
					"content": "Tìm tòi về những khả năng này là một việc rất thú vị, khi ấy mỗi ngày tôi đều sẽ say mê thu thập mẫu vật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030325
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030325,
					"content": "Nghĩ lại, quả thật là một khoảng thời gian tuy giản đơn nhưng vui vẻ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030326
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030326,
					"content": "Tóm lại, các bạn cứ nhận lấy, đối với tôi mà nói, đây không phải là tổn thất, mà là san sẻ niềm vui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030327
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030327,
					"content": "Nếu bây giờ trong lòng vẫn còn ái ngại, sau này đem Tường Vi Sumeru tới thăm tôi là được mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030328
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030328,
					"content": "Tôi cảm thấy thoải mái khi nói chuyện với các bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030329
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030329,
					"content": "Dù tôi có nói gì, các bạn cũng không nghĩ rằng tôi ăn nói \"linh tinh\" và cắt ngang lời tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030330
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030330,
					"content": "Tôi sẽ tặng các bạn vài món quà nhỏ, tuy bây giờ tôi không dùng tới chúng, nhưng nói không chừng các bạn sẽ thích.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030331
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030331,
					"content": "Chúng tôi sẽ thường xuyên ghé chơi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030332
					]
				},
				{
					"id": 732030332,
					"content": "Nhất định phải thường xuyên ghé lại đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030309,
					"content": "Đừng khách sáo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030310
					]
				}
			]
		},
