					"content": "Bánh ngon quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870402,
						761870403
					],
					"speakerTitle": "Mamere"
				},
				{
					"id": 761870402,
					"content": "(Ngồi thêm một lúc nữa vậy.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870404
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761870404,
					"content": "Hả?! Nhanh thế sao? Thôi được, cảm ơn tiểu thư Sandrone! Lần sau chúng ta lại gặp nhau nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mamere"
				},
				{
					"id": 761870403,
					"content": "Tiệc trà cũng nên kết thúc rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870404
					],
