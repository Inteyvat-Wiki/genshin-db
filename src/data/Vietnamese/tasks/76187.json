			"dialogs": [
				{
					"id": 761870301,
					"content": "Cho phép tôi thay mặt tiểu thư Mamere cảm ơn lời mời của tiểu thư Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870302
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761870302,
					"content": "Ừm, bánh ngon lắm. Cảm ơn nhé, Sandrone. Tay nghề của cô lợi hại thật đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870303
					],
					"speakerTitle": "Mamere"
				},
				{
					"id": 761870303,
					"content": "Cô thích là được rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870304
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761870304,
					"content": "Nhưng mà nguyên mẫu 4ACV07, đây chắc là lần đầu tiên chúng ta gặp nhau nhỉ? Sao lại nhận ra tôi thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870305
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761870305,
					"content": "Waa, lần đầu tiên tôi nghe có người gọi Seymour như vậy đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870306
					],
					"speakerTitle": "Mamere"
				},
				{
					"id": 761870306,
					"content": "Khẳng định. Dù cô cũng dịu dàng, đáng yêu và rạng ngời không kém, nhưng trước đây tôi chưa gặp cô bao giờ, tiểu thư Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870307
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761870307,
					"content": "Tôi có thể nhận ra cô, bởi vì trong bộ nhớ của tôi dung mạo của chủ nhân, cũng chính là tiểu thư Mary-Ann Guillotin đã được lưu trữ vĩnh viễn không thể thay thế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870308
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761870308,
					"content": "Tiểu thư Mary-Ann đã kể cho tôi nghe về cô. Vì dung mạo của cô giống với chủ nhân, nên tôi có thể suy luận hợp lý và nhận diện được danh tính của tiểu thư Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870309
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761870309,
					"content": "Ừm, không hổ danh là tác phẩm đầu tiên của Alain. Nhưng dựa trên nền tảng đó, hình như đã có sự trưởng thành vượt bậc... Bây giờ chắc tôi phải gọi bằng cái tên Seymour rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870310
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761870310,
					"content": "Khi nhìn thấy tôi, Seymour có thắc mắc gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870311
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761870311,
					"content": "Phủ định. Mệnh lệnh hàng đầu của tôi là thay thế Alain Guillotin để ở bên cạnh và bảo vệ tiểu thư.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870312
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761870312,
					"content": "Vì vậy, tôi hiểu rất rõ về tiểu thư Mary-Ann. Dựa trên phân tích logic của không gian vectơ hữu hạn chiều, thì tiểu thư Sandrone hoàn toàn khác với tiểu thư Mary-Ann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870313
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761870313,
					"content": "Sự khác biệt giữa hai vị tiểu thư tôn quý, giống như lá trà của Trầm Ngọc Cốc và trái Bulle của Khu Beryl vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870314
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761870314,
					"content": "Vậy Sandrone là lá trà hay trái Bulle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870315
					],
					"speakerTitle": "Mamere"
				},
				{
					"id": 761870315,
					"content": "Đang tìm kiếm... Dữ liệu không đủ, không thể trả lời.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870316
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761870316,
					"content": "(Ừm... May là sau này mô đun ngôn ngữ của mình đã được Alain nâng cấp.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sandrone"
				}
			]
		},
