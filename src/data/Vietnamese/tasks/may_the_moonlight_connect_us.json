			"dialogs": [
				{
					"id": 760310201,
					"content": "...Đúng vậy. Sau này sẽ để Kunegunda mang trái cây qua đó, hai ngày nay cô ấy cần phải tịnh dưỡng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310202
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760310202,
					"content": "Ồ, hình như Lauma đang bận. Chúng ta đợi một lát đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310203,
					"content": "Từ rất lâu trước đây tôi đã biết, Vịnh Nguyệt Sứ là sự tồn tại vô cùng quan trọng trong Dòng Dõi Sương Nguyệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310204
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760310204,
					"content": "Đôi khi tôi cảm thấy, chưa biết chừng họ còn vất vả hơn cả thần linh thực sự.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310205
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760310205,
					"content": "Ồ! Rảnh rồi kìa! Mau tranh thủ thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310206,
					"content": "Cô Lauma, bên này có một số công việc cần sắp xếp này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310207
					],
					"speakerTitle": "Vanamo"
				},
				{
					"id": 760310207,
					"content": "Được, tôi đến ngay đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310208
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760310208,
					"content": "Lại bị gọi đi rồi! Không cho chút thời gian nào luôn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310209,
					"content": "Chúng ta cẩn thận đi theo sau đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
