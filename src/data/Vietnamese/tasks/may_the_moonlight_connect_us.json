						760310103
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760310103,
					"content": "#{NICKNAME}, cô ấy đang ngủ trưa. Hay lát nữa chúng ta quay lại nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310104,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310105
					],
					"speakerTitle": "Lửng Áo Choàng"
				},
				{
					"id": 760310105,
					"content": "Này! Đừng qua đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310106,
					"content": "...Mmph!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310107
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760310107,
					"content": "Đau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310108
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760310108,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310109
					],
					"speakerTitle": "Lửng Áo Choàng"
				},
				{
					"id": 760310109,
					"content": "Trượt chân à? Ừm, không sao đâu. Hmm? Hai người cũng tới rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310110
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760310110,
					"content": "Thì ra Nguyệt Thần cũng sẽ bị động vật húc phải nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310111,
					"content": "Kuuvahki mà các động vật tỏa ra không hề có ý xấu, tôi không bận tâm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310112
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760310112,
					"content": "Sao vậy? Sao lại sợ hãi thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310113
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760310113,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310114
					],
					"speakerTitle": "Lửng Áo Choàng"
				},
				{
					"id": 760310114,
					"content": "Hmm, ừm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310115
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760310115,
					"content": "Thì ra cô nghe hiểu chúng nói gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310116,
					"content": "Nod-Krai là vùng đất nơi mặt trăng mọc. Chỉ cần là động vật trưởng thành dưới sự ảnh hưởng của Kuuvahki thì đều là \"thân quyến của Nguyệt Thần\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310117
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760310117,
					"content": "Vậy nó nói gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310118,
					"content": "Nơi nó sống có ma vật xuất hiện, vốn định đi tìm Lauma... Nhưng trên đường bị ma vật đuổi đến tận đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310119
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760310119,
					"content": "Chẳng trách sao nó lại sợ hãi như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310120,
					"content": "Có cần đưa nó về không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760310121
					]
				},
				{
					"id": 760310121,
					"content": "Ừm, đưa về chỗ Lauma là được, cô ấy sẽ xử lý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310122
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760310122,
					"content": "Xem ra lại phải ra ngoài một chuyến rồi. Nhưng lần này là đến chỗ Dòng Dõi Sương Nguyệt, phải trốn cho kỹ đấy nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
