					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031102,
					"content": "Đọc xong rồi đó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201031103
					]
				},
				{
					"id": 201031103,
					"content": "#Có tác dụng không? Xem vẻ mặt của {F#chị}{M#anh}, em đoán kết quả không tồi phải không?",
					"roleType": "TALK_ROLE_NPC",
