							"2"
						],
						"stepId": 2010301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ella Musk"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 201030101,
					"content": "#Lại gặp nhau rồi, {F#chị}{M#anh} còn nhớ em chứ? Nếu có quên... Thì chắc hẳn {F#chị}{M#anh} vẫn nhớ đến lần chúng ta \"giao lưu hữu hảo\" với đám Hilichurl nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030102
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030102,
					"content": "Ấy, chớ có dùng ánh mắt đó nhìn em, học ngoại ngữ cần phải luyện tập thường xuyên mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030103
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030103,
					"content": "#Yên tâm đi, em không để {F#chị}{M#anh} thiệt đâu. So với trước kia, khẩu ngữ Hilichurl của em đã tiến bộ vượt bậc đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030104
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030104,
					"content": "Tuy khẩu ngữ có tiến bộ, nhưng văn viết vẫn rất kém. Sau khi dày công nghiên cứu... Em đã sáng tác vài bài thơ bằng tiếng Hilichurl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030105
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030105,
					"content": "#Thế nhưng... Có một vài câu trong những bài thơ này vẫn chưa thể xác định được ý nghĩa chính xác, {F#chị}{M#anh} có thể giúp em \"kiểm tra\" được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030106,
						201030111
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030106,
					"content": "...\"Kiểm tra\" bằng cách nào?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201030107
					]
				},
				{
					"id": 201030107,
					"content": "Đương nhiên là đọc cho Hilichurl nghe rồi, xem chúng có phản ứng gì không!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030108
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030108,
					"content": "Chớ lo lắng! Chỉ là những câu thơ em có chút đắn đo mà thôi, em đã <color=#00E1FFFF>đánh dấu rồi</color>, ý nghĩa của chúng cũng không khác biệt mấy đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030109
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030109,
					"content": "#Mục tiêu đã được chọn sẵn, có vài tên Hilichurl dường như rất thân thiện, {F#chị}{M#anh} đọc cho chúng nghe những câu thơ này nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030110
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030110,
					"content": "#Vậy phải nhờ {F#chị}{M#anh} giúp em rồi! Sau khi đọc cho Hilichurl nghe, hãy quay lại nói cho em biết tình hình cụ thể.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030111,
					"content": "...Lại phải đọc cho Hilichurl nghe sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201030112
					]
				},
				{
					"id": 201030112,
					"content": "#Đúng rồi, em thấy {F#chị}{M#anh} rất thuần thục đó. Chớ có lo lắng, những câu thơ còn chút nghi ngờ em đều <color=#00E1FFFF>đánh dấu rồi</color>, ý nghĩa của chúng cũng không khác biệt mấy đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030113
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030113,
					"content": "#Mục tiêu đã được chọn sẵn, có vài tên Hilichurl dường như rất thân thiện, {F#chị}{M#anh} đọc cho chúng nghe những câu thơ này nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030114
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030114,
					"content": "#Vậy phải nhờ {F#chị}{M#anh} giúp em rồi! Sau khi đọc cho Hilichurl nghe, hãy quay lại nói cho em biết tình hình cụ thể.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030115
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030115,
					"content": "#Chẳng may mà có gì bất thường, em tin chắc {F#chị}{M#anh} sẽ xử lý êm đẹp...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				}
			]
		},
