			"dialogs": [
				{
					"id": 201031101,
					"content": "#Thế nào? {F#Chị}{M#Anh} đọc cho Hilichurl nghe thơ của em chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031102
