						201031104
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031104,
					"content": "Đúng là không tệ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201031105
					]
				},
				{
					"id": 201031105,
					"content": "Vậy em đã hiểu chính xác nghĩa của những từ này rồi, vui quá đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031106
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031106,
					"content": "Việc nghiên cứu tiếng Hilichurl lại có tiến bộ vượt bậc nữa rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031107
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031107,
					"content": "Rồi sẽ có một ngày, em sẽ có thể giao tiếp thoải mái với Hilichurl, sau đó moi thông tin từ chúng, như vậy thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031108
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031108,
					"content": "...Em có thể tự tin khẳng định bản thân không làm tổn hại danh dự dòng họ \"Musk\" rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031109
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031109,
					"content": "#Ồ đúng rồi, {F#chị}{M#anh} nhận lấy quà cảm ơn này nhé.",
					"roleType": "TALK_ROLE_NPC",
