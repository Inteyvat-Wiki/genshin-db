			"dialogs": [
				{
					"id": 201031501,
					"content": "Không biết Hilichurl có thích nghe những câu thơ mà em viết không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031502,
						201031509,
						201031515
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031502,
					"content": "Tại sao phải dùng tiếng Hilichurl để làm thơ cơ chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201031503
					]
				},
				{
					"id": 201031503,
					"content": "Ừm... Nói thật, ngôn ngữ Hilichurl em có chút không hiểu, ví dụ như ngữ pháp, câu cú, cách tổ hợp giữa các từ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031504
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031504,
					"content": "Những câu thơ này em đã nghiên cứu rất kỹ, nhưng nếu đọc cho Hilichurl có lẽ vẫn còn gượng gạo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031505
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031505,
					"content": "Hơn nữa, trong tiếng Hilichurl chỉ cần một chữ khác biết thì ý nghĩa của cả một câu sẽ thay đổi... Sự thay đổi vi diệu như vậy nếu không có giao tiếp thực tiễn thì sẽ mãi không học được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031506
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031506,
					"content": "Với người bình thường mà nói, \"học tiếng Hilichurl từ Hilichurl\" là điều không thể chấp nhận được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031507
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031507,
					"content": "Nhưng em chấp nhận được, ừm... Chi bằng nói là để học được tiếng Hilichurl, hiểu được Hilichurl thì em bắt buộc phải chấp nhận điều đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031508
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031508,
					"content": "Em nghĩ, việc dùng thơ ca giao lưu với đám Hilichurl quanh thành Mondstadt là một ý tưởng không tồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031509,
					"content": "Vậy những đánh dấu này...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201031510
					]
				},
				{
					"id": 201031510,
					"content": "#{F#Chị}{M#Anh} nói đến những đánh dấu phía sau ư. Ừm... Nói thế này đi, nhưng từ được dùng trong thơ đều được em tìm thấy trong sách vở.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031511
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031511,
					"content": "Tuy là học theo sách và cố gắng sắp xếp thành những câu này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031512
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031512,
					"content": "Nhưng ngôn ngữ là một thứ rất phức tạp... Cho dù cùng một từ nhưng đặt vào những hoàn cảnh khác nhau có lẽ sẽ có sự khác biệt, thậm chí còn làm thay đổi ý nghĩa của cả một câu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031513
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031513,
					"content": "Khi viết thơ, em đã cố gắng nắm bắt rõ ý nghĩa của những từ này rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031514
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031514,
					"content": "#Ngoài ra còn một số \"câu thơ\" em không biết dịch thế nào... Thì không chỉ cho {F#chị}{M#anh} xem nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031515,
					"content": "Những đánh dấu này em tương đối hiểu rõ ý nghĩa rồi chứ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201031516
					]
				},
				{
					"id": 201031516,
					"content": "Cũng chỉ là... \"Tương đối\" thôi. Tuy nói là giao lưu hảo hữu với Hilichurl...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031517
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031517,
					"content": "Nhưng nếu có gì sai sót, Hilichurl sẽ không nghe em giải thích đâu. Nếu có bị tấn công thì em cũng không biết làm sao để thoát thân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031518
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031518,
					"content": "#Chính vì vậy chỉ có thể nhờ {F#chị}{M#anh} thôi. Hihi... Không sao, chỉ cần {F#chị}{M#anh} làm theo đánh dấu của em, chắc không có vấn đề gì đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031519
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031519,
					"content": "Ừm, em nghĩ chắc là không sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				}
