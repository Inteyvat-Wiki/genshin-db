				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mualani",
					"Kinich",
					"Ajaw",
					"Kachina",
					"Citlali"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 50270101,
					"content": "Hỏa Thần thật lợi hại! Hơn nữa cũng rất dũng cảm nữa! Cô ấy dám so tài với ngài Xbalanque luôn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270102
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 50270102,
					"content": "Đừng khiêm tốn thế. Nếu là cô thì cô cũng dám làm mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270103
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 50270103,
					"content": "Hah, ai mà không dám chứ? Ta dám! Ngươi thì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270104
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 50270104,
					"content": "Ta... ta không dám!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270105
					],
					"speakerTitle": "Kachina"
				},
				{
					"id": 50270105,
					"content": "Chiến đấu là bản tính của chiến binh, có gì mà dám với không dám chứ. Khi đến thời cơ thì ai cũng sẽ lựa chọn đánh một trận thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270106
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 50270106,
					"content": "Haiz, mấy người thật là tràn đầy sức sống đấy... Đó là ngài Xbalanque đấy! Là một vị tổ tiên siêu đẳng mà? Thích so tài với trưởng bối vậy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270107
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 50270107,
					"content": "Bà Citlali à! Nếu có cơ hội thì so tài cùng tụi cháu nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270108
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 50270108,
					"content": "Thôi thôi, không nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Citlali"
				}
			]
		},
		{
			"id": 502702,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"502701",
							"2"
						],
						"stepId": 502701,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mausau",
					"Ororon",
					"Iansan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 50270201,
					"content": "Nói thử xem, em sẽ biến thành loại rau gì nhỉ? Đỏ hay xanh lá?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270202
					],
					"speakerTitle": "Mausau"
				},
				{
					"id": 50270202,
					"content": "Nếu là em thì chắc sẽ biến thành hành tây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270203
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 50270203,
					"content": "Hành tây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270204
					],
					"speakerTitle": "Mausau"
				},
				{
					"id": 50270204,
					"content": "Ngoại hình không quá nổi bật, nhưng lại có thể khiến người muốn ra tay với mình phải khóc lóc thảm thiết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270205
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 50270205,
					"content": "Thật sao? Nghe có vẻ rất mạnh nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270206
					],
					"speakerTitle": "Mausau"
				},
				{
					"id": 50270206,
					"content": "Hai người đang nói gì thế nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270207
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 50270207,
					"content": "Hành tây rất lợi hại. Lần trước đến nhà người bạn vô tình bắt gặp anh ta đang cắt hành tây, vừa cắt vừa khóc không ngừng. Anh ta khóc, Saurian cũng khóc, cuối cùng tất cả sinh vật trong nhà đều khóc cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270208
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 50270208,
					"content": "Anh thì sao? Lúc đó anh ở đâu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270209
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 50270209,
					"content": "Tôi cũng ở trong nhà, nhưng đã kịp thời dùng áo choàng che mắt lại. Cacucu và Ifa không nhìn thấy tôi, nên tưởng tôi cũng khóc theo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270210
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 50270210,
					"content": "Em muốn trở thành người đàn ông khiến người khác phải khóc, giống như hành tây vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270211
					],
					"speakerTitle": "Mausau"
				},
				{
					"id": 50270211,
					"content": "Ừm, không thành vấn đề.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270212
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 50270212,
					"content": "Thật muốn ngắt lời hai người, nhưng không biết phải nói sao mới có thể ngăn cản cuộc đối thoại này đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270213
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 50270213,
					"content": "Iansan là... một cây nấm nhỏ. Ừm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270214
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 50270214,
					"content": "Có ai hỏi đâu chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270215
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 50270215,
					"content": "Nhưng là nấm sao? Cũng không tệ, rất có sức sống, tôi thích.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270216
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 50270216,
					"content": "Vậy thì chị Iansan là một cô gái rất giàu sức sống!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270217
					],
					"speakerTitle": "Mausau"
				},
				{
					"id": 50270217,
					"content": "Ừm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270218
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 50270218,
					"content": "Ừm ừm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iansan"
				}
			]
		}
	]
}