				"points": []
			},
			"dialogs": [
				{
					"id": 716690101,
					"content": "#{NICKNAME}, nghe các nhân viên nói, {F#cô}{M#cậu} đã tìm được tất cả động vật nhỏ có lắp thiết bị rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690102
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690102,
					"content": "Thật bất ngờ đấy... Có một số loài rất nhạy cảm, khi có sinh vật lạ đến gần là sẽ bỏ chạy ngay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690103
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690103,
					"content": "#Nhưng chúng lại không hề né tránh {F#cô}{M#cậu}, đúng là kỳ lạ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690104,
						716690105
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690104,
					"content": "Bởi vì tôi là một người yêu động vật mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716690106
					]
				},
				{
					"id": 716690106,
					"content": "#Haha, khả năng này của {F#cô}{M#cậu} thật khiến người khác ghen tị đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690107
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690107,
					"content": "Mấy lần trước nhân viên khi đi cho chúng ăn, không phải bị gào đe dọa thì là bị cắn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690112
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690112,
					"content": "Lại còn để lại sẹo trên tay nữa, đau lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690113
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690113,
					"content": "Tuy chúng không thân thiết với tôi lắm, nhưng khi nhìn thấy những sinh linh đáng yêu này sống tốt thì tôi đã hài lòng rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690114
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690114,
					"content": "Đối với tất cả những người nhận nuôi cũng vậy, họ đều không làm phiền để bảo vệ môi trường sống của chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690115
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690115,
					"content": "Tôi biết đối với nhiều nhà mạo hiểm mà nói, động vật hoang dã là nguồn thức ăn quan trọng. Chúng tôi cũng không yêu cầu thành viên của Lữ Đoàn Móng Vuốt không sát sinh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690116
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690116,
					"content": "Nguyên tắc mà chúng tôi đề xướng là không được bắt giữ và giết hại bừa bãi. Nếu ai cũng làm được thì môi trường xung quanh chúng ta nhất định sẽ trở nên phong phú và tốt đẹp hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690117
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690117,
					"content": "#Thân là một thành viên, nếu {NICKNAME} đồng ý và chấp nhận nguyên tắc này thì tốt quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690118,
						716690120
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690118,
					"content": "Tôi đồng ý.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716690119
					]
				},
				{
					"id": 716690119,
					"content": "#Tôi biết mà, người thấu tình đạt lý như {F#cô}{M#cậu} thì sẽ công nhận chúng tôi thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690122
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690122,
					"content": "Có thể đưa suy nghĩ này vào tâm trí mọi người thì đã là thành công rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690123
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690123,
					"content": "#Nếu có cơ hội, hy vọng sẽ gặp lại {F#cô}{M#cậu} trong sự kiện lần tới của Lữ Đoàn Móng Vuốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690124
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690124,
					"content": "Hy vọng đến lúc đó, trên cánh tay tôi sẽ không có thêm vết sẹo mới nữa, haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690120,
					"content": "Tôi không có ý kiến.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716690121
					]
				},
				{
					"id": 716690121,
					"content": "Không sao, chúng tôi không ép tất cả mọi người chấp nhận. Nhưng cá nhân tôi hy vọng mọi người đều suy nghĩ về chuyện này trước khi sát sinh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690122
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690105,
					"content": "Đây là năng khiếu của nhà mạo hiểm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716690106
					]
				}
			]
		},
