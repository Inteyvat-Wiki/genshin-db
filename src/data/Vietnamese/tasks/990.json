			},
			"dialogs": [
				{
					"id": 9901508,
					"content": "Đã quen ở đây chưa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901509
					]
				},
				{
					"id": 9901519,
					"content": "Có muốn nói chuyện không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901520
					]
				},
				{
					"id": 9901536,
					"content": "Có việc gì muốn làm không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901537
					]
				},
				{
					"id": 9901509,
					"content": "Tôi rất thích nơi này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901510
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901510,
					"content": "Phong cách khác với ở Mondstadt, đối với tôi mà nói thì cảm giác này thật mới lạ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901511
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901511,
					"content": "Khi tập hát cũng có thể tự do điều chỉnh giọng, không cần lo lắng sẽ làm phiền đến người khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901512
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901512,
					"content": "Giọng hát của Barbara thì không thể nói là làm phiền được nhỉ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901513
					]
				},
				{
					"id": 9901516,
					"content": "Vậy thì tốt quá rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901517
					]
				},
				{
					"id": 9901513,
					"content": "Ừm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901514
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901514,
					"content": "Cảm ơn bạn đã nói vậy, nhưng tôi... vẫn nên suy nghĩ đến cảm nhận của người khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901515
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901515,
					"content": "Tóm lại, tôi rất vui vì nhận được lời mời của bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901516
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901517,
					"content": "Ừm, tôi rất vui vì nhận được lời mời của bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901518
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901518,
					"content": "Tôi vẫn muốn ở đây thêm chút nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901520,
					"content": "A, được chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901521
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901521,
					"content": "Hi hi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901522
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901522,
					"content": "Sao bạn đột nhiên lại cười?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901523
					]
				},
				{
					"id": 9901524,
					"content": "A, tôi vừa chợt nhận ra, lâu lắm rồi chưa có thoải mái nói chuyện với bạn bè như thế này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901525
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901525,
					"content": "Đột nhiên cảm thấy rất hạnh phúc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901526
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901526,
					"content": "Barbara dễ hài lòng thật đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901527
					]
				},
				{
					"id": 9901530,
					"content": "Vì Barbara luôn suy nghĩ cho người khác.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901531
					]
				},
				{
					"id": 9901527,
					"content": "Ồ ồ, vậy sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901528
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901528,
					"content": "Nhưng mà hình như cũng không phải việc gì xấu mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901529
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901529,
					"content": "Nếu dễ cảm nhận được hạnh phúc thì sẽ có rất nhiều năng lượng, sau đó có thể đem cảm giác hạnh phúc truyền lại cho người khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901530
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901531,
					"content": "Đó là chuyện đương nhiên mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901532
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901532,
					"content": "Tôi luôn nhận được sự quan tâm của mọi người, tôi cũng muốn đem sự nỗ lực của bản thân để báo đáp lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901533
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901533,
					"content": "Không hổ là Barbara",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901534
					]
				},
				{
					"id": 9901534,
					"content": "Này, đừng có khen tôi mãi thế chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901535
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901535,
					"content": "Có phê bình... thì mới có tiến bộ, phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901537,
					"content": "À, gần đây tôi có tập luyện một bài hát mới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901538
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901538,
					"content": "Nhưng có một số chi tiết vẫn chưa nắm vững lắm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901539
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901539,
					"content": "Khi lặp lại điệp khúc có nên cao giọng hơn không, bước nhảy có cần cải tiến thêm không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901540
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901541,
					"content": "Tôi sẽ \"toàn lực hỗ trợ\" cho bạn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901542
					]
				},
				{
					"id": 9901542,
					"content": "Đây là sự vinh hạnh của tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901543
					]
				},
				{
					"id": 9901540,
					"content": "Nếu không phiền thì... tôi muốn bạn xem tôi biểu diễn, sau đó cho ý kiến giúp tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901541
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901543,
					"content": "Cảm ơn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901544
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901544,
					"content": "Nếu có chỗ làm chưa tốt, thì đừng cười tôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901545
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901545,
					"content": "Tôi đã suy nghĩ rất nhiều lần mới có đủ can đảm biểu diễn cho bạn xem ở chỗ gần như vậy đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901546
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901547,
					"content": "Không đâu, yên tâm đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901548
					]
				},
				{
					"id": 9901546,
					"content": "Nếu bạn cười tôi, thì tôi không biết trốn đi đâu nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901547
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901549,
					"content": "Phù... được rồi",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901550
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901550,
					"content": "Vậy thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901551
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901551,
					"content": "Buổi Diễn, Bắt Đầu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Barbara"
				}
			]
