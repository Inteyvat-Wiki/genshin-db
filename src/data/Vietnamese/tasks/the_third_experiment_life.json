	"talks": [
		{
			"id": 1104301,
			"completionStepIds": [
				1104301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104301",
							"2"
						],
						"stepId": 1104301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110430101,
					"content": "Không phải là bắt bọn tôi nhảy từ trên cao xuống đó chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110430102,
					"content": "Không nhất thiết, nếu mọi người có cách tốt hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430103,
						110430104
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110430103,
					"content": "Bắt buộc phải có.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110430105
					]
				},
				{
					"id": 110430105,
					"content": "Cho dù dùng cách gì, chỉ cần có thể đến được bờ hồ bên kia, xem như đã hoàn thành thực nghiệm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430106
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110430106,
					"content": "#Căn cứ thời gian hoàn thành của {F#cô}{M#cậu}, và tốc độ nhanh nhất, tôi sẽ phân tích và so sánh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430107
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110430107,
					"content": "#Bờ hồ bên kia, cũng có nghĩa là muốn {M#anh ấy}{F#cô ấy} bơi trong Núi Tuyết?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110430108,
					"content": "Khi không bị hạn chế điều kiện, bản năng của con người sẽ thôi thúc chọn những thứ mình cho là phù hợp nhất để hoàn thành mục tiêu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430109
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110430109,
					"content": "Có thể có người không chịu đựng nổi nước trong băng tuyết, nhưng có thể người khác lại thích cảm giác lạnh thấu xương này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430110
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110430110,
					"content": "Cho dù chọn cách nào, cũng là một phần của việc thực nghiệm, cách nào cũng có giá trị nghiên cứu của nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430111,
						110430112
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110430111,
					"content": "Được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110430113
					]
				},
				{
					"id": 110430113,
					"content": "#Vậy nhờ {F#cô}{M#cậu} nhé, rất mong chờ phần thể hiện của {F#cô}{M#cậu}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110430112,
					"content": "Việc này so với siêu năng lực còn nhẹ nhàng hơn nhiều.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110430113
					]
				},
				{
					"id": 110430104,
					"content": "Cách trả lời mơ hồ này thật khiến người ta căng thẳng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110430105
					]
				}
			]
		},
		{
			"id": 1104303,
			"completionStepIds": [
				1104303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104303",
							"2"
						],
						"stepId": 1104303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110430301,
					"content": "#Vất vả cho {F#cô}{M#cậu} rồi, biểu hiện của {F#cô}{M#cậu} làm tôi ngưỡng mộ đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430302
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110430302,
					"content": "Không hổ danh là Nhà Lữ Hành trong truyền thuyết, những số liệu này vượt ngoài chuẩn mực trung bình của Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430303
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110430303,
					"content": "Nhưng anh luôn theo sát bọn tôi mà, hình như chẳng biết mệt là gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110430304,
					"content": "Tôi sao? Thật ra tôi có dùng một ít thuật giả kim để lười nhác, nhưng những thứ này không quan trọng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430305
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110430305,
					"content": "#Nếu quy luật của Teyvat không ảnh hưởng đến {F#cô}{M#cậu}, thì tôi có thể suy đoán được một vài loại văn minh của dị giới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430306
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110430306,
					"content": "#Nếu quy luật của Teyvat ảnh hưởng đến {F#cô}{M#cậu}, thì tôi cũng có thể đoán được sẽ xảy ra diễn biến thế nào khi không bị ảnh hưởng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430307
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110430307,
					"content": "Có vô số khả năng trong đó, thực sự quá thú vị, đáng để thử nhiều lần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430308
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110430308,
					"content": "Nhưng... Điều này giúp ích gì cho nghiên cứu của anh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110430309,
					"content": "Vấn đề khiến tôi phiền não bấy lâu cuối cùng cũng được giải quyết, đợi sau khi quay về nơi trú ẩn, tôi sẽ cho mọi người xem một số thứ đặc biệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430310
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110430310,
					"content": "Anh cũng đã nghiên cứu những thứ khác tương tự như vậy sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110430311
					]
				},
				{
					"id": 110430311,
					"content": "#Thế thì {F#cô}{M#cậu} sắp bị so sánh với những thứ kỳ quái rồi, có thể {F#cô}{M#cậu} sẽ không vui đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430312
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110430312,
					"content": "Vàng, cổ thụ hóa đá, mặt trời to gấp 8 lần...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430313
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110430313,
					"content": "Quá trình nghiên cứu bản chất khiến người ta say sưa. Đáng tiếc rằng thời gian say sưa đó chỉ trong chốc lát mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430314
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110430314,
					"content": "Tôi thà rằng dồn hết tinh thần vào trong đó, thế nhưng mọi thứ đều có giới hạn, khi dần dần biết được những thứ không biết... thì cảm giác thú vị đó cũng sẽ dần mất đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430315
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110430315,
					"content": "Cuối cùng chúng cũng sẽ biến thành sự tồn tại tầm thường như Quả Nhật Lạc, Hoa Ngọt, không còn đáng để bỏ thời gian vào nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430316
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110430316,
					"content": "Ồ, cho nên những bức tranh về Hilichurl do anh vẽ, những Hilichurl khác nhau sẽ có sự khác biệt rõ rệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110430317,
					"content": "Đúng, lúc đó tôi cũng nói, \"Rất nhàm chán, không đáng để lãng phí thời gian\". Bởi vì đối với tôi, cảm giác thú vị đã mất từ lâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430318
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110430318,
					"content": "Thế sau khi thực nghiệm, chúng tôi trong mắt anh cũng sẽ như vậy sao? Biến thành... haizz... bản nháp?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110430319,
					"content": "Không cần lo lắng, mọi người là người hỗ trợ của tôi, tình nghĩa này tôi sẽ không quên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430320
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110430320,
					"content": "Được rồi, trước khi trở về nơi trú ẩn, chúng ta hãy thực hiện một việc sau cùng, đó chính là thực nghiệm trí tuệ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430321
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110430321,
					"content": "Theo tôi nào, giờ chúng ta sẽ đến di tích bên kia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				}
			]
		},
