			"dialogs": [
				{
					"id": 730750101,
					"content": "#Nara {NICKNAME} và Paimon, cảm ơn các bạn, bây giờ vườn ươm của Vanarana đã mọc đầy Viparyas.",
					"roleType": "TALK_ROLE_NPC",
