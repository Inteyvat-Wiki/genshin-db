					"nextDialogs": [
						240050609
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050609,
					"content": "#Hihi, vậy thì em ăn đây! {M#Anh trai}{F#Chị gái} cũng mau ăn đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050610
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050610,
					"content": "Đúng rồi, anh phải chạy đi mua cà phê cho chú Delerue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050611
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050611,
					"content": "Đợi đã, không được đâu! Mẹ em đã cấm bố uống cà phê từ lâu lắm rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050612
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050612,
					"content": "Mỗi lần bố uống cà phê là lại ho suốt đêm, giọng nói cũng khàn cả đi.",
