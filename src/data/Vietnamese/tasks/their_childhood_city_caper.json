						240050604
					],
					"speakerTitle": "Louis"
				},
				{
					"id": 240050604,
					"content": "#Tuyệt quá! {M#Anh trai}{F#Chị gái}, Verut và anh Aurele nữa, mau thưởng thức đi, ngon lắm đó.",
					"roleType": "TALK_ROLE_NPC",
