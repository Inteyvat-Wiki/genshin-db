						240050408
					]
				},
				{
					"id": 240050408,
					"content": "Nếu có Trái Bulle ở đây thì tôi có thể làm ra ngay một mẻ nước sốt Trái Bulle, những gia vị khác vẫn còn một ít...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050409
					],
					"speakerTitle": "Louis"
				},
				{
					"id": 240050409,
					"content": "#Hay quá! {M#Anh}{F#Chị} lợi hại thật đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050410
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050410,
					"content": "#Cảm ơn {M#anh}{F#chị}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050411
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050411,
					"content": "#Thật ngại quá, mỗi lần gặp tụi em là {M#anh}{F#chị} lại bị làm phiền.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050412,
						240050413
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050412,
					"content": "Không cần khách sáo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050414
					]
				},
				{
					"id": 240050414,
					"content": "Được thôi... Chú Delerue cũng thường nói em cứng nhắc quá. Nếu muốn trở thành nhà phê bình trong tương lai thì con đường sẽ rất khó khăn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050415
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050415,
					"content": "#Khụ! Không nhắc chuyện này nữa, em sẽ ở đây coi chừng, chuyện Trái Bulle nhờ {M#anh}{F#chị} nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050413,
					"content": "Đừng nên để mất hứng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050414
					]
				},
				{
					"id": 240050407,
					"content": "Tôi sẽ đem một ít Trái Bulle về cho anh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050408
