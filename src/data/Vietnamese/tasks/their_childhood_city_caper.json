				]
			},
			"dialogs": [
				{
					"id": 240050301,
					"content": "Đây chẳng phải là Tòa Soạn Chim Hơi Nước sao, có vẻ như... không có gì đặc biệt nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050302,
						240050303
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050302,
					"content": "Một nơi rất bình thường.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050304
					]
				},
				{
					"id": 240050304,
					"content": "Woa! Không ngờ chim máy móc là có thật! Đúng là lợi hại!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050305
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050305,
					"content": "Lợi hại chứ? Bố thường dẫn tớ đến đây để mua báo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050306
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050306,
					"content": "Bố rất thích tờ báo Chim Hơi Nước, sáng nào cũng xem. Thỉnh thoảng còn cắt vài chỗ trên báo rồi dán vào cuốn sổ để lưu trữ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050307
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050307,
					"content": "Bố nói đây là những bài bình luận mà ông ấy phát biểu, thậm chí đôi lúc còn tự đọc những bình luận đó cho tớ và mẹ nghe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050308
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050308,
					"content": "Tớ với mẹ thì không thích nghe, toàn dùng mấy từ \"được đó\", \"vậy sao\" với \"ra là thế\" để trả lời. Nhưng bố không để tâm, vẫn rất thích thú.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050309
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050309,
					"content": "\"Bài bình luận\" là gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050310
					]
				},
				{
					"id": 240050310,
					"content": "Nói đơn giản, bài bình luận xuất phát từ quan điểm chủ quan của nhà phê bình về một sự việc nào đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050311
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050311,
					"content": "Bố của Lovi, chú Delerue là một nhà khoa học của Viện Khoa Học Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050320
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050320,
					"content": "Đồng thời, cũng là một \"nhà phê bình\" thường xuyên đăng tải \"bài bình luận\" trên tờ báo Chim Hơi Nước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050312
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050312,
					"content": "Đúng rồi, bố rất thích việc viết bài bình luận về bất cứ chuyện gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050313
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050313,
					"content": "Có lúc đang nói chuyện, ông ấy như nhớ ra chuyện gì đó, lại phi vào phòng viết bản thảo. Đến cơm cũng không buồn ăn, chỉ liên tục uống trà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050314
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050314,
					"content": "Haiz... Chỉ cần phát biểu ý kiến là kiếm ra tiền, có công việc như vậy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050315
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050315,
					"content": "Nếu chỉ phát biểu ý kiến thôi thì không thể gọi là \"nhà phê bình\" được. Muốn đăng một bài bình luận đáng được mọi người công nhận, đầu tiên phải tuân thủ một số yếu tố...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050316
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050316,
					"content": "#À ừm... Verut! Còn có {M#anh trai}{F#chị gái} này nữa, mọi người đói chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050317
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050317,
					"content": "Anh Louis mấy ngày trước nói với em, dạo gần đây anh ấy đang bán khoai tây chiên vị Trái Bulle, chúng ta mau tới mua ăn thử đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050318
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050318,
					"content": "Ồ... ừm! Được! Anh Aurele đừng lải nhải nữa, đi thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050319
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050319,
					"content": "Mấy đứa này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050303,
					"content": "Quả thực không có gì đặc biệt...",
					"roleType": "TALK_ROLE_PLAYER",
