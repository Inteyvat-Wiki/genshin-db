				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240050101,
					"content": "Anh mau lên, qua bên đây nè. Căn nhà lớn bên đó chúng ta chưa tới xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050102
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050102,
					"content": "Đi chậm thôi kẻo ngã. Lovi cũng thế, bố em nói sức khỏe của em không tốt, đừng để bị cảm lạnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050103
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050103,
					"content": "Chậc, anh trai cậu lèm bèm thiệt đó, giống hệt mẹ tớ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050104
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050104,
					"content": "Tớ cũng thấy vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050105
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050105,
					"content": "Hai đứa này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050106,
						240050107
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050106,
					"content": "Lại gặp nhau rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050108
					]
				},
				{
					"id": 240050108,
					"content": "#Chào {M#anh trai}{F#chị gái}! Lại gặp nhau rồi, lần này chúng ta không chơi trốn tìm đâu đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050109
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050109,
					"content": "Nói chính xác thì khi nãy vừa chơi xong rồi... Còn bị cô Nour mắng cho một trận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050110
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050110,
					"content": "Chị Nour luôn nghiêm túc như vậy khi làm việc, lúc nào cũng thích giáo huấn người khác. Uổng công em đã mời chị ấy ăn bánh quy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050111
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050111,
					"content": "Nhưng dù sao chơi cũng mệt rồi, em đang muốn đưa Aurele và Verut đi xung quanh một vòng, ăn gì đó ngon miệng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050112
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050112,
					"content": "#{M#Anh trai}{F#Chị gái} có muốn cùng với tụi em... ừm... gọi là gì ấy nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050113
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050113,
					"content": "Đi dạo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050114
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050114,
					"content": "Đúng rồi, đi dạo với tụi em đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050115
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050115,
					"content": "Chúng ta mau tới quảng trường bên kia xem, em muốn xem đài phun nước!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050116,
						240050117
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050116,
					"content": "Vậy phiền em dẫn đường nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050118
					]
				},
				{
					"id": 240050118,
					"content": "Được thôi, vậy chúng ta... tới quảng trường bên kia trước đi, đài phun nước ở đó rất đẹp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050117,
					"content": "Phiền các em dẫn đường nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050118
					]
				},
				{
					"id": 240050107,
					"content": "Mấy đứa đang làm gì thế?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050108
					]
				}
			]
		},
