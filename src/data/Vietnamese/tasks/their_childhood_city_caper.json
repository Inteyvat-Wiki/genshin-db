			"dialogs": [
				{
					"id": 240050201,
					"content": "Woa... Muốn vào đó nghịch nước ghê, hay là dùng đài phun nước để tắm nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050202
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050202,
					"content": "Như vậy sẽ bị mắng đó, đứng ở ngoài xem là được rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050203
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050203,
					"content": "Nhưng mà, nếu không cho người ta vào chơi, vậy làm đài phun nước to như thế để làm gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050204
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050204,
					"content": "Dù có đẹp đến mấy thì cũng chỉ là một cái bồn nước bình thường, chả có gì thú vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050205
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050205,
					"content": "Đây không phải là đài phun nước bình thường, bố đã nói thế nào ấy nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050206
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050206,
					"content": "\"Công dụng lớn nhất của những công trình làm đẹp Đại Sảnh Fontaine, chính là để linh hoạt giải quyết vấn đề kê khai thuế.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050207
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050207,
					"content": "Hôm nay chú Delerue vừa giải thích cho anh về vấn đề này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050208
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050208,
					"content": "Ngay cả giọng điệu cũng giống bố em y đúc... Chẳng trách bố lại thích anh Aurele như vậy. Mỗi lần lại cầm một đống sách đi nói chuyện với anh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050209
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050209,
					"content": "Mặc dù nghe không hiểu, nhưng chắc anh Aurele lại nói mấy lời mất hứng rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050210
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050210,
					"content": "Lovi, chúng ta mau tới chỗ tiếp theo chơi đi, hôm nay khó khăn lắm mới không phải học bài.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050211
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050211,
					"content": "Ừm, chúng ta đi xem chỗ khác thôi. Để nghĩ xem... tòa soạn hình như vẫn mở cửa, chúng ta mau đi thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lovi"
				}
			]
		},
