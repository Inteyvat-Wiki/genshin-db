					"nextDialogs": [
						240050606
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050606,
					"content": "...Yên tâm đi, anh thấy chú Delerue cũng không có hứng thú với khoai tây chiên đâu.",
