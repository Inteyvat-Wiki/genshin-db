			"dialogs": [
				{
					"id": 4660801,
					"content": "Hướng <color=#00E1FFFF>tây bắc của tửu trang</color>, là nơi có Băng Vụ Hoa nhiều nhất Mondstadt. Các khu vực xung quanh cũng mọc rải rác một chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660802
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4660802,
					"content": "Thu thập đủ <color=#00E1FFFF>Băng Vụ Hoa</color>, chúng ta sẽ bàn kế hoạch tiếp theo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Diluc"
