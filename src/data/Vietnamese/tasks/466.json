			"dialogs": [
				{
					"id": 4660101,
					"content": "Lão gia Diluc! Nghe tôi nói...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4660102,
					"content": "Hừ, là tên nhóc Kaeya sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660103
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4660103,
					"content": "Tôi nên sớm nhận ra. Đối với anh ta, đây là cơ hội tốt nhất để gỡ lại một bàn với tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660104
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4660104,
					"content": "Các anh dường như có thù oán gì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4660105,
					"content": "Tạm không nói chuyện này, cách nghĩ của Đội Kỵ Sĩ gần giống với dự đoán của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660106
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4660106,
					"content": "Bây giờ tương kế tựu kế là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660107,
						4660111
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4660107,
					"content": "Tốt nhất đừng đến quán rượu làm thay nữa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4660108
					]
				},
				{
					"id": 4660108,
					"content": "Không được. Nếu Đội Kỵ Sĩ đã biết việc tôi làm thay, nếu không đi ngược lại sẽ gây ra nghi ngờ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660109
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4660109,
					"content": "Đây cũng là âm mưu của Kaeya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660110
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4660110,
					"content": "Vậy phải làm thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4660112,
					"content": "Yên lặng chút, để tôi suy nghĩ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660113
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4660113,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660114
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4660114,
					"content": "...Nếu đã muốn canh chừng tôi, vậy thì làm theo ý anh ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660115
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4660115,
					"content": "Chúng ta hãy tạo ra một \"chứng cứ ngoại phạm\" hoàn mỹ nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660116
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4660116,
					"content": "\"Chứng cứ ngoại phạm\"? Vậy là ý gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4660117,
					"content": "Nếu muốn biết, vậy thì giúp tôi một việc trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660118
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4660118,
					"content": "Lại còn úp mở nữa chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4660119,
					"content": "Hướng <color=#00E1FFFF>tây bắc của tửu trang</color>, là nơi có Băng Vụ Hoa nhiều nhất Mondstadt. Các khu vực xung quanh cũng mọc rải rác một chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660120
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4660120,
					"content": "Nhờ hai người giúp tôi thu thập vài cây về, tôi chuẩn bị một vài thứ khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4660111,
					"content": "Anh có cách gì chưa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4660112
					]
				}
			]
		},
