						4660202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4660202,
					"content": "Ừ... phải đợi bao lâu mới có hiệu quả?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4660203,
					"content": "Lạch cạch... lạch cạch...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4660204,
					"content": "Oa, Slime xuất hiện rồi!... Nhưng mà số lượng có vẻ nhiều hơn tưởng tượng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4660205,
					"content": "Hiệu quả dường như vượt ngoài dự tính rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660206
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4660206,
					"content": "Trước khi trang viên bị đám Slime này làm rối tung lên, hãy giải quyết chúng nó đi.",
					"roleType": "TALK_ROLE_NPC",
