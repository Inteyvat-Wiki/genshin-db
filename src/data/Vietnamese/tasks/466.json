			},
			"dialogs": [
				{
					"id": 4660901,
					"content": "Ồ, đã quay lại rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660902
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4660902,
					"content": "Xin được giới thiệu, đây là người ủ rượu của tửu trang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660903
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4660903,
					"content": "Nhiều Băng Vụ Hoa vậy! Tôi đã bắt đầu mong chờ hiệu quả của \"nó\" rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660904
					],
					"speakerTitle": "Connor"
				},
				{
					"id": 4660904,
					"content": "Thiết bị chiết lọc có thể chịu nổi độ thuần khiết này không, có khi nào xảy ra vấn đề...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660905
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4660905,
					"content": "A... a a a a, ông chủ nói chuyện với tôi rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660906
					],
					"speakerTitle": "Connor"
				},
				{
					"id": 4660906,
					"content": "Yên tâm, lão gia! Chỉ cần là ý của ngài, cho dù tôi trả giá bằng mạng sống cũng cam lòng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660907
					],
					"speakerTitle": "Connor"
				},
				{
					"id": 4660907,
					"content": "Đây không phải việc phải liều cả mạng chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660908
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4660908,
					"content": "Mọi người nói chuyện trước nhé, tôi bắt đầu làm việc đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660909
					],
					"speakerTitle": "Connor"
				},
				{
					"id": 4660909,
					"content": "Anh ấy lấy Băng Vụ Hoa làm gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660910
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4660910,
					"content": "Sự tình là như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660911
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4660911,
					"content": "Thời gian trước khi tửu trang đang nghiên cứu mùi vị mới, có thêm chút Băng Vụ Hoa để tăng cảm giác mát mẻ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660912
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4660912,
					"content": "Sau khi Băng Vụ Hoa được chắt lọc, quả thực có sức hấp dẫn rất lớn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660913
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4660913,
					"content": "Cho nên bán đắt phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660914
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4660914,
					"content": "Không, tôi không phải nói việc thu hút khách, mà là... thu hút Slime.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660915
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4660915,
					"content": "Loại sinh vật sống nhờ vào việc hút sức mạnh Nguyên Tố, hoàn toàn không thể chống lại sự mê hoặc của nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660916
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4660916,
					"content": "Cho nên tôi nghĩ, hay là lợi dụng việc này để làm một số thứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660917
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4660917,
					"content": "*Tiếng đập vào tường*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660918
					],
					"speakerTitle": "Connor"
				},
				{
					"id": 4660918,
					"content": "U oa! Lúc nãy là âm thanh gì!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660919
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4660919,
					"content": "Lạnh... lạnh quá! Lão gia Di... Diluc, đã hoàn thành... chắt lọc, nhưng thiết... thiết bị...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660920
					],
					"speakerTitle": "Connor"
				},
				{
					"id": 4660920,
					"content": "Vất vả rồi, không cần để ý thiết bị, tôi sẽ nói quản gia đi mua lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660921
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4660921,
					"content": "Thật là một phát ngôn hào phóng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660922
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4660922,
					"content": "Thứ lúc nãy nói đến là cái này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660923
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4660923,
					"content": "Băng Vụ Hoa sau khi được chắt lọc - Có thể gọi nó là \"Mồi Nguyên Tố\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660924
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4660924,
					"content": "Lợi hại quá, hơi thở của Nguyên Tố lan tỏa! Nhưng làm sao để thử hiệu quả?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660925
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4660925,
					"content": "Tưới một chút lên mặt đất bên đó, cẩn thận... một chút thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Diluc"
				}
			]
