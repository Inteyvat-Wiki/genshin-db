				{
					"id": 4660708,
					"content": "Không có, chỉ là trong đây nóng quá...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4660709
					]
				},
				{
					"id": 4660709,
					"content": "#Nóng sao? Nhưng tại sao {F#cô}{M#cậu} hình như còn đang thở dốc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660712
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4660712,
					"content": "Này, làm sao đây, Huffman hình như đang nghi ngờ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4660713,
					"content": "Ừm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660714
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4660714,
					"content": "...Xin chào vị tiên sinh này. Mạo muội hỏi một chút...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660715
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4660715,
					"content": "...Anh có nhìn thấy tiên sinh Diluc... à, là người pha chế rượu hôm nay, anh ấy lúc nãy có đi ra ngoài không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660716
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4660716,
					"content": "A, thôi rồi! Lại còn hỏi những vị khách khác... sắp bị lộ rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4660717,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4660718
					]
				},
				{
					"id": 4660718,
					"content": "Ồ... lão gia... à, không không, tiên sinh Diluc luôn ở trong quầy, không đi đâu hết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660719
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 4660719,
					"content": "Vậy sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660720
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4660720,
					"content": "Tiên sinh Huffman, đây là rượu bồ công anh mà ngài đã gọi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660721
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4660721,
					"content": "Uống rồi đi về sớm đi, thay tôi hỏi thăm các vị trong Đội Kỵ Sĩ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660722
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4660722,
					"content": "A... không cần đâu, giờ tôi phải về Đội Kỵ Sĩ phục mệnh gấp, ly rượu này mời ngài vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660723
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4660723,
					"content": "...Hừ... thật là kỳ quái.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660724
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4660724,
					"content": "Phù phù... lúc nãy thật là sợ chết, tôi còn tưởng chắc chắn là bị lộ rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660725
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4660725,
					"content": "Việc này tôi sớm đã có dự tính, cho nên...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660726
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4660726,
					"content": "...Hôm nay ngoài hai người ra, tất cả khách đều là người của Tửu Trang Dawn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660727
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4660727,
					"content": "Toàn bộ sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4660728,
					"content": "Không phải tất cả... à, nói một cách chính xác, là \"ngoài tôi ra\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660729
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4660729,
					"content": "Kaeya! Tại sao anh đến đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660730
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4660730,
					"content": "Chỉ là chọn một vị trí có thể xem kịch hay thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660731
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4660731,
					"content": "Chẳng lẽ... ngay từ lúc đầu anh đã ở đây sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660732
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4660732,
					"content": "Đúng vậy, bộ phim \"Bằng Chứng Ngoại Phạm Của Anh Hùng Bóng Đêm\" thật là hay, còn say hơn cả rượu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660733
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4660733,
					"content": "Hừ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660734
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4660734,
					"content": "Sau đó thì sao? Anh chuẩn bị nói hết cho Đội Kỵ Sĩ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660735
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4660735,
					"content": "Ha ha ha... Anh nên hiểu rõ con người tôi, tôi không có hứng thú gì với việc tố giác cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660736
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4660736,
					"content": "Chỉ đơn thuần muốn biết, Anh Hùng Bóng Đêm của Mondstadt có thể làm đến đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660737
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4660737,
					"content": "Quả nhiên, luôn không làm người khác thất vọng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660738
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4660738,
					"content": "Tôi cũng không phải chứng minh với anh điều gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660739
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4660739,
					"content": "Tất nhiên là vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660740
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4660740,
					"content": "Nhưng điều khiến tôi bất ngờ nhất là Anh Hùng Bóng Đêm cao ngạo cũng chấp nhận sự giúp đỡ của người khác...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660741
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4660741,
					"content": "Xin lỗi quán đóng cửa rồi, mời anh về cho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660742
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4660742,
					"content": "Được rồi được rồi, tối nay tôi cũng không cần uống rượu nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660743
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4660743,
					"content": "Nhưng trước khi tôi rời khỏi, tôi còn có việc muốn nói.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660744
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4660744,
					"content": "Vậy thì nói câu cuối cùng đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660745
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4660745,
					"content": "Diluc, anh có \"trợ thủ\" như vậy, tôi cảm thấy rất yên tâm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660746
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4660746,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660747
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4660747,
					"content": "Chúc mọi người có một đêm thật tuyệt, gặp lại sau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660748
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4660748,
					"content": "Ý của Kaeya là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660749
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4660749,
					"content": "Đừng để ý đến anh ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660750
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4660750,
					"content": "Hai người giúp tôi nhiều như vậy, đây là quà cảm ơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660751
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4660751,
					"content": "Oa! Cám ơn lão gia Diluc!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660752
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4660752,
					"content": "Tuy là đã quen việc hành động một mình, nhưng có sự giúp đỡ của hai người cũng cảm thấy không tệ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660753
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4660753,
					"content": "Sau này có việc gì cần, có thể đến tìm tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4660710,
					"content": "Yên tâm, tôi chỉ là ra cửa vận động một chút.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4660711
					]
				},
				{
					"id": 4660711,
					"content": "Thật sao, nhưng tại sao lại chọn lúc này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660712
					],
					"speakerTitle": "Huffman"
				}
			]
		},
