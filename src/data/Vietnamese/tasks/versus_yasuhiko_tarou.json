			"dialogs": [
				{
					"id": 726990101,
					"content": "Không biết kiếm thuật của các hạ ra sao, tôi rất mong chờ trận chiến này đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990102
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726990102,
					"content": "Sao cả anh cũng...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726990103
					]
				},
				{
					"id": 726990103,
					"content": "Thật ra trước đây tôi đã nói có 4 võ sĩ, là đã tính cả tôi luôn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990104
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726990104,
					"content": "Tuy rằng tôi là người chủ trì trận quyết đấu này, nhưng cũng tại người tham gia ít quá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990105
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726990105,
					"content": "Hơn nữa, thân được sinh ra để chiến đấu, nếu đã gặp được một đối thủ mạnh, thì lý gì mà không đấu một trận chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990106
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726990106,
					"content": "Haha, tôi chờ để nói câu thoại này lâu lắm rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990107
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726990107,
					"content": "Này, người này có được không vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726990108,
					"content": "Không thể khinh địch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726990109
					]
				},
				{
					"id": 726990109,
					"content": "Nói hay lắm! Thái độ tôn trọng tất cả đối thủ của các hạ thật khiến tôi kính nể.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990110
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726990110,
					"content": "Trước đây, nếu không phải tôi nhìn mặt mà bắt hình dong, xem thường vị võ sĩ thứ tư, thì trận đấu đó cũng không thua thảm hại như thế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990111
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726990111,
					"content": "#Nhưng bây giờ tôi đã không còn là tôi lúc đó nữa rồi! Vậy thì, {NICKNAME}, bắt đầu tỉ thí thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990114,
						726990112
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726990114,
					"content": "Lên.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726990115
					]
				},
				{
					"id": 726990115,
					"content": "Lên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726990112,
					"content": "Chờ đã, để tôi chuẩn bị.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726990113
					]
				},
				{
					"id": 726990113,
					"content": "Tôi hiểu rồi, các hạ hãy chuẩn bị đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasuhiko Tarou"
				}
			]
		}
