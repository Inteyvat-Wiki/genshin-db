			},
			"dialogs": [
				{
					"id": 411300601,
					"content": "Sao rồi, bạn đã hạ gục con ma vật đó rồi hả?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300602
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300602,
					"content": "Đã đánh bại nó rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411300603
					]
				},
				{
					"id": 411300603,
					"content": "Tốt quá... cuối cùng đã có thể thở phào nhẹ nhõm rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300604
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300604,
					"content": "Cảm ơn bạn, Nhà Lữ Hành, xin hãy nhận lấy những thứ này coi như quà cảm ơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300605
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300605,
					"content": "Nhưng tại sao đột nhiên loài ma vật này lại xuất hiện xung quanh Khinh Sách Trang, thật kỳ lạ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300606
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300606,
					"content": "Thôi bỏ đi, dù thế nào, tôi cũng phải báo chuyện này lên tổng vụ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300607
					],
					"speakerTitle": "Jinglun"
