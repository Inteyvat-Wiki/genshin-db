					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300403,
					"content": "Sau khi dẹp sạch doanh trại của ma vật, chúng ta lại gặp nhau ở đây.",
					"roleType": "TALK_ROLE_NPC",
