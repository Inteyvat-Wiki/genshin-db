			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jinglun"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411300201,
					"content": "Không được... cần phải có người đến hỗ trợ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300202
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300202,
					"content": "Đã xử dẹp sạch doanh trại ma vật rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411300203
					]
				},
				{
					"id": 411300203,
					"content": "Cảm ơn bạn rất nhiều. Nhưng vừa xảy ra một chuyện bất ngờ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300204
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300204,
					"content": "Ban đầu tôi cho rằng chỉ có một số ma vật bình thường lang thang xung quanh Khinh Sách Trang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300205
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300205,
					"content": "Tôi dẫn theo vài người, vừa xử lý xong một doanh trại ma vật, chuẩn bị nghỉ ngơi trước khi đi tiếp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300206
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300206,
					"content": "Thì trong khu rừng bên cạnh, đột nhiên xuất hiện một vua Mũ Đá Hilichurl...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300207
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300207,
					"content": "Chúng tôi vẫn chưa kịp phản ứng thì đã bị nó tấn công, rất nhiều người đã bị thương... chúng tôi chỉ có thể tạm thời rút lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300208
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300208,
					"content": "Mối đe doạ từ ma vật đó quá lớn, tuyệt đối không thể khoanh tay đứng nhìn. Nhưng những người đi xử lý các doanh trại ma vật khác vẫn chưa trở lại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300209
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300209,
					"content": "Nhà Lữ Hành, bạn có đồng ý giúp đỡ đánh bại ma vật kia không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300210,
						411300212
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300210,
					"content": "Cứ để tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411300211
					]
				},
				{
					"id": 411300211,
					"content": "Cảm ơn bạn, thật ngại quá... đây vốn dĩ là trách nhiệm của chúng tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300212,
					"content": "Những người bị thương sao rồi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411300213
					]
				},
				{
					"id": 411300213,
					"content": "May mà chữa trị kịp thời, đều không có gì đáng ngại... nhưng trong thời gian ngắn không thể đi lại được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300214
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300214,
					"content": "Cho nên, Nhà Lữ Hành, chỉ có thể nhờ bạn xử lý con ma vật đó rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300215
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300215,
					"content": "Thật ngại quá... đây vốn dĩ là trách nhiệm của chúng tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinglun"
				}
			]
		},
