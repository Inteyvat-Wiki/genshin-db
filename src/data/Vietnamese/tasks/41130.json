			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jinglun"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411300101,
					"content": "Nhà Lữ Hành, bên này, tôi ở đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300102
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300102,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411300103
					]
				},
				{
					"id": 411300103,
					"content": "Còn việc của Khinh Sách Trang. Bởi vì thiên thạch rơi đã khiến những ma vật xung quanh hoành hành khắp nơi, tàn phá bừa bãi, Khinh Sách Trang gần như đã bị chúng bao vây rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300106
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300106,
					"content": "Mặc dù Khinh Sách Trang được chúng tôi bảo vệ, sẽ không xảy ra vấn đề gì lớn, nhưng đồ tiếp tế vẫn phải từ bên ngoài chuyển vào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300107
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300107,
					"content": "Tình hình hiện tại, tổng vụ không thể phái nhiều người hộ tống... nếu gặp phải số lượng lớn ma vật, e rằng vật tư sẽ gặp nguy hiểm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300108
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300108,
					"content": "Vì vậy, tôi và vài anh em đang nghĩ... cho dù không thể rời khỏi Khinh Sách Trang quá xa, nhưng chúng tôi vẫn có thể xử lý bớt một số ma vật xung quanh đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300109
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300109,
					"content": "Đây cũng coi như giúp đỡ các anh em đang vận chuyển đồ đến đây. Nhưng dựa theo lần trinh sát trước của chúng tôi, xung quanh đây vẫn còn khá nhiều điểm tập hợp ma vật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300110
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300110,
					"content": "Chỉ dựa vào chúng tôi, rất khó để quét sạch các doanh trại ma vật này. Mà nếu thời gian kéo dài, tôi sợ rằng Khinh Sách Trang sẽ xảy ra vấn đề...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300111
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300111,
					"content": "Nhà Lữ Hành, bạn có đồng ý giúp đỡ chúng tôi xử lý một phần đám ma vật kia không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinglun"
				}
			]
		},
		{
			"id": 4113002,
			"completionStepIds": [
				4113003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4113003",
