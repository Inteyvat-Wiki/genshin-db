						411300402
					]
				},
				{
					"id": 411300402,
					"content": "Tốt quá, vậy tôi đi gọi những người khác. Chúng ta lập tức xuất phát, đánh nhanh thắng nhanh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300403
