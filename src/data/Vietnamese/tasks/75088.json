			"dialogs": [
				{
					"id": 750880101,
					"content": "Sao nào, mọi người đã tìm thấy mảnh ghép của Chữ Khắc Lấp Lánh chưa...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chuno"
				}
			]
		},
		{
			"id": 7508802,
			"completionStepIds": [
				7508802
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7508802",
							"2"
						],
						"stepId": 7508802,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chuno"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750880201,
					"content": "Haha, tuyệt lắm, vậy thì tôi chắc chắn có thể giải mã hoa văn vàng trên Chữ Khắc Lấp Lánh rồi... Treo thưởng, treo thưởng nhất định sẽ thuộc về tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880202
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880202,
					"content": "Chi bằng nói nếu lần này thất bại thì sẽ hoàn toàn không còn kinh phí nữa. Sống chết thành bại đều tùy vào chuyện này rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880203
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880203,
					"content": "À, đây là thù lao cho mọi người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chuno"
				}
			]
		},
		{
			"id": 7508803,
			"completionStepIds": [
				7508803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7508803",
							"2"
						],
						"stepId": 7508803,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chuno"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750880301,
					"content": "Hmm, nếu có đủ mẫu vật thì nói không chừng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880302
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880302,
					"content": "Ồ, ở đây có một người kỳ lạ đang lẩm bẩm này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750880303,
					"content": "Người như tôi ở Natlan đâu đâu cũng có. Người kỳ lạ ở đây là các người đấy... Nếu không có gì thì đừng làm phiền tôi nghiên cứu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880304
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880304,
					"content": "Chi tiêu tháng này của tôi đã vượt mức dự kiến rồi, chỉ còn cách giải quyết vấn đề nghiên cứu mà hiệp hội treo thưởng để bù đắp vào thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880305
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880305,
					"content": "Thì ra làm nghiên cứu còn có được tiền à...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750880306,
					"content": "Đúng vậy. Hiệp Hội Nghiên Cứu Di Vật Saurian chính là kiểu tổ chức như vậy đó. Có thưởng thì mới có thể thúc đẩy mọi người nghiên cứu các chủ đề khác nhau chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880307
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880307,
					"content": "Lần này tôi sẽ thử giải mã Chữ Khắc Lấp Lánh... Nghe nói đó là sự nghiệp vĩ đại mà chưa ai hoàn thành, số Mora nhận được cũng rất nhiều...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880308
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880308,
					"content": "Nhưng mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880309
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880309,
					"content": "Nhưng mà sao thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750880310,
					"content": "Nếu muốn giải mã chúng thì trước tiên phải có đủ mảnh ghép Chữ Khắc Lấp Lánh đã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880311
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880311,
					"content": "Hmm... Vậy nhé, nếu các vị tìm được mảnh ghép Chữ Khắc Lấp Lánh thì tôi sẽ trả thù lao cho các vị, thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880312
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880312,
					"content": "Nhìn hai vị có vẻ là nhà mạo hiểm giàu kinh nghiệm, chắc thường nhận những ủy thác như vậy nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880313
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880313,
					"content": "Cũng không phải không được, nhưng chi tiêu tháng này không phải đã vượt mức rồi sao...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750880314,
					"content": "Nếu đã vượt mức rồi, thì vượt ít vượt nhiều không còn là vấn đề nữa... Chỉ cần lấy được mảnh ghép Chữ Khắc Lấp Lánh, giải mã được nội dung trong đó thì muốn bao nhiêu Mora cũng có!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880315,
						750880316
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880315,
					"content": "Chúng tôi chỉ phụ trách tìm mảnh ghép thôi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750880317
					]
				},
				{
					"id": 750880317,
					"content": "Các vị chỉ cần đảm bảo lấy được hàng thật là được rồi. Nói ra là thấy tức, tháng này có người đã bán cho tôi một di vật bí ẩn, nhưng đó lại là đồ giả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880318
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880318,
					"content": "Và đã lừa tôi một khoản Mora lớn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880319
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880319,
					"content": "À, hóa ra vì vậy nên mới vượt mức chi tiêu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750880320,
					"content": "Cho nên, phải dùng mảnh ghép Chữ Khắc Lấp Lánh để xoay chuyển tình thế!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880321
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880321,
					"content": "Làm ơn nhé, việc tìm mảnh ghép nhờ vào các vị rồi! Nếu tìm thấy nhất định phải đem đến chỗ tôi nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880322
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880322,
					"content": "À, cũng không cần quá nhiều đâu, chỉ cần... ba, không, bốn mảnh ghép đi! Nhiều hơn thì tôi thật sự không trả nổi thù lao đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880316,
					"content": "Không đảm bảo là mảnh ghép sẽ có tác dụng đâu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750880317
					]
				}
			]
		},
