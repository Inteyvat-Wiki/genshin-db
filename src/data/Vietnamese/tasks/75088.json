			"dialogs": [
				{
					"id": 750880601,
					"content": "#Là {F#cô}{M#cậu} à! Cảm ơn những mảnh ghép Chữ Khắc Lấp Lánh mà {F#cô}{M#cậu} đã mang đến nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880602
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880602,
					"content": "Nhưng tiến độ giải mã có chút đáng lo. Nhìn có vẻ giống với Chữ Khắc Phlogiston, nhưng lại phức tạp hơn nhiều so với trong tưởng tượng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880603
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880603,
					"content": "Đã không còn đường lui nữa rồi... Tôi nhất định phải giải mã thành công mới được, haha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chuno"
				}
			]
		}
	]
