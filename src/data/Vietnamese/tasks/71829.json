			]
		},
		{
			"id": 7182903,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182902",
							"2"
						],
						"stepId": 7182902,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jiangxue"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718290301,
					"content": "Ủa? Bạn đúng là khách hiếm thấy đó. Bình thường chỉ có tôi và đầu bếp nhìn nhau không nói gì, hôm nay có thêm bạn, không chừng sẽ náo nhiệt hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290302
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290302,
					"content": "Mà hôm nay tôi thấy đầu bếp đó mặt mày rầu rĩ, không biết gặp phải chuyện buồn phiền gì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiangxue"
				}
			]
		},
		{
			"id": 7182904,
			"completionStepIds": [
				7182903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182903",
							"2"
						],
						"stepId": 7182903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jiangxue",
					"Yanxiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718290401,
					"content": "Món thịt viên này mùi vị cũng khá đó, thịt vừa vào miệng đã tan, nước sốt thì có hương thơm đậm đà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290402
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290402,
					"content": "Ồ? Cho gạch cua vào trong thịt à, thảo nào mùi vị thơm ngon lạ thường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290403
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290403,
					"content": "Nào, Nhà Lữ Hành, bạn cũng nếm thử xem. Để tôi chỉ bạn, trước tiên dùng đũa kẹp vỡ thịt viên, chấm vào nước sốt, nhai chung với cơm trắng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290404,
						718290405,
						718290407
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290404,
					"content": "Khách sáo khách sáo rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290409
					]
				},
				{
					"id": 718290409,
					"content": "Hai người ăn ngon đi, dù sao thì tôi cũng sắp hết được làm ở đây rồi, bạn muốn ăn cũng không ăn được nữa đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290410
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718290410,
					"content": "Không làm ở đây nữa ư...Chuyện này là như thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290411
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290411,
					"content": "Nè, không lẽ do tôi cứ ở đây ăn uống quá nhiều mà anh bị chưởng quỹ ghét bỏ sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290412
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290412,
					"content": "Mà cũng không đúng, tôi cũng thường câu được cá và đem tặng cho nhà trọ, chắc cũng bù được cho tiền cơm chứ, mà chưởng quỹ cũng không giống dạng người nhỏ mọn vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290413
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290413,
					"content": "Thôi anh lo đi ngủ sớm đi, mấy con cá đó của anh đủ cho ai ăn chứ, cuối cùng chẳng phải cũng vào bụng anh hết rồi ư?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290414
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718290414,
					"content": "Vậy rốt cuộc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290415
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290415,
					"content": "Haizz...Thôi được rồi, để tôi kể cho anh nghe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290416
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718290416,
					"content": "Bán chạy, mùi vị ngon, thể hiện tài nghệ, và có kiểu cách...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290417
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290417,
					"content": "Hahaha, chưởng quỹ như vậy là muốn anh làm một món ăn kỳ diệu mà thế gian này không thể có rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290418
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290418,
					"content": "Anh cứ cười đi, cười tiếp đi. Để tôi coi sau khi tôi đi rồi thì anh có thể ăn ké uống ké ai được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290419
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718290419,
					"content": "Không cười nữa, không cười nữa. Bởi tôi cũng tự hỏi hôm nay không biết tại sao anh lại rầu rĩ như vậy, hóa ra là gặp phải chuyện này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290420
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290420,
					"content": "Còn phải nói sao, cũng chẳng hiểu sao chưởng quỹ đột nhiên lại có suy nghĩ như vậy, làm tôi khổ sở muốn chết...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290421
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718290421,
					"content": "Mà anh đừng lo quá. Tuy tôi không biết nấu ăn, nhưng tôi biết công thức của một món ăn kỳ diệu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290422
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290422,
					"content": "Hồi trước lúc tôi đi phiêu lưu khắp nơi, vô tình gặp một gia đình giàu có, họ ăn một món ăn rất kỳ diệu, có tên là \"Gà Nấu Đậu\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290423
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290423,
					"content": "Món ăn này \"ăn thịt nhưng không thấy thịt\", ăn vào mềm như đậu, lại có hương thơm nồng, vô cùng thơm ngon, rất xứng với danh xưng món ngon \"lấy thịt làm rau\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290424
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290424,
					"content": "Sau khi ăn vào, tôi vô cùng hiếu kỳ bèn đi hỏi xin công thức chế biến, nhưng...Tôi lại không giỏi nấu ăn, nên công thức này chỉ đành để đóng bụi suốt bao năm thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290425,
						718290428
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290425,
					"content": "Công thức chế biến này, anh làm sao mà xin được vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290426
					]
				},
				{
					"id": 718290426,
					"content": "Ừm...Đơn giản mà nói, lúc đó tôi đã giúp đỡ gia đình đó, nên họ làm tiệc chiêu đãi tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290427
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290427,
					"content": "Người đầu bếp nghiên cứu ra món này cũng rất tự tin, nói rằng trong thiên hạ số người có thể làm ra món này chỉ đếm trên đầu ngón tay, nên chép công thức cho tôi cũng không có vấn đề gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290429
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290429,
					"content": "Món này quả thực rất khó làm. Theo cách nói của đầu bếp đó, người có thể làm ra món này không chỉ phải tinh thông tài nghệ làm bếp, mà còn phải am hiểu kiếm thuật nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290430
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290430,
					"content": "Chậc, món ăn gì mà phải biết kiếm thuật nữa. Giả sử muốn cắt thịt thì đao pháp của tôi cũng đủ rồi mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290431
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718290431,
					"content": "Nếu anh thật sự dùng đao pháp đó đi băm thịt, thì e rằng thịt chưa nhuyễn là thớt đã gãy đôi rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290432
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290432,
					"content": "Theo cách nói của đầu bếp đó, tinh hoa của món ăn này đều nằm ở chỗ thịt băm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290433
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290433,
					"content": "Bắt buộc phải dùng dao theo cách kiếm thuật điêu luyện, trước tiên dùng lưỡi dao lọc bỏ gân, băm nhỏ thịt, sau đó dùng mặt lưng của dao băm thịt nhuyễn, rồi sau đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290434
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290434,
					"content": "Ngừng, anh ngưng lại dùm tôi...Vậy công thức anh nói, à mà có nói cũng như không thôi, tôi là người thường xuyên dùng dao đây này, anh lại là người chưa từng vào bếp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290435
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718290435,
					"content": "Ở đâu tìm ra một người vừa biết vào bếp, lại vừa giỏi dùng kiếm đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290436
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718290436,
					"content": "Cái này sao...Xa tận chân trời, gần ngay trước mắt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290437,
						718290439
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290437,
					"content": "Tôi...tôi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290438
					]
				},
				{
					"id": 718290438,
					"content": "Đúng vậy. Nhà Lữ Hành này không phải vừa biết vào bếp, lại cũng giỏi dùng kiếm sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290441
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290441,
					"content": "#Hay là để {M#anh ấy}{F#cô ấy} thử làm món này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290442
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290442,
					"content": "Nhưng mà chưởng quỹ muốn Yanxiao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290443
					]
				},
				{
					"id": 718290443,
					"content": "Haiz, chưởng quỹ muốn đầu bếp nghiên cứu ra món mới, chỉ cần có món mới rồi, thì chuyện do ai làm có thể thương lượng mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290444
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290444,
					"content": "Đầu bếp, anh nói xem phải vậy không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290445
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290445,
					"content": "Ừm...đúng! Chính là như vậy đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290446
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718290446,
					"content": "Mà món Gà Nấu Đậu này rốt cuộc là dùng nguyên liệu gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290447
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718290447,
					"content": "Nguyên liệu chỉ là các món bình thường, chỉ cần có Thịt Gia Cầm, Giăm Bông, Trứng Chim và Cỏ Kim Ngư là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290448
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290448,
					"content": "Thịt Gia Cầm và Giăm Bông thì trong bếp còn, nhưng Trứng Chim và Cỏ Kim Ngư hình như tôi đã dùng hết rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290449
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718290449,
					"content": "Haizz, nếu biết sớm thì đã không làm món Trứng Nhung Tùng rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290450
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718290450,
					"content": "Nhà Lữ Hành, hãy giúp tôi tìm một ít Trứng Chim và Cỏ Kim Ngư nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290451
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718290451,
					"content": "Sau khi tìm được, chúng ta cùng nghiên cứu làm món Gà Nấu Đậu này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290452
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718290452,
					"content": "Chậc...Đương nhiên, sẽ không thiếu phần thù lao của bạn đâu. Việc này phải nhờ bạn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718290439,
					"content": "Đúng là tôi có biết chút ít về nấu ăn...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290440
					]
				},
				{
					"id": 718290440,
					"content": "Cũng rất giỏi dùng kiếm, đúng không? Tôi bình thường cũng có quan sát bạn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290441
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290428,
					"content": "Món ăn này chắc chắn rất khó làm phải không...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290429
					]
				},
				{
					"id": 718290405,
					"content": "Bạn cũng am hiểu ghê...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290406
					]
				},
				{
					"id": 718290406,
					"content": "Ha ha ha, thường xuyên được ăn món ngon, thì cho dù tôi có ngốc đến mức nào cũng phải am hiểu chút ít chứ, để tôi chỉ bạn cách thưởng thức món cá hấp này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290409
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290407,
					"content": "Bạn không ngồi xuống cùng ăn sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290408
					]
				},
				{
					"id": 718290408,
					"content": "Tôi? Tôi nuốt không nổi, tôi bị chưởng quỹ mắng đến no luôn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290409
					],
					"speakerTitle": "Yanxiao"
				}
			]
