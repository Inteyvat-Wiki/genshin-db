						718291405
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718291405,
					"content": "Thật không ngờ nha, tên ăn chực kia, anh cũng có bản lĩnh lắm chứ, có thể nhớ rõ công thức như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291406
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718291406,
					"content": "Haha, nói ra không sợ anh cười. Lúc đó tôi vốn tưởng rằng trong công thức này có ẩn chứa kiếm pháp gì đó, nên ráng xin cho được để về nghiên cứu ngày đêm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291407
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718291407,
					"content": "Bây giờ nhìn lại, lúc đó đúng là luyện kiếm luyện đến điên luôn rồi, chỉ là một công thức nấu ăn mà thôi, làm gì có kiếm pháp gì chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291408
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718291408,
					"content": "Lúc đó bạn luyện kiếm rốt cuộc là vì...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718291409
					]
				},
				{
					"id": 718291409,
					"content": "Đi tìm một người, đòi lại công bằng mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291410
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718291410,
					"content": "Rõ ràng là một chuyện rất có khí phách, mà sao anh nói ra nghe nó mềm èo vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291411
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718291411,
					"content": "Ha ha, sau khi đòi lại công bằng, tôi đã đến đây. May được chưởng quỹ thu nhận, cho phép tôi làm một kẻ ăn không ngồi rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291412
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718291412,
					"content": "Nay tôi đã không còn nguyện vọng gì khác, không vung kiếm nữa, cũng không có ưu điểm gì...Ha ha ha, cứ ở đây sống cho qua phần đời còn lại, kể cũng không tồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291413
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718291413,
					"content": "Này, công thức món ăn tôi cũng chép cho bạn một phần, khi nào có thời gian, bạn có thể tự mình làm ăn thử, tuy rằng hơi phức tạp, nhưng quả thực rất ngon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291414,
						718291415
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718291414,
					"content": "Cám ơn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718291417
					]
				},
				{
					"id": 718291417,
					"content": "Ừm...Món này để sang một bên trước, chờ chưởng quỹ đến tôi sẽ đưa cho cô ấy xem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291418
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718291418,
					"content": "Rồi còn...Này này này, ăn chực, anh cũng đừng đi, qua đây này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291419
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718291419,
					"content": "Anh muốn làm gì? Tôi không còn công thức nào khác cho anh đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291420
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718291420,
					"content": "Anh không phải nói là, ngoài việc vung kiếm thì anh không còn sở trường gì khác sao? Lại đây, rút kiếm ra, tôi dạy anh cắt thịt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291421
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718291421,
					"content": "Cắt thịt? Chuyện này...tôi chỉ sợ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291422
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718291422,
					"content": "Mau làm đi. Phải học cắt thịt trước rồi học nấu ăn, học làm vài món ngon, ít nhiều gì cũng phải biết chút tài nghệ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291423
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718291423,
					"content": "Ý anh là muốn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291424
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718291424,
					"content": "Hừ...là muốn nhanh chóng dạy cho anh nấu ăn, tránh sau này anh cứ ở đây ăn ké riết...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291425
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718291425,
					"content": "Mau lên! Rề rề rà rà vậy, còn lề mề là mai đừng mong có món thịt viên cho ăn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291426
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718291426,
					"content": "Ơ cái tên đầu bếp này! Sao lại uy hiếp tôi như vậy chứ, tôi cắt là được chứ gì, tôi cắt nè.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718291415,
					"content": "Bạn vẫn tiếp tục ở lại đây chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718291416
					]
				},
				{
					"id": 718291416,
					"content": "Đương nhiên rồi, các món ngon của vị đầu bếp này làm ra, tôi ăn hoài không ngán.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291417
					],
					"speakerTitle": "Jiangxue"
				}
			]
		}
	]
