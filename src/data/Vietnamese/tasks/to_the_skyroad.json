			"dialogs": [
				{
					"id": 751350101,
					"content": "Đó chính là Tế Đàn Lửa Nguồn sao? Cảm thấy muốn qua đó thì hơi khó khăn đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751350102,
					"content": "#Phải làm sao đây? Chúng ta có thể bay, nhưng {REALNAME[ID(2)|SHOWHOST(true)]} và Bona thì phải làm sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751350103,
					"content": "Paimon đang coi thường tôi sao? Tôi là nhà mạo hiểm của Hội Hoa Vũ, kinh nghiệm bay của tôi rất phong phú đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350104
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751350104,
					"content": "#Dù có dẫn theo {REALNAME[ID(2)|SHOWHOST(true)]} thì bay qua đó cũng sẽ rất nhẹ nhàng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350105
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751350105,
					"content": "Tôi cũng có giấy phép bay đây.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751350106
					]
				},
				{
					"id": 751350106,
					"content": "Vậy thì tốt rồi. Tôi sẽ dẫn đường phía trước, mọi người chỉ cần theo tôi là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350107
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751350107,
					"content": "Vậy là sắp thử thách tốc độ bay rồi đúng không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751350108
					]
				},
				{
					"id": 751350108,
					"content": "Lúc này thì đừng háo thắng thế chứ! Tôi sẽ dẫn đường phía trước, mọi người chỉ cần theo tôi là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350109
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751350109,
					"content": "#Tôi có cảm giác rất nguy hiểm, cũng không biết sẽ xảy ra chuyện gì. {REALNAME[ID(2)|SHOWHOST(true)]} phải bám chắc đấy nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751350110,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				}
			]
