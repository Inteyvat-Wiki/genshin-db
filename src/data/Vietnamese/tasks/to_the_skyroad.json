			"dialogs": [
				{
					"id": 751350201,
					"content": "Woa, Bona bay nhanh quá! Suýt nữa không theo kịp rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751350202,
					"content": "Hihi, xin lỗi xin lỗi. Nhìn thấy Tế Đàn Lửa Nguồn ở phía trước thì tôi lại bất giác...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350203
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751350203,
					"content": "Chỉ cần dùng tế đàn này là có thể đến được Tonatiuh sao? Nhưng dù có xuất hiện luồng gió siêu lớn nào đó thổi chúng ta lên thì cũng không biết phải bay bao lâu nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751350204,
					"content": "Chậc, nghĩ thôi đã thấy lo lắng rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350205,
						751350207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751350205,
					"content": "Đừng sợ, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751350206
					]
				},
				{
					"id": 751350206,
					"content": "Được rồi, nếu đã nói vậy thì lát nữa đừng cách tôi xa quá nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751350209,
					"content": "Tóm lại bây giờ phải dâng Hỏa Lân Thạch lên đó nhỉ? Nhưng chúng ta có hai mảnh... Để an toàn thì cứ đặt chúng lên cả đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bona"
				},
				{
					"id": 751350207,
					"content": "Kích thích thật!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751350208
					]
				},
				{
					"id": 751350208,
					"content": "Đúng chứ? Tôi cũng bắt đầu thấy phấn khích rồi. Là một nhà mạo hiểm thì không thể bỏ qua thử thách này được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350209
					],
					"speakerTitle": "Bona"
				}
			]
		}
