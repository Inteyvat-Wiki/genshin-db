					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3180204,
					"content": "Ừm, đây là Liyue, quốc gia chịu ảnh hưởng bởi Nham Thần, cho nên tạo hình của tượng thần cũng khác biệt.",
					"roleType": "TALK_ROLE_NPC",
