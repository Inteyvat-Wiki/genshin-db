			"dialogs": [
				{
					"id": 706600201,
					"content": "Xin chào, có muốn thử \"Cơn Gió Lạc Lối\" không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600202,
						706600217
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706600202,
					"content": "\"Cơn Gió Lạc Lối\" là gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706600203
					]
				},
				{
					"id": 706600203,
					"content": "À há, hỏi hay lắm, \"Cơn Gió Lạc Lối\" là một trò chơi mang tính lịch sử của Mondstadt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600204
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706600204,
					"content": "Chắc bạn cũng biết ở Thành Mondstadt xưa kia có một nhóm \"Quý Tộc\" nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600205
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706600205,
					"content": "Bọn họ ở Thành Mondstadt ngang ngược hung bạo, khiến cho không ít người khổ đến mức không thể nào diễn tả...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600206
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706600206,
					"content": "Để chống lại những thủ đoạn tàn bạo của các quý tộc, có một nhóm người Mondstadt dũng cảm đã cùng xây dựng một tổ chức kháng chiến bí mật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600207
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706600207,
					"content": "Nhóm hiệp sĩ này liên tục triển khai hành động ở khắp nơi trong thành Mondstadt, để bọn quý tộc nếm mùi đau khổ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600208
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706600208,
					"content": "Nhưng những quý tộc đó cũng nhanh chóng huấn luyện một bọn tay sai chuyên đi trấn áp hiệp sĩ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600209
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706600209,
					"content": "Thế là, các hiệp sĩ và bọn tay sai của quý tộc liên tục triển khai hết trận chiến này đến trận chiến khác ở khắp Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600210
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706600210,
					"content": "\"Cơn Gió Lạc Lối\" chính là lấy đề tài từ sự kiện lịch sử chân thực như sử thi này! Đã từng được mọi người yêu thích...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600211
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706600211,
					"content": "Đã từng?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706600212
					]
				},
				{
					"id": 706600212,
					"content": "Phải, bây giờ những thanh niên trong thành đã không còn hứng thú với \"Cơn Gió Lạc Lối\" nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600213
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706600213,
					"content": "Nhưng tôi không muốn \"Cơn Gió Lạc Lối\" thất truyền như vậy, cho nên đã điều chỉnh lại quy tắc ban đầu của nó cho dễ hiểu hơn, thú vị hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600214
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706600214,
					"content": "Ngoài ra, tôi còn thêm vào tận mấy bản đồ mới. Có lẽ lần này sẽ có nhiều người đến chơi hơn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706600217,
					"content": "Về tình hình \"Cơn Gió Lạc Lối\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706600218
					]
				},
				{
					"id": 706600218,
					"content": "Trước đây tôi đã từng mời người đến chơi thử \"Cơn Gió Lạc Lối\", trong số họ có vài người rất xuất chúng, làm tôi rất ấn tượng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600219
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706600219,
					"content": "Nhưng ngoài họ ra, thì vẫn còn rất nhiều người nói với tôi rằng trò chơi này khó quá, nếu không phải hiệp sĩ khó chạy thoát, thì là thợ săn không tìm được người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600220
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706600220,
					"content": "Còn có người oán trách rằng, nếu muốn chơi được trò này, thì phải thuộc lòng từng chi tiết nhỏ trên mỗi tấm bản đồ, quả thật quá phiền phức, nên mong tôi đơn giản hóa trò chơi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600221
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706600221,
					"content": "Haiz, tôi cũng không biết họ nói có đúng không, nên tôi muốn tìm thêm một nhóm người nữa đến chơi thử, và nghe ý kiến của họ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gygax"
				}
			]
		},
