				"points": []
			},
			"dialogs": [
				{
					"id": 706600101,
					"content": "Chào nhà lữ hành, những chuyến mạo hiểm của bạn vẫn thuận lợi chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600102,
						706600105
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 706600102,
					"content": "Cũng khá thuận lợi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706600103
					]
				},
				{
					"id": 706600103,
					"content": "Thuận lợi là tốt, nếu giữ vững khí thế này tiếp tục mạo hiểm, bạn nhất định sẽ trở thành một Nhà Mạo Hiểm vĩ đại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600104
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 706600104,
					"content": "Đúng rồi, nếu bạn thấy hứng thú thì có thể đến chỗ ngài Gygax để tham gia \"Cơn Gió Lạc Lối\" mùa mới nhất nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600108
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 706600108,
					"content": "Cái này... có liên quan gì đến Hiệp Hội Nhà Mạo Hiểm không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706600109
					]
				},
				{
					"id": 706600109,
					"content": "Cái này... thực ra ngài Gygax cũng có treo một ủy thác để nhờ chúng tôi tìm người tham gia \"Cơn Gió Lạc Lối\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600110
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 706600110,
					"content": "Nhìn từ mặt này thì xem như... cũng có chút liên quan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600111
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 706600111,
					"content": "Nói chung thì nếu như bạn thấy có hứng thú thì có thể đến đó chơi thử. Những người trải nghiệm qua \"Cơn Gió Lạc Lối\" trước đây đều có phản hồi rất tích cực đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 706600105,
					"content": "Có ủy thác gì sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706600106
					]
				},
				{
					"id": 706600106,
					"content": "Ủy thác... cũng không có.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600107
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 706600107,
					"content": "Nhưng nếu bạn thấy hứng thú thì có thể đến chỗ ngài Gygax để tham gia \"Cơn Gió Lạc Lối\" mùa mới nhất nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600108
					],
					"speakerTitle": "Katheryne"
				}
			]
		},
