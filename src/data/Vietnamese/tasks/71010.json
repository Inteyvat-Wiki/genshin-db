			},
			"dialogs": [
				{
					"id": 710100301,
					"content": "Quái vật trên thế giới vốn là tai hoạ, tôi đã học võ rất lâu, trách nhiệm là trừ ma bảo vệ công đạo.",
					"roleType": "TALK_ROLE_NPC",
