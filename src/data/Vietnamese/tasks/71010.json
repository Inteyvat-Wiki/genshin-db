			},
			"dialogs": [
				{
					"id": 710100101,
					"content": "Tôi và sư huynh luyện võ từ nhỏ, dốc lòng trừ ma bảo vệ công đạo. Nhưng muốn bảo vệ công đạo trên thế gian mà không có sự hỗ trợ của Vision thì thật không dễ dàng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710100102
					],
					"speakerTitle": "Kho Báu Di Tích"
				},
				{
					"id": 710100102,
					"content": "Tôi và sư huynh tu luyện ở đây, với mong muốn có được Vision, dựng lên bia này làm chứng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710100103
					],
					"speakerTitle": "Kho Báu Di Tích"
				}
			]
		},
		{
			"id": 7101002,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
