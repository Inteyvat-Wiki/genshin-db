			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710100201,
					"content": "Sư huynh đã có được Vision, vốn nên quét sạch quái vật trên thế gian, nhưng anh lại hỏi tôi rằng quái vật trên thế gian có phải sinh ra đã ác? Những quái vật đang làm loạn thế giới, làm hại người vô tội, lẽ nào không phải là điều tồi tệ nhất? Tôi nghĩ rằng sư huynh thực sự đã tu luyện đến phát ngốc rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710100202
					],
					"speakerTitle": "Kho Báu Di Tích"
				},
				{
					"id": 710100202,
					"content": "Được rồi, cho dù không có Vision, một mình tôi cũng có thể tiêu diệt lũ quái vật!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710100203
					],
					"speakerTitle": "Kho Báu Di Tích"
				}
			]
		},
		{
			"id": 7101003,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
