				"points": []
			},
			"dialogs": [
				{
					"id": 725010201,
					"content": "Tiểu thư Moriko sao cứ phân cho mình loại bản thảo kỳ lạ thế này chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010202,
						725010203
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010202,
					"content": "Cô vẫn đang vẽ tranh minh họa sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725010204
					]
				},
				{
					"id": 725010203,
					"content": "Cô lại chưa có cảm hứng sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725010204
					]
				},
				{
					"id": 725010204,
					"content": "A! Nhà Lữ Hành, sao bạn lại đến đây, lâu rồi không gặp bạn, tôi cứ tưởng bạn đã đến nơi khác du lịch rồi chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010205
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010205,
					"content": "Ôi... Nếu tôi khỏe hơn thì tôi cũng muốn đi du lịch giống như bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010206
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010206,
					"content": "Như vậy thì khỏi phải lo ngày nào cũng bị cô Moriko hối giao bản thảo rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010207
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010207,
					"content": "Mấy bản thảo lần trước tôi vẽ có vẻ được đánh giá rất tốt, rất nhiều tác giả đều muốn tôi vẽ tranh minh họa cho họ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010230
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010230,
					"content": "Tuy tiểu thư Moriko đã giúp tôi từ chối nhiều hợp đồng, nhưng phần còn lại cũng là quá nhiều...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010209
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010208,
					"content": "Hơn nữa, đề tài mà các tác giả viết tiểu thuyết trong \"Nhà Xuất Bản Yae\" ngày càng... ngày càng cường điệu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010209
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010209,
					"content": "Lúc đầu tôi cho rằng ngoài Inazuma ra, họ cùng lắm là viết về Mondstadt, Liyue thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010210
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010210,
					"content": "Nhưng đề tài tiểu thuyết dưới ngòi bút của các tác giả ấy... đã lan tới tận Sumeru và Fontaine luôn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010216
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010216,
					"content": "Ừm... Nói lại chuyện chính nào. Nhà Lữ Hành, chiếc \"máy ảnh\" trong tay bạn vẫn hoạt động tốt chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010217,
						725010218
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010217,
					"content": "Tôi cảm thấy nó vẫn rất tốt...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725010219
					]
				},
				{
					"id": 725010218,
					"content": "Cô lại muốn tôi chụp ảnh giúp cô nữa đúng không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725010219
					]
				},
				{
					"id": 725010219,
					"content": "Bạn xem, thù lao lần trước tôi trả cho bạn tốt đó chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010220
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010220,
					"content": "Nhà Lữ Hành, hãy giúp tôi đi khắp nơi trên thế giới để chụp ảnh nữa nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010221,
						725010224
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010221,
					"content": "Haiz! Được rồi, cứ để tôi lo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725010222
					]
				},
				{
					"id": 725010224,
					"content": "Cô đến Hiệp Hội Nhà Mạo Hiểm để gửi ủy thác đi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725010225
					]
				},
				{
					"id": 725010222,
					"content": "Vậy thì nhờ bạn nhé! Hihi, tôi đã chuẩn bị sẵn sổ tay rồi đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010223
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010223,
					"content": "Nếu bạn không đến tìm tôi thì tôi cũng phải nhờ tiểu thư Moriko đi tìm bạn đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010225,
					"content": "Ôi! Đừng! Cho tôi xin, cho tôi xin đi! Tôi đã đến Hiệp Hội Nhà Mạo Hiểm gửi ủy thác rồi, nhưng không tìm được nhà mạo hiểm nào biết chụp ảnh cả!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010226
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010226,
					"content": "Bạn giúp tôi đi nhé, Nhà Lữ Hành, nếu tôi không giao bản thảo đúng hẹn thì tiểu thư Moriko sẽ lại chạy đến ở chung để hối tôi đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010227
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010227,
					"content": "Tôi không chịu nổi món Sakura Chazuke mà cô ấy làm đâu. Nhà Lữ Hành! Bạn giúp tôi nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010228
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010228,
					"content": "Tôi hiểu rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725010229
					]
				},
				{
					"id": 725010229,
					"content": "Phù... Vậy chờ một chút, để tôi tìm sổ tay đã...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asagiri"
				}
			]
		}
	]
}