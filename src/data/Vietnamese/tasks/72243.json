			"dialogs": [
				{
					"id": 722430102,
					"content": "Tôi có kho báu cần bán.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722430103
					]
				},
				{
					"id": 722430103,
					"content": "Bán kho báu sao? Bất ngờ ghê.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430104
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430104,
					"content": "Nhà mạo hiểm tài ba như bạn, thứ cần bán nhất định sẽ rất hiếm đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430105
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430105,
					"content": "Mau cho tôi xem thử nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430106
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430106,
					"content": "Kể chuyện Ngọc Long Cốt cho Marjorie nghe.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722430107
					]
				},
				{
					"id": 722430107,
					"content": "Ơ, đây chẳng phải Quả Quên Sầu giống như trong câu chuyện của Nhà Thơ sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430108
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430108,
					"content": "Có thứ này tồn tại trên đời thật sao...thì ra nó có tên gọi là Ngọc Long Cốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430109
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430109,
					"content": "Nếu như hiệu quả của nó giống như bạn nói thì tôi sẽ trả 80.000 Mora và một số đặc sản để mua nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430110
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430110,
					"content": "Ừm...80.000 Mora và 5 cái Bánh Mặt Trăng, thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430111,
						722430114,
						722430120
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430111,
					"content": "Cô sẽ làm gì với nó?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722430112
					]
				},
				{
					"id": 722430112,
					"content": "Hì hì, đây là bảo vật đặc biệt mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430113
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430113,
					"content": "Công dụng như trong truyện cổ tích vậy, tôi tin là những thuật sĩ giả kim sẽ không tiếc tiền để mua nó đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430110
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430114,
					"content": "Giá cả công bằng, chốt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722430115
					]
				},
				{
					"id": 722430115,
					"content": "Vậy tôi lấy món bảo vật này nhé, cảm ơn đã chiếu cố.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430116
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430116,
					"content": "Đúng rồi, thông thường mà nói, những thứ như vậy thường sẽ có xu hướng phát tán trong gió.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430117
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430117,
					"content": "Do đó, tốt nhất bạn nên đậy lại bằng màn ngăn hoặc đặt trong hộp kín để đảm bảo chất lượng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430118
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430118,
					"content": "Đây là chút thủ thuật nhỏ tặng bạn thôi, hy vọng sẽ có ích.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430119
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430119,
					"content": "Nếu sau này bạn tìm được những món bảo vật tương tự như vậy thì cứ đến tìm tôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430120,
					"content": "Để tôi suy nghĩ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722430121
					]
				},
				{
					"id": 722430121,
					"content": "Haha, không sao, nhưng tôi tin giá cả của tôi là hợp lý nhất rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430122
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430122,
					"content": "Nếu bạn suy nghĩ xong rồi thì quay lại đây tìm tôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marjorie"
				}
