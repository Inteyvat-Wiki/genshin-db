			"dialogs": [
				{
					"id": 760680101,
					"content": "Aria, xem ra chị cũng đã chọn được cho mình dáng vẻ \"con người\" phù hợp rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680102
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 760680102,
					"content": "Haha, dáng vẻ của Canon cũng khá giống với những gì chị đã hình dung đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680103
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 760680103,
					"content": "Nhưng điều khiến chị bất ngờ là em lại chủ động tạo ra hình hài thế này cho những sinh mệnh nhỏ bé đáng yêu kia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680104
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 760680104,
					"content": "Đây là điều đương nhiên, Aria. Những sinh mệnh yếu ớt kia tin tưởng em, kêu gọi em, thì em cũng sẽ đáp lại tiếng gọi của họ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680105
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 760680105,
					"content": "Chúng ta sinh ra để duy trì thế giới này. Nếu những sinh mệnh mang tên \"con người\" sẵn lòng định cư trong thế giới của chúng ta, thì lắng nghe lời thỉnh cầu của họ cũng chính là sứ mệnh mà nhà vua đã ban cho chúng ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680106
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 760680106,
					"content": "Ừm, dù sao nhà vua cũng từng nói, tất cả sinh mệnh trong biển sao đều là đồng minh của chúng ta trong cuộc chiến chống lại bóng tối.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680107
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 760680107,
					"content": "Nhưng điều chị muốn nói không phải chuyện đó. Ý chị là, không ngờ Sương Nguyệt cũng có lúc tỏ ra cảm tính như vậy. Rất đáng yêu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680108
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 760680108,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680109
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 760680109,
					"content": "...Em thấy, ngôn ngữ của chị đã bắt đầu bị những con người nhỏ bé đó ảnh hưởng rồi đấy, Aria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680110
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 760680110,
					"content": "Từ ngữ của họ luôn mơ hồ như vậy. Đừng dùng nữa, em hoàn toàn không thể hiểu \"đáng yêu\" mà chị nói rốt cuộc muốn diễn tả ý nghĩa gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680111
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 760680111,
					"content": "Ây da, được rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680112
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 760680112,
					"content": "Chị Aria, chị Canon, khi tạo ra hình hài như vậy cho bản thân, điều đầu tiên các chị nghĩ đến lẽ nào không phải là lẻn ra ngoài chơi cùng những người trên mặt đất sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680113
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 760680113,
					"content": "Nếu không thì uổng công tạo hình rồi! Nhanh lên, nhanh lên, nhân lúc không ai phát hiện...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680114
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 760680114,
					"content": "Haha, xem ra em gái yêu quý của chúng ta không thể chờ thêm được nữa rồi, Canon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680115
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 760680115,
					"content": "Khi họ bắt đầu xây dựng nền văn minh trên mặt đất, em còn nói \"Kẻ ngoại lai đó chẳng phải thứ gì tốt đẹp, tạo vật của nó đương nhiên cũng vậy\". Thậm chí còn chẳng thèm nhìn lấy một cái.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680116
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 760680116,
					"content": "Đó, đó là chuyện khác!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680117
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 760680117,
					"content": "Bây giờ em vẫn thấy các chị không nên để kẻ ngoại lai đó tiến vào, nhưng những người trên mặt đất...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680118
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 760680118,
					"content": "Hah... mọi người chơi vui là được rồi. Đi đi, nhớ theo sát Aria đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680119
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 760680119,
					"content": "Hửm? Chị Canon không đi cùng sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680120
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 760680120,
					"content": "Tùy tùng của Kẻ Đổ Bộ đó nói muốn tìm chị để bàn vài việc. Liên quan đến thế hấp dẫn và Metric {RUBY#[D]Quy Tắc Thời Gian}Tensor của thế giới này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680121
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 760680121,
					"content": "Istaroth?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680122
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 760680122,
					"content": "Chắc là cái tên này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680123
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 760680123,
					"content": "Phải nhớ kỹ tên của người khác chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680124
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 760680124,
					"content": "Tuy nhiên, có lẽ là ảo giác của chị, nhưng chị luôn cảm thấy cô ấy đối với Kẻ Đổ Bộ kia dường như...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680125
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 760680125,
					"content": "Em sẽ không vội vàng đưa ra phán đoán, Aria. Nhưng em sẽ lưu ý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680126
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 760680126,
					"content": "Ừm, vậy thì tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680127
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 760680127,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680128
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 760680128,
					"content": "Haha, không có gì đâu. Vậy đi trước nhé, Canon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680129
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 760680129,
					"content": "Yên tâm đi, chị và Sonnet sẽ mang quà về cho em.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680130
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 760680130,
					"content": "...Em không cần quà đâu. Hai người cẩn thận, đừng để bị nhận ra là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Canon"
				}
			]
		}
	]
}