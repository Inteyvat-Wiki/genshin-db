			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ilmari"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760210401,
					"content": "Hôm nay lại tay trắng ra về rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210402,
						760210405,
						760210412,
						760210417,
						760210421
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760210402,
					"content": "Ông đang làm gì ở đây vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760210403
					]
				},
				{
					"id": 760210403,
					"content": "Câu cá thôi. Nhưng đến giờ chỉ toàn câu được mấy thứ chẳng phải cá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210404
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760210404,
					"content": "Nếu là đồ từ tàu đắm thì còn đỡ, thương nhân lữ hành sẽ mua. Trước đây ta từng câu được một nửa chiếc ủng... Haiz, thôi, nói nhiều lát cá lại chạy mất nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760210405,
					"content": "Ở gần đây có gì đáng chú ý không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760210406
					]
				},
				{
					"id": 760210406,
					"content": "Cháu lại đến tìm kho báu sao? Nào là \"Kho Báu Vĩ Đại\" chỉ có thể tìm thấy ở Phía Đông Của Mặt Trăng, Phía Tây Của Mặt Trời gì đó... Nghe là biết không phải ở đây rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210407
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760210407,
					"content": "Ngày xưa ở đây quả thực đã xảy ra không ít vụ đắm tàu. Trong những con tàu đắm có lẽ toàn là đồ đáng tiền, nhưng không dễ tìm đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210408
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760210408,
					"content": "Lúc ở quán rượu cũng có nghe thủy thủ sống sót kể lại rồi. Hôm đó trời không trăng, nhưng giữa cơn sóng gầm gào vẫn có thứ gì đó phát sáng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210409
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760210409,
					"content": "Họ nói đó chắc chắn là Kratti một mắt, là con quái vật có thể nuốt cả mặt trăng đang tranh giành địa bàn với rắn biển khổng lồ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210410
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760210410,
					"content": "Sau đó một thời gian dài, khu vực này đen như lọ mực. Không có con tàu nào dám mạo hiểm đi qua đây, ai cũng sợ bị những linh hồn dưới nước ám.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210411
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760210411,
					"content": "Dù những linh hồn đó có còn lượn lờ ở gần đây thì ta cũng không nhìn thấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760210412,
					"content": "Về cái cây đó...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760210413
					]
				},
				{
					"id": 760210413,
					"content": "Thứ đó đúng là có hơi quái dị. Ở đây vốn là một xoáy nước, các thủy thủ gọi là Mắt Kratti. Rồi một ngày nọ bỗng mọc ra cái cây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210414
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760210414,
					"content": "Nhưng khoảng thời gian đó còn xảy ra nhiều chuyện lạ khác nữa. Giờ nghĩ lại thì đều là xảy ra sau khi mấy tảng đá từ trên trời rơi xuống... Có khi cái cây này cũng đến từ ngoài vũ trụ giống mấy tảng đá ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210415
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760210415,
					"content": "Còn có những thứ nhỏ bé lấp lánh thỉnh thoảng có thể thấy, hiếm lắm. Ta nghĩ có khi có loài cá mới, nên mới đến đây thử vận may.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210416
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760210416,
					"content": "Ban đầu còn có một người bạn câu cá cùng ta, nhưng anh ta bảo cứ nghe thấy tiếng hát kỳ lạ, sợ quá không dám tới nữa. Hừ, mặc dù anh ta chỉ được xem là một nửa Dòng Dõi Sương Nguyệt, nhưng tật xấu thì chẳng thiếu tí nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760210417,
					"content": "Về Chứng Nhận Trí Giả...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760210418
					]
				},
				{
					"id": 760210418,
					"content": "Nào là Chứng Nhận Trí Giả, nào là \"Kho Báu Vĩ Đại\" chỉ có thể tìm thấy ở Phía Đông Của Mặt Trăng, Phía Tây Của Mặt Trời... Ta thấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210419
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760210419,
					"content": "Bị lòng tham chi phối, theo đuổi thứ vốn không thuộc về mình, chắc chắn chẳng có kết cục tốt. Như con tàu Atlas ấy, nghe nói thuyền trưởng Grettir đã bị thứ đó mê hoặc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210420
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760210420,
					"content": "Cuối cùng lại phải chôn thân dưới đáy biển, kho báu cũng chẳng thể nằm mãi bên cạnh ông ta. Đúng là công cốc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760210421,
					"content": "Làm phiền rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760210422
					]
				},
				{
					"id": 760210422,
					"content": "Không sao. Giờ thì chẳng thấy bóng dáng con cá nào nữa cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ilmari"
				}
			]
		}
	]
}