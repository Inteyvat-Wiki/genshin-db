				"points": []
			},
			"dialogs": [
				{
					"id": 756600101,
					"content": "Phù... Thời tiết không tệ, lần đi dạo này quả là một quyết định đúng đắn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600102
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 756600102,
					"content": "Hửm? Đây chẳng phải là \"Tum{RUBY#[D]Hy Vọng}aini\" đáng tự hào của chúng ta sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600103,
						756600104
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 756600103,
					"content": "Trùng hợp thế.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756600105
					]
				},
				{
					"id": 756600105,
					"content": "Kể lại chuyện của Irade và ải sát hạch cho Xilonen nghe...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						756600106
					]
				},
				{
					"id": 756600106,
					"content": "Ra là vậy... Suýt nữa thì quên mất, trước đây đúng là tôi đã từng giúp cô ấy, ải sát hạch dành cho Con Của Tiếng Vang vừa hay cũng ở gần đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600107
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 756600107,
					"content": "Lúc đầu Irade chỉ mời được \"Tai Họa Của Tetlahuitl\" Nkunga và \"Lưỡi Đao Cát Của Seit'aad\" Amuru đến hỗ trợ thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600108
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 756600108,
					"content": "Nhưng hai người đó không hứng thú với vụ này, chỉ chú trọng đến quyết đấu trực diện thôi, nên đề xuất thiết kế đưa ra có chút lệch hướng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600109
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 756600109,
					"content": "Pacal nghe được chuyện này liền đến nhờ tôi góp ý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600110,
						756600113
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 756600110,
					"content": "Vậy ải sát hạch hiện tại là tác phẩm của cô sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756600111
					]
				},
				{
					"id": 756600111,
					"content": "Cũng gần giống vậy. Sau khi tôi thảo luận với Pacal và Irade, tôi đã quyết định chỉnh sửa một chút cấu trúc ải của bộ tộc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600112
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 756600112,
					"content": "Hiện tại những ải này chú trọng hơn vào việc thử thách chiến binh nhanh chóng đến được vị trí lợi thế, và ý thức không ngừng chuyển dịch điểm tựa trong lúc chiến đấu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600116,
						756600117
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 756600116,
					"content": "Vậy để tôi nhận sát hạch của cô trước vậy!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756600118
					]
				},
				{
					"id": 756600118,
					"content": "#Mọi người ở Natlan đều đã chứng kiến thực lực của {F#cô}{M#cậu} rồi. Nên dù là ải như thế nào thì cũng không làm khó được {F#cô}{M#cậu} đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600119
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 756600119,
					"content": "Ải sát hạch ở bên đó, nếu quan tâm thì đi thử xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 756600117,
					"content": "Hy vọng ải của Xilonen không quá khó...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756600118
					]
				},
				{
					"id": 756600113,
					"content": "Cô đúng là người thợ tạo ra đủ các thứ nhỉ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756600114
					]
				},
				{
					"id": 756600114,
					"content": "Chỉ là một số thứ đơn giản thôi mà, làm cũng không khó lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600115
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 756600115,
					"content": "Nếu chỉ cần làm một lần như vậy mà khiến Con Của Tiếng Vang có thể không ngừng sản sinh những chiến binh mạnh mẽ, thì tính ra tôi cũng có thể rảnh rỗi hơn để hoàn thành những đơn hàng vẫn đang chất đống.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600116,
						756600117
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 756600104,
					"content": "Tôi vừa nhận ủy thác của Irade.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756600105
					]
				}
			]
		}
	]
}