			"dialogs": [
				{
					"id": 740590201,
					"content": "#Là {M#anh}{F#chị} {NICKNAME} và Paimon đấy à, lâu rồi không gặp!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590202
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740590202,
					"content": "Mọi người vẫn muốn thu gom loại đá kỳ lạ lần trước sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590203
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740590203,
					"content": "Chuyện này nói ra khá dài dòng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740590204,
					"content": "Các bạn đưa đồng hồ cho Puca, đồng thời kể chuyện Chesil muốn dùng khoáng thạch kỳ lạ để chế tác đồng hồ.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740590205
					]
				},
				{
					"id": 740590205,
					"content": "Thật lợi hại, hóa ra viên đá đó còn có thể dùng để làm thành vật này sao?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590206
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740590206,
					"content": "Hả? Chỉ có bên trong của đồng hồ là làm từ viên đá kia thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740590207,
					"content": "Ở dưới nước mà cũng kêu tích tắc được, lần đầu tiên em thấy đồng hồ kiểu này đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590208
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740590208,
					"content": "À, nhớ hình như Chesil nói là dùng kết cấu vỏ sò gì ấy nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740590209,
					"content": "Hihi, chỉ nghe thấy tiếng động bên trong đồng hồ là đã vui rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590210
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740590210,
					"content": "Không ngờ loại đá trông bình thường lại có tác dụng như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590211
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740590211,
					"content": "Trước đây em luôn cảm thấy phải dùng đá quý hiếm mới có thể làm ra sản phẩm xuất sắc, không ngờ loại đá bình thường cũng có thể làm được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590212
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740590212,
					"content": "Bất kể cái gì cũng có tác dụng của nó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740590213
					]
				},
				{
					"id": 740590213,
					"content": "Em bỗng nhiên cũng trở nên tự tin vào bản thân rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590214
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740590214,
					"content": "Puca cẩn thận trưng đồng hồ.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740590215
					]
				},
				{
					"id": 740590215,
					"content": "Vậy thì Puca chuẩn bị sẵn khoáng thạch nhé, đến lúc đó bán cho Chesil là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740590216,
					"content": "Nếu vậy thì Puca cũng đã có được một xưởng đá quý của riêng mình rồi phải không!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740590217,
					"content": "Chỗ Puca có nhiều loại đá như vậy, biết đâu cũng sẽ tìm được công dụng của riêng chúng đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740590218,
					"content": "Em sẽ chuẩn bị kỹ càng, cảm ơn mọi người nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590219
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740590219,
					"content": "Nếu sau này muốn tìm đá gì thì hãy đến gặp em nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590220
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740590220,
					"content": "Hì hì, không cần cảm ơn đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
