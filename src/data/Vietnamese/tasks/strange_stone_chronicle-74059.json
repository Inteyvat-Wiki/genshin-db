			"dialogs": [
				{
					"id": 740590101,
					"content": "A, là các vị sao, người đã bán đá quý cho tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590102
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590102,
					"content": "Lần trước anh nói muốn dùng đá quý của chúng tôi để làm ra đồ trang sức đẹp, không biết đã xong chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740590103,
					"content": "Chúng tôi mong chờ mãi đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740590104,
					"content": "Việc đó... e là khiến các vị thất vọng rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590105
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590105,
					"content": "Hả?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740590106,
					"content": "Độ cứng của loại khoáng này quá cao, khó mài giũa thủ công để khảm lên trang sức...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590107
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590107,
					"content": "Một vấn đề khác là sau khi mài giũa thì nó đã mất đi độ bóng ban đầu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590108
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590108,
					"content": "Tóm lại là hoàn toàn không thích hợp để làm đồ trang sức.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590109
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590109,
					"content": "Ối, không ngờ lại như vậy, chúng tôi còn tưởng nó thật sự có công dụng này chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740590110,
					"content": "Cũng không thể nói là hoàn toàn không có...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590126
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590126,
					"content": "Vừa nói Chesil vừa lấy một chiếc đồng hồ đặt lên quầy.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740590111
					]
				},
				{
					"id": 740590111,
					"content": "Hãy nhìn chiếc đồng hồ mới làm này xem, đã dùng loại khoáng thạch đó đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590112
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590112,
					"content": "Lúc đầu tôi cảm thấy mình phán đoán sai, nên định vứt những viên đá này đi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590113
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590113,
					"content": "Nhưng một số thợ đồng hồ nhìn thấy chúng, cảm thấy độ cứng của loại khoáng thạch có thể dùng để làm linh kiện bên trong đồng hồ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590114
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590114,
					"content": "Không ngờ do độ cứng cao và chống ma sát mài mòn, nên dùng loại khoáng thạch này làm linh kiện sẽ có hiệu quả tốt hơn rất nhiều so với nguyên liệu trước đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590115
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590115,
					"content": "Nhưng nếu như dùng để làm đồng hồ thì yêu cầu về nguồn cung cấp ổn định thậm chí còn cao hơn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590116,
						740590117
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590116,
					"content": "Cái này thì dễ thôi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740590118
					]
				},
				{
					"id": 740590118,
					"content": "Các bạn kể chuyện của Puca cho Chesil nghe.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740590119
					]
				},
				{
					"id": 740590119,
					"content": "Thì ra là thế, vậy thì trùng hợp rồi! Chiếc đồng hồ này sử dụng kết cấu kiểu vỏ sò chống nước mới phát minh, mục đích ban đầu là để cho Melusine có thể sử dụng thuận tiện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590120
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590120,
					"content": "Vậy có thể nhờ các vị đưa chiếc đồng hồ này cho Puca được không, nhân tiện giải thích rõ trước giúp tôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590121
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590121,
					"content": "Dù sao tôi cũng không có kinh nghiệm làm ăn với Melusine... Nếu như Puca cung cấp nguồn cung ổn định thì có thể thành lập một dây chuyền sản xuất mới rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590122
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590122,
					"content": "Sau này tôi cũng sẽ đích thân đến tận nơi liên hệ! Trên mẫu thiết kế của đồng hồ sau này cũng sẽ thêm phong cách của Melusine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590123
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590123,
					"content": "Hihi, nghe có vẻ nếu như thành công thì cũng rất có lợi cho Puca đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740590124,
					"content": "Biết đâu Puca sẽ có được xưởng đá quý của riêng mình. Chúng ta về nói với Puca đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740590125,
					"content": "Vậy thì nhờ các vị nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590117,
					"content": "Nếu liên hệ trực tiếp với Puca...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740590118
					]
				}
			]
		},
