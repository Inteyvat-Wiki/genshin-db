					}
				]
			},
			"dialogs": [
				{
					"id": 402010501,
					"content": "Có thể khẳng định rồi. Hai tên xấu xa đó đang gấp rút chở phần lớn hàng hóa đến Fontaine trong một lần, không giở trò gì cả...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010502,
					"content": "Nhưng những thùng hàng có đánh dấu kỳ lạ kia là sao nhỉ? Đi hỏi Yelan thử xem đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010503,
					"content": "Sau khi tìm được Yelan, bạn giao kết quả điều tra cho cô ấy xem...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						402010504
					]
				},
				{
					"id": 402010504,
					"content": "So sánh với tình báo mà sĩ quan Edler cung cấp, có thể đoán được phiên đấu giá mà họ tham gia sẽ diễn ra vào hai ngày tới tại Khách Sạn Debord.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010505
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010505,
					"content": "Nhưng ký hiệu chụp được lại là dùng loại sơn đặc biệt. Nếu không phải đã có chuẩn bị trước Máy Ghi Hình Tổng Hợp thì thật sự rất khó phát hiện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010506
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010506,
					"content": "Đây là biến thể Ấn Quạ của Đạo Bảo Đoàn, được một số đầu sỏ trong băng nhóm xem như huy hiệu cá nhân. Kết hợp với tình tiết vụ án thì đó chắc chắn là bút tích của Siêu Lừa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010507,
						402010508
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010507,
					"content": "Siêu Lừa tại sao lại phải đánh dấu hàng hóa chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010509
					]
				},
				{
					"id": 402010509,
					"content": "So với danh sách ở cảng thì những món đồ được Siêu Lừa đánh dấu đều có... phân bón đặc biệt của Sumeru, pháo hoa bản địa, xà phòng và sáp thơm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010510
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010510,
					"content": "Nghe có vẻ toàn là những vật dụng nông nghiệp và sinh hoạt thông thường thôi nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010511,
					"content": "Phân bón, xà phòng và sáp thơm... Có điểm khả nghi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010512
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010512,
					"content": "Tuy có hơi mạo hiểm, nhưng tôi định lên thuyền để điều tra và theo nó đến Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010513,
						402010514
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010513,
					"content": "Đã điều tra đến bước này rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010515
					]
				},
				{
					"id": 402010515,
					"content": "Đúng đó, tôi rất muốn biết rốt cuộc mấy kẻ đó đang giở trò gì!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010516,
					"content": "Với thực lực của hai người thì tôi không lo tới vấn đề an toàn. Nhưng sau khi lên thuyền, chúng ta có thể sẽ đụng mặt Corder và Doddamani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010517
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010517,
					"content": "Hãy chuẩn bị tâm lý cho tốt, lần điều tra này có thể sẽ hơi đặc biệt đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010514,
					"content": "Chúng tôi sẽ cùng cô hành động...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010515
					]
				},
				{
					"id": 402010508,
					"content": "Siêu Lừa muốn truyền đạt thông tin gì sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010509
					]
				}
			]
