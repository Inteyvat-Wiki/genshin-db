			},
			"dialogs": [
				{
					"id": 402010101,
					"content": "Không tệ đấy, rất đúng giờ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010102,
						402010103
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010102,
					"content": "Tiến độ ra sao rồi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010104
					]
				},
				{
					"id": 402010104,
					"content": "Sau khi quan sát căn cứ lần trước suốt một ngày, tên tội phạm Corder và Doddamani đã bắt đầu di chuyển hàng hóa trong đó rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010105
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010105,
					"content": "Thấy con thuyền kia không? Đó là thuyền chuyển hàng của Doddamani. Chúng còn che giấu bằng việc vận chuyển hành khách nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010106
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010106,
					"content": "Ồ, con thuyền lớn quá! Hàng hóa chất đống như vậy, còn có không ít hành khách phương xa định ngồi thuyền đến Cảng Lumidouce nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010107,
						402010108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010107,
					"content": "Nhưng nếu đó không phải hàng thật thì sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010109
					]
				},
				{
					"id": 402010109,
					"content": "Tuyệt lắm, đã biết đề phòng bị lừa rồi, tiến bộ rất nhanh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010110
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010110,
					"content": "Nếu Corder và Doddamani đủ cẩn trọng và nghi ngờ bản thân đang bị điều tra, thì quả thật có thể sẽ điều một con thuyền trống đến Cảng Lumidouce, nhằm quan sát thêm động tĩnh của cơ quan hành pháp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010111
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010111,
					"content": "Nhưng phải cẩn thận. Theo tình báo điều tra được, thành viên lão làng của Đạo Bảo Đoàn với biệt danh \"Siêu Lừa\" cũng đang hợp tác với Nhà Tài Phiệt Hắc Ám.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010112
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010112,
					"content": "Tên Siêu Lừa này là một kẻ liều lĩnh, giỏi gây rối trong âm thầm. Qua điều tra trước đây thì hắn chính là kẻ đã do thám hải đăng của Thiên Nham Quân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010113
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010113,
					"content": "Tôi sẽ đi dạo quanh đây để đánh lạc hướng Siêu Lừa. Hãy nhân cơ hội này điều tra hàng hóa nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010114
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010114,
					"content": "Phải cẩn thận đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010115,
						402010116
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010115,
					"content": "Hiểu rồi, tôi sẽ cẩn thận.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010117
					]
				},
				{
					"id": 402010117,
					"content": "#Ừm! Tôi sẽ cố... bay thấp một chút! Không vượt quá tầm vai của {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010116,
					"content": "Cứ yên tâm để tôi xử lý.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010117
					]
				},
				{
					"id": 402010108,
					"content": "Chúng ta phải điều tra hàng hóa trước đúng không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010109
					]
				},
				{
					"id": 402010103,
					"content": "Có động tĩnh gì chưa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010104
					]
				}
			]
		},
