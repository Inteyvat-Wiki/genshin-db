			"dialogs": [
				{
					"id": 402010401,
					"content": "Số bom trên boong đã xử lý xong rồi, chắc trong khoang vẫn còn bom nữa... Còn đủ thời gian không?",
					"roleType": "TALK_ROLE_NPC",
