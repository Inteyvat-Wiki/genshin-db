							2931.238,
							342.726,
							2650.033
						],
						"pointId": 311500262
					}
				]
			},
			"dialogs": [
				{
					"id": 402010201,
					"content": "Xin lỗi quý khách, do khoang hàng đã đầy nên rất nhiều hàng hóa chỉ có thể để trên boong thuyền. Mong quý khách thông cảm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010202
					],
					"speakerTitle": "Thuyền Viên"
				},
				{
					"id": 402010202,
					"content": "Không sao! Điều này chứng tỏ dạo này kinh doanh phát đạt, mọi người cùng phát tài!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010203
					],
					"speakerTitle": "Hành Khách Nhiệt Tình"
				},
				{
					"id": 402010203,
					"content": "Xem ra hàng hóa mà tên Siêu Lừa đánh dấu đã ghi tên Corder làm người chuyển hàng. Còn Doddamani thì hoạt động trong khoang thuyền, chắc cũng đang xác nhận xem hàng hóa đã đủ chưa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010204
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010204,
					"content": "Bọn họ đang... kiểm tra hàng sao? Còn lục lọi trong rương nữa? Vậy là sao nhỉ... Thật khó hiểu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010205,
					"content": "#Cầm lấy bảng đối chiếu này đi, {NICKNAME}. Dùng nó thì {F#cô}{M#cậu} sẽ hiểu được ám ngữ chúng dùng để trao đổi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010206
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010206,
					"content": "Lát tôi sẽ đi đánh lạc hướng Corder và Doddamani, nhân cơ hội này hãy điều tra những chiếc rương mà Siêu Lừa đã đánh dấu nhé. Chắc sẽ tìm ra manh mối gì đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010207,
						402010208
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010207,
					"content": "Lỡ như có gì đó không ổn...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010209
					]
				},
				{
					"id": 402010209,
					"content": "#Đương nhiên là được. Tôi tin vào phán đoán của {F#cô}{M#cậu}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010210
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010210,
					"content": "Ơ? Haaả? Yelan muốn trực tiếp nói chuyện với những tên đó sao!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010211,
					"content": "Hmm? Hai vị... nhìn có vẻ quen quen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010212
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010212,
					"content": "Có phải chúng ta đã từng gặp nhau ở Cửu Lược Trà Quán tại Bến Tàu Di Lung không? Ngài Corder, nhà sưu tầm đồ cổ nổi tiếng của Quận Lyonnais, còn vị này là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010213
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010213,
					"content": "Hả? Cô... cô?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010214
					],
					"speakerTitle": "Doddamani"
				},
				{
					"id": 402010214,
					"content": "...Tiểu thư Yelan, Bậc Thầy Xúc Xắc của Tiệm Trà Trên Đá, hân hạnh được gặp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010215
					],
					"speakerTitle": "Corder"
				},
				{
					"id": 402010215,
					"content": "Các vị cũng biết tôi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010216
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010216,
					"content": "Tôi từng uống một ấm trà tuyệt vời ở Tiệm Trà Trên Đá. Trong lúc thưởng thức, tôi đã nghe được lời kể về cô. Xem ra chúng ta đều là người yêu trà, nên sẽ có chút duyên phận với nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010217
					],
					"speakerTitle": "Corder"
				},
				{
					"id": 402010217,
					"content": "Không ngờ lại có sự trùng hợp như vậy... Vừa hay tôi định đến Fontaine để tận hưởng kỳ nghỉ, không biết ngài có đề xuất nơi nào để đi không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010218
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010218,
					"content": "Ví dụ như triển lãm trà cụ tinh xảo... hoặc những buổi đấu giá chẳng hạn? Tôi nghe nói hồng trà của Fontaine có hương vị đặc biệt, nên trà cụ ở đó chắc cũng rất đặc sắc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010219
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010219,
					"content": "Cô!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010220
					],
					"speakerTitle": "Doddamani"
				},
				{
					"id": 402010220,
					"content": "Hửm? Người bạn này có vẻ cũng rất có hứng thú với trà cụ nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010221
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010221,
					"content": "Tôi... khụ khụ... Đúng vậy, tôi là chủ của chiếc thuyền này. Tôi nhận được lời mời của Corder để đến Fontaine du lịch, rất hân hạnh được làm quen với cô...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010222
					],
					"speakerTitle": "Doddamani"
				},
				{
					"id": 402010222,
					"content": "Yelan thật sự bắt chuyện với bọn họ à? Sẽ không sao chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010223,
						402010224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010223,
					"content": "Chúng ta tranh thủ thời gian đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010225
					]
				},
				{
					"id": 402010225,
					"content": "Được! Vậy chúng ta tìm đường vòng qua chỗ mà hai tên đó không nhìn thấy rồi điều tra rương của bọn họ đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010226,
					"content": "Khụ khụ, mùi trong rương khó chịu quá, hình như là trộn lẫn nhiều thứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010227,
					"content": "Còn có một mảnh giấy kỳ lạ nữa, viết thứ gì đó trông rất khó hiểu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010228,
						402010229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010228,
					"content": "Là ám ngữ của Nhà Tài Phiệt Hắc Ám...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010230
					]
				},
				{
					"id": 402010230,
					"content": "#Không hổ danh là Yelan, có thể tính toán được hết mọi tình huống! Vậy... Chắc {NICKNAME} biết cách giải mã mà đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010231,
					"content": "Thế nào rồi? Đám người đó nói gì thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010232,
						402010233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010232,
					"content": "Nếu đoán không nhầm thì đây là bom...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010234
					]
				},
				{
					"id": 402010234,
					"content": "Cho nổ... Cho nổ con thuyền á?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010235
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010235,
					"content": "Mấy người đó điên rồi sao!? Chẳng phải chúng muốn thoát khỏi cuộc điều tra sao? Làm như thế sẽ khiến mọi chuyện rắc rối thêm mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010236,
						402010237,
						402010238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010236,
					"content": "Siêu Lừa muốn bảo vệ kẻ chủ mưu đứng sau...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010239
					]
				},
				{
					"id": 402010239,
					"content": "Yelan nói đúng lắm, tên đó điên thật rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010240
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010240,
					"content": "Trên thuyền còn có rất nhiều người vô tội! Chúng ta phải nghĩ cách tìm ra toàn bộ số bom đó ngay!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010237,
					"content": "Nên chọn cách dùng sự việc lớn hơn để chuyển hướng chú ý...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010239
					]
				},
				{
					"id": 402010238,
					"content": "Đồng thời cắt đứt manh mối của chúng ta...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010239
					]
				},
				{
					"id": 402010233,
					"content": "Chúng muốn cho nổ con thuyền để tiêu hủy chứng cứ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010234
					]
				},
				{
					"id": 402010229,
					"content": "Chúng ta có bảng đối chiếu ám ngữ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010230
					]
				},
				{
					"id": 402010224,
					"content": "Phải tận dụng thời cơ này cho thật tốt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010225
					]
				},
				{
					"id": 402010208,
					"content": "Thì có thể để tôi tự xử lý không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010209
					]
				}
			]
		},
