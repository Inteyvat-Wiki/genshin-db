				},
				{
					"id": 402010402,
					"content": "Tôi đã xử lý xong số bom trong khoang rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010403
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010403,
					"content": "#Cảm ơn nhé, {NICKNAME}, Paimon. Hai người ứng phó rất quyết đoán và nhanh nhẹn, không chê vào đâu được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010404
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010404,
					"content": "Yelan! May mà cô phát hiện ra tình hình bất ổn nên lên thuyền kiểm tra đó, còn đưa cho chúng tôi bảng đối chiếu nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010405,
					"content": "Ơ mà khoan... Vậy hai tên đó đâu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010406,
					"content": "Heh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010407
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010407,
					"content": "Nguy hiểm thật. Ngài Doddamani và Corder, hai người dường như đã bị một nhân vật nguy hiểm nào đó nhắm tới rồi nhỉ? Hắn muốn khiến hai người biến mất chung với số tài sản này đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010408
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010408,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010409
					],
					"speakerTitle": "Corder"
				},
				{
					"id": 402010409,
					"content": "Đúng vậy. Tôi thật không hiểu nổi, sao trên đời lại có kẻ độc ác như vậy chứ... Tôi cũng không nghĩ ra được là đã đắc tội gì để khiến hắn phải hãm hại tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010410
					],
					"speakerTitle": "Corder"
				},
				{
					"id": 402010410,
					"content": "Không cần lo lắng nữa. Tôi sẽ thông báo ngay cho Sảnh Chấp Pháp, nhờ họ phái người đến hỗ trợ bảo vệ hai người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010411
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010411,
					"content": "Hàng hóa của ngài Corder cũng sẽ được Sảnh Chấp Pháp kiểm tra kỹ càng để loại bỏ hết những rủi ro. Sau đó sẽ có hiến binh hộ tống đến địa điểm dự kiến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010412
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010412,
					"content": "Vậy thì... hàng hóa của ngài Corder đây sẽ phải đưa đến đâu ấy nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010413
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010413,
					"content": "...Đến buổi đấu giá của Khách Sạn Debord hai ngày sau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010414
					],
					"speakerTitle": "Corder"
				},
				{
					"id": 402010414,
					"content": "Vậy thì cứ yên tâm nhé. Mỗi vị hiến binh của Sảnh Chấp Pháp đều sẽ làm tròn bổn phận và đảm bảo an toàn cho hàng hóa của anh để... tham gia đấu giá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010415
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010415,
					"content": "Cảm ơn rất nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010416
					],
					"speakerTitle": "Corder"
				},
				{
					"id": 402010416,
					"content": "Một lúc sau, thuyền đến Cảng Lumidouce bình an vô sự. Người của Sảnh Chấp Pháp nhanh chóng tiếp quản con thuyền, kiểm tra an ninh, niêm phong và chuyển hết hàng hóa đi.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						402010417
					]
				},
				{
					"id": 402010417,
					"content": "Cả hai kể thêm cho Yelan nghe về nội dung bức thư mà Siêu Lừa để lại cho Corder và Doddamani.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
