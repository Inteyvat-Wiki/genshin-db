			"dialogs": [
				{
					"id": 402010301,
					"content": "Làm tôi hết hồn đấy, Yelan! Cô trực tiếp đi đối đầu với đám tội phạm đó, cô không sợ chúng đột nhiên cảnh giác rồi... rồi làm liều sao!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010302,
					"content": "Chúng đều biết cả, nhưng vì lợi ích riêng mà chúng bắt buộc phải chơi tiếp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010303
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010303,
					"content": "Bây giờ xem ra, Nhà Tài Phiệt Hắc Ám đúng là rất thận trọng. Hắn định cắt đuôi để bảo toàn bản thân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010304
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010304,
					"content": "Để hàng hóa vắng mặt ở buổi đấu giá, vứt tang vật xuống biển, xóa bỏ mọi vật chứng có thể dẫn đến hắn, đồng thời để Siêu Lừa thu hút hết toàn bộ sự chú ý...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010305
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010305,
					"content": "Nhưng hành động của chúng ta và Sảnh Chấp Pháp có hiệu quả, đồng nghĩa với việc ép họ phải theo quy trình đấu giá đến cùng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010306
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010306,
					"content": "Vì nếu Nhà Tài Phiệt Hắc Ám không cử đại diện của mình đến buổi đấu giá và để hàng hóa đến tay một người mua không biết giá trị đã bị thổi phồng này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010307
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010307,
					"content": "Thì người mua đó sẽ phát hiện ra và báo án, Corder sẽ bị liệt vào danh sách nghi phạm, thậm chí còn bị kết án.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010308
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010308,
					"content": "Nhẹ thì khiến cho Nhà Tài Phiệt Hắc Ám không thể dùng chiêu trò này để rửa Mora, nặng thì sẽ khiến cho hắn mất đi thuộc hạ đắc lực cuối cùng ở Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010309,
						402010310
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010309,
					"content": "Ngược lại, nếu tiếp tục tham gia đấu giá...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010311
					]
				},
				{
					"id": 402010311,
					"content": "Chính xác. Dấu vết mà chúng ta theo đuổi vẫn còn nguyên vẹn, và cứ để người mua dẫn chúng ta đến sào huyệt của Nhà Tài Phiệt Hắc Ám thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010312
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010312,
					"content": "À ừm... Yelan... Hai người? Có thể giải thích lại không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010313,
					"content": "#Đừng nóng vội, Paimon. {NICKNAME} sẽ từ từ giải thích lại mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010314
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010314,
					"content": "Vậy thì bước cuối cùng, cũng là bước quan trọng nhất... Chúng ta chuẩn bị cho tốt để câu cá trong buổi đấu giá thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010315
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010315,
					"content": "Sĩ quan Edler đã cho người sắp xếp ổn thỏa rồi. Hãy nhận lấy tấm thiệp mời này nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010316
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010316,
					"content": "Hai ngày sau, chúng ta hẹn gặp nhau tại Khách Sạn Debord.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010310,
					"content": "Thì trường hợp đó sẽ có lợi cho chúng ta...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010311
					]
				}
