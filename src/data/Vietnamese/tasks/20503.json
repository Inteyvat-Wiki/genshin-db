					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030202,
					"content": "Muốn xem vũ khí",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205030203
					]
				},
				{
					"id": 205030203,
					"content": "Đều ở bên đó, tự chọn đi. Nếu muốn hợp tay, thì ta cũng nhận đặt hàng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030207
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030207,
					"content": "Hóa ra còn có thể đặt làm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 205030208,
					"content": "Đương nhiên. Bán, đặt hàng, tinh luyện, đều là việc kinh doanh của lò rèn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030209
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030209,
					"content": "Chỉ cần ngươi có khoáng thạch là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030210,
						205030212
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030210,
					"content": "Có thể tìm khoáng thạch ở đâu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205030211
					]
				},
				{
					"id": 205030211,
					"content": "Ở đâu cũng có.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030214
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030214,
					"content": "Vầy đi, xem ngươi mơ mơ hồ hồ, ta nói cho ngươi biết chỗ có nhiều mảnh sắt gần đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030215
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030215,
					"content": "Nếu ngươi có thể đem giúp ta mảnh sắt về, ta sẽ giúp ngươi rèn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030216
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030216,
					"content": "Được, cảm ơn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205030217
					]
				},
				{
					"id": 205030217,
					"content": "Không cần. Ta tiếp tục làm việc đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030212,
					"content": "Ở đây có bán không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205030213
					]
				},
				{
					"id": 205030213,
					"content": "Tìm người khác đi, ta còn không đủ dùng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030214
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030204,
					"content": "Muốn giúp Paimon xem vũ khí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205030205
					]
				},
				{
					"id": 205030205,
					"content": "Chưa từng nghe nói đến việc đó! Muốn tôi đánh trận đầu sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 205030206,
					"content": "Cái con nhỏ như vậy, ừm, phải đặt làm rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030207
