			"dialogs": [
				{
					"id": 766550101,
					"content": "Flins, anh cũng lên đây rồi à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766550102,
					"content": "Hai vị vất vả rồi. Sau khi có người bảo trì, trạng thái của ngọn hải đăng này đã tốt hơn nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550103
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 766550103,
					"content": "Hihi, chuyện nhỏ thôi. Nhưng dù chúng tôi có bảo trì thế nào đi nữa thì ở đây vẫn tối như vậy, vẫn luôn có những nơi mà ánh đèn không thể chiếu tới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766550104,
					"content": "Đúng vậy. Khác với bên ngoài, thời gian trong nghĩa trang dường như đã dừng lại vào cái đêm trận đấu đó kết thúc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550105
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 766550105,
					"content": "Tôi vốn không định thay đổi môi trường nơi đây, nhưng các vị đã thắp sáng ngọn hải đăng để thúc đẩy thời gian ở nơi này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550106,
						766550108
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 766550106,
					"content": "Vậy có ảnh hưởng đến cuộc sống của anh không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766550107
					]
				},
				{
					"id": 766550107,
					"content": "Nếu hỏi là có gây bất tiện hay không, thì câu trả lời là không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550110
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 766550110,
					"content": "Sinh mệnh là luân hồi. Dù không có chúng ta, thì những hồn ma trên hòn đảo này cũng sẽ dần tiêu tan để trở về Địa Mạch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550111
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 766550111,
					"content": "Vì thế, không cần lo lắng việc ngọn hải đăng không thể chiếu sáng cả hòn đảo. Cùng với hồn ma dần biến mất, sương mù bao trùm nơi này cũng sẽ tan đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550112
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 766550112,
					"content": "Mặt trời rồi cũng sẽ ló dạng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flins"
				},
				{
					"id": 766550108,
					"content": "Xin lỗi, đây là chuyện ngoài ý muốn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766550109
					]
				},
				{
					"id": 766550109,
					"content": "Không cần phải xin lỗi đâu, vì tôi không ghét những thay đổi này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550110
					],
					"speakerTitle": "Flins"
				}
			]
		}
	]
