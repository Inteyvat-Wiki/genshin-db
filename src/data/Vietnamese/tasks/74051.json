			"dialogs": [
				{
					"id": 740510301,
					"content": "Tốt quá rồi, máy quay không bị hỏng, phim bên trong cũng không ảnh hưởng gì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510328
					],
					"speakerTitle": "Cô Chủ Qiu"
				},
				{
					"id": 740510328,
					"content": "Tạ ơn trời đất, tôi còn tưởng là phải quay lại từ đầu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510302,
						740510303
					],
					"speakerTitle": "Cô Chủ Qiu"
				},
				{
					"id": 740510302,
					"content": "Sao lại quay phim ở đây?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740510329
					]
				},
				{
					"id": 740510303,
					"content": "Xem ra mọi người cũng không phải người Fontaine.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740510329
					]
				},
				{
					"id": 740510329,
					"content": "Đó là một câu chuyện dài...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510305
					],
					"speakerTitle": "Cô Chủ Qiu"
				},
				{
					"id": 740510304,
					"content": "Ngắn gọn mà nói. Ba người chúng tôi đến từ \"Làng Kiều Anh\" ở Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510305
					],
					"speakerTitle": "Cô Chủ Qiu"
				},
				{
					"id": 740510305,
					"content": "Người trong làng đa số đều kinh doanh trà, nhưng chúng tôi... không hứng thú với chuyện đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510306
					],
					"speakerTitle": "Cô Chủ Qiu"
				},
				{
					"id": 740510306,
					"content": "Cho nên mới chuyển nghề, giúp người bán trà trong làng quay phim tư liệu để phục vụ quảng cáo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510307
					],
					"speakerTitle": "Cô Chủ Qiu"
				},
				{
					"id": 740510307,
					"content": "Thật ra thì người kinh doanh trà nhiều quá, việc kinh doanh của chúng tôi không so được với họ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510308
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 740510308,
					"content": "Những thợ tốt trong tiệm cũng lần lượt chạy qua tiệm khác làm việc, còn tiếp tục kinh doanh trà thì chúng tôi chết đói mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510309
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 740510309,
					"content": "Hai người... không nói được gì dễ nghe hơn sao?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510310
					],
					"speakerTitle": "Cô Chủ Qiu"
				},
				{
					"id": 740510310,
					"content": "Việc quay phim quảng cáo trà cho làng cũng kiếm được không ít.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510311
					],
					"speakerTitle": "Cô Chủ Qiu"
				},
				{
					"id": 740510311,
					"content": "Nhưng dạo này trong làng cũng có người khác bắt đầu quay phim quảng cáo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510312
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 740510312,
					"content": "Trong phim còn có người hát kịch nữa, hoành tráng lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510313
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 740510313,
					"content": "Vì vậy chúng tôi mới đến Fontaine tham vấn chuyên gia phim ảnh đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510314
					],
					"speakerTitle": "Cô Chủ Qiu"
				},
				{
					"id": 740510314,
					"content": "Vậy là mọi người đến Fontaine học quay phim à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740510315
					]
				},
				{
					"id": 740510315,
					"content": "Đúng thế. Chúng tôi tìm được một \"chuyên gia phim ảnh\" tên là Geisert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510316
					],
					"speakerTitle": "Cô Chủ Qiu"
				},
				{
					"id": 740510316,
					"content": "Anh ấy rất am hiểu việc dùng ánh sáng trong phim để... Để cái gì ấy nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510317
					],
					"speakerTitle": "Cô Chủ Qiu"
				},
				{
					"id": 740510317,
					"content": "\"Tự sự\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510318
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 740510318,
					"content": "Đúng! Dùng ánh sáng để \"tự sự\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510319
					],
					"speakerTitle": "Cô Chủ Qiu"
				},
				{
					"id": 740510319,
					"content": "Có anh Geisert hướng dẫn, chúng tôi chắc chắn sẽ quay được những bộ phim hay nhất ở Làng Kiều Anh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510320
					],
					"speakerTitle": "Cô Chủ Qiu"
				},
				{
					"id": 740510320,
					"content": "Cô chủ, tháng trước cô mới nói muốn quay bộ phim hay nhất cả Liyue mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510321
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 740510321,
					"content": "Làm kinh doanh thì phải điều chỉnh kế hoạch tương lai của mình cho hợp lý... Cậu thì biết cái gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510322
					],
					"speakerTitle": "Cô Chủ Qiu"
				},
				{
					"id": 740510322,
					"content": "Tóm lại, cảm ơn sự trợ giúp của bạn, Nhà Lữ Hành, xin hãy nhận số tiền này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510323
					],
					"speakerTitle": "Cô Chủ Qiu"
				},
				{
					"id": 740510323,
					"content": "Xingye, Yifeng, mau dựng máy lên đi! Hôm nay nhất định phải quay xong phim mẫu để mang tới cho anh Geisert xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510324
					],
					"speakerTitle": "Cô Chủ Qiu"
				},
				{
					"id": 740510324,
					"content": "Chú ý ánh sáng! Ống kính phải chiếu với nguồn sáng thế này, ánh sáng thu được phải... chân thực và cao cấp!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510325
					],
					"speakerTitle": "Cô Chủ Qiu"
				},
				{
					"id": 740510325,
					"content": "Các cậu đọc hết quyển sách kia rồi chứ, ánh sáng phải chân thực, chân thực, hiểu không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510326
					],
					"speakerTitle": "Cô Chủ Qiu"
				},
				{
					"id": 740510326,
					"content": "Cô chủ, mặc dù chúng tôi đều đọc quyển sách của anh Geisert rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510327
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 740510327,
					"content": "Nhưng với ống kính này thì dù chúng tôi có làm đi làm lại, chất lượng ánh sáng thu được cũng không cao cấp nổi đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yifeng"
				}
			]
		},
