			"dialogs": [
				{
					"id": 732961601,
					"content": "Phù... Không... không ngờ rằng vẽ tranh cũng có yêu cầu thể lực cao như vậy, nếu biết sớm thì tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732961602
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732961602,
					"content": "Xem ra đối với Julien mà nói thì vẫn quá miễn cưỡng rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732961603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732961603,
					"content": "Dù... dù sao thì cũng mới dưỡng thương xong mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732961604
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732961604,
					"content": "Nhưng mà phong cảnh ở đây quả thật rất độc đáo. Kỳ lạ ghê, sao trước đây không để ý thấy nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732961605
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732961605,
					"content": "Phong cảnh phía trước chắc cũng đẹp lắm, chúng ta qua đó xem thử đi, cẩn thận chút nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
