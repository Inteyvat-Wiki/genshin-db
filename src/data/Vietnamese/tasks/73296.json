				{
					"id": 732960802,
					"content": "Đối diện với cảnh sắc như thế này, thì ngôn từ cũng đã trở nên thừa thãi. Caterpillar nói đúng, bên ngoài hàng rào sắt vẫn còn thế giới rộng lớn bao la...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960803
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960803,
					"content": "Hàng rào sắt... Trước đây Julien nói nơi ở của mình ở Fontaine rất nhỏ đúng không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960804,
					"content": "Khụ, phong cảnh tự nhiên ở Sumeru có nhiều lắm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960805
					]
				},
				{
					"id": 732960805,
					"content": "...À, đúng đúng! Anh ấy đã quyết định muốn làm một họa sĩ đường đường chính chính rồi, thay đổi môi trường cũng tốt mà. Có câu là... mở rộng tầm mắt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960806,
					"content": "Tuy bản thân Julien nói muốn từ bỏ... Nhưng tôi thấy không cần phải kết luận nhanh như vậy! Có thể suy nghĩ thêm mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960807,
					"content": "Hãy nghĩ thử xem còn rất nhiều cảnh đẹp giống như phong cảnh trước mắt mà anh vẫn chưa nhìn thấy. Nói không chừng... khi nhìn thấy rồi thì sẽ có cảm hứng ngay thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960808
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960808,
					"content": "Còn về việc phân biệt màu sắc... Julien cũng đã nói rồi, \"chỉ là nhìn thấy cảnh sắc khác nhau\" thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960809,
					"content": "\"Nhưng vẻ đẹp là tương thông với nhau.\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960810
					]
				},
				{
					"id": 732960810,
					"content": "Đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960811,
					"content": "Quả thực... các bạn nói rất có lý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960812
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960812,
					"content": "Là anh tự nói mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960813,
					"content": "Tôi... Haha, hóa ra đạo lý này tôi đều hiểu cả, chỉ là... chỉ là tôi cứ đi sai đường mãi thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960814
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960814,
					"content": "Nhờ Hạt Tiêu dẫn anh đi con đường này, nên chúng ta mới có thể quen biết nhau đó. Cho nên đây cũng không hẳn là \"sai đường\" đâu nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960815
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960815,
					"content": "Tuy rằng không thể giúp anh tìm ra con đường hành hương của Tinh Linh Nước Trong... ưm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960816
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960816,
					"content": "Thứ này có thật sự tồn tại không...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960817
					]
				},
				{
					"id": 732960817,
					"content": "Cho đến bây giờ thì tôi vẫn tin vào sự tồn tại của con đường hành hương. Nhưng... đối với tôi thì có tìm được điểm cuối hay không đã không còn quan trọng nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960818
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960818,
					"content": "Vì tôi đã tìm được đáp án mà tôi muốn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960819
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960819,
					"content": "Cám ơn hai bạn. Haiz, tôi phải cảm tạ các bạn thế nào đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960820
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960820,
					"content": "Nếu như trước đây mua cái trứng chim thần kỳ đó thì tốt rồi... Thứ thần kỳ có thể hóa giải vận xui trong một ngày, tặng cho nhà mạo hiểm như các bạn đây là phù hợp nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960821,
						732960823
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960821,
					"content": "Đúng đó, tiếc thật.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960822
					]
				},
				{
					"id": 732960822,
					"content": "#{NICKNAME} lại tin là có thứ thần kỳ như vậy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960825
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960825,
					"content": "Tôi định ở đây thêm một lát, ở đây khiến tâm trạng tôi cảm thấy yên bình, rất thích hợp để suy nghĩ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960826
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960826,
					"content": "Có linh cảm rằng sẽ vẽ ra thứ gì đó khác biệt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960827
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960827,
					"content": "Cám ơn hai bạn đã giúp đỡ, cũng chúc hành trình của các bạn thuận lợi nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960823,
					"content": "Cám ơn, nhưng mà không cần đâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960824
					]
				},
				{
					"id": 732960824,
					"content": "Tại sao chứ! Cho dù không thể hóa giải vận xui... Nói không chừng... nó ngon hơn trứng chim bình thường cả trăm lần thì sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960825
					],
					"speakerTitle": "Paimon"
				}
			]
		},
