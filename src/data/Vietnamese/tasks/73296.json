				"objectNames": [
					"Julien"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732960401,
					"content": "Nơi đây tràn đầy hơi thở của thiên nhiên... rất thích hợp để vẽ và tìm cảm hứng đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960402,
					"content": "Cái này được tính là một suy nghĩ rập khuôn đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960403
					]
				},
				{
					"id": 732960403,
					"content": "Ừm... Nhưng nếu là tôi thì sẽ rất muốn cầm bút vẽ, vì cảnh tượng ở đây có nét đẹp giàu sức sống, hơn nữa màu sắc cũng rất rực rỡ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960404,
					"content": "Khụ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960405
					]
				},
				{
					"id": 732960405,
					"content": "Ối...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960406,
					"content": "Xin lỗi... tôi không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960407,
					"content": "Haha, không sao đâu, tôi chẳng qua chỉ thấy gì đó khác biệt thôi. Nhưng vẻ đẹp là tương thông với nhau mà đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960408
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960408,
					"content": "Ừm! Tôi rất thích phong cảnh ở đây, cảm giác như được thanh tẩy tâm hồn vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960409,
					"content": "Tâm hồn của Paimon chắc không cần thanh tẩy đâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960410
					]
				},
				{
					"id": 732960410,
					"content": "Hai người bạn tốt của tôi, hai người đã trao rất nhiều sự tốt bụng cho một người xa lạ thậm chí lúc đầu còn nói dối như tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960411
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960411,
					"content": "Hai bạn đều là người có tâm hồn thuần khiết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960412
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960412,
					"content": "Hihi... Cũng không cần khen vậy đâu. Đúng rồi, thật ra còn một cảnh sắc đặc biệt hơn nữa đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960413,
					"content": "#{NICKNAME} chắc chắn biết tôi đang nói đến cảnh gì đúng không, chúng ta dẫn Julien đi xem thử đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
