			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Julien"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732960301,
					"content": "Nghe nói trước khi họa sĩ bắt đầu vẽ thì sẽ phải quan sát ở những góc độ khác nhau... đây chắc không phải là \"suy nghĩ rập khuôn\" đâu đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960302,
					"content": "Chúng ta đi dạo quanh đây đi! Còn có thể đến nơi cao có tầm nhìn tốt hơn để quan sát nữa đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960303,
					"content": "Nghe có vẻ hay đó, tôi đã chuẩn bị sẵn sàng rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960304
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960304,
					"content": "#Đúng rồi, hay chúng ta thử thi xem ai đến điểm đích trước nhé? {NICKNAME}, chuẩn bị sẵn sàng chưa nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7329604,
			"completionStepIds": [
				7329604
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
