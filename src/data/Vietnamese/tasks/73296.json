			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Julien"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732960201,
					"content": "#Paimon và cả {NICKNAME}, hai bạn quả nhiên đã đến! Đúng là khi ra ngoài phải nhờ bạn bè.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960202
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960202,
					"content": "Vì đã hứa dẫn đường cho anh rồi mà, hơn nữa cũng không phải chuyện to tát gì! Tiện tay thôi... À chắc phải nói là tiện chân chứ nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960203,
					"content": "Nhưng mà anh trở về Fontaine sớm vậy sao? Hiếm khi có dịp đến Sumeru, thật ra ở Sumeru cũng có nhiều phong cảnh đẹp lắm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960204,
						732960206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960204,
					"content": "Phong cảnh trong rừng mưa rất đẹp.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960205
					]
				},
				{
					"id": 732960205,
					"content": "Rất nhiều cây cỏ và sông ngòi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960208,
					"content": "Nghe đúng là rất hấp dẫn, nhưng tôi nghĩ... thật ra tôi vẫn chưa chuẩn bị kỹ cho việc đi xa. Lần này tuy là một chuyến đi thất bại, nhưng cũng xem như đã nhận được bài học rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960209
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960209,
					"content": "Ừm... Vậy... vậy ở gần đây cũng có phong cảnh đẹp đáng chiêm ngưỡng! Nếu bỏ lỡ thì tiếc lắm đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960210,
					"content": "Nơi Paimon giới thiệu thì tuyệt đối không sai đâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960211
					]
				},
				{
					"id": 732960211,
					"content": "Nếu hai bạn đã kiên quyết, tôi còn từ chối nữa thì thất lễ với bạn tốt của mình rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960212
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960212,
					"content": "Hihi, tôi là người dẫn đường tốt nhất Teyvat đấy nhé, chuyện dẫn đường cứ giao cho tôi nha! Mọi người cứ đi theo là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960206,
					"content": "Phong cảnh ở sa mạc rất đặc biệt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960207
					]
				},
				{
					"id": 732960207,
					"content": "Có rất nhiều cát và di tích!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960208
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7329603,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
