					"nextDialogs": [
						740090210
					],
					"speakerTitle": "Luca"
				},
				{
					"id": 740090210,
					"content": "Này! Không thành vấn đề thật sao? Tôi luôn cảm thấy họ sẽ trực tiếp ra tay!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090211
