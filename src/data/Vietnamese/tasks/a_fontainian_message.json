					"nextDialogs": [
						740090305
					],
					"speakerTitle": "Virgil"
				},
				{
					"id": 740090305,
					"content": "#Thật lợi hại. Thân thủ của {NICKNAME} đúng như lời đồn. Anh không thấy vậy sao? Luca thân mến.",
