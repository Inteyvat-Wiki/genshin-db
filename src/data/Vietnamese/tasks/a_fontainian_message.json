			},
			"dialogs": [
				{
					"id": 740090101,
					"content": "Thật trùng hợp. Anh nói có đúng không? Luca thân mến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090102
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090102,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090103
					],
					"speakerTitle": "Luca"
				},
				{
					"id": 740090103,
					"content": "Các anh là?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090104,
					"content": "Xem tôi kìa, thật thất lễ. Tôi là Sonny, đôi khi bạn bè gọi tôi là \"Găng Tay Trắng\". Còn \"Ngư Dân\" Luca đây cũng có chút tiếng tăm trong một nhóm người đặc biệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090105
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090105,
					"content": "À, xin chào! Tôi là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090106,
					"content": "#Tôi biết, tôi biết, bạn là Paimon, còn {M#anh chàng}{F#cô nàng} tóc vàng này là {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090107
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090107,
					"content": "Ơ? Anh biết chúng tôi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090108,
					"content": "#Tất nhiên là biết rồi! Nhưng trước đó, tôi biết bạn và {NICKNAME}, cũng giống như tôi biết ngài Neuvillette, nhưng chỉ là một phía.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090109
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090109,
					"content": "Những nhân vật xuất chúng như hai vị, một khi đặt chân lên Fontaine, đương nhiên sẽ có những chú chim nhỏ nói cho chúng tôi biết rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090110
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090110,
					"content": "Thì ra chúng tôi nổi tiếng như vậy sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090111
					]
				},
				{
					"id": 740090111,
					"content": "Xem kìa, đúng là khiêm tốn! Nói thế này nhé, sự xuất hiện của hai người ở Fontaine, đối với một số người, sẽ giống như quả bom xuất hiện trên sân khấu lớn ở Epiclese vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090112
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090112,
					"content": "...Tất nhiên, đó là khía cạnh tốt! Đúng không? Luca thân mến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090113
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090113,
					"content": "Ừm, thế nào mới là khía cạnh tốt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090114,
					"content": "Hmm... Tôi không giỏi dùng từ, anh thấy thế nào? Luca thân mến?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090115
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090115,
					"content": "Buổi biểu diễn ảo thuật của Lyney và Lynette. Nổ bom, biểu diễn trốn thoát. Những tin tức bùng nổ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090116
					],
					"speakerTitle": "Luca"
				},
				{
					"id": 740090116,
					"content": "Tuyệt vời! Bạn thấy đấy, tôi không thể nghĩ ra những điều như thế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090117
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090117,
					"content": "Thì, thì ra là vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090118,
					"content": "Nhưng tại sao anh lại có tên là \"Găng Tay Trắng\"? Rõ ràng là không hề đeo găng tay mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090119,
					"content": "Ồ, câu hỏi này khó quá. Phải giải thích thế nào đây nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090120
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090120,
					"content": "Hãy tưởng tượng bạn đang đeo găng tay trắng. Lúc này, chỉ cần chạm vào những thứ dơ bẩn, sẽ để lại vết bẩn trên găng tay, đúng không? Vì vậy, trách nhiệm của tôi là tìm ra những thứ dơ bẩn đó và xử lý nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090121
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090121,
					"content": "Đúng ha... Vậy cũng tức là người phụ trách dọn dẹp đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090122,
					"content": "Nói hay lắm, Paimon thân mến! Tôi không thể tóm tắt tính chất công việc của mình một cách ngắn gọn như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090123
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090123,
					"content": "Vậy nên đường phố của Đại Sảnh Fontaine sạch sẽ như vậy là nhờ có những người như Sonny!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090124,
					"content": "Hahaha, nói nghe thật xuôi tai! Cứ cho là vậy đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090125
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090125,
					"content": "Đúng đó... Nhưng mà người dọn dẹp vẫn phải mang theo dao sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090126,
					"content": "Cứ xem nó như một dụng cụ nhỏ có ích khi dọn dẹp một số loại rác cứng đầu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090127
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090127,
					"content": "Ừm, tôi hiểu rồi! Vậy là Luca vì giỏi câu cá nên mới gọi là \"Ngư Dân\" sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090128,
					"content": "Ừm... Cũng không hoàn toàn là vậy. Bạn thấy đấy, ở Fontaine chúng tôi, chẳng phải có đủ các loại cá sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090129
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090129,
					"content": "Và dạy mọi người cách sống vui vẻ và yên bình với những đàn cá đầy màu sắc là chuyên môn của anh ấy. Tôi nói đúng không? Luca thân mến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090130
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090130,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090131
					],
					"speakerTitle": "Luca"
				},
				{
					"id": 740090131,
					"content": "Ơ? Tôi không hiểu... Nếu là như vậy, thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090132,
					"content": "Ôi ôi, Paimon thân mến đúng là biết hỏi mà. Những câu hỏi đều rất hóc búa và rất có trình độ. Rất mong được trò chuyện với bạn nhiều hơn, và trả lời những câu hỏi của bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090133,
						740090135
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090133,
					"content": "Paimon, đừng hỏi nữa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090134
					]
				},
				{
					"id": 740090134,
					"content": "Ơ? Thôi được... Vậy Sonny, Luca, hai người có việc gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090136,
					"content": "Bạn thấy đấy, chúng tôi rất quan tâm đến việc \"lặn\". Vùng biển Fontaine của chúng tôi chứa đầy của cải, cả tự nhiên và người xưa để lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090137
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090137,
					"content": "Nghe nói gần đây bạn có quen một người bạn ở đây và đã xuống nước với anh ấy. Bạn mạnh đến mức không cần đồ bảo hộ khi xuống nước, đúng không? Luca thân mến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090138
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090138,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090139
					],
					"speakerTitle": "Luca"
				},
				{
					"id": 740090139,
					"content": "Các anh muốn hỏi chuyện của Virgil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090140
					]
				},
				{
					"id": 740090140,
					"content": "Đúng vậy. Chúng tôi muốn hỏi chuyện của Virgil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090141
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090141,
					"content": "Virgil... Cái tên đó! A, tức quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090142
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090142,
					"content": "Cùng với Paimon, kể chi tiết về chuyện trước đây cho \"Găng Tay Trắng\" Sonny và \"Ngư Dân\" Luca.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740090143
					]
				},
				{
					"id": 740090143,
					"content": "Thì ra là vậy, thì ra là vậy. Cảm ơn nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090144
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090144,
					"content": "Không cần cảm ơn! Hừm, thứ tồi tệ đó, tôi không bao giờ quên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090145,
					"content": "...Chúng tôi rất biết ơn hai vị vì đã thành thật về những gì đã xảy ra với Virgil. Nhưng tôi càng biết ơn hơn vì hai vị không phải là bạn của hắn. Nếu không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090146
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090146,
					"content": "Hm, nếu không ít nhiều cũng sẽ hơi bất tiện cho cả hai chúng ta, đúng không? Luca thân mến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090147
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090147,
					"content": "Chắc là không thể đối phó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090148
					],
					"speakerTitle": "Luca"
				},
				{
					"id": 740090148,
					"content": "Nghĩ cũng phải, nghĩ cũng phải. Thật sự rất cảm ơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090149
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090149,
					"content": "Anh đang nói gì vậy...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090150
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090150,
					"content": "Họ là kẻ thù của Virgil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090151
					]
				},
				{
					"id": 740090151,
					"content": "Ồ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090152
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090152,
					"content": "#Những lời này thật khiến người khác đau lòng, thưa {M#quý ngài tôn kính}{F#quý cô đáng yêu}. Tôi không có kẻ thù, chỉ có rất nhiều bạn, Virgil cũng là một trong số đó. Có điều, về Virgil thân mến...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090153
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090153,
					"content": "#Chúng ta cần \"nói chuyện\" đàng hoàng với anh ta. Bạn hiểu mà, đúng không? {NICKNAME} thân mến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090154
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090154,
					"content": "Đương nhiên cũng cần một lời giải thích cho bạn và Paimon. Nếu không thì thất lễ với hai vị khách quý quá, đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090155
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090155,
					"content": "Cái này, tôi không hiểu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090156,
						740090158
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090156,
					"content": "Anh ta là \"Găng Tay Trắng\". Biết như vậy là được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090157
					]
				},
				{
					"id": 740090157,
					"content": "Vậy sao...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090160
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090160,
					"content": "Chúng tôi đã tìm được cứ điểm của Virgil và những người bạn của anh ta. Hay là chúng ta gặp nhau ở cứ điểm nhé, bạn thấy thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090161,
						740090165
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090161,
					"content": "Tại sao phải cùng nhau..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090162
					]
				},
				{
					"id": 740090162,
					"content": "#{M#Quý ngài tôn kính}{F#Quý cô đáng yêu}! Virgil đã làm chuyện mạo phạm bạn như vậy, nếu tôi và Luca không chào hỏi bạn, mà... nói chuyện với anh ta thì thất lễ quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090163
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090163,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090164
					],
					"speakerTitle": "Luca"
				},
				{
					"id": 740090164,
					"content": "Bạn xem, Luca cũng hiểu đạo lý này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090166
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090166,
					"content": "Hừm! Tôi cũng phải nói chuyện với Virgil! Để anh ta xin lỗi chúng tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090167
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090167,
					"content": "Hahaha, bạn thật tử tế. Vậy thì hẹn gặp nhau ở điểm đến nhé, hai vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090165,
					"content": "Được. Đi thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090166
					]
				},
				{
					"id": 740090158,
					"content": "Những chuyện này không cần hiểu quá rõ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090159
					]
				},
				{
					"id": 740090159,
					"content": "#Ở trên đời, nếu hiểu nhiều quá sẽ hơi chán, đúng không? {M#Quý ngài tôn kính}{F#Quý cô đáng yêu}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090160
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090135,
					"content": "Tìm chúng tôi có việc gì không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090136
					]
				}
			]
