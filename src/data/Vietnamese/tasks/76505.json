			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Varesa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 765050101,
					"content": "#{NICKNAME} và Paimon? Thật là trùng hợp! Trước đây tôi nghe nói hai vị đã đi đến Nod-Krai, không ngờ lại gặp được ở đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050102
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050102,
					"content": "Đúng vậy! Tôi còn tưởng mình nhìn nhầm nữa chứ! Varesa, sao cô cũng chạy đến nơi xa như vậy thế? Lẽ nào đến để du lịch à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765050103,
					"content": "Hihi, cũng đại khái là thế! Lần này tôi đến đây để giúp vườn cây ăn quả ở nhà thu mua một lô máy móc nông nghiệp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050104
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050104,
					"content": "Cha nói là bên Nod-Krai có vài thứ hay ho, có thể làm cho trái cây lớn nhanh hơn, cũng có thể giúp tôi tiết kiệm sức lực. Như vậy tôi sẽ có nhiều thời gian hơn để ngủ... và tập luyện hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050105
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050105,
					"content": "Sau khi đến đây, tôi phát hiện ở đây có rất nhiều món ngon mà Natlan không có! Mấy ngày nay ngoài việc chính ra, tôi gần như dành toàn bộ thời gian cho việc ăn uống!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050106
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050106,
					"content": "Không ngờ sắp đến lúc phải về rồi, tôi có chút không nỡ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050107
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050107,
					"content": "Thế nên tôi phải tận dụng cơ hội cuối cùng để đi dạo một vòng, thử hết những món chưa ăn và ngắm hết những cảnh chưa ngắm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050108
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050108,
					"content": "#Còn hai vị thì sao? Để tôi đoán xem... Đại anh hùng {NICKNAME} có phải lại đang bảo vệ chính nghĩa ở vùng đất mới này không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050109,
						765050110
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050109,
					"content": "Chúng tôi đang tham quan xung quanh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765050111
					]
				},
				{
					"id": 765050111,
					"content": "Hihi, tôi hiểu! Đến một đất nước mới thì nhìn cái gì cũng thấy mới lạ, chỉ muốn dùng máy ảnh \"tách\" một cái lưu lại hết từng ngóc ngách thú vị thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050112
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050112,
					"content": "Nói mới nhớ... Lẽ ra tôi cũng nên chụp lại hết những món ngon đã ăn ở đây mới phải.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050113
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050113,
					"content": "Như vậy lúc tôi về Natlan, biết đâu có thể nhờ chú Atolli xem ảnh rồi thử tái hiện lại những món ngon này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050114
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050114,
					"content": "Biết đâu Varesa có thể trở thành một nhiếp ảnh gia ẩm thực đó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765050115
					]
				},
				{
					"id": 765050115,
					"content": "Hihi, thật sao? Nhiếp ảnh gia ẩm thực à... Nghe có vẻ tuyệt vời! Mỗi ngày đều được tiếp xúc với những món ngon, còn có thể chụp chúng sao cho ai nhìn vào cũng phải thèm nhỏ dãi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050116,
						765050117
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050116,
					"content": "Trước khi chụp ảnh món ngon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765050118
					]
				},
				{
					"id": 765050118,
					"content": "Ủa, muốn chụp ảnh tôi sao? Thật không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050119
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050119,
					"content": "Tóc... tóc tôi có bị rối không? Khóe miệng có dính nước sốt không? Chà, sớm biết hôm nay sẽ gặp hai vị thì tôi đã đeo món phụ kiện mua ở chợ hôm qua rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050120,
						765050121
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050120,
					"content": "Bây giờ cũng rất đẹp rồi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765050122
					]
				},
				{
					"id": 765050122,
					"content": "Được! Vậy... vậy thì nhờ hai vị nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050121,
					"content": "Tôi muốn chụp lại dáng vẻ vui vẻ của cô.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765050122
					]
				},
				{
					"id": 765050117,
					"content": "Tôi có thể chụp ảnh cho cô không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765050118
					]
				},
				{
					"id": 765050110,
					"content": "Nhân tiện tìm kiếm tư liệu chụp ảnh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765050111
					]
				}
			]
		},
