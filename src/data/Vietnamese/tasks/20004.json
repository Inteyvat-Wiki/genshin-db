			"dialogs": [
				{
					"id": 200040301,
					"content": "Là bạn à, lâu rồi không gặp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040302
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 200040302,
					"content": "Sao trông vội vàng vậy, tìm tôi có việc gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040303
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 200040303,
					"content": "Mona, mấy hôm nay cô đi đâu vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200040304,
					"content": "Tôi tìm cô mấy ngày nay đó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200040305
					]
				},
				{
					"id": 200040305,
					"content": "Thật đáng tiếc... Mấy hôm trước báo Chim Hơi Nước vừa đặt tôi một bản thảo mới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040306
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 200040306,
					"content": "Chủ đề là \"mối quan hệ giữa những thay đổi trong chuyển động của chiêm tinh và những thay đổi trong vận mệnh cá nhân\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040307
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 200040307,
					"content": "Để viết bản thảo này, mấy hôm nay tôi phải ở bên ngoài quan sát chiêm tinh, rất khuya mới trở về nhà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040308
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 200040308,
					"content": "Vì để kiếm tiền, Mona thật sự đã rất cố gắng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200040309,
					"content": "Kính thiên văn bên Đại Sảnh Fontaine lại ra bản mới, tôi đã đặt cọc rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040310
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 200040310,
					"content": "Khi nào có thù lao của bản thảo này là tôi có thể thanh toán hết và chính thức có được chiếc kính thiên văn đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040311
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 200040311,
					"content": "Cô còn tiền để trả tiền thuê nhà cho ngài Goth không...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200040312
					]
				},
				{
					"id": 200040312,
					"content": "Tiền thuê nhà?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040313
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 200040313,
					"content": "À ừm...! Chắc, chắc là tôi còn chút đỉnh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040314
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 200040314,
					"content": "Các bạn chờ chút, để tôi tìm xem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040315
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 200040315,
					"content": "(Mona bắt đầu lục túi...)",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						200040316
					]
				},
				{
					"id": 200040316,
					"content": "Chỗ này... cộng thêm chỗ này! Chắc là đủ trả tiền thuê nhà rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040317
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 200040317,
					"content": "(Mona móc hết tiền trong người ra rồi sao...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200040318
					]
				},
				{
					"id": 200040318,
					"content": "Các bạn giúp tôi đưa số tiền này cho ngài Goth nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
