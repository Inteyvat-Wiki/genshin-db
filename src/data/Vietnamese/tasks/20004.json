			},
			"dialogs": [
				{
					"id": 200040101,
					"content": "Haiz, xem ra ta phải tự đi một chuyến rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040102
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040102,
					"content": "Bộ xương già của ta sắp gãy mất rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040103
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040103,
					"content": "Có việc gì gấp sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200040104
					]
				},
				{
					"id": 200040104,
					"content": "Nhà Lữ Hành? Haiz...cũng không thể xem là việc gấp, nhưng ta thật sự không thể làm nổi nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040105
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040105,
					"content": "Cháu cũng biết chuyện bọn Fatui đã bao hết khách sạn của ta rồi đúng không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040106
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040106,
					"content": "Sau khi bọn họ bao hết khách sạn, ta là ông chủ của khách sạn Goth, đương nhiên cũng phải ở bên cạnh lo liệu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040107
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040107,
					"content": "Giúp liên hệ với nhà cung ứng thực phẩm, nhờ người sửa chữa kịp thời khi đồ bị hỏng, và một số thứ linh tinh nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040108
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040108,
					"content": "Gần đây, bàn ghế ở một số phòng trong khách sạn bị hỏng, ta phải liên hệ người sửa và gửi loại gỗ phù hợp cho thợ mộc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040109
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040109,
					"content": "Còn tiền thuê mấy căn nhà trong thành chưa thu...thằng nhóc Marvin thì suốt ngày không thấy bóng dáng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040110
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040110,
					"content": "Haiz, không biết thân già này còn chịu được mấy năm, rốt cuộc đến khi nào Marvin mới hiểu chuyện hơn một chút đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040111,
						200040112
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040111,
					"content": "Cháu sẽ giúp ông.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200040113
					]
				},
				{
					"id": 200040113,
					"content": "Cháu, cháu đồng ý giúp ta sao? Haiz, thật phiền cháu quá, giá như Marvin hiểu chuyện bằng một nửa cháu thôi thì ta cũng không mệt mỏi thế này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040114
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040114,
					"content": "Vậy thì phiền cháu tìm giúp ta một ít Gỗ Sam và một ít Gỗ Hoa về đây trước, ta phải sớm đưa chúng cho thợ mộc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040112,
					"content": "Ông ở đây nghỉ ngơi một chút đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200040113
					]
				}
			]
		},
		{
			"id": 2000403,
