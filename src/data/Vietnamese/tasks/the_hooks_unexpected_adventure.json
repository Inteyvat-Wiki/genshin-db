			"dialogs": [
				{
					"id": 230360601,
					"content": "Tuyệt lắm, tiếp theo tôi phải câu cá rồi, lần này nhất định sẽ câu được cá lớn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360602
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230360602,
					"content": "Kayvan làm mồi câu, bắt đầu câu cá...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230360603
					]
				},
				{
					"id": 230360603,
					"content": "Ngay sau đó, Kayvan đã câu được một chiếc hộp sũng nước...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230360604
					]
				},
				{
					"id": 230360604,
					"content": "Cái này... Để tôi xem nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360605
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 230360605,
					"content": "Ơ? Đồ bên trong... hình như lại là đồ bị thất lạc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360606,
						230360607
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 230360606,
					"content": "Không hổ danh là anh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230360608
					]
				},
				{
					"id": 230360608,
					"content": "Chà... Sau cái lần cùng anh Kayvan đi tìm vị học giả kia cải tiến mồi câu, chúng tôi vẫn luôn câu cá ở bên ngoài...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360609
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 230360609,
					"content": "Nhưng mỗi lần thả câu... anh Kayvan vẫn luôn câu được những thứ kỳ quặc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360610
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 230360610,
					"content": "Trong đó bao gồm đồ thất lạc của người khác, quặng dưới đáy sông, kiện hàng rơi khỏi thuyền...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360611
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 230360611,
					"content": "Thậm chí còn có một nhà mạo hiểm vô tình rơi xuống nước nắm lấy dây câu của anh Kayvan để leo lên bờ nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360612
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 230360612,
					"content": "Nhưng chúng tôi vẫn không thể câu được bất kỳ một con cá nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360613
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 230360613,
					"content": "Sự nghiệp câu cá của tôi đã kết thúc hoàn toàn rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360614
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230360614,
