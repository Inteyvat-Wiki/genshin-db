			"dialogs": [
				{
					"id": 230360101,
					"content": "Anh Kayvan hãy thử dùng loại mồi câu mới xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360102
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 230360102,
					"content": "Tôi đã thử bao nhiêu lần rồi, nó giống hệt như trước đây thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360103
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230360103,
					"content": "Ơ? Tại sao hai người lại câu cá cùng nhau?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230360104,
					"content": "Nhà Lữ Hành, chúng ta lại gặp nhau rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360105
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230360105,
					"content": "Xin chào, hai vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360106,
						230360107
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 230360106,
					"content": "Anh đã tìm ra nguyên nhân khiến anh không câu được cá chưa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230360108
					]
				},
				{
					"id": 230360108,
					"content": "Haha, chẳng có gì hết. Tôi và vị học giả đó đã thử đủ kiểu cải tiến cần câu, mồi câu và kỹ thuật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360109
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230360109,
					"content": "Còn đổi không biết bao nhiêu vùng nước, góc độ... Thậm chí còn để tôi câu cá trong một cái ao đầy cá nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360110
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230360110,
					"content": "Nhưng dù thế nào đi nữa, tôi cũng chỉ câu được những thứ không phải là cá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360111
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230360111,
					"content": "Đừng lo, anh Kayvan, chẳng phải vị học giả đó cũng hứa sẽ tiếp tục nghiên cứu sao? Anh ấy chắc chắn sẽ tìm ra nguyên nhân giúp anh thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360112
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 230360112,
					"content": "Anh thấy đấy, anh ấy đã thiết kế một loại mồi câu mới cho anh, còn nhờ tôi ở cạnh anh mọi lúc, ghi chép mọi chi tiết trong quá trình câu cá của anh nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360113
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 230360113,
					"content": "Mong rằng anh ấy thật sự có thể tìm ra được... Nhưng trước lúc đó, tôi vẫn sẽ câu cá theo cách của riêng mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360114
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230360114,
					"content": "Nhà Lữ Hành, nếu bạn rảnh thì tìm ít nguyên liệu làm mồi câu giúp tôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230360107,
					"content": "Sau khi thỉnh giáo các học giả thì anh có thu hoạch gì không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230360108
					]
				}
			]
		},
