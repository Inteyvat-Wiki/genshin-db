		{
			"id": 7309903,
			"completionStepIds": [
				7309905
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7309905",
							"2"
						],
						"stepId": 7309905,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Araminali",
					"Paimon",
					"Aranimba"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730990301,
					"content": "A! Là Nara Vàng! Hơn nữa, có mùi của gió, mùi của đất, còn có mùi của Aranara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990302
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 730990302,
					"content": "Nara Vàng cũng đã phá giải Ararakalari của Arayama?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990303
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 730990303,
					"content": "Đáng sợ, đáng sợ! Cản trở cũng vô ích, ai cũng có thể xông vào, \"mái ấm vui vẻ\" của Araminali sắp bị \"đạp nát\" rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990304
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 730990304,
					"content": "Ấy, bạn đừng lo lắng, chúng tôi không có ý xấu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730990305,
					"content": "Không có \"ý xấu\" là sao? Ý là không \"tham lam\" à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990306
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 730990306,
					"content": "#Ừm... Cho là thế đi! Tôi và {NICKNAME} đứng về phía Aranara mà, chúng tôi muốn làm bạn tốt của Aranara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730990307,
					"content": "Dù Paimon ham ăn, nhưng bản chất không xấu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730990308
					]
				},
				{
					"id": 730990308,
					"content": "Này! Tuy nói vậy cũng không sai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730990309,
					"content": "Bạn tốt của Aranara... Trên người Nara Vàng có mùi của Aranara, mùi quen thuộc mà lâu rồi không ngửi thấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990310
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 730990310,
					"content": "#À phải rồi, hạt giống kì lạ đó! {NICKNAME}, đưa hạt giống cho Araminali xem thử đi, biết đâu Araminali biết gì đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730990311,
					"content": "Ôi! Khát quá! Hạt giống cần phải uống rất nhiều nước mới có thể về dáng vẻ ban đầu... Nhanh lên, bên này có rất nhiều nước, để hạt giống uống no căng mới có thể khôi phục.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990312
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 730990312,
					"content": "Đặt hạt giống vào trong nước...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730990313
					]
				},
				{
					"id": 730990313,
					"content": "...Phù! Quay về rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990314
					],
					"speakerTitle": "Aranimba"
				},
				{
					"id": 730990314,
					"content": "#Wow! Hạt giống biến thành Aranara kìa! Thật sự tìm ra \"Aranara gặp nguy\" rồi! Tôi nói không sai chứ, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990315,
						730990316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730990315,
					"content": "\"Aranara gặp nguy\" thật sự tồn tại...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730990317
					]
				},
				{
					"id": 730990317,
					"content": "Là Aranimba! Không giống Araminali, Aranimba thích chu du khắp nơi, sẽ vẽ lại cảnh sắc nhìn thấy ở nơi xa, gửi về Vanarana, nhưng sau đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990318
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 730990318,
					"content": "Sau đó đến một nơi rất cứng và tối, ít đất nhưng nhiều đá... Dưới mặt đất có rất ít cỏ cây nhưng nhiều nấm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990319
					],
					"speakerTitle": "Aranimba"
				},
				{
					"id": 730990319,
					"content": "Ừm... Có phải Vực Đá Sâu không? Nhưng sao một Aranara như Aranimba lại chạy đến nơi xa như vậy, thậm chí là rời khỏi Sumeru nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730990320,
					"content": "Đúng! Đường xá xa xôi, lại còn nguy hiểm, gặp phải Nara Đen thật nguy hiểm! Nhưng Aranimba được Aramuhukunda dõi theo, biến thành hạt giống, \"tránh được một kiếp nạn\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990321
					],
					"speakerTitle": "Aranimba"
				},
				{
					"id": 730990321,
					"content": "Giờ Aranimba trở về an toàn, may mà có Nara Vàng, còn có Bông Trắng Bay Bay nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990322
					],
					"speakerTitle": "Aranimba"
				},
				{
					"id": 730990322,
					"content": "#Là {NICKNAME} và Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730990323,
					"content": "#Phải, Nara {NICKNAME} và Paimon là bạn tốt của Aranara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990324
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 730990324,
					"content": "#Araminali là \"bạn tốt\" của Aranimba, nên Nara {NICKNAME} và Paimon cũng là \"bạn tốt\" của Aranimba, hiểu rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990325
					],
					"speakerTitle": "Aranimba"
				},
				{
					"id": 730990325,
					"content": "Aranimba phải xuất phát rồi, lần này không chỉ vẽ mà Aranimba còn mang \"quà\" về cho Araminali đặt vào \"rương báu\" nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990326
					],
					"speakerTitle": "Aranimba"
				},
				{
					"id": 730990326,
					"content": "\"Rương báu\" ở đây đều là của Araminali, Araminali là chủ nhân của \"rương báu\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990327
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 730990327,
					"content": "Nếu đúng là bạn tốt của Aranara, đã giúp đỡ Aranara nhiều, Aranara \"có ơn phải trả\", sẽ đặt \"báu vật\" vào trong \"rương\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990328
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 730990328,
					"content": "Hóa ra cái rương đó vốn rỗng sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730990329,
					"content": "Khi Aranara ra đời đã biết mọi điều về Vana, nhưng khi \"rương\" ra đời bên trong đều trống rỗng! Araminali cũng không hiểu tại sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990330
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 730990330,
					"content": "Paimon cũng chẳng hiểu nổi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990331
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730990331,
					"content": "#...Chờ Araminali sắp xếp xong, Nara {NICKNAME} có thể mở \"rương báu\" ra, sau đó giống như Nara Lục, lúc thì \"được\", lúc thì \"ôi...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990332
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 730990332,
					"content": "Tại sao phải vòng vo vậy chứ? Araminali và Aranimba có thể lấy luôn đồ trong rương báu làm thù lao cho chúng tôi mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990333
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730990333,
					"content": "#Araminali biết, Nara Lục thích vào trong hang động hay trong nhà, mở \"rương báu\" ra. Nara {NICKNAME} và Paimon không thích sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990334
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 730990334,
					"content": "Ừm... Khó để nói là không thích... Cảm thấy có một... lực hút vô hình chăng?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990335
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730990335,
					"content": "Ừ, Nara thích \"rương báu\", Araminali cũng thích, nên cho phép Nara từng giúp Aranara mở \"rương báu\" ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990336
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 730990336,
					"content": "Còn rất nhiều Aranara, có người cần giúp, cũng có người muốn chơi cùng Nara, Nara nào thực hiện nguyện vọng của họ mới là bạn của Aranara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990337
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 730990337,
					"content": "Nara như vậy mới có thể mở \"rương báu\" mà Araminali đã chuẩn bị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990338
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 730990338,
					"content": "Thế nên, giờ chắc Aranimba nên xuất phát rồi, để lấp đầy \"rương báu\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990339
					],
					"speakerTitle": "Aranimba"
				},
				{
					"id": 730990339,
					"content": "Hử? Nhưng chẳng phải Aranimba mới quay về không bao lâu sao? Mới đó lại phải rời đi rồi à? Đúng là khí thế hừng hực như gió và lửa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990340
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730990340,
					"content": "Ấy! Có gió rất tốt, nhưng không cần lửa, nếu gần lửa quá, Aranimba sẽ khát lắm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990341
					],
					"speakerTitle": "Aranimba"
				},
				{
					"id": 730990341,
					"content": "À, ý tôi là, sao Aranimba lại đi gấp thế, rõ ràng có thể ở lại lâu hơn để ôn chuyện cũ với Araminali mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990342
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730990342,
					"content": "Araminali cũng thế, lâu rồi không gặp Aranimba, không có gì muốn nói sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990343
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730990343,
					"content": "Aranimba là một Aranara không thể dừng chân, nên không thể làm chủ nhân của \"rương báu\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990344
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 730990344,
					"content": "Tin tức chu du khắp nơi của Aranimba chỉ cần Vana biết, gió biết, hoa cỏ biết, Araminali cũng sẽ biết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990345
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 730990345,
					"content": "Thế nên, không sao cả, không cần phải nói nhiều. Chỉ cần Aranimba muốn nói, Araminali sẽ nghe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990346
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 730990346,
					"content": "#Ừm... Đây chính là tình bạn của Aranara sao? Nếu là tôi, chắc chắn có vô số chuyện muốn san sẻ với {NICKNAME} nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730990316,
					"content": "Vẫn ổn chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730990317
					]
				}
			]
		},
