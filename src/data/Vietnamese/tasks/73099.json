			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730990101,
					"content": "Chà, thế giới của Aranara thật kỳ diệu... Nhìn theo bức tranh là có thể tìm được kho báu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730990102,
					"content": "Cứ thế sẽ tìm được tất cả địa điểm trong bức tranh! Không biết Aranara đã vẽ những bản đồ kho báu này đang ở đâu nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990103,
						730990104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730990103,
					"content": "Không phải tất cả...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730990105
					]
				},
				{
					"id": 730990105,
					"content": "Phải rồi, nói như vậy, còn bức tranh có nhiều Aranara ở cùng nhau nữa, chúng ta không tìm thấy kho báu ở đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730990106,
					"content": "(Hình như có thứ gì trong bao hành lý rung lên.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730990107,
					"content": "(Tìm được vật phẩm rung.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730990108
					]
				},
				{
					"id": 730990108,
					"content": "Ủa? Đây là... hạt giống lúc trước chúng ta tìm được ở Vực Đá Sâu sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990109,
						730990111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730990109,
					"content": "Hình như đang chỉ dẫn chúng ta đi đâu đó...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730990110
					]
				},
				{
					"id": 730990110,
					"content": "Ừm... Biết đâu là vậy thật! Sau này nếu hạt giống còn rung, chúng ta sẽ để ý thêm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730990113,
					"content": "Biết đâu thật sự có \"Aranara gặp nguy\"! Hoặc là \"Kho báu Aranara\" gì đó... mà hạt giống chính là chìa khóa thì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730990111,
					"content": "Thật khó hiểu mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730990112
					]
				},
				{
					"id": 730990112,
					"content": "Ừm... Tôi thấy có thể hạt giống này muốn đi đâu đó! Sau này nếu hạt giống còn rung, chúng ta để ý thêm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730990104,
					"content": "Vẫn còn một chỗ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730990105
					]
				}
			]
		},
