				"points": []
			},
			"dialogs": [
				{
					"id": 4890101,
					"content": "Tôi biết rồi, tôi lập tức xuất phát!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890102
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4890102,
					"content": "Là Amber! Cô đến xử lý ủy thác phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4890103,
					"content": "Ah, xin chào. Tôi đang chuẩn bị đi đây, việc xử lý Hilichurl giao cho Kỵ Sĩ Trinh Thám là thích hợp nhất rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890104
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4890104,
					"content": "Haiz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890105
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890105,
					"content": "Tiểu thư Sara... Sao vẫn ảo não như vậy chứ? Yên tâm đi, Kỵ Sĩ Trinh Thám sẽ không làm cô thất vọng đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890106
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4890106,
					"content": "À, à không phải vậy, tôi không phải nghi ngờ thực lực của Amber đâu, chỉ là đơn hàng hiện nay quá nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890107
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890107,
					"content": "Lúc nãy, lại có một đơn hàng kỳ lạ, giống như là chuẩn bị cho cả một buổi tiệc lớn ấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890108
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890108,
					"content": "Hmm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890109
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4890109,
					"content": "Vậy còn cần giúp gì nữa không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4890110
					]
				},
				{
					"id": 4890110,
					"content": "Tôi có thể giúp nấu cơm!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4890111
					]
				},
				{
					"id": 4890111,
					"content": "#Thật không! {F#Cô}{M#Cậu} đồng ý giúp sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890112
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890112,
					"content": "#Tốt quá rồi, {F#cô}{M#cậu} chính là ân nhân của quán Người Săn Hươu chúng tôi đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890113
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890113,
					"content": "Ồ... sao có cảm giác hào quang của mình bị cướp mất vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890114
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4890114,
					"content": "#Vậy thì đơn hàng mới này giao cho {F#cô}{M#cậu} nhé, hãy bắt đầu từ việc thu thập nguyên liệu nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890115
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890115,
					"content": "#Nhưng mà... {NICKNAME} làm được không, như mùi vị của món ăn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4890116,
					"content": "Không quản được nhiều việc như vậy nữa, đây là cuộc chiến liên quan đến danh dự của Người Săn Hươu, không thể kén chọn được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890117
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890117,
					"content": "Chiến... chiến đấu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4890118,
					"content": "Món ăn cần <color=#00E1FFFF>3 phần Hoa Ngọt và 3 phần Thịt Gia Cầm</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890119
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890119,
					"content": "Được rồi, mau chuẩn bị đi, tiểu thư Amber cũng vậy, tôi sẽ ở đây đợi mọi người!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890120
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890120,
					"content": "À ừm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				}
			]
		},
