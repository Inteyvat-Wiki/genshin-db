					"content": "Ừ, đúng rồi, nguyên liệu đã đủ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890203
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890203,
					"content": "Sau đó... là một phần <color=#00E1FFFF>Gà Nấu Hoa Ngọt</color> của đơn hàng số 7, cảm ơn nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890204
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890204,
					"content": "Coi người ta như đầu bếp luôn rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4890205,
					"content": "Đã hứa là sẽ giúp Người Săn Hươu rồi mà, làm xong tranh thủ lúc nóng giao qua đi.",
					"roleType": "TALK_ROLE_NPC",
