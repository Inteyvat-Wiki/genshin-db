				{
					"id": 4890301,
					"content": "Gà Nấu Hoa Ngọt, vui lòng nhận lấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890302
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890302,
					"content": "#Mùi vị có vẻ ngon, tài nghệ của {F#cô}{M#cậu} cũng được nhỉ, thật là tìm đúng người rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890303
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890303,
					"content": "#Nếu đã vậy... chi bằng phần <color=#00E1FFFF>Thịt Nướng Mật Ong</color> trong đơn này cũng giao cho {F#cô}{M#cậu} đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890304
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890304,
					"content": "<color=#00E1FFFF>Thịt Nướng Mật Ong</color>! Trước kia từng ăn với Amber...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4890305,
					"content": "Đúng vậy, đây chính là món gia truyền của quán Người Săn Hươu, cũng là niềm kiêu hãnh của quán.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890306
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890306,
					"content": "Khi đội Kỵ Sĩ đến ăn cơm cũng thường hay gọi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890307
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890307,
					"content": "#Tôi sẽ đưa công thức của <color=#00E1FFFF>Thịt Nướng Mật Ong</color> cho {F#cô}{M#cậu}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890308
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890308,
					"content": "Đợi chút, đây không phải là món gia truyền của Người Săn Hươu sao, cô muốn dạy cho chúng tôi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4890309,
					"content": "#Với tài nghệ của {F#cô}{M#cậu}, chắc sẽ không làm hỏng danh hiệu của Người Săn Hươu đâu nhỉ, haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890310
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890310,
					"content": "Phần <color=#00E1FFFF>Thịt Nướng Mật Ong</color> đó làm xong thì mang đến cho tôi nhé.",
					"roleType": "TALK_ROLE_NPC",
