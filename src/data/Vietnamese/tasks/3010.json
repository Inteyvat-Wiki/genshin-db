			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nahida"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30100101,
					"content": "Tôi, tôi đã nhớ được toàn bộ rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100102,
					"content": "...Rất tốt, lần này mọi người thích nghi rất nhanh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100103
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30100103,
					"content": "Cuối ngày hôm qua...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100104
					]
				},
				{
					"id": 30100104,
					"content": "Đúng vậy, hôm qua rõ ràng chúng ta đã tháo bỏ Trạm Cuối Akasha, nhưng vẫn nghe được âm thanh đến từ Akasha, chuyện này là thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100105,
						30100106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100105,
					"content": "Chúng ta bị cấy một dạng Trạm Cuối Akasha nào đó rồi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100107
					]
				},
				{
					"id": 30100107,
					"content": "Nhưng mà lần này chúng ta có thể cơ bản xác nhận là, chuyện chúng ta bị nhốt trong cùng một ngày có liên quan đến Akasha đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100108,
					"content": "Nếu như nói Akasha muốn \"lấy trộm\" trí tuệ của mọi người, vậy tại sao lại phải tạo ra tình trạng này chứ... không thể hiểu được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100109,
					"content": "Con chuột bạch trên bàn thí nghiệm muốn biết được tại sao bản thân bị đối xử như vậy cũng là một chuyện cực kỳ khó khăn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100110
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30100110,
					"content": "Cô ví chúng tôi như chuột bạch sao, vậy cô là gì, Nahida, cô vẫn chưa nói cho tôi biết thân phận của cô đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100111,
					"content": "Ừm... tôi là \"mặt trăng\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100112
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30100112,
					"content": "Mặt trăng? Đây là kết quả bói toán của chúng ta mà?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100113,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100114
					]
				},
				{
					"id": 30100114,
					"content": "Được rồi, biết thân phận của tôi cũng không giúp ích được cho các bạn tìm ra chân tướng đâu. Hãy để tâm đến những vấn đề khác đi, cẩn thận đừng để bỏ sót manh mối nào nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100115
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30100115,
					"content": "Ừm... được rồi. Nếu như hôm qua Dehya đã giúp chúng ta nhiều như vậy, vậy thì cứ đi tìm cô ấy thôi. Giờ này chắc đám bắt cóc sắp xuất hiện rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100106,
					"content": "Chúng ta chỉ cho rằng bản thân đã tháo Trạm Cuối Akasha ra sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100107
					]
				}
			]
		},
		{
			"id": 301002,
			"completionStepIds": [
				301002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"301002",
							"2"
						],
						"stepId": 301002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dehya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30100201,
					"content": "Các vị ở đây sao, đám bắt cóc đó đã bị tôi giải quyết rồi, tiểu thư không bị thương chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100202
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30100202,
					"content": "Đợi đã, hình như có gì đó không đúng...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100203
					]
				},
				{
					"id": 30100203,
					"content": "Ối... Dehya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100204,
					"content": "Sao vậy? Sao hai người lại nhìn tôi chằm chằm thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100205
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30100205,
					"content": "Tại sao lần này cô không bị thương vậy!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100206,
					"content": "Hả? Lần này có nghĩa là gì, hơn nữa, tại sao tôi lại phải bị thương chứ? Bọn chúng chỉ là những tên nhãi nhép thôi mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100207,
						30100208
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30100207,
					"content": "Thanh trọng kiếm của cô đáng lẽ phải không mấy thuận tay mới phải!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100209
					]
				},
				{
					"id": 30100209,
					"content": "#Suỵt... sao {F#cô}{M#cậu} lại biết chuyện thanh kiếm của tôi thế, tôi chưa từng nói với ai mà, đừng để tiểu thư biết chuyện này nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100210
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30100210,
					"content": "Quả nhiên Dehya vẫn chưa nhớ lại được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100211,
						30100212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100211,
					"content": "Trong lần chiến đấu này...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100213
					]
				},
				{
					"id": 30100213,
					"content": "Điểm kỳ lạ sao... kể ra thì hai vị cũng biết tôi mới đổi kiếm đúng không, nhưng không biết tại sao thanh kiếm mới đó lại rất thuận tay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100214
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30100214,
					"content": "Giống như... giống như đã trải qua vô số lần chiến đấu vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100215
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30100215,
					"content": "Ý là tuy không có ký ức về việc chiến đấu với chúng, nhưng cơ thể... vẫn có cảm giác đó đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100216,
					"content": "Đúng vậy, dù là lính đánh thuê hay là chiến binh thì \"ký ức cơ thể\" mới là điều quan trọng nhất. Chiêu thức mà dựa vào cái đầu để nhớ thì chỉ trưng cho đẹp thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100217
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30100217,
					"content": "#{NICKNAME}, bạn thấy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100218,
						30100219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100218,
					"content": "Không lẽ là do ảnh hưởng bởi chuyện hôm qua tháo bỏ Trạm Cuối Akasha sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100220
					]
				},
				{
					"id": 30100220,
					"content": "Đúng đó, cứ như thấy được hy vọng vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100221,
					"content": "Hoặc là... chúng ta đã thoát ra được rồi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100222
					]
				},
				{
					"id": 30100222,
					"content": "Hả! Cũng đúng nhỉ, \"Samsara Của Lễ Hội Sabzeruz\" trước đây không có xuất hiện tình trạng thế này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100223,
					"content": "Đợi khi kết thúc hôm nay là sẽ biết được thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100224
					]
				},
				{
					"id": 30100224,
					"content": "Tuy tôi nghe không hiểu hai người đang thảo luận chuyện gì, nhưng mà nguy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100225
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30100225,
					"content": "Nguy hiểm vẫn chưa qua, muốn chúng tôi dẫn Dunyarzad đi nghỉ ngơi, còn cô sẽ kiểm tra xung quanh xem còn đồng bọn của đám bắt cóc không đúng chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100226,
					"content": "Sao hai người lại biết được... là thuật đọc tâm sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100227
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30100227,
					"content": "Được rồi, chúng ta mau làm thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100219,
					"content": "Lần đầu tiên xuất hiện sự thay đổi như vậy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100220
					]
				},
				{
					"id": 30100212,
					"content": "Cô có phát hiện ra điểm gì kỳ lạ không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100213
					]
				},
				{
					"id": 30100208,
					"content": "Cho nên vốn dĩ cô phải bị thương chút ít.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100209
					]
				}
			]
		},
		{
			"id": 301003,
			"completionStepIds": [
				301003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"301003",
							"2"
						],
						"stepId": 301003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nahida"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30100301,
					"content": "...Phù, cuối cùng cũng tới tối rồi, ngoài chuyện đó ra thì hôm nay cũng không có thay đổi gì nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100302,
					"content": "Nahida, nghe tôi nói này, hôm nay chúng tôi phát hiện ra Dehya vốn dĩ bị thương khi chiến đấu với kẻ xấu, nhưng hôm nay lại không bị thương.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100303,
					"content": "Cô nghĩ có phải \"Samsara Của Lễ Hội Sabzeruz\" đã kết thúc rồi không? Dunyarzad có phải đã được cứu rồi không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100304,
					"content": "Hửm? Có tiến triển như vậy rồi sao, không tệ đấy. Nếu là vậy thì hôm nay nghỉ ngơi sớm thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100305
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30100305,
					"content": "Này, đây là kiểu đáp án mơ hồ gì đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100306,
					"content": "Ngày mai sẽ đến, chuyện này đối với tất cả mọi người mà nói chỉ là kiến thức thông thường. Nhưng thực ra ngày mai có thật sự đến không, thì chỉ có bạn của ngày mai mới biết được thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100307
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30100307,
					"content": "Hôm nay đã qua bao nhiêu lần? Ngày hôm nay sau đó có thể nào là ngày hôm qua không? Hai chữ \"ngày mai\" liệu có phải chỉ là một khái niệm vô thực được tạo ra không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100308
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30100308,
					"content": "Hoặc có lẽ, cả thế giới này đều là giả, cả lịch sử của vùng đất rộng lớn này đều là một ngày Lễ Hội Sabzeruz trải dài thì sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100309
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30100309,
					"content": "Được rồi được rồi, đừng nói nữa, não tôi mệt lắm rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100310,
					"content": "Haha... chuyện mà ngày mai sẽ biết được thì hôm nay đừng nên phí công để suy nghĩ nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100311
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30100311,
					"content": "Cứ nghỉ ngơi thư giãn đi, ví dụ như là đi cầu gì đó chẳng hạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100312
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30100312,
					"content": "Hả? Đợi đã, cô vừa mới nói gì thế? Tôi có nghe nhầm không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100313,
					"content": "Hử? Người ta thường nói sau khi đi cầu thì tinh thần cũng sẽ thoải mái hơn nhiều mà. Cho nên tôi gợi ý hai bạn đi cầu thì có gì kỳ lạ đâu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100314
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30100314,
					"content": "Chậc... Quá ư kỳ lạ mà cũng quá ư thiếu kiến thức phổ thông, làm tôi không biết phải nói gì luôn... Rõ ràng ban nãy cô còn nói những chuyện rất vĩ mô mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100315,
					"content": "Vậy chúng tôi về nghỉ ngơi trước đây.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100316
					]
				},
				{
					"id": 30100316,
					"content": "Ừm, tuy mỗi ngày đều là một ngày hội vui vẻ, nhưng hình như chúng ta đã lâu rồi không được thư giãn qua. Đi thôi, chúng ta về phòng nghỉ ngơi thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100317,
					"content": "\"Tik...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100318,
					"content": "Tiếp tục \"thu hoạch\" nhé, so với kết quả mà nói thì đây chỉ là những tiểu tiết không đáng kể.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Azar"
				}
			]
		},
