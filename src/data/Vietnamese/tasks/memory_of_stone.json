						730150907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150907,
					"content": "Ừm... Nhưng đây là \"Hòn Đá Ký Ức\" sao? Nhìn giống tấm bia đá mà Aranara đã dựng lên vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150908
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150908,
					"content": "#Nara {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
