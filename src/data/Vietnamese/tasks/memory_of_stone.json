			},
			"dialogs": [
				{
					"id": 730151601,
					"content": "Aranakula, chúng tôi trở về rồi! Nhưng mà tiếp theo phải dựa vào bạn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151602,
					"content": "#Cảm ơn Paimon, cảm ơn Nara {NICKNAME}, Aranakula biết phải làm sao rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151603
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151603,
					"content": "Ồ! Xem ra ở đây chắc là không sao rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151604,
					"content": "Hy vọng rừng sâu có thể nhanh chóng khôi phục lại bình thường.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730151605
					]
				},
				{
					"id": 730151605,
					"content": "Chắc chắn có thể sửa được Cỗ Máy Varuna. Nhưng Marana... thì phải thanh trừ, vì Vana, vì Sarva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151606
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151606,
					"content": "Giống như \"Bia Kỷ Niệm\" xây lên cho Nara Varuna đã bị hạt giống xấu che đi mất. Vì Marana, \"Sảnh Ashvattha\" cũng bị ảnh hưởng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151607
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151607,
					"content": "Đó là vườn ươm mà Nara và Aranara cùng nhau xây dựng thật lâu trước khi Nara Varuna tới Vanarana. Nhưng bây giờ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151608
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151608,
					"content": "Ngoài đám trẻ ở Làng Vimara thì vẫn còn thấy được, còn đối với người lớn thì Aranara chỉ còn tồn tại trong những câu chuyện... Vườn ươm khi xưa cũng vì Marana mà hoang vu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151609,
					"content": "Aranakula muốn trồng đủ loại hoa ở vườn ươm, Nara đã quên Aranara, nhưng cũng không sao, bởi vì Nara sẽ được ngắm hoa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151610
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151610,
					"content": "Aranakula...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151611,
					"content": "#Cám ơn Nara {NICKNAME} và Paimon, Aranakula sẽ không quên đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151612
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151612,
					"content": "Bây giờ, Aranakula phải về \"nơi dừng chân\", Arapandu biết \"Bia Kỷ Niệm\" được dọn dẹp sạch sẽ, nhất định sẽ rất vui vẻ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151613
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151613,
					"content": "#Nara {NICKNAME} và Paimon có muốn cùng Aranakula trở về \"nơi dừng chân\" không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151614,
						730151616
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151614,
					"content": "Được chứ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730151615
					]
				},
				{
					"id": 730151615,
					"content": "Có Nara Vàng đi cùng, cực kỳ yên tâm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151616,
					"content": "Vẫn còn chuyện khác.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730151617
					]
				},
				{
					"id": 730151617,
					"content": "#Aramuhukunda dõi theo Nara {NICKNAME} và Paimon, cẩn thận đừng để những kẻ xấu nuốt mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranakula"
				}
