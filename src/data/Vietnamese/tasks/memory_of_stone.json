			"trigger": {
				"objectNames": [
					"Paimon",
					"Aranakula"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730150301,
					"content": "Đây chắc hẳn là Aranakula đúng không!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150302,
					"content": "Huhu! Bị, bị Nara phát hiện rồi! Phải, phải làm sao đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150303
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150303,
					"content": "Này, đừng chạy! Là Arapandu nói cho chúng tôi biết bạn ở đây đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150304,
					"content": "Nếu, nếu là Arapandu nói với các bạn, vậy nhất định là Nara tốt rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150305
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150305,
					"content": "#Hả? Sao Aranakula cả tin thế? Lỡ như {NICKNAME} là Nara xấu, mượn tên Arapandu ra để lừa bạn thì sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150306,
					"content": "Á! Vậy, vậy Nara Vàng đang lừa Aranakula? Nara Vàng là Nara xấu sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150307
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150307,
					"content": "Tự nhiên thấy tội lỗi đầy mình ghê...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150308,
					"content": "Đừng nghe Paimon, tôi là Nara tốt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150309
					]
				},
				{
					"id": 730150309,
					"content": "#Tốt quá rồi, cảm ơn Aramuhukunda, Nara Vàng quả nhiên là Nara tốt. Tuy Nara {NICKNAME} còn cao hơn Aranakula nhiều, nhưng không đáng sợ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150310
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150310,
					"content": "Paimon... Paimon nhỏ xíu, cũng không đáng sợ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150311
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150311,
					"content": "Này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150312,
						730150314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150312,
					"content": "Paimon đúng là rất nhỏ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150313
					]
				},
				{
					"id": 730150313,
					"content": "Xem thường tôi là sẽ thiệt thòi đấy! Hừ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150316,
					"content": "Nhưng quay lại chuyện chính nào, chúng tôi tới là để sửa chữa Cỗ Máy Varuna, vùng \"Vana\" bên này chắc cũng có \"cành\" và \"lá\" của Cỗ Máy Varuna nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150317,
					"content": "Arapandu bảo chúng tôi đến xem tình hình, nếu bạn gặp khó khăn thì cũng tiện giúp đỡ bạn luôn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150318,
					"content": "A! Rất nhiều người xấu ở Vana... có đường an toàn, nhưng phải cẩn thận. Hơn nữa khắp nơi đều là hạt giống xấu, ngay cả nơi dành cho Nara Varuna cũng... Huhu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150319
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150319,
					"content": "#Nara {NICKNAME} cao to vậy, nói không chừng cũng mạnh như Arabalika... Nara {NICKNAME}, nói không chừng sẽ có cách...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150320
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150320,
					"content": "#...Nara {NICKNAME}, nói không chừng có thể giúp đỡ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150321
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150321,
					"content": "#Chúng tôi tới vốn là để giúp đỡ mà, đúng không, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150322,
					"content": "Cứ giao cho chúng tôi đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150323
					]
				},
				{
					"id": 730150323,
					"content": "Aranakula có thỉnh cầu khác, trước khi sửa chữa Cỗ Máy Varuna... xin hãy đi tìm Hòn Đá Ký Ức trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150324
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150324,
					"content": "...\"Hòn Đá Ký Ức\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150325
					]
				},
				{
					"id": 730150325,
					"content": "Vana sẽ không quên, Aranara sẽ không quên, nhưng Aranara để lại những ký ức xem được. Từ khi tên xấu xa kia tới, nơi đâu cũng là hạt giống xấu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150326
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150326,
					"content": "Nói chuyện với Aranara chẳng hiểu gì cả... Nhưng chắc sau khi nhìn thấy thì sẽ hiểu thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150327,
					"content": "Tóm lại, chúng ta sẽ đi cùng với Aranakula!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150328
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150328,
					"content": "Nara tốt, Paimon tốt! Chúng ta đừng để người xấu phát hiện, có đường an toàn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150329
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150329,
					"content": "Hừm? \"Người xấu\" mà Aranakula nói chính là đám Nấm Quỷ à, vậy thì không cần lo gì hết!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150330
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150330,
					"content": "#Aranakula, nghe cho rõ nhé, Nara {NICKNAME} mạnh lắm đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150331
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150331,
					"content": "Hơn nữa cũng không phải dạng vừa đâu! Là cực... kỳ... mạnh đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150332
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150332,
					"content": "Lúc trước chúng tôi đã cùng Arapandu đánh bại rất nhiều Nấm Quỷ! Ngay cả Arapandu cũng phải công nhận thực lực của chúng tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150333
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150333,
					"content": "#Hiểu rồi, Nara {NICKNAME} nhất định cũng mạnh y như Arabalika. Còn Paimon thì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150334
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150334,
					"content": "Tôi? Tôi thì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150335
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150335,
					"content": "Từng có chuyện thế này... Aranakula bị người xấu đuổi theo, chui xuống dưới đất, nhưng lại bị đào lên...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150336
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150336,
					"content": "Haiz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150337
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150337,
					"content": "Miệng của người xấu nhễu chất lỏng, ướt nhẹp, nóng hổi, còn có cả mùi trái cây thối nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150338
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150338,
					"content": "Ôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150339
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150339,
					"content": "Nếu không nhờ Arabalika kịp thời chạy tới thì Aranakula đã...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150340
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150340,
					"content": "Huhu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150341
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150341,
					"content": "Sau đó Arapandu đã dạy dỗ rất lâu, mặt trời lặn rồi lại mọc, ngay cả hạt giống gieo xuống ở vườn ươm cũng đã nảy mầm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150342
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150342,
					"content": "...Dạy dỗ lâu thế!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150343
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150343,
					"content": "Nhưng chuyện này thì liên quan gì tới Paimon chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150344
					]
				},
				{
					"id": 730150344,
					"content": "Đúng đó đúng đó, liên quan gì tới Paimon chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150345
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150345,
					"content": "Aranakula lợi hại hơn Paimon, suýt chút nữa cũng bị người xấu nuốt chửng. Pai... Paimon nhỏ như vậy, nguy hiểm lắm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150346
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150346,
					"content": "#Nghe cũng có lý nhỉ? Không đúng! {NICKNAME} rất lợi hại, chắc chắn sẽ bảo vệ được Paimon mà, đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150347,
						730150349
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150347,
					"content": "Đương nhiên rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150348
					]
				},
				{
					"id": 730150348,
					"content": "#Hì hì, dù sao tôi cũng là đồng đội tốt nhất của {NICKNAME} mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150351
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150351,
					"content": "Nhưng nhiều người xấu như vậy, Aranakula cũng đánh không lại người xấu... Ừm... Nara Vàng tuy rất mạnh, nhưng mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150352
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150352,
					"content": "Aranakula biết đường an toàn, chúng ta đi đường an toàn nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150353
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150353,
					"content": "Hả? Chẳng lẽ... Aranakula rất sợ Nấm Quỷ sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150354
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150354,
					"content": "Hức...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150355
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150355,
					"content": "Hì hì, hóa ra là vậy. Nhưng lấy Paimon ra làm cái cớ thì không phải bé ngoan đâu nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150356
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150356,
					"content": "#Nếu đã vậy, {NICKNAME}, chúng ta và Aranakula cùng đi đường an toàn đi, trên đường cẩn thận một chút, đừng kinh động đến Nấm Quỷ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150357
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150357,
					"content": "Tôi có kinh nghiệm lắm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150358
					]
				},
				{
					"id": 730150358,
					"content": "Đúng vậy, cảm giác hình như đã làm chuyện tương tự rất nhiều lần rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150359
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150359,
					"content": "Ừm! Aranakula sẽ đưa Nara đi đường an toàn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150349,
					"content": "Paimon cũng có thể tự mình chạy trốn mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150350
					]
				},
				{
					"id": 730150350,
					"content": "#Tôi sẽ không bỏ rơi {NICKNAME} để chạy một mình đâu! Chắc là... không đâu nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150351
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150314,
					"content": "Paimon nho nhỏ, năng lượng thiệt to.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150315
					]
				},
				{
					"id": 730150315,
					"content": "Nói đúng lắm! Paimon rất lợi hại đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150316
					],
					"speakerTitle": "Paimon"
				}
			]
		},
