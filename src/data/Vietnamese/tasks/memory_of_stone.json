						730150909
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150909,
					"content": "Tôi đến để quét sạch hạt giống xấu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150910
					]
				},
				{
					"id": 730150910,
					"content": "#Aranakula đừng lo, chút việc nhỏ đó cứ giao cho Nara {NICKNAME}, nhất định sẽ không tốn nhiều sức đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150905,
					"content": "Cứ xem như trong rừng có một ít thực phẩm dự trữ vậy...",
