				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730151101,
					"content": "#Ôi! Cảm ơn Nara {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151102
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151102,
					"content": "Vana ghi nhớ tất cả những chuyện sau khi Nara Varuna tới đây, đại thụ nhớ, hạt giống cũng nhớ. Nhưng không biết, Nara Varuna có hiểu hay không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151103
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151103,
					"content": "Vì vậy nên lưu lại ký ức có thể nhìn thấy được. Như vậy khi Nara Varuna trở về Vana, sẽ biết Vana không quên, Aranara cũng không hề quên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151104
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151104,
					"content": "Hóa ra là vậy... \"Hòn Đá Ký Ức\" chính là Bia Kỷ Niệm à. Con người cũng hay xây Bia Kỷ Niệm để không bị lãng quên đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151105,
					"content": "Vì Nara là sinh vật dễ quên.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730151106
					]
				},
				{
					"id": 730151106,
					"content": "...So với rừng sâu, Nara giống như một mầm non nhỏ, không thể vươn mình thành đại thụ che trời, cũng không thể nhớ rõ tất cả những đổi thay đã qua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151107,
					"content": "Aranara sẽ không rời khỏi Vana, Aranara và Vana ở bên nhau. Nhưng Nara sẽ đến rồi lại đi, giống như Nara Varuna vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151108
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151108,
					"content": "Có rất nhiều Aranara, cũng giống như ở Vana có nhiều đại thụ vậy. Rất nhiều Aranara đều có tên riêng, giống như đại thụ có rất nhiều cành lá vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151109
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151109,
					"content": "Nara Vàng, nhớ tên của rất nhiều Aranara, nhớ tôi là Aranakula, giống như nhặt một chiếc lá rơi ở nơi này, lại biết nó rơi từ gốc cây nào vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151110
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151110,
					"content": "#Chắc đối với Aranara mà nói, Nara Varuna cũng là một Nara \"đặc biệt\"! Nên mới xây Bia Kỷ Niệm cho {F#anh ấy}{M#cô ấy} đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151111,
					"content": "Tuy không giống lắm, nhưng trước đây chúng ta đã từng thấy bức tượng điêu khắc hình dáng cụ thể hơn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151112,
					"content": "...Tượng thần sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730151113
					]
				},
				{
					"id": 730151113,
					"content": "#Đúng! Nghe nhiều chuyện của Nara Varuna như vậy, {NICKNAME} không muốn biết diện mạo của {F#anh ấy}{M#cô ấy} sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151114,
					"content": "Aranara đã có âm nhạc, nói không chừng mặt khác cũng rất lợi hại! Có lẽ sẽ khắc ra được một bức tượng sống động hơn thì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151115,
						730151117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151115,
					"content": "Nếu như có thì tôi quả thật rất muốn biết đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730151116
					]
				},
				{
					"id": 730151116,
					"content": "Đúng đó đúng đó! Hì hì, Nara Varuna, Nara Vàng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151119,
					"content": "Đúng rồi, hiện tại chúng ta có thể đi sửa \"cành\" và \"lá\" của Cỗ Máy Varuna rồi chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151120,
					"content": "#Aranakula sẽ đưa Nara {NICKNAME} và Paimon đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151117,
					"content": "Nghệ thuật của Aranara đều rất mộc mạc, khó mà tưởng tượng...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730151118
					]
				},
				{
					"id": 730151118,
					"content": "#À... nghệ thuật như vậy đối với {NICKNAME} mà nói có lẽ hơi mới mẻ nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151119
					],
					"speakerTitle": "Paimon"
				}
			]
