			"dialogs": [
				{
					"id": 730151301,
					"content": "Không ngờ lại ở nơi này. Nếu không có Aranakula dẫn đường, sợ là chúng ta khó mà tìm ra nơi này ấy chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151302,
					"content": "Nhưng hình như không thấy \"lá\" đâu nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151303,
					"content": "Lá... ở gần cây, không xa lắm, nhưng mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151304
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151304,
					"content": "Ừm... Ở đây an toàn, chắc là Nấm Quỷ sẽ không tìm tới đây được đâu, Aranakula ở đây chờ chúng tôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151305,
					"content": "Arapandu từng nói với chúng ta là chỉ cần để ba tảng đá \"lá\" chuyển hướng về phía \"cành\" ở đây là được rồi đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151306,
					"content": "#Cám ơn Nara {NICKNAME} và Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranakula"
				}
