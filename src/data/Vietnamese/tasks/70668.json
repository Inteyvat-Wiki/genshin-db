			"dialogs": [
				{
					"id": 706660101,
					"content": "Bắt đầu đột phá khiêu chiến!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706660102
					]
				},
				{
					"id": 706660102,
					"content": "#Meo...\"Ây da, đến đây để thực hiện thí luyện đột phá cấp bài thủ à... Ừm, đúng là {NICKNAME} đã đủ tư cách khiêu chiến, vậy tôi sẽ...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706660103
					],
					"speakerTitle": "\"Tiểu Hoàng Tử\""
				},
				{
					"id": 706660103,
					"content": "\"Vậy thì để Shuyun chuẩn bị ván bài dùng cho thí luyện đột phá đi, hãy cẩn thận ứng phó nhé...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"Tiểu Hoàng Tử\""
				}
			]
		},
		{
			"id": 7066802,
			"completionStepIds": [
				7066804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
