			"trigger": {
				"objectNames": [
					"Alrani"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715551001,
					"content": "Cảm ơn các bạn, tôi còn tưởng tôi xong đời rồi... Có lẽ bọn Đạo Bảo Đoàn vẫn luôn theo dõi tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551002
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551002,
					"content": "Nghiên cứu của tôi về di tích này vừa có tiến triển, sẽ thật tuyệt nếu tôi có thể đào được kho báu mang về...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551003
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551003,
					"content": "Nhưng còn chưa chuẩn bị xong, bọn Đạo Bảo Đoàn đã xông vào trói tôi đưa đến đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551004
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551004,
					"content": "Bọn chúng còn ép tôi nói ra tung tích kho báu, còn uy hiếp tôi, nói nếu tôi không nói ra vị trí kho báu, bọn chúng sẽ lấy mạng tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551005
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551005,
					"content": "Nhưng tôi biết, nếu tôi nói thẳng ra, thì tôi mới thật sự là chán sống...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551006
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551006,
					"content": "Đúng là tôi nên nghe lời tiểu thư Soraya, nhà khảo cổ học tốt nhất không nên quan tâm đến kho báu, chỉ cần có thu hoạch về học thuật là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551007
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551007,
					"content": "Nhưng tôi chỉ có chút tiền, chỉ vài luận văn thôi thì cả tiền đi lại tôi cũng không đủ chi trả...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551008
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551008,
					"content": "Không hiểu sao tiểu thư Soraya có thể một mình nghiên cứu ở Liyue lâu như vậy, chỉ nhìn số luận văn cô ấy bị từ chối thôi mà tôi cảm thấy mệt thay cô ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551009
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551009,
					"content": "Vậy tiếp theo bạn tính thế nào?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715551010
					]
				},
				{
					"id": 715551010,
					"content": "Còn thế nào nữa, tài liệu học thuật tôi đã sưu tập đủ rồi, kho báu thì... thôi vậy, nhường cho các bạn đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551011
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551011,
					"content": "Quá trình tìm kiếm lung tung tôi cũng không nói nhiều nữa, tóm lại, kho báu chôn <color=#00E1FFFF>dưới gốc cây vàng</color> ở giữa Thần Luật Quan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551012
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551012,
					"content": "Các bạn muốn thì đến đó lấy, tôi ghi địa chỉ lại cho các bạn, tránh để các bạn quên mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551013
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551013,
					"content": "Tôi nghỉ ngơi một chút rồi về trại dọn đồ, tôi phải mau rời khỏi đây, tránh để bọn Đạo Bảo Đoàn lại kéo đến...",
