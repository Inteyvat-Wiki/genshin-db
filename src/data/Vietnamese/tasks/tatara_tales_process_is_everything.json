					"Xavier"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721180401,
					"content": "Tốt quá rồi, để tôi xem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180402
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180402,
					"content": "Vận may của chúng ta không tồi, trạng thái của \"Lò Luyện Mikage\" rất ổn định, và năng lượng của \"Họa Thần\" xung quanh cũng không quá mạnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180403
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180403,
					"content": "Ở mức độ này, thiết bị của tôi vẫn có thể chịu đựng được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180404
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180404,
					"content": "Là muốn thanh tẩy tất cả năng lượng của Họa Thần sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721180405
					]
				},
				{
					"id": 721180405,
					"content": "Nếu thiết bị này có thể đạt được mức độ như vậy, đáng lẽ tôi đã phải đăng ký bằng sáng chế từ lâu rồi. Người bạn mới này nhiều nhất cũng chỉ có thể giảm chỉ số năng lượng của một vài khu vực mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180406
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180406,
					"content": "Có điều, \"Lò Luyện Mikage\" ngừng hoạt động, ngay cả quy trình tự động khởi động lại cũng không thể thực hiện được, chính là do bị năng lượng Họa Thần nồng độ cao bao trùm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180407
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180407,
					"content": "Chỉ cần chúng ta đi tìm nơi mà Họa Thần nồng độ cao nhất rồi thanh tẩy chúng, sẽ khiến hạt nhân có thể vận hành lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180408
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180408,
					"content": "Sau đó, \"Lò Luyện Mikage\" chắc sẽ có thể khởi động lại. Tiếp sau đó, thì chúng ta không cần phải lo lắng gì nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180409
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180409,
					"content": "Đây chính là toàn bộ kế hoạch của tôi, trước đó tôi còn phải chuẩn bị thêm chút nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				}
			]
		},
