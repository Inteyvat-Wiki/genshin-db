				{
					"id": 721180501,
					"content": "Dạo này hoạt động của đám Fatui kia càng ngày càng quái dị, hình như chúng đều tập trung ở khu vực hạt nhân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180502
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180502,
					"content": "Hy vọng chúng không có mưu đồ xấu xa nào đó... Hoặc đừng có làm chuyện gì để chúng ta không xử lý nổi...",
