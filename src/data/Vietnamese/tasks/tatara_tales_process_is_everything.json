			"trigger": {
				"objectNames": [
					"Xavier"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721180101,
					"content": "Cuối cùng đã hoàn thành! May mà tôi còn nhớ cách chế tạo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180102
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180102,
					"content": "Phải vào để thanh tẩy những Họa Thần kia à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721180103
					]
				},
				{
					"id": 721180103,
					"content": "Tôi rất muốn trực tiếp vào để giải quyết triệt để việc này, nhưng không thể xem nhẹ khi đối phó với Họa Thần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180104
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180104,
					"content": "Hơn nữa, vì quả thực không thể tìm được một số nguyên liệu, đành dùng những nguyên liệu khác thay thế tạm thời, cho nên độ đáng tin cậy của thiết bị này cũng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180105
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180105,
					"content": "Ờ...nói thế này mới phải, \"trong một số tình huống, tồn tại trường hợp không thể đạt đến trạng thái vận hành mong muốn\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180106
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180106,
					"content": "Mặc dù sử dụng bình thường chắc không vấn đề gì, nhưng với trạng thái của thiết bị này, chắc nó không thể chịu được các tình huống bất ngờ, nếu gặp phải chút va đập, chưa biết chừng sẽ rơi vài linh kiện ra ngoài...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180107
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180107,
					"content": "Cho nên trước khi chuyển đồng đội mới này vào trong để làm việc, chúng ta phải làm tốt công tác chuẩn bị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180108
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180108,
					"content": "Trước tiên phiền bạn đến gần Lò Luyện Mikage, ghi lại dữ liệu một chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180109,
						721180111
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180109,
					"content": "Cứ giao cho tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721180110
					]
				},
				{
					"id": 721180110,
					"content": "Vậy phiền bạn rồi, tôi ở đây chờ bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180111,
					"content": "Cẩn thận như vậy sao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721180112
					]
				},
				{
					"id": 721180112,
					"content": "Đương nhiên rồi. Tôi còn bỏ qua rất nhiều bước đó, nếu là ngài Flois, thì chúng ta tối thiểu còn phải tốn 1 tuần nếu làm theo quy trình của ngài ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180113
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180113,
					"content": "Tóm lại, lần này chúng ta tới đâu hay tới đó đi, dù sao tôi cũng đại diện tổ đánh giá đặc biệt...bây giờ tôi cho phép cho chúng ta dựa theo tình hình thực tế để tuỳ cơ ứng biến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				}
			]
		},
