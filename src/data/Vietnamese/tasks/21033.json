			"dialogs": [
				{
					"id": 210330101,
					"content": "Không biết... ý tưởng này có hiệu quả không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330102
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330102,
					"content": "Cô vẫn đang tìm thanh kiếm kia sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210330103
					]
				},
				{
					"id": 210330103,
					"content": "Nhà Lữ Hành? Là bạn à... Đúng vậy, tôi vẫn đang tìm Tàng Phong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330104
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330104,
					"content": "Nhưng đến bây giờ tôi vẫn chưa tìm được manh mối nào có giá trị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330105
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330105,
					"content": "Nhưng mà đây cũng là chuyện bất đắc dĩ, dù sao thì việc tìm một thanh kiếm ở cả Liyue... thật sự quá khó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330106
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330106,
					"content": "Có người nói với tôi là thanh kiếm đó đã bị ma vật phá hủy từ lâu rồi... Nhưng cho dù nó có vỡ vụn đi nữa thì tôi cũng sẽ tìm cho bằng được tất cả mảnh vỡ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330107
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330107,
					"content": "Xin lỗi vì đã nói quá nhiều. Địa điểm ủy thác lần này tôi đã đánh dấu trên bản đồ của bạn, nhờ bạn nhé, Nhà Lữ Hành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330108
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330108,
					"content": "Hy vọng... thanh kiếm đó không bị vỡ thật...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				}
			]
