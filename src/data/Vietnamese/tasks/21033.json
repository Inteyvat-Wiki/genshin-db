			"dialogs": [
				{
					"id": 210330403,
					"content": "Chuôi kiếm này... không hoàn chỉnh lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330404
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330404,
					"content": "Nó có liên quan tới \"Tàng Phong\" không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210330405
					]
				},
				{
					"id": 210330405,
					"content": "Tôi phải xem xét kỹ mới biết được... Ừm, tôi quên nói là, tôi đã bắt đầu thu thập các mảnh vũ khí cách đây một thời gian rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330406
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330406,
					"content": "Tôi đã thu thập được rất nhiều mảnh vỡ từ thị trường, ngoài thành và của những nhà mạo hiểm... tôi nghĩ có lẽ sẽ tìm ra manh mối của Tàng Phong từ khía cạnh này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330407
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330407,
					"content": "Nhưng đến bây giờ thì tôi vẫn chưa tìm được bất kỳ tung tích gì cả...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330408
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330408,
					"content": "Không sao, Liyue chúng tôi có câu \"có công mài sắt, có ngày nên kim\". Tôi vẫn sẽ tiếp tục tìm... cho đến khi tìm được Tàng Phong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330409
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330409,
					"content": "À, đây là thù lao của bạn, vất vả cho bạn rồi, Nhà Lữ Hành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
