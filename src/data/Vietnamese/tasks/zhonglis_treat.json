			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhongli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10160101,
					"content": "Hửm, các bạn đến rồi ư. Không cần gọi món, tôi đã chuẩn bị xong hết rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160102
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10160102,
					"content": "Quán Ba Cốc Say Mèm hoàn toàn khác so với những quán rượu ở Mondstadt. Chủ nhân ở đây đều cho rằng, rượu làm từ hoa quả là món đồ uống không \"chính thống\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160103
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10160103,
					"content": "Cho nên lần này, cuối cùng cũng được mời một ly rượu chính thống?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10160104
					]
				},
				{
					"id": 10160104,
					"content": "#Lần này tôi đã gọi cho {F#cô}{M#cậu} một bát cơm rượu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160105
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10160105,
					"content": "Hả. Là món này sao, thật là không thể ngờ được...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10160106
					]
				},
				{
					"id": 10160106,
					"content": "...Nếu các vị khách quan muốn nghe, vậy tôi xin mạn phép kể tiếp câu chuyện về Ningguang đại nhân - [Quần Ngọc Các].",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160107
					],
					"speakerTitle": "Tian Miệng Sắt"
				},
				{
					"id": 10160107,
					"content": "Woa, ở đây có người kể chuyện sao! Thật là vui quá đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10160108,
					"content": "Gọi nơi đây nổi tiếng nhất là do có rượu ngon và không khí nhộn nhịp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160109
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10160109,
					"content": "Có điều bầu \"không khí\" này khác hẳn với bầu \"không khí\" tại các quán rượu lớn được miêu tả trong cuốn \"Hướng Dẫn Du Ngoạn Teyvat\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160110
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10160110,
					"content": "Như các vị đều biết, phía trên cảng biển của chúng ta có Tiên Phủ trên mây, Cung Điện trong màn sương.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160111
					],
					"speakerTitle": "Tian Miệng Sắt"
				},
				{
					"id": 10160111,
					"content": "Cái gì là thiên phú hơn người? Các ngài nhìn đi, đây chính là thiên phú hơn người, cũng chính là kiệt tác mà đại nhân Ningguang làm ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160112
					],
					"speakerTitle": "Tian Miệng Sắt"
				},
				{
					"id": 10160112,
					"content": "Trời thanh gió mát, từ hiên ngoài cung điện, ngài nhìn xuống thế giới bên dưới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160113
					],
					"speakerTitle": "Tian Miệng Sắt"
				},
				{
					"id": 10160113,
					"content": "Quả là tuyệt vời! Đây chính là vẻ đẹp rực rỡ của cảng Liyue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160201
					],
					"speakerTitle": "Tian Miệng Sắt"
				},
				{
					"id": 10160201,
					"content": "Các ngài ngẫm xem, từ trên cao nhìn xuống tuy nó chỉ như những mảnh giấy vụn, nhưng đó chính là các \"ý tưởng\" để đại nhân Ningguang đưa ra quyết sách, thật quý giá biết bao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160202
					],
					"speakerTitle": "Tian Miệng Sắt"
				},
				{
					"id": 10160202,
					"content": "Chỉ cần đánh cắp được một hai mảnh giấy, vậy thì có thể đọc lén thông tin trên đó của Ningguang đại nhân, các ngài đã vượt xa so với đồng nghiệp vài lần rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160203
					],
					"speakerTitle": "Tian Miệng Sắt"
				},
				{
					"id": 10160203,
					"content": "Thiên Quyền Ningguang... Thời gian gần đây cứ liên tục nghe thấy cái tên này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10160204,
					"content": "Người Liyue đang bàn về cô ấy, Fatui thù ghét cô ấy, dường như cô ấy là người che giấu Tiên Tổ Pháp Thoái, chúng ta từng thấy cô ấy trong Điển Lễ Thỉnh Tiên...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10160205,
					"content": "Không biết cô ta là người như thế nào nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10160207,
					"content": "Cuối cùng cũng tìm được bạn rồi, \"người trở về từ Tuyệt Vân Gián\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160208
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160208,
					"content": "Ai?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10160209,
					"content": "Paimon chúng ta đi thôi...!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10160210
					]
				},
				{
					"id": 10160210,
					"content": "Xin đợi một lát. Tôi không phải là Thiên Nham Quân, cũng không phải bổ khoái đến bắt các bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160211
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160211,
					"content": "Nhưng tôi quả thật là sứ giả của Thất Tinh Liyue. Xin tự giới thiệu, tôi tên Ganyu - thư ký tại Nguyệt Hải Đình, tôi hôm nay đến đây để gặp các bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160212,
						10160213
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160212,
					"content": "Sứ giả?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10160214
					]
				},
				{
					"id": 10160214,
					"content": "Nói một cách chính xác, chức vụ chính của tôi là thư ký cho toàn thể Thất Tinh, còn chức vụ tạm thời là sứ giả đặc biệt cho tiểu thư Ningguang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160215
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160215,
					"content": "Woa, vừa nhắc đến Ningguang thì sứ giả của Ningguang liền đến tìm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10160216,
					"content": "Có gì sơ xuất xin thứ lỗi cho tôi... \"Người trở về từ Tuyệt Vân Gián\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160217
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160217,
					"content": "Đây chính là bức thư do tiểu thư Ningguang lấy danh nghĩa \"Thiên Quyền\" viết, có thể coi như thư mời chính thức.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160218
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160218,
					"content": "Mời bạn đến [Cung Điện Trên Không].",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160219
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160219,
					"content": "Bạn nói... Thư mời sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10160220,
					"content": "Đúng vậy. Tiểu thư Ningguang nói như thế này:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160221
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160221,
					"content": "#\"Rất mong {M#anh ấy}{F#cô ấy} có thể đến.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160222
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160222,
					"content": "#\"Tôi rất muốn gặp {M#anh ấy}{F#cô ấy}\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160223
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160223,
					"content": "#\"Ở Quần Ngọc Các, tôi sẽ cùng {M#anh ấy}{F#cô ấy} cắt đứt từng mối tơ vò rắc rối\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160213,
					"content": "Thư ký?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10160214
					]
				}
			]
		},
		{
			"id": 101603,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
