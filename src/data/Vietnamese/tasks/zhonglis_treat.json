			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhongli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10160301,
					"content": "Ningguang.... Ganyu",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160302
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10160302,
					"content": "Mối tơ vò rắc rối trong những ngày gần đây, nơi họ đang ở bây giờ là tầng thứ mấy cơ chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				}
			]
		},
		{
			"id": 101610,
			"completionStepIds": [
				101610
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101610",
							"2"
						],
						"stepId": 101610,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhongli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10161001,
					"content": "Sứ giả tự xưng là Ganyu kia buông ra mấy câu này rồi biến mất...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10161002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10161002,
					"content": "Nhưng mà, chúng ta lại nhận được thư mời từ Thất Tinh của Liyue, đúng là không thể ngờ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10161003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10161003,
					"content": "#{NICKNAME}! Gặp người giàu có nhất định phải chú ý lễ nghĩa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10161004,
						10161005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10161004,
					"content": "Tôi lúc nào cũng lịch sự mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10161006
					]
				},
				{
					"id": 10161006,
					"content": "He he... người may mắn được mời đến Quần Ngọc Các làm khách quả thực rất ít.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10161007
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10161007,
					"content": "Các bạn đi đi, nhưng đừng quên việc của Điển Lễ Tiễn Tiên. Sau khi các bạn trở về từ Quần Ngọc Các, chúng ta sẽ gặp nhau ở Địch Hoa Châu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10161008
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10161008,
					"content": "Ừm, chúng tôi sẽ ghi nhớ. Hẹn gặp ở Địch Hoa Châu, không gặp không về!",
					"roleType": "TALK_ROLE_NPC",
