			},
			"dialogs": [
				{
					"id": 727380101,
					"content": "Ừm, đại khái thế này đi. Dọn dẹp một chút là được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380102
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380102,
					"content": "Ôi, trùng hợp ghê, cưng đến đúng lúc lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380103,
						727380104
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380103,
					"content": "Trùng hợp? Trùng hợp chỗ nào cơ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727380105
					]
				},
				{
					"id": 727380105,
					"content": "Nhìn cưng hẳn là đang nghĩ: \"Haiz, chắc chắn là cô ta lại sắp đẩy việc phiền phức gì đó cho mình rồi đây\". Đúng chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380106
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380106,
					"content": "Yên tâm đi, chỉ là tòa soạn vừa sửa chữa xong, nên đang chuẩn bị triển khai dịch vụ mới thôi mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380107
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380107,
					"content": "#Còn chưa kịp công bố ra ngoài là {F#cô}{M#cậu} đã đến rồi. Thế không phải trùng hợp sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380108
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380108,
					"content": "Này, nhìn thấy chiếc hộp bên cạnh tôi đây không? Sau này ở đây sẽ có thêm một nơi để cầu nguyện nữa đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380109
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380109,
					"content": "Chẳng phải đã có Thẻ Ngự Thần rồi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727380110
					]
				},
				{
					"id": 727380110,
					"content": "Khác nhau mà. Thẻ Ngự Thần là xem vận may, còn bên này... dùng để \"cầu nguyện\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380111
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380111,
					"content": "Chỉ cần nhắm mắt nghĩ về nguyện vọng của mình, rồi viết lên thẻ cầu nguyện và treo lên giá bên cạnh. Nói không chừng sẽ thành hiện thực đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380112
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380112,
					"content": "Nguyện vọng gì cũng được sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727380113
					]
				},
				{
					"id": 727380113,
					"content": "Đương nhiên rồi. Nhưng rốt cuộc có thể thực hiện được những gì thì chỉ có thể xem thần linh phù hộ chúng ta thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380114
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380114,
					"content": "Guuji vô dụng như tôi cùng lắm chỉ có thể giúp cưng chuyện nhân duyên thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380115,
						727380116
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380115,
					"content": "Có thể gặp gỡ bạn mới là chuyện tốt...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727380117
					]
				},
				{
					"id": 727380117,
					"content": "Nếu đây là tâm nguyện của cưng thì hãy thử xem. Nào, cầm lấy một ít giấy đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380118
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380118,
					"content": "Đây là chỗ còn lại khi tôi viết Thẻ Ngự Thần, tặng cho cưng đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380119
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380119,
					"content": "Ghi điều ước lên đó rồi cầu nguyện, có lẽ sẽ linh nghiệm hơn đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380120
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380120,
					"content": "Thật sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727380121
					]
				},
				{
					"id": 727380121,
					"content": "Ây dà, tôi lừa cưng bao giờ chưa? Mau đi cầu nguyện đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380122
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380122,
					"content": "Nhớ là, đầu tiên phải viết nguyện vọng lên giấy, sau đó dán lên thẻ, rồi cuối cùng là treo lên giá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380123
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380123,
					"content": "Thế là cầu nguyện xong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380124
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380124,
					"content": "Ừm, rất thành tâm đấy. Tốt lắm, tốt lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380125
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380125,
					"content": "Làm thế này có tác dụng thật không...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727380126
					]
				},
				{
					"id": 727380126,
					"content": "Được rồi, tiếp tục việc của cưng đi. Nhưng nhớ là phải vểnh tai lên và mở to mắt ra nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380127
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380127,
					"content": "Nói không chừng, người mà cưng muốn gặp lại đang ăn ramen ở quán ăn nào đó đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380116,
					"content": "Gặp lại bạn cũ cũng không tồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727380117
					]
				},
				{
					"id": 727380104,
					"content": "Đợi chút, lời mở đầu này...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727380105
					]
				}
			]
		}
	]
}