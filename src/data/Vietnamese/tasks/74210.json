			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fusilier",
					"Lemarcq",
					"Chaussivert",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741361401,
					"content": "Không có giá trị... Nghiên cứu của tôi không có giá trị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361402
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741361402,
					"content": "Cô đừng nghĩ như vậy, phát minh của cô đã cứu tôi một mạng đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361403
					],
					"speakerTitle": "Lemarcq"
				},
				{
					"id": 741361403,
					"content": "Nhưng... Nhưng tiền bối Edwin... Huhu... Edwin nói... thứ này không có giá trị! Huhu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361404
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741361404,
					"content": "Là tên Edwin không nhìn ra thôi. Đây rõ ràng là một báu vật mà! Tôi muốn trang bị cho anh em của tôi mỗi người một cái đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361405
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741361405,
					"content": "Edwin là người xấu, anh ta nói dối.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361406
					]
				},
				{
					"id": 741361406,
					"content": "Tiền bối Edwin không phải người xấu! Anh ấy... Anh ấy... Dù sao... Anh ấy cũng không nhớ tên tôi! Tôi cứ cho rằng anh ấy đã xem qua bản thiết kế rất nhiều lần rồi chứ, huhu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361407
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741361407,
					"content": "Fusilier, cô là một người rất giỏi, tại sao lại phải để Edwin đánh giá cô chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741361408,
					"content": "Anh ta thấy tệ, còn tôi thì thấy tốt!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361409
					]
				},
				{
					"id": 741361409,
					"content": "Thật... Thật không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361410
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741361410,
					"content": "Thật đấy, cô xem, chúng tôi đều cảm thấy như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361411
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741361411,
					"content": "Nhưng mà, mấy người lại không hiểu về việc nghiên cứu... HuHu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361412
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741361412,
					"content": "Fusilier... hoàn toàn lạc lối rồi. Thôi thì cứ để cô ấy yên tĩnh một lát đi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741361413,
					"content": "Được... Tôi và Lemarcq chờ ở bên kia. Có chuyện gì thì cứ gọi chúng tôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chaussivert"
				}
			]
		}
	]
}