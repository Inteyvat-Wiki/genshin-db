				"points": []
			},
			"dialogs": [
				{
					"id": 741361301,
					"content": "Phù... Không sao, không sao, ác mộng đã chấm dứt rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361302,
						741361305,
						741361309
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361302,
					"content": "Anh nghĩ gì về việc Edwin trở về?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361303
					]
				},
				{
					"id": 741361303,
					"content": "Ối! Hết hồn! Cảm nghĩ sao? Tôi không có, chỉ mong tên vô trách nhiệm đó sẽ phải trả giá đắt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361304
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361304,
					"content": "Nếu có thể, tôi muốn trói tay chân và bịt mắt anh ta lại, để anh ta không chạm vào Arkhium nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361305,
					"content": "Bây giờ yên tâm được chưa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361306
					]
				},
				{
					"id": 741361306,
					"content": "So với trước đây thì quả thật tôi yên tâm hơn một chút rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361307
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361307,
					"content": "Nhưng nói thật, giam Nacker và Edwin chung một chỗ sao? Tôi cũng không biết họ sẽ gây ra chuyện gì nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361308
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361308,
					"content": "Lần trước là nổ, lần sau là cái gì đây? Nhấn chìm toàn bộ Fontaine bằng Fonta ư? Tôi thật sự không dám nghĩ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361309,
					"content": "Chúc vui vẻ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361310
					]
				},
				{
					"id": 741361310,
					"content": "Cũng chúc Nhà Nghiên Cứu Danh Dự Cấp Cao một ngày tốt lành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Choiseul"
				}
			]
		},
		{
			"id": 7413614,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
