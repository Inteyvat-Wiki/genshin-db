			},
			"dialogs": [
				{
					"id": 741361201,
					"content": "Nhà Nghiên Cứu Danh Dự Cấp Cao có muốn hỏi điều gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361202,
						741361208,
						741361220
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361202,
					"content": "Về chuyện xử lý Nacker và Edwin...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361203
					]
				},
				{
					"id": 741361203,
					"content": "Tạm thời họ sẽ ở trong Pháo Đài Meropide để sám hối về tội lỗi của mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361204
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361204,
					"content": "Đương nhiên, với tính cách của Edwin thì khả năng cao là sẽ không làm được chuyện đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361205
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361205,
					"content": "Nhưng dù thế nào, chỉ cần khiến Edwin tránh xa thiết bị nghiên cứu và Arkhium là được rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361206
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361206,
					"content": "Còn về Nacker... Tôi nghĩ anh ta sẽ không gây thêm phiền phức cho chúng ta nữa đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361207
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361207,
					"content": "Tôi hy vọng sẽ không gặp phải chuyện bắt buộc cần đến họ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361208,
					"content": "Hồi trước Fusilier rất sùng bái Edwin à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361209
					]
				},
				{
					"id": 741361209,
					"content": "...Edwin Eastinghouse là một thiên tài. Những người làm cùng lĩnh vực với anh ta một là ruồng bỏ bản thân, hai là trở thành tín đồ của anh ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361210
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361210,
					"content": "Fusilier là một nhà nghiên cứu rất đam mê và sáng tạo, thường làm ra những sản phẩm tuyệt vời với chi phí thấp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361211
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361211,
					"content": "Sau khi gia nhập nhóm nghiên cứu thứ ba của dự án Arkhium, cô ấy chịu trách nhiệm thiết kế cấu trúc của ống giảm thanh, nên tiếp xúc rất nhiều với Edwin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361212
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361212,
					"content": "Có lẽ, lúc đó cô ấy đã trở thành tín đồ của Edwin rồi. Giống như những tín đồ khác, sự công nhận của Edwin là mục tiêu duy nhất của cô ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361213
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361213,
					"content": "Sau vụ nổ, cô ấy không muốn tin Edwin là thủ phạm, nên đã chủ động xin tham gia điều tra để chứng minh Edwin vô tội.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361214
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361214,
					"content": "Anh cảm thấy thế nào về Edwin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361215
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361215,
					"content": "Anh ta là một kẻ lập dị, không quan tâm đến bất cứ điều gì ngoài nghiên cứu! Chỉ biết trốn tránh trách nhiệm, thậm chí không nhớ nổi tên của Fusilier!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741361216,
					"content": "Đúng thế, anh ta chính là người như vậy. Ngoài việc nghiên cứu ra, gần như không có thứ gì và không có ai đáng để anh ta quan tâm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361217
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361217,
					"content": "Chỉ cần nghiên cứu được suôn sẻ, anh ta không quan tâm bất kỳ việc gì khác. Ngay cả khi có người trộm tài nguyên nghiên cứu để bán lại thì anh ta cũng chẳng hề quan tâm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361218
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361218,
					"content": "Sở dĩ tôi đồng ý để Fusilier điều tra... Là hy vọng cô ấy có thể sớm hiểu bản thân chỉ đang sùng bái thứ mà cô ấy tưởng tượng ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361219
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361219,
					"content": "Giờ đây, hy vọng cô ấy có thể thức tỉnh... Viện Khoa Học Fontaine không thể để mất thêm bất kỳ nhà nghiên cứu nào nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361220,
					"content": "Tạm biệt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361221
					]
				},
				{
					"id": 741361221,
					"content": "Tạm biệt, Nhà Nghiên Cứu Danh Dự Cấp Cao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Raimondo"
				}
			]
		},
		{
