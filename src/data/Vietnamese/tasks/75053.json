					"nextDialogs": [
						750530304
					]
				},
				{
					"id": 750530304,
					"content": "Cái này đã được lưu truyền từ rất lâu về trước...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530305
					],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530305,
					"content": "Tất cả vì đôi mắt tinh tường, chuyện này vô cùng quan trọng với Hội Hoa Vũ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530306
					],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530306,
					"content": "Đến đời này sẽ do tôi, phụ trách tổ chức.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530307,
					"content": "Sao anh lại nói chuyện chậm vậy...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750530308
					]
				},
				{
					"id": 750530308,
					"content": "Trước đây, tôi từng bị thương, do rơi... từ trên cao xuống...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530309
					],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530309,
					"content": "Vì cổ họng, và lồng ngực, nên tôi không thể... nói chuyện như lúc trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530310
					],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530310,
					"content": "Nhưng tôi thấy... bây giờ... cũng không tệ lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530311,
					"content": "Không có câu hỏi gì nữa.",
