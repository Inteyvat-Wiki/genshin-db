				"points": []
			},
			"dialogs": [
				{
					"id": 722740201,
					"content": "Không ngờ chúng ta lại gặp phải chuyện bại lộ kế hoạch, thật xui xẻo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740202
					],
					"speakerTitle": "Đội Tiên Phong Fatui"
				},
				{
					"id": 722740202,
					"content": "Đúng vậy, thầy giáo đột nhiên nhận được mệnh lệnh quay về Snezhnaya, nhưng kế hoạch trên Đảo Watatsumi vẫn phải tiến hành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740203
					],
					"speakerTitle": "Đội Tiên Phong Fatui"
				},
				{
					"id": 722740203,
					"content": "Thầy giáo có quá tự tung tự tác không? Nhiệm vụ này thầy không có báo cáo lại cho đại nhân \"Arlecchino\" đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740204
					],
					"speakerTitle": "Đội Tiên Phong Fatui"
				},
				{
					"id": 722740204,
					"content": "Thì đây đúng là chủ ý của thầy mà. Hừ, tôi có chút dự cảm không lành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740205
					],
					"speakerTitle": "Đội Tiên Phong Fatui"
				},
				{
					"id": 722740205,
					"content": "Ý là nếu như chúng ta thất bại thì thầy sẽ đổ hết trách nhiệm lên đầu chúng ta sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Đội Tiên Phong Fatui"
				}
			]
		}
	]
