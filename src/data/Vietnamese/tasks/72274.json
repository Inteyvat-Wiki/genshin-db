				"objectNames": [
					"Paimon",
					"Đội Tiên Phong Fatui",
					"Ronin Anbu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722740110,
					"content": "Nơi này quả nhiên không đơn giản...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722740111,
					"content": "Suỵt... bạn nghe kìa, hình như có tiếng ai đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740101
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722740101,
					"content": "Hừ, không ngờ mồm của con ả kia cứng thật, một câu cũng không nói!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740102
					],
					"speakerTitle": "Đội Tiên Phong Fatui"
				},
				{
					"id": 722740102,
					"content": "Đại nhân đừng lo lắng, tra khảo là nghề của chúng tôi! Đại nhân cứ nghỉ ngơi, để chúng tôi xuống đó bắt con ả đó khai hết mọi thứ ra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740103
					],
					"speakerTitle": "Ronin Anbu"
				},
				{
					"id": 722740103,
					"content": "Thời gian đã không còn nhiều nữa, thầy giáo muốn chúng ta mau chóng tra khảo xem con ả đó đã biết được bao nhiêu phần của kế hoạch. Nếu không xong thì chúng ta cũng sẽ khó sống đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740104
					],
					"speakerTitle": "Đội Tiên Phong Fatui"
				},
				{
					"id": 722740104,
					"content": "Ây da, vị đại nhân đó nóng nảy quá. Không biết con ả đó đã làm chuyện gì khiến cho vị đại nhân đó nổi giận như vậy nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740105
					],
					"speakerTitle": "Ronin Anbu"
				},
				{
					"id": 722740105,
					"content": "Trong kế hoạch gần đây của thầy giáo có một con cờ quan trọng tên là Lyudochka, nhưng không ngờ cô ta đã bị con ả Shuumatsuban đó hạ sát rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740106
					],
					"speakerTitle": "Đội Tiên Phong Fatui"
				},
				{
					"id": 722740106,
					"content": "May mà lúc chúng ta xông vào thì lửa vẫn chưa tắt. Không hổ danh là thầy giáo, vừa nhìn là nhận ra Lyudochka ngay, nhờ thế nên đoán trước được rủi ro trong kế hoạch lần này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740107
					],
					"speakerTitle": "Đội Tiên Phong Fatui"
				},
				{
					"id": 722740107,
					"content": "Vậy đúng là trong cái rủi có cái may.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740108
					],
					"speakerTitle": "Ronin Anbu"
				},
				{
					"id": 722740108,
					"content": "Nhưng ai mà biết được con ả đó đã biết được bao nhiêu phần trong kế hoạch chứ, cũng không biết là nó đã báo lại cho Shuumatsuban chưa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740109
					],
					"speakerTitle": "Đội Tiên Phong Fatui"
				},
				{
					"id": 722740109,
					"content": "Xem ra tiểu thư Momoyo bị nhốt ở nhà lao bên dưới, chúng ta mau đi cứu cô ấy đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
