			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cyno",
					"Bahari"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130100701,
					"content": "Woa! Bắt được thật rồi này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100702,
					"content": "Ngươi chính là tên xấu xa đứng phía sau giở trò đúng không? Mau nói hết những gì ngươi biết ra ngay!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100703,
						130100704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100703,
					"content": "Người này có biết gì không vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100705
					]
				},
				{
					"id": 130100705,
					"content": "Lúc hắn mới xuất hiện, tôi đã không ra tay trước mà ở bên cạnh quan sát một lúc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100706
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100706,
					"content": "Hắn không phải là kẻ đứng sau, nhưng hẳn là một doanh nhân không hề tầm thường. Ta nói đúng chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100707
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100707,
					"content": "Không hổ danh là Cyno, nhìn chỉ có chuẩn... Sớm biết anh chưa đi thì tôi đã không tham lam rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100708
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100708,
					"content": "Tham lam? Ý ngươi là sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100709,
					"content": "Biết các anh sắp đến, đám thương nhân bán Hũ Tri Thức ở khắp nơi lập tức tan đàn xẻ nghé, hàng hóa cũng không kịp mang đi hết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100710
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100710,
					"content": "Đây tạm thời là những thứ vô chủ, chỉ cần đoạt lấy trước khi bị người khác cầm đi là đã có thể kiếm được một khoản tiền lớn. Đương nhiên bây giờ nói những điều này cũng vô nghĩa rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100711
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100711,
					"content": "Ngươi hẳn là biết ai là người làm ra và bán Hũ Tri Thức nhỉ. Ngươi muốn bị đập hay muốn tự nói?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100712
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100712,
					"content": "Tôi sẽ tự nói. Nhưng mà trước đó, tôi hi vọng có thể chuyển sang nơi khác để nói chuyện...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100713
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100713,
					"content": "Nếu ở nơi này mà bị người khác bắt gặp tôi qua lại với anh thì cả tôi và người nhà đều sẽ gặp nguy hiểm mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100714
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100714,
					"content": "Ngươi muốn đi đâu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100715
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100715,
					"content": "Đến nhà tôi đi, ở Làng Aaru, nơi đó rất an toàn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100716
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100716,
					"content": "#Được thôi. {NICKNAME}, {F#cô}{M#cậu} vứt thiết bị định vị đi, chúng ta qua đó xem thử.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100704,
					"content": "Người này có đủ \"quan trọng\" không thế?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100705
					]
				}
			]
		},
		{
			"id": 1301008,
			"completionStepIds": [
				1301008
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1301008",
