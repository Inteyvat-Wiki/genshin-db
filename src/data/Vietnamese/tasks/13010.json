				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Simin",
					"Bahari",
					"Cyno"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130100801,
					"content": "Cha, cha trở về rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100802
					],
					"speakerTitle": "Simin"
				},
				{
					"id": 130100802,
					"content": "A, đây là khách phải không ạ? Xin chào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100803
					],
					"speakerTitle": "Simin"
				},
				{
					"id": 130100803,
					"content": "Đây là con gái của tôi, tên là Simin, con bé hơi sợ người lạ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100804
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100804,
					"content": "Ngoan nào, con đi chơi trước đi, cha có chuyện cần nói với khách.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100805
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100805,
					"content": "Dạ... được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100806
					],
					"speakerTitle": "Simin"
				},
				{
					"id": 130100806,
					"content": "Người trong ngành không ai là không biết tên của Cyno, còn hai vị đây tên gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100807
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100807,
					"content": "#Tôi là Paimon, còn đây là {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100808
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100808,
					"content": "Nói thật, tôi không ngờ người luôn hành động một mình như Cyno lại có đồng nghiệp đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100809
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100809,
					"content": "Có điều, kể cả khi bị bắt thì tôi vẫn muốn khuyên mọi người một câu... Dừng lại ở đây thôi, đừng điều tra nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100810
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100810,
					"content": "Tại sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100811
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100811,
					"content": "Sản xuất, tiêu thụ, chia lợi nhuận... Mỗi một công đoạn ít thì mấy chục người, nhiều cũng hơn trăm người, lợi nhuận khổng lồ sẽ khiến tất cả mọi người tập trung lại cùng một chỗ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100812
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100812,
					"content": "Để đảm bảo cho chuỗi tài sản không dễ dàng có được này, mỗi người đều phải dốc hết sức lực, cho dù phải liều tới mức vỡ đầu chảy máu đi nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100813
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100813,
					"content": "Hơn nữa, kể cả anh có thật sự làm được việc đó, cũng sẽ không ai cảm ơn anh. Có lẽ chính anh cũng sẽ cảm thấy buồn... Sao phải liều lĩnh như vậy chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100814
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100814,
					"content": "Mỗi người đều sẽ có lập trường của mình, không có gì để bàn cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100815
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100815,
					"content": "Haiz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100816
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100816,
					"content": "Cha... uống trà đi... còn của các vị khách nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100817
					],
					"speakerTitle": "Simin"
				},
				{
					"id": 130100817,
					"content": "Ồ, cha quên mất không rót trà cho khách. Cảm ơn con nha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100818
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100818,
					"content": "Không có gì... à ừm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100819
					],
					"speakerTitle": "Simin"
				},
				{
					"id": 130100819,
					"content": "Trà của nhà mình rất đắng. Cho nên con đã bỏ thêm kẹo mà cha đã cho con, chắc sẽ dễ uống hơn một chút...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100820
					],
					"speakerTitle": "Simin"
				},
				{
					"id": 130100820,
					"content": "Con ngoan lắm, còn kẹo không? Nếu hết rồi thì để lần sau cha mua cho con.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100821
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100821,
					"content": "Dạ... con đi nghỉ ngơi trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100822
					],
					"speakerTitle": "Simin"
				},
				{
					"id": 130100822,
					"content": "Không phải nói những người tham gia vào đó đều được hưởng lợi nhuận cao lắm sao? Sao tôi thấy anh không được như vậy chút nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100823
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100823,
					"content": "...Thật ra, đây cũng là chuyện tôi muốn nói với anh, là một yêu cầu của riêng bản thân tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100824
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100824,
					"content": "Con gái của tôi, khi sinh ra đã mắc phải một căn bệnh hiểm nghèo. Trái tim của nó yếu ớt hơn so với người thường, chỉ cần vận động mạnh chút thôi cũng có thể ngất xỉu, thậm chí tính mạng sẽ còn gặp nguy hiểm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100825
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100825,
					"content": "Chính vì vậy, từ nhỏ con bé đã không có bạn chơi cùng, cả ngày nhốt mình trong phòng. Ngày thường cũng phải uống rất nhiều thuốc, rất là tốn kém.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100826
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100826,
					"content": "Còn tôi vốn chỉ là một người làm ăn buôn bán nhỏ, thức khuya dậy sớm, chạy đông chạy tây, tiền kiếm được thì mãi không đủ, chỉ đành nhìn con bé yếu đi từng ngày.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100827
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100827,
					"content": "Mãi tới khi có người tìm tới tôi, chỉ cho tôi biết một con đường làm ăn kiếm tiền.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100828
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100828,
					"content": "Bán Hũ Tri Thức?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100829
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100829,
					"content": "Đúng vậy. Kiếm được tiền rồi thì sẽ có thể chữa bệnh cho con gái. Nhìn thấy nó khỏe lên từng ngày, trong lòng tôi vui mừng hơn ai hết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100830
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100830,
					"content": "Còn rất nhiều người giống tôi. Anh có thể nghĩ việc buôn lậu Hũ Tri Thức là việc không thể tha thứ được, nhưng đối với chúng tôi, đó chính là cách để cứu sống mạng người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100831
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100831,
					"content": "Tôi nói với anh những điều này là muốn khuyên anh một câu, dừng tay đi đại nhân Cyno, chừa cho chúng tôi một con đường sống với.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100832
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100832,
					"content": "Sao lại như vậy... tức là nếu chúng tôi cấm buôn lậu Hũ Tri Thức thì đứa bé sẽ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100833
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100833,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100834
					]
				},
				{
					"id": 130100834,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100835
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100835,
					"content": "Tôi cần phải biết sự thật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100836
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100836,
					"content": "Tôi có thể tìm người tới khám bệnh cho đứa bé đó, nhưng tôi không thể xem như không biết vụ buôn lậu Hũ Tri Thức được. Đó là hai chuyện khác nhau hoàn toàn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100837
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100837,
					"content": "Tôi biết anh sẽ nói như vậy mà, nhưng có câu nói này của anh là đủ rồi. Nếu anh đã khăng khăng muốn điều tra rõ chuyện này, vậy thì ra sau nhà tìm đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100838
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100838,
					"content": "Ở đó có số hàng tôi đã nhập vào trước đó không lâu. Sau khi xem xong thì anh sẽ rõ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100839
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100839,
					"content": "Đi cùng Cyno ra sau nhà.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130100840
					]
				},
				{
					"id": 130100840,
					"content": "Nhiều vậy sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100841
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100841,
					"content": "Rất nhiều chiếc hộp được xếp ngay ngắn chỉnh tề, đây mới chỉ là một trong số các hang ổ của những thương nhân này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100842
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100842,
					"content": "Từng này hàng không thể chỉ do một công xưởng nhỏ sản xuất ra được. Chẳng lẽ thật sự là Giáo Viện sao? Nhưng mà số lượng lớn hàng hóa tuồn ra như thế này, sao lại không có kiểm duyệt chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100843
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100843,
					"content": "Mau nhìn kìa, hình như những Hũ Tri Thức có gì đó khang khác, chẳng lẽ đây là Hũ Tri Thức ghi chép về Sảnh Đường Phiền Muộn sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100844
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100844,
					"content": "Có lẽ như đúng là vậy. Khoan đã, cái này là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100845,
						130100846
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100845,
					"content": "Ký hiệu này chưa từng thấy qua.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100847
					]
				},
				{
					"id": 130100847,
					"content": "Đây là con dấu thông quan của Matra. Có được ký hiệu này thì tức là hàng hóa bên trong đã được Matra kiểm duyệt xong rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100848
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100848,
					"content": "Lúc trông thấy máy định vị, tôi đã nghi ngờ có người của Giáo Viện tham gia vào chuyện này rồi, nhưng tôi không hiểu chuyển nhiều Hũ Tri Thức ra khỏi Giáo Viện như thế nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100849
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100849,
					"content": "Giờ thì tôi hiểu rồi, một khi có được con dấu này, hàng hóa được chuyển ra khỏi Giáo Viện sẽ không phải kiểm duyệt lần nữa, mà có thể thông qua luôn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100850
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100850,
					"content": "Hừ, thảo nào không muốn tôi tiếp tục điều tra. Chính Matra là người đã phá vỡ tác phong và kỷ luật, thật là khó tin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100851
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100851,
					"content": "Cũng có thể chỉ là hiểu lầm thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100852
					]
				},
				{
					"id": 130100852,
					"content": "#{NICKNAME}, có thể nhờ bạn một chuyện được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100853
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100853,
					"content": "Những chiếc Hũ Tri Thức này tới từ Giáo Viện, vậy thì rất có thể tri thức về Sảnh Đường Phiền Muộn trong những Hũ Tri Thức chính là tài liệu nghiên cứu bị niêm phong trong kho của Giáo Viện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100854
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100854,
					"content": "Chỉ cần vào phòng tài liệu điều tra ghi chép thì sẽ biết ngay là kẻ nào đang giở trò đằng sau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100855
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100855,
					"content": "Nhưng với thân phận hiện giờ của tôi, nếu tùy tiện ra vào trong Giáo Viện thì e là sẽ bứt dây động rừng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100856
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100856,
					"content": "#Có thể nhờ {F#cô}{M#cậu} điều tra chuyện này được không? Tôi sẽ nhắn tin cho Nabil, để anh ấy đưa {F#cô}{M#cậu} vào trong phòng tài liệu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100857
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100857,
					"content": "Cứ giao cho tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100858
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100858,
					"content": "Trong thời gian này tôi cũng sẽ không ngồi yên. Tuy manh mối đều chỉ vào bên trong Giáo Viện, nhưng rõ ràng người này cũng rất có thế lực ở bên ngoài.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100859
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100859,
					"content": "Từ chỗ Bahari có thể lấy được một vài tin tức về những thương nhân khác, tôi sẽ ở lại đây để chuẩn bị. Nếu các vị có phát hiện gì mới thì có thể quay về đây tìm tôi bất cứ lúc nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100846,
					"content": "Cyno có nhận ra không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100847
					]
				}
			]
		},
		{
			"id": 1301010,
			"completionStepIds": [
				1301010
			],
