			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cyno"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130100610,
					"content": "Có phát hiện gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100611
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100611,
					"content": "Hừm... Hình như chẳng có gì đặc biệt cả...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100612,
					"content": "Toàn là Hũ Tri Thức thông thường thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100613
					]
				},
				{
					"id": 130100613,
					"content": "Có lẽ số lượng Hũ Tri Thức ghi chép về Sảnh Đường Phiền Muộn không nhiều lắm, đã bị bọn họ đưa đi hết rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100614
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100614,
					"content": "#Không sao đâu, tôi vẫn còn một cách. {NICKNAME}, {F#cô}{M#cậu} quay về theo đường cũ nhé, còn tôi sẽ ẩn nấp ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100615
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100615,
					"content": "#Một lúc sau {F#cô}{M#cậu} hãy trở lại đây gặp tôi, hẳn là sẽ có thu hoạch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100616
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100616,
					"content": "Hèn gì anh bắt tôi đeo thiết bị định vị...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100617
					]
				},
				{
					"id": 130100617,
					"content": "Vì bọn chúng vội vã rời đi nên sẽ có rất nhiều hàng hóa không kịp mang theo, chắc chắn không thể bỏ mặc đồ đạc của mình như vậy được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100618
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100618,
					"content": "Sau khi xác nhận chúng ta đã \"rời đi\", hiển nhiên sẽ có người đến để thu dọn đồ. Vì vậy chúng ta phải giữ cho thiết bị định vị cách nơi này đủ xa, khiến chúng nhầm lẫn rằng chúng đã được an toàn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100619
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100619,
					"content": "Tôi hiểu rồi! Anh muốn chúng tôi làm mồi nhử để dụ bọn chúng xuất hiện đúng không!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100620,
					"content": "Được rồi, bây giờ chúng tôi sẽ xuất phát, ở đây giao cho anh đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100621
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100621,
					"content": "Yên tâm. Chỉ cần bọn chúng dám đến, tôi nhất định sẽ bắt chúng ở lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyno"
				}
			]
		},
