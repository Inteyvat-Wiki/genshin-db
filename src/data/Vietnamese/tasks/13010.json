			"dialogs": [
				{
					"id": 130100601,
					"content": "Kỳ lạ thật, đây có phải nơi đấu giá không thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100602,
					"content": "Không một bóng người.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100603
					]
				},
				{
					"id": 130100603,
					"content": "Phải đó! Không một bóng người, chẳng lẽ bọn chúng vào trong nghỉ ngơi hết rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100604,
					"content": "Đánh bại đám lính đánh thuê xong là chúng ta đã chạy nhanh đến đây. Sở dĩ vội vàng như vậy là vì lo lắng sẽ có người đi mật báo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100605
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100605,
					"content": "Vậy mà lúc chúng ta đến đã chẳng còn ai, có lẽ bởi vì những người ở đây đã quan sát hành động của chúng ta thông qua thiết bị định vị, nên đã sớm rời đi rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100606
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100606,
					"content": "Chúng ta phải làm sao bây giờ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100607,
					"content": "Lục soát thôi. Bọn chúng chưa kịp di dời toàn bộ Hũ Tri Thức đi đâu, có thể sẽ có manh mối ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100608
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100608,
					"content": "Vậy chúng ta hãy tìm thật kỹ xem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1301007,
			"completionStepIds": [
				1301011
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1301011",
