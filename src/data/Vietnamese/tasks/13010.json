					"Cyno"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130100201,
					"content": "Nóng quá... Ước gì có chỗ nào mát mẻ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100202,
					"content": "Nghỉ ngơi tí đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100203
					]
				},
				{
					"id": 130100203,
					"content": "Quãng đường còn rất xa, hãy kiên trì nhé. Hơn nữa nhìn khung cảnh xung quanh có thể thấy nơi này không thích hợp để nghỉ ngơi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100204
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100204,
					"content": "Haiz... Được rồi, nhưng mà Cyno không thấy nóng sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100205,
					"content": "Có chứ, nhưng mà tôi đã quen rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100206
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100206,
					"content": "Có bí quyết gì không? Tôi cảm thấy bản thân không chịu nổi nữa rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100207,
					"content": "Cố hết sức giữ tỉnh táo, sau đó dựa vào nghị lực để chịu đựng. Một khi các vị buông lỏng thì sẽ càng thêm mệt mỏi thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100208
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100208,
					"content": "Bước từng bước một, đừng để bộ não quyết định giới hạn của cơ thể, đến một nơi tương đối an toàn rồi hẵng thả lỏng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100209
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100209,
					"content": "Được. Nhưng mà nơi an toàn là nơi nào chứ? Tôi thấy nơi này an toàn rồi mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100210,
					"content": "Anh nhìn đi, đây chính là sa mạc mênh mông, xung quanh cũng không có quái vật gì... Ối! Đám Bò Cạp Độc này từ đâu chui ra thế!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100211,
					"content": "Cẩn thận, những con ma vật này không dễ đối phó đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyno"
				}
			]
		},
		{
			"id": 1301004,
			"completionStepIds": [
				1301004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1301004",
							"2"
						],
						"stepId": 1301004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cyno"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130100401,
					"content": "Hừ... Không ngờ chỗ này lại có Bò Cạp Độc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100402,
					"content": "Đây không phải là loại Bò Cạp Độc thông thường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100403
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100403,
					"content": "Bạn nhìn đi, trên càng của chúng có đánh số, có lẽ đây là bò cạp được nuôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100404
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100404,
					"content": "Ý anh là...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100405
					]
				},
				{
					"id": 130100405,
					"content": "Có ai đó không muốn chúng ta đến buổi đấu giá, vậy nên đã cử chúng đến bao vây chúng ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100406
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100406,
					"content": "Dù sao xung quanh đây, đâu đâu cũng toàn cát, kể cả khi chúng ta bị giết thì cũng sẽ không có ai biết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100407
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100407,
					"content": "Nguy hiểm quá! May mà chúng ta không lơ là cảnh giác!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100408,
					"content": "Nhưng mà có gì đó sai sai... Ở sa mạc này làm gì có con đường cụ thể nào chứ, sao bọn chúng biết mà tới đây được nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100409
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100409,
					"content": "#Đừng nhúc nhích, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100410
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100410,
					"content": "#Quả nhiên... bọn chúng đã gắn thứ này lên người {F#cô}{M#cậu}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100411
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100411,
					"content": "Đây là cái gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100412,
					"content": "Thiết bị định vị cỡ nhỏ mà Học Phái Kshahrewar chế tạo ra, có thể xác định đại khái vị trí của người đeo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100413
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100413,
					"content": "Tôi nhớ là thiết bị này không được cấp phép sản xuất hàng loạt mà nhỉ, vậy bọn chúng lấy từ đâu ra... Chẳng lẽ chuyện này có liên quan đến học giả của Học Phái Kshahrewar sao? Nhưng không đúng lắm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100414
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100414,
					"content": "#Không ngờ lại có thứ như thế này, tại sao nó lại ở trên người {NICKNAME} nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100415,
					"content": "Chắc là trong lúc chiến đấu với lính đánh thuê đã bị bọn chúng gắn lên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100416,
						130100417
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100416,
					"content": "Xin lỗi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100418
					]
				},
				{
					"id": 130100418,
					"content": "Tình hình lúc đó rất lộn xộn, không phát hiện ra cũng là chuyện bình thường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100419
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100419,
					"content": "May mà Cyno phát hiện ra, chúng ta mau vứt nó đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100420,
					"content": "#...Đừng, cứ để nó trên người {F#cô}{M#cậu} đi, sẽ có lúc cần dùng đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100421
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100421,
					"content": "Chúng ta đi tiếp đến buổi đấu giá thôi, trì hoãn ở đây quá lâu có lẽ sẽ gặp vài mối nguy khác đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100417,
					"content": "Không để ý luôn đấy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100418
					]
				}
			]
		},
		{
