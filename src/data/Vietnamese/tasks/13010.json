			},
			"dialogs": [
				{
					"id": 130101001,
					"content": "Phù... mệt thật đấy, đi xa như vậy, chắc là được rồi nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130101002,
						130101004
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130101002,
					"content": "Được rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130101003
					]
				},
				{
					"id": 130101003,
					"content": "Được! Vậy chúng ta ở đây nghỉ ngơi một lát, sau đó trở về tìm Cyno thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130101006
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130101006,
					"content": "Ngồi nghỉ ngơi một lúc.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130101007
					]
				},
				{
					"id": 130101007,
					"content": "Có lẽ cũng đến giờ rồi, chúng ta quay về khu đấu giá xem sao đi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130101008
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130101008,
					"content": "Không biết bên chỗ Cyno có thu hoạch được gì không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130101004,
					"content": "Đi thêm một đoạn nữa đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130101005
					]
				},
				{
					"id": 130101005,
					"content": "Vẫn phải đi nữa sao? Nhưng mà tôi cạn hết sức lực rồi... Hay là nghỉ ngơi ở đây một lúc đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130101006
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1301011,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
