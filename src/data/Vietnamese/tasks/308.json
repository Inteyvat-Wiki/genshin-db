			"dialogs": [
				{
					"id": 3081101,
					"content": "Í, đứa trẻ đáng yêu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081102
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081102,
					"content": "Chuyện nguy hiểm vậy mà cưng cũng đến giúp, thật là cảm động.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081103
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081103,
					"content": "Thời gian này nếu có gì không hiểu, đều có thể đến hỏi chị nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081104,
						3081108
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081104,
					"content": "Người quản lý thư viện chủ yếu phụ trách những gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3081105
					]
				},
				{
					"id": 3081105,
					"content": "Ừm, câu hỏi này rất hay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081106
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081106,
					"content": "Về căn bản, là những công việc không cần dùng đến tay chân hay bộ não.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081107
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081107,
					"content": "Vậy thì còn những việc gì!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3081111,
					"content": "Cho nên, mọi người cũng nên tin tưởng chị chút nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081108,
					"content": "Tại sao người quản lý thư viện lại đến di tích...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3081109
					]
				},
				{
					"id": 3081109,
					"content": "Ừm, câu hỏi này rất hay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081110
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081110,
