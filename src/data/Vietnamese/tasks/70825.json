					"nextDialogs": [
						708250403
					]
				},
				{
					"id": 708250403,
					"content": "Bảo vệ thành phố, giúp đỡ công việc tu sửa trong thành, còn cả một số việc lặt vặt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708250404
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 708250404,
					"content": "Hiện nay tổng bộ Đội Kỵ Sĩ ai nấy đều bận tối mắt tối mũi",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708250405
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 708250405,
					"content": "Kể ra thì, đứng gác ở cổng lại là công việc nhẹ nhàng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huffman"
				},
				{
					"id": 708250406,
					"content": "Có thể đi tìm Hiệp Hội Nhà Mạo Hiểm nhờ giúp đỡ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708250407
					]
				},
				{
					"id": 708250407,
					"content": "Họ đã giúp từ sớm rồi, lúc mới đầu không ngừng tìm kiếm người bị nạn trong thành, sau đó lại phụ trách giám sát ma vật bên ngoài.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708250408
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 708250408,
					"content": "Lúc ma vật tụ hợp ngoài thành, cũng là các Nhà Mạo Hiểm trong Hiệp Hội Nhà Mạo Hiểm không ngừng ra bên ngoài theo dõi động tĩnh ma vật, rồi lại quay về báo cáo, chúng tôi mới có thể vạch ra kế hoạch tác chiến cụ thể.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708250409
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 708250409,
					"content": "Hiện giờ họ cũng đang toàn lực trợ giúp các công việc trong thành, không có họ, chỉ e Đội Kỵ Sĩ Tây Phong một cây làm chẳng lên non.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708250410
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 708250410,
					"content": "Nói vậy, tôi phải tìm cơ hội cảm tạ Cyrus rồi...",
