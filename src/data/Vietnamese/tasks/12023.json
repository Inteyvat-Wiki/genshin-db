			"dialogs": [
				{
					"id": 120230301,
					"content": "Mạnh quá... không hổ danh là người được đại nhân Sangonomiya chọn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230302
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230302,
					"content": "Ý chí chiến đấu này... có thể đội trưởng sẽ thấu hiểu được chúng tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230303
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230303,
					"content": "Đội trưởng Đội Cá Kiếm 2... có thể trở thành đồng đội của chúng tôi được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230304
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230304,
					"content": "Nói tôi nghe xem đã xảy ra chuyện gì.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230305
					]
				},
				{
					"id": 120230305,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230306
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230306,
					"content": "Chuyện Hiệp Hội Tenryou cấu kết với Fatui, chúng tôi đã nói dối.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230307
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230307,
					"content": "Sao, sao lại như vậy! Chuyện mà Kokomi lo lắng nhất lại là chuyện đùa sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230308,
					"content": "Sao các người lại làm vậy? Việc này có nguy cơ xảy ra xung đột với Hiệp Hội Tenryou đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230309,
					"content": "Điều mà chúng tôi muốn chính là vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230310
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230310,
					"content": "Đàm phán hòa bình ư? Hừ, chỉ vì mọi người ai cũng nghĩ vậy nên Đảo Watatsumi mới không có tương lai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230311
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230311,
					"content": "Ai có thể đảm bảo được Hiệp Hội Tenryou sẽ không lật lọng chứ? Ai có thể đảm bảo Raiden Shogun sẽ không phát động Lệnh Truy Lùng Vision lần nữa chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230312
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230312,
					"content": "Quân kháng chiến chúng tôi, điều quan trọng nhất chính là ý chí chiến đấu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230313
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230313,
					"content": "Hiệp Hội Tenryou và Raiden Shogun đều không đáng tin, điều đáng tin nhất chỉ có bản thân chúng tôi mà thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230314
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230314,
					"content": "Đội trưởng thấy sao về nhận định này?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230315
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230315,
					"content": "Anh ấy nói cũng rất có lý, nhưng tôi thấy cứ lạ lạ thế nào ấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230316,
					"content": "Đó chỉ là suy diễn của các anh thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230317
					]
				},
				{
					"id": 120230317,
					"content": "Đúng vậy, nói cả buổi thì cũng chỉ là đoán thôi đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230318,
					"content": "Vì suy đoán này mà các anh dám tung tin đồn để phá hủy nền hòa bình mà mọi người dốc sức xây dựng sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230319,
					"content": "Đừng làm bộ mặt không liên quan để thuyết giáo tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230320
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230320,
					"content": "Để chiến thắng, chúng tôi đã quán triệt ý chí chiến đấu, nên giờ đây các người nói rằng những chuyện này đã không còn quan trọng nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230321
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230321,
					"content": "Muốn chúng tôi buông vũ khí để làm một người bình thường, làm sao có thể chứ? Khi tôi nhắm mắt lại, trong đầu luôn nghĩ về những đồng đội đã hy sinh trên chiến trường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230322
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230322,
					"content": "Mỗi khi họ xuất hiện trong đầu tôi, tôi đều tuyệt đối không tha thứ cho Hiệp Hội Tenryou, không thể tha thứ cho Lệnh Truy Lùng Vision!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230323
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230323,
					"content": "Xem ra chúng ta không phải người cùng chí hướng... Đội trưởng có thể báo cáo chuyện này cho đại nhân Sangonomiya. Nhưng hiện giờ đã không thể ngăn cản chúng tôi được nữa rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230324
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230324,
					"content": "Không kịp nữa? Nói như vậy là có ý gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230325,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230326
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230326,
					"content": "...Hắn có vẻ như không muốn trả lời.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230327,
					"content": "#Làm sao đây {NICKNAME}, sự việc cấp bách, chúng ta báo cáo chuyện này cho Kokomi nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1202304,
