			"dialogs": [
				{
					"id": 120230201,
					"content": "Úi... tên này nặng mùi rượu quá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230202,
					"content": "Ừm... hình như bạn là đội trưởng Đội Cá Kiếm 2! Đúng chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230203
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230203,
					"content": "Đội trưởng đã quay về Đảo Watatsumi rồi, tôi còn ngỡ rằng đội trưởng sẽ bỏ rơi chúng tôi chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230204
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230204,
					"content": "Sao chúng tôi lại bỏ đi được chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230205,
					"content": "Hứ, khó nói lắm. Hòa bình, ổn định... ai rồi cũng sẽ có kế hoạch riêng mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230206
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230206,
					"content": "Điều quan trọng nhất của quân kháng chiến là gì, đội trưởng còn nhớ không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230207
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230207,
					"content": "Chính là \"ý chí chiến đấu\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230208
					]
				},
				{
					"id": 120230208,
					"content": "Đúng rồi, vậy cho phép tôi kiểm tra thử xem đội trưởng có còn đủ tư cách để làm một chiến sĩ kháng chiến không nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230209
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230209,
					"content": "Dù đội trưởng muốn hỏi gì đi nữa thì cũng phải thắng tôi đã rồi tính.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230210
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230210,
					"content": "Haiz... cảm thấy giao tiếp với người này khó thật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230211,
					"content": "#Đánh hắn đi {NICKNAME}, bạn sợ hắn à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230212,
						120230213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230212,
					"content": "Chiến thôi, sao phải xoắn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230214
					]
				},
				{
					"id": 120230214,
					"content": "Hừ... thắng đã rồi nói!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230213,
					"content": "Để tôi bắt hắn phải khai hết ra!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230214
					]
				}
			]
		},
