					"nextDialogs": [
						120230503
					]
				},
				{
					"id": 120230503,
					"content": "Gần đây? Để tôi suy nghĩ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230504
					],
					"speakerTitle": "Hirai"
				},
				{
					"id": 120230504,
					"content": "Đối với chúng tôi mà nói, việc lớn gần đây đó là cuối cùng cũng đã có thể ra khơi đánh cá rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230505
					],
					"speakerTitle": "Hirai"
				},
				{
					"id": 120230505,
					"content": "Trước đó khi còn chiến tranh, trên biển có nhiều tàu chiến, chúng tôi chỉ có thể đánh bắt cá tôm nhỏ lân cận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230506
					],
					"speakerTitle": "Hirai"
				},
				{
					"id": 120230506,
					"content": "Đôi khi không đánh bắt được, cả nhà đều ăn không no. Trẻ nhỏ suốt ngày dỗi khóc, tôi lại chẳng có cách nào cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230507
					],
					"speakerTitle": "Hirai"
				},
				{
					"id": 120230507,
					"content": "Mỗi tối bụng đều đói, trằn trọc đêm khuya giấc chẳng lành. Bây giờ cuối cùng cũng đã đỡ hơn rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230508
					],
					"speakerTitle": "Hirai"
				},
				{
					"id": 120230508,
					"content": "Tôi đã được nghe nói, bạn là đội trưởng Đội Cá Kiếm 2, cảm ơn bạn đã đánh thắng trận này. Tặng bạn con cá này, vừa mới bắt được đó, mong bạn đừng chê.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230509
					],
					"speakerTitle": "Hirai"
				},
				{
					"id": 120230509,
					"content": "Thôi, vậy thì thật ngại quá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230510,
					"content": "Ha ha, cứ cầm lấy. Không có bạn, không chừng bây giờ chúng tôi vẫn phải chịu cảnh đói. Sangonomiya đại nhân đã dạy chúng tôi phải có lòng biết ơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230511
					],
					"speakerTitle": "Hirai"
				},
				{
					"id": 120230511,
					"content": "#Vậy cảm ơn nhé. {NICKNAME}, chúng ta đi hỏi người khác xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
