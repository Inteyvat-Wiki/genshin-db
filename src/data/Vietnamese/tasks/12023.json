					"Sangonomiya Kokomi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120230401,
					"content": "...Nói chung chính là vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230402,
					"content": "Chuyện Hiệp Hội Tenryou cấu kết với Fatui, thực ra là họ đã dựng chuyện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230403,
					"content": "Mục đích của họ là muốn ngăn cản cuộc đàm phán, muốn tiếp tục chiến tranh. Họ còn nói dù chúng ta nghĩ gì thì cũng đã không còn kịp nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230404,
					"content": "Ra là vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230405,
						120230406
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230405,
					"content": "Kokomi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230407
					]
				},
				{
					"id": 120230407,
					"content": "Không sao, đã để bạn lo lắng rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230408
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230408,
					"content": "Là lỗi của tôi. Nếu tôi sớm nhận ra được tâm trạng của họ, thì sẽ không xảy ra những việc như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230409
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230409,
					"content": "\"Không kịp nữa rồi\" mà Kouzen nói, có lẽ tôi đã biết là chỉ gì rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230410
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230410,
					"content": "Tuy ngày mai mới bắt đầu đàm phán, nhưng lính canh của đôi bên đã đến địa điểm đàm phán trước, phụ trách đảm bảo sự an toàn quanh đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230411
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230411,
					"content": "Tư tưởng hiếu chiến như Kouzen, rất có thể đã trà trộn vào đám lính canh, chuẩn bị gây hấn trong buổi đàm phán ngày mai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230412
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230412,
					"content": "Phải làm sao đây. Hay là bây giờ chúng ta đổi người canh gác nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230413,
					"content": "Không được. Chúng ta mà đổi người bây giờ, nhất định sẽ khiến các bên cảnh giác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230414
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230414,
					"content": "Các binh sĩ hiếu chiến rất có thể sẽ phát động kế hoạch sớm hơn, từ đó có thể sẽ gây ra chiến tranh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230415
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230415,
					"content": "Hơn nữa, chúng ta không biết có bao nhiêu binh lính Đảo Watatsumi tham gia trong đó, đột xuất đổi người, khó tránh sẽ xuất hiện tình trạng không ai có thể tin cậy được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230416
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230416,
					"content": "Nghe phức tạp thật... không lẽ không còn cách nào sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230417,
					"content": "Không cần lo lắng. Việc cũng đã xảy ra rồi, hãy để tôi suy nghĩ biện pháp đối phó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230418
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230418,
					"content": "Những binh sĩ đó tuy có lỗi, nhưng không phải đều tại bọn họ. Cho dù thế nào, tôi cũng sẽ nghĩ cách đảm bảo tính mạng cho tất cả...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230419
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230419,
					"content": "Ngày mai chúng ta tập hợp ở đây nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230406,
					"content": "Không sao chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230407
					]
				}
			]
		},
