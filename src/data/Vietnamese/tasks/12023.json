			"trigger": {
				"objectNames": [
					"Sangonomiya Kokomi",
					"Denjirou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120230101,
					"content": "Xem ra buổi tiệc ban thưởng đã chuẩn bị sắp xong rồi, nhưng trước khi khai tiệc thì tôi cần phải diễn thuyết một bài đã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230102
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230102,
					"content": "Ừm... năng lượng của Kokomi còn đủ dùng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230103,
					"content": "Yên tâm, vẫn còn đủ, có các bạn giúp đỡ nên năng lượng của tôi hồi phục nhanh lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230104
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230104,
					"content": "Tốt quá rồi, chúng tôi sẽ cổ vũ cho bạn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230105,
					"content": "Mọi người vất vả rồi, bữa tiệc hôm nay chính là để ban thưởng cho mọi người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230106
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230106,
					"content": "Trong thời gian qua, chúng ta đã kết thúc chiến tranh với Shogunate, cũng đã chứng kiến sự sụp đổ của Lệnh Truy Lùng Vision.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230107
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230107,
					"content": "Inazuma trong tương lai sẽ như thế nào, tôi cũng không thể nào dự đoán được. Nhưng ngày mai tôi sẽ tiến hành đàm phán với Hiệp Hội Tenryou về vấn đề hòa bình cho Đảo Watatsumi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230108
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230108,
					"content": "Cảm ơn sự nỗ lực của mọi người, cũng vì có mọi người góp sức nên chúng ta mới có thể thắng được chiến dịch này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230109
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230109,
					"content": "Bữa tiệc này tôi đã chuẩn bị cho mọi người, hy vọng mọi người có thể tận hưởng chiến thắng này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230110
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230110,
					"content": "Ô ôoooo!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230111
					],
					"speakerTitle": "Denjirou"
				},
				{
					"id": 120230111,
					"content": "Xem ra bữa tiệc này diễn ra rất thuận lợi, không xảy ra vấn đề gì thì tốt quá rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230112
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230112,
					"content": "#Con người khi vui mừng thì lòng tham cũng sẽ tăng cao. {NICKNAME}, tôi có thể nhờ bạn giúp tôi thu thập một số tình báo được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230113
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230113,
					"content": "Về chuyện Hiệp Hội Tenryou cấu kết với Fatui, đến giờ tôi vẫn chưa có manh mối gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230114
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230114,
					"content": "Tôi lo rằng sẽ có chuyện xảy ra trong buổi đàm phán ngày mai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230115
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230115,
					"content": "Được rồi, để chúng tôi đi thăm dò thử.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
