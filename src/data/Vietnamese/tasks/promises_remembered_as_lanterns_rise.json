				"points": []
			},
			"dialogs": [
				{
					"id": 718240101,
					"content": "Phải nhanh lên thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240102
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718240102,
					"content": "Công việc làm ăn tốt vậy sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718240103
					]
				},
				{
					"id": 718240103,
					"content": "Đâu có. Chẳng phải đang nghỉ lễ sao? Người ở nhà trọ đều về nghỉ lễ, thiếu người làm, mọi việc gần như tôi đều phải tự mình làm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240104
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718240104,
					"content": "May mà cũng không quá đông khách, một mình tôi vẫn lo được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240105
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718240105,
					"content": "Khụ, tôi phải cảm ơn bạn vì lần trước đã giúp tôi, nếu không nhờ bạn, có lẽ tôi không thể làm việc bình thường như bây giờ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240106,
						718240107
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718240106,
					"content": "Dạo gần đây bạn vẫn...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718240108
					]
				},
				{
					"id": 718240108,
					"content": "Không có! Tuyệt đối không có, tin tôi, tuyệt đối không có! Nếu thêm một lần nữa, tôi chắc chắn chịu không nổi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240109
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718240109,
					"content": "Nếu bạn thật sự muốn nghe ngóng chuyện đó, hãy đi hỏi ông chủ thử, tôi...tôi thật sự không biết...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718240107,
					"content": "Còn cô ấy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718240108
					]
				}
			]
		},
		{
			"id": 7182402,
			"completionStepIds": [
				7182402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
