					"nextDialogs": [
						718240302
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718240302,
					"content": "Chắc là... xem như tặng được rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718240303
					]
				},
				{
					"id": 718240303,
					"content": "Ừm, như vậy là tốt nhất, có lẽ cô bé cũng sẽ vui hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240304
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718240304,
					"content": "Không biết... cô bé ấy sẽ ước gì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
