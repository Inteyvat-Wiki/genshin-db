			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Verr Goldet"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718240201,
					"content": "Nhà Lữ Hành, có việc gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240202
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718240202,
					"content": "Về Bé Ming...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718240203
					]
				},
				{
					"id": 718240203,
					"content": "Bạn nói cô bé ấy à, kể từ sau sự việc vừa rồi, cô bé đã ổn định hơn rất nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240204
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718240204,
					"content": "Nhưng đứa bé đó cũng thật đáng thương, những ngày lễ trước đây, nhà trọ càng nhộn nhịp, cô bé lại càng lẻ loi nên thường xuyên gây sự, khiến khách khiếp sợ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240205
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718240205,
					"content": "Nhưng có lẽ nó chỉ muốn ai đó chơi với mình, dù sao thì nó cũng chỉ là một đứa trẻ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240206,
						718240207
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718240206,
					"content": "Có thể tặng một chiếc đèn tiêu cho cô bé không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718240208
					]
				},
				{
					"id": 718240208,
					"content": "Tặng đèn tiêu? Ừm... ý kiến hay đó, nhưng cô bé đó rất khó tìm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240209
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718240209,
					"content": "Nếu muốn tìm nó, hãy đến khu rừng gần đây vào ban đêm và treo đèn tiêu trên ngọn cây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240210
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718240210,
					"content": "Nếu vậy thì chắc cô ấy có thể nhìn thấy rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718240207,
					"content": "Không biết cô bé có thích đèn tiêu không...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718240208
					]
				}
			]
		},
