		},
		{
			"id": 7402903,
			"completionStepIds": [
				7402905
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7402905",
							"2"
						],
						"stepId": 7402905,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iara"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740290301,
					"content": "Iara cho Bạch Tuộc Bóng Tròn đang rất yếu vào chiếc thùng ở bên cạnh...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740290302
					]
				},
				{
					"id": 740290302,
					"content": "Kỹ thuật đánh bắt đẹp mắt... nhưng giờ nó trông không còn ổn nữa rồi. Sao lại thế này chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290303
					],
					"speakerTitle": "Iara"
				},
				{
					"id": 740290303,
					"content": "Xin lỗi... Không ngờ \"thứ đó\" mà Iara nói lại là Bạch Tuộc Bóng Tròn, nên chúng tôi đã...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290304,
						740290306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740290304,
					"content": "Là lỗi của tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740290305
					]
				},
				{
					"id": 740290305,
					"content": "#Đều tại {NICKNAME} nóng vội quá! Tuy là cũng do tôi không cản được bạn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740290308,
					"content": "#Giáo viên {NICKNAME} và Paimon không cần xin lỗi, giờ nó đã nằm yên trong thùng rồi. Vậy là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290309
					],
					"speakerTitle": "Iara"
				},
				{
					"id": 740290309,
					"content": "Được rồi... Nhưng tại sao ở đây lại có Bạch Tuộc Bóng Tròn chứ? Do xuôi theo dòng nước rồi vô tình đến chỗ này sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740290310,
					"content": "Là do tôi bắt về từ bên ngoài.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290311
					],
					"speakerTitle": "Iara"
				},
				{
					"id": 740290311,
					"content": "Hả?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740290312,
					"content": "Vì tôi muốn xác minh phương pháp sử dụng cần câu để câu cá... nên đã đi bắt \"thứ đó\". Chính là Bạch Tuộc Bóng Tròn mà hai vị nói đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290313
					],
					"speakerTitle": "Iara"
				},
				{
					"id": 740290313,
					"content": "Sau đó cho nó vào đây, vậy là có thể đến câu cá bất cứ lúc nào rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290314
					],
					"speakerTitle": "Iara"
				},
				{
					"id": 740290314,
					"content": "Ban đầu tôi nghĩ đó là một kế hoạch rất hay, nhưng mà đợi mãi cũng không thấy nó cắn câu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290315
					],
					"speakerTitle": "Iara"
				},
				{
					"id": 740290315,
					"content": "Tuy việc cố tình bắt Bạch Tuộc Bóng Tròn cho vào hồ nước này để luyện tập câu cá hơi không hợp lý...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740290316,
					"content": "...Nhưng khi nãy chúng ta chỉ rải một chút mồi bột là đã dụ nó lên mặt nước rồi. Iara đã nghĩ đến phương pháp này bao giờ chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740290317,
					"content": "Trước đó tôi từng thử rất nhiều loại mồi bột rồi. Ví dụ như thịt bằm, bạc hà, linh kiện các thứ... Nó ăn xong là không thấy tăm hơi đâu. Lúc đó tôi nghĩ chắc mồi bột không có tác dụng với nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290318
					],
					"speakerTitle": "Iara"
				},
				{
					"id": 740290318,
					"content": "Linh, linh kiện?! Nghe không giống mồi câu chút nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290319,
						740290321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740290319,
					"content": "Đừng có cho \"sản phẩm biển cả\" ăn mấy thứ kỳ quái vậy chứ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740290320
					]
				},
				{
					"id": 740290320,
					"content": "Đúng là! Mà \"sản phẩm biển cả\" là sao....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740290323,
					"content": "Ừm, linh kiện là thứ rất quan trọng. Nếu không phải là thứ mà Bạch Tuộc Bóng Tròn có thể ăn thì phải nghĩ cách lấy nó ra vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290324
					],
					"speakerTitle": "Iara"
				},
				{
					"id": 740290324,
					"content": "#Đúng rồi, để cảm ơn hai vị giáo viên {NICKNAME} và Paimon giúp đỡ, linh kiện này xin được tặng hai vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290325
					],
					"speakerTitle": "Iara"
				},
				{
					"id": 740290325,
					"content": "Không cần đâu, chúng tôi cũng chưa giúp được gì to tát...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740290326,
					"content": "Nhưng mà Delaroche từng nói, khi cần người khác giúp đỡ thì hãy gọi họ là giáo viên, và khi trả phí học tập thì họ sẽ rất vui. Lẽ nào không phải sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290327
					],
					"speakerTitle": "Iara"
				},
				{
					"id": 740290327,
					"content": "Linh kiện này xin được tặng hai vị, sẽ rất hữu ích trong Làng Merusea đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290328
					],
					"speakerTitle": "Iara"
				},
				{
					"id": 740290328,
					"content": "Iara đã nói vậy thì cảm ơn nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740290329,
					"content": "#Hy vọng sau này sẽ có cơ hội học hỏi thêm kỹ thuật câu cá đẹp mắt từ hai vị giáo viên {NICKNAME} và Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iara"
				},
				{
					"id": 740290321,
					"content": "Hóa ra Bạch Tuộc Bóng Tròn cũng ăn linh kiện...",
