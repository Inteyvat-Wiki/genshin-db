	"talks": [
		{
			"id": 7402901,
			"completionStepIds": [
				7402901
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7402901",
							"2"
						],
						"stepId": 7402901,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iara"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740290101,
					"content": "Tại sao lại đặt cần câu ở chỗ này vậy? Lẽ nào là đang câu cá sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740290102,
					"content": "Có nước, lại có cần câu, tất nhiên là đang câu cá rồi. Là người từ phương xa tới mà lại hiểu biết hạn hẹp thế, xã hội này sẽ đi về đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290103,
						740290105
					],
					"speakerTitle": "Iara"
				},
				{
					"id": 740290103,
					"content": "Cũng đâu có liên quan gì tới \"xã hội này sẽ đi về đâu\" chứ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740290104
					]
				},
				{
					"id": 740290104,
					"content": "Đúng đó! Hơn nữa chúng tôi cũng đâu phải không biết gì về câu cá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740290107,
					"content": "Ý tôi muốn nói là tôi tưởng Melusine sẽ không dùng cần câu để câu cá chứ. Mà sẽ là... à ừm, có hơi kỳ lạ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740290108,
					"content": "Kỳ lạ chỗ nào chứ? Tôi chỉ làm theo phương pháp mà người ngoài hướng dẫn thôi. Delaroche rất tốt bụng, không những hướng dẫn tôi câu cá, mà còn tặng tôi cần câu nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290109
					],
					"speakerTitle": "Iara"
				},
				{
					"id": 740290109,
					"content": "Tuy cần câu của cô ấy nhìn xịn hơn, nhưng cô ấy là dân chuyên nghiệp, còn tôi chỉ là nghiệp dư, thế nên có cái này là đủ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290110
					],
					"speakerTitle": "Iara"
				},
				{
					"id": 740290110,
					"content": "Nhưng mà đợi lâu vậy rồi sao vẫn chưa cắn câu nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290111
					],
					"speakerTitle": "Iara"
				},
				{
					"id": 740290111,
					"content": "#Hay là để giáo viên {NICKNAME} và giáo viên Paimon đây giúp cô phân tích nguyên nhân nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740290112,
					"content": "#Giáo viên {NICKNAME} và Paimon có lợi hại hơn cô ấy không? Cô ấy là một chuyên gia với chiếc cần câu rất đẹp đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290113
					],
					"speakerTitle": "Iara"
				},
				{
					"id": 740290113,
					"content": "Hừm, vậy thì nên dùng thực lực để chứng minh, đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740290114,
					"content": "Nhưng ở đây liệu có cá không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740290115
					]
				},
				{
					"id": 740290115,
					"content": "Đúng thật... Điều mà tôi thấy kỳ lạ từ đầu là đây! Nơi này có thấy bóng dáng con cá nào đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740290116,
					"content": "Delaroche từng nói, thứ ở dưới nước không nhất định là thủy sản. Ừm, \"thứ đó\" có được coi là cá không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290117
					],
					"speakerTitle": "Iara"
				},
				{
					"id": 740290117,
					"content": "...Lẽ nào vì \"thứ đó\" không phải là cá, mà tôi thì dùng phương pháp câu \"cá\", cho nên mới không thể câu được sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290118
					],
					"speakerTitle": "Iara"
				},
				{
					"id": 740290118,
					"content": "#Giáo viên {NICKNAME}... còn có giáo viên Paimon nữa! Hãy dạy tôi đi, nên làm thế nào mới có thể câu được \"thứ đó\" lên?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290119
					],
					"speakerTitle": "Iara"
				},
				{
					"id": 740290119,
					"content": "Iara thật lễ phép... Tất nhiên là được rồi. Có điều cô nói \"thứ đó\" là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740290120,
					"content": "Nó bơi ở dưới nước rất nhanh, hơn nữa còn trơn tuột rất khó bắt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290121,
						740290123
					],
					"speakerTitle": "Iara"
				},
				{
					"id": 740290121,
					"content": "Nghe có vẻ giống cá nhỉ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740290122
					]
				},
				{
					"id": 740290122,
					"content": "Cũng có thể là sinh vật nào đó khác thì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740290125,
					"content": "Ừm... Tóm lại, ít nhất có thể khẳng định là sinh vật gì đó sống dưới nước. Bây giờ không thấy rõ hình dáng, có thể là đang trốn dưới nước sâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740290126,
					"content": "Theo tôi thấy, lúc này nên dùng thức ăn để thu hút nó từ dưới nước sâu bơi lên...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740290127,
					"content": "Nhưng mà trước đó nó đã ăn rất nhiều rồi... không biết đổi sang mồi khác có tác dụng không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290128
					],
					"speakerTitle": "Iara"
				},
				{
					"id": 740290128,
					"content": "Ừm, trước mắt chúng ta cứ rải một chút mồi bột xuống nước. Sau đó chuẩn bị cần câu và đợi nó cắn câu thôi. Tuy là vẫn chưa biết nó là thứ gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740290129,
					"content": "#Để tôi thử xem. Chuyện rải mồi giao cho giáo viên {NICKNAME} và Paimon nhé. Còn tôi sẽ chuẩn bị cần câu cho thật tốt, mặc dù đây không phải cần xịn của dân chuyên nghiệp...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290130
					],
					"speakerTitle": "Iara"
				},
				{
					"id": 740290130,
					"content": "Không thành vấn đề, rải mồi chỉ là chuyện nhỏ, cứ để chúng tôi lo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740290123,
					"content": "Nghe có vẻ giống Melusine nhỉ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740290124
					]
				},
				{
					"id": 740290124,
					"content": "Là Iara đang cùng với Melusine khác đang chơi trò câu cá sao...? Nghe không đúng chút nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740290105,
					"content": "Paimon thì dĩ nhiên biết thế nào là câu cá mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740290106
					]
				},
				{
					"id": 740290106,
					"content": "#Đúng thế, dẫu sao tôi cũng bị {NICKNAME} câu lên mà... Ấy không đúng, vấn đề không nằm ở đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290107
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
