			"dialogs": [
				{
					"id": 100050201,
					"content": "Albedo, quả nhiên anh ở đây. Hmm... đang vẽ đấy à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100050202,
					"content": "Ừm, gần đây tôi bận quá nên không có thời gian vẽ. Vừa hay dạo này rảnh rỗi, nên muốn cầm bút lên luyện tập một chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050203
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 100050203,
					"content": "Quả thật lúc trước đã trải qua nhiều chuyện.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100050204
					]
				},
				{
					"id": 100050204,
					"content": "Đúng vậy. May là có hai vị và mọi người trong Đội Kỵ Sĩ giúp đỡ, nên chuyện đó cũng đã được giải quyết êm đẹp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050205
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 100050205,
					"content": "Hơn nữa, tôi cũng đã hoàn thành bài tập cuối cùng mà sư phụ để lại cho mình rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050206
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 100050206,
					"content": "Nếu xét về kết quả, thì phải nói là không thể hoàn hảo hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050207
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 100050207,
					"content": "Sucrose dạo này học tập rất nhanh, đã có thể tự xử lý nhiều công việc liên quan đến giả kim thuật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050208
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 100050208,
					"content": "Đội Kỵ Sĩ hiện tại cũng không có việc gì cần tôi phải ra mặt giải quyết...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050209
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 100050209,
					"content": "Không có bài tập, không có công việc, không có phiền phức...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050210,
						100050211
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 100050210,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100050212
					]
				},
				{
					"id": 100050212,
					"content": "Không có gì. Tôi nghĩ, có lẽ mình đã quen với việc phải động não nhiều mỗi ngày...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050213
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 100050213,
					"content": "Thú thật, hoàn toàn rảnh rỗi như vậy, tôi thấy hơi không quen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050214
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 100050214,
					"content": "Tôi cứ vô thức suy nghĩ, không biết còn vấn đề gì đang chờ mình giải quyết không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050215
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 100050215,
					"content": "Nhưng thật đáng tiếc, ở Thành Mondstadt hiện tại, dường như mọi vấn đề đều đã có lời giải hoàn hảo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050216
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 100050216,
					"content": "Nghỉ ngơi một chút có gì không tốt đâu. Nếu ngày nào cũng bận rộn thì chẳng phải cơ thể mệt mỏi lắm sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100050217,
					"content": "Nếu không ổn thì đi chơi với chúng tôi đi, tôi rất rành về cách để lười biếng đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100050218,
					"content": "Haha, vậy thì phải phiền Paimon chỉ dạy rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050219,
						100050220
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 100050219,
					"content": "Nếu anh thật sự muốn tìm chút phiền phức để giải quyết...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100050221
					]
				},
				{
					"id": 100050221,
					"content": "Xùy xùy, không được nói! Mỗi lần nói mấy lời kiểu này là rắc rối sẽ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100050220,
					"content": "Cũng dễ thôi, chỉ cần tôi còn ở đây...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100050221
					]
				},
				{
					"id": 100050211,
					"content": "Lại gặp rắc rối mới à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100050212
					]
				}
			]
		},
