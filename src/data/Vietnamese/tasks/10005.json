			"dialogs": [
				{
					"id": 100051401,
					"content": "Albedo, hiếm khi thấy anh rảnh rỗi như vậy đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051402
					],
					"speakerTitle": "Sebas"
				},
				{
					"id": 100051402,
					"content": "Tuy nhiên, đã hoàn thành \"bài tập\" mà chủ nhân Rhinedottir để lại rồi, anh cũng nên thư giãn một chút đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051403
					],
					"speakerTitle": "Sebas"
				},
				{
					"id": 100051403,
					"content": "Woa! Se-Sebas, từ đâu chui ra vậy? Không một tiếng động nào luôn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100051404,
					"content": "Lại gặp nhau rồi, Sebas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100051405
					]
				},
				{
					"id": 100051405,
					"content": "#Có vẻ {F#cô}{M#cậu} đã gặp Sebas trước đó rồi nhỉ? Không biết nó có kể cho {F#cô}{M#cậu} nghe về mối quan hệ giữa hai chúng tôi không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051406
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 100051406,
					"content": "Nó bảo mình là... \"trưởng bối\" của anh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100051407
					]
				},
				{
					"id": 100051407,
					"content": "...Miễn cưỡng có thể coi là vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051408
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 100051408,
					"content": "Không hổ danh là gia đình anh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100051409
					]
				},
				{
					"id": 100051409,
					"content": "Miễn cưỡng? Giọng điệu kiểu gì vậy, căn nhà to đùng thế này mà chỉ mỗi mình tôi là quản gia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051410
					],
					"speakerTitle": "Sebas"
				},
				{
					"id": 100051410,
					"content": "Tất cả những chai lọ mà anh và chủ nhân Rhinedottir dùng xong đều do một mình tôi, một con mèo đích thân dọn dẹp đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051411
					],
					"speakerTitle": "Sebas"
				},
				{
					"id": 100051411,
					"content": "Anh... không phải là một con mèo sao? Sao một con mèo có thể làm quản gia được chứ, lại còn dọn dẹp chai lọ nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100051412,
					"content": "Vậy sao cô bay được vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051413
					],
					"speakerTitle": "Sebas"
				},
				{
					"id": 100051413,
					"content": "Hả? Tôi vẫn luôn biết bay mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100051414,
					"content": "Thì tôi cũng luôn làm được mà? Đừng biến sự thật thành câu hỏi, mấy câu hỏi kiểu này không tìm được câu trả lời đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051415
					],
					"speakerTitle": "Sebas"
				},
				{
					"id": 100051415,
					"content": "Anh, anh... tức quá! Tôi sẽ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051416,
						100051417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100051416,
					"content": "Chủ nhân của nó là Rhinedottir...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100051418
					]
				},
				{
					"id": 100051418,
					"content": "Tôi... tôi không muốn nghe nó nói nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100051419,
					"content": "Thôi, dừng nói chuyện phiếm. Albedo, lần này tôi đến đây theo lệnh của chủ nhân Rhinedottir, để chuyển lời nhắn đến anh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051420
					],
					"speakerTitle": "Sebas"
				},
				{
					"id": 100051420,
					"content": "E hèm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051421
					],
					"speakerTitle": "Sebas"
				},
				{
					"id": 100051421,
					"content": "\"Albedo thân mến, ta rất vui khi con đã tìm ra 'câu trả lời mà bản thân chấp nhận' cho bài tập đó.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051422
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100051422,
					"content": "\"Tuy nhiên, khi một vấn đề đã có lời giải, thì cũng đồng nghĩa với việc nó không còn ý nghĩa để suy nghĩ nữa.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051423
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100051423,
					"content": "\"Quả lắc không chịu nằm yên trong đầu con chắc đang nghiêng dần về phía 'nhàm chán' rồi nhỉ?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051424
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100051424,
					"content": "\"Vậy thì, sao không thử tự đặt câu hỏi cho chính mình đi?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051425
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100051425,
					"content": "\"Hãy gạt bỏ 'đáp án đã biết', và tìm kiếm 'câu hỏi chưa biết'.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051426
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100051426,
					"content": "\"Câu hỏi luôn thú vị hơn câu trả lời, và cũng giết thời gian tốt hơn.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051427
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100051427,
					"content": "\"Ta rất mong chờ, lần tới gặp mặt, con sẽ mang đến cho ta những câu hỏi như thế nào đây.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051428
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100051428,
					"content": "\"Nếu con có thể tìm ra một vấn đề mà ngay cả ta cũng chưa từng nghĩ tới, vậy thì càng tốt.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051429
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100051429,
					"content": "\"Mặc dù khả năng đó không cao lắm, nhưng hãy cứ cố gắng đi đã. Nếu đủ may mắn, biết đâu sẽ thực sự khiến ta bất ngờ đấy.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051430
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100051430,
					"content": "\"À phải rồi, đừng có nghĩ đến việc tạo ra một 'bản thân' chỉ dùng để suy nghĩ hay trả lời câu hỏi. Sư phụ đây đã thử rồi, hoàn toàn vô dụng thôi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051431
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100051431,
					"content": "\"Một điều cuối cùng. Ta đã nhờ Sebas mang cho con một món quà, hãy cất giữ cẩn thận. À, đừng cho nó ăn gì cả nhé, nó không biết đói là gì đâu.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051432
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100051432,
					"content": "Con sẽ làm theo lời sư phụ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051433
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 100051433,
					"content": "Khụ, khụ khụ, chủ nhân Rhinedottir chỉ nói có thế thôi... Mệt thật đấy, khụ khụ... khụ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051434
					],
					"speakerTitle": "Sebas"
				},
				{
					"id": 100051434,
					"content": "Tóm lại, tôi đã chuyển lời xong rồi. Sao anh cứ nhất định phải ở lại nơi này thế? Cứ như người đó, về Thành Mondstadt ở không tốt hơn sao...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051435,
						100051436
					],
					"speakerTitle": "Sebas"
				},
				{
					"id": 100051435,
					"content": "(\"Người đó\" ở Thành Mondstadt...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100051437
					]
				},
				{
					"id": 100051437,
					"content": "Thôi được rồi, tôi đi đây. Chỗ này lạnh quá, đuôi tôi đau buốt cả rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051438
					],
					"speakerTitle": "Sebas"
				},
				{
					"id": 100051438,
					"content": "Món quà chủ nhân Rhinedottir dành cho anh tôi đã đặt trên bàn, nhớ giữ cho cẩn thận nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051439
					],
					"speakerTitle": "Sebas"
				},
				{
					"id": 100051439,
					"content": "Albedo... Mối quan hệ gia đình của anh có vẻ ngày càng phức tạp nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051440
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100051440,
					"content": "Giờ lại đột nhiên xuất hiện một con mèo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100051441
					]
				},
				{
					"id": 100051441,
					"content": "Nhưng kể ra thì, con mèo này có thực sự được xem là \"thành viên gia đình\" anh không? Mặc dù nó tự xưng là quản gia gì đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051442
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100051442,
					"content": "Sebas quả thật đã được sư phụ tạo ra từ rất sớm. Nếu theo lý thuyết của người thường thì Sebas nói không sai, nó có thể được xem là bậc trưởng bối của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051443
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 100051443,
					"content": "Tuy nhiên, vì chúng tôi không phải một \"gia đình\" thông thường, nên mối quan hệ đó cũng chẳng có ý nghĩa gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051444
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 100051444,
					"content": "Nhưng lúc đó tôi thực sự được Sebas chăm sóc rất nhiều, ngoài việc giúp tôi dọn dẹp chai lọ, đôi khi nó còn làm người mẫu cho tôi phác họa nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051445
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 100051445,
					"content": "Khoan đã, con mèo mà anh vẽ hôm nay chính là Sebas à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051446
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100051446,
					"content": "Đúng vậy, đây là thói quen của tôi. Khi suy nghĩ về một vấn đề nào đó, tôi thường để tay mình hoạt động trong vô thức, từ đó giúp tôi suy nghĩ tốt hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051447
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 100051447,
					"content": "Vào những lúc như thế, tôi thường chọn vẽ chân dung Sebas... Dù sao thì cũng vẽ không biết bao nhiêu lần rồi, nên giờ đã quá thành thạo, gần như không cần phải động não.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051448,
						100051449
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 100051448,
					"content": "Nói như vậy thì...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100051450
					]
				},
				{
					"id": 100051450,
					"content": "Tôi cứ tưởng đó chỉ là một con mèo bình thường chứ?! Không ngờ lại có lai lịch lớn đến thế...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051451
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100051451,
					"content": "#Bây giờ {F#cô}{M#cậu} đã biết tên thật của con mèo này rồi. Nếu có dịp, tôi sẽ kể cho hai người nghe thêm nhiều câu chuyện về nó và tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051452
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 100051452,
					"content": "Nhưng hiện tại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051453
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 100051453,
					"content": "\"Cây sẽ tự hào về trái mọng hoàn hảo nhất, nó hoàn mỹ không tì vết đến thế.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051454
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100051454,
					"content": "\"Nhưng hỡi hạt giống chứa đựng giấc mơ, đừng chỉ làm vị vua của vũ trụ trong lớp vỏ.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051455
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100051455,
					"content": "...Tôi cần phải suy nghĩ thêm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
				{
					"id": 100051449,
					"content": "Giờ mới nhớ là trước đây từng thấy Albedo vẽ mèo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100051450
					]
				},
				{
					"id": 100051436,
					"content": "(Chắc là nói đến Durin...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100051437
					]
				},
				{
					"id": 100051417,
					"content": "Paimon, hay là thôi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100051418
					]
				}
			]
		}
	]
