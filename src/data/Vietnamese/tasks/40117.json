				"points": []
			},
			"dialogs": [
				{
					"id": 401171401,
					"content": "Tôi nghe Klee nói khu vực phía bên họ có rất nhiều đường ray, còn có \"xe bay\" rất thú vị nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171402
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 401171402,
					"content": "À, là xe bay với tốc độ \"không kiểm soát\" trên đường ray \"đầy kịch tính\" sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171403
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401171403,
					"content": "Phải, chính là cái đó, nghe nói có khi đầu xe sẽ lao thẳng xuống, cơ thể sẽ lơ lửng như mất trọng lực vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171404
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 401171404,
					"content": "Vậy sao? Sao tôi lại nghe nói trong lúc xe chạy thì túi của Klee suýt chút bị văng khỏi xe, nếu không phải Kaeya nhanh tay thì bom nảy đã bay đầy trời rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171405
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401171405,
					"content": "Hả?! Nếu là vậy, hình như... cũng nguy hiểm thật...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171406
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 401171406,
					"content": "Haiz... Nếu cô muốn chơi thì đợi khi rảnh rỗi tôi sẽ đi cùng cô.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171407
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401171407,
					"content": "Hả? Eula, sao đột nhiên lại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171408
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 401171408,
					"content": "Cũng dễ đoán được trong lòng cô đang nghĩ gì mà... nhưng nói trước nhé, tôi sẽ không nhặt đồ giúp cô đâu. Nhớ giữ lấy đồ đạc trong người đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171409
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401171409,
					"content": "Ừm, ừm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Collei"
				}
			]
		},
