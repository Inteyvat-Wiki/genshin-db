			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Klee",
					"Kaeya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401171301,
					"content": "...Phải rồi, trước đó anh Kaeya đã hứa với Klee là sẽ kể hết câu chuyện Trấn Linh Trong Bình cho Klee nghe đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171302
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401171302,
					"content": "Được thôi, ừm... lần trước kể đến đâu rồi nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171303
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401171303,
					"content": "Klee nhớ là kể đến Trấn Linh từ trong Bình Ma đi ra, muốn nuốt sống cậu bé chăn cừu vừa mở nắp chiếc bình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171304
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401171304,
					"content": "Đúng đúng, khi Trấn Linh xấu đang muốn nuốt sống thì cậu bé chăn cừu đột nhiên nảy ra ý tưởng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171305
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401171305,
					"content": "Là ném bom vào miệng Trấn Linh sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171306
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401171306,
					"content": "Haha, nếu lúc đó bên cạnh cậu bé chăn cừu có bom thì chắc cũng sẽ làm như vậy đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171307
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401171307,
					"content": "Nhưng mà cậu bé chăn cừu chưa bao giờ nhìn thấy một thứ như bom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171314
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401171314,
					"content": "Cậu bé nói với Trấn Linh rằng: \"Đợi đã, thân hình lớn như vậy, thật sự có thể chui ra từ trong chiếc bình đó sao? Trừ khi tôi tận mắt chứng kiến, nếu không tôi sẽ không tin đâu!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171308
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401171308,
					"content": "Trấn Linh rất tức giận và nói: \"Hừ, cậu bé chăn cừu đáng ghét, sao ngươi dám xem thường ta chứ.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171309
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401171309,
					"content": "Trấn Linh vừa nói xong thì chui vào trong chiếc bình, cậu bé chăn cừu liền nhanh tay đóng kín chiếc bình lại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171310
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401171310,
					"content": "May quá, vậy là Trấn Linh xấu xa sẽ không thể thoát ra nữa rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171311
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401171311,
					"content": "Nhưng mà... bị nhốt trong một nơi nhỏ như vậy, Trấn Linh có ngủ ngon được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171312
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401171312,
					"content": "Nhưng đó là bởi vì nó đã làm việc xấu, bị bắt được nên mới bị nhốt vào trong đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171313
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401171313,
					"content": "Cho nên nếu đã làm chuyện xấu và không muốn bị nhốt, vậy thì đừng để bị bắt nhé Klee...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171314
					],
					"speakerTitle": "Kaeya"
				}
			]
		},
		{
			"id": 4011714,
