						732670802
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732670802,
					"content": "Có thể chạy nhanh như vậy sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670803
					],
					"speakerTitle": "Karima"
				},
				{
					"id": 732670803,
					"content": "Rất tốt! Tốc độ rất khá, chạy cũng rất vững.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670804
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670804,
					"content": "Ayten, Karima, hai cháu phải nhớ cho kỹ đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670805
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670805,
					"content": "Lúc gặp nguy hiểm không nên cố quá, lúc cần rút lui thì phải quyết đoán rút lui mới được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670806
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670806,
					"content": "Ayten, đặc biệt là cháu đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670807
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670807,
					"content": "Cháu biết rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670808
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732670808,
					"content": "Không tệ, vậy bước tiếp theo... chúng ta sẽ ra bên ngoài làng để hai đứa đích thân học hỏi cách \"chiến đấu\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670809
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670809,
					"content": "Tốt quá! Cha mới làm cho một thanh kiếm gỗ, có cơ hội để dùng rồi. Karima, bạn thì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670810
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732670810,
					"content": "Tôi có một chiếc cung nhỏ, mặc dù... mẹ chỉ cho tôi một mũi tên không có đầu nhọn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670811
					],
					"speakerTitle": "Karima"
				},
				{
					"id": 732670811,
					"content": "Hahaha! Không sao, hai đứa vừa có kiếm vừa có cung, hơn nữa còn vô cùng dũng cảm, như vậy là đủ để bắt đầu hành trình thám hiểm của cả hai rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670812
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670812,
					"content": "Nhưng mà, sau khi ra ngoài làng thì nhớ không được đi lung tung, phải luôn đi theo chú và Nhà Lữ Hành đấy nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670813,
						732670814
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670813,
					"content": "Anh thật sự muốn dẫn hai đứa ra ngoài sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670815
					]
				},
				{
					"id": 732670815,
					"content": "...Yên tâm đi, tôi đã đi qua nơi đó rồi, chỉ có mấy con bò cạp ốm yếu, sẽ không có vấn đề gì đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670816
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670816,
					"content": "Hơn nữa, không phải còn có hai chúng ta sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670817,
						732670818
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670817,
					"content": "Anh còn tính cả tôi nữa sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670819
					]
				},
				{
					"id": 732670819,
					"content": "...Nhà Lữ Hành, đã giúp thì nên giúp cho trót. Tôi cũng sẽ dựa theo quy tắc để trả thù lao cho bạn mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670820
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670820,
					"content": "Vậy hai đứa chuẩn bị xong chưa, chúng ta xuất phát thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670821
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670821,
					"content": "Được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670822
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732670822,
					"content": "Ừm... có chút căng thẳng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Karima"
				},
				{
					"id": 732670818,
					"content": "Tôi đã đồng ý điều gì với anh sao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670819
					]
				},
				{
					"id": 732670814,
					"content": "Dẫn theo hai đứa trẻ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670815
					]
				}
			]
		},
