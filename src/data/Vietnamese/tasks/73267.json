			},
			"dialogs": [
				{
					"id": 732670501,
					"content": "Atiyah, sao anh lại đến đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670502
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 732670502,
					"content": "Hihi, ý chí kiên cường là phẩm chất của Eremite chúng ta mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670503
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670503,
					"content": "Vậy anh cũng nên biết, kiên trì với nguyên tắc cũng là cách làm việc của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670504
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 732670504,
					"content": "Đại ca Fodil à...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670505
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670505,
					"content": "Tôi đã rời Eremite rồi, anh không cần xưng hô như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670506
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 732670506,
					"content": "Haiz, vậy thì anh Fodil. Anh thực sự không cân nhắc việc quay lại sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670507
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670507,
					"content": "Tuy tác phong của một số anh em hơi... ờm... lộn xộn, nhưng vẫn có rất nhiều anh em tuân thủ quy tắc mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670508
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670508,
					"content": "Atiyah, tôi đã nói rồi, tôi sẽ không về đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670509
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 732670509,
					"content": "Những chuyện anh nói, tôi đều đã xác nhận bằng ánh mắt của mình rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670510
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 732670510,
					"content": "Có lẽ trong Eremite không phải toàn là người vô phép tắc, cũng không phải mỗi thành viên Eremite đều thích việc mượn gió bẻ măng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670511
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 732670511,
					"content": "Nhưng Atiyah... cái ác sẽ lan truyền. Chỉ cần có một người làm trái pháp luật thì những người xung quanh sẽ bị ảnh hưởng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670522
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 732670522,
					"content": "Một người ảnh hưởng đến một nhóm người, nhóm người kia lại liên tục mở rộng, gây ra ảnh hưởng đến càng nhiều người...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670523
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 732670523,
					"content": "Atiyah, anh hẳn là hiểu những chuyện này hơn tôi nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670512
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 732670512,
					"content": "Cuối cùng tiếng xấu sẽ lan rộng đấy, Atiyah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670513
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 732670513,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670514
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670514,
					"content": "Anh khuyên tôi quay về, tôi cũng muốn khuyên anh rời đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670515
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 732670515,
					"content": "Có lẽ trong mắt anh, Eremite tuy không thể gọi là có đạo đức, nhưng cũng không thể tính là xấu xa... Tuy nhiên con người không thể sống mãi trong ranh giới màu xám.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670516
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 732670516,
					"content": "...Đây chỉ là lời khuyên chân thành của tôi. Cụ thể thế nào thì anh phải tự mình đưa ra quyết định.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670517
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 732670517,
					"content": "Tôi hiểu rồi, anh Fodil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670518
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670518,
					"content": "Ừm. Nếu anh thực sự rời đi... đồng thời cũng muốn tìm kế sinh nhai thì tôi sẽ giúp anh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670519
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 732670519,
					"content": "Anh không sao chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670520
					]
				},
				{
					"id": 732670520,
					"content": "Hahaha, tôi nói không lại anh Fodil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670521
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670521,
					"content": "Tiếp theo... haha, chúng ta về nghỉ ngơi một lúc đi, nói nhiều quá khiến tôi đau hết cả cổ họng rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Atiyah"
				}
			]
		},
