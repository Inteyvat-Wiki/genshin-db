			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sania",
					"Atiyah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732670301,
					"content": "Thật sự khiến người ta buồn phiền...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670302
					],
					"speakerTitle": "Sania"
				},
				{
					"id": 732670302,
					"content": "Sania! Chào buổi sáng, cô đang chọn gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670303
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670303,
					"content": "Atiyah... Tôi đã nói rồi, Jabari không có hứng thú với Eremite, tôi cũng không muốn anh ấy đi làm lính đánh thuê gì đó, anh đừng mong tôi nói giúp anh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670304
					],
					"speakerTitle": "Sania"
				},
				{
					"id": 732670304,
					"content": "Ây da, tài nấu ăn của Jabari tốt như thế, đến Eremite chắc chắn sẽ có thể có một vị trí tốt, thu nhập cũng sẽ tốt hơn nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670305
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670305,
					"content": "Hơn nữa chẳng phải anh ấy đã nói là muốn ra ngoài kiếm việc làm sao? Nếu anh ấy thực sự muốn ra ngoài làm việc thì có người quen như tôi giới thiệu đương nhiên là tốt nhất rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670306
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670306,
					"content": "Cứ cách một khoảng thời gian là anh ấy sẽ nói mấy câu này thôi mà, mấy ngày sau lại hối hận ngay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670307
					],
					"speakerTitle": "Sania"
				},
				{
					"id": 732670307,
					"content": "Nói đến cùng thì anh ấy không nỡ để cho tôi sống một mình ở trong làng... Tôi cũng không nỡ để anh ấy một mình ra ngoài tranh đấu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670308
					],
					"speakerTitle": "Sania"
				},
				{
					"id": 732670308,
					"content": "Huống hồ, làm lính đánh thuê mỗi ngày đều phải liều mạng sống! Nên anh đừng mong nữa, cho dù Jabari muốn đi thì tôi cũng sẽ ngăn cản anh ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670309
					],
					"speakerTitle": "Sania"
				},
				{
					"id": 732670309,
					"content": "Được rồi, nói đến đây thôi, tôi còn phải đi mua đồ, anh đi tìm người khác đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670310
					],
					"speakerTitle": "Sania"
				},
				{
					"id": 732670310,
					"content": "Phù... Thôi được. Nhà Lữ Hành, bạn cũng thấy rồi đó, đây là tình trạng công việc mỗi ngày của tôi đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670311
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670311,
					"content": "Tiếp theo chúng ta đi tìm Fodil vậy, anh ấy... từng là người của chúng tôi, nhưng sau đó đã rời đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670312
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670312,
					"content": "Nếu tôi có thể khuyên anh ấy quay lại thì quá tốt rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Atiyah"
				}
			]
		},
