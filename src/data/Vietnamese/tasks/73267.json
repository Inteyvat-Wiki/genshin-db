			"trigger": {
				"objectNames": [
					"Atiyah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732670101,
					"content": "Gia nhập vào Eremite bao sống khỏe! Đằng ấy có hứng thú tìm hiểu về Eremite của chúng tôi không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670102
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670102,
					"content": "Hả...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670103
					]
				},
				{
					"id": 732670103,
					"content": "Khụ, hãy nghe tôi nói. Eremite là một nơi tuyệt vời, tự do, đoàn kết, thân thiện!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670104
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670104,
					"content": "Hơn nữa còn có thể móc tiền trong túi của những tên sống trên cây. Các học giả của Giáo Viện rất có tiền, chắc chắn sẽ không khất nợ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670105,
						732670106
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670105,
					"content": "Tôi đã gia nhập Hiệp Hội Nhà Mạo Hiểm rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670107
					]
				},
				{
					"id": 732670107,
					"content": "Ơ... Hiệp Hội Nhà Mạo Hiểm... Vậy... vậy cũng đừng nên bỏ lỡ chứ! Ai mà chẳng đi làm thêm, hơn nữa nhà mạo hiểm cũng na ná như lính đánh thuê mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670108
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670108,
					"content": "Khác nhau xa đó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670109
					]
				},
				{
					"id": 732670109,
					"content": "Haiz, có điều bữa cơm của chúng tôi rất xịn đó, luôn có thịt có cá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670110
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670110,
					"content": "Hơn nữa nếu bạn may mắn, thậm chí còn có thể nói chuyện với \"Sư Tử Lửa\" Dehya nữa! Tôi... Khụ khụ... Khụ khụ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670111,
						732670112
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670111,
					"content": "Anh uống chút nước đi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670113
					]
				},
				{
					"id": 732670113,
					"content": "Phù... Khụ... Xin lỗi, lúc nãy tôi nói nhanh quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670114
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670114,
					"content": "Khó khăn lắm mới có một người nghe tôi tuyên truyền, nên tôi hơi kích động...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670115
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670115,
					"content": "Có điều, bạn thực sự không muốn cân nhắc gia nhập Eremite ư?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670116,
						732670117
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670116,
					"content": "Tạm thời không có dự định này.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670118
					]
				},
				{
					"id": 732670118,
					"content": "Được thôi, nếu bạn đã nói như vậy rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670119
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670119,
					"content": "Anh vẫn luôn tuyển người ở đây sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670120
					]
				},
				{
					"id": 732670120,
					"content": "Đúng vậy, đây là công việc của tôi. Mấy năm nay ở đâu cũng thiếu người, lính đánh thuê chúng tôi càng thiếu người nhiều hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670121
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670121,
					"content": "Haiz... Nói với bạn chắc cũng không sao. Bạn thấy Eremite đông người, nhưng nghề làm lính đánh thuê rất nguy hiểm, công việc hộ tống thương đội còn đỡ, cùng lắm là hơi mệt chút...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670122
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670122,
					"content": "Nhưng nếu phải đi cùng các học giả thì thực sự nguy hiểm lắm. Đi một chuyến về chỉ cần không thiếu tay thiếu chân đã phải cảm ơn trời đất rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670123
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670123,
					"content": "Các anh em đi một chuyến kiểu này về, thường ít nhiều cũng nghỉ mười ngày nửa tháng, chỗ trống của họ phải có người khác thay thế vào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670124
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670124,
					"content": "Sumeru rộng lớn như vậy, học giả nhiều như thế, mỗi ngày đều không ngừng có công việc mới, chúng tôi gần như làm không nghỉ luôn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670125
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670125,
					"content": "Nếu không tuyển thêm người nữa thì chúng tôi chống đỡ không nổi mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670126
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670126,
					"content": "Vậy anh tuyển được người chưa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670127
					]
				},
				{
					"id": 732670127,
					"content": "Bạn nói trong làng này hả? Haha... Một người cũng không tuyển được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670128
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670128,
					"content": "Ờm... Cũng không thể nói là không tuyển được, chỉ có thể nói, người muốn tuyển thì không muốn vào, người muốn vào lại không tuyển được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670129
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670129,
					"content": "Nếu không tin thì đi cùng tôi một vòng đi... Nói không chừng đi xong một vòng bạn sẽ đồng ý gia nhập đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670130
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670130,
					"content": "...Ây da, đùa thôi mà, bạn đã nói không muốn gia nhập rồi thì thôi, tôi cũng sẽ không miễn cưỡng. Tôi muốn tìm người đi cùng tôi mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670132
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670132,
					"content": "Cùng anh đi dạo cũng không có vấn đề gì.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670131
					]
				},
				{
					"id": 732670131,
					"content": "Hihi, cảm ơn nhé. Theo tôi thấy thì việc này... Chúng ta đi tìm Sania trước là được, ban ngày chắc cô ấy rảnh, buổi tối thì... cô ấy bận bàn chuyện với Jabari rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670117,
					"content": "Việc của Hiệp Hội Nhà Mạo Hiểm đã đủ nhiều rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670118
					]
				},
				{
					"id": 732670112,
					"content": "Anh giới thiệu thuần thục nhỉ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670113
					]
				},
				{
					"id": 732670106,
					"content": "Tôi đã có rất nhiều ủy thác phải làm rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670107
					]
				}
			]
		},
		{
