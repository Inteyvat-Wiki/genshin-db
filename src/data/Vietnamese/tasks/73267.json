			"dialogs": [
				{
					"id": 732671001,
					"content": "Wow... mấy con bò cạp này to... to quá... không dám lại gần...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671002
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732671002,
					"content": "Rõ ràng đã bắn trúng nó rồi, nhưng nó không có chút phản ứng nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671003
					],
					"speakerTitle": "Karima"
				},
				{
					"id": 732671003,
					"content": "#Nhưng mà... sao {F#chị}{M#anh} lại dễ dàng đánh bại chúng nó như vậy chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671004,
						732671005
					],
					"speakerTitle": "Karima"
				},
				{
					"id": 732671004,
					"content": "Thành quả của việc luyện tập lâu ngày.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732671006
					]
				},
				{
					"id": 732671006,
					"content": "Ôi... rõ ràng chị Candace nói là mình đã có tiến bộ rồi mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671007
					],
					"speakerTitle": "Karima"
				},
				{
					"id": 732671007,
					"content": "Karima, đừng ủ rũ như vậy, chỉ cần mỗi ngày đều tiến bộ một chút, vậy thì sẽ có ngày cháu mạnh mẽ hơn đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671008
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732671008,
					"content": "Ayten cũng vậy, chỉ cần kiên trì luyện tập thì việc gia nhập Eremite chỉ còn là vấn đề thời gian thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671009
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732671009,
					"content": "Nếu như có thể thỉnh giáo võ nghệ của chị Dehya thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671010
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732671010,
					"content": "Lần sau gặp được chị Candace, nhất định phải nhờ chị ấy chỉ bảo chúng ta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671011
					],
					"speakerTitle": "Karima"
				},
				{
					"id": 732671011,
					"content": "Hai đứa bé này... rất hăng hái đấy, hahahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671012,
						732671013
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732671012,
					"content": "Kết quả là anh vẫn không tuyển được người.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732671014
					]
				},
				{
					"id": 732671014,
					"content": "Khụ khụ... khụ... đừng vạch áo cho người xem lưng chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671015
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732671015,
					"content": "Chuyện công việc nói sau đi... hơn nữa, việc tuyên truyền của tôi cũng không phải không có hiệu quả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671016
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732671016,
					"content": "Sau khi nghe buổi tuyên truyền của tôi, rất nhiều thanh niên trong làng đều muốn ra ngoài ngắm nhìn thế giới. Mặc dù... họ đều không muốn gia nhập Eremite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671017
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732671017,
					"content": "Không nói mấy chuyện này nữa, tôi phải đưa hai đứa trẻ này về trong làng rồi. Ra ngoài lâu như vậy, người nhà của cả hai hẳn rất nóng ruột.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671018
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732671018,
					"content": "Nhà Lữ Hành, chỗ thù lao này là của bạn, cảm ơn đã cùng tôi đi một chuyến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671019
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732671019,
					"content": "Haiz, mấy hôm nữa tôi còn phải quay về Eremite để báo cáo công việc, chuyện này nên giải thích thế nào đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671020
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732671020,
					"content": "Đúng rồi, chú Atiyah, chú vẫn chưa kiểm tra cho tụi cháu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671021
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732671021,
					"content": "Hả? Đúng... đúng vậy, chúng ta về trước nhé, sau khi về làng thì chú sẽ kiểm tra cho hai đứa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732671013,
					"content": "Còn công việc của anh thì sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732671014
					]
				},
				{
					"id": 732671005,
					"content": "Hai đứa vẫn còn nhỏ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732671006
					]
				}
			]
