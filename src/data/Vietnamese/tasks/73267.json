			},
			"dialogs": [
				{
					"id": 732670601,
					"content": "Chú Atiyah! Chú đang tuyển người gia nhập Eremite sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670602
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732670602,
					"content": "Ayten, sao cháu lại chạy ra đây, cháu đã nói với mẹ chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670603
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670603,
					"content": "Cháu nói rồi! Mẹ đang làm việc, cháu tự tìm Karima chơi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670604
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732670604,
					"content": "Xin chào, chú Atiyah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670605
					],
					"speakerTitle": "Karima"
				},
				{
					"id": 732670605,
					"content": "Chú Atiyah, chuyện lần trước cháu nói với chú, chú thấy thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670606
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732670606,
					"content": "Cháu vẫn luôn tập luyện, còn rèn luyện với Karima rất lâu... Karima sắp chạy không lại cháu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670607
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732670607,
					"content": "Ai chạy không lại chứ, chẳng qua hôm đó tôi chưa ăn no thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670608
					],
					"speakerTitle": "Karima"
				},
				{
					"id": 732670608,
					"content": "Tóm lại, cháu đã rèn luyện theo kế hoạch mà chú đã định ra rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670609
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732670609,
					"content": "Chú Atiyah, hôm nay chú hãy kiểm tra cho cháu thêm lần nữa đi! Xem cháu đã có đủ tư cách gia nhập Eremite chưa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670610,
						732670611
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732670610,
					"content": "Đây chính là người...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670612
					]
				},
				{
					"id": 732670612,
					"content": "Khụ... được! Ayten, hôm nay chú sẽ lấy thân phận là thành viên của Eremite, một lần nữa tiến hành kiểm tra cho cháu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670613
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670613,
					"content": "Được ạ! Karima cũng kiểm tra thử xem, chúng ta cùng cố gắng nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670614
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732670614,
					"content": "Tôi không muốn gia nhập Eremite đâu, tôi chỉ muốn ở lại làng để bảo vệ mọi người thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670615
					],
					"speakerTitle": "Karima"
				},
				{
					"id": 732670615,
					"content": "Có điều... để chú Atiyah kiểm tra cũng được, tôi đã từng thỉnh giáo chị Candace phương pháp luyện tập rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670616
					],
					"speakerTitle": "Karima"
				},
				{
					"id": 732670616,
					"content": "Ấy? Từ lúc nào mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670617
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732670617,
					"content": "Hahaha, hai cháu tràn đầy sức sống lắm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670618
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670618,
					"content": "Ayten đừng cắn răng nữa, nếu có cơ hội thì chú cũng sẽ đưa cháu đi thỉnh giáo Dehya về phương pháp luyện tập, thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670619
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670619,
					"content": "Thật sao?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670620
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732670620,
					"content": "Lời mà thành viên của Eremite nói thì chắc chắn không phải là giả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670621
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670621,
					"content": "Nhưng mà... hôm nay trước khi bắt đầu kiểm tra, chúng ta hãy để Nhà Lữ Hành này làm mẫu vài động tác trước nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670622,
						732670624
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670622,
					"content": "Có phần của tôi nữa sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670623
					]
				},
				{
					"id": 732670623,
					"content": "...Lúc trước tôi chưa từng có cơ hội làm mẫu. Tôi cũng không thể tự chạy đi làm mẫu rồi bỏ lại hai đứa trẻ ở lại nơi này một mình được, như vậy quá nguy hiểm... Lần này phải nhờ bạn vậy, Nhà Lữ Hành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670626
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670626,
					"content": "Khụ, vị Nhà Lữ Hành này là một nhà mạo hiểm có thực lực, chú khó khăn lắm mới mời được đến để làm mẫu cho các cháu đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670627
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670627,
					"content": "Ayten, Karima, cả hai nhất định phải nhìn cho kỹ đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670628
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670628,
					"content": "Dạ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670629
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732670629,
					"content": "Nhà mạo hiểm... là người trong Hiệp Hội Nhà Mạo Hiểm sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670630
					],
					"speakerTitle": "Karima"
				},
				{
					"id": 732670630,
					"content": "Dù là lính đánh thuê hay thủ vệ, trong lúc chấp hành nhiệm vụ đều sẽ gặp được tình huống bắt buộc phải rút lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670631
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670631,
					"content": "Lúc này, chúng ta thường phải... chạy càng nhanh càng tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670632
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670632,
					"content": "Nhà Lữ Hành, nhờ bạn vậy, chúng ta làm mẫu... ừm... cách rút lui nhanh chóng trước nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670633
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670633,
					"content": "Vạch xuất phát ở đó, nhờ bạn làm mẫu trước nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670624,
					"content": "Trước đây anh chưa từng làm mẫu sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670625
					]
				},
				{
					"id": 732670625,
					"content": "...Lúc trước tôi còn phải chăm sóc hai đứa bé này, sao có thể làm mẫu động tác tiêu chuẩn gì đó chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670634
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670634,
					"content": "...Tóm lại, lần này phải nhờ bạn vậy, Nhà Lữ Hành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670626
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670611,
					"content": "Muốn gia nhập mà anh nói sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670612
					]
				}
			]
