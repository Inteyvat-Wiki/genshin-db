			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105020601,
					"content": "Người để lại phong ấn này... Không đơn giản. Dùng bạo lực để giải quyết chắc chắn không được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020602
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020602,
					"content": "Thật thú vị, đáng để tôi dùng thuật chiêm tinh để xử lý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020603
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020603,
					"content": "Để tôi xem, ra là vậy... Chỉ cần như vầy, sau đó như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020604
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020604,
					"content": "Được rồi, mở rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020605
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020605,
					"content": "Ồ, thật lợi hại!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020606,
					"content": "Chỉ cần về báo cáo lại cho Katheryne là có thể vào ở được rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020607,
					"content": "Không cần đâu, thật cảm ơn mọi người!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020608
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 105020608,
					"content": "Vị này là...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020609
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020609,
					"content": "Ông là chủ của căn nhà này, Goth. Ban nãy khi đi ngang Hiệp Hội Nhà Mạo Hiểm có nghe Katheryne nhắc đến chuyện này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020610
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 105020610,
					"content": "Không ngờ cái phong ấn phiền phức này lại được mở nhanh như vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020611
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 105020611,
					"content": "Vậy là cháu có thể ở lại đây đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020612
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020612,
					"content": "Đương nhiên, dù sao thì thiết bị trong đây cũng không để làm gì, có người dùng đến nó thì ông cũng rất vui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020613
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 105020613,
					"content": "Để cảm ơn, ông có thể dùng giá thấp nhất để cho cháu thuê cái phòng này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020614
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 105020614,
					"content": "Thuê sao?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020615
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020615,
					"content": "Trước khi đến đây cháu chưa nghe qua chuyện thuê, vả lại cháu đã giúp đỡ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020616
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020616,
					"content": "Giúp đỡ? Phải, ông hiểu. Ông rất cảm ơn nên sẽ cho cháu giá ưu đãi nhất!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020617
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 105020617,
					"content": "Ý, ý là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020618
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020618,
					"content": "Xem ra Mona có chút hiểu lầm, nhưng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020619,
						105020620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020619,
					"content": "Đây có thể là sự lựa chọn tốt nhất rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020621
					]
				},
				{
					"id": 105020621,
					"content": "Haiz... không còn cách nào khác, vậy thì thuê chỗ này vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020622
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020622,
					"content": "Được, vậy để ông đi chuẩn bị thủ tục một chút, đợi lát nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020623
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 105020623,
					"content": "Lần này thật cảm ơn... Còn chuyện tôi đã hứa, thật xin lỗi, tạm thời chưa làm được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020624
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020624,
					"content": "#Không có thiết bị chiêm tinh, cũng không có kiến thức mới, muốn nhìn được vận mệnh của {F#cô}{M#cậu} thì cần phải có chút thời gian...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020625
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020625,
					"content": "#Nhưng tôi hứa với {F#cô}{M#cậu}, khi chuẩn bị xong rồi tôi sẽ xem cho {F#cô}{M#cậu} ngay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020626,
						105020628
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020626,
					"content": "Như cô đã nói, chuyến này luôn có lợi",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020627
					]
				},
				{
					"id": 105020627,
					"content": "#Cảm ơn, có thể đồng hành cùng {F#cô}{M#cậu} là vận mệnh của tôi, cũng có thể xem là may mắn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020630
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020630,
					"content": "#Chúc {F#cô}{M#cậu} may mắn! Tôi cũng sẽ suy nghĩ về chuyện sau này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020631
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020631,
					"content": "Nếu cô ấy không dùng chiêm tinh để kiếm tiền thì sao có thể sống được?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020632
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020632,
					"content": "...Hay là chúng ta thỉnh thoảng đến thăm cô ấy nhé? Nếu bị đói xỉu trong phòng thì không tốt chút nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020628,
					"content": "Giờ hãy có gắng sống sót đã.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020629
					]
				},
				{
					"id": 105020629,
					"content": "Tuy là đang không biết phải làm thế nào, nhưng... tôi sẽ cố gắng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020630
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020620,
					"content": "Tiết kiệm chút Mora có thể sẽ ổn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020621
					]
				}
			]
