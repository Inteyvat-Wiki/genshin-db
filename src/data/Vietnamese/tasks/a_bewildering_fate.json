	"talks": [
		{
			"id": 1050201,
			"completionStepIds": [
				1050202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1050202",
							"2"
						],
						"stepId": 1050202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105020101,
					"content": "#Sắp gặp được người kế thừa đó rồi, chuẩn bị xong chưa? Đừng để sư phụ của {F#cô}{M#cậu} mất mặt đó nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020102,
						105020103
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020102,
					"content": "Tôi đâu có xem bói được...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020104
					]
				},
				{
					"id": 105020104,
					"content": "Cũng đúng... À, không đúng! Cho dù là đệ tử giả đi nữa cũng không thể cái gì cũng không biết được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020105
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020105,
					"content": "#Tuy là sư môn có quy định không được truyền thụ cho người ngoài, tuy nhiên... nếu là {F#cô}{M#cậu} thì có thể được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020106
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020106,
					"content": "Thuật Chiêm Tinh của tôi là Thủy Chiêm Thuật, là thông qua hình ảnh phản chiếu từ nước để ngắm sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020107
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020107,
					"content": "#Để tôi thị phạm cho {F#cô}{M#cậu} xem, nhìn kỹ nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020108
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020108,
					"content": "Từ tinh tượng phía trước cho biết, vị kế thừa đó là kỵ sĩ tây phong, và là... nữ giới...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020109
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020109,
					"content": "Nghe miêu tả vậy... không lẽ là Lisa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020110,
					"content": "Chúng ta sẽ gặp cô ấy sớm thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020111
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020111,
					"content": "Được rồi, có nhiều thông tin như vậy chắc là đủ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020112,
						105020113
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020112,
					"content": "Kết thúc rồi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020114
					]
				},
				{
					"id": 105020114,
					"content": "Haiz, xem ra dù là thuật chiêm tinh cơ bản nhất cũng không phải nhìn một lần là ra được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020115
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020115,
					"content": "#Thôi kệ, đợi chút nói kỹ hơn với {F#cô}{M#cậu} vậy, cô ấy đã đến rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020116
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020116,
					"content": "#Oa, Kỵ Sĩ Danh Dự {NICKNAME}! Còn có bé Paimon, hai người quay về rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020117
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020117,
					"content": "Chính là cô ấy! Người kế thừa học thức vĩ đại!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020118,
						105020119
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020118,
					"content": "...Cô nói Klee sao?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020120
					]
				},
				{
					"id": 105020120,
					"content": "Người kế thừa...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020121
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020121,
					"content": "Không sai, chị chính là thuật sĩ chiêm tinh biết rõ bí mật của biển sao! Em cũng đã sớm đoán được chị sẽ đến đúng không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020122
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020122,
					"content": "Biển sao là gì, biển sao cũng có cá đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020123
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020123,
					"content": "Cá...? Không, đừng làm bộ nữa, em đang sợ các thử thách của chị à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020124
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020124,
					"content": "Chị đang nói cái gì vậy! Em không hiểu gì cả!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020125,
						105020126
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020125,
					"content": "Cứ nói qua nói lại thì không có kết quả!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020127
					]
				},
				{
					"id": 105020127,
					"content": "Nhưng thuật chiêm tinh của chị không thể sai được... Hừm, để tránh nhầm lẫn chị vẫn nên hỏi thêm một câu, mẹ của em tên là Alice đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020128
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020128,
					"content": "Đúng vậy. Chị là bạn bè của mẹ em à. Nhưng mẹ em đã đi đến một nơi rất xa rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020129
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020129,
					"content": "Cái này chị biết. Nhưng trước khi bà ấy đi, hẳn là có để lại tri thức thần bí học cho em đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020130
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020130,
					"content": "Thần bí học, tri thức... Không hiểu lắm, mẹ chỉ dạy em cách làm đạn nảy thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020131
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020131,
					"content": "Thì ra mẹ của Klee, chính là bạn bè kiêm kình địch của sư phụ Mona sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020132,
					"content": "Sư phụ của tôi tuy có sở trường chiêm tinh, nhưng bà ấy cũng chỉ biết về thuật chiêm tinh. Còn Alice thì khác, bà ấy là thiên tài nắm rõ được mọi lĩnh vực thần bí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020133
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020133,
					"content": "Cho nên... Klee nhỏ tuổi như vậy thì cho dù có nghe những tri thức cao thâm cũng sẽ không hiểu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020134,
					"content": "Ừm, xem ra chỉ kế thừa huyết thống, không có kế thừa tri thức... Tôi tính toán sai rồi, vậy không thể so tài được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020135
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020135,
					"content": "Đúng rồi, trước khi Alice đi, có nói cho em nghe cuộc hẹn 50 năm và chuyện của chiếc rương không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020136
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020136,
					"content": "Ừm ừm, cái này em biết, thì ra chị đến để lấy chiếc rương sao. Để em tìm thử!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020137
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020137,
					"content": "Không phải cái này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020138
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020138,
					"content": "Cái này cũng không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020139
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020139,
					"content": "Không đúng... cái này cũng không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020140
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020140,
					"content": "A! Em nhớ ra rồi, em đã giấu nó ở <color=#00E1FFFF>Phong Khởi Địa</color> rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020141,
						105020142
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020141,
					"content": "Không phải lại là bom chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020143
					]
				},
				{
					"id": 105020143,
					"content": "Mọi người đợi em chút, em sẽ lấy về!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020144
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020144,
					"content": "Khoan đi đã! Những thứ trong túi đồ này thì sao đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020145,
					"content": "Tôi sẽ dọn dẹp đồ cho em ấy, mọi người mau đuổi theo đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020146
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020146,
					"content": "Haiz, nhìn em ấy như vậy, tôi thật lo cho chiếc rương...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020142,
					"content": "Sao lại cứ thích để thứ quan trọng ở ngoài đường thế nhỉ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020143
					]
				},
				{
					"id": 105020126,
					"content": "Vậy mới nói nhất định có nhầm lẫn rồi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020127
					]
				},
				{
					"id": 105020119,
					"content": "Nhất định là có hiểu lầm rồi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020120
					]
				},
				{
					"id": 105020113,
					"content": "Tôi vẫn chưa nhìn rõ nữa!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020114
					]
				},
				{
					"id": 105020103,
					"content": "Tôi đâu có biết chiêm tinh...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020104
					]
				}
			]
		},
		{
			"id": 1050202,
			"completionStepIds": [
				1050204
