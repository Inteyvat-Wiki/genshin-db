					"nextDialogs": [
						101121015
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101121015,
					"content": "Tôi là nhà mạo hiểm vĩ đại, đây là việc nên làm! Còn các bạn, ở đây có rất nhiều Hilichurl, đừng lơ là!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121016
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101121016,
					"content": "Tạm biệt nhé, các bạn trẻ.",
