				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Venti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101120401,
					"content": "Nhìn kìa, <color=#00E1FFFF>\"kiếm dũng sĩ huy hoàng\"</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120402
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120402,
					"content": "Không phải chứ? chỉ là một thanh kiếm cũ hết sức bình thường thôi mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120403,
					"content": "Tại sao Hilichurl lại vây quanh món đồ đó rồi cúng bái?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120404,
					"content": "(E là có ai đó đã ném thanh kiếm vào ống chiến lợi phẩm mà Hilichurl đang cúng bái...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120405
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120405,
					"content": "Nó cũ mèm rồi! Hơn nữa... Phải nói thế nào nhỉ, bình thường đến mức không nói nên lời...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120406
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101120406,
					"content": "Không, Jack, bạn đã từng thấy Phong Tinh Điệp bay ở ngoài Thành Mondstadt chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120407
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120407,
					"content": "Loại bướm đó ban ngày không hề bắt mắt, nhưng về đêm lại rất đẹp, trông như viên ngọc biết bay vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120408
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120408,
					"content": "Cũng giống như dũng khí, người thuận buồm xuôi gió sẽ không hiểu được giá trị của nó, nhưng khi sống trong tuyệt vọng, dũng khí là ánh sáng duy nhất giúp bạn vươn lên và chiến đấu thoát khỏi khó khăn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120409,
						101120410,
						101120411
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120409,
					"content": "Nói hay như hát.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120412
					]
				},
				{
					"id": 101120412,
					"content": "Bạn nói đúng quá! Chính xác là như vậy, đó chắc chắn là \"kiếm dũng khí huy hoàng\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120413
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101120413,
					"content": "Ừm, vậy là tìm được kiếm rồi, chỉ còn khiên thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120414
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120414,
					"content": "Tìm xung quanh xem sao! Đồ chắc chắn ở trong <color=#00E1FFFF>Hẻm Núi Dadaupa</color>... Hả?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120415
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120415,
					"content": "Í? Hình như bên đó có người!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120416,
					"content": "Stanley? Sao bạn ấy lại ở đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120417
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120417,
					"content": "Dáng vẻ của bạn ấy hơi kỳ lạ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120418,
					"content": "Xảy ra chuyện gì sao? Sao đột nhiên lại dừng lại?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120419
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101120419,
					"content": "Không có gì, lúc nãy có một con \"Chồn Trộm Báu Vật\" biết rắc tiền vàng chạy ngang qua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120420
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120420,
					"content": "Cái gì? Ở đâu! Tôi cũng muốn xem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120421
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101120421,
					"content": "Không phải bạn đến tìm thần khí sao? Đừng xem nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120410,
					"content": "Khiến người khác kích động",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120412
					]
				},
				{
					"id": 101120411,
					"content": "Tôi sắp tin mất rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120412
					]
				}
			]
		},
		{
			"id": 1011206,
			"completionStepIds": [
				1011206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
