			"dialogs": [
				{
					"id": 221160701,
					"content": "Trước kia vào thành ta có gặp một người đang nói chuyện với một cô gái xem bói, có điều khi ấy ta không chú ý nghe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160702
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 221160702,
					"content": "Sau này mới biết hai người bọn họ là Zhihua và Qiming, cháu có thể giúp ta nghe ngóng tình hình được không, nếu có chuyện gì hay nhớ kể cho ta nghe đó.",
					"roleType": "TALK_ROLE_NPC",
