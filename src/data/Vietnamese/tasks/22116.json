				{
					"id": 221161201,
					"content": "Lulu, lần này đến lượt A Fei làm thuyền trưởng rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161202
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 221161202,
					"content": "Đúng đó, đã nói bao nhiêu lần rồi, lúc nào cũng cho tôi làm người phục vụ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161203
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 221161203,
					"content": "Nhưng mỗi khi A Meng làm thuyền trưởng chúng ta chơi rất vui mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161204
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 221161204,
					"content": "Lulu, bạn không được nói như vậy, A Fei diễn cũng rất tốt mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161205
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 221161205,
					"content": "Đúng vậy bạn nói không có sai, khi ấy bạn làm thuyền trưởng, tôi làm phú thương, còn A Fei là người phục vụ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161206
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 221161206,
					"content": "Lúc đó chúng ta chơi rất vui mà, phải không A Fei?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161207
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 221161207,
					"content": "Lulu, bạn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161208
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 221161208,
					"content": "Lulu đã nói như vậy thì... Cũng không sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161209
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 221161209,
					"content": "A Fei, bạn lại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161210
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 221161210,
					"content": "Không có sao! Không sao, chỉ cần Lulu vui là được, chúng ta tiếp tục đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161211
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 221161211,
					"content": "Chỉ là thuyền trưởng thôi mà, tôi cũng chả thiết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161212
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 221161212,
					"content": "... Các bạn, hừm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "A Meng"
				}
			]
