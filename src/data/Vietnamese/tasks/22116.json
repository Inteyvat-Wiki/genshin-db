					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221161303
					]
				},
				{
					"id": 221161303,
					"content": "Có cả sổ ghi chép sao, đưa ta xem... Zhihua và Qiming quả nhiên không có sai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161304
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 221161304,
					"content": "Ừm... Không tệ đó, cái này được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161305
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 221161305,
					"content": "Chỗ nào không tệ ạ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221161306
					]
				},
				{
					"id": 221161306,
					"content": "Cháu không biết sao? Không có cảm giác gì sao? Cháu xem này, cái cảm giác mập mờ này, không phải là thứ người ngoài có thể hiểu được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161307
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 221161307,
					"content": "Cái này cũng được, ta mường tượng được lối suy nghĩ rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161308
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 221161308,
					"content": "Đây là quà cảm ơn, cháu nhận lấy nhé, ta phải suy nghĩ làm sao để khai bút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Thường Cửu Gia"
				}
			]
