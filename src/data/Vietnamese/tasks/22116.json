					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 221160902,
					"content": "Tuy là lũ trẻ con, nhưng có thể biết được một vài câu chuyện quanh chúng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160903
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 221160903,
					"content": "Cháu đi xem giúp ta nhé, nếu có gì hay hãy ghi chép lại cho ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Thường Cửu Gia"
