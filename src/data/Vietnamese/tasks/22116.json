			},
			"dialogs": [
				{
					"id": 221160801,
					"content": "Xem ra cháu đã gặp người tên là Sisi rồi phải không? Cô ấy dường như đang đợi một thủy thủ tên là Chaoxi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160802
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 221160802,
					"content": "Nếu ta nhớ không lầm thì cô ấy cứ cách một quãng thời gian lại đi đến đó đợi... Rốt cuộc Chaoxi và Sisi có câu chuyện như thế nào chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160803
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 221160803,
					"content": "Cháu giúp ta đi xem nhé, nếu là câu chuyện hay nhớ ghi lại rồi đem về cho ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Thường Cửu Gia"
				}
			]
		},
