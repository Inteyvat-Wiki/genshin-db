			"dialogs": [
				{
					"id": 221161101,
					"content": "Anh Chaoxi, anh đến rồi ư... Em vừa học được cách nấu một món ăn ngon, chút nữa em làm cho anh ăn thử nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161102
					],
					"speakerTitle": "Sisi"
				},
				{
					"id": 221161102,
					"content": "Sisi đó ư, anh vừa mới về, giờ chả có tâm trạng nữa, chỉ muốn nghỉ ngơi một lát...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161103
					],
					"speakerTitle": "Chaoxi"
				},
				{
					"id": 221161103,
					"content": "Đúng rồi, anh vất vả như vậy cần phải nghỉ ngơi đầy đủ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161104
					],
					"speakerTitle": "Sisi"
				},
				{
					"id": 221161104,
					"content": "Vậy thì... Đợi đến khi anh nghỉ ngơi xong, chúng mình nói chuyện tiếp nhé? Chắc phải chọn ngày mới được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161105
					],
					"speakerTitle": "Sisi"
				},
				{
					"id": 221161105,
					"content": "Ừm, em nhớ rồi, nhưng hiện tại em vẫn chưa nghĩ xong. Không phải là do em không muốn chịu trách nhiệm, chỉ là không muốn phụ lòng anh mà thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161106
					],
					"speakerTitle": "Chaoxi"
				},
				{
					"id": 221161106,
					"content": "Đời thủy thủ là phải gắn liền với biển, Sisi à, em xứng đáng gặp được người tốt hơn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161107
					],
					"speakerTitle": "Chaoxi"
				},
				{
					"id": 221161107,
					"content": "Anh Chaoxi, anh đừng nói như vậy, em hiểu mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sisi"
				}
			]
		},
