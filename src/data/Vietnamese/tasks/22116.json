			"dialogs": [
				{
					"id": 221160101,
					"content": "Làm sao để mở đầu cho hay đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160102
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 221160102,
					"content": "Ông lại làm gì đấy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221160103
					]
				},
				{
					"id": 221160103,
					"content": "Ồ lại là cháu sao. Ta chuẩn bị viết tiểu thuyết, mỗi lần viết mở đầu ta đều cảm thấy thiếu một thứ gì đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160104
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 221160104,
					"content": "Nghĩ rất lâu mà vẫn không xong, không biết bao giờ mới có thể hoàn thành đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160105
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 221160105,
					"content": "Đúng rồi, ta thấy cháu là người có hiểu biết rộng. Cháu nghĩ thế nào là một cuốn tiểu thuyết thành công?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160106
					],
					"speakerTitle": "Thường Cửu Gia"
				}
			]
		},
