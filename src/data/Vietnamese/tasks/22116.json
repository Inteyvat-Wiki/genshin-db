				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221160501,
					"content": "Hihi... Như vậy ta thực sự trải nghiệm được thứ gọi là \"nhiệt huyết chiến đấu\" rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160502
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 221160502,
					"content": "Ông không phải chỉ muốn xem đánh nhau sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221160503
					]
				},
				{
					"id": 221160503,
					"content": "Đúng vậy, ban đầu ta nghĩ như thế, nhưng nào ngờ Nhà Mạo Hiểm đến trễ, không xuất hiện cơ chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160504
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 221160504,
					"content": "Đám quái vật quanh quẩn gần đó trông có vẻ chuẩn bị rời đi. Nếu bọn chúng chạy mất, coi như ta phí công rồi hay sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160505
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 221160505,
					"content": "Sau đó... Ta làm theo tiểu thuyết hướng dẫn, lấy cục đá ném vào đầu chúng để thu hút sự chú ý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160506
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 221160506,
					"content": "Nào ngờ, sau khi vứt vào đầu quái vật thì... Bị như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160507
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 221160507,
					"content": "Thật là đau quá, tuy là chịu khổ một chút nhưng cuối cùng cũng lấy được cảm hứng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160508
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 221160508,
					"content": "Bây giờ ta có rất nhiều ý tưởng! Ồ đúng rồi, đây là quà cảm ơn dành cho cháu, hãy nhận lấy nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160509
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 221160509,
					"content": "Ta cảm thấy có thế bắt đầu viết luôn được rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Thường Cửu Gia"
				}
			]
		},
