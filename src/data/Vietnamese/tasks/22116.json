					"Thường Cửu Gia"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221160301,
					"content": "Có nhiệt huyết chiến đấu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221160302
					]
				},
				{
					"id": 221160302,
					"content": "Nhiệt huyết chiến đấu sao... Ừm... cũng có lý, thứ này dễ thu hút người đọc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160303
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 221160303,
					"content": "Không nhắc đến \"nhiệt huyết chiến đấu\" nữa, Khinh Sách Trang còn chả có \"chiến đấu\" nữa là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160304
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 221160304,
					"content": "Xem ra ta phải đi tìm cảm hứng mới được. Ta nghe nói gần khu vực này có rất nhiều Nhà Mạo Hiểm phải không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160305
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 221160305,
					"content": "Để tìm kiếm bảo vật họ thường xuyên mạo hiểm nơi ngoài thành và đánh nhau với lũ quái vật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160306
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 221160306,
					"content": "Ta chợt nhớ đến một nơi có rất nhiều quái vật, chúng ta đến đó xem đi! Sau đó đợi những Nhà Mạo Hiểm đến đánh nhau với lũ quái vật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160307
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 221160307,
					"content": "Hihi như vậy là ta có tư liệu để viết rồi. Nơi đó khá xa, ta đi trước đây, cháu cũng đến xem nhá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Thường Cửu Gia"
				}
			]
		},
		{
			"id": 2211605,
			"completionStepIds": [
				2211608
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
