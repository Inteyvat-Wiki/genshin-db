			"dialogs": [
				{
					"id": 221161001,
					"content": "Chị Qiming, hôm nay em...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161002
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221161002,
					"content": "Hôm nay không thích hợp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161003
					],
					"speakerTitle": "Qiming"
				},
				{
					"id": 221161003,
					"content": "Í? Thế nhưng em chưa có nói gì mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161004
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221161004,
					"content": "Không cần nói nữa, mới nghe là chị biết em định nói gì, hôm nay không phù hợp đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161005
					],
					"speakerTitle": "Qiming"
				},
				{
					"id": 221161005,
					"content": "Vậy lúc nào mới phù hợp cơ chứ, chị Qiming, không lẽ chị...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161006
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221161006,
					"content": "Ồ, đến lúc nào đó thì sẽ thích hợp thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161007
					],
					"speakerTitle": "Qiming"
				},
				{
					"id": 221161007,
					"content": "Thế chẳng khác gì không nói! Chị Qiming, chị nghe em nói đi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161008
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221161008,
					"content": "Xong rồi, mời người tiếp theo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161009
					],
					"speakerTitle": "Qiming"
				},
				{
					"id": 221161009,
					"content": "Em còn chưa nói xong mà! Hơn nữa làm gì còn người nào nữa cơ chứ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhihua"
				}
			]
		},
