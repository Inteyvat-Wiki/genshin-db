			},
			"dialogs": [
				{
					"id": 221161701,
					"content": "Thế nào, cháu có thu hoạch gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161702
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 221161702,
					"content": "Cháu ghi lại vào đây.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221161703
					]
				},
				{
					"id": 221161703,
					"content": "Có thu hoạch sao, để ta xem... Tên Chaoxi này sao có chút gì đó không bình thường, không đúng, nên nói là hai người này không bình thường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161704
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 221161704,
					"content": "Cái này được tính là \"lãng mạn\" không nhỉ? Chắc là được rồi, nếu không được xem là lãng mạn, cũng được coi là một câu chuyện đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161705
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 221161705,
					"content": "Đây là quà cảm ơn, cháu nhận lấy nhé, ta phải suy nghĩ xem làm sao để khai bút rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161706
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 221161706,
					"content": "Có điều câu chuyện như vậy chỉ nên xuất hiện ở trong tiểu thuyết mà thôi, nếu đời thực mà có thì chắc phải kiện lên đến Thiên Nham Quân mất...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161707
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 221161707,
					"content": "Đúng rồi, cảm thấy sẽ xảy ra chuyện gì đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Thường Cửu Gia"
				}
			]
		},
