			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Caron"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							3627.395,
							446.263,
							4474.6
						],
						"pointId": 340100067
					},
					{
						"sceneId": 3,
						"position": [
							3627.172,
							446.167,
							4477.734
						],
						"pointId": 340100123
					},
					{
						"sceneId": 3,
						"position": [
							3626.387,
							446.167,
							4476.965
						],
						"pointId": 340100124
					}
				]
			},
			"dialogs": [
				{
					"id": 745010201,
					"content": "Lại gặp nhau rồi, hai vị dạo này thế nào? Có chơi thử món đồ chơi nhà mạo hiểm chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010202
					],
					"speakerTitle": "Caron"
				},
				{
					"id": 745010202,
					"content": "Hihi, chào ông chủ Caron. Thật ra chúng tôi có chút chuyện muốn hỏi, vừa hay cũng là về món đồ chơi đó đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745010203,
					"content": "Vừa hay? Tôi thích từ này. Muốn ngủ vừa hay có thể ngủ, muốn mua đồ vừa hay có thể mua đồ. Vậy nên có gì hai vị cứ hỏi đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010204
					],
					"speakerTitle": "Caron"
				},
				{
					"id": 745010204,
					"content": "Muốn biết câu chuyện về món đồ chơi này.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745010205
					]
				},
				{
					"id": 745010205,
					"content": "Đúng vậy! Chúng tôi nghe nói anh làm món đồ chơi này là vì ai đó. Chắc là về nhà mạo hiểm đó nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745010206,
					"content": "Haha, thì ra là chuyện này. Nhà mạo hiểm đó đúng là người đã để lại cho tôi ấn tượng sâu sắc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010207
					],
					"speakerTitle": "Caron"
				},
				{
					"id": 745010207,
					"content": "Lúc tôi sắp rời khỏi Mondstadt, tôi có gặp một nhà mạo hiểm ở Thanh Tuyền Trấn. Khi đó hình như cậu ấy đã làm hỏng một ủy thác giao hàng gì đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010208
					],
					"speakerTitle": "Caron"
				},
				{
					"id": 745010208,
					"content": "Nghe nói trên đường gặp phải ma vật, nên vừa trễ giờ vừa làm đổ thức ăn. Tôi biết chút ít về nấu nướng nên đã chủ động giúp cậu ấy làm lại một phần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010209
					],
					"speakerTitle": "Caron"
				},
				{
					"id": 745010209,
					"content": "Anh nhiệt tình thật!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745010210,
					"content": "Haha, nhưng nhiệt tình thôi vẫn không đủ. Chắc chắn hai vị sẽ bất ngờ là tại sao lại xảy ra nhiều sự cố đến vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010211
					],
					"speakerTitle": "Caron"
				},
				{
					"id": 745010211,
					"content": "Củi bị ướt... Đáy nồi bị thủng một lỗ lớn... Đang cho lên đĩa thì bị ném đá... Có một viên còn bay trúng đầu tôi. Đau lắm luôn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010212
					],
					"speakerTitle": "Caron"
				},
				{
					"id": 745010212,
					"content": "Dù cuối cùng vẫn miễn cưỡng hoàn thành ủy thác, nhưng bị khách hàng phàn nàn rằng nhai trúng đá làm gãy răng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010237
					],
					"speakerTitle": "Caron"
				},
				{
					"id": 745010237,
					"content": "Thủy Thần Furina trên cao, không phải người đã gõ vào đầu chúng tôi đấy chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010213
					],
					"speakerTitle": "Caron"
				},
				{
					"id": 745010213,
					"content": "Có phải nhà mạo hiểm đó tên là...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745010214
					]
				},
				{
					"id": 745010214,
					"content": "Là Bennett, lẽ nào... hai vị cũng biết cậu ấy sao? Thật kỳ diệu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010215
					],
					"speakerTitle": "Caron"
				},
				{
					"id": 745010215,
					"content": "Sau đó vì để cảm ơn tôi mà cậu ấy đã đưa tôi đến những nơi ít ai lui tới. Mặc dù đường rất khó đi, nhưng phong cảnh rất đẹp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010216
					],
					"speakerTitle": "Caron"
				},
				{
					"id": 745010216,
					"content": "Tôi còn tưởng cậu ấy là một người đam mê thám hiểm kỳ cựu. Không ngờ cậu ấy bảo là khi đi thám hiểm cũng hay té ngã hoặc bị lạc đường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010217
					],
					"speakerTitle": "Caron"
				},
				{
					"id": 745010217,
					"content": "Khi chúng tôi từ biệt nhau. Tôi có hỏi là tố chất xui xẻo như vậy có phải phiền phức lắm không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010218
					],
					"speakerTitle": "Caron"
				},
				{
					"id": 745010218,
					"content": "Nhưng cậu ấy cười và giơ ngón tay cái lên nói: \"Trên đời có đủ loại người, và có lẽ tôi là người xui xẻo nhất.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010219
					],
					"speakerTitle": "Caron"
				},
				{
					"id": 745010219,
					"content": "\"Nhưng vì vậy mà tôi càng trở thành người dũng cảm nhất. Đó chính là cảnh tượng chỉ có tôi thấy được.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010220
					],
					"speakerTitle": "Caron"
				},
				{
					"id": 745010220,
					"content": "Một câu nói rất hay. Đi trên con đường trải đầy bất hạnh mà vẫn tươi cười tiến về phía trước, chẳng lẽ đây mới là nhà mạo hiểm đích thực sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010238
					],
					"speakerTitle": "Caron"
				},
				{
					"id": 745010238,
					"content": "Đúng vậy! Bennett chính là nhà mạo hiểm mạo hiểm nhất!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010239
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745010239,
					"content": "Haha, tôi nghĩ nếu xui xẻo có tính lây lan thì tinh thần mạo hiểm này cũng phải được lây lan, và lây lan đến những nơi xa hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010221
					],
					"speakerTitle": "Caron"
				},
				{
					"id": 745010221,
					"content": "Không biết câu chuyện này đã đủ để hai vị về báo cáo lại không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010222
					],
					"speakerTitle": "Caron"
				},
				{
					"id": 745010222,
					"content": "Chậc... Ông chủ Caron lại nhìn thấu nữa rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745010223,
					"content": "Không có lửa làm sao có khói, đây là câu thành ngữ của người Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010224
					],
					"speakerTitle": "Caron"
				},
				{
					"id": 745010224,
					"content": "Nếu hai vị muốn biết câu chuyện này thì đã hỏi ngay vào hôm đó rồi. Hôm nay mới đến hỏi thì chắc chắn là đã nhận ủy thác của anh trai tôi, đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010225
					],
					"speakerTitle": "Caron"
				},
				{
					"id": 745010225,
					"content": "Lại bị nhìn thấu rồi! Rõ ràng là ông chủ Caron vừa hiền lành vừa thông minh, thật khó tin khi ông chủ Livre lại có thành kiến với một người em trai như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745010226,
					"content": "Là vì anh ấy giận tôi, anh ấy nghĩ là tôi phản bội anh ấy, chắc bây giờ vẫn còn đang giận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010227
					],
					"speakerTitle": "Caron"
				},
				{
					"id": 745010227,
					"content": "Hả?! Phản bội?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745010228,
					"content": "Tổ tiên chúng tôi nổi tiếng về chế tạo dây cót. Từ nhỏ tôi đã rất giỏi làm đồ chơi dây cót. Mặc dù mặt này anh trai tôi không bằng tôi, nhưng anh ấy rất có đầu óc kinh doanh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010229
					],
					"speakerTitle": "Caron"
				},
				{
					"id": 745010229,
					"content": "Bởi vì đều thích đồ chơi, nên chúng tôi hẹn nhau lớn lên sẽ mở một cửa hàng đồ chơi hoành tráng nhất. Nhưng lớn lên rồi mới biết, phải có người kế thừa công việc kinh doanh của gia đình, chính là cửa hàng đồng hồ này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010230
					],
					"speakerTitle": "Caron"
				},
				{
					"id": 745010230,
					"content": "Anh trai và cha đã cãi nhau một trận, anh ấy bỏ ra ngoài lập nghiệp, còn tôi thì bị thuyết phục mà không đi theo anh ấy. Như vậy là phản bội sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010231
					],
					"speakerTitle": "Caron"
				},
				{
					"id": 745010231,
					"content": "Ừm... Như vậy mà là phản bội gì chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745010232,
					"content": "Ít ra thì đó cũng là thiếu tinh thần mạo hiểm. Tôi cũng lo lắng là tôi không tạo dựng được tên tuổi thì sẽ tay trắng quay về. Dùng đam mê để lập nghiệp thì áp lực cũng sẽ rất lớn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010233
					],
					"speakerTitle": "Caron"
				},
				{
					"id": 745010233,
					"content": "Từ nhỏ tôi đã như vậy. Gặp bọn gây rối thì tôi là người khóc đầu tiên, nhưng anh trai tôi sẽ đẩy tôi ra phía sau và nói \"nhìn anh đấm bay bọn nó nè!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010234
					],
					"speakerTitle": "Caron"
				},
				{
					"id": 745010234,
					"content": "Mối quan hệ anh em của hai người hình như hơi phức tạp...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010235
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745010235,
					"content": "Haha, là vậy đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010236
					],
					"speakerTitle": "Caron"
				},
				{
					"id": 745010236,
					"content": "Tóm lại, nếu có gì thắc mắc thì cứ đến hỏi nhé. Tôi sẽ luôn ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Caron"
				}
			]
		},
