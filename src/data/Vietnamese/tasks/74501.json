			"dialogs": [
				{
					"id": 745010301,
					"content": "Ông chủ, họ quay về rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010302
					],
					"speakerTitle": "Arbon"
				},
				{
					"id": 745010302,
					"content": "Hai vị vẫn nhanh nhẹn nhỉ, lần này chắc cũng có thu hoạch lớn đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010303
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 745010303,
					"content": "Livre, sao anh cứ xuất hiện trễ vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745010304,
					"content": "Xin lỗi, lần sau tôi hứa sẽ xuất hiện sớm nhất có thể. Hihi, về chuyện món đồ chơi đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010305
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 745010305,
					"content": "Kể câu chuyện của Bennett cho Livre nghe, lông mày của anh ấy cau lại.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						745010306
					]
				},
				{
					"id": 745010306,
					"content": "Món đồ chơi được chế tạo vì một nhà mạo hiểm tên Bennett sao? Thì ra là vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010307
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 745010307,
					"content": "Livre, còn một chuyện nữa. Mặc dù tôi không hỏi, nhưng tôi nghĩ em trai anh sẽ không giành khách của anh đâu, anh ấy nhất định sẽ không làm như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745010308,
					"content": "Tại sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010309
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 745010309,
					"content": "Hình như anh ấy cảm thấy có lỗi với anh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745010310
					]
				},
				{
					"id": 745010310,
					"content": "Sau khi kể lại lời nói của Caron. Ánh mắt của Livre dần xuyên qua các bạn, nhìn về làn sương mù chợt xa chợt gần phía trước.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						745010311
					]
				},
				{
					"id": 745010311,
					"content": "Một lúc sau, anh ấy mới thở hắt ra một chút bất mãn.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						745010312
					]
				},
				{
					"id": 745010312,
					"content": "Hừm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010313
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 745010313,
					"content": "Nói thật, tôi cũng không nghĩ thằng nhóc đó sẽ làm chuyện này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010314
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 745010314,
					"content": "Sao?! Vậy thì còn nghĩ cách đối phó gì chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745010315,
					"content": "Tôi nghĩ ông chủ chỉ đang tự tìm cho mình một cái cớ thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010316
					],
					"speakerTitle": "Arbon"
				},
				{
					"id": 745010316,
					"content": "Tôi cũng thấy vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010317
					],
					"speakerTitle": "Alberre"
				},
				{
					"id": 745010317,
					"content": "Người làm ăn mà, sao có thể để mất mặt được chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010318
					],
					"speakerTitle": "Arbon"
				},
				{
					"id": 745010318,
					"content": "Hơn nữa lại còn là anh cả, mặt mũi là trên hết rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010319
					],
					"speakerTitle": "Alberre"
				},
				{
					"id": 745010319,
					"content": "Còn nhiều lời tôi tát cho mấy cái bây giờ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010320
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 745010320,
					"content": "Livre đúng như những gì mà Caron nói.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745010321,
					"content": "Hai vị khách quý, có lẽ tôi phải đi gặp tên nhóc đó rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010322
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 745010322,
					"content": "Woa! Anh muốn xuống nước và tự đi thỉnh giáo em trai mình sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745010323,
					"content": "Tất nhiên là không. Ý của tôi là có nên cho nó một cơ hội để trực tiếp xin lỗi tôi không. Chẳng phải nó cũng nói là cảm thấy đã phản bội tôi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010324
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 745010324,
					"content": "Ừm... Mặc dù là vậy... nhưng tôi thấy đó không phải kiểu phản bội đáng để xin lỗi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745010325,
					"content": "Vậy thì... quyết định như vậy trước đi. Arbon, hủy tất cả các đơn đặt hàng, cần hoàn tiền cọc thì hoàn, bảng đánh giá cũng tạm dỡ bỏ trước đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010326
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 745010326,
					"content": "Cái gì? Ông chủ! Lẽ nào định không làm nữa sao? Vậy việc thu thập dữ liệu sau này phải làm sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010327
					],
					"speakerTitle": "Arbon"
				},
				{
					"id": 745010327,
					"content": "Thật ra cũng còn thời gian để cải thiện mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745010328
					]
				},
				{
					"id": 745010328,
					"content": "Không, việc thu thập dữ liệu vẫn phải tiếp tục, nhưng tôi có dự định khác. Hơn nữa cũng phải để hai vị lấy được thù lao chứ! Tôi rất trung thực trong kinh doanh đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010329
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 745010329,
					"content": "Sự chính trực của anh thể hiện ở những nơi thật kỳ lạ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010343
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745010343,
					"content": "Không hổ danh là ông chủ, đến cả ngang ngược cũng rất ra dáng ông chủ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010330
					],
					"speakerTitle": "Alberre"
				},
				{
					"id": 745010330,
					"content": "Hừm, thái độ của tên nhóc đó với đồ chơi cũng không phải là hết cứu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010331
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 745010331,
					"content": "Hai ngày nữa sau khi kết thúc thu thập dữ liệu, tôi sẽ ghé qua Tiệm Đồng Hồ Lepaute, hy vọng hôm đó hai vị cũng đến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010344
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 745010344,
					"content": "Hôm nay tiệm có chút việc, tôi xin phép trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010345
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 745010345,
					"content": "Livre xoay người đi vào tiệm.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						745010332
					]
				},
				{
					"id": 745010332,
					"content": "Ơ... Tính tình của Livre thật kỳ lạ... không phải đi bắt người ta xin lỗi thật đấy chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010333
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745010333,
					"content": "Ôi, xem ra lại là bên thứ ba tạo ra bước ngoặt cho câu chuyện rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010334
					],
					"speakerTitle": "Arbon"
				},
				{
					"id": 745010334,
					"content": "Cái gì? Bên thứ ba gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010335
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745010335,
					"content": "Là hai vị đó. Nhờ có hai vị mà mâu thuẫn giữa ông chủ Livre và ông chủ Caron đã có dấu hiệu lắng xuống rồi. Trước đây cũng vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010336
					],
					"speakerTitle": "Arbon"
				},
				{
					"id": 745010336,
					"content": "Trước đây cũng vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745010337
					]
				},
				{
					"id": 745010337,
					"content": "Ừm, các vị có để ý không? Giữa tiệm chúng tôi và Tiệm Đồng Hồ Lepaute là Ngân Hàng Bắc Quốc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010346
					],
					"speakerTitle": "Arbon"
				},
				{
					"id": 745010346,
					"content": "Lúc đầu thật ra ông chủ muốn mở tiệm ở cạnh Tiệm Đồng Hồ Lepaute để đối đầu với họ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010338
					],
					"speakerTitle": "Arbon"
				},
				{
					"id": 745010338,
					"content": "Khi Ngân Hàng Bắc Quốc đặt vị trí đó thì họ không biết chuyện của ông chủ. Nhưng về mặt nào đó thì như là người đứng giữa để điều đình vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010339
					],
					"speakerTitle": "Alberre"
				},
				{
					"id": 745010339,
					"content": "Thật thú vị, mặc dù Fatui rất thích nhúng tay vào chuyện của người khác, nhưng kiểu can thiệp này có vẻ là lần đầu tiên!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010340
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745010340,
					"content": "Vì vậy, bên thứ ba rất quan trọng, như \"cặp đôi hài kịch\" tung hứng nhau cũng cần có ít nhất một khán giả vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010341
					],
					"speakerTitle": "Arbon"
				},
				{
					"id": 745010341,
					"content": "Vậy hài kịch một người thì sao? Một diễn viên và một khán giả là được à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010342
					],
					"speakerTitle": "Alberre"
				},
				{
					"id": 745010342,
					"content": "Nói gì vậy? Oắt con này cũng muốn phản bội anh sao? Đập cho bây giờ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arbon"
				}
			]
		},
