			},
			"dialogs": [
				{
					"id": 745010101,
					"content": "Cảm giác như những đánh giá trên bảng tin nhắn không đúng lắm nhỉ. Đáng lẽ phải là đầy lời khen chứ? Lúc trước đâu phải thế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010102
					],
					"speakerTitle": "Arbon"
				},
				{
					"id": 745010102,
					"content": "Không như dự tính, chắc chắn có người đang bôi nhọ chúng ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010103
					],
					"speakerTitle": "Alberre"
				},
				{
					"id": 745010103,
					"content": "May mà ông chủ thông minh, sớm đã chuẩn bị phương án đối phó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010104
					],
					"speakerTitle": "Arbon"
				},
				{
					"id": 745010104,
					"content": "Tất nhiên, không thì sao làm ông chủ được chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010105
					],
					"speakerTitle": "Alberre"
				},
				{
					"id": 745010105,
					"content": "Arbon, Alberre, chủ tiệm Livre có ở đây không? Anh ấy có việc tìm chúng tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745010106,
					"content": "Tốt quá, phương án đối phó đã tới rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010107
					],
					"speakerTitle": "Arbon"
				},
				{
					"id": 745010107,
					"content": "Phương án đối phó gì cơ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745010108
					]
				},
				{
					"id": 745010108,
					"content": "Chính là hai vị đấy. Đây cũng là ý của ông chủ, giờ ông chủ không có mặt, để chúng tôi trình bày cho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010109
					],
					"speakerTitle": "Arbon"
				},
				{
					"id": 745010109,
					"content": "Vậy thì tóm tắt nhanh gọn nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010110
					],
					"speakerTitle": "Alberre"
				},
				{
					"id": 745010110,
					"content": "Mấy hôm nay chúng tôi đã công bố kế hoạch \"Đấu Sĩ Đại Diện\", quảng cáo khắp thành phố.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010138
					],
					"speakerTitle": "Arbon"
				},
				{
					"id": 745010138,
					"content": "Đã mở dịch vụ đặt hàng trước, chỉ cần trả trước một nửa là sẽ được trải nghiệm sớm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010111
					],
					"speakerTitle": "Arbon"
				},
				{
					"id": 745010111,
					"content": "Hơn nữa còn lập hẳn mục bình luận, chính là cái bảng tin nhắn ở ngay cổng. Mọi người đều có thể viết lời khen của mình lên đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010112
					],
					"speakerTitle": "Arbon"
				},
				{
					"id": 745010112,
					"content": "Cái này người ta gọi là tạo xu hướng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010113
					],
					"speakerTitle": "Alberre"
				},
				{
					"id": 745010113,
					"content": "Lúc đầu đúng như ông chủ nghĩ, danh tiếng cửa hàng lập tức nổi như cồn. Nhưng số người đặt trước thì chẳng được mấy, mục bình luận cũng không nhận được lời khen nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010114
					],
					"speakerTitle": "Arbon"
				},
				{
					"id": 745010114,
					"content": "Mà toàn là bình luận kiểu \"thiếu thành ý\", \"thiếu cốt lõi\", \"không hợp thời\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010115
					],
					"speakerTitle": "Alberre"
				},
				{
					"id": 745010115,
					"content": "Xem ra thị trường không giống như các anh nghĩ nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745010116,
					"content": "Không đơn giản như vậy, ở Fontaine có câu \"không có lửa thì làm sao có khói\". Có nghĩa là mọi việc đều có nguyên nhân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010117
					],
					"speakerTitle": "Arbon"
				},
				{
					"id": 745010117,
					"content": "Nói cách khác, có người đang phao tin vịt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010118
					],
					"speakerTitle": "Arbon"
				},
				{
					"id": 745010118,
					"content": "Bôi nhọ ác ý!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010119
					],
					"speakerTitle": "Alberre"
				},
				{
					"id": 745010119,
					"content": "Ăn nói bừa bãi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010120
					],
					"speakerTitle": "Arbon"
				},
				{
					"id": 745010120,
					"content": "Vô cớ sinh sự!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010121
					],
					"speakerTitle": "Alberre"
				},
				{
					"id": 745010121,
					"content": "Ông chủ nói, chắc chắn là do cậu em trai thuê người bôi nhọ. Kế hoạch \"Đấu Sĩ Đại Diện\" nếu thành công thì người lo nhất chính là Tiệm Đồng Hồ Lepaute.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010122
					],
					"speakerTitle": "Arbon"
				},
				{
					"id": 745010122,
					"content": "Vậy hai anh tính sao, không lẽ thuê chúng tôi bôi nhọ họ à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745010123,
					"content": "Ôi Thủy Thần Furina trên cao ơi! Sao bạn có thể nghĩ vậy chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010139
					],
					"speakerTitle": "Arbon"
				},
				{
					"id": 745010139,
					"content": "Nói sao thì ông chủ cũng là anh trai của Caron. Dù bên họ có dùng thủ đoạn thì chúng ta cũng phải đường đường chính chính đánh bại họ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010124
					],
					"speakerTitle": "Arbon"
				},
				{
					"id": 745010124,
					"content": "Chỉ có cách này thì người anh trai mới đạt được mục đích dạy dỗ em trai mình thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010125
					],
					"speakerTitle": "Alberre"
				},
				{
					"id": 745010125,
					"content": "Vậy muốn chúng tôi làm gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745010126
					]
				},
				{
					"id": 745010126,
					"content": "Khiến họ khai ra thành ý và cốt lõi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010127
					],
					"speakerTitle": "Arbon"
				},
				{
					"id": 745010127,
					"content": "Khai ra?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745010128,
					"content": "Không phải như vậy là công bằng sao? Fontaine là quốc gia của sự công bằng mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010129
					],
					"speakerTitle": "Alberre"
				},
				{
					"id": 745010129,
					"content": "Công bằng không phải như thế!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745010130,
					"content": "Ông chủ có nói, nếu khách hàng thấy bao bì của người ta có thành ý thì mình có thể đồng bộ theo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010131
					],
					"speakerTitle": "Arbon"
				},
				{
					"id": 745010131,
					"content": "Bọn họ đóng gói Nhà Mạo Hiểm thế nào, thì chúng tôi sẽ đóng gói Đấu Sĩ Đại Diện y như vậy. Cộng thêm ưu thế về mặt dữ liệu, chúng tôi sẽ lật ngược tình thế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010132
					],
					"speakerTitle": "Arbon"
				},
				{
					"id": 745010132,
					"content": "Họ đâu có đóng gói gì đâu. Chỉ đơn giản là đem câu chuyện về nhà mạo hiểm làm thành món đồ chơi thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745010133,
					"content": "Vậy thì xin hai vị hãy đi tìm hiểu xem câu chuyện đó là gì nhé! Đó chính là thứ bao bì để đóng gói sản phẩm mà chúng tôi nói đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010134
					],
					"speakerTitle": "Arbon"
				},
				{
					"id": 745010134,
					"content": "Tôi cũng nghe được chút tin tức, nói là Caron khi say đã vô tình nói ra, món đồ chơi này được làm ra vì một người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010135
					],
					"speakerTitle": "Alberre"
				},
				{
					"id": 745010135,
					"content": "Nếu như vậy thì chắc anh ta đã cùng nhà mạo hiểm đó trải qua những chuyện vô cùng thú vị nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010136
					],
					"speakerTitle": "Arbon"
				},
				{
					"id": 745010136,
					"content": "#Hửm?! Caron và nhà mạo hiểm à? Tôi cũng muốn biết là đã xảy ra chuyện gì ghê. {NICKNAME}, hay là chúng ta lại qua đó hỏi thử xem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745010137,
					"content": "Tuyệt quá! Vậy thì giao cho hai vị rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arbon"
				}
			]
		},
		{
			"id": 7450102,
			"completionStepIds": [
				7450102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
