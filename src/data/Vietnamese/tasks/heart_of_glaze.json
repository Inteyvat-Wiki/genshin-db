				"points": []
			},
			"dialogs": [
				{
					"id": 10230301,
					"content": "Woa, đây là <color=#00E1FFFF>Hoàng Kim Ốc</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10230302,
					"content": "Bên ngoài xem ra đã rất có khí thế rồi, không ngờ bên trong còn xa xỉ hơn! Còn nữa... còn nữa, khắp nơi đều là Mora!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10230303,
					"content": "Nếu tất cả Mora của Teyvat đều được tạo ra ở đây, vậy... vậy nhiều một chút hay ít một chút cũng rất khó bị phát hiện?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230304,
						10230305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10230304,
					"content": "Đừng giơ tay, giơ tay ắt sẽ bị bắt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230306
					]
				},
				{
					"id": 10230306,
					"content": "Thì ra là bẫy dạng mồi nhử, nguy hiểm thật! May mà có bạn nhắc nhở!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10230307,
					"content": "Nhưng dù không thể cầm, khoảng cách gần chắc không có vấn đề gì nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10230308,
					"content": "Nếu được thì tôi vẫn muốn nằm bên trong đánh một giấc! Dùng Mora làm chăn, ngủ mơ cũng thấy thật đẹp, he he he...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230309,
						10230310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10230309,
					"content": "Hay là cứ đi xác nhận tình hình Tiên Tổ Pháp Thoái trước.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230311
					]
				},
				{
					"id": 10230311,
					"content": "À, đúng rồi, chuyện chính quan trọng hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10230312,
					"content": "Nơi này... cũng quá yên tĩnh rồi ư? Tiên Tổ Pháp Thoái là thứ quan trọng như vậy, chắc chắn phải có người trông coi chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10230313,
					"content": "#Ấy?! {NICKNAME}, bạn coi, đó là cái gì!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230314,
						10230315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10230314,
					"content": "Là Thiên Nham Quân.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230315
					]
				},
				{
					"id": 10230315,
					"content": "Hình như đã ngất xỉu hết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230316
					]
				},
				{
					"id": 10230316,
					"content": "...Hừm, cảm giác tình hình không ổn rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10230317,
					"content": "Chúng ta mau đi xác nhận xem Tiên Tổ Pháp Thoái có gì bất thường không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10230310,
					"content": "Bầu không khí ở đây có vẻ... kỳ quái.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230311
					]
				},
				{
					"id": 10230305,
					"content": "Nếu đơn giản như vậy, thì sớm đã loạn rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230306
					]
				}
			]
		},
