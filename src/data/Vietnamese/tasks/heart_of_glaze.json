				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Childe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10230501,
					"content": "Phù...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230502
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10230502,
					"content": "Hả, hắn ta biến thành hình dạng cũ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230546
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10230546,
					"content": "Cũng nên... bình tĩnh một chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230503
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10230503,
					"content": "\"Trang Phục Ma Vương\" vừa rồi rất nặng, làm tôi không có cơ hội ngừng lại để suy nghĩ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230504
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10230504,
					"content": "#Nhưng xét cho cùng, {F#cô}{M#cậu} quả thật không có khả năng giành được \"Gnosis\" trước tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230505
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10230505,
					"content": "Vậy \"Gnosis\" hiện đang ở đâu... Các bạn cũng không biết phải không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230506
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10230506,
					"content": "Đúng vậy, đã nói là không phải bọn tôi lấy rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10230507,
					"content": "#Nhà Lữ Hành, thực lực của {F#cô}{M#cậu} ngày hôm nay đã vượt xa đánh giá của Signora khi ở Mondstadt, chuyện này là sao chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230508,
						10230509
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10230508,
					"content": "(Là vì tôi đang thu thập 7 loại nguyên tố...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230510
					]
				},
				{
					"id": 10230510,
					"content": "#Xem ra {F#cô}{M#cậu} đã tìm được đáp án của riêng mình rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230511
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10230511,
					"content": "Nếu đó là bí mật không thể nói ra vậy thì tôi chỉ có thể miễn cưỡng kìm nén sự tò mò của bản thân vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230512
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10230512,
					"content": "Trận chiến ngày hôm nay khiến tôi rất vui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230513
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10230513,
					"content": "Những kẻ có khát vọng trở thành kẻ mạnh, thì đều là bạn của tôi. Cho dù tình bạn này về bản chất chính là tranh đấu bài trừ lẫn nhau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230514
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10230514,
					"content": "Đúng là mối quan hệ bạn bè kỳ quặc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10230515,
					"content": "Bây giờ tôi phải quay trở về với nhiệm vụ chính của mình, không thể tiếp chuyện với hai người nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230516
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10230516,
					"content": "\"Gnosis\" không bị ai lấy cắp, chẳng lẽ... Ngay từ đầu nó không nằm trong \"Tiên Tổ Pháp Thoái\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230517
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10230517,
					"content": "Nghĩ kỹ một chút lẽ nào \"Tiên Tổ Pháp Thoái\" chỉ dùng để che mắt người đời?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230518
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10230518,
					"content": "Như vậy có nghĩa là....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230519,
						10230520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10230519,
					"content": "Nham Vương Đế Quân vẫn còn sống?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230521
					]
				},
				{
					"id": 10230521,
					"content": "Có vẻ là như vậy. Quả là thú vị đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230522
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10230522,
					"content": "Không hổ danh là vị thần bảo vệ của thủ đô thương mại này, xem ra ông ta không chỉ am hiểu \"khế ước\" mà còn biết nhiều thủ đoạn khác nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230523
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10230523,
					"content": "Vậy thì chỉ có thể dùng \"phương án phòng bị\" rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230524
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10230524,
					"content": "Phương án phòng bị?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230525
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10230525,
					"content": "Vốn không muốn dùng cách này, vì sẽ liên lụy đến những kẻ yếu thế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230526
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10230526,
					"content": "Xét cho cùng thế giới này cũng chỉ dành cho những kẻ mạnh mà thôi. Còn những kẻ yếu thế kém cỏi thì tôi cũng chẳng thèm để ý đến họ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230527
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10230527,
					"content": "Nhưng với thân phận là Quan Chấp Hành Fatui, tôi không thể cứ kén cá chọn canh mãi được. Giống như trẻ nhỏ phải học cách ăn cà rốt, cho dù đó là món mà chúng không thích.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230528
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10230528,
					"content": "Vậy... Anh muốn làm gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230529
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10230529,
					"content": "Tôi sẽ đánh thức Ma Thần ngủ say dưới \"Cô Vân Các\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230530
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10230530,
					"content": "Ma Thần ư?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230531
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10230531,
					"content": "<color=#00E1FFFF>Ma Thần Lốc Xoáy - Osial</color>. Trong cuộc chiến ma thần, đây là kẻ thất bại dưới bàn tay của Nham ma thần - Morax và bị trấn áp dưới đáy biển.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230532
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10230532,
					"content": "Nếu để một vị Ma Thần cổ xưa tấn công cảng Liyue, nơi không còn thần linh ngự trị thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230533
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10230533,
					"content": "Nham Vương Đế Quân, người đã chơi chúng ta một vố đau như thế sẽ có thể bình tĩnh ngồi xem tiếp vở kịch này hay không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230534
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10230534,
					"content": "Nhưng... Chiến tranh ma thần đã kết thúc cách đây hơn hai nghìn năm rồi. Trên thế giới này chỉ còn bảy vị thần, anh làm sao có thể hồi sinh Ma Thần viễn cổ cơ chứ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230535
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10230535,
					"content": "Đương nhiên là tôi đã chuẩn bị xong mọi thứ để tiến hành nghi thức \"đánh thức\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230536
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10230536,
					"content": "Hả! Lẽ nào là \"Bách Vô Cấm Kỵ Lục\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230537
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10230537,
					"content": "Tôi nhớ ra rồi! Chúng ta từng phát hiện ra người Fatui đang nghiên cứu nó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230538,
						10230539
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10230538,
					"content": "Tôi tận mắt nhìn thấy nơi nghiên cứu của bọn chúng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230540
					]
				},
				{
					"id": 10230540,
					"content": "Không sai, bức vẽ đưa cho hai người chỉ là một bản sao từ nơi nghiên cứu của bọn tôi mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230541
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10230541,
					"content": "Tất cả sức mạnh của nhiều \"Bách Vô Cấm Kỵ Lục\" tập hợp lại một chỗ, kết hợp với nguồn sức mạnh của Nữ Hoàng ban tặng cho Quan Chấp Hành... thì việc tạm thời hóa giải phong ấn của thương đá cũng không phải là khó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230544
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10230544,
					"content": "Ban đầu, đối với tôi mà nói, việc sử dụng sức mạnh của Ma Thần viễn cổ là bước đường cùng, cũng là điều đi ngược lại với đạo đức của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230545
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10230545,
					"content": "Nhưng nghĩ đến viễn cảnh các người phải trợ giúp vị Nham Thần đó đứng ra ứng phó... Lại cảm thấy vô cùng thú vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Childe"
				},
				{
					"id": 10230539,
					"content": "Các người đang cố gắng \"sao chép\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230540
					]
				},
				{
					"id": 10230520,
					"content": "Còn tiên thể kia chỉ là đồ giả?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230521
					]
				},
				{
					"id": 10230509,
					"content": "(Là vì tôi đang dần khôi phục lại sức mạnh...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230510
					]
				}
			]
		}
	]
}