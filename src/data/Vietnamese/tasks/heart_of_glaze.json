			},
			"dialogs": [
				{
					"id": 10230201,
					"content": "Nhiệm vụ \"người dẫn đường\" của các ngươi đã hoàn thành, tại sao vẫn muốn tự tìm rắc rối?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230202
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10230202,
					"content": "Hửm? Ai vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10230203,
					"content": "Nếu các ngươi là Fatui, có lẽ đã có thể nhận được một phần thưởng hậu hĩnh của nữ hoàng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230204
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10230204,
					"content": "Nhưng đáng tiếc, hiện tại chỉ là một chướng ngại vô giá trị mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230205,
						10230208
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10230205,
					"content": "Sao ngươi lại biết được chỗ này?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230206
					]
				},
				{
					"id": 10230206,
					"content": "Nên bắt đầu từ đâu nhỉ? Đi đường vòng không phải phong cách của ta, nhưng ai biết được khi vừa đến Liyue thì Nham Thần lại chết một cách kỳ lạ, Tiên Tổ Pháp Thoái lại bị giấu đi mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230207
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10230207,
					"content": "Nếu không nhân cơ hội các ngươi chuẩn bị tổ chức Điển Lễ Tiễn Tiên, có được một số tin tức, có lẽ còn rắc rối hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230211
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10230211,
					"content": "Hừm... cho dù có phải ngừng đúc Mora cũng muốn giấu Tiên Tổ Pháp Thoái... Thất Tinh thật là đã dốc cạn vốn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230212
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10230212,
					"content": "Hoá... hoá ra là ngươi muốn tìm Gnosis bên trong Tiên Tổ Pháp Thoái?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10230213,
					"content": "Là một trong mười một quan chấp hành Fatui, nhất định phải thực hiện mệnh lệnh của Nữ Hoàng Băng Giá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230214
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10230214,
					"content": "Thứ nữ hoàng muốn, bọn ta sẽ lấy về.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230215,
						10230216
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10230215,
					"content": "Ta không cho phép.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230217
					]
				},
				{
					"id": 10230217,
					"content": "Vấn đề không nằm ở ai sẽ cho phép ta, mà là ai có thể ngăn cản ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230218
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10230218,
					"content": "Thời gian của giao dịch và kế hoạch cuối cùng đã kết thúc rồi... Thật ra ta cũng rất ghét những mánh khoé đó, nhưng vì nữ hoàng ta có thể chịu đựng được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230219
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10230219,
					"content": "Tiếp theo, chúng ta có thể tận hưởng một chút đơn giản, vui vẻ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230220
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10230220,
					"content": "Đó chính là chiến đấu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230221
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10230221,
					"content": "Chiến đấu? Ngươi là loại người thích tìm ai đó để đánh lộn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10230222,
					"content": "Hahaha, có thể nói như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230223
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10230223,
					"content": "Ở bên ngoài giáo đường Mondstadt, Signora đã mạo phạm thần linh, sau khi thành công thì vội vàng rời khỏi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230224
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10230224,
					"content": "Cô ta thà dựa vào băng tuyết để ngăn chặn hành động của mọi người, cũng không muốn đánh một trận với ngươi, là vì không muốn thu hút sự chú ý của kỵ sĩ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230225
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10230225,
					"content": "Đối mặt với kẻ mạnh, cô ta chỉ ưu tiên lợi ích, cân nhắc được thua, suy nghĩ đến sự ảnh hưởng sau khi ra tay...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230226
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10230226,
					"content": "Thế nhưng điều thú vị nhất khi trở thành một \"Quan Chấp Hành\" đó là được chiến đấu với kẻ mạnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230227
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10230227,
					"content": "Sự việc từng diễn ra ở Mondstadt sẽ không còn tái diễn nữa đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10230228,
					"content": "Được thôi, vậy thì đến thử nào? Ta sẽ không giết ngươi, Nhà Lữ Hành. Ta chỉ muốn tận hưởng niềm vui khi được chiến đấu mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230229
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10230229,
					"content": "Ngươi đánh không lại ta đâu, vì vậy đừng có cố gắng đánh thắng. Chỉ cần tận hưởng niềm vui như ta đây này. Nói như vậy chắc ngươi đã hiểu phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230230
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10230230,
					"content": "Ta đánh không thắng được ngươi ư? Ngươi có biết mình đang nói gì không.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230231
					]
				},
				{
					"id": 10230231,
					"content": "Haha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230232
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10230232,
					"content": "Xem ra ngươi cũng muốn thử sức, vậy thì đừng làm ta thất vọng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Childe"
				},
				{
					"id": 10230216,
					"content": "Sẽ không để ngươi đến gần Tiên Tổ Pháp Thoái.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230217
					]
				},
				{
					"id": 10230208,
					"content": "Bây giờ đuổi theo cũng không phải muộn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230209
					]
				},
				{
					"id": 10230209,
					"content": "Mặc dù cảm ơn các ngươi đã khiến ta không phí chút sức lực nào mà tìm thấy được nơi bị che giấu này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230210
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10230210,
					"content": "Nhưng bây giờ muốn ngăn chặn ta? Đừng phí công vô ích.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230211
					],
					"speakerTitle": "Childe"
				}
			]
		},
		{
