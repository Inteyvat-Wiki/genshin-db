			"dialogs": [
				{
					"id": 762030101,
					"content": "Ồ, đến rồi à! Tôi còn đang nghĩ xem có cần phải đưa ra gợi ý rõ ràng hơn không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030102
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030102,
					"content": "Nhưng lại nghĩ nếu gợi ý quá rõ ràng, sẽ làm gián đoạn kế hoạch du lịch của hai người...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030103
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030103,
					"content": "Và ngay lúc tôi đang do dự thì mọi người xuất hiện như cơn mưa rào giải hạn, có thể nói đôi bên đều vui vẻ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030104
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030104,
					"content": "Xin chào, Nicole, trông cô có vẻ rất phấn chấn! Hơn nữa... hôm nay cô cũng rất hoạt ngôn đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030105,
					"content": "Vậy tôi sẽ xem đây như lời khen. Được rồi, đến phòng tiếp theo xem thử nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				}
			]
		},
		{
			"id": 7620302,
			"completionStepIds": [
				7620302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
