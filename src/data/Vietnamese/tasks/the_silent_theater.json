			"dialogs": [
				{
					"id": 762030401,
					"content": "Ồ! Là Simulanka! Ơ... Sao trên mặt đất còn có cả tiểu thuyết của Nhà Xuất Bản Yae?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030402,
					"content": "Nhắc đến người khai sáng cho việc viết lách của tôi, đương nhiên là quý cô Anya mà tôi kính yêu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030403
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030403,
					"content": "Cô ấy là người gia nhập Hội Ma Nữ muộn nhất, nhưng cũng là người rời đi sớm nhất...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030404
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030404,
					"content": "Tôi thích mọi câu chuyện của cô ấy. Dù đó chỉ là một ý tưởng hay một bản thảo hoàn chỉnh, Anya đều rất giỏi mang đến những điều bất ngờ cho độc giả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030405
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030405,
					"content": "Hội Ma Nữ không thể thiếu những cuộc trò chuyện về phép thuật, tôi nghĩ Anya sở hữu một loại phép thuật đặc biệt, có thể dệt tình yêu và sự quan tâm thành những con chữ lay động người khác, hay những tình tiết thú vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030406
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030406,
					"content": "Tôi đã từng hỏi cô ấy về cách viết một câu chuyện hay, học được không ít kỹ thuật, nhưng cuối cùng kẻ thù lớn nhất của tôi vẫn là chính mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030407
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030407,
					"content": "Lười viết à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762030408
					]
				},
				{
					"id": 762030408,
					"content": "Đúng vậy, chính là ý này. Việc trực tiếp trao đổi bằng ý nghĩ quá tiện, cho dù là thiên sứ cũng sẽ có lúc lười biếng mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030409
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030409,
					"content": "Nhưng gần đây tôi quyết định sẽ cố gắng một chút, để tránh mỗi lần gặp mặt, người bạn cũ Tiên Linh nào đó cứ luôn phàn nàn về tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030410
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030410,
					"content": "Ồ! Cuối cùng cũng sắp được đọc tiểu thuyết do Nicole viết rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030411,
					"content": "Ai nói là sẽ viết chứ. Chỉ là mua một số tác phẩm nổi tiếng vài trăm năm gần đây để đọc cho vui thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030412
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030412,
					"content": "Đúng vậy, chính là ý này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030413
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030413,
					"content": "Việc trực tiếp trao đổi bằng ý nghĩ quá tiện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030414
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030414,
					"content": "Cho dù là thiên sứ cũng sẽ có lúc lười biếng mà.",
					"roleType": "TALK_ROLE_NPC",
