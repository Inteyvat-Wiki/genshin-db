			"dialogs": [
				{
					"id": 762030301,
					"content": "Cổ Thụ Irminsul?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030302,
					"content": "Ồ, là bức tranh này, hai người chắc không còn xa lạ gì với cây trắng nữa, nhưng hai người có biết, sự phản bội đầu tiên của thiên sứ là diễn ra ngay dưới gốc cây trắng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030303,
						762030304
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030303,
					"content": "Tôi không rõ lắm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762030305
					]
				},
				{
					"id": 762030305,
					"content": "Tôi hơi tò mò rồi đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030306,
					"content": "Ừm, thế thì để kể cho nghe một câu chuyện tình yêu kinh dị vậy. Để tôi giữ kín danh tính của nhân vật chính nhé... Có rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030307
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030307,
					"content": "#Ngày xửa ngày xưa, có một nhà lữ hành lang thang giữa các vì sao ... Khác với {NICKNAME}, nói ra thì dài lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030308
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030308,
					"content": "Một ngày nọ, anh ta đến thăm công chúa Sao Mai dưới gốc Cổ Thụ Irminsul, không lâu sau đã hỏi cô ấy về những bí mật cấm kỵ nhất của vương quốc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030309
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030309,
					"content": "Lời nói của anh ta khiến công chúa nghi ngờ: Làm sao anh ta biết được những chuyện mà thần linh không cho phép?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030310
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030310,
					"content": "Chàng trai tiết lộ lai lịch của mình, đồng thời cũng cho công chúa thấy những điều mà cô chưa từng thấy, đó là ý chí tự do và tình yêu cao cả từ tâm hồn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030311
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030311,
					"content": "Lời nói của chàng trai đã đánh thức bản ngã bị thần linh giam cầm của công chúa, trái tim cô bay bổng, vượt qua những rào cản mà trước đây chưa từng vượt qua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030312
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030312,
					"content": "Công chúa Sao Mai kể cho chàng trai nghe về bí mật của vương quốc, giữa hai người không chỉ nảy sinh tình cảm mà còn nảy sinh quyết tâm chống lại thần linh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030313
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030313,
					"content": "Đến đây thì vẫn là một câu chuyện tình yêu quen thuộc phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030314,
					"content": "Phần đáng sợ sắp đến rồi. Họ khao khát giúp người dân có được cuộc sống tự do không bị trói buộc, nhưng sự phản bội này sẽ không được thần linh tha thứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030315
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030315,
					"content": "Thần linh giáng xuống sấm sét và lửa giận, hủy diệt nơi ở của họ. Sau khi cuộc chiến lắng xuống, công chúa đã mãi mãi mất đi sức mạnh và trí tuệ của mình...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030316
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030316,
					"content": "Thậm chí ngay cả những người bạn từng thân thiết với cô cũng bị nguyền rủa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030317
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030317,
					"content": "Ôi... Phần kết thật đáng sợ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030318,
					"content": "Nhưng trước đó chúng ta đã nói từ thiên sứ đầu tiên sang câu chuyện này? Chẳng lẽ chuyện cô vừa kể là có thật sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030319,
					"content": "Ừm, đúng vậy, đó mới là phần đáng sợ nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030320
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030320,
					"content": "Ừm, thế thì để kể cho nghe một câu chuyện tình yêu kinh dị vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030321
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030321,
					"content": "Để tôi giữ kín danh tính của nhân vật chính nhé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030322
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030322,
					"content": "Có rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030304,
					"content": "Hình như có nghe qua...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762030305
					]
				}
			]
		},
