					"Nicole"
				],
				"points": [
					{
						"sceneId": 20360,
						"position": [
							589.654,
							904.556,
							494.111
						],
						"pointId": 5
					},
					{
						"sceneId": 20360,
						"position": [
							588.836,
							904.613,
							494.721
						],
						"pointId": 6
					},
					{
						"sceneId": 20360,
						"position": [
							589.08,
							904.586,
							495.725
						],
						"pointId": 7
					}
				]
			},
			"dialogs": [
				{
					"id": 762030201,
					"content": "Ối, làm tôi hết hồn! Đột nhiên bị hút vào trong tranh. Đợi đã, cảnh tượng này trông quen quá... Là chiếc bàn dài để các ma nữ tụ họp!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030202,
					"content": "...Cụ thể thì phải kể từ lần đầu tôi được Alice mời tham gia tiệc trà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030203
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030203,
					"content": "Nhưng hôm đó tôi không trực tiếp xuất hiện, vì lúc đó tôi còn chưa quyết định có nên chính thức gia nhập Hội Ma Nữ hay không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030204
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030204,
					"content": "Trong số những người có mặt chỉ có Alice biết thân phận thật của tôi, trước đó cô ấy đã nhắc tôi không được nói chuyện, đừng để lộ sơ hở, cứ im lặng quan sát mọi người là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030205
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030205,
					"content": "Sau đó thì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030206,
					"content": "...Sau đó tôi nghĩ rằng đó là sự trừng phạt cho việc tôi đã do dự.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030207
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030207,
					"content": "Nội dung trò chuyện của mọi người thú vị như vậy, sao có thể nhịn được mà không chen ngang chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030208
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030208,
					"content": "Đang nói chuyện bỗng có người đưa ra một vấn đề mà bản thân biết rõ câu trả lời, thì sao có thể nhịn được mà không chia sẻ chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030209
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030209,
					"content": "Còn phải kể đến cuộc cá cược giữa Alice và Barbeloth, sáng tạo cấm kỵ của Rhinedottir, thủ đoạn chính trị của Ivanovna...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030210
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030210,
					"content": "Quả thực là từng màn kịch tuyệt vời được cô đọng lại trong tách trà, chỉ bằng lời nói thôi cũng đã kích thích bản năng muốn vạch trần chân tướng trong tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030211
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030211,
					"content": "Vậy cô có nói chuyện trong đầu mọi người không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030212,
					"content": "Sao có thể chứ, cho dù nhịn đến khó thở, tôi cũng vẫn là một thiên sứ có trách nhiệm, hiểu được sự khác biệt giữa \"muốn nói\" và \"có thể nói\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030213
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030213,
					"content": "Thế nên cuối cùng, tôi cũng chỉ tìm riêng Alice để nói hết một mạch cho đã, đồng thời nhận lời gia nhập Hội Ma Nữ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030214
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030214,
					"content": "Cô ấy chấp nhận vế sau rất nhanh, nhưng vế trước thì... Cô ấy nói mấy hôm đó đau đầu đến nỗi phải tới Liyue tìm thầy thuốc, nhưng chuyện này cũng đâu thể đổ hết lên đầu tôi được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				}
			]
		},
