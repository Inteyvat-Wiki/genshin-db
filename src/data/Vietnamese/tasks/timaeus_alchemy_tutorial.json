				},
				{
					"id": 200390503,
					"content": "Muốn luyện thành [Tinh Dầu Băng Giá], bạn cần tìm Đuôi Rồng Đất và Đóa Băng Vụ Hoa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390504
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390504,
					"content": "Hai nguyên liệu này ở ngoài thành cũng thường nhìn thấy... Đuôi Rồng Đất có tác dụng gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390505
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390505,
					"content": "Đuôi Rồng Đất được đông cứng giòn tan, sẽ giúp cho thuốc có mùi vị ngon hơn...",
					"roleType": "TALK_ROLE_NPC",
