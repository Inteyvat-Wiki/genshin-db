				{
					"id": 200390101,
					"content": "Muốn cảm nhận Thuật Giả Kim",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390102
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390102,
					"content": "Thuật giả kim cổ đại thật là kỳ diệu... thật mong có thể giúp thêm nhiều người hiểu về nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390103
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390103,
					"content": "Hử? Bạn cũng có hứng thú với thuật giả kim sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390104
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390104,
					"content": "Rất có hứng thú.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200390105
					]
				},
				{
					"id": 200390105,
					"content": "Vậy thì bạn hãy tự tay trải nghiệm thuật giả kim đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390106
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390106,
					"content": "Bất kỳ thành tựu vĩ đại nào, đều xuất phát từ căn bản thiết thực nhất.",
					"roleType": "TALK_ROLE_NPC",
