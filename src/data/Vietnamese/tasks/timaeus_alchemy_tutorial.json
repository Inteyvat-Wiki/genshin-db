			"dialogs": [
				{
					"id": 200390401,
					"content": "Bạn hãy thử chế tạo một [Tinh Dầu Sấm Sét]",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390402
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390402,
					"content": "Nó là sản phẩm giả kim cơ bản. Thích hợp nhất để luyện tập nhập môn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390403
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390403,
					"content": "Muốn luyện thành [Tinh Dầu Sấm Sét], cần nguyên liệu là Pha Lê Điện và Ếch Xanh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390404
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390404,
					"content": "Hai nguyên liệu này đều có thể tìm được ở ngoài thành... Sao cơ? \"Pha lê\" có vẻ không liên quan gì với \"tinh dầu\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390405
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390405,
					"content": "Hahaha, đương nhiên, vì Pha Lê Điện để tạo \"Sấm Sét\", Ếch Xanh là nguyên liệu chủ yếu của \"Tinh Dầu\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390406
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390406,
					"content": "Sau khi tìm đủ nguyên liệu, bạn hãy thử chế tạo [Tinh Dầu Sấm Sét]. Hãy tự tin thử nghiệm, tôi sẽ ở bên cạnh giúp bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390407
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390407,
					"content": "Tôi biết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
