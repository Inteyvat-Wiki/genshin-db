			},
			"dialogs": [
				{
					"id": 740812401,
					"content": "Thu hồi những cuộn băng đục lỗ này phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740812402,
					"content": "Đưa cho Sevigne xem cuộn băng đục lỗ đã thu hồi...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740812403
					]
				},
				{
					"id": 740812403,
					"content": "Đúng vậy, chính là những thứ này. Các bạn làm việc rất hiệu quả, không hề lề mề dây dưa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812404
					],
					"speakerTitle": "Sevigne"
				},
				{
					"id": 740812404,
					"content": "Công việc đơn giản như vậy, đương nhiên là làm vèo vèo rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740812405,
					"content": "Vậy là rất giỏi rồi. Tôi không nói quá, chứ có những đồng nghiệp tốn cả một ngày chỉ để tìm một bản tài liệu đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812406
					],
					"speakerTitle": "Sevigne"
				},
				{
					"id": 740812406,
					"content": "Thôi không nói nữa. Phiền hai bạn đem những cuộn băng đục lỗ này về cho cô Chisseray nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812407
					],
					"speakerTitle": "Sevigne"
				},
				{
					"id": 740812407,
					"content": "Nói với cô ấy tạm thời tôi sẽ chưa về. À, còn nữa, nhờ cô ấy liên hệ đàn anh Maillardet mau chóng tới thu hồi máy thí nghiệm ở đây nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812408
					],
					"speakerTitle": "Sevigne"
				},
				{
					"id": 740812408,
					"content": "#Được rồi. Vậy {NICKNAME}, chúng ta quay lại đường cũ nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740812409,
					"content": "À, không cần vậy đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812410
					],
					"speakerTitle": "Sevigne"
				},
				{
					"id": 740812410,
					"content": "Hai vị chắc lặn được chứ? Thực ra bên này có một đường nước dẫn ra ngoài, lúc trước tạm chặn lại để đề phòng trượt chân, để tôi mở cho hai người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812411
					],
					"speakerTitle": "Sevigne"
				},
				{
					"id": 740812411,
					"content": "#Vậy thì tốt quá! {NICKNAME}, chúng ta trở về bằng đường thủy đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740812412,
					"content": "Thiết bị mở lối đi ở bên trong, để tôi đi là được. Hai người tự rời đi sẽ ổn thôi phải không? Sẽ không lạc đường đấy chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812413
					],
					"speakerTitle": "Sevigne"
				},
				{
					"id": 740812413,
					"content": "#Vậy thì cô đánh giá thấp chúng tôi quá rồi! Tôi là người dẫn đường giỏi nhất Teyvat đấy, có tôi ở đây thì sao mà {NICKNAME} lạc đường được?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740812414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740812414,
					"content": "Uy tín quá nhỉ. Vậy chuyện gửi lời nhắn và cuộn băng, xin nhờ hai vị nhé, tôi không tiễn nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sevigne"
				}
			]
		},
