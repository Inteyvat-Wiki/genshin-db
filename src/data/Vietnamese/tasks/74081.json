					}
				]
			},
			"dialogs": [
				{
					"id": 740811701,
					"content": "Khụ... Không phải... Không phải chúng ta gây họa lớn rồi đấy chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740811702,
					"content": "Thật kỳ lạ, vừa rồi tôi cảm thấy một cơn rung lắc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811703,
						740811704
					],
					"speakerTitle": "Sevigne"
				},
				{
					"id": 740811703,
					"content": "Tôi cũng cảm thấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811705
					]
				},
				{
					"id": 740811705,
					"content": "À, có thể do vừa rồi chúng ta động vào thiết bị tầng trên...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740811706,
					"content": "Cánh cửa nơi này vốn bị khóa phải không? Còn cố tình đặt vài Robot Dây Cót ở cửa để canh gác nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811707,
						740811708
					],
					"speakerTitle": "Sevigne"
				},
				{
					"id": 740811707,
					"content": "Tôi mời chúng đi nghỉ ngơi và mở cửa rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811709
					]
				},
				{
					"id": 740811709,
					"content": "Việc... Việc này cũng hết cách, do chúng tấn công chúng tôi trước, chúng tôi làm vậy là phòng vệ chính đáng chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740811710,
					"content": "Máy thí nghiệm của đàn anh Maillardet... vốn phải ở trạng thái ngừng hoạt động chứ. Dù sao, từ khi anh ấy tìm được một địa điểm tốt ở Đảo Erinnyes thì hầu như không trở lại nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811711
					],
					"speakerTitle": "Sevigne"
				},
				{
					"id": 740811711,
					"content": "Nghĩ cũng phải, nếu kết quả nghiên cứu được trưng bày cho mọi người ở một không gian tuyệt đẹp như sân khấu trong vườn đó, thì ai lại muốn trở về căn phòng nghiên cứu ẩm thấp xập xệ này chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811712
					],
					"speakerTitle": "Sevigne"
				},
				{
					"id": 740811712,
					"content": "Sau khi Ngài Bossuet từ chức, mọi người tản ra khắp Viện Khoa Học Fontaine như chính tài sản của nơi này vậy, ngay cả ghế sofa cũng không còn cái nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811713
					],
					"speakerTitle": "Sevigne"
				},
				{
					"id": 740811713,
					"content": "Chỉ có máy thí nghiệm là vẫn ở đây, chờ đợi những người sẽ không trở về nữa. Vốn chỉ là đứng đợi ở đây thôi, cũng chẳng có gì to tát với chúng, nhưng mà bây giờ thì hay ho rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811714
					],
					"speakerTitle": "Sevigne"
				},
				{
					"id": 740811714,
					"content": "Nhìn xem, bị đánh cho tan tác, dây cót cũng sắp rụng ra rồi. Nếu đàn anh Maillardet mà biết...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811715,
						740811716
					],
					"speakerTitle": "Sevigne"
				},
				{
					"id": 740811715,
					"content": "Là tôi làm đấy, xin lỗi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811718
					]
				},
				{
					"id": 740811718,
					"content": "Xin lỗi... Máy... Máy thí nghiệm này đắt lắm à? Nếu như phải bồi thường...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811719
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740811719,
					"content": "Đừng lo lắng. Ý tôi muốn nói là, nếu anh Maillardet mà biết thì chắc chắn sẽ cười ầm lên mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811720
					],
					"speakerTitle": "Sevigne"
				},
				{
					"id": 740811720,
					"content": "Dù sao trước đây chính anh ấy cũng thường chủ động cắt ngang vũ điệu của máy thí nghiệm, sau khi bị quật ngã thì lại ngồi yên cười haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811721
					],
					"speakerTitle": "Sevigne"
				},
				{
					"id": 740811721,
					"content": "Phải rồi, nói lâu như vậy mà vẫn chưa giới thiệu. Tôi là nhà nghiên cứu của Viện Khoa Học Fontaine, các bạn có thể gọi tôi là Sevigne. Hai bạn đây là?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811722
					],
					"speakerTitle": "Sevigne"
				},
				{
					"id": 740811722,
					"content": "#Tôi là Paimon, {M#cậu ấy}{F#cô ấy} là {NICKNAME}, chúng tôi là... Khụ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811723,
						740811725
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740811723,
					"content": "Là người đi ngang qua thôi, tuyệt đối không có ý gì khác.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811724
					]
				},
				{
					"id": 740811724,
					"content": "Phải! Chúng tôi chỉ đi ngang qua đây thôi, tuyệt đối không phải tưởng nơi này có kho báu gì nên mới...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811726
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740811726,
					"content": "Ồ, ý là các bạn sẽ sắp xếp một vài chuyến tham quan di tích để tìm kho báu à? Vậy thì các bạn tìm nhầm chỗ rồi, mặc dù nơi này cũng giống di tích... À không, thực tế thì cũng là di tích.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811727
					],
					"speakerTitle": "Sevigne"
				},
				{
					"id": 740811727,
					"content": "Nhưng nơi này vẫn chưa được đưa vào địa điểm đề xuất du lịch di tích đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811728
					],
					"speakerTitle": "Sevigne"
				},
				{
					"id": 740811728,
					"content": "Được rồi, vậy chúng tôi đi ngay đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811729
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740811729,
					"content": "...Khoan đã, các bạn biết Viện Khoa Học Fontaine Mới chứ? Nếu đi thì tiện thể giúp tôi một chuyện, đó là đến Viện Khoa Học Fontaine Mới tìm Chisseray...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811730,
						740811731
					],
					"speakerTitle": "Sevigne"
				},
				{
					"id": 740811730,
					"content": "Nhưng mà chúng tôi không đến Viện Khoa Học Fontaine Mới.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811732
					]
				},
				{
					"id": 740811732,
					"content": "Vậy phải làm sao đây, tôi vẫn còn công việc chưa giải quyết xong, máy thí nghiệm của anh Maillardet thì lại hỏng rồi, cần nhanh chóng tìm người thu hồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811733
					],
					"speakerTitle": "Sevigne"
				},
				{
					"id": 740811733,
					"content": "#Hmm... {NICKNAME}, hay là chúng ta giúp cô ấy chuyện này đi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811734
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740811734,
					"content": "Tốt quá! Nếu các bạn đồng ý giúp, vậy thì việc thu hồi băng giấy đục lỗ cũng xin nhờ các bạn nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811735,
						740811736
					],
					"speakerTitle": "Sevigne"
				},
				{
					"id": 740811735,
					"content": "Biết vậy đã không động chạm linh tinh vào thiết bị bên ngoài rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811746
					]
				},
				{
					"id": 740811746,
					"content": "Đừng nói vậy, dù sao cũng không phải việc gì khó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811737
					],
					"speakerTitle": "Sevigne"
				},
				{
					"id": 740811737,
					"content": "Có tiếng giúp thu hồi tài liệu nghiên cứu là sẽ được viện giải chi tiền công ủy thác rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811738
					],
					"speakerTitle": "Sevigne"
				},
				{
					"id": 740811738,
					"content": "Hả? Làm vậy không sao thật chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811739
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740811739,
					"content": "Suy cho cùng thì hỗ trợ công việc nghiên cứu là chính đáng, tất nhiên là không vấn đề gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811740
					],
					"speakerTitle": "Sevigne"
				},
				{
					"id": 740811740,
					"content": "Vả lại, nếu thực sự sai quy định thì sẽ bị nhân viên hành chính bãi bỏ. Lúc đó thì tôi đành tự chịu phí ủy thác thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811741
					],
					"speakerTitle": "Sevigne"
				},
				{
					"id": 740811741,
					"content": "Mọi người thường xuyên làm chuyện như vậy à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811742
					]
				},
				{
					"id": 740811742,
					"content": "Bản thân tôi thì không. Những người khác thì tôi cũng không biết, hồi trước đúng là từng nghe vài tin đồn, nhưng mà... Haiz, đây cũng không phải chuyện nên kể với người ngoài.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811743
					],
					"speakerTitle": "Sevigne"
				},
				{
					"id": 740811743,
					"content": "Có ba cuộn băng đục lỗ phải thu hồi. Nói cách khác, chỉ có duy nhất ba cuộn băng đục lỗ trên kệ sách. Chắc sẽ rất dễ tìm thấy, phiền hai bạn nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811744
					],
					"speakerTitle": "Sevigne"
				},
				{
					"id": 740811744,
					"content": "Giờ thì tôi phải kiểm tra lại máy thí nghiệm, dù sao cũng rất lâu rồi không ai bảo dưỡng chúng... Nếu để mất kiểm soát thì không được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811745
					],
					"speakerTitle": "Sevigne"
				},
				{
					"id": 740811745,
					"content": "Được thôi, vậy chúng tôi thu hồi băng đục lỗ xong sẽ quay lại xác nhận với cô.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740811736,
					"content": "Không thành vấn đề, để đấy cho tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811737
					]
				},
				{
					"id": 740811731,
					"content": "Chúng tôi còn phải tìm kho báu khác nữa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811732
					]
				},
				{
					"id": 740811725,
					"content": "Xin hỏi ở đây có kho báu không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811726
					]
				},
				{
					"id": 740811716,
					"content": "Cô có suy nghĩ đến việc nâng cấp sức mạnh máy thí nghiệm không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811717
					]
				},
				{
					"id": 740811717,
					"content": "Quả thực đàn anh Maillardet đã làm rồi. Có lẽ sản phẩm sau cùng sẽ phù hợp với sức mạnh mà bạn mong muốn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811718
					],
					"speakerTitle": "Sevigne"
				},
				{
					"id": 740811708,
					"content": "Đúng vậy, kỳ lạ quá, cửa mở sao đây?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811709
					]
				},
				{
					"id": 740811704,
					"content": "Hay là ảo giác của cô?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811705
					]
				}
			]
		},
		{
