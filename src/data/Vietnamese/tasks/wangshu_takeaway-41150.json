			"dialogs": [
				{
					"id": 411500301,
					"content": "Nghe nói là đơn đặc biệt...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411500302
					]
				},
				{
					"id": 411500302,
					"content": "Là thế này. Cô nương Ling'guan hồ đồ này đã gọi một phần Món Nào Nào, nói là lát nữa về ăn. Tôi đoán cô ấy lại đi dạo đâu đó rồi không về kịp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411500303
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 411500303,
					"content": "Bạn mang món này cho cô ấy nhé, <color=#00E1FFFF>đi đường cẩn thận, đừng leo trèo chạy nhảy</color>, sẽ sóng ra ngoài mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411500304
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 411500304,
					"content": "<color=#00E1FFFF>Còn nữa, đừng dính vào nguyên tố kỳ quái làm xáo trộn mùi vị</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411500305
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 411500305,
					"content": "Nếu món ăn bị hỏng, các bạn hãy quay lại tìm tôi, tôi sẽ làm một phần mới.",
					"roleType": "TALK_ROLE_NPC",
