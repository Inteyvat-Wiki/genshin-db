				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413130901,
					"content": "Thế nào, Tết Hải Đăng mà chúng tôi chuẩn bị có phải nhìn rất ngon không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130902,
					"content": "Đây chính là Tết Hải Đăng mà các bạn đem đến đây? Hành vi của loài người, chẳng lẽ đều kỳ dị như vậy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130903
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413130903,
					"content": "Các bạn làm những thứ này có ý nghĩa gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130904,
						413130905
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413130904,
					"content": "Để bạn tham gia Tết Hải Đăng một lần.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130906
					]
				},
				{
					"id": 413130906,
					"content": "...Là vậy sao? Tâm tư của con người đúng là khó đoán.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130907
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413130907,
					"content": "Đừng nói nữa, mau ăn thôi, không thôi món ngon sẽ nguội lạnh hết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130908
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130908,
					"content": "Hi hi, tôi ăn trước nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130909
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130909,
					"content": "Xong rồi, ăn no rồi đã đến lúc đi xem \"Đèn Minh Tiêu\" thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130910
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130910,
					"content": "Xiao cùng đi nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130911
					]
				},
				{
					"id": 413130911,
					"content": "Các bạn đi đi, tôi không hứng thú với những thứ đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130912,
						413130913
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413130912,
					"content": "Nếu không thì tiễn chúng tôi đi cũng được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130914
					]
				},
				{
					"id": 413130914,
					"content": "Đúng rồi, cho dù bạn không muốn xem \"Đèn Minh Tiêu\", vậy... xem như bạn đưa chúng tôi đi cũng được mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130915
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130915,
					"content": "Từ đây đến Liyue rất xa đó, ngoại ô cũng rất nguy hiểm... thật đó, rất nguy hiểm đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130916
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130916,
					"content": "Không cần đưa chúng tôi vào thành, chỉ.. chỉ cần đến ngoài thành là được rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130917
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130917,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130918
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413130918,
					"content": "Phù...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130919
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413130919,
					"content": "Được thôi, vậy tôi sẽ đưa các bạn đến <color=#00E1FFFF>bên ngoài thành</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130920
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413130920,
					"content": "Được! Chúng ta xuất phát thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130913,
					"content": "Làm ơn đi mà, Hộ Pháp Dạ Xoa đại nhân.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130914
					]
				},
				{
					"id": 413130905,
					"content": "Tết Hải Đăng là tết của tất cả mọi người.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130906
					]
				}
			]
		},
