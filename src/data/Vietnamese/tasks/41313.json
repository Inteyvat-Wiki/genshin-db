			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huai'an"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413130701,
					"content": "Ở đây được đấy, ừm... cũng rất yên tĩnh, rất thích hợp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130702
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130702,
					"content": "Vậy cứ chọn ở đây đi, tôi lúc nãy cũng đang suy nghĩ về việc làm sao xây dựng được quầy hàng như các bạn muốn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130703
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130703,
					"content": "Các bạn chờ nhé, tôi xem thử, nên bắt đầu từ đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130704
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130704,
					"content": "Xong rồi, đại khái là như vậy, các bạn xem đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130705
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130705,
					"content": "Oa... tài nghệ của bạn...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130706
					]
				},
				{
					"id": 413130706,
					"content": "Ây da, chỉ là chút việc nhỏ ấy mà, đâu có gì đáng trầm trồ, tôi học từ nhiều năm trước, suýt nữa thì quên hết rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130707
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130707,
					"content": "Vậy là quầy hàng thì đã có rồi, tôi bày thêm vài chiếc \"Đèn Tiêu\" lên đó, xem cũng được chứ nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130708
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130708,
					"content": "Bạn cũng biết làm Đèn Tiêu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130709
					]
				},
				{
					"id": 413130709,
					"content": "Ây da, người Liyue ở từng tuổi này thì hầu như ai cũng biết làm Đèn Tiêu hết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130710
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130710,
					"content": "Đúng rồi, dịp lễ lớn... mời khách thì phải có đồ ăn chứ, các bạn muốn mời vị đó ăn món gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130711
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130711,
					"content": "Ăn...\"Đậu Hũ Hạnh Nhân\"! Trước đây chúng tôi có từng mời Xiao ăn rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130712,
					"content": "Và \"Cá Hổ Nướng\" nữa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130713
					]
				},
				{
					"id": 413130713,
					"content": "\"Đậu Hũ Hạnh Nhân\" và \"Cá Hổ Nướng\" phải không... Được, không thành vấn đề, tôi sẽ kêu người chuẩn bị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130714
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130714,
					"content": "Vừa hay trong nhà trọ có đủ nguyên liệu, mấy món này chắc sẽ xong nhanh thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130715
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130715,
					"content": "Vậy các bạn hãy mời vị khách đó xuống đây đi, khi các bạn xuống chắc món ăn cũng vừa kịp xong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				}
			]
		},
