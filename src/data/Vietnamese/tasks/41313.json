			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Verr Goldet"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413130301,
					"content": "Xem ra, các bạn lại cùng Xiao làm việc lớn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130302
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 413130302,
					"content": "Đúng là lớn thật, chúng tôi ở đây mà còn nghe nói đến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130303
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130303,
					"content": "Nhưng mà, Tết Hải Đăng năm nay sắp kết thúc rồi, mà anh ấy vẫn chưa đi xem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130304
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 413130304,
					"content": "Haizz... Đã bao nhiêu năm rồi, tôi chưa từng thấy anh ấy tham gia Tết Hải Đăng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130305
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130305,
					"content": "Theo tôi thì thà bắt tôi dời Tết Hải Đăng đến đây còn dễ hơn là mời anh ấy đến Tết Hải Đăng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130306
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130306,
					"content": "Dời Tết Hải Đăng...đến đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130307,
					"content": "Đúng là ý hay.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130308
					]
				},
				{
					"id": 413130308,
					"content": "Đúng vậy! Nếu Xiao đã không đến Tết Hải Đăng, vậy chúng ta sẽ đem Tết Hải Đăng đến đây cho anh ấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130309,
					"content": "Hử? Tôi chỉ thuận miệng nói vậy thôi... sao lại xem là thật? Làm sao \"dời đến đây\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130310
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130310,
					"content": "Lúc đi dạo ở Tết Hải Đăng, chúng tôi đã biết cách làm \"Đèn Tiêu\", còn tìm thấy một quầy bán món ăn vặt nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130311,
					"content": "Có rất nhiều món ngon, Đèn Tiêu đẹp lung linh, còn có... ừm... các anh hùng qua lại, là những người bạn cũ của anh ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130312,
					"content": "Đó là tất cả của Tết Hải Đăng rồi còn gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130313,
					"content": "Đúng vậy, nhưng mà nên sắp xếp ở đâu mới được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130314
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 413130314,
					"content": "Nếu nói vậy, chúng ta thử nghĩ xem chỗ nào rộng rãi một chút, còn phải có chỗ để bày quầy hàng nữa mới được, ừm... <color=#00E1FFFF>tầng hầm của nhà trọ</color> cũng có chút không gian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130315
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130315,
					"content": "Chúng ta cùng xuống xem nào. Tôi muốn biết đại khái các bạn cần quầy hàng như thế nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130316
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130316,
					"content": "Ừm... chắc có mẫu để tham khảo, để tôi nghĩ xem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				}
			]
		},
		{
			"id": 4131307,
			"completionStepIds": [
				4131307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
