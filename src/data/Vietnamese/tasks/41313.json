			"dialogs": [
				{
					"id": 413130201,
					"content": "Sao rồi, đã xong xuôi hết chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130202
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413130202,
					"content": "Đã xong rồi, nhưng...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130203
					]
				},
				{
					"id": 413130203,
					"content": "Nếu vậy thì tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130204
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413130204,
					"content": "Không đi xem Đèn Minh Tiêu thật sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130205
					]
				},
				{
					"id": 413130205,
					"content": "Không đi. Tôi đã nói rồi, không thích chỗ đông người, đặc biệt là những ngày này hàng năm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130206
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413130206,
					"content": "Đèn Minh Tiêu năm nay là \"Di Tiêu Đạo Thiên Chân Quân\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130207
					]
				},
				{
					"id": 413130207,
					"content": "Đúng, là một con hươu trông rất có tiên khí, chúng ta cùng đi xem thử đi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130208,
					"content": "\"Di Tiêu Đạo Thiên Chân Quân\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130209
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413130209,
					"content": "Nhưng mà suy cho cùng cũng chỉ là Đèn Tiêu mà thôi, đồ nhân tạo rất vô vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130210
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413130210,
					"content": "Các bạn hãy vào thành chơi vui đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xiao"
				}
			]
		},
		{
			"id": 4131303,
			"completionStepIds": [
				4131303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
