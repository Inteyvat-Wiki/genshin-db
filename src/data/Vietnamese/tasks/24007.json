			"dialogs": [
				{
					"id": 240070501,
					"content": "Để xem... Bánh răng này dùng được, ổ trục nếu mà cưa ra thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070502
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070502,
					"content": "Tìm thứ này để làm gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240070503
					]
				},
				{
					"id": 240070503,
					"content": "Em muốn tự làm một con búp bê dây cót. Trước đó em đã lén học những kiến thức liên quan rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070504
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070504,
					"content": "Khi học xong em sẽ làm ra một Robot Dây Cót để cho bố bất ngờ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070505
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070505,
					"content": "Em đã đọc qua nhiều sách trong phòng bố, cũng đã dựa theo đó để làm một số bộ phận đơn giản.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070506
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070506,
					"content": "Chỉ cần cố thêm chút là em sẽ làm ra Robot Dây Cót rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070507
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070507,
					"content": "Nhưng em không thể nghiên cứu thứ này trong thành phố, nếu để bố phát hiện thì không còn bất ngờ nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070508
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070508,
					"content": "Vì thế chỗ này đã trở thành căn cứ bí mật để Lovi nghiên cứu, còn em thì... trở thành trợ lý của bạn ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070509
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240070509,
					"content": "Trợ lý! Bắt đầu nghiên cứu thôi! Hôm nay chúng ta phải làm được một cánh tay máy có thể di chuyển!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070510
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070510,
					"content": "Rõ! Bắt đầu nghiên cứu thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verut"
