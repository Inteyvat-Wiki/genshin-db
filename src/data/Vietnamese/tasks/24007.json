			"dialogs": [
				{
					"id": 240070101,
					"content": "Lovi tìm thấy gì hay ho chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070102
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240070102,
					"content": "Chưa, ở đây chả có gì!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070103
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070103,
					"content": "Mấy đứa đang làm gì thế?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240070104
					]
				},
				{
					"id": 240070104,
					"content": "#Tụi em đang \"tìm kho báu\", hihi... {M#Anh}{F#Chị} có muốn tham gia cùng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070105,
						240070108
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240070105,
					"content": "Tìm kho báu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240070106
					]
				},
				{
					"id": 240070106,
					"content": "Đừng nghe Verut tào lao, thật ra tụi em đang tính mò một ít linh kiện ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070107
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070107,
					"content": "Những linh kiện này chính là báu vật... Ấy? Chỗ này chắc là có...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070114
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240070114,
					"content": "Ừm... Xem ra chỗ này tìm không ra, đổi chỗ khác xem sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070115
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070115,
					"content": "Được! Chúng ta lên phía trước xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070116,
						240070117
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240070116,
					"content": "#Để {M#anh}{F#chị} đi cùng hai đứa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240070118
					]
				},
				{
					"id": 240070118,
					"content": "#Woa, giọng điệu của {M#anh}{F#chị} thật là giống anh Aurele...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070119
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240070119,
					"content": "Vậy chúng ta lên phía trước, em nhớ là quanh đây có rất nhiều linh kiện ở dưới nước...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verut"
				},
				{
					"id": 240070117,
					"content": "Không được chạy lung tung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240070118
					]
				},
				{
					"id": 240070108,
					"content": "Sao không thấy Aurele?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240070109
					]
				},
				{
					"id": 240070109,
					"content": "Anh ấy đi vào thành tìm chú Delerue rồi, anh ấy bảo có chút chuyện cần hỏi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070110
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240070110,
					"content": "Tụi em thì chỉ đành không chạy lung tung... nãy giờ ở đây \"tìm kho báu\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070111
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240070111,
					"content": "#Hihi... {M#Anh}{F#Chị} có muốn tham gia với tụi em không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070112
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240070112,
					"content": "Đừng nghe Verut tào lao, thật ra tụi em đang tính mò một ít linh kiện ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070113
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070113,
					"content": "Những linh kiện này chính là báu vật... Ấy? Chỗ này chắc là có...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070114
