			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ruu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722270301,
					"content": "Cây Cư Trú này cũng xong rồi đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722270302,
					"content": "Lợi hại thật! Đây chính là nhà mạo hiểm thực sự sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270303
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270303,
					"content": "Ý em là... cũng từng có người đến qua nơi này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270304
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270304,
					"content": "#Nhưng không lợi hại như {F#chị}{M#anh} {NICKNAME} và Paimon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270305
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270305,
					"content": "Từng có người đến đây sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722270306,
					"content": "Họ đến để tìm Maushiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270307,
						722270308
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270307,
					"content": "Chẳng lẽ là Sumida...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270309
					]
				},
				{
					"id": 722270309,
					"content": "Nhưng Maushiro là gì thế? Nghe nói là một loại nhạc cụ của người Tsurumi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722270310,
					"content": "Ừm, đó là một thứ có thể phát ra âm thanh đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270311
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270311,
					"content": "Do biển sương mù khiến người ở đây rất khó nhìn rõ mọi thứ, vì thế mà mọi người đã dùng Maushiro để truyền đạt vị trí của mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270312
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270312,
					"content": "Gọi nhau í ới thì ồn lắm, mà còn bị đau họng nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270313
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270313,
					"content": "Đúng là chẳng nhìn thấy gì hết thật...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722270314,
					"content": "Đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270315
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270315,
					"content": "Cha... à, ông Mata còn nói là tiếng Maushiro sẽ giúp những linh hồn bị lạc bước trong sương mù có thể tìm được đường về nhà nữa. Cho nên nó là vật rất quan trọng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270316
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270316,
					"content": "Ồ, thì ra quan trọng thế sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722270317,
					"content": "Chả trách tế lễ phải cần đến nó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270318
					]
				},
				{
					"id": 722270318,
					"content": "#Tế lễ chắc chắn sẽ giúp {F#chị}{M#anh} {NICKNAME} và Paimon vui cho xem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270319
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270319,
					"content": "Mọi người đi trước đi! Em muốn ngồi nghỉ dưới gốc cây thêm chút nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270320
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270320,
					"content": "Không sao chứ? Bên ngoài có lẽ vẫn còn ma vật đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722270321,
					"content": "Không sao đâu mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270308,
					"content": "Chả trách sao tiểu thư Katheryne nói đây là ủy thác độ khó cao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270309
					]
				}
			]
		},
