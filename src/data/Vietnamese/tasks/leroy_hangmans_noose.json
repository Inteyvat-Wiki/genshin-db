			"dialogs": [
				{
					"id": 741540201,
					"content": "Có điều gì đó không ổn, rất không ổn... Ngay cả tôi cũng cảm thấy có điều gì đó không ổn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540202,
					"content": "#{NICKNAME} thông minh, thử nói xem tiếp theo chúng ta nên làm gì đi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540203,
						741540204,
						741540205,
						741540206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540203,
					"content": "Ông Benoit muốn cầu cứu nhưng lại nói đừng cứu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540207
					]
				},
				{
					"id": 741540207,
					"content": "Chúng ta đến gần nhà ông Benoit xem thử đi? Phía sau cửa sổ nhà ông ấy hình như có cái rương kỳ lạ đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540208,
					"content": "Chắc chắn ở đó có giấu thứ gì đó, biết đâu lại chứng minh phỏng đoán của chúng ta thì sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540204,
					"content": "Cặp vợ chồng này có lẽ cũng đến từ Fleuve Cendre...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540207
					]
				},
				{
					"id": 741540205,
					"content": "Nhìn phản ứng của họ, hình như vẫn còn ẩn tình khác...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540207
					]
				},
				{
					"id": 741540206,
					"content": "Tôi có một vài phỏng đoán, nhưng vẫn thiếu chứng cứ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540207
					]
				}
			]
		},
