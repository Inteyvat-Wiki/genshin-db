				]
			},
			"dialogs": [
				{
					"id": 741540701,
					"content": "Tôi nghĩ dựa theo mức độ cố chấp của hai người thì chắc sẽ không bỏ cuộc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540702
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540702,
					"content": "Tôi còn tưởng hai người sẽ trình báo cho Sảnh Chấp Pháp, nhưng không, xem ra hai người cũng có ý đồ riêng của mình đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540703,
						741540704
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540703,
					"content": "Sao các người lại muốn nhốt ông Benoit?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540705
					]
				},
				{
					"id": 741540705,
					"content": "Tôi bái phục hai người đấy. Nếu hai người để dành công sức cho việc khác thì đã trở thành cá nhân xuất chúng rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540706
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540706,
					"content": "Tiếc là không được. Haiz, các người đúng là không sợ chết mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540707
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540707,
					"content": "Anh dọa nhầm người rồi đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540708
					]
				},
				{
					"id": 741540708,
					"content": "Ồ? Là vì các người không hiểu rõ tình hình hiện giờ của bản thân, hay do nghĩ là mình đang thực thi công lý đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540709
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540709,
					"content": "Kể ra thì, người thương nhân chết đuối ở trong bản tin mới đây tên là Brandt. Ừm, đó là một tên khéo ăn nói đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540710
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540710,
					"content": "Đoán xem? Trong bản tin nói là người này thật ra không hề chết đuối, mà là bị người ta sát hại rồi quăng xuống hồ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540711
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540711,
					"content": "Đội Hắc Ảnh Marechaussee điều tra một hồi, chỉ cho ra kết quả là người này bị mưu sát, hung thủ tội ác tày trời gì đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540712
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540712,
					"content": "Vì thế nên tờ báo cũng viết như vậy. Còn tình huống thực tế thì sao, hung thủ đáng chết hơn hay bản thân thương nhân đáng chết hơn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540713
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540713,
					"content": "Hmm... Đó là một câu hỏi phức tạp, tạm thời tôi vẫn chưa nghĩ ra đáp án.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540714
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540714,
					"content": "À, lan man quá. Chuyện này không liên quan đến chuyện mà chúng ta muốn nói.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540715
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540715,
					"content": "Rốt cuộc anh muốn nói gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540716,
					"content": "Cái tôi muốn nói là, trước khi hoàn toàn hiểu rõ một chuyện, thì hành động tùy tiện là một việc rất ngu ngốc, có lẽ còn phải nhận về hậu quả xấu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540717,
						741540718
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540717,
					"content": "Thờ ơ với những việc xấu xa mới là ngu ngốc.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540719
					]
				},
				{
					"id": 741540719,
					"content": "Haha... Nếu gặp nhau trong hoàn cảnh khác thì có lẽ chúng ta sẽ làm bạn đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540720
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540720,
					"content": "#Tuy suy nghĩ của {F#cô}{M#cậu} rất hợp với tôi, nhưng tôi có việc phải làm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540721
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540721,
					"content": "Đây là sự kiên nhẫn cuối cùng của tôi. Nếu sau này vẫn để tôi nhìn thấy các người lảng vảng xung quanh đây thì tôi sẽ ra tay đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540722
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540722,
					"content": "Athos nói thêm mấy lời khó hiểu, sau đó liền rời đi.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741540723
					]
				},
				{
					"id": 741540723,
					"content": "Thái độ kỳ lạ của anh ta khiến bạn thấy bất ngờ. Bạn đang cân nhắc xem mình nên giữ lập trường thế nào trong vụ này...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741540724
					]
				},
				{
					"id": 741540724,
					"content": "Cửa sổ phía sau lưng có tiếng động phát ra, sau đó một tờ giấy bị ném ra ngoài...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741540725
					]
				},
				{
					"id": 741540725,
					"content": "Trên tờ giấy có chữ viết màu nâu, hình như là chấm vào cà phê viết ra trong lúc vội vã...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741540726
					]
				},
				{
					"id": 741540726,
					"content": "Mau nhìn thử xem trên đó viết gì đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540727,
					"content": "Là ông Benoit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540728,
					"content": "Suỵt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540729
					]
				},
				{
					"id": 741540729,
					"content": "...Xin lỗi. Nói chung bây giờ chúng ta để ý bát thức ăn cho mèo để đợi tín hiệu vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540718,
					"content": "Tôi sẽ tích cực hành động khi nhìn thấy những việc xấu xa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540719
					]
				},
				{
					"id": 741540704,
					"content": "Rốt cuộc ông Benoit có mối quan hệ như thế nào với các người?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540705
					]
				}
			]
		},
		{
