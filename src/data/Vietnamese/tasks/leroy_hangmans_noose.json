			"dialogs": [
				{
					"id": 741540801,
					"content": "#{NICKNAME}, nhìn xem! Thịt cá vẫn còn mới, trên đất cũng sạch sẽ, chắc chắn có người vừa mới quét dọn xong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540802,
					"content": "Nhà ông Benoit chắc chắn có người, chúng ta qua đó thử xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540803,
					"content": "...Ông ta nói cũng có lý. Ông ta không thể biến mất mãi như thế được, ít nhất cũng phải thỉnh thoảng xuất hiện, ra ngoài đi dạo gì đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540804
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540804,
					"content": "Như vậy thì hàng xóm mới không nghi ngờ mà đến Sảnh Chấp Pháp báo án. Tôi không muốn Đội Ngự Lâm đến đây đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540805
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540805,
					"content": "Cha ơi, cha muốn ra ngoài tản bộ lắm đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540806
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540806,
					"content": "Có... Có thể sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540807
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741540807,
					"content": "Tất nhiên rồi. Không những vậy, chúng con còn rất vui khi được tản bộ cùng cha đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540808
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540808,
					"content": "Cẩn thận một chút, đừng để ông ta có cơ hội chạy ra ngoài cầu cứu. Hai tên kỳ lạ kia đang theo dõi nơi này đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540809
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540809,
					"content": "Cha sẽ không làm vậy đâu, chắc chắn đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540810
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540810,
					"content": "Cha ơi, liệu cha có muốn để Sảnh Chấp Pháp biết...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540811
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540811,
					"content": "Biết gì thế...? Sao lại nói chuyện bé như vậy chứ, không thể nghe nổi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540812,
					"content": "Họ định ra ngoài.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540813
					]
				},
				{
					"id": 741540813,
					"content": "Ừm, chúng ta đứng ra xa chút. Lần này phải nghĩ cách đến nói chuyện với ông Benoit đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540814
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540814,
					"content": "Đúng vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540815
					]
				},
				{
					"id": 741540815,
					"content": "Được, chúng ta mau đi ra xa thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540816
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540816,
					"content": "Sao rồi cha? Tâm trạng có khá hơn chút nào không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540817
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540817,
					"content": "Là các cháu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540818
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741540818,
					"content": "Ông Benoit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540819
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540819,
					"content": "Các cháu cứu ta với! À không, đừng cứu ta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540820
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741540820,
					"content": "Cha đang nói gì vậy? Cứu hay không cứu gì cơ? Haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540821
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540821,
					"content": "Là các người sao. Bảo sao cha lại chào hỏi như vậy, hóa ra là người quen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540822
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540822,
					"content": "Không có, không phải! Không có quen biết gì cả!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540823
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741540823,
					"content": "Không quen à? Sao lại thế nhỉ, con thấy bọn họ đứng đó chờ cha đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540824
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540824,
					"content": "Còn tốt bụng đưa báo đến cho chúng ta, lại đến Fleuve Cendre tìm người hàng xóm Snodgrass trước đây hỏi thăm nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540825
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540825,
					"content": "Chắc mọi người thân thiết lắm nhỉ? Trước giờ cha rất yêu trẻ con, chẳng trách.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540826
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540826,
					"content": "Tôi cũng thế. Nhưng tôi không vô tư được như cha, tôi yêu con mình nhất, nhưng đáng tiếc, nó đi mất rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540827,
						741540829
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540827,
					"content": "Rốt cuộc các người đang làm gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540828
					]
				},
				{
					"id": 741540828,
					"content": "Tôi và Athos là con của cha. Cha yêu chúng tôi, nên chúng tôi cũng yêu cha. Chuyện này không phải rất rõ ràng sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540831
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540831,
					"content": "Morticia xem kìa, hôm nay trời đẹp quá, rất thích hợp để đi dạo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540832
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540832,
					"content": "Đúng thế, Athos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540833
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540833,
					"content": "Morticia đã đọc báo Chim Hơi Nước hôm nay chưa? Có rất nhiều tin tức thú vị đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540834
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540834,
					"content": "Vẫn chưa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540835
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540835,
					"content": "Có tin tức về ông cụ không may qua đời. Nghe nói là gặp phải cướp trong tình trạng không có người giám hộ, thế là đã không cẩn thận ngã xuống vách núi mà chết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540836
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540836,
					"content": "Thật ư? Thế thì thê thảm quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540837
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540837,
					"content": "Còn có tin tức về một thương nhân không may chết đuối. Hình như do uống nhiều rượu quá, mơ màng bước xuống hồ mà chết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540838
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540838,
					"content": "Ôi trời, thật là bất hạnh quá mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540839
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540839,
					"content": "Tin cuối cùng, cũng là thú vị nhất! Một người tốt thích lo chuyện bao đồng, thế là... không cẩn thận mà uống nhầm thuốc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540840
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540840,
					"content": "Cứ tưởng thuốc độc là thuốc chữa bệnh, nên cứ thế uống luôn. Kết quả là đã chết một cách cực kỳ đau đớn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540841
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540841,
					"content": "Ôi trời, con người có nhiều kiểu chết thật đó, anh kể tiếp nữa nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540842
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540842,
					"content": "...Xin lỗi, xin lỗi! Cha sẽ không làm thế nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540843
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741540843,
					"content": "Cha đang nói gì thế? Chúng con đâu có trách cha đâu, nhưng cha đi dạo lâu thế này chắc đã mệt lắm rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540844
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540844,
					"content": "Athos, chúng ta về nhà cùng đọc báo cho cha nghe đi. Chẳng phải cha đã đặt rất nhiều báo rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540845
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540845,
					"content": "Đúng thế. Tán gẫu cũng đủ lâu rồi, nên về thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540846
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540846,
					"content": "Chúng ta về thôi, cha thân yêu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540829,
					"content": "Tại sao các người phải làm thế?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540830
					]
				},
				{
					"id": 741540830,
					"content": "Ý là ra ngoài đi dạo cùng cha ư? Đây là nghĩa vụ của một người con mà, nếu không thì chẳng phải sẽ phụ lại sự yêu thương của cha sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540831
					],
					"speakerTitle": "Morticia"
				}
			]
		}
	]
