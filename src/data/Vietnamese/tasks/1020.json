			"dialogs": [
				{
					"id": 10200401,
					"content": "Đứng lại!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200402
					],
					"speakerTitle": "Huaqing"
				},
				{
					"id": 10200402,
					"content": "Kẻ nào, dám xông vào trọng địa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200403,
						10200404
					],
					"speakerTitle": "Huaqing"
				},
				{
					"id": 10200403,
					"content": "Xông vào? Chúng tôi chỉ đi ngang qua...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200405
					]
				},
				{
					"id": 10200405,
					"content": "Phải đó phải đó, không hiểu các ngươi đang nói gì!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200406,
					"content": "Bọn tôi được mời tới đây, là khách quý! Sao lại đối xử với bọn tôi như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200407,
					"content": "Không... chờ đã... lẽ nào Ningguang... cô ta cố ý!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200408,
					"content": "Cô ta giả vờ mời chúng ta lên Quần Ngọc Các, thực chất Thiên Nham Quân đã mai phục ở đây, định bắt chúng ta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200409,
						10200410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200409,
					"content": "Tôi cảm thấy không phải như vậy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200411
					]
				},
				{
					"id": 10200411,
					"content": "Hức, tức quá đi! Đám binh sĩ kia, các ngươi đúng là gán tội bừa bãi! Vô liêm sỉ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200412,
					"content": "Cái gì... nhiệm vụ bảo vệ bình thường, tại sao lại là vô liêm sỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200413
					],
					"speakerTitle": "Huaqing"
				},
				{
					"id": 10200413,
					"content": "Xằng bậy, tóm lại, bắt kẻ khả nghi trước rồi nói sau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200414
					],
					"speakerTitle": "Yang"
				},
				{
					"id": 10200414,
					"content": "Tới rồi, đánh bại hết tất cả bọn họ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200410,
					"content": "Còn chưa giải thích chuyện mời chúng ta...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200411
					]
				},
				{
					"id": 10200404,
					"content": "Trọng địa? Đây chỉ là vùng hoang dã bên ngoài Thiên Hoành Sơn...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200405
					]
				}
			]
		},
