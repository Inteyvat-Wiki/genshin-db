			"dialogs": [
				{
					"id": 10200601,
					"content": "Dừng tay! Chuyện gì mà ồn ào vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200602
					],
					"speakerTitle": "Huaqing"
				},
				{
					"id": 10200602,
					"content": "Keqing đại nhân, hai kẻ quái dị này đột nhiên xuất hiện, hình như có ý đồ xấu với máy Guizhong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200603
					],
					"speakerTitle": "Huaqing"
				},
				{
					"id": 10200603,
					"content": "Ngươi, ngươi nói ai là kẻ quái dị!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200604,
					"content": "Chỉ là ta đang tìm đường đến Quần Ngọc Các.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200605
					]
				},
				{
					"id": 10200605,
					"content": "Hả? Các bạn muốn lên Quần Ngọc Các? Các bạn là ai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200606
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200606,
					"content": "Chúng ta là khách được mời, muốn tìm Thất Tinh Liyue! Bạn là ai thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200607,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200608
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200608,
					"content": "Vừa khéo, ta chính là Thất Tinh Liyue",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200609
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200609,
					"content": "???",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200610,
					"content": "Ta là Keqing, \"Ngọc Hành Tinh\" của Thất Tinh Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200611
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200611,
					"content": "Tôi biết chuyện của bạn, Nhà Lữ Hành, bạn là khách của Ningguang nhỉ? Không ngờ lại tình cờ gặp giữa núi rừng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200612
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200612,
					"content": "Wa, tôi cũng không ngờ lại gặp được người có tiền ở nơi hoang vu này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200613,
					"content": "Máy Guizhong ở tường thành cổ Thiên Hoành Sơn bị hỏng, nhưng đã được sửa trong một đêm. Tôi vốn là muốn điều tra sự việc nên đến đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200614
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200614,
					"content": "Thiên Nham Quân này chỉ là phụ trách bảo vệ hiện trường, không phải đến bắt người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200615
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200615,
					"content": "Thì ra là hiểu lầm à? Ừm... đúng là không thể ngờ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200616
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200616,
					"content": "Rất dễ đoán ra mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200617
					]
				},
				{
					"id": 10200617,
					"content": "Dù sao, cơ quan do tiên nhân tạo ra, nếu đã có người phàm sửa được. Việc này đối với Thất tinh mà nói cũng là một chuyện kỳ lạ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200618
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200618,
					"content": "Hi hi, đó là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200619,
						10200620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200619,
					"content": "(Suỵt...Đừng dây dưa nữa, Paimon.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200621
					]
				},
				{
					"id": 10200621,
					"content": "Í? À, phải rồi, vị Ngọc Hành đại nhân này, biết Thiên Quyền đại nhân tại sao lại mời chúng tôi đến Quần Ngọc Các không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200622
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200622,
					"content": "Gọi tôi Keqing là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200623
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200623,
					"content": "Ningguang hẹn gặp bạn, tôi nghĩ chẳng qua là muốn \"anh hùng cứu giúp Mondstadt\" trung lập một chút. Chí ít... đừng đứng hoàn toàn về phía tiên nhân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200624
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200624,
					"content": "Chúng tôi không hề đứng về phía nào! Chúng tôi từng trò chuyện với những tiên nhân kia, họ cũng muốn phù hộ Liyue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200625
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200625,
					"content": "\"Phù hộ\" mà bạn nói, là chỉ kiểu ngạo mạn từ trên cao nhìn xuống ấy à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200626
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200626,
					"content": "Ơ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200627
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200627,
					"content": "Vì các bạn là người phàm, là đối tượng để họ phù hộ, nên họ sẽ không xem bạn là \"thích khách có khả năng ám sát thần linh\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200628
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200628,
					"content": "Nên họ nhất định cũng cảm thấy Ningguang phong bế hiện trường, hỏi han dân thường, truy bắt thích khách... những mệnh lệnh này đều là để cho có, thậm chí còn để che đậy điều gì đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200629
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200629,
					"content": "Tôi nói thẳng nhé: Đây là xem thường người khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200630
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200630,
					"content": "Bạn nói vậy, quả thực cũng có chút đạo lý...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200631
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200631,
					"content": "Nhưng, người Liyue \"bất kính với thần\" như bạn, tôi gặp lần đầu đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200632
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200632,
					"content": "Hờ...Tôi phải tôn kính quan niệm thời gian mờ nhạt của họ, nhưng vì sự ngạo mạn với người phàm, nên họ tạm thời chưa ra tay với Thất Tinh chúng tôi ư?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200633
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200633,
					"content": "Bỏ đi, tôi không nên bàn luận tiên nhân như vậy. \"Bất kính với thần tiên\" chỉ là thái độ của cá nhân tôi, Ningguang tuyệt đối sẽ không nói những lời này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200634
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200634,
					"content": "Tóm lại, tôi thừa nhận, tiên nhân cũng khá kiềm chế trong lần hành sự này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200635
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200635,
					"content": "Đế quân bị hại, thực sự không bình thường. Đối diện với sự việc phi lý như vậy, họ vẫn đồng ý triệu tập chúng tiên đến thương nghị, chứ không trực tiếp đánh tới...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200636
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200636,
					"content": "Chuyện này rất văn minh, đúng là bất ngờ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200637,
						10200638
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200637,
					"content": "Cho nên có khả năng đàm phán hoà bình không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200639
					]
				},
				{
					"id": 10200639,
					"content": "Ningguang ấy à... Trong mắt cô ấy, tốt nhất mọi việc đều nên ngồi xuống thương lượng, nhưng điều đó là không thể.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200640
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200640,
					"content": "Thời đại của Tiên nhân đã qua, nếu ngay cả Thất Tinh của Liyue cũng không dám đối mặt với điều này, vậy tương lai của Liyue sẽ ra sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200641
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200641,
					"content": "...Lại là một phát ngôn to gan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200642
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200642,
					"content": "Phù... Vậy tạm kết tại đây. Thực ra tôi chẳng cần phải nói nhiều như vậy, nhưng bạn là một người rất biết lắng nghe, Nhà Lữ Hành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200643
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200643,
					"content": "Được rồi, các bạn nên đến Quần Ngọc Các rồi. Phải đúng giờ đó? Vì lịch hẹn gặp của Ningguang đã xếp tới năm sau rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200644
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200644,
					"content": "Những phú thương giàu có của Liyue đều xem việc \"lên Quần Ngọc Các\" là vinh quang của thương nhân. Ai nấy đều mang theo quà xa hoa, để đổi lấy những lợi ích từ Ningguang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200645
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200645,
					"content": "Lợi... lợi ích?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200646,
						10200647
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200646,
					"content": "Paimon, đó không phải trọng điểm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200648
					]
				},
				{
					"id": 10200648,
					"content": "Nhưng... nhưng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200649
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200649,
					"content": "Phải rồi! \"Quà gặp mặt\" cũng là văn hoá quý báu của Liyue, chúng ta không phải vì muốn có lợi ích gì, mà là tôn trọng truyền thống văn hoá Liyue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200650
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200650,
					"content": "Coi bộ dạng vồn vã của Paimon kìa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200651
					]
				},
				{
					"id": 10200651,
					"content": "Được rồi, tặng quà gặp mặt gì các bạn cứ từ từ nghĩ, tôi sẽ nói với các bạn cách đến Quần Ngọc Các trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200652
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200652,
					"content": "Thực ra các bạn không cần đến Thiên Hoành Sơn. Về Cảng Liyue đi, đến Nguyệt Hải Đình tìm \"Người dẫn đường\", sau đó làm thế này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200653
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200653,
					"content": "Vậy thì chúng ta có duyên lại gặp, Nhà Lữ Hành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200654
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200654,
					"content": "Hừm... Vị Ngọc Hành Tinh đó tuy bất kính với thần tiên, nhưng tôi cảm giác cô ấy là một người khá mạnh mẽ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200655,
						10200656
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200655,
					"content": "Ấn tượng của tôi với cô ấy cũng không tồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200657
					]
				},
				{
					"id": 10200657,
					"content": "Phải rồi, tặng quà gặp mặt gì cho Ningguang nhỉ... Tôi nghĩ xem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200658
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200658,
					"content": "Trọng điểm của Paimon biến thành tặng quà rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200659
					]
				},
				{
					"id": 10200659,
					"content": "Phải rồi! Hôm qua khi ngủ, tôi mơ thấy một món điểm tâm vô cùng quý giá: <color=#00E1FFFF>Slime Phủ Đường</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200660
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200660,
					"content": "Tôi có dự cảm, nó rất thích hợp với đại phú hào như Ningguang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200661
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200661,
					"content": "Chúng ta dùng thứ này làm quà đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200662,
						10200664
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200662,
					"content": "Vậy, có công thức nấu không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200663
					]
				},
				{
					"id": 10200663,
					"content": "Không có! Nhưng chỉ cần dùng cảm giác \"rộp rộp\" để nấu là được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200666
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200666,
					"content": "Mau đi tìm nguyên liệu! Không thể chậm trễ, vinh hoa phú quý đang chờ chúng ta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200664,
					"content": "Thứ ngủ mơ thấy thì biết làm kiểu gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200665
					]
				},
				{
					"id": 10200665,
					"content": "Dùng cảm giác \"rộp rộp\" để nấu là được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200666
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200656,
					"content": "Tôi có phần đồng ý với cô ấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200657
					]
				},
				{
					"id": 10200647,
					"content": "Paimon, chúng ta bàn chuyện chính.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200648
					]
				},
				{
					"id": 10200638,
					"content": "Ningguang cũng muốn đàm phán với tiên nhân?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200639
					]
				},
				{
					"id": 10200620,
					"content": "(Chúng ta chỉ là làm một chút việc nhỏ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200621
					]
				}
			]
		},
		{
			"id": 102007,
			"completionStepIds": [
				102007
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"102007",
							"2"
						],
						"stepId": 102007,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10200701,
					"content": "Ấy ấy? Chỉ có thể bay đến đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200702,
					"content": "Đều tại cơn gió chưa đủ mạnh, nếu không đã có thể bay tới đỉnh rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200703,
					"content": "Về Cảng Liyue đi... tìm Thiên Nham Quân hỏi thăm một chút.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200704
					]
				},
				{
					"id": 10200704,
					"content": "Hả? Tại sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200705,
					"content": "Cách lên đó chắc không phải là điều bí mật gì đâu, nếu không....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200706
					]
				},
				{
					"id": 10200706,
					"content": "Nếu không?... Ừm, tôi hiểu rồi, nếu không thì sao Ganyu có thể bảo chúng ta tự đến Quần Ngọc Các, đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200707,
					"content": "Được rồi, vậy cứ làm theo lời bạn đi, chúng ta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200708,
					"content": "Á! Chờ đã, bạn nhìn xuống dưới xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200709,
					"content": "Thì ra chúng ta đã đến gần <color=#00E1FFFF>Máy Guizhong</color> rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200710,
					"content": "Như vậy... ừm... tôi có một ý tưởng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200711,
					"content": "Chi bằng, dùng máy Guizhong phóng bạn lên?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200712,
						10200714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200712,
					"content": "Không nha, chết người đó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200713
					]
				},
				{
					"id": 10200713,
					"content": "Ùm... cũng đúng, quả thực chưa nghĩ đến vấn đề an toàn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200716,
					"content": "Nhưng tôi nhớ, máy Guizhong có chức năng nhìn xa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200717
					]
				},
				{
					"id": 10200717,
					"content": "A, đúng đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200718,
					"content": "Vậy thì quả thực có thể lợi dụng tính năng này... vậy thử dùng máy Guizhong tìm xem gần đó còn có đường lên không!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200714,
					"content": "Lẽ nào bạn rất hận tôi à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200715
					]
				},
				{
					"id": 10200715,
					"content": "Ưm... chỉ là không suy nghĩ đến vấn đề an toàn mà thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200716
					],
					"speakerTitle": "Paimon"
