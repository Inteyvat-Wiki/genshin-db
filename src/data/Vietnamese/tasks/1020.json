			"dialogs": [
				{
					"id": 10200201,
					"content": "Mau coi, nơi này có cơ quan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200202,
					"content": "Nếu đã xuất hiện ở đây, vậy nhất định là có liên quan tới Quần Ngọc Các.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200203,
						10200205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200203,
					"content": "Là đường đến Quần Ngọc Các ư?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200204
					]
				},
				{
					"id": 10200204,
					"content": "Chắc chắn rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200205,
					"content": "Là bẫy bình thường ư?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200206
					]
				},
				{
					"id": 10200206,
					"content": "Sao vậy được? Phải tin vào trực giác của tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
