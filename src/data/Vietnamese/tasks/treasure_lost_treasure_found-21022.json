			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2102210",
							"3"
						],
						"stepId": 2102210,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2102214",
							"2"
						],
						"stepId": 2102214,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Soraya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210220501,
					"content": "Bạn quay lại rồi ư, tôi đợi đến sốt cả ruột rồi, bạn tìm thấy gì thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210229601
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210229601,
					"content": "Lại tìm thấy 2 tấm bia đá...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210229602
					]
				},
				{
					"id": 210229602,
					"content": "Mau đưa cho tôi xem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210229603
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210229603,
					"content": "“... Cuộc chiến tại Quy Li Nguyên, khi đó bụi đen đầy trời, non núi nứt nẻ...”",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210229604
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210229604,
					"content": "Cái này dường như... Nói đến Quy Li Nguyên từng xảy ra đại chiến, hơn nữa quy mô rất lớn nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210229605
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210229605,
					"content": "Quy Li Tập chắc bị phá hủy trong cuộc đại chiến này. Còn một đoạn nữa....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210229606
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210229606,
					"content": "...Dường như còn có thứ mà người không chịu rời bỏ Quy Li Tập để lại, người có vẫn ở mãi nơi này, mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210229607
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210229607,
					"content": "Đó chắc chắn là kho báu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210220502
					]
				},
				{
					"id": 210220502,
					"content": "...Bạn thật nhạy bén với những thứ như vậy, thế nhưng chỉ xét về mặt chữ nghĩa, vùng đất Quy Li Nguyên này quả là có một kho báu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220503
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220503,
					"content": "Thế nhưng phía trước còn nhắc đến\"... Có [Bốn lời răn Guizhong] dẫn lối...\", phía sau lại viết...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220504
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220504,
					"content": "\"Giáo chi dĩ trí, luật chi dĩ đức, kiên kỳ cân cốt, chúng chí nhất tâm, tứ giả hội chi nhi thành Quy Li Tập.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220505
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220505,
					"content": "Haizz tôi thực sự không biết phải lý giải như thế nào nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220506
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220506,
					"content": "Chúng ta quay trở lại Nhà Trọ Vọng Thư đi. Ở đó nghỉ ngơi một lát rồi quay lại tiếp tục giải mã \"Bốn lời răn Guizhong\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				}
			]
		},
		{
			"id": 2102295,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2102208",
							"3"
						],
						"stepId": 2102208,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2102209",
							"2"
						],
						"stepId": 2102209,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Soraya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210229501,
					"content": "Tôi tìm thấy 5 bia đá.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210229502
					]
				},
				{
					"id": 210229502,
					"content": "Vậy tốt quá, để tôi xem nào... Ây da, thứ tự những văn tự này loạn quá, để tôi suy nghĩ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220302
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220302,
					"content": "...Hình như những văn tự này còn thiếu, đọc không liền mạch, hơn nữa cũng không biết thứ tự có đúng không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220303
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220303,
					"content": "Chúng ta cứ xếp đại đi, những văn tự này khi đặt liền nhau có nghĩa là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220304
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220304,
					"content": "“...Xưa kia, nhờ Nông mà hưng, người đông thành chợ...Có thần tới, tên Guizhong, cuốn tung bụi mù, che trời mấy ngàn dặm...”",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220305
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220305,
					"content": "\"...Đưa ra bốn giới, ban bố muôn dân...Sau lại có thần tới, lấy đá làm vũ khí, tập hợp tộc dân Liyue, bảo vệ dân chúng...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220306
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220306,
					"content": "“... Lấy tên của nhị thần, gọi đây là Quy Li...”",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220307
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220307,
					"content": "Ồ xem ra đang nhắc đến nguồn gốc khu vực Quy Li Tập, còn có vị thần bảo vệ khu vực này, người này rất giỏi điều khiển \"đất\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220308
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220308,
					"content": "Còn nhắc đến một vị ma thần mang theo một bộ phận con dân của mình kéo đến định cư.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220309
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220309,
					"content": "Đến cái tên Quy Li Tập cũng là được ghép từ tên hai vị thần, mỗi người lấy một chữ cái.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220310
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220310,
					"content": "Thật là hiếm có, trong sử sách không hề ghi chép hai vị ma thần có thể chung sống hòa bình, lại còn cùng nhau hợp tác...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220311
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220311,
					"content": "Nói là hai vị Ma Thần, chi bằng nói đây là hai người bạn tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220312
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220312,
					"content": "Nhưng mà, thật kỳ lạ, khúc sau không thấy nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220313
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220313,
					"content": "Hơn nữa \"Quy Li Tập\" vì sao lại biến thành vùng đất hoang? Có hai ma thần cùng hợp sức bảo vệ thì thiên tai hay hiểm họa cũng không thể hủy hoại \"Quy Li Tập\" được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220314
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220314,
					"content": "Có lẽ đã xảy ra kiếp nạn gì đó mà ngay cả Ma Thần cũng không thể cứu giúp được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220315
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220315,
					"content": "Nhà Lữ Hành, bạn có thể đi tìm xung quanh được không? Nếu không lầm thì gần nơi bạn phát hiện ra những thứ này, còn có rất nhiều bia đá khác nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220316
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220316,
					"content": "Có lẽ, các bia đá khác sẽ ghi lại phần tiếp theo của câu chuyện...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220317
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220317,
					"content": "Nhưng những thứ ghi chép trên bia có vẻ khác so với trong văn hiến..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220318
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220318,
					"content": "Ôi, quá nhiều truyền thuyết, quá nhiều cách nói... rốt cuộc cái nào mới là thật đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				}
			]
