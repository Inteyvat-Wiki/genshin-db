			"trigger": {
				"objectNames": [
					"Chú Luo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711050801,
					"content": "Ồ... Là Nhà Lữ Hành à, trông hai vị vội vàng như vậy, đã gặp phải rắc rối gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050802
					],
					"speakerTitle": "Chú Luo"
				},
				{
					"id": 711050802,
					"content": "Chúng tôi... Chú Luo biết nhà của Xiangjun và ông nội cô bé ở đâu không? Chúng tôi đến tìm họ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050803,
					"content": "Xiangjun à? Chưa từng nghe về người này, là người ở đây à? Nếu là người trong làng thì hẳn là tôi sẽ biết...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050804
					],
					"speakerTitle": "Chú Luo"
				},
				{
					"id": 711050804,
					"content": "Chưa từng nghe sao? Không phải chứ... Chúng tôi gặp một bé gái ở bên ngoài, cô bé nói tên là Xiangjun, nhà ở Làng Kiều Anh, còn nhờ chúng tôi giúp đi tìm ông nội...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050805,
					"content": "Cô bé còn có một chiếc bè trúc rất to nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050806,
					"content": "Chà... Bè trúc cũng dễ thấy thôi, nhưng cái tên Xiangjun thì... Tôi chắc chắn trong làng không có người tên như vậy. Các vị có biết ông nội cô bé tên là gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050807
					],
					"speakerTitle": "Chú Luo"
				},
				{
					"id": 711050807,
					"content": "Ông nội cô bé là một người hái thuốc.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050808
					]
				},
				{
					"id": 711050808,
					"content": "Người hái thuốc à? Để tôi nghĩ xem nào, đúng là trước đây trong làng có một người hái thuốc... Nhưng ông ấy đã mất được ba năm rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050809
					],
					"speakerTitle": "Chú Luo"
				},
				{
					"id": 711050809,
					"content": "Mất rồi ư?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050810,
					"content": "Gặp phải quái vật ở bên ngoài nên... Haiz... Có lẽ đó không phải người mà các vị muốn tìm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050811
					],
					"speakerTitle": "Chú Luo"
				},
				{
					"id": 711050811,
					"content": "Vì người hái thuốc này có chút vấn đề về đầu óc, còn chưa lập gia đình chứ đừng nói đến chuyện có con cháu đời sau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050812
					],
					"speakerTitle": "Chú Luo"
				},
				{
					"id": 711050812,
					"content": "Chuyện... chuyện này rốt cuộc là sao? Vậy Xiangjun mà chúng tôi gặp...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050813,
					"content": "Chẳng lẽ cô bé mới là yêu quái!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050814
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050814,
					"content": "Người hái thuốc trong làng thường hái thuốc gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050815
					]
				},
				{
					"id": 711050815,
					"content": "Toàn những loại hoa cỏ chưa từng thấy bao giờ. Tôi chỉ hiểu một chút về trà, nào có hiểu mấy thứ đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050816
					],
					"speakerTitle": "Chú Luo"
				},
				{
					"id": 711050816,
					"content": "Nhưng tôi nhớ rõ, lúc gặp chuyện, mọi người đã phát hiện ông ấy ở gần Huyền Luyện Sơn, trong tay còn nắm chặt một bình nước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050817
					],
					"speakerTitle": "Chú Luo"
				},
				{
					"id": 711050817,
					"content": "Ông ấy nói trong sân nhà mình có cây tiên thảo, phải tưới loại nước tiên đó mới sống được. Tôi thấy người đó thật hồ đồ, đều là nước sông cả, có gì đặc biệt chứ? Vì thứ này mà mất đi cả tính mạng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050818
					],
					"speakerTitle": "Chú Luo"
				},
				{
					"id": 711050818,
					"content": "Haiz... Nghĩa tử là nghĩa tận. Sau khi mai táng, chúng tôi vẫn đem thứ nước ông ấy mang về vẩy vào sân nhà, hy vọng ông ấy được yên nghỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050819
					],
					"speakerTitle": "Chú Luo"
				},
				{
					"id": 711050819,
					"content": "Nước tiên ở Huyền Luyện Sơn à? Chúng tôi cũng đến đó rồi, còn lấy cả nước tiên nữa... Người hái thuốc này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050820
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050820,
					"content": "Cảm giác... chính là cùng một người.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050821
					]
				},
				{
					"id": 711050821,
					"content": "Vậy thì lạ thật. Hay là... hai vị đi với tôi một chuyến, để tôi đưa hai vị đến sân nhà ông ấy xem thử.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050822
					],
					"speakerTitle": "Chú Luo"
				},
				{
					"id": 711050822,
					"content": "Nếu hai vị cũng lấy nước rồi thì thử vẩy vào sân nhà ông ấy xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chú Luo"
				}
			]
