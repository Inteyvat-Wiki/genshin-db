			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 711050201,
					"content": "\"Ngủ quên mất rồi! Phải mau về trước ngày mai mới được, nếu không thì không ai chăm lo cho Xiangjun... Mình thật ngốc quá...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050202
					],
					"speakerTitle": "Ghi Chép Của Ai Đó"
				},
				{
					"id": 711050202,
					"content": "\"Hình như từ Dược Điệp Cốc có một con đường nhỏ dẫn đến Huyền Luyện Sơn... Đi con đường mòn này, sau đó băng qua một hang núi là đến...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050203
					],
					"speakerTitle": "Ghi Chép Của Ai Đó"
				},
				{
					"id": 711050203,
					"content": "\"Nghe nói quanh đó có quái vật, nhưng bây giờ chỉ đành đi đường tắt thử xem sao...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050204
					],
					"speakerTitle": "Ghi Chép Của Ai Đó"
				},
				{
					"id": 711050204,
					"content": "Xem ra đây chính là thứ ông nội cô bé để lại? Ông ấy đi đường mòn rồi! Chúng ta cũng đi tìm thử xem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7110505,
			"completionStepIds": [
				7110505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7110505",
							"2"
						],
						"stepId": 7110505,
