			"dialogs": [
				{
					"id": 711050601,
					"content": "A? Chắc là nơi này nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050602,
					"content": "Sao lại không có ai? Xung quanh hình như cũng không có dấu vết gì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050603,
					"content": "Lẽ nào ông ấy quay về rồi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050604
					]
				},
				{
					"id": 711050604,
					"content": "Khó lắm, ông nội của Xiangjun đã bị thương, sao có thể đi xa như vậy được?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050605,
					"content": "Nhưng ông ấy không ở quanh đây.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050606
					]
				},
				{
					"id": 711050606,
					"content": "Lẽ nào có người gặp được ông ấy trên đường, rồi ra tay cứu giúp? Tôi thấy rất có khả năng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050607,
					"content": "Hay là chúng ta về Làng Kiều Anh hỏi thử xem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050608,
					"content": "Trước tiên lấy một ít \"nước tiên\" đã.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050609
					]
				},
				{
					"id": 711050609,
					"content": "#Lấy nước tiên? Ừm... {NICKNAME} nói phải, nếu ông ấy đúng là đã được cứu thì chắc chắn vẫn cần thứ này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050610,
					"content": "#Chúng ta tiện thể giúp một tay. Hihi, {NICKNAME} quả là chu đáo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
