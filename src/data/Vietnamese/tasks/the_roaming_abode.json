			"dialogs": [
				{
					"id": 711050101,
					"content": "Ông nội...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050102
					],
					"speakerTitle": "???"
				},
				{
					"id": 711050102,
					"content": "Ơ? Người bạn nhỏ, sao em lại ở đây một mình giữa đêm thế? Em tên là gì ấy nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050103,
					"content": "Em là Xiangjun... Em đi tìm ông nội... Ông bị yêu quái bắt mất rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050104
					],
					"speakerTitle": "???"
				},
				{
					"id": 711050104,
					"content": "Yêu... Yêu quái? Nơi này có yêu quái sao? Yêu quái gì thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050105,
					"content": "Em... Em cũng không biết... Ông nội nói vậy đó, ông nói trong núi có yêu quái. Nên bảo em đừng đi lung tung... Nhưng ông lên núi ba ngày rồi mà chưa về nhà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050106
					],
					"speakerTitle": "???"
				},
				{
					"id": 711050106,
					"content": "Chắc là để dọa em chút thôi nhỉ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050107
					]
				},
				{
					"id": 711050107,
					"content": "Tôi cũng thấy thế... Ông ấy có nói là lên núi làm gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050108,
					"content": "Ông nội là người hái thuốc của thôn, gần đây ông hái được một cây tiên thảo, nghe nói phải tưới bằng nước tiên gần Huyền Luyện Sơn mới trưởng thành được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050109
					],
					"speakerTitle": "???"
				},
				{
					"id": 711050109,
					"content": "Vậy nên... Lẽ nào ông gặp phải yêu quái nào đó canh gác nước tiên?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050110
					],
					"speakerTitle": "???"
				},
				{
					"id": 711050110,
					"content": "#Xiangjun đừng lo, giờ đã khuya rồi, ông nội em có lẽ chỉ gặp chút phiền phức nào đó thôi, trước tiên {F#các chị}{M#anh chị} đưa em về nhà được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050111,
					"content": "Nhưng em phải đi cứu ông nội...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050112
					],
					"speakerTitle": "???"
				},
				{
					"id": 711050112,
					"content": "Chúng tôi có thể giúp em.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050113
					]
				},
				{
					"id": 711050113,
					"content": "Thật sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050114
					],
					"speakerTitle": "???"
				},
				{
					"id": 711050114,
					"content": "Ừm! Nếu em không về nhà, không chừng còn khiến ông nội gặp rắc rối hơn đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050115,
					"content": "A... Em không thể để ông nội gặp phiền phức hơn được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050116
					],
					"speakerTitle": "???"
				},
				{
					"id": 711050116,
					"content": "Thế nên cứ để chúng tôi đi tìm ông ấy là được, nhà em ở đâu? Trước tiên để chúng tôi đưa em về đã nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050117,
					"content": "#Không cần đâu {M#anh chị}{F#hai chị}! Nhà em ở Làng Kiều Anh, em có thể tự về được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050118
					],
					"speakerTitle": "???"
				},
				{
					"id": 711050118,
					"content": "#{F#Các chị}{M#Anh chị} có thể đi tìm ông nội luôn được không? Em lo ông ấy gặp nguy hiểm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050119
					],
					"speakerTitle": "???"
				},
				{
					"id": 711050119,
					"content": "Chuyện đó không thành vấn đề. Vậy... em biết cụ thể ông nội đã đi đâu không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050120,
					"content": "Em chỉ biết ông ấy đi về phía bên kia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050121
					],
					"speakerTitle": "???"
				},
				{
					"id": 711050121,
					"content": "Vậy thì cứ qua đó tìm thử trước xem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050122
					]
				},
				{
					"id": 711050122,
					"content": "#Cảm ơn {M#anh chị}{F#hai chị}! Vậy em về nhà đây, không gây rắc rối thêm cho mọi người nữa... Em sẽ ở yên trong làng đợi tin tốt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "???"
				}
			]
		},
		{
			"id": 7110502,
			"completionStepIds": [
				7110502
