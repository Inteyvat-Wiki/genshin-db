					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 711050501,
					"content": "\"...Mặc dù đã lo có quái vật từ trước... Nhưng...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050502
					],
					"speakerTitle": "Ghi Chép Của Ai Đó"
				},
				{
					"id": 711050502,
					"content": "\"...Chảy nhiều quá... Chân không ngừng...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050503
					],
					"speakerTitle": "Ghi Chép Của Ai Đó"
				},
				{
					"id": 711050503,
					"content": "\"...Buồn ngủ quá... Nhưng Huyền Luyện Sơn ở ngay phía trước... Xiangjun... Nhất định phải lấy được nước tiên...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050504
					],
					"speakerTitle": "Ghi Chép Của Ai Đó"
				},
				{
					"id": 711050504,
					"content": "\"...Xiangjun... Ông nhất định sẽ lấy được nước tiên...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050505
					],
					"speakerTitle": "Ghi Chép Của Ai Đó"
				},
				{
					"id": 711050505,
					"content": "Nguy rồi... Ông ấy bị ma vật tập kích, hình như bị thương rất nặng... Vậy mà còn muốn đến Huyền Luyện Sơn lấy nước sao?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050506,
					"content": "Chúng ta mau đến đó đi, hy vọng giúp được ông ấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
