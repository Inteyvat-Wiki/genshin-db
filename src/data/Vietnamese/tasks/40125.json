			"dialogs": [
				{
					"id": 401251201,
					"content": "Nếu đi từ Làng Aaru... sẽ có thể đi ngang Dịch Trạm Lữ Khách, Pardis Dhyai... rồi đến Thành Sumeru...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251202
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 401251202,
					"content": "Thì ra là vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251203
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401251203,
					"content": "Muốn tiện đường mua gì không? Mọi người chỉ cần lo chọn quà, còn tôi sẽ phụ trách xách chúng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251204
					],
					"speakerTitle": "Lessig"
				},
				{
					"id": 401251204,
					"content": "Nặng bao nhiêu cũng không sao, tôi có thể xách được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251205
					],
					"speakerTitle": "Lessig"
				},
				{
					"id": 401251205,
					"content": "Bình tĩnh đi, có bao nhiêu người cần tặng đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251206
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401251206,
					"content": "Mẹ, anh Albedo, đội trưởng Jean, Razor... chị Diona, chị Mona, chị Fischl...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251207
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401251207,
					"content": "Nhìn tôi làm gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251208
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401251208,
					"content": "Không có gì, không có gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251209
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 401251209,
					"content": "Klee muốn chọn quà gì cho mọi người?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251210
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 401251210,
					"content": "Kẹo vị Quả Nhật Lạc! Rồi nón lớn như Nấm Quỷ nữa, còn nữa còn nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251211
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401251211,
					"content": "Klee muốn mua thật nhiều quyển truyện tặng cho mọi người!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251212
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401251212,
					"content": "Nhưng quà tặng cho mẹ thì Klee chưa nghĩ ra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251213
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401251213,
					"content": "Không sao, vừa đi vừa xem, các chị cũng sẽ giúp Klee.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251214
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401251214,
					"content": "Dạ! Cảm ơn chị!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
