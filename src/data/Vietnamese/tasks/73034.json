				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 730340601,
					"content": "Ơ? Bức thư này... hình như do Collei để lại, chúng ta xem thử đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730340602,
					"content": "Nhưng tại sao cô ấy vẫn chưa quay về...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730340603
					]
				},
				{
					"id": 730340603,
					"content": "Có lẽ lại cùng Tighnari ra ngoài làm việc rồi, họ lúc nào cũng bận rộn cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730340604,
					"content": "Mau xem lá thư này đi. Nhìn nét chữ này, khi Collei viết đúng là đã dùng lực rất mạnh đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730340605,
					"content": "#\"{NICKNAME} và Paimon, cảm ơn các bạn đã giúp tôi chăm sóc chậu hoa này.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730340606,
					"content": "\"Khoảng thời gian này trong rừng có quá nhiều việc cần phải xử lý, tôi cứ bận lên là lại quên chăm sóc chậu hoa...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730340607,
					"content": "\"Một lần nữa cảm ơn sự giúp đỡ của các bạn, đợi đến khi tôi có thời gian, chúng ta cùng đến tiệm của ông Jahangir ăn \"Thuyền Khoai Tây\" nhé!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730340608,
					"content": "Wow! Bạn xem này, Collei nói sẽ mời chúng ta ăn món ngon kìa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730340609,
					"content": "Chỉ là không biết Collei đang giải quyết chuyện gì, có vẻ như cô ấy bận sắp không thở nổi luôn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730340610,
					"content": "Mong cô ấy nghỉ ngơi thật tốt, đừng quá lao lực...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}