			"dialogs": [
				{
					"id": 191320401,
					"content": "Xin chào, cho hỏi có chuyện gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191320402
					],
					"speakerTitle": "Lanyang"
				},
				{
					"id": 191320402,
					"content": "Tôi đến lấy y phục giúp Ningguang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191320403
					]
				},
				{
					"id": 191320403,
					"content": "À, tôi có nghe nói rồi, vậy bạn hãy đợi trong chốc lát, tôi vào lấy ngay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191320404
					],
					"speakerTitle": "Lanyang"
				},
				{
					"id": 191320404,
					"content": "Đợi một lúc lâu, cuối cùng Lanyang đã quay lại.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						191320405
					]
				},
				{
					"id": 191320405,
					"content": "Chính là bộ này, phiền bạn giao cho Ningguang đại nhân nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191320406
					],
					"speakerTitle": "Lanyang"
				},
				{
					"id": 191320406,
					"content": "Hình như cô mất rất nhiều thời gian.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191320407
					]
				},
				{
					"id": 191320407,
					"content": "Ừm, bởi vì căn phòng này chứa rất nhiều đồ sưu tầm của Ningguang đại nhân, không chỉ riêng y phục, còn có các loại văn vật, ngọc ngà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191320408
					],
					"speakerTitle": "Lanyang"
				},
				{
					"id": 191320408,
					"content": "Gần đây đang sắp xếp lại theo ý của Ningguang đại nhân, cho nên trong phòng tương đối lung tung, hiện tại vẫn chưa thể tự tiện ra vào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191320409,
						191320410
					],
					"speakerTitle": "Lanyang"
				},
				{
					"id": 191320409,
					"content": "(Nghe có vẻ quả thật có rất nhiều đồ quý...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191320411
					]
				},
				{
					"id": 191320411,
					"content": "Tóm lại, rất cám ơn bạn, bộ y phục này xin giao cho bạn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lanyang"
				},
				{
					"id": 191320410,
					"content": "(Đây gọi là ưu phiền của người giàu sao.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191320411
					]
				}
			]
		},
