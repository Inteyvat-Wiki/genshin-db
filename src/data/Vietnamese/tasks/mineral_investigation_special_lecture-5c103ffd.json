				{
					"id": 761710301,
					"content": "Lần sau có nên hợp tác với Hiệp Hội Nhà Mạo Hiểm tổ chức một cuộc thi bình chọn viên đá đẹp nhất Thị Trấn Nasha không nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710302
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761710302,
					"content": "Nếu vậy thì phải nghĩ cách cấm Dorota tham gia nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710303
					],
					"speakerTitle": "Jurva"
				},
				{
					"id": 761710303,
					"content": "Ôi, nếu để chị ấy tham gia thì chị ấy sẽ dùng mọi cách để Bạc Ánh Trăng giành chiến thắng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710304
					],
					"speakerTitle": "Mikko"
				},
				{
					"id": 761710304,
					"content": "Nhưng, nhưng mà không cho chị ấy tham gia thì cũng quá bất công rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710305
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761710305,
					"content": "Thì bạn cũng thuộc phe Bạc Ánh Trăng giống chị ấy mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mikko"
				}
			]
