			"dialogs": [
				{
					"id": 761710101,
					"content": "Speranza hôm nay cũng nhộn nhịp thế nhỉ, mọi người đang nói chuyện gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761710102,
					"content": "Chúng em đang thảo luận xem viên đá nào đẹp nhất ở Nod-Krai, em bỏ một phiếu cho Bạc Ánh Trăng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710103
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761710103,
					"content": "Auni không có ở đây, thay em ấy bỏ một phiếu cho Đá Lạnh Giá vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710104
					],
					"speakerTitle": "Jurva"
				},
				{
					"id": 761710104,
					"content": "Em chọn Pha Lê Cầu Vồng! Pha Lê Cầu Vồng có nhiều màu sắc đẹp mắt, lại còn dùng để rèn vũ khí nữa, hữu ích hơn Bạc Ánh Trăng và Đá Lạnh Giá nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710105
					],
					"speakerTitle": "Mikko"
				},
				{
					"id": 761710105,
					"content": "Không phải là chọn viên đá \"đẹp nhất\" sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761710106
					]
				},
				{
					"id": 761710106,
					"content": "Hmm... Loại đá chỉ đẹp mà không có tác dụng gì thì không thể coi là thực sự đẹp được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710107
					],
					"speakerTitle": "Mikko"
				},
				{
					"id": 761710107,
					"content": "Ya-ho... Ya-hoho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710108
					],
					"speakerTitle": "Lumi"
				},
				{
					"id": 761710108,
					"content": "Thực ra công dụng của Bạc Ánh Trăng cũng không ít đâu, chỉ là không giống như Pha Lê Cầu Vồng có ứng dụng gần gũi với đời sống thường ngày như vậy thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710109
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761710109,
					"content": "Nói về chuyện này, trong quá trình điều tra chị từng nghe một số câu chuyện thú vị, kể về những bộ quần áo được dệt từ Bạc Ánh Trăng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710110
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761710110,
					"content": "Hả? Nói dối, đó là đá cơ mà, sao dùng để dệt quần áo được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710111
					],
					"speakerTitle": "Mikko"
				},
				{
					"id": 761710111,
					"content": "Haha, Mikko cũng thấy thần kỳ phải không? Vậy thì mau ngoan ngoãn ngồi yên nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710112
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761710112,
					"content": "#Quần áo làm từ Bạc Ánh Trăng... Tôi cũng rất tò mò! {NICKNAME}, mau ngồi xuống đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761710113,
					"content": "Có một câu chuyện kể rằng, rất lâu rất lâu về trước, ở Nod-Krai có một vị tổng đốc fae mê mẩn những kho báu quý hiếm và vô cùng thích ăn diện...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710114
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761710114,
					"content": "Để sưu tầm cho ông những bộ trang phục mới lạ, các cố vấn của dinh tổng đốc đều vô cùng đau đầu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710115
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761710115,
					"content": "Sau đó vào một ngày nọ, có một thợ may trẻ tuổi mặc đồ đen đến, nói rằng mình đã kế thừa kỹ thuật thần bí của vương quốc hoàng kim, có thể kéo những viên pha lê trong vắt như ánh trăng thành chỉ bạc, rồi dệt thành quần áo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710116
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761710116,
					"content": "Tổng đốc nghe vậy vui mừng khôn xiết, hứa hẹn với người thợ may trẻ tuổi mức thù lao hậu hĩnh, rồi mời anh ta ở lại dinh thự để may quần áo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710117
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761710117,
					"content": "Thợ may trẻ dặn tổng đốc gửi rất nhiều Bạc Ánh Trăng đến xưởng, và yêu cầu không ai được phép nhìn trộm khi anh ta làm việc, tổng đốc đều đồng ý làm theo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710118
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761710118,
					"content": "Đến ngày giao hàng, xưởng trống rỗng, không có Bạc Ánh Trăng, cũng không thấy thứ gì giống như quần áo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710119
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761710119,
					"content": "Tổng đốc vốn tưởng mình sẽ được mặc bộ quần áo mới, vội vàng hỏi: \"Vậy số Bạc Ánh Trăng đó đâu rồi? Sao cũng không thấy bộ lễ phục ánh trăng như đã hứa hẹn?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710120
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761710120,
					"content": "Chỉ thấy người thợ may trẻ tuổi giơ tay lên, khẽ vẩy nhẹ như đang cầm một tấm vải trên tay, rồi nói:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710121
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761710121,
					"content": "\"Ngài xem, số Bạc Ánh Trăng mà ngài gửi đến đã được tôi dệt thành quần áo, chỉ có điều bộ lễ phục này cao quý thuần khiết như ánh trăng, nên những kẻ ngu ngốc và tầm thường không thể nào nắm bắt được.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710122
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761710122,
					"content": "Tổng đốc hỏi vị cố vấn bên cạnh, trong mắt người đó bộ lễ phục ánh trăng trông như thế nào. Vị cố vấn chỉ nói là đẹp tuyệt vời, chưa từng thấy bộ trang phục nào lộng lẫy như thế này, giống như ánh trăng thật sự vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710123
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761710123,
					"content": "Tổng đốc chẳng nhìn thấy gì cả, nhưng ông không muốn thừa nhận mình là kẻ ngu ngốc hay tầm thường như thợ may đã nói, nên vẫn làm theo chỉ dẫn của thợ may mà \"khoác lên\" bộ \"lễ phục ánh trăng\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710124
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761710124,
					"content": "Để khoe bộ trang phục mới đặc biệt này, tổng đốc cố ý chọn con đường đông người nhất trong thị trấn để tuần du, cho đến khi một đứa trẻ đeo ốc biển bên hông phá lên cười...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710125
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761710125,
					"content": "\"Tổng đốc sao không mặc quần áo!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710126
					],
					"speakerTitle": "Mikko"
				},
				{
					"id": 761710126,
					"content": "Xem ra Mikko đã đoán được rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710127
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761710127,
					"content": "Vị thợ may trẻ tuổi đó nhìn qua cũng biết là kẻ lừa đảo rồi, ở Thị Trấn Nasha cũng có mấy người như vậy. Trước đó nghe nói có một nữ lừa đảo đến từ Sumeru cũng đã lừa không ít người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710128
					],
					"speakerTitle": "Mikko"
				},
				{
					"id": 761710128,
					"content": "Vậy cuối cùng Bạc Ánh Trăng đã đi đâu rồi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761710129
					]
				},
				{
					"id": 761710129,
					"content": "Câu hỏi hay đấy, trong câu chuyện có nói rằng, thực ra thợ may trẻ tuổi này chính là Reed Miller cải trang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710130
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761710130,
					"content": "Anh ta đã đổi số lượng lớn Bạc Ánh Trăng nhận được từ tổng đốc thành Mora và chia cho những người nghèo khổ trong thị trấn. Khi tổng đốc tuần du trong thị trấn, anh ta đang ngồi trên mái nhà nào đó xem trò hay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710131
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761710131,
					"content": "Người này cũng bận rộn thật đấy, đủ mọi câu chuyện đều thấy bóng dáng anh ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710132
					],
					"speakerTitle": "Jurva"
				},
				{
					"id": 761710132,
					"content": "Ừm? Nghĩ kỹ lại thì, nếu anh ta là kẻ lừa đảo, vậy chẳng phải là không hề có loại vải dệt từ Bạc Ánh Trăng sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761710133,
					"content": "Tôi nghĩ là có đấy, chỉ là kỹ thuật dệt vải đã thất truyền, nên chỉ có thể tìm thấy dấu vết trong những câu chuyện dân gian thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710134
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761710134,
					"content": "Trong câu chuyện về người đánh cá và Volkodlak cũng có nhắc đến bộ lễ phục ánh trăng... Nhưng câu chuyện này còn quá sớm đối với Mikko và Maisie, nên hôm nay tạm không kể nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710135
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761710135,
					"content": "Ơ, sao lại như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710136
					],
					"speakerTitle": "Mikko"
				},
				{
					"id": 761710136,
					"content": "Cô giáo Linnea biết nhiều câu chuyện kỳ lạ quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761710137,
					"content": "Tôi cũng có rất nhiều trải nghiệm trong chuyến hành trình có thể chia sẻ đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761710138
					]
				},
				{
					"id": 761710138,
					"content": "#Ừm ừm! {NICKNAME} chắc cũng hiểu mà đúng không? Thế giới rộng lớn như vậy, có biết bao nhiêu bí cảnh mà chúng ta chưa từng biết đến!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710139
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761710139,
					"content": "Ngay cả những điều mà chúng ta tưởng rằng mình đã hiểu rõ, cũng có thể ẩn chứa những bối cảnh và truyền thuyết chưa từng biết đến, giống như Bạc Ánh Trăng vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710140
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761710140,
					"content": "Pha Lê Cầu Vồng cũng vậy, khắp nơi trên Teyvat đều có loại khoáng thạch đặc trưng riêng, giống như người ở mỗi quốc gia có phong tục khác nhau, khoáng thạch ở mỗi nơi cũng có tính cách khác nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710141
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761710141,
					"content": "Chỉ cần đủ kiên nhẫn, ngay cả những kết tinh im lặng này cũng sẽ dần bập bẹ, chia sẻ về mọi điều mà chúng đã ghi lại trong quá khứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710142
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761710142,
					"content": "Không chỉ có khoáng thạch, mà cả những sinh vật già cỗi hay trẻ trung kia, đều đẹp đẽ và độc đáo đến thế... Thế giới này tràn ngập bao câu chuyện và những điều bí ẩn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710143
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761710143,
					"content": "Vào khoảnh khắc những bí ẩn chưa từng biết đến được giải đáp, giống như vô số khả năng được thắp lên, cả thế giới đều sẽ rộng mở trước mắt...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710144
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761710144,
					"content": "À, xin... xin lỗi, hình như tôi phấn khích quá rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710145
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761710145,
					"content": "Chị Linnea cứ nói về những thứ mình thích là lại như vậy đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710146
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761710146,
					"content": "Cô giáo cứ như vậy thì làm sao chúng em chọn được viên đá đẹp nhất ở Nod-Krai chứ, dù sao thì chị chắc chắn sẽ nói tất cả đều đẹp mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710147
					],
					"speakerTitle": "Mikko"
				},
				{
					"id": 761710147,
					"content": "Nếu vậy thì hai vị cũng bỏ phiếu đi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710148
					],
					"speakerTitle": "Jurva"
				},
				{
					"id": 761710148,
					"content": "#Viên đá đẹp nhất à... {NICKNAME} cảm thấy là loại nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710149,
						761710151,
						761710153,
						761710155
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761710149,
					"content": "Đá Lạnh Giá",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761710150
					]
				},
				{
					"id": 761710150,
					"content": "#Đá Lạnh Giá sao? Gu của {NICKNAME} độc đáo đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710158
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761710158,
					"content": "Vậy còn chị Linnea thì sao? Nếu nhất định phải chọn cái đẹp nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710159
					],
					"speakerTitle": "Mikko"
				},
				{
					"id": 761710159,
					"content": "Ừm... Hôm, hôm nay kể đến đây thôi nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710160
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761710160,
					"content": "Woa, định bỏ chạy à...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mikko"
				},
				{
					"id": 761710151,
					"content": "Bạc Ánh Trăng",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761710152
					]
				},
				{
					"id": 761710152,
					"content": "#Quả nhiên {NICKNAME} vẫn chọn thứ này, nhưng tôi cũng cảm thấy Bạc Ánh Trăng rất đẹp!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710158
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761710153,
					"content": "Pha Lê Cầu Vồng",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761710154
					]
				},
				{
					"id": 761710154,
					"content": "Ồ, đúng như Mikko nói, màu sắc vừa nhiều vừa đẹp nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710158
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761710155,
					"content": "Mũ của Lumi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761710156
					]
				},
				{
					"id": 761710156,
					"content": "Ya-ho?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710157
					],
					"speakerTitle": "Lumi"
				},
				{
					"id": 761710157,
					"content": "Hmm? Hình như cũng được tính là đá... Cũng đẹp đấy chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710158
					],
					"speakerTitle": "Paimon"
				}
			]
		},
