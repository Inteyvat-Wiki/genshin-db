			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750690801,
					"content": "(Cơ thể lạnh lẽo trông giống như Quenin, không biết tại sao lại không bị phân hủy, mà vẫn duy trì trạng thái như vậy...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690802
					],
					"speakerTitle": "Cơ Thể Lạnh Lẽo"
				},
				{
					"id": 750690802,
					"content": "(Hơn nữa, nhìn từ môi trường xung quanh, có lẽ đã duy trì trạng thái này từ rất lâu rồi...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cơ Thể Lạnh Lẽo"
				}
			]
		},
