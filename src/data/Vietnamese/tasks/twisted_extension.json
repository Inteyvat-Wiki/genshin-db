			"dialogs": [
				{
					"id": 750691101,
					"content": "Thác nước, haha... Bởi vì tiếng thác nước đã lấn át mọi thứ, nên không còn nghe thấy gì nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750691102
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750691102,
					"content": "#Ồ, là {F#cô}{M#cậu} à, có chuyện gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750691103
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750691103,
					"content": "Không có gì.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750691104
					]
				},
				{
					"id": 750691104,
					"content": "Vậy sao... Nghe tôi khuyên đi, dũng sĩ, hãy mau rời khỏi đây đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quenin"
				}
			]
		},
