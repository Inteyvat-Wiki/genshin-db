				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Quenin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750690201,
					"content": "Ôi, nơi này, rất ít người đến... Bởi vì dù sao cũng là nơi nguy hiểm mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690202
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750690202,
					"content": "#Chẳng lẽ {F#cô}{M#cậu} cũng là người của đội mạo hiểm sao...? Hừm, nghe nói cái bóng của Mãng Xà Đen đã đáp từ trên Tonatiuh xuống... {F#Cô}{M#Cậu} cũng phải cẩn thận đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690203
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750690203,
					"content": "Hoặc là sớm rời khỏi đây đi. Trong đội mạo hiểm, hah, cũng có những thứ không phải con người ẩn nấp... Những âm thanh đó, rất ồn ào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690204
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750690204,
					"content": "Ở đây thì lại yên tĩnh hơn. Haha... Bởi vì tiếng thác nước đã lấn át mọi thứ, nên không còn nghe thấy gì nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quenin"
				}
			]
		},
		{
			"id": 7506905,
			"completionStepIds": [
				7506903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7506903",
							"2"
						],
						"stepId": 7506903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750690501,
					"content": "(Một trang giấy bị rách, với những từ được viết ngay ngắn ở phần đầu...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690502
					],
					"speakerTitle": "Nhật Ký Của Quenin"
				},
				{
					"id": 750690502,
					"content": "\"...Ma vật của Vực Sâu ngày càng nhiều, điều này có thể dự đoán được... Cuối cùng thì đội mạo hiểm vẫn thất bại, kế hoạch rút lui đang tiến hành.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690503
					],
					"speakerTitle": "Nhật Ký Của Quenin"
				},
				{
					"id": 750690503,
					"content": "\"Nhất định phải cho những người còn lại sơ tán an toàn. Phải cẩn thận những người đột nhiên biến mất vào ban đêm, hoặc những kẻ trở về từ nơi tăm tối.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690504
					],
					"speakerTitle": "Nhật Ký Của Quenin"
				},
				{
					"id": 750690504,
					"content": "\"...Những ma vật Vực Sâu đó càng ngày càng nhiều, căn cứ đó có lẽ cũng sẽ bị phát hiện mất. Nhưng trước lúc đó...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690505
					],
					"speakerTitle": "Nhật Ký Của Quenin"
				},
				{
					"id": 750690505,
					"content": "(Chữ phía dưới bắt đầu trở nên lộn xộn...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690506
					],
					"speakerTitle": "Nhật Ký Của Quenin"
				},
				{
					"id": 750690506,
					"content": "\"Ôi, lạnh quá... lạnh quá... Ở đó, ở đó, máu cũng chảy hết...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690507
					],
					"speakerTitle": "Nhật Ký Của Quenin"
				},
				{
					"id": 750690507,
					"content": "\"Tiếng thác nước, lớn quá, đúng, như vậy là được. Chỉ cần như vậy... Chỉ cần ở dưới thác nước, ở đó sẽ yên tĩnh, gương mặt trắng xóa, miệng mở rộng, máu chảy...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690508
					],
					"speakerTitle": "Nhật Ký Của Quenin"
				},
				{
					"id": 750690508,
					"content": "\"Ở đó, ở... ở đó, có thứ gì đó... Có thứ gì đó...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690509
					],
					"speakerTitle": "Nhật Ký Của Quenin"
				},
				{
					"id": 750690509,
					"content": "\"Ở dưới thác nước ở dưới thác nước ở dưới thác nước ở dưới thác nước ở dưới thác nước ở dưới thác nước...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nhật Ký Của Quenin"
				}
			]
		},
