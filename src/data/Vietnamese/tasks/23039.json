			"dialogs": [
				{
					"id": 230390401,
					"content": "Hú... hú... em thắng rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390402,
						230390403
					],
					"speakerTitle": "Hilmi"
				},
				{
					"id": 230390402,
					"content": "Chúc... chúc mừng em...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390404
					]
				},
				{
					"id": 230390404,
					"content": "#Hihi, em có nói là em rất giỏi chạy bộ mà, {M#anh}{F#chị} khinh địch sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390405
					],
					"speakerTitle": "Hilmi"
				},
				{
					"id": 230390405,
					"content": "Nhưng mà, cho dù có chạy nhanh đến mấy, anh Habachi vẫn có thể bắt được chúng em, rốt cuộc là tại sao chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390406,
						230390407
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390406,
					"content": "Có lẽ là chạy đường tắt rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390408
					]
				},
				{
					"id": 230390408,
					"content": "Như thế sao? Ừm... nhưng mà quanh đây hình như đâu có đường tắt nào nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390409
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390409,
					"content": "#Hay là, chúng em lần tới mời {M#anh}{F#chị} đến chơi cùng chúng em nhé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390410
					],
					"speakerTitle": "Hilmi"
				},
				{
					"id": 230390410,
					"content": "Cùng chúng em luyện tập cái trò... \"trốn tìm\" đó đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390411
					],
					"speakerTitle": "Hilmi"
				},
				{
					"id": 230390411,
					"content": "Đúng rồi, dù gì cũng chạy không bằng anh Habachi, thế nên chúng ta cứ lách qua anh ấy vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390412
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390412,
					"content": "Chúng ta trước đây chẳng phải đã lẩn trốn anh ấy rồi sao? Nhưng mà có làm thế nào thì anh Habachi cũng đều phát hiện ra mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hilmi"
				},
				{
					"id": 230390407,
					"content": "Có lẽ là có kỹ xảo nào đó rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390408
					]
				},
				{
					"id": 230390403,
					"content": "Chạy... chạy nhanh thế...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390404
					]
				}
			]
