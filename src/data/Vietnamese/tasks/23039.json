				"points": []
			},
			"dialogs": [
				{
					"id": 230390101,
					"content": "#{M#Anh}{F#Chị} ơi! Đợi một chút!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390102
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390102,
					"content": "#Cho hỏi... {M#anh}{F#chị} là nhà mạo hiểm phải không? Là kiểu nhà mạo hiểm mà thám hiểm qua rất nhiều nơi, rất giỏi chiến đấu phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390103,
						230390104
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390103,
					"content": "Có thể xem là vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390105
					]
				},
				{
					"id": 230390105,
					"content": "#Bạn xem! Hilmi, mình đã bảo mà, {M#anh}{F#chị} này chắc chắn là nhà mạo hiểm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390106
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390106,
					"content": "Nhưng mà nhà mạo hiểm chẳng phải đều sẽ mặc bộ đồ xanh xanh đó sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390107,
						230390108
					],
					"speakerTitle": "Hilmi"
				},
				{
					"id": 230390107,
					"content": "#{M#Anh}{F#Chị} hơi bị lợi hại đấy, nên không cần ăn mặc như thế.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390109
					]
				},
				{
					"id": 230390109,
					"content": "Ồ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390110
					],
					"speakerTitle": "Hilmi"
				},
				{
					"id": 230390110,
					"content": "Ồ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390111
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390111,
					"content": "#Vậy thì {M#anh}{F#chị} ơi! {M#Anh}{F#Chị} chắc chắn có thể giúp được em việc này rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390112
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390112,
					"content": "#{M#Anh}{F#Chị} có nhìn thấy căn nhà kho to to đằng kia không? Anh Habachi nói, bên trong có cất đồ rất quan trọng, phải được canh giữ cẩn thận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390113
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390113,
					"content": "Anh ấy còn nói với chúng em rằng, nếu như có kẻ xấu đến tấn công làng, anh ấy sẽ ngắt thang nâng hạ trước, sau đó cắt đứt cầu treo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390114
					],
					"speakerTitle": "Hilmi"
				},
				{
					"id": 230390114,
					"content": "Tuy nhiên từ nhà kho đến thang nâng hạ còn một đoạn đường dài cơ, anh Habachi nếu muốn ngắt thang nâng hạ thì phải chạy hết tốc lực qua đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390115
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390115,
					"content": "Chúng em đã đề xuất là, chúng em có thể cùng anh ấy luyện tập, nhưng anh Habachi chẳng thèm đoái hoài chúng em...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390116
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390116,
					"content": "Rõ ràng là mỗi khi chúng em muốn đi làm việc riêng, phản ứng của anh ấy đều rất gay gắt, hứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390117
					],
					"speakerTitle": "Hilmi"
				},
				{
					"id": 230390117,
					"content": "Haiz, suy cho cùng! Nếu như kẻ xấu tấn công vào làng, mà anh Habachi chạy không nổi nữa, thì chỉ có thể để chúng em đi ngắt thang nâng hạ thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390118
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390118,
					"content": "#{M#Anh}{F#Chị} à, {M#anh}{F#chị} là nhà mạo hiểm, chắc chắn rất giỏi chạy bộ rồi, xin {M#anh}{F#chị} hãy cùng luyện tập với chúng em một chút nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390119,
						230390121
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390119,
					"content": "#Vậy thì {M#anh}{F#chị} sẽ cùng các em chạy một đoạn nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390120
					]
				},
				{
					"id": 230390120,
					"content": "#Hay quá đi! Cảm ơn {M#anh}{F#chị}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390126
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390126,
					"content": "Chúng em đã chọn được điểm xuất phát rồi, chúng ta tới đằng kia nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390127
					],
					"speakerTitle": "Hilmi"
				},
				{
					"id": 230390127,
					"content": "#Hihi, lần này để em cùng {M#anh}{F#chị} thi đấu. Nói trước nhé, em chạy giỏi lắm đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hilmi"
				},
				{
					"id": 230390121,
					"content": "Có thể tin tưởng vào Habachi mà...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390122
					]
				},
				{
					"id": 230390122,
					"content": "Haiz... chơi cùng tụi em đi mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390123
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390123,
					"content": "#Cùng chúng em luyện tập chút đi, đi mà {M#anh}{F#chị}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390124
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390124,
					"content": "Được rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390125
					]
				},
				{
					"id": 230390125,
					"content": "#Hay quá đi! Cảm ơn {M#anh}{F#chị}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390126
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390108,
					"content": "#{M#Anh}{F#Chị} hơi bị đặc biệt đấy, nên không cần ăn mặc như thế.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390109
					]
				},
				{
					"id": 230390104,
					"content": "Nói thế thì cũng không sai...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390105
					]
				}
			]
