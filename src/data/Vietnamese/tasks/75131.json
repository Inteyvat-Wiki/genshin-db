			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 751310301,
					"content": "Mưa, mưa lửa sinh học! Lẽ nào lửa sẽ lao vào đầu người ta như là sinh vật sống à? Ôi, núi lửa của Natlan đáng sợ quá đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751310302,
					"content": "#{NICKNAME}, tôi có hơi tò mò. Hihi, hay là bây giờ chúng ta tới khu vực phía trước thám hiểm đi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7513104,
			"completionStepIds": [
				7513102
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7513102",
							"2"
						],
						"stepId": 7513102,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_VAR_EQUAL",
						"rawParams": [
							"0",
							"0",
							"75131"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 751310401,
					"content": "...Ôi, ngọn lửa giống như sinh vật sống, dư ảnh kỳ lạ, máy ảnh có thể tự động chụp ảnh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751310402,
					"content": "Trực giác mách bảo, trong đó ắt hẳn có một bí ẩn khó mà giải thích được! Nói không chừng liên quan đến kho báu đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751310403,
					"content": "Paimon nhìn ra gì sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751310404
					]
				},
				{
					"id": 751310404,
					"content": "Nói thật... không có manh mối gì hết cả! Nhưng... chủ nhân của máy ảnh đã để nó ở đây thì nhất định là để chụp ảnh khi mặt đất rung chuyển.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751310405,
					"content": "Cho nên chúng ta chỉ cần khôi phục lại máy ảnh, sau đó đợi mặt đất rung chuyển là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751310406,
					"content": "Hihi, tôi tin là đến lúc đó, manh mối của kho báu sẽ ào ào tuôn ra như là dư ảnh đó vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
