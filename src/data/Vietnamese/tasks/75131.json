			"dialogs": [
				{
					"id": 751310601,
					"content": "Sau khi kiểm tra máy ảnh, các bạn phát hiện trong máy ảnh không chỉ có một bộ ảnh phong cảnh, mà còn có một thiết bị đặc biệt. Thiết bị này dường như có thể giúp máy ảnh tự động chụp ảnh khi mặt đất xảy ra rung chuyển.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
