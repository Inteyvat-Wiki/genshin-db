				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Matzahtli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751310101,
					"content": "Mưa lửa sinh học... Chẳng lẽ, giống như trong truyền thuyết, núi lửa phun trào sẽ tiến hóa và sinh trưởng như vật sống, biến mọi thứ xung quanh thành núi lửa á? Nguy hiểm quá, tiêu rồi, tiêu rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310102,
						751310103
					],
					"speakerTitle": "Matzahtli"
				},
				{
					"id": 751310102,
					"content": "Núi lửa đâu phải hình thành như vậy đâu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751310104
					]
				},
				{
					"id": 751310104,
					"content": "Đúng vậy, không có dung nham thì làm gì có núi lửa chứ. Núi lửa không thể tùy tiện xuất hiện, nếu không thì nơi này đã sớm trở thành khu vực nguy hiểm rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310105
					],
					"speakerTitle": "Matzahtli"
				},
				{
					"id": 751310105,
					"content": "Nhưng, nhưng lỡ như truyền thuyết là thật thì sao? Ừm, giá mà máy ảnh tự chụp lại được ảnh thì tốt rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310106
					],
					"speakerTitle": "Matzahtli"
				},
				{
					"id": 751310106,
					"content": "Đợi đã, lỡ như máy ảnh xảy ra vấn đề gì đó mà không chụp được ảnh thì phải làm sao? Không được không được, tôi phải dành thời gian đi xem thử mới được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Matzahtli"
				},
				{
					"id": 751310103,
					"content": "Xin lỗi đã làm phiền.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751310107
					]
				},
				{
					"id": 751310107,
					"content": "Tạm biệt... Hay là, vẫn còn ẩn tình gì trong chuyện này nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Matzahtli"
				}
			]
		},
		{
			"id": 7513102,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7513105",
							"3"
						],
						"stepId": 7513105,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Matzahtli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751310201,
					"content": "Thì ra mưa lửa sinh học chính là Chim Dung Nham từ trên trời rơi xuống à, thảo nào phạm vi lớn hơn mưa lửa bình thường nhiều...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310202
					],
					"speakerTitle": "Matzahtli"
				},
				{
					"id": 751310202,
					"content": "Tiêu rồi, nhỡ ngày nào đó chúng va vào nhà tôi thì làm sao? Không được, phải nghĩ cách mới được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310203,
						751310206
					],
					"speakerTitle": "Matzahtli"
				},
				{
					"id": 751310203,
					"content": "Chỉ là tình huống đặc biệt thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751310204
					]
				},
				{
					"id": 751310204,
					"content": "Đúng nhỉ, Chim Dung Nham chỉ có thể bay lên khi núi lửa phun trào thôi, mà nhà tôi lại không ở trong phạm vi phun trào của núi lửa, chắc không cần lo gì đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310205
					],
					"speakerTitle": "Matzahtli"
				},
				{
					"id": 751310205,
					"content": "Nhưng, nhưng nhỡ có một ngày, có một trận phun trào lớn chưa từng có thì sao? Như vậy thì sẽ không còn nơi nào an toàn cả, đúng không? Không được, phải nghĩ cách mới được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Matzahtli"
				},
				{
					"id": 751310206,
					"content": "Xin lỗi đã làm phiền.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751310207
					]
				},
				{
					"id": 751310207,
					"content": "Không sao, không phiền đâu... Tóm lại, phải gia cố mái nhà trước đã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Matzahtli"
				}
			]
		},
		{
			"id": 7513103,
			"completionStepIds": [
				7513106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7513106",
