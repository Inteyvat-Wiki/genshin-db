					"Neko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722150101,
					"content": "Meo, tảng đá này khi nào mới giống ta đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150102
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150102,
					"content": "Bức tượng như thế nào rồi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722150103
					]
				},
				{
					"id": 722150103,
					"content": "Người đá đó nói qua khoảng một thời gian nữa thì sẽ hoàn thành xong tảng đá đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150104
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150104,
					"content": "Đợi khi Hibiki quay trở về, cô ấy nhất định sẽ rất vui mừng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150105
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150105,
					"content": "Đúng vậy, không chỉ là tạc tảng đá đó, còn phải trang trí xung quanh đền thần mới được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150106
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150106,
					"content": "Các ngươi hãy giúp ta treo những quả cầu sắt tròn tròn và phát ra âm thanh này xung quanh đền thần nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150107
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150107,
					"content": "Những thứ này là do Hibiki đã chuẩn bị trước đó, hình như là do Domeki thấy cô ấy thích ta và những đứa nhóc nên đã tặng cho cô ấy. Ta khó khăn lắm mới tìm được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150108
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150108,
					"content": "Đây là... lục lạc?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722150109
					]
				},
				{
					"id": 722150109,
					"content": "Lục lạc? Ta không rõ... nhưng trước đó Hibiki thường cùng ta chơi quả cầu sắt này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150110
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150110,
					"content": "Hibiki đặt quả cầu sắt ở dưới đất, sau đó đánh đến nơi xa. Khi quả cầu lăn sẽ phát ra tiếng leng keng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150111
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150111,
					"content": "Không biết rằng những quả cầu sắt này có sức mạnh gì khiến ta và những con mèo khác vừa nghe thấy đều không cưỡng lại được mà chạy đến đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150112
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150112,
					"content": "Ta hiểu rồi. Bây giờ có ít người đến đền thần như vậy, nhất định là do không có quả cầu sắt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150113
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150113,
					"content": "Cho nên ta muốn nhờ ngươi giúp treo những quả cầu sắt này lên cao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150114
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150114,
					"content": "Như vậy thì con người nghe được âm thanh của quả cầu sắt, sẽ đến đền thần, không đi nhầm đường nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150115
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150115,
					"content": "Vậy thì sẽ nhét tiền vào Hòm Công Đức, đền thần sẽ trở nên náo nhiệt. Khi Hibiki quay về sẽ rất vui mừng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150116
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150116,
					"content": "Cho nên hãy giúp ta treo những quả cầu sắt này xung quanh đền thần nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150117
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150117,
					"content": "Tôi biết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722150118
					]
				},
				{
					"id": 722150118,
					"content": "Phiền ngươi rồi, meo meo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
		},
		{
			"id": 7221502,
