				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722150301,
					"content": "Treo hết lên rồi chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150302
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150302,
					"content": "Treo hết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722150303
					]
				},
				{
					"id": 722150303,
					"content": "Meo meo thật hay quá, như vậy đền thần sẽ náo nhiệt hơn chút rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150304
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150304,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150305
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150305,
					"content": "Ủa? Sao vẫn chưa có thật nhiều thật nhiều người đến vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150306,
						722150307
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150306,
					"content": "Chắc không nhanh đến vậy đâu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722150308
					]
				},
				{
					"id": 722150308,
					"content": "Haiz loài người thật khó hiểu. Đương nhiên là ngươi không phải vậy, ngộ tính của ngươi rất cao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150309
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150309,
					"content": "Tuy hiện tại chưa có ai... nhưng có tiếng leng keng từ quả cầu sắt, thì chí ít những tên nhóc đó sẽ không bị lạc đường, meo meo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150310
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150310,
					"content": "Người đá đó nói tảng đá sắp xong rồi, nhất định phải đến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150311
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150311,
					"content": "À đúng rồi. Còn một chuyện lạ nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150312
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150312,
					"content": "Ta đã đi hỏi hai người xanh xanh đó về chuyện của Hibiki và Domeki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150313
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150313,
					"content": "Nhưng hai người đó đều nói không quen biết Hibiki, cũng không nhớ những chuyện liên quan đến Hibiki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150314
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150314,
					"content": "Nhưng người cao cao xanh xanh đó nói anh ấy từng đọc được chuyện của Ako Domeki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150315
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150315,
					"content": "Nhưng anh ấy nói... \"Giặc\" với \"Thảo phạt\" gì đó... có vẻ như nói Domeki là người xấu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150316
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150316,
					"content": "Chắc chắn là nhầm lẫn rồi. Hibiki và anh ấy thường chơi chung với nhau. Cho nên Domeki cũng là người rất tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150317
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150317,
					"content": "Nhất định là do ngộ tính của người đó không cao. Suy cho cùng vẫn là ngươi đáng tin cậy hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150318
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150318,
					"content": "Hibiki... rốt cuộc khi nào mới trở về đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150307,
					"content": "Không đơn giản như vậy đâu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722150308
					]
				}
			]
		}
	]
}