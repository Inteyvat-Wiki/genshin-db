	"talks": [
		{
			"id": 7422302,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7422302",
							"2"
						],
						"stepId": 7422302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Venier"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 742230201,
					"content": "Một trăm ba mươi sáu... Được rồi, thêm mười bốn lần nữa là được nghỉ ngơi rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230202
					],
					"speakerTitle": "Venier"
				},
				{
					"id": 742230202,
					"content": "Có cần giúp gì không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742230203
					]
				},
				{
					"id": 742230203,
					"content": "Giúp đỡ? Không, không cần đâu, làm gì có chuyện rèn luyện mà lại còn cần người khác giúp đỡ chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230204
					],
					"speakerTitle": "Venier"
				},
				{
					"id": 742230204,
					"content": "Chỉ có rèn luyện thể chất mạnh mẽ thì mới có thể giống như vị chỉ huy này, gia nhập quân đoàn bất hủ và trở thành một binh sĩ vinh quang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230205
					],
					"speakerTitle": "Venier"
				},
				{
					"id": 742230205,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230206
					],
					"speakerTitle": "Venier"
				},
				{
					"id": 742230206,
					"content": "Quên giới thiệu, đây là người hướng dẫn của tôi. Chỉ có vượt qua sát hạch của vị này thì mới có tư cách được đề bạt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230207,
						742230210
					],
					"speakerTitle": "Venier"
				},
				{
					"id": 742230207,
					"content": "Đó không phải là một bức tượng sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742230208
					]
				},
				{
					"id": 742230208,
					"content": "#{F#Cô}{M#Cậu} đang nói gì vậy? Không phải người Remuria đều sẽ trông như vậy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230209
					],
					"speakerTitle": "Venier"
				},
				{
					"id": 742230209,
					"content": "Thế nào, có muốn thử không? Chỉ cần cùng lúc phá vỡ những trụ đá này là xem như đã vượt qua sát hạch sơ bộ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230213
					],
					"speakerTitle": "Venier"
				},
				{
					"id": 742230213,
					"content": "Đừng đánh giá thấp những trụ đá này! Tôi luyện ngày luyện đêm cũng mới chỉ đánh vỡ được một trụ thôi đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venier"
				},
				{
					"id": 742230210,
					"content": "Sát hạch? Sát hạch gì cơ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742230211
					]
				},
				{
					"id": 742230211,
					"content": "Đương nhiên là sát hạch chiến đấu rồi. Cho dù sau khi đề bạt và nhận được thân xác bất diệt, thì kỹ năng chiến đấu cũng phải tự mình mài giũa mới được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230212
					],
					"speakerTitle": "Venier"
				},
				{
					"id": 742230212,
					"content": "Thế nào, có muốn thử không? Chỉ cần cùng lúc phá vỡ những trụ đá này là xem như đã vượt qua sát hạch sơ bộ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230213
					],
					"speakerTitle": "Venier"
				}
			]
		},
