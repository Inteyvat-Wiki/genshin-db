			"dialogs": [
				{
					"id": 742230401,
					"content": "Thật không ngờ... Có thể giải quyết theo cách này sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230402
					],
					"speakerTitle": "Venier"
				},
				{
					"id": 742230402,
					"content": "#Thực sự quá lợi hại. Không lẽ trước đây {F#cô}{M#cậu} từng phục vụ trong quân đoàn của Thần Vương sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230403
					],
					"speakerTitle": "Venier"
				},
				{
					"id": 742230403,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230404
					],
					"speakerTitle": "Venier"
				},
				{
					"id": 742230404,
					"content": "#Chỉ huy cũng khen ngợi biểu hiện của {F#cô}{M#cậu}, xem ra tôi phải chăm chỉ luyện tập rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venier"
				}
			]
		},
