				{
					"id": 220230201,
					"content": "Về nhanh vậy sao? Bạn không phải là đầu bếp ẩn danh đó chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230202
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230202,
					"content": "...Nhanh nhanh nào, để tôi nếm thử món ăn của bạn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230203,
						220230204
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230203,
					"content": "Mời thưởng thức.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 220230204,
					"content": "Để xem nào...ban nãy nói đến món gì nhỉ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220230205
					]
				},
				{
					"id": 220230205,
					"content": "Ừm...là Thịt Mora, Thịt Xông Khói Xào, còn có Thịt Hầm Sốt Rau Củ nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220230206,
					"content": "Quyết định xong thì giao cho Tang Wen nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
