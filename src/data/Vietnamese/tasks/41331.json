					"nextDialogs": [
						413313703
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 413313703,
					"content": "Hy vọng mọi người năm mới sức khỏe dồi dào, vạn sự như ý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313704
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 413313704,
					"content": "Cả những đứa trẻ bôn ba bên ngoài cũng vạn sự như ý...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313705
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 413313705,
					"content": "Được rồi bà Ruoxin, còn không đi ăn thì thức ăn đã chuẩn bị sẽ nguội mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313706
					],
					"speakerTitle": "Xiaobai"
				},
				{
					"id": 413313706,
					"content": "Oa, có đồ ăn ngon!",
