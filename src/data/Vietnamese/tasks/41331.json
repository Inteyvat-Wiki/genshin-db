						413311004
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 413311004,
					"content": "Nếu cháu đồng ý, buổi tối hãy đến trước cửa tìm bà, chúng ta cùng thả đèn tiêu đón tết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413311005
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 413311005,
					"content": "Nhưng không biết bọn trẻ chạy đi đâu rồi... Bà không đi xa được, nên không thể đi tìm bọn trẻ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413311006
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 413311006,
					"content": "Nếu có thể, hãy giúp bà đi tìm bọn trẻ về đây, bọn trẻ rất thích thả đèn tiêu.",
					"roleType": "TALK_ROLE_NPC",
