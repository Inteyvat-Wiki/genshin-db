					"nextDialogs": [
						413313707
					],
					"speakerTitle": "Bé Liu"
				},
				{
					"id": 413313707,
					"content": "Bà ơi, chúng ta đi thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313708
					],
					"speakerTitle": "Dongdong"
				},
				{
					"id": 413313708,
					"content": "Mấy đứa trẻ này... Được rồi, được rồi, mau đi đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313709
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 413313709,
					"content": "Bà không đi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413313710
					]
				},
				{
					"id": 413313710,
					"content": "Bà? Bà từ từ, bà muốn ngắm đèn tiêu thêm một chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313711
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 413313711,
					"content": "Phải rồi, cái này cho cháu, hãy nhận lấy, cảm ơn cháu đã đến đây giúp đỡ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313712
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 413313712,
					"content": "Cảm ơn bà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413313713
					]
				},
				{
					"id": 413313713,
					"content": "Không cần cảm ơn, bà thấy cháu cũng còn trẻ, bôn ba bên ngoài như vậy chắc là vất vả lắm, haiz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313714
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 413313714,
					"content": "Hay là cháu ở đây thêm một chút, cùng mọi người đón tết đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313715
