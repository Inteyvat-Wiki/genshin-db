			"dialogs": [
				{
					"id": 413310201,
					"content": "Lại đến Tết Hải Đẳng rồi, ôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310202
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 413310202,
					"content": "Bà đang lo lắng chuyện gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413310203
					]
				},
				{
					"id": 413310203,
					"content": "Tết Hải Đăng vốn dĩ phải thật náo nhiệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310204
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 413310204,
					"content": "Nhưng Khinh Sách Trang này... toàn người già và trẻ con.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310205
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 413310205,
					"content": "Những đứa trẻ đi làm trong thành, đứa thì nói rằng không thể xin nghỉ phép vì bận công việc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310206
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 413310206,
					"content": "Đứa thì ở xa, không thể thể về kịp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310207
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 413310207,
					"content": "Vốn dĩ là ngày tết đoàn viên nhộn nhịp, kết quả là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310208
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 413310208,
					"content": "Bà cũng hiểu những khó khăn của bọn trẻ bên ngoài, nhưng đây là một ngày tết lớn, haiz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310209
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 413310209,
					"content": "Ôi, không nói nữa, không nói nữa. Ngày tết lớn không nên như thế này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310210
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 413310210,
					"content": "Đúng rồi, nếu cháu đồng ý, cháu có thể đi giúp Bé Bai không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310211
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 413310211,
					"content": "Đứa trẻ đó nói muốn làm một mâm cơm cho mọi người, nó đang rất bận, bà sợ một mình nó làm không nổi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310212,
						413310213
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 413310212,
					"content": "Được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413310214
					]
				},
				{
					"id": 413310214,
					"content": "Vây thì phiền cháu rồi, thực lòng cảm ơn cháu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 413310213,
					"content": "Đừng lo, cháu sẽ đến đó giúp.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413310214
					]
				}
			]
		},
