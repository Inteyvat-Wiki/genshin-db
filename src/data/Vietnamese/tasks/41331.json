					"id": 413310601,
					"content": "Hở? Tìm ông có việc gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310602
					],
					"speakerTitle": "Chú Kai"
				},
				{
					"id": 413310602,
					"content": "Về chuyện bàn ghế...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413310603
					]
				},
				{
					"id": 413310603,
					"content": "Bàn ghế à, ông nhớ mà, ông đã chuẩn bị xong lâu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310604
					],
					"speakerTitle": "Chú Kai"
				},
				{
					"id": 413310604,
					"content": "Ừm... bên trong tiệm chắc vẫn còn, thôi được, dọn ra hết đi vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310605
					],
					"speakerTitle": "Chú Kai"
				},
				{
					"id": 413310605,
					"content": "Được rồi, từng này chắc đủ dùng rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310606
					],
					"speakerTitle": "Chú Kai"
				},
				{
					"id": 413310606,
					"content": "Nhưng mà không ngờ cháu lại đến giúp...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310607
					],
					"speakerTitle": "Chú Kai"
				},
				{
					"id": 413310607,
					"content": "Chuyện nên làm mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413310608
					]
				},
				{
					"id": 413310608,
					"content": "Này, khá lắm, nhưng ngày tết lớn này sao cháu lại không về nhà?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310609,
						413310610
					],
					"speakerTitle": "Chú Kai"
				},
				{
					"id": 413310609,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413310611
					]
				},
				{
					"id": 413310611,
					"content": "Không sao không sao, ông không hỏi nhiều nữa, chắc chắn là cháu có lý do riêng của mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310612
					],
					"speakerTitle": "Chú Kai"
				},
				{
					"id": 413310612,
					"content": "Nhưng nếu cháu đồng ý, cứ ở lại đây ăn tết cũng được, dù sao ở đây cũng rất đông người, cũng khá náo nhiệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chú Kai"
				},
				{
					"id": 413310610,
					"content": "Vì chút chuyện...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413310611
					]
				}
			]
