					"speakerTitle": "Ruoxin"
				},
				{
					"id": 413313715,
					"content": "Bôn ba suốt một năm, có thể nghỉ ngơi một chút cũng tốt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
