					"content": "Haiz... Có lẽ cây tường vi này ngại nở trước mặt các bạn rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240207
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230240207,
					"content": "Nhưng căn cứ theo quy luật phát triển của tường vi, muộn nhất là ngày mai, chắc chắn sẽ nở hoa,",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240208
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240208,
					"content": "Nhà Lữ Hành, ngày mai lại đến nhé!",
