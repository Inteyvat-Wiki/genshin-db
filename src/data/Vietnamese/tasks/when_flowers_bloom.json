						230240405
					]
				},
				{
					"id": 230240405,
					"content": "Tường vi nở hoa rồi, chúng cháu cũng vui lắm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230240406,
					"content": "Phù... Bây giờ có thể giao hàng đúng hẹn cho \"Bimarstan\" rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240407
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240407,
					"content": "Hy vọng cây tường vi này sẽ giúp được cho họ...",
					"roleType": "TALK_ROLE_NPC",
