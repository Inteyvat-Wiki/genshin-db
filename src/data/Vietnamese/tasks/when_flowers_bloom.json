				},
				{
					"id": 230240704,
					"content": "Việc này không nên chậm trễ, để tôi dời bông hoa này đi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240705
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240705,
					"content": "Từ từ, cái này... Có chuyện gì thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240706
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230240706,
					"content": "Trong vườn hoa đột nhiên có động tĩnh khác thường...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230240707
					]
				},
				{
					"id": 230240707,
					"content": "Ôi! Là Hoa Lừa Dối! Sao nó lại ở đây nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230240708,
					"content": "Hỏng rồi! Vườn hoa! Nó phá hỏng vườn hoa rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240709,
						230240710
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230240709,
					"content": "Để tôi giải quyết nó!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230240711
					]
				},
				{
					"id": 230240711,
					"content": "Ơ... ơ? Sao bông Hoa Lừa Dối kia lại chạy trốn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230240712,
					"content": "Sao... sao lại như vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240713
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230240713,
					"content": "Tường vi của chúng ta, thảo dược quan trọng nhất... lại biến thành ma vật chạy mất!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240714,
						230240715
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230240714,
					"content": "Không phải \"biến thành\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230240716
					]
				},
				{
					"id": 230240716,
					"content": "Ý cháu là... Ngay từ đầu cây tường vi này phát triển chậm như thế, là do Hoa Lừa Dối này giở trò đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240717
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240717,
					"content": "Nói vậy! Phân bón hoàn toàn không có tác dụng... tưới lượng nước gấp đôi...",
					"roleType": "TALK_ROLE_NPC",
