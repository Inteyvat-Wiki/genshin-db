			"dialogs": [
				{
					"id": 230240101,
					"content": "Cuối cùng hai người cũng đến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240102
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240102,
					"content": "Thời gian vừa khéo, mọi thứ đã sẵn sàng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240103
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230240103,
					"content": "Sao hào hứng thế?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230240104
					]
				},
				{
					"id": 230240104,
					"content": "Lẽ nào tường vi nở hoa sớm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230240105,
					"content": "Khá lắm, hahaha! Cũng may có cháu hỗ trợ đấy, Nhà Lữ Hành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240106
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240106,
					"content": "Tuy cây tường vi này chưa nở, nhưng dựa theo tình trạng của cả cây, có thể thấy sức khỏe của nó rất dồi dào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240107
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230240107,
					"content": "Nhà Lữ Hành, nếu cháu có hứng thú thì quan sát gần chút thử xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240108
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240108,
					"content": "Hahaha, có khi nó còn nở ngay trước mặt các cháu đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240109
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240109,
					"content": "Thế thì tôi muốn xem kỹ hơn...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230240110
					]
				},
				{
					"id": 230240110,
					"content": "Thật, thật không? Nở hoa trong thời gian ngắn như vậy ư?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230240111,
					"content": "Hóng quá đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
