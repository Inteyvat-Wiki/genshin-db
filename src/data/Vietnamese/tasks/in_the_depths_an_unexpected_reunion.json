			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 80040401,
					"content": "Anh thợ mỏ muốn chúng ta vào đó điều tra sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040402,
					"content": "#Nhìn tòa thành này, {NICKNAME} có nhớ ra chuyện gì không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040403,
					"content": "Ừm, để xem nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040404,
					"content": "Tượng Thần Ô Uế.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040405
					]
				},
				{
					"id": 80040405,
					"content": "Đúng đúng! Rất kinh dị, lại còn đảo ngược nữa, thực sự có chút sợ hãi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040406,
					"content": "Như vậy không lẽ bên dưới Vực Đá Sâu đúng là có liên quan đến Giáo Đoàn Vực Sâu sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040407,
					"content": "Chúng ta phải nghĩ cách đến đó điều tra thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040408,
					"content": "....A!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040409,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040410,
						80040411
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80040410,
					"content": "Dainsleif?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040412
					]
				},
				{
					"id": 80040412,
					"content": "Tôi cũng không ngờ sẽ gặp hai người ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040413
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80040413,
					"content": "Lâu rồi không gặp... À không đúng, sao anh lại đột nhiên xuất hiện ở Vực Đá Sâu thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040414,
					"content": "Vực Đá Sâu... Ở đây là Vực Đá Sâu sao, một nơi mà đến tôi cũng chưa từng đặt chân đến... thì ra là vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040415
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80040415,
					"content": "Tôi có rất nhiều chuyện muốn hỏi anh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040416
					]
				},
				{
					"id": 80040416,
					"content": "Lần gặp mặt và chia tay đó có chút vội vàng, tôi hiểu tâm trạng của hai người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040417
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80040417,
					"content": "#Với cả cuộc hội ngộ này nữa, vận mệnh đúng là đã nợ {F#cô}{M#cậu} một câu trả lời.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040418,
						80040419
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80040418,
					"content": "Có thể giải thích cho tôi nghe tại sao anh lại ở đây không.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040420
					]
				},
				{
					"id": 80040420,
					"content": "Dễ đoán mà. Trước đó tôi đã dò được động tĩnh của một tên Sứ Đồ Vực Sâu, nên đã bắt đầu truy tìm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040421
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80040421,
					"content": "Đáng tiếc, tên đó khi bị tôi ép đến đường cùng đã giở thủ đoạn cũ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040422
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80040422,
					"content": "Tôi đã vội đuổi theo hắn qua cổng dịch chuyển, đúng là không ngoài dự đoán, tôi đã bị lạc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040423,
						80040424
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80040423,
					"content": "Nói như vậy, hồi trước anh chạy qua cổng dịch chuyển...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040425
					]
				},
				{
					"id": 80040425,
					"content": "Ừm, cộng thêm những trải nghiệm gần đây, tôi chỉ có thể đoán rằng, năng lực dịch chuyển mà Vực Sâu nắm giữ, có vẻ không chỉ là hai điểm liên kết, mà là cả một cấu trúc mạng lưới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040426
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80040426,
					"content": "Phía bên kia của cổng dịch chuyển có thể là một trong những điểm đến do chúng quyết định trong toàn bộ mạng lưới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040427
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80040427,
					"content": "Nghe có vẻ giống với điểm dịch chuyển của chúng ta nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040428
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040428,
					"content": "#Nói chung, lần trước khi tôi đuổi theo người thân của {F#cô}{M#cậu} vào trong cổng dịch chuyển, cho đến khi tôi ý thức được xung quanh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040429
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80040429,
					"content": "...Thì tôi phát hiện bản thân chỉ còn lại một mình trong sào huyệt của Phong Ma Long.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040430
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80040430,
					"content": "Vậy còn... con mắt của \"Máy Cày\" đầu tiên thế nào rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040431,
					"content": "Tôi đã cất giữ rồi, trước khi làm rõ chân tướng kế hoạch của \"Máy Dệt Vận Mệnh\" thì không cần lo nó bị lọt vào tay của Vực Sâu đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040432,
						80040433
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80040432,
					"content": "Anh tự giới thiệu lần nữa được không.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040434
					]
				},
				{
					"id": 80040434,
					"content": "#Hừm, {F#cô}{M#cậu} nhớ danh hiệu này ư.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040435
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80040435,
					"content": "Không phải tôi có ý muốn giấu, nhưng danh hiệu này từng là vinh quang của Khaenri'ah, nhưng giờ đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040436
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80040436,
					"content": "...Chỉ còn là một lời nguyền châm biếm mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040437
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80040437,
					"content": "Thân là đội trưởng đội cận vệ hoàng gia từng chứng kiến quốc gia của mình bị hủy diệt, tôi nghĩ tôi có lý do để không nhắc đến danh hiệu này nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040438
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80040438,
					"content": "#Xem ra điều mà {M#em gái}{F#anh trai} bạn nói là thật...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040439,
						80040440
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040439,
					"content": "#Về chuyện của {M#em gái}{F#anh trai} tôi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040441
					]
				},
				{
					"id": 80040441,
					"content": "Chúng tôi từng là \"bạn đồng hành\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040442
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80040442,
					"content": "Đó là một chuyến hành trình đau khổ đi tìm kiếm vận mệnh, chỉ là... chúng tôi chưa thể cùng nhau đi đến \"điểm cuối\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040443
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80040443,
					"content": "\"Điểm cuối của chuyến hành trình\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040444
					]
				},
				{
					"id": 80040444,
					"content": "#Trước khi {F#cô}{M#cậu} tiếp tục lên đường, tôi có một chuyện cần nhắc nhở...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040445
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80040445,
					"content": "Giả sử \"mạng lưới dịch chuyển\" mà tôi đoán là đúng, ban nãy tôi trùng hợp được dịch chuyển đến đây, chứng tỏ là nơi này có giá trị để họ thiết lập điểm dịch chuyển.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040446
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80040446,
					"content": "Ý anh là Giáo Đoàn Vực Sâu đang âm mưu gì đó ở đây sao? Đúng như dự liệu của chúng tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040447
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040447,
					"content": "Vậy thì, ngay lúc này đây... rất có thể chúng ta đang bị \"Vực Sâu\" theo dõi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040448
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80040448,
					"content": "Đừng, đừng nói vậy chứ, tôi nổi hết da gà rồi nè!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040449,
						80040450
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040449,
					"content": "Chúng ta điều tra trước đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040451
					]
				},
				{
					"id": 80040451,
					"content": "Rất sáng suốt. Có ánh lửa gần bức tường đá đằng kia, chúng ta qua đó thử xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80040450,
					"content": "Tôi tạm thời tin anh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040451
					]
				},
				{
					"id": 80040440,
					"content": "Giữa hai người rốt cuộc đã xảy ra chuyện gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040441
					]
				},
				{
					"id": 80040433,
					"content": "\"Kiếm Sĩ Hoàng Hôn\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040434
					]
				},
				{
					"id": 80040424,
					"content": "#Cũng không đuổi kịp {M#em gái}{F#anh trai} tôi đúng không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040425
					]
				},
				{
					"id": 80040419,
					"content": "Tại sao ban nãy lại có cổng dịch chuyển xuất hiện vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040420
					]
				},
				{
					"id": 80040411,
					"content": "Xuất hiện đột ngột thế.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040412
					]
				}
			]
		},
		{
