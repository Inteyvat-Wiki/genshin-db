					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040404,
					"content": "Tượng Thần Ô Uế.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040405
					]
				},
				{
					"id": 80040405,
					"content": "Đúng đúng! Rất kinh dị, lại còn đảo ngược nữa, thực sự có chút sợ hãi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040406,
					"content": "Như vậy không lẽ bên dưới Vực Đá Sâu đúng là có liên quan đến Giáo Đoàn Vực Sâu sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040407,
					"content": "Chúng ta phải nghĩ cách đến đó điều tra thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040408
					],
					"speakerTitle": "Paimon"
