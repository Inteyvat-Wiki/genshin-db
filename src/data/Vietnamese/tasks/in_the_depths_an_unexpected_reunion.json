					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80040101,
					"content": "Chào nhà lữ hành, trùng hợp ghê.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 80040102,
					"content": "Tiểu thư Katheryne, hôm nay có ủy thác gì không? À mà sao... hôm nay nhìn thấy chúng tôi sao cô vui quá vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040103,
					"content": "Bởi vì sáng nay tôi có đến đền thần rút quẻ, các pháp sư nói với tôi rằng sắp có \"cuộc hội ngộ bất ngờ\" đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040104
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 80040104,
					"content": "Tiểu thư Katheryne đến đền thần rút quẻ sao? Nghe lạ ghê!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040105,
					"content": "À mà khoan, có cái gì đó sai sai, đây là Liyue mà? Cô vừa đi một vòng từ Inazuma về đây sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040106,
					"content": "Haha, dù cho là tôi đi nữa thì cũng có cuộc sống riêng của mình mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040107
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 80040107,
					"content": "Cho nên \"cuộc hội ngộ bất ngờ\" mà cô nói là đang chỉ chúng tôi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040108,
					"content": "Ai mà biết được, ít nhất thì nếu có lời dự báo này thì gặp ai cũng thấy vui cả mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040109
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 80040109,
					"content": "Được rồi... dù là chúng ta ngày nào cũng gặp, nhưng mà tiểu thư Katheryne vui là được rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040110,
						80040111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040110,
					"content": "Cuộc hội ngộ bất ngờ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040112
					]
				},
				{
					"id": 80040112,
					"content": "#...Paimon hiểu rồi, {NICKNAME}, nếu như lời của pháp sư nói linh nghiệm thì hay biết mấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040113,
					"content": "#{M#Em gái}{F#Anh trai} của {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040114,
					"content": "Hình như tôi... đã nói ra những câu không nên nói sao? Trông hai bạn có vẻ buồn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040115
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 80040115,
					"content": "Không sao đâu, chúng ta nói tiếp chuyện ủy thác đi, hôm nay có ủy thác gì cho chúng tôi không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040116,
					"content": "À ừm, cũng vừa hay có một ủy thác của anh thợ mỏ, hình như liên quan đến việc điều tra Vực Đá Sâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040117
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 80040117,
					"content": "Hả, không lẽ bên đó đã hết phong tỏa rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040118,
					"content": "Tình hình cụ thể thì bạn đi tìm người ủy thác để hiểu rõ thêm nhé. Anh ta tên là Yuehui, đang ở gần Vực Đá Sâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040119
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 80040119,
					"content": "Ừm, vậy chúng tôi đi tìm anh ta đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040120,
					"content": "Ừm, hướng về những ngôi sao và vực sâu... lần này thì đúng là hướng về \"vực sâu\" rồi đó, chúc hai bạn may mắn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 80040111,
					"content": "Có lẽ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040112
					]
				}
			]
		},
		{
			"id": 800402,
			"completionStepIds": [
				800402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800402",
							"2"
						],
						"stepId": 800402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yuehui"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80040201,
					"content": "Xin chào! Anh là... Yuehui đúng không? Chúng tôi được Hiệp Hội Nhà Mạo Hiểm phái đến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040202,
					"content": "Ồ, hân hạnh hân hạnh, đúng là tôi đã gửi ủy thác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040203
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80040203,
					"content": "Hmm? Vị này trông rất quen... hình như là nhà mạo hiểm rất có tiếng đó đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040204,
						80040205
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80040204,
					"content": "Lai lịch của tôi khá phức tạp.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040206
					]
				},
				{
					"id": 80040206,
					"content": "Ừm được rồi, để tôi giới thiệu bản thân, không lâu trước đây tôi có nhận được giấy phép khai thác ở Vực Đá Sâu, trong nhóm tôi còn có vài huynh đệ nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040207
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80040207,
					"content": "Ồ! Anh nhận được giấy phép khai thác ở Vực Đá Sâu sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040208,
					"content": "Ừm, bên phía Ngọc Kinh Đài đã phê chuẩn rồi, đã có thể khai thác một số khu vực nông dưới sự bảo vệ của Thiên Nham Quân. Chúng tôi cũng là nhóm đầu tiên đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040209
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80040209,
					"content": "Nhưng mà gần đây xảy ra một số chuyện, khiến cho các huynh đệ có chút bất an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040210
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80040210,
					"content": "Xảy ra chuyện gì vậy? Hình như chúng tôi chưa nghe nói qua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040211,
					"content": "Ừm... Chuyện này nói lớn không lớn, nói nhỏ không nhỏ, chỉ là có chút kỳ dị thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040212
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80040212,
					"content": "Các huynh đệ trong lúc nghỉ ngơi có thấy được một vài tên Hilichurl với vẻ mặt ngẩn ngơ chạy qua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040213
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80040213,
					"content": "Với lại những tên Hilichurl đó cũng không thèm nhìn anh ta, chỉ chăm chăm chạy vào Vực Đá Sâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040214
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80040214,
					"content": "Cho nên các huynh đệ đã để ý quan sát bọn chúng, phát hiện chuyện này xảy ra khá thường xuyên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040215
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80040215,
					"content": "Hilichurl không lẽ là đang tò mò sao? Hay là chỉ muốn qua bên đó dạo chơi thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040216,
					"content": "Không, kỳ lạ ở chỗ, họ phát hiện ra những tên Hilichurl khi chạy vào Vực Đá Sâu đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040217
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80040217,
					"content": "...Đã không còn quay trở ra nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040218
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80040218,
					"content": "Hành tung của đám Hilichurl này chỉ có một hướng thôi, sau khi vào đó đã không còn trở ra nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040219
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80040219,
					"content": "Dạo gần đây thì chuyện tương tự như vậy xảy ra thường xuyên hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040220
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80040220,
					"content": "\"Mục đích của đám Hilichurl đó là gì\", \"chúng sẽ ra sao\", \"liệu có mối nguy hại nào đang ẩn nấp không\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040221
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80040221,
					"content": "Những suy nghĩ này cứ vây lấy các huynh đệ, khiến họ cảm thấy rất lo sợ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040222
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80040222,
					"content": "Ừm, hiểu hiểu... chỉ nghe thôi cũng thấy nổi da gà rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040223,
						80040224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040223,
					"content": "Thật không dám tưởng tượng cảnh vật bên trong của Vực Đá Sâu nữa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040225
					]
				},
				{
					"id": 80040225,
					"content": "Đúng vậy, có lẽ nỗi sợ chưa rõ mới là nỗi sợ kinh khủng nhất. Nên chỉ khi điều tra được chân tướng thì các huynh đệ mới có thể yên tâm làm việc được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040226
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80040226,
					"content": "Chúng ta... chúng ta phải nhận ủy thác này thật sao? Đợi chút nhé anh thợ mỏ, để chúng tôi suy nghĩ chút...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040227,
					"content": "Cứ giao cho chúng tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040228
					]
				},
				{
					"id": 80040228,
					"content": "Này! Ít ra cũng phải hỏi ý kiến của tôi đã chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040229,
						80040230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040229,
					"content": "Những tình huống kỳ lạ như thế này...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040231
					]
				},
				{
					"id": 80040231,
					"content": "Ra đây là suy nghĩ của bạn sao. Ừm... vậy được rồi, không chừng trong đấy sẽ có tung tích về người thân của bạn thì sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040232,
					"content": "Nếu không đi thì chắc bạn bứt rứt lắm đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040233,
					"content": "Hai vị quyết định nhận ủy thác rồi chứ? Tôi cũng không muốn lãng phí giấy phép khai thác ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040234
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80040234,
					"content": "Ừm, chúng tôi đương nhiên sẽ nhận để thỏa mãn lòng đam mê rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040235
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040235,
					"content": "Hay quá, vậy để tôi ghi lại vị trí đại khái của đám Hilichurl cho hai người...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80040230,
					"content": "Tôi nghĩ là có liên quan đến \"Giáo Đoàn Vực Sâu\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040231
					]
				},
				{
					"id": 80040224,
					"content": "Đúng là một câu chuyện kỳ dị...",
