					"nextDialogs": [
						80040442
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80040442,
					"content": "Đó là một chuyến hành trình đau khổ đi tìm kiếm vận mệnh, chỉ là... chúng tôi chưa thể cùng nhau đi đến \"điểm cuối\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040443
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80040443,
					"content": "\"Điểm cuối của chuyến hành trình\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040444
					]
				},
				{
					"id": 80040444,
					"content": "#Trước khi {F#cô}{M#cậu} tiếp tục lên đường, tôi có một chuyện cần nhắc nhở...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040445
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80040445,
					"content": "Giả sử \"mạng lưới dịch chuyển\" mà tôi đoán là đúng, ban nãy tôi trùng hợp được dịch chuyển đến đây, chứng tỏ là nơi này có giá trị để họ thiết lập điểm dịch chuyển.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040446
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80040446,
					"content": "Ý anh là Giáo Đoàn Vực Sâu đang âm mưu gì đó ở đây sao? Đúng như dự liệu của chúng tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040447
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040447,
					"content": "Vậy thì, ngay lúc này đây... rất có thể chúng ta đang bị \"Vực Sâu\" theo dõi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040448
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80040448,
					"content": "Đừng, đừng nói vậy chứ, tôi nổi hết da gà rồi nè!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040449,
						80040450
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040449,
					"content": "Chúng ta điều tra trước đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040451
					]
				},
				{
					"id": 80040451,
					"content": "Rất sáng suốt. Có ánh lửa gần bức tường đá đằng kia, chúng ta qua đó thử xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80040450,
					"content": "Tôi tạm thời tin anh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040451
					]
				},
				{
					"id": 80040440,
					"content": "Giữa hai người rốt cuộc đã xảy ra chuyện gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040441
					]
				},
				{
					"id": 80040433,
					"content": "\"Kiếm Sĩ Hoàng Hôn\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040434
					]
				},
				{
					"id": 80040424,
					"content": "#Cũng không đuổi kịp {M#em gái}{F#anh trai} tôi đúng không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040425
					]
				},
				{
					"id": 80040419,
					"content": "Tại sao ban nãy lại có cổng dịch chuyển xuất hiện vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040420
					]
				},
				{
					"id": 80040411,
					"content": "Xuất hiện đột ngột thế.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040412
					]
				},
				{
					"id": 80040304,
					"content": "Hoàn toàn vượt xa tưởng tượng...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040402
					]
				}
			]
		},
