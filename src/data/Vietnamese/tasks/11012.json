			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Childe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110120101,
					"content": "Chính là nơi này, \"viện nghiên cứu đồ chơi\" của Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120102
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120102,
					"content": "Đến rồi đến rồi! Em đã nghe thấy tiếng máy bên trong, quá tuyệt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120103
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120103,
					"content": "Rốt cuộc đây là nơi nào, sao anh lại biết chỗ này?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120104,
					"content": "Trước đây tôi có tìm hiểu sơ, nơi này có thể xem là \"viện nghiên cứu đồ chơi\" của \"Dottore\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120105
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120105,
					"content": "\"Dottore\" là một vị \"quan chấp hành\" của Fatui, thỉnh thoảng có sở thích... mày mò những món đồ cũ. Di tích này được ngài ấy cải tạo, dùng để nghiên cứu Thủ Vệ Di Tích.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120106
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120106,
					"content": "Hả? Lẽ nào Thủ Vệ Di Tích là do Fatui các anh chế tạo ra sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120107,
					"content": "Không, loại quái vật đó liên quan nhiều với \"Vực Sâu\" hơn, nói đúng ra nó là kẻ thù của chúng tôi... Chúng tôi chỉ nghiên cứu thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120108
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120108,
					"content": "Còn về chuyện gần đây có Thủ Vệ Di Tích... đại khái là do anh ta chơi chán rồi, không còn hứng thú với nơi này nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120109
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120109,
					"content": "Lại là một quan chấp hành xấu tính!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120110,
					"content": "Chẳng trách anh dám đưa Teucer tới đây, thì ra là có thăm dò trước rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120111,
					"content": "Thật ra... cũng chẳng phải là thăm dò trước, bên trong \"viện nghiên cứu\" này thế nào tôi còn chưa tìm hiểu rõ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120112
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120112,
					"content": "Vậy, vậy lẽ nào anh không lo cho an nguy của em trai của anh sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120113,
					"content": "Sao có thể... dù có nguy hiểm gì, tôi cũng sẽ gánh cho nó. \"Anh trai\" chẳng phải là một nhân vật như vậy sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120114
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120114,
					"content": "Hơn nữa cả Teucer cũng hiểu được ý nghĩa của chiến đấu, có thế nào đi nữa thì ý nghĩa này cũng ở trong tim tôi bao lâu nay...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120115
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120115,
					"content": "Anh trai, mọi người đang nói gì vậy? Mau dẫn đường đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120116
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120116,
					"content": "Haha, được, cứ giao cho anh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Childe"
				}
			]
		},
		{
			"id": 1101202,
			"completionStepIds": [
				1101205
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1101205",
							"2"
						],
						"stepId": 1101205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Childe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110120201,
					"content": "May mà để các bạn tìm thấy trước... mang theo vết thương phát động \"Trang Phục Ma Vương\" hóa ra khó khăn hơn tưởng tượng nhiều...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120202
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120202,
					"content": "Nếu để Teucer trông thấy bộ dạng thảm hại này của tôi thì xấu hổ quá... Hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120203,
						110120207
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120203,
					"content": "Anh không sợ tôi nhân lúc này để xử anh sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120204
					]
				},
				{
					"id": 110120204,
					"content": "#Haha, tôi nhớ {F#cô}{M#cậu} cũng có anh chị em đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120205
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120205,
					"content": "#Tôi hiểu {F#cô}{M#cậu}, nên tôi biết, dù thế nào... {F#cô}{M#cậu} cũng sẽ không ra tay với tôi trước mặt em trai tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120206
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120206,
					"content": "Nhưng không ngờ anh làm đến mức này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120208,
					"content": "Chỉ là... tôi sẽ không từ bỏ bất cứ cơ hội nào để rèn luyện bản thân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120209
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120209,
					"content": "Đó là lý do Tartaglia tôi không ngừng mạnh lên, hahaha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120210
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120210,
					"content": "Hơn nữa, ước mơ của tuổi thơ là thứ mong manh nhất. Sợ là nếu bỏ mặc, cũng sẽ có một ngày tự tan vỡ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120211
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120211,
					"content": "Cho nên nhất định phải có người bảo vệ mới được đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120212
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120212,
					"content": "Đã hứa thì phải làm, làm sai thì phải xin lỗi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120213
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120213,
					"content": "Cho ai đó ước mơ, thì phải bảo vệ nó cho đến cùng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120214
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120214,
					"content": "Người thân thì nên như vậy, chính là như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120215
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120215,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120216
					]
				},
				{
					"id": 110120216,
					"content": "#Lẽ nào... Khơi lại ký ức gì đó của {F#cô}{M#cậu} sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120217
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120217,
					"content": "Khụ khụ... Ừm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120218
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120218,
					"content": "Đã như vậy rồi còn muốn tỏ vẻ ngầu, mau đi khám bác sĩ đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120219
					],
					"speakerTitle": "Paimon"
				},
				{
