			"dialogs": [
				{
					"id": 207010101,
					"content": "Sao bụng lại đói rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207010102
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 207010102,
					"content": "Í, là bạn à! Tốt quá rồi, bạn còn nhớ tôi không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207010103
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 207010103,
					"content": "Cuộc thi nấu ăn của Xiangling, là tôi, Siegfria đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207010104
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 207010104,
					"content": "Hehe, bạn nhớ chưa, bạn đến thật đúng lúc, tôi có thể... nhờ bạn một chuyện không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207010105
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 207010105,
					"content": "Có việc gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207010106
					]
				},
				{
					"id": 207010106,
					"content": "Bạn còn nhớ món \"Túi Thập Cẩm Phỉ Ngọc\" mà bạn đã làm trước đây không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207010107
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 207010107,
					"content": "Tôi luôn nhớ đến hương vị đó, thực sự rất ngon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207010108
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 207010108,
					"content": "Vì vậy, tôi đã thử tự làm xem sao, nhưng... luôn cảm thấy hương vị làm ra cứ thiếu cái gì đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207010109
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 207010109,
					"content": "Tôi nghĩ rằng mình có thể làm ra lại hương vị đó nếu được nếm thử vài lần nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207010110
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 207010110,
					"content": "Có thể nhờ bạn làm Túi Thập Cẩm Phỉ Ngọc cho tôi ăn thử được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Siegfria"
				}
			]
		},
