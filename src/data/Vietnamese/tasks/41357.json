				{
					"id": 413570301,
					"content": "Sao rồi, hành trình tìm kho báu thuận lợi chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570302
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413570302,
					"content": "Đã tìm được tất cả kho báu rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413570303
					]
				},
				{
					"id": 413570303,
					"content": "Tìm được tất cả rồi sao? Khá ổn đó, có nhiều người đến cả hình cũng xoay không xong...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570304
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413570304,
					"content": "Nếu bạn đã tìm được tất cả kho báu rồi thì phần thưởng này xin tặng bạn, chúc bạn ngày lễ vui vẻ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qian"
				}
			]
		},
