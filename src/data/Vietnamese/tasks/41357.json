			"trigger": {
				"objectNames": [
					"Qian"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413570101,
					"content": "Hoan nghênh đến tham gia \"Linh Lung Tiêu Đăng Đồ\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570102
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413570102,
					"content": "Hả... là gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413570103
					]
				},
				{
					"id": 413570103,
					"content": "\"Linh Lung Tiêu Đăng Đồ\", sao nè, bạn muốn tham gia thử không? Đơn giản lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570104
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413570104,
					"content": "Bạn có thấy mấy bức tranh phía sau không? Còn ba ngọn đèn phía trước nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570105
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413570105,
					"content": "Những ngọn đèn này rất đặc biệt, sau khi mở sẽ xuất hiện rất nhiều hình ảnh khác nhau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570106
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413570106,
					"content": "Với lại, nếu xoay chuyển ba ngọn đèn này sẽ có thể ghép những bức tranh lại với nhau, tạo thành một bức tranh hoàn chỉnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570107
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413570107,
					"content": "A... Nói vậy chắc bạn cũng không hiểu, vậy đi, bạn thử đi xoay chuyển một chiếc Đèn Tiêu trước xem. Sau khi quen thuộc thao tác cơ bản, tôi sẽ nói cho bạn cách chơi chi tiết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qian"
				}
			]
		},
		{
			"id": 4135702,
			"completionStepIds": [
				4135704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4135703",
							"3"
						],
						"stepId": 4135703,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4135704",
							"2"
						],
						"stepId": 4135704,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qian"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413570201,
					"content": "Chà, bạn hiểu nhanh thật, vậy chúng ta bắt đầu chơi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570202
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413570202,
					"content": "Khó lắm không...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413570203
					]
				},
				{
					"id": 413570203,
					"content": "Không đâu không đâu, vừa nãy không phải bạn đã học được cách xoay chuyển những chiếc đèn rồi ư?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570204
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413570204,
					"content": "Khi chính thức chơi, chỉ cần xoay chuyển 3 chiếc đèn, để hoa văn mà chúng phản chiếu lên bình phong ghép thành một bức tranh chính xác là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570212
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413570212,
					"content": "Tôi sẽ nói trước với bạn hình cần kết hợp, nhưng phương pháp xoay chuyển 3 Đèn Tiêu... có thể sẽ cần bạn tự mình tìm hiểu một chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570205
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413570205,
					"content": "Sau khi ghép xong thì sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413570206
					]
				},
				{
					"id": 413570206,
					"content": "Không biết bạn có để ý không, những bức vẽ này đều là bản đồ của Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570207
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413570207,
					"content": "Khi bạn hoàn thành bức hình, sau đó so sánh nó lên bản đồ, bạn sẽ có thể tìm được \"kho báu\" của Hiệp Hội Nhà Mạo Hiểm chuẩn bị cho bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570208
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413570208,
					"content": "Hiệp hội đã mời rất nhiều người để đặt những kho báu đó, mất rất nhiều thời gian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570213
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413570213,
					"content": "Nhưng những chiếc rương kia... cũng giống như những chiếc rương ở đối diện tôi, nếu bạn đã biết chắc địa điểm thì sẽ rất dễ tìm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570209
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413570209,
					"content": "Tôi đã điều chỉnh xong tranh rồi, tranh hôm nay là <color=#00E1FFFF>Bách Hợp Lưu Ly</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570210
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413570210,
					"content": "À đúng rồi, còn có chuyện này, tranh của \"Linh Lung Tiêu Đăng Đồ\" chỉ có thể hiện rõ vào ban đêm, tốt nhất là bạn đợi đến đêm rồi đến chơi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570211
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413570211,
					"content": "Vả lại, những ngọn đèn này đều do các chuyên gia tạo ra, rất đẹp, nếu không xem một cách tỉ mỉ thì thật là đáng tiếc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qian"
				}
			]
		},
