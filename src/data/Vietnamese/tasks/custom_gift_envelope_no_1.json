			"dialogs": [
				{
					"id": 715330101,
					"content": "...Ừm, cảm thấy hơi sai. Loại thiệp chúc mừng này, khó làm thật đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715330102
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 715330102,
					"content": "Mika đang làm thiệp chúc mừng sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715330103
					]
				},
				{
					"id": 715330103,
					"content": "#Ơ? Trùng hợp quá, không ngờ lại gặp {NICKNAME} ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715330104
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 715330104,
					"content": "Mika tới Liyue đón Tết Hải Đăng sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715330105
					]
				},
				{
					"id": 715330105,
					"content": "Hả? Không phải, tôi đến Cảng Liyue vốn là để gửi thư, đúng lúc là Tết Hải Đăng thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715330106
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 715330106,
					"content": "Trước khi đến đây, tôi nghe tiền bối Klee nói rằng rất muốn có một tấm thiệp chúc mừng Tết Hải Đăng, nên tiện thể muốn mua một tấm đem về.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715330107
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 715330107,
					"content": "Kết quả, không ngờ là phải tự làm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715330108
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 715330108,
					"content": "Tôi làm cả buổi rồi, nhưng cứ cảm thấy sai sai thế nào ấy... Nhưng cũng không biết cụ thể là sai ở đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715330109
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 715330109,
					"content": "#{NICKNAME} hiểu sâu biết rộng... Có thể cho tôi vài gợi ý không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715330110
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 715330110,
					"content": "Để tôi nghĩ xem nào...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
