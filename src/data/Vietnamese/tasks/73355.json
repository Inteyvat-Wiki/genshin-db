			"dialogs": [
				{
					"id": 733550101,
					"content": "Ơ, bên kia có Nấm Quỷ bay qua kìa, có ổn không ta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550102,
					"content": "Bình thường thì Nấm Quỷ hoạt động trong khu vực thành thị cũng hơi nguy hiểm đấy nhỉ! Trừ khi là cực kỳ ngoan ngoãn, đã được huấn luyện...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550103,
					"content": "Không đúng lắm, cảm giác hơi quen quen nhỉ. Có phải trước đây chúng ta từng trải qua tình huống tương tự rồi không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550104,
						733550107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550104,
					"content": "Khoan đã, có phải là Nón Trống Tròn không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733550105
					]
				},
				{
					"id": 733550105,
					"content": "Đúng rồi! Nón Trống Tròn! Là Nấm Quỷ mà chúng ta quen ở Sumeru đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550106,
					"content": "Woahhh, lần trước gặp nhau là từ lâu lắm rồi! Chúng ta qua đó đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550107,
					"content": "Là trường hợp đặc biệt gì sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733550108
					]
				},
				{
					"id": 733550108,
					"content": "Hình như là... Nón Trống Tròn mà? Là Nấm Quỷ mà chúng ta quen ở Sumeru đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550109
