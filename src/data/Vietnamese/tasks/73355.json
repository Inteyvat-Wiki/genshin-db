			"dialogs": [
				{
					"id": 733550201,
					"content": "Hm? Có vẻ như không cần để lại lời nhắn ở Hiệp Hội Nhà Mạo Hiểm, duyên phận kỳ diệu sẽ dẫn lối cho chúng ta gặp lại nhau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550202
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 733550202,
					"content": "Cuối cùng cũng gặp lại nhau rồi, Sao Băng Vàng và Ngôi Sao Bạc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550203
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 733550203,
					"content": "Vẻ mặt rạng rỡ của hai người khiến tôi cảm thấy thời gian như ngừng trôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550204,
						733550208
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 733550204,
					"content": "Lâu lắm rồi không gặp đấy, Haniyyah!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733550205
					]
				},
				{
					"id": 733550205,
					"content": "Là Haniyyah và Nón Trống Tròn thật này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550206,
					"content": "Chẳng trách đọc lời nhắn mà tôi cứ thấy quen quen... Chứng tỏ là tôi với Nón Trống Tròn vẫn còn ăn ý lắm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550207,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550212
					],
					"speakerTitle": "Nón Trống Tròn"
				},
				{
					"id": 733550212,
					"content": "#Tôi đã tưởng tượng ra nhiều kịch bản trùng phùng lắm, như tổ chức tiệc linh đình, hay tiệc chào đón đầy sáng tạo, để cho {F#cô}{M#cậu} một bất ngờ thật lớn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550213
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 733550213,
					"content": "Nhưng lại thấy hơi khách sáo. Hai người vốn đã bận rộn, biết đâu chiếm quá nhiều thời gian lại khiến hai người thấy phiền.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550214
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 733550214,
					"content": "Hơn nữa, các Nấm Quỷ bây giờ cũng thích môi trường yên tĩnh, nên chúng ta hãy gặp lại nhau theo cách tự nhiên và thoải mái nhất nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550215
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 733550215,
					"content": "Đúng thế đúng thế, những bài văn xuôi Haniyyah từng đọc giờ đã phát huy tác dụng rồi, giữ tâm trạng bình tĩnh tốt cho cuộc sống!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550216
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 733550216,
					"content": "Cứ thoải mái trò chuyện thế này là vui nhất rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550217
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 733550217,
					"content": "♫~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550218
					],
					"speakerTitle": "Ngọn Lửa Hân Hoan"
				},
				{
					"id": 733550218,
					"content": "Cô Souka cũng ở đây nữa, cả Ngọn Lửa Hân Hoan luôn. Còn... đây là?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550219,
					"content": "Đồng đội Nấm Quỷ của tôi, Vũ Công Gió. Hồi đó ở vòng đấu top 32, đã bị hai người và Nón Trống Tròn đánh bại trong chốc lát!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550220
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 733550220,
					"content": "Ôi, cô nhớ rõ thật đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550221,
						733550222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550221,
					"content": "Cảm giác quen thuộc dần quay lại rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733550223
					]
				},
				{
					"id": 733550223,
					"content": "Tóm lại, hai người thấy đấy, chúng ta không cần hẹn gặp lại nhau vào lúc nào hay ở đâu nữa rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550224
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 733550224,
					"content": "Haniyyah và tôi đã mua lại cả khu thương mại này, cải tạo nó thành \"Công Viên Nấm Nhỏ\" luôn luôn mở cửa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550225
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 733550225,
					"content": "Khoan đã, nghĩa là cơ sở vật chất ở đây không phải cho thuê để làm trò chơi trên bàn mới, mà là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550226,
					"content": "Đúng vậy, từ giờ chúng tôi sẽ sống tại Cảng Bayda, quảng bá trò chơi trên bàn về Nấm Quỷ, cũng như lý thuyết giao tiếp với động vật cho mọi người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550227
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 733550227,
					"content": "Nếu rảnh, hai người cứ thoải mái đến đây chơi với các Nấm Quỷ nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550228
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 733550228,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550229,
						733550230
					],
					"speakerTitle": "Nón Trống Tròn"
				},
				{
					"id": 733550229,
					"content": "Tuyệt vời! Đồng đội Nấm Quỷ!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733550231
					]
				},
				{
					"id": 733550231,
					"content": "Đây... Đây là một trong những tin tuyệt vời nhất mà hôm nay tôi được nghe đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550232,
					"content": "Sau lần cuộc thi Nấm Quỷ đầu tiên, tôi đã nghĩ ra rất nhiều... ý tưởng để chơi cùng Nón Trống Tròn, giờ có thể từ từ thực hiện rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550233,
					"content": "Tiếc là hôm nay tôi không chuẩn bị bánh ngọt cho các Nấm Quỷ... Giá mà có thể ôm các Nấm Quỷ, rồi cùng nhau thưởng thức một bàn đầy món ngon thì tuyệt biết mấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550234,
					"content": "Chuyện này thì không cần lo đâu. Trong cuốn \"Lý Luận Tổng Hợp Về Nấm Quỷ\" mà tôi hoàn thiện, đã có nghiên cứu sâu về loại thực phẩm mà Nấm Quỷ thích ăn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550235
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 733550235,
					"content": "Mục tiêu là tìm ra những nguyên liệu chung giữa Nấm Quỷ và loài người, để các đồng đội không phải ăn Rau Câu Kỳ Diệu với đủ vị suốt cả năm nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550236
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 733550236,
					"content": "Rồi sẽ có ngày tôi tìm ra được nguyên liệu phù hợp với vị giác của cả loài người và Nấm Quỷ, làm ra những món ăn ngon mà cả hai đều thích!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550237
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 733550237,
					"content": "Đến lúc bắt tay vào nấu thì cứ để tôi đảm nhận! Để tránh Haniyyah làm cháy cái nồi thứ mười một.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550238
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 733550238,
					"content": "Xem ra ngày chúng ta ngồi ăn uống cùng các Nấm Quỷ cũng không còn xa nữa rồi nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550239,
						733550240
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550239,
					"content": "Chỉ chờ tin vui từ Haniyyah nữa thôi đó!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733550241
					]
				},
				{
					"id": 733550241,
					"content": "Vậy thì hãy thường xuyên ghé Công Viên Nấm Nhỏ chơi nhé, chúng tôi và các Nấm Quỷ luôn chờ hai người tới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550242
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 733550242,
					"content": "Chưa biết chừng, bất ngờ sẽ đến sớm hơn mong đợi đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550243
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 733550243,
					"content": "♪!",
