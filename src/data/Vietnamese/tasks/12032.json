			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Raiden Shogun",
					"Yae Miko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120320101,
					"content": "Trong tương lai, Inazuma chắc chắn sẽ gặp nhiều thử thách hơn, nhưng tôi đã sẵn sàng rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320102,
						120320107,
						120320112,
						120320117,
						120320122,
						120320128
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 120320102,
					"content": "Về \"thử thách\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120320103
					]
				},
				{
					"id": 120320103,
					"content": "Việc bãi bỏ lệnh bế quan tỏa cảng khó tránh khỏi liên lụy đến nhiều người, không thể nói rằng chỉ có tích cực mà không có tiêu cực được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320104
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 120320104,
					"content": "Chẳng hạn như vấn đề kinh tế của Inazuma với các quốc gia bên ngoài, đây đều là những việc sắp tới tôi phải xử lý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320105
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 120320105,
					"content": "Ei nghiêm túc nhỉ. Tôi thì chỉ quan tâm đến việc sau này Đền Narukami có thể bán vé vào cổng cho du khách hay không thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320106
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120320106,
					"content": "Thật là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320101
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 120320107,
					"content": "Về sự dõi theo của thần...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120320108
					]
				},
				{
					"id": 120320108,
					"content": "Makoto luôn dõi theo người dân Inazuma. Tôi từng nghĩ, đây chính là trách nhiệm của cô ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320109
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 120320109,
					"content": "Nhưng xem ra sự dõi theo này bao gồm cả ngưỡng mộ và kỳ vọng. Cô ấy rất thương con người, tôi nghĩ cô ấy đã tìm thấy được niềm vui từ đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320110
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 120320110,
					"content": "Người trong quá khứ đáng được dõi theo, và người trong tương lai cũng vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320111
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120320111,
					"content": "Ừm, tôi sẽ không xem nhẹ nhiệt huyết và ước mơ của họ nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320101
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 120320112,
					"content": "Về trận chiến hàng trăm năm trước...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120320113
					]
				},
				{
					"id": 120320113,
					"content": "Nói thẳng ra thì đó là một sự tra tấn không có hồi kết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320114
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 120320114,
					"content": "Đối mặt với những trận chiến không hồi kết, phải luôn tập trung cao độ. Chỉ cần lơ là một chút, lưỡi đao của Shogun sẽ lấy mạng tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320115
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 120320115,
					"content": "Có thể nói, nếu không có kinh nghiệm và kiến thức trước đó, không có sức mạnh của thanh đao thì tôi chắc chắn sẽ thua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320116
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 120320116,
					"content": "Trong đó, có cả công lao của bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320101
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 120320117,
					"content": "Về vết sẹo của cây Anh Đào Thần...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120320118
					]
				},
				{
					"id": 120320118,
					"content": "Yên tâm đi, tôi không quên đâu, tôi sẽ dặn dò Hiệp Hội Tenryou và Hiệp Hội Yashiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320119
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 120320119,
					"content": "Ngoài sự đe dọa của lũ ma vật, tôi còn lo rằng, không biết Anh Đào Thần có còn phát ra những thứ khác nữa không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320120
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 120320120,
					"content": "Khó nói lắm, ngoài hồi ức ra, những thứ bên trong địa mạch vẫn còn rất nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320121
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120320121,
					"content": "Nếu cô cũng biết vậy thì đừng có mà lười biếng đấy nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320101
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 120320122,
					"content": "Yae Miko nói vị thần của cô ấy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120320123
					]
				},
				{
					"id": 120320123,
					"content": "Ơ kìa? Ơ kìa kìa? Ai đang nói linh tinh cái gì đấy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320124
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120320124,
					"content": "Có những lời không thể nói tùy tiện được đâu nha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320125
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120320125,
					"content": "Bán đứng tôi sẽ phải trả cái giá như thế nào chắc cưng biết rồi đấy nhỉ. Hãy coi những gì tôi nói với cưng là bí mật, hiểu chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320126
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120320126,
					"content": "Hai người đang nói gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320127
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 120320127,
					"content": "À không có gì, muốn ăn đậu phụ rán thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320101
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120320128,
					"content": "Không có gì muốn hỏi nữa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		}
	]
}