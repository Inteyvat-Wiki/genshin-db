				]
			},
			"dialogs": [
				{
					"id": 790610101,
					"content": "Rozel, cho dù anh có nói với tôi bao nhiêu lần đi chăng nữa, tôi cũng sẽ không bao giờ đi xa cùng anh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610102
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610102,
					"content": "Tôi là bạn của anh, điều đó sẽ không bao giờ thay đổi, tôi không ghét anh. Nhưng... nhưng tôi không thích đi xa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610103
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610103,
					"content": "Esnoir, nó không đáng sợ như anh nghĩ đâu, chỉ là một chuyến đi thế thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610104
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610104,
					"content": "Có rất nhiều loài hoa ở thế giới bên ngoài không thể tìm thấy trong làng, những con người mà tôi chưa từng thấy trước đây, thậm chí cả hình dạng của những đám mây cũng khác nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610105
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610105,
					"content": "Chẳng phải tôi đã mang hạt giống hoa từ bên ngoài về cho anh sao? Tôi đảm bảo, chắc chắn anh chưa từng thấy những bông hoa có hình dạng và màu sắc như thế này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610106
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610106,
					"content": "Nó vẫn là hạt giống, tôi phải gieo trồng, đợi đến khi nó nở hoa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610107
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610107,
					"content": "Nếu anh muốn đi xa cùng tôi, thì chúng ta có thể trực tiếp tìm thấy loài hoa này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610108
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610108,
					"content": "Rozel... Xin lỗi, tôi không muốn đi xa, tôi không muốn giống như những nhà thám hiểm đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610109
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610109,
					"content": "Họ luôn lo lắng về giá trị của những tấm thảm, chứ không quan tâm những chiếc mũ đẹp...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610110
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610110,
					"content": "Đây là sự thay đổi mà việc đi du lịch xa mang lại cho mọi người, tôi sợ điều đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610111
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610111,
					"content": "Điều này đúng. Nhưng anh có để ý thấy những bản đồ, mẫu thực vật, còn có những sổ hành trình được viết kín trong hành lý của họ không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610112
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610112,
					"content": "Chúng tôi giống như một cơn gió đi qua hàng cây khác nhau, dòng sông chảy qua các hồ nước khác nhau... Chúng tôi gặp những con người mới, nhưng chúng tôi cũng không còn là bản thân của lúc trước nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610113
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610113,
					"content": "Đây là sự thay đổi mà việc đi xa đã mang lại cho chúng tôi. Tôi vừa sợ... nhưng cũng vừa biết ơn vì điều đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610114
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610114,
					"content": "Cũng giống như một miếng bánh mì được quét bơ đều ở cả hai mặt, dù có cầm nó cẩn thận thế nào đi nữa, cũng sẽ có một mặt bị rối tung cả lên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610115
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610115,
					"content": "Vậy thì tôi sẽ quét bơ một cách lần lượt, như vậy thì tôi còn có thể quét thêm vị khác nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610116,
						790610117
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610116,
					"content": "Đây là một ý tưởng hay, nghe có vẻ chắc chắn sẽ ăn no.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610118
					]
				},
				{
					"id": 790610118,
					"content": "#Là {F#cô}{M#cậu} à, cuối cùng {F#cô}{M#cậu} cũng đến rồi. Rozel đã nói với tôi rằng thế giới bên ngoài rất đẹp, còn mời tôi đi cùng anh ấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610119
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610119,
					"content": "#{F#Cô}{M#Cậu} có biết gì về thế giới bên ngoài không? Nó có... thực sự giống như những gì Rozel đã nói không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610117,
					"content": "Đây là một ý tưởng hay, như vậy bơ sẽ không dính vào tay.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610118
					]
				}
			]
		},
		{
			"id": 7906102,
