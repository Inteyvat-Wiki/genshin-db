			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 790610401,
					"content": "Rozel, có lẽ... tôi có thể đi cùng anh. Nhưng mà... tôi không biết phải chuẩn bị như thế nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610402
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610402,
					"content": "Rất đơn giản. Chỉ cần chuẩn bị mứt, bánh mì và một tấm lòng hiếu kỳ. Mặc một bộ đồ thoải mái, đem theo một ít để dự phòng nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610403
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610403,
					"content": "Sau cùng, hãy chuẩn bị sẵn tâm lý... vì dọc đường rất có thể anh sẽ phải vứt bỏ một số thứ trong đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610404
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610404,
					"content": "Ồ, nghe có vẻ rất phức tạp. Mà hơn nữa tôi không muốn vứt chúng đi, đều là đồ của tôi, rất quý giá, tôi rất yêu quý những món đồ đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610405
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610405,
					"content": "Sau khi chúng rời xa thì anh sẽ gặp dược những món đồ quý giá mới mẻ thôi, Esnoir thân mến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610406
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610406,
					"content": "Tin tôi đi, đây sẽ là một hành trình đầy thú vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rozel"
				}
			]
		},
