			"dialogs": [
				{
					"id": 790610601,
					"content": "\"Lá thư này gửi cho hàng xóm, bạn bè, hải đăng và bông hoa nhỏ.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610602
					],
					"speakerTitle": "Thư Với Nét Chữ Xiêu Vẹo"
				},
				{
					"id": 790610602,
					"content": "\"Tôi chuẩn bị đi xa với Rozel. Cứ thoải mái dùng xích đu, bàn và ghế của tôi nhé.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610603
					],
					"speakerTitle": "Thư Với Nét Chữ Xiêu Vẹo"
				},
				{
					"id": 790610603,
					"content": "\"Chúc mọi điều vui vẻ.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610604
					],
					"speakerTitle": "Thư Với Nét Chữ Xiêu Vẹo"
				},
				{
					"id": 790610604,
					"content": "\"Từ người hàng xóm, Esnoir.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Thư Với Nét Chữ Xiêu Vẹo"
