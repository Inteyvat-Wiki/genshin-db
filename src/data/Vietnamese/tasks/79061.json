			},
			"dialogs": [
				{
					"id": 790610501,
					"content": "Xin lỗi, Rozel. Tôi... tôi vẫn không thể đi cùng anh được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610502
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610502,
					"content": "Tôi cảm thấy đủ khi ở đây. Như vậy, khi anh đi xa trở về, ít nhất sẽ có người đón tiếp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610503
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610503,
					"content": "Nhưng mà Esnoir, tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610504
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610504,
					"content": "Tôi không đủ thông minh, cũng không đủ dũng cảm, Rozel à. Nhưng tôi nghĩ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610505
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610505,
					"content": "Gió thổi qua bụi cây, sông chảy qua hồ nước, mọi thứ tiếp diễn lặp đi lặp lại, cuối cùng vẫn sẽ về với điểm bắt đầu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610506
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610506,
					"content": "Có lẽ, sau khi trải qua nhiều thay đổi, cuối cùng thì nguyện vọng của chúng vẫn là... quay về với bản thân của thuở ban đầu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610507
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610507,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610508
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610508,
					"content": "Tôi sẽ ở nhà đợi anh, bạn tốt à, vẫn như ngày nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Esnoir"
				}
			]
		},
