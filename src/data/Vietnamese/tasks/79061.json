				]
			},
			"dialogs": [
				{
					"id": 790610301,
					"content": "<color=#FFCC33FF>Thế giới bên trong</color> cũng không tệ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610302
					]
				},
				{
					"id": 790610302,
					"content": "Ừ. Dù sao thì đây cũng là nhà của Esnoir. Esnoir nhất định rất thích nơi này. Mà hơn nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610303,
						790610304,
						790610305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790610303,
					"content": "Ở đây có rất nhiều bạn bè quen thuộc.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610306
					]
				},
				{
					"id": 790610306,
					"content": "Đúng vậy! Tôi sợ sẽ mất đi những thứ này, nên luôn lo lắng về chuyện đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610307
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610307,
					"content": "Tất cả đều rất tốt, rất tuyệt... Tôi không muốn họ thay đổi, mà tôi cũng không muốn thay đổi chính mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610308
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610308,
					"content": "...Nhưng. Đi xa sẽ khiến mọi thứ trở nên khác biệt. Phải không, Rozel?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610309
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610309,
					"content": "Đúng, chắc chắn rồi. Tôi không muốn nói dối anh, cũng không có ý làm anh buồn, Esnoir thân mến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610310
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610310,
					"content": "Được rồi... Được rồi. Tôi hiểu tấm lòng của anh, anh nhất định cũng hiểu tấm lòng của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610311
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610311,
					"content": "Tôi sẽ suy nghĩ về lời mời của anh và đưa ra quyết định sau... Ít nhất là bây giờ, chúng ta sẽ cùng nhau uống trà trong sự bình yên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610312
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610312,
					"content": "Được rồi... Tôi sẽ ở cạnh anh, Esnoir. Ngày khởi hành tiếp theo vẫn còn rất xa, tôi có thể cùng anh từ từ suy nghĩ về điều đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610304,
					"content": "Có rất nhiều hoa đẹp...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610306
					]
				},
				{
					"id": 790610305,
					"content": "Và những chiếc bánh thơm ngon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610306
					]
				}
			]
		},
		{
			"id": 7906104,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
