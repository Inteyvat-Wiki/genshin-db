				"points": [
					{
						"sceneId": 100,
						"position": [
							998.028,
							216.884,
							711.501
						],
						"pointId": 294
					}
				]
			},
			"dialogs": [
				{
					"id": 790610201,
					"content": "Đúng vậy. <color=#FFCC33FF>Thế giới bên ngoài</color> có rất nhiều điều mới mẻ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610202
					]
				},
				{
					"id": 790610202,
					"content": "Đúng đó, ngoài kia có rất nhiều món ngon vật lạ, anh có thể gặp rất nhiều chuyện thú vị, còn có thể quen biết rất nhiều người tuyệt vời. Chẳng hạn như...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610203,
						790610204,
						790610205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790610203,
					"content": "Có những người tập trung vào bản chất tươi đẹp của sự vật.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610206
					]
				},
				{
					"id": 790610206,
					"content": "Thật sao? Ôi, tôi tưởng thứ duy nhất ở thế giới bên ngoài là \"giá trị\", ai cũng muốn đội mũ nhưng lại không dám.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610207
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610207,
					"content": "Chuyện này... à, cái đó... giống, giống như sô cô la trên mặt bánh kem, mỗi viên đều có hương vị khác nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790610208,
					"content": "Nếu mỗi viên sô cô la đều có hương vị giống nhau, vậy chẳng phải chiếc bánh kem sẽ rất bình thường sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610209,
						790610210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790610209,
					"content": "Paimon, thật biết nói chuyện.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610211
					]
				},
				{
					"id": 790610211,
					"content": "Nghe lâu như vậy rồi, ít nhiều cũng đã quen thuộc, haha, thấy rất có lý phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790610212,
					"content": "Vậy sao? Tôi... tôi cần phải suy nghĩ lại... Có lẽ, đi xa một chuyến ngắn cũng không tệ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610213
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610213,
					"content": "Đừng lo lắng, Esnoir, ngày khởi hành tiếp theo vẫn còn rất xa, tôi có thể cùng anh từ từ suy nghĩ về điều đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610210,
					"content": "Paimon đã hoàn toàn hòa nhập vào nơi này...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610211
					]
				},
				{
					"id": 790610204,
					"content": "Một lý tưởng rực rỡ không bao giờ phai nhạt...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610206
					]
				},
				{
					"id": 790610205,
					"content": "Và những người làm việc chăm chỉ cho ước mơ của họ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610206
					]
				}
			]
		},
		{
