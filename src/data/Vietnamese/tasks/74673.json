			},
			"dialogs": [
				{
					"id": 746730101,
					"content": "Này nhóc con, ta không lặn xuống nước được. Nhìn xem, ta còn chẳng có đồ lặn nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746730102
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 746730102,
					"content": "Haiz... Dù có nhảy tới nhảy lui thì ta cũng không có cách nào để đi cùng đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746730103,
						746730104
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 746730103,
					"content": "Ulman! Anh cũng đến Fontaine sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746730105
					]
				},
				{
					"id": 746730105,
					"content": "#{NICKNAME}, có cả Paimon nữa, không ngờ lại gặp hai vị ở đây. Trùng hợp thật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746730106
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 746730106,
					"content": "Anh vẫn được các tiên linh quý mến như trước đây nhỉ. Hơn nữa... hình như anh giao lưu với tiên linh ngày càng thuần thục hơn thì phải.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746730107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746730107,
					"content": "Phiên dịch giúp tôi xem tiên linh đang nói gì nào.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746730108
					]
				},
				{
					"id": 746730108,
					"content": "Haiz, đừng trêu tôi nữa. Làm sao tôi biết được nó muốn nói gì chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746730109
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 746730109,
					"content": "Tôi đến Fontaine để làm ăn, nhưng khi đang đi dạo ven biển thì bị một tiên linh nhỏ quấn lấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746730110
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 746730110,
					"content": "Tôi đã quen với việc này rồi, nên tôi đã đi theo nó. Tôi vượt qua núi, băng qua rừng, thậm chí còn phải chèo thuyền nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746730111
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 746730111,
					"content": "Sau đó nó nhảy tới nhảy lui, báo hiệu cho tôi biết ở đây có chôn thứ gì đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746730112
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 746730112,
					"content": "Thế nhưng... nó vùi đầu vào trong nước, càng bơi càng sâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746730113
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 746730113,
					"content": "Tôi thì không biết lặn! Hơn nữa, tôi nghe người ta nói dưới đó có nhiều nguy hiểm... Tôi đành phải ngồi trên thuyền đợi nó quay lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746730114
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 746730114,
					"content": "Thế nhưng nhóc con kia vẫn cứ dẫn tôi xuống đó... Tôi thật lòng mong nó hiểu được là tôi không thể lặn xuống nước...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746730115,
						746730117
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 746730115,
					"content": "Anh có cảm nhận được điểm đặc sắc của Fontaine không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746730116
					]
				},
				{
					"id": 746730116,
					"content": "Hoàn toàn cảm nhận được. Đây đúng là một quốc gia thân thiện và nhiệt tình, khiến người ta lưu luyến không muốn về, hahaha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746730119
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 746730119,
					"content": "Vậy thì chắc là anh muốn nhờ chúng tôi ra tay giùm, đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746730120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746730120,
					"content": "Đúng vậy! Cảm ơn trời đất, hai vị vẫn chưa bị ảnh hưởng bởi người Fontaine, cách nói chuyện vẫn cứ ngắn gọn súc tích như trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746730121
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 746730121,
					"content": "Tôi thật lòng không thể chịu nổi cách người Fontaine gọi nhau là thương mến gì đó trong lúc nói chuyện đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746730122
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 746730122,
					"content": "Trung bình trong hai mươi từ là sẽ có hai từ kính ngữ, ba từ ẩn dụ, sáu từ hình dung...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746730123,
						746730124
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 746730123,
					"content": "Tôi lúc nào cũng ngắn gọn súc tích mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746730125
					]
				},
				{
					"id": 746730125,
					"content": "Chậc... Hình như tôi cũng bị ảnh hưởng mất rồi... Nào! Cầm lấy quyển sổ tay này đi, tôi đã đánh dấu lại những chỗ mà tiên linh đưa tôi đi rồi đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746730126
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 746730126,
					"content": "Vẫn giống như lúc trước, nếu tìm được Tiền Sắt Cổ thì hãy mang về cho tôi, tôi sẽ thu mua với giá cao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746730127
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 746730127,
					"content": "#Chúng ta hợp tác vui vẻ nhé, {NICKNAME}, và cả Paimon nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ulman"
				},
				{
					"id": 746730124,
					"content": "Khả năng tu từ của tôi không được tốt cho lắm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746730125
					]
				},
				{
					"id": 746730117,
					"content": "Tôi còn tưởng anh quen gặp ma vật rồi chứ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746730118
					]
				},
				{
					"id": 746730118,
					"content": "Đúng là thế. Nhưng nếu gặp ở trên đất liền thì tôi còn chạy được, còn gặp ở dưới nước thì tôi chịu đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746730119
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 746730104,
					"content": "\"Duyên phận Tiên Linh\" của anh vẫn tốt thật.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746730105
					]
				}
			]
		}
	]
}