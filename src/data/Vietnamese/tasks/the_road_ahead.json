					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080215,
					"content": "#Như vậy không được đâu nhé. Chúng tôi còn phải dùng để cứu {REALNAME[ID(2)|SHOWHOST(true)]} đấy!",
					"roleType": "TALK_ROLE_NPC",
