			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Manqu",
					"#{REALNAME[ID(2)|SHOWHOST(true)]}"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750080101,
					"content": "Manqu, chúng tôi quay lại rồi đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750080102,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080103
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750080103,
					"content": "Ừm, quả là khoảng thời gian chờ đợi vất vả. Không giấu gì, chờ đợi càng lâu thì tôi càng cảm thấy lo lắng đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080104
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080104,
					"content": "Tuy nhiên... Người đưa ra đề xuất là tôi, nếu mọi người tiến vào di tích mà không thể quay về thì thực sự lương tâm của tôi cũng không thể yên đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080105
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080105,
					"content": "Tuy nhiên, thứ lỗi tôi hỏi thẳng, mọi người chắc cũng tìm thấy tín vật mà Hiền Giả Trộm Lửa để lại trong di tích rồi nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080106,
						750080107
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080106,
					"content": "Rất tốn công sức đấy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750080108
					]
				},
				{
					"id": 750080108,
					"content": "Tôi tin chắc là mọi người sẽ thành công mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080109
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080109,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080110
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750080110,
					"content": "Đây, chính là thứ trông như đĩa tròn này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750080111,
					"content": "A... \"Đĩa Vàng Thông Điệp\"... Không ngờ Đĩa Vàng Thông Điệp trong truyền thuyết lại có thật. Tốt quá rồi, tôi nhất định phải ghi nó vào thành quả nghiên cứu của mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080112
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080112,
					"content": "Thì ra thứ này được gọi là Đĩa Vàng Thông Điệp à...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750080113,
					"content": "Đúng vậy. Thứ lỗi tôi hơi mạo muội, tôi thực sự phấn khích quá... Nghe nói đây là thứ do chính tay Hiền Giả Trộm Lửa làm ra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080114
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080114,
					"content": "Vừa rồi có một khoảnh khắc tôi đã muốn chiếm lấy nó làm của riêng, xem như bảo vật gia truyền gì đó đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080115
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080115,
					"content": "#Như vậy không được đâu nhé. Chúng tôi còn phải dùng để cứu {REALNAME[ID(2)|SHOWHOST(true)]} đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750080116,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080117
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750080117,
					"content": "Tôi biết chứ... Nhưng manh mối về tín vật thì tôi cũng chỉ biết có vậy, rốt cuộc cái còn lại ở đâu thì tôi thực sự không rõ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080118
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080118,
					"content": "Ochkanatlan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750080119
					]
				},
				{
					"id": 750080119,
					"content": "#Ối, thứ lỗi tôi nói thẳng, {NICKNAME} vừa nói Ochkanatlan sao...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080120
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080120,
					"content": "(Kể lại những gì đã thấy khi chạm vào bia đá...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750080121
					]
				},
				{
					"id": 750080121,
					"content": "Ừm, không ngờ lại ở Ochkanatlan... Đó là một di tích cổ nằm bên kia bờ biển ở phía bắc Hội Hoa Vũ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080122
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080122,
					"content": "Nếu là Ochkanatlan thì xin thứ lỗi, tôi không thể giúp được rồi. Nơi đó không chỉ là cấm địa của bộ tộc, mà còn là cấm địa của Hiệp Hội Nghiên Cứu Di Vật Saurian...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080123
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080123,
					"content": "Nghe nói nhiều năm trước từng có thành viên của Hiệp Hội Nghiên Cứu Di Vật Saurian nhận ủy thác đến đó điều tra, kết quả là như hòn đá chìm sâu dưới nước, không chút tăm hơi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080124
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080124,
					"content": "Từ đó về sau, hiệp hội chúng tôi không còn nhúng tay vào bất kỳ chuyện gì liên quan đến Ochkanatlan nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080125
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080125,
					"content": "Không sao, biết được những điều này đã là rất đủ rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750080126,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080127
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750080127,
					"content": "Ừm, tôi phải cảm ơn các vị một lần nữa. Đối với tôi thì việc được nhìn thấy Đĩa Vàng Thông Điệp thật sự rất quan trọng. Không được, tôi phải nhanh chóng trở về để ghi chép lại mới được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080128
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080128,
					"content": "#{NICKNAME}, Paimon, xin cảm ơn các vị một lần nữa. Chúc các vị có một chuyến hành trình thuận lợi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080129
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080129,
					"content": "#Và cũng chúc {REALNAME[ID(2)|SHOWHOST(true)]} có thể loại bỏ Chúc Phúc Của Chúa Tể Lửa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080130
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080130,
					"content": "Tạm biệt!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750080131
					]
				},
				{
					"id": 750080131,
					"content": "Ừm... Ở điểm cuối của hành trình, nơi trở về của tất cả linh hồn, chúng ta nhất định sẽ gặp lại nhau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080107,
					"content": "Dễ như trở bàn tay.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750080108
					]
				}
			]
		},
