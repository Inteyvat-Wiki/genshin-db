						750080216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750080216,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080217
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750080217,
					"content": "Tôi biết chứ. Tiếp theo đây, các vị sẽ phải đến Núi Lửa Tollan rồi nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080218
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080218,
					"content": "Truyền thuyết kể rằng, khi Xbalanque chưa trở thành Hỏa Thần, ngài đã từng chiến đấu với Chúa Tể Lửa nắm giữ ánh sáng và sức nóng ở đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080219
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080219,
					"content": "Cuối cùng, dũng sĩ Xbalanque đã sống sót quay về, trở thành Hỏa Thần đời đầu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080220
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080220,
					"content": "Nhưng không ai biết trong núi lửa có gì cả. Có người nói bên trong có rồng cổ đang ngủ say, cũng có người nói bên trong bị lửa của Xbalanque thiêu rụi, trở nên trống rỗng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080221
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080221,
					"content": "Theo tôi thì chắc đều chỉ là suy đoán của người kể chuyện thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080222
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080222,
					"content": "Dù rất muốn đi cùng, nhưng đối với tôi thì vẫn hơi miễn cưỡng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080223
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080223,
					"content": "Không sao, biết được những điều này đã là rất đủ rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750080224,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080225
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750080225,
					"content": "Ừm, tôi phải cảm ơn các vị một lần nữa. Đối với tôi thì việc được nhìn thấy Đĩa Vàng Thông Điệp thật sự rất quan trọng. Không được, tôi phải nhanh chóng trở về để ghi chép lại mới được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080226
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080226,
					"content": "#{NICKNAME}, Paimon, xin cảm ơn các vị một lần nữa. Chúc các vị có một chuyến hành trình thuận lợi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080227
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080227,
					"content": "#Và cũng chúc {REALNAME[ID(2)|SHOWHOST(true)]} có thể loại bỏ Chúc Phúc Của Chúa Tể Lửa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080228
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080228,
					"content": "Tạm biệt!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750080229
					]
				},
				{
					"id": 750080229,
					"content": "Ừm... Ở điểm cuối của hành trình, nơi trở về của tất cả linh hồn, chúng ta nhất định sẽ gặp lại nhau!",
