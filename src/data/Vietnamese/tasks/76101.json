			"dialogs": [
				{
					"id": 761010101,
					"content": "#{NICKNAME}, Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010102
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761010102,
					"content": "Hihi, chúng tôi đến rồi! Ở đây náo nhiệt thật đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761010103,
					"content": "Thời gian qua mọi người vất vả rồi, cuối cùng cũng xử lý xong xuôi hết mọi công việc, giờ mới có thời gian tổ chức tiệc tùng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010104
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761010104,
					"content": "Cậu cũng vất vả rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761010105
					]
				},
				{
					"id": 761010105,
					"content": "Những gì tôi làm thực sự chẳng đáng là bao. Hơn nữa, nếu không có sự hỗ trợ của hai vị, cho dù cuối cùng có giành được chiến thắng thì e rằng cũng phải trả giá bằng nhiều sự hy sinh hơn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010106
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761010106,
					"content": "Chúng tôi là thành viên trong đội của cậu mà! Đừng nói những lời khách sáo như vậy nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761010107,
					"content": "Ừm, nói cũng phải. A, bố già chuẩn bị phát biểu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010108
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761010108,
					"content": "Các chiến hữu, các anh chị em, hôm nay chúng ta tề tựu nơi đây không đơn thuần để ăn mừng, mà là để tưởng niệm chiến thắng đã đánh đổi bằng biết bao xương máu này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010109
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010109,
					"content": "Khi chúng ta nâng ly, xin đừng quên những người đã không thể cùng chúng ta nâng ly chúc mừng được nữa, họ đã dùng máu thịt của mình để thực hiện lời thề.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010110
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010110,
					"content": "Trong tác chiến lần này, phân đội điều tra \"Chim Đêm Ác Mộng\" do Illuga dẫn dắt đã gánh vác nhiệm vụ gian khổ nhất...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010111
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010111,
					"content": "#Đặc biệt là nhóm {NICKNAME}, hai người đã không chút do dự gia nhập trong lúc nguy nan này và đã thể hiện vai trò không thể xem thường trong chiến đấu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010112
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010112,
					"content": "Họ không ngại hy sinh, vượt khó tiến lên, mở ra con đường đi đến chiến thắng cho chúng ta trong bao hiểm nguy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010113
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010113,
					"content": "Công lao của họ, cùng với công lao của tất cả những người đã chiến đấu vì người sống và tương lai, sẽ mãi mãi được khắc ghi trong lịch sử.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010114
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010114,
					"content": "Đúng vậy, chúng ta đã chiến thắng! Mặc dù phải trả cái giá rất lớn. Chúng ta có thể rơi lệ, có thể thương tiếc, nhưng không được để nỗi đau đánh gục.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010115
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010115,
					"content": "Bởi vì \"tương lai\" mà chúng ta phấn đấu sắp đến rồi, để ngọn lửa được truyền đi, để ngọn đèn dẫn đường tiếp tục tỏa sáng, chúng ta vẫn chưa thể dừng bước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010116
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010116,
					"content": "Nhưng hôm nay, hãy cùng nâng ly vì chiến thắng, vì những chiến hữu anh dũng bất khuất, và vì tương lai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nikita"
				}
			]
		},
		{
			"id": 7610102,
			"completionStepIds": [
