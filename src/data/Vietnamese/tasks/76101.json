				]
			},
			"dialogs": [
				{
					"id": 761010301,
					"content": "Bố già, chúng con về rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010302
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761010302,
					"content": "Về là tốt rồi, tình hình Vách Đá Kipumaki thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010303
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010303,
					"content": "Kể lại vắn tắt tình hình...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						761010304
					]
				},
				{
					"id": 761010304,
					"content": "Quả nhiên là vậy... Từ đây cũng có thể quan sát được, Trụ Thần Embla đã hoàn toàn bị sức mạnh Vực Sâu... bị tên yêu ma bất tử \"Giáo Sư\" đó khống chế rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010305
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010305,
					"content": "Nhưng hiện tại nó vẫn chưa có động tĩnh gì lớn, có lẽ là do cô Alia đang dốc toàn lực để chống chọi với nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010306
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010306,
					"content": "Chúng ta không được lãng phí một giây phút quý giá nào mà cô ấy đã dành được cho chúng ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010307
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010307,
					"content": "May mắn là với sự giúp đỡ của Flins và mọi người, công tác chuẩn bị đã gần như hoàn thành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010308
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010308,
					"content": "Có Kiếm Xoắn Ốc mọi người mang về, Mũi Tên Của Terpikeraunas cũng thành hình rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010309
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010309,
					"content": "Ơ... Mũi Tên Của Terpikeraunas là gì? Là Thánh Vật lợi hại giống như Bấc Đèn Bạc, Kiếm Xoắn Ốc sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761010310,
					"content": "Haha, là thứ lợi hại hơn cả chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010311
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010311,
					"content": "Năm trăm năm trước, Người Đúc Đèn lực bất tòng tâm, chỉ có thể phong ấn yêu ma bất tử đó dưới Vách Đá Kipumaki. Nhưng sau đó, Người Đúc Đèn và Vịnh Nguyệt Sứ đời đầu vẫn không từ bỏ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010312
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010312,
					"content": "Để vào một ngày nào đó trong tương lai có thể kết liễu triệt để yêu ma bất tử đó, họ đã dùng kỹ thuật cổ xưa chế tạo ra \"cung tên\" này, do những Người Giữ Đèn chúng tôi bảo vệ đến nay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010313
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010313,
					"content": "Bây giờ cuối cùng cũng đến lúc để nó hoàn thành sứ mệnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010314
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010314,
					"content": "Ồ... không ngờ lại có mũi tên lợi hại như vậy, thật muốn xem thử... nó trông như thế nào nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761010315,
					"content": "Đứa trẻ ngốc, mọi người đã sớm nhìn thấy rồi, hay nói đúng hơn, chúng ta đang ở bên trong Mũi Tên Của Terpikeraunas đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010316,
						761010318
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010316,
					"content": "Hả?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761010317
					]
				},
				{
					"id": 761010317,
					"content": "Chẳng, chẳng lẽ là muốn bắn cả chúng ta ra ngoài... Sao có thể chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761010320,
					"content": "Đại sảnh bia này được xây dựng xung quanh Mũi Tên Của Terpikeraunas, mà Kiếm Xoắn Ốc mọi người mang về, chính là đầu mũi tên còn thiếu của nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010321
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010321,
					"content": "Chỉ cần lắp Kiếm Xoắn Ốc vào đây là có thể khiến Mũi Tên Của Terpikeraunas tiến vào trạng thái chuẩn bị phóng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010322
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010322,
					"content": "Nhưng đây chẳng phải là lò sưởi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761010323,
					"content": "Là lò sưởi, cũng là thiết bị đặc biệt khiến Kiếm Xoắn Ốc hóa thành \"đầu mũi tên\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010324
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761010324,
					"content": "Nhân lúc \"Trứng Ác\" đó còn chưa nở... Hãy dùng \"cung tên\" được truyền lại đến nay để hoàn toàn chôn vùi nó nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010325
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010325,
					"content": "Trong thời gian đó, chắc chắn tên yêu ma bất tử kia sẽ giãy giụa trước khi chết, dù nó có phái bao nhiêu tay sai đến thì chúng tôi cũng sẽ thay hai người chặn lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010326
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010326,
					"content": "Trọng trách phóng Mũi Tên Của Terpikeraunas, giao cho hai vị đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010318,
					"content": "Là muốn bắn cả tôi ra ngoài sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761010319
					]
				},
				{
					"id": 761010319,
					"content": "#Hóa ra {NICKNAME} chính là vũ khí quyết chiến cuối cùng của chúng ta! ...Không phải chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010320
					],
					"speakerTitle": "Paimon"
				}
			]
		},
