			"dialogs": [
				{
					"id": 761010201,
					"content": "Illuga! Cuối cùng cậu cũng về rồi, Starshyna Nikita đang đợi cậu đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010202
					],
					"speakerTitle": "Olav"
				},
				{
					"id": 761010202,
					"content": "Hả? Starshyna... Nikita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761010203,
					"content": "#{NICKNAME}, Nikita chẳng phải là ông lão ủy thác chúng ta đi tìm Bấc Đèn Bạc sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761010204,
					"content": "Tôi nhớ ông ấy rõ ràng nói mình chỉ là một Ratnik bình thường mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010205,
						761010206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761010205,
					"content": "Đúng vậy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761010207
					]
				},
				{
					"id": 761010207,
					"content": "Bố già cũng thật là... Haiz, mọi người cứ coi như trò đùa dai của ông ấy đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010208
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761010208,
					"content": "Khoan hãy nói chuyện này, chúng ta đi báo cáo tình hình với ông ấy đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761010206,
					"content": "Không, nhìn thế nào ông ấy cũng không giống Ratnik bình thường...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761010207
					]
				}
			]
		},
		{
			"id": 7610103,
