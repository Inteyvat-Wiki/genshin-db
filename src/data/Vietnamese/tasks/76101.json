			},
			"dialogs": [
				{
					"id": 761011301,
					"content": "Cánh cổng dẫn đến ma thiên đã mở ra, chút Kuuvahki yếu ớt này làm sao có thể ngăn cản được ta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011302
					],
					"speakerTitle": "\"Giáo Sư\""
				},
				{
					"id": 761011302,
					"content": "Nhưng tại sao ta lại bị giam cầm ở đây... Ta hiểu rồi, là SAMPO lại một lần nữa từ chối ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011303
					],
					"speakerTitle": "\"Giáo Sư\""
				},
				{
					"id": 761011303,
					"content": "Xem ai đến thế này, khách quý đây mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011304
					],
					"speakerTitle": "Alia"
				},
				{
					"id": 761011304,
					"content": "...Ai đó?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011305
					],
					"speakerTitle": "\"Giáo Sư\""
				},
				{
					"id": 761011305,
					"content": "Bộ dạng này... À, là cậu đấy à, Relya. Thật tốt quá, ta biết ngay là cậu vẫn còn sống.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011306
					],
					"speakerTitle": "\"Giáo Sư\""
				},
				{
					"id": 761011306,
					"content": "Giờ hãy ra lệnh cho sức mạnh của SAMPO phục tùng ta! Với dòng máu hậu duệ thánh trong người, cậu nhất định làm được. Dù sao cậu cũng khác hẳn với ba tên vô dụng kia, là đệ tử mà ta yêu quý nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011307
					],
					"speakerTitle": "\"Giáo Sư\""
				},
				{
					"id": 761011307,
					"content": "Ha, không ngờ lão lại nhận nhầm mình là Relya... Tên yêu tăng mồm mép năm xưa giờ lại lẩm cẩm đến thế, thật là châm biếm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011308
					],
					"speakerTitle": "Alia"
				},
				{
					"id": 761011308,
					"content": "Đừng do dự, Relya. Cậu đã quên đi lý tưởng chung của chúng ta rồi sao? Cậu không muốn lấy lại địa vị và thân phận vốn thuộc về mình sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011309
					],
					"speakerTitle": "\"Giáo Sư\""
				},
				{
					"id": 761011309,
					"content": "Tạo nên \"Thiên Đường\" cho những người bị bắt nạt và sỉ nhục, khiến lũ quý tộc fae xấu xa phải cúi đầu trước cậu, trong cả vương triều Sao Nhạt chỉ có ta, một con người như cậu là sẵn lòng giúp đỡ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011310
					],
					"speakerTitle": "\"Giáo Sư\""
				},
				{
					"id": 761011310,
					"content": "Giờ đây, chỉ còn một bước nữa thôi ta sẽ bước lên bậc thang của muôn sao... Khi \"Thiên Đường\" từ bên ngoài vòm trời giáng thế, chỉ những kẻ được chọn như cậu và ta mới có thể sống sót.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011311
					],
					"speakerTitle": "\"Giáo Sư\""
				},
				{
					"id": 761011311,
					"content": "Khi đó, mọi sự thối nát và ô uế đều sẽ được gột rửa sạch sẽ, chẳng phải đây chính là thế giới mà cậu hằng khao khát sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011312
					],
					"speakerTitle": "\"Giáo Sư\""
				},
				{
					"id": 761011312,
					"content": "Không, đó không phải là thế giới mà anh ấy mong muốn... Ngay cả lúc này ngươi vẫn cố giở trò lừa gạt vụng về của mình sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011313
					],
					"speakerTitle": "Alia"
				},
				{
					"id": 761011313,
					"content": "Ngay từ đầu ngươi đã lợi dụng anh ấy, tất cả những lời dối trá chẳng qua chỉ để anh ấy giúp ngươi lấy được SAMPO, còn \"Thiên Đường\" mà ngươi nói đến chỉ dành cho một mình ngươi mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011314
					],
					"speakerTitle": "Alia"
				},
				{
					"id": 761011314,
					"content": "Ngay cả việc anh ấy từ bỏ thân phận sĩ quan để trở thành đạo tặc cũng là do cái bẫy mà ngươi và đại công tước Alvis đã cùng nhau bày ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011315
					],
					"speakerTitle": "Alia"
				},
				{
					"id": 761011315,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011316
					],
					"speakerTitle": "\"Giáo Sư\""
				},
				{
					"id": 761011316,
					"content": "Tuy ngươi đã nhận nhầm người, nhưng với tư cách là người thừa kế thân phận và ý chí của anh ấy, tất nhiên tôi cũng không từ chối cái tên Reed Miller.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011317
					],
					"speakerTitle": "Alia"
				},
				{
					"id": 761011317,
					"content": "Nhân danh Reed Miller, Rauthvangi, yêu tăng, \"Giáo Sư\", con rắn độc bất tử... hãy để ta đặt dấu chấm hết cho câu chuyện của ngươi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011318
					],
					"speakerTitle": "Alia"
				},
				{
					"id": 761011318,
					"content": "Chúng ta làm được rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011319
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761011319,
					"content": "Lần này cuối cùng chúng ta cũng đã chôn vùi hoàn toàn con yêu ma bất tử đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011320
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761011320,
					"content": "\"Con rắn độc bất tử đó ắt sẽ sống lại hai lần, rồi bị đánh bại ba lần... cho đến khi bị các anh hùng của thế giới dưới trăng chôn vùi vĩnh viễn...\"\\nSát cánh cùng những Ratnik dũng cảm, cuối cùng cũng tiêu diệt được \"giáo sư\"...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						761011321
					]
				},
				{
					"id": 761011321,
					"content": "Sau đó, ở lại Thành Piramida vài ngày...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		}
	]
}