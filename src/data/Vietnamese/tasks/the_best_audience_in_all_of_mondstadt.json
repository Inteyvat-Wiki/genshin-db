					"Jack"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200630201,
					"content": "Khi nào tôi sẽ trở thành một nhà mạo hiểm tuyệt vời đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630202
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630202,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630203
					]
				},
				{
					"id": 200630203,
					"content": "Ồ thì ra là bạn... Ngài Cyrus hôm qua kể với tôi về một chuyến mạo hiểm...Tại <color=#00E1FFFF>Núi Vọng Phong</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630204
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630204,
					"content": "Anh ta nói thế này: \"...Chiếc khiên thô ráp giống như một cơn ác mộng mà tôi không thể chống lại, bất kể thanh kiếm của tôi có tấn công như thế nào, chiếc khiên ấy vẫn không hề lay chuyển, đằng sau tấm khiên là con quái vật nhìn tôi khinh bỉ, tiếng cười khúc khích của nó đang chế nhạo sự bất lực của tôi...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630205
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630205,
					"content": "Một chiếc khiên gỗ chống lại mọi sự công kích... Chà, tôi thực sự muốn tận mắt nhìn thấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630206
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630206,
					"content": "Nhưng nhiều việc như vậy không rời ra được... rốt cuộc là quái vật khủng khiếp như thế nào mới cầm thứ đồ như vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630207
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630207,
					"content": "Nếu bạn đồng ý, có thể giúp tôi đi tìm quái vật được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630208,
						200630210
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630208,
					"content": "Không thành vấn đề.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630209
					]
				},
				{
					"id": 200630209,
					"content": "Đợi bạn tìm thấy rồi, chúng ta cùng ngồi xuống nói chuyện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630210,
					"content": "Để tôi đi chung với bạn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630211
					]
				},
				{
					"id": 200630211,
					"content": "Tôi? Không được, Hiệp Hội Nhà Mạo Hiểm có rất nhiều việc vặt cần tôi làm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630212
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630212,
					"content": "Ngày nay, các hoạt động mạo hiểm không mang lại nhiều thu nhập, vì vậy mặc dù là Hiệp Hội Nhà Mạo Hiểm, nhưng thực chất hầu hết thời gian lại giúp đỡ mọi người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630213
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630213,
					"content": "Như giúp ngài Draff đuổi heo rừng, giúp tiểu thư Margaret tìm mèo, hái hoa tươi cho tiểu thư Flora....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630214
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630214,
					"content": "Haha, khi mới gia nhập Hiệp Hội Nhà Mạo Hiểm, tôi không nghĩ mình sẽ giải quyết được những \"mạo hiểm\" này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				}
			]
		},
		{
			"id": 2006303,
			"completionStepIds": [
				2006301
			],
