					"nextDialogs": [
						200631603
					]
				},
				{
					"id": 200631603,
					"content": "Đúng vậy, tôi kể câu chuyện đó thực chất là Hilichurl mà thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631604
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 200631604,
					"content": "Í, bạn hãy nghe lời tôi, bạn cũng biết giới trẻ ở Thành Mondstadt chỉ muốn gia nhập Đội Kỵ Sĩ Tây Phong, Hiệp Hội Nhà Mạo Hiểm đã lâu rồi không có người mới đăng ký.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631605
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 200631605,
					"content": "Còn nguyên nhân vì sao, thì là do Đội Kỵ Sĩ Tây Phong đều đánh nhau với các quái vật như rồng chẳng hạn. Còn Hiệp Hội Nhà Mạo Hiểm đều là giải quyết bọn Hilichurl lặt vặt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631606
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 200631606,
					"content": "Nếu không có câu chuyện hấp dẫn... Hiệp Hội Nhà Mạo Hiểm chắc chắn không tuyển được người nào cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631607
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 200631607,
					"content": "Mặc dù cách này cũng vô ích... nhưng tôi đã quá già, không thể chiến đấu với bất kỳ quái vật huyền thoại nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631608
					],
					"speakerTitle": "Cyrus"
				},
				{
