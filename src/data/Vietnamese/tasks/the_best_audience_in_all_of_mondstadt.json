				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jack"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200630301,
					"content": "Tôi muốn đi mạo hiểm khắp nơi..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630302
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630302,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630303
					]
				},
				{
					"id": 200630303,
					"content": "Hôm qua ngài Stanley lại kể với tôi một câu chuyện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630304
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630304,
					"content": "Nhưng do uống quá nhiều, câu chuyện loạn tùng phèo cả lên, tôi nghĩ... có lẽ là ở <color=#00E1FFFF>gần Tửu Trang Dawn</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630305
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630305,
					"content": "Có lẽ anh ấy nói như thế này...\"...Trên mình con quái vật có những kết tinh băng, khiến nó càng trở nên cứng cáp và to lớn. Chẳng mấy chốc, sự sợ hãi đã khiến đôi chân của tôi đông cứng, tôi vung kiếm loạn xạ, chém mãi chém mãi cuối cùng không nhìn thấy gì nữa...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630306
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630306,
					"content": "Là quái vật nào khiến ngài Stanley rơi vào một cuộc chiến khó khăn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630307
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630307,
					"content": "Tôi thực sự muốn nhìn thấy nó... nhưng nếu đi, tôi chỉ nên quan tâm đến việc chạy sao cho nhanh mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630308
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630308,
					"content": "Tuy nhiên, nếu đó là bạn, sẽ ổn thôi. Bạn có muốn giúp tôi tìm nó không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630309,
						200630311
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630309,
					"content": "Tôi biết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630310
					]
				},
				{
					"id": 200630310,
					"content": "Vậy phiền bạn rồi! Sau khi tìm thấy nhớ về kể cho tôi nghe nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630311,
					"content": "Cùng đi nào.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
