			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jack"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200630101,
					"content": "Ồ, tôi muốn xem thử...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630102
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630102,
					"content": "Xem cái gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630103
					]
				},
				{
					"id": 200630103,
					"content": "Í, bạn đến từ lúc nào vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630104
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630104,
					"content": "Chuyện là như thế này, ngài Stanley hôm qua sau khi uống rượu đã kể cho tôi về chuyến hành trình của anh ấy, tại <color=#00E1FFFF>Hẻm Núi Dadaupa</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630105
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630105,
					"content": "Anh ấy nói rằng: \"...Con quái vật đang bùng cháy dữ dội, cơ thể to lớn từ từ chuyển động. Dù tôi có tấn công hay hò hét thế nào, nó chỉ liếc đôi mắt to khủng khiếp của nó, như thể tỏ vẻ khinh miệt tôi tột cùng... \"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630106
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630106,
					"content": "Tuy tôi không tận mắt chứng kiến nhưng ngài Stanley đã phải khổ chiến thì chắc hẳn đó là cuộc mạo hiểm đầy vĩ đại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630107
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630107,
					"content": "Than ôi, tôi thực sự muốn tìm con quái vật đã khiến ngài Stanley rơi vào một cuộc chiến khó khăn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630108
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630108,
					"content": "Thế nhưng với thực lực của tôi, chắc chắn sẽ bị nó đánh thê thảm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630109
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630109,
					"content": "Nếu bạn có hứng thú, có thể giúp tôi tìm con quái vật được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630110,
						200630112
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630110,
					"content": "Tôi biết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630111
					]
				},
				{
					"id": 200630111,
					"content": "Bạn thật đáng tin tưởng! Vậy thì nhờ bạn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630112,
					"content": "Tôi có thể đi cùng bạn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630113
					]
				},
				{
					"id": 200630113,
					"content": "Nếu có thể, tôi cũng muốn đi cùng bạn, nhưng vẫn còn rất nhiều công việc phải làm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630114
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630114,
					"content": "Công việc gì ư? Hiệp Hội Nhà Mạo Hiểm ở Mondstadt, nếu chỉ có đi mạo hiểm thì thu nhập quả thực không đủ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630115
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630115,
					"content": "Vì vậy, tôi cũng giúp cư dân làm tất cả mọi việc, như tìm mèo, nhổ cỏ, v.v...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630116
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630116,
					"content": "Tôi sẽ để cho bạn tiến hành cuộc phiêu lưu tuyệt vời này. Sau khi tìm thấy nó, hãy quay lại và kể với tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				}
			]
		},
		{
			"id": 2006302,
			"completionStepIds": [
				2006301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
