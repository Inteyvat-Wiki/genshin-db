			"dialogs": [
				{
					"id": 731090301,
					"content": "Tiêu rồi, \"Hộp Ước Mơ\" này không phải của tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090302,
						731090304
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090302,
					"content": "Chúng tôi đã đào được một chiếc hộp.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090303
					]
				},
				{
					"id": 731090303,
					"content": "Haha... Tôi cũng đào được một cái...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090305
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090305,
					"content": "Tôi còn mở \"Hộp Ước Mơ\" đó ra, mảnh giấy trong hộp còn có chữ kí của Ami nữa cơ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090306
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090306,
					"content": "Tôi nhớ cô bé này, là con gái của Jahangir, thường hay xuất hiện ở tiệm ăn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090307
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090307,
					"content": "Ước mơ của cháu ấy là trở thành một người thợ trồng hoa để trồng thật nhiều hoa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090308
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090308,
					"content": "Không ngờ đấy, tôi còn nghĩ nhà Jahangir sẽ đào tạo cháu ấy trở thành người nối nghiệp cửa hàng nhà mình cơ đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090309,
						731090310
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090309,
					"content": "Xem ước mơ của anh trước đi nào.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090311
					]
				},
				{
					"id": 731090311,
					"content": "Ồ! Đúng đúng, phải xem ước mơ của bản thân mình trước đã...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090312
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090312,
					"content": "Để tôi xem nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090313
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090313,
					"content": "\"Hi vọng trở thành \"Van{RUBY#[S]Người Đi Rừng}ara\", luôn ở trong rừng sâu...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090314
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090314,
					"content": "Ước mơ hồi nhỏ của tôi là thế này sao? Thật không biết khi đó tôi đang nghĩ gì nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090315
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090315,
					"content": "Haiz... Vanara không phải là một công việc dễ kiếm tiền đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090316,
						731090317
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090316,
					"content": "Tôi thấy chẳng có gì không tốt cả.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090318
					]
				},
				{
					"id": 731090318,
					"content": "Đó chỉ là cách nghĩ mà trẻ con mới có, đến tuổi của tôi thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090319
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090319,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090320
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090320,
					"content": "Chi bằng nghĩ cách để kiếm thêm vài đồng Mora, như vậy thì ban đêm sẽ có thể ngủ yên giấc hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090321
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090321,
					"content": "Được rồi, đừng nói về ước mơ nhàm chán của tôi nữa, hay là xem tiếp của Ami đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090322
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090322,
					"content": "Tôi đã mở \"Hộp Ước Mơ\" của cháu ấy ra, nên phải làm gì đó để đền bù cho cháu ấy mới được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090323
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090323,
					"content": "Ừm... Để tôi nghĩ xem, nếu cháu ấy đã muốn trở thành một người trồng hoa, vậy thì phải học cách trồng hoa trước đã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090324
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090324,
					"content": "Chỗ tôi vừa hay có một chậu hoa để không, có thể mang cho cháu ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090325
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090325,
					"content": "Nhà Lữ Hành, bạn có biết làm thế nào để lấy hạt giống hoa không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090326,
						731090327
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090326,
					"content": "Cứ giao cho tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090332
					]
				},
				{
					"id": 731090332,
					"content": "Vậy chuyện hạt giống nhờ bạn nhé, Nhà Lữ Hành, lát nữa chúng ta sẽ gặp nhau ở cửa hàng của Jahangir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090327,
					"content": "Tại sao anh phải làm thế?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090328
					]
				},
				{
					"id": 731090328,
					"content": "Haha... Cứ xem như tôi nổi hứng nhất thời đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090329
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090329,
					"content": "Tôi không thể theo đuổi ước mơ của mình được nữa, một phần là tuổi không còn nhỏ nữa, mặt khác... tôi cũng không còn quan tâm nhiều đến ước mơ này nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090330
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090330,
					"content": "Nhưng Ami vẫn còn nhỏ, cháu ấy vẫn có thể thử thực hiện ước mơ của mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090331
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090331,
					"content": "Một người lớn nhàm chán như tôi cũng không thể làm gì để giúp được cháu ấy, nên cứ tặng chậu hoa này vậy, xem như là để cổ vũ cháu ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090332
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090317,
					"content": "Không có ước mơ tốt hay xấu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090318
					]
				},
				{
					"id": 731090310,
					"content": "Đây là \"Hộp Ước Mơ\" của anh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090311
					]
				},
				{
					"id": 731090304,
					"content": "Anh cũng đã đào được một cái sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090305
					]
				}
			]
		},
		{
			"id": 7310905,
			"completionStepIds": [
				7310905
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
