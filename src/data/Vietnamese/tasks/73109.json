				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731090501,
					"content": "Cái này... cho cháu sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090502
					],
					"speakerTitle": "Ami"
				},
				{
					"id": 731090502,
					"content": "Chiếc hộp đó cháu chỉ tùy tiện chôn xuống thôi, mảnh giấy bên trong cũng chỉ viết bừa, chú có nhìn thấy cũng không sao, không cần xin lỗi cháu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090503
					],
					"speakerTitle": "Ami"
				},
				{
					"id": 731090503,
					"content": "Không sao, dù sao chậu hoa này để ở chỗ chú cũng không làm gì, tặng nó cho cháu nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090504
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090504,
					"content": "Chú còn nhờ người tìm hạt giống cho cháu nữa, có lẽ sắp đến rồi đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090505,
						731090506
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090505,
					"content": "Hạt giống đến rồi đây!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090507
					]
				},
				{
					"id": 731090507,
					"content": "Hả? Bạn đến từ khi nào thế, tôi cũng không để ý nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090508
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090508,
					"content": "Khụ... Ami, không phải cháu muốn trở thành người trồng hoa sao? Cháu cứ bắt đầu trồng những loài hoa này trước nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090509
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090509,
					"content": "Cảm ơn... Nhưng nếu cháu trồng hoa cạnh cửa hàng của ba thì lũ côn trùng sẽ bay vào nồi đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090510
					],
					"speakerTitle": "Ami"
				},
				{
					"id": 731090510,
					"content": "Những con côn trùng rơi vào nồi thật đáng thương, những người lớn ăn phải côn trùng cũng rất đáng thương.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090511
					],
					"speakerTitle": "Ami"
				},
				{
					"id": 731090511,
					"content": "Nếu chuyển hoa ra xa, cháu lại lo mình sẽ quên chăm sóc nó, hoa héo đi thì cũng rất đáng thương...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090512
					],
					"speakerTitle": "Ami"
				},
				{
					"id": 731090512,
					"content": "Hơn nữa ba thường rất bận rộn, cũng sẽ không để cháu đi quá xa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090513
					],
					"speakerTitle": "Ami"
				},
				{
					"id": 731090513,
					"content": "Ừm... Nếu cháu đồng ý thì chú sẽ cùng cháu chăm sóc chậu hoa này, thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090514
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090514,
					"content": "Tuy mỗi ngày chú chỉ có thể tới sau khi tan làm, nhưng ít nhiều gì cũng có chút thời gian rảnh rỗi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090515
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090515,
					"content": "Được chứ! Nhưng có lẽ ba sẽ không đồng ý đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090516
					],
					"speakerTitle": "Ami"
				},
				{
					"id": 731090516,
					"content": "Chú và Jahangir xem như có quen biết, đợi lát nữa chú đi nói chuyện với anh ta, chắc sẽ không có vấn đề gì đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090517
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090517,
					"content": "Được!... Vậy cháu trồng thêm vài chậu hoa nữa mới được! Cháu thích nhất là Tường Vi Sumeru đó! Sau này... cháu muốn trồng đầy Tường Vi Sumeru bên cạnh cửa tiệm của ba!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090518
					],
					"speakerTitle": "Ami"
				},
				{
					"id": 731090518,
					"content": "Được chứ, cháu có lý tưởng lắm, hai chúng ta sẽ cùng nhau cố gắng nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090519,
						731090520
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090519,
					"content": "Tới lúc đó nhớ chia cho tôi một bông đó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090521
					]
				},
				{
					"id": 731090521,
					"content": "#Vâng! Cảm ơn {M#anh}{F#chị}, em nghĩ... em sẽ trồng thêm một chậu Hoa Ngọt, sau đó trồng thêm cái gì đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090522
					],
					"speakerTitle": "Ami"
				},
				{
					"id": 731090522,
					"content": "Xem ra đứa bé này thật sự rất thích trồng hoa, hy vọng cô bé sẽ có thể kiên trì với ước mơ của mình...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090523
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090523,
					"content": "Hì hì... Đừng có giống như tôi, trở thành một kẻ vừa bình thường lại nhàm chán.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090524
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090524,
					"content": "Khụ! Nhà Lữ Hành, cảm ơn bạn đã giúp đỡ, thù lao này cho bạn, xin hãy nhận lấy đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090525,
						731090526
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090525,
					"content": "Chẳng tầm thường khi chúng ta chú tâm vào cuộc sống.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090527
					]
				},
				{
					"id": 731090527,
					"content": "Cảm ơn bạn, không phải tôi đang phàn nàn cái gì đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090528
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090528,
					"content": "Có điều... Hôm nay nhìn thấy \"ước mơ\" tôi từng chôn xuống nên mới có chút bùi ngùi mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090529
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090529,
					"content": "Được rồi, cũng tới lúc tôi phải trở về rồi, hôm nay cảm ơn bạn đã giúp đỡ nhé, Nhà Lữ Hành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090530
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090530,
					"content": "Tôi có cần... viết lại một \"ước mơ\" khác rồi chôn xuống tiếp không nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090526,
					"content": "Nỗ lực sống không hề nhàm chán.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090527
					]
				},
				{
					"id": 731090520,
					"content": "Cố lên nào!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090521
					]
				},
				{
					"id": 731090506,
					"content": "Số hạt giống hoa này cho em này.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090507
					]
				}
			]
