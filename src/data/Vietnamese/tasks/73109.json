			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Javi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731090101,
					"content": "Chà? Chắc phải ở quanh đây mà, sao lại không thấy nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090102
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090102,
					"content": "Anh đang tìm gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090103
					]
				},
				{
					"id": 731090103,
					"content": "Bạn là... Ồ, chắc hẳn là Nhà Lữ Hành đúng không, tôi đã nghe người ta nhắc đến bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090104
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090104,
					"content": "Tôi là Javi, là... là một nhân viên bán hàng bình thường, tôi đang tìm một chiếc \"Hộp Ước Mơ\" mà tôi đã chôn lúc trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090105
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090105,
					"content": "Cái tên thật kỳ lạ... Trong hộp đó đựng gì thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731090106,
					"content": "Hừm... Đó là chiếc hộp đựng \"ước mơ mong muốn được thực hiện\" khi tôi còn nhỏ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090107
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090107,
					"content": "Tại sao phải làm như vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090108
					]
				},
				{
					"id": 731090108,
					"content": "Hahaha, đây là một trò chơi mà tôi đã chơi với bạn bè của mình khi tôi còn rất nhỏ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090109
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090109,
					"content": "Viết ra ước mơ mong muốn thực hiện nhất, sau đó chôn nó ở đây. Sau đó hẹn đến một lúc nào đó sẽ cùng đến đây đào \"Hộp Ước Mơ\" này ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090110
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090110,
					"content": "Bây giờ đã đúng thời gian hẹn trước rồi. Nhưng mà... xem ra chỉ có mình tôi là vẫn còn nhớ đến chuyện này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090111
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090111,
					"content": "Haiz, việc này họ quên thì cứ quên thôi... chỉ cần đừng quên ước mơ của mình là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090112
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090112,
					"content": "Tóm lại, lần này tôi đến đây chỉ để đào chiếc hộp của chính mình, như vậy cũng xem như đã hoàn thành một tâm nguyện của mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090113
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090113,
					"content": "Nhưng tôi đã tìm quanh rồi, không tìm thấy gì cả, không lẽ bị người ta đào mất rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090114,
						731090115
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090114,
					"content": "Lúc đó anh có đánh dấu gì không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090118
					]
				},
				{
					"id": 731090118,
					"content": "Tôi nhớ khi đó tôi đã chôn bên cạnh một cái cây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090119
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090119,
					"content": "Một cái cây? Xung, xung quanh đây có rất nhiều cây đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731090120,
					"content": "Hồi nhỏ tôi cũng không để ý đến chuyện này, khi đó chúng tôi đã cắm một cái bảng nhỏ ở nơi chôn chiếc hộp để đánh dấu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090121
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090121,
					"content": "Sau một thời gian dài, cái bảng đó đã biến mất, tôi cũng hoàn toàn không nhận ra cây cối xung quanh nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090122
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090122,
					"content": "Tôi chỉ nhớ mang máng là nơi chôn chiếc hộp nằm ở gần đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090123
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090123,
					"content": "Nhà Lữ Hành, bạn có thể giúp tôi tìm nó được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090124,
						731090127
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090124,
					"content": "Tìm bằng cách nào?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090125
					]
				},
				{
					"id": 731090125,
					"content": "Tôi đã chôn chiếc hộp đó bên cạnh một cái cây, cho nên... cứ đào cạnh mấy cái cây trước xem sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090126
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090126,
					"content": "Xin hãy giúp tôi đi mà, tôi sẽ trả thù lao cho bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090130
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090130,
					"content": "Bạn thấy đấy, khu rừng này rộng như vậy, một mình tôi không thể tự tìm được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090131
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090131,
					"content": "Được thôi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090132
					]
				},
				{
					"id": 731090132,
					"content": "Hihi, cảm ơn bạn nhiều nhé, vậy chúng ta chia ra tìm nhé, tôi ở bên này, bên còn lại nhờ vào bạn nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090127,
					"content": "Dù gì thì ước mơ cũng đã bay xa rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090128
					]
				},
				{
					"id": 731090128,
					"content": "Chính vì ước mơ của tôi đã bay mất nên tôi càng phải đào chiếc hộp đó ra, để xem ước mơ thuở ban đầu mà tôi hy vọng sẽ thành hiện thực là gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090129
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090129,
					"content": "Xin bạn đó Nhà Lữ Hành, hãy giúp tôi đi mà, tôi sẽ trả thù lao cho bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090130
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090115,
					"content": "Ước mơ bay mất rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090116
					]
				},
				{
					"id": 731090116,
					"content": "Hahaha... Tôi không phủ nhận điều này, dù sao bây giờ tôi cũng không nhớ ước mơ mà tôi đã viết năm xưa là gì nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090117
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090117,
					"content": "Nhưng ngay cả khi ước mơ của tôi đã bay xa thì chiếc hộp đó cũng không thể nào bay mất chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090118
					],
					"speakerTitle": "Javi"
				}
			]
		},
