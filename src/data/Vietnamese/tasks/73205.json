			},
			"dialogs": [
				{
					"id": 732050301,
					"content": "Tốt, tốt lắm, hai cháu thật thông minh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050302
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050302,
					"content": "Ta có dự cảm, dưới sự giúp đỡ của người có chuyên môn, lần này có lẽ sẽ trồng thành công.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050303
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050303,
					"content": "Cuốn Shawarma và Tahchin đợt trước có ngon không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050304,
						732050306
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050304,
					"content": "Ngon ạ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050305
					]
				},
				{
					"id": 732050305,
					"content": "Ngon thì ta sẽ làm thêm cho các cháu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050307
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050307,
					"content": "Tay nghề của ta vẫn chưa tốt bằng bà nhà đã mất của ta, nếu các cháu không chê thì cầm lấy đi, chỗ này ít hơn lần trước một chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050308
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050308,
					"content": "Ngon lắm! Ông Affan, ông thật tốt bụng, sau này chúng cháu sẽ đến thăm ông thường xuyên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732050309,
					"content": "Haha, trước đó các cháu chẳng phải muốn hỏi ta loài hoa này là loài hoa gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050310
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050310,
					"content": "Nói với các cháu cũng không có gì đáng ngại, hoa mà ta trồng đều là Tường Vi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050311
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050311,
					"content": "Loài này không giống với Tường Vi Sumeru đúng không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050312
					]
				},
				{
					"id": 732050312,
					"content": "Loài hoa này tên là \"Tường Vi Vàng\". Ôi, chúng còn quý báu hơn cả Tường Vi Sumeru nữa đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050313
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050313,
					"content": "Trước đó ta bảo những hạt giống hoa này là của một người bạn để lại cho ta, các cháu còn nhớ không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050314
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050314,
					"content": "Thực ra, những hạt giống này, và cả căn nhà cũ kĩ này đều là do quỷ già đã mất rồi để lại cho ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050315
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050315,
					"content": "Ôi, ta quên mất, các cháu không phải là người của làng Aaru, chắc chắn sẽ không biết cái tên này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050316
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050316,
					"content": "Không biết cũng được, cứ nhớ người đó là một lão già biết trồng hoa, vậy là được rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050317
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050317,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050318
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050318,
					"content": "Ông Affan sao bỗng nhiên ngây người ra rồi. Ông Affan, ông Affan ơi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732050319,
					"content": "Ôi, có phải ta vừa ngây người ra không? Người tuổi cao rồi, khả năng tập trung không còn tốt, để các cháu chê cười rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050320
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050320,
					"content": "Lần này phải cảm ơn hai cháu, nếu các cháu còn muốn xem cái gì thì cứ tự nhiên dạo quanh đây nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050321
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050321,
					"content": "Ta sẽ không đuổi người nữa đâu, nhưng mà cẩn thận đừng giẫm lên vườn ươm nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050306,
					"content": "Vẫn chưa thử ạ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050307
					]
				}
			]
		},
