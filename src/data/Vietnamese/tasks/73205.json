					"Affan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732050101,
					"content": "Nào, đến xem những hạt giống này nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050102
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050102,
					"content": "Hình như chẳng có gì thay đổi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050103
					]
				},
				{
					"id": 732050103,
					"content": "Đúng thế, dù ta đã làm ruộng bao năm nay, nhưng trồng hoa và trồng lúa không hề giống nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050104
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050104,
					"content": "Nếu không, tại sao đã lâu vậy rồi mà chúng vẫn chưa mọc chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050105
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050105,
					"content": "Để xem nào, ồ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732050106,
					"content": "Ông Affan, cháu thấy vườn ươm của ông khô cằn quá, chắc do đất ở xung quanh Làng Aaru không đủ chất dinh dưỡng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732050107,
					"content": "Trước đó chúng cháu từng giúp người trong Làng Aaru trồng hoa, chúng cháu có kinh nghiệm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732050108,
					"content": "Ồ, thế à...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050109
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050109,
					"content": "Cũng có lý, loài hoa hiếm có thế này khi trồng chắc sẽ cần chăm bón cẩn thận hơn cây hoa bình thường, đúng là ta không tưới nước bón phân đầy đủ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050110
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050110,
					"content": "Nhưng nguồn nước cách xa khu vườn ươm này quá, việc đi lấy nước rất bất tiện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050111
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050111,
					"content": "Nước dùng hàng ngày mà ta dự trữ cũng không nhiều, muốn tưới nước thường xuyên cho hạt giống trong vườn cũng hơi rắc rối.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050112
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050112,
					"content": "Cháu có thể giúp.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050113
					]
				},
				{
					"id": 732050113,
					"content": "Được rồi, vậy thì nhờ các cháu tưới ít nước cho ba hạt giống này trước nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				}
			]
		},
		{
