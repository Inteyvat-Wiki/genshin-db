			"trigger": {
				"objectNames": [
					"Shitou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223050101,
					"content": "Quý khách, ấy, quý khách! Bạn có muốn mua một viên đá thử vận may không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050102,
						223050104,
						223050108
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050102,
					"content": "Mua một viên thử xem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223050103
					]
				},
				{
					"id": 223050103,
					"content": "Được được! Quý khách à, tôi thấy hôm nay khí sắc của bạn tốt đó, có vẻ sắp phát tài rồi, ha ha ha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050116
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050116,
					"content": "Quý khách, bên này có hợp mắt bạn không!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050104,
					"content": "Đá gì thế?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223050105
					]
				},
				{
					"id": 223050105,
					"content": "Tất nhiên là phôi ngọc thượng hạng trong tiệm của chúng tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050106
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050106,
					"content": "Chỉ cần chế tác ra ngọc thạch, tôi sẽ trả lại Mora cho bạn. Nếu như chẳng có gì cả thì đương nhiên cũng không có Mora đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050107
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050107,
					"content": "Quý khách cứ thử một viên đi, sẽ tự khắc hiểu mọi thứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050102,
						22305108
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050108,
					"content": "Chỗ đá này từ đâu thế?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223050109
					]
				},
				{
					"id": 223050109,
					"content": "Phôi ngọc của cửa tiệm chúng tôi đều là hàng xịn được lấy từ Vực Đá Sâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050110
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050110,
					"content": "Hi hi, đừng nghi ngờ như thế, [Giải Thúy Hàng] chúng tôi nhiều đời buôn bán ngọc thạch rồi. Mắt nhìn hàng của chúng tôi có một không hai đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050111
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050111,
					"content": "Hi, có điều đó chỉ là ngày xưa mà thôi, còn hiện nay...không phải tổng vụ đã chặn Vực Đá Sâu rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050112
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050112,
					"content": "Nguồn nguyên liệu bị chặn như vậy, bán được một viên đá thì sẽ ít đi một viên đá, cứ như vậy thì mấy cục đá này còn đáng giá hơn cả những viên ngọc đã được chế tác xong nữa đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050113
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050113,
					"content": "Tôi đang nghĩ, chi bằng bán quách phôi ngọc trong tiệm đi cho rồi, như vậy không chỉ tiết kiệm được công chế tác, mà khi chế tạo đá còn có cảm giác kích khích nữa, he he...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050114
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050114,
					"content": "Quý khách, cứ thử mua một viên đá, tự mình trải nghiệm xem sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050115
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050115,
					"content": "Mua một viên thử xem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223050116
					]
				}
			]
		},
