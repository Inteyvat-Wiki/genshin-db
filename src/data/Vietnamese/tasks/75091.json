					"Qispi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750910101,
					"content": "Một, hai... Ừm, ba này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910102
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910102,
					"content": "Hửm, một, hai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910103
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910103,
					"content": "Woa, ở đây có một người kỳ lạ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910104,
					"content": "Người ngoại quốc như mấy người mới là kỳ lạ đấy... Đây không phải là nơi mà người ngoại quốc nên đến đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910105
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910105,
					"content": "Đây là cấm địa gì à...? Hay là thánh địa gì đó sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910106,
					"content": "Cũng không phải. Đây chỉ là nơi tôi tình cờ phát hiện ra, là nơi chứa đầy kho báu thôi. Này, hai người tới gần chút, có nghe thấy không, khối đá đặc biệt này chính là \"Đá Kho Báu\" đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910107
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910107,
					"content": "Từ trong đó phát ra âm thanh trầm thấp, như thể là... có ai đó đang thở vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910108,
						750910110
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910108,
					"content": "Đá cũng biết mệt mỏi mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910109
					]
				},
				{
					"id": 750910109,
					"content": "Chỉ ở đó hít thở thôi mà, có gì mệt mỏi chứ? À mà khoan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910112,
					"content": "Đá... cũng biết hít thở sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910113,
					"content": "Không chỉ hít thở đâu. Nếu áp tai lên đó sẽ còn nghe thấy nhịp điệu, nghe thấy âm thanh của nham thạch cọ xát dưới bề mặt gồ ghề.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910114
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910114,
					"content": "Haha... Đúng là thứ âm thanh tuyệt vời.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910115
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910115,
					"content": "Còn nữa... Chỉ cần cho nó vài viên đá nhỏ, thì nó thậm chí còn có thể nhả ra những viên đá tốt và đẹp hơn nữa đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910116
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910116,
					"content": "Aaaah, không thể tin nổi chứ gì? Nhìn này, những viên đá quý này đây, một này, hai này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910117
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910117,
					"content": "Hóa ra khi chúng tôi tới đây thì anh đang bận đếm số đá quý này sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910118,
					"content": "Đúng thế. Hơn nữa, tôi cảm thấy Đá Kho Báu này sau khi ăn những viên đá khác nhau thì đã trở nên mạnh mẽ hơn rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910119
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910119,
					"content": "Đây nhất định là một điều thần kỳ đấy. Haha, Đá Kho Báu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910120,
						750910121
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910120,
					"content": "Nghe có vẻ khả nghi quá...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910122
					]
				},
				{
					"id": 750910122,
					"content": "Haha, tôi vốn chẳng mong những người ngoại quốc sẽ tin tưởng mà. Nếu không thử thì sẽ chẳng ai tin cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910123
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910123,
					"content": "Tôi cũng thỉnh thoảng đặt khoáng thạch thu thập được ở bên cạnh Đá Kho Báu nên mới phát hiện ra đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910124
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910124,
					"content": "Đúng rồi, hai người cũng thử đi! Thử là tin ngay thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910125
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910125,
					"content": "Đúng lúc thì đá quanh đây nó đã ăn hết rồi, phải cho nó ăn chút đá mới thôi... Nhưng mà tôi không thể đi tìm cho nó ăn được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910126
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910126,
					"content": "Sao thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910127,
					"content": "Tất nhiên là tôi phải luôn trông chừng Đá Kho Báu rồi! Nhỡ đâu lúc tôi rời đi nó chui xuống đất thì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910128
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910128,
					"content": "Tôi đã canh chừng ở đây rất lâu rồi... Đá mà tôi mang theo nó cũng ăn hết rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910129
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910129,
					"content": "Hai người cho tôi một ít đá mới đi. Tôi cho nó ăn để chứng minh cho hai người thấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910130
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910130,
					"content": "Hmm, nghe có vẻ giống lừa đảo lắm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910131,
					"content": "#Làm thế nào đây, {NICKNAME}? Có nên thử không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910132,
					"content": "Dù sao thì cũng chỉ là đá thôi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910133
					]
				},
				{
					"id": 750910133,
					"content": "Hihi, vậy thì chọn một ít đá cho tôi đi... Đá Kho Báu nhất định sẽ nhả ra loại đá tốt hơn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910121,
					"content": "Thật sao? Trông như đang lừa đảo ấy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910122
					]
				},
				{
					"id": 750910110,
					"content": "Tôi cũng biết hít thở đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910111
					]
				},
				{
					"id": 750910111,
					"content": "Đúng thế, biết hít thở thì có gì mà ghê gớm chứ... À mà khoan, đây có phải là trọng tâm đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910112
					],
					"speakerTitle": "Paimon"
				}
			]
		},
