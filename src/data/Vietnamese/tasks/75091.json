				{
					"id": 750910201,
					"content": "Hmm... Kiên nhẫn chút. Chờ tới lúc yên tĩnh, tôi sẽ đem số đá này cho Đá Kho Báu ăn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910202
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910202,
					"content": "Chỉ cần qua một thời gian là sẽ có loại đá tốt hơn thôi. Haha, một viên... hai viên...",
					"roleType": "TALK_ROLE_NPC",
