			},
			"dialogs": [
				{
					"id": 750910301,
					"content": "Woa, không ngờ là lại mọc ra thật này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910302,
					"content": "Đá Kho Báu hay thật... Không đúng, không lẽ là Qispi tự đặt lên Đá Kho Báu sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910303,
					"content": "...Haha, sao tôi lại đi làm chuyện ngu ngốc đó chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910304
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910304,
					"content": "May nhờ số đá kia mà Đá Kho Báu cũng đã có sức sống hơn rồi. À, hai người có nghe thấy gì không...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910305
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910305,
					"content": "Âm thanh đó giống như tiếng lửa bập bùng trên mặt đất, như là... à, như mạch đập ấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910306
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910306,
					"content": "Quả nhiên, cho nó ăn chút đá khác là điều đúng đắn mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910307
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910307,
					"content": "Chậc, chẳng nghe thấy gì cả...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910308,
					"content": "#{NICKNAME} có nghe thấy không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910309,
						750910311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910309,
					"content": "Cảm thấy đó chỉ là đá bình thường thôi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910310
					]
				},
				{
					"id": 750910310,
					"content": "Đúng thế...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910313,
					"content": "Haha, người ngoại quốc... À, là hai người ngoại quốc tài năng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910314
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910314,
					"content": "Nếu được thì cho tôi thêm một ít đá đi. Loại đá tốt hơn, đẹp hơn ấy... Tôi tin là sức mạnh của Đá Kho Báu sẽ không khiến hai người thất vọng đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
