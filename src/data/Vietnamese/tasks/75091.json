				},
				{
					"id": 750910502,
					"content": "Haha, quả là người ngoại quốc đa nghi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910503
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910503,
					"content": "Lần này hai người đã hiểu được sự vĩ đại của Đá Kho Báu chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910504
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910504,
					"content": "Aaah, Đá Kho Báu, nhờ số đá mà hai người đem đến, sức mạnh của Đá Kho Báu đã mạnh hơn nhiều rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910505
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910505,
					"content": "Không biết cuối cùng nó sẽ biến thành thế nào nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910506
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910506,
					"content": "Chà, nói thế thì ngay cả tôi cũng có chút tò mò đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910507,
					"content": "Rốt cuộc tại sao chỉ cần ăn đá là có thể nhả ra đá tốt hơn nhỉ? Hay là... Chúng ta đập nó ra xem thử đi?",
