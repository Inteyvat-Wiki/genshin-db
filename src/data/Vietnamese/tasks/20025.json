			"dialogs": [
				{
					"id": 200250101,
					"content": "Nhà Lữ Hành, bạn... bạn đến thật tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200250102
					],
					"speakerTitle": "Wyatt"
				},
				{
					"id": 200250102,
					"content": "Tôi cần phải đưa xe hàng này đến Mondstadt. Tối hôm qua khi đi đến chỗ này, nhìn thấy nhiều đốm sáng sáng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200250103
					],
					"speakerTitle": "Wyatt"
				},
				{
					"id": 200250103,
					"content": "Vì uống nhiều quá, tôi... tôi đột nhiên rất muốn đến xem là thứ gì, sau khi đi qua đó, thì phát hiện rất nhiều Slime, tôi còn bị đụng trúng vài lần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200250104
					],
					"speakerTitle": "Wyatt"
				},
				{
					"id": 200250104,
					"content": "Tôi rất sợ, nhưng lại không tìm thấy phương hướng, đi cả nửa ngày mới về tới chỗ xe hàng. Sáng hôm nay, tôi phát hiện <color=#00E1FFFF>chìa khóa</color> của tôi không tìm thấy nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200250105
					],
					"speakerTitle": "Wyatt"
				},
				{
					"id": 200250105,
					"content": "Bạn có thể tìm giúp tôi không? Tôi đoán là ở xung quanh đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200250106,
						200250108
					],
					"speakerTitle": "Wyatt"
				},
				{
					"id": 200250106,
					"content": "Được thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200250107
					]
				},
				{
					"id": 200250107,
					"content": "Tốt quá rồi, khu vực lớn như vậy, tôi không biết bắt đầu từ đâu nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wyatt"
				},
				{
					"id": 200250108,
					"content": "Còn có việc gấp khác",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200250109
					]
				},
				{
					"id": 200250109,
					"content": "Khu vực lớn như vậy, tôi phải bắt đầu từ đâu, việc này chỉ có bạn làm được, năn nỉ đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wyatt"
				}
			]
		},
