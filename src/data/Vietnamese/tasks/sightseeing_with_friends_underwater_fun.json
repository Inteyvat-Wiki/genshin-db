			"dialogs": [
				{
					"id": 737130101,
					"content": "Ta-da! Chính là chỗ này. Xuống nước từ bãi cạn này, chắc chắn sẽ có cảm giác như một cuộn tranh từ từ mở ra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737130102,
					"content": "Ơ, là hai người... Còn dẫn theo bạn mới nữa sao? Đây là... Nấm Quỷ à? Trước giờ tôi mới chỉ thấy trong sách thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130103
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 737130103,
					"content": "Thật trùng hợp, còn có cả Melusine đang chơi ở đây nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130104,
						737130105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737130104,
					"content": "Lại gặp nhau rồi, Marine.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737130106
					]
				},
				{
					"id": 737130106,
					"content": "Không phải chơi đâu, tôi đang thu hoạch Tidalga để chuẩn bị làm mẻ Tidalga muối chua năm nay, nhiều chị em cũng về làng giúp đỡ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130107
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 737130107,
					"content": "Chị Enghiene và bé Roxane đều xin nghỉ để về đây rồi, giờ đang bận rộn lắm đó. Lát nữa tôi cũng phải xuống nước luôn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130108
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 737130108,
					"content": "Kể ra thì chị Enghiene nói cũng đúng. Nấm Quỷ màu xanh trông giống Tidalga thật...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130109
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 737130109,
					"content": "Ý tôi là, rất dễ thương, chứ không phải muốn ăn đâu... Ừm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130110
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 737130110,
					"content": "♫♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130111
					],
					"speakerTitle": "Nón Trống Tròn"
				},
				{
					"id": 737130111,
					"content": "Hihi, có mắt nhìn ghê đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130112,
						737130113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737130112,
					"content": "Nấm Quỷ đúng là dễ thương.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737130114
					]
				},
				{
					"id": 737130114,
					"content": "Tóm lại, rất vui được gặp mọi người, tôi phải đi làm việc đây. Mọi người chơi vui vẻ nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130115
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 737130115,
					"content": "Vậy chúng ta cũng xuất phát thôi? Cùng các Nấm Quỷ chụp thật nhiều ảnh đẹp dưới nước Fontaine nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737130113,
					"content": "Các Melusine cũng không thua kém đâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737130114
					]
				},
				{
					"id": 737130105,
					"content": "Xin chào, Melusine chưa từng gặp.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737130106
					]
				}
			]
		}
	]
