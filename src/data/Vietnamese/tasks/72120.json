					"Xavier"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721200101,
					"content": "Tốt lắm! Thử nghiệm lần trước rất thuận lợi, Họa Thần trên người Onikabuto bị thanh tẩy hoàn toàn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200102
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200102,
					"content": "Vậy bây giờ chúng ta...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721200103
					]
				},
				{
					"id": 721200103,
					"content": "Bây giờ chúng ta chỉ cần quy hoạch rõ ràng tuyến đường cần đi, là có thể bắt tay vào làm rồi. Nhưng tuyến đường này bắt buộc phải tránh đám Fatui kia mới được... xem ra phải đi đường vòng rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200104
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200104,
					"content": "Xét cho cùng thì tên này...cũng khá lớn, hai người chúng ta muốn đẩy vào thì phải đảm bảo trên đường không bị cản trở.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200105
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200105,
					"content": "Cho nên tôi muốn nhờ bạn đến gần Lò Luyện Mikage điều tra một chút, nếu gặp đường hỏng thì sửa chữa một chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200106
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200106,
					"content": "Mặc dù tôi vẫn chưa quy hoạch xong tuyến đường... Nhưng tốt nhất chúng ta hãy đảm bảo đa số các con đường đều thông thoáng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200107
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200107,
					"content": "Tôi không biết sửa đường.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721200108
					]
				},
				{
					"id": 721200108,
					"content": "Không cần sửa gì đặc biệt đâu, chỉ cần đặt một lớp gỗ lên trên để chúng ta chuyển anh bạn này qua là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200109
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200109,
					"content": "À, bạn sang bên kia lấy ván gỗ trước đi. Tôi ở đây giữ tên này, hãy cố gắng làm nó chắc chắn hết mức có thể nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				}
			]
		},
