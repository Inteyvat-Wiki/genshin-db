				"points": []
			},
			"dialogs": [
				{
					"id": 721200301,
					"content": "Thế nào? Bạn đã kiểm tra tất cả các con đường chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200302
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200302,
					"content": "Đường thông thoáng rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721200303
					]
				},
				{
					"id": 721200303,
					"content": "Được. Vậy một lát nữa chúng ta xuất phát...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200304
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200304,
					"content": "Bạn đang...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721200305
					]
				},
				{
					"id": 721200305,
					"content": "Tôi đang...suy nghĩ! Suy nghĩ các tình huống có thể xảy ra, bạn hiểu không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200306
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200306,
					"content": "Ví dụ khi đi vào, phát hiện hạt nhân đã bị lũ điên kia đào đi mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200307
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200307,
					"content": "Sau đó lũ điên đó lấy hạt nhân nhét vào Thủ Vệ Di Tích, rồi Thủ Vệ Di Tích mất kiểm soát, đánh bay hết chúng ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200308
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200308,
					"content": "Hoặc khi chúng ta đang thanh tẩy Lò Luyện Mikage, đột nguyên có một sinh vật nguyên tố nhảy ra, ăn mất hạt nhân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200309
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200309,
					"content": "Tệ nhất là Mãng Xà trong truyền thuyết hồi sinh, thì chúng ta coi như tiêu đời!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200310,
						721200311
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200310,
					"content": "Bạn bình tĩnh một chút...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721200312
					]
				},
				{
					"id": 721200312,
					"content": "À...ừm, xin lỗi, tôi lại gặp phải vấn đề cũ, lúc nào cũng nghĩ mọi chuyện theo hướng xấu nhất...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200313
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200313,
					"content": "Tôi sẽ vạch ra kế hoạch thật cụ thể, đến lúc đó, chúng ta sẽ xuất phát giải quyết cho xong chuyện này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200314
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200314,
					"content": "Mong mọi sự thuận lợi, mong mọi sự thuận lợi, mong mọi sự thuận lợi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200311,
					"content": "Không đến nỗi vậy đâu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721200312
					]
				}
			]
