					{
						"sceneId": 3,
						"position": [
							2515.588,
							415.68,
							4525.956
						],
						"pointId": 4563
					}
				]
			},
			"dialogs": [
				{
					"id": 740390801,
					"content": "Đây chính là nơi làm việc!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390802
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390802,
					"content": "Ừm, vậy tiếp theo đây sẽ cần thử nghiệm \"Thuốc Nhìn Thấu\", bạn đã chuẩn bị xong chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390803
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390803,
					"content": "Tôi chuẩn bị xong rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390804
					]
				},
				{
					"id": 740390804,
					"content": "Ừm... Phải cẩn thận đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390805,
					"content": "Bạn nhận bình thuốc từ tay Verenata, ngửi có mùi giống như rong biển đang thối rữa dưới ánh mặt trời, làm cho người ta đau đầu buồn nôn...\\nBạn do dự rồi một hơi uống cạn. Thuốc không khó uống, cũng chẳng có vị gì cả...\\nNgoài chuyện này ra, thì cơ thể bạn không có phản ứng gì khác.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740390806
					]
				},
				{
					"id": 740390806,
					"content": "Sau đó, theo hướng dẫn của Verenata, bạn nghỉ ngơi một lát, và cũng không xảy ra hiện tượng gì.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740390807
					]
				},
				{
					"id": 740390807,
					"content": "Nhưng không lâu sau đó...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740390808
					]
				},
				{
					"id": 740390808,
					"content": "Trông có vẻ như không có gì thay đổi nhỉ... Phù, không cần phải lo lắng nữa rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390809,
					"content": "#Ừm, nhưng... {NICKNAME} vừa ngẩn ra một lúc? Sao vậy? Đã nhìn thấy gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390810
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390810,
					"content": "Tôi nhìn thấy... một nửa con thuyền trong suốt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390811
					]
				},
				{
					"id": 740390811,
					"content": "Hửm? Thú vị đó! Nhưng mà... có thể miêu tả chi tiết hơn không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390812,
						740390815
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390812,
					"content": "Nó ở rất xa, tôi không nhìn rõ được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390813
					]
				},
				{
					"id": 740390813,
					"content": "#Rất thú vị! Nhưng không thể chứng minh cụ thể cho hiệu quả thuốc... Bởi vì có thể {NICKNAME} đã nhìn nhầm đá ngầm hoặc xác tàu ở ngoài xa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390814
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390814,
					"content": "Cho nên... haiz, thử nghiệm lần này vẫn không có thành quả rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390818
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390818,
					"content": "Cảm ơn các bạn, lần này đã thu thập được nhiều thông tin rồi! Sẽ có thể dùng cho công thức điều chế thuốc lần sau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390819
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390819,
					"content": "Ưm... \"Thông tin này rất quen thuộc...\" Ừm, \"Nhưng vẫn phải thử nghiệm thêm, xem thử còn có ai khác nhìn thấy cảnh tượng này không\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390820
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390820,
					"content": "Ơ... Vậy có nghĩa là cô còn phải tìm người khác để thử thuốc sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390821
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390821,
					"content": "Ừm. Bởi vì... chỉ cần tìm được hai người trở lên chứng kiến được cảnh này, thì chúng ta mới có thể xác nhận thuốc đã khiến người ta nhìn thấy \"thứ có thật\", đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390822
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390822,
					"content": "Bởi vì thứ \"có thật\" sẽ không bị ràng buộc bởi ánh mắt và tư duy, sẽ không vì lòng người mà biến đổi... Mà sẽ luôn luôn tồn tại ở đó, cứ thế mà tồn tại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390823
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390823,
					"content": "Ừm... Giống như... thần linh có thể sống mấy ngàn năm vậy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390824
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390824,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390825
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390825,
					"content": "Không, giống như cát trắng, xác của sao biển, như những làn sóng nhấp nhô... Những thứ này mới là \"sự thật\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390826
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390826,
					"content": "Nhưng dược sĩ cũng đã nói... Thông qua giấc mơ và hồi ức, cũng có thể tạo ra \"sự thật\" mới. Điều này tôi không hiểu lắm... nên đang cố gắng làm rõ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390827
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390827,
					"content": "Chà... Sao đề tài này lại trở nên thâm thúy vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390828
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390828,
					"content": "Haha, vậy thì không nói nữa! Tóm lại, rất cảm ơn các bạn đã giúp! Xin hãy nhận lấy những thứ này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390829
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390829,
					"content": "À... Lần sau nếu tôi điều chế ra thuốc mới, các bạn hãy đến thử nghiệm giúp tôi nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390815,
					"content": "Xem ra đã bị một thứ khổng lồ gì đó cắt đứt...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390816
					]
				},
				{
					"id": 740390816,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390817
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390817,
					"content": "Á, xin lỗi! Vừa rồi... có hơi phân tâm. Nhưng tôi đã ghi chép lại thông tin này rồi, cảm ơn bạn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390818
					],
					"speakerTitle": "Verenata"
				}
			]
		},
