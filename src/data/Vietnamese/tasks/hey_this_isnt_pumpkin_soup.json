			},
			"dialogs": [
				{
					"id": 740390501,
					"content": "Cảm ơn các bạn đã giúp đỡ! Bây giờ chúng ta sẽ thử loại thuốc đầu tiên!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390502
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390502,
					"content": "#{NICKNAME}, đừng có uống nhiều quá! Cảm thấy không ổn thì phải nhổ ra ngay nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390503,
					"content": "Được rồi, không sao đâu Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390504
					]
				},
				{
					"id": 740390504,
					"content": "Hừm... Tôi chỉ không yên tâm thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390505,
					"content": "Tôi sẵn sàng rồi, đưa thuốc cho tôi nào.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390506
					]
				},
				{
					"id": 740390506,
					"content": "Thuốc này tên là \"Thuốc Siêu Lợi Hại\", trên lý thuyết sẽ khiến bạn trở nên vô cùng lợi hại! Ừm... Trên lý thuyết là vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390507
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390507,
					"content": "Bạn nhận thuốc từ tay Verenata, một hơi uống sạch.\\nMặc dù mùi rất khó chịu, nhưng vị của thuốc lại thanh ngọt dễ uống.\\nNgoài chuyện này ra, cơ thể bạn không có phản ứng gì khác.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740390508
					]
				},
				{
					"id": 740390508,
