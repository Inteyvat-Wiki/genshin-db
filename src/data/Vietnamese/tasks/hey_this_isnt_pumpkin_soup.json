			"dialogs": [
				{
					"id": 740390601,
					"content": "#{NICKNAME} chỉ cần vài đòn là đã đánh bại đám quái vật đó, đây là tác dụng của \"Thuốc Siêu Lợi Hại\" sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390602,
						740390605
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390602,
					"content": "Đúng vậy, thuốc đã khiến tôi siêu lợi hại!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390603
					]
				},
				{
					"id": 740390603,
					"content": "Lời quảng cáo gì tệ vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390604,
					"content": "Woa! Cảm ơn hai bạn! Quả nhiên là nhờ thuốc, thật không hổ danh là thuốc do dược sĩ điều chế!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390609
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390609,
					"content": "Ừm, lần thử nghiệm \"Thuốc Siêu Lợi Hại\" đã kết thúc! Chúng ta sẽ bắt đầu thử nghiệm... thứ này! \"Thuốc Ấm Áp\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390610
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390610,
					"content": "Hửm, những cái tên này là do cô tự đặt à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390611,
					"content": "Không, tôi không biết đặt tên, nên chỉ có thể nhờ người khác đặt giúp một cái tên nghe ngốc ngốc thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390612
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390612,
					"content": "Cũng đừng nói vậy... Cái tên này vừa nghe là đã biết tác dụng rồi. Phải như vậy mới đúng, đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390613,
					"content": "Cũng đúng, dược sĩ chính là như vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390614
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390614,
					"content": "#Hihi, không nói nữa! {NICKNAME}, đã sẵn sàng thử lọ thuốc này chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390615
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390615,
					"content": "Ừm, chúng ta bắt đầu thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390616
					]
				},
				{
					"id": 740390616,
					"content": "Ối, mùi của lọ này cũng kinh quá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390617
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390617,
					"content": "Lọ \"Thuốc Ấm Áp\" này, về lý thuyết sẽ khiến bạn không sợ lạnh! Hmm... Trên lý thuyết là vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390618
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390618,
					"content": "Bạn nhận thuốc từ tay Verenata, ngửi mùi giống như miếng da cũ mốc meo phủ đầy bụi...\\nBạn do dự rồi một hơi uống sạch. Thuốc lại rất dễ uống, có mùi giống quế và nước gừng cay nồng... Khiến bạn nghĩ đến chiếc lò sưởi trong phòng vào một ngày mưa.\\nNgoài chuyện này ra, cơ thể bạn không có phản ứng gì khác.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740390619
					]
				},
				{
					"id": 740390619,
					"content": "Sau đó, dưới sự chỉ dẫn của Verenata, bạn nghỉ ngơi một lát.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 740390605,
					"content": "Không có cảm giác gì... Thấy rất ngọt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390606
					]
				},
				{
					"id": 740390606,
					"content": "Hả?! Nhưng mà... rõ ràng là mùi rất kinh dị mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390607,
					"content": "Hmm... Vậy sao? Sai ở đâu nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390608
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390608,
					"content": "Đừng chán nản... Dù sao thì cũng dễ uống, lại không có độc. Vậy là đã thành công rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390609
					],
					"speakerTitle": "Paimon"
				}
			]
		},
