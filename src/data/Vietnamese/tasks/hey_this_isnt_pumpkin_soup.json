			"dialogs": [
				{
					"id": 740390101,
					"content": "Ừm... Tidalga khô, nội tạng Lumitoile... ừm, thêm một chút... Chậc, một chút là bao nhiêu đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390102
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390102,
					"content": "Ơ, cô đang nấu canh gì sao...? Mùi hương kỳ lạ quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390103,
					"content": "Hửm? Kỳ lạ? Không phải chứ... Rõ ràng là làm theo đơn thuốc của Carabosse mà. Mùi hương phải bình thường mới đúng chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390104,
						740390106
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390104,
					"content": "Như mùi cá lên men ba năm trong bụng con ếch chết vậy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390105
					]
				},
				{
					"id": 740390105,
					"content": "Chà, cảnh tượng hiện ra ngay trước mặt tôi luôn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390108,
					"content": "Tóm lại thì cô đang làm gì thế? Hmm... Có cần chúng tôi giúp không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390109,
					"content": "Tôi đang nấu thuốc... là thuốc có thể giúp đỡ cho rất nhiều người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390110
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390110,
					"content": "Ồ... Vậy thì cô là dược sĩ à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390111,
					"content": "Không phải, là trợ lý của dược sĩ thì đúng hơn. Dược sĩ Carabosse rất lợi hại, Verenata tôi vẫn còn rất nhiều thứ để học.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390112
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390112,
					"content": "Hihi, vậy thì cũng là một trợ lý lợi hại mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390113,
					"content": "Hihi... ừm... à mà, không đúng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390114
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390114,
					"content": "Tôi vẫn còn rất nhiều thứ chưa biết, tôi chỉ đang cố điều chế thuốc cho dược sĩ thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390115
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390115,
					"content": "Các bạn biết tên tôi rồi... nhưng tôi vẫn chưa biết tên các bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390116
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390116,
					"content": "#Tôi là Paimon, còn đây là {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390117,
					"content": "\"Paimon\", tên thật hay. Nghe giống như con sứa nhỏ ồn ào màu trắng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390118
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390118,
					"content": "#{NICKNAME}, tên có vẻ kỳ lạ, vàng lấp lánh, nhưng rất thân thiện. Rất vui được gặp các bạn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390119
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390119,
					"content": "Tôi cần giúp đỡ, nhưng không biết các bạn có đồng ý không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390120
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390120,
					"content": "Cô cứ nói đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390121
					]
				},
				{
					"id": 740390121,
					"content": "Ừm, cần chúng tôi giúp gì thì cứ nói thẳng ra là được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390122,
					"content": "Tôi muốn hai bạn dùng thử... loại thuốc mới được điều chế này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390123
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390123,
					"content": "Hả...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390124,
					"content": "Tôi biết là nó khó ngửi khó uống... nhưng nó có thể giúp được rất nhiều người, nên sẽ rất hữu ích.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390125
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390125,
					"content": "Nhưng chúng tôi lại không bị bệnh, cũng không thích uống thứ kỳ quái... Dần dần không còn ai giúp tôi thử thuốc nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390126
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390126,
					"content": "Chà... Cả cô cũng tự nói là thứ kỳ quái, vậy không phải là rất nguy hiểm sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390127,
					"content": "Không sao đâu, chúng tôi không bị trúng độc. Hmm... Nên theo lý thuyết thì các bạn cũng sẽ không bị trúng độc... nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390128
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390128,
					"content": "Thuốc cần thử nghiệm có ba loại. Một loại sẽ khiến người ta trở nên lợi hại! Một loại khiến người ta cảm thấy ấm áp. Còn một loại... ừm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390129
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390129,
					"content": "Tôi cũng không nói rõ được... Carabosse nói là sẽ khiến người ta hiểu rõ sự thật. Cô ấy nói như vậy đó, nhưng tôi không hiểu lắm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390130
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390130,
					"content": "Nghe có vẻ vẫn rất nguy hiểm nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390131,
					"content": "Không nguy hiểm đâu... Vậy hai bạn có đồng ý giúp đỡ không? Nếu đồng ý thì tôi sẽ dẫn các bạn tới đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390106,
					"content": "Ngửi kỹ lại thì có chút hương thơm của Hoa Ngọt...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390107
					]
				},
				{
					"id": 740390107,
					"content": "Nghe không đúng lắm nhỉ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390108
					],
					"speakerTitle": "Paimon"
				}
			]
		},
