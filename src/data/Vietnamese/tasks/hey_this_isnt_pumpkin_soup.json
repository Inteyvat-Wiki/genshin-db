			"dialogs": [
				{
					"id": 740390701,
					"content": "#{NICKNAME}! Vẫn ổn chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390702
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390702,
					"content": "Hic... Xin lỗi, tôi không nghĩ thuốc sẽ thu hút những thứ kỳ quái như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390703,
						740390710
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390703,
					"content": "Do thuốc khiến tôi ấm áp nên mới như vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390704
					]
				},
				{
					"id": 740390704,
					"content": "Hả... Là do như vậy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390705,
					"content": "À... Đúng rồi, động vật thủy sinh sẽ lầm tưởng những thứ ấm áp là ánh sáng mặt trời, nên sẽ bị thu hút. Vậy là... thuốc đã thành công rồi! Cảm ơn bạn nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390706
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390706,
					"content": "Tôi cảm thấy không đúng cho lắm nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390707,
					"content": "Động vật thủy sinh...? Nhưng đó là Slime Hỏa mà?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390708
					]
				},
				{
					"id": 740390708,
					"content": "Vậy sao... Ừm, hình như là do tác dụng phụ gây ảo giác thì phải... Để tôi ghi lại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390709
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390709,
					"content": "Nhưng như vậy không ổn! Hôm nay nhìn cua thành Slime Hỏa, nếu ngày mai là quái vật nguy hiểm hơn thì sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390720
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390720,
					"content": "Ừm... Tôi đã làm phiền các bạn quá nhiều rồi, nhưng vẫn còn một mẫu thuốc cuối cùng cần thí nghiệm... À ừm, các bạn có đồng ý không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390721,
						740390723
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390721,
					"content": "Chỉ cần không có độc là được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390722
					]
				},
				{
					"id": 740390722,
					"content": "Có độc hay không thì phải thử mới biết mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390725
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390725,
					"content": "Cảm ơn các bạn! Vậy tiếp theo đây... chính là \"Thuốc Nhìn Thấu\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390726
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390726,
					"content": "Hả? Khoan, đợi đã!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390727,
					"content": "Bình thứ nhất là \"Thuốc Siêu Lợi Hại\", bình thứ hai là \"Thuốc Ấm Áp\", rồi bình này tên là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390728,
					"content": "\"Thuốc Nhìn Thấu\", nghĩa là có thể khiến cho người ta nhìn thấy sự thật... Sao vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390729
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390729,
					"content": "Không có gì... chỉ là cảm thấy cái tên này khác 360 độ so với hai cái tên trước đó thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390730,
						740390731
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390730,
					"content": "Vậy không phải sẽ giống với không có gì thay đổi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390732
					]
				},
				{
					"id": 740390732,
					"content": "Ễ... ? Ừm, thôi kệ đi! Đại khái là vậy đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390733
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390733,
					"content": "Hihi, bởi vì hai tên trước là do dược sĩ giúp tôi đặt, còn \"Thuốc Nhìn Thấu\" là do tôi tự mình đặt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390734
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390734,
					"content": "Khả năng đặt tên của tôi không thể bằng dược sĩ đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390735
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390735,
					"content": "Vậy sao... Tôi còn tưởng là ngược lại chứ... Cái tên mới này nghe bình thường hơn nhiều đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390736
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390736,
					"content": "Ừm, cảm ơn. À... Bình này khác với hai bình trước, có thể sẽ rất nguy hiểm... Cho nên hãy đến nơi làm việc của tôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390737
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390737,
					"content": "Ừm... Ở dưới biển thì môi trường có thể trung hòa hiệu quả thuốc, hơn nữa ở đó cũng có nhiều công cụ xử lý nguy hiểm hơn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390738
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390738,
					"content": "Chà... Lần này phải thử thuốc mạnh rồi nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390739
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390739,
					"content": "Chúng ta bắt đầu thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390740
					]
				},
				{
					"id": 740390740,
					"content": "Ừm, xin mời theo tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390731,
					"content": "Là 180 độ chứ nhỉ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390732
					]
				},
				{
					"id": 740390723,
					"content": "Dù sao thì cũng đang thử nghiệm rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390724
					]
				},
				{
					"id": 740390724,
					"content": "Đúng đó, bỏ cuộc giữa chừng thì phí lắm! Nhưng mà... tôi cũng còn hơi lo lo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390725
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390710,
					"content": "Không sao đâu, Slime Hỏa rất yếu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390711
					]
				},
				{
					"id": 740390711,
					"content": "#Hừm, cũng không đúng! Rõ ràng là do {NICKNAME} quá mạnh thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390712,
					"content": "Đợi chút... Bạn vừa nói là \"Slime Hỏa\" sao...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390713
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390713,
					"content": "...Chúng tôi chỉ nhìn thấy rất nhiều cua thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390714,
						740390716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390714,
					"content": "Cua? Ừm... Ở bờ biển có cua thì cũng bình thường thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390715
					]
				},
				{
					"id": 740390715,
					"content": "Nhưng lúc nãy bạn rất không bình thường!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390720
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390716,
					"content": "Nhưng cảm giác thiêu đốt rất chân thật, tôi còn cảm thấy có hơi nóng nữa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390717
					]
				},
				{
					"id": 740390717,
					"content": "Vậy sao... Ừm, hình như là do tác dụng phụ gây ảo giác thì phải... Để tôi ghi lại...! Cũng có tác dụng... nhưng mà... haiz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390718
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390718,
					"content": "Nhưng bạn không sao thì tốt quá! Thật xin lỗi, thuốc lại không thành công rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390719
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390719,
					"content": "#Không sao... Dù hơi khó ngửi chút, nhưng cũng đã thành công một nửa rồi! {NICKNAME} uống xong vẫn khỏe re kìa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390720
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7403908,
