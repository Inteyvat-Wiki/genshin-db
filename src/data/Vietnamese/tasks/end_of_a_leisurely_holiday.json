			"dialogs": [
				{
					"id": 765100101,
					"content": "...Giờ thì có thể chứng minh được rồi, đây không phải là vũ khí quân sự bí mật gì cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100102
					],
					"speakerTitle": "Edler"
				},
				{
					"id": 765100102,
					"content": "Ừm, quả thật là vậy. Nếu thiết kế khó hơn chút nữa thì không còn là trò chơi trẻ con nữa rồi, cố lên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100103
					],
					"speakerTitle": "Wislawa"
				},
				{
					"id": 765100103,
					"content": "Woa! Lại là bầu không khí đáng sợ y như vậy, căng thẳng như là sắp...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765100104,
					"content": "Sắp đánh nhau rồi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765100105
					]
				},
				{
					"id": 765100105,
					"content": "#Đúng vậy... Nhân lúc {NICKNAME} cũng ở đây, hay là bây giờ chúng ta so tài công bằng một chút nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100106
					],
					"speakerTitle": "Wislawa"
				},
				{
					"id": 765100106,
					"content": "Haiz, thật không biết chấp niệm của cô từ đâu ra? Đừng bảo là vì lần trước bị tôi hạ gục một cách dễ dàng nhé! Nếu đúng là vì chuyện đó thì được thôi, cứ việc thách đấu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100107
					],
					"speakerTitle": "Edler"
				},
				{
					"id": 765100107,
					"content": "#{NICKNAME}, {F#cô}{M#cậu} nhìn cho kỹ xem ai nhận thua trước!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100108
					],
					"speakerTitle": "Edler"
				},
				{
					"id": 765100108,
					"content": "Hừm, chỉ nói khoác thì chẳng có tác dụng gì đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100109,
						765100110
					],
					"speakerTitle": "Wislawa"
				},
				{
					"id": 765100109,
					"content": "Edler trông có vẻ mạnh hơn...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765100111
					]
				},
				{
					"id": 765100111,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100112
					],
					"speakerTitle": "Edler"
				},
				{
					"id": 765100112,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100113
					],
					"speakerTitle": "Wislawa"
				},
				{
					"id": 765100113,
					"content": "...!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765100114
					]
				},
				{
					"id": 765100114,
					"content": "Ối ối! Không phải họ chỉ so tài đôi chút thôi sao?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765100115,
					"content": "Bây giờ cô nhận thua vẫn còn kịp, tôi sẽ cho cô ba giây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100116
					],
					"speakerTitle": "Edler"
				},
				{
					"id": 765100116,
					"content": "Ba, hai, một...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100117
					],
					"speakerTitle": "Edler"
				},
				{
					"id": 765100117,
					"content": "Oái!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765100118,
					"content": "Sau tiếng \"keng\" giòn tan của kim loại, tất cả đều chìm vào tĩnh lặng...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						765100119
					]
				},
				{
					"id": 765100119,
					"content": "Được rồi, Paimon bé nhỏ, có thể mở mắt rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100120
					],
					"speakerTitle": "Edler"
				},
				{
					"id": 765100120,
					"content": "Có vẻ người căng thẳng nhất đang ở đây rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100121
					],
					"speakerTitle": "Wislawa"
				},
				{
					"id": 765100121,
					"content": "Cái, cái gì? Wislawa không ngờ lại bình an vô sự.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100122,
						765100123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765100122,
					"content": "Edler chỉ đang dọa Wislawa thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765100124
					]
				},
				{
					"id": 765100124,
					"content": "Đúng vậy, tôi cũng không muốn ra ngoài một chuyến rồi lại bị giam vào nhà lao ở đất khách quê người đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100125
					],
					"speakerTitle": "Edler"
				},
				{
					"id": 765100125,
					"content": "Đành phải giả vờ to gan, phô trương thanh thế, để cho cô ta thấy tôi không phải loại thương nhân yếu đuối có thể tùy tiện bắt nạt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100126
					],
					"speakerTitle": "Edler"
				},
				{
					"id": 765100126,
					"content": "Như vậy lần sau gặp lại, cô ta sẽ không dám tùy tiện gây rắc rối cho tôi nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100127
					],
					"speakerTitle": "Edler"
				},
				{
					"id": 765100127,
					"content": "#Nhưng mà, sao {NICKNAME} nhìn ra được vậy?! Tôi thấy {NICKNAME} hoàn toàn không căng thẳng chút nào luôn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100128,
						765100129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765100128,
					"content": "Biểu cảm của Edler trông rất thoải mái.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765100130
					]
				},
				{
					"id": 765100130,
					"content": "#{F#Cô}{M#Cậu} thật nhạy bén. Hù dọa quả thực là cách nhanh nhất khiến người ta nhận thua. Tiếc là, đi đường tắt rốt cuộc vẫn không dễ dàng như vậy đâu, bạn à.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100131
					],
					"speakerTitle": "Wislawa"
				},
				{
					"id": 765100131,
					"content": "#Huống hồ còn có {NICKNAME} ở đây... Tóm lại, bây giờ tôi vẫn đang đứng vững.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100132
					],
					"speakerTitle": "Wislawa"
				},
				{
					"id": 765100132,
					"content": "Chỉ là lần sau gặp lại, hy vọng có cơ hội...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100133
					],
					"speakerTitle": "Wislawa"
				},
				{
					"id": 765100133,
					"content": "Đừng, kẻ hèn mọn này không có nhiều cơ hội chạm mặt nhân vật tai to mặt lớn như cô đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100134
					],
					"speakerTitle": "Edler"
				},
				{
					"id": 765100134,
					"content": "Nếu lần sau gặp nhau khi cô đang làm nhiệm vụ, nếu cô tính làm gì tôi, thì tôi đành phải phòng vệ chính đáng thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100135
					],
					"speakerTitle": "Edler"
				},
				{
					"id": 765100135,
					"content": "Còn nếu gặp nhau trong kỳ nghỉ, chúng ta vẫn nên chơi Bàn Cờ Diễn Tập thì hơn, coi như ủng hộ việc làm ăn của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Edler"
				},
				{
					"id": 765100129,
					"content": "Edler nói rồi, là xem \"ai nhận thua trước\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765100130
					]
				},
				{
					"id": 765100123,
					"content": "Trong súng không có đạn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765100124
					]
				},
				{
					"id": 765100110,
					"content": "Wislawa trông có vẻ cao lớn hơn...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765100111
					]
				}
			]
		}
	]
}