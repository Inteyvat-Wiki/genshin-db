				{
					"id": 221080301,
					"content": "Bạn tiêu diệt chúng chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080302
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080302,
					"content": "Đã tiêu diệt toàn bộ rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221080303
					]
				},
				{
					"id": 221080303,
					"content": "Rất tốt, bạn làm việc cũng nhanh chóng đó, có dáng dấp của một nhà mạo hiểm rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080304
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080304,
					"content": "Đây là phần thưởng, vất vả cho bạn rồi, tiêu diệt được bọn chúng vùng đất xung quanh cũng yên lành hơn nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080305
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080305,
					"content": "Không tìm thấy món đồ nào liên quan đến \"kiếm\" sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080306
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080306,
					"content": "...Là vậy sao, không sao, vẫn nằm trọng dự tính của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080307
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080307,
					"content": "Vất vả rồi, đây là phần thưởng, cầm lấy rồi đi làm việc của bạn đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				}
			]
