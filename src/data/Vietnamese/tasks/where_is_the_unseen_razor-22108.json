			"dialogs": [
				{
					"id": 221080201,
					"content": "Bạn tiêu diệt chúng chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080202
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080202,
					"content": "Vẫn chưa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221080203
					]
				},
				{
					"id": 221080203,
					"content": "Không gấp, Nhà Mạo Hiểm mà quá nóng vội, sẽ đưa bản thân vào nguy hiểm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080204
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080204,
					"content": "Nhưng cũng đừng lười nhác, bởi vì thời gian và phần thưởng có liên quan đến nhau đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				}
			]
		},
