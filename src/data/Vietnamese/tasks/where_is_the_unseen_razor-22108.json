			"trigger": {
				"objectNames": [
					"Lan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221080101,
					"content": "Lần này không tìm thấy, dấu vết mất tiêu rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080102
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080102,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221080103
					]
				},
				{
					"id": 221080103,
					"content": "Bạn là ai? Nếu muốn tìm hiểu về Hiệp hội, bạn gặp Katheryne ở bên cạnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080104
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080104,
					"content": "Bạn đã là nhà mạo hiểm rồi sao, xin lỗi, tuy là phân hội trưởng, thế nhưng tôi lại không quan tâm đến việc của Hiệp hội.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080105
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080105,
					"content": "Vậy nên, người mới tôi cũng không biết nhiều... có điều nhìn bộ dạng của bạn, có phải là có chút kinh nghiệm mạo hiểm rồi không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080106
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080106,
					"content": "Vậy thì giúp tôi được không? Nhưng phải nói rõ trước, đây không phải là nhiệm vụ của Hiệp hội mà là ủy thác của tôi nhờ bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080107,
						221080108
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080107,
					"content": "Được thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221080109
					]
				},
				{
					"id": 221080109,
					"content": "Thật là thẳng thắn, có điều không tìm hiểu rõ tình hình đã nhận ủy thác rồi thì có chút không thông minh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080111
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080111,
					"content": "Về chuyện ủy thác, tôi muốn nhờ bạn đi tiêu diệt hai tên Hilichurl lực lưỡng cầm khiên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080112
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080112,
					"content": "Trên khiên của chúng có sức mạnh thuộc tính \"nham\", tuy không coi là nguy hiểm nhưng phải cẩn thận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080113
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080113,
					"content": "Phải chỉ cần tiêu diệt chúng. Sau đó quay lại đây tìm tôi để lấy phần thưởng xứng đáng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080114
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080114,
					"content": "Đúng rồi, nếu tìm thấy món đồ gì có liên quan đến \"kiếm\" thì mang về cho tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080115
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080115,
					"content": "Không có phát hiện gì thì cũng không sao, chỉ cần tiêu diệt Hilichurl là được, tôi sẽ cho bạn phần thưởng, yên tâm đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080108,
					"content": "Ủy thác gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221080110
					]
				},
				{
					"id": 221080110,
					"content": "Bạn thật là cẩn thận, có phải trước kia từng vấp phải khó khăn gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080111
					],
					"speakerTitle": "Lan"
				}
			]
		},
