			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yae Miko",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120310101,
					"content": "Chào hai cưng, đến rồi sao. Khá lắm, rất đúng giờ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310102
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310102,
					"content": "Hừm, vì nhuận bút nên bắt buộc phải đến thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310103,
					"content": "Miko, cụ thể phải làm thế nào để giúp mọi người thực hiện \"bách quỷ dạ hành\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310104,
					"content": "Thật ra chúng tôi còn không rõ bách quỷ dạ hành là gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310105,
					"content": "\"Bách quỷ dạ hành\" nghe có vẻ đáng sợ, nhưng nói một cách đơn giản, chính là buổi tụ họp của youkai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310106
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310106,
					"content": "Năm đó youkai cùng tụ họp, khi say rượu, chúng đã dùng yêu lực của mình để bay lên không trung, và bóng của chúng có thể che phủ cả mặt trăng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310107
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310107,
					"content": "Nhưng mà bây giờ, ký ức của youkai lại tràn ra từ địa mạch, sức mạnh rất yếu nên không thể bay lên được nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310108
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310108,
					"content": "Vì vậy, tôi sẽ làm nghi thức gọi hồn cho họ, để những ký ức rời rạc đó có thể tụ họp lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310109
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310109,
					"content": "Khi đó, họ sẽ gặp nhau trên bầu trời của Đền Narukami. Sau đó, khi sức lực của họ đã cạn kiệt, họ sẽ trở về nơi họ thuộc về trong sự hài lòng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310110
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310110,
					"content": "Hóa ra là vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310111
					]
				},
				{
					"id": 120310111,
					"content": "Thật ra mọi việc chuẩn bị cho nghi lễ đã được chuẩn bị từ lâu rồi. Còn nhớ thần chú và \"đêm không trăng\" mà tôi đã thêm vào tiểu thuyết không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310112
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310112,
					"content": "Hình như phải đọc \"pháp thuật bí truyền của tiểu thư hồ ly\" vào \"đêm không trăng\" đúng chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310113,
					"content": "Đúng rồi, những gì được viết trong đó không phải là một câu thần chú để hiện thực hóa một điều ước, mà là một câu thần chú để xoa dịu ký ức trong địa mạch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310114
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310114,
					"content": "Đến lúc đó, để mọi người tiễn đưa họ vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310115
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310115,
					"content": "Vậy tôi phải làm gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310116
					]
				},
				{
					"id": 120310116,
					"content": "Lát nữa tôi sẽ bắt đầu chuẩn bị nghi lễ, hy vọng hai người có thể giúp tôi làm hai việc:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310117
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310117,
					"content": "Trước hết là thông báo cho các pháp sư xuống núi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310118
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310118,
					"content": "Khi bách quỷ dạ hành bắt đầu, ký ức của rất nhiều youkai sẽ chiếm cứ bầu trời phía trên Đền Narukami, lỡ như ai đó không cẩn thận bị nhập thì hơi rắc rối.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310119
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310119,
					"content": "Sau đó, tôi sẽ bắt đầu nghi lễ để các ký ức hội tụ. Quá trình này sẽ tốn chút thời gian, hai người hãy đến phía dưới Núi Yougou để quan sát động tĩnh của ma vật gần đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310120
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310120,
					"content": "Mặc dù bình thường ký ức bị phân tán không có nguy hiểm gì, nhưng khi tập hợp sức mạnh, bọn ma vật cũng khó tránh khỏi bị ảnh hưởng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310121
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310121,
					"content": "Chúng có thể muốn lên núi theo bản năng, vì vậy hai người hãy phụ trách tiêu diệt chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310122
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310122,
					"content": "Hiểu rồi. Vậy sau đó thì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310123,
					"content": "Ừm, sau đó à... Nếu hai người muốn đến đền thần để giúp đỡ, tiện thể nhìn cận cảnh những youkai đó thì cũng không phải không được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310124
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310124,
					"content": "#Được, {NICKNAME}, chúng ta xuất phát thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1203102,
			"completionStepIds": [
