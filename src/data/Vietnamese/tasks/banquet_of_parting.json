					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310409
					]
				},
				{
					"id": 120310409,
					"content": "Hai người sao vậy, mau đến đây ngồi đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310410
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310410,
					"content": "Nếm thử món này xem, đây là loại cá chỉ xung quanh Đảo Seirai mới có, vận chuyển trong đêm về Thành Inazuma, vẫn còn tươi lắm đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310411
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310411,
					"content": "Hay là uống chút rượu không? Loại rượu quý thế này, bình thường tôi cũng không nỡ uống.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310412
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310412,
					"content": "Không uống được rượu cũng không sao, nước ép cũng rất nhiều, giá nào cũng có.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310413
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310413,
					"content": "Hic, Miko thật quá đáng mà!",
