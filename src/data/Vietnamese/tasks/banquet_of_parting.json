				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120310201,
					"content": "Xuống núi? Đây là lệnh của đại nhân Guuji sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310202
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 120310202,
					"content": "Đúng vậy, Miko nói sắp phải cử hành nghi thức, sẽ có ảnh hưởng đến sức khỏe của mọi người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310203,
					"content": "Thì ra là vậy... Tôi sẽ sắp xếp ngay. Các bạn thì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310204
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 120310204,
					"content": "Chúng tôi sẽ giúp cô ấy làm chút chuyện, sau đó quay lại đây, cùng cô ấy thực hiện nghi thức.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310205,
						120310206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310205,
					"content": "Bởi vì cũng có chút lo lắng cho cô ấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310207
					]
				},
				{
					"id": 120310207,
					"content": "Có vẻ như đại nhân Guuji rất tin tưởng hai người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310208
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 120310208,
					"content": "Trước đây khi thực hiện những nghi thức quan trọng như vậy, đại nhân Guuji sẽ không giữ ai lại bên cạnh cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310209
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 120310209,
					"content": "Vậy chuyện nghi thức nhờ các bạn nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310210
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 120310210,
					"content": "Yên tâm đi, chúng tôi rất mạnh luôn đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310206,
					"content": "Bởi vì muốn xem youkai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310207
					]
				}
			]
		},
		{
			"id": 1203104,
			"completionStepIds": [
				1203106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1203106",
							"2"
						],
						"stepId": 1203106,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yae Miko",
					"Paimon",
					"Okazaki Rikuto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120310401,
					"content": "Hai cưng đến rồi à.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310402
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310402,
					"content": "Miko, chúng tôi còn chưa đến mà cô đã bắt đầu ăn rồi sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310403,
					"content": "Ừm, đúng rồi, bởi vì hai người mời mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310404
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310404,
					"content": "Cứ nghĩ đến chuyện được ăn ké món mắc nhất, uống loại rượu ngon nhất là tôi đến ngay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310405
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310405,
					"content": "À, ông chủ, có thấy hai người này không? Bàn này lát nữa hai người họ tính tiền nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310406
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310406,
					"content": "Được được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310407
					],
