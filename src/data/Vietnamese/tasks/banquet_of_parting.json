						120310414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310414,
					"content": "Hôm trước ở đây gấp rút viết bản thảo, cô chỉ cho chúng tôi ăn xiên que tầm thường nhất!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310415,
					"content": "Ơ, có chuyện đó sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310416,
						120310417
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310416,
					"content": "Đúng vậy đó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310418
					]
				},
				{
					"id": 120310418,
					"content": "Ồ, vậy thì sao chứ? Lúc trước không phải hai người nói muốn mời tôi ăn cơm sao? Hơn nữa, hai người nhẫn tâm đối xử tệ bạc với khách quý như tôi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310419
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310419,
					"content": "Miko, bữa cơm này phải tốn rất nhiều rất nhiều tiền đó, cô không sợ chúng tôi không trả nổi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310420,
					"content": "Haha, đừng sợ, sẽ trả nổi mà. Lúc trước chúng ta cùng nhau viết một quyển tiểu thuyết, gần đây lại tái bản rồi, nhuận bút của hai người không ít đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310421
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310421,
					"content": "Cái, cái gì?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310422,
					"content": "#Aaaa, đáng ghét! {NICKNAME}, chúng ta bị lừa rồi! Ngay từ đầu Miko đã có ý đồ với nhuận bút của chúng ta rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310423,
						120310424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310423,
					"content": "Sơ ý rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310425
					]
				},
				{
					"id": 120310425,
					"content": "Hahahaha, biểu cảm của hai cưng bây giờ thật thú vị, hahaha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310426
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310426,
					"content": "À đúng rồi, vì không có gì xảy ra sau khi cầu nguyện trong đêm không trăng, nên bây giờ loại tiểu thuyết về thần chú không còn thịnh hành nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310427
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310427,
					"content": "Vì vậy chương mới nhất của \"Chuyến Phiêu Lưu Kỳ Thú\", hai cưng phải nghĩ ra những tình tiết hấp dẫn chút nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310428
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310428,
					"content": "Sắp đến hạn nộp bản thảo rồi, trông cậy vào hai cưng đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310424,
					"content": "Bị trúng kế rồi...",
