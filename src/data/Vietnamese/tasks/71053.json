			"dialogs": [
				{
					"id": 710501401,
					"content": "Tạm không nói chuyện khác nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501402
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710501402,
					"content": "Mấy ngày nay ở Vực Đá Sâu bạn đã làm rất nhiều việc, tôi không biết phải cám ơn bạn như thế nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501403
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710501403,
					"content": "Nếu đưa tiền cho bạn nữa, thì cũng kỳ quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501404
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710501404,
					"content": "Thật ra nếu anh nhất định muốn đưa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710501405
					]
				},
				{
					"id": 710501405,
					"content": "Thôi đừng đùa nữa, tôi làm sao có thể chỉ đưa tiền cho xong chuyện được chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501406
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710501406,
					"content": "Hành vi như thế chẳng phải là đang sỉ nhục bạn sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501407
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710501407,
					"content": "Nào, hãy nhận lấy lá thư này, nếu sau này bạn có cơ hội đến Sumeru, gặp phải phiền phức gì, hoặc có việc gì cần giúp, thì hãy cầm lấy lá thư này đi tìm người của Purbiruni!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501408
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710501408,
					"content": "Chúng tôi nhất định sẽ dốc sức giúp đỡ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501409
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710501409,
					"content": "\"Tình người qua lại, còn quý hơn vàng.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501410
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710501410,
					"content": "Câu ngạn ngữ này của Sumeru, chính là nói đến hoàn cảnh như vầy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
