					"nextDialogs": [
						207432003
					]
				},
				{
					"id": 207432003,
					"content": "Tốt quá rồi, thế này việc làm ăn của tửu trang có thể từ từ phục hồi rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207432004
					],
					"speakerTitle": "Elzer"
				},
				{
					"id": 207432004,
					"content": "Đáng ra chuyện này tôi nên báo cáo với ông chủ Diluc trước...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207432005
					],
					"speakerTitle": "Elzer"
				},
				{
					"id": 207432005,
					"content": "Nhưng hiện tại không biết ông chủ Diluc đang ở đâu, tôi đã hỏi khắp mọi người trong tửu trang, không ai biết ông chủ đã đi đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207432006
					],
					"speakerTitle": "Elzer"
				},
				{
					"id": 207432006,
					"content": "Adelinde còn nói cái gì mà \"ông chủ Diluc đi giải quyết việc riêng rồi\", ngoài ra không chịu nói thêm câu nào nữa, cũng chẳng hề tỏ ra lo lắng chút nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207432007
					],
					"speakerTitle": "Elzer"
				},
				{
					"id": 207432007,
					"content": "Haiz, thôi bỏ đi. Đợi ông chủ Diluc trở lại, tôi nhất định phải nói chuyện với ngài ấy...",
