			"dialogs": [
				{
					"id": 738020101,
					"content": "Hướng về những ngôi sao và vực sâu! Chào mừng đến với Hiệp Hội Nhà Mạo Hiểm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738020102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 738020102,
					"content": "Chào Katheryne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738020103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 738020103,
					"content": "Xin chào, Katheryne...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738020104
					]
				},
				{
					"id": 738020104,
					"content": "Chào mọi người, trạng thái hôm nay của hai bạn có vẻ rất tốt. Các bạn đến nhận ủy thác sao? Hay là đến xử lý công việc khác?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738020105
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 738020105,
					"content": "Ừm... Sao hai bạn cứ nhìn tôi chằm chằm vậy? Có chuyện gì muốn hỏi tôi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738020106,
						738020107
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 738020106,
					"content": "Không có.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738020108
					]
				},
				{
					"id": 738020108,
					"content": "Vậy à... Nhìn dáng vẻ của bạn, hẳn kinh nghiệm thám hiểm đã rất phong phú rồi nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738020109
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 738020109,
					"content": "Có thể xem là vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738020110
					]
				},
				{
					"id": 738020110,
					"content": "Vậy chắc hẳn các bạn đã biết rõ cách thức hoạt động của Hiệp Hội Nhà Mạo Hiểm rồi nên tôi sẽ không đi vào chi tiết nữa, để không làm mất thời gian của bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738020111
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 738020111,
					"content": "Nếu bạn có bất kỳ câu hỏi nào về công việc của hiệp hội, rất hoan nghênh các bạn đến tìm tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738020112
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 738020112,
					"content": "Bạn hãy hoàn thành nhiều ủy thác trong Thành Sumeru hơn nữa nhé. Một Nhà Mạo Hiểm có thực lực như bạn, nhất định sẽ giúp được cho rất nhiều người đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738020113
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 738020113,
					"content": "Hãy tiếp tục những chuyến phiêu lưu mạo hiểm nào, hướng về những ngôi sao và vực sâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 738020107,
					"content": "Chỉ, chỉ là muốn nhận ủy thác thôi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738020108
					]
				}
			]
		}
