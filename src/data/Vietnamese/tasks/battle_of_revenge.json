			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Asakura"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728040406,
					"content": "Các hạ trông rất bình tĩnh...Đám Kairagi kia đối với các hạ mà nói quả nhiên quá dễ dàng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040407
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040407,
					"content": "Xem ra bạn cũng thắng rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040408
					]
				},
				{
					"id": 728040408,
					"content": "Đúng vậy, nhưng thật hổ thẹn...Cuối cùng tên đó xuất chiêu giả, đâm tôi một nhát rồi chạy mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040409
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040409,
					"content": "Nhưng hắn bị thương rất nghiêm trọng, tôi nghĩ, trong vòng mấy năm chắc hắn sẽ không thể ra ngoài làm loạn nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040410
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040410,
					"content": "Quan trọng nhất là tôi đã tự tay đánh bại hắn, cũng đã đoạt vũ khí về, đã rửa sạch nỗi nhục.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040411
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040411,
					"content": "Chúc mừng bạn, Asakura.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040412
					]
				},
				{
					"id": 728040412,
					"content": "Thực lòng cảm ơn, nhưng tôi vẫn không thể thả lỏng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040413
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040413,
					"content": "Lý do xảy ra tất cả những chuyện này là do võ nghệ của tôi chưa đủ tốt, sau này tôi sẽ tiếp tục tu luyện chăm chỉ hơn và nâng cao võ nghệ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040414
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040414,
					"content": "Vậy nên...mong các hạ chỉ giáo, thường xuyên luyện võ cùng tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040415
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040415,
					"content": "À, phải rồi, những thứ này phiền các hạ nhận giúp. Tuy không phải là nhiều...nhưng cũng là chút tấm lòng của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040416
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040416,
					"content": "Một lần nữa cảm ơn các hạ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asakura"
				}
			]
		}
	]
}