				"points": []
			},
			"dialogs": [
				{
					"id": 728040206,
					"content": "Ái da! Hảo hán, hảo hán xin nhẹ tay! Các hạ tìm được trợ thủ này ở đâu ra vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040207
					],
					"speakerTitle": "\"Kairagi\""
				},
				{
					"id": 728040207,
					"content": "Tên ác độc! Mau trả vũ khí cho ta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040208
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040208,
					"content": "Các hạ, các hạ vẫn còn nhớ đến vũ khí đó ư...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040209
					],
					"speakerTitle": "\"Kairagi\""
				},
				{
					"id": 728040209,
					"content": "Ta chỉ muốn lấy lại vũ khí của mình, ngươi nói cho ta biết vũ khí đó ở đâu, ta tha cho ngươi một con đường sống.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040210
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040210,
					"content": "Đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040211,
						728040212
					],
					"speakerTitle": "\"Kairagi\""
				},
				{
					"id": 728040211,
					"content": "Đừng phí lời với hắn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040213
					]
				},
				{
					"id": 728040213,
					"content": "Ái ui! Hảo hán nhẹ tay! Sao phải nổi nóng như vậy, ta cũng đâu phải không chịu nói chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040214
					],
					"speakerTitle": "\"Kairagi\""
				},
				{
					"id": 728040214,
					"content": "Vũ khí đó...bị lão đại của chúng tôi giữ làm đồ sưu tầm rồi, nếu muốn lấy lại thì hãy đến doanh trại bên kia tìm lão đại là được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040215
					],
					"speakerTitle": "\"Kairagi\""
				},
				{
					"id": 728040215,
					"content": "Hừ, xem như ngươi biết điều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040216
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040216,
					"content": "Vậy hai vị hảo hán, tại hạ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040217
					],
					"speakerTitle": "\"Kairagi\""
				},
				{
					"id": 728040217,
					"content": "Biến!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040218
					]
				},
				{
					"id": 728040218,
					"content": "Vâng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040219
					],
					"speakerTitle": "\"Kairagi\""
				},
				{
					"id": 728040219,
					"content": "Võ nghệ chẳng ra làm sao, mà chạy trốn cũng khá đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040220
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040220,
					"content": "Bán đứng chiến hữu một cách quyết đoán như vậy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040221
					]
				},
				{
					"id": 728040221,
					"content": "Kairagi chung quy chỉ là một đám ô hợp vì lợi ích, chẳng thể bàn đến trung thành gì đó, cũng không thể tồn tại niềm tin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040222
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040222,
					"content": "Gặp chuyện phiền phức, phản ứng đầu tiên là vỗ mông bỏ đi, điều này thực sự quá là bình thường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040223
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040223,
					"content": "Nhưng may mà có các hạ trấn áp một bên, nếu không làm sao hắn có thể dễ dàng đầu hàng như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040224
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040224,
					"content": "Tiếp theo chúng ta còn phải xông vào đại bản doanh của Kairagi nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040225
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040225,
					"content": "Vẫn dựa theo kế hoạch trước đó, các hạ, tôi sẽ trực tiếp đi chém tên thủ lĩnh đó, đám tạp nham còn lại giao cho các hạ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040226,
						728040227
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040226,
					"content": "Cứ giao cho tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040228
					]
				},
				{
					"id": 728040228,
					"content": "Vậy thì phiền các hạ rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040227,
					"content": "Tôi một chọi mười.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040228
					]
				},
				{
					"id": 728040212,
					"content": "Chúng ta đi tra hỏi kẻ tiếp theo đi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040213
					]
				}
			]
		},
		{
			"id": 7280403,
			"completionStepIds": [
				7280405
