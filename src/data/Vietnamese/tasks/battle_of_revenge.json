			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Thủ Lĩnh \"Kairagi\""
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728040301,
					"content": "Ngươi? Ha ha ha, chẳng phải tên nhãi ranh lần trước sao? Thế nào, lại đến tặng đồ sưu tầm cho ta à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040302
					],
					"speakerTitle": "Thủ Lĩnh \"Kairagi\""
				},
				{
					"id": 728040302,
					"content": "Ta đến để lấy lại vũ khí của mình!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040303
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040303,
					"content": "Ừm...không tồi, quả là có chút khí phách. Nhưng chỉ mang theo một trợ thủ đã dám vào tận đây, ngươi cũng coi thường ta quá rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040304
					],
					"speakerTitle": "Thủ Lĩnh \"Kairagi\""
				},
				{
					"id": 728040304,
					"content": "Có điều, nể tình ngươi to gan dám tới đây, ta sẽ cho ngươi cơ hội này, tiến lên! Chúng ta qua bên cạnh đùa giỡn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040305
					],
					"speakerTitle": "Thủ Lĩnh \"Kairagi\""
				},
				{
					"id": 728040305,
					"content": "Nhưng mà... những thủ hạ này của ta, đương nhiên cũng không thể nhàn rỗi. Không phải ngươi mang theo trợ thủ sao? Vậy thì chơi đùa cùng họ đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040306,
						728040307
					],
					"speakerTitle": "Thủ Lĩnh \"Kairagi\""
				},
				{
					"id": 728040306,
					"content": "Cứ xông lên đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040308
					]
				},
				{
					"id": 728040308,
					"content": "Ha ha ha, khẩu khí lớn lắm. Lũ kia, mau...giày vò tên liều lĩnh này cho ta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040309
					],
					"speakerTitle": "Thủ Lĩnh \"Kairagi\""
				},
				{
					"id": 728040309,
					"content": "Còn ngươi, chúng ta qua bên cạnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040310
					],
					"speakerTitle": "Thủ Lĩnh \"Kairagi\""
				},
				{
					"id": 728040310,
					"content": "Vậy thì giao cho các hạ đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040311
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040311,
					"content": "Cứ giao cho tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040312
					]
				},
				{
					"id": 728040312,
					"content": "Cảm ơn rất nhiều. Tôi sẽ xử lý hắn nhanh chóng rồi quay về giúp các hạ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040313
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040313,
					"content": "Khẩu khí của ngươi cũng không nhỏ, muốn chém ta thì tự mình thử xem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Thủ Lĩnh \"Kairagi\""
				},
				{
					"id": 728040307,
					"content": "Chỉ e rằng ta chơi không đã.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040308
					]
				}
			]
		},
		{
			"id": 7280404,
			"completionStepIds": [
				7280407
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
