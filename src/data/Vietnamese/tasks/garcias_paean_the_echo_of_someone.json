			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Garcia",
					"Lutong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230170101,
					"content": "Nhà, Nhà Lữ Hành! Bạn tới đúng lúc lắm, tôi đang uống cà phê với Kaia, chuẩn bị trở về làm tiếp đây. Tôi xin giới thiệu với bạn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170102
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230170102,
					"content": "Đây là người mà anh từng nhắc tới ư? Rất vui được gặp bạn, tôi là Kaia, một... ừm... vũ công.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170104
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230170104,
					"content": "Xin chào, Garcia lúc trước từng nhắc tới cô.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230170105
					]
				},
				{
					"id": 230170105,
					"content": "Hì hì, vậy sao? Thế thì tốt quá, tôi còn tưởng anh ấy chỉ biết có máy móc của mình với Lutong thôi chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170106
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230170106,
					"content": "Có lẽ cô nên loại tôi ra đấy, tiểu thư, tôi tin rằng ngài Garcia cũng thích như thế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170107
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230170107,
					"content": "Không được, nếu không có anh, Garcia nhất định sẽ tiêu sạch đến đồng xu cuối cùng mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170108
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230170108,
					"content": "Lời này tôi không dám nhận bừa, tiểu thư, tôi tin dù thế nào đi nữa thì ngài Garcia cũng sẽ có thể kiếm được tiền cho hai ly cà phê đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170109
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230170109,
					"content": "Ba ly!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170110
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230170110,
					"content": "Tôi luôn phải cảm thán vì cách đồng tình của ngài đấy, thưa ngài Garcia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170111
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230170111,
					"content": "Nói, nói chuyện chính nào! Nhà Lữ Hành, tôi vẫn đang thu mua loại ấn mà Đạo Bảo Đoàn mang theo, nếu như bạn tìm được thì hãy bán cho tôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170112
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230170112,
					"content": "Gần đây tôi kiếm được chút ít tiền, bạn không cần lo chuyện thù lao đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				}
			]
		},
