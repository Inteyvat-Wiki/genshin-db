			},
			"dialogs": [
				{
					"id": 230175001,
					"content": "Xin chào? Ồ... Bạn muốn hỏi gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175002
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230175002,
					"content": "Sao cô lại quen biết Garcia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230175003
					]
				},
				{
					"id": 230175003,
					"content": "Hỏi thẳng như vậy sao? Đúng là phong cách làm việc của một nhà mạo hiểm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175004
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230175004,
					"content": "Tôi và Garcia quen nhau... vì anh ấy được trưởng đoàn của đoàn kịch chúng tôi mời tới tính sổ sách.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175005
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230175005,
					"content": "Hahaha, nói thật, từ đó tới giờ tôi chưa từng thấy người nào không liên quan gì tới không khí trong đoàn kịch như thế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175006
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230175006,
					"content": "Chúng tôi chơi nhạc, khiêu vũ, uống rượu, ca hát, còn anh ấy và Lutong thì chỉ im lặng ngồi bên cạnh tính toán.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175007
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230175007,
					"content": "Có một lần, tôi phát hiện anh ấy mặc một bộ đồ rất lạ, giống như bị vẽ hình thù gì đó lên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175008
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230175008,
					"content": "Tôi rất tò mò nên hỏi anh ấy mấy hình vẽ kia là cái gì, anh ấy nói đó là bản thiết kế của một cỗ máy nào đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175009
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230175009,
					"content": "Sở dĩ vẽ lên quần áo là vì có một lần anh ấy đang nói chuyện khung máy với người ta ở bên ngoài thì không tìm thấy giấy bút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175010
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230175010,
					"content": "Nên anh ấy đã dùng than vẽ lên áo của mình để nói cho người ta hiểu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175011
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230175011,
					"content": "Sau đó, chúng tôi cứ nói mãi về cái áo chưa được giặt sạch cùng với khung máy kia... Đương nhiên, chủ yếu là anh ấy nói, còn tôi thì ngồi nghe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175012
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230175012,
					"content": "Hì hì, anh ấy đúng là một người kỳ lạ, nhưng đồng thời cũng rất có sức hút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaia"
				}
			]
		},
