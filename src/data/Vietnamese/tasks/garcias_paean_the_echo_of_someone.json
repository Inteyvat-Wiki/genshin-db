			"dialogs": [
				{
					"id": 230170301,
					"content": "Ừm... Số ấn này chắc đủ để tôi thí nghiệm rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170302
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230170302,
					"content": "Đây là thù lao, xin bạn hãy nhận lấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170303
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230170303,
					"content": "Nhà Lữ Hành, ánh mắt này của bạn là có ý gì? Nhìn lăm lăm làm tôi sợ đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170304
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230170304,
					"content": "Khụ! Tôi phải đi làm việc đây...",
					"roleType": "TALK_ROLE_NPC",
