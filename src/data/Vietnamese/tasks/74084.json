			"dialogs": [
				{
					"id": 740841101,
					"content": "...Ah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841102
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841102,
					"content": "Sao lại có Melusine ở đây nhỉ? Này! Mau tránh xa con rồng đất đó đi, nguy hiểm lắm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841103,
					"content": "Melusine đưa tay ra xoa đầu rồng đất, nó chợt ngoan ngoãn cúi đầu.\\nRồng đất há miệng nhả ra một giọt nước long lanh, sau đó quay người nhảy xuống nước.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740841104
					]
				},
				{
					"id": 740841104,
					"content": "Hả? Chuyện gì thế này?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841105,
					"content": "Chìa khóa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841106
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841106,
					"content": "Chìa khóa... gì cơ? Giọt nước này là chìa khóa sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841107,
					"content": "Pahsiv.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841108
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841108,
					"content": "Hả... Giọt nước này là Pahsiv à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841109,
					"content": "Melusine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841110
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841110,
					"content": "Hả! Nghĩa là sao? Giọt nước này là Melusine à? Tôi hơi nhức đầu rồi đấy, không phải cô mới là Melusine sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841111,
					"content": "Pahsiv...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841112
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841112,
					"content": "Hừm... Cô là Pahsiv hay tên cô là Pahsiv? Tôi bị câu trả lời của cô xoay cho chóng mặt rồi đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841113,
					"content": "Tôi quyết định sẽ gọi cô là Pahsiv nhé, được chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841114,
					"content": "Melusine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841115
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841115,
					"content": "#{NICKNAME}... Sao bây giờ? Tôi chịu rồi, rốt cuộc cô ấy đang nói gì vậy...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841116,
					"content": "Cô có thể nghe hiểu lời của chúng tôi chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740841117
					]
				},
				{
					"id": 740841117,
					"content": "Pahsiv...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841118
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841118,
					"content": "Giọt nước này là chìa khóa, phải không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740841119
					]
				},
				{
					"id": 740841119,
					"content": "Pahsiv.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841120
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841120,
					"content": "Cô không phải con người, đúng không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740841121
					]
				},
				{
					"id": 740841121,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841122
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841122,
					"content": "Này... Sao lại đột nhiên mắng người ta thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841123,
					"content": "Tôi không phải con người, đúng không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740841124
					]
				},
				{
					"id": 740841124,
					"content": "Me... Melusine?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841125
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841125,
					"content": "À đợi đã, hình như tôi hiểu được chút rồi... \"Pahsiv\" là khẳng định, \"Melusine\" là phủ định. Hình như là vậy đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841126,
					"content": "Pahsiv! Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841127
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820737,
					"content": "Pahsiv! Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820738
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841127,
					"content": "Hóa ra tên cô không phải là Pahsiv... Xin lỗi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841128,
					"content": "Pahsiv... Thích...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841129
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841129,
					"content": "Cô thích cái tên này sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740841130
					]
				},
				{
					"id": 740841130,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841131
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841131,
					"content": "#Tốt quá! Thế thì cứ gọi như vậy nhé, hihi. Tôi là Paimon, đây là {NICKNAME}, rất vui được gặp cô. Cảm ơn khi nãy đã giúp chúng tôi đuổi con rồng đất đó nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841132,
					"content": "Thứ màu xanh, tốt bụng, chìa khóa, bảo vệ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841133
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841133,
					"content": "Thứ màu xanh là con rồng đất vừa nãy sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740841134
					]
				},
				{
					"id": 740841134,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841135
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841135,
					"content": "Lẽ nào nó đang giúp cô bảo vệ chìa khóa? Cô là bạn của con rồng đất đó à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841136,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841137
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841137,
					"content": "Thứ màu tím, cướp chìa khóa... Thứ màu xanh, ngất xỉu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841138
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841138,
					"content": "Thứ màu tím? Là ai vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841139,
					"content": "#Thứ màu tím, xấu xa! Thứ màu xanh, Paimon, {NICKNAME}, tốt bụng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841140
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841140,
					"content": "Ừm... Được rồi, tuy nghe hiểu là đang khen chúng tôi, nhưng cứ cảm thấy hơi kỳ kỳ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841141
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841141,
					"content": "Thứ màu tím, rất xấu, Erinnyes, Melusine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841142
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841142,
					"content": "Erinnyes Melusine? Hmm... Erinnyes phủ định?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841143
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841143,
					"content": "Đảo Erinnyes đang không ổn sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740841144
					]
				},
				{
					"id": 740841144,
					"content": "Erinnyes, Melusine, bây giờ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841145
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841145,
					"content": "Pahsiv, Erinnyes, bảo vệ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841146
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841146,
					"content": "Đảo Erinnyes đang dần không ổn, và cô muốn bảo vệ nó?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841147
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841147,
					"content": "#Paimon, {NICKNAME}, Erinnyes, ka-pow, ka-pow...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841148
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841148,
					"content": "#Hmm...? Ý là muốn {NICKNAME} và tôi đến Đảo Erinnyes để ka-pow thứ gì đó đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841149
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841149,
					"content": "Melusine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841150
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841150,
					"content": "Muốn chúng tôi giúp đỡ à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740841151
					]
				},
				{
					"id": 740841151,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841152
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841152,
					"content": "Thì ra là muốn giúp đỡ. Cũng được thôi, nhưng nếu chúng tôi ra tay trên Đảo Erinnyes thì hơi không ổn lắm. Dù gì đây cũng là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841153
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841153,
					"content": "Ka-pow, Ka-pow.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841154,
						740841158
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841154,
					"content": "Có thù lao không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740841155
					]
				},
				{
					"id": 740841158,
					"content": "Vậy phải giúp thế nào?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740841159
					]
				},
				{
					"id": 740841155,
					"content": "Thù... lao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841156
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841156,
					"content": "#Chậc, {NICKNAME}, không thấy Pahsiv không giỏi nói chuyện à? Có lẽ cô ấy không tìm được người giúp đỡ rồi, chúng ta giúp cô ấy đi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841157
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841157,
					"content": "Vậy phải giúp thế nào?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740841159
					]
				},
				{
					"id": 740841159,
					"content": "Chìa khóa, chìa khóa, chìa khóa, số lượng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841160
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841160,
					"content": "Sau đó thì sao? Số lượng chìa khóa là sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841161
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841161,
					"content": "Chìa khóa! Chìa khóa! Chìa khóa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841162
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841162,
					"content": "Ba chiếc chìa khóa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740841163
					]
				},
				{
					"id": 740841163,
					"content": "Pahsiv! Chìa khóa, đường sương, nam...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841164
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841164,
					"content": "Chìa khóa, suối, bắc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841165
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841165,
					"content": "Chìa khóa, liễu rũ, đông...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841166
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841166,
					"content": "À... Vậy là tổng cộng có ba chìa khóa chia thành các khu vực, gồm đường sương phía nam, suối phía bắc, và liễu rũ phía đông... Phải vậy không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841167
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841167,
					"content": "Chìa khóa, chìa khóa, chìa khóa, quảng trường, tây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841168
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841168,
					"content": "Quảng trường phía tây còn có ba chìa khóa nữa sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841169
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841169,
					"content": "Thu thập ba chiếc chìa khóa và đến quảng trường?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740841170
					]
				},
				{
					"id": 740841170,
					"content": "#Paimon, Melusine! {NICKNAME}, Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841171
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841171,
					"content": "#Nào Pahsiv, đừng nói những lời như kiểu {NICKNAME} thông minh hơn tôi vậy chứ! Chúng tôi thông minh ngang nhau mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841172
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841172,
					"content": "Nói tóm lại, giờ chúng ta đã có một chìa khóa rồi, chỉ cần lấy được hai chìa khóa còn lại nữa là xong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841173
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841173,
					"content": "Erinnyes, Melusine... Pahsiv, bảo vệ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841174
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841174,
					"content": "Yên tâm đi. Tuy không biết đã xảy ra chuyện gì, nhưng chúng tôi sẽ giúp cô bảo vệ Đảo Erinnyes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841175
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841175,
					"content": "Nhưng tôi muốn bổ sung một điều. Nếu Pahsiv vô tình nhìn thấy một thứ đồ tròn trịa, vàng lấp lánh mà không ai cần, hoặc là một chiếc rương nào đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841176
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841176,
					"content": "...Thì hãy nói cho chúng tôi biết nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841177
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841177,
					"content": "Pahsiv gãi đầu bối rối, rồi lại vui vẻ nhảy tung tăng, sau đó vội vã đi mất.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740841178
					]
				},
				{
					"id": 740841178,
					"content": "#Chạy luôn rồi. Chắc cô ấy có chuyện gấp. {NICKNAME}, giờ chúng ta đi tìm hai chiếc chìa khóa còn lại nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
