			"dialogs": [
				{
					"id": 740840801,
					"content": "...Melusine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840802
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740840802,
					"content": "Pahsiv, sao cô lại ở đây? Mau tránh xa con rồng đất đó đi, nguy hiểm lắm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740840803,
					"content": "Paimon tốt bụng, Pahsiv! Nguy hiểm, Melusine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840804
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740840804,
					"content": "Pahsiv đưa tay xoa đầu rồng đất, nó chợt ngoan ngoãn cúi đầu.\\nRồng đất há miệng nhả ra một giọt nước long lanh, sau đó quay người nhảy xuống nước.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740840805
					]
				},
				{
					"id": 740840805,
					"content": "Là chìa khóa! Không ngờ chìa khóa lại được giấu trong miệng rồng đất! Hơn nữa, nó còn chủ động giao chìa khóa ra nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740840806,
					"content": "Thứ màu xanh, tốt bụng, chìa khóa, bảo vệ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840807
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740840807,
					"content": "Thứ màu xanh là con rồng đất vừa nãy sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740840808
					]
				},
				{
					"id": 740840808,
					"content": "Pahsiv là bạn của con rồng đất đó à? Nó đang giúp cô bảo vệ chìa khóa sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740840809,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840810
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740840810,
					"content": "Thứ màu tím, cướp chìa khóa... Thứ màu xanh, ngất xỉu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840811
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740840811,
					"content": "Thứ màu tím? Là ai vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740840812,
					"content": "#Thứ màu tím, xấu xa... Thứ màu xanh, Paimon, {NICKNAME}, tốt bụng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840813
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740840813,
					"content": "Ừm... Được rồi, tuy nghe hiểu là đang khen chúng tôi, nhưng cứ cảm thấy hơi kỳ kỳ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840814
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740840814,
					"content": "Thứ màu tím, rất xấu, Erinnyes, rất Melusine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840815
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740840815,
					"content": "Cô đang muốn nói là kẻ làm hại hòn đảo này chính là thứ màu tím đó phải không? Cũng may chìa khóa đang nằm trong tay chúng ta rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840816
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740840816,
					"content": "#Paimon, {NICKNAME}, Pahsiv! Nhưng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840817
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740840817,
					"content": "Chìa khóa, chìa khóa, chìa khóa, quảng trường, phía tây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840818
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740840818,
					"content": "Hiểu rồi, Pahsiv đừng vội. Giờ chúng tôi đến quảng trường phía tây ngay đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
