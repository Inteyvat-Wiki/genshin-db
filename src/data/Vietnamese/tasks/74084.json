			"dialogs": [
				{
					"id": 740840605,
					"content": "Mau nhìn kìa! Có con rồng đất bên cạnh tế đàn! Nó đang ngủ à? Chúng ta phải cẩn thận chút...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840601
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740840601,
					"content": "Hửm? Ở đây sao lại không có chìa khóa? Chẳng lẽ tế đàn đã bị kích hoạt từ trước rồi sao? Hay ai đã lấy chìa khóa đi rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740840602,
					"content": "Grào!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840603
					],
					"speakerTitle": "Rồng Đất Say Ngủ"
				},
				{
					"id": 740840603,
					"content": "Không hay rồi! Con rồng kia thức tỉnh rồi! Chạy mau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740840604,
					"content": "Rồng đất cạnh tế đàn loạng choạng thức tỉnh, hai mắt ánh lên vẻ phẫn nộ và hung ác...\\nHai bạn vội vã bơi vào bờ... Nhưng nó cũng tức tốc đuổi theo...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
