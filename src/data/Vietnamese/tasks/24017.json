					"Yves"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240170401,
					"content": "Đúng vậy, đây chính là những thứ chúng ta mất cả ngày để vớt, toàn là phế liệu rác rưởi. Đúng là tên bủn xỉn ăn rác...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170402
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170402,
					"content": "Cảm ơn bạn đã giúp đỡ, số tiền này là tiền lương tôi ứng trước từ Goldman, mong bạn hãy nhận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170403
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170403,
					"content": "Tôi không thể nhận số tiền này.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170404
					]
				},
				{
					"id": 240170404,
					"content": "Nhất định phải nhận, đây chính là thù lao bạn đã vất vả làm việc! Số tiền này không thuộc về tôi nữa, nếu bạn không nhận, tôi sẽ để nó chìm xuống nước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170405
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170405,
					"content": "Thôi được...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170406
					]
				},
				{
					"id": 240170406,
					"content": "Vậy tốt rồi, nếu sau này bạn muốn vớt đồ gì thì cứ tới tìm tôi. Dù là món đồ đó ở đâu chăng nữa tôi cũng sẽ vớt lên hết!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170407
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170407,
					"content": "Tôi đi vá đồ lặn tiếp đây. Haiz, lỗ thủng này lớn quá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yves"
				}
			]
		},
		{
