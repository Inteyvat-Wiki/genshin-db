			"trigger": {
				"objectNames": [
					"Yves"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240170101,
					"content": "Phù... Thật là xui xẻo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170102,
						240170103
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170102,
					"content": "Anh là thợ lặn à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170104
					]
				},
				{
					"id": 240170104,
					"content": "Đúng vậy, thì tôi đang mặc đồ lặn mà? Bạn cần tôi giúp gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170105
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170105,
					"content": "Mà nếu đúng thì xui cho bạn rồi... tạm thời tôi không thể lặn được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170106
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170106,
					"content": "Tình hình dưới nước của khu vực này quá phức tạp. Ở dưới sâu, ngoài dòng nước ngầm hỗn loạn, còn có cả đống rác và tảo biển cuốn chân tôi nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170107
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170107,
					"content": "Khi nãy hơi sơ ý đã bị ống kim loại chọc vào chân, bộ đồ lặn liền bị rò rỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170108
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170108,
					"content": "Cũng may lúc đó gần mặt nước, tôi bơi hết sức mới lên được bờ. Chỉ có bộ đồ thủng một lỗ, còn chân thì không sao... Tôi không có thừa tiền để đi bác sĩ đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170109
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170109,
					"content": "Nhưng chắc chắn tôi sẽ không thể hoàn thành việc mà Goldman giao phó. Không chừng còn phải đền cho tên keo kiệt này một khoản lớn, thật là xui xẻo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170110,
						240170112
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170110,
					"content": "Bản thân không sao là tốt rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170111
					]
				},
				{
					"id": 240170111,
					"content": "Bạn thật biết cách an ủi người khác. Nhưng nói vậy cũng đúng, tôi bây giờ ngoài tấm thân nguyên vẹn này ra thì đâu còn gì khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170116
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170116,
					"content": "Haiz, tôi không thể giúp gì cho bạn rồi. Tôi phải mau chóng vá lại lỗ thủng trên đồ lặn để tiếp tục vớt phế liệu cho Goldman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170117,
						240170118
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170117,
					"content": "Tôi có thể giúp anh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170119
					]
				},
				{
					"id": 240170119,
					"content": "Cảm ơn ý tốt của bạn. Nhưng lặn thì không phải ai cũng làm được. Hơn nữa, tôi cũng không có tiền để trả bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170120,
						240170121
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170120,
					"content": "Tôi biết lặn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170122
					]
				},
				{
					"id": 240170122,
					"content": "#...Haiz, được rồi, lỗ thủng lớn quá, tôi không thể vá ngay được. Đành nhờ cả vào bạn rồi, {M#quý ngài}{F#quý cô} tốt bụng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170127
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170127,
					"content": "Bạn tốt bụng như vậy, chắc có nhiều bạn bè lắm nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170123
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170123,
					"content": "Mỗi lần vớt đồ cho tên Goldman này đều như cực hình. Những món đồ cần vớt, hoặc bị chìm ở nơi sâu nhất, hoặc bị chôn dưới đất...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170128
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170128,
					"content": "Tôi sẽ đánh dấu từng cái cho bạn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170124
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170124,
					"content": "Được rồi, địa điểm tôi đã đánh dấu xong, trông cậy vào bạn rồi. Đồ lặn thủng một lỗ lớn thế này... không biết phải đền bao nhiêu cho đủ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170121,
					"content": "Yên tâm, tôi lo được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170122
					]
				},
				{
					"id": 240170118,
					"content": "Hay là... để tôi giúp anh vớt đồ nhé?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170119
					]
				},
				{
					"id": 240170112,
					"content": "Goldman là...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170113
					]
				},
				{
					"id": 240170113,
					"content": "Hắn ta à, hừm... Goldman là chủ của tôi, người đã thuê một đám bất tài vô dụng, lao động tay chân để mưu sinh giống như tôi về làm việc cho hắn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170114
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170114,
					"content": "Cái tên trong đầu chỉ có Fonta này vừa hà khắc vừa bủn xỉn! Hắn yêu cầu chúng tôi phải tuân theo một đống nguyên tắc công việc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170125
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170125,
					"content": "Hơn nữa, đồ lặn dùng để làm việc cũng là hắn cho chúng tôi \"thuê\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170115
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170115,
					"content": "Chỉ cần phạm phải bất kỳ quy định nào, hoặc làm hư hại đồ lặn, chúng tôi sẽ phải bồi thường một khoản cho hắn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170126
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170126,
					"content": "Nói cách khác, nếu tôi lỡ bất cẩn, không những phải đền một khoản cho tên keo kiệt đó mà còn phải cầu xin hắn tiếp tục thuê mình! Hừ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170116
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170103,
					"content": "Anh vừa lặn sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170104
					]
				}
			]
		},
		{
