					"Yves"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240170201,
					"content": "Tên tham lam vô độ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170203
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170203,
					"content": "Đồ lặn của anh sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170204
					]
				},
				{
					"id": 240170204,
					"content": "Là bạn à! Gặp được bạn đúng là chuyện tốt nhất trong ngày.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170205
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170205,
					"content": "Chắc bạn không biết, Goldman lại nghĩ ra cách thức mới để hành hạ chúng tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170206
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170206,
					"content": "Hắn mời về một người rất giỏi tính toán, tính ra được mỗi người chúng tôi có thể vớt được bao nhiêu đồ một ngày.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170222
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170222,
					"content": "Sau đó hắn dựa vào \"kết quả tính toán\", ép chúng tôi mỗi ngày đều phải vớt được nhiều như vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170207
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170207,
					"content": "Chúng tôi cũng mệt mỏi chứ, thỉnh thoảng lại bị thương, hoặc đói bụng, kiệt sức, không thể ngày nào cũng vớt được nhiều đồ như vậy... Nhưng Goldman không quan tâm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170223
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170223,
					"content": "Chỉ cần chúng tôi vớt không đủ là hắn sẽ mắng chửi và phạt tiền!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170208
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170208,
					"content": "Đây không phải lỗi của người tính toán, vị đó tên là Finnegan, là một người tốt bụng, giàu lòng cảm thông.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170209
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170209,
					"content": "Những lúc anh ấy tính toán đều hỏi chúng tôi công việc cụ thể hằng ngày. Có một hôm, vừa nghe dứt lời là anh ấy cũng tính xong...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170224
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170224,
					"content": "Anh ấy đột nhiên đứng dậy, lao vào phòng của Goldman, hét vào mặt hắn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170210
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170210,
					"content": "\"...Chuyện này không hợp lý, họ là người chứ không phải máy!\"... Tôi chỉ nghe được câu này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170211
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170211,
					"content": "...Sau đó, anh ấy đã bị thuộc hạ của Goldman ném ra ngoài, ngã xuống hố nước. Chúng tôi đã đỡ anh ấy lên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170212
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170212,
					"content": "Sau đó anh ấy mở lời xin lỗi, còn ngậm ngùi rơi nước mắt. Chúng tôi không hề oán trách, người đó cũng chỉ như chúng tôi, đều là nạn nhân của Goldman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170213
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170213,
					"content": "Anh ấy hứa nhất định sẽ nghĩ cách để tìm lại công bằng cho mọi người... Nhưng chúng tôi đều hy vọng anh ấy sẽ không quay lại vũng bùn ấy nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170214,
						240170215
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170214,
					"content": "Vậy hôm nay anh còn phải làm bao lâu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170216
					]
				},
				{
					"id": 240170216,
					"content": "Nhiều lắm, không biết khi nào mới xong, đành phải cố gắng làm thêm, hy vọng có thể giảm chút tiền đền bù... Tôi chỉ có thể tìm ai đó để hỏi mượn bộ đồ lặn để kiếm sống thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170217,
						240170218
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170217,
					"content": "Để tôi giúp anh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170219
					]
				},
				{
					"id": 240170219,
					"content": "Thật sao? Bạn đồng ý giúp tôi tiếp sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170220
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170220,
					"content": "Bạn thực sự là vị cứu tinh của tôi, nếu như Goldman tốt bằng một nửa bạn thì... Ừm, xin lỗi, tôi không nên so sánh bạn với con heo đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170221
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170221,
					"content": "Vậy, giống như lần trước, tôi sẽ đánh dấu vị trí, chúng ta chia nhau xuất phát thôi. Haiz, tôi tuyệt đối không được để bộ đồ lặn này bị hỏng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170218,
					"content": "Để tôi gánh bớt cho.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170219
					]
				},
				{
					"id": 240170215,
					"content": "Hôm nay còn nhiều việc không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170216
					]
				}
			]
