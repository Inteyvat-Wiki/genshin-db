					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728011403,
					"content": "Chờ khi tôi viết xong toàn bộ, tôi sẽ nhờ người đem \"Du Ký\" hoàn chỉnh cho cô bé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011404
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728011404,
					"content": "\"Du Ký\"...Hừ, miệng thì nói vậy, chưa biết chừng còn có mục đích gì khác...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011405
					],
					"speakerTitle": "Heihachi"
				},
				{
					"id": 728011405,
					"content": "Anh đang nói gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728011406
					]
				},
				{
					"id": 728011406,
					"content": "Tôi nói là, thứ gọi là \"Du Ký\" của tên này là có mục đích khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011407
					],
					"speakerTitle": "Heihachi"
				},
				{
					"id": 728011407,
					"content": "Ai lại tự dưng nghĩ ra mấy thứ vớ vẩn như thế, còn dùng khinh khí cầu đi vòng quanh Teyvat, hơn nữa lại không dùng Vision...",
