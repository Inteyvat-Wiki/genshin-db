				"points": []
			},
			"dialogs": [
				{
					"id": 728010201,
					"content": "Vị khách này, hôm nay bạn đến \"Phòng Trà Komore\" có chuyện gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010202
					],
					"speakerTitle": "Kozue"
				},
				{
					"id": 728010202,
					"content": "Về Ramsay...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728010203
					]
				},
				{
					"id": 728010203,
					"content": "Thương nhân đó à...anh ấy đúng là đang ở trong phòng trà, nhưng dạo này hình như trông anh ấy có chút lo lắng, không biết đã gặp phải chuyện gì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010204
					],
					"speakerTitle": "Kozue"
				},
				{
					"id": 728010204,
					"content": "Nếu bạn muốn tìm anh ấy, thì cứ vào bên trong là nhìn thấy anh ấy thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kozue"
				}
			]
		},
		{
			"id": 7280103,
			"completionStepIds": [
				7280103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7280103",
							"2"
						],
						"stepId": 7280103,
						"stateName": "QUEST_STATE_UNFINISHED"
