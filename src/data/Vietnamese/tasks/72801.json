			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ramsay"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728010301,
					"content": "Bạn là...Nhà Lữ Hành? Tìm tôi có việc gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010302
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010302,
					"content": "Về \"Du Ký\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728010303
					]
				},
				{
					"id": 728010303,
					"content": "À, bạn đang nói về \"Du Ký\" mà tôi viết cho đứa bé tên Midori đúng không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010304
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010304,
					"content": "Thật là...dạo này tôi quả thực không có thời gian rảnh để viết, chắc đứa bé đó sốt ruột lắm rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010305
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010305,
					"content": "Những thứ trong \"Du Ký\" đó là thật sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728010306
					]
				},
				{
					"id": 728010306,
					"content": "Ha ha ha, đoán xem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010307,
						728010309
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010307,
					"content": "Không giống thật lắm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728010308
					]
				},
				{
					"id": 728010308,
					"content": "Ha ha ha, không hổ danh là người từng chu du khắp nơi, vừa nhìn là đã biết rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010311
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010311,
					"content": "Chính xác, nghiêm túc mà nói, những thứ trong \"Du Ký\" đều không phải là thật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010312
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010312,
					"content": "Tuy có những địa điểm và nhân vật lấy cảm hứng từ hiện thực...nhưng hầu hết nội dung đều xuất phát từ trí tưởng tượng của cá nhân tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010313
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010313,
					"content": "Đương nhiên rồi, có những nội dung cũng không phải hoàn toàn là tưởng tượng. Ví dụ như trong quyển \"Du Ký\" mà tôi đang viết, có một người đã chế tạo ra Khí Cầu Siêu Cấp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010314
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010314,
					"content": "Sau đó anh ta tập hợp vài người bạn, muốn dùng khí cầu này để đi vòng quanh đại lục Teyvat trong 80 ngày.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010315
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010315,
					"content": "Hơn nữa, hoàn toàn không cần Vision để điều khiển khí cầu này, chỉ cần có kiến thức về kỹ thuật là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010316
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010316,
					"content": "Nhóm người này dùng khí cầu để đi vòng quanh thế giới, trên đường gặp phải vô số sự vật và hiện tượng kỳ lạ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010317
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010317,
					"content": "Quyển này vốn dĩ tôi định chuẩn bị viết cho Midori, nhưng vì...một số nguyên nhân, đến bây giờ tôi vẫn chưa có cơ hội hoàn thành dù chỉ là một đoạn ngắn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010318
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010318,
					"content": "Nguyên nhân gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728010319
					]
				},
				{
					"id": 728010319,
					"content": "Bạn nhìn thấy cái tên đứng ở hành lang không? Anh ta tên là Heihachi, không biết bắt đầu từ bao giờ anh ta cứ nhìn tôi chằm chằm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010320
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010320,
					"content": "Tôi định ra ngoài lấy cảm hứng, tìm đề tài cho quyển Du Ký kia, nhưng tên đó lần nào cũng đi theo tôi, không biết muốn làm gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010321
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010321,
					"content": "Vì lo rằng tên này có mưu đồ bất chính với tôi, tôi cũng không dám ra ngoài tìm tư liệu, quyển Du Ký này cũng đành phải gác lại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010322
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010322,
					"content": "Nhưng cũng may bây giờ bạn đến rồi, Nhà Lữ Hành, bạn có thể cùng tôi ra ngoài tìm tư liệu không? Có bạn đi cùng thì tên đó cũng không dám làm gì tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010323,
						728010325
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010323,
					"content": "Cứ giao cho tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728010324
					]
				},
				{
					"id": 728010324,
					"content": "Vậy phiền bạn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010327
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010327,
					"content": "Hơn nữa dân gian có câu \"Cẩn thận vẫn hơn\", có một kẻ cứ nhìn chằm chằm đằng sau mình, dù hắn có ý định gì đi nữa thì cũng phải cảnh giác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010328
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010328,
					"content": "Cho nên khi tôi đang thu thập tư liệu, phiền bạn bảo vệ tôi nhé, Nhà Lữ Hành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010329
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010329,
					"content": "Thật ra trước đó tôi đã định sẵn vài địa điểm để tìm cảm hứng rồi, chúng ta tới thẳng đó là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010330
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010330,
					"content": "Địa điểm đầu tiên là bờ biển ở gần đây, chúng ta xuất phát thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010325,
					"content": "Tại sao phải làm vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728010326
					]
				},
				{
					"id": 728010326,
					"content": "Tôi không biết. Nhưng...nảy sinh ác ý với người nào đó cũng không cần phải có lý do gì đặc biệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010327
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010309,
					"content": "Tôi hy vọng đó là thật.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728010310
					]
				},
				{
					"id": 728010310,
					"content": "Ha ha ha, tôi cũng hy vọng những thứ tôi viết có thể trở thành sự thật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010311
					],
					"speakerTitle": "Ramsay"
				}
			]
		},
