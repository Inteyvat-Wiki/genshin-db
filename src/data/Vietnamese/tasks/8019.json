			"dialogs": [
				{
					"id": 80190501,
					"content": "Chính là dưới cái cây này sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190502,
					"content": "Ừm, trông có vẻ bình thường, nhưng đối với tôi mà nói thì lại là nơi tràn ngập hồi ức...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190503
					],
					"speakerTitle": "Atossa"
				},
				{
					"id": 80190503,
					"content": "Chúng tôi từng ngồi dưới gốc cây này nói chuyện, ngắm nhìn những đám mây trên bầu trời, cảm nhận hướng gió... Thời gian cứ thế trôi qua.",
