			"dialogs": [
				{
					"id": 80190101,
					"content": "Ồ? Hai vị đến rồi sao, tôi có một ủy thác mà chỉ có hai vị mới có thể làm được đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 80190102,
					"content": "Phải là chúng tôi mới có thể làm được sao? Hmm... Vậy ủy thác này chắc cũng phải cỡ cấp độ Ma Thần rồi nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190103,
						80190104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190103,
					"content": "Lần đầu tiên tôi nghe nói đến loại ủy thác này đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190105
					]
				},
				{
					"id": 80190105,
					"content": "Haha... Ủy thác của Hiệp Hội Nhà Mạo Hiểm không có cấp độ này đâu, và ủy thác lần này cũng không quy mô như hai vị nghĩ đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190106
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 80190106,
					"content": "Thực ra đó chỉ là một ủy thác tìm người thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190107
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 80190107,
					"content": "Hả? Vậy tại sao lại nói... Chỉ có chúng tôi mới có thể làm được chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190108,
					"content": "Dạo trước, khi tôi đang kiểm kê danh sách các ủy thác tồn đọng thì vô tình thấy được nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190109
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 80190109,
					"content": "Trông có vẻ bình thường, nhưng lại có hơn mười lần ủy thác thất bại liên tục rồi, trong đó còn có một số nhà mạo hiểm danh tiếng nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190110
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 80190110,
					"content": "Vì vậy, dưới góc độ danh tiếng của Hiệp Hội Nhà Mạo Hiểm và thành tích của phân hội tại Sumeru, tôi hy vọng có thể giao ủy thác này cho nhà mạo hiểm có tỉ lệ hoàn thành nhiệm vụ cao nhất trong nhiều năm trở lại đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190111
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 80190111,
					"content": "...Vậy thì đương nhiên là chúng tôi rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190112,
						80190113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190112,
					"content": "Paimon dễ dụ thật đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190114
					]
				},
				{
					"id": 80190114,
					"content": "Haha, hy vọng hai vị có thể thử sức xem sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190115
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 80190115,
					"content": "Nếu cả hai vị cũng không làm được, vậy thì tôi sẽ liên hệ với người ủy thác để bàn bạc về chuyện hủy bỏ nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190116
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 80190116,
					"content": "Vậy cô mau nói đi, ủy thác này rốt cuộc cần tìm ai, khó khăn ở đâu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190117,
					"content": "Ủy thác tìm người này là của các thôn dân ở Làng Vimara, họ nói rằng có một thôn dân đã mất tích...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190118
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 80190118,
					"content": "Nhưng mà... Họ thậm chí còn không biết tên của người đó là gì, chỉ nhớ đại khái về dáng vẻ và đặc điểm của người đó thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190119
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 80190119,
					"content": "Hả? Đều là người trong cùng một làng mà, ngay cả tên cũng không biết sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190120,
					"content": "Hơn nữa, nhiều nhà mạo hiểm thất bại như vậy, có khi nào không hề có người này không? Hoặc có thể nói là... trò đùa gì đó thì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190121,
					"content": "Khả năng này rất thấp. Có rất nhiều thôn dân đến đây gửi ủy thác. Nhìn vẻ mặt và giọng điệu của họ đều rất nghiêm túc, không giống như đang đùa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190122
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 80190122,
					"content": "Hơn nữa, việc gửi ủy thác cũng phải trả Mora để làm phí thủ tục, nên trò đùa này đối với họ cũng chẳng có lợi ích gì cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190123
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 80190123,
					"content": "Đúng là có chút kỳ lạ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190124
					]
				},
				{
					"id": 80190124,
					"content": "Tóm lại, hai vị có thể đến Làng Vimara hỏi thử nhé. Mặc dù tôi cũng có một số tài liệu ở đây, nhưng vẫn nên lấy thông tin trực tiếp từ phía thôn dân thì sẽ hợp lý hơn, tránh việc xảy ra sai sót.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190125
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 80190125,
					"content": "#Ừm, vậy thì đi thôi {NICKNAME}, tôi cũng bắt đầu thấy tò mò rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190113,
					"content": "Tôi cũng không đảm bảo là sẽ hoàn thành đâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190114
					]
				},
				{
					"id": 80190104,
					"content": "Cứ giao cho tôi, phải đối phó với Ma Thần nào đây?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190105
					]
				}
			]
		},
