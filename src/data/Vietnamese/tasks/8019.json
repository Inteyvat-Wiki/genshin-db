					"nextDialogs": [
						80190504
					],
					"speakerTitle": "Atossa"
				},
				{
					"id": 80190504,
					"content": "Tôi là đứa trẻ được nhân viên kiểm lâm phát hiện ra trong rừng, sau đó được Làng Vimara nhận nuôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190505
					],
					"speakerTitle": "Atossa"
				},
				{
					"id": 80190505,
					"content": "Mặc dù mọi người đối xử tốt với tôi, mỗi ngày trôi qua đều rất vui, nhưng tôi trước đây luôn cảm thấy cô đơn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190506
					],
					"speakerTitle": "Atossa"
				},
				{
					"id": 80190506,
					"content": "Cô đơn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190507,
					"content": "Hmm... Nói sao nhỉ, có những chuyện trong lòng dù là vui hay buồn thì tôi luôn không biết phải chia sẻ với ai, hoặc có thể nói là không biết có nên mở lời hay không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190508
					],
					"speakerTitle": "Atossa"
				},
				{
					"id": 80190508,
					"content": "Mọi người đều có cuộc sống riêng của mình, đôi khi mở lòng ra sẽ chỉ mang đến phiền phức cho người khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190509,
						80190510
					],
					"speakerTitle": "Atossa"
				},
				{
					"id": 80190509,
					"content": "Tôi đại khái hiểu được cảm giác này.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190511
					]
				},
				{
					"id": 80190511,
					"content": "#Hửm? {F#Cô}{M#Cậu} cũng cảm thấy vậy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190512,
						80190513
					],
					"speakerTitle": "Atossa"
				},
				{
					"id": 80190512,
					"content": "Tôi từng có một người thân luôn sẵn lòng lắng nghe mình...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190514
					]
				},
				{
					"id": 80190514,
					"content": "Hihi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190515,
					"content": "Vậy thì tốt quá, thật là đáng ngưỡng mộ... Với tôi mà nói thì anh ấy vừa giống như người thân, vừa giống như một người bạn có thể hiểu tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190516
					],
					"speakerTitle": "Atossa"
				},
				{
					"id": 80190516,
					"content": "Bất kể tôi gặp chuyện gì thì tôi cũng đều có thể kể cho anh ấy nghe mà không ngại ngần gì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190517
					],
					"speakerTitle": "Atossa"
				},
				{
					"id": 80190517,
					"content": "Anh ấy trong sáng một cách thuần khiết và rất tinh tế. Cảm xúc trên khuôn mặt luôn tràn đầy kiên nhẫn và hứng thú, cứ như đang được nghe câu chuyện về chính bản thân mình vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190518
					],
					"speakerTitle": "Atossa"
				},
				{
					"id": 80190518,
					"content": "Từ sau khi anh ấy biến mất, tôi thực sự có rất nhiều điều muốn nói với anh ấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190519
					],
					"speakerTitle": "Atossa"
				},
				{
					"id": 80190519,
					"content": "À không, những chuyện đó cũng không còn quan trọng nữa, chỉ cần gặp lại anh ấy là được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190520
					],
					"speakerTitle": "Atossa"
				},
				{
					"id": 80190520,
					"content": "Mối quan hệ của hai người thật sự rất tốt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190521
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190521,
					"content": "Trong ấn tượng của cô, anh ấy có nói gì về bản thân không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190522
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190522,
					"content": "Hmm... Đại khái thì anh ấy kể về những chuyện thú vị mà bản thân từng chứng kiến được trong Làng Vimara, và đủ thứ suy nghĩ táo bạo của anh ấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190523
					],
					"speakerTitle": "Atossa"
				},
				{
					"id": 80190523,
					"content": "À đúng rồi, có một lần tôi hỏi anh ấy rằng cha mẹ anh ở đâu... Nhưng anh ấy chỉ trả lời tôi rằng \"họ không còn ở đây nữa\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190524
					],
					"speakerTitle": "Atossa"
				},
				{
					"id": 80190524,
					"content": "Tôi cũng không dám hỏi thêm, vậy thì rốt cuộc là đã rời đi hay là không còn trên đời nữa nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190525
					],
					"speakerTitle": "Atossa"
				},
				{
					"id": 80190525,
					"content": "Vẫn không có manh mối gì sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190526
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190526,
					"content": "Trò chuyện nhiều như vậy nhưng vẫn không giúp được gì, thực sự xin lỗi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190527,
						80190528
					],
					"speakerTitle": "Atossa"
				},
				{
					"id": 80190527,
					"content": "Đừng nói vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190529
					]
				},
				{
					"id": 80190529,
					"content": "Lần gần nhất tôi nói một mạch nhiều như vậy, cũng là lúc ở cạnh anh ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190530
					],
					"speakerTitle": "Atossa"
				},
				{
					"id": 80190530,
					"content": "Kể ra thì, mỗi lần trò chuyện với anh ấy cũng đều là thời điểm hoàng hôn như này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190531
					],
					"speakerTitle": "Atossa"
				},
				{
					"id": 80190531,
					"content": "Trong ký ức thì thời gian sẽ trôi rất chậm, đôi khi cảm thấy rõ ràng là đã nói rất lâu, vậy mà trời vẫn chưa tối đi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190532
					],
					"speakerTitle": "Atossa"
				},
				{
					"id": 80190532,
					"content": "#Hình như sau khi tâm trạng thư thả thì thời gian sẽ trôi chậm lại nhỉ... Ủa, sao vậy, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190533,
						80190534
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190533,
					"content": "Mỗi lần đều vào cùng một thời điểm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190535
					]
				},
				{
					"id": 80190535,
					"content": "(Thu thập thông tin đến đây thì cảm giác hoàn toàn không thể xử lý như một ủy thác tìm người thông thường rồi...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190536
					]
				},
				{
					"id": 80190536,
					"content": "(Ngược lại, theo như Atossa vừa nói thì mấu chốt về vấn đề thời gian có lẽ chính là bước ngoặt để giải đáp bí ẩn...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190537
					]
				},
				{
					"id": 80190537,
					"content": "#...Này {NICKNAME}, đám Hilichurl bên đó hình như trông hơi kỳ lạ nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190538
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190538,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190539
					]
				},
				{
					"id": 80190539,
					"content": "Hửm, Giáo Đoàn Vực Sâu? Lẽ nào là do bọn chúng giở trò sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190540
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190540,
					"content": "#Nó phát hiện ra chúng ta rồi kìa! {NICKNAME}, mau nghênh chiến đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190534,
					"content": "Thời gian như ngừng lại...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190535
					]
				},
				{
					"id": 80190528,
					"content": "Ít ra thì chúng tôi cũng đã hiểu anh ấy hơn rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190529
					]
				},
				{
					"id": 80190513,
					"content": "Có điều, giờ thì tôi cũng đã có thêm nhiều bạn bè thấu hiểu mình.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190514
					]
				},
				{
					"id": 80190510,
					"content": "Đây chính là lý do mà \"người thân\" tồn tại.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190511
					]
				}
			]
		},
