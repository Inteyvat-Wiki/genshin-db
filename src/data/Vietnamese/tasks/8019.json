			},
			"dialogs": [
				{
					"id": 80190701,
					"content": "Cảm ơn hai vị! Không ngờ ở đây cũng xuất hiện ma vật. Nếu không có hai vị thì đúng là phiền phức đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190702
					],
					"speakerTitle": "Atossa"
				},
				{
					"id": 80190702,
					"content": "Chuyện nhỏ thôi mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190703,
						80190704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190703,
					"content": "Điểm mấu chốt của vấn đề là...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190705
					]
				},
				{
					"id": 80190705,
					"content": "Kể ra thì dạo này Hilichurl ở gần Làng Vimara hoạt động sôi nổi hơn trước rất nhiều...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190706
					],
					"speakerTitle": "Atossa"
				},
				{
					"id": 80190706,
					"content": "Chúng thường tỏ ra bồn chồn bất an, đôi khi còn tấn công không phân biệt mục tiêu. Trưởng làng đã không cho bọn trẻ chơi ở xung quanh Làng Vimara nữa rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190707
					],
					"speakerTitle": "Atossa"
				},
				{
					"id": 80190707,
					"content": "Hừm... Chẳng lẽ là có liên quan đến Giáo Đoàn Vực Sâu thật sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190708,
					"content": "Để đề phòng, chúng ta quay về Làng Vimara xem tình hình đi. Hy vọng dân làng sẽ không gặp nguy hiểm gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190704,
					"content": "Tại sao ở đây lại có Giáo Đoàn Vực Sâu hoạt động nhỉ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190705
					]
				}
			]
		}
	]
