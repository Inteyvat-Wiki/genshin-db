			"dialogs": [
				{
					"id": 80190401,
					"content": "Là khách sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190402
					],
					"speakerTitle": "Amadhiah"
				},
				{
					"id": 80190402,
					"content": "Xin chào, ông Amadhiah! Chúng cháu nhận được ủy thác của Làng Vimara nên đã đến đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190403,
					"content": "Ồ, vậy thì vất vả cho hai cháu rồi. Đi đường xa như vậy, chuyện về anh chàng đó cũng đành nhờ vào hai cháu cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190404
					],
					"speakerTitle": "Amadhiah"
				},
				{
					"id": 80190404,
					"content": "Ông có thể kể cho chúng cháu nghe thêm về người mất tích không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190405,
					"content": "Đương nhiên là được rồi, miễn là chuyện này giúp ích được cho các cháu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190406
					],
					"speakerTitle": "Amadhiah"
				},
				{
					"id": 80190406,
					"content": "Tuy mắt ta không tốt lắm, nhưng trước đây vẫn được nghe giọng nói của cậu ta, bây giờ không nghe thấy nữa nên luôn cảm thấy trống trải trong lòng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190407
					],
					"speakerTitle": "Amadhiah"
				},
				{
					"id": 80190407,
					"content": "Cha mẹ cậu ta hình như đều không ở trong Làng Vimara, nhưng cậu ta có vẻ như không cô đơn chút nào, ngược lại còn luôn sẵn lòng đồng hành cùng người khác nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190408
					],
					"speakerTitle": "Amadhiah"
				},
				{
					"id": 80190408,
					"content": "Cậu ta thường đến làm khách trong nhà những người già neo đơn, cũng thích dẫn lũ trẻ mồ côi trong làng đi chơi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190409
					],
					"speakerTitle": "Amadhiah"
				},
				{
					"id": 80190409,
					"content": "Bất kể ai gặp phải chuyện gì đó đau lòng thì cậu ta đều vui vẻ ngồi nghe tâm sự, lại rất biết cách an ủi người khác nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190410
					],
					"speakerTitle": "Amadhiah"
				},
				{
					"id": 80190410,
					"content": "Thân là trưởng làng, ta thực sự phải cảm ơn anh chàng đó vì đã giúp đỡ những người gặp khó khăn về mặt tinh thần, vì đây vốn dĩ cũng là một phần trách nhiệm của ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190411
					],
					"speakerTitle": "Amadhiah"
				},
				{
					"id": 80190411,
					"content": "Chẳng trách sao mọi người lại lo lắng như vậy sau khi anh ấy mất tích, thì ra anh ấy là một người rất tốt bụng và dịu dàng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190412,
					"content": "Nhưng mà... Về những thông tin như tên tuổi, nơi ở, tình hình gia đình của anh ấy... Ông là trưởng làng nhưng cũng không có manh mối gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190413,
					"content": "Haiz... Đây cũng là việc khiến ta vô cùng hổ thẹn. Dù gì thì ta cũng phải nhớ lấy những thông tin này mà, hoặc do ta thực sự đã lớn tuổi rồi... Những điều này ta có ngẫm thế nào cũng không thể nhớ ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190414
					],
					"speakerTitle": "Amadhiah"
				},
				{
					"id": 80190414,
					"content": "A... Không sao, không cần gượng ép quá. Chúng cháu sẽ nghĩ cách...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190415,
					"content": "#Được rồi, {NICKNAME} thấy thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190416,
						80190417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190416,
					"content": "Cảm thấy đây không phải là một vụ mất tích đơn giản.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190418
					]
				},
				{
					"id": 80190418,
					"content": "Phải đấy, tôi cũng thấy vậy! Có nói thế nào thì việc không ai nhớ tên anh ta cũng rất kỳ lạ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190419,
					"content": "Nơi ở và gia đình cũng không có manh mối gì liên quan... Người này quả thật giống như bị bốc hơi khỏi cuộc sống thực tại vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190420,
						80190421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190420,
					"content": "Không. Tôi thì lại thấy giống như...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190422
					]
				},
				{
					"id": 80190422,
					"content": "Hả... Ý là dưới góc độ hiện thực thì không phải là \"bị bốc hơi\", mà là trước đó \"chưa từng tồn tại\" sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190423,
					"content": "Đợi đã, chuyện này hơi khó hiểu với tôi rồi... Một người chỉ tồn tại trong ký ức sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190424,
					"content": "(Liệu có phải là sự thay đổi ký ức mang tính tập thể giống như Đại Vương Rukkhadevata khi đó không...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190425
					]
				},
				{
					"id": 80190425,
					"content": "Các vị là... nhà mạo hiểm mới đến sao? Là nhận được ủy thác nên đến Làng Vimara hả?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190426
					],
					"speakerTitle": "Atossa"
				},
				{
					"id": 80190426,
					"content": "À, đúng vậy. Chúng tôi đang điều tra chuyện của người mất tích...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190427,
					"content": "Tốt quá rồi, cảm ơn hai vị vì vẫn chưa từ bỏ. Tôi vẫn luôn lo là Hiệp Hội Nhà Mạo Hiểm sẽ hủy bỏ ủy thác của chúng tôi đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190428
					],
					"speakerTitle": "Atossa"
				},
				{
					"id": 80190428,
					"content": "Tôi tên là Atossa, cũng sống ở Làng Vimara. Hai vị nhất định phải cố lên nhé, làm ơn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190429,
						80190430
					],
					"speakerTitle": "Atossa"
				},
				{
					"id": 80190429,
					"content": "Chúng tôi nhất định sẽ tìm được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190431
					]
				},
				{
					"id": 80190431,
					"content": "Đừng căng thẳng. Cô có quen người mất tích không? Có manh mối gì có thể cung cấp cho chúng tôi không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190432
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190432,
					"content": "Manh mối... Tôi cũng không biết có thể xem là manh mối hay không. Hai vị đi theo tôi, tôi dẫn hai vị đến một nơi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Atossa"
				},
				{
					"id": 80190430,
					"content": "Chỉ có thể nói là cố gắng hết sức thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190431
					]
				},
				{
					"id": 80190421,
					"content": "...Một người chỉ tồn tại trong ký ức hơn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190422
					]
				},
				{
					"id": 80190417,
					"content": "Có rất nhiều điểm bất thường.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190418
					]
				}
			]
