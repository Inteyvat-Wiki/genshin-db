				]
			},
			"dialogs": [
				{
					"id": 80190301,
					"content": "Ồ, xin chào, muốn mua gì sao? Tôi là dân buôn bán ở khu vực này đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190302
					],
					"speakerTitle": "Bahram"
				},
				{
					"id": 80190302,
					"content": "Không không, chúng tôi là nhà mạo hiểm, do vừa nhận được ủy thác của Làng Vimara từ chỗ Katheryne nên đã đến đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190303,
					"content": "Chuyện đó à, haiz... Cũng xem như phiền các nhà mạo hiểm đi đến đây một chuyến rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190304
					],
					"speakerTitle": "Bahram"
				},
				{
					"id": 80190304,
					"content": "Nói thật, mọi người đều không còn hy vọng gì nữa rồi. Lần nào cũng có người tự tin đến giúp, nhưng kết quả là nhanh chóng thất bại quay về.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190305
					],
					"speakerTitle": "Bahram"
				},
				{
					"id": 80190305,
					"content": "Chúng tôi khai manh mối đến nhàm chán cả rồi, ở xung quanh Làng Vimara cũng đã tìm gần hết, nhưng lại không có tiến triển gì mới...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190306
					],
					"speakerTitle": "Bahram"
				},
				{
					"id": 80190306,
					"content": "Vậy rốt cuộc anh ấy tên là gì? Sống ở đâu? Người thân của anh ấy đâu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190307,
					"content": "Không biết, không biết và không biết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190308
					],
					"speakerTitle": "Bahram"
				},
				{
					"id": 80190308,
					"content": "Hả... Dứt khoát vậy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190309,
					"content": "Xin lỗi, không phải tôi tỏ thái độ, mà là tôi đã lần lượt trả lời ba câu hỏi rồi đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190310,
						80190311
					],
					"speakerTitle": "Bahram"
				},
				{
					"id": 80190310,
					"content": "Cả ba câu đều không biết sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190312
					]
				},
				{
					"id": 80190312,
					"content": "Tuy nói là vậy, nhưng thực ra chúng tôi đều có ấn tượng sâu sắc với anh ấy. Đều là người sống cùng Làng Vimara cả, cũng từng cùng nhau làm qua rất nhiều việc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190313
					],
					"speakerTitle": "Bahram"
				},
				{
					"id": 80190313,
					"content": "Chỉ là chúng tôi không hiểu rõ tình hình cụ thể của anh ấy thôi. Hoặc cũng có thể là trước đây từng biết, nhưng bây giờ thì không còn ai nhớ nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190314
					],
					"speakerTitle": "Bahram"
				},
				{
					"id": 80190314,
					"content": "Dù sao thì mọi người trong làng cũng đã trao đổi thông tin với nhau và đưa ra kết luận như vậy mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190315
					],
					"speakerTitle": "Bahram"
				},
				{
					"id": 80190315,
					"content": "Được rồi, cứ cho là vậy đi... Vậy anh ấy trông như thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190316,
					"content": "Anh ấy à... Trong ấn tượng của tôi thì là một chàng trai tầm hai mươi tuổi, rất nhiệt tình, cũng rất hiền lành...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190317
					],
					"speakerTitle": "Bahram"
				},
				{
					"id": 80190317,
					"content": "Khi chỗ tôi không có khách thì tôi hay trò chuyện với anh ấy, thỉnh thoảng lại thấy anh ấy mạo hiểm đi giúp đỡ người khác... Haha, đúng là một chàng trai thú vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190318
					],
					"speakerTitle": "Bahram"
				},
				{
					"id": 80190318,
					"content": "Xem ra anh đánh giá khá tốt về anh ấy nhỉ, vừa nhắc đến anh ấy là vẻ mặt cũng không còn buồn rầu như trước nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190319,
					"content": "Đương nhiên rồi! Mọi người đều rất thích anh ấy, nếu không thì đã không đến Hiệp Hội Nhà Mạo Hiểm để gửi ủy thác tìm người rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190320
					],
					"speakerTitle": "Bahram"
				},
				{
					"id": 80190320,
					"content": "Người trẻ tuổi hồn nhiên như anh ấy rất hiếm gặp, nhưng sao đột nhiên lại biến mất chứ. Mong là không có chuyện gì xấu xảy ra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190321
					],
					"speakerTitle": "Bahram"
				},
				{
					"id": 80190321,
					"content": "Có lẽ... Anh ta chỉ là lén dọn đi chăng?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190322,
					"content": "Không đâu, với tính cách của anh ấy thì sẽ không đi mà không từ biệt. Mà cho dù là vậy thì chuyện anh ấy dọn nhà cũng không thể qua mặt được tất cả mọi người ở Làng Vimara...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190323
					],
					"speakerTitle": "Bahram"
				},
				{
					"id": 80190323,
					"content": "Ừm... Được rồi, cảm ơn thông tin của anh. Chúng tôi sẽ đến nơi khác hỏi thăm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190311,
					"content": "Vậy anh rốt cuộc biết những gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190312
					]
				}
			]
		},
