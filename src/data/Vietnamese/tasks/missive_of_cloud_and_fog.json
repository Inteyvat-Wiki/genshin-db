			"dialogs": [
				{
					"id": 414110301,
					"content": "Cảm ơn các bạn! Tôi sẽ bắt đầu vào việc ngay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110302
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 414110302,
					"content": "Không chỉ là món quà này đâu, bạn cũng còn phải đối xử tốt với vợ mình nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414110303,
					"content": "Nhất định, nhất định rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110304
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 414110304,
					"content": "Hy vọng món quà của tôi sẽ làm cô ấy vui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110305
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 414110305,
					"content": "Không có ai là không thích những món quà chứa đựng tình cảm đâu, yên tâm nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110306
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414110306,
					"content": "Chăm chỉ làm đi nhé, đừng lãng phí những nguyên liệu chúng tôi thu thập được đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
