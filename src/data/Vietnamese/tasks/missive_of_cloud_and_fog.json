				"points": []
			},
			"dialogs": [
				{
					"id": 414111302,
					"content": "Đây là gì, mau mở ra xem thử!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414111303,
					"content": "Tôi, tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111304
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 414111304,
					"content": "Hộp quà tinh tế như vậy nhưng lại xuất hiện ở nơi hẻo lánh thế này, thật thú vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111305
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414111305,
					"content": "...Ấy?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111306
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 414111306,
					"content": "Woa, một vòng hoa Cúc Cánh Quạt rất tinh tế, còn có rất nhiều ngôi sao giấy nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111307,
						414111308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414111307,
					"content": "Là trò đùa chăng?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414111309
					]
				},
				{
					"id": 414111309,
					"content": "\"Hung thủ\" mà chúng ta nói hình như là fan của tiểu thư Barbara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111310
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414111310,
					"content": "Còn có mẫu giấy nữa, trên đó ghi gì vậy? Để xem thử...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414111311,
					"content": "\"Xin lỗi vì đã dùng cách này dụ bạn đến, vòng Hoa Gió này xin tặng bạn.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414111312,
					"content": "Hừ! Thì ra trò hù dọa đó chỉ là cái cớ thôi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414111313,
					"content": "Dù là đối với thần linh hay là người yêu, tặng đóa hoa chất chứa tình cảm của mình mới là nghi thức chính của Lễ Hội Hoa Gió.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111314
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414111314,
					"content": "Để có thể tặng bạn trong ngày lễ đặc biệt này, người này đã không từ thủ đoạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111315
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414111315,
					"content": "Xem ra đằng sau vòng hoa này chính là một sự chuẩn bị chu đáo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111316
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414111316,
					"content": "Hừ, thật quá đáng... đúng là một tên không biết điều...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414111317,
					"content": "Ha ha, đúng vậy, mà tôi cũng đã đoán được là ai rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111318
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414111318,
					"content": "Là ai vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414111319,
					"content": "(Tôi hình như cũng đoán ra rồi.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414111320
					]
				},
				{
					"id": 414111320,
					"content": "Không nói... để Paimon tự đoán vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111321
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414111321,
					"content": "Ấy! Sao lại thế!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414111308,
					"content": "Là thủ đoạn gây sự chú ý chăng?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414111309
					]
				}
			]
		},
		{
