				},
				{
					"id": 414110502,
					"content": "Thầy đến thu bài tập đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110503
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414110503,
					"content": "Tôi cũng làm được kha khá rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110504
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 414110504,
					"content": "Mau lên, nộp bài tập đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414110505,
					"content": "Đây đây, đừng cười tôi là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110506
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 414110506,
					"content": "Hừm... ừm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110507
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414110507,
					"content": "Tên hát rong, đánh giá xem nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414110508,
					"content": "Kaeya, tôi có thể đọc lên được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110509
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414110509,
					"content": "Được thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110510
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 414110510,
					"content": "Khụ khụ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110511
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414110511,
					"content": "\"mi muhe ye\\nTrong ngôn ngữ của Hilichurl\\nLà anh yêu em.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110512
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414110512,
					"content": "Ừ? Hử??",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414110513,
					"content": "Đọc xong rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110514
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414110514,
					"content": "Hết rồi á?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414110515,
					"content": "Ngắn gọn súc tích, biểu đạt gọn gàng, tôi cho rằng vậy là đủ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110516
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 414110516,
					"content": "Hả?! Đây giống đang dạy tiếng Hilichurl đúng hơn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110517,
						414110518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414110517,
					"content": "Lủng củng quá, không cảm nhận được tình yêu.",
