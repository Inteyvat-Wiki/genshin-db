					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111016
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 414111016,
					"content": "Lợi hại quá, vừa nhìn đã ra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111017
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414111017,
					"content": "Nhưng mà, Tửu Trang Dawn? Hình như khác với địa điểm ban nãy nói tới...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111018
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414111018,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111019
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 414111019,
					"content": "Barbara, thay vì suy nghĩ, sao không đối diện trực tiếp với vấn đề nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111020
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 414111020,
					"content": "Ừm, bạn nói đúng, nhưng chỉ là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111021
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 414111021,
					"content": "Ha ha, sợ đúng không? Vậy chúng tôi sẽ đi với bạn, thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111022
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414111022,
					"content": "Các vị...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111023
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 414111023,
					"content": "Vị tu nữ này cũng muốn đi chung chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111024
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414111024,
					"content": "Thôi không cần... nhìn là thấy không phải chuyện lớn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111025
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 414111025,
					"content": "Hử? Ban nãy cô ấy nói gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111026
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414111026,
					"content": "Không có gì thì mọi người mau đi đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111027
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 414111027,
					"content": "Tiểu thư Barbara, bạn ổn hơn chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111028
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414111028,
					"content": "Ừm! Tôi không sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111029
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 414111029,
					"content": "Rosaria nói đúng, thay vì ngồi sợ thì hãy trực tiếp đi bắt hung thủ thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111030
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 414111030,
					"content": "Đúng vậy đúng vậy, chúng ta cùng đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111031
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414111031,
					"content": "Cảm ơn các bạn, vậy giờ chúng ta cùng đi đến vị trí trên bản đồ nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111032
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 414111032,
					"content": "Được, Barbara cố lên!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
