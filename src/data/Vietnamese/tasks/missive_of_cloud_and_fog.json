			},
			"dialogs": [
				{
					"id": 414111401,
					"content": "Phải làm sao đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111402
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 414111402,
					"content": "Bạn là Nimrod đúng không? Kaeya nói bạn có việc cần tìm anh ấy, hiện giờ anh ấy đang bận nên nhờ tôi đến giúp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414111403,
					"content": "Nhà Lữ Hành sao? Không ngờ lại là bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111404
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 414111404,
					"content": "Là như vậy, tôi đang định chọn quà Lễ Hội Hoa Gió cho vợ tôi, nên định nhờ Kaeya góp ý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111405
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 414111405,
					"content": "Con người của tôi nghiện rượu... luôn lang thang ở đây. Vợ tôi phản đối tôi uống nên chúng tôi thường xuyên cãi nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111406
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 414111406,
					"content": "Thì ra bạn là tên nát rượu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414111407,
					"content": "Đồng ý rượu là món ngon, nhưng nếu bạn cứ uống như vậy thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111408
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414111408,
					"content": "Tôi cũng biết thế, nên cảm thấy có lỗi với cô ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111409
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 414111409,
					"content": "Nhà Lữ Hành, có thể giúp tôi đi tìm một số nguyên liệu không? Tôi muốn tự tay làm một phần quà tặng cho vợ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111410
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 414111410,
					"content": "Đúng ra là tôi phải chuẩn bị, nhưng tôi uống say quá nên ngủ quên mất. Lúc tỉnh dậy thì đang trong lễ hội rồi, với khả năng của tôi thì giờ chuẩn bị chắc không kịp nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111411
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 414111411,
					"content": "Bạn thật hồ đồ quá đi mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414111412,
					"content": "Những người chưa kết hôn trong Mondstadt sẽ không dám nhờ người khác làm việc trong ngày lễ hội đâu, cũng may là bạn đã kết hôn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111413
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414111413,
					"content": "Ừm ừm... xin lỗi, để các bạn chê cười rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111414
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 414111414,
					"content": "Thật hết cách. Nói đi, bạn cần chuẩn bị gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414111415,
					"content": "Tôi sẽ tìm gỗ ở trong thành, còn cây cỏ thì cần phải ra ngoài để hái. Tôi đang cần 2 Tiểu Đăng Thảo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111416
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 414111416,
					"content": "Tiểu Đăng Thảo và gỗ sao, có thể làm gì nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414111417,
					"content": "Tôi muốn làm một ngôi nhà nhỏ bằng ván gỗ, có hoa phát sáng và đồ gia dụng thủ công nho nhỏ... để tặng cho cô ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111418
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 414111418,
					"content": "Món quà thật lãng mạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111419
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414111419,
					"content": "Một chút lòng thành thôi mà, lúc mới quen thì tôi cũng hay tặng quà tự làm cho cô ấy, cô ấy thích lắm, còn nói...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111420
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 414111420,
					"content": "À thôi! Không nói chuyện cũ nữa, thôi thì nhờ cả vào bạn nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111421
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 414111421,
					"content": "Xem như bạn may mắn khi gặp được chúng tôi đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414111422,
					"content": "Đi tìm nguyên liệu thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
