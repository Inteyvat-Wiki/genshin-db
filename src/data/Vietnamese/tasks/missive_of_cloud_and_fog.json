			"dialogs": [
				{
					"id": 414110101,
					"content": "Hêy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414110102,
					"content": "Nhà Lữ Hành, Paimon, các bạn đến rồi sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110103
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414110103,
					"content": "Tôi vừa nhắc các bạn là các bạn có mặt ngay, thật trùng hợp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110104
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 414110104,
					"content": "Kaeya, bạn đã hoàn thành xong bài tập chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414110105,
					"content": "Phải khiến các bạn thất vọng rồi, tôi vẫn còn chưa bắt đầu làm nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110106
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 414110106,
					"content": "Học sinh không làm bài tập thì không phải học sinh ngoan đâu nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110107
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414110107,
					"content": "Kaeya đang bận gì đó nên mới không làm bài tập đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414110108,
					"content": "Ừm, như bạn thấy đó, đang giúp Jean xử lý công việc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110109
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 414110109,
					"content": "Trong thời gian lễ hội, Mondstadt rất nhộn nhịp, cho nên công việc lặt vặt cần phải xử lý bị đội lên rất nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110110
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 414110110,
					"content": "Nhà Lữ Hành, bạn có thể giúp tôi được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110111
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 414110111,
					"content": "Có một người bạn rượu nhờ tôi làm chút việc, tôi thì hiện giờ không tiện rời khỏi... Bạn có thể đi giúp tôi được chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110112
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 414110112,
					"content": "Bạn rượu? Là quen trong quán rượu sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110113
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414110113,
					"content": "Đúng vậy, tôi tan ca có đi uống chút rượu, không ngờ cũng làm quen được khá nhiều bạn bè.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110114
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 414110114,
					"content": "Anh ấy là Nimrod, thường hay xuất hiện ở quán rượu, giờ này chắc anh ta đang rảnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110115
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 414110115,
					"content": "Tôi phải ở lại để làm bài tập, chuyện của Nimrod giao cho bạn nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110116,
						414110117
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 414110116,
					"content": "Kaeya, cố gắng làm bài nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 414110117,
					"content": "Được thôi, xem như hòa mình vào lễ hội vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
