					"content": "Dù sao cũng không có chuyện gì gấp, nói không chừng tòa án sẽ còn gọi tôi đi làm chứng nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960332
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960332,
					"content": "Còn khẩu súng kia, đó là vật chứng quan trọng, chắc phải chờ xét xử xong vụ án rồi mới có thể đưa về Natlan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960333
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960333,
					"content": "Nói chung, cứ để tôi tận hưởng bãi cát và biển rộng thêm một lúc nữa vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960324,
