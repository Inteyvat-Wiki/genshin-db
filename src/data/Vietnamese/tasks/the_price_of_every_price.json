			"dialogs": [
				{
					"id": 401960101,
					"content": "Chào mọi người nhé! Chúng tôi không đến trễ chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960102,
					"content": "Không, tới đúng lúc lắm. Ngủ có ngon không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960103
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 401960103,
					"content": "Bận rộn sẽ khiến người ta phấn chấn hơn đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960104
					]
				},
				{
					"id": 401960104,
					"content": "Đúng là cách tốt để duy trì năng lượng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960105
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960105,
					"content": "Mọi người đã bắt đầu chuẩn bị rồi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960106
					]
				},
				{
					"id": 401960106,
					"content": "Hôm qua tôi đã lấy được thông tin từ Argenteau, xác định được thời gian và địa điểm giao dịch rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960107
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960107,
					"content": "Nói ra thì, là một nơi mà mọi người đều biết đấy. \"Buổi chiều hôm nay, gặp ở nhà hàng Phim Trường Vui Vẻ.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960108
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960108,
					"content": "Hửm? Hắn ta thích nơi đó sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960109,
					"content": "Nhưng mà...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960110
					]
				},
				{
					"id": 401960110,
					"content": "#Xem ra {NICKNAME} cũng có mối lo ngại giống chúng tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960111
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960111,
					"content": "Đúng vậy. So với những khu vực trống trải thì nơi có nhiều người sẽ gây cản trở cho việc truy bắt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960112
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 401960112,
					"content": "Tội phạm có thể trà trộn vào dòng người, thậm chí lợi dụng con tin để trốn thoát.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960113
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 401960113,
					"content": "Thế nên trước hết chúng ta cần phải chuẩn bị nhiều hơn. Hôm qua khi nhận được thông tin, chúng tôi đã bắt đầu sắp xếp công việc cho Đội Hắc Ảnh Marechaussee và Đội Tuần Tra Đặc Biệt rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960114
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 401960114,
					"content": "Ừm, chúng tôi sẽ sắp xếp thêm nhiều thành viên mặc thường phục tại hiện trường. Nếu tiến triển không thuận lợi thì chúng tôi sẽ ưu tiên bảo vệ sự an toàn cho người dân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960115
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960115,
					"content": "Đương nhiên, vẫn nên chúc cho chúng ta mọi việc thuận lợi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960116
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960116,
					"content": "Trong nhóm người tham gia có khá nhiều gương mặt quen thuộc mà tôi từng gặp trong vụ án lần trước, chẳng hạn như đội trưởng Đội Tuần Tra Đặc Biệt, Chevreuse. Vậy nên tôi thấy khá lạc quan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960117
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960117,
					"content": "Vậy thì mượn lời chúc phúc của đại anh hùng Natlan nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960118
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960118,
					"content": "À, chúng tôi cũng đã trao đổi và sắp xếp với bên của tiểu thư Lepine-Pauline và Navia rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960119
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960119,
					"content": "Spina di Rosula sẽ hỗ trợ trong phạm vi có thể kiểm soát, không cần lo lắng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960120
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 401960120,
					"content": "Vấn đề duy nhất ở đây... có lẽ là bên của tiểu thư Escoffier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960121,
						401960123
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960121,
					"content": "Cô ấy không muốn tiếp những khách hàng từng phạm tội sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960122
					]
				},
				{
					"id": 401960123,
					"content": "Cô ấy muốn xiên tên tội phạm đó sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960124
					]
				},
				{
					"id": 401960122,
					"content": "Haha, nếu là như vậy thì đơn giản rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960125
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960124,
					"content": "Ồ, nói ra thì ý tưởng này cũng hay đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960125
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960125,
					"content": "Khụ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960126
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 401960126,
					"content": "Không đùa nữa. Escoffier hy vọng nhà hàng của cô ấy sẽ không phải chịu bất kỳ tổn thất nào từ lần hành động này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960127
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960127,
					"content": "Haha... Tôi có linh cảm là chắc chắn sẽ không được như mong muốn đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960128
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960128,
					"content": "Có cần tôi làm gì không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960129
					]
				},
				{
					"id": 401960129,
					"content": "#Nói thật thì chuyện này không liên quan đến {F#cô}{M#cậu}, bữa giờ cũng đã gây không ít phiền phức cho {F#cô}{M#cậu} rồi, việc còn lại cứ giao cho chính quyền Fontaine xử lý là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960130
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960130,
					"content": "#Nhưng tôi đoán, chắc {F#cô}{M#cậu} cũng muốn biết kết cục của vụ việc này nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960131
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960131,
					"content": "Chắc chắn rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960132
					]
				},
				{
					"id": 401960132,
					"content": "#Ừm, vậy {F#cô}{M#cậu} cứ tùy cơ ứng biến nhé. Không nhất thiết cần {F#cô}{M#cậu} ra tay, chỉ là để đề phòng thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960133
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960133,
					"content": "Tôi sẽ cố hết sức không để sự việc phát triển tới mức đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960134
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960134,
					"content": "Kinich cũng muốn tham gia sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960135
					]
				},
				{
					"id": 401960135,
					"content": "Đương nhiên rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960136
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960136,
					"content": "Tuy trong lòng tôi còn nhiều nghi vấn, nhưng theo những thông tin đã có được thì tên tội phạm đến từ Natlan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960137
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960137,
					"content": "Hơn nữa, tôi cũng là một trong những nhân chứng, cho nên không thể bỏ mặc được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960138
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960138,
					"content": "Quả đúng là phong cách của Kinich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960139,
					"content": "Mọi người tiếp tục thảo luận về chi tiết hành động và những điều cần lưu ý.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401960140
					]
				},
				{
					"id": 401960142,
					"content": "Vậy thì, tán gẫu đến đây thôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960143
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960143,
					"content": "Thời gian hành động sẽ là buổi chiều. Chỉ cần đủ nhanh thì trước khi xuất phát vẫn còn có thể uống thêm vài tách trà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960144
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960144,
					"content": "#Đúng rồi, {NICKNAME}, chúng ta cũng đi ăn chút gì đi nhé? Ăn no bụng thì mới có sức làm việc chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960145,
					"content": "Paimon chỉ xem thôi mà đúng không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960146
					]
				},
				{
					"id": 401960146,
					"content": "Đi chung cũng là một việc rất quan trọng đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960147
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960147,
					"content": "Vậy tôi đến hội trường trước đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960148
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960148,
					"content": "Mấy ngày nay Ajaw cứ nằng nặc đòi ăn món giới hạn của sự kiện, phải nhanh chóng thỏa mãn nó trước đã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960149
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960149,
					"content": "Lát nữa gặp lại nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960150
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960150,
					"content": "Được, tôi chờ tin tốt của các vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neuvillette"
				}
			]
		},
		{
			"id": 4019602,
			"completionStepIds": [
				4019603,
				4019605
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
