			},
			"dialogs": [
				{
					"id": 401960201,
					"content": "Vài ngày trôi qua, bãi biển này có vẻ náo nhiệt hơn rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960202,
					"content": "(Ừm, cũng có thể do trong đó có không ít hiến binh mặc thường phục.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960203
					]
				},
				{
					"id": 401960203,
					"content": "#{NICKNAME}, chuyện là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960204,
					"content": "Khụ! Tôi hơi đói rồi, chúng ta đến nhà hàng xem thử thực đơn đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960205,
					"content": "(Người mang chiếc rương này chắc là người đến để giao dịch.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960206
					]
				},
				{
					"id": 401960206,
					"content": "(Được rồi, làm việc thôi.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960207
					]
				},
				{
					"id": 401960207,
					"content": "Đáng ghét, cứ thế mà lôi người qua như vậy sao! Đây là hành vi xem thường mạng sống! Ta sẽ đến tòa án để kiện ngươi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960208
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960208,
					"content": "Vậy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960209
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960209,
					"content": "Tôi thì thấy, tôi tốt bụng đưa anh ra khỏi tầm mắt của \"khán giả\", là đang giữ thể diện cho anh rồi đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960210
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960210,
					"content": "Còn trên đường đi, đầu anh ngẩng lên hay cúi xuống chẳng phải do tự anh lựa chọn sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960211
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960211,
					"content": "Ngươi...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960212
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960212,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960213
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960213,
					"content": "Được rồi, tôi thừa nhận là do tôi không đúng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960214
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960214,
					"content": "Haiz... Đương nhiên tôi biết điều gì là đúng, điều gì là sai. Nhưng thật sự không còn cách nào khác nữa, tôi thật sự rất cần số tiền này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960215
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960215,
					"content": "Tôi vốn là một chuyên gia nghiên cứu di tích cổ, gia đình hạnh phúc, công việc cũng thuận lợi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960216
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960216,
					"content": "Nhưng ai ngờ được rằng con trai của tôi lại bị dụ dỗ, đắm chìm trong vũng lầy bài bạc... Gia đình chúng tôi vốn có một số tích góp, nhưng cũng không đủ để phung phí như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960217
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960217,
					"content": "Sau khi mắc nợ, nó thường bị chủ nợ uy hiếp. Tôi là cha ruột, sao lại có thể trơ mắt nhìn con mình gặp phải chuyện như vậy chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960218
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960218,
					"content": "Haiz, con trai tôi cũng tầm cỡ tuổi của cậu, nếu nó cũng có thể trưởng thành khỏe mạnh như vậy thì tốt quá... Cho nên tôi mới cần số tiền đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960219
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960219,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960220
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960220,
					"content": "Cậu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960221
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960221,
					"content": "Cầu xin đấy, chàng trai trẻ à, xin hãy giúp tôi đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960222
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960222,
					"content": "Nể tình chúng ta đều là dân Natlan, xin hãy tha mạng cho tôi đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960223
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960223,
					"content": "Nếu tôi quay về, thì còn có cơ hội dạy dỗ cho đứa con trai hư hỏng của mình. Nhưng nếu tôi bị bắt, thì có lẽ nó chỉ còn có một con đường chết mà thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960224
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960224,
					"content": "Là người một nhà, nên cùng nhau chiến đấu vì tương lai tốt đẹp hơn, phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960225
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960225,
					"content": "Cơ hội của cả gia đình chúng tôi đều nằm trong tay cậu đấy, xin hãy giơ cao đánh khẽ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960226
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960226,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960227
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960227,
					"content": "Haha, Kinich, sao không nói gì vậy? Không lẽ mềm lòng rồi à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960228
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 401960228,
					"content": "Hừm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960229
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960229,
					"content": "Tôi sẽ không tin bất kỳ lời nào của anh đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960230
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960230,
					"content": "Wriothesley đoán đúng tám phần rồi đấy, anh đúng là con bạc vô phương cứu chữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960231
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960231,
					"content": "Hả, con bạc? Tôi? Sao có thể chứ, đã nói là con trai tôi mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960232
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960232,
					"content": "Trước hết, anh thật sự là người Natlan sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960233
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960233,
					"content": "Nếu anh luôn chú ý động tĩnh của khẩu súng kia, chắc chắn không thể nào không nhận ra một khuôn mặt quen thuộc nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960234
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960234,
					"content": "Mà so ra thì khi anh thốt ra từ \"tòa án\" có vẻ thuận miệng hơn nhiều đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960235
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960235,
					"content": "Gì chứ, chỉ với cái này thôi sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960236
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960236,
					"content": "Tôi, tôi có thể giải thích! Thật... thật ra từ nhỏ tôi đã sống ở...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960237
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960237,
					"content": "Chậc, tôi đã nói là không muốn nghe thêm câu nào nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960238
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960238,
					"content": "Ajaw, cho ngươi một cơ hội để chặn họng người khác đây, thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960239
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960239,
					"content": "Haha, ta chờ câu này của ngươi lâu lắm rồi đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960240
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 401960240,
					"content": "Lão già mặt dày, ăn một đấm của ta đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960241
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 401960241,
					"content": "Một trong những đặc điểm của con bạc chính là nói dối liên tục.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960242
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960242,
					"content": "Tôi đoán anh chỉ là người Fontaine giả làm người Natlan thôi, xung quanh cũng chẳng có người nhà bạn bè. Cho dù có thì họ cũng đã sớm rời xa anh vì sự vô sỉ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960243
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960243,
					"content": "Đương nhiên, cũng có thể tôi đã đoán sai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960244
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960244,
					"content": "...Nhưng vậy thì đã sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960245
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960245,
					"content": "Tôi chỉ phụ trách bắt người, không phải người đại diện của anh, cũng không phải thính giả quan tâm đến anh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960246
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960246,
					"content": "Còn việc moi ra chân tướng từ miệng của anh, thì đó là trách nhiệm của tòa án mà anh yêu thích nhất rồi. Đúng không nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960247
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960247,
					"content": "Đúng vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960248
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401960248,
					"content": "Ngài Kinich, đã lâu không gặp. Tên tội phạm này sẽ do Đội Tuần Tra Đặc Biệt chúng tôi tiếp quản.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960249
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401960249,
					"content": "À, vất vả cho mọi người rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960250
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960250,
					"content": "Không đâu, chúng tôi vẫn phải cảm ơn sự giúp đỡ của anh mới đúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960251
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401960251,
					"content": "Còn ta thì sao? Còn ta thì sao? Vô lễ! Chẳng lẽ không nên bày tỏ lòng biết ơn chân thành với Thánh Long Toàn Năng ta sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960252
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 401960252,
					"content": "Vậy được rồi, cảm ơn màn biểu diễn tuyệt vời của ngươi và ngài Cacucu nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960253
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401960253,
					"content": "Này, ý gì đấy!? Ngươi đứng lại ngay cho ta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960254
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 401960254,
					"content": "Kinich, anh vẫn ổn chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960255
					]
				},
				{
					"id": 401960255,
					"content": "Đừng lo, người bị kéo đi suốt chặng đường không phải tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960256
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960256,
					"content": "Cảm giác như lúc nãy tâm trạng của anh không được tốt lắm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960257
					]
				},
				{
					"id": 401960257,
					"content": "Haha, là vì Kinich bé nhỏ đang nhớ đến chuyện ngày xưa đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960258
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 401960258,
					"content": "Đừng có mà khóc nhè! Thánh Long Toàn Năng ta đây mà có một tên hầu cận yếu đuối như vậy thì sẽ mất mặt lắm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960259
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 401960259,
					"content": "Nói cái gì đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960260
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960260,
					"content": "Ajaw, xấu xa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960261
					]
				},
				{
					"id": 401960261,
					"content": "Cũng không có gì phải giấu, nói thẳng ra thì tôi quả thật rất ghét con bạc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960262
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960262,
					"content": "Bọn họ là những người thiếu trách nhiệm nhất trên thế giới, là loại người không tôn trọng sự hy sinh và đền đáp nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960263
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960263,
					"content": "Vì một đồng xu, họ có thể bịa ra hàng trăm ngàn lời nói dối, lại còn muốn dùng đồng xu đó để thắng được hàng trăm triệu tài sản.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960264
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960264,
					"content": "Nhưng chúng ta đều hiểu rõ, những thứ khi không có được, thì phía sau đó đều ẩn chứa cái giá không thể tưởng tượng được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960265
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960265,
					"content": "Cuộc sống trước đây của tôi đã là một phần của cái giá phải trả khi cha tôi cược thua. Nếu có thể, tôi không muốn có người khác rơi vào hoàn cảnh tương tự.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960266
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960266,
					"content": "Kinich...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960267
					]
				},
				{
					"id": 401960267,
					"content": "Không cần đau buồn cho tôi, tôi cũng không cảm thấy đau buồn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960268
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960268,
					"content": "Ai cũng nói con người được tạo nên từ quá khứ. Nếu tôi đã có thể đi được đến ngày hôm nay, thì chứng tỏ tôi đã làm đúng rất nhiều việc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960269
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960269,
					"content": "Đừng trừng phạt bản thân vì những sai lầm của người khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960270
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960270,
					"content": "Đối với tôi, thì tôi sẽ chọn ghi nhớ những khoảnh khắc giúp tôi trưởng thành hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960271
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960271,
					"content": "Giống như lần đầu tiên tôi học được cách dùng dây móc vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960272
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960272,
					"content": "Hoặc là lần đầu tiên khao khát tri thức.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960273
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960273,
					"content": "Tôi hiểu rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960274
					]
				},
				{
					"id": 401960274,
					"content": "Ừm, tôi tin là vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960275
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960275,
					"content": "Đi thôi, nếu không về sẽ có thêm nhiều người lo lắng không cần thiết hơn đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kinich"
				}
			]
