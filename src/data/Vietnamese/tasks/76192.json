			"dialogs": [
				{
					"id": 761920101,
					"content": "Có vẻ hôm nay không được may mắn, đợi lâu thế mà đến cả Cá Voi Vây Sương thông thường cũng chẳng thấy được mấy con...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920102
					],
					"speakerTitle": "Helka"
				},
				{
					"id": 761920102,
					"content": "Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920103
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761920103,
					"content": "Hay là hôm nay thôi nhé, về trước đi, sau này vẫn còn cơ hội mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920104
					],
					"speakerTitle": "Helka"
				},
				{
					"id": 761920104,
					"content": "Nhưng mà... nhưng mà lần này bạn về không bao lâu là lại đi nơi khác rồi đúng không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920105
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761920105,
					"content": "Chúng ta chờ thêm một lát nữa nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920106
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761920106,
					"content": "Ồ? Chẳng lẽ là Helka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920107
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761920107,
					"content": "Chị Linnea! Vâng, em đã về rồi, nhưng mà cuốn cẩm nang của em còn thiếu một chút nữa mới hoàn thành, nên bây giờ vẫn chưa thể phân thắng bại với chị được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920108
					],
					"speakerTitle": "Helka"
				},
				{
					"id": 761920108,
					"content": "Ồ? Vậy thì xem ra chuyến đi xa lần này em cũng thu hoạch được không ít đấy nhỉ? Nhưng thời gian qua chị cũng chẳng ngồi không đâu, chị đã bổ sung thêm khá nhiều nội dung cho cẩm nang của mình rồi đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920109
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761920109,
					"content": "Chị Linnea cũng đến xem Cá Voi Vây Sương đấy à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920110
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761920110,
					"content": "Đúng vậy. Nghe nói mới được phát hiện ra gần đây, xét về kích thước của nó thì chị đoán là do sự thay đổi môi trường dẫn đến màu sắc bề ngoài thay đổi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920111
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761920111,
					"content": "Ví dụ như, nồng độ Kuuvahki trong môi trường chẳng hạn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920112
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761920112,
					"content": "Tiếc là hôm nay có lẽ không thấy được rồi. Chúng em đã đợi lâu lắm rồi, nhưng vẫn chẳng có gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920113
					],
					"speakerTitle": "Helka"
				},
				{
					"id": 761920113,
					"content": "Chị Linnea, chị cũng khuyên Maisie đi, hôm nay chúng ta cứ về trước đi vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920114
					],
					"speakerTitle": "Helka"
				},
				{
					"id": 761920114,
					"content": "Không sao đâu. Hôm nay khi thức dậy mình thấy trạng thái còn tốt hơn bình thường nữa, chúng ta chờ thêm một chút nữa nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920115
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761920115,
					"content": "Nghe nói nhìn thấy chú Cá Voi Vây Sương đó thì điều ước sẽ thành hiện thực. Vậy nó là loài động vật mang lại may mắn đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920116
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761920116,
					"content": "Mình hy vọng Helka sẽ mang theo vận may của nó để tiếp tục lên đường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920117
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761920117,
					"content": "Nhưng mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920118
					],
					"speakerTitle": "Helka"
				},
				{
					"id": 761920118,
					"content": "Vậy chúng ta cùng chờ thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920119
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761920119,
					"content": "Chị Linnea!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920120
					],
					"speakerTitle": "Helka"
				},
				{
					"id": 761920120,
					"content": "Em đừng vội mà, chị có linh cảm hôm nay nhất định sẽ nhìn thấy chú Cá Voi Vây Sương đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920121
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761920121,
					"content": "Helka cũng biết mà đúng không? Linh cảm của chị lúc nào cũng chuẩn đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920122
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761920122,
					"content": "Được rồi... Vậy chờ thêm một lúc nữa vậy, nhưng chỉ một lúc thôi đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920123
					],
					"speakerTitle": "Helka"
				},
				{
					"id": 761920123,
					"content": "Chờ một lúc...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						761920124
					]
				},
				{
					"id": 761920124,
					"content": "Mau nhìn kìa! Ôi, nó nhảy cao quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920125
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761920125,
					"content": "Giá mà mình cũng bơi nhanh như vậy thì tốt biết mấy, nếu được bơi cùng chúng thì chắc chắn sẽ rất vui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920126
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761920126,
					"content": "Thôi nhảy xuống nước thử luôn đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920127
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761920127,
					"content": "Như vậy nguy hiểm quá! Haiz, đi xa lâu rồi mới trở về mà chị Linnea vẫn hấp tấp như thế...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920128
					],
					"speakerTitle": "Helka"
				},
				{
					"id": 761920128,
					"content": "Đ-đâu có! Helka không muốn chơi đùa với chúng sao? Trông chúng chơi vui vẻ thế kia mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920129
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761920129,
					"content": "Nhưng nếu quần áo ướt rồi bị cảm lạnh thì không tốt đâu, hay là ở trên bờ, dùng máy ảnh ghi lại khoảnh khắc vui vẻ của chúng nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920130
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761920130,
					"content": "Nói vậy cũng có lý... Vậy mượn máy ảnh của Helka nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linnea"
				}
			]
		},
