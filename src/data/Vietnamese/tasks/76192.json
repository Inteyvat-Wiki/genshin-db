			"dialogs": [
				{
					"id": 761920201,
					"content": "Chụp đẹp quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920202
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761920202,
					"content": "Giờ thì mãn nguyện rồi chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920203
					],
					"speakerTitle": "Helka"
				},
				{
					"id": 761920203,
					"content": "Ừm! Dù truyền thuyết có thật hay không, vẫn hy vọng dù Helka đi đến đâu, vận may cũng sẽ giúp hóa giải mọi hiểm nguy và cuối cùng trở về Speranza bình an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920204
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761920204,
					"content": "...Cảm ơn nhé, Maisie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920205
					],
					"speakerTitle": "Helka"
				},
				{
					"id": 761920205,
					"content": "Hihi, vậy chúng ta về thôi nhỉ? Chị Linnea, em cũng cảm ơn chị, hẹn gặp lại ở Speranza nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920206
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761920206,
					"content": "Hẹn gặp lại ở Speranza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linnea"
				}
			]
