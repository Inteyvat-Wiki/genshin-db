				]
			},
			"dialogs": [
				{
					"id": 705500201,
					"content": "Trời Đẹp xong rồi đây, Klee thử xem nhé!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500202
					]
				},
				{
					"id": 705500202,
					"content": "Waa, hoá ra Trời Đẹp lại có màu này sao? Bầu trời màu tím... là trời đêm rực sáng phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500203,
						705500204
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500203,
					"content": "Có thể là buổi chiều tối quang đãng sau khi mặt trời lặn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500205
					]
				},
				{
					"id": 705500205,
					"content": "Klee uống trước đã, rồi nghĩ tiếp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500206
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500206,
					"content": "A, em uống hết rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500207
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500207,
					"content": "Chua chua ngọt ngọt! Ngon lắm ạ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500208
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500208,
					"content": "Nếu uống ly này khi ăn cá nướng, chắc chắn Klee sẽ ăn được hết mấy con liền, sức ăn tăng gấp đôi luôn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500209
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500209,
					"content": "Một ly nhỏ vẫn chưa đủ đâu, Klee còn muốn thêm một ly nữa... giống như bánh ngọt vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500210,
						705500211,
						705500212
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500210,
					"content": "Hiểu rồi, Klee muốn thêm \"đồ ngọt dạng lỏng\" nữa hả!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500213
					]
				},
				{
					"id": 705500213,
					"content": "#Hmm... Em cũng không biết phải thêm công thức gì nữa. Em và {F#chị}{M#anh} Kỵ Sĩ Danh Dự cùng nghĩ nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500214
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500214,
					"content": "Kẹo mà Klee mang đến đặc biệt thật đấy!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500215
					]
				},
				{
					"id": 705500215,
					"content": "Cái này sao? Hihi... Là mẹ dạy em làm bằng Đài Giả Kim đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500216
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500216,
					"content": "Cho thật nhiều đường, thêm cả những bông hoa mà người bạn Fontaine của mẹ mang tới, mật ong sao trời của dì Barbie, mứt ma thuật mà dì Tavia tặng mẹ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500217
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500217,
					"content": "Cho nguyên liệu vào Đài Giả Kim, cầu nguyện một hình dạng, niệm theo thần chú của mẹ. Bùm một tiếng, thế là kẹo hình Dodoco hiện ra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500218,
						705500219
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500218,
					"content": "Thành phần và cách làm đều đỉnh thật đó...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500220
					]
				},
				{
					"id": 705500220,
					"content": "#Em tặng {F#chị}{M#anh} Kỵ Sĩ Danh Dự mấy viên kẹo Dodoco này! Nếu {F#chị}{M#anh} thích, em sẽ dạy {F#chị}{M#anh} câu thần chú mà mẹ đã dạy em.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500221
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500221,
					"content": "#Như vậy thì {F#chị}{M#anh} Kỵ Sĩ Danh Dự cũng có thể tự làm ra loại kẹo mình muốn rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500222,
						705500223
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500222,
					"content": "Cảm ơn Klee đã chia sẻ công thức rất tuyệt vời!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500224
					]
				},
				{
					"id": 705500224,
					"content": "Hihi, nếu có gì không hiểu thì cứ tìm Klee nhé! Klee là chuyên gia về kẹo ma thuật đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500225
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500225,
					"content": "Hôm nay Klee còn việc gì phải làm không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500226
					]
				},
				{
					"id": 705500226,
					"content": "Ừm! Gần đây mẹ đã đưa cho Klee một cuốn sách siêu hay, mỗi tối phải đọc một chương, học hỏi thêm kiến thức rồi đi ngủ sớm đúng giờ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500227
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500227,
					"content": "Cuốn sách đó dạy Klee cách làm \"thuốc đẩy\", có thể khiến Bom Nảy nhảy cao hơn nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500228,
						705500229
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500228,
					"content": "Học... học cái này có ổn không đó?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500230
					]
				},
				{
					"id": 705500230,
					"content": "Không khó đâu... Có nhiều điểm giống với bom lắm, chỉ cần cẩn thận khi cắt gọt là được, giống như gọt bút màu ấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500231
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500231,
					"content": "Thời gian trước khi ngủ cũng rất quan trọng! Mẹ sẽ ngồi bên cạnh Klee, kể cho Klee nghe đủ chuyện trên trời dưới biển.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500232
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500232,
					"content": "Mẹ lấy ra một cái... một chiếc... à một ngọn đèn làm từ đá quý. \"Leng keng\" phát ra ánh sáng, chiếu lên trần nhà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500233
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500233,
					"content": "Trần nhà biến thành bảng kể chuyện luôn sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500234
					]
				},
				{
					"id": 705500234,
					"content": "Đúng rồi, đúng rồi! Chuyện kể đến đâu là những chấm sáng trên trần nhà cũng biến thành hình ảnh đẹp mắt theo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500235
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500235,
					"content": "Có lúc, mẹ đang kể dở thì ngủ gật, Klee liền lấy chăn đắp cho mẹ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500236
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500236,
					"content": "#Đợi Klee học được cách dùng ngọn đèn này, Klee sẽ đến kể chuyện cho {F#chị}{M#anh} Kỵ Sĩ Danh Dự nghe nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500237,
						705500238
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500237,
					"content": "Được thôi được thôi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500239
					]
				},
				{
					"id": 705500239,
					"content": "Hihi, giờ Klee đã nhớ được rất nhiều câu chuyện, cũng đã có thể mang những niềm vui mới mẻ tới cho mọi người rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500240
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500240,
					"content": "Buổi tối Klee có ăn gì nữa không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500241
					]
				},
				{
					"id": 705500241,
					"content": "Ừm! Sau khi về, Klee sẽ vừa đọc sách vừa ăn một ít... hạt khô rắc muối!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500242
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500242,
					"content": "Trước đây sau bữa tối Klee đều ăn bánh ngọt! Nhưng đội trưởng Jean nói là bánh ngọt nhiều đường quá, ăn trước khi đi ngủ thì không tốt, sẽ mập lên, còn bị đau răng nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500243
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500243,
					"content": "Nên mẹ đã nghe lời khuyên của dì Barbie, cho em ăn hạt, nói rằng sẽ giúp tăng cường trí nhớ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500244
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500244,
					"content": "Vị của hạt rất nhạt nhẽo, hơi giống nhai cỏ, nhưng mà rắc muối vào thì cũng không khó ăn lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500245
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500245,
					"content": "Cũng là một cách giải quyết đấy, dinh dưỡng và sức khỏe rất quan trọng!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500246
					]
				},
				{
					"id": 705500246,
					"content": "Hay là cùng nghĩ xem, có nguyên liệu nào vừa tốt cho sức khỏe lại vừa ngon ngọt không nhỉ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500247
					]
				},
				{
					"id": 705500247,
					"content": "Đúng rồi... Klee vẫn muốn ăn thứ gì đó ngọt ngọt! Lớp kem trên bánh mỏng một chút cũng được, hoặc là... cho thêm trái cây vào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500248
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500248,
					"content": "À nhớ rồi! Người bạn đeo kính của mẹ còn tặng cho mẹ một túi trái cây tròn vo từ Fontaine, gọi là Trái Bulle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500249
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500249,
					"content": "Klee đã ăn liền mấy trái, ngọt lắm! Đội trưởng Jean cũng thấy không vấn đề gì cả, vì: \"Độ ngọt của trái cây khác với độ ngọt của đường\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500250
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500250,
					"content": "Vậy nên, nếu nhất định phải ăn hạt, thì hình như có thể ngâm chúng trong nước ép trái cây nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500251
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500251,
					"content": "Kể ra thì, ba bữa mỗi ngày của Klee thường được sắp xếp thế nào?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500252
					]
				},
				{
					"id": 705500252,
					"content": "Ba bữa sao? Hihi, có khi Klee ăn tận năm bữa một ngày đấy. Thậm chí có lúc còn ăn bảy bữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500253
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500253,
					"content": "Nhiều thế à?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500254
					]
				},
				{
					"id": 705500254,
					"content": "Vì đi mạo hiểm rất tốn sức, mà ăn no quá thì chạy nhảy rất khó chịu... nên mỗi lần ăn một ít, rồi ăn nhiều bữa là được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500255
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500255,
					"content": "Trước đây anh Albedo phụ trách bữa ăn của Klee, món ăn trong hộp cơm luôn được sắp xếp đẹp mắt, như một bức tranh vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500256,
						705500257
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500256,
					"content": "Đúng là phong cách của Albedo rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500258
					]
				},
				{
					"id": 705500258,
					"content": "Nếu anh Albedo bận ở núi tuyết thì Klee cũng sẽ theo mọi người trong Đội Kỵ Sĩ đến doanh trại ăn cơm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500259
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500259,
					"content": "Doanh trại của anh Kaeya gọn gàng nhất, doanh trại của chị Amber đôi khi sẽ ở trên cây, vui cực! Cô Hertha nấu ăn ngon nhất luôn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500260
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500260,
					"content": "Sau khi mẹ về, còn có nhiều món ngon và thú vị hơn nữa. Chẳng hạn như kết hợp nhiều loại thịt cá và canh cá, làm thành những miếng vuông như pudding, gọi là Thạch Cá Ngũ Sắc!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500261,
						705500262
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500261,
					"content": "Nghe mà thấy đói luôn rồi đó...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500263
					]
				},
				{
					"id": 705500263,
					"content": "Bánh Chocolate giòn rụm cũng ngon! Đó là phát minh mới mà mẹ làm từ Chocolate và bánh quy! Hơi đắng một chút, nhưng giòn tan thơm phức, đắng xong sẽ càng ngọt hơn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500264
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500264,
					"content": "#Ăn vào là đầy năng lượng luôn... Để lần sau em mang một ít đến cho {F#chị}{M#anh} Kỵ Sĩ Danh Dự nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500265
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500265,
					"content": "#Được, {F#chị}{M#anh} biết nên điều chỉnh thế nào rồi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500266
					]
				},
				{
					"id": 705500266,
					"content": "Để pha thêm cho Klee một ly thật ngon nữa nhé!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500267
					]
				},
				{
					"id": 705500267,
					"content": "Nhanh vậy ạ? Tuyệt vời!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500268
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500268,
					"content": "Ly tiếp theo sẽ ngon đến mức nào nhỉ... Klee háo hức quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500262,
					"content": "Quả nhiên là nhà mạo hiểm vĩ đại...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500263
					]
				},
				{
					"id": 705500257,
					"content": "#{F#Chị}{M#Anh} cũng muốn nếm thử món do Albedo làm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500258
					]
				},
				{
					"id": 705500238,
					"content": "#{F#Chị}{M#Anh} sẽ đợi Klee!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500239
					]
				},
				{
					"id": 705500229,
					"content": "Nghe... nghe có vẻ rất khó nhỉ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500230
					]
				},
				{
					"id": 705500223,
					"content": "#{F#Chị}{M#Anh} sẽ cố gắng học để làm được kẹo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500224
					]
				},
				{
					"id": 705500219,
					"content": "Đúng là món đồ ngọt tuyệt vời...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500220
					]
				},
				{
					"id": 705500211,
					"content": "Được rồi, làm cho Klee thêm một ly siêu ngon nữa nhé!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500213
					]
				},
				{
					"id": 705500212,
					"content": "Klee muốn hương vị gì cũng pha được!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500213
					]
				},
				{
					"id": 705500204,
					"content": "#Tên đồ uống chưa hợp lắm, để {F#chị}{M#anh} đổi lại nhé!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500205
					]
				}
			]
		},
		{
