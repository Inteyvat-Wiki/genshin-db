			"dialogs": [
				{
					"id": 705500301,
					"content": "Tèn ten! Xong rồi. Ly mới này Klee chắc chắn sẽ thích!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500302
					]
				},
				{
					"id": 705500302,
					"content": "Waa! Kẹo Dodoco cũng có trên đồ uống luôn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500303
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500303,
					"content": "Trong ly có rất nhiều màu cam đỏ, Dodoco như đang nằm trên đám mây trắng vậy. Đây chính là Trời Đẹp cao cấp hơn này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500304
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500304,
					"content": "Klee nếm thử xem nhé?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500305
					]
				},
				{
					"id": 705500305,
					"content": "Ưm ưm... Ngon quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500306
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500306,
					"content": "Klee phải uống thật chậm rãi, không thể ực một hơi rồi bỏ lỡ hương vị tuyệt vời được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500307
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500307,
					"content": "#Kỳ diệu quá... Cứ như là {F#chị}{M#anh} Kỵ Sĩ Danh Dự đã nhốt ánh mặt trời vào trong cốc nước ép ấy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500308
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500308,
					"content": "Cảm giác mệt mỏi vì vui chơi biến mất hết rồi, ấm áp quá, nhưng mà lại rất yên bình nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500309
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500309,
					"content": "#...Phù! {F#Chị}{M#Anh} Kỵ Sĩ Danh Dự giỏi quá đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500310,
						705500311
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500310,
					"content": "Vậy thì Klee đặt tên cho ly đồ uống này nhé?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500312
					]
				},
				{
					"id": 705500312,
					"content": "Thật sao? Để em nghĩ xem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500313
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500313,
					"content": "Trời đẹp, tâm trạng tốt, thì Dodoco sẽ hát nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500314
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500314,
					"content": "Dodoco hát, Klee cũng hát theo... Cho nên, gọi nó là... Hợp Xướng Dodoco Ngày Nắng đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500315,
						705500316
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500315,
					"content": "#Tên hay đấy, {F#chị}{M#anh} ủng hộ!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500317
					]
