					}
				]
			},
			"dialogs": [
				{
					"id": 705500101,
					"content": "#Ơ? Ồ ồ? Là {M#anh}{F#chị} Kỵ Sĩ Danh Dự kìa! Tuyệt vời!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500102,
						705500103
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500102,
					"content": "Hay quá! Là Klee này!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500104
					]
				},
				{
					"id": 705500104,
					"content": "Haha, chị Eula nói với em là cô Hertha đã tìm được một trợ thủ đắc lực...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500105
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500105,
					"content": "#Thấy {F#chị}{M#anh} Kỵ Sĩ Danh Dự ở đây là em biết chắc đây sẽ là tiệm đồ uống ngon nhất Teyvat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500106,
						705500107
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500106,
					"content": "Cảm ơn Klee nhé, sau này sẽ làm được thôi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500108
					]
				},
				{
					"id": 705500108,
					"content": "Vẫn... vẫn chưa phải sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500109
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500109,
					"content": "#Vậy thì... trong số các tiệm đồ uống Klee từng đến, {F#chị}{M#anh} Kỵ Sĩ Danh Dự là giỏi nhất!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500110
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500110,
					"content": "#Dù sao thì {F#chị}{M#anh} Kỵ Sĩ Danh Dự có pha đồ uống gì, Klee chắc chắn đều sẽ thấy ngon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500111,
						705500112
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500111,
					"content": "Lần này Klee phải nghiêm khắc hơn một chút mới được!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500113
					]
				},
				{
					"id": 705500113,
					"content": "#Ơ... Ơ! Thật ạ? Nhưng mà Klee không nghiêm khắc với {F#chị}{M#anh} được ấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500114
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500114,
					"content": "Để em nghĩ xem... Vậy thì em sẽ học theo anh Albedo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500115
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500115,
					"content": "Khi trực tiếp sửa bài cho chú Timaeus, anh Albedo rất nghiêm túc! Klee nghe hiểu hết từng lời anh ấy nói luôn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500116,
						705500117
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500116,
					"content": "Được được, vậy Klee làm giáo viên nhé!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500118
					]
				},
				{
					"id": 705500118,
					"content": "Hihi... vậy thì Klee phải gọi món thật oách mới được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500119
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500119,
					"content": "#Lát nữa Klee phải đi nổ cá cùng mẹ rồi... {F#Chị}{M#Anh} đừng nói với đội trưởng Jean nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500120
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500120,
					"content": "#Hôm nay Klee và mẹ đã nổ được siêu nhiều cá... {F#Chị}{M#Anh} đừng nói với đội trưởng Jean nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500121
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500121,
					"content": "Mấy ngày nay Klee được chơi với mẹ nhiều, vui lắm luôn! Bị nhốt cũng không sao cả!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500122
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500122,
					"content": "Vì vậy, Klee muốn gọi một ly Trời Đẹp... Trời quang mây tạnh, ánh nắng ấm áp, tâm trạng chắc chắn sẽ rất tuyệt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500123,
						705500124
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500123,
					"content": "Được thưa cô giáo Klee, em sẽ làm ngay đây!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500125
					]
				},
				{
					"id": 705500125,
					"content": "Hihi, không biết sẽ là mùi vị thế nào đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500124,
					"content": "Hiểu rồi đại sư Klee, sẽ làm ngay đây!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500125
					]
				},
				{
					"id": 705500117,
					"content": "Được được, đại Giả Kim Thuật Sĩ Klee!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500118
					]
				},
				{
					"id": 705500112,
					"content": "Lần này Klee cứ chê thoải mái đi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500113
					]
				},
				{
					"id": 705500107,
					"content": "#Cảm ơn Klee, {F#chị}{M#anh} sẽ cố gắng hơn nữa!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500108
					]
				},
				{
					"id": 705500103,
					"content": "Tuyệt vời! Klee đến chơi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500104
					]
				}
			]
		},
