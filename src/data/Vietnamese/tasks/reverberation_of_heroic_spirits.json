			"dialogs": [
				{
					"id": 761420301,
					"content": "Này, Chernov, cậu ổn chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420302
					],
					"speakerTitle": "???"
				},
				{
					"id": 761420302,
					"content": "Vẫn còn cầm được đao... Đội trưởng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420303
					],
					"speakerTitle": "Chernov"
				},
				{
					"id": 761420303,
					"content": "Shonokovych... Filaev... hai người không sao chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420304
					],
					"speakerTitle": "???"
				},
				{
					"id": 761420304,
					"content": "Ưm... Hình như chân tôi bị gãy rồi, may mà vẫn còn sống. Cậu đã đếm chưa? Tôi đã giết được bao nhiêu tên rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420305
					],
					"speakerTitle": "Shonokovych"
				},
				{
					"id": 761420305,
					"content": "Rốt... Rốt cuộc là có bao nhiêu ma vật vậy, chúng ta... chúng ta sẽ không chết ở đây chứ, đội trưởng?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420306
					],
					"speakerTitle": "Filaev"
				},
				{
					"id": 761420306,
					"content": "Cậu nói gì thế? Nhất định chúng ta sẽ thoát ra an toàn! Đừng lo, trinh sát chắc đã về thành báo với bố già rồi, quân tiếp viện đang trên đường đến đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420307
					],
					"speakerTitle": "???"
				},
				{
					"id": 761420307,
					"content": "Lại nữa rồi, lũ Cuộc Săn Hoang Dã này đúng là không có hồi kết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420308
					],
					"speakerTitle": "???"
				},
				{
					"id": 761420308,
					"content": "Này! Cầm chắc vũ khí và đèn của mình đi, chúng ta còn một trận chiến khó khăn phía trước đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "???"
				}
			]
		},
