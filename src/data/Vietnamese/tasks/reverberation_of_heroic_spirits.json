			"dialogs": [
				{
					"id": 761420401,
					"content": "Filaev, đừng sợ, tôi và Patoli sẽ đưa cậu ra khỏi đây. Xốc lại tinh thần đi, như một Người Giữ Đèn thực thụ, cầm chắc kiếm vào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420402
					],
					"speakerTitle": "???"
				},
				{
					"id": 761420402,
					"content": "Tôi... tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420403
					],
					"speakerTitle": "Filaev"
				},
				{
					"id": 761420403,
					"content": "Kế hoạch gì ư? Làm gì có kế hoạch nào hả Patoli. Nếu đây là kết cục, thì tôi sẽ chiến đấu đến cùng ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420404
					],
					"speakerTitle": "???"
				},
				{
					"id": 761420404,
					"content": "Mọi người là đội ngũ tuyệt vời nhất. Dù kết quả có ra sao, được chiến đấu cùng mọi người chính là niềm vinh dự của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420405
					],
					"speakerTitle": "???"
				},
				{
					"id": 761420405,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420406
					],
					"speakerTitle": "Filaev"
				},
				{
					"id": 761420406,
					"content": "Đây cũng là vinh dự của chúng tôi, đội trưởng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420407
					],
					"speakerTitle": "Filaev"
				},
				{
					"id": 761420407,
					"content": "Nào, chuẩn bị phòng thủ! Cho chúng nếm thử sức mạnh của \"Ngựa Gió Lạnh\" đi!",
