			"dialogs": [
				{
					"id": 221110101,
					"content": "Về ủy thác mới...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110102,
					"content": "Xin chào, Nhà Mạo Hiểm. Sự tích mạo hiểm của bạn, đã được truyền khắp Mondstadt rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110103
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110103,
					"content": "Cứ tiếp tục như vậy bạn nhất định sẽ là một nhà mạo hiểm vĩ đại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110104,
						221110107
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110104,
					"content": "Có chuyện gì sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221110105
					]
				},
				{
					"id": 221110105,
					"content": "Nếu bạn muốn trở thành Nhà Mạo Hiểm vĩ đại thì không thể cứ mạo hiểm ở những chỗ quen thuộc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110106
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110106,
					"content": "Bạn đã có kinh nghiệm mạo hiểm phong phú như vậy, chi bằng đi thám hiểm nơi khác xem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110110
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110110,
					"content": "Hãy giữ cẩn thận bức thư này, đem đến cho tiểu thư Katheryne ở cảng Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110111,
						221110113
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110111,
					"content": "...Katheryne... ở cảng Liyue?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221110112
					]
				},
				{
					"id": 221110112,
					"content": "Đúng vậy, bạn sẽ dễ dàng tìm thấy cô ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110115
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110115,
					"content": "Với phong thư này, cô ấy cũng sẽ cung cấp các dịch vụ chuyên nghiệp nhất cho các hoạt động mạo hiểm của bạn như tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110116
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110116,
					"content": "Nếu như bạn quay trở lại thành Mondstadt, tôi cũng sẽ tiếp tục phục vụ bạn, hãy yên tâm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110117
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110117,
					"content": "Đúng rồi, xin vui lòng không tự ý mở thư, nếu không có thể một thứ gì đó sẽ bị rơi mất, gây ra những rắc rối không cần thiết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110118
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110118,
					"content": "Hướng về những ngôi sao và vực sâu, hãy tiến bước về phía trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110113,
					"content": "Vậy sau này nên gọi bạn là \"Katheryne của thành Mondstadt\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221110114
					]
				},
				{
					"id": 221110114,
					"content": "Bạn có thể chọn một biệt hiệu phù hợp với công việc mạo hiểm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110115
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110107,
					"content": "Chỉ có điều Mondstadt thì...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221110108
					]
				},
				{
					"id": 221110108,
					"content": "Trước mắt, bạn cũng chỉ có thể mở rộng phạm vi mạo hiểm ở Mondstadt mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110109
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110109,
					"content": "Có điều, bạn sẽ rất nhanh tiến bước ra thế giới ngoài kia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110110
					],
					"speakerTitle": "Katheryne"
				}
			]
		},
