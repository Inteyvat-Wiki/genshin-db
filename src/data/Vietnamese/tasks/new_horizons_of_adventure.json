			"dialogs": [
				{
					"id": 221110201,
					"content": "Có một bức thư cho bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110202
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110202,
					"content": "Hướng về những ngôi sao và vực sâu! Chào mừng đến với Hiệp Hội Nhà Mạo Hiểm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110203
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110203,
					"content": "Bức thư này là dành cho bạn...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221110204
					]
				},
				{
					"id": 221110204,
					"content": "Thư? Đưa tôi xem, ồ...bạn là Nhà Mạo Hiểm đến từ Mondstadt à.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110205
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110205,
					"content": "Í? Đây là... bồ công anh? Sao trong thư lại kèm theo thứ này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110206
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110206,
					"content": "Nhà Mạo Hiểm bạn muốn chứng minh rằng bạn đến từ Mondstadt bằng cách kẹp bồ công anh trong thư?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110207
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110207,
					"content": "Bạn nghĩ nhiều rồi, thông tin trong thư này là đủ để chứng minh danh tính và nguồn gốc của bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110208,
						221110210
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110208,
					"content": "Không phải tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221110209
					]
				},
				{
					"id": 221110209,
					"content": "Nhưng đây cũng không phải chuyện quan trọng gì, đừng để ý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110214
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110214,
					"content": "Từ bức thư của Hiệp Hội Nhà Mạo Hiểm Mondstadt có thể thấy bạn rất có kinh nghiệm mạo hiểm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110215
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110215,
					"content": "Vậy chắc bạn cũng chuẩn bị xong rồi, đồng ý nhận các ủy thác của Hiệp Hội Nhà Mạo Hiểm Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110216
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110216,
					"content": "Hướng về những ngôi sao và vực sâu, những chuyến mạo hiểm mới đang đợi bạn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110210,
					"content": "Lẽ nào là Katheryne...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221110211
					]
				},
				{
					"id": 221110211,
					"content": "Katheryne? À, bạn nói là \"Katheryne của thành Mondstadt\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110212
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110212,
					"content": "Cô ấy tại sao cô ấy lại kẹp bồ công anh trong thư nhỉ? Lạ thật... bồ công anh không có tác dụng gì với việc mạo hiểm",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110213
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110213,
					"content": "Nhưng đây cũng không phải chuyện quan trọng gì, đừng để ý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110214
					],
					"speakerTitle": "Katheryne"
				}
			]
