			},
			"dialogs": [
				{
					"id": 726900101,
					"content": "Hai vị, ngày hôm nay cuối cùng đã tới rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900102
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726900102,
					"content": "Các bạn đã lĩnh ngộ được những thứ tinh tuý của Bóng Hoa Sân Đình rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900103
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726900103,
					"content": "Đã đến lúc thử thách thí luyện nghệ thuật cắm hoa rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900104
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726900104,
					"content": "Đợi đã? Chúng tôi đã lĩnh ngộ được tinh túy rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726900105,
					"content": "Thí luyện này chính là chủ đề khó nhất phải không! Tự nhiên tôi thấy sợ sợ sao á...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726900106,
					"content": "Rõ ràng là mới làm quen với nghệ thuật cắm hoa này vẫn chưa được bao lâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726900107
					]
				},
				{
					"id": 726900107,
					"content": "Tay nghề cắm hoa đúng là cần rèn luyện lâu dài, mà quy hoạch kết cấu cho \"vườn hoa\" thì lại cần nhiều hiểu biết và cảm hứng hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900108
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726900108,
					"content": "Chỉ nói về vế sau, hai bạn đã thể hiện thiên phú xuất chúng, không cần luyện tập thêm bằng \"chủ đề hoa\" nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900109
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726900109,
					"content": "Có lẽ là vì, hai bạn đã trải qua chuyến hành trình dài, từng nhìn thấy những khung cảnh mà tôi không thể nào tưởng tượng được, nên mới có thể có được tâm tình khác với những người bình thường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900110
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726900110,
					"content": "Là, là như vậy sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726900111,
					"content": "#Nói ra thì, {NICKNAME}, chúng ta quả thực là đã đi qua không ít nơi, thì ra là trong quá trình cùng nhau thám hiểm, chúng ta cũng đã có thêm nhiều cảm hứng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726900112,
					"content": "Thời gian qua, chúng ta liên tục học cách cắm hoa, đã tiêu tốn mất bao nhiêu cảm hứng rồi nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900113,
						726900114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726900113,
					"content": "Hành trình vẫn sẽ còn tiếp tục.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726900115
					]
				},
				{
					"id": 726900115,
					"content": "Rất có lý đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726900116,
					"content": "Cảm ơn cô, tiểu thư Fushizome! Nếu không có cô chỉ dẫn thì chúng tôi cũng sẽ không phát hiện ra tài năng này đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726900117,
					"content": "Đừng khách sáo. Vậy thì hãy dùng \"vườn hoa\" đẹp nhất để vẽ nên cái kết cho hành trình trải nghiệm cắm hoa này nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900118,
						726900122
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726900118,
					"content": "Mời ra đề.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726900119
					]
				},
				{
					"id": 726900119,
					"content": "Vậy thì, chủ đề hoa hôm nay là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900120
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726900120,
					"content": "\"Nghiêng Bóng Cầu Vồng, Điểm Tô Hương Sắc\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900121
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726900121,
					"content": "Tôi rất mong chờ tác phẩm \"Bóng Hoa Sân Đình\" nghệ thuật tuyệt vời của bạn đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726900122,
					"content": "Tôi còn chuyện khác phải làm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726900123
					]
				},
				{
					"id": 726900123,
					"content": "Không sao. Khi cắm hoa cần phải tâm bình khí lặng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900124
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726900124,
					"content": "Đợi khi hai bạn hoàn thành công việc, loại bỏ tạp niệm. Chắc chắn sẽ tạo ra được một vườn hoa hoàn chỉnh như yêu cầu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726900114,
					"content": "Cảm hứng cũng sẽ ngày càng nhiều thêm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726900115
					]
				}
			]
		},
