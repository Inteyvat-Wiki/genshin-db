			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zakariya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230380101,
					"content": "Nhà Lữ Hành! Nhà Lữ Hành, xin mau mau qua đây, tôi có việc muốn nhờ bạn giúp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380102
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230380102,
					"content": "Xảy ra chuyện gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230380103
					]
				},
				{
					"id": 230380103,
					"content": "Bạn vẫn còn nhớ Maruf chứ? Chính là vị bác sĩ Làng Aaru đó, người mà trước đó nhờ bạn đến tìm tôi xin đơn thuốc ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380104
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230380104,
					"content": "Anh ta đã tự mình uống thử một bát thuốc tự nấu, kết quả là nôn thốc nôn tháo suốt mấy ngày liền.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380105
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230380105,
					"content": "Tôi hỏi qua thì mới biết, tại bệnh nhân uống nước thuốc mấy ngày không thấy hiệu quả, anh ta đã đột nhiên nảy ra ý tưởng, muốn tự mình sửa đổi đơn thuốc một chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380106
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230380106,
					"content": "Thật không biết anh ta đã thêm vị thuốc gì vào nước thuốc nữa, làm cho chính mình trở nên như bây giờ đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380107
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230380107,
					"content": "Haiz, nếu như anh ta chỉ điều chỉnh tỉ lệ thuốc và cách đun thuốc trên cơ sở nước thuốc ban đầu, chắc chắn sẽ không xảy ra cơ sự này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380108
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230380108,
					"content": "Anh ta cũng chẳng phải lần đầu tiên bị khổ sở thế này, sao mà lại còn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380109
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230380109,
					"content": "Thôi kệ đi, có lẽ anh ta cũng có những nỗi niềm khó nói của mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380110
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230380110,
					"content": "Nhà Lữ Hành, nếu như bạn đồng ý, có thể giúp tôi lấy một chút nguyên liệu thuốc về được không? Lần này tôi sẽ tự làm sẵn thuốc rồi nhờ bạn trực tiếp mang đến cho Maruf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380111,
						230380112
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230380111,
					"content": "Cứ giao cho tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230380114
					]
				},
				{
					"id": 230380114,
					"content": "Đơn thuốc lần này Maruf điều chỉnh, là đơn thuốc lần trước tôi kê cho anh ấy để điều trị đau đầu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380115
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230380115,
					"content": "Trong đơn thuốc của tôi vẫn thiếu 3 Quả Xích Niệm, phiền bạn giúp tôi đi hái 3 quả về đây nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230380112,
					"content": "Anh ấy trước đây cũng làm như thế này sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230380113
					]
				},
				{
					"id": 230380113,
					"content": "Đúng thế, tôi cũng quên đây là lần thứ mấy rồi. Vẫn may anh ta không táy máy thêm vị thuốc nào có dược tính mạnh, nếu không thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380114
					],
					"speakerTitle": "Zakariya"
				}
			]
		},
