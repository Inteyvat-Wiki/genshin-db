			"dialogs": [
				{
					"id": 730420601,
					"content": "Chơi vui thật đấy! Chơi trò chơi với Nara Vàng, Arakanta vui lắm! Hơn nữa, Nara nhanh quá, giỏi quá, y như Hổ Lông Dài thật ấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730420602
					],
					"speakerTitle": "Arakanta"
				},
				{
					"id": 730420602,
					"content": "Chơi cùng với các Aranara khác, Hổ Lông Dài thật sự thì cũng vui đấy, nhưng chơi với bạn mới, bạn Nara thì càng vui hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730420603
					],
					"speakerTitle": "Arakanta"
				},
				{
					"id": 730420603,
					"content": "Tại sao Hổ Lông Dài lại đuổi theo Aranara?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730420604
					]
				},
				{
					"id": 730420604,
					"content": "Hổ Lông Dài với Aranara đều là bạn bè, bạn bè sẽ chơi với nhau. Nhưng Arakanta phát hiện Nara rất sợ Hổ Lông Dài. Cho nên tôi đã nghĩ ra một trò chơi mới cho Lễ Hội Utsava!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730420605
					],
					"speakerTitle": "Arakanta"
				},
				{
					"id": 730420605,
					"content": "Cảm ơn bạn, Nara. Xin tặng hoa của Aranara tới Nara Vàng!",
