					"nextDialogs": [
						760300305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300305,
					"content": "Huhu, đây là đâu... Mẹ ơi... Con muốn về nhà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300306
					],
					"speakerTitle": "Rijeka"
				},
				{
					"id": 760300306,
					"content": "Xem ra là người của Dòng Dõi Sương Nguyệt. Em ấy bị lạc sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300307,
					"content": "Để tôi đi giúp em ấy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760300308
					]
				},
				{
					"id": 760300308,
					"content": "Thật sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300309
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760300309,
					"content": "Hả? Thì nhìn thế nào cũng cần phải giúp mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300310,
					"content": "#Tôi nhớ là Dòng Dõi Sương Nguyệt rất đề phòng người từ nơi khác đến. Muộn thế này rồi, trên đầu {F#cô}{M#cậu} lại không có sừng, nếu em ấy bị dọa sợ mà chạy đi thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300311
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760300311,
					"content": "Cũng có lý. Nhưng cũng không thể mặc kệ được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300312
					],
					"speakerTitle": "Paimon"
