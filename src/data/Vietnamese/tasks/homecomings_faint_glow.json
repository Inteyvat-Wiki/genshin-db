			"dialogs": [
				{
					"id": 760300101,
					"content": "Ồ! Bầu không khí hôm nay có chút khác thường, Columbina đang trang trí vườn hoa này sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300102,
					"content": "Không phải tôi, mà là chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300103
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760300103,
					"content": "Là... Kuuhenki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300104,
					"content": "Loại đá này sau khi hấp thụ sức mạnh Kuuvahki sẽ tỏa ra ánh sáng, các Kuuhenki rất thích.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300105
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760300105,
					"content": "Cho nên chúng... đặt đá dưới đất để chơi à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300106,
					"content": "Qua đây nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300107
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760300107,
					"content": "Hửm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300108,
					"content": "Ồ! Thì ra là một bức tranh khi nhìn từ trên cao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300109,
					"content": "Nhưng hình như thiếu mất một phần...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760300110
					]
				},
				{
					"id": 760300110,
					"content": "Chừng này không đủ, để tôi đi nhặt thêm một ít.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300111
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760300111,
					"content": "Hmm? Cô muốn ra ngoài nhặt thêm sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300112,
					"content": "Tôi biết một nơi không tệ. Nơi đó ánh trăng chiếu rọi, có rất nhiều loại đá giống như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300113
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760300113,
					"content": "Cần chúng tôi đi cùng không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760300114
					]
				},
				{
					"id": 760300114,
					"content": "Được đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300115
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760300115,
					"content": "Ừm, vậy thu thập thêm đi. Chúng tôi cũng muốn thấy bức tranh hoàn chỉnh.",
					"roleType": "TALK_ROLE_NPC",
