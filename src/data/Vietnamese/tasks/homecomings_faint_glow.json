				},
				{
					"id": 760300303,
					"content": "Huhu... Huhu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300304
					],
					"speakerTitle": "Rijeka"
				},
				{
					"id": 760300304,
					"content": "Aaahh! Có người tới, mau trốn đi!",
