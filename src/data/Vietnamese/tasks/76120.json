				},
				{
					"id": 761200304,
					"content": "Nghĩ lại thì tranh của Maalaus đã bao quát hết toàn bộ câu chuyện của Columbina từ khi sinh ra đến tận bây giờ luôn đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200305,
					"content": "Câu chuyện vẫn chưa kết thúc đâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761200306
					]
				},
				{
					"id": 761200306,
					"content": "Ừm! Tôi cũng chưa xem đủ những tác phẩm của họa sĩ tài ba này đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200307,
					"content": "!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200308
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 761200308,
					"content": "Ô! Vẽ xong rồi sao? Tốc độ vẫn nhanh như mọi khi nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200309,
					"content": "Để xem nào... Woa! Đẹp quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200310,
					"content": "Thì ra từ mặt trăng nhìn về Teyvat lại đẹp thế này sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200311,
					"content": "Hah... Giờ tôi đã hiểu tại sao Maalaus nói tôi đã thay đổi rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200312
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761200312,
					"content": "Hmm? Tại sao thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200313,
					"content": "Nhìn bức tranh này, tôi đã nhớ ra rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200314
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761200314,
					"content": "Lúc đó ngồi trên mặt trăng nhìn về Teyvat, trong lòng tôi nghĩ, trước đây tôi luôn tìm kiếm một \"ngôi nhà\" thuộc về mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200315
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761200315,
					"content": "Nhưng giờ tôi chợt nhận ra mình có tới hai \"ngôi nhà\". Và cả hai đều rất đẹp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200316
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761200316,
					"content": "Lúc đó tôi đã hiểu ra, có lẽ \"ngôi nhà\" chính là nơi có những thứ trân quý, có người thân và bạn bè yêu mến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200317
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761200317,
					"content": "Cảm tưởng rất thú vị.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761200318
					]
				},
				{
					"id": 761200318,
					"content": "#Cảm ơn {F#cô}{M#cậu}, sau này tôi muốn thường xuyên dẫn các Kuuhenki lên mặt trăng chơi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200319
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761200319,
					"content": "Cũng hoan nghênh hai người, sau này hãy cùng đến thăm \"ngôi nhà thứ hai\" của tôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Columbina"
				}
			]
