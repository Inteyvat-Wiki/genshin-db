			"dialogs": [
				{
					"id": 761200101,
					"content": "...Đây, cầm lấy này, vậy là phần của tôi được rồi nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200102
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761200102,
					"content": "Woa! Là bảng vẽ! Xem ra, chẳng lẽ là...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200103,
					"content": "Ừm, tới đúng lúc lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200104
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761200104,
					"content": "~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200105
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 761200105,
					"content": "Là họa sĩ Maalaus! Lâu rồi không gặp!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200106,
					"content": "Đến đúng lúc là...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761200107
					]
				},
				{
					"id": 761200107,
					"content": "Tôi vừa mới đưa Maalaus lên mặt trăng một chuyến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200108
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761200108,
					"content": "Thật ngưỡng mộ giọng điệu của cô đấy... Nói nhẹ nhàng như chỉ là đi dạo ở vườn hoa bên cạnh vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200109,
					"content": "Nhưng mà lên mặt trăng để làm gì vậy? Đi ngắm cảnh à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200110,
					"content": "Đúng một nửa thôi. Chúng tôi ở trên mặt trăng đã chọn được địa điểm để tổ chức triển lãm tranh rồi, hai người còn nhớ chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200111
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761200111,
					"content": "Ồ! Tôi nhớ rồi, triển lãm chủ đề Nguyệt Thần của họa sĩ tài ba Maalaus! Tới lúc đó nhất định phải gọi chúng tôi tới đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200112,
					"content": "Ừm, tất nhiên rồi. Hơn nữa, Maalaus có vẻ rất nhạy cảm với những thay đổi dù là rất nhỏ ở quanh mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200113
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761200113,
					"content": "Nó nói, sau khi tôi từ mặt trăng trở về đã thay đổi rất nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200114
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761200114,
					"content": "Nên muốn tôi dẫn đi xem thử xem trên mặt trăng có thứ gì đặc biệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200115
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761200115,
					"content": "Ồ! Quả không hổ danh là nghệ sĩ tài ba...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200116,
					"content": "Vậy thứ đặc biệt đó là...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761200117
					]
				},
				{
					"id": 761200117,
					"content": "Tôi cũng không biết nữa. Tôi đã đưa Maalaus đi rất nhiều nơi rồi, nhưng có vẻ đều chưa vừa ý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200118
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761200118,
					"content": "#Cho đến khi tôi đưa nó đến gần phi thuyền của {F#cô}{M#cậu}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200119,
						761200120
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761200119,
					"content": "Phi thuyền!?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761200121
					]
				},
				{
					"id": 761200121,
					"content": "Nhưng khi dẫn nó lại gần, tôi phát hiện ra nó không hề quan tâm đến phi thuyền.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200122
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761200122,
					"content": "Hả? Thế thì là gì chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200123,
					"content": "~!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200124
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 761200124,
					"content": "Ủa? Nó đang bay vòng quanh Columbina kìa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200125,
					"content": "Haha, lúc đó nó đã thế đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200126
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761200126,
					"content": "Tôi nghĩ, điều nó thật sự hứng thú chính là dáng vẻ của tôi khi nhìn thấy phi thuyền.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200127
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761200127,
					"content": "Dáng vẻ... của cô?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200128,
					"content": "#Ừm, tôi chợt nhớ đến cảnh tượng khi cùng {NICKNAME} đến đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200129
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761200129,
					"content": "#Cùng ngồi trên thuyền, ngắm nhìn Teyvat. {M#Cậu ấy}{F#Cô ấy} đã tìm ra sự thật về quá khứ, còn tôi đã tìm thấy \"ngôi nhà\" của mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200130
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761200130,
					"content": "Chỉ cần nhớ lại những điều này, tôi liền cảm thấy an tâm, hay nói đúng hơn là cảm giác hạnh phúc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200131
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761200131,
					"content": "~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200132
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 761200132,
					"content": "Ừm, nói đúng đấy. Đây là cảm giác mà trước đây tôi chưa từng có.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200133
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761200133,
					"content": "Nên tôi đã kể cho Maalaus nghe câu chuyện của chúng ta, cả những chuyện xảy ra sau khi chúng ta lên mặt trăng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200134
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761200134,
					"content": "Nghe xong, nó có vẻ rất hài lòng, như thể đã tìm thấy cảm hứng vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200135
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761200135,
					"content": "Ra là vậy. Thế thì giờ là lúc họa sĩ tài ba Maalaus cầm bút vẽ rồi nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200136,
					"content": "Lúc đó hai người không cho tôi lên cùng, tôi cũng rất tò mò rốt cuộc Maalaus sẽ vẽ ra phong cảnh thế nào đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200137,
					"content": "Lần này sẽ cần thứ gì để làm màu vẽ đây?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761200138
					]
				},
				{
					"id": 761200138,
					"content": "Lần này có hơi đặc biệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200139
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761200139,
					"content": "~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200140
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 761200140,
					"content": "Maalaus nói, nó muốn có màu vẽ chỉ thuộc về chúng ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200141
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761200141,
					"content": "Hả? Vậy là sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200142
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200142,
					"content": "#Đại khái là... khi {F#cô}{M#cậu} nhìn thấy món đồ này, {F#cô}{M#cậu} sẽ nhớ về chuyến hành trình, trong lòng sẽ hiện lên những thành quả và niềm vui mà nó mang lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200143
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761200143,
					"content": "Đừng lo, Maalaus chỉ muốn xem thử và cảm nhận một chút thôi. Nó sẽ không dùng thứ quý giá như vậy để làm màu vẽ đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200144
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761200144,
					"content": "Columbina đã đưa thứ gì ra vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761200145
					]
				},
				{
					"id": 761200145,
					"content": "Đất trên mặt trăng, còn cả tấm thiệp Đêm Cầu Nguyệt mà hai người đã tặng tôi nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200146
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761200146,
					"content": "#Ồ, chỉ cần là thứ có thể đại diện cho chuyến phiêu lưu này là được! Vậy để {NICKNAME} chọn nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200120,
					"content": "Thế thì đúng là có hơi đặc biệt thật...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761200121
					]
				}
			]
		},
