						],
						"pointId": 13639
					}
				]
			},
			"dialogs": [
				{
					"id": 760780201,
					"content": "Ồ, là ngọn đèn. Vật dụng tùy thân quan trọng của Người Giữ Đèn, chìa khóa để xua đuổi Cuộc Săn Hoang Dã...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780202
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760780202,
					"content": "Đèn vẫn còn, thậm chí trên chụp đèn còn sót lại khí tức của Cuộc Săn Hoang Dã, nhưng người cầm đèn lại không ở gần đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780203
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760780203,
					"content": "Tuy có chút đáng tiếc, nhưng không khó để tưởng tượng ra những gì đã xảy ra ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780204
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760780204,
					"content": "Sự hy sinh của Người Giữ Đèn có lúc rất lặng lẽ, mỗi lần phát hiện sự ra đi của đồng đội một cách bất ngờ như thế này tôi đều thấy đáng tiếc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780205
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760780205,
					"content": "...Đồng chí vô danh, ngọn đèn anh để lại cứ để tôi trông coi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780206
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760780206,
					"content": "Thân nó sẽ được lau sạch, ngọn lửa của nó sẽ được thắp lại, rồi giao cho Người Giữ Đèn tiếp theo đã thề sẽ bảo vệ Nod-Krai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780207
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760780207,
					"content": "Flins lau sạch ngọn đèn rồi cẩn thận cất đi.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						760780208
					]
				},
				{
					"id": 760780208,
					"content": "Đây chắc là nguyên nhân Cuộc Săn Hoang Dã không thể hoàn toàn biến mất. Ngọn đèn này cứ để tôi tạm thời cất giữ, cho đến khi có người từ tổng bộ đến thu hồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780209
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760780209,
					"content": "...Dưới ngọn đèn còn có thứ gì đó thì phải.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780210
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760780210,
					"content": "Là di vật của người đồng nghiệp này nhỉ. Có lẽ nên để nó cùng một chỗ với ngọn đèn thì hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flins"
				}
			]
		},
