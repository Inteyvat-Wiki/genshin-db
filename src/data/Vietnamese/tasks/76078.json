			"dialogs": [
				{
					"id": 760780101,
					"content": "Thông thường, một khi đã tiêu diệt hết tất cả ma vật sinh ra từ Cuộc Săn Hoang Dã thì khí tức ô uế sẽ tan đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780102
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760780102,
					"content": "Nhưng khe nứt này vẫn còn tồn tại. Tình trạng này không bình thường lắm, nhưng cũng không phải là chưa từng có tiền lệ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780103
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760780103,
					"content": "Tìm thử ở gần đây đi, chắc sẽ có thứ gì đó dính ô uế vẫn còn sót lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flins"
				}
			]
		},
		{
			"id": 7607802,
			"completionStepIds": [
				7607804
