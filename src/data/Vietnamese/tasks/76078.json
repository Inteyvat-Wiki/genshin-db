			},
			"dialogs": [
				{
					"id": 760780501,
					"content": "Ở đây cũng có Đèn Lời Thề, có lẽ là di vật của tiền bối nào đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780502
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760780502,
					"content": "Trên đèn vẫn còn vết nhơ của Cuộc Săn Hoang Dã, nghĩ thôi cũng biết ở đây đã xảy ra chuyện gì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780503
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760780503,
					"content": "Kể từ ngày cầm lên Đèn Lời Thề, mạng sống của chúng ta đã gắn liền với ngọn lửa trong đèn, cho đến... khoảnh khắc hoàn thành sứ mệnh đã định.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780504
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760780504,
					"content": "Xin kính chào, người chiến binh đã chiến đấu đến giây phút cuối cùng vì hòa bình và bình yên của Nod-Krai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780505
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760780505,
					"content": "Vậy thì tôi sẽ thay ngài giữ gìn ngọn đèn, hãy yên tâm, vương miện của anh linh sẽ được giữ lại cho ngài.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780506
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760780506,
					"content": "Tôi sẽ mang nó về tổng bộ, thắp sáng lại và trao cho người có thể kế thừa ý chí này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780507
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760780507,
					"content": "Illuga lau sạch ngọn đèn rồi trịnh trọng cất đi.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						760780508
					]
				},
				{
					"id": 760780508,
					"content": "Vậy là Cuộc Săn Hoang Dã ở đây đã được dọn sạch, linh hồn của tiền bối cũng đã có nơi an nghỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illuga"
				}
