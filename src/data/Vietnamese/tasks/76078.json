			},
			"dialogs": [
				{
					"id": 760780401,
					"content": "Theo kinh nghiệm trước đây, sau khi tiêu diệt hết ma vật xung quanh, khe nứt ở đây lẽ ra phải tự động biến mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780402
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760780402,
					"content": "Nhưng tại sao khí tức của Cuộc Săn Hoang Dã ở đây vẫn không tan biến... Thật kỳ lạ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780403
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760780403,
					"content": "Chẳng lẽ có nơi nào đó mình chưa để ý đến đã bị Cuộc Săn Hoang Dã vấy bẩn rồi ư?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illuga"
				}
