			"dialogs": [
				{
					"id": 400741201,
					"content": "Megistus... đúng là làm khó người ta mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741202
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400741202,
					"content": "Đừng an ủi tôi, tôi ngại lắm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741203
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741203,
					"content": "Lúc này im lặng là vàng, Mona muốn có một cái ôm không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741204
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400741204,
					"content": "Không cần!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741205
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741205,
					"content": "Đây là cảm ngộ của tôi lúc trước, khi đó tôi vừa mới tiếp xúc với thuật chiêm tinh thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741206
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741206,
					"content": "Bây giờ tôi đã là chuyên gia rồi, sẽ không bị ý kiến của người thường làm cho lung lay nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741207
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741207,
					"content": "Bất ngờ thật, đại pháp sư Megistus cũng có thời gian khó khăn như thế sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741208
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400741208,
					"content": "Cuộc sống bị người khác hiểu lầm chắc chắn rất khó chịu... cô có thể quên được thì tốt rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741209
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400741209,
					"content": "Thật ra, có người vì không chịu nổi những chuyện này mà phải từ bỏ thuật chiêm tinh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741210
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741210,
					"content": "Nhưng tôi là thiên tài, nhất định có thể làm được chuyện mà người khác không làm được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741211
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741211,
					"content": "Nói ra những lời đó ở một nơi tuyệt vời thế này, đúng là khỏi chê luôn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741212,
						400741213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400741212,
					"content": "Mona giỏi quá!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400741214
					]
				},
				{
					"id": 400741214,
					"content": "Hay lắm hay lắm, khen thêm chút nữa đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741215
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741215,
					"content": "À thì... tuy không muốn làm phiền nhã hứng của mọi người, nhưng bên kia có cửa kìa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741216
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400741216,
					"content": "Được rồi, đợi giải quyết hết mấy vấn đề này xong sẽ cho mọi người thêm cơ hội để khen tôi nhiều hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741213,
					"content": "Mona đúng là thiên tài mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400741214
					]
				}
			]
		}
