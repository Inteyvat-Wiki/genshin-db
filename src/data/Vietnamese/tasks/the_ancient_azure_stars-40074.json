			},
			"dialogs": [
				{
					"id": 400740201,
					"content": "Bàn bói nước cho thấy, chúng ta đã đến chỗ ảo cảnh rồi. Ừm, tìm cửa vào trước đã...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740202
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400740202,
					"content": "Có phải là cái bên kia không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400740203,
					"content": "Hình như đây... là một hồ nước mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740204
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400740204,
					"content": "Phải bơi vào sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400740205,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740206
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400740206,
					"content": "Chẳng lẽ, trong chúng ta có người không biết bơi à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740207
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400740207,
					"content": "Tôi lại cảm thấy có thể vấn đề không nằm ở đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740208
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400740208,
					"content": "Haha, sợ rồi đúng không? Vậy thì được rồi, để tôi xung phong cho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740209
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400740209,
					"content": "Bắt đầu rồi! Cô ta rất tự tin về khả năng bơi lội nên lại bắt đầu khoe khoang rồi đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740210
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400740210,
					"content": "Khụ! Tiểu thư, chú ý cách dùng từ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740211
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400740211,
					"content": "À, haha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740212
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400740212,
					"content": "Đi trước đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740213
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400740213,
					"content": "A, Mona nhảy vào trong hồ rồi biến mất luôn?! Vậy chúng ta cũng đi theo thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
