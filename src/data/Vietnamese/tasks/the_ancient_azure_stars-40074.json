					"nextDialogs": [
						400740302
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400740302,
					"content": "Woa... Trước giờ tôi chưa từng thấy chỗ nào như thế này cả...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740303
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400740303,
					"content": "Mona, ảo cảnh của cô lợi hại thật!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740304
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400740304,
					"content": "Dù vẫn xấu hơn Vương Đô U Ám một chút, nhưng cũng khá đấy, Megistus ạ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740305
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400740305,
					"content": "(Hên quá, may mà không phải là ảo cảnh trong lớp học bị bà cô trách mắng... xem như vẫn giữ được thể diện...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740306
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400740306,
					"content": "Ảo cảnh của nhà chiêm tinh thiên tài thì đương nhiên phải hoành tráng rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740307
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400740307,
					"content": "Vậy chúng ta bắt đầu tìm kiếm thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
