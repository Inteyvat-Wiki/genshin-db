			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jack"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411250101,
					"content": "Haiz... Giá mà tôi cũng có thể đi xem thì tốt biết mấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250102
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250102,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411250103
					]
				},
				{
					"id": 411250103,
					"content": "Là bạn à. Chẳng có gì đặc biệt xảy ra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250104
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250104,
					"content": "Ách, thực ra cũng khá đặc biệt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250105,
						411250108
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250105,
					"content": "Là chuyện thiên thạch sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411250106
					]
				},
				{
					"id": 411250106,
					"content": "Đúng vậy, bạn cũng thấy đó, gần đây các thiên thạch liên tục từ trên trời rơi xuống.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250107
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250107,
					"content": "Có điều... nên gọi đây là sự bảo hộ của Phong Thần hay chỉ là sự may mắn nhỉ, chưa có thiên thạch nào rơi vào trong thành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250113
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250113,
					"content": "Nhưng bên ngoài còn có rất nhiều thiên thạch, nghe nói... ai chạm vào thiên thạch đều sẽ rơi vào hôn mê, làm thế nào cũng không thể tỉnh dậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250114
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250114,
					"content": "Ngài Cyrus đã ban hành uỷ thác, triệu tập được một số nhà mạo hiểm, một nhóm đi thông báo cho những người vẫn còn ở bên ngoài về thành lánh nạn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250115
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250115,
					"content": "Nhóm khác đi giúp đỡ đội kỵ sĩ Tây Phong xác nhận vị trí của thiên thạch ở khắp mọi nơi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250116
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250116,
					"content": "Sau đó lấy điểm rơi làm trung tâm, tìm kiếm và giải cứu xung quanh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250117
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250117,
					"content": "Còn tôi... ngài Cyrus nói rằng tôi tốt hơn hết là nên ở lại trong thành, chăm sóc cho những người đang hôn mê.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250118
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250118,
					"content": "Có lẽ do thực lực của tôi chưa đủ... nhưng cứ phụ trách những chuyện nhỏ nhặt này, tôi chẳng có bất kỳ cơ hội nào để trở nên mạnh mẽ hơn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250119
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250119,
					"content": "Haiz, nhưng nói thế nào, thì tôi cũng phải làm tròn bổn phận của mình trước đã... Nhà Lữ Hành, có thể nhờ bạn giúp tôi một việc được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250120
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250120,
					"content": "Tôi muốn nhờ bạn giúp tôi ra bên ngoài, thu thập một số thông tin về những thiên thạch đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250121,
						411250126
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250121,
					"content": "Thu thập những thứ này để làm gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411250122
					]
				},
				{
					"id": 411250122,
					"content": "Ngài Cyrus luôn nói rằng, trước khi bắt đầu mạo hiểm, phải chuẩn bị đầy đủ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250123
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250123,
					"content": "Nếu tôi có thể thuyết phục được ngài Cyrus, thì tôi đã hiểu rõ được tình hình hiện tại, cũng đã chuẩn bị đầy đủ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250124
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250124,
					"content": "Vậy thì, có thể ngài ấy sẽ cho phép tôi tham gia điều tra phía bên ngoài...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250125
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250125,
					"content": "Nhưng bây giờ tôi còn phải giúp chăm sóc cho những người đó, không có cơ hội ra ngoài thu thập thông tin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250133
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250133,
					"content": "Vì vậy chỉ có thể nhờ bạn, nhà lữ hành! Làm ơn hãy giúp tôi ra bên ngoài điều tra, chỉ cần... đi đến gần Rừng Thì Thầm là được rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250134
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250134,
					"content": "Nếu có thu hoạch gì thì hãy quay lại nói cho tôi biết nhé. Tôi có được đi ra bên ngoài để tham gia điều tra hay không... đều dựa cả vào bạn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250126,
					"content": "Bạn muốn bí mật...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411250127
					]
				},
				{
					"id": 411250127,
					"content": "Hả? Tôi bí mật... Không! Không, hoàn toàn không!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250128
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250128,
					"content": "Tuy rằng tôi thực sự rất muốn ra bên ngoài điều tra... nhưng trong thành cũng cần giúp đỡ, hơn nữa việc trong thành cũng rất quan trọng! Tôi không thể tự ý rời đi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250129
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250129,
					"content": "Ui da, thì... ngài Cyrus luôn nói rằng, trước khi bắt đầu mạo hiểm, phải chuẩn bị đầy đủ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250130
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250130,
					"content": "Nếu tôi có thể thuyết phục được ngài Cyrus, thì tôi đã hiểu rõ được tình hình hiện tại, cũng đã chuẩn bị đầy đủ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250131
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250131,
					"content": "Vậy thì, có thể ngài ấy sẽ cho phép tôi tham gia điều tra phía bên ngoài...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250132
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250132,
					"content": "Nhưng bây giờ tôi còn phải giúp chăm sóc cho những người đó, không có cơ hội ra ngoài thu thập thông tin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250133
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250108,
					"content": "Các món ăn được giảm giá 50% trong lễ kỷ niệm của quán ăn \"Người Săn Hươu\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411250109
					]
				},
				{
					"id": 411250109,
					"content": "Gì cơ? Sao tôi không biết! Hôm nay quán ăn Người Săn Hươu có còn hoạt động ấy không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250110
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250110,
					"content": "Ôi! Không đúng... ý của tôi không phải vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250111
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250111,
					"content": "Bạn cũng thấy đấy, gần đây thiên thạch từ trên trời rơi xuống không ngừng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
