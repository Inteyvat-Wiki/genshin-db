			"dialogs": [
				{
					"id": 411250201,
					"content": "Cuối cùng cũng thoát khỏi, rốt cuộc chuyện này là sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250202
					],
					"speakerTitle": "Pallad Lỗ Mãng"
				},
				{
					"id": 411250202,
					"content": "Bạn đến để điều tra thiên thạch sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411250203
					]
				},
				{
					"id": 411250203,
					"content": "Đúng vậy, tôi nhận uỷ thác của hiệp hội đến bên ngoài để điều tra việc liên quan đến thiên thạch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250204
					],
					"speakerTitle": "Pallad Lỗ Mãng"
				},
				{
					"id": 411250204,
					"content": "Nhưng không hiểu tại sao những ma vật ở gần vị trí thiên thạch rơi bỗng khác hẳn mọi khi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250205
					],
					"speakerTitle": "Pallad Lỗ Mãng"
				},
				{
					"id": 411250205,
					"content": "Bất kể là cường độ tấn công, trạng thái hoạt động, hay các phương diện khác đều vô cùng khác thường và số lượng cũng cực kỳ đông.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250206
					],
					"speakerTitle": "Pallad Lỗ Mãng"
				},
				{
					"id": 411250206,
					"content": "Tôi không cẩn thận bị chúng phát hiện ra, không dám ở lại đó lâu nữa, liền đi theo đường mòn, bỏ lại chúng phía sau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250207
					],
					"speakerTitle": "Pallad Lỗ Mãng"
				},
				{
					"id": 411250207,
					"content": "Tôi phải mau chóng về thành báo lại cho ngài Cyrus biết tình hình bất thường của đám ma vật này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250208
					],
					"speakerTitle": "Pallad Lỗ Mãng"
				},
				{
					"id": 411250208,
					"content": "Còn gì khác nữa không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411250209
					]
				},
				{
					"id": 411250209,
					"content": "Còn gì nữa? Cái này mà... nếu phải nói thì là còn có rất nhiều học giả từ chối vào thành lánh nạnv.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250210
					],
					"speakerTitle": "Pallad Lỗ Mãng"
				},
				{
					"id": 411250210,
					"content": "Cho dù tôi có thuyết phục thế nào thì họ cũng nhất quyết ở lại bên ngoài để tiếp tục nghiên cứu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250211
					],
					"speakerTitle": "Pallad Lỗ Mãng"
				},
				{
					"id": 411250211,
					"content": "Hiện không có nhiều nhà mạo hiểm có thể ra bên ngoài điều tra, cũng không thể cứ cách vài ngày lại đến để nhắc nhở họ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250212
					],
					"speakerTitle": "Pallad Lỗ Mãng"
				},
				{
					"id": 411250212,
					"content": "Nhưng người này thật sự khiến tôi đau đầu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250213
					],
					"speakerTitle": "Pallad Lỗ Mãng"
				},
				{
					"id": 411250213,
					"content": "Được rồi, nhà lữ hành, nếu không còn chuyện gì quan trọng, bạn cũng mau trở về đi, hiện tại không phải là lúc chạy loạn bên ngoài.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pallad Lỗ Mãng"
				}
			]
		},
