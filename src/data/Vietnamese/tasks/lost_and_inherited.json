			"dialogs": [
				{
					"id": 140160101,
					"content": "Ludivine, tôi đến rồi đây. Dạo này công việc làm ăn tốt chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160102
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160102,
					"content": "Ôi, nếu không có đại tiểu thư Spina di Rosula đến ủng hộ thì cửa tiệm nhỏ của tôi chắc phải dẹp mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160103
					],
					"speakerTitle": "Ludivine"
				},
				{
					"id": 140160103,
					"content": "Haha, ai cũng biết cô sẽ xoay sở tốt mà, nên không cần phải đùa như thế đâu. Nhưng mà, bây giờ cô ấy đã là cô chủ rồi đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160104
					],
					"speakerTitle": "Colter"
				},
				{
					"id": 140160104,
					"content": "Ây da, thất lễ quá, tôi cứ quen miệng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160105
					],
					"speakerTitle": "Ludivine"
				},
				{
					"id": 140160105,
					"content": "Các vị đến đây để lấy đồng phục sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160106
					],
					"speakerTitle": "Ludivine"
				},
				{
					"id": 140160106,
					"content": "Đúng vậy. Lần trước đến Đại Sảnh Fontaine làm việc mà quên mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160107
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160107,
					"content": "Chuyện nhỏ nhặt này cứ để cấp dưới làm là được mà. Tôi cũng không ngờ là đại tiểu thư lại đích thân đến lấy đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160108
					],
					"speakerTitle": "Ludivine"
				},
				{
					"id": 140160108,
					"content": "Navia luôn nghiêm túc cả trong những vấn đề nhỏ nhất mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140160109,
					"content": "Làm gì có! Tản bộ cũng là một trong những mục tiêu quan trọng của chuyến hành trình mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160110
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160110,
					"content": "Không gì có thể chữa lành cơ thể và tâm hồn hơn là một chuyến hành trình mới đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160111
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160111,
					"content": "Haha, cô chủ nói đúng lắm. Ít ra thì vẫn đỡ hơn là cứ ủ rũ một mình mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160112
					],
					"speakerTitle": "Colter"
				},
				{
					"id": 140160112,
					"content": "Vậy mọi người chờ chút nhé, để tôi đi lấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160113
					],
					"speakerTitle": "Ludivine"
				},
				{
					"id": 140160113,
					"content": "Phải rồi, tại sao Adele lại muốn gia nhập Spina di Rosula vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140160114,
					"content": "Hihi, em ấy không nói rõ lý do cụ thể, chỉ nói là em ấy rất yêu mến tôi thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160115
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160115,
					"content": "Sau chuyện đó, em ấy đã cởi mở hơn nhiều. Có lẽ em ấy đã hiểu ra được cha mình không phải là người khiến em ấy thất vọng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160116
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160116,
					"content": "Adele nói em ấy rất sợ cha tôi, nên cảm thấy người trong Spina di Rosula đều rất đáng sợ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160117
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160117,
					"content": "Nhưng Spina di Rosula bây giờ đã khác rồi. Em ấy đã can đảm nói chuyện với tôi, chắc là cảm thấy tôi có thể hiểu được em ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160118
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160118,
					"content": "Vì cả hai đều có hoàn cảnh tương tự nhau mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160119
					]
				},
				{
					"id": 140160119,
					"content": "Ừm, có lẽ thế. Trong lúc tìm ra sự thật, tôi đã giúp đỡ em ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160120
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160120,
					"content": "Em ấy bảo cũng muốn giống như tôi, đi giúp đỡ người khác, chứ không phải đứng yên tại chỗ mà mong chờ người khác đến cứu rỗi bản thân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160121
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160121,
					"content": "Nghe có vẻ như cô bé tương lai sẽ trở thành thành viên ưu tú của Spina di Rosula đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160122
					],
					"speakerTitle": "Colter"
				},
				{
					"id": 140160122,
					"content": "Tôi cũng nghĩ vậy, nhưng trước tiên phải xây dựng một môi trường trưởng thành lành mạnh cho em ấy đã. Đợi khi lớn lên rồi mới để em ấy lựa chọn vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160123
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160123,
					"content": "(Quả nhiên không phải ảo giác...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160124
					]
				},
				{
					"id": 140160124,
					"content": "Này, sao thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160125,
						140160126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140160125,
					"content": "Đi theo tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160127
					]
				},
				{
					"id": 140160127,
					"content": "Hả? Theo, theo dõi sao?! Tôi đến ngay đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140160128,
					"content": "Tôi cũng đi xem thử! Colter, chú lấy đồng phục giúp tôi nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160129
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160129,
					"content": "À, được, được thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Colter"
				},
				{
					"id": 140160126,
					"content": "Có người đang theo dõi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160127
					]
				}
			]
		},
