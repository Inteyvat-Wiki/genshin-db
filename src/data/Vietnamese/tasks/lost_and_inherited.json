				{
					"id": 140160802,
					"content": "Ngày mai hành động, lo mà cầu nguyện đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160803
					],
					"speakerTitle": "Martinat"
				},
				{
					"id": 140160803,
					"content": "Thiết bị dây cót không chuyển động là do lắp thiếu một linh kiện, vậy thì coi như chúng ta hòa nhau nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160804
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160804,
					"content": "Nếu tính về số lượng thì là vậy... Oáp, không được rồi, tôi gắng gượng hết nổi rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140160805,
					"content": "Haha, mau đi nghỉ ngơi đi. Hôm nay tôi đã chơi rất vui đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160806
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160806,
					"content": "Mai gặp lại nhé, Navia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160807
					]
				},
				{
					"id": 140160807,
					"content": "Ừm, mai gặp!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160808
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160808,
					"content": "Sao rồi, nơi này ẩm thấp như vậy, tối qua ngủ không sao chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160809
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160809,
					"content": "Tôi nằm mơ thấy trời sáng... nên là \"không có sao\" nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140160810,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160811
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160811,
					"content": "...Học của ai thế?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160812
					]
				},
				{
					"id": 140160812,
					"content": "Haha, không ngờ Paimon lại hài hước đến thế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160813
					],
					"speakerTitle": "Colter"
				},
				{
					"id": 140160813,
					"content": "Nhìn này, có người biết thưởng thức đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160814
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140160814,
					"content": "Vậy chúng ta ngồi thuyền về Thị Trấn Poisson nhé, để tôi sắp xếp cho. Chắc Adele cũng muốn gặp mọi người đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160815
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160815,
					"content": "Hy vọng em ấy sẽ thích món quà mà cô chuẩn bị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160816
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140160816,
					"content": "Vậy thì tốt quá rồi, hihi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Navia"
				}
			]
		},
