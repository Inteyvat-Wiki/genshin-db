					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160406
					]
				},
				{
					"id": 140160406,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160407
					],
					"speakerTitle": "Martinat"
				},
				{
					"id": 140160407,
					"content": "Cô chủ, sao rồi? Mọi người không bị thương chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160408
					],
					"speakerTitle": "Colter"
				},
				{
					"id": 140160408,
					"content": "Mấy tên này thì đâu thể làm gì được chúng tôi chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160409
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160409,
					"content": "Được rồi, mau khai đi. Nếu để Sảnh Chấp Pháp can thiệp vào thì chuyện này sẽ không còn đơn giản nữa đâu đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160410
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160410,
					"content": "Chúng tôi... tìm Spina di Rosula để trả thù.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160411
					],
					"speakerTitle": "Martinat"
				},
				{
					"id": 140160411,
					"content": "Theo dõi thì bị phát hiện, mà đánh thì cũng đánh không lại... Chúng tôi chịu thua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160412
					],
					"speakerTitle": "Martinat"
				},
				{
					"id": 140160412,
					"content": "Trả thù? Chẳng lẽ... mấy người thuộc nhóm Romeuf sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160413
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160413,
					"content": "Cô biết người này sao...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160414
					],
					"speakerTitle": "Martinat"
				},
				{
					"id": 140160414,
					"content": "Vậy thì cô biết mối hận của chúng tôi đến từ đâu rồi đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160415
					],
					"speakerTitle": "Martinat"
				},
				{
					"id": 140160415,
					"content": "Bình tĩnh đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160416
					]
				},
				{
					"id": 140160416,
					"content": "Đúng đấy! Bây giờ mấy người không còn cơ hội thắng được nữa đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160417
					],
					"speakerTitle": "Colter"
				},
				{
					"id": 140160417,
					"content": "Hừ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160418
					],
					"speakerTitle": "Martinat"
				},
				{
					"id": 140160418,
					"content": "Chúng tôi có uống chút rượu, sau đó gặp phải Navia trên đường. Trong cơn tức giận nên nảy sinh ý định gây phiền phức cho mấy người thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160419
					],
					"speakerTitle": "Martinat"
				},
				{
					"id": 140160419,
					"content": "Kết quả lại bị mấy người đánh bại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160420
					],
					"speakerTitle": "Martinat"
				},
				{
					"id": 140160420,
					"content": "Ngươi nói dối.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160421
					]
				},
				{
					"id": 140160421,
					"content": "Hả...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160422,
						140160423
					],
					"speakerTitle": "Martinat"
				},
				{
					"id": 140160422,
					"content": "Các người đã theo dõi bọn ta đến tận đây.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160424
					]
				},
				{
					"id": 140160424,
					"content": "Nhạy bén đấy, thì đã sao? Chúng tôi chưa làm gì cả, cũng không có khả năng làm gì được mấy người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160425
					],
					"speakerTitle": "Martinat"
				},
				{
					"id": 140160425,
					"content": "Chúng tôi chỉ là giận quá mất khôn, bực bội khi nhìn thấy mấy người thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160426
					],
					"speakerTitle": "Martinat"
				},
				{
					"id": 140160426,
					"content": "Nghe đây, Callas đã qua đời rồi. Cho dù Spina di Rosula có từng làm gì thì tôi cũng mong là sẽ có một khởi đầu mới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160427
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160427,
					"content": "Tôi là hội trưởng đương nhiệm của Spina di Rosula. Nếu đại ca của các người có ý kiến gì thì tôi sẵn lòng tiếp chuyện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160428
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160428,
					"content": "Tôi không truy cứu trách nhiệm của mấy người, như vậy đã là thể hiện thái độ của tôi rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160429
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160429,
					"content": "...Hiểu rồi, cảm ơn nhé. Tôi sẽ truyền đạt lại lời nói của cô.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160430
					],
					"speakerTitle": "Martinat"
				},
				{
					"id": 140160430,
					"content": "Nhưng nếu mấy người còn làm thế hay có âm mưu gì nữa, thì đừng trách tôi đấy. Nghe rõ chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160431
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160431,
					"content": "Tôi biết rồi. Chúng ta đi thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160432
					],
					"speakerTitle": "Martinat"
				},
				{
					"id": 140160432,
					"content": "Thả họ đi như vậy không sao chứ, Navia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160433
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140160433,
					"content": "Tôi không muốn tiếp nối mâu thuẫn mà cha tôi để lại. Hơn nữa, tôi cũng không hoàn toàn đồng tình với cha tôi về chuyện Tàu Luân Chuyển.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160434
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160434,
					"content": "Nếu đối phương chịu thương lượng, thì tôi cũng sẵn lòng để mọi chuyện bước sang một trang mới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160435
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160435,
					"content": "Tôi ủng hộ cách làm của cô chủ. Dùng bạo lực để giải quyết vấn đề là rất hạ sách, không hề đẹp đẽ gì trong triết lý của Spina di Rosula cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160436
					],
					"speakerTitle": "Colter"
				},
				{
					"id": 140160436,
					"content": "Ừm, chú Colter từng nói dạo này tình hình nội bộ của họ bất ổn, nên không gây ra sóng gió gì được đâu. Có lẽ cũng là lúc họ phải ngồi lại nói chuyện với chúng ta rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160437
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160437,
					"content": "Nhưng tôi nghĩ vẫn phải đề phòng hành tung của Romeuf. Nếu người đó phớt lờ cảnh cáo của chúng ta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160438
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160438,
					"content": "Thì e là sẽ khó tránh khỏi một trận chiến đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160439
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160439,
					"content": "Đúng vậy. Người bên đó hình như rất căm thù Spina di Rosula.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160440
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140160440,
					"content": "Đừng đi đến bước đó là tốt nhất. Cho dù... có cắt đứt tình nghĩa đi nữa thì hai bên cũng đã từng là người một nhà mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160441
					],
					"speakerTitle": "Colter"
				},
				{
					"id": 140160441,
					"content": "Ừm, đúng vậy. Được rồi, nói chung là giải quyết xong rồi, đừng để tâm đến mấy tên đáng ghét đó nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160442
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160442,
					"content": "Hôm nay hơi muộn rồi, chúng ta đến Fleuve Cendre nghỉ ngơi một đêm, rồi sáng mai trở về Thị Trấn Poisson nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160443
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160443,
					"content": "Tôi sẽ nhờ người viết thư cho Florent, kể cho anh ấy biết chuyện đã xảy ra hôm nay, bảo anh ấy chú ý an ninh xung quanh Thị Trấn Poisson, đề phòng những kẻ khả nghi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160444
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160444,
					"content": "Lại phải qua đêm ở Fleuve Cendre sao? Gối ở đó đều có mùi cỏ nước đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160445
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140160445,
					"content": "Cũng hết cách, do ở gần nước lại thiếu đi ánh sáng mặt trời mà. Thị Trấn Poisson cũng thế, nên tôi đã quen từ lâu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160446
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160446,
					"content": "Buổi tối chúng ta có thể đến cửa tiệm ăn cá nướng và uống gì đó, nghe người ta ca hát, chẳng phải rất tuyệt sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160447
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160447,
					"content": "Có lý, cô thuyết phục được tôi rồi đấy! Chúng ta đi thôi, tôi cũng muốn hát!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140160423,
					"content": "Nhất định là có âm mưu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160424
					]
				},
				{
					"id": 140160405,
					"content": "Bọn ta có người bao vây ở khắp nơi rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160406
					]
				}
			]
		},
		{
			"id": 1401605,
