					}
				]
			},
			"dialogs": [
				{
					"id": 140160501,
					"content": "Lại đến nơi này rồi, cảm thấy có chút thân thuộc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140160502,
					"content": "Nếu căn cứ của Spina di Rosula ở Đại Sảnh Fontaine cũng tráng lệ như Palais Mermonia thì lại thấy không hài hòa lắm nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140160503,
					"content": "Haha, phải đấy. Tôi cũng thấy vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160504
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160504,
					"content": "Chỉ là trong suy nghĩ của cha tôi, đợi khi Spina di Rosula ngày càng phát triển thì Thị Trấn Poisson cũng sẽ trở thành thành phố lớn không thua kém Đại Sảnh Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160505
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160505,
					"content": "Ông ấy là một người rất có tham vọng, ít khi cúi đầu nhìn xuống, nên ông ấy mới có nhiều đặc điểm khác với người thường như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160506
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160506,
					"content": "Cũng chính vì điểm này mà mọi người mới vừa yêu vừa hận ngài Callas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160507
					],
					"speakerTitle": "Colter"
				},
				{
					"id": 140160507,
					"content": "Được rồi, mọi người đến quán đợi tôi nhé. Tôi vào trong chuẩn bị đôi chút, tiện thể nhờ người sắp xếp chỗ ở cho chúng ta luôn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160508
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160508,
					"content": "Vẫn là căn phòng lần trước đó. Còn nhớ là căn nào không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160509
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160509,
					"content": "Ừm, dù sao thì cũng chỉ có mấy căn phòng đó thôi mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140160510,
					"content": "Paimon thật là, lại muốn nói nơi này nghèo nàn đúng không? Bây giờ tôi sẽ đi nhét đầy cỏ nước vào gối của Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160511
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160511,
					"content": "Xin lỗi, xin lỗi mà! Như vậy thì tôi sẽ ngủ không được thật đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140160512,
					"content": "Haha, đùa thôi. Mọi người sang đó trước đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Navia"
				}
			]
		},
