			"dialogs": [
				{
					"id": 140160601,
					"content": "Thưởng thức bữa tối và xem biểu diễn... Màn đêm náo nhiệt dần trôi qua.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						140160602
					]
				},
				{
					"id": 140160602,
					"content": "Mọi thứ trở nên bình yên, bạn và Paimon về phòng và rồi nghe thấy tiếng gõ cửa...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						140160603
					]
				},
				{
					"id": 140160603,
					"content": "Ngủ chưa? Vẫn chưa nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160604,
						140160605
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160604,
					"content": "Navia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160606
					]
				},
				{
					"id": 140160606,
					"content": "Không có gì. Chỉ là cảm thấy hiếm khi có một đêm như vậy, không nên để nó trôi qua như thế, đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160607
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160607,
					"content": "Muốn đi câu cá không? Tôi chuẩn bị xong rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160608
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160608,
					"content": "Đây là thứ mà cô \"chuẩn bị\" trước bữa tối đó à? Chúng tôi đến ngay đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140160609,
					"content": "Hihi, không làm phiền hai vị nghỉ ngơi đó chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160610,
						140160613
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160610,
					"content": "Không đâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160611
					]
				},
				{
					"id": 140160611,
					"content": "#Yên tâm, tôi nghĩ {F#cô}{M#cậu} sẽ chẳng mấy tỉnh táo, nên đã chuẩn bị xong cả rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160612
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160612,
					"content": "Coi như là đi trò chuyện với tôi nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160615
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160615,
					"content": "Đi thôi, đi câu cá nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160613,
					"content": "Nếu Navia đã yêu cầu thì...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160614
					]
				},
				{
					"id": 140160614,
					"content": "Hihi, không hổ danh là cộng sự tốt của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160615
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160605,
					"content": "Sao thế?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160606
					]
				}
			]
		},
		{
			"id": 1401607,
