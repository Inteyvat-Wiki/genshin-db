						],
						"pointId": 340100403
					}
				]
			},
			"dialogs": [
				{
					"id": 140160701,
					"content": "Dùng cần câu cá tự động như vậy mà cũng xem là câu cá sao?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140160702,
					"content": "Ừm, sao thế? Loại cần câu này rất thường thấy ở Thị Trấn Poisson mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160703
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160703,
					"content": "Câu cá không phải là... À ừm, tập trung cao độ để đợi cá cắn câu, cảm nhận khoảnh khắc bất ngờ khi cá ngoi lên khỏi mặt nước sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140160704,
					"content": "#Đó là kiểu câu khác rồi. {NICKNAME} thấy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160705,
						140160707
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160705,
					"content": "Tự câu sẽ có ý nghĩa hơn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160706
					]
				},
				{
					"id": 140160707,
					"content": "Tự động sẽ tiết kiệm công sức hơn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160708
					]
				},
				{
					"id": 140160706,
					"content": "Vậy lần sau chúng ta dùng cần câu bình thường để câu nhé, xem ai câu được nhiều hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160709
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160708,
					"content": "#Haha, {F#cô}{M#cậu} cũng thấy vậy sao? Dù sao đi nữa thì câu được cá là vui rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160709
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160709,
					"content": "So với chuyện này thì tôi muốn hỏi tại sao Navia lại tươi tỉnh thế? Lúc này tôi đã.. oáp... muốn đi ngủ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140160710,
					"content": "À, tôi bẩm sinh đã thế rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160711
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160711,
					"content": "Chỉ thế thôi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140160712,
					"content": "Nói thêm thì chỉ khiến Paimon buồn ngủ hơn thôi. Tôi nghĩ là do Spina di Rosula và mẹ tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160713
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160713,
					"content": "Mẹ cô?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160714
					]
				},
				{
					"id": 140160714,
					"content": "Cha tôi từ nhỏ đã đặt rất nhiều kỳ vọng phi thực tế vào tôi. Cha tôi càng muốn tôi giống ông ấy thì tôi lại càng không muốn nghe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160715
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160715,
					"content": "Mẹ tôi thì khác. Tôi nghe nói mẹ chỉ mong chờ một điều duy nhất, đó là mong tôi sẽ lớn lên trong hạnh phúc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160716
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160716,
					"content": "Các thành viên của Spina di Rosula đều tôn trọng suy nghĩ của bà ấy, nên sẵn sàng chiều chuộng tôi bất kể tôi có đi quậy phá ở đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160717
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160717,
					"content": "Hai người tưởng tượng được không? Khi tôi bị mắng vì gây rắc rối, mọi người đứng thành hai hàng, kể cả Melus và Silver, chỉ có cha tôi là người duy nhất tức giận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160718
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160718,
					"content": "Mọi người đều không lên tiếng, khiến cho người cha hay nổi giận với tôi vì những chuyện nhỏ nhặt trở nên rất nhỏ nhen. Vì vậy, ông ấy cũng đành phải im lặng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160719
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160719,
					"content": "Có chuyện như vậy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160720
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140160720,
					"content": "Đúng đó, bây giờ nghĩ lại thì họ đều là những người rất dịu dàng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160721
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160721,
					"content": "Khi còn bé, tôi luôn nghĩ rằng tôi có thể làm bất cứ điều gì tôi muốn, vì sẽ luôn có người giúp tôi giải quyết hậu quả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160722
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160722,
					"content": "Nhưng có một lần Melus bị thương, nhưng lại không nói cho tôi biết nguyên nhân... Tuy nhiên, tôi có thể cảm nhận được là do tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160723
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160723,
					"content": "Sẽ luôn có người gánh chịu trách nhiệm vì những lỗi lầm. Nếu trân trọng những người xung quanh thì càng không nên làm điều sai trái.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160724
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160724,
					"content": "Bởi vì khi sự trừng phạt kéo đến, những người đó sẽ đứng ra bảo vệ, thay chúng ta hứng chịu tất cả...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160725,
						140160726
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160725,
					"content": "Navia...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160727
					]
				},
				{
					"id": 140160726,
					"content": "Cô vẫn đang buồn lắm đúng không...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160727
					]
				},
				{
					"id": 140160727,
					"content": "Xin lỗi, tôi không nên nhắc chuyện này. Tối nay tôi sẽ không nói những chuyện đau lòng nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160728
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160728,
					"content": "Tóm lại thì Spina di Rosula có được bầu không khí như ngày nay chắc chắn không phải do cha tôi, mà là do mẹ tôi cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160729
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160729,
					"content": "Đây có lẽ là cách duy nhất tôi cảm nhận được tình yêu thương từ bà ấy, và tôi cũng muốn tiếp nối sự dịu dàng của bà ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160730
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160730,
					"content": "Vậy nên hôm nay cô mới thả những người đó đi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160731
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140160731,
					"content": "Ừm, có lẽ là do bài học năm xưa, nên ít nhất thì tôi không muốn quá độc đoán.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160732
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160732,
					"content": "#Ối, {NICKNAME}, nhìn kìa! Bên phía {F#cô}{M#cậu} hình như có cá cắn câu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160733
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160733,
					"content": "Mà sao cần câu không thu dây được vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160734
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140160734,
					"content": "Chắc là do chưa lắp đúng thiết bị dây cót. Đây cũng là lần đầu tiên tôi dùng loại cần câu này thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160735
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160735,
					"content": "Đừng để nó chạy thoát, bắt nó lại! Nhanh lên!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160736
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160736,
					"content": "Tôi, tôi cũng phải bắt sao?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160737
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140160737,
					"content": "Sau một hồi chung sức, các bạn đã kéo được con cá lớn này lên.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						140160738
					]
				},
				{
					"id": 140160740,
					"content": "Navia không có lắp lưỡi câu sao?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
