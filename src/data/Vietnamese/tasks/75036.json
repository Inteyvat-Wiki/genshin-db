					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750360807,
					"content": "Có lẽ hạt giống cần thời gian để phát triển.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750360808
					]
				},
				{
					"id": 750360808,
					"content": "Đúng vậy! Nghĩ lại thấy cũng đúng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360809,
					"content": "Bồ công anh chỉ cần thổi phù một cái là chúng sẽ phát tán ngay, Quả Móc Câu sẽ bám vào người chú sói nhỏ mà đi đến nơi xa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360810,
					"content": "Sức sống của hạt giống rất mãnh liệt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360815
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360815,
					"content": "Vậy chúng ta đừng làm phiền nó nữa, một thời gian nữa quay lại xem sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360816
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360816,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750360811,
					"content": "Có lẽ hạt giống chỉ bị hoảng sợ thôi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750360812
					]
				},
				{
					"id": 750360812,
					"content": "Thật vậy sao? Cũng đúng! Hay là do tôi nóng vội quá nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360813,
					"content": "#Hạt giống bị {REALNAME[ID(2)|SHOWHOST(true)]} đào lên, lại bị côn trùng trộm chất dinh dưỡng, còn bị quái vật quấy rầy nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360814
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360814,
					"content": "Nghe tiếng đánh nhau thì đối với hạt giống cũng giống như tiếng bão và sấm sét vậy. Sau đó nó lặng lẽ co mình trong đất, không dám nhúc nhích nữa... Ừm! Chắc chắn là vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360815
