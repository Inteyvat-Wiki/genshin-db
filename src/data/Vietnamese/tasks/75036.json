					"nextDialogs": [
						750360805
					]
				},
				{
					"id": 750360805,
					"content": "#A, {NICKNAME}, năng lượng Phlogiston đã hết. Chắc chắn đã bị hạt giống hấp thụ rồi, nhưng sao không có phản ứng gì cả vậy...",
					"roleType": "TALK_ROLE_NPC",
