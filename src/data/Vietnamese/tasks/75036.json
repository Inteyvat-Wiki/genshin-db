			"dialogs": [
				{
					"id": 750360201,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}, hình như nhóc vừa đào được thứ gì đó có giá trị phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360202,
					"content": "Lẽ nào là kho báu quý giá à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360203,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360204
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750360204,
					"content": "Hmm... Để xem nào, cái này trông giống như hạt giống của thứ gì đó nhỉ? Không ngờ ở nơi trông như vùng đất hoang mà lại có thể đào được thứ này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360205,
					"content": "Rrrawr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360206
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750360206,
					"content": "Nhưng mà thứ này trông có vẻ không đáng giá lắm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360207,
					"content": "Rawr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360208,
						750360209
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750360208,
					"content": "Hạt giống này ẩn chứa tiềm năng vô hạn...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750360210
					]
				},
				{
					"id": 750360210,
					"content": "Nhưng dù sao đây cũng là đất bỏ hoang... Hạt giống này thật sự còn dùng được sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360211,
					"content": "Rawr...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360212
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750360212,
					"content": "Đang buồn à? ...Cũng khó nói lắm, vì có những loại hạt giống bẩm sinh đã không thể nảy mầm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360213,
					"content": "Nhưng cứ thử trồng nó xuống xem sao. Có lẽ nó chưa nảy mầm chỉ vì chỗ đào chưa tốt hoặc là không đủ dinh dưỡng đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360214,
					"content": "Chúng ta hãy trồng nó cẩn thận, biết đâu nó có thể mọc lên đấy! Hihi, sẽ mọc ra thứ gì nhỉ? Hạt Ngũ Cốc khổng lồ... Hay là Cacahuatl thơm ngon cũng không tệ đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360215,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360216
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750360216,
					"content": "Có lẽ sẽ mọc ra Hoa Lừa Dối đấy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750360217
					]
				},
				{
					"id": 750360217,
					"content": "Lúc thế này thì đừng làm mất hứng chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360218,
					"content": "Nhưng thực vật ở Natlan cần loại dinh dưỡng nào nhỉ? Thôi kệ, cứ trồng xuống trước đã!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360209,
					"content": "Biết đâu có thể mọc ra thứ gì đó tuyệt vời đấy!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750360210
					]
				}
			]
		},
