					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190602902,
					"content": "Haiz... Rõ ràng hội trưởng và Heizou đều là những người rất tốt, thế mà sao mỗi lần gặp là lại căng thẳng với nhau thế chứ.",
					"roleType": "TALK_ROLE_NPC",
