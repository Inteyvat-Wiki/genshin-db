			"dialogs": [
				{
					"id": 190603001,
					"content": "Này, Nhà Lữ Hành, phá án đau đầu lắm đúng không, các bạn nghe theo tôi chỉ có chuẩn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603002
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 190603002,
					"content": "Về Hội Trưởng Sango...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190603003
					]
				},
				{
					"id": 190603003,
					"content": "Haiz! Bạn nói hội trưởng Sango đó hả, nhà Takatsukasa thật sự đã mời được một vị thám tử tuyệt vời đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603004
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 190603004,
					"content": "Cứ cách vài hôm là cô ấy lại đến xin điều tra lại \"vụ án Ryuuji\", nhưng lần nào cũng bị tiền bối Heizou từ chối, không ngờ lần này lại viết thư khiếu nại, đúng là lợi hại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603005
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 190603005,
					"content": "Về phần tại sao tiền bối Heizou không cho thì có lẽ là do sợ hội trưởng Sango gặp nguy hiểm, dù sao đây cũng là án mạng của một nhân vật lớn mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603006
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 190603006,
					"content": "Tuy Sango là hội trưởng của Trụ Sở Thám Tử, nhưng dù sao cô ấy cũng chỉ là một người bình thường thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603007
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 190603007,
					"content": "Mối quan hệ của họ có tốt không?",
