					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jean"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80020201,
					"content": "Haizz...Khu vực này quả thực không ít kẻ địch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020202,
					"content": "Càng đến gần mục tiêu thì địch càng nhiều. Hừm, đúng là phù hợp với tác phong giáo đoàn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020203
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020203,
					"content": "Chúng ta phải nhanh chóng tìm thấy \"Vua Sói\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020204
					]
				},
				{
					"id": 80020204,
					"content": "Ừm! Đi thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020205,
					"content": "Tôi...không đi đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020206
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020206,
					"content": "Ủa? Tại sao vậy? Chẳng lẽ bạn sợ các loài sinh vật lông lá?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020207,
						80020208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020207,
					"content": "Chắc không phải nguyên nhân này.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020209
					]
				},
				{
					"id": 80020209,
					"content": "Không liên quan với \"sói\". Là bởi vì hắn từng là ma thần ngày trước, nhưng nay lại góp sức cho Thất Thần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020210
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020210,
					"content": "Tôi không thể nào chấp nhận hành vi này, càng không muốn có liên quan gì với hắn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020211
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020211,
					"content": "Hơn nữa, lấy lòng người khác là bản lĩnh của bạn, tôi không làm được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020212,
						80020214
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020212,
					"content": "Bạn đúng là rất ghét Thất Thần.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020213
					]
				},
				{
					"id": 80020213,
					"content": "Thần linh vốn dĩ không xứng đáng để kỳ vọng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020216
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020216,
					"content": "Xem như đây là kiến nghị của cá nhân tôi, hãy nhớ, lúc nào cũng phải cảnh giác với thần linh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020217
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020217,
					"content": "Đừng quá tin họ, nhưng, cũng đừng đến mức...\"lật đổ\" hoặc \"truy sát\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020218
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020218,
					"content": "Cho dù, đối với \"kẻ địch\" năm đó của bạn, thì cũng như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020219
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020219,
					"content": "Không tin tưởng, cũng không truy sát...một cách suy nghĩ thật kỳ quặc. Dainsleif rốt cuộc là thù hận Thất Thần, hay là đang bảo vệ họ chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020220,
					"content": "Tại sao lại có quan điểm mâu thuẫn như vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020221
					]
				},
				{
					"id": 80020221,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020222
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020222,
					"content": "Rút kinh nghiệm đau thương.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020223
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020223,
					"content": "Tôi...sẽ nói với các bạn một sự thật cuối cùng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020224
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020224,
					"content": "Ừm? Sự thật gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020225,
					"content": "\"Khaenri'ah là vương quốc bị Thần hủy diệt, và đây chính là...nguyên nhân Giáo Đoàn Vực Sâu muốn hủy diệt vương quốc của Thất Thần.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020226
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020226,
					"content": "Chúng ta nói đến đây thôi, làm việc chính trước đã. Tôi sẽ đi giải quyết đám Giáo Đoàn Vực Sâu còn lại, các bạn cũng đi nhanh về nhanh nhé. Sau khi mọi việc giải quyết xong, chúng ta gặp nhau tại cổng Lang Lãnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020227
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020227,
					"content": "A...Anh ta đi rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020228,
					"content": "Đúng là người kỳ lạ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020229,
					"content": "Tôi có thể hiểu được anh ta một chút.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020230
					]
				},
				{
					"id": 80020230,
					"content": "Ừm, nói như vậy, bạn cũng phải đề phòng vị \"thần linh lạ mặt\" đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020231,
					"content": "Lúc đó ở Liyue, trong điển lễ thỉnh tiên, lựa chọn của bạn rất giống với Dainsleif...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020232,
					"content": "Vì tôi thiếu lòng tin. Không có cách nào khác, chỉ đành tránh né.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020233
					]
				},
				{
					"id": 80020233,
					"content": "Haizz...Thật là không dễ dàng mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020234,
					"content": "Kỵ Sĩ Danh Dự, Paimon! Sao các bạn lại ở đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020235
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 80020235,
					"content": "Ồ, đội trưởng Jean! Quá tốt rồi, tìm được bạn rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020236,
					"content": "Chúng tôi nghe Rosaria nói bạn đến đây chiến đấu, nên đến để chi viện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020237
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020237,
					"content": "Vậy thì vô cùng cảm tạ. Lần bạo động này rất kỳ lạ, Giáo Đoàn Vực Sâu đã bao vây khắp nơi xung quanh Lang Lãnh, tôi đang chuẩn bị điều động binh lực đối kháng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020238
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 80020238,
					"content": "Tôi đến Lang Lãnh để dò thám...không ngờ lại gặp được các bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020239
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 80020239,
					"content": "Nghe Rosaria nói, mục đích của chúng có thể là \"Boreas\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020240
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 80020240,
					"content": "Nhưng Giáo Đoàn Vực Sâu...và \"Boreas\"...có quan hệ gì chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020241
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 80020241,
					"content": "Chắc chỉ đơn giản là gây chuyện thôi, có lẽ không cần có lý do gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020242
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020242,
					"content": "Bạn xem, Giáo Đoàn Vực Sâu cũng đã từng gây chuyện với Dvalin, rồi cũng đã tìm đến người thân khác của Phong Thần, cũng đâu có gì lạ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020243
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020243,
					"content": "Cũng...cũng có lý...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020244
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 80020244,
					"content": "Tóm lại, những mối hiểm họa gần đây, bất luận là đã rõ ràng hay đang manh nha, thì hãy giao hết cho tôi xử lý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020245
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 80020245,
					"content": "Kỵ Sĩ Danh Dự, nhờ bạn mau đi xác nhận xem \"Vua Sói\" có gặp nguy hiểm gì không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020246
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 80020246,
					"content": "Hồn phách Ma Thần...ít khi gặp người. Nhưng tôi nghe nói bạn và nó đã từng có duyên gặp mặt, có lẽ để bạn ra mặt là thích hợp nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020247
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 80020247,
					"content": "Tôi sẽ thử xem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020248
					]
				},
				{
					"id": 80020248,
					"content": "Ừm, hãy thật cẩn thận. Nhiệm vụ phía trước đành nhờ bạn rồi, \"Kỵ Sĩ Danh Dự Tây Phong\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jean"
				},
				{
					"id": 80020214,
					"content": "Bạn đúng là rất không thích giao tiếp.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020215
					]
				},
				{
					"id": 80020215,
					"content": "Giao thiệp với người đương nhiên là không thành vấn đề, còn với thần...thì thật khó nói.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020216
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020208,
					"content": "Lông lá thì không dễ thương sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020209
					]
				}
			]
		},
