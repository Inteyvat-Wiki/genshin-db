	"talks": [
		{
			"id": 800201,
			"completionStepIds": [
				800202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800202",
							"2"
						],
						"stepId": 800202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Barbara"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80020101,
					"content": "Kỵ Sĩ Danh Dự! Chào bạn, dạo này thế nào? Hôm nay có chuyện gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020102
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020102,
					"content": "À... Nhưng mà nói trước, muốn mượn Đàn Thiên Không là không được đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020103
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020103,
					"content": "(Xem ra cô ấy chưa phát hiện chuyện huyễn thuật...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020104,
					"content": "Chúng tôi đến hỏi thăm chút chuyện. Barbara có từng nghe nói đến chiếc máy cày đầu tiên trên thế giới không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020105,
					"content": "Hả? Đó là cái gì? Máy cày... Dùng để làm gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020106
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020106,
					"content": "Ừm, đúng là không biết mà. Vậy hỏi chuyện khác, giáo hội có từng làm mất Thất Thiên Thần Tượng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020107,
					"content": "Ơ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020108
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020108,
					"content": "Các bạn đến hỏi chuyện cũ sao? Thật bất ngờ, vì đây là chuyện rất lâu rồi, bây giờ không còn ai nhắc đến nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020109
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020109,
					"content": "Cách đây rất lâu, đúng là có một đêm Thất Thiên Thần Tượng đột nhiên biến mất, không để lại dấu vết gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020110
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020110,
					"content": "Lúc đó, gần như tất cả người trong giáo hội đều tham gia tìm kiếm, nhưng cuối cùng vẫn không tìm được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020111
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020111,
					"content": "Trong ghi chép của giáo hội, chuyện kỳ lạ đó được gọi là \"Thất Thiên Thần Tượng mất tích\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020112
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020112,
					"content": "Ừm... quả nhiên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020113,
					"content": "Quả nhiên?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020114
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020114,
					"content": "À, không có gì. Còn có manh mối gì khác không? Ừm, ý tôi là... Còn chuyện lạ gì khác không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020115,
					"content": "(Xin lỗi Barbara, tạm thời không thể nói cho bạn biết chuyện chúng tôi từng thấy Thần Tượng... Đây cũng là kết quả đã bàn bạc, vì sự an toàn của bạn...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020116,
					"content": "Chuyện lạ khác? Không rõ lắm, tôi nhớ những chuyện lạ giáo hội ghi chép lại... \"Oán hận của bạo quân\"? Không đúng, không liên quan lắm về thời gian...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020117
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020117,
					"content": "\"Oán hận của bạo quân\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020118,
					"content": "Ồ, chuyện kỳ lạ này cho thấy, tại Mondstadt thời cổ, nơi mà bây giờ được gọi là Phế Tích Phong Long đã có một khoảng thời gian trở nên rất nguy hiểm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020119
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020119,
					"content": "Trong một khoảng thời gian từ nhiều năm trước, chỉ cần có người đến gần nơi đó, sẽ có một quả cầu lửa từ trên trời rơi xuống.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020120
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020120,
					"content": "Quả cầu lửa từ trên trời rơi xuống?! Thật đáng sợ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020121,
					"content": "Khi đó, mọi người cho rằng đó là bùa chú của Ma Thần Rồng Cuộn, cho nên gọi nó là oán hận của bạo quân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020122
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020122,
					"content": "Hiện tượng kỳ lạ này kéo dài một năm, nhưng cuối cùng vẫn không giải quyết được, và sau đó từ từ dừng lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020123,
						80020124
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020123,
					"content": "Vậy thì lạ quá.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020125
					]
				},
				{
					"id": 80020125,
					"content": "Ừm, về sau giáo hội cho rằng, cách nói oán hận của bạo quân không ổn. Theo lý thì Ma Thần Rồng Cuộn sẽ không phun ra quả cầu lửa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020126
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020126,
					"content": "E rằng có một số nguyên nhân khác đã gây ra thảm họa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020127
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020127,
					"content": "Tóm lại, chuyện này có thể không liên quan gì đến \"thần tượng mất tích\". Nhưng những chuyện kỳ lạ khác thì tôi cũng không nghĩ ra được gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020128
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020128,
					"content": "Không sao, vẫn rất cảm ơn bạn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020129,
					"content": "\"Cám ơn\"? Dường như tôi lại nghe thấy từ ngữ phiền phức...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020130
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 80020130,
					"content": "A, là bạn sao, Rosaria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020131
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020131,
					"content": "Nếu muốn tìm Đội Kỵ Sĩ, thì hiện tại họ không có thời gian, \"đám ma vật đó\" lại đến rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020132
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 80020132,
					"content": "\"Đám ma vật đó\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020133
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020133,
					"content": "Chính là đám quái vật từng thừa cơ lúc xảy ra bạo loạn Phong Ma Long, định tấn công vào Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020134
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 80020134,
					"content": "Đó không phải là Giáo Đoàn Vực Sâu sao? Chúng lại có hành động rồi à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020135,
					"content": "Ừ, chúng đang tập họp tại <color=#00E1FFFF>Lang Lãnh</color>, đàn sói đang hỗn loạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020136
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 80020136,
					"content": "Giáo Đoàn Vực Sâu, có lẽ...đang nhắm vào \"Hồn Vua Sói Bắc Phong\"? Còn lý do vì sao thì tôi tạm thời vẫn chưa xác định được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020137
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 80020137,
					"content": "Đội trưởng Jean đã đến <color=#00E1FFFF>Lang Lãnh</color>, tôi cũng phải bắt đầu âm thầm hành động rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020138
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 80020138,
					"content": "Vậy, vậy tôi cũng muốn đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020139
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020139,
					"content": "Đội trưởng Jean nói, cần bạn ở lại giáo hội, hoàn thành chức trách của mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020140
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 80020140,
					"content": "Nhưng, nhưng bạn cũng là một bề tôi của Thần mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020141
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020141,
					"content": "Đừng lo lắng, tôi cũng sẽ đi theo giúp đỡ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020142
					]
				},
				{
					"id": 80020142,
					"content": "Đúng, chúng tôi cũng sẽ đi giúp đội trưởng Jean!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020143
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020143,
					"content": "Ừm...Được thôi, nếu đã có \"Kỵ Sĩ Danh Dự\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020144
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020144,
					"content": "Nhưng nhất định phải hành sự thật cẩn thận nhé. Cầu mong Phong Thần phù hộ mọi người bình an vô sự...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020124,
					"content": "Chưa chắc có liên quan đến bạo quân.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020125
					]
				}
			]
		},
		{
			"id": 800202,
