			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800208",
							"2"
						],
						"stepId": 800208,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Boreas"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80020701,
					"content": "Hừm...Nghi thức đã bị gián đoạn, các ngươi đúng là may mắn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020702
					],
					"speakerTitle": "Sứ Đồ Vực Sâu"
				},
				{
					"id": 80020702,
					"content": "Thật không ngờ, chỉ là linh hồn mà cũng có ý chí kiên cường như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020703
					],
					"speakerTitle": "Sứ Đồ Vực Sâu"
				},
				{
					"id": 80020703,
					"content": "Nhưng một biến số bé nhỏ như vậy, sẽ không đủ sức ảnh hưởng toàn cục.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020704
					],
					"speakerTitle": "Sứ Đồ Vực Sâu"
				},
				{
					"id": 80020704,
					"content": "Lại biến mất rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020705,
						80020706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020705,
					"content": "Chí ít đã ngăn cản được hành động của chúng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020707
					]
				},
				{
					"id": 80020707,
					"content": "Cám ơn các bạn, đã đến...đúng lúc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020708
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 80020708,
					"content": "\"Lupical\" của nhân loại...để các người nhìn thấy ta trong bộ dạng này, thật xấu hổ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020709
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 80020709,
					"content": "Nhưng Sứ Đồ Vực Sâu, đã quá xem thường ta rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020710
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 80020710,
					"content": "Vua Sói, không từ chối, thử thách. Nhưng, người ngoài, không tuân thủ, quy tắc thử thách.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020711
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 80020711,
					"content": "Ta cũng, không chú ý đến, cạm bẫy được đặt sẵn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020712
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 80020712,
					"content": "Cũng tức là, Giáo Đoàn Vực Sâu đã chuẩn bị sẵn cạm bẫy, sau đó dùng danh nghĩa thử thách, thức tỉnh \"Vua Sói\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020713,
						80020714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020713,
					"content": "Đây không phải lỗi của bạn, Razor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020715
					]
				},
				{
					"id": 80020715,
					"content": "#Cảm ơn bạn, {NICKNAME}. Sau này, móng vuốt của ta, cần phải, sắc bén hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020716
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 80020716,
					"content": "Các bạn, đánh hơi được sự nguy hiểm, nên đến đây sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020717
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 80020717,
					"content": "Không, chúng tôi nghe nói mới biết, chứ mũi của chúng tôi không hữu dụng lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020718,
					"content": "Ngoài việc đến giúp đỡ, chúng tôi còn có một việc muốn thỉnh giáo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020719
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020719,
					"content": "Xin hỏi...Vị Ma Thần đại nhân đây, bạn có biết \"máy cày đầu tiên của thế giới\" không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020720
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020720,
					"content": "Tôi không quan tâm các đồ vật của loài người chế tạo, không biết \"máy cày\" là gì. Nhưng nếu nói ấn tượng về máy móc, thì đã từng có một món.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020721
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 80020721,
					"content": "Nó đã xông vào trong bãi tập luyện của tôi, tôi xem nó như một dũng sĩ tham gia tập luyện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020722
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 80020722,
					"content": "Nhưng nó không có trí óc, chỉ có thể chiến đấu. Từ đầu đến chân, nó đúng là cỗ máy được chế tạo để giết chóc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020723
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 80020723,
					"content": "Cuối cùng, tôi đã phá hủy được nó. Trước khi gục ngã, nó đã rời khỏi bãi thí luyện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020724
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 80020724,
					"content": "Ồ...Nghe bạn mô tả như vậy, có vẻ cũng không loại trừ khả năng nó chính là \"máy cày đầu tiên của thế giới\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020725,
						80020727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020725,
					"content": "Nó biết xoay không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020726
					]
				},
				{
					"id": 80020726,
					"content": "Đúng vậy, nó biết xoay, nhảy cũng rất cao, còn có thể bắn ra cầu lửa. Sức mạnh tuy không bằng ma thần, nhưng mạnh hơn nhiều người có \"Vision\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020730
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 80020730,
					"content": "Cầu lửa...? Ừm, gần đây hình như có nghe nhắc đến từ này ở đâu đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020731
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020731,
					"content": "Tóm lại, thông tin này có thể chứng minh, \"máy cày đầu tiên của thế giới\" quả thực đã từng đến Mondstadt không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020732
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020732,
					"content": "Nghe có vẻ như, sức mạnh \"chiếc máy đệ nhất thế giới\" mạnh hơn rất nhiều so với các Thủ Vệ Di Tích sau này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020733
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020733,
					"content": "Nhưng trong câu chuyện này, nó hình như đã bị phá hỏng trong \"thử thách của sói\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020734
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020734,
					"content": "Không biết. Vậy thì, tôi đã giúp được các bạn chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020735
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 80020735,
					"content": "Đã giúp chúng tôi rất nhiều, xin cám ơn các bạn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020736
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020736,
					"content": "Chúng tôi phải tiếp tục điều tra một việc rất quan trọng. Tuy rằng Sứ Đồ Vực Sâu đã rời đi, nhưng cuộc tấn công của giáo đoàn vẫn chưa kết thúc, các bạn phải cẩn thận!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020737
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020737,
					"content": "Ừm, chúng tôi cũng ngửi thấy rồi, thứ nguy hiểm hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020738
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 80020738,
					"content": "Các bạn, cũng phải, bảo vệ bản thân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Razor"
				},
				{
					"id": 80020727,
					"content": "Nó có thể bắn đạn chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020728
					]
				},
				{
					"id": 80020728,
					"content": "\"Đạn\"? Không...Tôi đã nói rồi, tôi không quan tâm các tạo vật của loài người, không hiểu những từ ngữ kỳ lạ này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020729
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 80020729,
					"content": "Nó biết xoay, nhảy cũng rất cao, còn có thể bắn ra cầu lửa. Sức mạnh tuy không bằng ma thần, nhưng mạnh hơn nhiều người có \"Vision\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020730
					],
					"speakerTitle": "Boreas"
				},
