			"dialogs": [
				{
					"id": 80020301,
					"content": "Ở đây, không chào đón, ngươi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020302
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 80020302,
					"content": "Hahaha...Chỉ còn lại linh hồn mà vẫn có thói quen bảo vệ con cháu mình sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020303
					],
					"speakerTitle": "Sứ Đồ Vực Sâu"
				},
				{
					"id": 80020303,
					"content": "Muốn trở thành hộ vệ sao? Nhưng sức mạnh của hắn, rõ ràng không thể so sánh với nanh vuốt của Ma Thần xưa kia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020304
					],
					"speakerTitle": "Sứ Đồ Vực Sâu"
				},
				{
					"id": 80020304,
					"content": "Nhưng chỉ cần phục tùng bọn ta, thì ngươi sẽ lại có được quyền trượng thần linh, giống như xưa vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020305
					],
					"speakerTitle": "Sứ Đồ Vực Sâu"
				},
				{
					"id": 80020305,
					"content": "Hỗn...xược...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020306
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 80020306,
					"content": "Đây là nghi thức gì? Nhìn có vẻ rất đau khổ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020307,
					"content": "Ừm...là sự \"ăn mòn\" giống như lúc khống chế tâm trí Dvalin sao?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020308,
					"content": "Sói, không khuất phục. Nhưng, không thể, tiếp tục nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020309,
						80020310
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 80020309,
					"content": "Để tôi ngăn hắn lại.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020311
					]
				},
				{
					"id": 80020311,
					"content": "Bất luận bao nhiêu lần, nỗ lực của các ngươi chỉ là công cốc mà thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sứ Đồ Vực Sâu"
				},
				{
					"id": 80020310,
					"content": "Thêm một trận chiến nữa thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020311
					]
				}
			]
		},
