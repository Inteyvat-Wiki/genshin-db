				"objectNames": [
					"Dainsleif"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80020501,
					"content": "Hóa ra là vậy, Giáo Đoàn Vực Sâu đã bắt đầu triển khai hành động mới rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020502
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020502,
					"content": "Rất có thể có liên quan với \"Tượng Thần Ô Uế\", chúng ta cũng đi xem thử xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020503
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020503,
					"content": "Nhưng mà, Giáo Đoàn Vực Sâu đến Lang Lãnh để làm gì? Chẳng lẽ lại muốn tái diễn sự kiện Dvalin? Trời...Tai ương xin đừng lặp lại nữa chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020504,
					"content": "Không, chắc sẽ không đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020505
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020505,
					"content": "Khác với Osial đang bị trấn áp, ma thần \"Andrius\" đã chết từ lâu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020506
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020506,
					"content": "Ngày nay thứ đang bảo vệ Lang Lãnh, chỉ là hồn phách của hắn mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020507
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020507,
					"content": "Sứ Đồ Vực Sâu xem các hồn phách đó là mục tiêu, có lẽ muốn moi được thông tin hữu ích từ người thân của Phong Thần...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				}
			]
		},
		{
			"id": 800206,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
