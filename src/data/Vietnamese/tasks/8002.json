				{
					"id": 80020403,
					"content": "Niềm tin không đòi hỏi được đền đáp mà nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020404,
					"content": "Hừm, chỉ cần thần linh yên lòng, tôi cũng không nói nhiều làm gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020405
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020405,
					"content": "Suỵt! Sắp vào giáo đường rồi, không được nói linh tinh về Phong Thần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020406,
					"content": "Mà Phong Thần thật sự... À ừm, không có gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020407,
					"content": "Hừm, tôi vốn không có ý định vào giáo đường, việc nói chuyện với tu nữ giao cho các bạn đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020408
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020408,
					"content": "Ơ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020409,
						80020410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020409,
					"content": "Trước giờ vốn cùng nhau hành động mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020411
					]
				},
				{
					"id": 80020411,
					"content": "Bạn là Kỵ Sĩ Danh Dự của Thành Mondstadt, rất được tin tưởng, có lẽ họ sẽ rất yên tâm để bạn tham gia vào việc này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020412
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020412,
					"content": "Và sự xuất hiện của tôi sẽ chỉ làm tăng cảnh giác mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020413,
						80020414
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020413,
					"content": "Vì là người lạ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020415
					]
				},
				{
					"id": 80020415,
					"content": "Ừm, cũng như tên nhóc kia nói, bất cứ lúc nào... Tôi cũng có thể nói ra những lời giáo hội không muốn nghe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020416
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020416,
					"content": "Kẻ từ chối tín ngưỡng bước chân vào vùng đất thành kính, từ trước đến nay vốn không có kết quả tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020417
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020417,
					"content": "Tôi chưa từng nhận được ơn huệ của Thần, bây giờ và tương lai cũng không cần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020418
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020418,
					"content": "Được rồi, chuyện này nói cũng đủ rồi. Trong khi chúng ta trò chuyện, Giáo Đoàn Vực Sâu không hề dừng bước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020419
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020419,
					"content": "#Ơ, {NICKNAME}, vậy hai người chúng ta đi hỏi xem sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020420,
					"content": "Tôi vẫn phải nhắc nhở các bạn một câu, các bạn cũng đừng nhắc đến Tượng Thần Ô Uế trước mặt người của giáo hội.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020421
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020421,
					"content": "Giáo Hội Tây Phong sẽ không làm lơ chuyện của Thần Tượng, nhưng nếu họ nhúng tay vào, sợ là sẽ bứt dây động rừng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020422
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020422,
					"content": "Và... Bất kể là ai, động đến những việc liên quan đến Vực Sâu, thông thường cũng sẽ không có kết quả tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020414,
					"content": "Bạn nghĩ bạn sẽ không được chào đón sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020415
					]
				},
				{
					"id": 80020410,
					"content": "Bạn không tò mò sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020411
					]
				}
			]
		},
		{
			"id": 800205,
			"completionStepIds": [
				800210
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
