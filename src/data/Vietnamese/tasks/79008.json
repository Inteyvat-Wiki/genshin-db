			"dialogs": [
				{
					"id": 790080101,
					"content": "Chắc là cái này nhỉ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790080102
					],
					"speakerTitle": "Điều tra"
				},
				{
					"id": 790080102,
					"content": "Hửm? Bên cạnh còn một bức thư...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790080103
					],
					"speakerTitle": "Điều tra"
				},
				{
					"id": 790080103,
					"content": "Gửi những người bạn đã hữu duyên đến đây,",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790080104
					],
					"speakerTitle": "Điều tra"
				},
				{
					"id": 790080104,
					"content": "Xin chào những người bạn đến từ phương xa. Nếu bạn đọc được bức thư này thì có lẽ là bạn đã tìm được quả cầu tôi để lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790080105
					],
					"speakerTitle": "Điều tra"
				},
				{
					"id": 790080105,
					"content": "Trên Quần Đảo Táo Vàng có rất nhiều trò chơi liên quan đến quả cầu, tôi và những người bạn của tôi đã trải qua một mùa hè rất tuyệt vời ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790080106
					],
					"speakerTitle": "Điều tra"
				},
				{
					"id": 790080106,
					"content": "Vì vậy tôi đã để lại quả cầu mà mình làm, hy vọng người ngẫu nhiên phát hiện ra nó cũng sẽ được trải nghiệm niềm vui giống như tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790080107
					],
					"speakerTitle": "Điều tra"
				},
				{
					"id": 790080107,
					"content": "Hãy tận hưởng nắng, gió biển và những trò chơi mùa hè.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790080108
					],
					"speakerTitle": "Điều tra"
				},
				{
					"id": 790080108,
					"content": "Barbara",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790080109
					],
					"speakerTitle": "Điều tra"
				},
				{
					"id": 790080109,
					"content": "Không hổ là Barbara, nhờ phúc của bạn mà chúng ta cũng có được quả cầu rồi! Đi thôi, chơi thật vui nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Điều tra"
				}
			]
		},
