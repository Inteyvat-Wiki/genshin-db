						],
						"stepId": 2200901,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Soraya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220090101,
					"content": "Đạo Bảo Đoàn càng ngày càng manh động rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090102
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220090102,
					"content": "Bạn tìm tôi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220090103
					]
				},
				{
					"id": 220090103,
					"content": "Đúng vậy, tôi có chuyện cần nhờ bạn. Sau khi điều tra, Bao'er - người trước kia bạn từng nhắc đến chính là thành viên của Đạo Bảo Đoàn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090104
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220090104,
					"content": "Lý do cô ta hành động một mình... Có lẽ là muốn độc chiếm báu vật hoặc thăm dò đường cho đám Đạo Bảo Đoàn phía sau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090105
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220090105,
					"content": "Cô ta xuất hiện một mình cũng là để dễ ngụy trang bản thân. Xét cho cùng Nhà Lữ Hành có kinh nghiệm như bạn cũng bị cô ta lừa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090106
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220090106,
					"content": "Nếu cứ để cô ta hoành hành cùng đám Đạo Bảo Đoàn ngang ngược thì văn vật quanh đây sẽ bị tổn thất mất thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090107
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220090107,
					"content": "Vì vậy tôi muốn nhờ bạn ngăn chặn bọn chúng, tuy không thể đánh lui tất cả nhưng giải cứu được một vài văn vật cùng là điều tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090108,
						220090110,
						220090117
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220090108,
					"content": "Tôi biết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220090109
					]
				},
				{
					"id": 220090109,
					"content": "Vậy thì nhờ bạn nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220090110,
					"content": "Sao bạn lại biết được vị trí của chúng?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220090111
					]
				},
				{
					"id": 220090111,
					"content": "Hừm, nếu tôi đoán không lầm thì đám Đạo Bảo Đoàn luôn theo dõi tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090112
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220090112,
					"content": "Cho dù có lấy được \"báu vật\" từ chỗ tôi, lòng tham của chúng sẽ không bao giờ được lấp đầy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090113
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220090113,
					"content": "Chỉ cần là nơi tôi dừng chân, bọn chúng sẽ kéo đến đào bới khắp nơi với hy vọng lấy được báu vật bên dưới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090114
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220090114,
					"content": "Động não một chút tôi sẽ biết vị trí của chúng. Có điều tôi là một học giả mấy việc suy luận còn dễ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090115
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220090115,
					"content": "Còn việc đánh nhau thì phải nhờ đến Nhà Lữ Hành có kinh nghiệm như bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090116
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220090116,
					"content": "Nhờ bạn giúp tôi đánh bại bọn chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220090117,
					"content": "Tôi sẽ cho chúng một bài học.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220090118
					]
				},
				{
					"id": 220090118,
					"content": "Xin đợi một lát, tuy nói là \"ngăn cản\" nhưng tôi không muốn lật mặt tên Bao'er.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090119
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220090119,
					"content": "Đạo Bảo Đoàn mà phân tán sẽ rất khó theo dõi mục tiêu, bạn hiện tại giả vờ bị mắc câu là cơ hội ngàn vàng đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090120
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220090120,
					"content": "Tôi nghĩ chúng xuất hiện ở vùng đất Quy Li Nguyên này là có ý đồ gì đó. Bạn thân thiết với Bao'er sẽ có cơ hội thăm dò kế hoạch của bọn chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090121
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220090121,
					"content": "Vì vậy tạm thời bạn không cần phải lộ mặt, tôi tin với thực lực của bạn, hãy chọn một điểm tấn công bí mật... Sau đó giải quyết nhanh gọn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090122
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220090122,
					"content": "Nhớ là lấy được văn vật phải lập tức rời đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				}
			]
		},
