			"dialogs": [
				{
					"id": 220090301,
					"content": "Thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090302
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220090302,
					"content": "Đây là văn vật.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220090303
					]
				},
				{
					"id": 220090303,
					"content": "Quả thật không sai... Hoàn toàn đúng như tôi nghĩ, bọn chúng đào bới theo con dường mà tôi khảo sát.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090304
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220090304,
					"content": "Không cần kỹ năng gì đặc biệt, đám ô hợp này ỷ vào sức người đông, đào bới tùy tiện là sẽ ra văn vật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090305
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220090305,
					"content": "May là có bạn, nếu không những văn vật này sẽ bị hủy hoại rồi, thực sự cảm ơn bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				}
			]
		}
	]
