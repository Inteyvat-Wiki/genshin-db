				{
					"id": 30111113,
					"content": "Ừm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111101,
						30111102
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30111101,
					"content": "Thời gian không lặp lại...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30111103
					]
				},
				{
					"id": 30111103,
					"content": "Đúng vậy! Âm thanh của Akasha mỗi tối nói không chừng chính là để xóa đi ký ức ngày hôm đó của chúng ta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30111104,
					"content": "Cho nên khi tỉnh lại, mọi người đều tưởng rằng Lễ Hội Sabzeruz vẫn chưa qua, rõ ràng đã là \"ngày mai\" rồi, nhưng lại cứ ngỡ là \"hôm qua\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30111105,
					"content": "Nhưng ký ức cơ thể là thứ không thể xóa, cho nên Dehya càng ngày càng quen tay với thanh kiếm mới! Điều này có thể lý giải được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30111106,
					"content": "...Một suy luận rất khá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111107
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30111107,
					"content": "Vậy rốt cuộc là đã đúng hay chưa, Nahida!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30111108,
					"content": "Nói đơn giản thì giống như bắt Hỏa Tinh Điệp để làm đom đóm chiếu sáng vậy, quá chú trọng vào \"cảm nhận\" mà bỏ qua \"bản chất\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111109
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30111109,
					"content": "Thật không đơn giản...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30111110,
					"content": "Vẫn là một kết luận sai như trước đây sao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30111111
					]
				},
				{
					"id": 30111111,
					"content": "Hay là hai bạn đi tìm tiểu thư Dehya để nói chuyện thử nhé, nói không chừng sẽ có phát hiện mới đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111112
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30111112,
					"content": "Ừm, dẫu sao thì manh mối mới cũng được phát hiện từ chỗ cô ấy mà... chúng ta đi thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30111102,
					"content": "Mà là ký ức của chúng ta mỗi ngày đều bị xóa đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30111103
					]
				}
			]
		},
