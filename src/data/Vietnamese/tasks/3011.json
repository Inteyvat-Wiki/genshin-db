			"trigger": {
				"objectNames": [
					"Nahida"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30110101,
					"content": "...Vẫn là ngày này sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110102,
					"content": "Xem ra không đơn giản như chúng ta nghĩ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110103
					]
				},
				{
					"id": 30110103,
					"content": "Nahida, thực ra hôm qua cô đã biết được \"Samsara Của Lễ Hội Sabzeruz\" vẫn sẽ tiếp tục mà đúng không? Sao cô không nói trực tiếp cho chúng tôi luôn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110104,
					"content": "Nói rồi thì sẽ thế nào, các bạn rồi cũng sẽ lo lắng, và \"ngày mai\" rồi cũng sẽ như cũ thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110105
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30110105,
					"content": "Ngược lại... buông lỏng đi đôi chút nói không chừng sẽ khiến cho suy nghĩ của bản thân trở nên tỉnh táo hơn thì sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110106
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30110106,
					"content": "Nghĩ cũng phải... Nahida đang muốn tốt cho chúng ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110107,
					"content": "Đương nhiên rồi, ít ra thì trong thời gian này, các bạn chính là tất cả của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110108
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30110108,
					"content": "Ừm... sao lại đột nhiên nói ra những câu sến như vậy chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110109,
					"content": "Hahaha... ý của tôi là, tuy tôi đang nhờ hai bạn phá giải câu đố, nhưng ngược lại, cũng chỉ có hai bạn mới có thể thấy và cảm nhận được tôi thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110110
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30110110,
					"content": "Nói cách khác, nếu không có các bạn thì tôi và \"không tồn tại\" cũng không có gì khác biệt. Cho nên các bạn chính là tất cả của tôi, hiểu chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110111
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30110111,
					"content": "Nahida lại làm tôi đau đầu rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110112,
					"content": "Nói đến đây thôi, căn cứ theo manh mối mới của hôm qua, Nhà Lữ Hành đã có nhận thức mới về \"hiện trạng\" chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110113
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30110113,
					"content": "\"Vòng lặp thời gian\" đích thực là một kết luận sai lầm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110114
					]
				},
				{
					"id": 30110114,
					"content": "Sao, sao lại đột nhiên phủ nhận suy luận trước đó chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110115,
						30110116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110115,
					"content": "Võ nghệ của Dehya có tiến bộ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110117
					]
				},
				{
					"id": 30110117,
					"content": "Ừm, đúng nhỉ, trước đây tôi không có để ý đến điểm này, nếu đơn thuần là vòng lặp thời gian thì hẳn là sẽ tái lập lại trạng thái cơ thể...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110118,
					"content": "Vậy kết luận mới là gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30110116,
					"content": "Bệnh tình của Dunyarzad cũng trở nên nặng hơn...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110117
					]
				}
			]
		},
		{
			"id": 301102,
			"completionStepIds": [
				301102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"301102",
							"2"
						],
						"stepId": 301102,
						"stateName": "QUEST_STATE_UNFINISHED"
