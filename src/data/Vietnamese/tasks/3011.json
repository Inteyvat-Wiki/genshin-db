					"Nahida"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30110401,
					"content": "Nahida, chúng tôi về rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110402,
					"content": "Hôm nay về sớm thật, không lẽ là có thu hoạch gì mới sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110403
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30110403,
					"content": "Cũng có thể nói là vậy, chúng tôi trên cơ bản đã xác nhận được là thời gian không lặp lại, và nơi này có lẽ cũng không phải là thực tại... nhưng đồng thời chúng tôi cũng có một nghi vấn mới...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110404,
						30110405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110404,
					"content": "Nếu như ra khỏi thành thì sẽ như thế nào?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110406
					]
				},
				{
					"id": 30110406,
					"content": "Ra khỏi thành... theo như tôi nhớ thì có hai lần các bạn đã đề cập qua kế hoạch tương tự...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110407
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30110407,
					"content": "!?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110408
					]
				},
				{
					"id": 30110408,
					"content": "Chúng tôi đã nói qua sao! Sao chúng tôi lại không có ấn tượng gì nhỉ, vậy sau đó thì sao? Khi chúng tôi trở về đã nói cái gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110409,
					"content": "Để tôi nghĩ xem... hình như các bạn chưa từng đề cập qua kết quả của kế hoạch rời thành. À, có thể nói là, vào buổi tối hai lần có kế hoạch ra khỏi thành đó, hai bạn đều không quay về.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110410
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30110410,
					"content": "Nhưng bình thường các bạn cũng có không ít hôm không về nhà, cho nên tôi cũng không có cảm giác là nó sẽ chứng minh được điều gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110411
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30110411,
					"content": "Đúng là có lúc chúng tôi lo điều tra mà quên mất thời gian đến tận hôm sau. Nhưng mà ký ức hôm ra khỏi thành thì chúng tôi lại không có.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110412,
					"content": "Vậy sao, kỳ lạ thật. Trên nguyên lý thì hai bạn đã có được toàn bộ ký ức rồi mới phải.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110413,
						30110414
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30110413,
					"content": "Ngày mai thử lại lần nữa vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110415
					]
				},
				{
					"id": 30110415,
					"content": "Đúng vậy! Có gì đó rất không ổn, ngày mai chúng ta cần phải làm rõ chuyện này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110416,
					"content": "\"Tik...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110414,
					"content": "Có thể mấu chốt vấn đề là nằm ở đây.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110415
					]
				},
				{
					"id": 30110405,
					"content": "Chúng tôi có thật là chưa thử ra khỏi thành không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110406
					]
				}
			]
		},
