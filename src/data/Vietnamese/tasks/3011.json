			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dehya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30110201,
					"content": "...Hai vị đang ở đây sao, cuối cùng cũng tìm được rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110202
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110202,
					"content": "Dehya của hôm nay quả nhiên cũng không bị thương.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110203,
					"content": "Bị thương? Bị thương gì? Đừng coi thường tôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110204
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110204,
					"content": "Thanh kiếm mới của cô không phải không mấy thuận tay sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110205,
					"content": "Thực ra tôi cũng thấy lạ, hôm nay đột nhiên thuận tay đến lạ... À không đúng, sao hai người biết chuyện tôi mới đổi kiếm thế? Tôi chưa từng tiết lộ qua mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110206
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110206,
					"content": "#Ừm, lần này {NICKNAME} giải thích đi, tôi đã giải thích đến phát chán rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110207,
						30110208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110207,
					"content": "Thực ra cũng không cần phải để Dehya lý giải hoàn toàn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110209
					]
				},
				{
					"id": 30110209,
					"content": "Vậy sao, cũng đúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110210,
					"content": "Nguyên nhân khiến thanh kiếm của cô trở nên thuận tay là...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110211,
						30110212
					]
				},
				{
					"id": 30110211,
					"content": "Là do chúng ta đã trải qua rất nhiều lần Lễ Hội Sabzeruz rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110213
					]
				},
				{
					"id": 30110213,
					"content": "...Lúc tôi không có ở đây bộ có ai tới truyền giáo cho hai người sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110214
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110214,
					"content": "Ây da, đừng nghĩ nhiều quá, cô cứ tin đi là được rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110215,
					"content": "...Được rồi, tôi hiểu ý của hai người, ý là cơ thể tôi đã quen với thanh kiếm này, chỉ là đầu tôi không nhớ ra chuyện này thôi đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110216
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110216,
					"content": "Đúng vậy, mỗi ngày đều quên đi một lần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110217,
					"content": "Vậy tôi có thể phản biện không? Chuyện này tuyệt đối không thể nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110218
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110218,
					"content": "Sao? Cô thử nói xem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110219,
					"content": "Nếu đã rất nhiều ngày đều là Lễ Hội Sabzeruz như vậy, chỉ là do chúng ta không nhớ ra, vậy tất cả vật tư tiêu hao, tiền bạc đã dùng, thức ăn đã ăn thì giải thích thế nào đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110220
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110220,
					"content": "Chiếu theo lý mà nói thì túi tiền của tôi đã sớm trống trơn rồi mới phải chứ đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110221
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110221,
					"content": "Điểm này tôi cũng chưa nghĩ qua.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110222,
						30110223
					]
				},
				{
					"id": 30110222,
					"content": "Dưới góc nhìn của đám hiền giả đứng sau thì...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110224
					]
				},
				{
					"id": 30110224,
					"content": "Đúng vậy... dùng Akasha để ghi nhận lại hành vi mỗi ngày của toàn bộ người trong thành, sau đó vận dụng tài nguyên trong thành để khôi phục lại điểm bắt đầu của ngày hôm đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110225,
					"content": "Tuy nghe rất vô lý, nhưng hình như vẫn có thể làm được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110226,
					"content": "Không thể là không thể, tôi có chứng cứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110227
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110227,
					"content": "Cô có chứng cứ sao? Ở đâu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110228,
					"content": "Haiz... hai người cố chấp với cái suy luận viển vông này thật. Được rồi, để tôi chơi với hai người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110229
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110229,
					"content": "Đi theo tôi, tiểu thư Dunyarzad cũng đi chung nhé, xung quanh đây vẫn chưa an toàn đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110223,
					"content": "Nếu như lợi dụng số liệu Akasha và tài nguyên của toàn bộ thành phố thì...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110224
					]
				},
				{
					"id": 30110212,
					"content": "Chỉ là mỗi đêm đều sẽ bị xóa đi ký ức của hôm đó thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110213
					]
				},
				{
					"id": 30110208,
					"content": "Nói thẳng vào trọng tâm là được rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110209
					]
				}
			]
		},
