			"dialogs": [
				{
					"id": 30110301,
					"content": "Chính là cái này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110302
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110302,
					"content": "Đây là gì, cọc gỗ luyện kiếm hả? Vậy là sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110303,
					"content": "Nhìn thấy vết tích trên đó chứ? Là thành quả mấy ngày nay của tôi đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110304
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110304,
					"content": "Giả dụ như hiền giả không đến để đổi nó mỗi ngày, vậy thì nó đã sớm bị tôi chém cho banh xác rồi mới phải!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110305
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110305,
					"content": "Đúng ha, vậy trong trường hợp mỗi ngày đều đổi nó một lần thì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110306,
					"content": "Vậy thì hiền giả mỗi lần như vậy đều phải khôi phục lại vết tích mà tôi đã chém trước đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110307
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110307,
					"content": "Tôi cũng là chiến binh, trong trường phái võ thuật mà tôi học, rất coi trọng khả năng \"khống chế\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110308
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110308,
					"content": "Mỗi lần vung kiếm thì độ mạnh, góc độ đều phải dùng con tim để khống chế nó, cho nên mỗi vết tích trên đó tôi đều nhớ rõ, và tôi cũng nhớ cảm giác lúc vung nhát kiếm đó của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110309
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110309,
					"content": "Chính vì đạo lý này nên đường kiếm của chiến binh là độc nhất vô nhị, không ai có thể chém ra vết tích hoàn toàn giống nhau như thế. Cho nên việc mô phỏng vết chém của tôi là chuyện không thể.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110310
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110310,
					"content": "Không thể sao? Nếu như dùng công cụ nào đó để \"điêu khắc\" tỉ mỉ thì sao nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110311,
					"content": "Người ta hay nói, ảnh chụp sẽ không thể nào thay thế được phong cảnh mà họa sĩ đã vẽ ra, bởi vì nó không có linh hồn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110312
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110312,
					"content": "Đối với tôi cũng vậy, vết tích điêu khắc ra với vết tích của kết tinh võ nghệ... tôi nhìn cái là phân biệt ra ngay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110313,
						30110314
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110313,
					"content": "...Cũng có lý.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110315
					]
				},
				{
					"id": 30110315,
					"content": "Phù... vậy là không còn nghi vấn gì nữa rồi đúng không? Haiz, đây có phải là trò \"hỏi xoáy đáp xoay\" mà dạo này mấy tên học giả hay chơi không? Mà không ngờ cũng có chút thú vị đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110316
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110316,
					"content": "Vậy tạm như vậy trước nhé, hôm nay cũng không còn sớm rồi, tôi đưa tiểu thư Dunyarzad về chỗ Nilou đây, tạm biệt nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110317
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110317,
					"content": "Haiz... lại là ngõ cụt rồi, kết luận \"xóa đi ký ức\" cũng sai rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110318,
					"content": "Nhưng ít ra chúng ta cũng có một số kết luận cục bộ mà đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110319,
						30110320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110319,
					"content": "Thời gian không lặp lại.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110321
					]
				},
				{
					"id": 30110321,
					"content": "Ừm, đúng là như vậy, vậy giờ chúng ta còn có thể tìm được manh mối gì không đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110322,
						30110323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110322,
					"content": "Để tôi nghĩ xem...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110324
					]
				},
				{
					"id": 30110324,
					"content": "Kỳ lạ sao? Tôi cảm thấy gần đây toàn là mấy chuyện kỳ lạ đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110325,
					"content": "Chúng ta... tại sao không suy nghĩ đến chuyện rời khỏi thành phố nhỉ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110326
					]
				},
				{
					"id": 30110326,
					"content": "Hả...? Rời khỏi đây... đúng rồi! Chuyện đơn giản vậy sao chúng ta lại không nghĩ ra nhỉ. Để ra ngoài xem xem thời gian ở ngoài kia có bị kẹt trong cùng một ngày không, như vậy là sẽ xác nhận được rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110327,
					"content": "Thật không thể tin được, trước đây chúng ta nghĩ nát óc cũng không ra được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110328,
						30110329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110328,
					"content": "Thật kỳ lạ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110330
					]
				},
				{
					"id": 30110330,
					"content": "Hay là chúng ta về đó hỏi Nahida đi, về chuyện ra khỏi thành, không lẽ là do chúng ta đã quên đi gì đó sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110329,
					"content": "Có vẻ như mình đã nghĩ ra sớm rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110330
					]
				},
				{
					"id": 30110323,
					"content": "Tôi đột nhiên cảm thấy có một chuyện rất kỳ lạ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110324
					]
				},
				{
					"id": 30110320,
					"content": "Chúng ta không ở trong thực tại này.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110321
					]
				},
				{
					"id": 30110314,
					"content": "Xem ra chỉ có thể bỏ qua khả năng này thôi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110315
					]
				}
			]
		},
		{
			"id": 301104,
			"completionStepIds": [
				301104
			],
