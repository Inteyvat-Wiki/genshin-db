			"dialogs": [
				{
					"id": 756730101,
					"content": "Có vẻ như Thợ Pha Màu Asha đã vô cùng mãn nguyện rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730102
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 756730102,
					"content": "Chúng ta đã thành công giúp Asha thần kỳ hoàn thành thêm một thử thách đặc biệt nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730103
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 756730103,
					"content": "Tuyệt vời! Thành công thu thập màu vẽ rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756730104,
					"content": "Asha này là có ý tưởng rồi nên nóng lòng muốn vẽ ngay à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730105,
						756730106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756730105,
					"content": "Khoảnh khắc \"rộp rộp\" ấy chỉ trong một tích tắc mà thôi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756730107
					]
				},
				{
					"id": 756730107,
					"content": "#À, nó còn để lại không ít kho báu mà nó thu thập được nữa... Nên trao hết cho {NICKNAME} và Paimon làm thù lao mới phải!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730108
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 756730108,
					"content": "Biết đâu sau một thời gian chúng ta quay lại, sẽ được ngắm tác phẩm mới của Thợ Pha Màu Asha đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730109
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 756730109,
					"content": "Asha bình thường đã có thể phun ra màu sắc rất đẹp rồi, loại Asha đặc biệt này, liệu sẽ còn lợi hại đến mức nào đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756730110,
					"content": "Ôi, tôi bắt đầu mong chờ rồi đấy, biết đâu chúng có thể pha ra một thứ mà... không thể diễn tả bằng ngôn từ thông thường được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756730111,
					"content": "Nào là màu sắc của Phlogiston, của mặt trăng hay thậm chí là màu sắc của nơi sâu thẳm trên trời sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756730112,
					"content": "Đúng vậy, nên trong quá trình mạo hiểm, chỉ cần gặp những sinh linh đang gặp khó khăn, thì hãy cố gắng giúp đỡ họ một cách chân thành nhất có thể...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730113
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 756730113,
					"content": "Ừm ừm! Biết đâu một ngày nào đó, còn nhận được phần thưởng bất ngờ nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730114,
						756730115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756730114,
					"content": "Tôi cũng đồng ý với Bennett.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756730116
					]
				},
				{
					"id": 756730116,
					"content": "À, nhưng mà... nếu chỉ giúp đỡ vì muốn nhận lại cái gì đó thì có hơi sai lệch rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730117
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 756730117,
					"content": "Dù không có bất kỳ phần thưởng nào, thì thấy vấn đề được giải quyết, những người bạn vốn lo lắng được vui vẻ trở lại, mọi thứ đều phát triển theo hướng tốt đẹp...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730118
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 756730118,
					"content": "Tôi thích cảm giác này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bennett"
				},
				{
					"id": 756730115,
					"content": "Cảm giác như thế rất trọn vẹn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756730116
					]
				},
				{
					"id": 756730106,
					"content": "Không ai muốn bỏ lỡ khoảnh khắc cảm hứng tốt nhất mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756730107
					]
				}
			]
		}
	]
