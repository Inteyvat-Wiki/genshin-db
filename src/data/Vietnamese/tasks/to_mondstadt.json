					],
					"speakerTitle": "Tyler"
				},
				{
					"id": 105010421,
					"content": "Vậy có cần tôi nói trên người mấy anh có bao nhiêu món đồ là do ăn cướp được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010422
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010422,
					"content": "Sau khi tôi nói xong nếu không phục thì cứ tìm người ra đối chiếu là rõ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010423
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010423,
					"content": "Nếu tôi thua thì sẽ bồi thường cho anh 2 vạn Mora. Còn nếu tôi thắng thì các anh sẽ phải vào tù ở cảng Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010424
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010424,
					"content": "Thế nào, nếu đúng là thương nhân thì sợ gì chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010425
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010425,
					"content": "Cô, cô...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010426
					],
					"speakerTitle": "Tyler"
				},
				{
					"id": 105010426,
					"content": "Cô chọc giận ta rồi đấy nhóc con!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010427
					],
					"speakerTitle": "Tyler"
				},
				{
					"id": 105010427,
					"content": "Ta không cần biết làm sao cô biết, nhưng chỉ cần tiêu diệt cô thì sẽ không ai biết!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010427,
						105010428
					],
					"speakerTitle": "Tyler"
				},
				{
					"id": 105010428,
					"content": "Mona cẩn thận!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010430
					]
				},
				{
					"id": 105010429,
					"content": "Ta không để các ngươi làm hại cô ấy đâu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010430
					]
				},
				{
					"id": 105010430,
					"content": "Không sao đâu, chỉ là vài tên cướp thôi mà.",
