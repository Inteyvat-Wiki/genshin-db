					"content": "Được, vậy quý khách còn muốn gọi thêm gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011206
					],
					"speakerTitle": "Yuhua"
				},
				{
					"id": 105011206,
					"content": "Tôi... tôi muốn hỏi một chút, những món đã gọi tổng cộng hết khoảng bao nhiêu Mora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011207
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011207,
					"content": "Ừm, khoảng hai mươi ngàn Mora đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011208
					],
					"speakerTitle": "Yuhua"
				},
				{
					"id": 105011208,
					"content": "Vậy chẳng phải... À tôi, cho tôi một tô Mì Somen là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011209
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011209,
					"content": "Được, một tô Mì Somen đúng không. Các vị chờ chút, đồ ăn sẽ lên ngay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011210
					],
					"speakerTitle": "Yuhua"
				},
				{
					"id": 105011210,
					"content": "Thật ra lúc ăn cơm tôi cảm thấy rất kỳ lạ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105011211,
					"content": "Tại sao cô ấy chỉ gọi một tô Somen vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105011212
					]
				},
				{
					"id": 105011212,
					"content": "Là vì... Cô ấy thật sự thiếu tiền sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105011213,
					"content": "Tôi nghe hết rồi! Đã nói là tôi mời, sao có thể không đủ Mora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011214
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011214,
					"content": "Nhà chiêm tinh phải chuyên chú nghiên cứu các vì sao, nếu như bị những thứ tầm thường làm phiền, thì sẽ ảnh huởng đến kết quả phán đoán.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011215
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011215,
					"content": "Nhất là dùng quá nhiều Mora để thỏa mãn nhu cầu, rất thô tục...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011216
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011216,
					"content": "Ọc ọc ọc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011217
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011217,
					"content": "...Và nguy hiểm nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011218
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011218,
					"content": "Cho nên không ăn những món chúng tôi gọi, cũng là tôn nghiêm của nhà chiêm tinh sao? Thật khó hiểu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105011219,
					"content": "Nhưng chỉ có chúng ta ăn uống thoải mái, như vậy có ổn không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105011220,
					"content": "Để tôi phụ một tay.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105011221
					]
				},
				{
					"id": 105011221,
					"content": "Ừm, đúng vậy, cũng có thể như vậy! Cô đợi chúng tôi một chút nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
