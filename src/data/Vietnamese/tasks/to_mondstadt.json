					"nextDialogs": [
						105011508
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011508,
					"content": "À, ý tôi là... khụ khụ, không ngờ đồ đệ lại có sở trường nấu nướng, sư phụ rất hài lòng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011509,
						105011510
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011509,
					"content": "Ăn no là được rồi.",
