						105011511
					]
				},
				{
					"id": 105011511,
					"content": "Ẩm thực của Liyue không phải chỉ có hư danh thôi đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011512
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011512,
					"content": "Nghĩ lại, tiêu nhiều Mora như vậy cũng không đau lòng lắm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011513
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011513,
					"content": "Không có gì, không có gì. Ăn uống no say rồi, chúng ta xuất phát thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011514
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011514,
					"content": "Từ đây đi về phía bắc sẽ có thể đến <color=#00E1FFFF>Cổng Đá</color>, sau đó có thể vào địa phận Mondstadt rồi.",
