					"nextDialogs": [
						105011515
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011515,
					"content": "Không biết có thể học được kiến thức cao thâm gì đây? Thật kỳ vọng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011510,
					"content": "Rõ ràng là ăn rất vui vẻ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105011511
					]
				},
				{
					"id": 105011504,
					"content": "Dành riêng cho cô đó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105011505
					]
				},
				{
