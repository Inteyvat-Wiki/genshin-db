			},
			"dialogs": [
				{
					"id": 706890114,
					"content": "<color=#FFCC33FF>Có chuyện gì mới mẻ không?</color>",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706890101
					]
				},
				{
					"id": 706890101,
					"content": "#{NICKNAME}, đến đúng lúc lắm. Tôi có một thứ muốn giao cho {F#cô}{M#cậu}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706890102,
						706890103
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 706890102,
					"content": "Là thư cầu cứu hay manh mối kho báu thế?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706890104
					]
				},
				{
					"id": 706890104,
					"content": "#...{F#Cô}{M#Cậu} quả thực đã rất quen thuộc với các công việc của hiệp hội đấy. Nhưng rất tiếc, món đồ này không liên quan gì đến những ủy thác trên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706890105
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 706890105,
					"content": "Hãy cầm lấy sổ tay mới do hiệp hội làm nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706890106,
						706890107
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 706890106,
					"content": "Không phải đã có sổ tay mạo hiểm rồi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706890108
					]
				},
				{
					"id": 706890108,
					"content": "Tác dụng chính của sổ tay mạo hiểm là ghi lại tình hình hoàn thành ủy thác của các nhà mạo hiểm, và một số thông tin liên quan đến ma vật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706890109
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 706890109,
					"content": "Còn cuốn sổ tay này sẽ giúp các nhà mạo hiểm ghi lại những câu chuyện kỳ thú đã gặp trong chuyến đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706890110,
						706890111
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 706890110,
					"content": "Vậy à...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706890112
					]
				},
				{
					"id": 706890112,
					"content": "#Có thể giúp được {F#cô}{M#cậu} thì tốt quá. Vậy ủy thác lần này đã hoàn thành rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706890113
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 706890113,
					"content": "#Hãy tiếp tục tự do mạo hiểm nhé, {NICKNAME}. Hướng về những ngôi sao và vực sâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 706890111,
					"content": "Đúng là có ích đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706890112
					]
				},
				{
					"id": 706890107,
					"content": "Sao lại đưa tôi thêm một cuốn nữa vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706890108
					]
				},
				{
					"id": 706890103,
					"content": "Là ủy thác hộ tống hay ủy thác tìm người thế?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706890104
					]
				}
			]
		},
