			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120090101,
					"content": "Katheryne, chúng tôi đến rồi, có chuyện gì cần chúng tôi giúp sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120090102,
					"content": "Xin lỗi vì đã làm phiền. Lần này Hiệp Hội Tenryou đã gửi ủy thác cho Hiệp Hội Nhà Mạo Hiểm, rất quan trọng, cũng rất nguy hiểm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090103
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 120090103,
					"content": "Sau khi xem xét thì hiệp hội cho rằng chỉ có thể giao cho nhà mạo hiểm có kinh nghiệm nhất, thế là tôi đã nghĩ đến các bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090104
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 120090104,
					"content": "Hihi, nào có lợi hại đến thế đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090105,
						120090106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120090105,
					"content": "Nghe có vẻ nguy hiểm nhỉ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090107
					]
				},
				{
					"id": 120090107,
					"content": "Để tôi nói rõ hơn. Hiệp Hội Tenryou gần đây đã phát lệnh truy nã, họ muốn tìm một thanh niên thuộc tộc Oni, tên là \"Arataki Itto\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090108
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 120090108,
					"content": "Tộc Oni sao? Tôi hình như có nghe qua, là những người trông rất hung dữ, trên đầu có sừng đúng không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120090109,
					"content": "Đúng vậy, tên này rất huênh hoang ồn ào, cho nên cũng có chút tiếng tăm trên đường phố. Tuy nói là vậy nhưng hắn trước giờ cũng chưa có tiền án gì lớn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090110
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 120090110,
					"content": "Nhưng không ngờ dạo này hắn đã bắt đầu bắt cóc cướp của...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090111
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 120090111,
					"content": "Không những làm chuyện xấu, mà khi Hiệp Hội Tenryou ra lệnh bắt hắn thì hắn còn chống đối người thi hành công vụ rồi dắt theo đồng bọn chạy trốn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090112
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 120090112,
					"content": "Có cảm giác hắn rất hung dữ nhỉ!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090113
					]
				},
				{
					"id": 120090113,
					"content": "Nói chung thì muốn chúng tôi đi bắt kẻ xấu về đây đúng không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120090114,
					"content": "#Yên tâm yên tâm, {NICKNAME} lợi hại lắm, hắn không đủ khả năng để chống lại {NICKNAME} đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120090115,
					"content": "Ừm, nhưng cũng đừng hành động lỗ mãng quá, người này có Vision, hơn nữa còn là đại ca của \"Bang Arataki\" nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090116,
						120090118
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 120090116,
					"content": "Tôi không giỏi một chấp một đống đâu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090117
					]
				},
				{
					"id": 120090117,
					"content": "Cũng đúng, dẫu sao thì chúng ta cũng chưa hiểu rõ về hắn. Nghe bạn nói vậy thì đúng là cẩn thận vẫn hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120090120,
					"content": "Về những thông tin liên quan đến Arataki Itto, tại sao hắn phải làm chuyện này, giờ đã trốn đi đâu, chúng tôi tạm thời chưa rõ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090121
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 120090121,
					"content": "Mọi người trên con phố này có lẽ hiểu rõ hắn hơn tôi, có lẽ bạn nên hỏi thăm người dân xung quanh vẫn hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090122
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 120090122,
					"content": "Ừm, tôi sẽ đi thám thính.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090123
					]
				},
				{
					"id": 120090123,
					"content": "Cảm ơn bạn đã hỗ trợ, tôi sẽ đợi tin tốt từ bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 120090118,
					"content": "Tôi còn có Paimon mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090119
					]
				},
				{
					"id": 120090119,
					"content": "Bậy! Đừng kêu tôi đi đánh nhau nha, tôi chưa muốn thể hiện khả năng của mình đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120090106,
					"content": "Hiệp Hội Tenryou cũng không thể tự mình giải quyết sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090107
					]
				}
			]
		},
		{
			"id": 1200902,
			"completionStepIds": [
				1200902
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
