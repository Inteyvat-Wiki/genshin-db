			},
			"dialogs": [
				{
					"id": 120090401,
					"content": "Arataki Itto? Tôi biết, chúng tôi đang đi bắt hắn đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090402
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 120090402,
					"content": "Hắn đã chạy ra khỏi Thành Inazuma rồi, do chưa có manh mối gì nên chúng tôi đã ủy thác người khác tìm giúp, bao gồm cả các nhà mạo hiểm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090403
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 120090403,
					"content": "Katheryne nói với chúng tôi là Arataki Itto trước giờ chưa gây ra chuyện lớn, lần này có vẻ như khá đột ngột đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120090404,
					"content": "Nhưng mà vụ bắt cóc cướp giật đó đều đã có chứng cứ rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120090405,
					"content": "Đương nhiên rồi, nếu không thì cũng không huy động nhiều người đến vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090406
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 120090406,
					"content": "Tuy là những tên cướp thường sẽ tìm cách để che giấu thân phận của mình, nhưng tộc Oni lại rất dễ phân biệt, nhìn sơ qua sẽ biết ngay là hắn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090407
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 120090407,
					"content": "Không lẽ tộc Oni không có người khác sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090408
					]
				},
				{
					"id": 120090408,
					"content": "Ban đầu chúng tôi chỉ nghi ngờ hắn thôi, nhưng khi đi điều tra thì hắn đã trực tiếp nhận tội, lại còn khiêu khích chúng tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090409
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 120090409,
					"content": "Điều đáng nói hơn là hắn đã dẫn theo người của mình trốn thoát... tên này chắc chắn đã lên kế hoạch từ trước rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090410
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 120090410,
					"content": "Hắn có động cơ phạm tội gì không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090411
					]
				},
				{
					"id": 120090411,
					"content": "Đương nhiên rồi, dù là động cơ tâm lý hay là động cơ thực tế đều có đủ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090412
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 120090412,
					"content": "Hắn nghèo kiết xác, cũng không có công việc đàng hoàng, nghe nói hắn còn phải chăm sóc cho cả bang hội, trách nhiệm cũng nặng lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090413
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 120090413,
					"content": "Thay vì cứ chịu khổ như vậy mãi, có thể hắn đã nghĩ rằng làm điều ác sẽ giúp hắn sống thoải mái hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090414
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 120090414,
					"content": "Còn về động cơ tâm lý, bây giờ nói ra có hơi ngại, khi \"Lệnh Truy Lùng Vision\" diễn ra, chính chúng tôi đã đoạt đi Vision của hắn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090415
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 120090415,
					"content": "Ra là hắn muốn báo thù Hiệp Hội Tenryou sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090416
					]
				},
				{
					"id": 120090416,
					"content": "Lúc đó tên Arataki Itto phản kháng quyết liệt lắm, chúng tôi phải nhờ đến đại nhân Kujou Sara mới có thể hàng phục hắn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090417
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 120090417,
					"content": "...Chuyện này đúng là do lỗi của chúng tôi, nhưng không ngờ hắn vì muốn báo thù mà giở những thủ đoạn quá khích này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090418
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 120090418,
					"content": "Nghe thì có vẻ đúng là một tên thần kinh không ổn định nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090419,
						120090420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120090419,
					"content": "Động cơ có vẻ như khá rõ ràng rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090421
					]
				},
				{
					"id": 120090421,
					"content": "Ừm, nếu như các bạn có thể bắt được Arataki Itto thì cứ mang hắn đến chỗ tôi, chúng tôi sẽ xử lý theo pháp luật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090422
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 120090422,
					"content": "Được, cảm ơn thông tin của bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120090420,
					"content": "Xem ra chứng cứ cũng đã đủ rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090421
					]
				}
			]
