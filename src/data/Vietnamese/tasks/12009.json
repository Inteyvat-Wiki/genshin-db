			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ogura Mio",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120090201,
					"content": "Arataki Itto? À, tôi biết chuyện của hắn, tôi nghĩ có lẽ Hiệp Hội Tenryou tìm nhầm người rồi, hắn sao lại làm chuyện ác được chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090202
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 120090202,
					"content": "Hử? Tại sao lại khẳng định như vậy, bạn tin tưởng hắn đến thế sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120090203,
					"content": "Bạn hiểu lầm rồi, ý của tôi là, hắn có thể không có \"năng lực\" để làm chuyện xấu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090204,
						120090205
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 120090204,
					"content": "Không đủ... sức mạnh sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090206
					]
				},
				{
					"id": 120090206,
					"content": "Nghe tôi kể là các bạn sẽ hiểu ngay thôi. Hắn trước đây thường xuyên chơi oẳn tù tì với trốn tìm cùng lũ trẻ trên phố.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090207
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 120090207,
					"content": "Các bạn cũng biết đám trẻ con ở đây rất ngây thơ rồi, vậy mà đôi khi Arataki Itto cũng bị thua thê thảm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090208
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 120090208,
					"content": "Do hắn cố ý sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120090209,
					"content": "Không không, có lần tôi thấy hắn thắng một đứa trẻ, hắn vui mừng đến nỗi nhảy cẫng lên, lại hò hét mấy câu như \"cuối cùng cũng thắng rồi!\"... \"Bổn đại gia là vô địch\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090210
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 120090210,
					"content": "Do chiến thắng nên hắn giành được cây kẹo của đứa nhóc, còn ăn trước mặt nó nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090211
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 120090211,
					"content": "Woa, nhẫn tâm thế!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120090212,
					"content": "Lần đó hắn đúng là quá đáng thật, nên tôi đã thay mặt đứa trẻ đó giáo huấn hắn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090213
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 120090213,
					"content": "Hắn nhận lỗi nhanh lắm, mặt cũng rất nghiêm túc nữa, làm cho lũ trẻ không nhịn cười được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090214
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 120090214,
					"content": "Do hắn \"có chơi có chịu\" nên đám trẻ con rất thích chơi với hắn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090215
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 120090215,
					"content": "Một kẻ thường xuyên thua cả trẻ con như thế... làm sao lại làm chuyện xấu được chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090216,
						120090217
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 120090216,
					"content": "Tôi hiểu ý của bạn rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090218
					]
				},
				{
					"id": 120090218,
					"content": "Nghe qua thì có vẻ hắn không phải là người xấu, mà lại là người rất có nguyên tắc thì phải.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120090219,
					"content": "Ừm, tôi cũng nghĩ như vậy, nhưng nghe nói là Hiệp Hội Tenryou đã có được bằng chứng thì phải.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090220
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 120090220,
					"content": "Tôi cũng không muốn nói giúp cho hắn ta, nếu như hắn phạm tội thì phải ngoan ngoãn chịu phạt thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090221
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 120090221,
					"content": "Ừm, cảm ơn bạn! Chúng tôi đến chỗ khác thám thính tiếp đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120090217,
					"content": "Bất ngờ thật đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090218
					]
				},
				{
					"id": 120090205,
					"content": "Không đủ... thông minh sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090206
					]
				}
			]
		},
		{
