				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120090301,
					"content": "Arataki Itto sao? Nghe nói dạo gần đây hắn gây ra chuyện gì đó nên đã bỏ trốn rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090302
					],
					"speakerTitle": "Furuya Noboru"
				},
				{
					"id": 120090302,
					"content": "Khi vừa mới nghe thì tôi cũng có chút bất ngờ, nhưng mà... cũng không bất ngờ lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090303
					],
					"speakerTitle": "Furuya Noboru"
				},
				{
					"id": 120090303,
					"content": "Do tiếng tăm của hắn trước giờ cũng không tốt đẹp gì đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120090304,
					"content": "Không, nói sao nhỉ... khụ khụ, hắn chỉ hống hách trong mọi việc mà hắn làm, khiến người ta cảm thấy hắn rất sôi nổi và ồn ào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090305
					],
					"speakerTitle": "Furuya Noboru"
				},
				{
					"id": 120090305,
					"content": "Người như vậy nói dễ nghe thì là nhiệt huyết, nói khó nghe thì là tâm trạng thất thường, lúc vui thì vui quá, lúc nóng thì lại nóng quá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090306
					],
					"speakerTitle": "Furuya Noboru"
				},
				{
					"id": 120090306,
					"content": "Ấn tượng của Arataki Itto cũng không hẳn là xấu, nhưng khi hắn kích động lên có mất kiểm soát hay không, thì tôi cũng khó mà đoán được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090307,
						120090308
					],
					"speakerTitle": "Furuya Noboru"
				},
				{
					"id": 120090307,
					"content": "Hắn thường ngày sẽ làm gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090309
					]
				},
				{
					"id": 120090309,
					"content": "Tôi cũng không rõ, khụ khụ... bình thường tôi cũng khá để tâm đến cuộc sống trong thành, nhưng hình như Arataki Itto chỉ lông bông cả ngày thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090310
					],
					"speakerTitle": "Furuya Noboru"
				},
				{
					"id": 120090310,
					"content": "Nếu có người cần giúp thì hắn sẽ giúp, còn những lúc khác thì chỉ đi quậy phá với lũ trẻ và các thuộc hạ thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090311
					],
					"speakerTitle": "Furuya Noboru"
				},
				{
					"id": 120090311,
					"content": "Haiz, có phải do không có thu nhập nên gần đây hắn mới làm chuyện xấu không nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090312
					],
					"speakerTitle": "Furuya Noboru"
				},
				{
					"id": 120090312,
					"content": "Con người này kỳ lạ quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120090313,
					"content": "Xin lỗi nhé, những chuyện khác tôi không rõ lắm, hắn thích chơi với những người sôi nổi hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090314
					],
					"speakerTitle": "Furuya Noboru"
				},
				{
					"id": 120090314,
					"content": "Hay là bạn đi hỏi thăm người khác thử nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090315
					],
					"speakerTitle": "Furuya Noboru"
				},
				{
					"id": 120090315,
					"content": "Ừm, cảm ơn bạn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120090308,
					"content": "Hắn không có công việc ổn định sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090309
					]
				}
			]
		},
		{
