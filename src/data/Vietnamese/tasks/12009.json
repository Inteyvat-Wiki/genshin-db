			"dialogs": [
				{
					"id": 120090501,
					"content": "Xin chào, chúng tôi đến để hỏi thăm chuyện của Arataki Itto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120090502,
					"content": "Lại là hắn sao... đương nhiên là được, trước đó tôi đã từng giúp Hiệp Hội Tenryou điều tra. Nhưng mà, các bạn đã chuẩn bị đủ phí tư vấn chưa đó?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090503
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 120090503,
					"content": "Tôi cũng có nghe qua danh tiếng của các bạn, trải qua nhiều sóng gió như vậy chắc cũng hiểu quy tắc nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090504
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 120090504,
					"content": "Vậy, vậy... phải cần bao nhiêu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120090505,
					"content": "397.000 Mora, thanh toán một lần, nếu như bắt thành công Arataki Itto về quy án, thì tôi còn phải thu thêm phí hoa hồng bằng 5% thù lao của hiệp hội nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090506
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 120090506,
					"content": "Mắc quá! Con số này sao cô tính ra được thế!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120090507,
					"content": "Haha, nghe tôi nói hết đã chứ, khoản phí này thì Hiệp Hội Tenryou đã trả rồi, cho nên các bạn chỉ cần trả tiền hoa hồng thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090508
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 120090508,
					"content": "Còn phần tiền hoa hồng thì tôi cũng sẽ tính với Hiệp Hội Nhà Mạo Hiểm, thành ra các bạn được lợi lắm rồi đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090509
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 120090509,
					"content": "Vậy thì, nếu muốn tìm hiểu chuyện này thì phải nhắc đến câu chuyện cổ tích nổi tiếng của Inazuma rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090510
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 120090510,
					"content": "Vậy còn Thanh Quỷ thì sao rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120090511,
					"content": "Thanh Quỷ đã biến mất, không còn gặp lại nữa, chỉ còn lại Xích Quỷ mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090512
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 120090512,
					"content": "Huhu, sao lại thế... Thanh Quỷ đúng là một đứa trẻ tốt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120090513,
					"content": "Câu chuyện cổ tích có liên quan gì đến hiện thực không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090514
					]
				},
				{
					"id": 120090514,
					"content": "Có chứ, không thì tôi cũng không kể rồi. Có người nói là... câu chuyện cổ tích này được cải biên từ lịch sử, và Arataki Itto chính là hậu duệ của Xích Quỷ trong câu chuyện đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090515
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 120090515,
					"content": "Điều tôi muốn nói với bạn là, tộc Oni năm xưa đã hy sinh rất nhiều mới có thể hòa nhập với con người, nhưng mà tính cách của tộc Oni vẫn có phần bất ổn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090516
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 120090516,
					"content": "Loại tính cách bất ổn này thuộc về huyết mạch di truyền từ nhiều đời rồi. Arataki Itto xưa nay chưa từng làm chuyện xấu, nhưng nói không chừng cũng sẽ có ngày thay đổi tính tình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090517
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 120090517,
					"content": "Nhưng nếu là vậy thì chẳng phải Xích Quỷ đã phản bội lại ước nguyện của Thanh Quỷ rồi sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120090518,
					"content": "Đó đều là những chuyện xa xưa rồi. Thanh Quỷ cũng đã không xuất hiện trong một thời gian dài, e rằng sớm đã bị diệt vong rồi, do đó cũng không còn căn cứ để nói về chuyện phản bội.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090519
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 120090519,
					"content": "Hơn nữa...đương sự cũng đã thừa nhận rồi, vậy thì còn nghi ngờ gì nữa nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090520
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 120090520,
					"content": "Theo điều tra của tôi thì hắn đã chạy về hướng tây nam, rất có thể hiện giờ hắn đang ở <color=#00E1FFFF>Đảo Yashiori</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090521
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 120090521,
					"content": "Quân của Hiệp Hội Tenryou sẽ không thể đến khu vực của quân Sangonomiya bắt người, cho nên Arataki Itto cũng có lý do để chạy đến đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090522
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 120090522,
					"content": "Tôi hiểu rồi, cảm ơn tình báo của bạn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090523
					]
				},
				{
					"id": 120090523,
					"content": "Không sao, đây là việc nên làm mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090524
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 120090524,
					"content": "Đợi đã, tôi còn một câu hỏi, nếu như cái tên Arataki Itto tính nết thất thường như vậy, có phải sẽ rất nóng nảy, rất hung dữ đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090525
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120090525,
					"content": "Có lẽ là vậy, từ góc độ những người đã từng tỉ thí với hắn mà nói, hắn rất khỏe và giỏi đánh nhau, chỉ với sức của các bạn không biết có thể chế ngự được hắn không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090526
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 120090526,
					"content": "Vậy... chuyện rải đậu trong truyện cổ tích đó có tác dụng gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090527
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120090527,
					"content": "À, bạn nói tôi mới nhớ ra, hình như Arataki Itto dị ứng với đậu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090528
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 120090528,
					"content": "Tộc Oni đều khá sợ đậu, hắn ta càng đặc biệt sợ, nghe nói là chạm vào thôi cũng không thể.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090529
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 120090529,
					"content": "Nếu làm hắn dị ứng để giảm bớt sức mạnh của hắn thì có lẽ sẽ bắt hắn dễ dàng hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090530,
						120090532
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 120090530,
					"content": "Chỉ còn cách này thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090531
					]
				},
				{
					"id": 120090531,
					"content": "Đúng rồi, tìm được nhược điểm sẽ thuận tiện hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090534
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120090534,
					"content": "Tôi ở đây có một túi đậu, vốn định nấu cháo ăn, giờ tôi giao cho các bạn nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090535
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 120090535,
					"content": "Tiền của túi đậu này tôi sẽ tính vào khoản thanh toán của hiệp hội.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090536
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 120090536,
					"content": "Quả nhiên là có ý đồ! Nhưng mà cảm ơn bạn nhé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090537
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120090537,
					"content": "Chúng ta đến <color=#00E1FFFF>Đảo Yashiori</color> tìm hắn thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120090532,
					"content": "Như vậy thì có thắng cũng chẳng vinh quang gì.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090533
					]
				},
				{
					"id": 120090533,
					"content": "Đối mặt với kẻ xấu thì không cần phải suy nghĩ nhiều quá đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090534
					],
					"speakerTitle": "Paimon"
				}
			]
		},
