			"trigger": {
				"objectNames": [
					"Bé Que'er",
					"Zhiruo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210370401,
					"content": "Chị Zhiruo, chị... chị nói xem có phải sư huynh cố ý không! Anh ấy... anh ấy không muốn ở cùng chúng ta! Hic...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370402
					],
					"speakerTitle": "Bé Que'er"
				},
				{
					"id": 210370402,
					"content": "Em à, hai người sớm tối có nhau mà, sao anh ấy lại không hiểu tâm ý của em chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370403
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 210370403,
					"content": "Anh ấy rời khỏi Liyue đi du lịch cũng là có cân nhắc riêng, em đi cùng anh ấy cũng đâu có sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370404
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 210370404,
					"content": "Em không muốn rời xa Liyue! Chúng ta cùng nhau sống ở đây không được sao? Phái Cổ Hoa... quan tâm Phái Cổ Hoa làm gì chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370405
					],
					"speakerTitle": "Bé Que'er"
				},
				{
					"id": 210370405,
					"content": "Vậy sao em không nói những lời này với anh ấy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370406
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 210370406,
					"content": "Em... em... em... trong lòng anh ấy chỉ có Phái Cổ Hoa thôi... Nếu em nói những lời này với anh ấy, anh ấy ghét em thì sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370407
					],
					"speakerTitle": "Bé Que'er"
				},
				{
					"id": 210370407,
					"content": "Haiz, em à...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiruo"
				}
			]
		},
