				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210370101,
					"content": "Liyue ơi... Liyue, không biết đến khi nào ta mới có thể quay trở về đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370102
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370102,
					"content": "Sao thế?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370103
					]
				},
				{
					"id": 210370103,
					"content": "Nhà Lữ Hành, là bạn à...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370104
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370104,
					"content": "Là thế này. Hành trình đến Fontaine của tôi cuối cùng cũng đã được quyết định, vài ngày nữa tôi sẽ lên đường với vị thương gia kia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370105
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370105,
					"content": "Anh ấy vẫn còn một số công việc cần giải quyết, tôi cũng tranh thủ thời gian này để thu dọn đồ đạc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370106,
						210370107
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370106,
					"content": "Anh không về thăm Tuyệt Vân Gián sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370108
					]
				},
				{
					"id": 210370108,
					"content": "Haha, tôi mà đi dạo lần nữa thì e là sẽ không nỡ rời khỏi Liyue mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370109
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370109,
					"content": "Tôi ở đây ngắm nhìn thêm một chút là được rồi. Sống ở đây lâu như vậy rồi, lần này đi xa, cũng không biết khi nào mới được trở về.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370110
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370110,
					"content": "À đúng rồi, cuối cùng thì... sư muội vẫn không đồng ý đi cùng tôi, nhưng tôi đã nhờ Zhiruo chăm sóc sư muội rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370111
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370111,
					"content": "Tôi cũng có để lại một ít tiền cho sư muội, sư muội thông minh hơn tôi, sư muội sẽ biết tự chăm sóc tốt cho mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370112
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370112,
					"content": "...Có lẽ một ngày nào đó, sư muội cũng sẽ hiểu cho tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370113
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370113,
					"content": "Đúng rồi Nhà Lữ Hành, tôi còn một chuyện muốn nhờ bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370114
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370114,
					"content": "Có thể giúp tôi lấy một ít đất về đây không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370115,
						210370116
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370115,
					"content": "Không thành vấn đề...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370117
					]
				},
				{
					"id": 210370117,
					"content": "Một người sắp rời quê hương như tôi, ít nhiều gì cũng nên mang theo chút kỷ niệm chứ, đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370118
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370118,
					"content": "Mang theo một nhúm đất của Liyue bên mình, ít nhất tôi sẽ có thể nói rằng tôi chưa hoàn toàn bị chia cắt khỏi vùng đất này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370119
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370119,
					"content": "Sao anh không tự đi lấy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370120
					]
				},
				{
					"id": 210370120,
					"content": "Hahaha... Không phải lúc nãy đã nói rồi sao? Nếu tôi đi và ngắm nhìn xung quanh thì sẽ lại tức cảnh sinh tình mất...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370121
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370121,
					"content": "Sợ rằng chút can đảm cuối cùng mà tôi góp nhặt được để rời quê hương cũng sẽ tan biến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370122
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370122,
					"content": "Nên chuyện lấy đất nhờ bạn nhé, Nhà Lữ Hành. Tôi đã đánh dấu vị trí trên bản đồ cho bạn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370123
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370123,
					"content": "Nơi này có gì đặc biệt sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370124
					]
				},
				{
					"id": 210370124,
					"content": "E hèm... Lúc... lúc trước tôi thường đưa sư muội đến đây luyện kiếm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370125
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370125,
					"content": "Tóm lại! Chuyện lấy đất nhờ bạn nhé, Nhà Lữ Hành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370116,
					"content": "Anh lấy đất để làm gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370117
					]
				},
				{
					"id": 210370107,
					"content": "Anh không đi dạo xung quanh lần nữa sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370108
					]
				}
			]
		},
