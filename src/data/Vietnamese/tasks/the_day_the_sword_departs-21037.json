			"dialogs": [
				{
					"id": 210370301,
					"content": "Cảm ơn, nhiêu đây đủ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370302,
						210370305
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370302,
					"content": "Anh... có vẻ như không được vui cho lắm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370303
					]
				},
				{
					"id": 210370303,
					"content": "Hửm? Không sao không sao, hahaha... để bạn chê cười rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370304
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370304,
					"content": "Có điều, đột nhiên phải rời xa nơi mình sinh sống đã lâu như Liyue, tôi có chút không đành lòng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370305,
					"content": "Khi nào anh xuất phát?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370306
					]
				},
				{
					"id": 210370306,
					"content": "Sau khi chuẩn bị xong vật tư thì chúng tôi sẽ xuất phát.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370307
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370307,
					"content": "À đúng rồi, nhà mạo hiểm hôm trước cùng tôi đến Vực Đá Sâu cũng sẽ đi cùng đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370308
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370308,
					"content": "Nhà mạo hiểm đó nghe nói tôi sắp đi Fontaine, cô ấy nói mình cũng có hứng thú, thế là quyết định đi cùng chúng tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370309
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370309,
					"content": "Vị thương nhân kia rất vui, vì có thêm một người bảo vệ anh ta... Nhưng thành thật mà nói, tôi thực sự không giỏi giao tiếp với những người quá nhiệt tình như vậy, haiz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370310
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370310,
					"content": "Thật không ngờ tôi cũng có ngày phải rời xa quê hương...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				}
			]
		},
		{
			"id": 2103704,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
