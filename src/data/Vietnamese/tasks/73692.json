				"points": []
			},
			"dialogs": [
				{
					"id": 736920101,
					"content": "À... Chào Nhà Lữ Hành, nhìn bạn chắc là cũng đến tham gia Hội Chợ Trí Tuệ đúng không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920102
					],
					"speakerTitle": "Paz"
				},
				{
					"id": 736920102,
					"content": "Nếu có hứng thú, có muốn chơi thử trò chơi của Học Viện Amurta thiết kế không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920103
					],
					"speakerTitle": "Paz"
				},
				{
					"id": 736920103,
					"content": "Trò chơi gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736920104
					]
				},
				{
					"id": 736920104,
					"content": "Học viện chúng tôi đã đem đến Hội Chợ Trí Tuệ một trò chơi nhỏ mang tên Mô Phỏng Sinh Vật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920105
					],
					"speakerTitle": "Paz"
				},
				{
					"id": 736920105,
					"content": "Trong trò chơi này, tôi sẽ giới thiệu cho bạn một số hành vi theo quy luật của động vật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920106
					],
					"speakerTitle": "Paz"
				},
				{
					"id": 736920106,
					"content": "Đương nhiên, những \"quy luật\" này đã được chúng tôi đơn giản hóa và khái quát hóa nên rất dễ hiểu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920107
					],
					"speakerTitle": "Paz"
				},
				{
					"id": 736920107,
					"content": "Việc bạn cần làm là dùng những mô hình chúng tôi đã chuẩn bị để mô phỏng hành vi của động vật tương ứng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920108,
						736920109
					],
					"speakerTitle": "Paz"
				},
				{
					"id": 736920108,
					"content": "Nghe có vẻ khá đơn giản nhỉ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736920110
					]
				},
				{
					"id": 736920110,
					"content": "Đúng vậy. \"Động vật có tập tính theo quy luật\" là một câu nói rất dễ hiểu và dễ tiếp nhận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920111
					],
					"speakerTitle": "Paz"
				},
				{
					"id": 736920111,
					"content": "Nhưng đằng sau câu nói tưởng chừng như đơn giản này lại có vô số câu đố để khám phá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920112
					],
					"speakerTitle": "Paz"
				},
				{
					"id": 736920112,
					"content": "Nhưng mà... trong thời gian này, chúng ta hãy tạm gác lại việc quan sát học thuật, và trải nghiệm thói quen của các loài động vật một cách thoải mái nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920113,
						736920115
					],
					"speakerTitle": "Paz"
				},
				{
					"id": 736920113,
					"content": "Muốn chơi thử.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736920114
					]
				},
				{
					"id": 736920114,
					"content": "Được, mời sang bên này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paz"
				},
				{
					"id": 736920115,
					"content": "Còn bận việc khác.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736920116
					]
				},
				{
					"id": 736920116,
					"content": "Không sao, thời gian này, gian hàng của tôi vẫn luôn mở, bạn có thể đến chơi thử bất cứ lúc nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paz"
				},
				{
					"id": 736920109,
					"content": "Cảm thấy không khó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736920110
					]
				}
			]
		}
	]
