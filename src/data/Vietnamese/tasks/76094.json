				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760940201,
					"content": "#Tuyệt quá, tôi biết ngay là {F#cô}{M#cậu} sẽ có cách mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940202
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940202,
					"content": "Tuy Cừu Lười không thể tồn tại trong môi trường không có Kuuvahki, nhưng ít nhất trong thời gian ở Nod-Krai cũng có thể mang lại chút an ủi cho vị thương nhân đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940203
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940203,
					"content": "Vậy tôi xin phép đi trước nhé. Đây là một chút lòng thành của tôi, xin hãy nhận lấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vacarao"
				}
			]
		},
