			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vacarao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760940101,
					"content": "Rốt cuộc phải làm sao để lôi được nó ra đây nhỉ, đúng là đau đầu thật...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940102
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940102,
					"content": "Có thể giúp được gì không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760940103
					]
				},
				{
					"id": 760940103,
					"content": "#Hả? À à, là nhà mạo hiểm nhiệt tình đây mà. Gặp được {F#cô}{M#cậu} thế này thật tốt quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940104
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940104,
					"content": "Chuyện là thế này. Con đường dẫn về phía Bắc xuyên qua hang đá này cách đây không lâu mới bị sập do sự bất thường của Kuuvahki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940105
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940105,
					"content": "May là không có thương vong về người, nhưng có một thương nhân ngoại quốc nói rằng \"bạn đồng hành\" của anh ấy bị kẹt lại bên trong...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940106
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940106,
					"content": "#Đó là một con Cừu Lười mà anh ấy quen biết ở gần đây. Nếu {F#cô}{M#cậu} ở đây đủ lâu thì sẽ biết, Cừu Lười theo {F#cô}{M#cậu} chủ yếu chỉ để mang hạt giống đi gieo rắc ở nơi xa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940107
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940107,
					"content": "Nhưng giải thích thế nào thì vị thương nhân đó cũng không nghe, cứ nhất quyết muốn chúng tôi phải nghĩ cách cứu nó ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940108
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940108,
					"content": "Muốn nối lại con đường dẫn vào sâu trong hang, chỉ có thể dùng những bông Hoa Long Lanh này thôi. Tiếc là tôi không biết phép thuật của Dòng Dõi Sương Nguyệt, cũng chẳng có thiết bị Kuuvahki mạnh mẽ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940109
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940109,
					"content": "#May mà gặp được {F#cô}{M#cậu}. Đã là nhà mạo hiểm thì chắc sẽ có cách đưa được con Cừu Lười bên trong ra ngoài phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940110
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940110,
					"content": "#Tôi sẽ thay mặt vị thương nhân đó cảm ơn {F#cô}{M#cậu}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vacarao"
				}
			]
		},
