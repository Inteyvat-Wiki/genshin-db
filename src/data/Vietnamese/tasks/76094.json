			"dialogs": [
				{
					"id": 760940501,
					"content": "#Ôi, đây là \"bạn đồng hành\" của một thương nhân nước ngoài lúc trước bị mắc kẹt trong hang động, không ngờ được {F#cô}{M#cậu} cứu ra rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940502
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940502,
					"content": "#Dù biết là Cừu Lười đi theo {F#cô}{M#cậu} chủ yếu chỉ để mang hạt giống đi gieo rắc ở nơi xa, nhưng giải thích thế nào thì thương nhân đó cũng không chịu nghe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940503
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940503,
					"content": "#Tôi còn đang đau đầu về chuyện này, may mà gặp được một nhà mạo hiểm nhiệt tình như {F#cô}{M#cậu} đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
