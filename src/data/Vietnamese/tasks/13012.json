			"dialogs": [
				{
					"id": 130120201,
					"content": "Nhắc mới nhớ, gần đây đã xảy ra một chuyện kỳ lạ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130120202
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130120202,
					"content": "Có một lái buôn tới tìm tôi để đòi tiền túi du lịch sa mạc gì đó, vừa mở miệng ra là đòi tận 1.250.000 Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130120203
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130120203,
					"content": "Tôi chẳng có ấn tượng gì về khoản nợ này cả, hơn nữa con số này cao hơn giá thị trường nhiều, cho nên tôi đã nhốt người đó lại với lý do \"kiếm cớ gây sự\" rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130120204
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130120204,
					"content": "Các bạn có manh mối gì về chuyện này không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130120205
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130120205,
					"content": "Không, không có. Paimon không biết.",
					"roleType": "TALK_ROLE_NPC",
