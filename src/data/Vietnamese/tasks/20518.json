			},
			"dialogs": [
				{
					"id": 205180501,
					"content": "Bạn vẫn đang chuẩn ư? Ừm chuẩn bị cẩn thận trước khi xuất phát.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180502,
						205180506
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180502,
					"content": "Vị tiên sinh ấy là ai?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180503
					]
				},
				{
					"id": 205180503,
					"content": "Chớ hỏi nhiều, tôi sẽ không nói cho bạn đâu. Đây đều là quy tắc cơ bản trong nghề của chúng tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180504
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180504,
					"content": "Cho dù là tiết lộ... Thì những tin tức đó cũng là do \"cần phải tiết lộ\" mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180505
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180505,
					"content": "À đúng rồi, bạn có thể nghĩ rằng trong những lời mà tôi nói đâu là những tình tiết \"cần phải tiết lộ\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180506,
					"content": "Mục đích của các bạn là gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180507
					]
				},
				{
					"id": 205180507,
					"content": "Mục đích... Của tiên sinh ấy thì tôi không biết. Nhưng tất cả chỉ là để bảo vệ thành Mondstadt mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180508
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180508,
					"content": "Ồ... có lẽ là chuyện như vậy ngài ấy sẽ không hành động theo \"sở thích\" đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180509
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180509,
					"content": "Ồ ồ, không được, chuyện này không được suy đoán...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				}
			]
		},
