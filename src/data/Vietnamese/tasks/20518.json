	"talks": [
		{
			"id": 2051801,
			"completionStepIds": [
				2051801
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2051801",
							"2"
						],
						"stepId": 2051801,
