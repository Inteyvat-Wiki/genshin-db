			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vile"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205180201,
					"content": "Bạn quay lại rồi sao, hiệu quả làm việc nhanh thật đó, tôi cũng đã hiểu được lý do tiên sinh ấy thích bạn như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180202,
						205180204
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180202,
					"content": "Thù lao đâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180203
					]
				},
				{
					"id": 205180203,
					"content": "Những đồng tiền mát lạnh... Đây là thù lao của bạn. Bạn cũng hiểu cho tôi một chút, tôi chỉ là người chạy việc mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180204,
					"content": "Thực sự cảm ơn sự hào phóng của bạn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180205
					]
				},
				{
					"id": 205180205,
					"content": "Chớ khách khí, thù lao này cho bạn, còn nữa... Hợp tác vui vẻ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				}
			]
		},
		{
			"id": 2051803,
			"completionStepIds": [
				2051805
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2051805",
							"2"
						],
						"stepId": 2051805,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huffman"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205180301,
					"content": "Đám Đạo Bảo Đoàn này... tiếp tục trốn đi, khôn hồn đừng để ta biết được trốn chỗ nào đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180302
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 205180302,
					"content": "Tôi biết Đạo Bảo Đoàn trốn ở đâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180303
					]
				},
				{
					"id": 205180303,
					"content": "Bạn? Sao lại... Ấy, tấm bản đồ này ghi chi tiết quá... Bạn lấy ở đâu vậy? Vile? Là cô ta sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180304
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 205180304,
					"content": "...Cách xa vị trí mà chúng tôi đã xác định trước đây, rốt cuộc mục tiêu của đám Đạo Bảo Đoàn này là gì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180305
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 205180305,
					"content": "Xin lỗi, để tôi nhớ lại... Được rồi, tôi biết rồi, chúng tôi sẽ phái người đi xác thực. Nếu đúng là vậy thì chúng tôi sẽ đi tiêu diệt chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180306
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 205180306,
					"content": "Một lần nữa cảm ơn bạn! Cảm ơn những gì bạn đã cống hiến cho Mondstadt! Đám Đạo Bảo Đoàn đó lần này đừng hòng thoát!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huffman"
				}
			]
		},
		{
			"id": 2051804,
			"completionStepIds": [
				2051806
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2051806",
							"2"
						],
						"stepId": 2051806,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vile"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205180401,
					"content": "Bạn về rồi sao, nhanh thật đấy, tôi biết tại sao vị tiên sinh đó lại thích giao việc cho bạn rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180402
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180402,
					"content": "Chuyện này đã giao cho Đội Kỵ Sĩ Tây Phong rồi",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180403
					]
				},
				{
					"id": 205180403,
					"content": "Giao cho Kỵ Sĩ Tây Phong... Này, ban nãy đã nói rằng nếu Đội Kỵ Sĩ Tây Phong biết chuyện thì sẽ rất phiền phức rồi mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180404
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180404,
					"content": "Bạn thật lười đấy. Phù... Cũng may vị tiên sinh đó bảo rằng bạn có thể sẽ làm như vậy để tôi sớm chuẩn bị phương án dự phòng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180405
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180405,
					"content": "Những chuyện tiếp theo không cần bạn phải lo nữa, tôi đi đây. Haiz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180406
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180406,
					"content": "Nhưng theo vị tiên sinh đó nói, hành vi này của bạn không chừng sẽ dẫn câu chuyện rẽ theo hướng thú vị hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180407
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180407,
					"content": "Dẫu sao, nếu như để tôi đi báo cáo động tĩnh của Đạo Bảo Đoàn thì quá lộ liễu, mặt khác thân phận của tiên sinh cũng không tiện để lộ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180408
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180408,
					"content": "...Cái này cho bạn, nhận đấy đi. Đây là phần thưởng \"làm thay đổi tình hình\" như lời tiên sinh bảo đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				}
			]
		},
		{
			"id": 2051805,
