			"dialogs": [
				{
					"id": 761190101,
					"content": "...Ở đây sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190102
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761190102,
					"content": "~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190103
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 761190103,
					"content": "...Hah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190104
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761190104,
					"content": "Có vẻ họ chơi rất vui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761190105,
					"content": "Xin chào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190106
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761190106,
					"content": "!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190107
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 761190107,
					"content": "Xin chào, Luonnotar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190108
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761190108,
					"content": "Đang chơi trò chơi mới à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761190109
					]
				},
				{
					"id": 761190109,
					"content": "Ừm, tôi thấy có người ở Soái Hạm chơi với bạn bè bằng chiếc cốc như thế này, nên đã học theo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190110
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761190110,
					"content": "Họ đặt viên đá quý vào trong cốc rồi xoay thật nhanh chiếc cốc trên mặt bàn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190111
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761190111,
					"content": "Sau khi dừng lại, thì để đối phương đoán xem viên đá quý đang ở trong chiếc cốc nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190112
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761190112,
					"content": "Các Kuuhenki thích cảm giác chui ra chui vào trong vải, nên tôi đã lấy chiếc mũ của tiểu thư ma nữ làm mẫu và cải tiến một chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190113
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761190113,
					"content": "Rất dễ thương.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761190114
					]
				},
				{
					"id": 761190114,
					"content": "~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190115
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 761190115,
					"content": "Nhưng mà cô cũng đã đến tận Soái Hạm rồi, có bị ai nhận ra không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761190116,
					"content": "Cũng có người hỏi thăm, tôi liền bảo \"Tôi đang đóng vai Nguyệt Thần đấy, giống lắm phải không?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190117
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761190117,
					"content": "Chiêu trò trong Đêm Cầu Nguyệt đó, cô đã học được rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761190118,
					"content": "Liệu họ có tin không nhỉ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761190119
					]
				},
				{
					"id": 761190119,
					"content": "Ừm... Hình như là nửa tin nửa ngờ. Nhưng cũng không nói chuyện thêm với tôi nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190120
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761190120,
					"content": "Có phải vì tôi diễn chưa được tự nhiên không? Lần sau để tôi đến chỗ khác thử thêm vài lần nữa vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190121
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761190121,
					"content": "Sao nghe có vẻ như bị dạy hư rồi thế này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761190122,
					"content": "!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190123
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 761190123,
					"content": "#Luonnotar muốn mời {F#cô}{M#cậu} đoán xem nó đang trốn ở đâu, {F#cô}{M#cậu} có muốn chơi một ván không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190124
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761190124,
					"content": "Được thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761190125
					]
				},
				{
					"id": 761190125,
					"content": "Vui lòng tuân thủ quy định của Soái Hạm, đặt cọc 100.000 Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190126
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761190126,
					"content": "Phần này không cần học đâu nhỉ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
