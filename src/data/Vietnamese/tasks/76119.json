						761190202
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 761190202,
					"content": "#Có phải là quá dễ dàng với {F#cô}{M#cậu} không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190203
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761190203,
					"content": "Lần sau mà chơi nữa, tôi sẽ cố gắng xoay mũ nhanh hơn một chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190204
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761190204,
					"content": "Tôi có một thắc mắc! Vậy khi nãy Columbina đã chơi với chúng như thế nào vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761190205,
					"content": "Nếu không dùng Kuuvahki thì chẳng thấy gì hết, nhưng dùng thì lại thấy quá rõ ràng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761190206,
					"content": "Tôi có thể mở mắt mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190207
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761190207,
					"content": "Đúng nhỉ, tôi không nghĩ ra thật...",
