			},
			"dialogs": [
				{
					"id": 200330101,
					"content": "Nhà Lữ Hành! Nhìn nè nhìn nè, bộ đồng phục này của tôi thế nào? Có đẹp không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330102
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330102,
					"content": "Bộ đồng phục này...lẽ nào?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200330103
					]
				},
				{
					"id": 200330103,
					"content": "Đúng vậy! Tôi đã vượt qua được kỳ thi của Hiệp Hội Nhà Mạo Hiểm, chính thức trở thành một nhà mạo hiểm rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330104,
						200330105
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330104,
					"content": "Ngầu quá!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200330106
					]
				},
				{
					"id": 200330106,
					"content": "Hì hì, cám ơn bạn. Tôi kêu anh trai thử, nhưng có nói thế nào anh ấy cũng không chịu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330107
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330107,
					"content": "Anh không có hứng thú với mạo hiểm...Hơn nữa, nếu cả hai chúng ta đều làm nhà mạo hiểm thì ai chăm sóc cho bố mẹ đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330108
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200330108,
					"content": "Vậy thì chúng ta đưa bố mẹ theo, cùng đi du lịch đến khắp nơi trên thế giới!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330109
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330109,
					"content": "Em đó...được rồi, đã là nhà mạo hiểm rồi thì làm cho tốt, chuyện trong nhà cứ để anh lo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330110
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200330110,
					"content": "Nhưng mà! Nhất định phải chú ý an toàn, không được để bị thương, cũng không được quá sức...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330111
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200330111,
					"content": "Biết rồi biết rồi! Em phải đi thực hiện ủy thác đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330112
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330112,
					"content": "Nhà Lữ Hành, bạn có muốn đi cùng tôi không? Tôi còn muốn thỉnh giáo bạn rất nhiều vấn đề liên quan đến nhà mạo hiểm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330113,
						200330114
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330113,
					"content": "Không thành vấn đề.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200330115
					]
				},
				{
					"id": 200330115,
					"content": "Được, để tôi xem...ủy thác lần này là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330116
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330116,
					"content": "Hộ tống Khí Cầu Vận Chuyển!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330114,
					"content": "Xuất phát nào!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200330115
					]
				},
				{
					"id": 200330105,
					"content": "Chúc mừng cô!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200330106
					]
				}
			]
		},
