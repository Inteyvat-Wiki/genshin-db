			"dialogs": [
				{
					"id": 1903201201,
					"content": "Haiz, mệt quá, cuối cùng có thể nghỉ ngơi rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201202
					],
					"speakerTitle": "Zhouliang"
				},
				{
					"id": 1903201202,
					"content": "Có phải hơi quá tay không nhỉ, hình như có vài người bị dọa cho sợ chết kiếp rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201203
					],
					"speakerTitle": "Zhouliang"
				},
				{
					"id": 1903201203,
					"content": "Cho hỏi bạn là?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903201204
					]
				},
				{
					"id": 1903201204,
					"content": "A a, đừng đến đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201205
					],
					"speakerTitle": "Zhouliang"
				},
				{
					"id": 1903201205,
					"content": "Haiz thôi kệ vậy, bạn nghe thấy rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201206
					],
					"speakerTitle": "Zhouliang"
				},
				{
					"id": 1903201206,
					"content": "Tôi là nhân viên hóa trang ma quỷ ở đây, bây giờ đang lúc nghỉ ngơi nên tôi đã cởi bộ trang phục vừa nóng vừa bí đó ra rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201207,
						1903201208
					],
					"speakerTitle": "Zhouliang"
				},
				{
					"id": 1903201207,
					"content": "Quả nhiên nơi này không hề có ma quỷ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903201209
					]
				},
				{
					"id": 1903201209,
					"content": "Đúng rồi, làm gì có ma quỷ thật chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201210
					],
					"speakerTitle": "Zhouliang"
				},
				{
					"id": 1903201210,
					"content": "Cho dù là chúng tôi hay người tham gia Đại Hội Thi Gan cũng không mong nhìn thấy ma quỷ thật đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201211
					],
					"speakerTitle": "Zhouliang"
				},
				{
					"id": 1903201211,
					"content": "Bọn họ chỉ muốn chút không khí thôi, điều quan trọng nhất là cảm giác kích thích.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201212
					],
					"speakerTitle": "Zhouliang"
				},
				{
					"id": 1903201212,
					"content": "Khi đang nơm nớp lo sợ thì gặp phải một số chuyện bất ngờ, tiện thể nói những lời mà bình thường không dám nói, đây chính là tác dụng của Đại Hội Thi Gan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201213,
						1903201214
					],
					"speakerTitle": "Zhouliang"
				},
				{
					"id": 1903201213,
					"content": "Tôi cũng nghĩ vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903201215
					]
				},
				{
					"id": 1903201215,
					"content": "Được rồi, tôi phải tiếp tục làm việc đây, bạn và bạn của bạn chơi vui nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhouliang"
				},
				{
					"id": 1903201214,
					"content": "(Chongyun chắc sẽ rất thất vọng.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903201215
					]
				},
				{
					"id": 1903201208,
					"content": "Chỉ là hù dọa thôi phải không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903201209
					]
				}
			]
		}
	]
