				]
			},
			"dialogs": [
				{
					"id": 50220701,
					"content": "(Khoảnh khắc xuyên qua bức tường ánh sáng đó, cơ thể như bị đóng băng.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220702
					]
				},
				{
					"id": 50220702,
					"content": "(Sự bảo vệ của Dạ Thần dường như không thể chạm đến nơi đây. Hơi lạnh và bóng tối bao trùm mọi cảm quan, bên tai ngập tràn tiếng than thở mệt mỏi và đau khổ.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220703
					]
				},
				{
					"id": 50220703,
					"content": "(Họ không biết đã đi bao lâu, cũng không biết phải đi bao lâu nữa...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220704
					]
				},
				{
					"id": 50220704,
					"content": "(Ơ, người đó là...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220705
					]
				},
				{
					"id": 50220705,
					"content": "Dù quê hương đã trở thành quá khứ, nhưng ngọn lửa chiến tranh vẫn đang rực cháy. Chúng ta đã đổ những giọt máu cuối cùng từ lâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50220706
					],
					"speakerTitle": "\"The Captain\""
				},
				{
					"id": 50220706,
					"content": "Hãy ráng chịu đựng thêm chút nữa nhé, các chiến sĩ của ta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50220707
					],
					"speakerTitle": "\"The Captain\""
				},
				{
					"id": 50220707,
					"content": "(Tại sao Capitano lại ở đây? Anh ta đang nói gì vậy...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220708
					]
				},
				{
					"id": 50220708,
					"content": "Rồi sẽ có một ngày, ta sẽ đưa các vị tới nơi đã hẹn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"The Captain\""
