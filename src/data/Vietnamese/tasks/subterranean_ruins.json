			"dialogs": [
				{
					"id": 50220401,
					"content": "(Đây là đâu? Lẽ nào... là Vương Quốc Dạ Thần sao?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220402
					]
				},
				{
					"id": 50220402,
					"content": "(Tại sao mình lại ở đây? Vừa rồi rõ ràng mình đang... Ối...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220403
					]
				},
				{
					"id": 50220403,
					"content": "(Chóng mặt quá, không thể suy nghĩ bình thường được. Thử đi xung quanh trước đã.)",
					"roleType": "TALK_ROLE_PLAYER",
