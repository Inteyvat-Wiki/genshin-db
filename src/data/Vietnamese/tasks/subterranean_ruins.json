			"dialogs": [
				{
					"id": 50220801,
					"content": "Chào buổi sáng nhé, tối qua gặp ác mộng sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50220802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 50220802,
					"content": "#Tôi nghe thấy tiếng {NICKNAME} trở mình qua lại trên giường, nên nghĩ chắc là ngủ không được ngon rồi. Có phải đang lo lắng vì trận quyết chiến sắp diễn ra không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50220803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 50220803,
					"content": "(Giấc mơ tối qua... Thoáng chốc trở nên mơ hồ quá.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220804
					]
				},
				{
					"id": 50220804,
					"content": "(Thứ trong mơ giống như được ngăn bởi một lớp lụa mỏng, hình ảnh mơ hồ. Khi cố gắng nhớ thì đầu lại đau âm ỉ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220805
					]
				},
				{
					"id": 50220805,
					"content": "Hihi, hôm nay là ngày chúng ta hẹn với Mavuika đấy, phải phấn chấn lên nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
