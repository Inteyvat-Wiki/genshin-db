			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Navia"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401890429,
					"content": "Chuẩn bị xong rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890401
					]
				},
				{
					"id": 401890401,
					"content": "Nào, cộng sự tuyệt vời của tôi và Paimon, chúng ta bắt đầu vào trong chủ đề chính của Phim Trường Vui Vẻ Chevalmarin nhé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890402
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890402,
					"content": "Như đã nói trước đó, Phim Trường Vui Vẻ Chevalmarin lần này do những người hâm mộ khởi xướng, và Spina di Rosula chịu trách nhiệm điều phối, xây dựng và vận hành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890403
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890403,
					"content": "Tuy nhiên, những người hâm mộ không phải là chuyên gia toàn năng, nên thường chỉ đảm nhận việc thiết kế các gian hàng sự kiện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890404
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890404,
					"content": "Nhiệm vụ của chúng ta là lập ra Kế Hoạch Kinh Doanh Dài Hạn và Chiến Lược Chơi Tiêu Chuẩn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890405
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890405,
					"content": "Kế hoạch, kinh doanh, dài hạn... Nghe cao siêu quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890406,
					"content": "Chúng ta toàn đi phiêu lưu thôi, chưa từng bày sạp bán hàng bao giờ, làm sao hiểu được mấy cái này chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890407,
						401890408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890407,
					"content": "Đâu phải người làm chủ nào cũng học qua trường lớp kinh doanh đâu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890409
					]
				},
				{
					"id": 401890409,
					"content": "Đúng vậy, chính là khí thế này! Cộng sự của tôi đã từng trải qua đủ mọi sóng gió, và đã ảnh hưởng đến không ít sự kiện thương mại lớn ở Teyvat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890410
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890410,
					"content": "Dù sao thì, trước tiên chúng ta hãy xem qua tình hình cơ bản của Phim Trường Vui Vẻ nhé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890411
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890411,
					"content": "#Có vẻ như tôi đã hiểu rồi. {NICKNAME} thấy thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890412,
						401890413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890412,
					"content": "Haha, đây là sở trường của tôi mà!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890414
					]
				},
				{
					"id": 401890414,
					"content": "Ừm! Cùng cố gắng nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890415,
					"content": "Vừa nãy Navia còn nhắc đến \"Chiến Lược Chơi Tiêu Chuẩn\" nhỉ... Chẳng lẽ còn có cách chơi không tiêu chuẩn sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890416,
					"content": "Tất nhiên rồi! Vì mỗi người đều sẽ có cách hiểu khác nhau về phim ảnh và các trò chơi giải trí mà. Trong Phim Trường Vui Vẻ cũng không thiếu những hoạt động mạo hiểm và đầy kích thích.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890417
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890417,
					"content": "Biết đâu có du khách lạc đường, loanh quanh một hồi lại ra khỏi khu vực tham quan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890418
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890418,
					"content": "Có những du khách hiểu nhầm công dụng của đạo cụ, rồi cầm lấy những vật nguy hiểm trong tay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890419
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890419,
					"content": "Để tránh cho du khách bị bối rối khi chơi, chúng ta cần phải làm ra \"Cách Chơi Tiêu Chuẩn\", hoặc có thể gọi là \"Hướng Dẫn Chi Tiết\" cho mỗi sự kiện!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890420,
						401890421
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890420,
					"content": "Tôi hiểu rồi, để tôi chơi thử xem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890422
					]
				},
				{
					"id": 401890422,
					"content": "Tôi bắt đầu tưởng tượng ra đủ thứ tình huống bất ngờ rồi đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890423,
					"content": "Nếu gặp màn chơi khó, thì chỉ có thực lực của chúng ta mới có thể vượt qua một cách dễ dàng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890424,
					"content": "Tất nhiên rồi, tôi không muốn cộng sự tốt của mình gặp nguy hiểm đâu. Trước khi hai vị đến, tôi đã kiểm tra kỹ lưỡng tất cả các hạng mục hiện có, tuyệt đối không có bất kỳ thiếu sót nào về yếu tố an toàn cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890425
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890425,
					"content": "#Tôi cũng mong {F#cô}{M#cậu} sẽ là người đầu tiên được trải nghiệm các trò chơi này, rồi chia sẻ cảm nhận và đóng góp ý kiến cho tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890426
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890426,
					"content": "Hihi, không hổ danh là Navia, lúc nào cũng khiến chúng ta thấy vui vẻ và yên tâm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890427,
					"content": "Tôi rất mong chờ đấy! Ý kiến của hai vị rất quan trọng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890428
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890428,
					"content": "Tóm lại, chúng ta bắt đầu vận hành \"Chuyến Thám Hiểm Rực Rỡ\" và lập ra phần chiến lược đầu tiên thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890421,
					"content": "Hiểu rồi, để tôi lấy bản thân ra làm tiêu chuẩn nào.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890422
					]
				},
				{
					"id": 401890413,
					"content": "Chậc... Đành phải vừa làm vừa học vậy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890414
					]
				},
				{
					"id": 401890408,
					"content": "Chúng ta cũng từng làm qua nhiều phi vụ kiếm bộn tiền mà!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890409
					]
				}
			]
		},
