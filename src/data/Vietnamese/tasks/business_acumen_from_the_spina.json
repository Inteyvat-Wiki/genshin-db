			"dialogs": [
				{
					"id": 401891401,
					"content": "Món Sườn Que Nướng này sử dụng nước xốt đã được cải tiến tỷ lệ, có hương vị đậm đà hơn so với nguyên bản, nhưng không ngấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891402
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891402,
					"content": "Chiết xuất Bạc Hà trong gia vị còn có thể mang lại dư vị sảng khoái cho người ăn, thích hợp ăn thỏa thích sau khi vui chơi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891403
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891403,
					"content": "Nhưng tôi thấy, những người thợ thủ công sẽ cần món này hơn là khách hàng đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891404
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891404,
					"content": "Thợ thủ công sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401891405,
					"content": "Phim trường này còn chưa được xây dựng đến trạng thái lý tưởng nhất nhỉ? Những người thợ thủ công ăn món Sườn Que Nướng này chắc sẽ nhanh chóng lấy lại sức và loại bỏ mệt mỏi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891406
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891406,
					"content": "Là người phụ trách, các vị vốn dĩ cũng phải cung cấp thức ăn cho họ. Hay là mời họ đến đây dùng bữa nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891407
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891407,
					"content": "Nói không chừng còn có thể nâng cao cả về mặt tinh thần lẫn hiệu suất thi công đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891408
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891408,
					"content": "Hửm? Tôi nhớ là, trước đây cô cũng từng cung cấp món Khoai Tây Chiên Cá cho những người khuân vác ở Fleuve Cendre nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891409
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891409,
					"content": "Kết quả là mấy ngày đó, hiệu suất của họ siêu cao, chỉ mất năm giờ là đã hoàn thành xong nhiệm vụ của tám giờ, tan làm sớm thì ngày hôm sau cũng có tinh thần hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891410
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891410,
					"content": "Không nên chậm trễ nữa, nhân lúc Sườn Que Nướng còn nóng, mau đi mời họ ăn đi. Tôi sẽ chuẩn bị thêm một ít món phụ và tráng miệng sau bữa ăn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891411
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891411,
					"content": "Có lý lắm! Không hổ danh là Escoffier!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401891412,
					"content": "Xem ra món ăn chủ đề sẽ phát huy được tác dụng đấy. Vậy sau một thời gian nữa chúng tôi sẽ đến tìm cô!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401891413,
					"content": "Cùng Navia mời những người thợ đến thưởng thức món Sườn Que Nướng đặc biệt...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
