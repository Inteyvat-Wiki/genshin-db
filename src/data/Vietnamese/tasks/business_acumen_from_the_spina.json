			},
			"dialogs": [
				{
					"id": 401891101,
					"content": "Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891102
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891102,
					"content": "Nội lực của nhà hàng rất tốt, bầu không khí ăn uống bên bờ biển thật đặc biệt. Khung cảnh phản chiếu có thể khiến thực khách hào hứng hơn, thưởng thức món ăn cũng sẽ tinh tế hơn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891103
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891103,
					"content": "Nguyên liệu đã có đủ, dụng cụ nấu ăn cũng đã sẵn sàng, có thể bắt tay vào việc ngay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891104
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891104,
					"content": "Chào Escoffier!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401891105,
					"content": "Ồ? Các vị chủ thuê của tôi đến rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891106
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891106,
					"content": "#Sếp của Spina di Rosula, cùng với {NICKNAME} nổi tiếng và Paimon... Đội hình này điều hành một công viên giải trí thì có hơi xa xỉ nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891107
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891107,
					"content": "Bếp trưởng tiền nhiệm của Khách Sạn Debord mới là người xứng với từ \"xa xỉ\" nhất đúng không? Dù cô có đi đến đâu thì cũng sẽ mang theo hương thơm của những món ăn tinh tế đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891108
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891108,
					"content": "Khụ... Chúng ta nói chuyện chính thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891109
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891109,
					"content": "#Có vẻ như Navia muốn để {NICKNAME} quyết định món ăn chủ đề cho từng giai đoạn nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891110
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891110,
					"content": "Món ăn chủ đề?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401891111
					]
				},
				{
					"id": 401891111,
					"content": "Đây chính là chiến lược kinh doanh mà tôi đã đề cập trước đó, dùng những món ăn của đầu bếp hàng đầu để thu hút thêm khách hàng cho Phim Trường Vui Vẻ Chevalmarin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891112
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891112,
					"content": "Không chỉ thu hút khách hàng đâu, kiệt tác của Escoffier chắc chắn còn mang lại nhiều điều bất ngờ thú vị hơn đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891113
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891113,
					"content": "Thử nghĩ xem, chỉ cần một tấm vé vào cửa thôi, không những được vui chơi thỏa thích, lại còn được thưởng thức món ăn trong truyền thuyết nữa, Paimon có thấy hấp dẫn không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891114
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891114,
					"content": "Chà! Vậy thì tôi sẽ đến đây mỗi ngày luôn đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891115,
						401891116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401891115,
					"content": "Có thẻ năm không? Cho tôi xin một tấm với?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401891117
					]
				},
				{
					"id": 401891117,
					"content": "Tuy nhiên, nếu công khai thực đơn thì hiệu quả thu hút khách sẽ giảm đi một nửa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891118
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891118,
					"content": "Theo khảo sát của một chuyên gia tư vấn thương hiệu ẩm thực, nhiều nhà hàng đã áp dụng \"Món Đặc Biệt Theo Ý Đầu Bếp\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891119
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891119,
					"content": "Vì vậy, cứ vài chu kỳ kinh doanh, các vị hãy cho tôi cảm hứng để quyết định xem nên làm món ăn chủ đề gì nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891120
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891120,
					"content": "Đưa tay cho tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891121,
						401891122
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891121,
					"content": "Tay ư...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401891123
					]
				},
				{
					"id": 401891123,
					"content": "Hmm, cảm giác ấm áp và đầy sức sống.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891124
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891124,
					"content": "Sau thời gian dài cầm chuôi kiếm, da đã tạo ra một lớp chai cứng, nhưng lại rất nhẵn mịn. Khi cầm kiếm, sẽ giống như chạm vào dây của đàn violin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891125
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891125,
					"content": "Kiếm à... Tôi hiểu rồi, chủ đề lần này là \"sức mạnh\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891126
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891126,
					"content": "#Nào, xem thử \"sức mạnh\" mà {F#cô}{M#cậu} mang đến sẽ ngưng tụ thành món ăn như thế nào nhé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891122,
					"content": "Thì ra là truyền cảm hứng vật lý...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401891123
					]
				},
				{
					"id": 401891116,
					"content": "Tôi sẽ nghĩ cách để ở lại đây luôn!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401891117
					]
				}
			]
		},
