			"dialogs": [
				{
					"id": 401890301,
					"content": "Tôi còn việc khác cần giải quyết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890302
					]
				},
				{
					"id": 401890302,
					"content": "#Được, tôi sẽ chờ {F#cô}{M#cậu} bất cứ lúc nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
