				},
				{
					"id": 401890804,
					"content": "Hahaha, hai vị cũng không tệ đấy, có khí chất của sếp hơn cả tôi nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890805
