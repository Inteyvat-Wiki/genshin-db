						],
						"pointId": 340200187
					}
				]
			},
			"dialogs": [
				{
					"id": 401890601,
					"content": "Cả hai trông có hứng thú hơn lúc trước nhỉ... Xem ra lần chơi thử này không làm hai vị thấy thất vọng đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890602,
						401890603
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890602,
					"content": "Những thử thách rất quen thuộc!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890604
					]
				},
				{
					"id": 401890604,
					"content": "Tuy tôi không xem nhiều phim ảnh, nhưng sau khi thử chơi lần này, tôi cảm thấy... có hứng thú đó! Tôi còn muốn tìm hiểu thêm về những tác phẩm liên quan nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890605,
					"content": "Paimon giỏi thật, đã hiểu được mục tiêu chân thành nhất của người hâm mộ rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890606
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890606,
					"content": "Nếu khiến khách tham quan thích thú với những bộ phim truyền cảm hứng cho trò chơi, thì những người đam mê đó sẽ không còn gì có thể vui hơn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890607
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890607,
					"content": "Trong phạm vi chi phí cho phép, họ thậm chí sẽ sẵn sàng bỏ tiền túi ra để trải nghiệm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890608
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890608,
					"content": "Tự... tự bỏ tiền túi ra sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890609,
					"content": "Đúng vậy. Spina di Rosula lo phần chi phí cơ bản cho gian hàng và tiền thuê đất, rất nhiều người hâm mộ đã tự bỏ tiền túi ra để làm các vật phẩm quảng bá và hàng hóa liên quan đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890610
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890610,
					"content": "Đối với họ thì chi phí gian hàng không phải là khoản lớn, một số người đã bắt đầu tự thiết kế các sản phẩm từ hình ảnh nhân vật rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890611
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890611,
					"content": "Ví dụ như người đại diện lần này là Phu Nhân Chevalmarin, cô ấy đã giành vị trí á quân trong cuộc bình chọn nhân vật được yêu thích trong bộ phim hoạt hình trước đó, với lời nhận xét là \"tròn trịa và cực kỳ đáng yêu\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890612
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890612,
					"content": "Nhiều người muốn thiết kế gối ôm theo hình tượng của cô ấy, sử dụng chất liệu vải cao cấp nhất và thuê những người thợ thủ công khéo léo nhất để sản xuất hàng loạt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890613
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890613,
					"content": "Tại hội chợ triển lãm tiếp theo, những chiếc gối ôm này sẽ chính thức được bày bán, và còn có nhiều sản phẩm tương tự khác nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890614,
						401890616
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890614,
					"content": "Kể ra thì tôi cũng hơi háo hức đấy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890615
					]
				},
				{
					"id": 401890615,
					"content": "Tuyệt vời phải không? Hơn nữa, với tư cách là người đại diện bản quyền hình ảnh kiêm người giám hộ của Phu Nhân Chevalmarin, Furina sẽ nhận được 60% tiền hoa hồng đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890618
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890618,
					"content": "Dù sao thì đây cũng là sở thích của mọi người. Mục đích không phải để kiếm tiền, mà là để quảng bá hình ảnh đáng yêu của Phu Nhân Chevalmarin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890619
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890619,
					"content": "Furina càng có nhiều Mora, thì Phu Nhân Chevalmarin càng được ăn uống ngon lành, mọi người đều sẽ vui vẻ vì điều đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890620
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890620,
					"content": "Hihi, tôi thích cảm giác này! Mọi người cùng nhau nỗ lực vì sở thích chung, không cần phải tính toán lợi nhuận!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890621
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890621,
					"content": "Kể ra thì việc hoàn toàn không quan tâm đến Mora cũng hơi không ổn. Dù là sản phẩm của người làm vì đam mê hay dự án thương mại thì cũng phải cân đối thu chi cơ bản.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890622
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890622,
					"content": "Ý nghĩa của Phim Trường Vui Vẻ Chevalmarin lần này cũng là như thế đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890623
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890623,
					"content": "Sau khi hoàn thành Chiến Lược Chơi Tiêu Chuẩn, các trò chơi giải trí sẽ có thể chính thức mở cửa đón khách. Tuy nhiên, chúng ta không thể tự mình làm nhân viên bán vé được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890624
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890624,
					"content": "Gian hàng còn nhiều việc vặt cần xử lý, Phim Trường Vui Vẻ cũng cần chúng ta tiếp tục xây dựng. Vì vậy, chúng ta cần sắp xếp nhân viên chuyên trách cho từng trò chơi để quản lý và bảo trì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890625
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890625,
					"content": "Tại bảng thông báo có một mục tuyển dụng, chúng tôi đã nhận được rất nhiều hồ sơ ứng tuyển. Mỗi người đều có thế mạnh riêng, vì vậy chúng ta cần tìm ra những nhân viên có năng lực tổng hợp tốt nhất dựa trên yêu cầu của từng hạng mục!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890626
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890626,
					"content": "Sau đó, các nhân viên sẽ tiếp tục vận hành các trò chơi, không ngừng mang lại lợi nhuận cho Phim Trường Vui Vẻ Chevalmarin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890627
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890627,
					"content": "Hả? Tự nhiên từ chuyên gia thử nghiệm trở thành... người tuyển dụng nhân viên à? Tôi chưa từng trải qua chuyện này bao giờ đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890628,
						401890629
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890628,
					"content": "Tôi rất khắt khe trong việc sàng lọc hồ sơ đấy!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890630
					]
				},
				{
					"id": 401890630,
					"content": "#{NICKNAME} cũng đừng lấy bản thân ra làm chuẩn mực tuyệt đối, rồi đòi hỏi người khác phải giỏi như mình nhé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890631
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890631,
					"content": "Được rồi, đến lúc xem hồ sơ rồi! Hy vọng sẽ có những ứng viên tài năng đến ứng tuyển!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890629,
					"content": "Tôi chắc chắn sẽ là một người sếp đáng tin cậy!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890630
					]
				},
				{
					"id": 401890616,
					"content": "Hay là, chia cho Furina vài phần lợi nhuận nhỉ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890617
					]
				},
				{
					"id": 401890617,
					"content": "Yên tâm đi, Furina là người giám hộ kiêm quản lý bản quyền hình ảnh của Phu Nhân Chevalmarin, nên sẽ nhận được 60% tiền hoa hồng đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890618
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890603,
					"content": "Lại còn kết hợp với chủ đề điện ảnh nữa!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890604
					]
				}
			]
		},
