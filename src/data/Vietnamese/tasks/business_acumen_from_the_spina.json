				},
				{
					"id": 401890805,
					"content": "Bây giờ, Phim Trường Vui Vẻ Chevalmarin sẽ chính thức khai trương!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890806
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890806,
					"content": "Điều hành công viên giải trí là một quá trình lâu dài, quá nóng vội là không thể kiếm được nhiều Mora đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890807
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890807,
					"content": "Công việc lần này đã gần như hoàn tất, chúng ta hãy nghỉ ngơi một chút và chờ báo cáo doanh thu của kỳ này nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890803,
					"content": "Tôi sẽ đi kiểm tra thường xuyên đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890804
					]
				}
