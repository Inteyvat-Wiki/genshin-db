			"dialogs": [
				{
					"id": 740430201,
					"content": "Kháng nghị! Kháng nghị! Kháng nghị vì quyền lợi lao động của tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430202,
						740430204,
						740430206
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430202,
					"content": "Linh kiện mà anh cần...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430203
					]
				},
				{
					"id": 740430203,
					"content": "Ồ? Để tôi xem nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430204,
					"content": "Tại sao lại kháng nghị ở đây...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430205
					]
				},
				{
					"id": 740430205,
					"content": "Ngã xuống ở đâu thì phải đứng dậy ở đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430206,
					"content": "Tôi phải làm gì đây?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430207
					]
				},
				{
					"id": 740430207,
					"content": "Thật là hết cách. Có người đã bố trí những cỗ máy kỳ quái này ở một số nơi trên mặt đất và dưới nước. Cách để nhận biết cũng rất đơn giản, xung quanh máy móc sẽ xuất hiện ánh sáng kỳ lạ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430208
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430208,
					"content": "Xử lý nó, mang cho tôi linh kiện đặc biệt bên trong, tổng cộng <color=#00E1FFFF>cần bảy cái</color>. Làm ơn nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Henri"
				}
			]
		},
