			"dialogs": [
				{
					"id": 740430301,
					"content": "Ừm, quả là lấy được rồi, bảy linh kiện bí ẩn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430302
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430302,
					"content": "Vậy rốt cuộc linh kiện này là để làm gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430303
					]
				},
				{
					"id": 740430303,
					"content": "Sao tôi biết được? Ông chủ chỉ nói, cần bảy linh kiện bí ẩn của những máy móc bí ẩn này. Lấy được linh kiện thì kiếm được tiền.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430304
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430304,
					"content": "Tôi đã hẹn chủ thuê hôm nay gặp nhau ở đây để báo cáo tiến độ. Hai người có thể trực tiếp hỏi ông ấy. Dù gì cũng phải đợi ông ta thanh toán, tôi mới có tiền để chia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430305
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430305,
					"content": "Đúng là hết cách. Henri đã nói như thế rồi, vậy đợi một chút thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740430306,
					"content": "Chờ một hồi...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740430307
					]
				},
				{
					"id": 740430307,
					"content": "Henri thân mến, tình hình thế nào rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430308
					],
					"speakerTitle": "\"Ông Chủ\""
				},
				{
					"id": 740430308,
					"content": "Rất tốt, ông chủ! Bảy linh kiện bí ẩn mà ngài cần đã thu thập đủ rồi. Để tôi giới thiệu chút, đây là cộng sự của tôi... Tên là gì nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430309
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430309,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430310
					]
				},
				{
					"id": 740430310,
					"content": "Ấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430311
					],
					"speakerTitle": "\"Ông Chủ\""
				},
				{
					"id": 740430311,
					"content": "Ơ ơ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740430312,
					"content": "Ý? Mọi người quen nhau sao? Vậy thì tốt rồi! Chuyện là như vầy, ông chủ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430315
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430313,
					"content": "#\"Ấy! Là {NICKNAME}! Sao {NICKNAME} lại ở đây?!\"\\n\"Ông chủ\" quay mặt bỏ chạy, nhưng đã bị Hunter và Turner không biết từ đâu xuất hiện giữ lại rồi!\\n\\n",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740430314
					]
				},
				{
					"id": 740430315,
					"content": "Ui da! Xin tha mạng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430316
					],
					"speakerTitle": "\"Ông Chủ\""
				},
				{
					"id": 740430316,
					"content": "Ấy chà, hai người này điêu luyện quá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740430317,
					"content": "Ông chủ đừng lo, không có nguy hiểm gì cả!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430318
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430318,
					"content": "Đương nhiên, đương nhiên. Đương nhiên là không có nguy hiểm gì cả!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430319
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 740430319,
					"content": "Trước mắt là vậy đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430320
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 740430320,
					"content": "Trước, trước mắt là vậy... ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430321
					],
					"speakerTitle": "\"Ông Chủ\""
				},
				{
					"id": 740430321,
					"content": "Sau đó thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430322
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 740430322,
					"content": "Là gà nướng hoặc là... gì đó ngoài gà nướng, đều quyết định bởi thái độ của ông chủ đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430323
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 740430323,
					"content": "Ôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430324
					],
					"speakerTitle": "\"Ông Chủ\""
				},
				{
					"id": 740430324,
					"content": "Hai người sao lại ở đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740430325,
					"content": "Lần trước, sau khi chúng ta may mắn gặp gỡ, chúng tôi đã quyết định theo dõi Henri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430326
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 740430326,
					"content": "Chờ chút, tại sao lại muốn theo dõi tôi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430327
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430327,
					"content": "Không đúng, chung quy, các người tại sao muốn nhắm đến tôi! Tôi chỉ là nỗ lực làm việc thôi mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430328
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430328,
					"content": "Máy móc mà anh phá hủy chính là thiết bị mà chuyên gia Viện Khoa Học Fontaine dùng để kiểm tra và tối ưu chất lượng nước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430329
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 740430329,
					"content": "Hả? Không phải là thiết bị dùng để gây ô nhiễm sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430330
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430330,
					"content": "Linh kiện bị tháo ra có chứa công nghệ tiên tiến nhất và dữ liệu thủy văn của Fontaine. Chúng tôi hy vọng có thể... làm quen với đối tượng giao dịch của anh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430331
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 740430331,
					"content": "Ấy? Ấy? Cái gì? Tại sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430332,
						740430334
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430332,
					"content": "Henri! Anh lừa tôi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430333
					]
				},
				{
					"id": 740430334,
					"content": "Không ngờ! Chúng ta bị lừa rồi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430335
					]
				},
				{
					"id": 740430333,
					"content": "Không không, hai vị là ân nhân của tôi, sao tôi có thể lừa hai vị được chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430335
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430335,
					"content": "Ông chủ, sao ông lừa tôi! Sao lại lừa tôi phá hoại thứ quan trọng như vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430336
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430336,
					"content": "Tôi, tôi không cố ý... Tôi chỉ là cấp thấp thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430337
					],
					"speakerTitle": "\"Ông Chủ\""
				},
				{
					"id": 740430337,
					"content": "Hả? Ông chủ nói gì cơ tôi không nghe rõ, cái gì mà \"không cố ý\"... Ngài nói lại lần nữa xem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430338
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 740430338,
					"content": "Ấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430339
					],
					"speakerTitle": "\"Ông Chủ\""
				},
				{
					"id": 740430339,
					"content": "Ông chủ này có vẻ mệt rồi, mới đó mà đã xỉu mất tiêu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430340
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 740430340,
					"content": "Ôi ôi, tôi, chúng tôi không cố ý...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430341
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740430341,
					"content": "Về chuyện này, chúng tôi quyết định, không truy cứu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430342
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 740430342,
					"content": "Ấy? Thật sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430343
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740430343,
					"content": "Dù sao chỉ cần linh kiện còn nguyên vẹn, dữ liệu trong đó không hư tổn, máy móc căn bản không có vấn đề.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430344
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 740430344,
					"content": "Bên trên đã nói không truy cứu, dù gì cũng không thể làm khó các bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430345
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 740430345,
					"content": "Có làm khó dễ gì tôi đâu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430346
					]
				},
				{
					"id": 740430346,
					"content": "Không có gì, không có gì. Bạn xem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430347
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 740430347,
					"content": "Chúng tôi chỉ là đang tản bộ mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430348
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 740430348,
					"content": "Chúng ta chỉ tình cờ gặp gỡ, phải không? Thời tiết đẹp, cuộc gặp gỡ tốt đẹp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430349
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 740430349,
					"content": "Nhưng cuộc gặp gỡ tốt đẹp đều sẽ kết thúc, chúng ta nên... tạm biệt rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430350
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 740430350,
					"content": "Để cuộc gặp gỡ tốt đẹp lưu giữ trong tim, hoặc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430351
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 740430351,
					"content": "Quên đi thì càng tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430352
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 740430352,
					"content": "Ấy... Vậy nên chúng tôi không sao rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430353
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430353,
					"content": "Hửm, vậy anh muốn sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430354
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 740430354,
					"content": "Không sao không sao! Haha, tất nhiên là không sao rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430355
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430355,
					"content": "Haiz, tôi cứ nghĩ là đã gặp được người tốt, có thể thay đổi số phận nhờ sức lao động. Cuối cùng, thế gian này vẫn là nhiều người xấu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430356
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430356,
					"content": "...Này, Henri, đến giúp một tay nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430357
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 740430357,
					"content": "Hả?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430358
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430358,
					"content": "Thật không may, ông chủ tốt bụng này bất tỉnh rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430359
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 740430359,
					"content": "Chúng tôi cần một người...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430360
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 740430360,
					"content": "Làm việc chăm chỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430361
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 740430361,
					"content": "Trung thực đáng tin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430362
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 740430362,
					"content": "Một người bạn tốt... hy vọng dùng sức lao động để thay đổi số phận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430363
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 740430363,
					"content": "Đúng vậy, một người bạn tốt, đưa giúp ông chủ tốt bụng này đến ngôi nhà an toàn của chúng tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430364
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 740430364,
					"content": "Ở đó, chúng tôi mới tiện... nói chuyện với ông chủ tốt bụng này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430365
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 740430365,
					"content": "Đương nhiên rồi, chúng tôi sẽ bày tỏ... lòng cảm ơn của mình bằng Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430366
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 740430366,
					"content": "Được! Để tôi giúp một tay!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430367
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430367,
					"content": "Quá tốt rồi! Cảm ơn hai vị! Cũng rất cảm ơn, ừm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430368
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430368,
					"content": "#Tôi là {NICKNAME}, đây là Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430369
					]
				},
				{
					"id": 740430369,
					"content": "#Cảm ơn {NICKNAME} và Paimon! Sau khi gặp gỡ hai người, số phận của tôi đã thay đổi rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430370
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430370,
					"content": "Không có gì đâu! Henri cố lên, đừng để bị lừa nữa nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430371
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740430371,
					"content": "Ừm! Không đâu! Tôi phải nỗ lực làm việc, trở thành người giàu có! Sau này sẽ thuê người khác làm việc cho tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430372
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430372,
					"content": "Hunter, Turner và Henri cùng đào tên Fatui đã bất tỉnh nhân sự lên, rồi mang đi.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740430373
					]
				},
				{
					"id": 740430373,
					"content": "Mong rằng Henri sẽ được hạnh phúc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430374
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740430374,
					"content": "Chờ đã! Henri nói là gửi thù lao cho chúng ta?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}