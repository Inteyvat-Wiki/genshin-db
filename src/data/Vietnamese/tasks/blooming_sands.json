			"dialogs": [
				{
					"id": 732330201,
					"content": "Haiz, vẫn còn một lô hàng nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330202
					],
					"speakerTitle": "Azalai"
				},
				{
					"id": 732330202,
					"content": "Hàng hóa của Raef...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330203
					]
				},
				{
					"id": 732330203,
					"content": "Bạn nói đến mấy món hàng mà Raef đặt ở chỗ tôi sao? Tôi vừa mới nhận một lô hàng, trong đó có thứ mà anh ta cần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330204
					],
					"speakerTitle": "Azalai"
				},
				{
					"id": 732330204,
					"content": "Nhưng mà, đồ anh ta mua cũng không ít... Bạn đến giúp anh ta lấy hàng ư?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330205,
						732330206
					],
					"speakerTitle": "Azalai"
				},
				{
					"id": 732330205,
					"content": "Nặng lắm không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330207
					]
				},
				{
					"id": 732330207,
					"content": "Ngoài chậu hoa kia thì còn có các loại hạt giống, phân bón và đồ làm vườn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330208
					],
					"speakerTitle": "Azalai"
				},
				{
					"id": 732330208,
					"content": "Mấy món đó cộng lại cũng không phải là nhẹ, bạn... một mình bạn có thể vác về được sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330209,
						732330210
					],
					"speakerTitle": "Azalai"
				},
				{
					"id": 732330209,
					"content": "Tôi sẽ có cách...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330211
					]
				},
				{
					"id": 732330211,
					"content": "Như vậy sao... Vậy được, tôi sẽ giúp bạn gói hàng lại. Bạn đi chuyến này đúng là vất vả rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Azalai"
				},
				{
					"id": 732330210,
					"content": "Tôi đã nhận lời người ta rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330211
					]
				},
				{
					"id": 732330206,
					"content": "Có bao nhiêu món vậy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330207
					]
				}
			]
		},
