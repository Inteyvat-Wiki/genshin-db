			"dialogs": [
				{
					"id": 732330601,
					"content": "Nhà Lữ Hành, bạn đã về, vất vả cho bạn rồi... Nermin nói như thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330602,
						732330605
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330602,
					"content": "Cô ấy lo rằng mình không biết trồng hoa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330603
					]
				},
				{
					"id": 732330603,
					"content": "Cái này... để tôi cùng cô ấy nghiên cứu chuyện này, nếu vẫn không được thì tìm người khác để hỏi vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330604
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330604,
					"content": "Nếu thật sự không được, tôi... tôi sẽ... đi tìm những giống hoa dễ trồng hơn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330608
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330608,
					"content": "Khụ, tóm lại... Nhà Lữ Hành, cảm ơn bạn đã giúp tôi, mong bạn hãy nhận lấy khoản tiền thưởng này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330609
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330609,
					"content": "Đợi lát nữa tôi sẽ đưa những thứ khác đến chỗ Nermin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330610
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330610,
					"content": "Khoan đã, mấy món đồ làm vườn này không kèm theo sách hướng dẫn à? Tôi hoàn toàn không biết cách dùng chúng luôn đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330605,
					"content": "Trước đây anh chưa từng tặng hoa cho cô ấy sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330606
					]
				},
				{
					"id": 732330606,
					"content": "Cũng không thể nói là chưa từng tặng... nhưng mấy lần trước tôi đều nhờ mọi người mua hoa đã trưởng thành. Nên đến lúc đưa đến đây thì mấy bông hoa đó đã thành hoa khô rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330607
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330607,
					"content": "Cho nên lần này, tôi quyết định tặng cho Nermin một chậu hoa mới trồng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330608
					],
					"speakerTitle": "Raef"
				}
			]
