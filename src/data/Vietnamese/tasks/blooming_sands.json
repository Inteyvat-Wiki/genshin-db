			},
			"dialogs": [
				{
					"id": 732330401,
					"content": "Chính là mấy thứ này, Nhà Lữ Hành, cảm ơn bạn rất nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330402,
						732330403
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330402,
					"content": "Anh định mở tiệm hoa à...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330404
					]
				},
				{
					"id": 732330404,
					"content": "Đây là kiểu... đã mua thì mua nhiều một chút, đỡ phải đi đi lại lại đúng không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330405
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330405,
					"content": "Bạn ngồi nghỉ một lát nhé! Tôi phải đi gieo hạt rồi bón phân nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330406
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330406,
					"content": "Raef bắt đầu lấy chậu hoa ra...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732330407
					]
				},
				{
					"id": 732330407,
					"content": "Xong rồi! Như vậy là được, Nermin chỉ cần tưới nước cho nó nữa là xong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330408
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330408,
					"content": "Nhà Lữ Hành, có thể... một lần nữa nhờ bạn giúp tôi đi tặng chậu hoa này cho Nermin không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330409
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330409,
					"content": "Anh không đi à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330410
					]
				},
				{
					"id": 732330410,
					"content": "Tôi phải canh gác nơi này, nếu có lương thực hoặc vật tư được chuyển đến thì tôi còn phải gọi người trong làng ra để nhận nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330411
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330411,
					"content": "Nhiệt độ xung quanh... bạn hẳn đã cảm nhận được. Nếu như nhận hàng quá chậm thì vật tư sẽ bị phơi khô hết đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330412
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330412,
					"content": "Nhà Lữ Hành, nhờ bạn đó, Nermin ở cách đây không xa, bạn đưa chậu hoa này cho cô ấy là được, những thứ khác tôi sẽ nghĩ cách để vận chuyển về.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330403,
					"content": "Anh mua nhiều đồ như vậy để làm gì!?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330404
					]
				}
			]
		},
