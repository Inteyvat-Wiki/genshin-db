			"dialogs": [
				{
					"id": 706560101,
					"content": "Xin chào, bạn đến khiêu chiến bí cảnh phía trước sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706560102,
						706560103
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 706560102,
					"content": "Có chút hứng thú.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706560104
					]
				},
				{
					"id": 706560104,
					"content": "Vậy vừa đúng lúc, để tôi giới thiệu cho bạn nhé, tôi là Plauen thuộc Hiệp Hội Nhà Mạo Hiểm, phụ trách canh giữ cổng vào bí cảnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706560105
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 706560105,
					"content": "Theo ghi chép của Hiệp Hội Nhà Mạo Hiểm, nó dường như chỉ xuất hiện vào thời gian nhất định.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706560106
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 706560106,
					"content": "Hiện tại vừa đúng dịp Lễ Hội Hoa Gió, chúng tôi đang cải tạo một chút, sửa thành hạng mục khiêu chiến đặc biệt, dành cho tất cả mọi người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706560107
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 706560107,
					"content": "Sẽ không có nguy hiểm gì chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706560108
					]
				},
				{
					"id": 706560108,
					"content": "Không đâu, đây là một hoạt động đặc biệt để mừng lễ, nếu là người chưa có kinh nghiệm mạo hiểm tham gia, thì sẽ có chuyên gia mạo hiểm đi cùng suốt quãng đường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706560109
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 706560109,
					"content": "Nhưng mà, kinh nghiệm mạo hiểm của các bạn phong phú như vậy, chắc không cần chúng tôi giúp đỡ đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706560110
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 706560110,
					"content": "Bạn có thể thám hiểm bí cảnh một mình, cũng có thể mời bạn bè cùng đi, tóm lại, chỉ cần vượt qua được thì sẽ có phần thưởng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706560111,
						706560112
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 706560111,
					"content": "Hiểu rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706560113
					]
				},
				{
					"id": 706560113,
					"content": "Vậy tôi không làm mất thời gian nữa, chúc các bạn vui vẻ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Plauen"
				},
				{
					"id": 706560112,
					"content": "Nếu có phần thưởng thì có thể thử.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706560113
					]
				},
				{
					"id": 706560103,
					"content": "Hình như là một bí cảnh đặc biệt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706560104
					]
				}
			]
		}
	]
