			"dialogs": [
				{
					"id": 756710101,
					"content": "Chíp chíp, chíp chíp chíp!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710102
					],
					"speakerTitle": "Basima Đệ Ngũ"
				},
				{
					"id": 756710102,
					"content": "Đang làm gì vậy nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710103,
						756710104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756710103,
					"content": "Mật mã?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756710105
					]
				},
				{
					"id": 756710105,
					"content": "Đúng rồi! Đó là kỹ thuật để giao tiếp với chim sẻ đáng yêu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710106
					],
					"speakerTitle": "Basima Đệ Ngũ"
				},
				{
					"id": 756710106,
					"content": "Ồ, có vẻ tôi đã quên chào hỏi rồi, còn câu mở đầu không thể thiếu nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710107
					],
					"speakerTitle": "Basima Đệ Ngũ"
				},
				{
					"id": 756710107,
					"content": "Xin chào hai vị khách qua đường, tôi là Basima Đệ Ngũ, học giả của Học Phái Amurta, một thương nhân mới và là chuyên gia về động vật đáng yêu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710108
					],
					"speakerTitle": "Basima Đệ Ngũ"
				},
				{
					"id": 756710108,
					"content": "Hãy thả lỏng cơ thể, giải tỏa tâm trí và lắng nghe tôi nói một chuyện quan trọng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710109
					],
					"speakerTitle": "Basima Đệ Ngũ"
				},
				{
					"id": 756710109,
					"content": "Chim sẻ là đáng yêu nhất, đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756710110,
					"content": "Hoàn toàn chính xác! Chúc mừng các vị đã bị sự đáng yêu của chim sẻ mê hoặc và vô thức trả lời!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710111
					],
					"speakerTitle": "Basima Đệ Ngũ"
				},
				{
					"id": 756710111,
					"content": "Kỳ lạ, không biết tại sao vừa nhìn thấy trò chơi trên bàn là trong đầu lại lóe lên câu nói này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756710112,
					"content": "#{NICKNAME} có ấn tượng gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710113,
						756710115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756710113,
					"content": "Hình như lúc trước chúng ta đã từng gặp nhau rồi nhỉ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756710114
					]
				},
				{
					"id": 756710114,
					"content": "Đúng rồi! Không chỉ một lần đâu, thấy hai vị vẫn tràn đầy năng lượng như vậy, tôi cảm thấy rất ấm lòng đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710117
					],
					"speakerTitle": "Basima Đệ Ngũ"
				},
				{
					"id": 756710117,
					"content": "À, có muốn thử chơi trò chơi này không? Đây là phiên bản thứ mười bảy, hay còn gọi là thế hệ thứ ba của Chim Sẻ Bing-Bang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710118
					],
					"speakerTitle": "Basima Đệ Ngũ"
				},
				{
					"id": 756710118,
					"content": "Trong lúc thư giãn chơi trò chơi, hai vị còn có thể tìm hiểu câu chuyện về Chim Sẻ Đỏ Cổ Xưa khổng lồ chiến thắng hải âu nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710119
					],
					"speakerTitle": "Basima Đệ Ngũ"
				},
				{
					"id": 756710119,
					"content": "Được rồi, đúng là những trò chơi nhẹ nhàng thư giãn thế này thì thích thật!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710120,
						756710121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756710120,
					"content": "Vậy thì chơi thôi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756710122
					]
				},
				{
					"id": 756710122,
					"content": "Ừm! Mong hai vị có thể tìm ra cách chơi phù hợp nhất với bản thân, phát hiện niềm vui độc nhất vô nhị!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Basima Đệ Ngũ"
				},
				{
					"id": 756710121,
					"content": "Bắt đầu thôi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756710122
					]
				},
				{
					"id": 756710115,
					"content": "Bây giờ bắt đầu bằng câu \"chim sẻ đáng yêu nhất\" cũng được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756710116
					]
				},
				{
					"id": 756710116,
					"content": "Đúng vậy! Dù tạm thời không nhớ được chuyện trước đây cũng không sao, điều quan trọng là tận hưởng hiện tại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710117
					],
					"speakerTitle": "Basima Đệ Ngũ"
				},
				{
					"id": 756710104,
					"content": "Ám hiệu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756710105
					]
				}
			]
		}
	]
}