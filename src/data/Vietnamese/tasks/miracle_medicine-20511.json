						205110403
					]
				},
				{
					"id": 205110403,
					"content": "Là đây sao? Nhìn cũng chả có gì khác...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110404
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110404,
					"content": "Nhìn thế nào cũng thấy giống Quả Mâm Xôi bình thường...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110405
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110405,
					"content": "Thôi vậy, dù sao thần y cũng kê đơn như vậy rồi, tôi cứ làm theo những gì trên đơn thuốc viết vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110406
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110406,
					"content": "Cám ơn bạn, đây là tiền công của bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110407
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110407,
					"content": "Nói không chừng sau này còn phải làm phiền bạn, mong bạn đừng từ chối.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
