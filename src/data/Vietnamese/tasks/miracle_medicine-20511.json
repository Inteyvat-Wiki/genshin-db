			"dialogs": [
				{
					"id": 205110101,
					"content": "Thuốc này hiệu quả thật sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110102
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110102,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205110103
					]
				},
				{
					"id": 205110103,
					"content": "Nhà Lữ Hành! Bạn đến thật đúng lúc, tôi đang lo lắng lắm đây,",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110104
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110104,
					"content": "Là thế này, cậu còn nhớ em gái Anna của tôi không, con bé bị bệnh suốt, chữa trị thế nào cũng không khỏi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110105
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110105,
					"content": "Nhưng tôi nghe nói ở Cảng Liyue có một vị thần y, chuyên chữa những bệnh nan y, nên muốn nhờ người đến chỗ ông ấy xin thuốc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110106
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110106,
					"content": "Tuy nguyên liệu trong đơn thuốc rất kỳ lạ... nhưng cũng muốn thử xem thế nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110107
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110107,
					"content": "Ừm, để tôi xem, bạn có thể giúp tôi tìm một ít quả mâm xôi bị Slime Thảo ăn không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110108,
						205110112,
						205110116
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110108,
					"content": "Thật sự là có thứ như vậy sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205110109
					]
				},
				{
					"id": 205110109,
					"content": "Tôi cũng không biết! Slime Thảo biết ăn Quả Mâm Xôi thật sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110110
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110110,
					"content": "Vậy thì, thì nhờ bạn vậy! Tôi biết một chỗ có Slime Thảo, có cả Quả Mâm Xôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110111
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110111,
					"content": "Nhờ bạn đi xem thế nào, mong là tìm được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110112,
					"content": "Lang băm hỏng việc.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205110113
					]
				},
				{
					"id": 205110113,
					"content": "Bạn cũng thấy vậy sao? Nhưng mà, tôi thật sự hết cách rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110114
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110114,
					"content": "Tôi biết một nơi có rất nhiều Slime Thảo, còn có cả Quả Mâm Xôi, hãy giúp tôi đến đó tìm xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110115
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110115,
					"content": "Thuốc làm ra tôi sẽ thử trước. Dù thế nào cũng không thể để sức khỏe của Anna tiếp tục xấu đi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110116,
					"content": "Nếu không tìm được, tôi sẽ bắt Slime Thảo cho bạn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205110117
					]
				},
				{
					"id": 205110117,
					"content": "Ơ... Ơ? Bạn muốn tôi tự tay nhét Quả Mâm Xôi cho Slime Thảo ăn sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110118
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110118,
					"content": "Tha cho tôi đi, lần trước lúc tôi hái thuốc cho Anna, bị một đám Slime Thảo đuổi theo đến Thanh Tuyền Trấn luôn đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110119
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110119,
					"content": "Tôi biết một nơi có rất nhiều Slime Thảo, còn có cả Quả Mâm Xôi, hãy giúp tôi đến đó xem sao, mong là tìm được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110120
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110120,
					"content": "Nhưng... Nếu, nếu thật sự không được, vì Anna... Bạn, bạn có thể bắt Slime Thảo về đây!Tôi làm được! Nhất định làm được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				}
			]
		},
