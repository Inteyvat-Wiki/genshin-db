			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhongli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10100601,
					"content": "#Nhà Lữ Hành, sau khi đi qua \"vùng đất bị thần rời bỏ\", đối với \"vùng đất có thần\" Liyue, {F#cô}{M#cậu} có cảm giác thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100602,
						10100605
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100602,
					"content": "Tôi thích bầu không khí ở Mondstadt hơn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100603
					]
				},
				{
					"id": 10100603,
					"content": "#Tôi hiểu rồi...Hóa ra {F#cô}{M#cậu} là kiểu du khách như vậy. Cũng không tệ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100604
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100604,
					"content": "#Có điều, \"vùng đất có thần\" này đã trải qua 3700 năm lịch sử, có thể {F#cô}{M#cậu} vẫn chưa trải nghiệm được hết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100607
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100607,
					"content": "#Quá trình chuẩn bị \"Điển Lễ Tiễn Tiên\" cũng sẽ trở thành một phần trong hành trình của {F#cô}{M#cậu}, giúp {F#cô}{M#cậu} mở rộng tầm mắt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100608
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100608,
					"content": "Những năm qua dưới sự bảo vệ của Thần Linh và sự cai trị của Thất Tinh, Liyue trở thành quốc gia thịnh vượng nhất trong bảy vương quốc. Bởi vậy rất nhiều thủ đoạn của Fatui đều không thể thực hiện được ở Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100609
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100609,
					"content": "Ningguang, một trong Thất Tinh luôn luôn đề cao phòng bị đối với Fatui, có lẽ đây chính là lý do Childe muốn mượn quan hệ với Vãng Sinh Đường để hành sự.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100610
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100610,
					"content": "Ủa... Chúng ta làm \"Điển Lễ Tiễn Tiên\" thì có lợi ích gì đối với Childe chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100611,
					"content": "Tôi không biết, cũng không muốn biết. Đối với tôi mà nói Fatui chỉ là nơi cung cấp tài chính. Tôi chỉ hy vọng truyền thống của Liyue sẽ không bị lãng quên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100612
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100612,
					"content": "(Zhongli đưa cho nhân vật chính 1 túi tiền)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100613
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100613,
					"content": "#Đây là khoản tạm ứng đầu tiên mà Childe đưa cho tôi. Nếu {F#cô}{M#cậu} dùng hết thì có thể đi tìm anh ta thanh toán khoản tiền tiếp theo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100614
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100614,
					"content": "Wow...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100615,
					"content": "Được rồi, chúng ta bắt đầu thôi. Bước đầu tiên chuẩn bị cho nghi lễ... Là lấy được <color=#00E1FFFF>Dạ Phách Thạch</color> tốt nhất có đầy đủ phẩm chất để xứng với Thần Linh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100605,
					"content": "Quả nhiên vẫn là Liyue tốt hơn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100606
					]
				},
				{
					"id": 10100606,
					"content": "Ừm, \"vùng đất có thần\" có bề dày 3700 năm lịch sử và cũng là quốc gia lâu đời nhất trong 7 vương quốc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100607
					],
					"speakerTitle": "Zhongli"
				}
			]
		},
