	"talks": [
		{
			"id": 101002,
			"completionStepIds": [
				101002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101002",
							"2"
						],
						"stepId": 101002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ekaterina"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10100201,
					"content": "#Chào mừng {NICKNAME}, bằng hữu của đại nhân Childe. Chúc bạn sau này ở Fatui có thể một bước lên mây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100202,
						10100203
					],
					"speakerTitle": "Ekaterina"
				},
				{
					"id": 10100202,
					"content": "Tôi không phải là bạn của Childe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100204
					]
				},
				{
					"id": 10100204,
					"content": "Ha... Chúng ta đều là người phàm, không phải \"Nữ Hoàng Băng Giá\". Những suy nghĩ của người phàm giống như nước dưới tầng băng... sẽ không sắc bén và vững vàng mãi mãi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100205
					],
					"speakerTitle": "Ekaterina"
				},
				{
					"id": 10100205,
					"content": "Thất lễ rồi, xin phép cho tôi quay lại chủ đề chính. Đại nhân Childe nói, giao ước giữa ngài và các bạn đã hoàn thành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100206
					],
					"speakerTitle": "Ekaterina"
				},
				{
					"id": 10100206,
					"content": "Giao ước đã hoàn thành? Hả, là nói việc anh ta giúp chúng tôi tìm người sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100207,
					"content": "Đúng vậy, đại nhân Childe đã hứa sẽ giúp các bạn tìm người có thể phá vỡ cục diện này. Quan chấp hành của Fatui chưa bao giờ thất hứa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100208
					],
					"speakerTitle": "Ekaterina"
				},
				{
					"id": 10100208,
					"content": "Vậy, anh ta đang ở đâu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100209,
					"content": "Đại nhân ở <color=#00E1FFFF>Lưu Ly Đình</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100210
					],
					"speakerTitle": "Ekaterina"
				},
				{
					"id": 10100210,
					"content": "Lưu Ly Đình?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100211
					]
				},
				{
					"id": 10100211,
					"content": "A, là Lưu Ly Đình! Tôi đã từng nghe nói!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100212,
					"content": "\"Món Li\" và \"món Yue\" là hai phong cách ẩm thực ở cảng Liyue, đã tranh đấu hàng trăm năm, bất phân thắng bại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100213,
					"content": "Đại diện cho \"Món Li\" chính là quán rượu Lưu Ly Đình. Ông chủ cố tình mở quán ở Dốc Phi Vân, cạnh tranh trực tiếp với đại diện của \"Món Yue\" là Tân Nguyệt Hiên!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100214,
						10100215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100214,
					"content": "Chỉ những lúc như thế này Paimon mới giống một người hướng dẫn tốt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100216
					]
				},
				{
					"id": 10100216,
					"content": "#Đừng nói như vậy mà! Tóm lại là có đồ ăn ngon! {NICKNAME}, chúng ta mau đi xem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100215,
					"content": "Khi nhắc đến chủ đề ăn uống, là bạn...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100216
					]
				},
				{
					"id": 10100203,
					"content": "Tôi không định gia nhập Fatui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100204
					]
				}
			]
		},
		{
			"id": 101003,
			"completionStepIds": [
				101003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101003",
							"2"
						],
						"stepId": 101003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Childe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10100301,
					"content": "Ồ, các bạn đến rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100302
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10100302,
					"content": "Giao ước đã hoàn thành, tôi đã tìm thấy người có thể giúp các bạn, người có thể giải quyết vấn đề \"tiên thể của Nham Thần bị Thất Tinh che giấu\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100303
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10100303,
					"content": "Vậy, người đó đang ở đâu? Trong <color=#00E1FFFF>Lưu Ly Đình</color> à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100304,
					"content": "Không sai. Hãy đi theo tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100305
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10100305,
					"content": "Tôi đã chuẩn bị một bữa. Ừm, ở đất nước này có thói quen gọi là \"bữa tiệc\" gặp mặt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Childe"
				}
			]
		},
		{
			"id": 101005,
			"completionStepIds": [
				101005
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101005",
							"2"
						],
						"stepId": 101005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhongli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10100501,
					"content": "Tôi xin được giới thiệu, người bạn này là người trong nghề, khách của Vãng Sinh Đường, ngài Zhongli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100502,
						10100503
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10100502,
					"content": "Người trong nghề?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100504
					]
				},
				{
					"id": 10100504,
					"content": "Ừm, ở Liyue, ngành nghề giống như Vãng Sinh Đường, luôn phải tiếp xúc làm ăn với \"người trong nghề\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100505
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10100505,
					"content": "Còn người Fatui chúng tôi, trước giờ luôn thích giao tiếp với... những người bạn hành tẩu trong bóng tối.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100506
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10100506,
					"content": "Hành tẩu trong, trong bóng tối...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100507,
					"content": "Rất hân hạnh được gặp hai bạn. Tôi đã nghe đến danh tiếng của các bạn ở Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100508
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100508,
					"content": "Người trong nghề... Bóng tối... Tiễn người \"vãng sinh\"... Lẽ nào, tổ chức Vãng Sinh Đường, chính là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100509,
					"content": "Không sai, đúng như suy đoán của bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100510
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100510,
					"content": "Hả!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100511,
					"content": "Vãng Sinh Đường là tổ chức phụ trách các đám tang, đưa tiễn người vãng sinh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100512
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100512,
					"content": "Hở.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100513,
					"content": "Ha ha, lẽ nào bạn cho rằng ngài Zhongli là sát thủ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100514
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10100514,
					"content": "Đúng là trong những người bạn của Fatui có rất nhiều sát thủ, nhưng Vãng Sinh Đường không làm nghề đó... Tối thiểu thì không làm công khai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100515
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10100515,
					"content": "Công khai...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100516
					]
				},
				{
					"id": 10100516,
					"content": "Rốt cuộc vẫn là \"người trong nghề\" mà, cái này không thể nói rõ được. Tóm lại, tôi đưa các bạn đến gặp Zhongli, là bởi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100517
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10100517,
					"content": "Vì tôi có cách để các bạn thấy được tiên thể của Nham Vương Đế Quân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100518
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100518,
					"content": "Sao cơ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100519,
					"content": "Ha, không cần phải ngạc nhiên như vậy, mặc dù dưới sự thao túng của Thiên Quyền Tinh Ningguang, tiên thể của Nham Thần sớm đã bị giấu kín... Nhưng, hãy nghe ý kiến của Zhongli trước đã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100520
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10100520,
					"content": "Mặc dù Nham Vương Đế Quân là Chúng Tiên Tổ Sư, nhưng suy cho cùng vẫn là một tiên nhân. Trong suốt hàng ngàn năm lịch sử của Liyue, các tiên nhân liên tục rời đi, đây cũng là tình thế không thể cứu vãn được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100521
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100521,
					"content": "#Thời thế đã đổi thay, {F#cô}{M#cậu} ở Tuyệt Vân Gián chắc cũng đã thấy được sự thay đổi này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100522,
						10100523
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100522,
					"content": "Quả thực, các tiên nhân đang rời xa Liyue.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100525
					]
				},
				{
					"id": 10100525,
					"content": "#Như {F#cô}{M#cậu} đã thấy. thời đại của tiên nhân đang dần biến mất, thời đại của con người dần đang dần trở thành hiện thực.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100526
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100526,
					"content": "Trước kia, mỗi khi một vị tiên nhân ra đi đều sẽ có một nghi thức kỷ niệm rất long trọng. Đây cũng là truyền thống của Liyue. Nhưng lần này, ngay cả Thất Tinh cũng không có thời gian để quan tâm đến truyền thống này... Thật không ra thể thống gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100527
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100527,
					"content": "Dẫu sao cũng là \"vụ án mưu sát Thần\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100528
					]
				},
				{
					"id": 10100528,
					"content": "Đúng vậy, ngay cả hung thủ thực sự cũng chưa bắt được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100529
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100529,
					"content": "Vụ án mưu sát Thần... Vãng Sinh Đường không quan tâm đến chuyện này. Điều Vãng Sinh Đường quan tâm chính là nghi thức thỉnh tiên long trọng như vậy, mà nghi thức tiễn tiên lại không có ai để ý hay sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100530
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100530,
					"content": "#Nhà lữ hành, tôi đã nghe Childe nhắc đến {F#cô}{M#cậu}. {F#Cô}{M#Cậu} có quen biết Phong Thần... Vậy, có thể cùng chúng tôi chuẩn bị nghi lễ đưa tiễn Nham Thần được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100531,
						10100534,
						10100536
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100531,
					"content": "Tôi cần suy nghĩ một chút...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100532
					]
				},
				{
					"id": 10100532,
					"content": "#Ừm... {NICKNAME}, suy nghĩ cho cùng, có lẽ cũng không còn cách nào khác...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100533
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100533,
					"content": "Đúng vậy, suy nghĩ thêm kết quả cũng chỉ như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100539
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10100539,
					"content": "#Thiên Quyền Ningguang... Cô ta đang ngăn cản bất cứ ai muốn đến gần tiên thể của Đế Quân. Cho nên, nếu {F#cô}{M#cậu} muốn đạt được mục tiêu tìm kiếm bảy vị thần, chỉ có con đường này thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100540
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10100540,
					"content": "#Đúng như vậy. Chỉ có tham gia \"Điển Lễ Tiễn Tiên\" {F#cô}{M#cậu} mới có thể nhìn thấy tiên thể của Nham Thần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100541
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100541,
					"content": "Xem ra cũng không còn cách nào khác.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100542
					]
				},
				{
					"id": 10100542,
					"content": "#Ừm, nếu {F#cô}{M#cậu} đồng ý, hãy đi cùng tôi. Chúng ta sẽ nói chi tiết trên đường đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100543
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100543,
					"content": "(Màn hình đen, Zhongli rời đi)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100544
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100544,
					"content": "Được rồi, nhiệm vụ giới thiệu của tôi đã hoàn thành. Thế nào, kết quả này cũng không tệ phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100545
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10100545,
					"content": "Nếu các bạn phải đi thì cứ đi, không cần lo cho tôi, có thể tôi sẽ ở đây uống thêm vài ly... Tiện thể làm quen với cách dùng \"đũa\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Childe"
				},
				{
					"id": 10100534,
					"content": "Muốn tôi chấp nhận lời mời, cũng không phải không được...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100535
					]
				},
				{
					"id": 10100535,
					"content": "Lựa chọn khôn ngoan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100539
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10100536,
					"content": "Childe nói nhiều thật.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100537
					]
				},
				{
					"id": 10100537,
					"content": "Hả? Ở \"trong nghề\" câu nói này có nghĩa là muốn giết người diệt khẩu đó... Rất thú vị, rút kiếm ra đi, bọn ta ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100538
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10100538,
					"content": "Nói đùa thôi. Chúng ta tiếp tục bàn chính sự.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100539
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10100523,
					"content": "Nham Thần, một trong bảy vị thần cũng là tiên nhân?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100524
					]
				},
				{
					"id": 10100524,
					"content": "Thần có rất nhiều tôn danh. Thần Khế Ước, Thần Thương Nghiệp, Võ Thần, Morax, Nham Vương Đế Quân... Trong đó cũng bao gồm \"Tiên Nhân\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100525
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100503,
					"content": "Vãng Sinh Đường?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100504
					]
				}
			]
		},
		{
			"id": 101006,
			"completionStepIds": [
				101006
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
