			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Quả Thông Nhỏ",
					"Người Gỗ Bùng Nổ",
					"Vigee"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 755100101,
					"content": "Theo mình thấy thì tuy Đấu Sĩ Mặt Nạ không thể tự do bay lượn như Người Hòa Giải, nhưng chỉ cần tìm đúng cơ hội để lao tới thì chắc chắn sẽ thắng trận!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100102
					],
					"speakerTitle": "Quả Thông Nhỏ"
				},
				{
					"id": 755100102,
					"content": "Đồ ngốc, không thể ỷ lại vào tốc độ lao lên theo đường thẳng được. Nếu không thể đổi hướng hay tông trúng mục tiêu thì chẳng phải sẽ vô nghĩa sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100103
					],
					"speakerTitle": "Người Gỗ Bùng Nổ"
				},
				{
					"id": 755100103,
					"content": "Được rồi, các bạn nhỏ. Có thể thảo luận nghiêm túc, nhưng không được cãi nhau đâu nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100104
					],
					"speakerTitle": "Vigee"
				},
				{
					"id": 755100104,
					"content": "Không có đâu, chỉ là... nói đến những chiến sĩ mạnh mẽ thì chúng em có hơi phấn khích thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100105
					],
					"speakerTitle": "Người Gỗ Bùng Nổ"
				},
				{
					"id": 755100105,
					"content": "Chị Vigee yên tâm! Dù có muốn so cao thấp thì chúng em cũng sẽ nói lý lẽ và có bằng chứng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100106
					],
					"speakerTitle": "Quả Thông Nhỏ"
				},
				{
					"id": 755100106,
					"content": "Còn một cách nữa, đấu thêm một ván nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100107
					],
					"speakerTitle": "Người Gỗ Bùng Nổ"
				},
				{
					"id": 755100107,
					"content": "Vậy thì thêm ván nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100108,
						755100109
					],
					"speakerTitle": "Quả Thông Nhỏ"
				},
				{
					"id": 755100108,
					"content": "Thật náo nhiệt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755100110
					]
				},
				{
					"id": 755100110,
					"content": "A, là khách hàng mới! Xin chào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100111
					],
					"speakerTitle": "Vigee"
				},
				{
					"id": 755100111,
					"content": "#Nhìn cách ăn mặc của {F#cô}{M#cậu}, chắc là nhà lữ hành nhỉ? Vậy thì chúng ta là đồng nghiệp rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100112
					],
					"speakerTitle": "Vigee"
				},
				{
					"id": 755100112,
					"content": "Có muốn cùng các bạn nhỏ chơi thử trò cuộn dệt tương tác mà tôi mới sáng tạo ra không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100113,
						755100114
					],
					"speakerTitle": "Vigee"
				},
				{
					"id": 755100113,
					"content": "\"Cuộn dệt tương tác\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755100115
					]
				},
				{
					"id": 755100115,
					"content": "Nói đơn giản thì đó là một trò chơi kết hợp giữa kịch cắt giấy của Liyue, truyện tranh của Inazuma và phim ảnh Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100116
					],
					"speakerTitle": "Vigee"
				},
				{
					"id": 755100116,
					"content": "Lấy hình tượng chiến sĩ nổi tiếng ở nơi này làm nguyên mẫu, thêm vào một vài ý tưởng về \"khiêu chiến xuyên giới hạn\", kết hợp thành một câu chuyện mới mẻ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100117
					],
					"speakerTitle": "Vigee"
				},
				{
					"id": 755100117,
					"content": "#Nói không chừng có thể đem đến cho {F#cô}{M#cậu} một trải nghiệm rất mới mẻ đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100118
					],
					"speakerTitle": "Vigee"
				},
				{
					"id": 755100118,
					"content": "Vậy để tôi thử xem sao!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755100119
					]
				},
				{
					"id": 755100119,
					"content": "#Được thôi. Chúc {F#cô}{M#cậu} chơi vui vẻ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vigee"
				},
				{
					"id": 755100114,
					"content": "Là cuộn tranh biết cử động à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755100115
					]
				},
				{
					"id": 755100109,
					"content": "Xảy ra chuyện gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755100110
					]
				}
			]
		},
