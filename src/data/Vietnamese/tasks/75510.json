				{
					"id": 755100210,
					"content": "A, là khách hàng mới! Xin chào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100211
					],
					"speakerTitle": "Vigee"
				},
				{
					"id": 755100211,
					"content": "#Đợi đã, hình như tôi đã thấy qua hình của {F#cô}{M#cậu} trên cuộn vải. {F#Cô}{M#Cậu} là Tumaini mà bọn trẻ sùng bái đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100212
					],
					"speakerTitle": "Vigee"
				},
				{
					"id": 755100212,
					"content": "#Tốt quá rồi, may mắn sao lại gặp được {F#cô}{M#cậu} thế này... Tumaini nổi tiếng, có muốn chơi thử \"cuộn dệt tương tác\" này không?",
					"roleType": "TALK_ROLE_NPC",
