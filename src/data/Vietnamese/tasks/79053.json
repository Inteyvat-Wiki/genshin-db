	"talks": [
		{
			"id": 7905301,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7905301",
							"2"
						],
						"stepId": 7905301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Idyia"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790530101,
					"content": "\"Chào mừng đến với Ảo Cảnh Veluriyam, hy vọng các bạn có thể tạm quên đi sự vất vả của chuyến đi và nghỉ ngơi thật tốt.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790530102
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 790530102,
					"content": "Đáng lẽ nên nói câu chào như vậy lúc gặp mặt lần đầu. Hic, không ngờ lại xảy ra nhiều chuyện đến vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790530103
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 790530103,
					"content": "Nếu như mọi thứ đã khôi phục, vậy thì bù lại bằng câu mở màn này nhé... Sao hả, nghe nghiêm túc lắm đúng không!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790530104,
						790530109,
						790530114,
						790530117
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 790530104,
					"content": "Về Hình Chiếu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790530105
					]
				},
				{
					"id": 790530105,
					"content": "Ơ, muốn tôi giải thích nguyên lý à, thật ra tôi cũng không rõ lắm. Nói chung thì Hình Chiếu giống như một ý tưởng hơn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790530106
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 790530106,
					"content": "Giống như thực vật sinh trưởng như thế nào sớm đã được ghi vào hạt giống, loài chim vỗ cánh ra sao đã được định sẵn trong trứng từ lâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790530107
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 790530107,
					"content": "Sự vật thuận theo đạo lý mà trở thành mọi thứ như ta thấy. Có lẽ ngay từ sự khởi đầu, thiết kế của vạn vật dường như đã được định sẵn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790530108
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 790530108,
					"content": "Hình Chiếu cũng giống như một bản thiết kế, biến thành Ảo Cảnh Veluriyam dưới ánh sáng phản chiếu trong chiếc bình. À, nhưng đây là chuyện chỉ thực hiện được trong chiếc Bình Ma này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Idyia"
				},
				{
					"id": 790530109,
					"content": "Về Tinh Linh Nước Trong...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790530110
					]
				},
				{
					"id": 790530110,
					"content": "À, là đang hỏi tại sao chúng tôi lại bỏ trốn khỏi Fontaine à? Nhớ lại thì giống như câu chuyện của kiếp trước vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790530111
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 790530111,
					"content": "Để nói về lý do trốn thoát, đó là do \"nước\". Nước ở Fontaine đã thay đổi, đối với Tinh Linh Nước Trong mà nói, chắc nước ở nơi đó bây giờ đã tràn ngập... hận thù và khổ đau nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790530112
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 790530112,
					"content": "Với chúng tôi mà nói, nếu muốn tiếp tục sống thì tốt nhất là nên rời bỏ quê hương. Đó cũng là lúc tôi hoảng loạn lạc lối, ngã xuống ở sa mạc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790530113
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 790530113,
					"content": "Sa mạc này thật rộng lớn đối với tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Idyia"
				},
				{
					"id": 790530114,
					"content": "Về Rhodeia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790530115
					]
				},
				{
					"id": 790530115,
					"content": "Ồ, chị Rhodeia sao? Hửm, mà bạn đã từng gặp chị ấy hả?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790530116
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 790530116,
					"content": "Xem ra chị ấy đã tìm được nơi thuộc về mình... Khinh Sách Trang là ở Liyue phải không? Đúng là một nơi xa nhỉ... chị Rhodeia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Idyia"
				},
				{
					"id": 790530117,
					"content": "Phải cố gắng lên nhé!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790530118
					]
				},
				{
					"id": 790530118,
					"content": "Ừm, tôi sẽ... cố gắng! Cũng chúc bạn tận hưởng được không khí mát mẻ nơi đây. Rất hiếm khi tìm được một nơi như vậy ở sa mạc đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Idyia"
				}
			]
		},
		{
			"id": 7905313,
			"completionStepIds": [
				7905302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
