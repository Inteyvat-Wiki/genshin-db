			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Idyia"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790531301,
					"content": "Idyia, có tình huống khẩn cấp này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790531302,
					"content": "Chúng tôi đã tìm thấy chiếc đồng hồ! Đây có phải là chiếc đồng hồ Mora trong truyền thuyết không!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531303,
						790531304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790531303,
					"content": "Bề ngoài đúng là lấp lánh!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790531305
					]
				},
				{
					"id": 790531305,
					"content": "Ồ? Để tôi xem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531306
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 790531306,
					"content": "Không ngờ các bạn lại tìm thấy! Không lẽ tất cả đều do định mệnh sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531307
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 790531307,
					"content": "Nhà thám hiểm thần kỳ để lại một bất ngờ vô giá, và được Nhà Lữ Hành huyền thoại tìm thấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531308
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 790531308,
					"content": "Tôi dường như cảm thấy có sự... kế thừa tinh thần nào đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531309
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 790531309,
					"content": "Cô khen như vậy tôi vui lắm, nhưng giờ tôi thấy tò mò về chuyện đã xảy ra hơn đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531310,
						790531311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790531310,
					"content": "Sẽ có thêm phần thưởng khác sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790531312
					]
				},
				{
					"id": 790531312,
					"content": "Không phải....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531313
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 790531313,
					"content": "Tôi chưa từng nghĩ là sẽ có người tìm ra chiếc đồng hồ này... Đến bản thân tôi còn quên mất nó được chôn ở đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531314
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 790531314,
					"content": "Nhưng bản thân nó rất có giá trị đúng không? Vậy là không cần tôi phải thưởng thêm cho các bạn nữa rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531315
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 790531315,
					"content": "Tóm lại thì tôi phải nhớ chuyện này, để sau này kể lại cho những vị khách khác nghe một cách sống động.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531316
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 790531316,
					"content": "Sau này, kho báu mà các bạn chôn giấu sẽ thay thế cho chiếc đồng hồ Mora này rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531317
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 790531317,
					"content": "Cũng đúng, như chúng ta đã nói, quan trọng là câu chuyện mà kho báu cất giữ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790531318,
					"content": "#Tóm lại, chúng ta nghiên cứu thêm về chiếc đồng hồ này đi, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790531319,
					"content": "Idyia, viết câu chuyện của chúng tôi cho thật xuất sắc nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790531320,
					"content": "Yên tâm, cứ giao cho tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Idyia"
				},
				{
					"id": 790531311,
					"content": "Sẽ kích hoạt sự kiện ẩn sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790531312
					]
				},
				{
					"id": 790531304,
					"content": "Lớp vỏ còn có hoa văn Mora nữa!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790531305
					]
				}
			]
		},
		{
			"id": 7905314,
