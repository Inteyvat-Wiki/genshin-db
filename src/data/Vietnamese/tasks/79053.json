			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Idyia"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790531401,
					"content": "Là hai vị à! Thế nào, trông như có chuyện muốn hỏi nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531402
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 790531402,
					"content": "Nếu là chuyện liên quan đến Ảo Cảnh Veluriyam thì cứ hỏi tôi. Với tôi thì nơi này như những vệt nước nhăn trên tay mình vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531403,
						790531405
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 790531403,
					"content": "Vệt nước nhăn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790531404
					]
				},
				{
					"id": 790531404,
					"content": "Đó chỉ là phép ẩn dụ thôi! Tôi còn lâu mới có nếp nhăn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531407
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 790531407,
					"content": "Tóm lại thì chúng tôi đã nhặt được một bức thư trong công viên!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790531408,
					"content": "Idyia chắc sẽ biết thứ này từ đâu tới nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790531409,
					"content": "Đương nhiên rồi, bức thư này nhìn là biết... Ấy, tôi lần đầu tiên nhìn thấy bức thư này đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531410
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 790531410,
					"content": "Vệt nước trên tay cô mờ nhạt dần rồi đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790531411,
					"content": "Cái này... là ai đó nhân lúc tôi không chú ý đã lén chôn xuống thôi, nên tôi không biết cũng bình thường mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531412
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 790531412,
					"content": "Hơn nữa, xem nội dung thì nó giống di thư và ghi chép hơn là một bức thư. Rốt cuộc là ai nhỉ, giọng văn có chút quen thuộc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531413
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 790531413,
					"content": "Xem ra có liên quan tới \"Hộp Shinrou\" nhỉ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790531414
					]
				},
				{
					"id": 790531414,
					"content": "À! Tôi nhớ ra rồi, Hộp Shinrou là do một ông lão để lại... Khi đó là lúc tôi mới tới chiếc bình này chưa lâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531415
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 790531415,
					"content": "Ông lão đó là người Inazuma, vừa vào đã hỏi đây có phải là bí cảnh thực hiện nguyện vọng của mọi người không, và nhờ tôi đưa ông ấy quay về chiến trường cũ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531416
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 790531416,
					"content": "Tôi có giải thích cho ông ấy, nhưng mà... lúc vào bí cảnh thì thể trạng ông ấy rất xấu. Lặn lội đường xa, tinh thần cũng đã như ngọn đèn dầu sắp cạn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531417
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 790531417,
					"content": "Liên tục nói \"làm ơn đưa tôi quay về ngày đó...\" với \"hãy đưa tôi về trận chiến đó...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531418
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 790531418,
					"content": "Nên tôi đã dùng ảo cảnh mô phỏng lại chiến trường trong tưởng tượng của ông ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531419
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 790531419,
					"content": "À, vậy nên trong thư viết \"cuối cùng cũng đã về lại nơi đây\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790531420,
					"content": "Đại khái là khi tỉnh lại, phát hiện xung quanh trở lại thành chiến trường trong ký ức. Chiến trường đáng sợ lắm, nhưng ông ấy thì lại cười rất tươi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531421
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 790531421,
					"content": "Sao lại có người muốn nhìn thấy khung cảnh đáng sợ đó vào cuối đời chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531422,
						790531423
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 790531422,
					"content": "Chắc là có ý nghĩa khác đối với ông ấy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790531424
					]
				},
				{
					"id": 790531424,
					"content": "Tôi cũng không hiểu lắm, nhưng ông ấy có vẻ như rất mãn nguyện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531425
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 790531425,
					"content": "Nếu có một nguyện vọng mà ông ấy phải thực hiện ở một nơi như thế, thì những năm tháng gánh vác nguyện vọng chắc hẳn rất đau khổ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531426
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 790531426,
					"content": "Hộp Shinrou đã giúp đỡ không ít trong việc vận hành Vòng Trung Tâm, nên tôi cũng nên nói lời cảm ơn ông Hideie rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Idyia"
				},
				{
					"id": 790531423,
					"content": "Có lẽ như vậy sẽ thú vị hơn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790531424
					]
				},
				{
					"id": 790531405,
					"content": "Thật sao, cho tôi xem nào!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790531406
					]
				},
				{
					"id": 790531406,
					"content": "Chỉ là một phép ẩn dụ thôi. Cũng giống như đường chỉ tay thôi mà, đâu có gì đáng xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531407
					],
					"speakerTitle": "Idyia"
				}
			]
		}
	]
}