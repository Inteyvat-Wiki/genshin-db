						111120215
					],
					"speakerTitle": "Wu"
				},
				{
					"id": 111120215,
					"content": "Nếu giúp tôi tìm một ít Ớt Tuyệt Vân về đây, tôi sẽ làm một phần cho các bạn.",
					"roleType": "TALK_ROLE_NPC",
