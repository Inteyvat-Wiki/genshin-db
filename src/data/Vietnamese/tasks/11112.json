			},
			"dialogs": [
				{
					"id": 111120201,
					"content": "Xin chào, bạn còn nhớ chúng tôi chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120202,
					"content": "Xin lỗi, tôi thật sự không cần dịch vụ của Vãng Sinh Đường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120203,
						111120204
					],
					"speakerTitle": "Wu"
				},
				{
					"id": 111120203,
					"content": "Chúng tôi đã biết chuyện của Lão Meng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120205
					]
				},
				{
					"id": 111120205,
					"content": "Ừ, tôi và Lão Meng cùng nhau lớn lên, đến bây giờ vẫn thường xuyên giữ liên lạc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120206
					],
					"speakerTitle": "Wu"
				},
				{
					"id": 111120206,
					"content": "Tôi không biết vì sao bạn ấy lại đến Vãng Sinh Đường, nói thật, tôi cảm thấy đường chủ ở đó là một người rất cổ quái.",
