			},
			"dialogs": [
				{
					"id": 111120101,
					"content": "Việc đến nước này, tôi thực sự không thể hiểu nổi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120102,
						111120103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120102,
					"content": "Không ngờ có thể tìm được Big G như vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120104
					]
				},
				{
					"id": 111120104,
					"content": "Việc này giống như tôi nghĩ, có nhớ những gì tôi nói trước đó không? Trên thế gian này làm gì có nhiều ác quỷ như thế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120105
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111120105,
					"content": "Anh ấy vì một lý do gì đó mà thoát ra khỏi Dốc Vô Vọng, sau đó cũng vì một lý do gì đó mà không trở về được nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120106
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111120106,
					"content": "Lời giải thích này nghe có vẻ miễn cưỡng thật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120107,
					"content": "Thực ra... cũng gần giống như cô ấy nói vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120108
					],
					"speakerTitle": "Big G"
				},
				{
					"id": 111120108,
					"content": "Hở?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120109,
					"content": "Này, đừng nghi ngờ khả năng làm việc của tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120110
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111120110,
					"content": "Tôi chỉ muốn biết bạn bè của tôi hiện giờ sống như thế nào, nên tôi muốn đến Liyue xem thử.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120111
					],
					"speakerTitle": "Big G"
				},
				{
					"id": 111120111,
					"content": "Tôi thề là tôi chưa từng nghĩ đến chuyện hù dọa ai cả! Cũng chưa từng làm hại ai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120112
					],
					"speakerTitle": "Big G"
				},
				{
					"id": 111120112,
					"content": "Mấy ngày trước có vài người đến Dốc Vô Vọng thi gan, nghe nói họ đến từ Liyue nên tôi đã đi theo một trong số họ đến đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120113
					],
					"speakerTitle": "Big G"
				},
				{
					"id": 111120113,
					"content": "Đó là Luocheng đúng không, tuy anh ấy không nhìn thấy được, nhưng nhất định có cảm giác bị theo dõi, vì thế nên mới gặp phải ác mộng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120114
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111120114,
					"content": "Vậy, tôi đã bị phát hiện rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120115
					],
					"speakerTitle": "Big G"
				},
				{
					"id": 111120115,
					"content": "Nếu không cũng không bị dọa đến mức này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120116
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111120116,
					"content": "Vậy sao không trực tiếp tìm Lão Meng chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120117
					]
				},
				{
					"id": 111120117,
					"content": "Đúng vậy, làm cho Lão Meng đi tìm bạn khắp nơi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120118,
					"content": "Cái này, thực ra là do tôi không tìm được họ. Từ khi tôi đến Liyue thì tôi đã bị lạc đường rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120119
					],
					"speakerTitle": "Big G"
				},
				{
					"id": 111120119,
					"content": "Đúng rồi, nói ra mới nhớ Big G lúc nhỏ bị mù đường. Nếu không có tôi dẫn đường thì bạn ấy sẽ không dám tự mình xuống núi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120120
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111120120,
					"content": "Vậy tất cả những điều này chỉ là vì bạn bị lạc sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120121,
					"content": "Nhưng mà các linh hồn đều có thể bay mà, chỉ cần bay lên là tìm được đường thôi không phải sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120122,
					"content": "Tôi, tôi không dám ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120123
					],
					"speakerTitle": "Big G"
				},
				{
					"id": 111120123,
					"content": "Cao quá, tôi sẽ sợ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120124
					],
					"speakerTitle": "Big G"
				},
				{
					"id": 111120124,
					"content": "Đúng rồi, Big G hồi nhỏ không dám đứng từ trên núi nhìn xuống.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120125
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111120125,
					"content": "Ha ha ha, bạn đúng là không thay đổi gì cả!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120126,
						111120127
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111120126,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120128
					]
				},
				{
					"id": 111120128,
					"content": "Tôi biết tôi không nên xuất hiện trước mặt người khác, nhưng cư dân trong Liyue đông quá, nên tôi chỉ biết tìm chỗ nấp mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120129
					],
					"speakerTitle": "Big G"
				},
				{
					"id": 111120129,
					"content": "Cho đến khi bị Địa Mạch Trấn Thạch thu hút mới có thể tìm thấy mọi người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120130
					],
					"speakerTitle": "Big G"
				},
				{
					"id": 111120130,
					"content": "Vậy là bạn không bị biến thành ác quỷ, thật tốt quá ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120131
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111120131,
					"content": "Đã nói hãy tin vào sự chuyên nghiệp của tôi mà, giờ chỉ cần dẫn người này về Dốc Vô Vọng thì mọi chuyện sẽ được giải quyết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120132
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111120132,
					"content": "Nhưng mà, bạn ấy nói muốn đến thăm bạn bè, vậy thì còn ba người là Wu, Mumu với Congzi nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120133
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111120133,
					"content": "Vậy thì chúng ta hoàn thành tâm nguyện của bạn ấy vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120134
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111120134,
					"content": "Tôi và Lão Meng đưa Big G về Dốc Vô Vọng, bạn hãy đi tìm tín vật của ba người kia đi, sau đó đến tìm tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120135
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111120135,
					"content": "Đều là bạn bè cả mà, trực tiếp gọi họ đến không phải tốt hơn sao? Hoặc là dẫn Big G đến gặp họ luôn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120136,
					"content": "...Vậy không tốt cho lắm, tôi e rằng họ sẽ sợ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120137
					],
					"speakerTitle": "Big G"
				},
				{
					"id": 111120137,
					"content": "Tôi không muốn người thường trở nên nghi thần nghi quỷ. Chuyện không nên biết thì tốt nhất không biết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120138
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111120138,
					"content": "Cho nên, bạn cũng cần chú ý cách lấy tín vật nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111120127,
					"content": "Hay là đừng gọi \"Big G\" nữa nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120128
					]
				},
				{
					"id": 111120103,
					"content": "Big G không phải ác quỷ sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120104
					]
				}
			]
		},
		{
			"id": 1111202,
			"completionStepIds": [
				1111202
