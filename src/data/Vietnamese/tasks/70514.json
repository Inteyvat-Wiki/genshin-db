			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Félix Yogue",
					"Swan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705140101,
					"content": "Sự nhiệt tình của Mondstadt đúng là vượt ngoài sức tưởng tượng... Quả là danh bất hư truyền, ngay cả những Hilichurl cũng tràn đầy sức sống.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140102
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140102,
					"content": "Dù sao thì... thưa ngài Yogue, ngài đừng ra ngoài một mình nữa nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140103
					],
					"speakerTitle": "Swan"
				},
				{
					"id": 705140103,
					"content": "Gì chứ? Vậy mấy cái máy của tôi phải làm sao đây, còn thiếu... chậc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140104
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140104,
					"content": "1, 2, 3... 18... 19... bộ phận lận đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140105
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140105,
					"content": "Đã có những Nhà Mạo Hiểm giúp ngài đi tìm rồi, ngài cứ yên tâm chờ đợi trong thành đi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140106
					],
					"speakerTitle": "Swan"
				},
				{
					"id": 705140106,
					"content": "Nhưng nếu không có những cái máy đó thì cảm hứng... cảm hứng của tôi, anh biết không? Cảm hứng của tôi nếu tràn đến thì phải làm sao đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140107
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140107,
					"content": "Cảm hứng chỉ lướt thoáng qua thôi... giống như... giống như sau khi uống rượu ợ một cái, chỉ thoáng qua vậy đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140108
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140108,
					"content": "Hmm, ví dụ này rất hay, tôi sẽ ghi lại nó, Xavier nhất định sẽ thích...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140109
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140109,
					"content": "Tôi... ngài...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140110
					],
					"speakerTitle": "Swan"
				},
				{
					"id": 705140110,
					"content": "Ơ? Kỵ Sĩ Danh Dự... quá tốt rồi, là Kỵ Sĩ Danh Dự! Mau đến đây giúp tôi với!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140111,
						705140112
					],
					"speakerTitle": "Swan"
				},
				{
					"id": 705140111,
					"content": "Chuyện gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705140113
					]
				},
				{
					"id": 705140113,
					"content": "Để tôi giới thiệu, vị này đến từ Fontaine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140114
					],
					"speakerTitle": "Swan"
				},
				{
					"id": 705140114,
					"content": "Một Nhà Mơ Mộng! Chúng tôi tự gọi mình như thế!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140115
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140115,
					"content": "...Ngài Yogue, đây là Kỵ Sĩ Danh Dự của Thành Mondstadt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140116
					],
					"speakerTitle": "Swan"
				},
				{
					"id": 705140116,
					"content": "#Yogue, Félix Yogue! Xin kính chào {F#cô}{M#cậu}, Kỵ Sĩ Danh Dự! Tôi đã nghe rất nhiều câu chuyện về {F#cô}{M#cậu}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140117
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140117,
					"content": "Anh biết tôi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705140118
					]
				},
				{
					"id": 705140118,
					"content": "#Tất nhiên, tất nhiên rồi! Tôi đương nhiên là biết {F#cô}{M#cậu} rồi, ai mà lại không biết {F#cô}{M#cậu} chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140119
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140119,
					"content": "#Sự tích về trận chiến trước đây của {F#cô}{M#cậu} với Phong Long ở Thành Mondstadt đã chiếm lĩnh tiêu đề của \"Tờ báo Chim Hơi Nước\" suốt ba tuần liền đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140120
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140120,
					"content": "#Hahaha, nếu đám phóng viên đó biết được tôi đang nói chuyện với {F#cô}{M#cậu}, nhất định sẽ ghen tị đến mức không ngủ được mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140121,
						705140124
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140121,
					"content": "\"Tờ báo Chim Hơi Nước\" là gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705140122
					]
				},
				{
					"id": 705140122,
					"content": "#{F#Cô}{M#Cậu} không biết sao? \"Tờ báo Chim Hơi Nước\" là một tòa... ừm... một tòa soạn có độ nổi tiếng rất cao ở Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140123
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140123,
					"content": "#Còn {F#cô}{M#cậu}, đã giúp họ lấy được doanh số cao nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140125
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140125,
					"content": "Tiêu, tiêu đề?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705140126
					]
				},
				{
					"id": 705140126,
					"content": "#Đương nhiên, {F#cô}{M#cậu} đã giúp họ đạt được doanh số cao nhất đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140127
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140127,
					"content": "Tiêu đề trang nhất, chiếm cả trang dài, phỏng vấn chuyên gia, còn có cả tranh minh họa vẽ tay đẹp nhất, haha! Họ kiếm tiền điên cuồng luôn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140128
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140128,
					"content": "Vậy, Nhà Lữ Hành, ngài Félix Yogue, hai người cứ nói chuyện trước nhé. Tôi... ờm... tôi đi xử lý mấy chuyện khác trước, thứ lỗi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140129
					],
					"speakerTitle": "Swan"
				},
				{
					"id": 705140129,
					"content": "Swan nhanh chóng rời đi...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						705140130
					]
				},
				{
					"id": 705140130,
					"content": "Được thôi, xem ra Đội Kỵ Sĩ Tây Phong giống như những gì tôi nghe được, họ đang có nhiệm vụ chưa hoàn thành...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140131
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140131,
					"content": "Vậy, tại sao anh lại đến Mondstadt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705140132
					]
				},
				{
					"id": 705140132,
					"content": "Tôi sao? Thật ra tôi đang có kế hoạch du lịch khắp Teyvat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140133
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140133,
					"content": "Và mục đích của chuyến du lịch chính là để bán \"Lõi Động Cơ\" mà tôi chế tạo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140134
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140134,
					"content": "Nói đơn giản thì đó là một động cơ kiểu dây cót, chỉ cần vặn cót theo từng khoảng thời gian thì cái lõi này sẽ cung cấp động lực trong một thời gian dài.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140135
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140135,
					"content": "Để minh họa cho động cơ này, tôi còn chế tạo ra một món đồ chơi chuyển động vĩnh cửu được điều khiển bởi \"Lõi Động Cơ\", tên nó là \"Tranh Máy Móc Vĩnh Cửu\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140136
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140136,
					"content": "#Khụ... Nhưng thật tiếc, tuy tôi rất muốn cho {F#cô}{M#cậu} xem qua động cơ này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140137
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140137,
					"content": "Nhưng động cơ này thật sự quá xuất sắc, ngay cả ma vật cũng không thể cưỡng lại sức hấp dẫn của nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140138
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140138,
					"content": "Nên bây giờ... bộ máy đó đã bị đám ma vật phân rã thành từng mảnh nhỏ và mang đi chơi rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140139
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140139,
					"content": "Tuy tôi đã nhờ các nhà mạo hiểm giúp đỡ, nhưng đến giờ họ vẫn chưa báo tin gì cho tôi cả...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140140
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140140,
					"content": "#Kỵ Sĩ Danh Dự, nếu {F#cô}{M#cậu} có hứng thú, có thể giúp tôi việc này không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140141
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140141,
					"content": "#Hãy tin tôi, bộ máy... và thù lao của tôi chắc chắn sẽ không làm {F#cô}{M#cậu} thất vọng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140142
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140142,
					"content": "Cứ giao cho tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705140143
					]
				},
				{
					"id": 705140143,
					"content": "#Quá tuyệt vời, {F#cô}{M#cậu} quả nhiên giống như những gì trên báo nói, là một nhà mạo hiểm mạnh mẽ và giàu lòng trắc ẩn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140144
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140144,
					"content": "Nhưng tiếc là chúng ta đang ở Mondstadt, chứ nếu như đang ở Fontaine thì tôi nhất định sẽ dẫn một phóng viên của \"Tờ báo Chim Hơi Nước\" đến phỏng vấn độc quyền ngay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140145
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140145,
					"content": "#Họ chắc chắn sẽ lại bị khuất phục trước sức hấp dẫn của {F#cô}{M#cậu}, và sẽ tình nguyện chừa lại trang nhất và tiền thù lao của cả ba tuần cho {F#cô}{M#cậu}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140124,
					"content": "Tiêu đề trang nhất, chiếm cả trang dài, phỏng vấn chuyên gia, còn có cả tranh minh họa vẽ tay đẹp nhất, haha! Họ kiếm tiền điên cuồng luôn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140125
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140112,
					"content": "Xảy ra chuyện gì rồi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705140113
					]
				}
			]
		},
