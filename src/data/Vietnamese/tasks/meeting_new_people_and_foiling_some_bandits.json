			},
			"dialogs": [
				{
					"id": 710410401,
					"content": "Ở đây nè, tiền bối. Khụ khụ... thật không may, cửa bị khóa rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410402
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410402,
					"content": "Phải lấy được hai chìa khóa cùng lúc mới mở được cửa... Haiz, người Liyue ấy mà, toàn đề phòng những thứ không đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410403
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410403,
					"content": "Bớt nói những câu vô ích đi... Nhìn thông báo trên cửa kìa, may mà chúng ta cũng còn biết đạn pháo đang ở bên trong nhà kho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410404
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410404,
					"content": "Đạn là một chuyện, chúng ta còn chưa biết ngòi nổ được bảo quản như thế nào mà? Tôi nghĩ tốt hơn hết là nên tính kế lâu dài.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410405
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410405,
					"content": "Được rồi... Đừng có than nữa. Không làm được gì, chỉ nói xui rủi là hay!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410406
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410406,
					"content": "Hơn nữa tại sao chúng tôi phải nghe lời của một tên Đạo Bảo Đoàn chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410407,
						710410408
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410407,
					"content": "Clitopho nói vậy không phải không có lý...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710410409
					]
				},
				{
					"id": 710410409,
					"content": "Đúng vậy, hai người đừng cãi nhau nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710410410,
					"content": "Hừm... nghe lời tiền bối vậy. Chúng ta tiếp tục đi, nói không chừng chị Jinwu biết phải làm thế nào để mở cửa nhà kho đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410411
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410411,
					"content": "Hơn nữa sau đó, chúng ta vẫn còn phải bận rất nhiều việc... Mở khóa nòng xong còn phải kích hoạt thiết bị tín hiệu nữa mới được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410412
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410412,
					"content": "Nghe chị Jinwu nói, điểm quan sát của chúng ta nên đặt ở nơi cao để nhìn thấy khẩu pháo... Từ đó có thể điều tiết tín hiệu để mở khóa khẩu pháo từ khoảng cách an toàn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410408,
					"content": "Tóm lại, chúng ta phải mở cửa trước đã.",
