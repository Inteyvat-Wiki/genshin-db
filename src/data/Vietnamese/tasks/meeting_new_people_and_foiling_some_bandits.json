			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Clitopho",
					"Paimon",
					"Zhiqiong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710410301,
					"content": "...Chốt khóa chưa hoen gỉ, có vết dầu nhờn... Có vẻ như đã có ai đó bảo dưỡng nó sau khi khu mỏ đóng cửa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410302
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410302,
					"content": "Khóa nòng vẫn còn nguyên... có điều cầu chì vẫn khóa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410303
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410303,
					"content": "Không hiểu... đó là cái gì vậy, thần chú hả?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710410304,
					"content": "Hầm mỏ phía trước đã bị chặn bởi những tảng đá trong lần sơ tán trước đó... Có vẻ như khẩu pháo này sắp có ích rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410305
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410305,
					"content": "Nhưng nếu không có đạn thì pháo cũng vô dụng. Chúng ta phải tìm đạn mới được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410306
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410306,
					"content": "Hừ... đừng nói như kiểu tôi không biết gì vậy, đồ ma lanh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410307
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410307,
					"content": "Gần đây có một nhà kho, chắc ở đó có đạn... Hy vọng lúc sơ tán họ không mang đạn theo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410308
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410308,
					"content": "Chúng ta xuất phát thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710410309
					]
				},
				{
					"id": 710410309,
