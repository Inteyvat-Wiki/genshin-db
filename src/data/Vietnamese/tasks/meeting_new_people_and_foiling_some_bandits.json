			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Clitopho",
					"Zhiqiong",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710410101,
					"content": "Phù... Cảm ơn các vị anh hùng, cảm ơn các vị đã cứu mạng tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410102
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410102,
					"content": "Khoan đã... Tôi nhận ra anh, anh là Toclipho ở trong hầm mỏ đúng không!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410103
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410103,
					"content": "À, không... Không phải tôi, tôi không bán thuốc giả. Tôi là Clitopho, Clitopho không bán thuốc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410104
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410104,
					"content": "Thì ra anh bán thuốc giả hả?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710410105
					]
				},
				{
					"id": 710410105,
					"content": "Không phải... Sao có thể chứ! Thuốc Hảo Hán mà tôi bán đều là thuốc chính hãng! Nhìn xem, những người thợ mỏ uống vào cũng rất tỉnh táo mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410106
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410106,
					"content": "Anh không phải Clitopho không bán thuốc sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410107
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410107,
					"content": "À... Đúng, đó là sau khi sự nghiệp bán thuốc của tôi kết thúc... Bởi vì cái tên... đúng, cũng tại tên Toclipho kia, lấy tên giả để lừa đảo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410108
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410108,
					"content": "Hắn dùng tên giả bán thuốc giả, làm mất uy tín của tôi! Nên từ đó về sau tôi thề sẽ không bán thuốc nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410109
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410109,
					"content": "Kết quả là vừa mới chuyển nghề không bao lâu, thì đã bị những tên trộm của Đạo Bảo Đoàn bắt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410110
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410110,
					"content": "Nói như vậy, kẻ bán thuốc giả thật đáng ghét...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410111
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410111,
					"content": "Đúng đó đúng đó, ngay cả người cùng ngành cùng nghề mà cũng dám gạt, đúng là xấu xa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710410112,
					"content": "Tên giả của Toclipho là gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710410113
					]
				},
				{
					"id": 710410113,
					"content": "Clitopho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410114
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410114,
					"content": "...À, không phải... Clitopho không phải tên giả, là tên thật...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410115
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410115,
					"content": "Vậy Toclipho là tên giả...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710410116,
					"content": "Không... Là, là hắn sử dụng tên tôi, lấy tên Clitopho làm tên giả, hiểu chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410117
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410117,
					"content": "Ồ... Vậy nên Toclipho trở thành tên thật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710410118,
					"content": "Thật đáng tiếc...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710410119
					]
				},
				{
					"id": 710410119,
					"content": "Đáng tiếc cái gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410120
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410120,
					"content": "Tiếc là anh suýt chút nữa không đánh mà khai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410121
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410121,
					"content": "Chúng ta đưa hắn lên đi, để các đại ca của Thiên Nham Quân hỏi hắn xem chuyện gì đang xảy ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410122
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410122,
					"content": "Hay là chúng ta giải quyết hắn ở đây luôn đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710410123
					]
				},
				{
					"id": 710410123,
					"content": "Hả?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410124
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410124,
					"content": "Nè, đừng có đùa kiểu này nha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410125
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410125,
					"content": "Haha, mắc cười quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710410126,
					"content": "Cười gì chứ! Chuyện này chẳng buồn cười xíu nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410127,
						710410130
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410127,
					"content": "Đúng là không buồn cười, bởi vì chúng tôi làm thật.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710410128
					]
				},
				{
					"id": 710410128,
					"content": "Tiền bối, hãy bình tĩnh, bây giờ không phải là lúc thẩm vấn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410129
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410129,
					"content": "Tôi không muốn vác một tên Đạo Bảo Đoàn bị dọa xỉu chạy tới chạy lui đâu... Nói gì thì nói, đưa hắn về doanh trại trước đã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410131
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410131,
					"content": "Khoan đã, tôi rất có ích đó! Hãy đưa tôi đi thám hiểm cùng đi! Dù sao thì... tôi cũng bị Đạo Bảo Đoàn đuổi đi rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410132
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410132,
					"content": "Dù sao bây giờ tôi cũng được xem là... trong sạch mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410133
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410133,
					"content": "Thì ra như vậy gọi là trong sạch à...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710410134,
					"content": "Anh biết những gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410135
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410135,
					"content": "Ừm... Ví dụ như... điều chế thuốc nổ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410136
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410136,
					"content": "Hay là thuốc giả?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710410137,
					"content": "Là thuốc nổ, không phải thuốc giả.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710410138
					]
				},
				{
					"id": 710410138,
					"content": "Hay là thuốc nổ giả?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410139
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410139,
					"content": "Lần này là thật!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410140
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410140,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410141
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410141,
					"content": "...Tôi không có quyền cho anh vào đội, về việc xử lý anh ra sao sẽ do chị Jinwu quyết định. Nhưng tôi nghĩ chắc là giao cho Thiên Nham Quân rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410142
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410142,
					"content": "Nhưng bọn tôi sẽ để mắt đến anh. Người của Đạo Bảo Đoàn, dù thế nào cũng cảm thấy không đáng tin cậy. Chưa kể còn bán thuốc giả nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410143
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410143,
					"content": "Đã nói tôi không bán thuốc giả rồi mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410144
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410144,
					"content": "Rồi rồi biết rồi! Chúng ta mau đi thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710410130,
					"content": "Rất có lý.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710410131
					]
				}
			]
		},
		{
			"id": 7104103,
			"completionStepIds": [
				7104109
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
