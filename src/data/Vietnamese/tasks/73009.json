				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730090101,
					"content": "Arana sẽ chăm sóc cô ấy. Vì cô ấy là người bạn quan trọng nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090102
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730090102,
					"content": "#Nara {NICKNAME}, mời bạn tới \"Vanarana\", hát vang \"Giai Điệu Giấc Mơ\". Sau đó xin họ hỗ trợ chuẩn bị \"Bija\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090103,
						730090104
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730090103,
					"content": "Nghe không hiểu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730090106
					]
				},
				{
					"id": 730090106,
					"content": "Cũng như áng mây sẽ biết phải cho mưa rơi xuống, mưa sẽ biết mình phải rơi xuống mặt đất. Hạt giống sẽ biết phát triển, vươn mình lên cao, mọc ra những quả trái cây căng mọng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arana"
				},
				{
					"id": 730090104,
					"content": "Tôi, tôi biết rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730090105
					]
				},
				{
					"id": 730090105,
					"content": "#Nara {NICKNAME}, xem ra không hiểu lắm, nhưng không thành vấn đề. Vào lúc quan trọng, Nara {NICKNAME} sẽ biết phải làm gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090106
					],
					"speakerTitle": "Arana"
				}
			]
		},
		{
			"id": 7300902,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
