						730091402
					]
				},
				{
					"id": 730091402,
					"content": "Đó là chuyện từ lâu lắm rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091403
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730091403,
					"content": "Ngày xưa, Aranara du hành trên trái đất, kết bạn với Nara và vạn vật, và trong rừng cũng không có Marana. Cho đến khi xảy ra một thảm họa cách đây rất nhiều mặt trăng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091404
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730091404,
					"content": "Rất nhiều người quay về Sarva, còn Marana bắt đầu tàn phá mặt đất. Đến khi khu rừng có lại được sự sống, vì để bảo vệ bản thân, Aranara đã giấu Vanarana thực thụ vào trong giấc mơ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091405
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730091405,
					"content": "Rừng vốn không biết cái chết là gì. Cho đến một ngày, cây nhớ lại mặt đất đầy hoa héo tàn và muôn thú chết chóc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091406
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730091406,
					"content": "Cũng trong ngày hôm đó, mặt đất nhớ lại rằng mình đã từng hoặc sắp nuốt lấy dòng máu độc đen tối. Dòng sông nhớ lại thế giới màu đỏ, nơi mặt trời lặn xuống và làm bốc hơi cạn nước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091407
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730091407,
					"content": "Họ đã hiểu rằng, vạn vật đều khó tránh khỏi cái chết. Lúc này, \"Marana\" đã ra đời. Đây là tên của \"thần chết\", những ai biết đến sự tồn tại của nó, cuối cùng sẽ chết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091408
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730091408,
					"content": "Sức mạnh của Marana là khiến mọi thứ đi vào chỗ chết. Và những thứ cao lớn, đen tối, vặn vẹo chính là hóa thân mà Marana lựa chọn, là sứ giả mang đến cái chết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091409
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730091409,
					"content": "Tất nhiên rồi, trong câu chuyện của già đây, hình dạng hóa thân của Marana bất định. Có thể là một con thú, cũng có thể là loài chim, có thể là Nara, cũng có thể là dịch bệnh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091410
