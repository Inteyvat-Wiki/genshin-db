			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 730090301,
					"content": "(Rana vẫn đang ngủ say. Arana cũng không có ở đây.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090302
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730090302,
					"content": "(Giữa \"bong bóng\" bao vây Rana dường như có cảnh tượng gì đó xuất hiện...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090303,
						730090307
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730090303,
					"content": "(Đắm chìm vào trong cảnh tượng...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730090304
					]
				},
				{
					"id": 730090304,
					"content": "Bạn ở giữa rừng cây, tất cả đều vô cùng khổng lồ, lại vô cùng tĩnh lặng. Nhưng bạn lại vô cùng tự tại.\\nÁnh sáng thỉnh thoảng xuyên qua tán lá lấp lánh như ánh vàng, tiếng cười vui từ những ngọn cỏ dại cao ngang ngửa bạn, lúc bạn đi ngang qua còn nhẹ nhàng mơn trớn bàn tay bạn.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730090305
					]
				},
				{
					"id": 730090305,
					"content": "Lắng nghe bản hòa tấu ngân nga của cây cối xào xạc xen lẫn tiếng nước róc rách, bạn bỗng nghe thấy một tiếng khóc. Lần theo âm thanh, bạn tìm được một bóng hình nhỏ bé.\\nDường như khóc đến mệt lả, cô ấy nằm rạp ngủ trên bãi cỏ. Bạn đi tới bên cạnh cô ấy, nhẹ nhàng hát vang khúc ca có thể khiến sinh linh cảm thấy yên bình...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730090306
					]
				},
				{
					"id": 730090306,
					"content": "(...Hình như tình trạng của Rana không bị xấu đi.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rana"
				},
				{
					"id": 730090307,
					"content": "(Im lặng rời đi.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
