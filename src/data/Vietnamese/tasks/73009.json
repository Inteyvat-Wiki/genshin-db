				"points": []
			},
			"dialogs": [
				{
					"id": 730091301,
					"content": "#Già này còn được tham gia Lễ Hội Utsava, đều là nhờ có Nara {NICKNAME} và Paimon. Cảm ơn mọi người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091302
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730091302,
					"content": "Già rất tiếc vì không thể nào cùng mọi người ra ngoài mạo hiểm như Arama bọn họ, cũng không giúp được gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091303
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730091303,
					"content": "Nhưng giấc mơ này sẽ luôn chào đón mọi người. Nếu ở thế giới bên ngoài cảm thấy mệt quá rồi, thì hãy đến Vanarana nhé.",
					"roleType": "TALK_ROLE_NPC",
