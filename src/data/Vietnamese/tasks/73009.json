						730090202,
						730090203
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730090202,
					"content": "(Phải giúp Rana khôi phục sớm một chút mới được...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 730090203,
					"content": "(Lặng lẽ rời đi thôi.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
