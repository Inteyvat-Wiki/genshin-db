			"dialogs": [
				{
					"id": 730090901,
					"content": "Về \"Marana\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730090902
					]
				},
				{
					"id": 730090902,
					"content": "Đó là chuyện rất lâu về trước...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090903
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730090903,
					"content": "Trước đây, Aranara đi trên vùng đất này, đã kết bạn với Nara và vạn vật, mà trong rừng không hề có Marana. Mãi cho đến khi xảy ra thảm họa, có lẽ cách đây rất nhiều rất nhiều mặt trăng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090904
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730090904,
					"content": "Đại Vương Rukkhadevata trở về Sarva, Marana bắt đầu tàn sát bừa bãi trên mặt đất. Sau khi rừng cây khôi phục lại sự sống, Aranara liền giấu Vanarana thật vào trong mơ để bảo vệ bản thân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090905
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730090905,
					"content": "Rừng sâu vốn không biết cái chết là gì. Cho đến một ngày, cây đã nhớ ra cảnh tượng hoa tàn, xác thú chất đầy đất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090906
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730090906,
					"content": "Cũng cùng ngày ấy, mặt đất đã nhớ ra bản thân từng hoặc sắp bị máu độc đen tối nuốt chửng. Dòng sông thì nhớ tới hoàng hôn, thế giới nhuộm màu đỏ đã làm bốc hơi toàn bộ nguồn nước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090907
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730090907,
					"content": "Họ hiểu ra rồi, vạn vật đều không tránh khỏi cái chết. Lúc này, \"Marana\" ra đời. Đây là tên của \"cái chết\", những ai biết đến sự tồn tại của nó rồi cũng sẽ chết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090908
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730090908,
					"content": "Sức mạnh của Marana khiến mọi thứ chết đi. Thứ cao lớn, âm u, vặn vẹo đó chính là hóa thân mà Marana đã chọn, sứ đồ mang đến cái chết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090909
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730090909,
					"content": "Tất nhiên rồi, trong câu chuyện của già đây, hình dạng hóa thân của Marana bất định. Có thể là một con thú. Cũng có thể là loài chim. Có thể là Nara. Cũng có thể là dịch bệnh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090910
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730090910,
					"content": "Dù sao thì câu chuyện chỉ là câu chuyện thôi, đó đã không phải là ký ức của già nữa rồi.",
					"roleType": "TALK_ROLE_NPC",
