			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Félix Yogue"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705150201,
					"content": "#Hoàn hảo, quá đẹp! Khả năng hiểu biết và hành động của {F#cô}{M#cậu} rất tuyệt, vượt ra ngoài sự mong đợi của tôi luôn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150202
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150202,
					"content": "#À, \"tờ báo Chim Hơi Nước\" còn có mấy bài rất hoang đường mô tả {F#cô}{M#cậu} như một... một...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150203,
						705150204
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150203,
					"content": "Một...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705150205
					]
				},
				{
					"id": 705150205,
					"content": "Hờ... haha... một người dũng cảm... thích dùng... kiếm để thuyết phục người khác...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150206
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150206,
					"content": "#Hoang đường, ngu ngốc! Đám phóng viên viết những bài này đúng là muốn vô cớ sinh sự mà! {F#Cô}{M#Cậu} rõ ràng là một dũng sĩ nhanh nhẹn, thông minh, khiêm tốn... mà lại hào sảng nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150207
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150207,
					"content": "Đợi khi tôi rảnh, tôi nhất định sẽ viết một bức thư để phản bác họ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150208
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150208,
					"content": "#À mà {F#cô}{M#cậu} hãy nhận lấy bộ máy này nhé, khi chán thì {F#cô}{M#cậu} có thể dùng nó để giải sầu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150209
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150209,
					"content": "Còn tôi thì... ờm... tôi phải bắt đầu gây quỹ tài trợ cho chuyến du lịch đến Liyue rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150204,
					"content": "Anh cứ nói đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705150205
					]
				}
			]
		},
