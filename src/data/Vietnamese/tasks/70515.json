			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Félix Yogue"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705150101,
					"content": "Tuyệt vời! Tổng cộng sáu bộ \"Tranh Máy Móc Vĩnh Cửu\" đã được phục chế! Tiếp theo, chúng ta chỉ cần ghép chúng lại với nhau thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150102
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150102,
					"content": "Ghép... ghép lại với nhau sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705150103
					]
				},
				{
					"id": 705150103,
					"content": "Đương nhiên rồi, 6 bộ Tranh Máy Móc Vĩnh Cửu cỡ nhỏ này còn có thể ghép lại tiếp được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150104
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150104,
					"content": "Ghép thành một bức... khổng lồ! Một bức Tranh Máy Móc Vĩnh Cửu cỡ lớn... tuyệt đẹp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150105
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150105,
					"content": "Đến đây nào, tiếp theo chúng ta chỉ cần ghép chúng lại là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150106,
						705150107
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150106,
					"content": "Có cần thêm nhiên liệu gì không...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705150108
					]
				},
				{
					"id": 705150108,
					"content": "Không, không không không không, hoàn toàn không, bộ máy của tôi không phải đống rác kim loại được ghép với nhau một cách vụng về như thế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150109
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150109,
					"content": "Từng linh kiện đều được ghép một cách khéo léo và gọn gàng, giống như... ờm... như...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150110
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150110,
					"content": "Thôi bỏ đi, tôi không giỏi làm mấy phép so sánh kiểu này, Xavier đã đánh cắp mọi cảm hứng về mặt ngôn ngữ của tôi rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150111
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150111,
					"content": "#Tóm lại, mời {F#cô}{M#cậu} tự mình thử xem nhé, cứ tin tôi, nó sẽ rất thú vị đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150107,
					"content": "Có cần thêm công nghệ gì không...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705150108
					]
				}
			]
		},
		{
			"id": 7051502,
			"completionStepIds": [
				7051503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
