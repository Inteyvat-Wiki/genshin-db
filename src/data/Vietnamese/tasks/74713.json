				]
			},
			"dialogs": [
				{
					"id": 747130101,
					"content": "#Đã lâu không gặp đấy, {NICKNAME} và Paimon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130102
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747130102,
					"content": "Freminet? Sao vẫn còn đội mũ lặn vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747130103,
					"content": "Vừa từ dưới nước lên à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747130104
					]
				},
				{
					"id": 747130104,
					"content": "Ừm... Tình hình dưới nước gần đây không ổn lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130105
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747130105,
					"content": "Số thợ lặn nhiều hơn trước gấp mấy lần, họ đang trục vớt hàng hóa chìm xuống khắp nơi. Tôi cũng chỉ có thể cố gắng giúp đỡ thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130106
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747130106,
					"content": "Nếu hoàn thành sớm thì các thợ lặn cũng sẽ rời đi, dưới nước sẽ trở lại trạng thái yên tĩnh như trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130107
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747130107,
					"content": "Vậy à... Khung cảnh ồn ào thế này chắc cậu không quen lắm phải không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747130108,
					"content": "Cảm ơn Paimon đã quan tâm. May mà cũng không phải toàn là chuyện xấu. Có một số thu hoạch bất ngờ, như đồ cổ và đồ trang trí vô chủ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130109
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747130109,
					"content": "\"Cha\" nói, những món đồ đẹp và có giá trị được vớt lên có thể gửi đến thuyền này, hai người chắc chắn sẽ khiến chúng phát huy được giá trị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130110
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747130110,
					"content": "Arlecchino suy nghĩ chu đáo quá. Nếu là những món trang sức đẹp mà vốn dĩ không ai muốn, biết đâu có thể dùng để trang trí thủy cung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747130111,
					"content": "Hay là chúng ta cùng Freminet đi trục vớt nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747130112,
					"content": "Có được không? Nhưng như vậy có lẽ sẽ tốn thời gian của hai người đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130113
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747130113,
					"content": "Tất nhiên là không vấn đề gì rồi! Freminet nói rồi mà, vớt được đồ tốt vô chủ thì sẽ cho chúng tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747130114,
					"content": "Thế thì làm sao chúng tôi có thể để mình cậu làm việc được? Không làm gì mà cứ thế nhận lợi ích thì chúng tôi áy náy lắm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130115,
						747130116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747130115,
					"content": "Tự mình vớt được đồ cổ cũng rất có ý nghĩa mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747130117
					]
				},
				{
					"id": 747130117,
					"content": "Vậy thì... tôi sẽ chia sẻ thông tin của các thợ lặn cho hai vị, có thể tiết kiệm được chút công sức...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130118
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747130118,
					"content": "Nếu tìm được đồ tốt thì hai vị cứ tự do sử dụng. Nhưng có một số thứ mà chủ thuyền cũng đang tìm kiếm, trường hợp đó thì vẫn phải trả lại cho chủ cũ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130119
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747130119,
					"content": "Được, chúng tôi hiểu rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747130120,
					"content": "Chú ý an toàn, đừng đến những vùng nước lạ nhé. Nếu gặp nguy hiểm thì hãy nổi lên mặt nước càng sớm càng tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747130116,
					"content": "Tìm kho báu dưới nước cũng rất thú vị mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747130117
					]
				}
			]
		}
	]
}