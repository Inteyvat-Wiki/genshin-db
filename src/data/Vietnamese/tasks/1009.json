			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 10090201,
					"content": "Hình như từng có người nấu ăn ở đây, là để thờ phụng tiên nhân ư?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10090202,
					"content": "Bên cạnh còn có nguyên liệu chưa dùng hết. Cỏ Kim Ngư... Đài Sen... còn cả Đậu Phụ, món này phức tạp thật...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10090203,
					"content": "Haiz, nhìn đây này, hình như là... ghi chú.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10090204,
					"content": "Món ăn phức tạp như vậy, thảo nào phải ghi lại vào giấy cách làm... Chúng ta xem kỹ thử coi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 100903,
			"completionStepIds": [
				100903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"100903",
							"2"
						],
						"stepId": 100903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 10090301,
					"content": "Oa, bao nhiêu bột mì vương vãi ra đất, ai nấu ăn ở đây mà lộn xộn thật...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10090302,
					"content": "Thứ trong nồi hình như là thịt... nhưng cụ thể là thịt gì thì không rõ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10090303,
					"content": "Món này có phải chỉ làm để thờ phụng tiên nhân không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10090304,
					"content": "Ừm... món cần dùng đến \"Thịt\" và \"Bột Mì\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10090305,
					"content": "Ấy? Dưới đất còn có một trang giấy... Ặc, còn cả vết chân chiếm nửa trang giấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10090306,
					"content": "Có điều, chưa biết chừng nó có liên quan đến món ăn này...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 100904,
			"completionStepIds": [
				100904
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
