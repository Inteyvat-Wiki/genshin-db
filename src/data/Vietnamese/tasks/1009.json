		{
			"id": 100914,
			"completionStepIds": [
				100914
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"100914",
							"2"
						],
						"stepId": 100914,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lưu Vân Tá Phong Chân Quân"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10091401,
					"content": "Không ngờ lại có thể vượt qua động phủ, các ngươi cũng khá có bản lĩnh đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091402
					],
					"speakerTitle": "Lưu Vân Tá Phong Chân Quân"
				},
				{
					"id": 10091402,
					"content": "Bổn tiên là Lưu Vân Tá Phong Chân Quân, các ngươi tới đây có việc gì mau",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091403,
						10091405
					],
					"speakerTitle": "Lưu Vân Tá Phong Chân Quân"
				},
				{
					"id": 10091403,
					"content": "Động phủ này là ngài tự xây đó ư?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10091404
					]
				},
				{
					"id": 10091404,
					"content": "Đương nhiên rồi, ngoài động phủ này ra, những cơ quan kia cũng do bổn tiên xây cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091407
					],
					"speakerTitle": "Lưu Vân Tá Phong Chân Quân"
				},
				{
					"id": 10091407,
					"content": "\"Cơ quan thuật\" của bổn tiên, ngay cả Guizhong và Nham Vương Đế quân đều thấy rồi, ai cũng phải tán dương.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091408
					],
					"speakerTitle": "Lưu Vân Tá Phong Chân Quân"
				},
				{
					"id": 10091408,
					"content": "Chỉ mỗi mình ngài sống trong động phủ lớn như vậy? Hơn nữa còn có nhiều cơ quan đến thế...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091409,
					"content": "Có phải để nghiên cứu \"Cơ quan thuật\", nên ngài mới sống một mình ở đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091410,
					"content": "Giống như trong truyền thuyết, tiên nhân rời khỏi cõi trần, ẩn cư nơi nào đó, nghiên cứu rất nhiều thứ lợi hại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091411,
					"content": "Bổn tiên... chỉ là cảm thấy giao tiếp quá phiền phức, muốn được thanh tịnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091412
					],
					"speakerTitle": "Lưu Vân Tá Phong Chân Quân"
				},
				{
					"id": 10091412,
					"content": "Nhưng thanh tịnh chưa bao lâu, các ngươi đã cầm Bách Vô Cấm Kỵ Lục đến rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091413
					],
					"speakerTitle": "Lưu Vân Tá Phong Chân Quân"
				},
				{
					"id": 10091413,
					"content": "Thôi được rồi! Các ngươi có việc gì, mau nói đi, đừng làm phiền bổn tiên tu hành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091414
					],
					"speakerTitle": "Lưu Vân Tá Phong Chân Quân"
				},
				{
					"id": 10091414,
					"content": "Đế quân... Đế quân bị ám sát!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091415
					],
					"speakerTitle": "Lưu Vân Tá Phong Chân Quân"
				},
				{
					"id": 10091415,
					"content": "Sao... sao lại như thế! Có kẻ dám phạm tội tày trời như vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091416
					],
					"speakerTitle": "Lưu Vân Tá Phong Chân Quân"
				},
				{
					"id": 10091416,
					"content": "Hoang đường như vậy, khó mà tin nổi, bổn tiên phải đi kiểm chứng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091417
					],
					"speakerTitle": "Lưu Vân Tá Phong Chân Quân"
				},
				{
					"id": 10091417,
					"content": "Chi bằng bổn tiên đi trấn áp Cảng Liyue trước, rồi đợi chúng tiên đến họp bàn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091418
					],
					"speakerTitle": "Lưu Vân Tá Phong Chân Quân"
				},
				{
					"id": 10091418,
					"content": "...Í?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10091419
					]
				},
				{
					"id": 10091419,
					"content": "Í?! Đợi, đợi đã! \"Trấn áp\" Cảng Liyue là gì vậy? Ngài định huỷ toàn bộ Cảng Liyue ư?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091420,
					"content": "Chỉ là dùng thuật Lôi Đình, tránh gây thêm rắc rối.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091421,
						10091423
					],
					"speakerTitle": "Lưu Vân Tá Phong Chân Quân"
				},
				{
					"id": 10091421,
					"content": "Ngài là Tiên nhân bảo vệ Cảng Liyue...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10091422
					]
				},
				{
					"id": 10091422,
					"content": "Đúng vậy, nghe lệnh Đế quân, ta đã bảo vệ Cảng Liyue hơn ba ngàn bảy trăm năm. Nhưng nay cái ác lộng hành, buộc phải dùng đến cách đặc biệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091425
					],
					"speakerTitle": "Lưu Vân Tá Phong Chân Quân"
				},
				{
					"id": 10091425,
					"content": "Bổn tiên không muốn trông thấy sinh linh đồ thán, mới phải sử dụng cách đặc biệt trong thời điểm mấu chốt này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091426
					],
					"speakerTitle": "Lưu Vân Tá Phong Chân Quân"
				},
				{
					"id": 10091426,
					"content": "Úi! Mau nghĩ cách thôi, vị Tiên nhân này nghiêm túc đó! Cô ấy thật sự định đi trấn áp toàn bộ Cảng Liyue đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091427,
					"content": "Tôi dâng cống phẩm rồi, dựa theo \"Khế ước\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10091428
					]
				},
				{
					"id": 10091428,
					"content": "Phải rồi! Chúng ta làm bao nhiêu món ngon như vậy, dâng cho ngài hết rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091429
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091429,
					"content": "Chúng tôi đến mời ngài đi bảo vệ Cảng Liyue, không phải là mời ngài đi \"Trấn áp\" nó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091430,
					"content": "Chí ít... ngài cũng nên nghe thử suy nghĩ của mọi người chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091431,
					"content": "...\"Khế ước\". Thần Khế Ước cũng đã bị ám sát, hai chữ này nghe đúng là châm biếm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091432
					],
					"speakerTitle": "Lưu Vân Tá Phong Chân Quân"
				},
				{
					"id": 10091432,
					"content": "Người phàm ở Cảng Liyue lúc nào cũng ngó lơ \"Khế ước\", lại rất giỏi đổi trắng thay đen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091433
					],
					"speakerTitle": "Lưu Vân Tá Phong Chân Quân"
				},
				{
					"id": 10091433,
					"content": "Song... Nếu các ngươi lấy danh nghĩa \"Khế ước\" đến mời ta, bổn tiên cũng không thể coi Khế ước như vô hình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091434
					],
					"speakerTitle": "Lưu Vân Tá Phong Chân Quân"
				},
				{
					"id": 10091434,
					"content": "Hơn nữa các ngươi còn cầm Bách Vô Cấm Kỵ Lục... Haiz, lúc Đế quân đúc thành Thần Lục, từng truyền tinh lực, giúp người phàm chinh chiến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091435
					],
					"speakerTitle": "Lưu Vân Tá Phong Chân Quân"
				},
				{
					"id": 10091435,
					"content": "Nhưng nay Thần Lục này đã vơi bớt tiên lực, chỉ có tác dụng làm tín vật...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091436
					],
					"speakerTitle": "Lưu Vân Tá Phong Chân Quân"
				},
				{
					"id": 10091436,
					"content": "Có điều, tín vật không thể chứng minh độ tin cậy của các ngươi... Vừa nãy những lời ta nghe thấy, ta đều sẽ kiểm chứng lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091437
					],
					"speakerTitle": "Lưu Vân Tá Phong Chân Quân"
				},
				{
					"id": 10091437,
					"content": "Ắt hẳn Tước Nguyệt Trúc Dương Chân Quân có lời mời ta cũng bởi chuyện này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091438
					],
					"speakerTitle": "Lưu Vân Tá Phong Chân Quân"
				},
				{
					"id": 10091438,
					"content": "Được rồi, các ngươi mau đi đi, đừng làm phiền bổn tiên nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lưu Vân Tá Phong Chân Quân"
				},
				{
					"id": 10091423,
					"content": "Không phải ngài nên bảo vệ người phàm sao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10091424
					]
				},
				{
					"id": 10091424,
					"content": "Đúng vậy. Nhưng nay Đế quân bị hại, Cảng Liyue cũng lâm nguy, giả như không nhanh chóng trấn áp, chỉ e tình hình sẽ càng tệ hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091425
					],
					"speakerTitle": "Lưu Vân Tá Phong Chân Quân"
				},
				{
					"id": 10091405,
					"content": "Cơ quan trong động phủ là do ngài xây ư?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10091406
					]
				},
				{
					"id": 10091406,
					"content": "Đương nhiên rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091407
					],
					"speakerTitle": "Lưu Vân Tá Phong Chân Quân"
				}
			]
		},
