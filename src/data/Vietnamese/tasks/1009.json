				"points": []
			},
			"dialogs": [
				{
					"id": 10091501,
					"content": "Ấy? Sao ở đây lại có chiếc bàn đá, bên trên bày nhiều bát đũa như vậy, còn có cả bình rượu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091502,
					"content": "Trên chiếc ghế bên cạnh còn khắc chữ nữa kìa, Nơi này Lưu Vân...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091510,
					"content": "\"Nơi này Guizhong ngồi\", còn cả \"Nơi này tiếp Đế quân\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091503,
					"content": "\"Đế quân\" lẽ nào muốn chỉ \"Nham Vương Đế Quân\"? \"Guizhong\" không biết là có ý gì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091504,
					"content": "\"Lưu Vân\"... đúng rồi, vị Tước Nguyệt Trúc Dương Chân Quân nọ từng nhắc, trong số Tiên nhân có một vị tên là \"Lưu Vân Tá Phong Chân Quân\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091505,
					"content": "Nói vậy, không biết chừng nơi này chính là nơi mà \"Lưu Vân Tá Phong Chân Quân\" và các Tiên nhân khác từng tụ họp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091506,
					"content": "Ha ha, giả dụ đúng là như vậy, thì chúng ta làm một ít món ngon mà tiên nhân thích, có phải sẽ khiến \"Lưu Vân Tá Phong Chân Quân\" chú ý đến?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091507,
					"content": "Có điều, rốt cuộc tiên nhân muốn ăn món gì nhỉ? Hoàn toàn không có manh mối gì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091508,
					"content": "Chẳng có cách nào khác, chúng ta đi xem xét xung quanh thử coi, hy vọng những người từng đến đây thờ phụng trước kia sẽ để lại chút manh mối có thể tham khảo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091509,
					"content": "Phải rồi, bạn nói... Tiên nhân thích ăn Thịt Nướng Mật Ong à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
