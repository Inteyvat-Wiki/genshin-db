			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ganyu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80000101,
					"content": "Đúng đó, đúng đó. Tôi biết bọn chúng chuyện gì cũng dám làm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000102
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000102,
					"content": "Ngay cả những cổ vật mang tính lịch sử như Thất Thần, Ma Thần, Ác Long... Bọn chúng cũng dám ra tay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000103
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000103,
					"content": "Nhưng lần này, ai đã cho chúng can đảm để động vào đồ của Giáo Đoàn Vực Sâu chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000104
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000104,
					"content": "A, Nhà Lữ Hành, là các bạn à.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000105
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000105,
					"content": "Ơ? Sao Ganyu lại ở chỗ Lan? Muốn phát ủy thác gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000106,
					"content": "#Xin chào, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000107
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 80000107,
					"content": "Lúc nãy chúng tôi đang nói chuyện về Đạo Bảo Đoàn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000108
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 80000108,
					"content": "Ừm, lúc nãy chúng tôi nói đến chuyện kẻ dám động đến mọi thứ như Đạo Bảo Đoàn, vốn dĩ cũng đã biết tốt nhất không nên động đến \"Vực Sâu\", bởi vì chúng quá tà ác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000109
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000109,
					"content": "Tuy nhiên, gần đây tôi nhận được tình báo từ Tổng Vụ, hai nhóm Đạo Bảo Đoàn nam bắc từ Mondstadt đến Liyue đang chuẩn bị hợp lực để làm một cú lớn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000110
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 80000110,
					"content": "Đạo Bảo Đoàn... hai nhóm Nam Bắc?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000111,
					"content": "Ừm, giang hồ gọi là \"Nam Trưởng Tỷ\", \"Bắc Quái Điểu\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000112
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000112,
					"content": "Á, \"Quái Điểu\"! Tôi có ấn tượng, hắn và Amber từng đấu với nhau ở Mondstadt... Nhưng \"Nam Trưởng Tỷ\" là ai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000113,
						80000114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000113,
					"content": "Trưởng Tỷ có nghĩa là người chị lớn nhất sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80000116
					]
				},
				{
					"id": 80000116,
					"content": "Đúng vậy, theo tôi được biết thì bọn người đó gọi thủ lĩnh của Đạo Bảo Đoàn Liyue là \"Chị Đại\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000117
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000117,
					"content": "Cũng có người nói tay nghề của cô ta được thần đạo bảo ban tặng, nên gọi là \"Thần Chi Trưởng Tỷ\"... Nhưng có lẽ đó chỉ là lời đồn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000118
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000118,
					"content": "Nói tóm lại, Đạo Bảo Đoàn đã tìm thấy một di tích chưa ai khai quật, di tích đó đang được Giáo Đoàn Vực Sâu canh giữ nghiêm ngặt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000119
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 80000119,
					"content": "Mặc dù đây là một dấu hiệu rất nguy hiểm, nhưng với tư duy của Đạo Bảo Đoàn, chúng chỉ cảm thấy có báu vật...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000120
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 80000120,
					"content": "Bọn chúng lập kế hoạch, cử một nhóm đánh lạc hướng lực lượng của Giáo Đoàn Vực Sâu, sau đó cho một tinh anh ưu tú nhất đi sâu vào di tích, lấy kho báu và trốn thoát.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000121
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 80000121,
					"content": "Vì vậy, nghe nói \"Chị Đại\" và \"Quái Điểu\" đã mời một \"Trùm Đạo Bảo\" từ Fontaine về...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000122
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000122,
					"content": "\"Trùm Đạo Bảo\"? Danh hiệu nghe có vẻ rất ngầu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000123,
					"content": "Đúng vậy, đó là một nhân vật trong truyền thuyết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000124
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000124,
					"content": "Địa vị của Trùm Đạo Bảo trong Đạo Bảo Đoàn cũng giống như \"nhà mạo hiểm vĩ đại\" trong mắt những nhà mạo hiểm như chúng ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000125,
						80000127
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000125,
					"content": "Ví dụ như nhà mạo hiểm nổi tiếng Alice?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80000126
					]
				},
				{
					"id": 80000126,
					"content": "Các bạn cũng biết tác giả của quyển Hướng Dẫn Du Ngoạn Teyvat đúng không? Chính xác, địa vị của Trùm Đạo Bảo cũng cao quý như cô ấy vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000129
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000129,
					"content": "Vì vậy, ngay cả hai gã khổng lồ của Đạo Bảo Đoàn ở hai miền Nam Bắc cũng phải làm mọi cách mời ông ta đến để lên toàn bộ kế hoạch đánh cắp kho báu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000130
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000130,
					"content": "Gần đây Liyue gặp phải thay đổi lớn, tổng vụ và Thiên Nham Quân đều quá bận rộn, không có thời gian để đối phó với tin đồn Đạo Bảo Đoàn hành động.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000131
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 80000131,
					"content": "Nhưng với linh tính của tôi, những thứ liên quan đến Vực Sâu đều ẩn chứa sự uy hiếp nào đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000132
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 80000132,
					"content": "Cho nên tôi muốn đến Hiệp Hội Nhà Mạo Hiểm treo ủy thác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000133,
						80000134
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 80000133,
					"content": "Vậy thì đúng lúc quá...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80000135
					]
				},
				{
					"id": 80000135,
					"content": "Ừm, vậy chúng tôi nhận ủy thác này nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000136,
					"content": "Ôi, rất cảm ơn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000137
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 80000137,
					"content": "Tuyệt vời, đúng là thành viên đáng tin cậy. Chúc bạn thuận buồm xuôi gió, chi tiết của ủy thác cứ để hiệp hội xử lý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000134,
					"content": "Tôi cũng hiểu rõ mối nguy hại của Vực Sâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80000135
					]
				},
				{
					"id": 80000127,
					"content": "Ví dụ như nhà mạo hiểm nổi tiếng Stanley?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80000128
					]
				},
				{
					"id": 80000128,
					"content": "Ơ? Lẽ nào các bạn đã từng gặp vị tiền bối đó ở Mondstadt rồi sao? Không sai, địa vị của Trùm Đạo Bảo cũng cao quý như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000129
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000114,
					"content": "Là \"Chị Đại\" của Đạo Bảo Đoàn sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80000115
					]
				},
				{
					"id": 80000115,
					"content": "Bạn biết không ít nhỉ, xem ra từng giao du rất nhiều với Đạo Bảo Đoàn nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000116
					],
					"speakerTitle": "Lan"
				}
			]
		},
		{
			"id": 800002,
			"completionStepIds": [
				800004
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
