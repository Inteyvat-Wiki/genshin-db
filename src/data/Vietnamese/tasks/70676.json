			"dialogs": [
				{
					"id": 706760101,
					"content": "Không ngờ trong thư viện lại có một căn phòng như vậy. Chẳng lẽ đây chính là khu sách cấm mà Lisa nhắc đến sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706760102,
					"content": "Hmm, nhưng bầu không khí ở đây có vẻ không được giống cho lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706760103,
					"content": "Hay đây là loại phòng bí ẩn thường thấy trong truyện nhỉ? Một căn phòng bí ẩn bị cấm vào vì ẩn giấu một bí mật không thể cho ai biết đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706760104,
					"content": "Nếu thực sự không muốn người khác vào thì nên khóa cửa lại chứ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706760105
					]
				},
				{
					"id": 706760105,
					"content": "Đúng nhỉ. Vừa rồi chúng ta đi vào rất bình thường, cũng không giống như khóa cửa bị hỏng cả...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706760106,
					"content": "Ấy? Đợi đã, hình như đây không phải là cánh cửa mà chúng ta vừa đi vào! Ối, chúng ta có còn ở trong thư viện không vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760107,
						706760109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706760107,
					"content": "Có lẽ chúng ta đang ở dưới đáy Hồ Rượu Trái Cây rồi nhỉ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706760108
					]
				},
				{
					"id": 706760108,
					"content": "Thì ra ở đây có kết cấu như vậy sao, siêu thật đó... Không đúng, nghĩ thế nào cũng thấy không thể được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706760111,
					"content": "Hmm... Tiếc là hôm nay Lisa lại nghỉ phép, nếu không thì đã có thể hỏi cô ấy rồi. Nhưng giờ đã đến đây rồi, có vẻ như cũng không có gì nguy hiểm. Hay là chúng ta đi dạo quanh thử nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706760112,
					"content": "Cứ khi nào đến một địa điểm mới thì đều phải khám phá nó mà! Đó là bí quyết để trở thành người dẫn đường giỏi đấy, hihi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706760113,
					"content": "#{NICKNAME}, mau nhìn kìa, con sói bông đáng yêu quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706760114,
					"content": "Lông mềm mại thế kia thì sờ dễ chịu lắm đó! Không biết là ai để lại ở đây nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760115,
						706760117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706760115,
					"content": "Biết đâu nó mới chính là chủ nhân của căn phòng này đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706760116
					]
				},
				{
					"id": 706760116,
					"content": "\"Nhà Lữ Hành to gan, dám xông vào lâu đài của ta sao? Ta sẽ ăn thịt các ngươi! Grào grào!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706760120,
					"content": "...Thôi đừng để ý tới nó nữa là được. Căn phòng này cũng rộng rãi đấy, chúng ta đi dạo chỗ khác nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706760117,
					"content": "Có thể là người gác cổng của căn phòng bí ẩn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706760118
					]
				},
				{
					"id": 706760118,
					"content": "Rõ ràng là người gác cổng, vậy mà lại ngủ say trên ghế như vậy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706760119,
					"content": "\"Phù... phù... phù... Không nhìn thấy nguy hiểm thì tức là không có gì nguy hiểm... phù... phù... phù...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706760109,
					"content": "Nói không chừng chúng ta đã đến một thế giới khác rồi đấy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706760110
					]
				},
				{
					"id": 706760110,
					"content": "Thế giới khác là thế giới nào cơ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760111
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}