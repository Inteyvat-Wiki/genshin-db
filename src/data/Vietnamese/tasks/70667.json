			"trigger": {
				"objectNames": [
					"\"Tiểu Hoàng Tử\""
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706670201,
					"content": "Meo! \"Thật xuất sắc, chúc mừng bạn đã đột phá thí luyện cấp bài thủ, bây giờ bạn đã là Bài Thủ Chuyên Nghiệp rồi!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706670202
					],
					"speakerTitle": "\"Tiểu Hoàng Tử\""
				},
				{
					"id": 706670202,
					"content": "\"Điều này sẽ giúp bạn đủ điều kiện để khiêu chiến nhiều bài thủ hơn, mặc dù trước đây bạn đã có thể làm vậy, nhưng tôi nhắc nhở bạn lần nữa, bạn có thể treo chiến thư trên bảng mời...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706670203
					],
					"speakerTitle": "\"Tiểu Hoàng Tử\""
				},
				{
					"id": 706670203,
					"content": "Meo...\"Bằng cách này, những bài thủ muốn khiêu chiến bạn có thể xé chiến thư của bạn. Hmm, không biết đối thủ của mình là ai, đôi khi cũng rất thú vị...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706670204
					],
					"speakerTitle": "\"Tiểu Hoàng Tử\""
				},
				{
					"id": 706670204,
					"content": "\"Suy cho cùng, hẹn nhau chơi bài cũng là một cách để gặp gỡ.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706680204
					],
					"speakerTitle": "\"Tiểu Hoàng Tử\""
				},
				{
					"id": 706680204,
					"content": "#Meo! \"Á! Dông dài quá rồi, với tư cách là Bài Thủ Chuyên Nghiệp, bây giờ {NICKNAME} có thể mua một số thẻ bài thật đặc biệt...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706670205
					],
					"speakerTitle": "\"Tiểu Hoàng Tử\""
				},
				{
					"id": 706670205,
					"content": "#\"Ừm ừm... {NICKNAME}, đừng quên trái tim của trò chơi, hy vọng bạn sẽ trải nghiệm được thú vui của \"Thất Thánh Triệu Hồi!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"Tiểu Hoàng Tử\""
				}
			]
		},
