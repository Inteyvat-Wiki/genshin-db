						700230103
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700230103,
					"content": "Mani. Mi muhe mani. Unu du mani! Hahahahaha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700230104
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 700230104,
					"content": "Tên này kể chuyện cười bằng tiếng Hilichurl, tự làm mình vui. Xem ra đời sống tinh thần của chúng khô khan quá, trông thật đáng thương.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700230105
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700230105,
					"content": "Mi muhe <color=#00E1FFFF>kucha gusha</color>. Kucha gusha dada. Unu gusha dada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700230106
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 700230106,
					"content": "Nó muốn...ừm...thôi, cứ tra sổ tay là tìm được ấy mà!",
					"roleType": "TALK_ROLE_NPC",
