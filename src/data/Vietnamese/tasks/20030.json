				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200300101,
					"content": "Chào mừng đến với <color=#00E1FFFF>Hiệp Hội Nhà Mạo Hiểm</color>, tôi đã quan sát bạn từ rất lâu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300102,
					"content": "#Quan sát {NICKNAME}? Chẳng lẽ bạn tôi đã làm việc kỳ lạ gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200300103,
					"content": "Không có không có, phát hiện ra Nhà Mạo Hiểm ưu tú, đây cũng là một phần công việc của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300104
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300104,
					"content": "Trên người bạn, tôi nhìn thấy tư chất của những Nhà Mạo Hiểm trong truyền thuyết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300105
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300105,
					"content": "Hì hì, cái này tôi cũng nhìn ra được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200300106,
					"content": "#Đi mạo hiểm với {NICKNAME}, đều rất có cảm giác an toàn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200300107,
					"content": "Ừ ừ, nhưng với nhà mạo hiểm mà nói, kinh nghiệm quan trọng hơn tư chất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300108
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300108,
					"content": "Chỉ có không ngừng tích lũy <color=#00E1FFFF>Kinh Nghiệm Mạo Hiểm</color>, mới có thể tăng đánh giá <color=#00E1FFFF>Hạng Mạo Hiểm</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300109
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300109,
					"content": "Việc không thể chậm trễ, hãy để tôi giới thiệu chút cho Nhà Mạo Hiểm mới gia nhập...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300110
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300110,
					"content": "Đợi một chút! Chúng tôi đã trở thành Nhà Mạo Hiểm chính thức sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200300111,
					"content": "Yên tâm, Hiệp Hội Nhà Mạo Hiểm không cần hội phí, cũng không bắt buộc Nhà Mạo Hiểm phải thực hiện nghĩa vụ gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300112
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300112,
					"content": "Nói cách khác, gia nhập hiệp hội chỉ có lợi chứ không có hại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300113,
						200300114
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300113,
					"content": "Được rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200300116
					]
				},
				{
					"id": 200300116,
					"content": "Tóm lại, mỗi khi tăng Hạng Mạo Hiểm, Hiệp Hội Nhà Mạo Hiểm đều sẽ có phần thưởng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300117
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300117,
					"content": "Đây là quà cho người mới của hiệp hội, bạn hãy tự mình xác nhận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300118
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300118,
					"content": "Thưởng Hạng Mạo Hiểm",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 200300114,
					"content": "Tôi cần có lợi ngay bây giờ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200300115
					]
				},
				{
					"id": 200300115,
					"content": "Haha... người mới hiện nay sao lại trở nên thẳng thừng như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300116
					],
					"speakerTitle": "Katheryne"
				}
			]
		},
		{
			"id": 2003002,
			"completionStepIds": [
				2003003,
				2003004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2003003",
