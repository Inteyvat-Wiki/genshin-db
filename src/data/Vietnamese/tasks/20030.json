			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200300201,
					"content": "Vậy thì hãy cho phép tôi chào mừng bạn gia nhập, ngôi sao mạo hiểm mới!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300202
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300202,
					"content": "Đây chính là <color=#00E1FFFF>Bằng Chứng Mạo Hiểm</color> của bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300203,
						200300205
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300203,
					"content": "Còn có giấy xác nhận?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200300204
					]
				},
				{
					"id": 200300204,
					"content": "Việc quan trọng như có người mới gia nhập, đương nhiên phải làm theo nghi thức.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300207
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300207,
					"content": "Ở trên đó ghi rất nhiều thông tin về ủy thác và phần thưởng của hiệp hội.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300208
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300208,
					"content": "Đồng thời đây cũng là chứng minh hội viên, hãy nhớ mở ra xem và bảo quản tốt nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300209
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300209,
					"content": "Phải rồi, còn một việc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300210
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300210,
					"content": "Hạng mạo hiểm sẽ có hạn chế tăng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300211
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300211,
					"content": "Đến lúc đó cần phải hoàn thành một số \"nhiệm vụ khiến người khác có ấn tượng sâu sắc\" để được sự chấp nhận của hiệp hội.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300212
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300212,
					"content": "Nhiệm vụ... khiến người khác có ấn tượng sâu sắc?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200300213,
					"content": "Có thể gọi đó là \"Nhiệm Vụ Đột Phá\" để mở giới hạn \"Hạng Mạo Hiểm\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300214
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300214,
					"content": "Bây giờ vẫn chưa đến lúc, khi kinh nghiệm của bạn đủ phong phú, tự nhiên sẽ có cơ hội để đạt được sự công nhận của người khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300215
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300215,
					"content": "Hôm nay đến đây vậy, sau này chắc chúng ta sẽ thường xuyên gặp mặt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300216
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300216,
					"content": "Nhà Mạo Hiểm hãy cố gắng lên, hướng về những ngôi sao và vực sâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300205,
					"content": "Đây là... sổ tay tuyên truyền?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200300206
					]
				},
				{
					"id": 200300206,
					"content": "Nói như vậy cũng được, nhưng tác dụng của nó còn nhiều hơn thế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300207
					],
					"speakerTitle": "Katheryne"
				}
			]
		}
	]
