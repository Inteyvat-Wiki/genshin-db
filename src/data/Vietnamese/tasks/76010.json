			"dialogs": [
				{
					"id": 760100201,
					"content": "Hai mươi lăm... hai mươi sáu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100202
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100202,
					"content": "Ủa, anh đang đếm gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760100203,
					"content": "Suỵt...! Nói khẽ thôi... haiz, thôi bỏ đi, dù sao lần này cũng chắc chắn không câu được rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100204
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100204,
					"content": "Này cô nhóc kia, chuyện này chỉ cần nhìn qua là hiểu ngay mà? Dĩ nhiên là tôi đang tính giờ câu cá, chứ nghĩ tôi cầm cần câu để làm gì, làm phép à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100205,
						760100207
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100205,
					"content": "Dòng Dõi Sương Nguyệt thì... cũng có thể lắm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760100206
					]
				},
				{
					"id": 760100206,
					"content": "#Haiz, {F#cô}{M#cậu} nhóc này quả thực đã đánh giá tôi quá cao rồi. Tôi nhiều lắm cũng chỉ được coi là nửa Dòng Dõi Sương Nguyệt, chỉ là một người bình thường không biết dùng Kuuvahki thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100210
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100210,
					"content": "Thôi bỏ đi, nhưng đây là lần đầu tiên tôi thấy có người tính thời gian câu cá bằng giây đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760100211,
					"content": "À, quan trọng là kỹ thuật câu chứ không phải thời gian đứng trên bờ dài hay ngắn. Lão Ilmari vì không hiểu được điểm này nên chẳng lúc nào câu được cá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100212
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100212,
					"content": "Ừm? Nói vậy thì, hai người chắc là thợ săn kho báu nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100213
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100213,
					"content": "Không phải, chúng tôi là nhà mạo hiểm... ờ, vậy là có chuyện gì cần chúng tôi làm sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760100214,
					"content": "Cũng gần như vậy, thợ săn kho báu hay nhà mạo hiểm đều được, chỉ cần nhận tiền rồi làm việc là được. Nếu hai người có thời gian, tôi muốn nhờ hai người giúp một việc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100215
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100215,
					"content": "Hai người thấy đấy, kỹ thuật câu của tôi rõ ràng là số một ở Đảo Hiisi, dù là các Vịnh Nguyệt Sứ các đời cũng không ai có thể thắng được tôi trong lĩnh vực câu cá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100216
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100216,
					"content": "Vậy sao? Thật lợi hại... ủa? Nghĩ kỹ lại hình như cũng không có gì lợi hại, công việc chính của Vịnh Nguyệt Sứ đâu phải là câu cá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760100217,
					"content": "Tuy nhiên, một người lợi hại như tôi, gần đây lại không câu được một con cá nào! Tại sao lại thế nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100218
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100218,
					"content": "Rõ ràng, vấn đề không phải ở tôi mà là ở môi trường. Giống như Mắt Kratti bị nguyền rủa vậy, dưới mặt nước này chắc chắn có thứ gì đó đang ảnh hưởng đến đàn cá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100219
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100219,
					"content": "Thật, thật là một suy luận kỳ quặc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760100220,
					"content": "Thế nên, xin nhờ cả hai giúp tôi điều tra vùng nước gần đây, xem rốt cuộc là thứ gì đang ngăn cản cá cắn câu. Yên tâm, tôi sẽ không bạc đãi hai người đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100221
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100221,
					"content": "Ờm, vì có thù lao nên chúng tôi sẽ đi xem xét quanh đây... nhưng không đảm bảo là sẽ tìm thấy thứ gì kỳ lạ đâu nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760100207,
					"content": "Chắc là đang tìm kiếm đồng đội tốt nhất...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760100208
					]
				},
				{
					"id": 760100208,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100209
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100209,
					"content": "Không phải ai câu cá cũng câu được đồng đội tốt nhất đâu... Khoan, đó đâu phải trọng tâm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100210
					],
					"speakerTitle": "Paimon"
				}
			]
		},
