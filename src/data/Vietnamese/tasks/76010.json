			"dialogs": [
				{
					"id": 760100601,
					"content": "Này, hai người có thấy không? Vừa rồi không biết chuyện gì xảy ra, tôi chỉ lơ đãng một chút thôi mà tảng đá to đó đã bay mất rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100602
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100602,
					"content": "Kể lại chuyện trước đó...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760100603
					]
				},
				{
					"id": 760100603,
					"content": "Ồ! Tuy hoàn toàn không hiểu chuyện gì xảy ra, nhưng nếu có thể tạo ra phép màu như vậy, hai người chắc chắn là người được Thiếu Nữ {RUBY#[D]Kuutar}Mặt Trăng yêu quý!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100604
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100604,
					"content": "Nguyệt Thần đại nhân phù hộ, Nguyệt Thần đại nhân phù hộ! Vậy là tôi có thể ở đây câu cá thỏa thích rồi! Chỉ cần tên nhà thơ đáng ghét đó không dắt thú cưng của hắn qua đây hát nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100605
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100605,
					"content": "Đây là tiền công đã hứa! Tuy gần đây tôi không câu được cá, nhưng những thứ linh tinh khác thì câu được không ít, có những thứ cũng khá đáng tiền...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100606
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100606,
					"content": "Chỉ là bên Đảo Hiisi này cũng không dùng đến Mora mấy, nên tôi sẽ tặng hết cho hai người. Cảm ơn vì đã giúp đỡ, giờ thì để tôi yên tâm câu cá một mình nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pekkani"
				}
			]
		}
	]
