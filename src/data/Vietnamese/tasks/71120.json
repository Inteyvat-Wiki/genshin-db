			"dialogs": [
				{
					"id": 711200101,
					"content": "Này, tránh xa ra! Đây là địa bàn của lão gia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200102
					],
					"speakerTitle": "Tọa Địa Hổ"
				},
				{
					"id": 711200102,
					"content": "Chà, thật hung hăng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200103,
						711200106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711200103,
					"content": "Các người là ai?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711200104
					]
				},
				{
					"id": 711200104,
					"content": "Xem kìa. Khách sáo chút thì chúng ta làm bạn được! Còn nếu thăm dò nhiều quá, thì đừng trách chúng tôi không khách sáo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200105
					],
					"speakerTitle": "Rắn Cuộn Cành"
				},
				{
					"id": 711200105,
					"content": "Nên có mắt nhìn một chút, đến từ đâu thì hãy quay về đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200109
					],
					"speakerTitle": "Tọa Địa Hổ"
				},
				{
					"id": 711200109,
					"content": "Các người cũng thật đáng nghi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711200110,
					"content": "Đáng nghi? Ơ kìa... Chúng tôi chỉ gác cửa mà thôi, dáng vẻ thăm dò của các người mới đáng nghi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200111
					],
					"speakerTitle": "Rắn Cuộn Cành"
				},
				{
					"id": 711200111,
					"content": "Được rồi, không có gì đáng nói đâu! Đừng phiền nhiễu nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tọa Địa Hổ"
				},
				{
					"id": 711200106,
					"content": "Đây là địa bàn của vị \"lão gia\" nào?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711200107
					]
				},
				{
					"id": 711200107,
					"content": "Vị \"lão gia\" nào? Hừ... nói ra thì người nghe sẽ giật mình đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200108
					],
					"speakerTitle": "Tọa Địa Hổ"
				},
				{
					"id": 711200108,
					"content": "Cũng là để tốt cho các vị đây! Thứ không nên biết thì đừng dò hỏi lung tung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200109
					],
					"speakerTitle": "Rắn Cuộn Cành"
				}
			]
		},
