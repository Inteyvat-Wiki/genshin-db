			"dialogs": [
				{
					"id": 711209101,
					"content": "Sao lại là các người!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209102
					],
					"speakerTitle": "Tọa Địa Hổ"
				},
				{
					"id": 711209102,
					"content": "Đừng quá tò mò. Các người cứ xem như không thấy chúng tôi, chúng tôi cũng xem như không thấy các người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209103,
						711209111
					],
					"speakerTitle": "Rắn Cuộn Cành"
				},
				{
					"id": 711209103,
					"content": "Đang canh giữ gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711209104
					]
				},
				{
					"id": 711209104,
					"content": "Này người bạn, nghĩ xem tôi lãnh tiền công để làm chuyện gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209105
					],
					"speakerTitle": "Rắn Cuộn Cành"
				},
				{
					"id": 711209105,
					"content": "Là chuyện gì?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711209106,
					"content": "Khụ khụ...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209107
					],
					"speakerTitle": "Rắn Cuộn Cành"
				},
				{
					"id": 711209107,
					"content": "(Tôi chỉ nói cho hai người, đừng cho người khác biết... Nào nào, tôi nói cho nghe...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209108
					],
					"speakerTitle": "Rắn Cuộn Cành"
				},
				{
					"id": 711209108,
					"content": "(Ừ! Tôi đang nghe đây!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711209109,
					"content": "Để khiến loại nhàn rỗi như các người xéo đi chỗ khác!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209110
					],
					"speakerTitle": "Rắn Cuộn Cành"
				},
				{
					"id": 711209110,
					"content": "Úi!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711209111,
					"content": "Trong động có âm thanh lạ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711209112
					]
				},
				{
					"id": 711209112,
					"content": "Tôi vừa đánh rắm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209113
					],
					"speakerTitle": "Tọa Địa Hổ"
				},
				{
					"id": 711209113,
					"content": "Ờ... Đúng, anh ta đánh rắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209114
					],
					"speakerTitle": "Rắn Cuộn Cành"
				},
				{
					"id": 711209114,
					"content": "Vậy, vậy hết chuyện rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
