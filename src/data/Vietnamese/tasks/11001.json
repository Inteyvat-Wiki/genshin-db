			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Draff"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110010201,
					"content": "Bạn chính là Xiangling, phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010202
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 110010202,
					"content": "Xin lỗi, ngài Draff, là tôi không đúng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010203
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110010203,
					"content": "Những việc bạn làm tôi đều đã nghe rồi. Nếu bạn đã đến đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010204
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 110010204,
					"content": "Đáng... đáng sợ quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010205,
						110010206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110010205,
					"content": "Bạo... bạo lực là không đúng!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110010207
					]
				},
				{
					"id": 110010207,
					"content": "Hãy giúp chúng tôi quảng cáo sản phẩm thịt của chúng tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010208
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 110010208,
					"content": "...A?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010209
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110010209,
					"content": "Thật ngại quá, có chút đường đột, tôi sẽ giải thích cho các bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010210
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 110010210,
					"content": "Thanh Tuyền Trấn nổi tiếng nhờ sản phẩm thịt cao cấp, nhưng danh tiếng của nó không nên chỉ hạn chế trong Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010211
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 110010211,
					"content": "Đúng lúc nghe nói đầu bếp Xiangling đến Mondstadt, tôi lập tức kêu Allan mời bạn qua đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010212
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 110010212,
					"content": "Đầu bếp?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110010213,
					"content": "Bạn chưa nghe qua ư? Độc nhất ở cảng Liyue, \"Vạn Dân Đường\" chuyên món ăn bình dân, chính là đầu bếp Xiangling.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010214
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 110010214,
					"content": "Cô ấy có sự lý giải rất đặc biệt với nguyên liệu, những món làm ra được người dân địa phương hết sức yêu mến, cũng được du khách đánh giá cao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010215
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 110010215,
					"content": "Hì hì, có chút nói quá. Tôi chỉ muốn làm ra món ngon mà rẻ thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010216
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110010216,
					"content": "Đầu bếp hạng nhất như Xiangling, dùng loại thịt hạng nhất nấu ra món ăn hạng nhất, thịt ở Thanh Tuyền Trấn của chúng ta có thể tiếng tăm bay xa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010217
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 110010217,
					"content": "Nhưng mà... thỉnh cầu này tôi nghĩ tôi không làm được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010218
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110010218,
					"content": "Tôi chỉ suy nghĩ làm sao để làm ra món ngon, không hạn chế nguyên liệu, càng chưa từng quảng cáo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010219
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110010219,
					"content": "Dù gì thịt cũng là nguyên liệu bạn muốn, tôi thấy cũng không có gì khác biệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010220
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 110010220,
					"content": "Có khác biệt, khác biệt rất lớn! Ví dụ tôi muốn thêm dịch Slime vào bạn có đồng ý không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010221
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110010221,
					"content": "Cái này... quả thực có chút... không thể dùng nguyên liệu bình thường một chút sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010222
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 110010222,
					"content": "Nguyên liệu không có gì bình thường hay không bình thường! Bất kể là cái gì chỉ cần cách làm đúng, đều có thể làm ra món ngon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010223
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110010223,
					"content": "Tôi không muốn nguyên liệu trói buộc cảm xúc của tôi, nếu bị như vậy thì thứ làm ra thật là chán.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010224,
						110010225
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110010224,
					"content": "Khí thế đột nhiên trở nên rất mạnh mẽ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110010226
					]
				},
				{
					"id": 110010226,
					"content": "Haiz, nếu thái độ kiên quyết như vậy, thì thôi bỏ đi. Nhưng thật là đáng tiếc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Draff"
				},
				{
					"id": 110010225,
					"content": "Đây chính là chấp niệm của đầu bếp sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110010226
					]
				},
				{
					"id": 110010206,
					"content": "Nếu muốn động thủ... thì cứ nhằm vào tôi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110010207
					]
				}
			]
		},
		{
			"id": 1100104,
			"completionStepIds": [
				1100104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1100104",
							"2"
						],
						"stepId": 1100104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xiangling"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110010401,
					"content": "Chào bạn, món bạn nấu này tôi có thể nếm thử không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010402
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110010402,
					"content": "Thật là ngại quá, những ngày gần đây đều hết hàng, muốn ăn thì phải đặt trước 7 ngày, được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010403
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 110010403,
					"content": "Được yêu thích vậy sao... nhất định là rất ngon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110010404,
					"content": "Kỳ lạ, rõ ràng là có đầu bếp được yêu thích như thế...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110010405
					]
				},
				{
					"id": 110010405,
					"content": "Đúng rồi, tại sao ngài Draff còn muốn tìm Xiangling nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110010406,
					"content": "Haiz... Có thể anh ấy thấy Mondstadt so với đầu mối thương mại của toàn đại lục như Liyue, thì khẩu vị vẫn chưa được đại chúng lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010407
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 110010407,
					"content": "Nhưng tôi không phục! Tôi chưa từng cảm thấy thịt tôi làm ra sẽ thua kém ai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010408
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 110010408,
					"content": "Vậy thì hãy phá lệ làm cho tôi một lần, có thể tôi sẽ có đề xuất gì đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010409
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110010409,
					"content": "Người bình thường chỉ khen vài câu vô thưởng vô phạt như \"ngon\", chắc bạn cũng...ơ...khoan...bạn chính là Xiangling?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010410
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 110010410,
					"content": "Ừm, đúng nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010411
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110010411,
					"content": "Hóa ra là bạn! Vậy thì bạn nhất định biết cách nấu thịt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010412
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 110010412,
					"content": "Thật ra tôi có giữ lại một miếng thịt ngon nhất hôm nay, nếu muốn bạn làm thịt nướng, bạn sẽ làm như thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010413
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 110010413,
					"content": "Vậy thì phải xem chất lượng thịt và lượng mỡ rồi, miếng thịt này chắc tôi sẽ nướng đá, kết hợp với muối biển Ớt Tuyệt Vân và Hoa Thanh Tâm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010414
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110010414,
					"content": "Hoa Thanh Tâm? Khi nó gặp dầu nóng sẽ tỏa ra mùi thơm, đậm đặc gấp mấy lần khi lạnh, mùi thơm của thịt sẽ bị át mất đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010415
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 110010415,
					"content": "Tôi biết, nhưng Hoa Thanh Tâm không phải hương liệu của thịt sườn, mà là món ăn kèm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010416
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110010416,
					"content": "Tôi từng thử qua, chỉ cần độ lửa thích hợp, cánh hoa Thanh Tâm được chiên qua dầu sẽ mất đi vị đắng, trở thành món ăn nhẹ giòn tan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010417
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110010417,
					"content": "Sau đó lựa chọn ớt Tuyệt Vân mọc ở trên núi cao. Độ ẩm thấp và chênh lệch nhiệt độ cao, khiến nó có thể có mùi vị thơm ngon đặc biệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010418
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110010418,
					"content": "Vị mặn của muối biển, cay của ớt Tuyệt Vân, mùi thơm của mỡ thịt sườn, tụ lại trên cánh hoa, khi ăn vào còn có hương thơm thanh mát của thực vật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010419
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110010419,
					"content": "Nói linh tinh, làm vậy chẳng phải sẽ làm mất đi vị của món chính sao?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010420
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 110010420,
					"content": "Thịt nướng là thịt nướng, mùi thơm của thịt bị át mất rồi thì còn ăn gì nữa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010421
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 110010421,
					"content": "Ấy ấy, đừng cãi nhau, đừng cãi nhau mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010422,
						110010423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110010422,
					"content": "Đã không còn nghe được người khác nữa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110010424
					]
				},
				{
					"id": 110010424,
					"content": "Hừ, nếu như vậy, vấn đề nấu nướng thì hãy để nấu nướng giải quyết!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010425
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110010425,
					"content": "Tôi phải thi thố tài nghệ nấu nướng với bạn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010426
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110010426,
					"content": "Không thành vấn đề, nếu đến cả món ăn của tôi cũng không thắng được, thì chứng minh rằng Draff đã nhìn sai người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010427
					],
					"speakerTitle": "Brook"
				},
