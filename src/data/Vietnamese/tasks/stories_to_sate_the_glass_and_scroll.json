			"dialogs": [
				{
					"id": 700740901,
					"content": "Không thể tin được... Hilichurl lại dễ nói chuyện thế à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740902
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700740902,
					"content": "Ella! Em có thấy Varka không!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740903,
					"content": "Ừm, vừa nãy ngài ấy nói là sẽ đi mượn nồi của Hilichurl... Thế rồi Hilichurl vừa thấy ngài ấy liền đưa nồi ra ngay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740904
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700740904,
					"content": "Rõ ràng cũng chẳng nói mấy câu, sao lại suôn sẻ thế nhỉ? Chẳng lẽ Đại Đội Trưởng còn nắm được ngôn ngữ cơ thể của Hilichurl mà em không biết sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740905,
						700740906
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700740905,
					"content": "Chắc đó không phải là giao tiếp đâu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740907
					]
				},
				{
					"id": 700740907,
					"content": "...Đó không phải là trọng tâm! Bây giờ Varka đang ở đâu thế?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740908
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740908,
					"content": "À... Ở ngay đằng kia kìa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740909
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700740909,
					"content": "Cuối cùng... cũng xong rồi! Loại rượu ngon nhất Teyvat! Ngay lúc này, ngay trong tay mình!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740910
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740910,
					"content": "Varka...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740911
					]
				},
				{
					"id": 700740911,
					"content": "Ồ? Cuối cùng hai người cũng tới rồi à? Mấy Hilichurl đó khá hiểu chuyện, tiến độ pha chế nhanh hơn tưởng tượng đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740912
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740912,
					"content": "Đến lúc thưởng thức rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740913
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740913,
					"content": "...Đừng uống vội!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740914
					]
				},
				{
					"id": 700740914,
					"content": "Hửm? Hai người muốn nếm thử ly đầu tiên sao? Haha... vinh dự uống ly đầu tiên này, tôi tuyệt đối không nhường đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740915
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740915,
					"content": "Không phải chuyện đó!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740916
					]
				},
				{
					"id": 700740916,
					"content": "Yên tâm đi! Tôi sẽ để lại một ít cho cả hai mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740917
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740917,
					"content": "Ực... ực... Ha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740918
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740918,
					"content": "Hửm? Sao cảm giác... hơi... tệ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740919
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740919,
					"content": "Varka! Anh không sao chứ? Varka? Varkaaa!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740920,
						700740921
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740920,
					"content": "...Đại Đội Trưởng!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740922
					]
				},
				{
					"id": 700740922,
					"content": "Này! Đã đánh bại cả thần rồi mà lại gục ngã ở đây thì thành cái gì chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740923
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740923,
					"content": "Ugh... Agh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740924
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740924,
					"content": "...Cảm giác như trong khoảnh khắc ấy, tôi đã thấy hết các đời Kỵ Sĩ Bắc Phong trước đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740925,
						700740926
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740925,
					"content": "Không biết nên nói anh gục ngã ở đây là tốt...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740927
					]
				},
				{
					"id": 700740927,
					"content": "Để tôi tiêu hóa một chút đã... Dù là ly rượu vừa nãy hay là bài học xương máu này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740928
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740928,
					"content": "Giải thích cho Varka về chúc phúc \"chắc chắn pha được rượu ngon\" của Diona...\\nChỉ có qua tay cô ấy, những nguyên liệu kỳ lạ mới có thể biến thành rượu ngon...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						700740929
					]
				},
				{
					"id": 700740929,
					"content": "Hóa ra là thế... Nguyên liệu còn thiếu, thực ra là lời chúc phúc của Tinh Linh Suối sao... Haha, thật không thể tin được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740930
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740930,
					"content": "Này, đừng tỏ ra thoải mái như chẳng có gì xảy ra thế chứ! Tôi còn chưa tính sổ chuyện anh lừa chúng tôi đâu đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740931
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740931,
					"content": "Xin lỗi, xin lỗi... Tôi thực sự nghĩ là công thức này không có vấn đề gì, còn định pha xong thì sẽ vừa uống vừa giải thích với hai người nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740932
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740932,
					"content": "Giờ thì... chắc hai người cũng không muốn uống đâu nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740933,
						700740934
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740933,
					"content": "Thôi thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740935
					]
				},
				{
					"id": 700740935,
					"content": "Ừm... Vậy rượu lần này coi như tôi nợ hai người nhé. Lần sau để tôi mời cả hai một bữa ở quán Người Săn Hươu nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740936
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740936,
					"content": "Mời ăn à? Thế còn được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740937
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740937,
					"content": "Paimon cũng dễ bị mua chuộc quá đấy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740938
					]
				},
				{
					"id": 700740938,
					"content": "#Ừm... {NICKNAME} thấy đấy, anh ta uống ly rượu đó xong là khó chịu lâu như vậy, cũng coi như học được một bài rồi mà?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740939
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740939,
					"content": "Hah, tôi tự chuốc lấy thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740940,
						700740941
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740940,
					"content": "Nhưng mà \"bài tập\" trống không của anh...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740942
					]
				},
				{
					"id": 700740942,
					"content": "Haha, tôi định là sẽ kể cho vui khi nhâm nhi rượu, giờ thì chỉ đành kể với gió thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740943
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740943,
					"content": "...Đặt ra một bộ \"bài tập\" cho mọi người ở Mondstadt ư? Ý tưởng hay đấy, cho tôi một bài được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740944
					],
					"speakerTitle": "Varka"
				},
				{
