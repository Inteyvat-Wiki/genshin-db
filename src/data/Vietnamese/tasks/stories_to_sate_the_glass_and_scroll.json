			"dialogs": [
				{
					"id": 700740501,
					"content": "Này! Mọi người làm lũ bồ câu... sợ hãi... bay đi hết rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740502
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 700740502,
					"content": "...Đại... Đại Đội Trưởng?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740503
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 700740503,
					"content": "Ồ? Là Timmie đây mà? Trông cao lớn hơn nhiều đấy? Có ăn uống đầy đủ không đó?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740504
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740504,
					"content": "Có... có ạ! Cháu luôn nhớ lời chú nói mà! Muốn trở thành một người đàn ông rắn rỏi thì phải ăn uống đầy đủ! Tập luyện chăm chỉ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740505,
						700740506
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 700740505,
					"content": "Thái độ của cậu nhóc này...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740507
					]
				},
				{
					"id": 700740507,
					"content": "Chịu thôi... Tôi nghĩ trong thành phố này chắc chẳng có đứa trẻ nào lại không thần tượng những truyền thuyết đương đại của Đội Kỵ Sĩ Tây Phong đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740508,
					"content": "Xin lỗi nhé, chú làm lũ bồ câu của cháu bay mất rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740509
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740509,
					"content": "Chú cũng muốn hỏi, có cách nào tiếp cận chim bồ câu mà không làm chúng giật mình... lại còn giữ cho chúng luôn vui vẻ không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740510
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740510,
					"content": "Hmm... Bình thường thì cháu sẽ lặng lẽ đến bên chúng, rồi rắc thức ăn xuống...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740511
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 700740511,
					"content": "...Đúng rồi! Chính là như thế! Cháu còn thừa thức ăn không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740512
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740512,
					"content": "Thức ăn thì vẫn còn khá nhiều... Nhưng mà... Đại Đội Trưởng... Ừm... Chú định...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740513
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 700740513,
					"content": "Yên tâm đi, hứa với cháu... Chú chỉ mượn vài cọng lông của chúng thôi. Đây là lời hứa giữa những người trưởng thành nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740514
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740514,
					"content": "À... Vâng ạ! Cảm ơn Đại Đội Trưởng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timmie"
				},
				{
					"id": 700740506,
					"content": "Hoàn toàn khác với lúc trước!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740507
					]
				}
			]
		},
