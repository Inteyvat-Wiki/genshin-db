					"speakerTitle": "Bồ Câu"
				},
				{
					"id": 700740802,
					"content": "Lông vũ! Tôi lấy được rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740803
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740803,
					"content": "Cuối cùng cũng lấy được rồi, bài tập này khó hơn tôi nghĩ nhiều đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740804,
					"content": "Chỉ còn một bước nữa thôi... \"Thuốc đun trong nồi lớn\", nếu tôi nhớ không nhầm thì là ở Hẻm Núi Dadaupa nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740805
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740805,
					"content": "Tôi đi trước, hai người mau đi theo nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740806
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740806,
					"content": "Này... Hăng hái quá vậy? Chạy còn nhanh hơn bay à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740807,
						700740808
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740807,
					"content": "Đúng là người tự do như gió...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740809
					]
				},
				{
					"id": 700740809,
					"content": "...Cái ông chú nghiện rượu đó...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740810
					],
					"speakerTitle": "Diona"
				},
				{
					"id": 700740810,
					"content": "Hmm? Ai ở đó thế?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740811
					]
				},
				{
					"id": 700740811,
					"content": "...Á!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740812
					],
					"speakerTitle": "Diona"
				},
				{
					"id": 700740812,
					"content": "Diona? Sao cô lại ở đây? Còn cố tình trốn nữa chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740813,
					"content": "Tôi... tôi chỉ ra ngoài hái ít trái cây thôi, ai ngờ lại đột nhiên gặp ông chú đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740814
					],
					"speakerTitle": "Diona"
				},
				{
					"id": 700740814,
					"content": "Gần đây ông chú đó cứ bám lấy tôi mãi, muốn tôi pha lại loại rượu lần trước... Tôi thấy phiền quá trời, đành phải trốn khắp nơi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740815
					],
					"speakerTitle": "Diona"
				},
				{
					"id": 700740815,
					"content": "Rượu lần trước... là sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740816
					]
				},
				{
					"id": 700740816,
					"content": "Thì ông chú mới cùng đội viễn chinh trở về mà? Thế là đến Quán Rượu Đuôi Mèo uống rượu mừng công...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740817
					],
					"speakerTitle": "Diona"
				},
				{
					"id": 700740817,
					"content": "Quán Rượu Đuôi Mèo sao? Tôi tưởng sẽ tổ chức ở Đội Kỵ Sĩ chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740818
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740818,
					"content": "Tôi còn tưởng họ sẽ đến Quà Tặng Của Thiên Sứ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740819
					]
				},
				{
					"id": 700740819,
					"content": "Ừm... Họ đã đến đó rồi, Quán Rượu Đuôi Mèo là tăng ba rồi đấy! Họ định đến tất cả quán rượu trong thành phố luôn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740820
					],
					"speakerTitle": "Diona"
				},
				{
					"id": 700740820,
					"content": "...Tôi nghi là khi đợt quân viễn chinh tiếp theo trở về, bọn họ sẽ lại lấy cớ đó để uống thêm một vòng nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740821
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740821,
					"content": "Tôi không nghi ngờ gì về chuyện đó cả.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740822
					]
				},
				{
					"id": 700740822,
					"content": "...Tóm lại! Tôi thực sự không thể chịu nổi bộ dạng của mấy ông chú say xỉn đó! Nên muốn pha một ly khó uống kinh khủng để họ tỉnh táo lại!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740823,
						700740824
					],
					"speakerTitle": "Diona"
				},
				{
					"id": 700740823,
					"content": "Nhưng không phải là cô...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740825
					]
				},
				{
					"id": 700740825,
					"content": "Đúng vậy! Nên lúc đầu tôi định nhờ Tiểu Hoàng Tử pha hộ... Ai ngờ mấy người đó vừa uống say là muốn trêu Tiểu Hoàng Tử.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740826
					],
					"speakerTitle": "Diona"
				},
				{
					"id": 700740826,
					"content": "...Nên Tiểu Hoàng Tử chưa kịp pha xong thì đã bỏ chạy rồi. À, tiện thể còn cào cho ông chú say xỉn đó một phát nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740827
					],
					"speakerTitle": "Diona"
				},
				{
					"id": 700740827,
					"content": "(Vết sẹo mà Varka nói... chẳng lẽ chính là...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740828
					]
				},
				{
					"id": 700740828,
					"content": "\"Vì nó mà tôi đã thâm nhập vào một bí {RUBY#[D]quán rượu}cảnh hỗn loạn, chiến đấu với những ma {RUBY#[D]Tiểu Hoàng Tử}vật hung tợn nhất...!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740829
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740829,
					"content": "...Tôi nhìn ly đồ uống pha sắp xong, nghĩ là chỉ còn thiếu chút nữa thôi, liệu có phải...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740830
					],
					"speakerTitle": "Diona"
				},
				{
					"id": 700740830,
					"content": "Cuối cùng thì vẫn phải tự tay hoàn thành bước cuối sao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740831
					]
				},
				{
					"id": 700740831,
					"content": "Đúng thế...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740832,
						700740833
					],
					"speakerTitle": "Diona"
				},
				{
					"id": 700740832,
					"content": "Tôi có hơi tò mò...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740834
					]
				},
				{
					"id": 700740834,
					"content": "Ừm, có mảnh gỗ dính trên người các kỵ sĩ, lông chim bồ câu nhặt trong rừng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740835
					],
					"speakerTitle": "Diona"
				},
				{
					"id": 700740835,
					"content": "Còn loại cuối cùng, vốn là để giải rượu... Canh thảo dược của Hilichurl...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740836
					],
					"speakerTitle": "Diona"
				},
				{
					"id": 700740836,
					"content": "#{NICKNAME}... Varka vừa về không lâu... Có khi nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740837,
						700740838
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740837,
					"content": "Vẫn chưa ai nói với anh ấy là những nguyên liệu này...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740839
					]
				},
				{
					"id": 700740839,
					"content": "Ôi trời... sắp có chuyện lớn rồi! Mau ngăn anh ta lại đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740838,
					"content": "Chỉ có Diona mới pha ra được!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740839
					]
				},
				{
					"id": 700740833,
					"content": "Cô đã cho thêm gì vào đó vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740834
					]
				},
				{
					"id": 700740824,
					"content": "Pha gì cũng ngon sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740825
					]
				},
				{
					"id": 700740808,
					"content": "Muốn uống rượu lắm rồi đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740809
					]
				}
			]
		},
