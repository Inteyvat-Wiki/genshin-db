			"dialogs": [
				{
					"id": 700740201,
					"content": "...Nói đến \"mảnh gỗ bị kỵ sĩ đánh vỡ\", quả nhiên là ở đây nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740202,
					"content": "A! Đại Đội Trưởng! Kỵ Sĩ Danh Dự! Hôm nay mọi người cũng đến đây luyện tập à?",
					"roleType": "TALK_ROLE_NPC",
