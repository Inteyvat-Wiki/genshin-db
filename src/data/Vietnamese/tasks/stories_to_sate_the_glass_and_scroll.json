			"dialogs": [
				{
					"id": 700740101,
					"content": "Kể ra thì, rõ ràng là cuộc \"hội đàm\" mà Varka cùng các ma nữ khởi xướng, nhưng sao chúng ta chẳng chú ý đến bài tập của chính anh ta nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740102,
					"content": "Để tôi tìm xem nào... Varka, Varka... Ủa? Sao lại là... một dòng trống thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740103,
					"content": "Hay là tìm anh ta hỏi trực tiếp luôn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740104
					]
				},
				{
					"id": 700740104,
					"content": "Cũng đúng nhỉ... Tôi thấy là tới quán rượu với nhà hàng thì dễ tìm được anh ta hơn đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740105,
					"content": "...Cũng không có ở đây à? Xem ra đành phải tự nghĩ cách thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740106
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740106,
					"content": "Vừa nhắc đến là xuất hiện luôn rồi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740107
					]
				},
				{
					"id": 700740107,
					"content": "Này! Varka! Chúng tôi muốn hỏi về \"bài tập\" của anh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740108,
					"content": "Ồ? Kỵ Sĩ Danh Dự và Paimon! Bài tập...? Sao đột nhiên lại hỏi chuyện này thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740109,
						700740110
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740109,
					"content": "Hội Ma Nữ đã chuẩn bị bài tập cho mọi người...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740111
					]
				},
				{
					"id": 700740111,
					"content": "Bài tập... Bài tập... À, hình như đúng là có nghe Alice nhắc đến chuyện này nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740112
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740112,
					"content": "...Nhờ buổi \"hội đàm\" của anh nên mới có bài tập này còn gì?! Thôi được rồi... Vậy nói xem nào, sao bài tập của anh lại là dòng trống thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740113,
					"content": "... Ừm, chắc là vì bài tập của tôi quá nặng nề đối với cuốn sổ đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740114,
						700740115
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740114,
					"content": "Anh nói vậy làm tôi thấy tò mò đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740116
					]
				},
				{
					"id": 700740116,
					"content": "Bài tập là... pha chế ra loại rượu ngon nhất Teyvat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740117
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740117,
					"content": "...Thế này thì \"nặng nề\" ở đâu hả!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740118,
					"content": "Đừng coi thường bài tập này nhé. Vết sẹo mới trên cánh tay tôi chính là vì lấy công thức pha chế nên mới xuất hiện đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740119
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740119,
					"content": "Vì nó mà tôi đã thâm nhập vào một bí cảnh hỗn loạn, chiến đấu với những ma vật hung tợn nhất...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740120
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740120,
					"content": "Thật hay giả vậy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740121
					]
				},
				{
					"id": 700740121,
					"content": "Giờ chỉ còn thiếu ba nguyên liệu đặc biệt nữa là thành công rồi! Kỵ Sĩ Danh Dự, Paimon, hai người có thể giúp tôi một tay không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740122
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740122,
					"content": "Được rồi, nếu chỉ còn thiếu ba thứ thôi... thì cứ coi như bị anh lừa vậy, tôi sẽ đi cùng anh một chuyến!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740123,
					"content": "Được, nguyên liệu cần thu thập còn có: \"Mảnh gỗ bị kỵ sĩ đánh vỡ\", \"lông bồ câu vui vẻ rụng xuống\", \"thuốc đun trong nồi lớn\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740124
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740124,
					"content": "Đây là pha chế rượu á hả?! Nghe như là đang luyện loại ma dược đáng ngờ nào đó ấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740125,
					"content": "Ừm... Nói sao nhỉ, suy cho cùng thì đây là bài tập của các ma nữ mà, haha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740126
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740126,
					"content": "Để đảm bảo tái hiện hoàn hảo công thức rượu, cả ba nguyên liệu đều phải đáp ứng yêu cầu nghiêm ngặt. Trước tiên hãy đến nơi có thể lấy được mảnh gỗ đã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740115,
					"content": "Có bài tập gì thú vị thì kể cho tôi nghe đi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740116
					]
				},
				{
					"id": 700740110,
					"content": "Nhưng phần của anh hình như lại trống trơn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740111
					]
				}
			]
		},
