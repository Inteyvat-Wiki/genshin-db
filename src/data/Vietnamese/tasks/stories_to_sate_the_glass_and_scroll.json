					"speakerTitle": "Ellin"
				},
				{
					"id": 700740402,
					"content": "...Dừng lại thôi! Câu này tôi nghe phát chán luôn rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740403,
					"content": "Ừm... Mảnh gỗ này... về hình dáng hay kết cấu đều rất giống... chất lượng khá tốt đấy!",
					"roleType": "TALK_ROLE_NPC",
