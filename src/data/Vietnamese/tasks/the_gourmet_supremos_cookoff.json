	"talks": [
		{
			"id": 2202101,
			"completionStepIds": [
				2202101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
