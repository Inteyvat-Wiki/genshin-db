			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xudong",
					"Kamei Munehisa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220210101,
					"content": "Món này của tôi ngon lắm, chú chuẩn bị chịu thua đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210102
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210102,
					"content": "Món này của tại hạ cũng rất ngon, các hạ phải chuẩn bị sẵn tâm lý đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210103
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210103,
					"content": "Mọi người đang làm gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210104
					]
				},
				{
					"id": 220210104,
					"content": "Là nhà lữ hành sao. Là vầy, Parvaneh và Julie ra ngoài tìm nguyên liệu nấu ăn rồi, chúng tôi ban đầu định đợi họ về rồi mới nấu ăn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210105
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210105,
					"content": "Nhưng khi tôi và chú Munehisa bàn luận xem nên làm món gì thì có chút bất đồng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210106
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210106,
					"content": "Cho nên tôi và chú Munehisa quyết định mỗi người chọn ra một món để so tài, tiện cho việc quyết định bữa ăn hôm nay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210107
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210107,
					"content": "Tôi dự định chọn món \"Canh Trân Châu Phỉ Thúy Bạch Ngọc\" nổi tiếng của Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210108
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210108,
					"content": "Tại hạ sẽ chuẩn bị món \"Xiên Que Ba Vị\" mà tại hạ hay ăn khi còn trong quân ngũ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210109,
						220210111
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210109,
					"content": "Có cần giúp gì không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210110
					]
				},
				{
					"id": 220210110,
					"content": "Hừm, nếu như bạn rảnh thì có thể làm trọng tài giúp chúng tôi được không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210113
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210113,
					"content": "Nhưng mỗi bên chúng tôi chỉ có một người, rồi mỗi món lại phải làm thành bốn phần, nói không chừng sẽ có chút bận rộn đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210114
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210114,
					"content": "Trước khi chấm kết quả thì chắc phải nhờ bạn đi chuẩn bị món ăn giúp chúng tôi rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210115
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210115,
					"content": "Đương nhiên, bạn chỉ có một mình, nên bạn cứ chọn một trong hai món bạn thích để giúp là được rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210116,
						220210119
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210116,
					"content": "Xudong, bạn làm kịp không đấy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210117
					]
				},
				{
					"id": 220210117,
					"content": "Bạn không cần phải lo cho tôi, dạo trước tôi có mở quán ăn ở Liyue, nên việc chuẩn bị bữa ăn đối với tôi mà nói không thành vấn đề.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210118
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210118,
					"content": "Nhưng mà, nếu như có người giúp đỡ thì món đó sẽ tinh tế hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210122
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210122,
					"content": "Nói chung, bạn cứ chọn một món bạn thích để giúp đỡ là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210123,
						220210126
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210123,
					"content": "Xudong, tôi chọn bên của bạn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210124
					]
				},
				{
					"id": 220210124,
					"content": "Ồ! Hay quá, chú Munehisa, chuẩn bị sẵn tinh thần đi nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210125
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210125,
					"content": "Tại hạ sẽ không chịu thua dễ vậy đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210126,
					"content": "Chú Munehisa, tôi chọn bên của chú.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210127
					]
				},
				{
					"id": 220210127,
					"content": "Đa tạ các hạ. Xudong, các hạ cẩn thận đấy nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210128
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210128,
					"content": "Không thành vấn đề, chú cứ trổ hết tài nghệ ra đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210119,
					"content": "Chú Munehisa, chú có làm kịp không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210120
					]
				},
				{
					"id": 220210120,
					"content": "Các hạ cứ tự chọn món theo ý thích là được rồi. Lúc còn ở Shogunate, tôi cũng thường xuyên phải chuẩn bị bữa ăn cho anh em trong đội, giờ chỉ chuẩn bị bốn phần thì không thành vấn đề đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210121
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210121,
					"content": "Nhưng nếu như có các hạ giúp sức thì món ăn của tôi sẽ ngon miệng hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210122
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210111,
					"content": "Các bạn chắc là đang thiếu trọng tài nhỉ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210112
					]
				},
				{
					"id": 220210112,
					"content": "Ha ha ha, còn không phải sao, chúng tôi đang thiếu trọng tài để phân cao thấp đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210113
					],
					"speakerTitle": "Xudong"
				}
			]
		},
		{
			"id": 2202102,
			"completionStepIds": [
				2202109
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2202109",
							"2"
						],
						"stepId": 2202109,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xudong",
					"Kamei Munehisa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220210201,
					"content": "Xong rồi, cảm ơn nhà lữ hành. Mùi vị này thật tuyệt vời.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210202
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210202,
					"content": "Để tôi nếm thử...Chẹp, ngon đấy, rất đủ độ lửa, mùi vị ngon lành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210203
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210203,
					"content": "Có thể nói là một món \"Canh Trân Châu Phỉ Thúy Bạch Ngọc Hoàn Mỹ\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210204
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210204,
					"content": "Được rồi, chú Munehisa, món ăn bên chú thế nào rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210205
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210205,
					"content": "Chậc, thật thất lễ. Khi bắt đầu mới phát hiện chưa có Trứng Chim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210206
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210206,
					"content": "Tuy tại hạ lập tức đi vào rừng để tìm, nhưng những nguyên liệu còn lại đều đã qua giai đoạn ngon nhất rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210207
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210207,
					"content": "Món \"Xiên Que Ba Vị\" này nếu như thiếu đi độ chuẩn thì đã không thể xem là món ngon nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210208
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210208,
					"content": "Không ngờ lại thành ra vậy, thật xấu hổ quá, so về tài làm bếp thì chắc tôi còn phải tập luyện thêm nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210209
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210209,
					"content": "Lần so tài này tôi thua rồi. Nhưng lần sau tôi nhất định sẽ thắng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210210,
						220210214
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210210,
					"content": "Cố lên nhé chú Munehisa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210211
					]
				},
				{
					"id": 220210211,
					"content": "Hì hì, tôi cũng không phải người háo thắng thế đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210212
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210212,
					"content": "Đúng rồi, nhà lữ hành, tôi có món này cho bạn, cảm ơn bạn về chuyện này nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210213
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210213,
					"content": "Lần quyết đấu sau bạn nhất định phải đến nữa đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210214,
					"content": "Thực ra tôi cảm thấy mùi vị cũng ngon mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210215
					]
				},
				{
					"id": 220210215,
					"content": "Không, cho dù là nấu ăn thì cũng phải đòi hỏi sự tinh tế, không ngừng trau dồi rèn luyện, không thể tự mãn mà nói chữ \"cũng\" được.",
