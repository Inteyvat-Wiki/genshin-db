					"nextDialogs": [
						220210219
					]
				},
				{
					"id": 220210219,
					"content": "Dù là đạo luyện võ hay là đạo làm bếp, đều là đạo làm người của tại hạ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210220
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210220,
					"content": "À ừm...Hay lắm! Chú cố lên nhé...Ha ha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210221
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210221,
					"content": "À...ừm, tôi không biết cách để nói chuyện với một người nghiêm túc như vậy...Chỉ có Julie mới tiếp được chú ấy thôi, nhưng cô ấy lại không ở đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210222
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210222,
					"content": "Nghe thật hoành tráng...",
