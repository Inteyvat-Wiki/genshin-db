			"dialogs": [
				{
					"id": 745260401,
					"content": "#A, là {NICKNAME}, {F#cô}{M#cậu} đến rồi à.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745260402,
						745260403
					],
					"speakerTitle": "Nilou"
				},
				{
					"id": 745260402,
					"content": "Nilou đang luyện tập sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745260404
					]
				},
				{
					"id": 745260404,
					"content": "Không đâu. Tôi đang lên ý tưởng cho một điệu múa mới, cảm hứng đến từ Padisarah sau cơn mưa trời lại sáng, trên cánh hoa vẫn còn đọng những giọt sương.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745260405
					],
					"speakerTitle": "Nilou"
				},
				{
					"id": 745260405,
					"content": "Nhưng hiện giờ mới chỉ là sơ khai thôi, rất nhiều động tác vẫn chưa đủ uyển chuyển, cứ cảm thấy thiếu chút gì đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745260406,
						745260407
					],
					"speakerTitle": "Nilou"
				},
				{
					"id": 745260406,
					"content": "Nghe mô tả thôi đã thấy đẹp rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745260408
					]
				},
				{
					"id": 745260408,
					"content": "Chụp hình cho tôi sao? Nhưng như tôi vừa nói đó, điệu múa này tôi vẫn chưa thành thạo lắm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745260409,
						745260410
					],
					"speakerTitle": "Nilou"
				},
				{
					"id": 745260409,
					"content": "Luyện tập trước khi hoàn thiện điệu múa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745260411
					]
				},
				{
					"id": 745260411,
					"content": "#Ừm, tôi hiểu rồi! Vậy tôi sẽ gửi gắm tâm tư vào từng bước nhảy... Hãy dùng ống kính của {F#cô}{M#cậu} để bắt trọn khoảnh khắc đóa hoa nở rộ nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nilou"
				},
				{
					"id": 745260410,
					"content": "Cũng là một phần của nghệ thuật.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745260411
					]
				},
				{
					"id": 745260407,
					"content": "Để tôi chụp một tấm nhé?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745260408
					]
				},
				{
					"id": 745260403,
					"content": "Tôi không làm phiền đấy chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745260404
					]
