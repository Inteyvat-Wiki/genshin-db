					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721490201,
					"content": "#Chào mừng trở lại, {NICKNAME}. Cho hỏi có chuyện gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490202
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490202,
					"content": "Về ủy thác của bạn...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721490203
					]
				},
				{
					"id": 721490203,
					"content": "Chúng tôi đã lấy được 4 viên \"Ngự Linh Châu\" rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721490204,
					"content": "Vậy sao? Thật sự cám ơn, bạn đúng là người đáng tin cậy đó! Vậy tiếp theo chỉ còn một bước nữa để phá giải \"Tim\" - phong ấn cuối cùng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490205
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490205,
					"content": "Tiếp đến vẫn phải phiền hai bạn cùng đi với tôi, mong rằng bạn không để bụng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490206
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490206,
					"content": "#Nếu đã đến đây thì chúng tôi cũng không ngại đi thêm vài bước nữa đâu, đúng không, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490207,
						721490208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721490207,
					"content": "Được rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721490209
					]
				},
				{
					"id": 721490209,
					"content": "Vậy chúng ta đi ngay đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490208,
					"content": "Tôi sao cũng được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721490209
					]
				}
			]
		},
