			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jeht"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733270101,
					"content": "#{NICKNAME}?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270102
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270102,
					"content": "Còn có Paimon nữa! Thật không ngờ lại gặp được mọi người ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270103
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270103,
					"content": "Jeht! Đúng là cô rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733270104,
					"content": "Haha, khẽ một chút! Cá của tôi sợ chạy hết rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270105
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270105,
					"content": "Bíp bíp!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270106
					],
					"speakerTitle": "Benben"
				},
				{
					"id": 733270106,
					"content": "Cô đang câu cá sao? Nhưng tôi không thấy cần câu đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733270107,
					"content": "Bíp...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270108
					],
					"speakerTitle": "Benben"
				},
				{
					"id": 733270108,
					"content": "#Benben, không được nói huyên thuyên. {NICKNAME}, chúng ta nói chuyện khác đi nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270109,
						733270121
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270109,
					"content": "Cần câu của cô?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733270110
					]
				},
				{
					"id": 733270110,
					"content": "#{F#Cô}{M#Cậu}...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270111
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270111,
					"content": "Nó... hỏng rồi... hihi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270112
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270112,
					"content": "Haiz... Tôi không ngờ được là câu cá và săn bắt không giống nhau chút nào... Khó, quá khó! Tôi không đủ kiên nhẫn để ngồi đây đợi cá cả ngày... thà xuống hồ dùng tay bắt còn hơn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270113
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270113,
					"content": "Kết quả là không bắt được con nào đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733270114,
					"content": "#Hừm, đương nhiên là bắt được rồi, lại còn là một con siêu to, dài hơn cả {F#cô}{M#cậu} nữa... Ừm, chiều dài bằng {F#cô}{M#cậu} với một nửa Benben cộng lại đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270115
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270115,
					"content": "Bíp bíp! Bíp bíp!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270116
					],
					"speakerTitle": "Benben"
				},
				{
					"id": 733270116,
					"content": "#Tôi nướng ăn hết rồi, không có phần của {F#cô}{M#cậu} đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270117
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270117,
					"content": "Bíp bíp...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270118
					],
					"speakerTitle": "Benben"
				},
				{
					"id": 733270118,
					"content": "#Ừm, ăn cùng Benben nữa, chỉ là không có phần của {F#cô}{M#cậu}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270119
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270119,
					"content": "Tôi không tin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733270120,
					"content": "#Haha! Không tin thì tùy {F#cô}{M#cậu} thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270125
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270125,
					"content": "Dạo này cô thế nào?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733270126
					]
				},
				{
					"id": 733270126,
					"content": "#Ừm? Vẫn rất tốt, {F#cô}{M#cậu} không cần quan tâm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270127
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270127,
					"content": "Dù gì thì cũng không phải đi một mình lần đầu mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270128
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270128,
					"content": "Bíp bíp! Bíp bíp!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270129
					],
					"speakerTitle": "Benben"
				},
				{
					"id": 733270129,
					"content": "Haha, đừng nóng! Ta biết vẫn còn có ngươi mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270130
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270130,
					"content": "Sau sự việc ở Tanit, các bộ tộc ở sa mạc không cung cấp cho tôi lều và thực phẩm... Tôi không nhận được sự bảo vệ của bộ tộc nữa rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270131
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270131,
					"content": "Sau đó... tuy đại ca Rukh Shah của \"Lữ Đoàn 30\" đồng ý nhận tôi, nhưng mà... ở trong thành khiến tôi không thoải mái và nhớ đến mẹ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270132
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270132,
					"content": "Vậy nên tôi rời thành Sumeru và nghĩ... hay là đi đến một quốc gia khác, xem cảnh vật mà mình chưa từng thấy qua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270133
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270133,
					"content": "Nên tôi đã lên thuyền buôn, chả mấy chốc mà đến được đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270134
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270134,
					"content": "Tiếp đó thì... Haha, thì không có gì đáng để kể nữa! Ở đâu cũng cần bảo tiêu mà, nhất là các nhóm thương nhân đến thành phố lớn! Giờ cuộc sống của tôi cũng không tệ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270135
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270135,
					"content": "Hihi, chỉ có vậy... Ngày tháng phiêu bạt bốn phương làm nhà cũng thích lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270136
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270136,
					"content": "#Tôi với Benben chẳng phải cũng như {F#cô}{M#cậu} và Paimon sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270137
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270137,
					"content": "Hừm, Benben thì làm sao giống tôi được chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733270138,
					"content": "Bíp bíp!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270139
					],
					"speakerTitle": "Benben"
				},
				{
					"id": 733270139,
					"content": "#Haha, biết rồi... {NICKNAME}, tôi không làm phiền mọi người nữa. Vốn định mời {F#cô}{M#cậu} bữa cơm, nhưng quy định của tiêu cục thì... haiz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270140
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270140,
					"content": "#Hừm! Thôi không nói chuyện buồn nữa! Gửi đến {F#cô}{M#cậu} một nghìn cái ôm và chúc {F#cô}{M#cậu} lên đường bình an nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270141
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270141,
					"content": "#{M#Đừng quên là chúng ta rồi cũng sẽ có ngày tương ngộ đó!}{F#...Cô đừng có quên những lời mà chúng ta từng nói khi ở bộ tộc Tanit đó. Khi nào cảm thấy mệt mỏi, muốn dừng chân nghỉ ngơi thì... có lẽ chúng ta sẽ có cơ hội gặp lại nhau.}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270121,
					"content": "Không ngờ lại gặp cô ở đây.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733270122
					]
				},
				{
					"id": 733270122,
					"content": "Ừm... Tôi, tôi cũng không ngờ là gặp lại mọi người ở đây. Vui quá đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270123
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270123,
					"content": "Hihi, chúng tôi không làm phiền cô câu... à bắt cá phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733270124,
					"content": "Đừng nói nữa! Paimon nhiều chuyện thật đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270125
					],
					"speakerTitle": "Jeht"
				}
			]
		},
