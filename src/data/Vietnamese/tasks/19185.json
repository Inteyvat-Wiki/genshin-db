			"dialogs": [
				{
					"id": 191851001,
					"content": "Hình như Đội Hắc Ảnh Marechaussee chưa từng thấy những thùng gỗ này ở nhà của Pierre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851002
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 191851002,
					"content": "Trực tiếp ôm đống thùng này đến thì lộ liễu quá.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191851003
					]
				},
				{
					"id": 191851003,
					"content": "Ừm, không giống với cách hành động của Pierre... Vậy thì làm sao để vận chuyển đến đây nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851004
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 191851004,
					"content": "(Quan sát kỹ thùng gỗ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191851005
					]
				},
				{
					"id": 191851005,
					"content": "(Bên ngoài thùng gỗ có dấu vết ngâm nước, xung quanh thân thùng đều là vệt nước đã khô...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851006
					],
					"speakerTitle": "Điều Tra"
				},
				{
					"id": 191851006,
					"content": "(Những vệt nước này trông rất có quy củ, nửa trên dường như không hề có vệt nước nào.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851007
					],
					"speakerTitle": "Điều Tra"
				},
				{
					"id": 191851007,
					"content": "(Nắp thùng có vẻ không khít lắm, quanh mép có khe hở khá lớn, nhưng bên trong lại không có dấu vết bị nước xâm nhập.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851008
					],
					"speakerTitle": "Điều Tra"
				},
				{
					"id": 191851008,
					"content": "Chỉ có nửa dưới bị ngâm nước sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lynette"
				}
			]
