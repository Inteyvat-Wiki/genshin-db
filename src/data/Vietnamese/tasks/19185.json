				{
					"id": 191851106,
					"content": "Vừa nãy tôi còn phát hiện một số túi với chất liệu tương tự, nhưng chúng đều rất nhỏ và mỏng. Nhìn có vẻ kém bền hơn nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851107
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 191851107,
					"content": "Hơi giống... túi niêm phong?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191851108
					]
				},
				{
					"id": 191851108,
					"content": "Đúng là hơi giống thật. Chó Vệ Binh sẽ đánh hơi được Sinthe Giả, nếu niêm phong kín lại không chừng có thể tránh bị phát hiện trong một thời gian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851109
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 191851109,
					"content": "Vậy những chiếc túi to này dùng để làm gì nhỉ? Nếu cũng dùng để niêm phong Sinthe Giả thì sẽ quá nổi bật...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lyney"
				}
			]
		},
