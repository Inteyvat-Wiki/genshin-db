					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191851203
					]
				},
				{
					"id": 191851203,
					"content": "Trong đống chai lọ này chính là Sinthe Giả sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191851204
					]
				},
				{
					"id": 191851204,
					"content": "Không chỉ vậy, còn có nguyên liệu cần thiết để điều chế, lượng lớn chất tẩy rửa và một vài loại thuốc không rõ là gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851205
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 191851205,
					"content": "Những chất tẩy rửa này chắc là dùng để xóa dấu vết... Ví dụ như mùi hương của Sinthe Giả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851206
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 191851206,
					"content": "Trong tài liệu của Đội Tuần Tra Đặc Biệt có nhắc đến, người thường rất khó phát hiện dấu vết do Sinthe Giả để lại. Chuyện này cũng giống với trường hợp của Pierre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851207
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 191851207,
					"content": "Nếu muốn đảm bảo rửa sạch mọi thứ, chắc hẳn sẽ cần đến rất nhiều thời gian và kỹ thuật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851208
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 191851208,
					"content": "Nhưng đống thuốc còn lại dùng vào việc gì nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chevreuse"
				}
			]
