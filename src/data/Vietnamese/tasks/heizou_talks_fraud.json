			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kano Nana"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190570801,
					"content": "Xin chào Nhà Lữ Hành, em họ tôi đã gây ra không ít phiền phức cho bạn đúng không? Đứa nhóc đó có hơi cá tính chứ thật ra không có ý xấu gì đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570802
					],
					"speakerTitle": "Kano Nana"
				},
				{
					"id": 190570802,
					"content": "Nếu nó có gì mạo phạm thì xin hãy dạy dỗ nó tử tế nhé, nếu nó dám phản kháng thì cứ nói đây là lời của tôi là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kano Nana"
				}
			]
		},
		{
			"id": 1905709,
