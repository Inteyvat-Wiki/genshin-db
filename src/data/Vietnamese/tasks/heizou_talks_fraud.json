			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iba"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190570901,
					"content": "Đúng là không nên dây vào tên nhóc Heizou này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570902
					],
					"speakerTitle": "Iba"
				},
				{
					"id": 190570902,
					"content": "Hả? Hai cháu muốn biết chuyện thuở xưa của ông già này à? Chẳng có gì đáng nói cả, chỉ là một câu chuyện đơn giản mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570903
					],
					"speakerTitle": "Iba"
				},
				{
					"id": 190570903,
					"content": "Lúc đó khi nghe nói tên nhóc Heizou đang điều tra thì tôi đã biết thôi xong rồi, nên đã tự khai báo luôn cho lành, dù sao cậu ta cũng là \"Cơn Bão\" kia mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570904
					],
					"speakerTitle": "Iba"
				},
				{
					"id": 190570904,
					"content": "\"Cơn Bão\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190570905
					]
				},
				{
					"id": 190570905,
					"content": "Là một biệt danh của tên nhóc Heizou, cháu chưa nghe qua sao? Các tội phạm trong trại giam đều gọi cậu ta như vậy đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570906
					],
					"speakerTitle": "Iba"
				},
				{
					"id": 190570906,
					"content": "Chạy trốn cũng không được mà ẩn nấp cũng chẳng xong, đối với các tội phạm mà nói thì tên nhóc Heizou này giống như thiên tai, như một cơn bão vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570907
					],
					"speakerTitle": "Iba"
				},
				{
					"id": 190570907,
					"content": "Haiz, sớm biết như vậy thì lúc trước đã không làm rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iba"
				}
			]
		}
