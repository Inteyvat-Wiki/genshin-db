			"dialogs": [
				{
					"id": 190570701,
					"content": "Vô cùng xin lỗi vì ban nãy tôi đã mạo phạm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570702
					],
					"speakerTitle": "Etsu"
				},
				{
					"id": 190570702,
					"content": "À, hỏi thăm về ngài Heizou sao? Chắc là ngài ấy ghét những người như tôi lắm đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570703
					],
					"speakerTitle": "Etsu"
				},
				{
					"id": 190570703,
					"content": "Tuy ngài ấy rất kiềm chế và cư xử đúng mực, nhưng thái độ của ngài ấy lại rất khác khi đối diện với tội phạm... hình như ngài ấy rất ghét những kẻ lừa đảo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570704
					],
					"speakerTitle": "Etsu"
				},
				{
					"id": 190570704,
					"content": "Lẽ nào trước đây ngài ấy đã bị lừa qua sao? Thật không thể tin được, là người thế nào mới có thể lừa được ngài Heizou đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Etsu"
				}
			]
		},
		{
			"id": 1905708,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
