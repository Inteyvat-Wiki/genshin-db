			},
			"dialogs": [
				{
					"id": 750660301,
					"content": "Sao các vị vẫn còn ở đây...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750660302
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750660302,
					"content": "Đội trưởng đội mạo hiểm, vị anh hùng mang mặt nạ chim ưng đó đã... Chúng tôi đã không thể chống đỡ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750660303
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750660303,
					"content": "Mau đi đi, đây là vùng đất bị nguyền rủa. Dũng sĩ, đây không phải nơi mà con người nên đặt chân đến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quenin"
				}
			]
		},
