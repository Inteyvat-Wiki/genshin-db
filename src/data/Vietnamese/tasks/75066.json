					}
				]
			},
			"dialogs": [
				{
					"id": 750660401,
					"content": "#Dũng sĩ, {F#cô}{M#cậu} vẫn ở đây sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750660402
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750660402,
					"content": "Ngày xưa, có học giả nói rằng, thành chủ độc tài cổ xưa trong Thành Tro Tàn này biết cách... ngăn cản Vực Sâu xâm nhâp. Nên chúng tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750660403
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750660403,
					"content": "Nhưng đây đúng là nơi kỳ lạ đấy, dũng sĩ. Gần đây tôi cũng cảm thấy, cảm thấy có chút kỳ lạ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750660404
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750660404,
					"content": "Có lúc, con đường hôm trước vẫn còn nguyên vẹn, nhưng khi tỉnh dậy thì đã trở nên đổ nát... Những ngôi nhà bằng đá đó vốn dĩ như vậy sao? Cứ cảm thấy nó vốn sẽ hoàn chỉnh hơn một chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750660405
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750660405,
					"content": "Nhưng có lúc, khi tỉnh dậy lại nhìn thấy những người bạn vốn dĩ không nên xuất hiện nữa... Đó là ma vật sao? Chắc là vậy, là ma vật biến thành hình dạng của bạn tôi nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750660406
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750660406,
					"content": "Trách nhiệm của tôi... là tiêu diệt đám ma vật đó. Nhưng tại sao... Tại sao tôi phải làm vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750660407
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750660407,
					"content": "Tóm lại, đây là một nơi kỳ lạ. Các vị... mau rời khỏi đây đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quenin"
				}
			]
		},
