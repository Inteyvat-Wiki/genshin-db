			},
			"dialogs": [
				{
					"id": 750660501,
					"content": "Các vị mau đi đi, còn không đi thì không kịp đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750660502
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750660502,
					"content": "Tại sao không kịp nhỉ... Đúng, bởi vì, bởi vì đội mạo hiểm đã bị tiêu diệt toàn bộ. Tất cả mọi người đều... đều bị con thú đen khổng lồ đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750660503
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750660503,
					"content": "Họ bảo tôi phải bảo vệ những người sơ tán, ít nhất cũng phải để họ rời khỏi thành phố này. Cứu viện của Hội Hoa Vũ đang trên đường đến đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750660504
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750660504,
					"content": "Tôi phải tiêu diệt đám ma vật tà ác này, như vậy thì những người còn lại mới có thể trở về vùng đất của ánh sáng... Ơ, nhưng mà, tại sao tôi lại ở đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750660505
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750660505,
					"content": "Âm thanh bên tai... Ôi, âm thanh bên tai càng ngày càng nặng. Tôi... phải quay về chỗ thác nước mới được. Tôi phải... quay về chỗ thác nước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750660506
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750660506,
					"content": "Dũng sĩ, các vị cũng phải sớm rời khỏi đây đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quenin"
				}
			]
		}
	]
