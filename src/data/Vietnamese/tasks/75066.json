			"dialogs": [
				{
					"id": 750660101,
					"content": "Những thứ không phải con người này thật khó đối phó, ma vật không phải con người. Dũng sĩ à... Tôi là Quenin của đội mạo hiểm. Trách nhiệm của tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750660102
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750660102,
					"content": "Trách nhiệm của tôi... chính là tiêu diệt đám ma vật này. Đúng, tôi là chiến sĩ trong đội mạo hiểm. Hãy cẩn thận, dũng sĩ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750660103
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750660103,
					"content": "Đám ma vật này rất xảo quyệt, chúng sẽ ngụy trang thành những dáng vẻ khác nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750660104
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750660104,
					"content": "Mỗi đêm, trước khi đi ngủ đều sẽ nghe thấy... nghe thấy tiếng của chúng ẩn nấp trong phế tích cổ xưa này. Cho nên mới... không thể ngủ trong doanh trại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750660105
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750660105,
					"content": "Ở đây toàn là những con ma vật như vậy. Các vị... cũng phải cẩn thận đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quenin"
				}
			]
		},
