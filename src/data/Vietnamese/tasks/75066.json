			},
			"dialogs": [
				{
					"id": 750660201,
					"content": "Ah, nơi này quả nhiên là nơi bị nguyền rủa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750660202
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750660202,
					"content": "Các vị cũng đừng dừng chân quá lâu, mau đi đi... Đúng, trước khi thủy triều đen ập đến, các vị nhất định phải rời khỏi đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750660203
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750660203,
					"content": "Đúng, thủy triều đen, cái bóng khổng lồ đó sắp đến rồi. Phải... Phải để mọi người rời khỏi đây an toàn, phải để mọi người... rời khỏi đây an toàn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quenin"
				}
			]
		},
