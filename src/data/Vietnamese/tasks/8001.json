			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dainsleif"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80010301,
					"content": "Phù... Ngoài Giáo Đoàn Vực Sâu, Thủ Vệ Di Tích cũng hoạt động rất sôi nổi ở khu vực này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010302,
					"content": "Tôi thấy nơi Pháp Sư Vực Sâu ẩn nấp, cũng thường hay có Thủ Vệ Di Tích qua lại, đây lẽ nào là trùng hợp?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010303,
					"content": "Trên đời này không có gì là trùng hợp, tất cả đều là mầm mống được gieo từ quá khứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010304
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010304,
					"content": "Giống như sự xuất hiện của bạn trong quán rượu đó... Thời gian chỉ chờ nó đâm chồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010305,
						80010306
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010305,
					"content": "Nhưng tôi chỉ tình cờ nghe nói bạn...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010307
					]
				},
				{
					"id": 80010307,
					"content": "Không sao, chút cảm xúc không cần thiết thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010308
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010308,
					"content": "Mối liên hệ giữa Giáo Đoàn Vực Sâu và Thủ Vệ Di Tích đương nhiên không phải trùng hợp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010309
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010309,
					"content": "Phải nói đó là những nhánh cây mọc từ cùng một bộ rễ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010310
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010310,
					"content": "Bộ rễ? Nhánh cây? Ý của bạn là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010311,
					"content": "Bọn chúng đều có nguồn gốc từ một quốc gia cổ đại đã bị hủy diệt cách đây năm trăm năm - \"Khaenri'ah\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010312
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010312,
					"content": "Hả? Khaenri'ah?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010313,
					"content": "Thì ra là vậy... Giáo Đoàn Vực Sâu và Thủ Vệ Di Tích là tàn dư của Khaenri'ah sau khi bị hủy diệt sao?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010314,
					"content": "Nói đến Khaenri'ah, đó thực sự là một cái tên rất cũ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010315,
					"content": "Ừm đúng vậy. Là người hướng dẫn, để tôi giải thích cho Nhà Lữ Hành một chút. Khaenri'ah này là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010316,
					"content": "Tôi biết cái tên Khaenri'ah này.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010317
					]
				},
				{
					"id": 80010317,
					"content": "Hả...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010318,
					"content": "Bởi vì tôi có ký ức với Khaenri'ah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010319
					]
				},
				{
					"id": 80010319,
					"content": "Bạn có ký ức? Nhưng đó là đất nước đã bị hủy diệt cách đây năm trăm năm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010320,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010321
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010321,
					"content": "Cũng đúng, ai cũng có bí mật, bạn không hỏi đến chuyện thời gian của tôi, tôi cũng sẽ không hỏi bạn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010322
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010322,
					"content": "Nhưng nếu bạn đồng ý nói với tôi, tôi sẽ lắng nghe. Vậy... Khaenri'ah mà bạn đã thấy trông như thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010323,
						80010324,
						80010325,
						80010362
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010323,
					"content": "(Đã đến lúc không thể tiếp tục che giấu nữa... )",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010326
					]
				},
				{
					"id": 80010326,
					"content": "Thì ra mọi chuyện xảy ra theo trình tự như vậy... Tôi còn tưởng bạn đã gặp được vị thần lạ kia ngay từ đầu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010327,
					"content": "#Ừm...Sau khi giáng xuống thế giới này, lần thức tỉnh đầu tiên của bạn, là do {F#anh trai}{M#em gái} đánh thức từ Sao Băng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010328
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010328,
					"content": "#Xem ra {F#anh trai}{M#em gái} của bạn đã tỉnh trước bạn, chỉ là không biết sớm hơn bạn bao lâu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010329,
					"content": "#Sau đó, {F#anh trai}{M#em gái} nói với bạn chuyện Khaenri'ah diệt vong, dẫn đến chuyện trời đất thay đổi, muốn cùng bạn rời khỏi thế giới có tên Teyvat này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010330
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010330,
					"content": "#\"Khaenri'ah diệt vong\"? {F#Anh ấy}{M#Cô ấy} đã nói như vậy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010331,
						80010332
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010331,
					"content": "Đúng vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010333
					]
				},
				{
					"id": 80010333,
					"content": "Các bạn đã trải qua thảm họa đó, đó là... năm trăm năm trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010334
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010334,
					"content": "Có vẻ như lần thức tỉnh đầu tiên của bạn trên thế giới này cũng là vào thời gian đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010335
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010335,
					"content": "#Ừm...Nói như vậy, {F#anh trai}{M#em gái} của bạn, vì tỉnh dậy trước bạn nên đã hiểu rõ thế giới này nhiều hơn bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010336
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010336,
					"content": "Rồi sau đó, hai bạn đã gặp một vị thần lạ chặn đường, và không thể trốn thoát...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010337
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010337,
					"content": "Ừm, chuyện này tôi nghe quen nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010338
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010338,
					"content": "...Tôi hiểu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010339
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010339,
					"content": "Lúc đó bạn vừa thức tỉnh, lại vội vàng muốn rời khỏi thế giới này mà không hề biết gì về cái tên Khaenri'ah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010340
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010340,
					"content": "Nhưng sau khi đã biết một chút về Teyvat, chỉ đoán rằng cuộc chiến năm đó là \"cuộc chiến hủy diệt Khaenri'ah\", đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010341
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010341,
					"content": "À, có thể nói, trong mấy tháng qua chúng ta cùng nhau đi du lịch, dường như bạn đã xem rất nhiều sách cổ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010342
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010342,
					"content": "Trước khi đến Mondstadt, chỉ xem qua một số tư liệu mơ hồ, sau đó ở Mondstadt, Liyue thu thập một ít sách cổ, bạn luôn nói \"chẳng có ích gì\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010343
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010343,
					"content": "#Hóa ra bạn muốn biết thêm nhiều chuyện về Khaenri'ah là để tìm kiếm {F#anh trai}{M#em gái} sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010344,
						80010345
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010344,
					"content": "Đó là manh mối chỉ sau \"Thất Thần\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010346
					]
				},
				{
					"id": 80010346,
					"content": "Ừm, cũng phải. Muốn tìm Thất Thần, có thể đi khắp bảy nước. Nhưng Khaenri'ah, đã bị hủy diệt cách đây năm trăm năm thì không còn tìm được nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010347
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010347,
					"content": "Những chuyện về Khaenri'ah, có lẽ tôi biết nhiều hơn bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010348
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010348,
					"content": "Khaenri'ah là một nước không có thần linh. Các vị thần không chết hay bỏ đi, mà vốn dĩ không hề tồn tại trong lịch sử của Khaenri'ah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010349
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010349,
					"content": "Đây là một quốc gia hùng mạnh được xây dựng hoàn toàn bởi loài người, và loài người tự hào về sự thịnh vượng và nền văn minh huy hoàng chưa từng có của mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010350
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010350,
					"content": "Đất nước... Không tồn tại... Thần linh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010351
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010351,
					"content": "Và những gì xảy ra sau đó cũng giống như ký ức bạn có được, mọi thứ đã bị các vị thần phá hủy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010352
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010352,
					"content": "Ý của bạn là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010353
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010353,
					"content": "Năm trăm năm trước, các vị thần đã cùng đến và tiêu diệt Khaenri'ah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010354
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010354,
					"content": "Xem cái gọi là \"niềm tự hào của loài người\" như cỏ dại và xóa bỏ khỏi khu vườn của các vị thần...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010355
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010355,
					"content": "Sao lại như vậy... Lịch sử không hề nhắc đến điều này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010356,
						80010357
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010356,
					"content": "Thật quá đáng...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010358
					]
				},
				{
					"id": 80010358,
					"content": "Ừm, tiếp tục ở đây bàn luận chuyện cũ sẽ làm mất đi ý chí của con người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010359,
						80010360
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010359,
					"content": "(Nhưng lần sau khi gặp Venti và Zhongli...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010361
					]
				},
				{
					"id": 80010361,
					"content": "Cứ đi tiếp trước đã. Còn về những chuyện bạn muốn biết, trên đường đi tôi sẽ tiếp tục kể cho bạn nghe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010360,
					"content": "(E là phải nghe xem họ giải thích thế nào. )",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010361
					]
				},
				{
					"id": 80010357,
					"content": "#Thế giới này thật nguy hiểm... thật muốn nhanh chóng tìm thấy {F#anh trai}{M#em gái}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010358
					]
				},
				{
					"id": 80010345,
					"content": "Mặc dù chỉ có manh mối là \"một địa danh\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010346
					]
				},
				{
					"id": 80010332,
					"content": "Câu nói tôi nghe được là câu này.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010333
					]
				},
				{
					"id": 80010324,
					"content": "(Dain và Khaenri'ah... Xem như đánh cược vậy. )",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010326
					]
				},
				{
					"id": 80010325,
					"content": "(Người đánh thức tôi...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010326
					]
				},
				{
					"id": 80010362,
					"content": "(Còn có... biển lửa mà tôi nhìn thấy khi tỉnh dậy...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010326
					]
				},
				{
					"id": 80010306,
					"content": "Đại loại là... Không hiểu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010307
					]
				}
			]
		},
		{
			"id": 800104,
			"completionStepIds": [
				800107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800107",
							"2"
						],
						"stepId": 800107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dainsleif"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80010401,
					"content": "Haiz, lá bùa lấy được trên người Pháp Sư Vực Sâu... Lẽ nào là \"thư\" sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010402,
					"content": "Ừm, chắc chắn có liên quan đến Sứ Đồ Vực Sâu. Không ngờ lại ở trên người Pháp Sư Vực Sâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010403
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010403,
					"content": "Có lẽ, thật sự có thông tin liên quan đến hành động của bọn chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010404
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010404,
					"content": "Nhưng chữ trên này không thể đọc được, là chữ Khaenri'ah sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010405,
					"content": "#\"...Dùng tín ngưỡng của kẻ địch làm củi lửa, dâng hiến vinh quang cho {F#hoàng tử}{M#công chúa} điện hạ tôn quý...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010406
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010406,
					"content": "Hả, đây là... Nội dung trong thư?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010407,
					"content": "\"Máy dệt số phận\", kế hoạch ban đầu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010408
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010408,
					"content": "Bọn chúng... Vực Sâu, dường như đang thực hiện một kế hoạch. Từ khóa của kế hoạch là... \"Máy dệt vận mệnh\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010409
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010409,
					"content": "Có vẻ như vẫn đang trong giai đoạn khởi động, hoặc vẫn đang trong quá trình thử nghiệm ban đầu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010410
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010410,
					"content": "Máy dệt vận mệnh? Là cái gì? Theo nghĩa đen, nó giống như... \"cỗ máy dệt nên vận mệnh\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010411,
						80010412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010411,
					"content": "Pháp Sư Vực Sâu là từ di tích đó...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010413
					]
				},
				{
					"id": 80010413,
					"content": "Haiz, nói như vậy, từ bầu không khí cho thấy, di tích kỳ lạ đó rất có thể có liên quan với kế hoạch này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010414,
					"content": "Cho nên Dain, rốt cuộc trong thư nói gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010415,
					"content": "Tôi đang đọc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010416
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010416,
					"content": "Ừm... Kế hoạch gió thoảng mây bay, hơi khó hiểu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010417
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010417,
					"content": "Thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010418,
					"content": "Nói một cách dễ hiểu, kế hoạch sơ bộ có liên quan đến \"Ma Thần Lốc Xoáy\" Osial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010419
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010419,
					"content": "Ma Thần Lốc Xoáy! Là Ma Thần dưới biển sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010420,
						80010421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010420,
					"content": "Lần trước, không tiêu diệt được nó...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010422
					]
				},
				{
					"id": 80010422,
					"content": "Nhưng bọn chúng muốn làm gì Osial? Ừm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010423,
					"content": "Lẽ nào giống Dvalin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010424
					]
				},
				{
					"id": 80010424,
					"content": "Ừm, tôi từng tìm hiểu câu chuyện của các bạn, cũng biết rất rõ sự tham gia của Giáo Đoàn Vực Sâu trong Tai Họa Rồng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010425
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010425,
					"content": "Mặc dù không cố ý, nhưng thật sự các bạn đã từng ngăn cản kế hoạch tương tự của Giáo Đoàn Vực Sâu một lần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010426
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010426,
					"content": "Lúc trước là \"bầy tôi của thần\", bây giờ là \"cựu Ma Thần\" sao... Mục tiêu ngày càng lớn nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010427,
					"content": "Lần này, Vực Sâu cũng hành động giống như với Dvalin, muốn dùng những lời nói hoang đường và bùa chú hủy hoại Osial sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010428
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010428,
					"content": "Không... Xem nội dung bức \"thư\", kế hoạch lần này tiến bộ hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010429
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010429,
					"content": "Không chỉ cải tạo ý chí. Bọn chúng còn chuẩn bị dùng kỹ thuật chế tạo Máy Cày để cải tạo hoàn toàn cơ thể của Osial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010430
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010430,
					"content": "Chuyện... Chuyện như vậy cũng làm được sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010431,
					"content": "Lẽ nào Giáo Đoàn Vực Sâu muốn chế tạo... \"Cỗ máy giết người tối thượng, ma thần cơ khí hắc ám\"?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010432,
						80010433
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010432,
					"content": "Đại khái là vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010434
					]
				},
				{
					"id": 80010434,
					"content": "Ngày nay, rất ít người trên thế giới này thực sự hiểu được nền văn minh của Khaenri'ah, đương nhiên cũng khó mà đánh giá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010435
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010435,
					"content": "Chỉ có Giáo Đoàn Vực Sâu vẫn luôn tìm kiếm nền văn minh Khaenri'ah đã thất lạc, mặc dù bọn chúng không còn là loài người, nhưng chấp niệm vẫn còn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010436
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010436,
					"content": "Trong thư nói, bọn chúng phải dùng bức \"Tượng Thần Ô Uế\" kia làm cơ sở, tạo ra một ma thần cơ khí cùng với tay chân của Osial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010437
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010437,
					"content": "Là \"Lõi Mới\" dùng để thay thế viên ngọc trong tay Thần Tượng, là... \"mắt của chiếc máy cày đầu tiên trên thế giới\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010438
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010438,
					"content": "Mắt của chiếc máy cày đầu tiên trên thế giới?... Ồ! Tôi hiểu rồi, đây là thứ bọn Pháp Sư Vực Sâu kia vẫn luôn tìm kiếm đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010439
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010439,
					"content": "Có lẽ là vậy",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010440,
						80010441
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010440,
					"content": "Bọn chúng vẫn chưa tìm thấy, chúng ta vẫn còn thời gian.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010442
					]
				},
				{
					"id": 80010442,
					"content": "Càng nói càng phức tạp. Nhưng nó thật sự có liên quan đến ... Thất Thiên Thần Tượng kỳ lạ kia đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010443
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010443,
					"content": "Đúng vậy. Theo như trong thư nói, đặt \"mắt\" vào trong tay \"Tượng Thần Ô Uế\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010444
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010444,
					"content": "Vậy là có thể sinh ra một Ma Thần Ô Uế mới, ban sức mạnh \"lay chuyển thần tọa trên Đảo Thiên Không\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010445,
						80010446
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010445,
					"content": "(Đảo Thiên Không...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010447
					]
				},
				{
					"id": 80010447,
					"content": "Woa... Thứ mà kế hoạch này muốn chống lại đúng là to lớn đến không ngờ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010448
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010448,
					"content": "Kể ra bây giờ cũng không ai biết chiếc máy cày đầu tiên trên thế giới đang ở đâu, vậy chi bằng... bắt đầu điều tra từ thông tin về tượng Thần?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010449,
						80010450
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010449,
					"content": "Thần tượng đó giống như Tượng Phong Thần...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010451
					]
				},
				{
					"id": 80010451,
					"content": "Ừm, nhà thơ đi khắp nơi hát rong kia thật khó tìm, hay là đến <color=#00E1FFFF>Đại Giáo Đường Tây Phong</color> tìm hiểu tình hình xem sao, nói không chừng sẽ có gì đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010452
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010452,
					"content": "Giáo Đường... hừ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010453
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010453,
					"content": "Hả? Dain, sao vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010454
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010454,
					"content": "Không có gì, qua bên đó trước rồi nói.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010450,
					"content": "Hỏi người của Giáo Hội Tây Phong?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010451
					]
				},
				{
					"id": 80010446,
					"content": "(Lay chuyển thần tọa)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010447
					]
				},
				{
					"id": 80010441,
					"content": "Đi trước một bước, tìm thấy nó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010442
					]
				},
				{
					"id": 80010433,
					"content": "Biệt danh lại dài hơn rồi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010434
					]
				},
				{
					"id": 80010421,
					"content": "Chỉ bị Quần Ngọc Các trấn áp lần nữa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010422
					]
				},
				{
					"id": 80010412,
					"content": "Có liên quan với Thần Tượng treo ngược không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010413
					]
				}
			]
		},
		{
			"id": 800105,
			"completionStepIds": [
				800108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800108",
							"2"
						],
						"stepId": 800108,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dainsleif"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80010501,
					"content": "Nhìn bên kia, lại là Thủ Vệ Di Tích và Pháp Sư Vực Sâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010502,
					"content": "Lúc nãy Dain nói, những cỗ máy cổ kia cũng có nguồn gốc từ Khaenri'ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010503,
					"content": "Lẽ nào, Khaenri'ah có rất nhiều di tích cần được bảo vệ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010504,
					"content": "Không. Thủ Vệ Di Tích là cái tên được người hiện đại đặt theo \"ấn tượng\" của thời hiện đại. Năm trăm năm trước không ai gọi chúng như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010505
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010505,
					"content": "Những cỗ máy bây giờ được gọi là Thủ Vệ Di Tích vào thời Khaenri'ah được gọi là \"Máy Cày\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010506
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010506,
					"content": "Máy Cày? Cái tên thật lạ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010507,
						80010508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010507,
					"content": "Thì ra là dụng cụ làm ruộng sao?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010509
					]
				},
				{
					"id": 80010509,
					"content": "Không như các bạn nghĩ đâu. \"Máy Cày\" thật ra chỉ là một cách gọi. Người Khaenri'ah khi đó thường có thói quen đặt tên cho vũ khí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010510
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010510,
					"content": "\"Đất không cày xới bằng nông cụ mà dùng máu và sắt để tranh cướp.\"- Dựa trên ý tưởng này, Máy Cày đã ra đời.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010511
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010511,
					"content": "Dùng máu và sắt để tranh cướp đất? Người Khaenri'ah hiểu về \"đất canh tác\" như vậy... Tôi thấy không có gì tốt đẹp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010512,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010513
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010513,
					"content": "Sau khi Khaenri'ah sụp đổ, những chiếc Máy Cày mất đi chủ nhân đó lần lượt mất kiểm soát.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010514
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010514,
					"content": "Không ngừng lang thang trong một thời gian dài, dần dần bị phân tán ở mọi ngóc ngách của lục địa Teyvat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010515
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010515,
					"content": "Có thể là do có sự đồng cảm với các nền văn minh cổ đại bị tiêu diệt khác, chúng thường cư trú trong các di tích khác nhau và không hoạt động.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010516
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010516,
					"content": "Nghe có vẻ... Rất đáng thương...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010517,
						80010518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010517,
					"content": "Năm trăm năm lang thang không mục đích...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010520
					]
				},
				{
					"id": 80010520,
