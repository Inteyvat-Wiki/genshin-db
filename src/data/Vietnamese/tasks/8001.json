				"points": []
			},
			"dialogs": [
				{
					"id": 80010201,
					"content": "Bọn Pháp Sư Vực Sâu... Đang chuẩn bị mai phục chúng ta sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010202,
					"content": "Không, bọn chúng chỉ đang lục tìm thứ gì đó trong đống xác của Thủ Vệ Di Tích thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010203
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010203,
					"content": "Vậy sao... Hình như Nhà Lữ Hành cũng thường làm như vậy nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010204,
					"content": "Cái gì mà \"Cấu Trúc Hỗn Độn\", \"Bộ Não Hỗn Độn\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010205,
						80010206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010205,
					"content": "Đúng vậy, đó đều là những nguyên liệu rất quan trọng!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010207
					]
				},
				{
					"id": 80010207,
					"content": "Không phải những thứ tầm thường đó đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010208
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010208,
					"content": "Tôi đi điều tra xung quanh là vì thỉnh thoảng lại có Pháp Sư Vực Sâu từ trong di tích đi ra bên ngoài thăm dò.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010209
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010209,
					"content": "Dường như bọn chúng muốn tìm một thứ quý giá trong xác của Thủ Vệ Di Tích, mang về di tích.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010210
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010210,
					"content": "Nhưng trông dáng vẻ thất vọng của bọn chúng, ít nhất cho đến bây giờ chúng vẫn chưa tìm được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010211
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010211,
					"content": "Vậy sao lúc nãy không bắt chúng lại hỏi cho rõ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010212,
						80010213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010212,
					"content": "Hình như Lão gia Diluc từng làm như vậy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010214
					]
				},
				{
					"id": 80010214,
					"content": "Tất nhiên là tôi sẽ không nhân từ với bọn này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010215
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010215,
					"content": "Chỉ cảm thấy chuyện này có ý nghĩa rất lớn đối với Giáo Đoàn Vực Sâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010216
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010216,
					"content": "Sự thật của nó không phải chỉ hỏi là biết được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010217
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010217,
					"content": "Nói cách khác, bọn Pháp Sư Vực Sâu này vốn dĩ phải đối mặt với nỗi sợ hãi lớn hơn cả bị tra hỏi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010218,
						80010219
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010218,
					"content": "Sợ hãi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010220
					]
				},
				{
					"id": 80010220,
					"content": "Ơ... Ơ... Cảm giác dựng tóc gáy như thế này là sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010221,
					"content": "Được rồi, đừng mất thời gian ở đây quá lâu, chúng ta tiếp tục theo dõi thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010219,
					"content": "Có liên quan đến chuyện bên trong di tích không...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010220
					]
				},
				{
					"id": 80010213,
					"content": "Với bọn chúng có thể tàn nhẫn một chút.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010214
					]
				},
				{
					"id": 80010206,
					"content": "Chắc không phải Pháp Sư Vực Sâu đang tìm những thứ đó chứ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010207
					]
				}
			]
		},
		{
			"id": 800103,
			"completionStepIds": [
				800105
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
