			"dialogs": [
				{
					"id": 80010101,
					"content": "Gặp lại... Sớm hơn tôi nghĩ một chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010102
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010102,
					"content": "A, là Dain!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010103,
					"content": "Trông biểu cảm của bạn có vẻ như vừa trải qua chuyện gì đó rất kỳ lạ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010104
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010104,
					"content": "Lẽ nào bạn đã đối mặt với Sứ Đồ Vực Sâu ở di tích này?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010105
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010105,
					"content": "Ơ, sao Dain lại biết?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010106,
					"content": "Tôi vẫn đang tiếp tục truy bắt Sứ Đồ Vực Sâu, không ngờ lại gặp hai bạn ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010107,
						80010108
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010107,
					"content": "Thật ra tôi không chỉ gặp Sứ Đồ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010109
					]
				},
				{
					"id": 80010109,
					"content": "Tượng Thần treo ngược...sức mạnh Vực Sâu trong tay? Không, tôi đang chiến đấu với Vực Sâu, cũng chưa từng gặp thứ gì như vậy. Nhưng...Tôi có suy đoán.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010110
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010110,
					"content": "Kể chuyện các bạn đã trải qua trước đi. Các bạn đã thoát khỏi tận cùng Di Tích chứa đầy năng lượng Vực Sâu, sau đó thì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010111
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010111,
					"content": "Rồi khi chúng tôi đến gần lối ra, thì Sứ Đồ Vực Sâu đột nhiên xuất hiện chặn đường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010112,
					"content": "Chúng tôi đấu với nó một trận, nói không chừng nó vẫn chưa đi xa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010113,
					"content": "Ừm, cơ hội hiếm có, hãy cùng tôi đuổi theo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010114,
						80010115
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010114,
					"content": "Được!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010116
					]
				},
				{
					"id": 80010116,
					"content": "Đi thôi! Cơ hội hiếm có, còn có Dain hỗ trợ, nói không chừng có thể giải đáp được nhiều bí ẩn hơn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010115,
					"content": "Không, tôi nhớ hình như tôi mới là người được phép ra lệnh...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010116
					]
				},
				{
					"id": 80010108,
					"content": "Trong di tích còn có những thứ kỳ lạ hơn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010109
					]
				}
			]
		},
		{
			"id": 800102,
			"completionStepIds": [
				800103
