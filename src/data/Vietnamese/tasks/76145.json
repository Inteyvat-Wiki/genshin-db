	"talks": [
		{
			"id": 7614501,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7614502",
							"2"
						],
						"stepId": 7614502,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kuzmich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761450101,
					"content": "Tình hình kinh doanh tệ quá... Hay là mình gom thêm ít tiền, tìm cách thuê một gian hàng ở Thị Trấn Nasha nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450113,
						761450102,
						761450115
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450113,
					"content": "Có món hàng tốt nào không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450114
					]
				},
				{
					"id": 761450114,
					"content": "#Toàn là những món đồ lặt vặt lấy từ Natlan thôi, {F#cô}{M#cậu} thấy thích món nào thì cứ thoải mái chọn nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450102,
					"content": "Anh là?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450103
					]
				},
				{
					"id": 761450103,
					"content": "Ôi, có khách đến rồi! Xin chào, tôi là Kuzmich, một thương nhân lữ hành đến từ Snezhnaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450104
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450104,
					"content": "Nói vậy thôi chứ thực ra tôi chỉ tiện thì buôn bán vài món lặt vặt để kiếm lộ phí thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450105
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450105,
					"content": "Kết quả là khi đi qua Natlan, người dân ở đó quá nhiệt tình, trong lúc kích động tôi đã... Bây giờ nếu không bán hết đống hàng này thì tôi không có tiền mua vé về mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450106,
						761450110
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450106,
					"content": "Anh định về Snezhnaya à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450107
					]
				},
				{
					"id": 761450107,
					"content": "Đúng vậy, sau khi bán hết lô hàng này, tôi sẽ mua vé tàu về nhà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450108
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450108,
					"content": "Tuy ở đó tuyết rơi quanh năm, khắp nơi đều là băng tuyết, mỗi ngày chỉ có thể co ro trong thành phố.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450109
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450109,
					"content": "Nhưng ở bên ngoài lâu rồi, tôi cũng thấy nhớ những ngày được nằm ngủ cả ngày ở nhà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450110,
					"content": "Nhìn qua thì nơi này chẳng có vẻ gì là sẽ làm ăn được cả.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450111
					]
				},
				{
					"id": 761450111,
					"content": "Nhưng nếu muốn thuê một gian hàng trong thị trấn, tôi chỉ có thể đi vay tiền từ Ngân Hàng Bắc Quốc thôi. Nghe nói chi nhánh ở Thị Trấn Nasha không được đánh giá tốt cho lắm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450112
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450112,
					"content": "#Thôi kệ đi, ít ra chỗ này cũng đông người qua lại. Hàng hóa thì chỉ cần có nhiều người đến là sẽ bán được thôi, {F#cô}{M#cậu} nói xem có đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450115,
					"content": "Xin lỗi, tôi phải đi trước đây.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450116
					]
				},
				{
					"id": 761450116,
					"content": "#Ơ, sao {F#cô}{M#cậu} lại đi luôn thế, không xem thử sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuzmich"
				}
			]
		},
		{
			"id": 7614503,
			"completionStepIds": [
				7614503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7614503",
							"2"
						],
						"stepId": 7614503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kuzmich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761450301,
					"content": "Ôi trời, không ngờ là bán hết thật rồi, có vẻ tôi cũng có chút khiếu kinh doanh đấy chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450302
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450302,
					"content": "Tiếp theo tôi sẽ nhờ Người Giữ Đèn dẫn tôi đi qua Đầm Lầy Bóng Tối, sau đó đi về phía Bắc chắc là cũng dễ thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450303
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450303,
					"content": "Biết đâu trên đường về lại gặp cơ hội làm ăn nào đó... Vậy tạm biệt nhé, có duyên sẽ gặp lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuzmich"
				}
			]
		},
		{
			"id": 7614504,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7614504",
							"2"
						],
						"stepId": 7614504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kuzmich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761450401,
					"content": "#Thật trùng hợp, chúng ta lại gặp nhau rồi. {F#Cô}{M#Cậu} có muốn mua gì không? Hàng mới đang ế, mua giúp tôi đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450407,
						761450402,
						761450409
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450407,
					"content": "Để tôi xem có thứ gì hay ho không.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450408
					]
				},
				{
					"id": 761450408,
					"content": "#Toàn là đặc sản địa phương thôi, {F#cô}{M#cậu} cứ yên tâm, tôi sẽ lấy giá tốt nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450402,
					"content": "Sao anh lại nhập thêm hàng nữa vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450403
					]
				},
				{
					"id": 761450403,
					"content": "Ừm, nói sao bây giờ nhỉ. Chuyện làm ăn mà, chính là thời cơ đến thì phải nắm lấy... Tôi tình cờ gặp cơ hội tốt ở Thành Piramida, có một lô hàng cần bán gấp, họ để cho tôi giá ưu đãi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450404
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450404,
					"content": "Lúc đó tôi phấn khích quá, quên mất là mình phải về nhà, mua sạch luôn. Kết quả thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450405
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450405,
					"content": "Anh đoán xem tại sao họ phải bán gấp như thế.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450406
					]
				},
				{
					"id": 761450406,
					"content": "#Ây, thôi {F#cô}{M#cậu} đừng chạm vào nỗi đau của tôi nữa mà. Hay là {F#cô}{M#cậu} xem thử có món nào dùng được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450409,
					"content": "Xin lỗi, tôi đi trước đây.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450410
					]
				},
				{
					"id": 761450410,
					"content": "#Sao không xem thêm đi, nhất định sẽ có thứ {F#cô}{M#cậu} cần mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuzmich"
				}
			]
		},
		{
			"id": 7614506,
			"completionStepIds": [
				7614506
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7614506",
							"2"
						],
						"stepId": 7614506,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kuzmich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761450601,
					"content": "Tuyệt quá, cuối cùng cũng bán hết hàng rồi, chiến lược lãi ít bán nhiều quả nhiên là đúng đắn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450602
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450602,
					"content": "Lẽ ra tôi nên lên đường về Snezhnaya rồi, nhưng giờ chỉ mới kiếm đủ lộ phí thôi... Tay trắng ra đi, tôi không muốn lại tay trắng quay về đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450603
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450603,
					"content": "#Haiz, dù sao thì cũng cảm ơn {F#cô}{M#cậu} đã ủng hộ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuzmich"
				}
			]
		},
		{
			"id": 7614507,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7614507",
							"2"
						],
						"stepId": 7614507,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kuzmich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761450701,
					"content": "Ái chà, thật là duyên phận kỳ diệu, lại gặp được nhau ở đây rồi. Sao nào, muốn xem thử không? Lần này có nhiều hàng tốt đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450709,
						761450702,
						761450706,
						761450711
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450709,
					"content": "Để xem thử có gì hay ho nào.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450710
					]
				},
				{
					"id": 761450710,
					"content": "Đây toàn là trang bị cũ mà Fatui đã loại bỏ, ở nơi khác không mua được đâu, thích cái nào thì cứ việc lấy đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450702,
					"content": "Anh không phải đã về Snezhnaya rồi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450703
					]
				},
				{
					"id": 761450703,
					"content": "#Thú thật với {F#cô}{M#cậu}, nhà tôi ở Novokitezhgrad, cả nhà đều là thợ mỏ. Họ ấy mà, toàn những người cứng đầu hơn cả Domovoy. Tôi nói muốn ra ngoài buôn bán thì họ kiên quyết không đồng ý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450704
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450704,
					"content": "Nên trước khi ra đi, tôi đã khoe khoang rằng sẽ kiếm thật nhiều tiền mang về... Nào ngờ, cuối cùng lại suýt không đủ lộ phí để về nhà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450705
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450705,
					"content": "Giờ kiếm nhiều tiền thì chắc không được rồi, ít nhất cũng để tôi kiếm được chút tiền lẻ, về nhà còn có cái để báo cáo chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450706,
					"content": "Sao anh lại ở trên địa bàn của Fatui thế?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450707
					]
				},
				{
					"id": 761450707,
					"content": "#Coi {F#cô}{M#cậu} nói kìa, tôi là một công dân Snezhnaya thượng tôn pháp luật, thấy Fatui là như về nhà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450708
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450708,
					"content": "#Mấy món hàng chỗ tôi đây toàn là trang bị cũ mà Fatui đã loại bỏ, họ đặc biệt nhờ tôi xử lý hộ. {F#Cô}{M#Cậu} không thể mua được ở nơi nào khác đâu, độc quyền đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450711,
					"content": "Thôi không cần đâu, tôi đi trước đây.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450712
					]
				},
				{
					"id": 761450712,
