			"dialogs": [
				{
					"id": 100060101,
					"content": "Chào Durin! Thì ra cậu ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100060102,
					"content": "#Là {NICKNAME} và Paimon! Sao hai người lại tới đây vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060103
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060103,
					"content": "Hì hì, thời tiết bên ngoài đẹp như vậy, sao lại ngồi một mình đọc sách ở đây thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100060104,
					"content": "Là thế này. Kể từ khi có thêm nhiều cơ hội giao lưu với mọi người ở Mondstadt, tôi thường hay hiểu lầm những câu đùa của mọi người là thật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060105
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060105,
					"content": "Ví dụ, lần trước khi tôi thấy một bó hoa rất đẹp ở tiệm hoa, sau khi nói với chủ tiệm thì nhận được câu trả lời là:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060106
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060106,
					"content": "\"Hì hì, nếu đã thích đám cỏ dại này thì sao không kết hợp thêm Bạc Hà và Hoa Ngọt làm thành một bó hoa luôn nhỉ?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060107
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060107,
					"content": "Kết quả là, khi tôi làm theo lời người ta và đưa bó hoa đã hoàn thành ra, thì chủ tiệm lại bộc lộ một biểu cảm vô cùng đáng sợ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060108,
						100060109
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060108,
					"content": "Durin có cách nhìn thật độc đáo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060110
					]
				},
				{
					"id": 100060110,
					"content": "Sau này Albedo nói, đó là vì tôi vẫn chưa thể hiểu được hàm ý trong lời nói của mọi người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060111
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060111,
					"content": "Sau khi học được chữ viết của Mondstadt, anh ấy bảo tôi có thể đọc thêm sách ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060112
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060112,
					"content": "Vì tôi được sinh ra từ truyện cổ tích, nên hẳn là cũng sẽ học được \"quy tắc\" của thế giới này từ những cuốn sách.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060113
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060113,
					"content": "Thế là tôi đã bất giác đọc đến tận bây giờ... À phải rồi, còn chưa hỏi hai người tìm tôi có chuyện gì nữa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060114,
						100060117
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060114,
					"content": "Bạn bè thì nên thường xuyên đến thăm nhau.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060115
					]
				},
				{
					"id": 100060115,
					"content": "Ra là vậy, đây cũng là một phần quy tắc nhỉ? Lại học được thêm rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060116
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060116,
					"content": "Tuy đúng là vậy, nhưng chúng ta vẫn còn việc quan trọng cần bàn đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100060118,
					"content": "Là thế này... Thực ra chúng tôi có mang theo \"lời nhắn\" của Rhinedottir gửi cho cậu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100060119,
					"content": "Thì ra là từ... dì Rhinedottir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060120,
						100060121
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060120,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060122
					]
				},
				{
					"id": 100060122,
					"content": "Ừm, tôi chỉ hơi bất ngờ thôi... Dì Rhinedottir là bạn của mẹ, và cũng là mẹ của con rồng ma từng tồn tại trên thế giới này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060123
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060123,
					"content": "Và tôi đã thay thế vận mệnh vốn thuộc về nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060124
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060124,
					"content": "Vậy nên nếu dì ấy ghét tôi... Tôi cũng không biết phải làm sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060125,
						100060126
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060125,
					"content": "Chắc cô ấy không đến mức nhỏ nhen như vậy đâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060127
					]
				},
				{
					"id": 100060127,
					"content": "Ừm, đừng lo lắng gì cả. Chắc chắn đây không phải chuyện xấu đâu. Hơn nữa còn có chúng tôi ở đây mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100060128,
					"content": "Nghe hai người nói vậy thì tôi yên tâm hơn nhiều rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060129
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060129,
					"content": "Vậy thì để tôi mở ra xem thử...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060126,
					"content": "Có chúng tôi ở đây mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060127
					]
				},
				{
					"id": 100060121,
					"content": "Đừng căng thẳng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060122
					]
				},
				{
					"id": 100060117,
					"content": "Chúng tôi đến đây là vì ma nữ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060118
					]
				},
				{
					"id": 100060109,
					"content": "Tôi cảm thấy đó là lỗi của chủ tiệm hoa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060110
					]
				}
			]
		},
