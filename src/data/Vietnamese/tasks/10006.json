					"nextDialogs": [
						100060804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100060804,
					"content": "Điều đó không quan trọng. Tôi là Sebas, chỉ là một quản gia mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060805
					],
					"speakerTitle": "Sebas"
				},
				{
					"id": 100060805,
					"content": "Hai người là bạn của Albedo phải không? Nói cho chính xác thì tôi là trưởng bối của anh ta đấy, vì vậy đừng có đánh đồng tôi với mấy con mèo bình thường.",
					"roleType": "TALK_ROLE_NPC",
