			"dialogs": [
				{
					"id": 100060901,
					"content": "Hơn nữa, xét về mặt sinh học, thân là một sinh vật giả kim, tôi không thể bị xem là mèo. Cũng giống như cô và đám Bóng Ma bay tới bay lui kia không thể xem là một, phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060902
					],
					"speakerTitle": "Sebas"
				},
				{
					"id": 100060902,
					"content": "Hả? Bóng Ma gì cơ? Sao cảm thấy tên này có ẩn ý gì thế nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100060903,
					"content": "Tôi hiểu rồi, đây chính là \"ẩn ý\" phải không? Vậy thì Sebas hẳn là muốn nói...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060904
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060904,
					"content": "Đừng nói ra chứ, Durin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060905
					]
				},
				{
					"id": 100060905,
					"content": "Này, mấy người có ý gì vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060906
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100060906,
					"content": "À đúng rồi, nếu chủ nhân Rhinedottir đã nói thế, vậy thì tôi sẽ tiêu hủy thuật pháp vô dụng này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060907
					],
					"speakerTitle": "Sebas"
				},
				{
					"id": 100060907,
					"content": "Hiếm khi thấy chủ nhân Rhinedottir phải suy nghĩ nhiều như vậy, tôi rất kỳ vọng vào cậu đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060908
					],
					"speakerTitle": "Sebas"
				},
				{
					"id": 100060908,
					"content": "Được rồi, giờ tôi phải đi đây. Tôi còn có tin nhắn khác cần truyền đạt, biết đâu chúng ta sẽ còn gặp lại đấy.",
