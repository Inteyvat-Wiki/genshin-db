			"dialogs": [
				{
					"id": 100060601,
					"content": "\"Hmm, xem ra lần này Albedo không nhầm lẫn rồi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060602
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100060602,
					"content": "Này, lần sau đừng bày trò tập kích bất ngờ như vậy nữa được không!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100060603,
					"content": "Nhưng sau khi đánh bại chúng, tôi cảm thấy mình có thể kiểm soát sức mạnh trong cơ thể tốt hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060604
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060604,
					"content": "\"Thật ra, sau khi nghe về chuyện của cậu, ta đã chuẩn bị một thuật pháp có thể phong ấn nguồn sức mạnh hắc ám trong huyết mạch, định nhân cơ hội này trao nó cho cậu.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060605
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100060605,
					"content": "\"Tất nhiên, việc sử dụng thuật pháp đó sẽ phải trả một cái giá tương ứng. Tuy nó có thể duy trì sự tồn tại của cậu ở Teyvat, nhưng sẽ làm suy yếu liên kết giữa cậu và thế giới.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060606
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100060606,
					"content": "\"Dù sao cậu cũng là con của M, nếu chỉ vì sức mạnh không được xử lý tốt mà khiến cậu phải chịu chung số phận với đứa trẻ đó, thì thật là có lỗi với cô ấy.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060607
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100060607,
					"content": "\"Nhưng hiện tại, xem ra ta lo lắng hơi thừa thãi rồi. M quả thật là một người mẹ tuyệt vời, giỏi giang mẫu mực hơn ta nhiều.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060608
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100060608,
					"content": "\"Giờ đây, ta rất mong chờ xem cậu sẽ trưởng thành đến đâu. Một sinh mệnh giả kim thực sự hòa nhập với thế giới này sẽ tìm được vị trí của mình trong xã hội loài người ra sao.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060609
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100060609,
					"content": "\"Ta chưa từng thực hiện một thí nghiệm như vậy bao giờ. Có lẽ từ cậu, ta sẽ tìm được 'câu trả lời' ngoài mong đợi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060610
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100060610,
					"content": "Ừm, nhưng Durin không phải là vật thí nghiệm gì hết, cậu ấy là người bạn quan trọng của chúng tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100060611,
					"content": "Tuy không hiểu lắm, nhưng cảm ơn sự tốt bụng của dì Rhinedottir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Durin"
				}
			]
