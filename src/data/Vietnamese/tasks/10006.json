			"dialogs": [
				{
					"id": 100060501,
					"content": "\"Lần đầu gặp mặt, ta vẫn chưa biết nên gọi cậu là gì. Đã là con của M, thì cứ tạm gọi cậu là Durin Nhỏ vậy.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060502
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100060502,
					"content": "\"Tuy nhìn thân hình cậu nhỏ con hơn nhiều, nhưng sức mạnh còn sót lại trong máu cậu từ đứa trẻ đó cũng không hề nhỏ bé.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060503
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100060503,
					"content": "\"Đứa trẻ đó là tạo vật không hoàn chỉnh của 'Humus', vì vậy mà nó thiếu đi 'ý chí' để kiểm soát sức mạnh của bản thân.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060504
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100060504,
					"content": "\"Đứa trẻ thiếu 'ý chí' nhưng lại có được sức mạnh vượt quá khả năng chịu đựng của bản thân, vì thế đã bị sức mạnh ấy bóp méo và nuốt chửng, dẫn đến kết cục đã được định sẵn.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060505
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100060505,
					"content": "\"Albedo nói rằng cậu đã vượt qua huyết mạch của sự mục nát, là đồng loại có sự tương đồng với mình. Nhưng đó chỉ là ý kiến cá nhân của Albedo, vẫn chưa có được sự công nhận từ ta.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060506
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100060506,
					"content": "\"Ta chỉ chịu khuất phục trước những sự thật tuyệt đối, ta cần phải 'nhìn thấy' tận mắt. Nhân cơ hội này, đứa con của M, hãy chứng minh cho ta thấy đi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"Rhinedottir\""
				}
			]
		},
