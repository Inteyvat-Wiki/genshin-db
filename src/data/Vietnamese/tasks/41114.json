				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411140801,
					"content": "Tác giả là Leonard... Leonard... thấy rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411140802,
					"content": "Trên hướng dẫn tra cứu, sổ tay của nhà mạo hiểm Leonard nằm ở <color=#00E1FFFF>góc tây bắc</color> <color=#00E1FFFF>tầng một</color> của thư viện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411140803,
					"content": "Góc tây bắc... chắc là ở bên đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4111409,
			"completionStepIds": [
				4111409
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4111409",
							"2"
						],
						"stepId": 4111409,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411140901,
					"content": "Tìm thấy sách của anh ấy rồi nè!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411140902,
					"content": "Mau đưa cho tôi xem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140903
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140903,
					"content": "Nội dung bị thiếu không ăn khớp.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411140904
					]
				},
				{
					"id": 411140904,
					"content": "Hư, tôi biết mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140905
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140905,
					"content": "Nếu là một nhà chiêm tinh bình thường, có lẽ là đã bỏ cuộc rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140906
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140906,
					"content": "Nhưng Mona tôi là nhà chiêm tinh đứng đầu trong tương lai, không gì có thể cản trở tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140907
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140907,
					"content": "Dùng bảng chiêm tinh để suy tính những phần còn thiếu rồi điền vào, sau đó diễn giải...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140908
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140908,
					"content": "Phù! Cuối cùng cũng đọc xong...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140909
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140909,
					"content": "Cuốn sách nói về cái gì vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140910
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411140910,
					"content": "Đúng như tôi nghĩ, Leonard là một nhà mạo hiểm của 2000 năm trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140911
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140911,
					"content": "Ước mơ cả đời của anh ấy là leo lên ngọn núi phủ đầy tuyết có tên \"Đỉnh Nón Nhọn\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140912
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140912,
					"content": "2000 năm? Những thiên thạch này là... \"cung mệnh\" của người cổ đại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411140913,
					"content": "Vì một lý do nào đó cung mệnh của anh ấy đã được triệu hồi đến trái đất. Về điểm này, tôi cho rằng có liên quan đến người Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140914
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140914,
					"content": "Đồng ý, đại đa số những chuyện ly kỳ cổ quái đều do họ làm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140915
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411140915,
					"content": "Những thiên thạch này chứa đựng sức mạnh nguyên tố, bằng cách toả ra một loại bức xạ tác động lên tinh thần của những người dân xung quanh, khiến họ chìm vào trong giấc mộng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140916
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140916,
					"content": "Ngoài ra, nếu những suy đoán của tôi là đúng, giữa những mảnh thiên thạch này có lẽ có một viên giống như hạt nhân, đó chính là kết tinh tinh thần của Leonard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140917
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140917,
					"content": "Nó sẽ ở đâu chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411140918
					]
				},
				{
					"id": 411140918,
					"content": "Nếu tôi mà là Leonard, hạt nhân này chắc chắn sẽ rơi xuống đỉnh núi nơi mà khi còn sống tôi vẫn không thể với đến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140919
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140919,
					"content": "Hạt nhân sẽ ở Đỉnh Nón Nhọn sao? Nhưng mà... Đỉnh Nón Nhọn ở đâu nhỉ? Tôi còn chưa từng nghe đến địa danh này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140920
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411140920,
					"content": "Tôi cũng mới biết. Đối chiếu bản đồ trong sách với địa hình hiện tại của Mondstadt, tôi phát hiện ra rằng Đỉnh Nón Nhọn đã không còn nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140921
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140921,
					"content": "Ngọn núi tuyết lớn như vậy cũng có thể biến mất sao?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140922
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411140922,
					"content": "Tôi từng đọc trong sách rằng phong thần Barbatos vì để cứu thần dân của mình, đã dùng thần lực thổi bay băng tuyết, đồng thời cũng đã thay đổi địa hình của Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140923
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140923,
					"content": "Đỉnh núi trong quá khứ đã được thay đổi bằng biển cả vô tận. Nhưng nếu ngọn núi đó đã bị chôn vùi xuống biển thì với độ cao trước đây của nó, sẽ vẫn lưu lại một vài dấu vết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140924
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140924,
					"content": "...Phần đỉnh lộ ra khỏi mặt nước hiện được gọi là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140925
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140925,
					"content": "<color=#00E1FFFF>\"Rặng Musk\"</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
		{
			"id": 4111411,
			"completionStepIds": [
				4111411
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4111411",
							"2"
						],
						"stepId": 4111411,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Scaramouche"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411141101,
					"content": "Hả? Đây chính là Đỉnh Nón Nhọn trước đây hả? Trở nên nhỏ bé thật nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141102
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141102,
					"content": "Ơ, có người đến trước rồi? Ở đây có điểm tham quan nào sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141103,
					"content": "A! Là ngươi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141104,
					"content": "Ơ... Ơ? Là các ngươi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141105,
						411141106
					],
					"speakerTitle": "Scaramouche"
				},
				{
					"id": 411141105,
					"content": "Ngươi làm sao tìm được đến đây?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141107
					]
				},
				{
					"id": 411141107,
					"content": "Nhìn bộ dạng của hắn, lẽ nào là vừa bước ra từ trong mơ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141108,
					"content": "Không ngờ lại có người có thể tự thức dậy dựa vào sức mạnh của bản thân... sao có thể?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141109
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141109,
					"content": "Hừ, các ngươi không làm được, không có nghĩa ta cũng không làm được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141110
					],
					"speakerTitle": "Scaramouche"
				},
				{
					"id": 411141110,
					"content": "Các ngươi đến chậm một bước, \"nghiên cứu\" của ta đã hoàn thành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141111
					],
					"speakerTitle": "Scaramouche"
				},
				{
					"id": 411141111,
					"content": "Quả nhiên tất cả đều là do đám người Fatui các ngươi đang bày trò?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141112,
					"content": "Đừng căng thẳng như vậy, hôm nay ta không có thời gian để chơi với các ngươi. Lần sau tìm các ngươi gây sự cũng không muộn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141113
					],
					"speakerTitle": "Scaramouche"
				},
				{
					"id": 411141113,
					"content": "Đợi đã! Rốt cuộc các ngươi có mục đích gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141114
					]
				},
				{
					"id": 411141114,
					"content": "Ngươi vừa mới tiến vào giấc mộng núi tuyết cùng với những người khác phải không? Ngươi biết gì về Leonard?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141115
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141115,
					"content": "Leonard? Cái gì mà Leonard... Hừm, thôi bỏ đi, bây giờ không phải là lúc quan tâm đến mấy chuyện vớ vẩn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141116
					],
					"speakerTitle": "Scaramouche"
				},
				{
					"id": 411141116,
					"content": "Ta phát hiện được... chuyện quan trọng đáng sợ hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141117
					],
					"speakerTitle": "Scaramouche"
				},
				{
					"id": 411141117,
					"content": "Hửm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141118,
					"content": "Là cái gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141119
					]
				},
				{
					"id": 411141119,
					"content": "Bầu trời sao chính là sự dối trá to lớn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141120
					],
					"speakerTitle": "Scaramouche"
				},
				{
					"id": 411141120,
					"content": "Bầu trời sao... dối trá? Đây là ý gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141121
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141121,
					"content": "Muốn phản bác lý luận chiêm tinh gì đó của Mona sao? Thì cũng không cần phải nói rằng \"Bầu trời sao chính là sự dối trá\" chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141122,
					"content": "Trong đêm, ngước nhìn lên bầu trời, không phải là có thể nhìn thấy sao rồi à? Chuyện thường này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141123,
					"content": "Ha...hahahahaha! Vẫn còn nói những điều ngây thơ như vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141124
					],
					"speakerTitle": "Scaramouche"
				},
				{
					"id": 411141124,
					"content": "Suy cho cùng, cũng không phải lỗi của ngươi. Bởi vì cách đây không lâu, ta cũng tin là như vậy",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141125
					],
					"speakerTitle": "Scaramouche"
				},
				{
					"id": 411141125,
					"content": "Cho đến vừa rồi? Ý của ngươi là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141126
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141126,
					"content": "Hừ, ta không rảnh để thảo luận với các ngươi chuyện này nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141127
					],
					"speakerTitle": "Scaramouche"
				},
				{
					"id": 411141127,
					"content": "Tên Jester đó... giao cho ta nhiệm vụ kiểu này, không hề báo trước về khả năng \"phát hiện\"... có phải cố ý hù doạ ta hay không?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141128
					],
					"speakerTitle": "Scaramouche"
				},
				{
					"id": 411141128,
					"content": "Bây giờ ta cần phải đi xác nhận \"chân tướng\". Vì vậy, tạm biệt nhé, đám gà mờ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
