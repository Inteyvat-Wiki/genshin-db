				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411141401,
					"content": "Tìm thấy rồi! Sổ tay mạo hiểm \"Cuốn Sơn Hải\", tác giả Leonard!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141402,
					"content": "Có điều cuốn sách này thiếu trang, có xem cũng không hiểu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141403,
					"content": "Tại sao lại thế này, hức... không lẽ tốn công vô ích...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141404,
					"content": "Đừng bỏ cuộc, đưa cho Mona xem thử.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141405
					]
				},
				{
					"id": 411141405,
					"content": "Ah, đúng rồi, nói không chừng cô ấy sẽ có cách.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4111415,
			"completionStepIds": [
				4111415
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4111415",
							"2"
						],
						"stepId": 4111415,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411141501,
					"content": "Thật là một cuộc chiến khốc liệt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141502,
					"content": "Đây là kết cục của việc dám chọc giận tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141503
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141503,
					"content": "Mona thật là lợi hại.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141504
					]
				},
				{
					"id": 411141504,
					"content": "Tất nhiên rồi! Paimon cũng cảm thấy tôi rất lợi hại đúng không? Đúng không hả?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141505
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141505,
					"content": "Đúng đúng, không có Mona e rằng chúng tôi sẽ gặp rắc rối lớn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141506,
					"content": "Hừ, đã nghe thấy chưa! Quan chấp hành Fatui! Đàn ông tồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141507
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141507,
					"content": "Có điều nhìn bộ dạng sợ hãi của hắn ban nãy, cũng không giống là đang nói dối. Lẽ nào \"Bầu trời giả dối\" mà sư phụ nhắc tới khi dạy tôi thuật chiêm tinh còn có ý nghĩa khác?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141508
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141508,
					"content": "A... hì hì, tôi lại mất tập trung rồi. Nào đi hoàn thành công việc quan trọng nhất của chúng ta thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141509
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141509,
					"content": "<color=#00E1FFFF>Hạt nhân thiên thạch</color>, chắc chắn chỉ ở quanh đây thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4111416,
			"completionStepIds": [
				4111416
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4111416",
							"2"
						],
						"stepId": 4111416,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411141601,
					"content": "Oa, đây có phải là hạt nhân không? Trông nó có vẻ khác với những thiên thạch khác! Có cảm giác... trong sáng?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141602,
					"content": "Trên hòn đá này có chứa ý niệm và sức mạnh nguyên tố kinh người. Đúng là hạt nhân rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141603
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141603,
					"content": "Chúng ta có nên phá huỷ nó không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141604
					]
				},
				{
					"id": 411141604,
					"content": "Ừm, nếu không xử lý nó, mọi người sẽ không thể tỉnh lại... hạt nhân này chính là nguồn gốc của mọi việc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141605
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141605,
					"content": "#{NICKNAME}, cố lên nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141606,
					"content": "Thật không ngờ, hoá ra sự việc là như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141607,
						411141608
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141607,
					"content": "Người leo núi cố gắng đạt đến đỉnh cao mà mình chưa biết.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141609
					]
				},
				{
					"id": 411141609,
					"content": "Không thể ngờ rằng niềm tin của loài người, có thể tồn tại trên bầu trời hàng ngàn năm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141610
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141610,
					"content": "Haiz, chiêm tinh học quả nhiên thật lợi hại!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141611
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141611,
					"content": "Tại sao lại nói đến chuyện này rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141612,
					"content": "Nếu có thể giao tiếp với các vì sao sẽ có thể nắm được tất cả các bí mật từ cổ chí kim. Và tất nhiên là ngoài tôi ra, nhà chiêm tinh có thể làm được điều này cũng không có mấy người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141613
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141613,
					"content": "Mona, cảm ơn bạn nhiều.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141614
					]
				},
				{
					"id": 411141614,
					"content": "Làm, làm gì thế... đột nhiên lại nghiêm túc như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141615
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141615,
					"content": "Mà nói chứ, cô gái tên là Fischl đó, thật sự rất thần kỳ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141616
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141616,
					"content": "Tôi cũng thấy vậy! Cô ấy rõ ràng... hừm... nói thế nào nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141617,
						411141618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141617,
					"content": "Là một người tràn đầy những ý tưởng kỳ lạ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141619
					]
				},
				{
					"id": 411141619,
					"content": "Mặc dù là vậy, nhưng nếu bạn nhớ lại... lời cô ấy nói cũng có vẻ đúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141620,
					"content": "Lẽ nào cô ấy chính là loại người dùng quá trình sai để có được kết quả đúng đắn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141621
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141621,
					"content": "Không chừng đúng là như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141622
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141622,
					"content": "Điều tôi không ngờ nhất chính là Đỉnh Nón Nhọn đã trở thành một hòn đảo nhỏ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141623
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141623,
					"content": "Ngọn núi cao năm xưa nay đã trở thành một mảnh đất nhỏ giữa biển khơi. Bây giờ người Mondstadt chỉ cần ngồi thuyền là có thể đến đó nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141624
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141624,
					"content": "Chẳng phải là ai ai cũng đều có thể leo lên Đỉnh Nón Nhọn rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141625
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141625,
					"content": "Ai ai cũng đều có thể đến được đỉnh núi rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141626
					]
				},
				{
					"id": 411141626,
					"content": "Leonard sẽ vui chứ? Mặc dù Đỉnh Nón Nhọn là một tai nạn, nhưng giờ đây, với sự giúp đỡ của Phong Thần, người Mondstadt đã có thể bay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141627
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141627,
					"content": "Với đôi cánh con người có thể bay cao và xa hơn, khám phá được nhiều nơi hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141628
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141628,
					"content": "(Leonard, tâm nguyện của anh đã thành hiện thực chưa?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141629
					]
				},
				{
					"id": 411141629,
					"content": "Được rồi, xử lý xong thiên thạch hạt nhân, những người đang hôn mê sẽ dần dần tỉnh lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141630
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141630,
					"content": "Chúng ta cũng coi như đã thuận lợi hoàn thành uỷ thác của Hiệp Hội Nhà Mạo Hiểm nhỉ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141631
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141631,
					"content": "Ừm, hy vọng mọi người... mau chóng hồi phục.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 411141618,
					"content": "Là một người lập dị mơ mộng hão huyền.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141619
					]
				},
				{
					"id": 411141608,
					"content": "Những người kiên trì muốn truyền lại ý chí của họ cho tương lai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141609
					]
				}
			]
		}
	]
}