			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mona",
					"Fischl"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411140101,
					"content": "Í, Fischl đang đợi chúng tôi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411140102,
					"content": "Đến đúng lúc lắm. Mặc dù miễn cưỡng, nhưng vẫn phải nói những điều này với các bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140103
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411140103,
					"content": "Hãy nói lời tạm biệt với công chúa đi, bạn đồng hành. Trên đường đi bạn đã thể hiện sự dũng cảm phi thường, làn gió ca ngợi này là để dành cho bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140104
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411140104,
					"content": "Ấy ấy ấy? Sao tự nhiên lại nói tạm biệt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411140105,
					"content": "Fischl, bạn phải đi rồi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411140106
					]
				},
				{
					"id": 411140106,
					"content": "Thiên thạch lớn càng làm tình trạng hôn mê nghiêm trọng hơn, ngay cả những binh lính khoẻ mạnh cũng không thể chống đỡ nổi. Hiện nay khắp nơi đều thiếu nhân lực.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140107
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411140107,
					"content": "Tôi và công chúa phải đến chăm sóc các bệnh nhân thay cho các binh sĩ, việc còn lại giao cho các bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140108
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411140108,
					"content": "#{NICKNAME}... tạm biệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140109
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411140109,
					"content": "Bạn là người rất biết lắng nghe và sẵn sàng trò chuyện cùng tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140110
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411140110,
					"content": "Ngày thường, ngay cả trong hiệp hội, nhiều nhà mạo hiểm sẵn sàng hợp tác với tôi, cũng chỉ để nghe kết quả do thám của Oz từ trong lời nói của tôi mà thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140111
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411140111,
					"content": "Cuộc hành trình ngắn lần này thực sự là một cuộc mạo hiểm rất thú vị. Đột nhiên nói phải đi, tôi cũng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140112
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411140112,
					"content": "Í? Cách nói chuyện của Fischl, có vẻ như hơi khác so với ngày thường...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411140113,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140114
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411140114,
					"content": "(A...A A A! Vừa rồi lơ đễnh rồi...!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140115
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411140115,
					"content": "Ý, ý của tiểu thư là... các bạn rất dũng cảm, lại có trí tuệ vượt xa người thường, bất kỳ câu đố nào các bạn gặp phải đều trở thành hư vô!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140116
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411140116,
					"content": "Tại sao lần này hướng \"phiên dịch\" của Oz lại bị đảo ngược hoàn toàn nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411140117,
					"content": "Ách... e hèm, tiểu thư nói rằng các bạn chắc chắn sẽ tìm ra được chân tướng phía sau những ảo giác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140118
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411140118,
					"content": "E hèm... À, đúng vậy. Các bạn là những tuỳ tùng của công chúa. Kỵ sĩ định tội, hãy dẫn dắt họ bước ra khỏi bóng tối, trở về với ánh sáng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140119
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411140119,
					"content": "Ai là tuỳ tùng của bạn hả...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140120
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140120,
					"content": "Cảm ơn các bạn, Oz, Fischl.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411140121
					]
				},
				{
					"id": 411140121,
					"content": "Vẫn còn gặp lại mà, đợi mọi chuyện xong xuôi, lại hẹn nhau đi uống vài ly nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140122
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411140122,
					"content": "Haiz, thật tiếc hai người giúp việc tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140123
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140123,
					"content": "Đừng có nhăn mặt nhăn mày nữa, nói cho các bạn một tin tốt, tôi đã có phát hiện mới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140124
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140124,
					"content": "Tôi đã cạo một ít bột từ khối thiên thạch lớn kia để xem bói, có kết quả rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140125
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140125,
					"content": "Những tảng đá rơi này đã tồn tại hàng ngàn năm, Leonard có lẽ là người rất lâu trước đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140126
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140126,
					"content": "Thiên thạch truyền đạt lại ý chí của anh ấy, cũng có nghĩa là ước muốn của anh ấy trải qua hàng ngàn năm vẫn không hề suy yếu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140127
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140127,
					"content": "Một cổ nhân có khát vọng cháy bỏng leo lên đỉnh núi... Tôi dám chắc, anh ấy cũng là một nhà mạo hiểm giống như bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140128
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140128,
					"content": "Nhà mạo hiểm? Thảo nào lại muốn leo lên núi tuyết đến như vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411140129,
					"content": "Cách làm hiện nay gần như là cuộc chạy đua với thời gian, chúng ta quá bị động, cần phải thay đổi tư duy để giải quyết tận gốc vấn đề.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140130
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140130,
					"content": "Tôi ủng hộ! Tôi nghĩ rằng bây giờ chúng ta nên tập trung vào Leonard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411140131,
					"content": "Ừm... nếu như thiên thạch đã mang theo một điều ước nào đó, thì những tảng đá này đúng như lời Fischl đã nói, được coi như một loại \"lời nguyền\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140132
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140132,
					"content": "Thật hiếm khi cô ấy đoán mò lại trúng... e hèm, thôi bỏ đi, một nhà chiêm tinh tao nhã không nên đánh giá người khác như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140133
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140133,
					"content": "Tóm lại chúng ta chỉ cần tháo bỏ lời nguyền là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140134
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140134,
					"content": "Paimon, chúng ta xuất phát thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411140135
					]
				},
				{
					"id": 411140135,
					"content": "Hay!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411140136,
					"content": "Nếu muốn điều tra về những nhà mạo hiểm trước đây, thì phải bắt đầu từ <color=#00E1FFFF>Hiệp Hội Nhà Mạo Hiểm</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4111407,
			"completionStepIds": [
				4111407
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4111407",
							"2"
						],
						"stepId": 4111407,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411140701,
					"content": "Có nhiều nhà mạo hiểm mang tên này, tôi cũng không dám đưa ra kết luận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140702
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 411140702,
					"content": "Nhưng tôi có ấn tượng vì đã từng xem qua một quyển sách được viết bởi tác giả này, hay là đến thư viện tìm xem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140703
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 411140703,
					"content": "Nhưng tôi nhớ có một cuốn sách tên tác giả là Leonard, tại sao các bạn không đến <color=#00E1FFFF>thư viện</color> xem thử?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				}
			]
		},
		{
			"id": 4111408,
			"completionStepIds": [
				4111414
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
