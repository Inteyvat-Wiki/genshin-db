			},
			"dialogs": [
				{
					"id": 227010201,
					"content": "Nói thẳng nói thật.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						227010202
					]
				},
				{
					"id": 227010202,
					"content": "Sư huynh tôi nói chuyện với bạn, bạn hãy khách sáo một chút!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010203
					],
					"speakerTitle": "Bé Que'er"
				},
				{
					"id": 227010203,
					"content": "Sư muội, là ta chủ động gọi người bạn này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010204
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010204,
					"content": "Chỉ sợ người này lại là kẻ đầu cơ khác muốn đến Tuyệt Vân Gián tìm tiên duyên...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010205
					],
					"speakerTitle": "Bé Que'er"
				},
				{
					"id": 227010205,
					"content": "Được rồi, được rồi, sư muội hãy ở đây nghỉ ngơi trước, ta và người bạn này nói vài câu rồi sẽ quay lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010206
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010206,
					"content": "Sư huynh, có chuyện gì không thể nói trước mặt của muội?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010207
					],
					"speakerTitle": "Bé Que'er"
				},
				{
					"id": 227010207,
					"content": "Chỉ là có chút chuyện vặt, sư muội chắc chắn là không muôn nghe đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010208
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010208,
					"content": "Hừ, chắc chắn lại nói về chuyện phái Cổ Hoa rồi... Được rồi, sư huynh không muốn muội nghe, muội sẽ không nghe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010209
					],
					"speakerTitle": "Bé Que'er"
				},
				{
					"id": 227010209,
					"content": "Người bạn này, hãy theo tôi qua bên kia, tôi sẽ nói tỉ mỉ với bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				}
			]
		},
