			"dialogs": [
				{
					"id": 227010401,
					"content": "Ở đây là được rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010402
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010402,
					"content": "Rốt cuộc là có chuyện gì...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						227010403
					]
				},
				{
					"id": 227010403,
					"content": "Haiz, là chuyện của sư muội Que'er của tôi. Hàng ngày tôi và muội ấy tập võ luyện công như hình với bóng, võ công của muội ấy cũng không thua kém tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010404
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010404,
					"content": "Nhưng lần này trên đường đến Tuyệt Vân Gián tìm kiếm dấu vết của tiên nhân vốn đã vất vả, muội ấy còn thích nói chuyện, mấy ngày trước bị cảm lạnh, giọng nói cũng trở nên khàn đặc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010405
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010405,
					"content": "Tôi thấy bạn cũng là người có võ công cao cường, có thể phiền bạn giúp tôi đi hái ba bông hoa Thanh Tâm trên đỉnh vách đá bên cạnh về đây không? Để tôi pha nước cho Que'er uống cho mau khỏi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010406,
						227010408
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010406,
					"content": "Tôi biết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						227010407
					]
				},
				{
					"id": 227010407,
					"content": "Vậy nhờ cả vào bạn, Que'er quá hiếu động, tôi không dám đi hái thuốc mà để muội ấy một mình ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010408,
					"content": "Tại sao phải tránh mặt cô ấy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						227010409
					]
				},
				{
					"id": 227010409,
					"content": "Để bạn cười rồi, từ nhỏ sư muội của tôi tính tình hiếu thắng, chuyện gì cũng không chịu thua kém người khác cho dù chỉ là một chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010410
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010410,
					"content": "Nếu nói tìm thuốc chữa đau họng ở trước mặt muội ấy, muội ấy chắc chắn sẽ giận tôi rồi không chịu uống thuốc, cho nên chỉ có thể tránh muội ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010411
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010411,
					"content": "Tôi lại không dám đi hái thuốc mà bỏ muội ấy ở lại đây, cho nên đành phải nhờ bạn thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				}
			]
		},
