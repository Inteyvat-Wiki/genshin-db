					"nextDialogs": [
						227010602
					]
				},
				{
					"id": 227010602,
					"content": "Sư huynh, nếu huynh muốn hái thuốc, muội đi hái giúp huynh, sao phải nhờ người ngoài chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010603
					],
					"speakerTitle": "Bé Que'er"
				},
				{
					"id": 227010603,
					"content": "Lại nói, người này không rõ lai lịch, nói không chừng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010604
					],
					"speakerTitle": "Bé Que'er"
				},
				{
					"id": 227010604,
					"content": "...Được rồi, sư muội, đây là người bạn đã giúp đỡ chúng ta, đừng nói người ta như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010605
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010605,
					"content": "Cảm ơn bạn, đây là quà cảm ơn xin hãy nhận lấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010606
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010606,
					"content": "Nhận lấy rồi mau đi đi, sư huynh tôi đau đầu không thể ra gió.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010607
					],
					"speakerTitle": "Bé Que'er"
				},
				{
					"id": 227010607,
					"content": "Sư huynh, chúng ta mau qua bên kia tránh gió, muội nấu nước đường cho huynh uống...",
					"roleType": "TALK_ROLE_NPC",
