							4711.404
						],
						"pointId": 6283
					}
				]
			},
			"dialogs": [
				{
					"id": 741401301,
					"content": "Ôi. Lại đến chỗ này rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401302
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401302,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741401303,
					"content": "Tôi cũng cảm thấy nói câu này thì không hay lắm, mọi người đều tốt với tôi. Nhưng mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401304
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401304,
					"content": "Mọi người không cảm thấy thế giới thực vô vị đến đáng sợ sao? Không cảm thấy thế giới trong sách tươi đẹp hơn ư?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401305,
						741401307,
						741401309
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401305,
					"content": "Tôi cũng thấy vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741401306
					]
				},
				{
					"id": 741401306,
					"content": "#Ồ? {NICKNAME} cũng thấy như vậy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741401311,
					"content": "Tôi cảm thấy thế giới trong Sách Khải Huyền vẫn tươi đẹp hơn. Khắp nơi đều là cánh hoa phủ sương, hơn nữa khó khăn lắm mới làm bạn được với chó nhỏ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401312
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401312,
					"content": "Chó nhỏ... Nhắc mới nhớ, Canotila hiểu được tiếng chó sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741401313,
					"content": "Hả? Đương nhiên là không rồi. Nhưng chó nhỏ trong Sách Khải Huyền rất đặc biệt, hoặc cũng có thể là tôi đặc biệt chăng?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401314
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401314,
					"content": "Nhưng tôi cứ thiền và đến thế giới trong sách để chơi, và bỗng một ngày, tiếng kêu gâu gâu đã biến thành ngôn ngữ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401315
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401315,
					"content": "Nhưng nó khuyên tôi nên đi, bảo tôi đừng quay lại nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401316
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401316,
					"content": "Nhưng... Tôi vẫn muốn nhìn thấy khung cảnh hoa hướng dương nở rộ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401317
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401317,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741401318
					]
				},
				{
					"id": 741401318,
					"content": "À ừm... Vậy Canotila giữ gìn sức khỏe nhé! Chúng tôi đi trước đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741401307,
					"content": "Tôi không thấy vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741401308
					]
				},
				{
					"id": 741401308,
					"content": "Vậy sao...? Có lẽ như vậy mới đúng, tôi như vậy là không bình thường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401311
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401309,
					"content": "Với tôi mà nói thì không có gì khác nhau cả.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741401310
					]
				},
				{
					"id": 741401310,
					"content": "#Xem ra {NICKNAME} là người mạnh mẽ nhất nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401311
					],
					"speakerTitle": "Canotila"
				}
			]
		}
	]
}