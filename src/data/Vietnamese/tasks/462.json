		{
			"id": 46203,
			"completionStepIds": [
				46203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"46203",
							"2"
						],
						"stepId": 46203,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vile"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4620301,
					"content": "Haiz... Tại sao lại gặp phải chuyện này, sớm biết vậy tôi sẽ không giúp <color=#00E1FFFF>hắn</color> rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620302
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 4620302,
					"content": "\"Hắn\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620303,
					"content": "Thật cảm ơn các bạn! Suýt nữa là gặp rắc rối rồi, các bạn thật đáng tin cậy hơn kỵ sĩ Tây Phong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620304
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 4620304,
					"content": "#Chuyện nhỏ chuyện nhỏ, dù gì {NICKNAME} là Nhà Lữ Hành, mỗi ngày đều gặp rất nhiều phiền phức.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620305,
					"content": "Nhà Lữ Hành? Hình như có nghe tình báo về bạn, không ngờ lại được <color=#00E1FFFF>người nhận tin</color> cứu một mạng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620306
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 4620306,
					"content": "Oa! Hóa ra cô là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620307,
					"content": "Hahaha... vốn không biết làm sao báo đáp các bạn. Nếu đã vậy, sẽ miễn phí tặng thông tin cho các bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620308
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 4620308,
					"content": "Làm nghề buôn bán tình báo, đều biết sự quan trọng của việc có nhiều bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620309,
						4620311
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 4620309,
					"content": "Có thật là được không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620310
					]
				},
				{
					"id": 4620310,
					"content": "Đương nhiên, dù gì cũng là ân nhân cứu mạng mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620312
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 4620312,
					"content": "Hì, thật là may mắn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620313,
					"content": "Nhưng mà... Có cảm giác tên Kaeya được lợi, đã nói trước chi phí tình báo do hắn trả...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620314,
					"content": "Vậy nghe cho kỹ đây, tình báo về di tích Arcadia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620315
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 4620315,
					"content": "\"Trong thành phố dưới hồ, có 3 tên khổng lồ 6 tay. Hai vị bảo vệ Thần Tượng, một vị bảo vệ tài sản của Thần.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620316
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 4620316,
					"content": "...Hở? Có vậy thôi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620325,
					"content": "Trên giấy viết thông tin còn có một hình vẽ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620317
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 4620317,
					"content": "Ồ... Chẳng lẽ hình vẽ là địa điểm cất giấu kho báu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620318,
					"content": "Hm... khó khăn lắm mới có manh mối, hóa ra lại còn phải giải câu đố.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620319,
					"content": "#Nhưng mà với sự thông minh của {NICKNAME} chắc là không vấn đề gì nhỉ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620320,
						4620321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620320,
					"content": "Tất nhiên rồi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620322
					]
				},
				{
					"id": 4620322,
					"content": "Hm, cho dù không giải được, ít nhất cũng có thể đi hỏi Kaeya, đầu óc hắn cũng có vẻ tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620326,
					"content": "Tin tình báo này tạm thời để ở chỗ các bạn vậy, nếu có quên thì lấy ra coi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620327
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 4620327,
					"content": "Hì hì, cảm ơn tiểu thư Vile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620323,
					"content": "\"Trong thành phố dưới hồ, có 3 tên khổng lồ 6 tay, hai vị bảo vệ Thần Tượng, một vị bảo vệ tài sản của Thần.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620324,
					"content": "...Rốt cuộc là nói về thứ gì? Nếu không muốn làm phiền Kaeya, thì tự mình suy nghĩ xem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620321,
					"content": "...Chắc là... không sao đâu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620322
					]
				},
				{
					"id": 4620311,
					"content": "Cám ơn bạn, bằng hữu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620312
					]
				}
			]
		},
