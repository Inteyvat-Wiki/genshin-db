			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaeya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4620701,
					"content": "\"Cô ấy vốn không yêu hắn. Sự nhiệt tình ở dòng suối xanh chỉ là sự biểu hiện mơ hồ, khi lạnh lẽo cô đơn, trái tim cô ấy mới trở nên thật thà\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620702
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620702,
					"content": "Nghĩ đến cái gì rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620703,
					"content": "Đây không lẽ là trang tiểu thuyết tình yêu các bạn vô tình nhặt được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620704
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620704,
					"content": "Hóa ra nhầm rồi à, chả trách thông minh như tôi cũng không đoán ra được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620705,
					"content": "Hahaha... Tôi nói giỡn đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620706
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620706,
					"content": "Hừ...Anh nghiêm túc chút đi, Kaeya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620707,
					"content": "Haha, câu đố này quả thực khó đoán hơn. Dòng suối xanh... là nói về Thanh Tuyền Trấn sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620708
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620717,
					"content": "Khi có người đang tắm suối?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 4620724,
					"content": "Chảy từ cao đến thấp?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 4620708,
					"content": "\"Sự nhiệt tình ở dòng suối xanh\"... trong tình huống nào thì suối sẽ trở nên nhiệt tình?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620709
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620718,
					"content": "...Chuyện tổn hại văn hóa như vậy, rất hiếm gặp ở Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620719,
					"content": "Chẳng lẽ... đây là sở thích của bạn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620720,
					"content": "Ồ, thật ngại quá, tôi không nên bình phẩm về sở thích của người khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620721,
					"content": "#Này, anh nghĩ {NICKNAME} là người như thế nào chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620723,
					"content": "Ừm... Không lẽ nói về nước suối chảy từ cao đến thấp?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 4620722,
					"content": "Haha. Chủ yếu là nếu như vậy, sự nhiệt tình không phải của nước suối, mà là của người tắm suối.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620725,
					"content": "Suy nghĩ có lý! Ví dụ như... gặp phải thác nước...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620726,
					"content": "Nếu như vậy, tôi nghĩ nó nói về thác nước phía sau Thanh Tuyền Trấn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620727,
					"content": "Chỉ có ở đó, nước suối chảy khắp Mondstadt mới biểu lộ mặt nhiệt tình cháy bỏng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620709,
					"content": "Về \"Trái tim của thác nước\", chắc là vách núi bên trái thác nước, lúc tôi đi tuần tra có nhìn thấy nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620710
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620710,
					"content": "Cuối cùng, \"Khi lạnh lẽo cô đơn\", chắc là nói về Nguyên Tố Băng mà Vision có thể điều khiển.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620711
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620712,
					"content": "Cám ơn Kaeya giúp đỡ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620713
					]
				},
				{
					"id": 4620711,
					"content": "Tốt nhất bạn nên <color=#00E1FFFF>mang theo một người bạn có thể điều khiển Nguyên Tố Băng</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620712
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620713,
					"content": "Không có chi, là một kỵ sĩ Tây Phong nếu đến giải câu đố cũng không làm được, thì làm sao nhìn ra được âm mưu của tội phạm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620714
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620714,
					"content": "Vậy chúng ta đến Thanh Tuyền Trấn xem thử, không làm phiền anh ủ mưu nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620715
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620715,
					"content": "Hả?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620716
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620716,
					"content": "À không phải... không làm phiền anh nhìn thấu âm mưu của tội phạm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
