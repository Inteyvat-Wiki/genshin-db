				"points": []
			},
			"dialogs": [
				{
					"id": 4620401,
					"content": "Mau để tôi xem thử! Thứ cất giấu là thứ gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620402,
					"content": "\"Cô ấy vốn không yêu hắn. Sự nhiệt tình ở dòng suối xanh chỉ là sự biểu hiện mơ hồ, khi lạnh lẽo cô đơn, trái tim cô ấy mới trở nên thật thà.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620407,
					"content": "Lần này cũng có một hình vẽ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620403,
					"content": "Cái gì, còn phải giải câu đố?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620404,
					"content": "Không được, Paimon thấy rất mệt, nhức đầu, có lẽ là do suy nghĩ nhiều quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620405,
					"content": "Bạn rõ ràng là không động não...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620406
					]
				},
				{
					"id": 4620406,
					"content": "Tóm lại lần này nhờ bạn rồi, hì hì. Nếu không nghĩ ra, thì đi nhờ Kaeya giúp vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 46205,
