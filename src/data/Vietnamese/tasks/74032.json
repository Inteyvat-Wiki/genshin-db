			"dialogs": [
				{
					"id": 740320201,
					"content": "Thứ đá xanh xanh vàng vàng đó... chắc chắn có vấn đề, chắc ta sắp chết rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320202
					],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320202,
					"content": "Hmm... Ông không sao chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320203,
					"content": "Ta... về lâu dài thì chắc chúng ta sẽ \"ổn\" thôi. Nhưng ta sẽ \"ổn\" trước mọi người một bước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320204,
						740320206
					],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320204,
					"content": "Ổn thì tốt rồi, tạm biệt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320205
					]
				},
				{
					"id": 740320205,
					"content": "Không không, nghe không ổn chút nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320208,
					"content": "Không, ta không sao thật. Nếu có sao thì cũng đã quá muộn rồi, hic...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320209
					],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320209,
					"content": "Vậy rốt cuộc là ổn hay không ổn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320210
					]
				},
				{
					"id": 740320210,
					"content": "Cháu chóng mặt lắm rồi, có thể nói rõ chút không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320211,
					"content": "Nói rõ thì, gần đây mỗi lần đến khu sản xuất là đầu ta như muốn nứt ra, tay chân lạnh toát, thỉnh thoảng tim còn đập loạn xạ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320212
					],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320212,
					"content": "Chắc chắn ta sắp tiêu đời rồi! Hai cháu có hiểu không, là tiêu rồi đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320213
					],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320213,
					"content": "Nhất định là do thứ đá vàng xanh... Thứ tà ác! Hai cháu biết về phòng thí nghiệm trung tâm của Viện Khoa Học Fontaine đúng không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320214
					],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320214,
					"content": "Tất cả là tại thứ đá vàng xanh đó đã hủy diệt mọi thứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320215,
						740320216
					],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320215,
					"content": "Đi gặp bác sĩ thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320217
					]
				},
				{
					"id": 740320217,
					"content": "Ta là bác sĩ nên tự biết! À không, bây giờ thì không còn nữa... Ta không còn tư cách, không thể chẩn đoán được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320218
					],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320218,
					"content": "Xin hai cháu hãy đi tìm bác sĩ thực thụ có trình độ đến giúp ta với!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320219
					],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320219,
					"content": "#Chà, cảm thấy ông ấy thực sự mắc bệnh không nhẹ... {NICKNAME}, chúng ta đi tìm bác sĩ hỏi thử xem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320216,
					"content": "Hay là đến phòng y tế nghỉ ngơi chút nhé?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320217
					]
				},
				{
					"id": 740320206,
					"content": "Ông đang nói giảm nói tránh sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320207
					]
				},
				{
					"id": 740320207,
					"content": "Nghe không có chút gì là ổn cả...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320208
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7403203,
			"completionStepIds": [
				7403203
