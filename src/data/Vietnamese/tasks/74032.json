			},
			"dialogs": [
				{
					"id": 740320301,
					"content": "Gặp rắc rối sao? Hay là ai gặp rắc rối? Xem sắc mặt của hai người, chắc là người khác gặp rắc rối rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320302
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320302,
					"content": "Đúng là vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320303,
					"content": "Nói rõ tình trạng của ông Lechlade...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740320304
					]
				},
				{
					"id": 740320304,
					"content": "Lại là ông ấy à? Bệnh kinh niên rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320305
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320305,
					"content": "Có chữa được không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320306
					]
				},
				{
					"id": 740320306,
					"content": "Là đang nói về bệnh đau đầu, hay là bệnh hoang tưởng?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320307
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320307,
					"content": "Hả? Vậy là ông ấy không mắc bệnh nghiêm trọng sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320308,
					"content": "Theo kết quả kiểm tra lần trước thì là vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320309
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320309,
					"content": "Nghe nói là ngày trước khi ở ngoài từng bị chẩn đoán sai, bỏ sót triệu chứng khởi phát, dẫn đến như vậy... Haiz, tóm lại, từ sau đợt đó là tinh thần ông ấy rất nhạy cảm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320310
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320310,
					"content": "Nhạy cảm với mọi người, thậm chí là với bản thân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320311
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320311,
					"content": "Vậy đá vàng xanh đó có vấn đề gì không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320312
					]
				},
				{
					"id": 740320312,
					"content": "Nhìn xem, ngoài ông ấy ra thì mọi người đều đang sống sờ sờ đấy thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320313
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320313,
					"content": "Tuy vậy, cũng không thể bỏ mặc được. Hai người cầm thứ này cho ông ấy đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320314
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320314,
					"content": "Cái này... chẳng phải là Nước Tinh Khiết sao? Có chắc là không sao không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320315,
					"content": "Hửm, hai người cũng biết thứ này à. Không sao, ít nhất thì nó không có hại cho cơ thể, lại giúp ông ấy phấn chấn hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320316,
						740320318
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320316,
					"content": "Ông ấy không biết à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320317
					]
				},
				{
					"id": 740320317,
					"content": "Theo tôi biết thì ông ấy luôn tránh xa thứ đồ uống này, nên trước đây đã đưa cho ông ấy... dưới danh nghĩa thuốc bổ. Ông ấy uống xong quả thực đã hồi phục tinh thần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320322
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320322,
					"content": "Thôi được, vậy chúng tôi đem thứ này cho ông ấy đã. Nếu vẫn không được thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320323,
					"content": "Hãy để ông ấy xuống phòng y tế nằm nghỉ. Nói là bác sĩ căn dặn là ông ấy sẽ nghe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320324
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320324,
					"content": "#Được, chúng ta quay về tìm ông ấy thôi, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320318,
					"content": "Hay là uống Fonta đi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320319
					]
				},
				{
					"id": 740320319,
					"content": "Đây chính là vấn đề, ở đây ai ai cũng biết hương vị của Fonta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320320
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320320,
					"content": "Nhưng theo tôi biết, ông ấy chưa từng thử Nước Tinh Khiết, dù sao phạm vi lưu thông cũng có giới hạn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320321
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320321,
					"content": "Trước đây đã đưa cho ông ấy... dưới danh nghĩa thuốc bổ, ông ấy uống xong quả thực đã hồi phục tinh thần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320322
					],
					"speakerTitle": "Arderne"
				}
			]
		},
