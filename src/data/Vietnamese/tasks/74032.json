			"dialogs": [
				{
					"id": 740320401,
					"content": "Chúng cháu về rồi đây, bác sĩ bảo mang thứ này cho ông...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320402,
					"content": "Ông Lechlade cầm lấy Nước Tinh Khiết, một hơi uống sạch.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740320403
					]
				},
				{
					"id": 740320403,
					"content": "Ta thấy đỡ hơn rồi! Phấn chấn trở lại rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320404,
						740320406
					],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320404,
					"content": "Thế là khỏi rồi à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320405
					]
				},
				{
					"id": 740320405,
					"content": "Hiệu quả nhanh thật đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320408,
					"content": "Không hổ danh là bác sĩ có trình độ, Arderne bắt bệnh kê thuốc quá chuẩn, không như ta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320409
					],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320409,
					"content": "Vậy đá vàng xanh thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320410,
					"content": "Rất có vấn đề!",
