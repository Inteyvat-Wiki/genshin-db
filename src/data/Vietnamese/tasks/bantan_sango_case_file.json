			"dialogs": [
				{
					"id": 220150701,
					"content": "Tôi chỉ thấy qua một \"nhà cố vấn luật\" thôi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150702
					]
				},
				{
					"id": 220150702,
					"content": "\"Nhà cố vấn luật\"? À...tôi có nghe qua, cũng không...hiểu nhiều về họ lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150703
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150703,
					"content": "Tôi nghĩ những người này thường sẽ phức tạp hóa vấn đề, rồi sẽ công thức hóa sự phức tạp, sau cùng lại khế ước hóa công thức.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150704
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150704,
					"content": "Nếu có thể thì tôi hy vọng sẽ không bao giờ gặp những người như vậy.",
					"roleType": "TALK_ROLE_NPC",
