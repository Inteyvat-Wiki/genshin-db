			"dialogs": [
				{
					"id": 220150801,
					"content": "Nhìn sắc mặt của bạn, có phải là rất có hứng thú với trụ sở thám tử đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150802,
						220150807
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150802,
					"content": "Tôi cũng có thể làm thám tử sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150803
					]
				},
				{
					"id": 220150803,
					"content": "Bạn muốn làm thám tử? Đây là một nghề vất vả lắm đó, đừng để bị gạt bởi những cuốn truyện trinh thám nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150804
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150804,
					"content": "Trong lúc theo vụ án sẽ không có những trận chiến sinh tử, những pha đuổi bắt khốc liệt hay là ngày nào cũng có án mạng đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150805
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150805,
					"content": "Mà chất đầy văn phòng đều là hồ sơ, lần ra dấu vết của kẻ khả nghi mới là bối cảnh công việc của một thám tử.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150806
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150806,
					"content": "Nhưng mà có miêu tả như vậy thì bạn cũng không hiểu đâu...Đúng lúc tôi có một vụ án nhỏ, bạn theo vụ án này để tìm hiểu công việc của một thám tử nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150815
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150815,
					"content": "Trợ thủ tên Ryuuji của tôi đang thu thập manh mối ngoài kia, tới giờ vẫn chưa về.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150816
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150816,
					"content": "Cũng đến giờ rồi, anh ta chắc phải thu thập đủ manh mối rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150817
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150817,
					"content": "Tôi muốn nhờ bạn đi đón Ryuuji về.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150818,
						220150821
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150818,
					"content": "Không phải là có nguy hiểm gì đó chứ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150819
					]
				},
				{
					"id": 220150819,
					"content": "Tôi đã bàn giao mọi việc cho anh ta rồi, cho dù gặp phải tình huống gì thì dựa vào thân thủ của anh ta cũng sẽ có thể giải quyết được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150820
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150820,
					"content": "Điều mà tôi để tâm tới là anh ta có thể tìm được thứ mà tôi muốn hay không thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150826
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150826,
					"content": "Vậy thì chuyện này tôi giao cho bạn nhé, tôi sẽ chuẩn bị thù lao cho bạn. Tiện thể...bạn cũng có thể trải nghiệm cách làm việc của một thám tử.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150821,
					"content": "Không phải là có sự cố gì đó chứ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150822
					]
				},
				{
					"id": 220150822,
					"content": "Sẽ không đâu, tôi đã bàn giao hết mọi việc cho anh ta rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150823
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150823,
					"content": "Cho dù có xảy ra những tình huống gì đi nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150824
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150824,
					"content": "Thì với thân thủ của anh ta cũng sẽ có thể giải quyết được thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150825
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150825,
					"content": "Điều mà tôi để tâm tới là anh ta có thể tìm được thứ mà tôi muốn hay không thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150826
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150807,
					"content": "Có cảm giác khá phiền phức đây...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150808
					]
				},
				{
					"id": 220150808,
					"content": "Đương nhiên rồi. Nhưng mà thám tử chính là \"người xử lý phiền phức\" mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150809
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150809,
					"content": "Những cái như là trận chiến sinh tử, những pha đuổi bắt khốc liệt, ngày nào cũng có án mạng...đều là thứ phóng đại ra từ tiểu thuyết mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150810
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150810,
					"content": "Mà chất đầy văn phòng đều là hồ sơ, lần ra dấu vết của kẻ khả nghi mới là bối cảnh công việc của một thám tử.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150811
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150811,
					"content": "Nhưng cũng có một điều mà tiểu thuyết trinh thám viết đúng, đó là thám tử sẽ luôn có những trợ thủ khác nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150812
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150812,
					"content": "Vì vậy nên bạn cũng có trợ thủ đúng không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150813
					]
				},
				{
					"id": 220150813,
					"content": "Đương nhiên rồi. Trợ thủ của tôi đang bận ở ngoài kia. Chính vì vậy...tôi cần phải có một trợ thủ khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150814
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150814,
					"content": "Nếu như bạn sẵn lòng thì có thể giúp đỡ tôi không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150815
					],
					"speakerTitle": "Sango"
				}
			]
