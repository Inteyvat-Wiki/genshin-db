				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220150205,
					"content": "Ra là vậy, bạn là \"trợ thủ\" mà hội trưởng nhắc tới sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150206
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150206,
					"content": "Bạn biết tôi sẽ đến sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150207
					]
				},
				{
					"id": 220150207,
					"content": "À...cũng không hẳn. Chỉ là hội trưởng có nói sẽ có người đến giúp thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150208
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150208,
					"content": "Này, các người đang làm gì đó?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150209
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220150209,
					"content": "Đó là Đạo Bảo Đoàn sao? Sao ở gần thành quá vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150210
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220150210,
					"content": "Ryuuji, sao anh lại ở đây, còn có cả người ngoại quốc khả nghi nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150211,
						220150213
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220150211,
					"content": "Bạn nói tôi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150212
					]
				},
				{
					"id": 220150212,
					"content": "Đúng vậy, ở đây chỉ có ngươi là người ngoại quốc thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150215
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220150215,
					"content": "Được rồi, đừng nhạy cảm quá. Ryuuji, anh đến đây làm gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150216
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220150216,
					"content": "Tôi theo lệnh của hội trưởng để theo dõi tên khả nghi và đến được đây, nhưng lại gặp phải Đạo Bảo Đoàn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150217
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150217,
					"content": "Nhà lữ hành này đích thực là trợ thủ của hội trưởng. Ban nãy còn giúp tôi đẩy lùi đám Đạo Bảo Đoàn kia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150218
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150218,
					"content": "Vậy sao...Nhưng mà, tại sao Đạo Bảo Đoàn lại xuất hiện ở gần đây nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150219
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220150219,
					"content": "Ryuuji, ban nãy anh nói gì, kẻ khả nghi...Này! Không lẽ anh theo dõi Đạo Bảo Đoàn từ trong thành ra đây sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150220
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220150220,
					"content": "Đúng vậy, trước đó hội trưởng đang xử lý vụ án trộm cướp liên hoàn, tôi căn cứ theo suy luận của hội trưởng để tìm kiếm manh mối xung quanh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150221
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150221,
					"content": "Sau đó, tôi phát hiện có kẻ khả nghi ở gần Hanamizaka. Nhưng khi hỏi thăm vài câu thì hắn hoang mang chạy mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150222
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150222,
					"content": "Tôi đuổi theo hắn ra khỏi thành, chuyện sau đó thì như mọi người đã thấy đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150223
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150223,
					"content": "Ừm...Ryuuji, sao anh lại nói chuyện rành mạch thế, không phải trước đây anh rụt rè lắm sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150224
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220150224,
					"content": "Đi theo Sango làm việc một thời gian, cả tài ăn nói cũng có tiến bộ đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150225,
						220150228
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220150225,
					"content": "Các bạn đến đây làm gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150226
					]
				},
				{
					"id": 220150226,
					"content": "Là cái tên Andou đó, nói rằng có một tên ngoại quốc tóc vàng khả nghi đang lảng vảng trong thành, muốn đi xem thử.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150227
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220150227,
					"content": "Cho nên hai chúng tôi mới đi theo đến đây, không ngờ bạn lại là trợ thủ của Sango, hiểu lầm thôi, xin lỗi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150232
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220150232,
					"content": "Nhưng mà...Ryuuji, ban nãy anh có nói, anh phát hiện thấy có kẻ khả nghi trong thành sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150233
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220150233,
					"content": "Đúng là vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150234
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150234,
					"content": "Đám người đó dám manh nha vào cả trong thành sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150235
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220150235,
					"content": "Đúng là vậy. Chỉ với chúng tôi...chỉ với chúng tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150236,
						220150237
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150236,
					"content": "(Anh ta đột nhiên nói vấp quá...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150238
					]
				},
				{
					"id": 220150238,
					"content": "À...với khả năng của chúng tôi thì cùng lắm chỉ đánh đuổi được một hai tên Đạo Bảo Đoàn. Muốn truy đuổi triệt để thì cần phải có thêm sự giúp đỡ nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150239
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150239,
					"content": "Hai vị...nếu muốn xem chứng cứ thì có thể vào thành tìm hội trưởng, cô ấy sẽ giải thích rõ ràng cho hai vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150240
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150240,
					"content": "Vậy sao...Amano, vậy chúng ta đi tìm Sango đi, nếu như trong thành có Đạo Bảo Đoàn làm loạn thì chúng ta không thể ngó lơ được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150241
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220150241,
					"content": "À ừm! Vậy chúng ta đi tìm Sango. Ryuuji, anh cũng mau chóng quay về nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150242
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220150242,
					"content": "...Phù.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150243
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150243,
					"content": "Chúng ta trở về đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150244
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150244,
					"content": "Những lời bạn nói ban nãy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150245
					]
				},
				{
					"id": 220150245,
					"content": "Là do hội trưởng nhắn nhủ lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150246
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150246,
					"content": "Đã làm xong việc rồi, chúng ta quay về thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150237,
					"content": "(Anh ta hình như quên bản thân muốn nói gì rồi...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150238
					]
				},
				{
					"id": 220150228,
					"content": "Bạn cũng là truy đuổi theo tên khả nghi đến đây sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150229
					]
				},
				{
					"id": 220150229,
					"content": "Nói vậy cũng không sai, nhưng thực ra bạn lại là tên khả nghi đó, haiz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150230
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220150230,
					"content": "Là cái tên Andou đó, nói rằng có một tên ngoại quốc tóc vàng khả nghi đang lảng vảng trong thành, muốn đi xem thử.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150231
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220150231,
					"content": "Cho nên hai chúng tôi mới đi theo đến đây, không ngờ bạn lại là trợ thủ của Sango, hiểu lầm thôi, xin lỗi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150232
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220150213,
					"content": "Tôi là trợ thủ của Sango",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150214
					]
				},
				{
					"id": 220150214,
					"content": "Trợ thủ của Sango? Nghe xong càng thấy khả nghi hơn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150215
