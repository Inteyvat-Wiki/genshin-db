				},
				{
					"id": 220150602,
					"content": "Liyue không cần đến thám tử lắm đâu. Ai cũng biết ở đó tôn trọng \"khế ước\" như thế nào rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150603
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150603,
					"content": "Vả lại, họ còn có đội \"Thiên Nham Quân\" đi giải quyết mọi vấn đề lớn nhỏ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150604
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150604,
					"content": "Cho dù ở đó có nghề thám tử thì chắc cũng không có mối làm ăn nào mất.",
					"roleType": "TALK_ROLE_NPC",
