				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220150301,
					"content": "Tiểu thư Sango, những lời ban nãy cô nói là thật chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150302
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220150302,
					"content": "Trong thành có vụ trộm liên hoàn, có phải do đám Đạo Bảo Đoàn làm không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150303
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220150303,
					"content": "Đúng đấy. Ban nãy tôi cũng đã có cho anh xem qua bằng chứng, với \"trực giác nghề nghiệp\" của hai vị thì có lẽ đã có phán đoán rồi chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150304
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150304,
					"content": "Đám Đạo Bảo Đoàn đó...đúng là to gan! Không xem chúng ta ra gì!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150305
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220150305,
					"content": "Amano! Chúng ta mau quay về báo cáo lại chuyện này đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150306
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220150306,
					"content": "Nhất định phải tăng cường tuần tra, không thể để đám người có làm loạn như vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150307
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220150307,
					"content": "Tiểu thư Sango, những chứng cứ này có thể cho chúng tôi mượn trước được không? Chúng tôi sẽ dùng để thuyết phục cấp trên để xin viện trợ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150308
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220150308,
					"content": "Không thành vấn đề, anh cứ lấy đi. Dù sao chuyện Đạo Bảo Đoàn làm loạn lớn như vậy đã vượt ngoài khả năng xử lý của Trụ Sở Thám Tử rồi, chỉ có thể trông cậy vào Hiệp Hội thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150309
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150309,
					"content": "Yên tâm đi! Chúng tôi tuyệt đối sẽ không bỏ qua cho đám Đạo Bảo Đoàn đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150310
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220150310,
					"content": "Vất vả cho mọi người quá. Bây giờ xem như...đã chuẩn bị được tương đối rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150311,
						220150313
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150311,
					"content": "Chuẩn bị?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150312
					]
				},
				{
					"id": 220150312,
					"content": "Đúng vậy, hai vị lính tuần tra này chính là \"trợ thủ\" quan trọng mà tôi dùng để khép lại vụ án này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150316
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150316,
					"content": "Sau khi hai vị lính tuần tra đó tăng cường quân lực, Đạo Bảo Đoàn trong thành nhất định sẽ gia tăng cảnh giác..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150317
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150317,
					"content": "Ryuuji, khi tôi nhờ anh theo chân Đạo Bảo Đoàn, anh nhất định đã giao đấu qua với chúng đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150318
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150318,
					"content": "Đúng vậy, đám Đạo Bảo Đoàn đó đã bị tôi và nhà lữ hành này đánh lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150319
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150319,
					"content": "Ừm...tốt lắm, vậy là động tĩnh mà chúng ta tạo ra đã đủ lớn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150320
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150320,
					"content": "Việc tiếp theo là đợi thời cơ thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150321
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150321,
					"content": "Nhà lữ hành, bạn vất vả rồi, đây là thù lao của bạn, hãy nhận lấy nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150322
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150322,
					"content": "Tôi hình như không có giúp được gì cả...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150323
					]
				},
				{
					"id": 220150323,
					"content": "Đừng nói như vậy. Bạn lấy thân phận người ngoại quốc thu hút sự chú ý của Andou, để anh ta dẫn theo Amano tới gặp Ryuuji...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150324
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150324,
					"content": "Sau đó, để họ phát hiện ra sự uy hiếp của Đạo Bảo Đoàn, nhờ vậy mà trong thành mới có thể tăng cường phòng vệ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150325
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150325,
					"content": "Chuyện này, chỉ có bạn mới có thể làm được thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150326
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150326,
					"content": "Dù sao thì nếu như tôi đi báo cho họ thì hiệu quả sẽ không bằng họ \"tự mình phát hiện\" mà, đúng không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150327
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150327,
					"content": "Nói chung thì bạn cứ nhận lấy thù lao này nhé, nói không chừng...sau này tôi sẽ còn tìm bạn để nhờ giúp đỡ nữa đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150313,
					"content": "Bạn muốn làm gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150314
					]
				},
				{
					"id": 220150314,
					"content": "Tôi là thám tử, việc mà tôi cần làm đương nhiên là phá án rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150315
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150315,
					"content": "Hai vị lính tuần tra này chính là \"trợ thủ\" quan trọng mà tôi dùng để khép lại vụ án này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150316
					],
					"speakerTitle": "Sango"
				}
			]
