				"points": []
			},
			"dialogs": [
				{
					"id": 3760701,
					"content": "Hôm nay muốn uống...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760702
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760702,
					"content": "Bỏ bình rượu cậu mò được phía sau quầy xuống cho tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760703
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760703,
					"content": "...Muốn uống lạnh một chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760704
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760704,
					"content": "Được rồi, các người cần trả lời câu hỏi của tôi rồi đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760705
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760705,
					"content": "Để tôi uống trước đã. Tôi sẽ trả tiền... À, trả bằng cách biểu diễn vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760706
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760706,
					"content": "Không phải vấn đề tiền bạc, mà trông cậu chưa đến tuổi mua rượu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760707
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760708,
					"content": "Chi bằng trả lời câu hỏi của tôi trước.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3760709
					]
				},
				{
					"id": 3760710,
					"content": "Người này là ai?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3760711
					]
				},
				{
					"id": 3760707,
					"content": "Cái này thì có thể yên tâm, lúc tôi uống rượu anh còn đang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760708,
						3760710
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760709,
					"content": "Bạn muốn hỏi \"Người này là ai\", đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760711
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760711,
					"content": "Đây chắc là lão gia <color=#00E1FFFF>Diluc</color>, ông chủ lớn đằng sau... ông chủ quán rượu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760712
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760712,
					"content": "Là người rất nổi tiếng đó. Tiện cũng nói luôn, tôi rất thích rượu bồ công anh của nhà anh ấy sản xuất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760713
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760713,
					"content": "Tuy lần nào tôi cũng không mua nổi cả bình...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760714
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760714,
					"content": "Tôi vừa nghe vệ binh nhắc đến chuyện tên trộm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760715
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760715,
					"content": "Phải giải thích trước, tôi đánh giá rất cao việc các người dám đi trộm Đàn Thiên Không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760716
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760716,
					"content": "Dù có là tên ngốc, thì cũng là tên ngốc ngàn năm hiếm gặp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760717
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760717,
					"content": "Không phải do chúng tôi trộm! Thủ phạm thực sự là người khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3760718,
					"content": "Đây là người mới đang được yêu mến của đội Kỵ Sĩ, làm sao đi trộm thánh vật của Mondstadt được chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760719
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760719,
					"content": "#Người mới được yêu thích...? À, hóa ra là {F#cô}{M#cậu} à.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760720
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760721,
					"content": "Thực ra cũng không thân lắm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3760723
					]
				},
				{
					"id": 3760722,
					"content": "Chỉ là có xem anh ấy biểu diễn 1 lần.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3760723
					]
				},
				{
					"id": 3760720,
					"content": "#Thế nào, {F#cô}{M#cậu} là người quen của nhà thơ lang thang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760721,
						3760722
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760723,
					"content": "Ừm... là Nhà Lữ Hành, lại sẵn lòng ra tay giúp khi Mondstadt gặp nguy hiểm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760724
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760724,
					"content": "Người như vậy, gia nhập đội Kỵ Sĩ thật đáng tiếc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760725
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760725,
					"content": "Đội Kỵ Sĩ Tây Phong... cứ sợ sệt e dè với vấn đề của Phong Ma Long, hiệu suất làm việc quá thấp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760726
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760726,
					"content": "Trong phương diện ngoại giao với <color=#00E1FFFF>Fatui</color> cũng nhu nhược và bảo thủ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760727
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760727,
					"content": "Chậc... thôi kệ, tôi cũng không muốn nhắc vấn đề này nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760728
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760728,
					"content": "Xem ra lão gia Diluc rất ghét Đội Kỵ Sĩ Tây Phong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760729
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760729,
					"content": "Chỉ là không cùng chí hướng thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760730
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760730,
					"content": "Đối với thành phố Mondstadt này, tôi có sự kỳ vọng khác...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760731
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760731,
					"content": "Vậy thì hãy trả lời câu hỏi của tôi. Tại sao các người lại muốn trộm Đàn Thiên Không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760732
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760732,
					"content": "Anh thật sự muốn biết sao? Có thể nó sẽ cuốn anh vào những rắc rối của đội Kỵ Sĩ đó?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760733
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760733,
					"content": "...Ha. Tôi không sợ rắc rối, bản thân tôi đã là rắc rối của đội Kỵ Sĩ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760734
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760734,
					"content": "Vậy nếu tôi kể câu chuyện có thật bằng một màn biểu diễn thì anh sẽ tin tôi chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760735
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760735,
					"content": "Tùy theo tình hình, tôi sẽ tự đưa ra phán đoán.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760736
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760736,
					"content": "Vậy thì... anh sẽ thưởng cho buổi biểu diễn của tôi chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760737
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760737,
					"content": "Thù lao có thể là 5 Mora cho đến Đàn Thiên Không, tùy theo câu chuyện của cậu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760738
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760738,
					"content": "Tốt lắm. Vậy thì tôi sẽ biểu diễn thêm một lần...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760739
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760739,
					"content": "Bài thơ kể chuyện lúc nãy, rốt cuộc là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760740
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760740,
					"content": "Đây là bí mật quan trọng. Tại sao lại để tôi biết những chuyện này?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760741
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760741,
					"content": "Tại sao ư? Ừm, có thể là vì hướng gió đang thay đổi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760742
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760742,
					"content": "Thế nào, lão gia Diluc?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760743
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760743,
					"content": "Thú vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760744
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760744,
					"content": "Cho tôi một chút thời gian, để tôi nghĩ cách liên lạc với một số mối quan hệ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760745
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760745,
					"content": "#Người phương xa, hình như vì {F#cô}{M#cậu} có thân phận là Đội Kỵ Sĩ, nên không bị nghi ngờ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760746
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760746,
					"content": "#Trên lệnh truy nã chỉ ghi đặc điểm là tóc vàng, vệ binh chắc sẽ không tìm đến {F#cô}{M#cậu} đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760747
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760747,
					"content": "Nhưng nhà thơ, tốt nhất cậu không nên rời khỏi quán rượu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760748
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760748,
					"content": "Không sao cả! Tôi thích quán rượu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760749
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760749,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760750
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760750,
					"content": "Vậy thì, buổi tối sau khi quán rượu đóng cửa, chúng ta gặp lại nhau ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760751
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4820221,
					"content": "Theo <color=#00E1FFFF>tuyến đường đánh dấu</color> tôi đã làm sẵn, bay thẳng đến mục tiêu nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820222
					],
					"speakerTitle": "Amber"
				}
			]
		}
	]
}