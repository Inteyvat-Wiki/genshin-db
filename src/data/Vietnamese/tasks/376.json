			"dialogs": [
				{
					"id": 3760401,
					"content": "Lão gia Diluc, sổ sách tuần này chỉ có thế này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760402
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 3760402,
					"content": "Đợt bão này, ảnh hưởng tới việc kinh doanh thật lớn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760403
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760403,
					"content": "Hy vọng thời gian này sớm qua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760404
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 3760404,
					"content": "Ông chủ, chúng tôi... muốn một chỗ kín đáo chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760405
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760405,
					"content": "Chỗ kín đáo... lầu hai ít người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760406
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760406,
					"content": "Nhưng cậu là nhà thơ lang thang phải không? Chi bằng chọn chỗ náo nhiệt chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760407
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760407,
					"content": "Ha ha, biểu diễn thì đợi lần sau vậy. Chúng tôi lên trước đây, chút nữa gặp!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760408
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760408,
					"content": "Xem chừng bọn họ. Tên nhà thơ đó rất khả nghi, tôi phải đi dò hỏi tình hình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760409
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760409,
					"content": "A... Hỏi ai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760410
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 3760410,
					"content": "Hỏi \"Bảo Vệ\" thành Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Diluc"
				}
			]
		},
