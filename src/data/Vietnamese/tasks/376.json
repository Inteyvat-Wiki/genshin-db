				"points": []
			},
			"dialogs": [
				{
					"id": 3760601,
					"content": "A, lão gia Diluc, anh nhìn thấy hai tên trộm không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760602
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 3760602,
					"content": "Xảy ra chuyện gì, sao phải điều động nhiều người vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760603
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760603,
					"content": "Lão gia Diluc không nghe nói sao? Có hai tên trộm, dòm ngó Đàn Thiên Không!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760604
					],
					"speakerTitle": "Miles"
				},
				{
					"id": 3760604,
					"content": "Ồ? Thật là kỳ lạ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760605
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760605,
					"content": "Phải đó. Đàn Thiên Không là báu vật Phong Thần đã từng dùng, tài sản văn hóa quý giá như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760606
					],
					"speakerTitle": "Miles"
				},
				{
					"id": 3760606,
					"content": "Không ngờ có người ngốc tới mức muốn trộm món đồ không bán được, không bằng trộm hầm rượu nhà ta còn có giá hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760607
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760607,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760608
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 3760608,
					"content": "A, xin lỗi lạc đề rồi. Hai tên một vàng một xanh đó, hình như đi về phía bên kia rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760609
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760609,
					"content": "Vâng, vâng, cám ơn lão gia Diluc!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Miles"
				}
			]
		},
