			},
			"dialogs": [
				{
					"id": 150360301,
					"content": "#{NICKNAME}, Skirk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360302,
					"content": "Vừa xảy ra chuyện gì vậy? Tôi thấy vai của Skirk hình như bị...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360303,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360304
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360304,
					"content": "#Khi ở Quy Li Nguyên, {F#cô}{M#cậu} hỏi tôi rằng tại sao tên đó lại nhắm đến {F#cô}{M#cậu}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360305
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360305,
					"content": "#Bây giờ thì đáp án đã rất rõ ràng rồi. Ngoài việc bản thân {F#cô}{M#cậu} vốn có thực lực phi phàm ra, thì {F#cô}{M#cậu} còn có năng lực \"thanh tẩy\" Vực Sâu nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360306
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360306,
					"content": "Bản chất của việc thanh tẩy tạm thời chưa nói đến, nhưng nhờ sức mạnh này mà hắn có thể làm được rất nhiều việc vốn dĩ không thể làm được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360307
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360307,
					"content": "Ví dụ như xuyên qua lớp phòng ngự và nuốt chửng sức mạnh của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360308,
						150360309
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360308,
					"content": "Mục tiêu của hắn thực ra là cô sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360310
					]
				},
				{
					"id": 150360310,
					"content": "#Không, chắc hắn không nghĩ là tôi sẽ tới. Việc lấy đi mảnh linh hồn của {F#cô}{M#cậu}, chỉ là vì cho rằng nguồn sức mạnh này rất quý giá, không ngờ lại vừa hay có tác dụng vào lúc này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360311
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360311,
					"content": "Nếu trên thế giới này thật sự có cái gọi là vận mệnh, thì chắc đó chỉ là những sự trùng hợp nhàm chán như vậy thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360312
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360312,
					"content": "#Nhưng với chúng ta cũng là chuyện tốt. Khi tôi biết hắn dùng nó cho mục đích gì, thì tôi sẽ có thể lấy lại thứ mà {F#cô}{M#cậu} đã mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360313
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360313,
					"content": "Nhưng cô...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360314
					]
				},
				{
					"id": 150360314,
					"content": "Tôi tự có tính toán.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360315
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360315,
					"content": "Ăn no chưa? Trả lời câu hỏi của ta nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360316
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360316,
					"content": "Tại sao ngươi lại có quyền năng của Thôn Tinh Kình Ngư?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360317
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360317,
					"content": "Thôn Tinh Kình Ngư?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360318,
					"content": "À... Đúng nhỉ! Hèn gì cái gai nhọn đó trông rất quen! Nó... trông rất giống cái sừng trên đầu Thôn Tinh Kình Ngư!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360319,
					"content": "Quyền năng này không phải ngươi dựa vào sức mạnh của bản thân để có được, phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360320
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360320,
					"content": "Nếu ngươi thực sự có khả năng đánh bại Thôn Tinh Kình Ngư thì sẽ không cần phải đi thu thập loại sức mạnh không hoàn chỉnh như tàn dư Ma Thần ở khắp nơi như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360321
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360321,
					"content": "Ta chỉ có thể nghĩ đến một khả năng. Ngươi có quen biết sư phụ của ta, \"Kỵ Sĩ Cực Ác\" Surtalogi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360322
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360322,
					"content": "\"Kỵ Sĩ Cực Ác\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360323
					],
					"speakerTitle": "Skofnungr"
				},
				{
					"id": 150360323,
					"content": "Ai dám gọi hắn là \"ác\" thế? Surtalogi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360324
					],
					"speakerTitle": "Skofnungr"
				},
				{
					"id": 150360324,
					"content": "Surta... logi...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360325
					],
					"speakerTitle": "Skofnungr"
				},
				{
					"id": 150360325,
					"content": "Bị sức mạnh làm mờ lý trí, mất đi khả năng giao tiếp cơ bản rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360326
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360326,
					"content": "Đợi đã, ta còn chưa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360327
					],
					"speakerTitle": "Skofnungr"
				},
				{
					"id": 150360327,
					"content": "Nhìn kìa! Thứ đó lại tới nữa rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360328
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360328,
					"content": "Kẻ ám ảnh với sức mạnh, thì sẽ không quay đầu trước khi bản thân cũng bị nuốt chửng đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360329
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360329,
					"content": "Bây giờ phải làm thế nào?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360330
					]
				},
				{
					"id": 150360330,
					"content": "#Bình tĩnh. Dùng lý trí để đưa ra lựa chọn mà {F#cô}{M#cậu} cho là phù hợp nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360331
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360331,
					"content": "(Để lấy lại mảnh linh hồn của mình, Skirk đã bị tên đó đâm trúng, sức mạnh cũng bị đoạt mất.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360332
					]
				},
				{
					"id": 150360332,
					"content": "(Hung thủ ở phía sau màn sương mù. Trong trận giao đấu vừa rồi, mình đã dần nắm rõ cách thức tấn công của hắn. Nếu tiếp tục đánh thì khả năng chiến thắng sẽ rất cao.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360333
					]
				},
				{
					"id": 150360333,
					"content": "(Nhưng hơi thở của Skirk đã rất yếu rồi. Nếu hấp tấp tấn công thì không thể đảm bảo an toàn cho cô ấy và Paimon. Tuy không muốn lắm, nhưng đành vậy...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360334
					]
				},
				{
					"id": 150360334,
					"content": "Chúng ta rời khỏi đây trước đã.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360335
					]
				},
				{
					"id": 150360335,
					"content": "#Thắng thua không chỉ trong nhất thời, {F#cô}{M#cậu} đã có phán đoán chính xác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360336
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360336,
					"content": "#{F#Cô}{M#Cậu} lấy lại được mảnh linh hồn của mình, nên mục đích của chuyến đi này đã đạt được rồi. Còn tên đó thì cứ tạm bỏ qua một thời gian nữa cũng không sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360337
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360337,
					"content": "#Đi thôi. Lần này phải nhờ {F#cô}{M#cậu} đưa chúng tôi ra ngoài rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360309,
					"content": "Từ đầu hắn đã có ý đồ với cô sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360310
					]
				}
			]
		},
