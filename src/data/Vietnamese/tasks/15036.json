			"dialogs": [
				{
					"id": 150360101,
					"content": "Nơi này... Tôi nhớ là ở gần Vực Đá Sâu đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360102,
					"content": "#Vào từ đây sẽ có thể đến được không gian trong giấc mơ của {F#cô}{M#cậu}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360103
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360103,
					"content": "Tuy đều là bí cảnh Vực Sâu, nhưng bên đó là địa bàn của kẻ khác, nên vẫn cần phải cẩn thận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360104
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360104,
					"content": "#Yên tâm đi, tôi sẽ trốn sau lưng {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360105,
					"content": "#Hihi, {NICKNAME} cũng đừng miễn cưỡng bản thân quá nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360106,
						150360107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360106,
					"content": "Cứ yên tâm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360108
					]
				},
				{
					"id": 150360108,
					"content": "Đi thôi. Cứ nhớ về những nội dung huấn luyện nhé, sẽ có ích đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360107,
					"content": "Dạy cho tên cướp đó một bài học thôi nào.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360108
					]
				}
			]
		},
