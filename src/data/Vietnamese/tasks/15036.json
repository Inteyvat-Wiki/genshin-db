			"dialogs": [
				{
					"id": 150365001,
					"content": "Trên người hắn ta nhất định có manh mối về sư phụ. Nếu lần sau gặp mặt thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150365002,
						150365005,
						150365008
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150365002,
					"content": "Vết thương còn đau không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150365003
					]
				},
				{
					"id": 150365003,
					"content": "Chỉ là vết thương ngoài da thôi, không cần để tâm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150365004
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150365004,
					"content": "Tuy hồi phục sức mạnh cần phải có thời gian, nhưng khó khăn ở mức độ này thì tôi vẫn thích nghi được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150365005,
					"content": "Trang phục của cô trông hơi khác nhỉ...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150365006
					]
				},
				{
					"id": 150365006,
					"content": "#{F#Cô}{M#Cậu} nói thứ này sao? Năng lượng Vực Sâu ở Teyvat rất mỏng manh. Để có thể tự do sử dụng sức mạnh, tôi đã tạo ra một loại \"Trang Phục Tinh Thể\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150365007
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150365007,
					"content": "Nó chứa nhiều năng lượng Vực Sâu, có thể giúp tôi hành động thuận tiện. Khi hết năng lượng thì sẽ trở về hình dạng ban đầu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150365008,
					"content": "Đi thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150365009
					]
				},
				{
					"id": 150365009,
					"content": "Tìm được chỗ nghỉ ngơi rồi sao? Vậy thì mau đi thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Skirk"
				}
			]
		},
