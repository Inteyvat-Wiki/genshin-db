			"dialogs": [
				{
					"id": 150360501,
					"content": "Phù... Chạy tới đây chắc là an toàn rồi nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360502,
					"content": "Không còn cảm nhận được khí tức của tên đó nữa. Xem ra hắn ta vẫn đang ở trong bí cảnh Vực Sâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360503
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360503,
					"content": "Sức mạnh của tôi không phải là thứ mà kẻ yếu có thể dễ dàng khống chế. Trước khi hắn tiêu hóa xong thì chắc sẽ không rời khỏi chỗ đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360504,
						150360505
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360504,
					"content": "Thôn Tinh Kình Ngư...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360506
					]
				},
				{
					"id": 150360506,
					"content": "#Nhìn {F#cô}{M#cậu} có vẻ rất kinh ngạc đấy nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360507
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360507,
					"content": "#Cũng đúng... {F#Cô}{M#Cậu} chưa thực sự nhìn thấy cảnh con cá voi đó há to miệng như muốn nuốt chửng cả hành tinh vào bụng đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360508
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360508,
					"content": "Thôn Tinh Kình Ngư có quyền năng \"nuốt chửng\". Cho dù là người sống hay vật chết, chỉ cần phá vỡ lớp phòng ngự và chạm trực tiếp vào bản thể đối phương, là sẽ hút được sức mạnh từ trong đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360509
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360509,
					"content": "Khi chúng ta giao đấu với nó, Neuvillette hình như cũng từng nói \"nuốt chửng\" là bản năng của nó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360510,
					"content": "Hậu duệ Rồng Cổ đã nhìn ra được bản chất sức mạnh của nó, nên đã dùng quyền năng của nước để bảo vệ mọi người. Lúc đó, Thôn Tinh Kình Ngư cũng đang no bụng, chưa hoàn toàn phát điên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360511
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360511,
					"content": "Sau khi hoàn toàn tiêu hao hết năng lượng, nó mới dần bộc lộ bản chất thực sự, biến mọi thứ trên hành tinh thành thức ăn. Vì thế, tôi đã giữ nó trong một không gian hư vô đặc biệt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360512
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360512,
					"content": "Nhưng tôi không ngờ là trên hành tinh này vẫn còn người có thể sử dụng quyền năng của nó. Chứng tỏ hắn đã từng gặp Thôn Tinh Kình Ngư từ rất lâu trước đây, có lẽ là người mà sư phụ từng quen biết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360513
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360513,
					"content": "Đúng là hắn có phản ứng mạnh khi cô nói \"Kỵ Sĩ Cực Ác\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360514
					]
				},
				{
					"id": 150360514,
					"content": "Cho nên tôi mới nói, mục đích của chuyến đi này đã hoàn thành rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360515
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360515,
					"content": "#Tiếp theo sẽ là chuyện riêng của tôi. Giờ {F#cô}{M#cậu} đã trở lại dáng vẻ hoàn chỉnh, có thể tiếp tục chuyến hành trình của mình rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360516
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360516,
					"content": "Thế sao mà được chứ! Vì giúp chúng tôi mà sức mạnh của cô mới bị đoạt mất, sao chúng tôi có thể mặc kệ cô được?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360517,
					"content": "Đây không phải lần đầu tiên tôi chịu thất bại và mất đi sức mạnh. Nếu rơi xuống vực thẳm thì cứ leo lên lại, cho đến khi trở nên mạnh mẽ hơn thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360518
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360518,
					"content": "Cho dù là vậy... Nhưng nếu tên đó tìm thấy cô trước khi cô kịp hồi phục thì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360519,
					"content": "Hơn nữa cô đã mất đi sức mạnh, chắc cũng không thể \"vù\" một cái là mở ra cánh cửa đi vào Vực Sâu như trước đây nữa đâu nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360520,
					"content": "Ít nhất là trong khoảng thời gian này đi cùng chúng tôi cũng không tệ mà, đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360521,
						150360522
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360521,
					"content": "Đây không phải xuất phát từ sự đồng cảm đâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360523
					]
				},
				{
					"id": 150360523,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360524
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360524,
					"content": "Tôi hiểu rồi. Cái này cho hai người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360525
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360525,
					"content": "Đây là...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360526
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360526,
					"content": "Túi Mora. Muốn sống ở thế giới này thì phải có tiền, tôi hiểu những kiến thức cơ bản này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360527
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360527,
					"content": "Khoảng thời gian này tùy hai người sắp xếp vậy. Quyết định đi đâu thì mau xuất phát thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360522,
					"content": "Hiện giờ vẫn chưa thể xem là \"chúng ta không nợ gì nhau\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360523
					]
				},
				{
					"id": 150360505,
					"content": "Ngay cả sức mạnh của cô cũng có thể đoạt đi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360506
					]
				}
			]
		},
