				]
			},
			"dialogs": [
				{
					"id": 150360201,
					"content": "Hình như phía trước hết đường rồi! Đây chính là nơi cái tên xấu xa đó đang trốn đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360202,
					"content": "Sương mù dày quá, không nhìn thấy gì cả!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360203,
					"content": "#Lúc trước {F#cô}{M#cậu} đã bị tấn công ở đây và mất một mảnh linh hồn phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360204
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360204,
					"content": "#{F#Cô}{M#Cậu} có cảm nhận được mảnh linh hồn đó đang ở đâu không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360205
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360205,
					"content": "(Để thử nhắm mắt và nhớ lại điểm sáng trôi ra khỏi cơ thể khi đó... Dường như nó ở ngay gần đây thôi, nhưng không rõ phương hướng cụ thể.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360206,
						150360207
					]
				},
				{
					"id": 150360206,
					"content": "Không được...!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360208
					]
				},
				{
					"id": 150360208,
					"content": "#Xem ra đối phương cũng đã sớm che giấu khí tức của mình rồi. Nếu không thì {F#cô}{M#cậu} hẳn đã cảm nhận được rõ ràng hơn nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360209
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360209,
					"content": "Khoan đã, mau nhìn kìa! Những chiếc gai nhọn đó lại xuất hiện rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360210,
					"content": "Cứ bình tĩnh và quan sát trước đã. Khi đánh trả hãy giảm bớt lực một chút, nếu chúng ta quá liều lĩnh thì có thể sẽ rơi vào tay kẻ địch đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360211
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360211,
					"content": "#Đối phương đã đoạt mảnh linh hồn của {F#cô}{M#cậu}, nên chắc sẽ dùng nó để làm gì đó hoặc giấu trong chiêu thức tấn công. Thử nghĩ cách tìm ra xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360207,
					"content": "Chỉ có thể cảm nhận được là nó đang ở gần đây thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360208
					]
				}
			]
		},
