					"speakerTitle": "Baizhu"
				},
				{
					"id": 150365102,
					"content": "Hm, thật không đơn giản chút nào. Nhưng bây giờ vui mừng thì còn quá sớm nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150365103
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 150365103,
					"content": "Đúng vậy. Bệnh vừa mới khỏi, theo dõi thêm một thời gian nữa thì hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
