			"dialogs": [
				{
					"id": 150360601,
					"content": "Kiểm tra mới thấy, túi của Skirk có nhiều Mora thật đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360602,
					"content": "Chẳng lẽ cô ấy cũng đi làm thêm à? Không đúng, còn nhớ chuyện lúc ở Vạn Dân Đường chứ? Nếu cô ấy mà đi làm thì chắc chắn sẽ thành ra như vầy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360603,
					"content": "\"Ông chủ, trả lương tháng này đi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360604,
					"content": "\"Được. Mà khoan đã... Cô là ai? Chúng ta quen nhau à?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360605,
					"content": "Hihi, dù sao thì những người từng gặp cô ấy cũng đều sẽ quên mất mà. Vậy số Mora này từ đâu ra vậy nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360606,
					"content": "Kho báu vô chủ trong lòng đất, và tiện tay giải quyết vài đám ma vật gây rối thôi. Đều là tiền sạch đấy, cứ yên tâm dùng đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360607
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360607,
					"content": "Ốiii! Cô nghe thấy à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360608,
					"content": "Nói lớn như vậy, đứng trên đỉnh núi bên ngoài cũng nghe thấy luôn ấy chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360609
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360609,
					"content": "Hả? Đợi đã, đừng nói là những thứ tôi nói sau lưng cô trước đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360610,
					"content": "Ý là khi cô bảo tôi là \"Dưa Tím Lạnh Lùng\" à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360611,
						150360612
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360611,
					"content": "Quả nhiên là bị nghe thấy rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360613
					]
				},
				{
					"id": 150360613,
					"content": "Chuyện đó... Thật ra câu đó không phải do tôi nói đâu! Có một người rất giống tôi, rất thích lén mạo danh tôi để đặt biệt danh kỳ quái cho người khác đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360614,
					"content": "#...Thôi được rồi, tôi sai rồi. Lúc đó tôi không ưa cô lắm, nhưng bây giờ tôi thấy cô cũng không tệ. Dù sao cô cũng đã giúp {NICKNAME} một việc lớn mà... Chúng ta có thể làm bạn không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360615,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360616
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360616,
					"content": "Tôi vừa xem qua rồi, ở đây chỉ có một chiếc giường thôi. Hai người nghỉ ngơi đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360617
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360617,
					"content": "Hả? Vậy còn cô thì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360618,
					"content": "Tôi không cảm thấy mệt mỏi, cũng không cần nghỉ ngơi. Tôi cần ra ngoài vung kiếm, như vậy mới có thể nhanh chóng hồi phục sức mạnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360619
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360619,
					"content": "Nhưng cơ thể cô... Ủa! Đợi đã, đi luôn rồi à!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360620,
					"content": "Tức chết đi được. Hừm! Thôi kệ cô ấy, mệt rồi thì sẽ tự khắc quay về nghỉ ngơi thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360621
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360621,
					"content": "Chúng ta ngủ thôi! Đi ngủ trên chiếc giường êm ái nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360622
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360622,
					"content": "(Skirk có quan điểm rất rõ ràng, bây giờ có khuyên thì chắc cô ấy cũng sẽ không đồng ý.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360623
					]
				},
				{
					"id": 150360623,
					"content": "(Paimon nói đúng, nếu Skirk thấy mệt thì chắc đã dừng tập luyện rồi. Giờ mình cứ đi ngủ trước vậy.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360624
					]
				},
				{
					"id": 150360624,
					"content": "Hộc... hộc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360625
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360625,
					"content": "(Skirk...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360626
					]
				},
				{
					"id": 150360626,
					"content": "(Không hổ danh là Skirk, hồi phục sức mạnh nhanh thật. Nhưng trông cô ấy có hơi kỳ lạ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360627
					]
				},
				{
					"id": 150360627,
					"content": "Phù...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360628
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360628,
					"content": "...Yên lặng nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360629
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360629,
					"content": "(Yên lặng? Xung quanh rõ ràng không có ai nói chuyện cả. Chẳng lẽ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360630
					]
				},
				{
					"id": 150360630,
					"content": "Nhớ về chúng ta đi, có bao nhiêu người đã chết trong đám cháy lớn đó? Chỉ có một mình cô sống sót.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360631
					],
					"speakerTitle": "Người Qua Đường Hoảng Loạn"
				},
				{
					"id": 150360631,
					"content": "Đừng rời mắt khỏi thanh kiếm, cô vẫn chưa có tư cách nghỉ ngơi đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360632
					],
					"speakerTitle": "Người Qua Đường Hoảng Loạn"
				},
				{
					"id": 150360632,
					"content": "Chạy đi, Skirk. Trước khi cái chết kéo đến, con phải không ngừng chạy tiếp...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360633
					],
					"speakerTitle": "Giọng Nam Vui Vẻ"
				},
				{
					"id": 150360633,
					"content": "(Đúng rồi. Lần đó trong mơ, Skirk cũng đang luyện kiếm sau một trận thua, có rất nhiều tạp âm không rõ ở phía sau.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360634
					]
				},
				{
					"id": 150360634,
					"content": "(Một trong số họ nhắc đến hỏa hoạn... Rốt cuộc đã xảy ra chuyện gì nhỉ? Giá như cô ấy chịu kể thì tốt biết mấy...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360635
					]
				},
				{
					"id": 150360635,
					"content": "Ngủ sớm dậy sớm tốt cho sức khỏe! Chiếc giường này thoải mái thật đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360636
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360636,
					"content": "Skirk, cô ngồi ở đây cả đêm sao? Có muốn nghỉ ngơi chút không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360637
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360637,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360638
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360638,
					"content": "Sức mạnh của cô đã hồi phục chưa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360639
					]
				},
				{
					"id": 150360639,
					"content": "Đã hồi phục sáu bảy phần rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360640
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360640,
					"content": "Nhanh vậy sao! Tôi còn tưởng ít nhất cũng phải mất mấy ngày chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360641
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360641,
					"content": "Không... Thế là chậm hơn tôi dự kiến đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360642
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360642,
					"content": "Nếu là trước đây thì sức mạnh phải còn hồi phục được thêm hai phần nữa. Cách thức giống nhau, cảm nhận giống nhau, vậy mà kết quả lại kém đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360643
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360643,
					"content": "Chẳng lẽ là bị ảnh hưởng bởi cái gai kia sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360644
					]
				},
				{
					"id": 150360644,
					"content": "Chắc là do bản thân tôi có vấn đề.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360645
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360645,
					"content": "Hai ngày tới tôi cần phải ngồi thiền ở đây, để cho ý thức hoàn toàn chìm sâu vào nội tâm, xem xem rốt cuộc đã xảy ra chuyện gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360646
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360646,
					"content": "Thiền à! Nghe lợi hại ghê, vậy chúng tôi ở bên cạnh bảo vệ cho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360647
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360647,
					"content": "Làm phiền rồi, hai ngày sau gặp lại nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360612,
					"content": "Trình độ nói thầm của Paimon vẫn cần phải cải thiện đấy.",
