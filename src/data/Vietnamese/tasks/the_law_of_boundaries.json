					"nextDialogs": [
						100091119
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100091119,
					"content": "Ấy, không được. Tôi không muốn thành ra như vậy đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100091120,
					"content": "À phải rồi, tôi... tôi còn thắc mắc! Sao Sucrose cứ mãi nghiên cứu về Hoa Ngọt với Quả Nhật Lạc vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100091121,
					"content": "Tất nhiên là vì... dù là Quả Nhật Lạc khi ăn, hay đường chiết xuất từ Hoa Ngọt, thì chúng cũng đều rất ngọt ngào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091122
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100091122,
					"content": "Xét từ góc độ này, thí nghiệm \"Hoa Lừa Dối to gấp 16 lần\" này còn có thêm thu hoạch ngoài lề, bởi vì mật của Hoa Lừa Dối...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091123
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100091123,
					"content": "...Có vị giống với Hoa Ngọt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100091124,
					"content": "Đúng vậy. Đợi khi chiết xuất được đường từ mật của loại hoa này, tôi sẽ gửi cho hai người một phần nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091125
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100091125,
					"content": "Hì hì, hứa đấy nhé!",
