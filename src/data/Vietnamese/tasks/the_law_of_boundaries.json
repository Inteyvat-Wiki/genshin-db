					}
				]
			},
			"dialogs": [
				{
					"id": 100090101,
					"content": "Hmm... Dựa trên kết quả trước đây rồi điều chỉnh lại kế hoạch thí nghiệm nào! Sau đó, phải kiểm tra thiết bị và nguyên liệu thí nghiệm nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090102
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090102,
					"content": "#À, thuốc giả kim phải làm hôm nay... Ơ, {NICKNAME} và Paimon, sao hai người lại đến đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090103
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090103,
					"content": "Hihi, chúng tôi đến để giúp cô hoàn thành \"bài tập\" đây. Chúng tôi định xem thử có giúp được gì không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090104,
					"content": "#\"Bài tập\" à... Ah, {F#cô}{M#cậu} đang nói đến bài tập của Hội Ma Nữ mà anh Albedo đề cập phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090105
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090105,
					"content": "Thật trùng hợp, vừa hay hôm nay tôi có lịch thí nghiệm định kỳ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090106
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090106,
					"content": "Định kỳ? Vậy chẳng phải Sucrose vẫn làm thí nghiệm này suốt sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090107,
					"content": "Đúng vậy. Nhưng vì nó có phương hướng khá sát với các nội dung nghiên cứu khác của tôi, nên việc tiếp tục thí nghiệm về bài tập này cũng không quá nặng nề.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090108
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090108,
					"content": "Nhưng mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090109
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090109,
					"content": "Sao vậy, thí nghiệm gặp khó khăn à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090110,
					"content": "Ừm, thí nghiệm vẫn chưa thể thành công.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090111
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090111,
					"content": "À, nghĩa là đã thất bại rất nhiều lần rồi à...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090112,
					"content": "Không chỉ đơn giản xem đó là \"thất bại\". Nguyên lý ẩn chứa đằng sau bài tập này còn phức tạp hơn tưởng tượng nhiều...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090113
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090113,
					"content": "Vậy rốt cuộc là bài tập gì đây...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100090114
					]
				},
				{
					"id": 100090114,
					"content": "Đúng vậy, nói nãy giờ mà vẫn chưa biết cụ thể phải làm thí nghiệm gì đó?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090115,
					"content": "Thí nghiệm phát triển thuốc có thể biến Hoa Ngọt thành \"Hoa Ngọt Lớn Gấp 16 Lần\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090116
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090116,
					"content": "Cũng chính là công thức thuốc giả kim \"Dung Dịch Tăng Trưởng Thực Vật Loại 4 Mẫu Thứ 7\". Nhân tiện nói thêm, gọi là \"Mẫu Thứ 7\", vì hôm nay là lần thứ bảy tiến hành thí nghiệm này rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090117
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090117,
					"content": "Lớn gấp, gấp 16 lần á?! Tóm lại, tôi hiểu rồi, chúng ta cần làm \"thuốc tăng kích thước\" phiên bản thứ 7!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090118,
					"content": "Phiên bản thứ 7 của \"thuốc tăng kích thước\"... Ừm, đúng vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090119
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090119,
					"content": "Tuy là phiên bản thứ 7, nhưng công thức không có nhiều thay đổi, vì cả nguyên lý lẫn sản phẩm thí nghiệm đều đã được chứng minh là không có vấn đề gì rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090120
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090120,
					"content": "Nhưng sao vẫn \"chưa thành công\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090121,
					"content": "Ừm, nên tôi đang nghĩ, có lẽ là... cần thêm yếu tố khác can thiệp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090122
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090122,
					"content": "Hihi... Rõ ràng yếu tố khác biệt đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090123,
						100090125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090123,
					"content": "Vậy chúng ta giúp thử xem!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100090124
					]
				},
				{
					"id": 100090124,
					"content": "Ừm, vốn dĩ chúng ta đến đây là để xem có giúp được gì không mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090127,
					"content": "Nếu cho Paimon vào thì tỷ lệ nguyên liệu ban đầu sẽ phải điều chỉnh lại, hiệu quả có khi không bằng công thức đã ổn định trước đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090128
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090128,
					"content": "Tôi không muốn làm nguyên liệu đâu, mau lấy công thức bình thường ra đây đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090129,
					"content": "Đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090130
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090130,
					"content": "Có điều, vẫn còn thiếu hai nguyên liệu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090131
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090131,
					"content": "Hihi, cứ để chúng tôi lo. Đó là gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090132,
					"content": "Nước từ Thanh Tuyền Trấn làm nền cho công thức, và một thứ hơi phiền phức là mảnh vỡ của Mắt Bão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090133
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090133,
					"content": "Được, chúng tôi xuất phát đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090125,
					"content": "Lấy Paimon làm nguyên liệu chế thuốc vậy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100090126
					]
				},
				{
					"id": 100090126,
					"content": "Chắc chắn sẽ tạo ra thuốc giả kim lợi hại... Không đúng! Sao lại lấy tôi làm nguyên liệu chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090127
					],
					"speakerTitle": "Paimon"
				}
			]
		},
