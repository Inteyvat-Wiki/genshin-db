					"nextDialogs": [
						100091112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100091112,
					"content": "Hmm, có khi chính người chế thuốc cũng có ảnh hưởng nhất định chăng? Hay do Hoa Lừa Dối này là một cá thể đặc biệt nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091113
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100091113,
					"content": "Sau bài tập này lại đến bài tập khác, còn nhiều phương hướng phải xác nhận lắm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091114
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100091114,
					"content": "#Vậy à? Nếu cần thì tôi và {NICKNAME} chắc chắn sẽ đến giúp đỡ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100091115,
					"content": "Thuốc tăng kích thước cho Paimon dùng được không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100091116
					]
				},
				{
					"id": 100091116,
					"content": "Nếu dùng thuốc này, biết đâu tôi cũng sẽ biến thành \"Paimon to gấp 16 lần\", một đấm hạ gục đám Đạo Bảo Đoàn đến cướp đồ đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100091117,
					"content": "Chắc là không được đâu. Hoa Lừa Dối thành công là vì cấu trúc trong cơ thể nó có điểm tương đồng với Hoa Ngọt... Nếu Paimon uống vào thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091118
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100091118,
					"content": "Có thể sẽ biến thành \"Paimon phiên bản cây cối to gấp 16 lần\".",
