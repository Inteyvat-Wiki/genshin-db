			"dialogs": [
				{
					"id": 100090601,
					"content": "Nguyên liệu cũng đã đầy đủ, Nồi Giả Kim dùng để luyện chế ở đằng kia... Có thể bắt đầu bất cứ lúc nào. Hmm... Nhưng mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090602
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090602,
					"content": "Còn khó khăn gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090603,
					"content": "Không không, chỉ là... để phục vụ ghi chép chính xác, tôi có thể quan sát quá trình chế tác của hai người được không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090604
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090604,
					"content": "Thực ra có nhiều người không thích bị quan sát khi đang làm thí nghiệm... Nên tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090605
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090605,
					"content": "Đương nhiên không thành vấn đề rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100090606
					]
				},
				{
					"id": 100090606,
					"content": "Cảm ơn. Nếu chuẩn bị xong rồi thì chúng ta bắt đầu nhé, tôi sẽ ghi chép thật cẩn thận, không bỏ sót chi tiết nào đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090607
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090607,
					"content": "Sao rồi, bắt đầu chế tác ngay thôi nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sucrose"
				}
			]
