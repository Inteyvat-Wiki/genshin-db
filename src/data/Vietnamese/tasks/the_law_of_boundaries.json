						100091106
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100091106,
					"content": "Thí nghiệm thành công chẳng phải là chuyện tốt sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100091107,
					"content": "Vẫn chưa thể xác định kết quả thành công của thí nghiệm này sẽ có ảnh hưởng thế nào. Nhưng nếu sau này có thể liên tục thành công...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091108
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100091108,
					"content": "Vậy thì chứng tỏ đã có sự thay đổi... Có lẽ, giới hạn của quy luật đang dần thay đổi vì điều gì đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091109
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100091109,
					"content": "Tuy không biết sự thay đổi này là tốt hay xấu, nhưng xét từ góc độ nghiên cứu thuật giả kim, giới hạn được mở rộng sẽ mang đến nhiều khả năng hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091110
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100091110,
					"content": "Vậy là, \"bài tập\" về giới hạn cũng kết thúc rồi.",
