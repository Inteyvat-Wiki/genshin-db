			"dialogs": [
				{
					"id": 100090801,
					"content": "Hoàn thành rồi... Quá trình vô cùng hoàn hảo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090802
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090802,
					"content": "Thật sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090803,
					"content": "Ừm, xét về quá trình chuyển hóa của thuốc thì không có sai sót gì... Để tôi lấy một ít đem đi thử nghiệm thành phần, đợi chút nhé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090804
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090804,
					"content": "Sucrose lấy một ít thuốc đã luyện chế xong, dùng dụng cụ thí nghiệm bên cạnh để kiểm tra thành phần thật cẩn thận...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						100090805
					]
				},
				{
					"id": 100090805,
					"content": "Ừm, quá trình luyện chế hoàn hảo, nên kết quả cũng rất hoàn hảo. Đúng như những gì tôi dự đoán.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090806
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090806,
					"content": "Vậy thì \"thuốc tăng kích thước\" phiên bản thứ 7 mà chúng tôi điều chế...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090807,
					"content": "Giống hệt với 6 phiên bản trước của \"Dung Dịch Tăng Trưởng Thực Vật Loại 4\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090808
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090808,
					"content": "Hm... Vậy chẳng phải kết quả cũng giống hệt sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090809,
					"content": "Không. Mỗi lần thí nghiệm, dù mọi thứ có giống nhau đến mấy thì vẫn sẽ có khác biệt nhất định. Sẽ không ai biết được kết quả trước khi hoàn thành, vậy nên thí nghiệm mới có ý nghĩa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090810
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090810,
					"content": "Đi thôi, chúng ta đến địa điểm thí nghiệm nào, ở đó đã có sẵn Hoa Ngọt trồng riêng rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090811
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090811,
					"content": "Chỉ cần tưới \"Dung Dịch Tăng Trưởng Thực Vật Loại 4 Phiên Bản 7\" lên Hoa Ngọt là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sucrose"
				}
			]
		},
