			"dialogs": [
				{
					"id": 733520101,
					"content": "Xin chào Nhà Lữ Hành và người bạn nhỏ phương xa, Lễ Hội Sabzeruz chơi vui chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733520102
					],
					"speakerTitle": "Masud"
				},
				{
					"id": 733520102,
					"content": "Nếu hai vị vẫn còn hứng thú thì Vua Trò Chơi Ảo ta đây xin được mời hai vị chơi thử trò chơi mới là \"Xe Hoa Lắc Lư\", chỉ được mở trong thời gian Lễ Hội Sabzeruz nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733520103
					],
					"speakerTitle": "Masud"
				},
				{
					"id": 733520103,
					"content": "Xe Hoa Lắc Lư?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733520104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733520104,
					"content": "Vừa nghe cái tên này là tôi tưởng tượng ra... Hình ảnh Nahida ngồi trên Xe Hoa đung đưa lắc lư đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733520105,
						733520106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733520105,
					"content": "Nghe cũng thấy vui lây!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733520107
					]
				},
				{
					"id": 733520107,
					"content": "Tuyệt vời! \"Thảo Thần đại nhân mỗi ngày đều vui vẻ hạnh phúc\" chính là nguyện vọng của người dân Sumeru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733520108
					],
					"speakerTitle": "Masud"
				},
				{
					"id": 733520108,
					"content": "Liên tưởng của hai vị... Quả là một cảnh tượng tuyệt vời, xứng đáng được vẽ thành một bức tranh đẹp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733520109
					],
					"speakerTitle": "Masud"
				},
				{
					"id": 733520109,
					"content": "Có điều, bầu không khí của trò chơi này sôi động hơn. So với việc ăn mừng vui vẻ thì nó giống với một chuyến mạo hiểm hơn vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733520110
					],
					"speakerTitle": "Masud"
				},
				{
					"id": 733520110,
					"content": "\"Dù thông minh hay ngốc nghếch, dù ngoan ngoãn hay nghịch ngợm, mỗi đứa trẻ với một tâm hồn trong trẻo đều sẽ có được Xe Hoa của riêng mình trong Lễ Hội Sabzeruz...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733520111
					],
					"speakerTitle": "Masud"
				},
				{
					"id": 733520111,
					"content": "\"Ngồi lên chiếc xe này, lũ trẻ sẽ mở ra hành trình có một không hai của bản thân, đối mặt với nguy hiểm, và cũng thành công vượt qua trở ngại, chuyển nguy thành an, tìm thấy kho báu của ngàn đóa hoa tươi...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733520112,
						733520113
					],
					"speakerTitle": "Masud"
				},
				{
					"id": 733520112,
					"content": "Paimon vừa thông minh lại vừa ngoan này.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733520114
					]
				},
				{
					"id": 733520114,
					"content": "Hihi, nói đúng lắm! Kho báu của ngàn đóa hoa tươi, đến lúc đoạt lấy nó rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733520115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733520115,
					"content": "Vậy hai vị cứ chơi thoải mái, tận hưởng trò chơi cho đã nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Masud"
				},
				{
					"id": 733520113,
					"content": "Chúng tôi đều rất giỏi chuyển nguy thành an đó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733520114
					]
				},
				{
					"id": 733520106,
					"content": "Nghe xong là muốn xem Nahida lắc lư...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733520107
					]
				}
			]
		}
	]
}