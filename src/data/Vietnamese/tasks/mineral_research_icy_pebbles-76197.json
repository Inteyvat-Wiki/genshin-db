			"dialogs": [
				{
					"id": 761970120,
					"content": "(test) Lời thoại",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						761970101
					]
				},
				{
					"id": 761970101,
					"content": "Năm đó khi phiêu bạt trên biển, tôi từng nghe thấy tiếng gọi không biết phát ra từ đâu, những người khác thì thờ ơ, nhưng tôi lại nhanh chóng bị mê hoặc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970102
					],
					"speakerTitle": "Viljami"
				},
				{
					"id": 761970102,
					"content": "Chắc chắn là tiếng gọi từ thế giới khác đấy, em cũng từng nghe thấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970103
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 761970103,
					"content": "Sau này tôi mới nhận ra rằng, lời gọi đó chứa đựng tất cả những ước mơ chưa thể đến được bờ bên kia, có thể nói là tập hợp của oán niệm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970104
					],
					"speakerTitle": "Viljami"
				},
				{
					"id": 761970104,
					"content": "Anh nên mang theo Đá Lạnh Giá, nhìn qua lỗ rỗng ở giữa là có thể thấy được ai đang gọi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970105
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 761970105,
					"content": "Nhưng lúc đó tôi vẫn còn là tên nhóc trẻ người non dạ, dù có thấy nguy hiểm cũng chỉ coi đó là cơ hội, nên cứ thế đâm đầu vào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970106
					],
					"speakerTitle": "Viljami"
				},
				{
					"id": 761970106,
					"content": "Nghe nói lỗ rỗng ở giữa Đá Lạnh Giá chính là cánh cổng dẫn đến dị giới... Nhưng mà, làm sao để đi qua được đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970107
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 761970107,
					"content": "Và sau đó... sóng gió biển cả đã cuốn đi tài sản, danh dự và cả gia đình của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970108
					],
					"speakerTitle": "Viljami"
				},
				{
					"id": 761970108,
					"content": "Những cuộc mạo hiểm bị thúc đẩy bởi dã tâm và tham vọng chưa bao giờ mang đến kết cục tốt đẹp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970109
					],
					"speakerTitle": "Viljami"
				},
				{
					"id": 761970109,
					"content": "A, bị kẹt rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970110
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 761970110,
					"content": "Để chị giúp em lấy ra nhé. Lần sau đừng làm thế nữa đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970111
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761970111,
					"content": "Chị Linnea, sao hôm nay chị có thời gian về đây vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970112
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 761970112,
					"content": "Chị đến gần đây để thu thập Đá Lạnh Giá, thấy hai người đang nói chuyện nên ghé qua chào hỏi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970113
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761970113,
					"content": "Đúng rồi, nếu là chị Linnea thì có lẽ thật sự có thể dùng Đá Lạnh Giá để mở cánh cổng dẫn đến dị giới...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970114
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 761970114,
					"content": "Dù là chị thì cũng không làm được đâu, chị đã nói với em rồi mà? Đó chỉ là truyền thuyết dân gian bịa đặt vô căn cứ thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970115
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761970115,
					"content": "Hóa ra không được à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970116
					],
					"speakerTitle": "Viljami"
				},
				{
					"id": 761970116,
					"content": "Hóa ra anh cũng đang nghe đấy à.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970117
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761970117,
					"content": "Khụ... Không, tôi không còn là tôi của ngày xưa nữa, bây giờ tôi biết đủ, không còn mong cầu gì thêm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970118
					],
					"speakerTitle": "Viljami"
				},
				{
					"id": 761970118,
					"content": "Thế thì thật đáng tiếc. Vậy để em giúp chị Linnea thu thập Đá Lạnh Giá nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970119
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 761970119,
					"content": "Được, vậy thì làm phiền em nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970124
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761970124,
					"content": "Với sự giúp đỡ của Auni, mọi thứ đã được thu thập nhanh chóng...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						761970122
					]
				},
				{
					"id": 761970122,
					"content": "Cảm ơn nhé, nhưng chị đã thu thập đủ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970123
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761970123,
					"content": "Được rồi, vậy em sẽ đến Thung Lũng Moley tìm ông Moley và mọi người. Tạm biệt nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Auni"
				}
			]
		},
