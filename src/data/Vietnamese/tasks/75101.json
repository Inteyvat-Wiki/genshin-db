			"dialogs": [
				{
					"id": 751010101,
					"content": "Ồ, như vậy mới đúng chứ... Loại cảm giác kết nối vững chắc với Thất Thiên Thần Tượng này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751010102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751010102,
					"content": "Vậy thì tình trạng bất thường trước đó là do tên xấu xa ở trong Vương Quốc Dạ Thần làm loạn! Xem ra trước đây Thất Thiên Thần Tượng cũng đã rất vất vả rồi... Làm tốt lắm, tượng thần!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751010103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751010103,
					"content": "Mặc dù sức mạnh cộng hưởng với Nguyên Tố Hỏa cũng không phải do tượng thần ban cho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751010104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751010104,
					"content": "Ừm, điều đó xảy ra khi tôi chiến đấu cùng Hỏa Thần...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751010105
					]
				},
				{
					"id": 751010105,
					"content": "#Đúng vậy, khi đó tôi rất lo lắng đó... Nhưng quả nhiên {NICKNAME} vẫn mạnh hơn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
