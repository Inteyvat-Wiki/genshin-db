			"dialogs": [
				{
					"id": 748000401,
					"content": "Tại sao lại trốn rồi, xung quanh đây đâu có gì đâu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 748000402,
					"content": "Bạn không thấy Robot Hiến Binh kia à? Ở ngay trước mặt chúng ta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000403,
						748000404
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000403,
					"content": "Nó... làm sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000405
					]
				},
				{
					"id": 748000405,
					"content": "Suỵt, mau rời khỏi đây, nếu Robot Hiến Binh này mất kiểm soát thì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000406
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000406,
					"content": "Hoặc là lõi... lõi năng lượng của nó đột nhiên phát nổ, hoặc nó bị người ta điều khiển để tấn công chúng ta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000407
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000407,
					"content": "Nhưng nó đang rất bình thường mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000408
					]
				},
				{
					"id": 748000408,
					"content": "Đây chính là cái mà tôi sợ. Một máy móc vốn bình thường đột nhiên mất kiểm soát, khiến kẻ xui xẻo nào đó mất mạng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000409
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000409,
					"content": "Chuyện này sẽ không có bất kỳ ai chịu trách nhiệm, không chừng kẻ chủ mưu là cũng chẳng thể tìm ra... Thật quá nguy hiểm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000410
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000410,
					"content": "Nó đi rồi đấy, cô ra được rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 748000411,
					"content": "Haiz, nó không bị mất kiểm soát, đúng là nằm ngoài dự kiến. Chúng ta lại giữ được cái mạng này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000412,
						748000413
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000412,
					"content": "Vốn dĩ không có khả năng xuất hiện tai nạn đó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000414
					]
				},
				{
					"id": 748000414,
					"content": "Thứ tôi muốn nghĩ tới, chính là một \"tai nạn thuần túy do con người tạo ra\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000415
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000415,
					"content": "Đợi chút. Không có chủ mưu... thì sẽ không có bất kỳ ai chịu trách nhiệm cho vụ án...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000416
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000416,
					"content": "Đúng! Tôi có cảm hứng rồi. Mau đến quán cà phê thôi, tôi phải nhanh chóng viết nó ra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000417
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000417,
					"content": "Này! Chậm thôi, cô không sợ có người ném đá bất thình lình làm cô vấp ngã à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 748000413,
					"content": "Ngay từ đầu nó đã không thể bị mất kiểm soát.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000414
					]
				},
				{
					"id": 748000404,
					"content": "Hmm... rồi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000405
					]
				}
			]
		},
