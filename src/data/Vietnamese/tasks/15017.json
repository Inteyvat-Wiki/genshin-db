			"dialogs": [
				{
					"id": 150170401,
					"content": "Đúng là có một con Tepetlisaur ở trên đây thật. Nhưng không biết có phải con mà Tlazolli nuôi không nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170402,
						150170403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170402,
					"content": "Xem ra không giống như là gặp nguy hiểm gì cả.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170404
					]
				},
				{
					"id": 150170404,
					"content": "Hmm... Không đúng, chúng ta đến tìm Tlazolli mà, nhưng xung quanh đây cũng không thấy cô ấy đâu.",
					"roleType": "TALK_ROLE_NPC",
