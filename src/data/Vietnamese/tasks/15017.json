			"dialogs": [
				{
					"id": 150170101,
					"content": "Ồ, hai vị tới sớm thật đấy! Xem ra là rất mong chờ món quà đó nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170102,
						150170105
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170102,
					"content": "Chúng tôi muốn thăm Tlazolli và Nechca.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170103
					]
				},
				{
					"id": 150170103,
					"content": "Đúng vậy. Nechca bị bệnh nặng, còn Tlazolli thì mất đi công việc quan trọng nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170104,
					"content": "Tình hình tuy là đã chuyển biến tốt hơn, nhưng cũng không biết họ có thể phấn chấn lên không nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170109,
					"content": "Haha, tôi đã nhờ người đi chào hỏi Tlazolli, có lẽ cô ấy đã chuẩn bị sẵn sàng hết rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170110
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170110,
					"content": "Chúng ta mau xuất phát thôi. Imix, hãy trông coi cửa tiệm cẩn thận nhé, lát nữa sư phụ sẽ về.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170105,
					"content": "Vậy, món quà đó rốt cuộc là gì thế...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170106
					]
				},
				{
					"id": 150170106,
					"content": "Tôi cũng rất tò mò đấy... Nhưng mà, chúng tôi cũng muốn đi thăm Nechca nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170107,
					"content": "Cô bé mắc bệnh nặng như vậy, không biết đã hồi phục thế nào rồi, cả Tlazolli nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170108,
					"content": "Mất đi công việc quan trọng như vậy, cũng không biết cô ấy có thể phấn chấn trở lại không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170109
					],
					"speakerTitle": "Paimon"
				}
			]
		},
