			"dialogs": [
				{
					"id": 150170201,
					"content": "Chính là chỗ này. Ngôi nhà trông khá ấn tượng phải không? Đợi một chút, tôi đi gõ cửa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170202
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170202,
					"content": "Tlazolli, mở cửa đi nào, tôi dẫn hai người đó tới rồi đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170203
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170203,
					"content": "...Tlazolli? Cô có đó không? Mở cửa ra đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170204
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170204,
					"content": "Kỳ lạ, cái cửa này... Hửm, sao lại khóa rồi. Giờ này lẽ ra cô ấy không nên ra ngoài mới phải chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170205
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170205,
					"content": "Nechca, Nechca? Là chị Cheven đây, mau mở cửa ra nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170206,
						150170207
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170206,
					"content": "(Không có phản ứng gì cả...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170210
					]
				},
				{
					"id": 150170210,
					"content": "Lạ thật, tôi đã nói với Tlazolli rồi mà... Chẳng lẽ cô ấy đưa Nechca đi lấy thuốc đột xuất sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170211
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170211,
					"content": "Ơ? Còn bên đây là gì vậy? Trông giống như ổ của Tepetlisaur nhỏ nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170212,
					"content": "Đúng vậy. Tlazolli có một người bạn đồng hành là Tepetlisaur. Tôi nhớ hình như tên là... Iengu gì đó thì phải.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170213
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170213,
					"content": "Trước đây khi cô ấy còn làm công việc rèn đúc thì thường hay nhờ Iengu giúp một số công việc khai thác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170214
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170214,
					"content": "Nhưng từ khi Nechca bị bệnh thì Tlazolli cũng không để Iengu đào cái gì nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170215
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170215,
					"content": "Chờ đã, xung quanh sao lại bừa bộn thế này? Iengu cũng không thấy đâu cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170216
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170216,
					"content": "Ối! Còn có rất nhiều chiếc rương bị vỡ nữa! Không lẽ đã xảy ra chuyện gì rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170217,
						150170218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170217,
					"content": "Đến gần hơn xem nào.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 150170218,
					"content": "Cô ở đây trước nhé, Cheven.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170219
					]
				},
				{
					"id": 150170219,
					"content": "À ừm...! Được rồi, tôi... tôi tìm chỗ nấp ngay đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170220
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170220,
					"content": "Chẳng lẽ miệng của Imix từng được Wayob chúc phúc à? Sao lần nào bảo tôi đừng tới nơi nguy hiểm là tôi sẽ gặp nguy hiểm thật thế...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170207,
					"content": "Có cần phá cửa không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170208
					]
				},
				{
					"id": 150170208,
					"content": "Chẳng lẽ Tlazolli và Nechca đã xảy ra chuyện gì rồi sao? Hay là bệnh tình của Nechca lại... Hic... Tôi không dám nghĩ nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170209,
					"content": "Đừng nghĩ lung tung, hôm qua khi tôi tới thì hai mẹ con họ vẫn rất ổn. Nechca còn ngủ rất ngon trong phòng mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170210
					],
					"speakerTitle": "Cheven"
				}
			]
		},
