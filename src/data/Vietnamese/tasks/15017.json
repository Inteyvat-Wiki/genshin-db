				},
				{
					"id": 150170405,
					"content": "#Này... {NICKNAME}! Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170406
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170406,
					"content": "Cheven đang hét gì thế nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170407,
					"content": "Bên cạnh còn có thêm một người nữa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170408
					]
				},
				{
					"id": 150170408,
					"content": "Mau xuống đi... Tlazolli ở đây này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170409
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170409,
					"content": "Hả? Chúng ta vừa lên đây là Tlazolli đã trở về rồi sao? Chuyện này là thế nào nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170410,
						150170411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170410,
					"content": "Cứ đi xuống trước đã.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170413
					]
				},
				{
					"id": 150170413,
					"content": "Sao con Tepetlisaur này lại qua đây nhỉ? Này, đừng có đột nhiên lao tới thế chứ, sẽ đâm vào chúng tôi đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170414,
					"content": "Cùng với Tepetlisaur xuống dưới chân núi...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150170415
					]
				},
				{
					"id": 150170415,
					"content": "Iengu, lại đây nào... Sao lại nghịch ngợm nữa rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170416
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170416,
					"content": "Rawr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170417
					],
					"speakerTitle": "Iengu"
				},
				{
					"id": 150170417,
					"content": "Ngoan nào, đói rồi hả? Xin lỗi nhé... Một lát nữa ta sẽ làm món ngon cho ngươi ăn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170418
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170418,
					"content": "Cứ đi chơi trước đi, lát nữa ta sẽ tìm ngươi sau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170419
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170419,
					"content": "Grào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170420
					],
					"speakerTitle": "Iengu"
				},
				{
					"id": 150170420,
					"content": "Xin lỗi. Tôi vốn đang đợi hai vị ở nhà, nhưng không ngờ là Nechca lại lẻn ra ngoài một mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170421
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170421,
					"content": "Khi tìm thấy Nechca thì con bé nói là muốn làm quà cho khách, nên đi hái một ít hoa đẹp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170422
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170422,
					"content": "Con bé vừa đi vừa hái, cuối cùng lại bị lạc đường... Phù, may mà tôi tìm thấy kịp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170423
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170423,
					"content": "Sức khỏe của Nechca không có vấn đề gì chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170424
					]
				},
				{
					"id": 150170424,
					"content": "Chúng tôi nghe Cheven nói là bệnh tình của cô bé vừa mới có chuyển biến tốt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170425
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170425,
					"content": "Cơ thể con bé vẫn quá yếu. Con bé bị cảm rồi lại trúng gió lạnh, bây giờ hơi sốt. Nó vừa uống thuốc xong là về ngủ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170426
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170426,
					"content": "Không nghiêm trọng lắm, nghỉ ngơi một đêm là ổn thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170427
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170427,
					"content": "Nhưng mà... Hôm nay chắc con bé không thể gặp khách được rồi. Thật xin lỗi, uổng công hai vị tới đây rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170428
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170428,
					"content": "Không cần xin lỗi đâu. Lúc trước chúng tôi nghe Cheven nói rồi, cô bé bị bệnh rất nặng, khó khăn lắm mới hồi phục được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170429
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170429,
					"content": "Cho nên hôm nay chúng tôi muốn đến thăm Nechca... Dù sao thì giữ gìn sức khỏe vẫn là việc quan trọng nhất mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170430,
						150170433
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170430,
					"content": "Căn bệnh trước đó của cô bé đã khỏi chưa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170431
					]
				},
				{
					"id": 150170431,
					"content": "...Ít nhất thì bây giờ con bé có thể nói chuyện với tôi, cũng có thể sống bình thường được rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170432
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170432,
					"content": "Thế là tôi đã mãn nguyện lắm rồi, không còn mong ước gì hơn nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170437
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170437,
					"content": "Được rồi, sao mọi người lại làm bầu không khí trở nên ảm đạm thế này chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170438
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170438,
					"content": "Chúng tôi đã cảm nhận được tấm lòng của Nechca rồi. Nhưng mà Tlazolli này, lúc trước tôi đã nói với cô...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170439,
						150170440
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170439,
					"content": "À, là món quà!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170441
					]
				},
				{
					"id": 150170441,
					"content": "À! Rốt cuộc đó là món quà gì vậy? Bây giờ có thể nói cho chúng tôi biết rồi chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170442
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170442,
					"content": "Món quà này chính là \"Chữ Khắc Đá Lửa\" do tôi làm đấy. Nó được làm từ khoáng thạch tinh khiết nhất, gần như là sẽ không bị ăn mòn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170443
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170443,
					"content": "Kỹ thuật làm ra nó cũng đều bắt nguồn từ kỹ thuật đúc Tên Cổ cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170444
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170444,
					"content": "Vậy, vậy thì đó chẳng phải là một phiên bản đơn giản hơn của Tên Cổ sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170445
					]
				},
				{
					"id": 150170445,
					"content": "Ấy... Đừng nói thế, Wayob sẽ trách tội tôi mất. Tôi chỉ sử dụng kỹ thuật đúc Tên Cổ, rồi lấy khoáng thạch làm nguyên liệu để tạo ra thể kết tinh như vậy thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170446
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170446,
					"content": "Khi mới làm ra, tôi cảm thấy nó ngoài đẹp và không bao giờ bị ăn mòn ra thì chẳng có tác dụng thực tế gì hết...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170447
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170447,
					"content": "Nhưng Cheven đã cho tôi ý tưởng. Cô ấy đã đề nghị tôi biến thể kết tinh này thành một loại \"trang sức\" đặc biệt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170448
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170448,
					"content": "\"Chữ Khắc Đá Lửa do thợ thủ công Tên Cổ làm ra, trên đó có khắc những dòng chữ không bao giờ bị ăn mòn.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170449
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170449,
					"content": "Thế nào, nghe là thấy rất đáng mua rồi phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170450
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170450,
					"content": "Sau khi thêm nhiều mô tả như vậy, tôi bỗng nhiên cảm thấy thứ này rất lợi hại rồi đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170451,
						150170452
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170451,
					"content": "Cô giỏi kinh doanh đó...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170453
					]
				},
				{
					"id": 150170453,
					"content": "Haha, nhưng mà Chữ Khắc Đá Lửa mà Tlazolli chế tạo ra quả thực rất có ý nghĩa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170454
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170454,
					"content": "Lời truyền miệng luôn không đáng tin. Trong quá trình kể lại, nó sẽ trở nên không đầy đủ và dần bị lãng quên, thậm chí còn bị xuyên tạc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170455
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170455,
					"content": "Nhưng nếu được khắc trên Chữ Khắc Đá Lửa này thì nó sẽ tồn tại mãi mãi. Hơn nữa, ý nghĩa lại rất rõ ràng, không thể bị bóp méo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170456
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170456,
					"content": "Cho dù là tặng cho bạn bè, người thân hay hậu bối trong gia đình thì nó cũng đều rất thích hợp!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170457,
						150170460
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170457,
					"content": "Cô bắt đầu quảng cáo rồi đấy à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170458
					]
				},
				{
					"id": 150170458,
					"content": "#Nói mà làm tôi xiêu lòng luôn đó. À, {NICKNAME}, hay là chúng ta cũng mua một cái đi, khắc tên chúng ta lên đó cũng được nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170459
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170459,
					"content": "#Đợi {NICKNAME} tìm được {M#em gái}{F#anh trai} rồi thì sẽ để {M#cô ấy}{F#cậu ấy} tự tay khắc tên lên đó nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170462
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170462,
					"content": "Như vậy thì tên của chúng ta sẽ mãi mãi gắn liền với nhau rồi, hihi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170463,
						150170495
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170463,
					"content": "Paimon đã bị thu hút rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170464
					]
				},
				{
					"id": 150170464,
					"content": "Hai vị đừng từ chối nữa. Hai vị đã cứu tôi, cũng đã cứu món quà sinh nhật của Nechca. Số tiền này tôi sẵn sàng trả mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170465
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170465,
					"content": "Cheven, lúc trước tôi có nói với cô là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170466
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170466,
					"content": "Cô cũng không được từ chối đấy, Tlazolli. Tôi biết việc làm ra một Chữ Khắc Đá Lửa cần tốn bao nhiêu công sức mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170467
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170467,
					"content": "#Cảm ơn Cheven, còn có cả {NICKNAME} nữa. Tôi sẽ nhanh chóng làm xong, đến lúc đó sẽ để hai vị tự tay khắc nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170468
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170468,
					"content": "Đến lúc đó thì Nechca chắc cũng đã hồi phục rồi. Có mọi người đến thăm, con bé nhất định sẽ rất vui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170469,
						150170496
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170469,
					"content": "Có nên mua món này cho bạn bè luôn không nhỉ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170470
					]
				},
				{
					"id": 150170470,
					"content": "Này! Nghĩ xa quá rồi đó. Nói không chừng món này sẽ rất đắt đấy, như vậy thì chúng ta liệu có còn đủ tiền đi lại không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170471
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170471,
					"content": "Chờ đã... Chẳng lẽ món quà này là kế hoạch của Cheven, muốn dụ chúng ta vào cái bẫy để tiêu tiền sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170472
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170472,
					"content": "Cũng không biết chừng đấy. Dù sao thì... trông hai vị có vẻ như cũng có không ít của để dành mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170473
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170473,
					"content": "#Úi! Không được, {NICKNAME}, không được tiêu tiền bừa bãi đâu nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170474
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170474,
					"content": "Haha, vậy hai vị tự thương lượng đi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170475
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170475,
					"content": "Grào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170476
					],
					"speakerTitle": "Iengu"
				},
				{
					"id": 150170476,
					"content": "#Hửm?! Sao nó lại xuất hiện rồi, {NICKNAME} mau ngăn nó lại đi! Tôi không muốn bị đâm trúng nữa đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170477
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170477,
					"content": "Ngoan nào!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170478
					]
				},
				{
					"id": 150170478,
					"content": "Rawr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170479
					],
					"speakerTitle": "Iengu"
				},
				{
					"id": 150170479,
					"content": "Tlazolli, tôi còn phải nhờ cô một việc, sửa giúp tôi Chữ Khắc Đá Lửa này nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170480
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170480,
					"content": "Lần trước bị tấn công, tôi đã làm rơi nó xuống đất, dây và móc cài đều bị hỏng cả rồi, không thể đeo được nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170481
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170481,
					"content": "Tôi cũng từng thử tự sửa rồi, nhưng sửa thế nào cũng không chắc chắn được, chỉ đành nhờ cô thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170482
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170482,
					"content": "Không thành vấn đề. Cứ giao cho tôi! Đảm bảo sẽ sửa giống hệt như trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170483
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170483,
					"content": "Cảm ơn Cheven. Cảm ơn cô đã sẵn lòng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170484
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170484,
					"content": "Không sao đâu, Tlazolli. Chỉ cần Nechca khỏe mạnh là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170485
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170485,
					"content": "...Ừm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170486
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170486,
					"content": "Iengu! Ngoan nào, lát nữa ta sẽ cho ngươi ăn nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170487
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170487,
					"content": "#{NICKNAME}, chờ Chữ Khắc Đá Lửa làm xong rồi thì tôi sẽ nhờ Cheven báo cho {F#cô}{M#cậu} nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170488
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170488,
					"content": "Nói không chừng còn kịp ngày sinh nhật của Nechca đó. Đến lúc đó chúng ta cùng tổ chức một bữa tiệc nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170489
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170489,
					"content": "Hihi, chắc là sẽ có nhiều đồ ăn ngon lắm đây. Đến lúc đó phải ăn no nê mới được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170490
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170490,
					"content": "Vậy thì gặp lại sau nhé, Tlazolli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170491,
						150170492
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170491,
					"content": "Gặp lại sau nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170493
					]
				},
				{
					"id": 150170493,
					"content": "Tạm biệt, chúc hai vị luôn khỏe mạnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170494
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170494,
					"content": "...Nechca, chắc sẽ vui lắm đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170492,
					"content": "Chúc Nechca sớm khỏe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170493
					]
				},
				{
					"id": 150170496,
					"content": "Hay là mua thêm vài cái tặng người khác vậy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170470
					]
				},
				{
					"id": 150170495,
					"content": "Nghe có vẻ quý giá quá...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170464
					]
				},
				{
					"id": 150170460,
					"content": "Tôi sắp bị thuyết phục rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170461
					]
				},
				{
					"id": 150170461,
					"content": "#Mua một cái cũng được đấy. Khắc tên của chúng ta lên đó. Đợi {NICKNAME} tìm được {M#em gái}{F#anh trai} rồi thì sẽ để {M#cô ấy}{F#cậu ấy} tự tay khắc tên lên đó nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170462
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170452,
					"content": "Không hổ danh là chủ tiệm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170453
					]
				},
				{
					"id": 150170440,
					"content": "Sắp đến giờ nhận quà rồi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170441
					]
				},
				{
					"id": 150170433,
					"content": "Cô bé đã có thể chạy nhảy thì chắc sức khỏe cũng ổn rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170434
					]
				},
				{
					"id": 150170434,
					"content": "Đúng vậy. Nhất là khi tôi bảo con bé ăn rau thì con bé chạy nhanh lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170435
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170435,
					"content": "Nhảy qua ghế, trốn dưới gầm bàn... Chạy quanh phòng, tôi còn không đuổi kịp nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170436
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170436,
					"content": "Nhìn dáng vẻ của Nechca bây giờ là tôi đã mãn nguyện rồi, không còn đòi hỏi gì khác nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170437
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170411,
					"content": "Mọi chuyện thật trùng hợp...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170412
					]
				},
				{
					"id": 150170412,
					"content": "Tóm lại, chúng ta cứ đi xuống trước đi vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170403,
					"content": "Hình như là nó tự trèo lên nhỉ...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170404
					]
				}
			]
		},
