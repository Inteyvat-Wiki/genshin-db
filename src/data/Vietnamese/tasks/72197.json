					"nextDialogs": [
						721402304
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721402304,
					"content": "Í? Tại sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721402305,
					"content": "Người dân nơi đây thiếu chút gì đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402306
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721402306,
					"content": "Trước kia khi em sống trên đảo Yashiori, Ogosho đại nhân đối với em mà nói khá xa cách điềm tĩnh...Em sẽ không để ý cô ấy ở đâu, nhưng em tin rằng cô ấy ở ngay đây, quan sát và bảo vệ em, quy định xem em nên sống như thế nào, trở thành người ra sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402307
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721402307,
					"content": "Nhưng ở đây, Ogosho đại nhân một tay che trời, chèn ép đủ đường...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402308
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721402308,
					"content": "Haiz, em cũng khó có thể nói rõ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402309
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721402310,
					"content": "#{F#Chị}{M#Anh} vẫn đang cố gắng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721402311
					]
				},
				{
					"id": 721402309,
					"content": "#Phải rồi, về mẹ của em...{F#chị}{M#anh} có phát hiện gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402310
					],
					"speakerTitle": "Chouji"
				},
				{
