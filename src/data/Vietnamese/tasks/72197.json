					"id": 721402301,
					"content": "#{NICKNAME}, không ngờ lại có thể gặp {F#chị}{M#anh} ở đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402302
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721402302,
					"content": "Lâu rồi không gặp! Đảo Yashiori như thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721402303,
					"content": "Nơi này giàu có hơn quê hương của em rất nhiều, cũng có nhiều món ăn ngon và thứ để chơi hơn. Nhưng...em không thích lắm.",
