				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chouji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721401901,
					"content": "Số Tủy Pha Lê này chắc là đủ rồi. Tiếp theo em phải bắt đầu hành trình mạo hiểm rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401902
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401903,
					"content": "Chăm sóc tốt cho bản thân nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401905
					]
				},
				{
					"id": 721401904,
					"content": "Nhất định phải giữ liên lạc.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401905
					]
				},
				{
					"id": 721401902,
					"content": "Lo cho đứa bé này quá đi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401903,
						721401904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401905,
					"content": "Ừm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401906
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401906,
					"content": "Này, Chouji không còn ăn nói lươn lẹo nữa rồi! May là gặp được tụi này đấy...nếu không sẽ bị đánh đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401907,
					"content": "Còn nữa còn nữa, gặp kẻ xấu muốn thăm dò, cũng đừng nói thật với bọn chúng! Nhất định phải bịa đặt nhảm nhí vào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401908
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401909,
					"content": "Paimon biến thành bà lão rồi cơ đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401910
					]
				},
				{
					"id": 721401908,
					"content": "Còn nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401909
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401911,
					"content": "Tôi tin em ấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401912
					]
				},
				{
					"id": 721401910,
					"content": "Đứa bé còn nhỏ như vậy tự mình ra ngoài mạo hiểm, ai yên tâm nổi chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401911
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401912,
					"content": "...Đúng thật là.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401913,
					"content": "#Hahahaha! Cảm ơn {F#chị}{M#anh}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401914
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401914,
					"content": "Hy vọng sau này chúng ta sẽ còn gặp lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401915
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401915,
					"content": "Nhất định phải chú ý an toàn đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401916
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401916,
					"content": "Em không sao đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401917
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401917,
					"content": "Tiếp theo em sẽ đi Tatarasuna, mẹ từng làm việc ở đó. Chắc sẽ có ai đó nói cho em biết mẹ từng đi qua đó hay chưa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401918
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401918,
					"content": "Sau đó...em sẽ nghĩ cách đến đảo Narukami. Rồi bắt tàu buôn của Snezhnaya...còn sau đó nữa, tuỳ cơ ứng biến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401919
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401920,
					"content": "Em có biết mình đang nói gì không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401922
					]
				},
				{
					"id": 721401921,
					"content": "Em hiểu rủi ro mình sắp phải đối mặt chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401922
					]
				},
				{
					"id": 721401919,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401920,
						721401921
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401922,
					"content": "Nếu không làm điều gì đó chỉ vì không biết sẽ đối mặt với rủi ro ra sao...thì trên thế giới này sẽ không có nghề nghiệp như Nhà Mạo Hiểm rồi nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401923
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401924,
					"content": "Được rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401926
					]
				},
				{
					"id": 721401925,
					"content": "Nhất định phải cẩn thận.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401926
					]
				},
				{
					"id": 721401923,
					"content": "Wa...Đứa trẻ này đúng là khó chịu thật đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401924,
						721401925
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401926,
					"content": "Ha ha ha, yên tâm đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401927
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401927,
					"content": "#{F#Chị}{M#Anh} cũng thượng lộ bình an! Nhân tiện, {NICKNAME}, hy vọng {F#chị}{M#anh} sẽ sớm tìm thấy người thân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401928
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401928,
					"content": "Ừ! Mong sẽ như lời em nói!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
