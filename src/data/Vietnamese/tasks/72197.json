					"nextDialogs": [
						721402005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721402007,
					"content": "Hành trình của em thế nào?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721402008
					]
				},
				{
					"id": 721402006,
					"content": "Ha ha ha ha, đương nhiên không phải rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402007
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721402008,
					"content": "Vẫn ổn, chỉ là vẫn chưa tìm thấy tung tích của mẹ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402009
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721402010,
					"content": "#{F#Chị}{M#Anh} sẽ cố hết sức.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721402011
					]
				},
				{
					"id": 721402009,
					"content": "#Không sao, tụi này cũng sẽ giúp đỡ, phải không? {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402010
