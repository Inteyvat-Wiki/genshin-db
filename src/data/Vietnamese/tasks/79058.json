			"dialogs": [
				{
					"id": 790580101,
					"content": "Đây là cảnh quay bị bỏ đi trong vở \"Thoát Khỏi Tuyệt Vọng\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790580102
					],
					"speakerTitle": "Ghi Chú Phim Trường"
				},
				{
					"id": 790580102,
					"content": "Câu chuyện kể về Eidolon Thủy bị mắc kẹt trong hang động bí ẩn, chỉ có thể dùng đạo cụ ẩn trong cuốn sách để trốn thoát...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790580103
					],
					"speakerTitle": "Ghi Chú Phim Trường"
				},
				{
					"id": 790580103,
					"content": "Nhưng nó đã bị Idyia từ chối.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790580104
					],
					"speakerTitle": "Ghi Chú Phim Trường"
				},
				{
					"id": 790580104,
					"content": "Đúng vậy, Eidolon Thủy không cần dùng đạo cụ cũng có thể thoát khỏi hang, với tình tiết giấu dụng cụ đào bới trong sách cũng hơi khó hiểu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790580105
					],
					"speakerTitle": "Ghi Chú Phim Trường"
				},
				{
					"id": 790580105,
					"content": "Nhưng đây chắc chắn là một ý tưởng hay. Nếu có thể thực hiện được ý tưởng này cho Idyia xem thì tốt quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790580106
					],
					"speakerTitle": "Ghi Chú Phim Trường"
				},
				{
					"id": 790580106,
					"content": "Nhưng mà, phải lấy <color=#00E1FFFF>sách đạo cụ bị Hilichurl lấy trộm</color> về đây trước đã...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790580107
					],
					"speakerTitle": "Ghi Chú Phim Trường"
				},
				{
					"id": 790580107,
