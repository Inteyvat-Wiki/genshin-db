			"dialogs": [
				{
					"id": 736810101,
					"content": "Nhà Lữ Hành, Paimon, các bạn tới rồi. Tôi nghe nói các bạn đã tham gia hoạt động tìm kiếm \"Rương Bội Thu\". Thế nào, có vui không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736810102
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 736810102,
					"content": "Cũng khá có ý nghĩa đấy! Còn nữa, không biết có phải do đã mở Hội Chợ Rượu trong Lễ Hội Rượu không mà chúng tôi lấy được rất nhiều đồ trang trí này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736810103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736810103,
					"content": "Haha, đúng là có người đã chuẩn bị những thứ đó để làm quà tặng. À đúng rồi, nếu các bạn đang kinh doanh quầy ăn vặt thì hay là bày những món đồ trang trí kia ở đây luôn nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736810104
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 736810104,
					"content": "Trang trí gian hàng cho đẹp một chút, có khi sẽ thu hút được nhiều vị khách ghé thăm hơn đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736810105
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 736810105,
					"content": "Vả lại, nếu người tặng quà nhìn thấy tâm ý của mình xuất hiện trong gian hàng của Nhà Lữ Hành thì nhất định sẽ rất vui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736810106
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 736810106,
					"content": "#Anh nói cũng có lý! {NICKNAME}, chúng ta trang trí một chút gian hàng của mình đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
