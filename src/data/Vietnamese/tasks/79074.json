			},
			"dialogs": [
				{
					"id": 790740101,
					"content": "Nhìn kìa, lại có hai chiến binh nữa xuất hiện rồi! Hai vị muốn đến thách đấu \"Cơn Lốc Phương Bắc\" sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740102
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740102,
					"content": "Nào, hãy đi theo lối này! Tôi hy vọng hai vị sẽ bay giỏi hơn bất kỳ ai khác!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740103,
						790740104
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740103,
					"content": "Bình tĩnh lại nào!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790740105
					]
				},
				{
					"id": 790740105,
					"content": "Bay thì không cần phải bình tĩnh, thưa quý khách. Chắc chắn không cần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740106
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740106,
					"content": "Bình tĩnh sẽ chỉ làm chậm đi cảm giác của hai vị về gió thôi. Chỉ khi đối mặt với cuồng phong thì mới phát hiện ra tiềm năng của chính mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740107
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740107,
					"content": "Sóc bay ngày nay đã quá nhút nhát! Họ đã quên mất lời dạy trong bài \"Gió Bắc Dũng Cảm\" đó rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740108
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740108,
					"content": "Chỉ đứng ở nơi an toàn, ngưỡng mộ sự dũng cảm của những chiếc lá bay theo gió, còn bản thân thì lại sợ sệt đủ điều, không dám tự mình bước vào bên trong cơn gió.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740109
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740109,
					"content": "Nếu cứ tiếp tục như thế này thì làm sao chúng ta có thể cùng công chúa bảo vệ được vương quốc chứ! Đúng là vô lý, vô lý hết sức!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740110
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740110,
					"content": "Đúng là một chú sóc bay năng động...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790740111,
					"content": "Có vẻ như cậu bạn này thực sự rất thích bay.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790740112
					]
				},
				{
					"id": 790740112,
					"content": "Thế là tôi đã tìm thấy một số đường gió có sức thổi đặc biệt mạnh mẽ, và thiết lập đủ loại cơ quan bên trong nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740113
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740113,
					"content": "Chỉ những chiến binh dũng cảm nhất và giỏi bay nhất mới có thể đi qua đường gió này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740114
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740114,
					"content": "Vậy thưa quý khách, hai vị có can đảm không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740115,
						790740117
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740115,
					"content": "Để thử sức xem sao!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790740116
					]
				},
				{
					"id": 790740116,
					"content": "Tốt lắm! Vui lòng đi theo tôi, đường gió sẽ không xa đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740117,
					"content": "À... Tôi đang còn chuyện khác...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790740118
					]
				},
				{
					"id": 790740118,
					"content": "Thế nào? Vẫn muốn chuẩn bị hả? Được rồi, tôi sẽ đợi ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740119
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740119,
					"content": "Nếu hai vị muốn thử thì cứ tới đây tìm tôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740104,
					"content": "Tôi còn chưa nói gì mà!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790740105
					]
				}
			]
		}
	]
}