				"points": []
			},
			"dialogs": [
				{
					"id": 3572301,
					"content": "Phong Ma Long... Không ngờ tấn công thẳng vào trong thành rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572302
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3572302,
					"content": "#Kaeya, {NICKNAME}, mọi người đến thật đúng lúc, chúng ta mau chóng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572303
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3572303,
					"content": "Đợi chút, Amber. Ở đây còn có người chưa kịp làm quen này?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572304
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3572304,
					"content": "A...Được rồi. Đây là Kaeya, là Đội Trưởng Kỵ Binh của chúng tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572305
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3572305,
					"content": "#Hai vị này là lữ khách đến từ nơi xa, {NICKNAME} và Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572306
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3572306,
					"content": "(Chỉ biết là \"nơi xa\" thôi sao...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572307
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3572307,
					"content": "Sự tình là như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572308
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3572308,
					"content": "Hóa ra là vậy, chào mừng đến với Mondstadt. Thật đáng tiếc, gặp ngay lúc tồi tệ này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572309
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3572309,
					"content": "Tôi rất hiểu tâm trạng đau khổ khi cốt nhục phân ly, Nhà Lữ Hành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572310
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3572310,
					"content": "#Ngoài ra, mặc dù không biết {F#cô}{M#cậu} tìm Phong Thần làm gì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572311
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3572311,
					"content": "Nhưng mỗi người đều có bí mật của mình, phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572312
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3572312,
					"content": "Ha ha, tôi sẽ không gặng hỏi đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572313
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3572313,
					"content": "#Nhìn chung, trước tiên tôi cần thay mặt Đội Kỵ Sĩ cảm ơn {F#cô}{M#cậu}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572314,
						3572315
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3572314,
					"content": "À, chúng tôi không thể khoanh tay đứng nhìn tình hình trở nên tồi tệ hơn được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3572318
					]
				},
				{
					"id": 3572318,
					"content": "#Cuộc chiến trên không lúc nãy của {F#cô}{M#cậu} với Ma Long đều đã được người dân chứng kiến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572319
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3572319,
					"content": "Đội Trưởng Đại Diện cũng rất có hứng thú với hai vị, hy vọng hai vị có thể đến <color=#00E1FFFF>tổng bộ Đội Kỵ Sĩ</color> nói chuyện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3572315,
					"content": "Đừng khách sáo, vậy quà cảm ơn đâu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3572316
					]
				},
				{
					"id": 3572316,
					"content": "Ừm... Đặc sản Thịt Nướng Mật Ong của Mondstadt được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572317
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3572317,
					"content": "Câu này lúc nãy tôi đã nghe rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3572318
					]
				}
			]
		}
	]
}