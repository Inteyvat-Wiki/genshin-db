				"points": []
			},
			"dialogs": [
				{
					"id": 715220101,
					"content": "Trò chơi này truyền cảm hứng thật đấy, haha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220102
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220102,
					"content": "Có trò chơi mới gì sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715220103
					]
				},
				{
					"id": 715220103,
					"content": "Nhà Lữ Hành! Đến đúng lúc lắm, vừa hay tôi đang tìm người chơi thử trò chơi tôi vừa chế tác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220104
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220104,
					"content": "Nhìn bên này, tôi đặt tên cho trò chơi này là \"Cảm Hứng Tuôn Trào\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220105
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220105,
					"content": "Nó đã khôi phục hoàn hảo toàn bộ quá trình sáng tác thơ ca của nhà thơ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220106,
						715220110
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220106,
					"content": "Ý anh là uống rượu, uống rượu và uống rượu sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715220107
					]
				},
				{
					"id": 715220109,
					"content": "Anh nói rõ thêm nào.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715220110
					]
				},
				{
					"id": 715220107,
					"content": "#Haha, {F#cô}{M#cậu} thật hài hước. Lấy cảm hứng từ việc uống rượu quả là một ý hay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220108
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220108,
					"content": "Nhưng để sáng tác một bài thơ thật sự xuất sắc thì uống rượu thôi vẫn chưa đủ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220110
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220110,
					"content": "Trong lần sáng tác thơ ca, đầu tiên chúng ta cần tìm cảm hứng ở khắp nơi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220111
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220111,
					"content": "Có người thích chu du khắp nơi, có người thích một mình trầm tư, còn một số người thì... đặc biệt thích uống rượu để kích thích lối tư duy của bản thân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220112
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220112,
					"content": "Đây là giai đoạn khó khăn nhất, bởi vì trong quá trình tìm cảm hứng, hầu như chúng ta đều không biết nguồn cảm hứng rốt cuộc đang ở đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220113
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220113,
					"content": "Hầu hết thời gian chúng ta đều cảm thấy không có thu hoạch, rồi trở nên cáu kỉnh và phiền muộn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220114
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220114,
					"content": "Nhưng thực tế thì, nguồn cảm hứng đã âm thầm tích tụ trong tâm trí của chúng ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220115
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220115,
					"content": "Đợi đến thời điểm thích hợp, sẽ bùng nổ rồi tuôn trào, tạo thành một bài thơ tuyệt vời... hay một bức tranh xuất sắc, hoặc bất cứ thứ gì khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220116
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220116,
					"content": "Điều này cũng có thể làm thành một trò chơi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715220117
					]
				},
				{
					"id": 715220117,
					"content": "Haha, đương nhiên rồi! Quá trình sáng tác thơ ca này rõ ràng rành mạch, rất dễ hiểu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220118
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220118,
					"content": "Vừa hay trong Thành Mondstadt có vài người rất giỏi chế tạo trò chơi, họ đều có hứng thú với ý tưởng của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220119
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220119,
					"content": "Chúng tôi đã tiến hành rất nhiều cuộc thảo luận, sau cùng trò chơi mang tên \"Cảm Hứng Tuôn Trào\" này đã được ra mắt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220120
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220120,
					"content": "#Nếu {F#cô}{M#cậu} có hứng thú thì bây giờ có thể thử chơi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220121
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220121,
					"content": "#Chơi thêm vài ván, không biết chừng {F#cô}{M#cậu} còn học được cách sáng tác thơ ca đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Buies"
				}
			]
		}
	]
}