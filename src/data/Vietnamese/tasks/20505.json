				"points": []
			},
			"dialogs": [
				{
					"id": 205050201,
					"content": "Bạn sẽ tiếp nhận Phái Đi Thám Hiểm bất cứ lúc nào, những người bạn trong thời gian tiến hành uỷ thác vẫn có thể cùng bạn tham gia mạo hiểm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050202
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050202,
					"content": "Tìm kiếm ở mức độ khác nhau sẽ tốn thời gian khác nhau, sau khi tìm kiếm xong, chỉ cần đến chỗ tôi xác nhận kết quả là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050203
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050203,
					"content": "Khi hạng mạo hiểm tăng, còn có thể đến những chỗ nguy hiểm hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050204
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050204,
					"content": "Đây chính là nói năng lực càng cao, trách nhiệm càng nặng nề!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 205050205,
					"content": "Đúng vậy, đương nhiên đây cũng là suy nghĩ cho sự an toàn của các bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050206
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050206,
					"content": "Cám ơn sự giúp đỡ của bạn lần nữa, hy vọng bạn và các bạn của bạn có thể nhận nhiều Phái Đi Thám Hiểm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				}
			]
		}
	]
