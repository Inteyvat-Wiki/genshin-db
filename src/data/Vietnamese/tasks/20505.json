				"objectNames": [
					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205050101,
					"content": "Thật ngại quá, lại gọi bạn đến đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050102,
						205050104
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050102,
					"content": "Không sao, bình thường cũng nhận được nhiều sự chiếu cố.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050103
					]
				},
				{
					"id": 205050103,
					"content": "Bạn nói vậy thật tốt quá rồi, vậy tôi sẽ nói ngắn gọn thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050106
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050106,
					"content": "Rất cảm ơn bạn đã giúp hoàn thành ủy thác của hiệp hội, đánh giá của Hiệp Hội Nhà Mạo Hiểm cũng sẽ càng ngày càng tốt hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050107
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050107,
					"content": "Nhưng cũng vì vậy, người ủy thác hiệp hội cũng càng lúc càng nhiều, hiện nay các Nhà Mạo Hiểm làm không kịp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050108
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050108,
					"content": "Muốn chúng tôi đi làm người tuyên truyền sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 205050109,
					"content": "A, không phải, bạn có lòng tôi rất cảm ơn. Tôi cũng mong có thêm nhiều người mới gia nhập hiệp hội...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050110
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050110,
					"content": "Nhưng bây giờ đi tìm người mới, thì như nước xa không cứu được lửa gần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050111
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050111,
					"content": "Tôi muốn hỏi chút, không biết bạn của bạn có thời gian để giúp không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050112,
						205050114
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050112,
					"content": "Cần phải thương lượng với họ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050113
					]
				},
				{
					"id": 205050113,
					"content": "Thật tốt quá, cảm ơn bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050117
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050117,
					"content": "Tóm lại tôi cần giải thích trước, hiện nay việc khá gấp là <color=#00E1FFFF>Phái Đi Thám Hiểm</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050118
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050118,
					"content": "Phái Đi Thám Hiểm?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050119
					]
				},
				{
					"id": 205050119,
					"content": "Chúng tôi luôn quan sát xung quanh thành phố và khu vực bên ngoài, ví dụ như những nguy cơ tiềm ẩn, hoặc di tích dưới lòng đất có gì bất thường không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050120
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050120,
					"content": "Vì không phải đến từ ủy thác của người khác, nên không có hạn chế thời gian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050121
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050121,
					"content": "Nhưng nếu do bận rộn mà cứ để đó, thì hiểm họa có thể biến thành tai họa lớn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050122
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050122,
					"content": "Nghe có vẻ rất quan trọng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050123,
						205050125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 205050123,
					"content": "Chỗ bạn bè chắc có thể thông cảm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050124
					]
				},
				{
					"id": 205050124,
					"content": "Chỉ cần họ chịu giúp, những thủ tục còn lại cứ giao cho tôi là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050127
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050127,
					"content": "Chuyện không thể chậm trễ, để tôi giới thiệu cho bạn Phái Đi Thám Hiểm hiện tại gồm những loại nào nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050128
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050128,
					"content": "Xác nhận Phái Đi Thám Hiểm",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 205050125,
					"content": "Thù lao thì sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050126
					]
				},
				{
					"id": 205050126,
					"content": "Yên tâm, thu hoạch khi thám hiểm hiệp hội sẽ không lấy, toàn bộ đều thuộc về bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050127
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050114,
					"content": "Hóa ra muốn khuyên bạn tôi gia nhập hiệp hội?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050115
					]
				},
				{
					"id": 205050115,
					"content": "Không phải, bạn hiểu lầm rồi. Tôi biết bạn của bạn có rất nhiều thân phận, muốn họ gia nhập hết thì không thực tế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050116
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050116,
					"content": "Đây là một yêu cầu có chút quá đáng của hiệp hội.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050117
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050104,
					"content": "Lại có thù lao rồi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050105
					]
				},
				{
					"id": 205050105,
					"content": "Haha... quả thực là vậy, xem ra bạn rất có hứng thú.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050106
					],
					"speakerTitle": "Katheryne"
				}
			]
		},
		{
			"id": 2050502,
			"completionStepIds": [
				2050502
