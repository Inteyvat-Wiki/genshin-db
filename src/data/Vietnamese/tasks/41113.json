				},
				{
					"id": 411131003,
					"content": "Đến giờ đã có bệnh nhân nào tỉnh lại chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131004
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411131004,
					"content": "Ôi, tôi cũng không rõ nữa... bạn có thể trực tiếp đến xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
