				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411130701,
					"content": "Mona, chúng tôi hỏi thăm được rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411130702,
					"content": "Ngọn núi tuyết cao chót vót, chắc là những chồi non mọc trong bóng tối.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130703
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411130703,
					"content": "Núi tuyết? Chính là cái này hả?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130704
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130704,
					"content": "Tất cả mọi người đều mơ thấy cùng một núi tuyết.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411130705
					]
				},
				{
					"id": 411130705,
					"content": "Núi tuyết cao tận mây xanh, nhiệt độ cực thấp, những người trong giấc mơ cứ muốn leo lên đỉnh núi một cách mất kiểm soát.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411130706,
					"content": "Leo lên đỉnh núi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130707
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130707,
					"content": "Ai lại muốn leo lên đỉnh núi? Mà khao khát ấy lại còn ảnh hưởng đến người khác như vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130708
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130708,
					"content": "Trên núi tuyết có chôn vùi những người bị bức hại đến chết không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130709
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411130709,
					"content": "Hoặc là... Một kẻ khiêu chiến đầy khát vọng với núi tuyết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130710
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411130710,
					"content": "Tôi nhẩm quẻ lại lần nữa xem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130711
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130711,
					"content": "Có rồi! Tôi loáng thoáng nhìn thấy được chút manh mối. Tên hắn là... <color=#00E1FFFF>Leonard</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130712
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130712,
					"content": "Hả?! Nhanh vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411130713,
					"content": "Đã nói với cô rồi, tôi là thiên tài mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130714
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130714,
					"content": "Leonard... Chưa từng nghe qua cái tên này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4111308,
			"completionStepIds": [
				4111308
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
