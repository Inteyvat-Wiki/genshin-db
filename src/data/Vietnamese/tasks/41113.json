			},
			"dialogs": [
				{
					"id": 411131401,
					"content": "Xin chào, cho hỏi ở đây đã có bệnh nhân nào tỉnh lại chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131402,
					"content": "Thật trùng hợp, <color=#00E1FFFF>Gao Lão Lục</color> vừa mới tỉnh lại!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131403
					],
					"speakerTitle": "Anh Huang"
				},
				{
					"id": 411131403,
					"content": "Chúng ta qua xem anh ấy đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131404,
					"content": "Có điều từ lúc anh ấy hôn mê đến nay, cơ thể rất yếu. Nếu các bạn muốn hỏi chuyện, xin hãy nhẹ nhàng một chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131405
					],
					"speakerTitle": "Anh Huang"
				},
				{
					"id": 411131405,
					"content": "Hỡi kẻ không may, bạn nhận được lời hỏi thăm của công chúa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131406
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411131406,
					"content": "Ôi... đói quá đi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131407
					],
					"speakerTitle": "Gao Lão Lục"
				},
				{
					"id": 411131407,
					"content": "Bạn không sao chứ? Có phải đang rất đói bụng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131408,
					"content": "Ôi trời...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131409,
						411131410
					],
					"speakerTitle": "Gao Lão Lục"
				},
				{
					"id": 411131409,
					"content": "Muốn ăn gì? Kể tên món ăn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131411
					]
				},
				{
					"id": 411131411,
					"content": "Muốn... ăn... đồ... đồ ăn... quê hương...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131412
					],
					"speakerTitle": "Gao Lão Lục"
				},
				{
					"id": 411131412,
					"content": "Món ăn quê hương của Khinh Sách Trang, chắc chắn là <color=#00E1FFFF>Món Nhà Nông Khinh Sách</color> rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131410,
					"content": "Tôi có thể làm cơm cho bạn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131411
					]
				}
			]
		},
