					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131002,
					"content": "Các bạn thực sự đã giúp việc lớn rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131003
					],
