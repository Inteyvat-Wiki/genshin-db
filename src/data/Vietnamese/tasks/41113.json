			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411130101,
					"content": "Mona! Nhờ phước của cô, chúng tôi đã dọn sạch rất nhiều thiên thạch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411130102,
					"content": "A, đúng lúc lắm! Có việc cần mọi người làm đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130103
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130103,
					"content": "Còn nhớ tôi từng nói thiên thạch này là cung mệnh của ai đó không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130104
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130104,
					"content": "Một ngôi sao xa xôi đột nhiên rơi xuống đất, theo lý thì điều này là không thể, nhưng thực tế lại trái ngược hẳn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130105
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130105,
					"content": "Muốn giải được câu đố, cách tốt nhất là điều tra rõ chủ nhân của cung mệnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130106
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130106,
					"content": "Bạn từng nói những người bị thiên thạch ảnh hưởng sẽ chìm vào giấc mơ, và hình như họ đều mơ thấy một ngọn núi tuyết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130107
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130107,
					"content": "Núi cao không rõ, nơi phủ đầy tuyết... Nhưng lại không phải là Long Tích Tuyết Sơn, nếu không sẽ có người nhận ra dáng núi liền.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130108
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130108,
					"content": "Có phải tất cả mọi người đều mơ cùng một giấc mơ? Trong mơ họ đang ở đâu? Những chi tiết này đều rất quan trọng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130109
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130109,
					"content": "Tôi cần bạn thu thập thêm thông tin về giấc mơ, càng nhiều manh mối thì càng dễ dàng tìm ra sự thật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130110
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130110,
					"content": "Xem ra cần phải tìm đến nơi đông người để điều tra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411130111,
					"content": "Đi tìm thêm vài bệnh nhân để hỏi thôi nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411130112,
					"content": "Tôi phải ở lại một nơi không bị quấy nhiễu, nên việc điều tra phải làm phiền các vị rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130113
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130113,
					"content": "Còn nơi nào chúng tôi chưa đến hả?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411130114,
					"content": "Ở Liyue có <color=#00E1FFFF>Khinh Sách Trang</color>... Tuy nơi đó không phải là \"nơi nhiều người\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130115
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411130115,
					"content": "Nhưng tôi nghĩ, nơi đó có lẽ sẽ được Thiên Nham Quân trưng dụng tạm thời như Nhà Trọ Vọng Thư, trở thành nơi chữa trị cho bệnh nhân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Oz"
				}
			]
		},
		{
			"id": 4111302,
			"completionStepIds": [
				4111302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
