			"dialogs": [
				{
					"id": 411131201,
					"content": "Phàm nhân! Bạn cũng đang rơi vào cõi đau khổ sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131202
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411131202,
					"content": "Các triệu chứng của người bệnh giống hệt như hai nơi khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131203,
					"content": "Xin chào, cho hỏi anh ấy đã tỉnh lại chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131204,
					"content": "Vẫn chưa, chỉ thỉnh thoảng nói mơ vài câu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131205
					],
					"speakerTitle": "Huaqing"
				},
				{
					"id": 411131205,
					"content": "Nói mơ những gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131206,
					"content": "Những câu kiểu như... lạnh quá... không đi nổi nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131207
					],
					"speakerTitle": "Huaqing"
				},
				{
					"id": 411131207,
					"content": "Lạnh? Trước đó cũng có người nhắc đến.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131208
					]
				},
				{
					"id": 411131208,
					"content": "Vùng núi lạnh giá... sẽ ở đâu đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Oz"
				}
			]
		},
		{
