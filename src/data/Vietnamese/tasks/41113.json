			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411130715,
					"content": "Cho dù dùng cách bói đơn giản nhất cũng sẽ phát hiện ra người đó... Chính là \"Quan Chấp Hành Fatui\"! Nguy hiểm quá, sao các bạn lại có liên hệ với hắn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130716
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130716,
					"content": "Cái gì? Anh chàng đó là Quan Chấp Hành Fatui? Một kẻ cực kỳ xấu xa...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130717
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411130717,
					"content": "Là Quan Chấp Hành?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411130718
					]
				},
				{
					"id": 411130718,
					"content": "Hắn tiếp cận cô chắc hẳn có mưu đồ gì đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130719
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130719,
					"content": "Hơn nữa, hắn rất mạnh! Liếc sơ qua cũng sẽ cảm nhận được, sức mạnh của hắn ngoài sức tưởng tượng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130720
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130720,
					"content": "Mặc dù không muốn thừa nhận, nhưng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130721
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130721,
					"content": "Lẽ nào hắn còn mạnh hơn cô Mona, thiên tài chiêm tinh hiếm thấy trên đời?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130722
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411130722,
					"content": "Ai, ai nói vậy! Chẳng qua thực lực của hắn mạnh hơn một tí, nếu tính thuật chiêm tinh thì kém xa tôi nhiều!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130723
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130723,
					"content": "Phải rồi, chúng tôi cũng đã gặp người của Fatui ở gần Nhà Trọ Vọng Thư!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130724
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411130724,
					"content": "Tại sao Fatui lại quan tâm đến thiên thạch nhiều như vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130725
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411130725,
					"content": "Quả nhiên là có âm mưu gì đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130726
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130726,
					"content": "Hừm, không lẽ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130727
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130727,
					"content": "Hả! Không lẽ những thiên thạch này được người Fatui tạo ra?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411130728,
					"content": "Paimon! Sao bạn dám cướp lời thoại của tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130729
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130729,
					"content": "Úi, hehe... xin lỗi nhé, là do tôi nhanh miệng hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130730
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411130730,
					"content": "Nhưng, trên đời này có phép thuật triệu hồi thiên thạch sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411130731
					]
				},
				{
					"id": 411130731,
					"content": "Kéo một ngôi sao từ trên trời rơi xuống, thật đáng nể!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130732
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411130732,
					"content": "Ozvaldo Hrafnavines ngươi cảm thấy thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130733
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411130733,
					"content": "Thưa tiểu thư, tôi nghĩ mọi thứ đều có thể.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130734
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411130734,
					"content": "Chỉ cần trả cái giá như nhau, các hạt giống khác nhau sẽ bén rễ ở bất kỳ nơi nào... Fatui, bổn công chúa ghi nhớ các ngươi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130735
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411130735,
					"content": "Ha, phép màu cũng có thể xảy ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130736
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411130736,
					"content": "Sứ giả của các vì sao, không hổ là tuỳ tùng xuất sắc của tôi! Tôi sẽ hạ lệnh cho thuộc hạ bảo vệ bạn khỏi sự tấn công của bóng tối.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130737
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411130737,
					"content": "Ví dụ là tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130738
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411130738,
					"content": "Thôi! Thôi! Thôi, việc sắp xếp chiến đấu của chúng ta đang rất hợp lý, cứ giữ như thế này là được rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130739
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411130739,
					"content": "Fischl bạn đang coi thường tôi sao? Tôi rất mạnh đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130740
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130740,
					"content": "Không có ai đáng tin cậy hơn bạn đâu, thưa quý cô. Chỉ có điều, công chúa cũng sẽ lo lắng cho sự an toàn của bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130741
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411130741,
					"content": "Không cần thiết. Hơn nữa, nơi các bạn ở còn nguy hiểm hơn tôi, nếu có thể tôi còn muốn bảo vệ các bạn nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130742,
						411130744
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130742,
					"content": "Mona, bạn thật tốt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411130743
					]
				},
				{
					"id": 411130743,
					"content": "Sao, sao tự dưng lại nói những lời này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130746
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130746,
					"content": "Trước tiên, hãy giải quyết rắc rối mới, bảng chiêm tinh cho thấy, có một <color=#00E1FFFF>thiên thạch cực lớn</color> đang rơi xuống.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130744,
					"content": "Fischl, bạn thật tốt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411130745
					]
				},
				{
					"id": 411130745,
					"content": "Tất, tất nhiên rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130746
					],
					"speakerTitle": "Fischl"
				}
			]
		},
