					"speakerTitle": "Oz"
				},
				{
					"id": 411130903,
					"content": "Nguồn gốc của bóng tối và huỷ diệt... đã đến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130904
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411130904,
					"content": "Lẽ nào đám người Fatui đó nhắm vào sức mạnh nguyên tố?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411130905,
					"content": "Không phải là không thể. Nếu vậy thì những sinh vật khác cũng sẽ muốn có sức mạnh này mới đúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130906
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130906,
					"content": "Chúng ta đến gần xem sao.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
