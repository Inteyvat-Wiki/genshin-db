				"points": []
			},
			"dialogs": [
				{
					"id": 411131301,
					"content": "Xin hỏi bệnh nhân này đã tỉnh lại chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131302,
					"content": "Vẫn chưa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131303
					],
					"speakerTitle": "Yang"
				},
				{
					"id": 411131303,
					"content": "Vậy anh ấy có nói mơ không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131304,
					"content": "Nói như vậy... Hôm qua dường như anh ấy đã hét lên \"Cao quá\", không hiểu có ý gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131305
					],
					"speakerTitle": "Yang"
				},
				{
					"id": 411131305,
					"content": "Cao quá? Là nói độ cao của núi tuyết sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131306,
					"content": "Ngọn núi ma quái lạnh lẽo cao chót vót, tuôn trào sức mạnh của bóng tối...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131307
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411131307,
					"content": "Hỏi thêm người bên kia đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4111314,
			"completionStepIds": [
				4111314
			],
