			"dialogs": [
				{
					"id": 411131101,
					"content": "Ơn trời... sống lại rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131102
					],
					"speakerTitle": "Gao Lão Lục"
				},
				{
					"id": 411131102,
					"content": "Xin hỏi, bạn có mơ trong khi ngủ không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131103,
					"content": "Có... có mơ, làm tôi mệt chết đi được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131104
					],
					"speakerTitle": "Gao Lão Lục"
				},
				{
					"id": 411131104,
					"content": "Mơ cái gì mà có thể khiến người ta mệt mỏi đến vậy nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131105,
						411131107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131105,
					"content": "Bạn mơ thấy mình đang ở trên núi à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131106
					]
				},
				{
					"id": 411131106,
					"content": "Sao bạn biết? Đó là ngọn núi tuyết rất cao, rất lạnh... Tôi chưa bao giờ nhìn thấy ngọn núi nào cao như thế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131109
					],
					"speakerTitle": "Gao Lão Lục"
				},
				{
					"id": 411131109,
					"content": "Bạn đến núi tuyết làm gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131110,
					"content": "Tôi cũng không biết nữa, giống như trúng tà vậy, trong mơ chỉ nghĩ đến việc leo núi, phải đến đỉnh núi cao nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131111
					],
					"speakerTitle": "Gao Lão Lục"
				},
				{
					"id": 411131111,
					"content": "Trên đỉnh núi có thứ gì hay ho không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131112,
					"content": "Ai mà biết được? Tôi vừa ngủ liền giống như biến thành người khác vậy, tôi cũng không giải thích được lý do tại sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131113
					],
					"speakerTitle": "Gao Lão Lục"
				},
				{
					"id": 411131113,
					"content": "Không phải tự bạn muốn leo lên sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131114
					]
				},
				{
					"id": 411131114,
					"content": "Nói sao nhỉ... giống như có người đang điều khiển vậy, khiến tôi nảy ra ý định leo núi, rất kỳ lạ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131115
					],
					"speakerTitle": "Gao Lão Lục"
				},
				{
					"id": 411131115,
					"content": "Có lẽ nào là bóng đen trong trái tim???",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131116
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411131116,
					"content": "Không phải tự nhiên mà là do tiềm thức nảy sinh ra mong muốn này. Nó thực sự rất giống với việc kiểm soát tâm trí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131117,
						411131118
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411131117,
					"content": "Mặc dù đã quen rồi, nhưng vẫn muốn nói...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131119
					]
				},
				{
					"id": 411131119,
					"content": "Nói cách khác thì, trước đó những người kêu lên lạnh quá, leo không nổi nữa rồi... đều là đang ở núi tuyết sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131120,
					"content": "Tất cả mọi người đều mơ cùng một giấc mơ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131121
					]
				},
				{
					"id": 411131121,
					"content": "Thật không thể ngờ... phải mau nói chuyện này cho <color=#00E1FFFF>Mona</color> mới được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131118,
					"content": "Hai bạn hoàn toàn không nói cùng một chủ đề...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131119
					]
				},
				{
					"id": 411131107,
					"content": "Bạn mơ thấy mình ở trên cánh đồng phủ đầy tuyết sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131108
					]
				},
				{
					"id": 411131108,
					"content": "Không phải cánh đồng tuyết, là núi tuyết. Cao vô cùng, mà lại rất lạnh... tôi vừa ngủ liền mơ thấy mình đang đứng dưới chân núi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131109
					],
					"speakerTitle": "Gao Lão Lục"
				}
			]
