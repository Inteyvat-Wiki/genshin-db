			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jinglun"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411130201,
					"content": "Xin chào, chúng tôi đến từ Hiệp Hội Nhà Mạo Hiểm. Cho hỏi khu vực Khinh Sách Trang có bị ảnh hưởng nhiều bởi thiên thạch không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411130202,
					"content": "Là nhà mạo hiểm à! Tốt quá, đang buồn vì không có ai đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130203
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411130203,
					"content": "Mấy ngày nay, thiên thạch lâu lâu lại rơi xuống, còn rắc rối thì không đếm xuể.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130204
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411130204,
					"content": "Rơi xuống <color=#00E1FFFF>đồng lúa</color>, không ai dám đi thu hoạch lương thực, rơi xuống <color=#00E1FFFF>cổng lớn</color>, cản trở đi lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130205
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411130205,
					"content": "Các vị có cách nào dọn sạch những thiên thạch này không? Vướng tay vương chân quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130206
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411130206,
					"content": "Xem ra Khinh Sách Trang cũng đang gặp phiền phức.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411130207
					]
				},
				{
					"id": 411130207,
					"content": "Hết cách rồi, đến lúc chúng ta phải hành động.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
