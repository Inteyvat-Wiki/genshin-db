			"dialogs": [
				{
					"id": 240090901,
					"content": "Lần này... khó xử lý rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090902,
						240090903
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090902,
					"content": "Lần này phải chụp gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090904
					]
				},
				{
					"id": 240090904,
					"content": "Lần này... không phiền bạn chụp ảnh nữa, tôi muốn bạn giúp một việc khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090905
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090905,
					"content": "Khụ, nói ra thì rất ngại, có thể... phiền bạn giúp tôi kiếm chút đồ ăn không... Ví dụ như \"Bánh Mì Bơ Tỏi\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090906,
						240090907
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090906,
					"content": "Anh không mang đồ ăn à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090908
					]
				},
				{
					"id": 240090908,
					"content": "Không phải! Tôi mang rất nhiều bánh mì, còn có mứt và thịt khô nữa, vốn dĩ đủ ăn cho hôm nay...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090909
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090909,
					"content": "Tôi mải vẽ quá nên đặt đồ ăn ở bên cạnh... Tới lúc cảm thấy đói bụng thì không thấy đống đồ ăn đâu nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090910
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090910,
					"content": "Không biết là con thú nào tha đi hay tên nào đi ngang qua trộm mất... Haiz, hy vọng số thức ăn đó sẽ giúp chúng lấp đầy cái bụng rỗng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090911
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090911,
					"content": "Nhưng cái bụng rỗng của tôi cũng phải tìm cách lấp đầy mới được... Tôi không thể về thành vào lúc này, tư liệu vẫn chưa tìm đủ nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090912,
						240090913
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090912,
					"content": "Đợi một chút.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090914
					]
				},
				{
					"id": 240090914,
					"content": "Cảm ơn nhé, \"Bánh Mì Bơ Tỏi\" có thể mua ở cửa tiệm trong thành!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090915
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090915,
					"content": "Haha... Giờ tôi cũng hết sức rồi, không biết là do đói hay do suy nghĩ quá nhiều nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090913,
					"content": "Để tôi đi lấy cho anh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090914
					]
				},
				{
					"id": 240090907,
					"content": "Anh không có tiền mua đồ ăn à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090908
					]
				},
				{
					"id": 240090903,
					"content": "Lần này phải đi đâu chụp ảnh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090904
					]
				}
			]
