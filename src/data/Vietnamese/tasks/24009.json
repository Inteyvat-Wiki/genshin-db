			},
			"dialogs": [
				{
					"id": 240090201,
					"content": "Xem nào... Bạn bè đã cho tôi vài góp ý, tôi đều ghi chép trong sổ này rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090202
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090202,
					"content": "Thực vật dưới nước... đung đưa... thay đổi... khi đó tôi viết gì nhỉ? Hừm... chắc là uống say rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090203
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090203,
					"content": "Khụ, phiền bạn xuống dưới nước chụp cho tôi một ít thực vật thủy sinh nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090204
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090204,
					"content": "Xem ra... khi tôi viết ghi chép này, chắc là đang rất hứng thú với sự thay đổi ánh sáng của thực vật dưới nước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				}
			]
		},
