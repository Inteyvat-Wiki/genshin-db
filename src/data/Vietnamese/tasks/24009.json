			},
			"dialogs": [
				{
					"id": 240090601,
					"content": "Xem nào... Bạn bè đã cho tôi vài góp ý, tôi đều ghi chép trong sổ này rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090602
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090602,
					"content": "Tôi viết gì nhỉ? Xem nào... Hmm... nham thạch thô ráp dưới nước... thực vật trên nham thạch... đường nét nham thạch...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090603
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090603,
					"content": "Ừm, đúng vậy. Lúc đó tôi đang say mê nghiên cứu nham thạch, và cho rằng chúng thể hiện rất tốt nét đẹp của thiên nhiên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090604
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090604,
					"content": "Vậy phiền bạn giúp tôi chụp lại vài tấm ảnh nham thạch nhé. Không biết nham thạch dưới nước có đường nét ra sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				}
			]
		},
