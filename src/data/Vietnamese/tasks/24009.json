					"id": 240090401,
					"content": "Xem nào... Bạn bè đã cho tôi vài góp ý, tôi đều ghi chép trong sổ này rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090402
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090402,
					"content": "\"Phế tích khổng lồ dưới nước!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090403
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090403,
					"content": "Sao tôi dùng lực viết mạnh vậy nhỉ, gần rách cả giấy rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090404
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090404,
					"content": "Nhưng phế tích khổng lồ dưới nước... nghe như mang vẻ đẹp gì đó rất đặc biệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090405
					],
