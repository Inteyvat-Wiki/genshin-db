			},
			"dialogs": [
				{
					"id": 240091001,
					"content": "Cảm ơn bạn, chỗ này đủ tôi ăn no rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091002
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091002,
					"content": "Phần thù lao này gửi bạn, xin hãy nhận. Tôi phải mau chóng ăn vài miếng đã...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091003
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091003,
					"content": "Lần sau tôi phải đút túi một chút bánh quy mới được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				}
			]
		},
