					"nextDialogs": [
						240091102
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091102,
					"content": "Nhưng mà... cảm thấy thiếu thứ gì đó mang tính quyết định...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091103,
						240091105
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091103,
					"content": "Anh đang chụp ảnh sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091104
					]
				},
				{
					"id": 240091104,
					"content": "Đúng thế, tôi đang dùng máy ảnh để lấy tư liệu vẽ tranh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091107
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091107,
					"content": "Tôi tên Depierris, là một họa sĩ, rất vui được làm quen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091108
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091108,
					"content": "Ồ... ồ, xin chào.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091109
					]
				},
				{
					"id": 240091109,
					"content": "Thường thì tôi sẽ mời người bạn mới một ly cà phê, nhưng hiện tại thì không có quán cà phê nào quanh đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091110
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091110,
					"content": "Thế này đi, hãy cầm lấy cốc Fonta này, chúng ta cụng ly, xem như chính thức kết giao bạn bè... À mà bạn đã từng tới Fontaine bao giờ chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091111
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091111,
					"content": "Đây là lần đầu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091112
					]
				},
				{
					"id": 240091112,
					"content": "Thế thì tha hồ chơi rồi. Trước tiên có thể đi dạo trong thành, ngắm nhìn những cung đường nước đan xen ngang dọc trên đầu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091113
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091113,
					"content": "Sau đó đi thăm thú máy móc tinh xảo trên phố. Dưới góc độ là một họa sĩ, tôi thấy... máy móc cũng có giá trị thẩm mỹ của nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091114
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091114,
					"content": "Cuối cùng, nhất định phải tới quán cà phê và gọi một ly, ngồi xuống từ từ thưởng thức.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091115
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091115,
					"content": "Trong lúc uống cà phê, không chừng sẽ có người đến trò chuyện với bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091116
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091116,
					"content": "Tuy nhiên, nếu người tới trò chuyện mà nói họ là người của \"Hội Đam Mê Máy Ảnh\" gì đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091117
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091117,
					"content": "Thì hãy cảnh giác, không chừng họ sẽ nói mấy câu rất ngớ ngẩn... Dù sao thì một số người trong đó cũng đang làm mấy chuyện hết sức ngu ngốc mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091118,
						240091120
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091118,
					"content": "Bọn họ đã làm gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091119
					]
				},
				{
					"id": 240091119,
					"content": "Làm gì ư? Một phần trong số họ đang hủy hoại sự văn minh của Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091122
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091122,
					"content": "Đừng nghĩ tôi hăm dọa vô cớ. Bạn biết người trong hội này nói gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091123
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091123,
					"content": "\"Về mặt hình ảnh, những tấm hình chụp từ máy ảnh tốt hơn nhiều so với tranh mà họa sĩ vẽ ra.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091124
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091124,
					"content": "Nghe rõ chứ? \"Về mặt hình ảnh\"... đúng là ngu xuẩn, vậy mà đám người đó lại cho là chân lý!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091125
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091125,
					"content": "Nếu họa sĩ chỉ muốn thể hiện một hình ảnh y hệt bản gốc, vậy thì tính thẩm mỹ để làm gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091126
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091126,
					"content": "Vài đồng nghiệp của tôi quả thật đang nghĩ cách để tả thực chi tiết hơn... nhưng chuyện đó cũng phải dựa vào thẩm mỹ của họ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091127
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091127,
					"content": "Thẩm mỹ! Quan trọng là thẩm mỹ, bạn hiểu không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091128,
						240091129
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091128,
					"content": "Tôi, không hiểu lắm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091130
					]
				},
				{
					"id": 240091130,
					"content": "Họa sĩ dùng mắt cảm nhận thế giới, cũng chỉ là bước khởi đầu. Phải biết dùng bút để khám phá linh hồn và cái đẹp, mới thực sự vẽ ra bức tranh đẹp bằng cả tâm hồn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091131
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091131,
					"content": "Tôi không muốn tất cả những người đam mê máy ảnh đều bị coi là lũ đần độn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091132
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091132,
					"content": "Tôi cũng có nhiều bạn bè đam mê máy ảnh, cũng hay giao lưu. Đôi khi ảnh của họ cho tôi hứng thú, đôi khi là tranh của tôi truyền cảm hứng cho họ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091133
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091133,
					"content": "Nhưng cái đám dốt nát thì chỉ giỏi ăn nói xằng bậy, thật là khó chịu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091134
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091134,
					"content": "Chúng còn sỉ nhục cả những người đam mê nhiếp ảnh và hội họa! Chúng thật là... khụ khụ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091135
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091135,
					"content": "Uống chút nước, uống chút nước đã...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091136
					]
				},
				{
					"id": 240091136,
					"content": "Cảm ơn... Mỗi lần nhắc đến chuyện này tôi lại không kiềm chế được cơn giận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091137
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091137,
					"content": "Vì thế, tôi và vài người bạn đang tính dùng máy ảnh để chụp một loạt ảnh, rồi mượn cảm hứng từ chúng để sáng tác một loạt tranh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091138
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091138,
					"content": "Sau đó đem số ảnh và tranh này làm triển lãm, đặt chúng cạnh nhau, để mọi người chiêm ngưỡng xem rốt cuộc nhiếp ảnh và hội họa khác nhau thế nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091139
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091139,
					"content": "Nhưng mà... haiz, mấy tấm tôi chụp chẳng có gì thú vị. Mấy người bạn tôi nói là, cảnh đẹp luôn ở nơi nguy hiểm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091140
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091140,
					"content": "Ví dụ như dưới nước, trên đỉnh núi, hay những khu rừng rậm hoang vu... Nhưng một mình tôi không dám đến những nơi đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091141
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091141,
					"content": "Nếu nhờ nhà mạo hiểm giúp đỡ thì lại mất nhiều thời gian...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091142
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091142,
					"content": "Hmm... Nhà Lữ Hành thân mến, bạn có ngại... khi được thuê bởi một nghệ sĩ không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091143,
						240091144
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091143,
					"content": "Chỉ cần không phải vẽ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091145
					]
				},
				{
					"id": 240091145,
					"content": "Không cần lo lắng, hai chúng ta chỉ cần làm những việc sở trường của mình là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091146
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091146,
					"content": "Cũng đừng lo về thù lao, tôi thường thuê nhà mạo hiểm bảo vệ tôi đi khắp nơi tìm cảm hứng, nên cũng hiểu phép tắc của họ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091147
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091147,
					"content": "Chỉ là lần này đi hơi vội, không kịp tìm nhà mạo hiểm để đồng hành thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091148
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091148,
					"content": "Quyết định vậy đi, có bạn giúp đỡ, tôi sẽ có thêm tự tin để vẽ tranh rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091144,
					"content": "Tôi chỉ giỏi mấy việc của nhà mạo hiểm thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091145
					]
				},
				{
					"id": 240091129,
					"content": "Tôi... hiểu một chút...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091130
					]
				},
				{
					"id": 240091120,
					"content": "Họ sẽ làm gì tôi à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091121
					]
				},
				{
					"id": 240091121,
					"content": "Giống như họ đã làm với Fontaine vậy, sẽ hủy hoại thứ văn minh mà bạn đáng được tận hưởng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091122
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091105,
					"content": "Anh là người đam mê máy ảnh à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091106
					]
				},
				{
					"id": 240091106,
					"content": "Đam mê? Đương nhiên không phải. Với tôi, máy ảnh chỉ là công cụ để thu thập tư liệu tham khảo, tôi vẫn đam mê những bức tranh của mình hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091107
					],
					"speakerTitle": "Depierris"
				}
			]
		},
