			"dialogs": [
				{
					"id": 240090801,
					"content": "Đã chụp được tấm nào chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090802
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090802,
					"content": "Chụp được rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090803
					]
				},
				{
					"id": 240090803,
					"content": "Để tôi xem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090804
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090804,
					"content": "Tấm ảnh hoàn hảo! Không ngờ bạn chụp ảnh lại nghệ như vậy, thật là xuất sắc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090805
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090805,
					"content": "Tôi nhất định sẽ chọn được những tư liệu tuyệt vời trong tấm ảnh này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090806
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090806,
					"content": "Rất cảm ơn, xem nào... Mora để đâu rồi nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090807
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090807,
					"content": "Được rồi, chỗ này gửi bạn, xin hãy nhận! Nếu sau này có cơ hội, mong bạn sẽ giúp tôi chụp thêm vài tấm nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090808
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090808,
					"content": "Bây giờ... để tôi suy nghĩ xem cảnh tượng này thế nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				}
			]
		},
