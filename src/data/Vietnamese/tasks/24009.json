			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Depierris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240090101,
					"content": "Nhà Lữ Hành! Bạn đến thật đúng lúc, tôi vừa tìm được một nơi chụp ảnh tuyệt đỉnh, thiếu mỗi bạn giúp tôi nữa thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090102
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090102,
					"content": "Vẫn đang tìm cảm hứng sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090103
					]
				},
				{
					"id": 240090103,
					"content": "Đương nhiên, một tấm ảnh thì không thể đủ để tôi sáng tác một bức tranh hoàn chỉnh được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090104
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090104,
					"content": "Thường nếu tôi lấy cảm hứng từ những tấm ảnh này, ít thì phải vài chục tấm, nhiều thì cả trăm tấm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090105,
						240090106
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090105,
					"content": "Cần nhiều vậy sao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090107
					]
				},
				{
					"id": 240090107,
					"content": "Giống như tôi đã nói trước đây, trọng tâm của hội họa chính là \"sáng tạo\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090108
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090108,
					"content": "Nếu chỉ đem những thứ nhìn thấy được thể hiện trên bức vẽ... thì không thể gọi là \"hội họa\", mà chỉ là một dạng \"chụp ảnh\" thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090109
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090109,
					"content": "Họa sĩ thực sự cần phải dùng tính thẩm mỹ và sự linh hoạt của mình để xem xét sự vật trước mắt, sau đó tiến hành chọn lọc, biến đổi hay cắt xén...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090110
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090110,
					"content": "Cho đến khi trừu tượng hóa thứ \"đẹp nhất\" trong mỗi sự vật, đem nó khắc ghi lên tranh vẽ, như vậy mới hoàn thành được bức tranh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090111,
						240090112
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090111,
					"content": "Không hiểu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090113
					]
				},
				{
					"id": 240090113,
					"content": "...Được rồi. Nói một cách đơn giản thì tôi chỉ lấy cảm hứng từ phần đẹp nhất trong những tấm ảnh này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090114
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090114,
					"content": "Ví dụ, tấm này ánh sáng rất tốt, nhưng cảnh vật thì hơi chán, vậy thì tôi chỉ tham khảo ánh sáng thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090115
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090115,
					"content": "Tấm này có một người đi đường với sắc thái rất thú vị, tấm tiếp theo có kiến trúc rất hùng vĩ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090116
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090116,
					"content": "Giống như trong đầu đang chơi xếp hình vậy, sự vật ghép được có đẹp hay không sẽ phụ thuộc vào thẩm mỹ và học thức của bản thân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090117
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090117,
					"content": "Tôi nói như vậy là rất đơn giản rồi, vì chúng tôi còn phải biến đổi cảnh vật tư liệu, trừu tượng hóa, kiểu vậy... Nhưng bạn cứ hiểu như vậy là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090118,
						240090119
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090118,
					"content": "Nên anh vẫn cần tôi giúp sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090120
					]
				},
				{
					"id": 240090120,
					"content": "Hmm... Đúng vậy! Kỹ năng chụp hình của bạn rất đỉnh, khi nhìn thấy ảnh bạn chụp, bạn bè tôi đều rất muốn được gặp bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090121
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090121,
					"content": "Được bạn giúp đỡ, chắc chắn tôi sẽ sáng tác ra những bức tranh đỉnh cao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090122
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090122,
					"content": "Ây da, vì thẩm mỹ của mọi người, cùng với số Mora tôi đã chuẩn bị đây, mong bạn giúp đỡ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090119,
					"content": "Nên tôi phải tiếp tục giúp anh lấy cảm hứng à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090120
					]
				},
				{
					"id": 240090112,
					"content": "Nói đơn giản hơn đi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090113
					]
				},
				{
					"id": 240090106,
					"content": "Những tấm ảnh này có gì khác nhau?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090107
					]
				}
			]
		},
		{
			"id": 2400902,
