			"dialogs": [
				{
					"id": 3830201,
					"content": "À ừm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3830202,
					"content": "Hiệp hội bảo vệ Dvalin! Tập hợp!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3830203,
					"content": "Vậy thì, mau lấy kết tinh thu thập được ra đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830204
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3830204,
					"content": "A...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830205
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3830205,
					"content": "Màu sắc của kết tinh hình như bị nhiễm bẩn hơn rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830206
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3830206,
					"content": "Dvalin... rốt cuộc đang phải chịu đựng sự dày vò như thế nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830207
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3830207,
					"content": "Tóm lại, hãy thanh tẩy những kết tinh này trước. Nhà Lữ Hành đến từ phương xa, nhờ bạn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830208
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3830208,
					"content": "Nếu không phải tận mắt chứng kiến, thật là khó mà tin được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830209
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3830209,
					"content": "Thật thú vị. Việc này khiến người khác cảm thấy thoải mái giống như là lọc rượu vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830210
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3830210,
					"content": "Bấy nhiêu nước mắt là đủ rồi. Vậy thì tiếp theo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
