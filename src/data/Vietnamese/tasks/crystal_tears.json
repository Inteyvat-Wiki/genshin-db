			"dialogs": [
				{
					"id": 3830401,
					"content": "Thành công rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3830402,
					"content": "Cảm giác hoàn toàn khác với trước đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830403
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3830403,
					"content": "Nguyên Tố Phong... đầy đến mức sôi động. Như vậy chắc là được rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830404
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3830404,
					"content": "#Cám ơn bạn, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830405
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3830405,
					"content": "Vậy thì, chúng ta phải đi đâu triệu hồi Phong Ma Long?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830406
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3830406,
					"content": "Không thể làm trong thành Mondstadt được, nếu thất bại sẽ gây ra tổn thất không thể bù đắp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830407
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3830407,
					"content": "Ở trong tửu trang này, đương nhiên cũng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830408
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3830408,
					"content": "Ồ, tửu trang không còn nữa thì cũng không phải tổn thất gì ghê gớm, nhưng tốt nhất không nên làm thế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830409
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3830409,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830410
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3830410,
					"content": "Gió biển hoặc gió ở nơi cao, đều có thể đem tiếng hát của nhà thơ bay xa hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830411
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3830411,
					"content": "Nếu không khí khô hạn, buồn tẻ và chán nản, thì không chỉ nhà thơ, kể cả rồng cũng sẽ nổi giận mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830412
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3830412,
					"content": "Hóa ra là vậy. Gió biển hoặc gió ở nơi cao, phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3830413,
					"content": "Cho nên, nơi thích hợp để diễn tấu nhất chắc là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830414,
						3830415,
						3830416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3830414,
					"content": "Vách núi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3830418
					]
				},
				{
					"id": 3830418,
					"content": "Từ Hồ Sao Rơi đi một đoạn về hướng đông, phía nam bờ biển có một vùng núi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830419
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3830419,
					"content": "...A! Là bờ biển lần trước bạn nằm ngủ nướng phải không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3830420,
					"content": "Leo dọc theo vùng núi, có thể đến được một nơi gọi là <color=#00E1FFFF>Vực Hái Sao</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830421
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3830421,
					"content": "Ca sĩ, gió biển và gió ở nơi cao mà cậu muốn, đều có thể tìm thấy ở đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830422
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3830422,
					"content": "Ừm, để tôi suy nghĩ, Vực Hái Sao phải không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830423
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3830423,
					"content": "...Quả thực là một nơi rất tốt, rất hợp với giọng hát của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830424
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3830424,
					"content": "Rất tốt. Vậy thì chúng ta hãy chuẩn bị sẵn sàng, tập hợp tại Vực Hái Sao nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830425
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3830425,
					"content": "Mong mọi người nghiêm túc, không được đến trễ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830426
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3830426,
					"content": "Tuân lệnh, đội trưởng đại nhân!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3830427,
					"content": "A... xin lỗi, không cẩn thận đã...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jean"
				},
				{
					"id": 3830415,
					"content": "Bờ biển?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3830418
					]
				},
				{
					"id": 3830416,
					"content": "Vừa bay trên trời vừa đàn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3830417
					]
				},
				{
					"id": 3830417,
					"content": "Chuyện đó thì đến cả Amber cũng không làm được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830418
					],
					"speakerTitle": "Jean"
				}
			]
		}
	]
