			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412120701,
					"content": "Albedo, mọi chuyện thuận lợi chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120702,
					"content": "Tạm ổn. Có mấy trang bị rách, nhưng phần lớn là không bị gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120703
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120703,
					"content": "Nhiệt độ Tuyết Sơn quá thấp, nhất là sơn động đó, nhiệt độ xung quanh đã đạt đến cực hạn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120704
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120704,
					"content": "Đã vậy Hilichurl còn nhổ nước lên quyển sách. Miếng giấy đóng băng rơi ở một nơi nhiệt độ thấp như vậy, đúng là không thể tưởng tượng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120705
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120705,
					"content": "Giấy đóng băng rất giòn, chạm vào sẽ vỡ đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120706,
					"content": "May mà bạn có cách cứu được nó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120707
					]
				},
				{
					"id": 412120707,
					"content": "Không hổ là Giả Kim Thuật Sĩ, thật khéo léo",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120708,
					"content": "Nếu quyển sạch bị hư hỏng nghiêm trọng, chắc chắn Albedo sẽ nổi trận lôi đình nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120709,
					"content": "Tại sao bạn lại nghĩ như vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120710
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120710,
					"content": "Vì bạn từng nói trong đó có rất nhiều hình ảnh và ghi chú.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120711,
					"content": "Thật sự là vậy, quyển sách phác thảo đó tôi luôn đem theo bên mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120712
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120712,
					"content": "Nhưng cũng không đến nỗi vì chuyện này mà tức giận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120713
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120713,
					"content": "Nếu thật sự không cứu vãn được thì vẽ lại là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120714
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120714,
					"content": "Ồ... Vào thời điểm này lại rất thực tế...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120715,
						412120716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120715,
					"content": "Tôi không nghĩ vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120717
					]
				},
				{
					"id": 412120717,
					"content": "Vậy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120718
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120718,
					"content": "Dù thế nào thì đó cũng là bạn dùng cả tâm huyết để vẽ mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120719
					]
				},
				{
					"id": 412120719,
					"content": "Đúng vậy đúng vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120720
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120720,
					"content": "Những thứ bức tranh mang theo là ký ức.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120721
					]
				},
				{
					"id": 412120721,
					"content": "Đúng vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120722
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120722,
					"content": "Đừng dễ dàng từ bỏ những thứ liên quan đến kỷ niệm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120723
					]
				},
				{
					"id": 412120723,
					"content": "#Đúng vậy! Nói hay lắm {NICKNAME}, thật ra tôi cũng muốn nói vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120724
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120724,
					"content": "...Cũng phải. Vẽ lại rất phiền phức, tôi không thích như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120725
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120725,
					"content": "Tôi đoán đó là vì Albedo là một thiên tài?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120726
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120726,
					"content": "Bạn thấy đấy, bạn biết rất nhiều kỹ năng mà người khác không biết, và bạn hiểu rất nhiều đạo lý mà người khác không hiểu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120727,
					"content": "Những người như vậy đôi khi bỏ qua các chi tiết. Có thể nói đây là nhược điểm của sự thông minh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120728,
					"content": "Albedo cũng từng nói Paimon rất thông minh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120729
					]
				},
				{
					"id": 412120729,
					"content": "Đúng vậy, Paimon là một sinh vật rất thú vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120730,
						412120731
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120730,
					"content": "Paimon cũng bỏ qua chi tiết nhỏ sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120732
					]
				},
				{
					"id": 412120732,
					"content": "A... Đừng đụng chạm đến tôi khi tôi đang nói đạo lý chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120733
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120733,
					"content": "Vậy thì đổi chủ đề. Lúc trước Cyrus nói, Hilichurl Núi Tuyết thường xuyên tấn công Nhà Mạo Hiểm để cướp đồ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120734
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120734,
					"content": "Nơi chúng ta đi, có lẽ là một trong những căn cứ của bọn Hilichurl đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120735
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120735,
					"content": "Hilichurl ở đây rất mạnh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120736
					]
				},
				{
					"id": 412120736,
					"content": "Đúng vậy, Hilichurl ở đây mạnh hơn Hilichurl dưới chân núi nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120737
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120737,
					"content": "Tôi cũng có cảm giác như vậy. Tôi nghĩ... điều này vẫn có liên quan tới \"Rồng\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120738
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120738,
					"content": "Sức mạnh bị nhiễm bẩn trong hài cốt của Durin sẽ tiếp thêm sức mạnh cho quái vật. Thêm khí hậu lạnh giá, một số khu vực của Núi Tuyết đã trở thành chốn không người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120739
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120739,
					"content": "Nhà Lữ Hành, có thể lấy kiếm ra không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120740
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120740,
					"content": "Mỗi lần chiến đấu ở Núi Tuyết, thanh kiếm này đều hấp thu sức mạnh vào trong kiếm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120741
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120741,
					"content": "Hơn nữa do bạn đã thanh tẩy nó, những sức mạnh vốn dĩ bị huyết rồng làm vấy bẩn, dường như đều được rửa sạch rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120742
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120742,
					"content": "Đó là một hiện tượng rất ý nghĩa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120743
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120743,
					"content": "Chúng tôi đã quen với điều này rồi, rất rành đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120744
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120744,
					"content": "Mặc dù biết là bạn có sức mạnh này, nhưng... thì ra đó là thanh tẩy, đúng là trăm nghe không bằng mắt thấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120745
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120745,
					"content": "Kiếm có thể lưu trữ sức mạnh, rất nguy hiểm nhỉ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120746
					]
				},
				{
					"id": 412120746,
					"content": "Không thể nói rằng nó là một vũ khí rất an toàn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120747
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120747,
					"content": "May mà không bị bọn Hilichurl cướp đi, nếu không chúng ta sẽ tiêu mất! Bọn Hilichurl Núi Tuyết sẽ mạnh đến cỡ nào chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120748,
						412120749
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120748,
					"content": "Fatui nguy hiểm hơn chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120750
					]
				},
				{
					"id": 412120750,
					"content": "Hilichurl cũng rất nguy hiểm! Nếu bọn chúng có được năng lượng, trở thành... siêu cấp, không, Hilichurl đỉnh cấp!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120751
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120751,
					"content": "Ma Hilichurl!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120752
					]
				},
				{
					"id": 412120752,
					"content": "Ác Ma Hilichurl!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120753
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120753,
					"content": "Người Tuyết Ác Ma Hilichurl!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120754
					]
				},
				{
					"id": 412120754,
					"content": "Tại sao lại thêm chữ tuyết, nghe có vẻ yếu đuối...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120755
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120755,
					"content": "Nhắc mới nhớ, nếu thanh kiếm này mạnh như vậy, có phải nó cũng có thể hấp thụ sức mạnh của Albedo không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120756
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120756,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120757
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120757,
					"content": "Muốn thử không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120758
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120758,
					"content": "Oa! Ánh mắt bỗng trở nên lạnh lùng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120759,
						412120760
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120759,
					"content": "Paimon nói đùa đấy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120761
					]
				},
				{
					"id": 412120761,
					"content": "Không, tôi không giận. Tóm lại, mong bạn có thể tiếp tục sử dụng thanh kiếm này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120762
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120762,
					"content": "Dù thanh kiếm này nguy hiểm, bạn vẫn tin tưởng tôi sao? Thật bất ngờ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120763
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120763,
					"content": "Albedo bề ngoài trông như này, nhưng bên trong lại như kia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120764
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120764,
					"content": "Như này, như kia... là sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120765
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120765,
					"content": "Nói đến nguyên nhân tôi tin tưởng các bạn... Có lẽ là vì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120766
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120766,
					"content": "Sự đồng thuận giữa những thứ \"khác loài\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120767
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120767,
					"content": "Khác loài?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120768
					]
				},
				{
					"id": 412120768,
					"content": "Cá thể độc lập... và cá thể khác nhau của người bình thường, như... bạn và tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120769,
						412120770
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120769,
					"content": "(...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 412120770,
					"content": "(Câu nói này có hàm ý đặc biệt gì không?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 412120760,
					"content": "Paimon không có ác ý...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120761
					]
				},
				{
					"id": 412120749,
					"content": "Đạo Bảo Đoàn nguy hiểm hơn chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120750
					]
				},
				{
