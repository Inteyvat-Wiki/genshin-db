			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412120101,
					"content": "Albedo! Chúng tôi về rồi này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120102,
					"content": "Ây da, có khách sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120103,
						412120104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120103,
					"content": "Trông quen quá.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120105
					]
				},
				{
					"id": 412120105,
					"content": "Bảo người mới lên núi tuyết mạo hiểm có lẽ hơi gấp gáp...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120106
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 412120106,
					"content": "Nhưng, mạo hiểm không phải là thử thách giới hạn của bản thân sao? Không gặp trắc trở, không có hành trình thúc đẩy thì còn thú vị gì nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120107
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 412120107,
					"content": "Ngay cả khi khu vực này đâu đâu cũng là Hilichurl hung ác và tuyết ngập đầu gối, các Nhà Mạo Hiểm cũng không được chùn bước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120108
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 412120108,
					"content": "Cyrus, nói vào trọng điểm nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120109
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120109,
					"content": "Ha ha ha, xem bạn kìa! Trò chuyện cũng như thám hiểm, điều quan trọng nằm ở quá trình, làm gì có trọng điểm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120110
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 412120110,
					"content": "Ừm! Bị cướp đến nỗi bỏ căn cứ, nhóm lửa nấu cơm trong băng tuyết!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120111
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 412120111,
					"content": "Cuộc hành trình trên núi tuyết là sự trải nghiệm vĩnh viễn không thể quên đối với những người mới trong Hiệp Hội Nhà Mạo Hiểm, ha ha ha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120112
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 412120112,
					"content": "Ừm, đúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120113
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120113,
					"content": "Cho dù ngay lúc này họ đang âm thầm oán trách, căm giận tôi, thì sau này cũng sẽ cảm ơn tôi vì những hồi ức này, đây gọi là sự kế thừa của việc mạo hiểm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120114
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 412120114,
					"content": "Ừ, bạn nói tiếp đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120115
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120115,
					"content": "Wow... Bệnh cũ của Albedo tái phát rồi, đối với những thứ không hứng thú thì lại lạnh lùng ghê...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120116,
					"content": "Xem ra anh ấy chẳng có hứng thú gì mấy về Nhà Mạo Hiểm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120117
					]
				},
				{
					"id": 412120117,
					"content": "Phải không? Tôi thấy anh ấy rất có hứng thú với bạn đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120118,
					"content": "Nhưng mà, điều đáng nói là người mới quá yếu hay do núi tuyết quá mạnh nhỉ? Lần này tổn thất vô cùng nặng nề...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120119
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 412120119,
					"content": "Vì sao tổn thất vô cùng nặng nề?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120120,
					"content": "Ồ...! Bạn là...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120121
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 412120121,
					"content": "Xin chào, ngài Cyrus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120122
					]
				},
				{
					"id": 412120122,
					"content": "Đã lâu không gặp!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120123,
					"content": "#A! Nhà Mạo Hiểm trẻ tuổi và bạn đồng hành của {M#anh ấy}{F#cô ấy}, rất vui được gặp các bạn ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120124
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 412120124,
					"content": "Mong là ngọn núi giá rét này không đem lại quá nhiều phiền phức cho các bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120125
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 412120125,
					"content": "Những thứ ứng phó được thì không phải phiền phức!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120126,
					"content": "Ha ha ha, đúng vậy! Tôi thích cách nói chuyện tự tin của bạn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120127
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 412120127,
					"content": "Cố ý đội mưa gió đến đây là vì có việc không thể không làm sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120128
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 412120128,
					"content": "#Tôi đến đây thu thập dữ liệu mới nhất về Hilichurl, ủy thác {M#anh ấy}{F#cô ấy} làm trợ lý của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120129,
						412120130
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120129,
					"content": "(Hả? Là vậy sao?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120131
					]
				},
				{
					"id": 412120131,
					"content": "Thì ra là thế, đều là những người theo đuổi ước mơ tụ họp ở đây vì lý tưởng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120132
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 412120132,
					"content": "Vậy chúc các bạn hoàn thành kế hoạch thuận lợi. Tôi phải đi xem thử đám người mới, tạm biệt nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120201
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 412120201,
					"content": "Hừm, hình như tôi phát hiện được gì đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120202,
					"content": "Albedo giấu Cyrus đó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120203
					]
				},
				{
					"id": 412120203,
					"content": "Dù sao cũng là ma kiếm, không muốn để người Mondstadt khác biết cũng là chuyện hợp tình hợp lý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120204,
					"content": "Tôi nghe cả rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120205
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120205,
					"content": "Có phải tôi không nên hỏi không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120206
					]
				},
				{
					"id": 412120206,
					"content": "Không có nên hay không nên gì cả. Chuyện mà bạn muốn biết, tôi đều sẽ nói.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120207
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120207,
					"content": "Nhưng không phải bây giờ. Giờ tôi còn có chuyện quan trọng phải làm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120208
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120208,
					"content": "Phải làm? Hừm, nói là làm chuyện của mình, nhưng tôi đoán... bạn cũng không bỏ qua chúng tôi đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120209,
					"content": "Paimon càng ngày càng thông minh rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120210
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120210,
					"content": "Xời, còn phải nói!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120211,
					"content": "Tôi phát hiện một số khu vực mới, chủng loại quái vật khác nhau ở đó sẽ cho tôi rất nhiều dữ liệu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120212
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120212,
					"content": "Bạn thật có hứng thú với việc thí nghiệm nhỉ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120213
					]
				},
				{
					"id": 412120213,
					"content": "Thí nghiệm thì cần phải có nghị lực mới thành công được. Đối với nhà giả kim mà nói, kiên trì là tố chất cơ bản cần có.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120214
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120214,
					"content": "Chuẩn bị xong chưa? Đi thôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120130,
					"content": "(Hình như anh ấy không muốn để người khác biết chuyện về thanh kiếm.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120131
					]
				},
				{
					"id": 412120104,
					"content": "Có phải tôi đã gặp qua rồi không?",
					"roleType": "TALK_ROLE_PLAYER",
