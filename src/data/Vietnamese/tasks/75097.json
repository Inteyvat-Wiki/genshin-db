			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750970101,
					"content": "Hửm? Tôi cứ cảm thấy Thất Thiên Thần Tượng ở Natlan có gì đó lạ lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970102,
					"content": "Lần đầu tiên chạm vào tượng thần, không phải là một cảm giác mạnh mẽ như... \"vù\" một phát sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970103,
						750970105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970103,
					"content": "Tôi thấy cũng ổn mà?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750970104
					]
				},
				{
					"id": 750970104,
					"content": "Nhưng đúng là hơi lạ thật...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970108,
					"content": "Hmm, để tôi nghĩ xem nên nói thế nào nhỉ. Tôi cảm thấy trước đây khi chạm vào tượng thần khác thì sẽ tạo ra được mối liên kết vững chắc hơn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970109,
					"content": "Lần này thì cảm giác như chạm phải công tắc gì đó ấy, chạm vào là nó sáng lên vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970110,
					"content": "#À đúng rồi, lúc trước {NICKNAME} chạm vào tượng thần là có thể cảm nhận được sức mạnh nguyên tố mà. Còn lần này thì sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970111,
					"content": "Có cảm giác sôi nổi hay mãnh liệt gì đó của nguyên tố Hỏa không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970112,
						750970113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970112,
					"content": "(Cảm nhận kỹ bên trong cơ thể mình...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750970114
					]
				},
				{
					"id": 750970114,
					"content": "Hả, không có chút nào sao...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970115,
					"content": "Cứ cảm thấy có gì đó kỳ lạ nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970113,
					"content": "(Không có cảm giác bùng cháy như mong đợi...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750970114
					]
				},
				{
					"id": 750970105,
					"content": "Thật ra âm thanh \"vù\" trước đây là do tôi phát ra đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750970106
					]
				},
				{
					"id": 750970106,
					"content": "Ra thế! Thế lần này quên \"vù\" rồi đấy, lần sau nhớ chú ý nhé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970107,
					"content": "Nhưng tốt nhất là mỗi lần chạm vào Thất Thiên Thần Tượng đều phải tự lồng tiếng đi nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970108
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
