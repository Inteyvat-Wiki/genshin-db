				"points": []
			},
			"dialogs": [
				{
					"id": 750970201,
					"content": "#...Hmm, thấy không quen lắm. Bây giờ {NICKNAME} vẫn không thể nhận được sức mạnh nguyên tố từ Thất Thiên Thần Tượng sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970202,
					"content": "Chậc, rốt cuộc Thất Thiên Thần Tượng gặp phải vấn đề gì nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970203,
						750970206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970203,
					"content": "Chắc là do nhiều năm không được tu sửa đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750970204
					]
				},
				{
					"id": 750970204,
					"content": "Nhưng rõ ràng là lúc chạm vào có phát sáng mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970205,
					"content": "Này, Thất Thiên Thần Tượng... Có đang làm việc chăm chỉ không đấy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970208,
					"content": "Chịu, chẳng có chút manh mối nào hết...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970206,
					"content": "Có lẽ là do Natlan tương đối đặc biệt chăng...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750970207
					]
				},
				{
					"id": 750970207,
					"content": "Kể ra thì hình như Natlan luôn phải chịu ảnh hưởng từ Vực Sâu... Chẳng lẽ là do chuyện này à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970208
					],
					"speakerTitle": "Paimon"
				}
			]
		},
