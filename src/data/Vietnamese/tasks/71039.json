			"dialogs": [
				{
					"id": 710390101,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390102,
						710390103
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710390102,
					"content": "Xin chào Jinwu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390104
					]
				},
				{
					"id": 710390104,
					"content": "...?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390105
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710390105,
					"content": "Ôi, giật cả mình!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710390106,
					"content": "Xin... xin lỗi. Nếu hai người muốn tìm Zhiqiong thì... Zhiqiong đã rời đội rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390107,
						710390109
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710390107,
					"content": "Cô ấy đi đâu vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390108
					]
				},
				{
					"id": 710390108,
					"content": "Tôi không biết... chỉ sơ suất một chút là không thấy con bé đâu nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390112
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710390112,
					"content": "Tôi đã nói chuyện với con bé rồi... Con bé vẫn nhất quyết muốn đi. Có nói gì hay làm gì cũng không giữ được con bé lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390113
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710390113,
					"content": "Haiz... Mong là con bé biết mình đang làm gì. Mong là vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390114
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710390114,
					"content": "Mong là vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390115
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710390115,
					"content": "Đúng rồi, chuyện này nhất định phải nói với Muning. Để anh ấy tổ chức một đội tìm kiếm cứu hộ, tìm thấy con bé càng sớm càng tốt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390116,
						710390117
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710390116,
					"content": "Chúng tôi sẽ đi tìm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390118
					]
				},
				{
					"id": 710390118,
					"content": "Thiệt tình... không biết đi đâu mất tiêu! Chúng ta mau lên mặt đất tìm Muning đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710390117,
					"content": "Cô cứ yên tâm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390118
					]
				},
				{
					"id": 710390109,
					"content": "Lúc đi trông cô ấy thế nào?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390110
					]
				},
				{
					"id": 710390110,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390111
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710390111,
					"content": "Khedive đã kiểm tra cho con bé rồi, tình trạng không ổn chút nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390112
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710390103,
					"content": "Cô vẫn khỏe chứ!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390104
					]
				}
			]
		},
		{
			"id": 7103902,
			"completionStepIds": [
				7103903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103903",
							"2"
						],
						"stepId": 7103903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
