			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Muning",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710390201,
					"content": "Hở? Zhiqiong không đi cùng bạn sao? Thư giới thiệu của Tổng Vụ đã đến rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390202
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710390202,
					"content": "Bởi vì tấm bản đồ con bé vẽ đã giúp ích rất nhiều cho Huy Sơn Đình, nên Tổng Vụ đã đặc cách thuê con bé làm... ừm, để tôi xem... cố vấn hướng dẫn, huởng đặc quyền như nhân viên chính thức.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390203
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710390203,
					"content": "Chúc mừng Zhiqiong, việc chạy vòng vòng trước đây đúng là không vô ích.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390204
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710390204,
					"content": "Cô ấy đã nghỉ việc.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390205
					]
				},
				{
					"id": 710390205,
					"content": "Nghỉ việc? Là sao...? Con bé đi rồi sao? Nhưng Thiên Nham Quân không hề nói với tôi là có ai đó rời khỏi Vực Đá Sâu cả...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390206
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710390206,
					"content": "Zhiqiong đã rời đội thăm dò.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390207
					]
				},
				{
					"id": 710390207,
					"content": "Hả? Ồ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390208
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710390208,
					"content": "Khoan đã! Khoan đã!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390209
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710390209,
					"content": "Không đúng không đúng... Bạn nói, con bé, đã rời khỏi đội thăm dò?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390210
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710390210,
					"content": "Zhiqiong, nghỉ việc rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390211
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710390211,
					"content": "Đúng vậy! Anh nghe không hiểu chỗ nào à!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710390212,
					"content": "...Tôi hiểu rồi, tôi sẽ tổ chức một đội tìm kiếm cứu hộ ngay lập tức. Nếu con bé vẫn ở Vực Đá Sâu, có lẽ chúng ta vẫn có thể tìm thấy con bé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390213
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710390213,
					"content": "Cho dù con bé có nông nỗi hay do nguyên nhân gì khác... thì cũng phải tìm cho ra con bé mới được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390214
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710390214,
					"content": "Với tình trạng hiện tại của con bé, rời khỏi đội và tự ý hành động thật chẳng ra làm sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390215,
						710390217
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710390215,
					"content": "Cần tôi giúp gì không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390216
					]
				},
				{
					"id": 710390216,
					"content": "Xin lỗi, lần này không cần phiền bạn giúp nữa... Tôi cũng phải có ích một chút chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390233
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710390233,
					"content": "Nếu cần tôi giúp gì thì cứ nói nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390234
					]
				},
				{
					"id": 710390234,
					"content": "Ừm ừm, tôi cũng vậy! Không thể bỏ mặc cô ấy được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390235
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710390235,
					"content": "Trên đường đi chúng ta cũng hãy chú ý hơn, nói không chừng có thể gặp được cô ấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710390217,
					"content": "Về Zhiqiong...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390218
					]
				},
				{
					"id": 710390218,
					"content": "Con bé là một người không yên phận, nhưng dù thế nào chúng tôi cũng là bạn bè. Tôi biết tôi không dễ gần... nhưng tôi không thể tùy tiện quên đi những người bạn của mình được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390219
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710390219,
					"content": "Con bé luôn mơ ước được làm nhà mạo hiểm gì đó, trước đó đã bị thương không biết bao nhiêu lần... thậm chí còn suýt mất mạng. Sau đó không dễ dàng gì mới yên ổn được một thời gian...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390220
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710390220,
					"content": "Tôi đã nghĩ là con bé đã từ bỏ giấc mơ viển vông của mình... Trở thành người như Roald, Stanley đâu có dễ chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390221
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710390221,
					"content": "Haiz... Nhưng thật không ngờ... Có lẽ lần này tôi không nên giới thiệu bạn đến khám phá Vực Đá Sâu, nếu không cũng không đến nỗi làm bùng lên ngọn lửa trong lòng Zhiqiong rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390222,
						710390226
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710390222,
					"content": "Nhưng sự cố gắng của cô ấy không hề vô ích.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390223
					]
				},
				{
					"id": 710390223,
					"content": "Không vô ích...? Bạn nói vậy quá thực dụng. Bản đồ dưới lòng đất mà con bé vẽ quả thực rất hữu ích, nhưng mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390224
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710390224,
					"content": "Đặt \"mơ ước\" viển vông và hành động theo đuổi nó lên trên cả mạng sống của mình...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390225
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710390225,
					"content": "Dù thế nào tôi cũng không thể hiểu nổi, tôi cũng không nghĩ là sẽ có người thực sự đặt bản thân vào tình thế nguy hiểm như thế này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390232
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710390232,
					"content": "Vì vậy, việc tìm cô ấy cứ để tôi... Ừm, ý tôi là, cứ giao cho đội tìm kiếm cứu hộ của Thiên Nham Quân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390233
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710390226,
					"content": "Nhưng đây là lựa chọn của cô ấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390227
					]
				},
				{
					"id": 710390227,
					"content": "Lựa chọn, lựa chọn... đó chỉ là cái cớ! Con bé đang tự tìm cái chết, bạn không nhận thấy hay sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390228
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710390228,
					"content": "Hmm... xin lỗi, tôi hơi nặng lời. Nhưng... đối mặt với tình huống mà con người chúng ta không thể thay đổi... con bé nên kiên nhẫn hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390229
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710390229,
					"content": "Chờ thêm... Hai ba mươi năm nữa, có thể chỉ cần mười năm, không chừng con bé có thể đợi đến khi việc phát triển các thiết bị an toàn hơn dưới hầm mỏ được hoàn thành? Đến lúc đó con bé cũng không phải vội vàng thăm dò bản đồ dưới lòng đất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390230
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710390230,
					"content": "Nhưng con bé không muốn chờ đợi... chỉ muốn nhân lúc bản thân còn trẻ hoàn thành thành tựu mà người khác phấn đấu cả một đời!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390231
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710390231,
					"content": "Thật là ngu ngốc... thân là bạn bè, tôi không thể bỏ mặc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390232
					],
					"speakerTitle": "Muning"
				}
			]
		}
	]
}