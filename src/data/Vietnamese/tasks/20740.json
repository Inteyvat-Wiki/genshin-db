					"content": "Về những bông hoa đó...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207400402
					]
				},
				{
					"id": 207400402,
					"content": "Bạn đã hái được hoa chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400403
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207400403,
					"content": "Đều hái được rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207400404
					]
				},
				{
					"id": 207400404,
					"content": "Những bông hoa rất tươi... cảm ơn bạn, chỗ hoa này bày bên ngoài tiệm, chắc chắn có thể thu hút rất nhiều khách đến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400405
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207400405,
					"content": "Tiếp theo, tôi còn một thỉnh cầu nho nhỏ... chả là khi gió thổi, những bông hoa bồ công anh trong tiệm cũng đều bị thổi bay đi mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400406
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207400406,
					"content": "Mặc dù hạt bồ công anh bị gió thổi không phải là chuyện xấu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400407
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207400407,
					"content": "Nhưng tiệm hoa trong thành Mondstadt mà không có bồ công anh, cảm giác có chút gì đó chẳng nói lên lời.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400408
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207400408,
					"content": "Bồ công anh không thể hái mang về trực tiếp, mà phải trồng nó từ đầu mới được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400409
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207400409,
					"content": "Vì vậy, bạn có thể giúp tôi đi tìm một ít hạt bồ công anh không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400410,
						207400412
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207400410,
					"content": "Được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207400411
					]
				},
				{
					"id": 207400411,
					"content": "Vậy thì nhờ vào bạn cả đấy, tôi nhớ ở ngoài thành Mondstadt có rất nhiều bồ công anh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				},
				{
					"id": 207400412,
					"content": "Hái ở đâu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207400413
					]
				},
				{
					"id": 207400413,
					"content": "Bên ngoài thành Mondstadt có rất nhiều bồ công anh, rất dễ tìm thấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				}
