			"dialogs": [
				{
					"id": 730270401,
					"content": "Cuối cùng mọi chuyện cũng đã kết thúc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270402,
					"content": "Nói ra thì, đúng là một chuyến phiêu lưu dài.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270403,
						730270406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270403,
					"content": "Nếu nói cho Jazari nghe thì...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730270404
					]
				},
				{
					"id": 730270404,
					"content": "Đúng vậy, nếu anh ấy biết chuyện của tâm lõi thì có thể sẽ giúp chúng ta xin kinh phí gì đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270405,
					"content": "#Nhưng tôi không muốn vào Giáo Viện đâu. {NICKNAME}, bạn cũng vậy mà đúng không!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270409,
					"content": "Tóm lại, mặc dù không biết \"hóa thân của Marana\" có liên quan gì tới đám Giáo Đoàn Vực Sâu này, nhưng chữa khỏi \"căn bệnh\" của rừng sâu cũng là chuyện tốt rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270410,
					"content": "Huhuhu, Ararycan cảm ơn các bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270411
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730270411,
					"content": "Đừng khách sáo, Ararycan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730270412
					]
				},
				{
					"id": 730270412,
					"content": "Nhưng tiếp theo thì Ararycan tính làm gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270413,
					"content": "Ararycan muốn tham gia Lễ Hội Utsava, nhưng Ararycan rất lo cho \"căn bệnh\" của rừng sâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270414
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730270414,
					"content": "Cũng có thể những kẻ khiến khu rừng bị bệnh sẽ trở lại, Ararycan muốn bảo vệ rừng sâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270415
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730270415,
					"content": "Thế nên sau khi Lễ Hội Utsava hoàn thành, Ararycan sẽ quay về đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270416
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730270416,
					"content": "Aranara cũng vất vả nhiều rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730270417
					]
				},
				{
					"id": 730270417,
					"content": "Nếu Ararycan cần giúp đỡ thì nhất định phải tới tìm chúng tôi đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270418,
					"content": "Ừm ừm, Ararycan biết rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270419
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730270419,
					"content": "Hì hì, phải chăm sóc bản thân cho tốt nhé, chúng ta nhất định sẽ gặp lại nhau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270406,
					"content": "Nếu kể cho ông Royinjan nghe thì...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730270407
					]
				},
				{
					"id": 730270407,
					"content": "Đúng vậy, ông Royinjan chắc chắn sẽ nói \"Đúng là một câu chuyện thú vị.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270408,
					"content": "Ai mà ngờ chúng ta thật sự đã cứu lấy khu rừng chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270409
					],
					"speakerTitle": "Paimon"
				}
			]
