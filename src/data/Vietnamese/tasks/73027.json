			"dialogs": [
				{
					"id": 730270201,
					"content": "Ơ, Ararycan, sao bạn lại ở đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270202,
					"content": "Sau khi Ararycan trồng hoa xong đã đứng đây chờ các bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270203
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730270203,
					"content": "Sau đó chẳng biết tại sao đột nhiên có thứ gì đó rơi xuống từ trên núi sắt lớn, suýt nữa đập trúng Ararycan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270204
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730270204,
					"content": "Ôi, xin lỗi Ararycan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270205,
					"content": "Tại sao Paimon phải xin lỗi, Ararycan không sao, Ararycan chạy rất nhanh nên sẽ không bị rớt trúng đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270206
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730270206,
					"content": "Tóm lại bạn không sao là tốt rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730270207
					]
				},
				{
					"id": 730270207,
					"content": "Xem ra cánh tay gãy của người máy khổng lồ đã đập bể lối vào di tích dưới lòng đất. Cuối cùng cũng có chút tác dụng rồi nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270208,
					"content": "Vậy chúng ta xuống dưới xem thử đi, không biết sẽ có những thứ xấu xa nào đang chờ đợi chúng ta nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270209,
					"content": "Ararycan sẽ đi cùng các bạn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ararycan"
				}
			]
		},
		{
