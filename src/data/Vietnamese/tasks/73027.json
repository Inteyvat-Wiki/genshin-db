			"dialogs": [
				{
					"id": 730270301,
					"content": "Thứ phát sáng bên trong hẳn là Trái Tim Hỗn Độn của tên khổng lồ bên trên mà Jazari đã nói.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270302,
					"content": "Tuy trông như bị mớ dây leo và cành cây phong ấn, nhưng hình như bên trong có thứ gì đó đang chảy ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270303,
					"content": "Huhu, là thứ bẩn thỉu, Ararycan có thể cảm giác được, chính nó đã khiến rừng sâu bị bệnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270304
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730270304,
					"content": "Ấy, có rất nhiều Pháp Sư Vực Sâu đang làm gì đó bên mấy cành cây lớn, cảm giác như không phải là chuyện tốt đẹp gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270305,
					"content": "Tôi nhớ Jazari từng nói, phong ấn của tâm lõi đã bị phá hỏng, chẳng lẽ là do đám Pháp Sư Vực Sâu này giở trò sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270306,
					"content": "Dù sao thì Ararycan nấp đi, chúng tôi sẽ ngăn cản chúng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
