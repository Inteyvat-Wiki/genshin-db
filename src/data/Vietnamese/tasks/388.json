					"nextDialogs": [
						3880304
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3880304,
					"content": "Chắc là do Giáo Đoàn Vực Sâu thao túng đằng sau, nhưng bọn chúng không thể biết chắc chúng ta sẽ đến đây.",
