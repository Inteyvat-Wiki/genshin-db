				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708140501,
					"content": "Í? Bạn đã về rồi, hoàn thành ủy thác rồi à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140502
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140502,
					"content": "Đã hoàn thành rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140503
					]
				},
				{
					"id": 708140503,
					"content": "Bạn lợi hại thật... Vừa nãy tôi dựa theo tiêu chuẩn uỷ thác đó, trở về Hiệp Hội Nhà Mạo Hiểm để sắp xếp lại uỷ thác một chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140504
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140504,
					"content": "Có một đống uỷ thác như dọn dẹp ma vật, thì ra bình thường Nhà Mạo Hiểm đều đang làm cái này à...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140505
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140505,
					"content": "Nhưng ngoài dọn dẹp ma vật ra, còn có báo cáo nói rằng, có rất nhiều Đạo Bảo Đoàn đang trấn giữ trên đường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140506
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140506,
					"content": "Cái này cũng để Nhà Mạo Hiểm xử lý à? Cảm giác giống với chức trách của Thiên Nham Quân hơn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140507,
						708140509
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140507,
					"content": "Có thể đưa Nhà Mạo Hiểm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140508
					]
				},
				{
					"id": 708140508,
					"content": "Vậy à, Nhà Mạo Hiểm quả là việc gì cũng có thể làm được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140511
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140511,
					"content": "Vậy thì, tôi sẽ chuẩn bị thù lao xứng đáng với bạn, uỷ thác này cũng phiền bạn rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140512
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140512,
					"content": "Sao còn có uỷ thác thêm vào bất chợt vậy! Lúc trước không có...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708140513,
					"content": "Sẽ có thêm thù lao đó! Tôi đã nói với Lan rồi, chỉ cần các bạn hoàn thành uỷ thác, sẽ có thêm nhiều thù lao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140514
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140514,
					"content": "Vậy còn tạm được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140515
					]
				},
				{
					"id": 708140515,
					"content": "Vậy nhờ vào bạn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140516
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140516,
					"content": "Vậy thì, một lần sẽ phân bổ được hai uỷ thác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140517
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140517,
					"content": "\"Bí quyết khiến Nhà Mạo Hiểm ngoan ngoãn tiếp nhận uỷ thác\" mà Lan nói với tôi quả là hữu dụng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140509,
					"content": "Chỉ cần thù lao xứng đáng...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140510
					]
				},
				{
					"id": 708140510,
					"content": "Nhà Mạo Hiểm lợi hại thật đó... quả là việc gì cũng có thể làm được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140511
					],
					"speakerTitle": "Tiantian"
				}
			]
		},
