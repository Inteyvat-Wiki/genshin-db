			"dialogs": [
				{
					"id": 708140201,
					"content": "Sao vậy, còn có việc gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140202
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 708140202,
					"content": "Bạn tìm thấy thanh kiếm kia chưa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140203
					]
				},
				{
					"id": 708140203,
					"content": "...Hóa ra bạn còn nhớ, rất đáng tiếc, vẫn chưa có bất cứ manh mối nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140204
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 708140204,
					"content": "Xem ra, tôi vẫn đang mò kim đáy bể.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140205
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 708140205,
					"content": "Nếu có uỷ thác nào liên quan đến việc này, chưa biết chừng tôi sẽ tìm bạn đó, tới lúc ấy lại phải nhờ vào bạn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140206
					],
					"speakerTitle": "Lan"
				}
			]
		},
		{
			"id": 7081403,
			"completionStepIds": [
				7081401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
