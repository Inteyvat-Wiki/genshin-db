					"Tiantian"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708140301,
					"content": "Là, là Nhà Mạo Hiểm à? Bạn đến nhận uỷ thác sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140302
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140302,
					"content": "A... Bạn, bạn chờ một lát, tôi tìm xem, uỷ thác chỗ tôi có \"Đua tốc độ Phong Chi Dực\", \"Hướng dẫn trải nghiệm sinh tồn nơi hoang dã\", còn cả \"Hướng dẫn leo núi tự do\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140303
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140303,
					"content": "Hoàn toàn khác với Hiệp Hội Nhà Mạo Hiểm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140304
					]
				},
				{
					"id": 708140304,
					"content": "Tôi biết rồi! Lan cũng nói vậy, nhưng tôi thấy những \"Mạo hiểm\" trong sách chẳng phải đều như vậy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140305
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140305,
					"content": "Không phân bổ những uỷ thác này, thì biết phân bổ cái gì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140306
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140306,
					"content": "Ví dụ, dạng như dọn dẹp ma vật...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140307
					]
				},
				{
					"id": 708140307,
					"content": "Vậy, vậy cũng quá nguy hiểm rồi, mặc dù ngoại ô Li Sa đúng là có rất nhiều ma vật, lại hay đe doạ người đi đường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140308
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140308,
					"content": "Nhưng, người bình thường chắc chắn không thể đối phó với chúng, chưa biết chừng còn bị thương...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140309,
						708140311
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140309,
					"content": "Cứ giao cho tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140310
					]
				},
				{
					"id": 708140310,
					"content": "Được không, vậy... phiền bạn rồi, lát nữa tôi sẽ về bàn bạc với Lan về mức thù lao xứng đáng với bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140311,
					"content": "Nhà Mạo Hiểm không phải người bình thường đâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140312
					]
				},
				{
					"id": 708140312,
					"content": "Vậy sao... vậy... phiền bạn rồi, lát nữa tôi sẽ về bàn bạc với Lan về mức thù lao xứng đáng với bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tiantian"
				}
			]
		},
