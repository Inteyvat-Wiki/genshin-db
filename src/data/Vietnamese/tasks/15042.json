			"dialogs": [
				{
					"id": 150421401,
					"content": "Bây giờ cảm thấy thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421402,
						150421404,
						150421406
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421402,
					"content": "Cũng khá thoải mái.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421403
					]
				},
				{
					"id": 150421403,
					"content": "#Mạnh miệng nhỉ. Nhưng tôi thấy {F#cô}{M#cậu} đúng là đã thể hiện rất tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421408
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421408,
					"content": "Nói không chừng tôi cũng có thể góp ý cho nhân viên ở đây, để sau này họ vận hành ngày một tốt hơn đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421409
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421409,
					"content": "Dù thế nào đi nữa thì ít nhất họ cũng nên để hai tuyển thủ phân cao thấp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421404,
					"content": "Hoa cả mắt rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421405
					]
				},
				{
					"id": 150421405,
					"content": "Haha, tập trung tinh thần đúng là một việc rất hao tổn thể lực.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421408
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421406,
					"content": "Khá thú vị.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421407
					]
				},
				{
					"id": 150421407,
					"content": "Vậy sao? Xem ra chúng ta đã đưa ra ý kiến giống nhau rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421408
					],
					"speakerTitle": "Chasca"
				}
			]
		},
