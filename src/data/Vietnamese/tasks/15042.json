			"dialogs": [
				{
					"id": 150420101,
					"content": "Woohoo!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420102
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420102,
					"content": "Ánh nắng! Sóng biển! Koholasaur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420103
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420103,
					"content": "Cô ấy kích động đến mức quên mất Tên Cổ của mình là \"Umo{RUBY#[S]Đoàn Kết}ja\" đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150420104,
					"content": "Mau đến đây, bên này! Nào, mau lên, chạy đi nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420105
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420105,
					"content": "Chúng tôi đến ngay đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420106
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150420106,
					"content": "Nhìn xem! Đây là gì này?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420107
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420107,
					"content": "Tấm gỗ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150420108,
					"content": "Đọc chữ cơ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420109
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420109,
					"content": "Ồ, là bản đồ tham quan à.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150420110,
					"content": "Bản đồ tham quan! Giá trị của nó không thua gì chìa khóa kho báu đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420111
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420111,
					"content": "Tôi hiểu rồi, đều là tượng trưng cho sự bắt đầu của cuộc mạo hiểm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420112
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150420112,
					"content": "Hoặc cũng có thể ví với Hạt Giống Phlogiston cháy rực, đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420113
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420113,
					"content": "Phlogiston? À... Hình như là một loại năng lượng phải không? Ý là... chỉ cần nhìn một cái thì sẽ có nguồn động lực bất tận sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420114
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150420114,
					"content": "Đúng thế! Hơn nữa, nó còn rất quan trọng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420115
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420115,
					"content": "Có bản đồ là có thể xem bất cứ lúc nào, mỗi người đều có thể tự tìm ra con đường mạo hiểm tự do của mình!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420116
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420116,
					"content": "Woa, tự do! Mạo hiểm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420117
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150420117,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420118
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150420118,
					"content": "Khoan đã... Đừng vội vàng đồng ý. Sao tôi thấy lời nói của Mualani dường như còn có ý khác vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150420119,
					"content": "Bây giờ thì... giải tán thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420120
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420120,
					"content": "Làm gì có người dẫn đường nào cứ vừa tới địa điểm tham quan là giải tán tại chỗ như cô chứ!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420121,
						150420122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150420121,
					"content": "Hay là Mualani muốn chơi một mình?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150420123
					]
				},
				{
					"id": 150420123,
					"content": "Đúng là bạn tốt của tôi. Tôi sẽ ghi nhớ những lời nói đỡ này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420124
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420124,
					"content": "Mọi người nhìn kỹ nhé. Bên cạnh hai hạng mục giải trí cỡ lớn này đều có chữ \"đang thử nghiệm\", có lẽ là đã gặp phải rắc rối gì đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420125
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420125,
					"content": "Hay là chúng ta chia nhau ra tìm hạng mục mà mình hứng thú đi. Vừa trải nghiệm vừa giúp thử nghiệm luôn, nói không chừng còn giúp Vịnh Sóng Vỗ sớm được đưa vào vận hành đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420126
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420126,
					"content": "Tôi còn tưởng là cứ liên quan đến các hạng mục trên nước là Mualani sẽ mặc kệ chúng tôi luôn chứ! Ra là cô vẫn còn nhiệt tình...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150420127,
					"content": "Hihi, khi hoàn thành xong thì cùng tụ họp ở gần tòa nhà Koholasaur khổng lồ kia nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420128
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420128,
					"content": "Theo kinh nghiệm dẫn đường nhiều năm của tôi thì lối vào thử thách chính của khu vực chắc ở gần đó thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420129
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420129,
					"content": "Được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420130
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150420130,
					"content": "Vậy giải tán nhé, nhớ để ý bản đồ thường xuyên đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420122,
					"content": "Hiểu rồi, hôm nay người dẫn đường cũng đang nghỉ phép...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150420123
					]
				}
			]
		},
		{
			"id": 1504213,
