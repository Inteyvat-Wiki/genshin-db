			"dialogs": [
				{
					"id": 150421501,
					"content": "Tốt lắm, điểm danh nhân sự nào... Một, hai, ba, bốn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421502
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421502,
					"content": "Ủa, có thêm một người nữa sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421503
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421503,
					"content": "Các vị muốn tham gia mục khiêu chiến chính của Vịnh Sóng Vỗ sao? Nhưng bên chỗ chúng tôi lại xảy ra chút chuyện...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421504
					],
					"speakerTitle": "Tuksina"
				},
				{
					"id": 150421504,
					"content": "Nếu muốn hoàn thành nhiệm vụ của album kỷ niệm và chụp ảnh thì bây giờ tôi có thể chụp ảnh giúp các vị...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421505
					],
					"speakerTitle": "Tuksina"
				},
				{
					"id": 150421505,
					"content": "Không... Như vậy không đúng đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421506
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421506,
					"content": "Hình ảnh chỉ là một cách để lưu giữ kỷ niệm để sau này nhớ lại khoảnh khắc ấm áp thôi... Điều chúng tôi quan tâm vẫn là trải nghiệm của cả chuyến đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421507
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421507,
					"content": "Cô quên mất việc dùng tấm ảnh để đổi thưởng rồi kìa... Được rồi, tôi cũng đồng tình là chụp một tấm rồi đi luôn thì qua loa quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150421508,
					"content": "Tôi hiểu rồi, thật xin lỗi... Vậy có lẽ cần các vị chờ thêm rồi, chúng tôi sẽ cố gắng giải quyết...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421509
					],
					"speakerTitle": "Tuksina"
				},
				{
					"id": 150421509,
					"content": "Vậy phải đợi bao lâu nữa nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150421510,
					"content": "Chuyện này cũng khó nói trước được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421511
					],
					"speakerTitle": "Tuksina"
				},
				{
					"id": 150421511,
					"content": "Hả? Khó nói sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150421512,
					"content": "Nếu có chúng tôi giúp đỡ thì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421513
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421513,
					"content": "Chuyện này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421514
					],
					"speakerTitle": "Tuksina"
				},
				{
					"id": 150421514,
					"content": "Tôi thấy không có nhiều nhân viên ở các hạng mục khác của Vịnh Sóng Vỗ, trạng thái của các Saurian cũng đang mệt mỏi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421515
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421515,
					"content": "Hẳn là do \"hạng mục khiêu chiến chính\" gặp vấn đề, nên đã điều động hết nhân lực để cùng tu sửa nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421516
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421516,
					"content": "Đừng căng thẳng, tôi cũng hiểu là tình hình nội bộ không tiện tiết lộ, nên không có ý làm khó cô đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421517
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421517,
					"content": "Ngược lại, chúng tôi thì khá giỏi đấy, lại còn thích giúp đỡ người khác nữa. Chúng tôi vừa hoàn thành Du Thuyền Hoàng Hôn và Asha Tốc Độ xong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421518
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421518,
					"content": "Nếu cô chia sẻ những vấn đề nan giải thì mọi chuyện sẽ được giải quyết nhanh thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421519
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421519,
					"content": "Woa, cô ấy nói chuyện đâu ra đấy. Đây chính là thực lực của người hòa giải sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150421520,
					"content": "Chasca... Cô quan sát như thế nào vậy? Chắc không phải ngồi trên cành cây từ xa nhìn trộm chúng tôi đấy chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421521
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421521,
					"content": "...Đó là trọng tâm sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421522
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421522,
					"content": "À, trọng tâm là... chúng tôi rất giỏi chi viện và hỗ trợ đấy! Gặp vấn đề thì đương nhiên cần mọi người cùng góp sức rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421523
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150421523,
					"content": "Không ngờ quý khách có thể nói chính xác trạng thái của các Saurian nữa... Thật ngại quá, tôi không nên giấu các vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421524
					],
					"speakerTitle": "Tuksina"
				},
				{
					"id": 150421524,
					"content": "Tình hình là như thế này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421525
					],
					"speakerTitle": "Tuksina"
				},
				{
					"id": 150421525,
					"content": "Khi thử nghiệm thì chúng tôi phát hiện Đường Trượt Lấp Lánh vẫn còn nhiều chỗ tô màu chưa đúng. Vì phải phun sơn lên Đường Linh Hồn nên độ khó thi công rất cao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421526
					],
					"speakerTitle": "Tuksina"
				},
				{
					"id": 150421526,
					"content": "Để không ảnh hưởng tới thời gian khai trương của khu nghỉ dưỡng, chúng tôi đành phải tạm đóng cửa các hạng mục đó để tranh thủ sửa chữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421527
					],
					"speakerTitle": "Tuksina"
				},
				{
					"id": 150421527,
					"content": "Haha... Vậy thì dễ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421528
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421528,
					"content": "Cứ cho tôi biết màu vẽ để ở đâu nhé. Tôi lướt một lượt là xong thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421529
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421529,
					"content": "Hả...? Cô ấy đang nói gì thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421530
					],
					"speakerTitle": "Tuksina"
				},
				{
					"id": 150421530,
					"content": "Chắc cô chưa từng gặp cô ấy nhỉ. Cô ấy chính là \"Umo{RUBY#[S]Đoàn Kết}ja\" Mualani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421531
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421531,
					"content": "Mualani... Đợi đã, Mualani...?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421532
					],
					"speakerTitle": "Tuksina"
				},
				{
					"id": 150421532,
					"content": "Ý cô là... Mualani, một trong sáu vị anh hùng đó sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tuksina"
				}
			]
		},
