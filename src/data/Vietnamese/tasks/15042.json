			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chasca"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 150421301,
					"content": "Ồ, tinh mắt đấy. Tôi đứng ở nơi cao thế này mà vẫn bị phát hiện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421302
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421302,
					"content": "#Xem ra {F#cô}{M#cậu} cũng có hứng thú với thiết bị ở đây nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421303,
						150421305
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421303,
					"content": "Nó thú vị không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421304
					]
				},
				{
					"id": 150421304,
					"content": "#Không tệ. Nhưng đây là ý kiến chủ quan, chưa chắc đúng, {F#cô}{M#cậu} phải đích thân thử qua mới được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421307
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421307,
					"content": "Có nhìn thấy đường ray đó không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421308
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421308,
					"content": "Dùng đạn màu để sơn màu cho quả cầu trên đó. Chỉ cần sơn cùng màu thì chúng sẽ bị \"xóa bỏ\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421309
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421309,
					"content": "Còn về việc \"xóa bỏ\"... Haha, có lẽ sẽ có một người khác cũng đang cầm súng để đánh bay những quả cầu đó đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421310,
						150421311
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421310,
					"content": "Thật lợi hại...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421312
					]
				},
				{
					"id": 150421312,
					"content": "Vậy thì chơi một ván xem sao? Cứ dùng khẩu súng đó là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421313
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421313,
					"content": "#Lần này tôi sẽ xem {F#cô}{M#cậu} chơi. Cố lên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421311,
					"content": "Nói đến mức tôi sắp tin luôn rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421312
					]
				},
				{
					"id": 150421305,
					"content": "Nó phức tạp lắm sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421306
					]
				},
				{
					"id": 150421306,
					"content": "Thư giãn nào. Đây là Khu Nghỉ Dưỡng Nhàn Nhã, là nơi xa rời với những từ ngữ như \"phức tạp\", \"khó khăn\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421307
					],
					"speakerTitle": "Chasca"
				}
			]
		},
