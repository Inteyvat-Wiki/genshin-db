			"dialogs": [
				{
					"id": 150421701,
					"content": "Vất vả rồi, Mualani!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150421702,
					"content": "Phù... Lần này xem như được chơi vui rồi. Thế nào? Tôi làm ổn lắm đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421703
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421703,
					"content": "Đẹp lắm. Không hổ danh là một trong sáu vị anh hùng của Natlan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421704
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150421704,
					"content": "Sau khi cô đi lướt ván thì Paimon đã kể cho tôi nghe rồi, ngưỡng mộ thật đó! Cả người tôi phấn khích như đang bùng cháy vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421705
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150421705,
					"content": "Haha, cảm ơn nhé. Nghe những lời khen như thế, làm tôi muốn tổ chức một bữa tiệc suối nước nóng tại đây luôn đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421706
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421706,
					"content": "Woa! Xem kìa, nhân viên Vịnh Sóng Vỗ đều tới cả rồi! Cố gắng lâu như vậy, chắc mọi người đều đang chờ đợi âm nhạc, tiệc tùng và phần thưởng rồi đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421707
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421707,
					"content": "Tôi thấy là cô hiểu sai ý rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421708
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421708,
					"content": "Sai ở đâu cơ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421709
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421709,
					"content": "Đại anh hùng Mualani, có thể cho tôi xin chữ ký không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421710
					],
					"speakerTitle": "Tuksina"
				},
				{
					"id": 150421710,
					"content": "Tôi cũng muốn nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421711
					],
					"speakerTitle": "Gaun"
				},
				{
					"id": 150421711,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421712
					],
					"speakerTitle": "Iktomisaurus Non"
				},
				{
					"id": 150421712,
					"content": "Xem ra không thể che giấu được rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421713
					]
				},
				{
					"id": 150421713,
					"content": "Nhanh nào, nhân lúc những người khác còn chưa đến, chúng ta tranh thủ chụp ảnh thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421714
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421714,
					"content": "Phải cười thật tươi, biểu cảm tự tin! Hãy nghĩ đến cảnh biển đẹp đẽ bên cạnh, và cả màu sắc may mắn của chính mình nữa nhé...",
