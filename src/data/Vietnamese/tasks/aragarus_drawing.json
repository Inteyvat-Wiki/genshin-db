			"dialogs": [
				{
					"id": 730580401,
					"content": "Chúng ta đi xem thử doanh trại của Nara xấu xa đi! Chắc sẽ biết được bọn họ tới đây để làm gì đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580402
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730580402,
					"content": "Làm sao để phân biệt được kẻ xấu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730580403
					]
				},
				{
					"id": 730580403,
					"content": "#Ừm... Không biết, không thể nói rõ được! Nhưng tôi biết Nara {NICKNAME} và Bông Trắng Bay Bay chắc chắn không phải là người xấu! Aragaru tin vào điều đó!",
					"roleType": "TALK_ROLE_NPC",
