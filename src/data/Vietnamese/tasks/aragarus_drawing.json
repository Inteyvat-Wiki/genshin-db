			},
			"dialogs": [
				{
					"id": 730580101,
					"content": "Nara Vàng, Bông Trắng Bay Bay! Lại gặp các bạn rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580102
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730580102,
					"content": "Ối, lần sau nếu đột nhiên xuất hiện thì nhớ lên tiếng trước nhé! Dọa tôi hết cả hồn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580103,
						730580104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730580103,
					"content": "Chúng tôi không phải là kẻ xấu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730580105
					]
				},
				{
					"id": 730580105,
					"content": "Hmm... Các bạn nói rất có lý... Thế nên, Nara Vàng, Bông Trắng Bay Bay trông không giống kẻ xấu, có thể giúp tôi thêm một việc được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580106
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730580106,
					"content": "#Rất sẵn lòng, tôi là {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730580107
					]
				},
				{
					"id": 730580107,
					"content": "Tôi là Paimon, lần này đừng quên đấy nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730580108,
					"content": "Lần này...? Ờm... khụ khụ, tôi là Aragaru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580109
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730580109,
					"content": "#Chúng tôi đã từng đến đây với bạn, nhưng bạn quên mất rồi... Haiz, thật khó giải thích! {NICKNAME}, chúng ta kể lại cho Aragaru nghe nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730580110,
					"content": "Các bạn kể lại chi tiết chuyến phiêu lưu cùng với Aragaru.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730580111
					]
				},
				{
					"id": 730580111,
					"content": "Vậy sao... Tuy tôi không nhớ ra, nhưng không biết vì sao, tôi bằng lòng tin tưởng các bạn... Hơn nữa các bạn còn có hoa mà tôi tặng, tôi có thể cảm nhận được sự tồn tại đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580112
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730580112,
					"content": "À, đúng rồi! Nara xấu xa đã để lại doanh trại ở đây, chúng ta hãy đi tìm xem bọn họ để lại thứ gì đi, nói không chừng có thể biết được họ đang bàn tính chuyện gì đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730580104,
					"content": "Chúng tôi đã giúp bạn đánh bại những kẻ xấu xa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730580105
					]
				}
			]
		},
		{
			"id": 7305802,
