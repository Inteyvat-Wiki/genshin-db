			"dialogs": [
				{
					"id": 730580201,
					"content": "Thế nào, có phát hiện gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580202
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730580202,
					"content": "Ờm... Chỉ phát hiện mấy chỉ thị không rõ ràng, còn có cái này! Một bông hoa khô!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730580203,
					"content": "Hả...! Cái này, có thể đưa cho tôi không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580204
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730580204,
					"content": "Đây là do kẻ xấu để lại, bạn không sợ có độc... hay gì đó sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730580205,
					"content": "Không cần phải lo, tôi đã từng thấy bông hoa này... Người đó có lẽ tôi cũng đã từng gặp... Xin hãy giao cho tôi, được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580206
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730580206,
					"content": "Vậy bạn cầm nó đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730580207
					]
				},
				{
					"id": 730580207,
					"content": "#Cảm ơn bạn! Nara {NICKNAME} và Bông Trắng Bay Bay!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580208
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730580208,
					"content": "Aragaru mang bông hoa khô đến Rừng Mawtiyima...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
