			"dialogs": [
				{
					"id": 740650101,
					"content": "#Ái chà! Đây không phải {NICKNAME} và Paimon sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650102,
						740650103
					],
					"speakerTitle": "Decembre"
				},
				{
					"id": 740650102,
					"content": "Chúng ta thân lắm à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650104
					]
				},
				{
					"id": 740650104,
					"content": "Đừng có lạnh lùng như thế mà. Chuyện lần trước tôi vẫn còn khắc ghi trong lòng đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650105
					],
					"speakerTitle": "Decembre"
				},
				{
					"id": 740650105,
					"content": "Chuyện lần trước... À! Chúng tôi còn rất nhiều thắc mắc muốn hỏi đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740650106,
					"content": "Thế, thế à? Mà lần trước là chuyện gì ấy nhỉ? Tôi không nhớ gì cả!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650107
					],
					"speakerTitle": "Decembre"
				},
				{
					"id": 740650107,
					"content": "Người thông minh hay nói, thay vì nhìn về quá khứ thì hãy dõi mắt tới tương lai. Hay là chúng ta bàn về chuyện hợp tác sau này đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650108
					],
					"speakerTitle": "Decembre"
				},
				{
					"id": 740650108,
					"content": "Hiện tại tôi có một việc không tệ, đang lo là không có người hỗ trợ đây. Nếu hai vị rảnh thì cứ tới đó xem thử nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650109
					],
					"speakerTitle": "Decembre"
				},
				{
					"id": 740650109,
					"content": "Hừ, chúng tôi sẽ không dễ dàng mắc bẫy nữa đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740650110,
					"content": "Thù lao không tệ là bao nhiêu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650111
					]
				},
				{
					"id": 740650111,
					"content": "Này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740650112,
					"content": "#Đây chính là lý do tôi thích hợp tác với người như {NICKNAME} đấy. Người ta hay nói thế nào ấy nhỉ, là... nhanh gọn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650113
					],
					"speakerTitle": "Decembre"
				},
				{
					"id": 740650113,
					"content": "Vậy để tôi báo giá, bảo đảm sẽ khiến các vị hài lòng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650114
					],
					"speakerTitle": "Decembre"
				},
				{
					"id": 740650114,
					"content": "100 Phiếu Đặc Cách, thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650115
					],
					"speakerTitle": "Decembre"
				},
				{
					"id": 740650115,
					"content": "100?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740650116,
					"content": "Nhìn vẻ mặt của các vị, chắc đã bị sự hào phóng của tôi làm cho bất ngờ chứ gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650117,
						740650119
					],
					"speakerTitle": "Decembre"
				},
				{
					"id": 740650117,
					"content": "Không đủ để mua nắp chai Fonta nữa đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650118
					]
				},
				{
					"id": 740650118,
					"content": "Đúng đó! Đúng là không thể tin nổi mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740650121,
					"content": "Vậy còn chưa đủ nhiều à? Tuổi trẻ đúng thật là... đừng đòi hỏi nhiều như thế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650122
					],
					"speakerTitle": "Decembre"
				},
				{
					"id": 740650122,
					"content": "Phải biết là mấy người khốn khổ rất hay tìm những thứ việc nhẹ lương cao này để làm đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650123
					],
					"speakerTitle": "Decembre"
				},
				{
					"id": 740650123,
					"content": "Decembre, cuối cùng cũng tìm được anh! Lần trước chúng tôi phát hiện anh báo giá thấp hơn công việc gửi thư của mình để người khác làm giùm anh đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650124
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650124,
					"content": "#{NICKNAME} và Paimon? Các vị sẽ không tin mấy lời dối trá của tên này đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650125,
						740650127
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650125,
					"content": "Hic, chúng tôi bị lừa một lần rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650126
					]
				},
				{
					"id": 740650126,
					"content": "Haiz, vậy là tôi đến muộn một bước rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650130
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650130,
					"content": "Tóm lại là đừng tin những gì anh ta nói. Anh ta chuyên chọn những người vừa tới Pháo Đài Meropide, chưa hiểu luật lệ để lừa đảo, đã có không ít người bị lừa rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650131
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650131,
					"content": "Lừa đảo gì chứ? Nói khó nghe thế. Giữa chúng ta có gì khác nhau đâu? Cai ngục các người cũng dùng Phiếu Đặc Cách để ủy thác người ta làm việc mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650132
					],
					"speakerTitle": "Decembre"
				},
				{
					"id": 740650132,
					"content": "Nhưng chúng tôi không cắt xén tiền công để đút vào túi riêng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650133
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650133,
					"content": "Đang ám chỉ gì đây? Không có chứng cứ thì đừng có ngậm máu phun người nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650134
					],
					"speakerTitle": "Decembre"
				},
				{
					"id": 740650134,
					"content": "Muốn có chứng cứ đúng không? Phòng tạm giam vừa yên tĩnh vừa có đầy đủ chứng cứ đấy. Thật là, rõ ràng bên Đường Hầm Mỏ Tinh Thể còn có chuyện cần làm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650135
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650135,
					"content": "#Đúng rồi, {NICKNAME} và Paimon, nếu các vị rảnh thì giúp tôi nhé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650136
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650136,
					"content": "Không phải lúc nào chúng tôi cũng rảnh rỗi đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740650137,
					"content": "Thù lao chắc sẽ cao nhỉ, việc này tôi nhận.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650138
					]
				},
				{
					"id": 740650138,
					"content": "Này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740650139,
					"content": "Haha, đương nhiên là sẽ chi trả theo quy định rồi. Các vị cũng biết tiêu chuẩn rồi đấy, tôi không lừa đảo đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650140
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650140,
					"content": "Chuyện là thế này, Đường Hầm Mỏ Tinh Thể xuất hiện Dị Chủng Biển Sâu... Nếu cứ mặc kệ thì nguy hiểm lắm, phải nhanh chóng xử lý mới được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650141
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650141,
					"content": "Tôi đưa người này tới phòng tạm giam trước, trao đổi với đồng nghiệp chắc sẽ tốn một chút thời gian... Chờ làm xong thủ tục tôi sẽ qua đó ngay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650142
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650142,
					"content": "Được rồi. Vậy anh nhanh lên nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650143
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740650143,
					"content": "Tôi sẽ tranh thủ, nhưng thủ tục ấy mà... nhanh hay chậm không phải do tôi quyết định. Bên kia nhờ vào các vị nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650127,
					"content": "Lần này thì chưa bị.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650128
					]
				},
				{
					"id": 740650128,
					"content": "Lần này?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650129
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650129,
					"content": "À ừm... Lần trước xảy ra một việc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740650119,
					"content": "Tôi cho anh 100, anh làm việc cho tôi nhé!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650120
					]
				},
				{
					"id": 740650120,
					"content": "#Woa, không phải {NICKNAME} định làm vậy thật đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740650103,
					"content": "Tôi có dự cảm chẳng lành...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650104
					]
				}
			]
		},
