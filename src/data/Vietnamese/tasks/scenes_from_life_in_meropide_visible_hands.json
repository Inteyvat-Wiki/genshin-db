				"points": []
			},
			"dialogs": [
				{
					"id": 740650301,
					"content": "Sao bây giờ anh mới chịu đến? Đám Dị Chủng Biển Sâu đều bị chúng tôi đuổi đi hết rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740650302,
					"content": "Ồ, vậy là việc này đã xảy ra với tôi rồi sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650303
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650303,
					"content": "Là sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740650304,
					"content": "Là khi tôi đến hiện trường thì đã có người khác hoàn thành công việc rồi. Tôi không cần làm gì cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650305
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650305,
					"content": "Đây là của các vị. Thật sự rất cảm ơn, đêm nay tôi có thể ngủ ngon rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maupoil"
				}
			]
		}
	]
