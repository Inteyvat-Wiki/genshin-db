				},
				{
					"id": 760360304,
					"content": "Trước đây tôi không biết là Kuuhenki còn biết vẽ tranh đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360305,
					"content": "Thật ra chúng cũng giống như chúng ta, đều có tính cách và sở thích riêng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360306
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760360306,
					"content": "Hmm? Lẽ nào cô đều quen biết tất cả Kuuhenki ở Nod-Krai sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360307,
					"content": "Ừm, chỉ cần từng gặp là tôi sẽ quen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360308
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760360308,
					"content": "Lợi hại vậy?! Theo tôi thấy, ngoại trừ Luonnotar có hơi đặc biệt ra thì những Kuuhenki khác gần như đều giống nhau cả...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360309,
					"content": "Vậy nhóc biết vẽ tranh này tên là gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360310,
					"content": "Tên...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360311
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760360311,
					"content": "Cô vẫn chưa đặt tên cho chúng à...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360312,
					"content": "Tôi quen biết chúng, chúng cũng biết tôi, không cần đến tên... Tôi cũng không có tên mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360313
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760360313,
					"content": "Đừng duy trì những truyền thống không tốt này nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360314,
					"content": "Hmm, để tôi nghĩ xem... Luonnotar, là sinh linh được Nguyệt Thần ban phước...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360315,
					"content": "\"Vẽ tranh\" trong ngôn ngữ của Dòng Dõi Sương Nguyệt nói thế nào nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360316,
					"content": "Hình như là... Maa... naus? Maalaus? Là Maalaus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360317
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760360317,
					"content": "Nghe cũng hay đó. Vậy thì gọi nó là \"Maalaus\" đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360318,
					"content": "??",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360319
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760360319,
					"content": "Sao rồi Maalaus, vẽ xong chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360320,
					"content": "!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360321
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760360321,
					"content": "Ồ! Để xem nào... Cái này...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360322,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760360323
					]
				},
				{
					"id": 760360323,
					"content": "Vẽ đẹp quá đi mất!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360324,
					"content": "Tôi còn tưởng nét vẽ sẽ khá trẻ con... hoặc là... giống như Melusine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360325,
					"content": "Kuuhenki rất giỏi cảm nhận môi trường xung quanh. Khi ký họa những thứ nhìn thấy, sẽ có xu hướng ghi lại nguyên vẹn cảm nhận của bản thân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360326
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760360326,
					"content": "Maalaus đang vẽ... Columbina sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760360327
					]
				},
				{
					"id": 760360327,
					"content": "!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360328
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760360328,
					"content": "Hmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360329
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760360329,
					"content": "...Trông giống như dáng vẻ khi Columbina vừa mới được sinh ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360330
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360330,
					"content": "Hửm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360331
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760360331,
					"content": "Tôi nhớ Lauma từng nói. Khi cô được sinh ra, Dòng Dõi Sương Nguyệt cũng đã ghi lại, nhưng có vẻ hơi khác với bức tranh này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360332,
						760360333
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360332,
					"content": "Hơn nữa, sinh vật như Kuuhenki...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760360334
					]
				},
				{
					"id": 760360334,
					"content": "Đứa nhóc này... Maalaus, là một trong những Kuuhenki đầu tiên được sinh ra. Có lẽ nó đã kết hợp với cảm nhận của bản thân để tưởng tượng ra khung cảnh lúc đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360335
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760360335,
					"content": "Ồ! Xem ra Maalaus đang cố gắng giới thiệu vị thần của mình nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360336
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360336,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360337
					],
					"speakerTitle": "Maalaus"
				},
