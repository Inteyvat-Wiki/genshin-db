					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760360103,
					"content": "Columbina?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760360105
					]
				},
				{
					"id": 760360105,
					"content": "Hmm? Là hai người à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360106
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760360106,
					"content": "Giúp tôi được không? Sau này sẽ có lợi đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360107
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760360107,
					"content": "Chậc... Khi nào thì cô mới thay đổi được thói quen này đây...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360108,
						760360109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360108,
					"content": "Trước đây cô cũng giúp chúng tôi rất nhiều mà...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760360110
					]
				},
				{
					"id": 760360110,
					"content": "Đúng đấy! Dù không có lợi ích gì thì chúng tôi vẫn sẽ giúp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360111,
					"content": "Vậy nên... tóm lại là thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360112,
					"content": "Hmm... Nói chính xác thì là nó cần giúp đỡ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360113
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760360113,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360114
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760360114,
					"content": "Con Kuuhenki này à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360115,
					"content": "Không biết nó đã nhặt được bút vẽ ở đâu, sau khi quay về đã vui vẻ mà lắc lư quanh tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360116
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760360116,
					"content": "Tôi đã tìm một ít vải và màu vẽ cho nó. Nhưng sau khi vẽ vời loay hoay một hồi thì dường như nó không thể pha được màu sắc ưng ý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360117
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760360117,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360118
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 760360118,
					"content": "Này, sao nhóc lại chui ra rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360119,
					"content": "!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360120
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 760360120,
					"content": "??",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360121
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760360121,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360122
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 760360122,
					"content": "Này... Cho dù có chỉ trỏ như vậy thì bọn ta cũng không biết nhóc đang cần gì đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360123,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360124
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 760360124,
					"content": "!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360125
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 760360125,
					"content": "!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360126
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760360126,
					"content": "#A! Hình như nó thích cái túi của {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360127,
					"content": "Hai người có mang theo màu vẽ nào phù hợp không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360128
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760360128,
					"content": "Chúng tôi không mang thứ đó... Mà nói chứ, Columbina tìm màu vẽ ở đâu vậy? Thường ngày trông cô cũng không giống người biết vẽ tranh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360129,
					"content": "Nó có chút nóng vội, nên tôi đã tiện tay dùng những đóa hoa sặc sỡ bên cạnh để làm cho nó một ít.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360130
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760360130,
					"content": "Ồ! Lẽ nào Luonnotar cũng muốn tìm một số thứ sặc sỡ để làm màu vẽ sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360131,
					"content": "Nào, vậy mau xem trong túi chúng ta có gì nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360109,
					"content": "Trước đó cũng chúc phúc cho chúng tôi nữa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760360110
					]
				},
				{
					"id": 760360104,
					"content": "Xảy ra chuyện gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
