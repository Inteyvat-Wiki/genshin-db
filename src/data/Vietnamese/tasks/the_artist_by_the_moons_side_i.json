					"nextDialogs": [
						760360343
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360343,
					"content": "Hmm? Columbina đang làm gì ở tế đàn vậy? Vẽ nhỏ quá nhìn không rõ.",
