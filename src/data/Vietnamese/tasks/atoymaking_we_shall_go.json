					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726940101,
					"content": "Thì ra là nhà lữ hành và Paimon sao, đúng lúc lắm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 726940102,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940103,
					"content": "Có một nhiệm vụ rất thích hợp với bạn đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940104
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 726940104,
					"content": "Lại là những nhiệm vụ đi tìm đồ hay chiến đấu với Hilichurl sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940105,
						726940106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940105,
					"content": "Còn có leo lên nóc nhà dọn rác nữa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940107
					]
				},
				{
					"id": 726940107,
					"content": "Không không, nhiệm vụ lần này rất thích hợp với bạn đó... Rất thích hợp có nghĩa là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940108
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 726940108,
					"content": "Không chỉ thú vị, mà còn có thù lao hậu hĩnh nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940109
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 726940109,
					"content": "Thù lao hậu hĩnh sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940110,
					"content": "Paimon không thèm để ý đến chữ thú vị luôn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940111
					]
				},
				{
					"id": 726940111,
					"content": "Thì đương nhiên thú vị là chính rồi, vậy nội dung ủy thác là gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940112,
					"content": "Ừm, người ủy thác lần này là thương nhân Bertrand đến từ Fontaine, anh ấy đến Inazuma để tìm trợ thủ chế tạo thương phẩm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940113
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 726940113,
					"content": "Dù sao cũng là người làm ăn, cho nên anh ta chi khá mạnh tay lúc đăng ký ủy thác cho Hiệp Hội Nhà Mạo Hiểm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940114
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 726940114,
					"content": "Nhưng mà do một số nguyên nhân nên anh ấy chỉ hoạt động được trên Đảo Ritou, tình hình cụ thể thì anh ấy sẽ nói cho các bạn nghe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940115
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 726940115,
					"content": "Được, bây giờ chúng tôi sẽ đến Đảo Ritou tìm anh ta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940106,
					"content": "Hoặc là vận chuyển hàng hóa kỳ lạ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940107
					]
				}
			]
		},
		{
			"id": 7269402,
			"completionStepIds": [
				7269402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7269402",
							"2"
						],
						"stepId": 7269402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bertrand"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726940201,
					"content": "Hừm, mọi thứ đã chuẩn bị xong, chỉ cần một món đồ chơi của tôi bán được mấy ngàn Mora... và bán mấy ngàn cái!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940202
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940202,
					"content": "Vậy chẳng phải sẽ dễ dàng kiếm được mấy chục triệu Mora sao... Hahaha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940203
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940203,
					"content": "Này! Anh là Bertrand sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940204,
					"content": "Ơ? Đúng vậy, là tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940205
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940205,
					"content": "Sao thế, lẽ nào hai vị cũng có nghe tin về tôi và đến mua đồ chơi do tôi làm sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940206
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940206,
					"content": "Nhưng tiếc là tôi không thể bán ngay cho hai vị, vì chúng tôi vẫn chưa thể bắt đầu sản xuất quy mô lớn được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940207
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940207,
					"content": "Nhưng đừng lo lắng, dây chuyền sản xuất đã được chuẩn bị sẵn sàng rồi, nếu hai vị có ý định mua thì có thể đăng ký và thanh toán tiền đặt cọc trước, đợi khi làm xong thì tôi sẽ thông báo cho hai vị thanh toán toàn bộ số tiền sau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940208
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940208,
					"content": "Khoan đã, chúng tôi không phải đến để mua đồ chơi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940209,
					"content": "Ồ, vậy thì... có chuyện gì thì nói mau, đừng làm chậm trễ công việc của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940210
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940210,
					"content": "Nói ngắn gọn thôi, thời gian của tôi rất quý báu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940211
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940211,
					"content": "Woa, thái độ của người này thay đổi nhanh ghê.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940212,
						726940213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940212,
					"content": "Chúng tôi đến để giúp đỡ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940214
					]
				},
				{
					"id": 726940214,
					"content": "Cái gì! Ôi, là nhà mạo hiểm đến làm trợ thủ sao, xin chào xin chào, thì ra là đến phụ giúp, sao không nói sớm chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940215
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940215,
					"content": "Đúng vậy, người treo ủy thác ở Hiệp Hội Nhà Mạo Hiểm là tôi, tôi nên xưng hô thế nào nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940216
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940216,
					"content": "(Có vẻ như thái độ lại thay đổi rồi...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940217,
					"content": "Tôi là Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940218,
					"content": "Vậy còn vị này?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940219
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940219,
					"content": "#{NICKNAME}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940220
					]
				},
				{
					"id": 726940220,
					"content": "#{NICKNAME}, cái tên này tôi đã từng nghe qua ở đâu đó rồi thì phải, lẽ nào... hai vị cũng từng bị truy nã sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940221,
						726940223
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940221,
					"content": "Đúng là không chỉ một lần...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940222
					]
				},
				{
					"id": 726940222,
					"content": "Vậy có thể là khi tôi bị Hiệp Hội Tenryou truy nã... Không, tôi đã từng nghe khi họ gọi tôi đến hỏi chuyện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940225
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940225,
					"content": "Rốt cuộc anh đã làm gì mà bị Hiệp Hội Tenryou truy nã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940226,
					"content": "Haiz, cũng không có gì to tát, chỉ là lô đồ chơi lần trước xảy ra chút vấn đề nhỏ không đáng kể...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940227
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940227,
					"content": "Không đáng kể?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940228,
					"content": "Vấn đề nhỏ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940229
					]
				},
				{
					"id": 726940229,
					"content": "Hihi, là chỉ cần vô tình chạm vào thiết bị kích hoạt bên trong thì chúng sẽ phát nổ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940230
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940230,
					"content": "Nổ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940231,
					"content": "Ôi, chỉ là chút vấn đề nhỏ thôi mà, cũng đâu có ai bị thương đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940232
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940232,
					"content": "Nhưng lính tuần tra của Hiệp Hội Tenryou lại chẳng nói năng gì, cứ thế tịch thu hết số đồ chơi của tôi... Rõ ràng là vẫn có thể bán như \"một quả bom đáng yêu\" mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940233
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940233,
					"content": "Haiz, lúc từ Fontaine đến, tôi còn mượn của Thương Hội Vạn Quốc một khoản tiền làm vốn, ai ngờ bây giờ lại bị hạn chế nhập cảnh, đành phải mưu sinh trên Đảo Ritou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940234
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940234,
					"content": "Nói gì thì cũng là anh tự làm tự chịu thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940235
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940235,
					"content": "Khoan đã, anh còn nợ Mora của Thương Hội Vạn Quốc sao, vậy sao lại còn nhiều tiền như vậy để treo ủy thác chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940236,
					"content": "Không sao, tôi còn một khoản tiền cuối cùng, chỉ cần bán được lô đồ chơi mới thì chắc chắn sẽ trả được hết nợ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940237
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940237,
					"content": "Đương nhiên cũng sẽ có thể trả thù lao hậu hĩnh cho hai vị!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940238
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940238,
					"content": "...Có được không đó?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940239
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940239,
					"content": "Đừng xem thường thị trường đồ chơi của Inazuma, đồ chơi của tôi trước khi phát hiện sẽ bị nổ đã bán rất chạy đó... Thậm chí sau khi biết sẽ bị nổ bán còn chạy hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940240
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940240,
					"content": "Tóm lại, nếu thật sự không khả thi thì những món đồ chơi tôi làm ra sẽ giao cho hội trưởng Kurisu để gán nợ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940241
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940241,
					"content": "Vậy nhờ hai vị giúp đỡ nhé, hihi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940242
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940242,
					"content": "Nhưng mà anh nói cần giúp, cụ thể là giúp gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940243
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940243,
					"content": "Là thế này, tôi sử dụng \"máy chế tạo lõi thế hệ thứ hai có kỹ thuật độc đáo và ổn định tuyệt đối độc nhất vô nhị\" mà tôi phát minh ra để chế tạo đồ chơi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940244
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940244,
					"content": "Nói đến \"máy chế tạo lõi thế hệ thứ hai có kỹ thuật độc đáo và ổn định tuyệt đối độc nhất vô nhị\" của tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940245
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940245,
					"content": "Tên quá dài...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940246
					]
				},
				{
					"id": 726940246,
					"content": "Đúng vậy, chi bằng gọi là... để tôi nghĩ xem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940247
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940247,
					"content": "Gọi là \"Cỗ Máy Khổng Lồ\" đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940248
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940248,
					"content": "Khoan đã, cái tên này có ngắn quá không! Chẳng có chút cảm giác đặc biệt lợi hại gì cả!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940249
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940249,
					"content": "Đôi khi ngắn một chút thì mọi người sẽ dễ nhớ hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940250
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940250,
					"content": "\"Cỗ Máy Khổng Lồ\", tôi thấy \"Cỗ Máy Khổng Lồ\" rất hay, rất thuận miệng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940251
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940251,
					"content": "Haiz... Thôi được thôi được, đúng là lúc trước có người nói tôi không biết đặt tên, tin bạn một lần vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940252
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940252,
					"content": "Paimon đặt tên cũng không hay ho gì...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940253
					]
				},
				{
					"id": 726940253,
					"content": "Ê!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940254
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940254,
					"content": "Hahaha, dù sao thì \"Cỗ Máy Khổng Lồ\" của tôi cũng sẽ tự động phân tích các nguyên liệu được thêm vào, xử lý nguyên liệu sao cho phù hợp nhất và lắp ráp chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940255
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940255,
					"content": "Nhưng lần trước vì thêm vào một số cơ quan kỳ lạ nên mới bị nổ, lần này tôi đã rút kinh nghiệm xương máu, thực hiện chút thay đổi... Về lý thuyết mà nói thì sẽ không xảy ra vấn đề như vậy nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940256
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940256,
					"content": "Về lý thuyết...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940257
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940257,
					"content": "Vì vậy mới cần người giúp thử nghiệm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940258
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940258,
					"content": "Tóm lại, khi chế tạo, quá trình thu thập nguyên liệu được chia thành ba bước, đó là \"thu thập nguyên liệu\", \"nạp nguyên tố\" và cuối cùng là \"kích hoạt hạt nhân\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940259
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940259,
					"content": "Chúng ta cần thu thập một số nguyên liệu như khoáng thạch, trái cây và hoa để làm nguyên liệu chính.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940260
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940260,
					"content": "Sau đó là nạp nguyên tố để đảm bảo hoạt động sản xuất, và cuối cùng là dùng sức mạnh của hạt nhân sinh vật nguyên tố để đảm bảo hoạt động sản xuất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940261
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940261,
					"content": "Hôm nay chúng ta sẽ thử bước đầu tiên là \"thu thập nguyên liệu\" nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940262
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940262,
					"content": "Nào, \"Máy Thu Thập Nguyên Liệu\" này giao cho bạn. Bất kể là thu thập được gì thì cũng phải cho vào Máy Thu Thập Nguyên Liệu ngay để không bị ô nhiễm bởi các sức mạnh nguyên tố khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940263
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940263,
					"content": "Cứ giao cho tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940264
					]
				},
				{
					"id": 726940264,
					"content": "Ừm, tôi còn phải điều chỉnh lại máy móc chút, việc thu thập nguyên liệu giao cho bạn đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940223,
					"content": "\"Cũng\" từng bị truy nã là sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940224
					]
				},
				{
					"id": 726940224,
					"content": "Haha, chuyện này nói ra dài dòng lắm, cũng vì chút sự cố nhỏ mà tôi từng bị Hiệp Hội Tenryou mời lên uống trà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940225
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940213,
					"content": "Anh đã treo ủy thác ở Hiệp Hội Nhà Mạo Hiểm đúng không...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940214
					]
				}
			]
		},
