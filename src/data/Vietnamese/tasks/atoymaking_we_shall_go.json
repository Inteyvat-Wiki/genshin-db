				"points": []
			},
			"dialogs": [
				{
					"id": 726940401,
					"content": "Sao sao, nguyên liệu thu thập sao rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940402
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940402,
					"content": "Tất cả đều đã ở trong máy thu thập.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940403
					]
				},
				{
					"id": 726940403,
					"content": "Được, bây giờ chúng ta sẽ cho tất cả nguyên liệu thu thập được vào cỗ máy độc nhất vô nhị này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940404
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940404,
					"content": "\"Cỗ Máy Khổng Lồ\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940405,
					"content": "Được rồi được rồi, chúng ta sẽ cho nguyên liệu vào \"Cỗ Máy Khổng Lồ\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940406
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940406,
					"content": "Bertrand cắm máy thu thập vào chỗ kết nối của \"Cỗ Máy Khổng Lồ\"",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						726940407
					]
				},
				{
					"id": 726940407,
					"content": "Woa, sau đó thì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940408,
					"content": "Lát nữa cỗ máy này sẽ chuyển động rầm rầm, sau đó sẽ tạo ra đồ chơi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940409,
					"content": "Hahaha, đương nhiên là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940410
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940410,
					"content": "Không thể nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940411
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940411,
					"content": "Nghĩ gì vậy, mới chỉ hoàn thành một trong ba công đoạn thôi, còn lâu mới tạo ra được đồ chơi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940412
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940412,
					"content": "Thì ra là vậy, phải hoàn thành hết tất cả công đoạn mới có đồ chơi sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940413,
					"content": "Đúng vậy, phải hoàn thành lần lượt cả ba công đoạn mới sản xuất ra được đồ chơi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940414,
						726940415
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940414,
					"content": "Phiền phức thật...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940416
					]
				},
				{
					"id": 726940416,
					"content": "Các người toàn muốn cái gì cũng phải nhanh. Người ta phải kiên trì với quy trình sản xuất đồ chơi chứ, người làm ra nó phải dồn hết...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940417
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940417,
					"content": "Dồn hết cái gì? Tôi hiểu rồi, suy cho cùng thứ mình làm ra là \"đồ chơi\", nên cần phải dồn hết tâm huyết của người làm ra nó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940418,
					"content": "Đúng vậy, phải tràn đầy nhiệt huyết với Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940419
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940419,
					"content": "À, mặc dù không giống như tưởng tượng, nhưng nhiệt huyết này tôi cũng có.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940420,
					"content": "Nè...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940421
					]
				},
				{
					"id": 726940421,
					"content": "Hihi, nói đại đó mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940422,
					"content": "Bertrand, vậy tiếp theo chúng ta phải làm gì, tiếp tục hoàn thành công đoạn tiếp theo sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940423,
					"content": "Đừng vội đừng vội, vì là máy đã qua điều chỉnh, nên vẫn chưa chạy qua quy trình này, trước tiên tôi phải xem xem máy xử lý số nguyên liệu này có xảy ra vấn đề gì không đã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940424
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940424,
					"content": "Phải quan sát một lúc, đến tìm tôi sau nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940415,
					"content": "Rườm rà thật...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940416
					]
				}
			]
		},
