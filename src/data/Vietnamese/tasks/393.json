			"dialogs": [
				{
					"id": 3930101,
					"content": "Tôi đang nghĩ, sau khi mọi chuyện kết thúc, tôi phải ghi những việc này vào bài ca...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930102,
						3930103
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3930102,
					"content": "Thời gian gần đây quả là xảy ra nhiều việc.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930104
					]
				},
				{
					"id": 3930104,
					"content": "Ừ, bài hát này cũng giống với \"Truyền Thuyết Về Vennessa\", được người dân Mondstadt lưu truyền.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930105
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3930105,
					"content": "Tôi từ bé đã rất thích bài hát đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930106
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3930106,
					"content": "#Vậy thì, {NICKNAME}... hôm nay bạn thấy thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930107
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3930107,
					"content": "Tôi đã chuẩn bị sẵn sàng, nhất định sẽ giúp được các bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930108,
						3930109
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3930108,
					"content": "Đội trưởng Jean thật đáng tin cậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930110
					]
				},
				{
					"id": 3930110,
					"content": "Nói đến thì lão gia Diluc cũng đã đi với chúng ta đến cuối cùng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3930111,
					"content": "Rõ ràng lúc đầu chỉ là bất cẩn bị cuốn vào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3930112,
					"content": "Là... người... qua đường?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3930113,
					"content": "Các vị chia sẻ cho tôi bí mật, tôi chỉ là trả lại sự tin cậy mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930114,
						3930117,
						3930120
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3930114,
					"content": "Lý do của lão gia Diluc, là tín nhiệm à.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930115
					]
				},
				{
					"id": 3930115,
					"content": "Sau đó, lý do của Đội Trưởng Jean, là \"trách nhiệm\" à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3930116,
					"content": "Vậy thì, tên hát rong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3930121,
					"content": "Là \"tự do\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930122
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3930122,
					"content": "Tự do...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3930123,
					"content": "Khi các bạn đến Mondstadt, có người nào nói cho các bạn biết, Mondstadt là \"Thành Phố Tự Do\" không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930124
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3930124,
					"content": "Amber...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930125
					]
				},
				{
					"id": 3930125,
					"content": "Haha, đó cũng là một cô bé tự do tự tại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930126
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3930126,
					"content": "Mondstadt là một thành bang không có \"Quốc Vương\" thống trị",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930127
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3930127,
					"content": "Mà người dân Mondstadt là người dân tự do nhất trong 7 đất nước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930128
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3930128,
					"content": "Tôi hy vọng, con rồng từng bảo vệ Mondstadt cũng như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930129
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3930129,
					"content": "Không nên có người lừa dối nó, nói \"Thành phố này đã phản bội ngươi\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930130
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3930130,
					"content": "Cũng không nên có người nói với nó, \"Bảo vệ thành phố này là nghĩa vụ vĩnh hằng của ngươi\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930131
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3930131,
					"content": "Nó có quyền lựa chọn cuộc sống của mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930132
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3930132,
					"content": "Venti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3930133,
					"content": "#Vậy thì, {NICKNAME}, ngọn gió ngàn năm của Mondstadt sẽ đồng hành với bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930134
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3930134,
					"content": "Tiếp đến tôi sẽ giúp bạn dẫn sức mạnh Nguyên Tố Phong giống như lần trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930135,
						3930136
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3930135,
					"content": "Anh nói \"lần trước\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930137
					]
				},
				{
					"id": 3930137,
					"content": "#Hóa ra là vậy! Chả trách {NICKNAME} nói giọng của anh rất quen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3930136,
					"content": "Tôi biết ngay mà, giọng nói lần trước chính là anh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930137
					]
				},
				{
					"id": 3930117,
					"content": "Lý do của đội trưởng Jean, là \"trách nhiệm\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930118
					]
				},
				{
					"id": 3930118,
					"content": "Ừm, lý do của lão gia Diluc, là \"tín nhiệm\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3930119,
					"content": "Vậy thì, tên hát rong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3930120,
					"content": "Vậy Venti thì sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930121
					]
				},
				{
					"id": 3930109,
					"content": "Yên tâm, trạng thái của tôi cũng rất tốt!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930110
					]
				},
				{
					"id": 3930103,
