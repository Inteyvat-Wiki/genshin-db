				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700300301,
					"content": "Gió còn chưa mang tin tức của bạn đến mà bạn đã xuất hiện. Đúng là tôi được mở mang tầm mắt, sao bạn làm được vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300302
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 700300302,
					"content": "#Hihi, {NICKNAME} lợi hại hơn bạn nghĩ nhiều!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700300303,
					"content": "E hèm, chừng này đủ chưa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300304
					]
				},
				{
					"id": 700300304,
					"content": "Đưa tôi xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				}
			]
		},
		{
			"id": 7003004,
			"completionStepIds": [
				7003007
			],
			"beginWay": "TALK_BEGIN_MANUAL",
