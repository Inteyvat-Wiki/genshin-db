			"trigger": {
				"objectNames": [
					"Kaedehara Kazuha"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700300401,
					"content": "Ừm, chất lượng rất tốt, chừng này đủ rồi, giã nó ra thành nước và nhúng thân đàn vào là sẽ có thể hồi xuân đàn cổ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300402
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 700300402,
					"content": "Ôi, cảm giác quen thuộc này. Nó thức tỉnh rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300403
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 700300403,
					"content": "#Nào, {NICKNAME}, thử đi, giao nó cho bạn đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300404
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 700300404,
					"content": "Giao cho tôi là ý gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300405
					]
				},
				{
					"id": 700300405,
					"content": "Haha, lẽ nào nhà thơ không được biểu lộ tâm ý sao? \"Giao cho bạn\" tức là: Tặng cây đàn này cho bạn đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300406
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 700300406,
					"content": "Tôi đến thăm lại Liyue là để lắng nghe vùng đất này. Nghe những lời thì thầm bất tận ở vùng đất cổ xưa được Nham Thần bảo hộ này, tôi rất mãn nguyện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300407
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 700300407,
					"content": "Đương nhiên, nếu một ngày nào đó bạn không cần cây đàn này nữa, tôi sẽ đến lấy. Nhưng...hy vọng sẽ không có ngày đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300408
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 700300408,
					"content": "Được rồi, tôi phải tiếp tục lên đường, những lúc thế này người Liyue hay nói gì nhỉ? À, đúng rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300409
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 700300409,
					"content": "#{NICKNAME}, \"hẹn gặp lại sau\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				}
			]
		}
	]
