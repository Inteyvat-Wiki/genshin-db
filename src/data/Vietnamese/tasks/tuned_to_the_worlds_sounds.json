			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Juza"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700300101,
					"content": "Ồ! Nhà Lữ Hành, lâu rồi không gặp, dạo này có khỏe không!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300102
					],
					"speakerTitle": "Juza"
				},
				{
					"id": 700300102,
					"content": "Chúng ta từng gặp nhau sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300103
					]
				},
				{
					"id": 700300103,
					"content": "Ơ...Bạn...Bạn quên tôi rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300104
					],
					"speakerTitle": "Juza"
				},
				{
					"id": 700300104,
					"content": "Tôi là thuyền phó Juza của Ngôi Sao Chết Chóc đây, lúc trước bạn còn ngồi thuyền của chúng tôi đến Inazuma đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300105
					],
					"speakerTitle": "Juza"
				},
				{
					"id": 700300105,
					"content": "#Đâu có đâu có, thuyền phó Juza, đương nhiên chúng tôi nhớ chứ, {NICKNAME} đang đùa đó, hì hì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700300106,
					"content": "Hờ, vậy mới phải chứ, dù sao tôi cũng đường đường là thuyền phó của Ngôi Sao Chết Chóc mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300107
					],
					"speakerTitle": "Juza"
				},
				{
					"id": 700300107,
					"content": "E hèm, có gì cần giúp sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300108
					]
				},
				{
					"id": 700300108,
					"content": "À, thật ra không phải tôi, mà là chú em Kazuha đang ở tạm trong đội thuyền của chúng tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300109
					],
					"speakerTitle": "Juza"
				},
				{
					"id": 700300109,
					"content": "Chắc bạn có ấn tượng chứ? Khi trở về từ Inazuma, cậu ấy cũng có đi chung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300110
					],
					"speakerTitle": "Juza"
				},
				{
					"id": 700300110,
					"content": "Không biết tại sao suốt chặng đường tôi cảm thấy tâm trạng của cậu ấy rất tốt, thỉnh thoảng còn rủ mọi người hát hò ngâm thơ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300111
					],
					"speakerTitle": "Juza"
				},
				{
					"id": 700300111,
					"content": "Tiếc là trên thuyền của chúng tôi, từ chị đại Beidou đến Bé Yue, chẳng có ai có...có...ừm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300112,
						700300114
					],
					"speakerTitle": "Juza"
				},
				{
					"id": 700300112,
					"content": "Nhã hứng!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300113
					]
				},
				{
					"id": 700300113,
					"content": "Đúng! Nhã hứng! Không tìm được ai có nhã hứng đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300116
					],
					"speakerTitle": "Juza"
				},
				{
					"id": 700300116,
					"content": "Cho nên vừa đến Liyue là cậu ấy xuống thuyền và đi thưởng ngoạn cảnh núi non sông nước, xem ra có vẻ đã chịu sự ngột ngạt quá lâu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300117
					],
					"speakerTitle": "Juza"
				},
				{
					"id": 700300117,
					"content": "Nhưng cậu ấy vừa đi không bao lâu thì nhắn về, nhờ chúng tôi để ý hành tung của bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300118
					],
					"speakerTitle": "Juza"
				},
				{
					"id": 700300118,
					"content": "Cậu ấy gặp rắc rối sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300119
					]
				},
				{
					"id": 700300119,
					"content": "Không nói đến tình hình cụ thể, chỉ nói nếu gặp bạn thì mời bạn đến đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300120
					],
					"speakerTitle": "Juza"
				},
				{
					"id": 700300120,
					"content": "Nghe có vẻ không quan trọng lắm, nhưng nếu là chuyện nhỏ thì tôi nghĩ không cần nhờ đến Nhà Lữ Hành đâu nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300121
					],
					"speakerTitle": "Juza"
				},
				{
					"id": 700300121,
					"content": "#Thật ra chúng tôi cũng hay xử lý những chuyện nhỏ, đúng không, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300122,
						700300123,
						700300124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700300122,
					"content": "Ừm, thường cho bồ câu ăn hay gì đó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300125
					]
				},
				{
					"id": 700300125,
					"content": "Ồ, thật không ngờ bạn còn giúp mọi người làm cả những việc tầm thường đó nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300126
					],
					"speakerTitle": "Juza"
				},
				{
					"id": 700300126,
					"content": "Chẳng trách chị đại hay khen bạn, xem ra trên người bạn có \"hơi thở cuộc sống\" như chị ấy nói nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300127
					],
					"speakerTitle": "Juza"
				},
				{
					"id": 700300127,
					"content": "Ây da! Nói nhiều quá rồi, bạn mau đến chỗ Kazuha xem đi, chắc cậu ấy đang ở phía bắc cảng Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300128
					],
					"speakerTitle": "Juza"
				},
				{
					"id": 700300128,
					"content": "Tôi còn bận việc của đội thuyền nên không tiễn mọi người nữa, đi đường cẩn thận nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Juza"
				},
				{
					"id": 700300123,
					"content": "Ừm, thường giao đồ ăn cho quán ăn hay gì đó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300125
					]
				},
				{
					"id": 700300124,
					"content": "Ừm, thường dọn dẹp vệ sinh hay gì đó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300125
					]
				},
				{
					"id": 700300114,
					"content": "Kỳ quặc!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300115
					]
				},
				{
					"id": 700300115,
					"content": "Không không, phải gọi là nhã hứng! Không tìm được ai có nhã hứng đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300116
					],
					"speakerTitle": "Juza"
				}
			]
		},
		{
			"id": 7003002,
			"completionStepIds": [
				7003004
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7003004",
							"2"
						],
						"stepId": 7003004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaedehara Kazuha"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700300201,
					"content": "Tiếng đàn réo rắt, dây đàn thì thầm, độc huyền lẻ loi, dưới ánh hoàng hôn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300202
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 700300202,
					"content": "Ơ! Chú em Kazuha đang ở đây à? Chúng tôi đến giúp chú em đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700300203,
					"content": "Ồ? Các bạn đến rồi, lâu rồi không gặp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300204
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 700300204,
					"content": "Cách gọi \"chú em Kazuha\" nghe từ miệng Paimon đúng là mang một âm điệu hoàn toàn khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300205
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 700300205,
					"content": "Hihihi, tôi học theo thuyền phó Juza đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300206,
						700300207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700300206,
					"content": "Rảnh ghê.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300208
					]
				},
				{
					"id": 700300208,
					"content": "Haha, lẽ nào trong mắt bạn, tôi là loại người mang gánh nặng cuộc đời mà bước đi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300209
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 700300209,
					"content": "Thuyền phó Juza nói bạn có việc tìm tôi, ai mà biết được bạn lại ung dung tự tại như vậy, còn ở đây ngắm cảnh ngâm thơ nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700300210,
					"content": "Chuyện Inazuma tôi không còn nghĩ đến nữa. Bây giờ trở lại Liyue, đương nhiên là nên ngâm thơ và lắng nghe âm thanh tuyệt vời của mặt trăng rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300211
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 700300211,
					"content": "Còn về chuyện nhờ bạn giúp vốn dĩ là không có, nhưng tiếc là các bạn đến trễ một bước nên bây giờ có rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300212
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 700300212,
					"content": "Hả? Chóng mặt ghê, \"vốn dĩ là không có...cho nên bây giờ lại có rồi...\", cái gì chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700300213,
					"content": "Có phải bạn đã ăn phải thứ gì đó trong núi không, sao ngay cả nói chuyện cũng không rõ ràng vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700300214,
					"content": "Suỵt, hai vị nghe tôi nói.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300215
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 700300215,
					"content": "Hai vị thấy thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300216
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 700300216,
					"content": "Woa, tiếng đàn... Theo tôi thì gần giống với tiếng đàn của tên hát rong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700300217,
					"content": "Hở, tên hát rong? Hy vọng có ngày được gặp. Nhà Lữ Hành, bạn thấy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300218,
						700300219
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 700300218,
					"content": "Tôi nghĩ cây đàn này bị hỏng rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300220
					]
				},
				{
					"id": 700300220,
					"content": "Đúng vậy, nhưng mà quan trọng hơn là nó có một loại năng lực thần kỳ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300221
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 700300221,
					"content": "Cây đàn cổ vô danh này tôi vô tình phát hiện được trong một hang động đổ nát khi đi tham quan những ngọn núi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300222
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 700300222,
					"content": "Lúc đó, cây đàn tuy đã cũ nhưng vẫn còn tốt. Tôi vừa thấy là thích và bất giác đàn một bài.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300223
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 700300223,
					"content": "Không ngờ ngay tiếng đàn đầu tiên, tôi đã ngẩn ngơ, cứ như có ai đó đang hợp tấu với tôi vậy, cảm giác đó rất quen thuộc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300224
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 700300224,
					"content": "Chà, bạn thật sự không ăn phải thứ cỏ gì đó gây ảo giác đó chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700300225,
					"content": "Không có, ngay khi vừa đàn xong thì tôi tỉnh lại, sau đó mới nhìn kĩ xung quanh hang động, đúng là có rất nhiều điều bí ẩn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300226
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 700300226,
					"content": "Trong hang cỏ dại mọc um tùm, chắc là chủ nhân đã bỏ đi từ rất lâu rồi. Nhưng bộ bàn ghế lại không hề hấn gì, lại còn tỏa ra mùi hương thanh tao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300227
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 700300227,
					"content": "Ngay cả âm thanh ồn ào của gió cũng dừng lại ở đó. Một điều kỳ diệu như vậy, tôi đoán, đó chính là kho báu tiên gia trong truyền thuyết Liyue chăng?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300228
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 700300228,
					"content": "Woa! Vậy cây đàn đó là báu vật của tiên nhân để lại sao?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700300229,
					"content": "Haha, ai mà biết được? Sau đó tôi lại nghĩ, điều tuyệt vời như vậy, tất nhiên phải được chia sẻ với bạn bè.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300230
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 700300230,
					"content": "Nhưng ở Liyue, ngoài chị đại ra thì tôi chỉ có bạn là bạn thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300231
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 700300231,
					"content": "Sợ là chị đại sẽ không hứng thú với những chuyện này, nên tôi nghĩ, hay là rủ bạn trải nghiệm một phen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300232
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 700300232,
					"content": "Thế là tôi nhờ thuyền phó Juza để ý tung tích của bạn. Chỉ tiếc là trước khi các bạn đến, cây đàn đã hư mất rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300233
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 700300233,
					"content": "Ừm, là lỗi của tôi, tôi đem nó đi khắp nơi và sử dụng quá nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300234
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 700300234,
					"content": "Hơ, báu vật của tiên nhân mà cũng hư sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300235
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700300235,
					"content": "Ngay cả Lôi Thần đại nhân kia cũng không thể giữ được vĩnh hằng...huống chi những thứ khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300236
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 700300236,
					"content": "#Hic, {NICKNAME}, bạn, bạn nhất định phải bảo vệ Ấm Trần Ca của chúng ta đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300237
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700300237,
					"content": "Nhưng may là hư hỏng này có thể sửa được, bởi vì nó giống ngủ đông hơn, là do năng lượng trong đàn mất dần theo thời gian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300238
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 700300238,
					"content": "Cho nên chỉ cần tìm được nguyên liệu là có thể đánh thức nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300239
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 700300239,
					"content": "Nếu tôi không nghe lầm, thì hình như nguyên liệu là...Bách Hợp Lưu Ly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300240
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 700300240,
					"content": "Sao bạn biết?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300241
					]
				},
				{
					"id": 700300241,
					"content": "Tôi từng nói rồi, gió sẽ mang theo tiếng thì thầm của vạn vật đi khắp nơi, và tình cờ tôi nghe được một số điều chúng nói.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300242
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 700300242,
					"content": "Vì vậy, tôi biết một vài lời trong quá khứ về cây đàn cổ này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300243
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 700300243,
					"content": "Đi đi, tôi sẽ ở đây chờ bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300244
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 700300244,
					"content": "Bạn là đại anh hùng của cảng Liyue, chút chuyện nhỏ này chắc là không thành vấn đề đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 700300219,
					"content": "Cây đàn này rất giá trị đúng không.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300220
					]
				},
				{
					"id": 700300207,
					"content": "Đúng là làm việc không đâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300208
					]
				}
			]
		},
