			"dialogs": [
				{
					"id": 715010101,
					"content": "À, tình hình hai hôm nay chuyển biến xấu hơn rồi, hành động của đội thăm dò cũng sẽ bị hạn chế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 715010102,
					"content": "Ai có thể giải quyết được ủy thác như vậy đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010103,
						715010104
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 715010103,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715010105
					]
				},
				{
					"id": 715010105,
					"content": "#A, là {NICKNAME} và Paimon, đến đúng lúc lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010106
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 715010106,
					"content": "Đến đúng lúc?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 715010107,
					"content": "Nghe là biết lại có chuyện phiền phức nữa rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 715010108,
					"content": "Trong thời gian này, không biết tại sao mà khu mỏ và đường hầm của Vực Đá Sâu lại có rất nhiều bùn đen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010109
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 715010109,
					"content": "Vì là trường hợp khẩn cấp nên đội thăm dò không thể ứng phó kịp thời, tiến triển đội điều tra cũng dừng lại rồi, Khedive cũng đã nhờ Hiệp Hội Nhà Mạo Hiểm tìm người hỗ trợ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010110
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 715010110,
					"content": "Hả? Thứ bùn đen? Lẽ nào là thứ dưới Vực Đá Sâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 715010111,
					"content": "Phải, đúng là loại bùn đen đó, không biết sao lại xuất hiện ở khu mỏ và đường hầm nữa, không nói đến tiến trình điều tra của đội thám hiểm bị cản trở, cả hoạt động thường ngày cũng chịu ảnh hưởng luôn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010112
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 715010112,
					"content": "Dù gì thì rất nhiều tài nguyên và nguyên liệu phải dựa vào hầm mỏ để vận chuyển mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010113
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 715010113,
					"content": "Chuyện xảy ra như vậy bao lâu rồi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715010114
					]
				},
				{
					"id": 715010114,
					"content": "Đã được một thời gian rồi, dù Khedive nói đã tìm được học giả Sumeru chịu giúp đỡ, nhưng vị học giả đó cũng cần trợ giúp...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010115
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 715010115,
					"content": "Tôi đang đau đầu với việc tìm người có khả năng giải quyết được chuyện này đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010116
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 715010116,
					"content": "Thù lao cho ủy thác của Khedive chắc cao lắm nhỉ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 715010117,
					"content": "Không một ai chịu nhận sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 715010118,
					"content": "Dù gì những thứ bùn đen đó vẫn rất nguy hiểm... chẳng một ai chịu nhận ủy thác này cả, dù cho số người đến vì thù lao rất đông...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010119
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 715010119,
					"content": "Nhưng đa phần nhà mạo hiểm vừa nghe đến Vực Đá Sâu thôi là đã rút lui rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010120
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 715010120,
					"content": "Hơn nữa, cũng do hầu hết nhà mạo hiểm không hề rõ về tình hình của Vực Đá Sâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010121
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 715010121,
					"content": "Người có thể nhận ủy thác này phải vừa không sợ nguy hiểm, vừa phải hiểu rõ tình trạng của Vực Đá Sâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010122
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 715010122,
					"content": "Tôi đang rầu không biết làm sao để tìm ra người đảm nhận trọng trách này thì các bạn đi ngang qua đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010123
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 715010123,
					"content": "#Ra là thế, {NICKNAME}, tình hình có vẻ nguy cấp lắm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010124,
						715010125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 715010124,
					"content": "Ừm, phải đi xem thử mới được...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715010126
					]
				},
				{
					"id": 715010126,
					"content": "Thế bây giờ chúng ta tới Vực Đá Sâu tìm Khedive nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 715010127,
					"content": "À, về chuyện này thì... Khedive nói bạn cứ đi tìm học giả Sumeru kia là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010128
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 715010128,
					"content": "Nguyên văn của anh ta như thế này: \"Nếu có người chịu tới thì cứ bảo người đó tới doanh trại ở Vực Đá Sâu, tên đó vẫn đang điều chỉnh thiết bị ở đấy.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010129
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 715010129,
					"content": "Được, chúng tôi sẽ đi ngay.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715010130
					]
				},
				{
					"id": 715010130,
					"content": "Ừm, sự an toàn của Vực Đá Sâu trông cậy vào các bạn rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 715010125,
					"content": "Xem như giúp Khedive một lần...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715010126
					]
				},
				{
					"id": 715010104,
					"content": "Xảy ra chuyện gì sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715010105
					]
				}
			]
		},
