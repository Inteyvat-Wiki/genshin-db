						],
						"pointId": 600100246
					}
				]
			},
			"dialogs": [
				{
					"id": 715010201,
					"content": "Không ngờ môi trường ở đây lại đặc biệt như thế... Vậy thì, hệ thống năng lượng \"Gai Pursina\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010202
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010202,
					"content": "#Hửm? {NICKNAME} và Paimon, đã lâu không gặp, sao các bạn cũng tới Vực Đá Sâu thế...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010203
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010203,
					"content": "Nhắc đến thì, hình như trước đây tôi từng nghe Khedive nói qua, bạn đã giúp đội thăm dò rất nhiều ở Vực Đá Sâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010204
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010204,
					"content": "Tuy nhiên môi trường ở Vực Đá Sâu hiện tại đã trở nên tồi tệ và nguy hiểm hơn trước, đây không phải là nơi để đi dạo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010205
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010205,
					"content": "Anh là?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715010206
					]
				},
				{
					"id": 715010206,
					"content": "Không phải chúng ta vừa mới gặp nhau không lâu trước đây sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010207
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010207,
					"content": "Mặc dù lần nào gặp nhau cũng phiền bạn làm rất nhiều thứ, nhưng cũng không cần thiết phải giả vờ không quen biết nhau mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010208
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010208,
					"content": "Thôi bỏ đi, tôi sẽ tự giới thiệu lại, tôi là Hosseini, học giả của \"Giáo Viện\" Sumeru, trước đây từng nghiên cứu \"Đĩa Dẫn Năng Lượng\", và cũng từng tới Inazuma để khảo sát.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010209
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010209,
					"content": "Nhưng quỹ nghiên cứu giờ đã cạn kiệt, cho nên tôi đành phải quay về Sumeru...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010210
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010210,
					"content": "Ồ, hình như tôi có chút ấn tượng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 715010211,
					"content": "Bạn đã nhớ ra tôi rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010212
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010212,
					"content": "Anh là \"người đĩa dẫn\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 715010213,
					"content": "...Cái từ đó ở đâu ra thế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010214
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010214,
					"content": "Tóm lại, tôi đang trên đường trở về Sumeru thì nhận được ủy thác của Khedive, cũng là một học giả của \"Giáo Viện\", lúc trước Khedive đã giúp tôi vài chuyện, chủ yếu là kinh phí nghiên cứu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010215
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010215,
					"content": "Vì thế lần này tôi tới Vực Đá Sâu để giúp anh ta giải quyết vấn đề này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010216
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010216,
					"content": "Tôi đã giải thích rõ ràng rồi nhỉ, còn các bạn thì sao, sao các bạn lại ở Vực Đá Sâu vào lúc này?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010217,
						715010218
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010217,
					"content": "Chúng tôi đã nhận ủy thác của Khedive...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715010219
					]
				},
				{
					"id": 715010219,
					"content": "Ồ ồ, thì ra là các bạn. Lúc Khedive nói muốn tìm người giúp đỡ, tôi còn thấy lo lắng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010220
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010220,
					"content": "Nhưng nếu là các bạn thì tôi yên tâm rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010221
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010221,
					"content": "Lần này chuyện bùn đen xuất hiện ở Vực Đá Sâu, nếu chỉ có mình tôi giải quyết thì sẽ tốn rất nhiều công sức. Có sự giúp đỡ của các bạn thì xác suất giải quyết được sẽ... cao hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010222
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010222,
					"content": "Vậy chúng tôi cần phải làm gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715010223
					]
				},
				{
					"id": 715010223,
					"content": "Bạn đã nghe nói về \"Gai Pursina\" chưa? Một thiết bị có khả năng giải phóng sức mạnh làm nhiễu loạn các địa mạch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010224
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010224,
					"content": "Theo suy đoán của tôi, chỉ cần đặt một \"Gai Pursina\" ở chỗ bùn đen tuôn ra, làm nhiễu loạn hoạt động của địa mạch là có thể dọn dẹp bùn đen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010225
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010225,
					"content": "Nhưng bùn đen thì liên quan gì đến địa mạch chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 715010226,
					"content": "Bởi vì đống bùn đen này xuất hiện cùng với sự biến đổi của địa mạch, cho nên khả năng cao là có liên quan tới địa mạch... Đây là kết quả thảo luận của tôi và Khedive.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010227
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010227,
					"content": "Cho nên chỉ cần dùng Gai Pursina làm nhiễu loạn, thậm chí khóa lối ra của địa mạch thì chắc sẽ ngăn bùn đen chảy ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010228
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010228,
					"content": "Thì ra là thế...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715010229
					]
				},
				{
					"id": 715010229,
					"content": "Chẳng qua, trước đó chỉ dùng Gai Pursina làm \"Nhiễu Loạn Địa Mạch\", còn lần này cần phải \"Đóng Kín Hoàn Toàn\", mà đây lại là lần đầu tiên làm thử nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010230
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010230,
					"content": "Tôi đã tính toán kiểm tra lại, điều chỉnh một vài thông số trong Gai Pursina, trên lý thuyết thì sẽ không có lỗi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010231
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010231,
					"content": "Tuy nhiên lý thuyết cũng chỉ là lý thuyết, vẫn cần được kiểm chứng bằng thí nghiệm, tôi định bắt đầu thử nghiệm ngay bây giờ, nhưng các thí nghiệm có thể có rủi ro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010232
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010232,
					"content": "Để tôi thử xem...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715010233
					]
				},
				{
					"id": 715010233,
					"content": "Ừm... Vậy cũng được, tôi giao cho bạn đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010234
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010234,
					"content": "Tôi cũng sẽ đứng bên cạnh quan sát.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010218,
					"content": "Chúng tôi tới để giúp đỡ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715010219
					]
				}
			]
		}
	]
}