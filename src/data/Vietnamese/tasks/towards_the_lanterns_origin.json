				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400010201,
					"content": "Cuối cùng cũng đến <color=#00E1FFFF>Liyue</color> rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010202,
					"content": "Xin hỏi thứ đồ bay bay bên cạnh bạn, bán bao nhiêu tiền vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010203,
						400010205
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 400010203,
					"content": "Bao nhiêu tiền cũng không bán!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400010204
					]
				},
				{
					"id": 400010204,
					"content": "Bao nhiêu tiền cũng không bán!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010209,
					"content": "Haha, thời gian gần đây tiền vốn không đủ, khó mà trả giá được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010210
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 400010210,
					"content": "Dù sao tôi cũng chỉ là một người buôn bán nhỏ, cũng không buôn bán bảo vật quý hiếm gì cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010211
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 400010211,
					"content": "Cảm thấy đáng nghi ngờ quá à.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010212,
					"content": "Đừng nói như vậy chứ. Người bạn nhỏ, có muốn ăn kẹo không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010213
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 400010213,
					"content": "#{NICKNAME}, tôi thấy người này có thể tin được đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010214,
					"content": "Đúng rồi, các bạn đến Liyue là vì Tết Hải Đăng phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010215
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 400010215,
					"content": "Đèn Minh Tiêu năm nay rất đáng trông đợi. Viên Phù Sinh Thạch để làm chiếc đèn khổng lồ bay lên là loại to nhất trong 20 năm gần đây đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010216
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 400010216,
					"content": "To đến mức khó tin, thành phố trên mây trong thần thoại nếu có thật thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010217
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 400010217,
					"content": "Chắc cũng đặt một viên Phù Sinh Thạch to như vậy ở dưới chăng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010218
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 400010218,
					"content": "Thật là kỳ thú quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010219,
					"content": "Haha, có duyên gặp lại. Chào mừng các bạn đến Liyue, tuy không thể đại diện cho <color=#00E1FFFF>Cảng Liyue</color>, thế nhưng cửa tiệm nhỏ của tôi luôn hoan nghênh các bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bolai"
				},
				{
					"id": 400010205,
					"content": "Tin tôi đi, bạn trả không nổi đâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400010206
					]
				},
				{
					"id": 400010206,
					"content": "Lời nói thật kỳ quặc!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010207,
					"content": "Thực sự tôi vẫn còn thắc mắc...rốt cuộc là bao nhiêu tiền thế...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010208,
					"content": "Thôi vậy, tôi nói thẳng \"bao nhiêu tiền cũng không bán\" vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010209
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4000103,
			"completionStepIds": [
				4000103
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4000103",
							"2"
						],
						"stepId": 4000103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jiangzhou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400010301,
					"content": "#{NICKNAME}, mau xem kìa! Viên đá trôi nổi giữa không trung, hơn nữa sợi dây kết nối còn bị kéo thẳng ra nữa chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010302,
					"content": "Nếu không bị buộc lại, chả biết nó sẽ bay đi đâu mất nữa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010303,
					"content": "Đó là Phù Sinh Thạch được dùng để chế tạo Đèn Minh Tiêu. Toàn bộ Chợ Đèn Tiêu đều được bố trí xung quanh nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010304
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 400010304,
					"content": "Cho hỏi bạn là...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010305,
					"content": "Tôi là Jiangzhou, thời gian gần đây phụ trách thống kê tiến độ xây dựng đèn Minh Tiêu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010306
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 400010306,
					"content": "Chắc các bạn lần đầu tiên đến Liyue đón tết Hải Đăng phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010307
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 400010307,
					"content": "Đúng vậy... Sao bạn biết được?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010308,
					"content": "Năm ngoái tôi không nhớ có Nhà Lữ Hành đem theo vật may mắn kỳ quái đến đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010309
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 400010309,
					"content": "Để tôi giới thiệu vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010310
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 400010310,
					"content": "Vì thế Đèn Minh Tiêu là...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400010311
					]
				},
				{
					"id": 400010311,
					"content": "Trong ngày tết, đèn được bay lên trời gọi là \"đèn tiêu\". Hơn nữa người Liyue cùng làm một chiếc đèn khổng lồ, chính là \"Đèn Minh Tiêu\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010312
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 400010312,
					"content": "Slime Hỏa Lớn có năng lực \"Ngọn Lửa Âm Ỉ\": Cứ cách một khoảng thời gian sẽ gây ra lửa đốt, gây đính kèm nguyên tố hỏa cho nhân vật gần đó. Trước khi nguyên tố hỏa đính kèm biến mất sẽ chịu sát thương nguyên tố hỏa liên tục.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010313
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 400010313,
					"content": "Nếu các bạn muốn, cũng có thể cùng giúp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010314
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 400010314,
					"content": "Có được lợi ích gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010315,
					"content": "Sự trợ giúp của bạn sẽ được Đèn Minh Tiêu mãi ghi nhớ. Chờ cho đến ngày trăng tròn đầu tiên của năm, mọi thứ có khởi đầu mới, nguyện vọng của bạn sẽ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010316
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 400010316,
					"content": "Không có thứ gì thực tế hơn một chút được sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010317,
					"content": "Haizz, sao phải thực dụng như vậy chứ? Chân bước trên mặt đất, mắt cũng nên ngắm nhìn sao trên trời chứ. Con người không thể đánh mất ước mơ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010318
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 400010318,
					"content": "Tóm lại, nếu giúp đỡ xây dựng Đèn Minh Tiêu, sẽ có hồi báo tương ứng trong <color=#00E1FFFF>Chợ Đèn Tiêu</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010319
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 400010319,
					"content": "Tóm lại, chỉ cần cố gắng là có đồ ăn ngon, phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010320,
					"content": "#{NICKNAME}, phải cố gắng đó! Chúng mình đi hỏi mọi người trong <color=#00E1FFFF>Chợ Đèn Tiêu</color> đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
