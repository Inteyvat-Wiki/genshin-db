					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3710103,
					"content": "Tôi muốn tự mình điều tra trước.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3710105
					]
				},
				{
					"id": 3710105,
					"content": "Ừm, quả nhiên bạn còn nhớ hắn, cái tên màu xanh xanh đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3710106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3710106,
					"content": "Mặc màu xanh giống như cái tên ở dưới lầu kia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3710107,
						3710111
					],
					"speakerTitle": "Paimon"
				},
				{
