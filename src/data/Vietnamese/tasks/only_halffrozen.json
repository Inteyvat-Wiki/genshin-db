			},
			"dialogs": [
				{
					"id": 205200401,
					"content": "Phù... ấm áp hơn nhiều rồi, cảm ơn bạn nhé, Nhà Lữ Hành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200402
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200402,
					"content": "Sao bạn lại ở đây?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205200403
					]
				},
				{
					"id": 205200403,
					"content": "Haiz, tôi ở lại doanh trại này suốt... vì một ủy thác không dễ dàng gì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200404
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200404,
					"content": "Nhưng cứ ở mãi một chỗ cũng không được, nên tôi chỉ muốn tìm chút việc để làm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200405
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200405,
					"content": "Đầu bếp Harris ở doanh trại muốn nhờ người tìm Thịt Tươi Lạnh gì đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200406
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200406,
					"content": "Anh ấy còn nói chỉ cần tìm mấy con heo con bị đóng băng là được, không cần đi vào sâu trong núi, sẽ không có nguy hiểm gì hết...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200407
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200407,
					"content": "Tôi nghĩ chỉ là chuyện nhỏ, nên đã nhận ủy thác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200408
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200408,
					"content": "Vả lại tôi cũng muốn rèn luyện bản thân, làm quen dần với hoàn cảnh trên núi tuyết...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200409
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200409,
					"content": "Rồi hoàn thành ủy thác của cô thuật sĩ giả kim đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200410
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200410,
					"content": "Nhưng nào ngờ, vừa vào núi tuyết, chưa đi được mấy bước thì lạc đường, suýt nữa còn bị đóng băng, may mà gặp được bạn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200411
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200411,
					"content": "Bây giờ tôi hối hận lắm... mà việc ủy thác cũng chưa hoàn thành nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200412
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200412,
					"content": "Nhà Lữ Hành... tôi thấy bạn có vẻ tương đối thông thuộc núi tuyết, có thể giúp tôi một chuyện không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200413
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200413,
					"content": "Nhờ bạn tìm giúp tôi một phần Thịt Tươi Lạnh là được, chỉ cần một phần thôi, là tôi có thể hoàn thành ủy thác này rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200414
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200414,
					"content": "Tôi biết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205200415
					]
				},
				{
					"id": 205200415,
					"content": "Tốt quá đi, vậy để tôi đánh dấu nơi xuất hiện của heo con đóng băng mà Harris nói lên bản đồ nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200416
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200416,
					"content": "Vậy tôi đến doanh trại dưới chân núi chờ tin tốt của bạn nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tommy"
				}
			]
		},
