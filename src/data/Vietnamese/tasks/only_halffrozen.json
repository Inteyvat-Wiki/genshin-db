				},
				{
					"id": 205200102,
					"content": "Bạn làm sao thế...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205200103
					]
				},
				{
					"id": 205200103,
					"content": "Nhờ... nhờ bạn giúp tôi tìm nguồn nhiệt nào đó...tôi...tôi lạnh...lạnh quá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200104
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200104,
					"content": "Hoặc, hoặc là... bạn giúp tôi tìm món gì đó nóng một chút cũng được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200105
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200105,
					"content": "Nhờ... nhờ bạn đó, tôi lạnh đến mức không chịu nổi nữa rồi...",
					"roleType": "TALK_ROLE_NPC",
