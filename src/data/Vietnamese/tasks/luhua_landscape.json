					"Vermeer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710060601,
					"content": "Bạn tìm thấy dụng cụ vẽ tranh chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060602
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060602,
					"content": "Tìm được rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060603
					]
				},
				{
					"id": 710060603,
					"content": "Đúng là tôi đã quên ở nơi vẽ rồi, mỗi khi tôi vẽ tranh thường có thói quen để những thứ đã dùng xuống đất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060604
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060604,
					"content": "Có lúc đi vội, liền bỏ lại rất nhiều thứ, cảm ơn bạn, nếu không tôi chắc lại phải về thành để mua dụng cụ vẽ tranh nữa rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060605
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060605,
					"content": "Bạn vẫn muốn ở đây vẽ tranh à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060606
					]
				},
				{
					"id": 710060606,
					"content": "Đừng nhắc nữa, tôi nghe người ta nói rằng đôi mắt của bức tượng này vốn có thể phát sáng, từ xa cũng có thể nhìn thấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060607
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060607,
					"content": "Bức tượng khổng lồ với đôi mắt sáng ngời, đứng bên vách núi... đây chắc chắn là mổ bức tranh đẹp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060608
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060608,
					"content": "Cuối cùng sau khi tôi đến đây, tượng thì vẫn còn nhưng không còn mắt phát sáng nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060609
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060609,
					"content": "Tôi cho rằng mình đã bỏ lỡ thời điểm đặc biệt hay là góc độ sai gì đó, vì vậy mới cứ ở đây lấy góc khắp nơi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060610
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060610,
					"content": "Nhưng... haiz, cho dù tôi lấy góc thế nào cũng đều không có manh mối...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060611
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060611,
					"content": "Thu hoạch duy nhất của tôi chính là tìm thấy thứ này dưới hồ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060612
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060612,
					"content": "Này... tôi cũng tìm thấy một cái...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060613
					]
				},
				{
					"id": 710060613,
					"content": "Í? Tôi xem nào, chúng thực sự giống nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060614
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060614,
					"content": "Thật kỳ lạ, ở phía sau còn khắc chữ, nối lại sẽ là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060615
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060615,
					"content": "\"Thạch quan yểm sài môn, dụ nhập nhu điểm tinh\"... điểm tinh? Là gì nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060616
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060616,
					"content": "Tôi cầm viên đá này cũng không làm gì, tặng cho bạn vậy, coi như là quà cảm ơn bạn đã giúp tôi tìm dụng cụ vẽ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060617
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060617,
					"content": "Phải rồi, tôi có một ý nghĩ, chỉ là đoán bừa thôi, bạn có cảm thấy hai viên đá này giống đôi mắt không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060618
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060618,
					"content": "Nếu thực sự là đôi mắt, vậy \"điểm tinh\" trong câu đố kia, có khi nào cũng có liên quan đến hai viên đá này?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060619
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060619,
					"content": "Hahaha, tôi chỉ nói bừa thôi, bạn đừng để ý nhé. Tôi phải tiếp tục đi tìm cảnh đây, cảm ơn bạn đã giúp tôi tìm lại dụng cụ vẽ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vermeer"
				}
			]
		},
