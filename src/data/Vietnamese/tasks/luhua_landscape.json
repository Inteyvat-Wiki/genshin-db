			"trigger": {
				"objectNames": [
					"Vermeer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710060101,
					"content": "Nguy to rồi, này làm sao vẽ nữa đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060102
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060102,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060103
					]
				},
				{
					"id": 710060103,
					"content": "Bạn... ôi, Nhà Lữ Hành. Là thế này, tôi vẫn luôn tìm đề tài ở xung quanh Lục Hoa Trì, muốn vẽ vài bức tranh đẹp mang về.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060104
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060104,
					"content": "Nhưng tôi vẫn chưa tìm được góc đẹp nên vẫn chưa vẽ được bức nào ưng ý...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060105
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060105,
					"content": "Và bởi vì tôi quá chú tâm vào việc lấy bối cảnh, đi đến đây mới phát hiện ra, hầu hết bút vẽ và màu của tôi đều không thấy đâu nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060106
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060106,
					"content": "Tôi nghĩ những thứ này chắc là rơi ở nơi mà tôi đã vẽ trước đây, bạn có thể giúp tôi đi tìm không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060107,
						710060110
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060107,
					"content": "Bạn đã vẽ tranh ở đâu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060108
					]
				},
				{
					"id": 710060108,
					"content": "Ừm, thực ra thì... tôi cũng không nhớ rõ, bởi vì mỗi khi chú tâm vào việc vẽ tranh tôi thường không chú ý đến xung quanh, nên không nhớ rõ vị trí chính xác nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060109
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060109,
					"content": "Tuy nhiên, ở quanh đây tôi mới chỉ vẽ hai bức tranh, tôi nghĩ có lẽ cũng chỉ ở hai nơi này thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060113
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060113,
					"content": "Bạn hãy cầm lấy hai bức tranh này, dụng cụ của tôi có lẽ là <color=#00E1FFFF>nằm ở nơi</color> tôi vẽ hai bức tranh này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060114
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060114,
					"content": "Tìm được rồi thì mang về cho tôi nhé, tôi phải ở đây xem lại... nhất định có góc đẹp hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060110,
					"content": "Thế nhưng, đi đâu tìm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060111
					]
				},
				{
					"id": 710060111,
					"content": "Mỗi khi chú tâm vào việc vẽ tranh tôi thường không chú ý đến xung quanh, nên không nhớ rõ vị trí chính xác nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060112
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060112,
					"content": "Nhưng ở quanh đây tôi mới chỉ vẽ hai bức tranh, tôi nghĩ có lẽ cũng chỉ ở hai nơi này thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060113
					],
					"speakerTitle": "Vermeer"
				}
			]
		},
