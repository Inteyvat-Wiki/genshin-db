				"points": []
			},
			"dialogs": [
				{
					"id": 710060201,
					"content": "Bạn tìm thấy dụng cụ vẽ tranh chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060202
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060202,
					"content": "Tìm được rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060203
					]
				},
				{
					"id": 710060203,
					"content": "Đúng là tôi đã quên ở nơi vẽ rồi, mỗi khi tôi vẽ tranh thường có thói quen để những thứ đã dùng xuống đất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060204
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060204,
					"content": "Có lúc đi vội, liền bỏ lại rất nhiều thứ, cảm ơn bạn, nếu không tôi chắc lại phải về thành để mua dụng cụ vẽ tranh nữa rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060205
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060205,
					"content": "Bạn vẫn muốn ở đây vẽ tranh à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060206
					]
				},
				{
					"id": 710060206,
					"content": "Đừng nhắc nữa, tôi nghe người ta nói rằng mắt của hai bức tượng này vốn có thể phát sáng, từ xa cũng có thể nhìn thấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060207
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060207,
					"content": "Bức tượng khổng lồ với đôi mắt sáng ngời, đứng bên vách núi... đây chắc chắn là một bức tranh đẹp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060208
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060208,
					"content": "Cuối cùng sau khi tôi đến đây, tượng thì vẫn còn nhưng không còn mắt phát sáng nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060209
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060209,
					"content": "Tôi cho rằng mình đã bỏ lỡ thời điểm đặc biệt hay là góc độ sai gì đó, vì vậy mới cứ ở đây lấy góc khắp nơi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060210
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060210,
					"content": "Nhưng... haiz, cho dù tôi lấy góc thế nào cũng đều không có manh mối...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060211
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060211,
					"content": "Thu hoạch duy nhất của tôi chính là tìm thấy thứ này trong đáy hồ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060212
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060212,
					"content": "Mặc dù không biết để làm gì, nhưng càng nhìn viên đá này, càng cảm thấy nó giống như mắt vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060213
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060213,
					"content": "Nhưng nếu thực sự là mắt, có lẽ vẫn còn một viên đá y hệt như vậy nữa, dẫu sao con người ta có hai mắt mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060214
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060214,
					"content": "Ôi, đây cũng do tôi đoán bừa thôi, bạn đừng để ý. Tôi lấy viên đá này cũng không làm được gì, tặng cho bạn vậy, coi như là quà cảm ơn bạn đã giúp tôi tìm dụng cụ vẽ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060215
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060215,
					"content": "Haiz, bức tượng có đôi mắt phát sáng... ở trong Lục Hoa Trì này, rốt cuộc có bí mật gì nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vermeer"
				}
			]
		},
