			},
			"dialogs": [
				{
					"id": 752780101,
					"content": "Hai, hai người! Xin hãy dừng bước!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780102
					],
					"speakerTitle": "\"Chiton\""
				},
				{
					"id": 752780102,
					"content": "Sao thế cô bé, em có chuyện gì à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780103,
					"content": "\"Mang theo kỳ tích của Guiztli sum suê, dùng Lửa Thánh thắp sáng nụ cười!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780104
					],
					"speakerTitle": "\"Chiton\""
				},
				{
					"id": 752780104,
					"content": "Ối? Hả?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780105,
					"content": "\"Với danh nghĩa Khu Nghỉ Dưỡng Nhàn Nhã, xin dâng lên điệu nhảy chào mừng. Tỏa sáng nào! Thần Tượng Pipilpan!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780106
					],
					"speakerTitle": "\"Chiton\""
				},
				{
					"id": 752780106,
					"content": "Ối! Lại là câu này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780107,
					"content": "#Ừm, là em, \"Chiton\" đây. Hihi, lâu rồi không gặp, {M#anh}{F#chị} {NICKNAME}, chị Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780108
					],
					"speakerTitle": "\"Chiton\""
				},
				{
					"id": 752780108,
					"content": "Thì ra là em à, \"Chiton\"? Tôi còn tưởng lại gặp phải tên đáng sợ nào nữa chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780109,
						752780110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780109,
					"content": "Có chuyện gì vui thế?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752780111
					]
				},
				{
					"id": 752780111,
					"content": "Hì hì, để em kể cho. Cha em chuẩn bị đích thân hướng dẫn em, muốn đào tạo em thành một nghệ sĩ biểu diễn tiêu chuẩn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780112
					],
					"speakerTitle": "\"Chiton\""
				},
				{
					"id": 752780112,
					"content": "Mặc dù ngoài miệng cha em khá hung dữ, nhưng trong lòng vẫn rất quan tâm đến em đấy! Đương nhiên, nếu không dạy mấy thứ kỳ lạ cho em thì sẽ tốt hơn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780113,
					"content": "Đúng rồi, cái này tặng cho hai người đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780114
					],
					"speakerTitle": "\"Chiton\""
				},
				{
					"id": 752780114,
					"content": "Là... trang phục biểu diễn của em à? Nhưng nếu không có thứ này thì em...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780115,
					"content": "Hì hì, đừng lo, cha đã làm cho em một bộ phù hợp với dáng người của em hơn rồi! Lần này chắc chắn em sẽ không ngã trên sân khấu nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780116
					],
					"speakerTitle": "\"Chiton\""
				},
				{
					"id": 752780116,
					"content": "#Còn trang phục biểu diễn ban đầu, em đã biến nó thành đồ trang trí. {F#Hai chị}{M#Anh chị} hãy nhận lấy nhé, xem như vật tượng trưng cho tình bạn của chúng ta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780117
					],
					"speakerTitle": "\"Chiton\""
				},
				{
					"id": 752780117,
					"content": "#Lần sau gặp lại, em sẽ mặc trang phục biểu diễn mới, dùng vũ đạo mới để chào đón cả hai! Vậy nên, sau này nhất định phải đến ủng hộ nhé, em sẽ đợi {F#hai chị}{M#anh chị}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780118
					],
					"speakerTitle": "\"Chiton\""
				},
				{
					"id": 752780118,
					"content": "Ừm, nhất định rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780119,
					"content": "\"Chiton\"! Phải về luyện tập thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780120,
					"content": "#Được rồi, không còn sớm nữa, em đi luyện tập cơ bắp đây! {M#Anh}{F#Chị} {NICKNAME}, chị Paimon, tạm biệt nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780121
					],
					"speakerTitle": "\"Chiton\""
				},
				{
					"id": 752780121,
					"content": "Ừm, tạm biệt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780122,
					"content": "(Sẽ đi thật sao?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752780123
					]
				},
				{
					"id": 752780123,
					"content": "Chắc chắn rồi! Đương nhiên... nếu lúc đó có thể xem một màn biểu diễn thần tượng \"bình thường\" thì càng tốt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780110,
					"content": "Dạo này thế nào?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752780111
					]
				}
			]
		}
	]
}