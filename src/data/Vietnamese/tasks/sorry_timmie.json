				},
				{
					"id": 200680402,
					"content": "Được rồi, bạn mang Bánh Khoai Tây Mondstadt này đến cho Timmie đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680403
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680403,
					"content": "Lần sau đừng làm... những chuyện không tốt như vậy nữa, thật sự là được không bằng mất...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680404
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680404,
					"content": "Hy vọng bạn nhớ những lời tôi nói, đừng để tôi và Timmie thất vọng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680405
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680405,
					"content": "Có điều... haiz, nếu ai cũng nhớ để cảnh báo, thì tu nữ Victoria sẽ không bận đến vậy...",
					"roleType": "TALK_ROLE_NPC",
