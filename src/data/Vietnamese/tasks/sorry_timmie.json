				},
				{
					"id": 200680502,
					"content": "Người mẹ mà Timmie nói...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680503
					]
				},
				{
					"id": 200680503,
					"content": "Là tôi. Tôi vẫn luôn chăm sóc những đứa trẻ cần được chăm sóc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680504
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680504,
					"content": "Timmie được tôi chăm sóc lâu nhất, cũng dần dần gọi tôi là mẹ Grace rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680505
					],
					"speakerTitle": "Grace"
				},
				{
