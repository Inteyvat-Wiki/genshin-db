			},
			"dialogs": [
				{
					"id": 200680101,
					"content": "Chà, vậy phải làm sao đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680102
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680102,
					"content": "Ơ, có chuyện gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680103
					]
				},
				{
					"id": 200680103,
					"content": "Là bạn sao, bạn đến đúng lúc lắm. Timmie đã nói những chuyện bạn làm với đàn vịt cho tôi nghe rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680104
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680104,
					"content": "Bạn... Bạn...Ừm, tôi phải nói bạn thế nào đây, chuyện của bạn cũng không phải tôi chưa từng nghe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680105
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680105,
					"content": "Sự can đảm và sức mạnh của bạn... sao có thể dùng ở những nơi này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680106,
						200680107,
						200680108
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680106,
					"content": "Thật sự là quá đói...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680109
					]
				},
				{
					"id": 200680109,
					"content": "Bạn... Nếu thật sự đói quá, thì có thể làm việc nghiêm túc để kiếm tiền mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680110
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680110,
					"content": "Với thực lực của bạn, chắc chắn có thể có được một chỗ đứng ở Hiệp Hội Nhà Mạo Hiểm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680113
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680113,
					"content": "Haiz, chuyện đã xảy ra rồi, nói nhiều vô ích, Timmie đã không vui vì chuyện này lâu lắm rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680114
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680114,
					"content": "Tôi từng học một món từ chỗ bố... của Timmie. Bánh Khoai Tây Mondstadt cho thêm Nấm Rơm Gió, là món ăn mà Timmie thích nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680115
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680115,
					"content": "Hãy giúp tôi tìm 3 Nấm Rơm Gió, được ăn món đó, có lẽ tâm trạng của Timmie sẽ tốt hơn... Và bạn cũng có thể xin lỗi Timmie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680116,
						200680117
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680116,
					"content": "Được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680118
					]
				},
				{
					"id": 200680118,
					"content": "Bạn đi sớm về sớm nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680120
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680120,
					"content": "Nấm Rơm Gió à... Tôi nhớ dưới mái hiên của ngôi nhà ở phía nam thành phố có lẽ có một ít.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680121
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680121,
					"content": "Bạn đi sớm về sớm nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680117,
					"content": "Bao nhiêu Nấm Rơm cũng được!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680119
					]
				},
				{
					"id": 200680119,
					"content": "3 cái là đủ rồi. Bạn lấy nhiều như vậy, lẽ nào là để lần sau chọc giận Timmie lại lấy ra dùng?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680120
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680107,
					"content": "Chỉ là lỡ tay...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680111
					]
				},
				{
					"id": 200680111,
					"content": "Lỡ tay động vào bồ câu và vịt? Vậy những kẻ địch mà bạn gặp, chắc cũng là lỡ tay đánh bại nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680113
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680108,
					"content": "Sức mạnh chính là đến từ sự tích lũy thông thường này.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680112
					]
				},
				{
					"id": 200680112,
					"content": "Bạn... bạn, tôi... Bỏ đi, có vẻ như sức mạnh của bạn thật sự toàn diện...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680113
					],
					"speakerTitle": "Grace"
				}
			]
		},
