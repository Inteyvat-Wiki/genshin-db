			"dialogs": [
				{
					"id": 200680301,
					"content": "...Ăn đi, ăn đi, ăn xong rồi thì đi nhanh đi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680302,
						200680303,
						200680304
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200680302,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680305
					]
				},
				{
					"id": 200680305,
					"content": "#Sao lại là {F#chị}{M#anh}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680308
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200680308,
					"content": "#Rốt cuộc {F#chị}{M#anh} muốn làm gì, lẽ nào vẫn muốn ra tay với vịt và bồ câu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680309,
						200680310
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200680309,
					"content": "Bánh khoai tây này là cho em đó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680311
					]
				},
				{
					"id": 200680311,
					"content": "#Bánh khoai tây! Ơ, sao {F#chị}{M#anh} lại biết cách làm bánh khoai tây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680312
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200680312,
					"content": "#Em biết rồi, chắc chắn là {F#chị}{M#anh} đi tìm mẹ Grace...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680313
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200680313,
					"content": "#Hừm, muốn lấy thứ này để mua chuộc em, nằm mơ đi, chuyện {F#chị}{M#anh} làm với đàn vịt và bồ câu, em biết rõ hơn ai hết!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680314
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200680314,
					"content": "#... Nhưng mà, mẹ Grace bảo {F#chị}{M#anh} mang bánh khoai tây đến, chắc chắn là không muốn em tiếp tục gây rắc rối.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680315
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200680315,
					"content": "Bà còn phải chăm sóc Nora và Glory, em lại gây thêm rắc rối cho bà, thật là không hiểu chuyện mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680316
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200680316,
					"content": "#Nhưng nói trước, em chưa tha thứ cho {F#chị}{M#anh} đâu! Chỉ là không muốn gây thêm rắc rối cho mẹ nữa, biết chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680317
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200680317,
					"content": "#Hừm, có điều... dù sao em cũng chỉ là một đứa trẻ, những lời hứa này, chắc chắn {F#chị}{M#anh} sẽ quên thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680318
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200680318,
					"content": "#Đợi ba em về, em sẽ nói chuyện của {F#chị}{M#anh} với ông ấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200680310,
					"content": "Cầm lấy phần Bánh Khoai Tây này đi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680311
					]
				},
				{
					"id": 200680303,
					"content": "Timmie, cái đó...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680306
					]
				},
				{
					"id": 200680306,
					"content": "#Sao lại là {F#chị}{M#anh}? Rốt cuộc là có chuyện gì!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680308
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200680304,
					"content": "Sao, đã xảy ra chuyện gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680307
					]
				},
				{
					"id": 200680307,
					"content": "#{F#Chị}{M#Anh} còn dám hỏi em!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680308
					],
					"speakerTitle": "Timmie"
				}
			]
		},
