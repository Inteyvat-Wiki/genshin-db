			"dialogs": [
				{
					"id": 706960101,
					"content": "Lâu rồi không gặp nhỉ, bé cưng. Dạo này đi du lịch ở đâu thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706960102
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 706960102,
					"content": "Kể cho Miko về những chuyện đã thấy ở núi tuyết.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						706960103
					]
				},
				{
					"id": 706960103,
					"content": "Ừm, đúng là những đứa trẻ đáng yêu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706960104
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 706960104,
					"content": "Vì sở thích chung, dù cách xa đến đâu cũng phải gặp nhau... Ôi, hơi thở thanh xuân thật sự đang tràn ngập nơi đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706960105
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 706960105,
					"content": "Có vẻ \"Chiến Ký Đấu Sĩ Lửa\" khá hấp dẫn đấy nhỉ, đến lúc đưa kế hoạch tái bản vào lịch trình rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706960106
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 706960106,
					"content": "Độc giả chân thành như vậy, cũng phải bày tỏ chút tấm lòng mới được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706960107
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 706960107,
					"content": "Tặng mấy cưng vài cuốn truyện tranh nhé? Ừm... Cũng không ít người, chắc phải tặng thêm vài cuốn nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706960108,
						706960109
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 706960108,
					"content": "Cảm ơn nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706960110
					]
				},
				{
					"id": 706960110,
					"content": "Toàn bộ đều là ấn bản đầu tiên, ở ngoài không thể mua được đâu, hãy trân trọng nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 706960109,
					"content": "Tôi sẽ chia sẻ với mọi người.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706960110
					]
				}
