					"nextDialogs": [
						710980711
					]
				},
				{
					"id": 710980711,
					"content": "Vậy chúng ta đi hỏi thử đi! Nói không chừng thì họ đang chuẩn bị nghiên cứu món ăn mới nào đó, vậy là chúng ta sẽ có thể ăn thử rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980712,
					"content": "Chúng ta đi hỏi thử xem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980713
					]
				},
				{
					"id": 710980713,
