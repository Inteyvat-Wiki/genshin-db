						710980927
					]
				},
				{
					"id": 710980927,
					"content": "Cho chúng tôi mượn bếp đã là bước nhượng bộ lớn nhất của anh ấy rồi đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980928
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980928,
					"content": "Nhà lữ hành, chuyện nấu Canh Rau Củ nhờ vào bạn nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
