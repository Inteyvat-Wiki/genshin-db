					"nextDialogs": [
						710981304
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710981304,
					"content": "Sau đó, \"Máy Đánh Số\" của tôi sẽ có thể tính ra được những con số vĩ đại hơn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981305
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710981305,
