			"dialogs": [
				{
					"id": 710981301,
					"content": "Tham số này... không đúng, không đúng, cần phải điều chính lại cách tính...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981302
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710981302,
					"content": "Ông chủ à, chúng ta cần phải tiết kiệm chi phí rồi đó, không thôi sẽ không đủ lộ phí để đến Sumeru đâu.",
					"roleType": "TALK_ROLE_NPC",
