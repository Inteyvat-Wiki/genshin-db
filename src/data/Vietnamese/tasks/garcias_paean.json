			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lutong",
					"Garcia",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710980101,
					"content": "Ông chủ à, điều đáng phải nói là tính luôn hôm nay thì chúng ta đã ăn Canh Rau Củ liên tục sáu ngày rồi đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980102
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980102,
					"content": "Nên hiện giờ ngoài khó khăn về tiền bạc ra, bao tử của tôi cũng hơi bị khó khăn rồi đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980103
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980103,
					"content": "Anh nói rất đúng! Rất chính xác, Lutong à, lời nói của anh rất tinh tế đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980104
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980104,
					"content": "Có thể do chúng ta có vấn đề về bao tử nên mới không thể phán đoán chính xác được mùi vị của món ăn này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980105
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980105,
					"content": "Chúng ta cần phải đi tìm bên chứng thực thứ ba đấy Lutong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980106
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980106,
					"content": "Cảm ơn lời khen của anh, nhưng ý tôi không phải thế...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980107,
						710980108
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980107,
					"content": "Cho hỏi hai anh đang làm gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980109
					]
				},
				{
					"id": 710980109,
					"content": "À... haha! Người chứng thực của chúng ta đến rồi này! Thật tốt quá! Thậm chí còn đến cả hai người luôn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980110
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980110,
					"content": "Hả? Sao, sao? Người chứng thực?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980111,
					"content": "Anh đang nói chúng tôi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980112
					]
				},
				{
					"id": 710980112,
					"content": "Đúng vậy, bạn đã ăn qua Canh Rau Củ chưa? Có biết được mùi vị của nó không? Có biết cách làm không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980113
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980113,
					"content": "Ông chủ à, anh phải nói rõ ngọn nguồn ra đã chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980114
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980114,
					"content": "#À ừm... Từng ăn rồi! {NICKNAME} biết cách làm này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980115,
					"content": "Paimon, chúng ta phải lắng nghe nguyên do sự việc đã...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980116
					]
				},
				{
					"id": 710980116,
					"content": "Để tôi kể lại cho, nhưng chúng tôi hy vọng các bạn có thể nhận ủy thác này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980117
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980117,
					"content": "Tôi là Lutong, vị này là ông chủ của tôi, ngài Garcia, đến từ Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980118
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980118,
					"content": "Ngài Garcia đang nghiên cứu một loại... ừm... được anh ấy gọi là \"Máy Đánh Số\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980119
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980119,
					"content": "Cụ thể mà nói thì đó là một loại công cụ có thể giúp con người tính toán các loại số liệu khác nhau, tôi nói đúng chứ ông chủ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980120
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980120,
					"content": "Rất chính xác, Lutong thân mến, tính năng của \"Máy Đánh Số\" đơn giản như vậy đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980121
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980121,
					"content": "Đúng, phải đơn giản... cần phải đơn giản, việc chuyển hóa nó đã đủ phức tạp rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980122
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980122,
					"content": "Nhưng mà nó thì có liên quan gì đến Canh Rau Củ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980123,
					"content": "Phần này thì để cho ngài Garcia giải thích nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980124
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980124,
					"content": "Nhưng phải làm sao để đơn giản hóa... À! Đúng rồi, không vấn đề gì cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980125
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980125,
					"content": "Chậc... chúng ta bắt đầu nói từ thứ đơn giản trước nhé, các bạn biết \"công thức\" là gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980126
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980126,
					"content": "Công thức? Ừm... chưa nghe qua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980127,
					"content": "Không hiểu lắm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980128
					]
				},
				{
					"id": 710980128,
					"content": "Được rồi... không sao, các bạn có thể hiểu công thức chính là... ừm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980129
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980129,
					"content": "Một... một phương trình được sử dụng để biểu thị mối quan hệ giữa các đại lượng khác nhau và có một khả năng ứng dụng chung nhất định...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980130
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980130,
					"content": "Hả? Hả...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980131,
					"content": "Nghe lợi hại thật...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980132
					]
				},
				{
					"id": 710980132,
					"content": "Nói một cách đơn giản thì chúng tôi đang dùng Máy Đánh Số này để viết ra công thức chế biến Canh Rau Củ này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980133
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980133,
					"content": "Ngài Garcia tin rằng, chỉ cần tìm đúng được công thức thì chúng ta sẽ có thể chuyển cách làm Canh Rau Củ thành một loại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980134
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980134,
					"content": "Một loại \"lưu trình chung\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980135
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980135,
					"content": "Một loại \"lưu trình ngơ\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980136
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980136,
					"content": "Chỉ cần thao tác theo lưu trình đó thì cho dù là ai cũng có thể làm ra Canh Rau Củ thơm ngon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980137
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980137,
					"content": "Nghe phức tạp thật... sao không tìm người để hỏi luôn cách làm luôn đi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980138,
					"content": "Cách làm này... thật là thách thức tài năng của con người quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980139
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980139,
					"content": "Như tôi và ngài Garcia đây không ai có năng khiếu nấu nướng cả, cho dù là đầu bếp có chỉ dạy cẩn thận đến đâu cũng không thể học được tinh túy trong đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980140
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980140,
					"content": "Điểm này tôi tin là đầu bếp Yanxiao của nhà trọ này rất thấu hiểu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980141,
						710980143
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980141,
					"content": "Vậy các anh muốn chúng tôi giúp tính \"công thức\" sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980142
					]
				},
				{
					"id": 710980142,
					"content": "Đương nhiên là không rồi, tôi sẽ không lấy chuyện này ra để làm khó bạn đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980145
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980145,
					"content": "Chính xác mà nói thì chúng tôi hy vọng bạn có thể làm \"bên chứng thực thứ ba\" của chúng tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980146
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980146,
					"content": "Theo thông lệ thì có nghĩa là mời bạn nếm thử Canh Rau Củ mà ngài Garcia đã làm theo công thức, sau đó cho đánh giá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980147
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980147,
					"content": "Nói một cách đơn giản thì là muốn chúng tôi ăn thử đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980148
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980148,
					"content": "Paimon tổng kết hơi bị gọn đấy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980149
					]
				},
				{
					"id": 710980149,
					"content": "Được rồi, dù gì thì tôi cũng chưa thử qua Canh Rau Củ làm theo cách này, vậy thì chúng tôi sẽ thử xem sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980150
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980150,
					"content": "Quyết định vậy nhé, tôi vừa mượn bếp của Yanxiao, chúng ta qua đó đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980151
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980151,
					"content": "Ngài Garcia? Chúng ta vẫn thử nghiệm dựa trên các bước trước đó chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980152
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980152,
					"content": "Hả? A! Xin lỗi, ban nãy tôi hơi mơ màng chút...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980153
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980153,
					"content": "Những tham số đó cứ nhảy múa trong đầu tôi... Đúng vậy, theo ba bước trước đó để làm nhé.",
