			"dialogs": [
				{
					"id": 710981501,
					"content": "Vị không tệ nhưng hoàn toàn khác với Canh Rau Củ của Yanxiao làm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981502
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710981502,
					"content": "Tôi rất hiếu kỳ, bạn... bạn làm món này như thế nào? Nguyên liệu bỏ bao nhiêu? Gia vị cho như thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981503,
						710981504
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710981503,
					"content": "Đừng, đừng đến gần quá!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710981505
					]
				},
				{
					"id": 710981505,
					"content": "À xin lỗi, nhưng bạn có thể nói chi tiết cho tôi nghe không, cách làm của bạn nói không chừng có thể cho tôi chút cảm hứng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981506
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710981506,
					"content": "Nhà Lữ Hành kể lại cách nấu Canh Rau Củ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710981507
					]
				},
				{
					"id": 710981507,
					"content": "Hóa ra là vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981508
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710981508,
					"content": "Haiz, mùi vị của một món ăn đúng là có nhiều biến số ảnh hưởng quá, nếu muốn tính toán tỉ mỉ thì cần phải lập ra thêm nhiều phép tính nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981509
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710981509,
					"content": "Nhưng mà, nhiều phép tính quá thì có nghĩa là tôi cần phải cải tiến Máy Đánh Số...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981510
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710981510,
					"content": "Hy vọng tài liệu trong thư viện của Giáo Viện có thể cho tôi chút cảm hứng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981511
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710981511,
					"content": "Sao anh lại phải chế tạo Máy Đánh Số?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710981512
					]
				},
				{
					"id": 710981512,
					"content": "Ừm, đây là một câu hỏi hay, nhưng trước khi tôi trả lời thì tôi phải hỏi bạn một câu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981513
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710981513,
					"content": "Bạn cảm thấy, Máy Đánh Số mà tôi chế tạo có phải đã có \"tư duy\" trong đó không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981514,
						710981515
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710981514,
					"content": "Hỏi như vậy là sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710981516
					]
				},
				{
					"id": 710981516,
					"content": "Đúng vậy, bạn suy nghĩ câu hỏi này trước nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981517
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710981517,
					"content": "Đợi lần tới chúng ta gặp lại thì chúng ta có thể ngồi thảo luận hai vấn đề này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981518
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710981518,
					"content": "Còn bây giờ thì, tôi phải đi chỉnh sửa số liệu mới được... Nào Lutong, bắt đầu làm việc thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981519
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710981519,
					"content": "Vâng, thưa ngài.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981520
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710981520,
					"content": "Hãy nhận lấy thứ này nhé Nhà Lữ Hành. Ngài Garcia là như vậy đó, đừng lấy làm lạ nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981521
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710981521,
					"content": "Các anh muốn đến Sumeru sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710981522
					]
				},
				{
					"id": 710981522,
					"content": "Đúng vậy, ngài Garcia muốn đến Giáo Viện để đọc tài liệu, còn tôi được thuê để đi chung với ngài ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981523
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710981523,
					"content": "Tạm biệt Nhà Lữ Hành. Nếu chúng ta có thể gặp nhau ở Sumeru thì tôi chắc chắn sẽ rất vui, tôi nghĩ ngài Garcia cũng sẽ như thế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710981515,
					"content": "Máy Đánh Số... có \"tư duy\"?",
