					"nextDialogs": [
						230410305
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410305,
					"content": "Chẳng phải Raef đã tặng tôi một bộ dụng cụ làm vườn, còn có cả phân bón sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410306
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410306,
					"content": "Nếu chỉ trồng một bồn hoa thì tôi thấy quá lãng phí... Vì thế, tôi nhờ Azalai mua giúp tôi một ít hạt giống bạc hà về.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410307
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410307,
					"content": "Sau khi trồng hạt giống bạc hà, tôi chăm sóc nó như chăm sóc bồn hoa vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410308
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410308,
					"content": "Chăm mãi chăm mãi, bạc hà đã mọc lên nhanh chóng...",
