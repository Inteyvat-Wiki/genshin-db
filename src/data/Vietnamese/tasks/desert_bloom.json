			"dialogs": [
				{
					"id": 230410101,
					"content": "Phù... Xới đất như này chắc được rồi nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410102
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410102,
					"content": "Cô vẫn đang chăm sóc bồn hoa đó sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410103
					]
				},
				{
					"id": 230410103,
					"content": "Ừm, bà Kulsoom dạy tôi rất nhiều cách để chăm sóc cho hoa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410104
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410104,
					"content": "Ví dụ như phải xới đất cho nó, cắt tỉa lá đúng lúc, diệt côn trùng bằng nhiều cách...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410105
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410105,
					"content": "Còn nữa, tưới nước không thể tưới quá nhiều, nếu không rễ của cây sẽ bị úng nước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410106
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410106,
					"content": "Haiz, tôi còn tưởng phải tưới nước mỗi ngày để luôn đảm bảo cho đất ẩm mềm chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410107
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410107,
					"content": "Có điều như vậy cũng tốt, tôi không cần phải đi lấy nước mỗi ngày, chỗ lấy nước cách đây cũng khá xa nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410108
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410108,
					"content": "Tôi phải tiếp tục cắt tỉa lá đây. Nhà Lữ Hành, bạn có thể lấy giúp tôi một bình nước nhỏ không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410109
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410109,
					"content": "Tôi đã nói với Kazan rồi, anh ấy đồng ý cho tôi lấy nước tưới cây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410110,
						230410111
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410110,
					"content": "Cứ giao cho tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410114
					]
				},
				{
					"id": 230410114,
					"content": "Bình nước ở bên đó kìa. Khi bạn lấy nước nhớ chú ý, đừng để bị trộn lẫn đất cát nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410111,
					"content": "Đây đều là những lời bà Kulsoom nói với cô ư?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410112
					]
				},
				{
					"id": 230410112,
					"content": "Ừm... Đúng vậy, bà Kulsoom biết rất nhiều thứ, tôi thường tìm bà ấy để xin ý kiến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410113
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410113,
					"content": "Vậy nhờ vào bạn nhé, Nhà Lữ Hành, chỉ cần lấy một bình nước nhỏ là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410114
					],
					"speakerTitle": "Nermin"
				}
			]
		},
