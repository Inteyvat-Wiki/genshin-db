					"Nermin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230410201,
					"content": "Ôi... Lại có mấy chiếc lá bị gặm rách rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410202
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410202,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410203
					]
				},
				{
					"id": 230410203,
					"content": "Nhà Lữ Hành, bạn nhìn đi! Có mèo con đến cắn hoa này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410204
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410204,
					"content": "Bạn nhìn chiếc lá này đi, chiếc này... cả chiếc lá này nữa! Đều bị gặm một miếng to đùng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410205,
						230410208
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410205,
					"content": "Mèo con đói rồi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410206
					]
				},
				{
					"id": 230410206,
					"content": "Raef cũng nói vậy, anh ấy chuyên mang đồ ăn cho mèo ăn đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410207
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410207,
					"content": "Nhưng hôm sau vẫn có mèo con tới cắn hoa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410210
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410210,
					"content": "Bây giờ mèo con chỉ cắn lá, nhưng tôi sợ có một ngày nào đó mèo con sẽ bắt đầu cắn cành hoa luôn ấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410211
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410211,
					"content": "Có điều, tôi cũng không nhẫn tâm đuổi chúng đi, dù sao ngoài kia cũng là sa mạc, ngoài cái làng này ra thì nó cũng chẳng có nơi nào để đi cả...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410212
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410212,
					"content": "Nhà Lữ Hành, bạn có thể giúp tôi cho nó ăn không? Hy vọng sau khi mèo con ăn no sẽ không cắn hoa nữa, lá hoa cũng không phải là thức ăn ngon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410213,
						230410214
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410213,
					"content": "Cứ giao cho tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410216
					]
				},
				{
					"id": 230410216,
					"content": "Vậy nhờ vào bạn nhé, Nhà Lữ Hành, tôi đã đánh dấu trên bản đồ nơi mèo con thường ở rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410217
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410217,
					"content": "Tôi phải canh bên bồn hoa, để tránh lại có mèo con khác tới cắn hoa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410214,
					"content": "Tôi rất giỏi giao tiếp với mèo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410215
					]
				},
				{
					"id": 230410215,
					"content": "Vậy thì quá tốt rồi! Mỗi lần thấy móng vuốt mèo, tôi đều lo nó đột nhiên sẽ lao tới cào tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410216
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410208,
					"content": "Mèo con... cắn chơi nhỉ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410209
					]
				},
				{
					"id": 230410209,
					"content": "Tôi không biết mèo con thích chơi cái gì nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410210
					],
					"speakerTitle": "Nermin"
				}
			]
		},
