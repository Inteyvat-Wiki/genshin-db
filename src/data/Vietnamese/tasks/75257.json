			"dialogs": [
				{
					"id": 752570101,
					"content": "Người trẻ tuổi, không phải nơi này rất tốt sao? Sao lại không thể kinh doanh chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570102
					],
					"speakerTitle": "Xoma"
				},
				{
					"id": 752570102,
					"content": "Xin lỗi quý khách, trợ lý khung cảnh của hạng mục này hôm qua hơi quá chén, hôm nay không đến làm được, ngày mai hãy quay lại nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570103
					],
					"speakerTitle": "Yiztli"
				},
				{
					"id": 752570103,
					"content": "Bà già này đã lớn tuổi rồi, ngày mai còn phải đi xa như vậy nữa thì sợ là không chịu nổi đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570104
					],
					"speakerTitle": "Xoma"
				},
				{
					"id": 752570104,
					"content": "Đúng vậy, ngày mai mọi người đều có việc khác mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570105
					],
					"speakerTitle": "Inti"
				},
				{
					"id": 752570105,
					"content": "Rất xin lỗi, nét đặc sắc của Góc Chụp Ảnh Mùa Hè chính là có thể tạo ra bối cảnh chụp ảnh mà khách hàng yêu thích.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570106
					],
					"speakerTitle": "Yiztli"
				},
				{
					"id": 752570106,
					"content": "Hiện giờ trợ lý khung cảnh không có ở đây, thật sự là không thể tiếp tục được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570107
					],
					"speakerTitle": "Yiztli"
				},
				{
					"id": 752570107,
					"content": "Có cần tôi giúp đỡ không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752570108
					]
				},
				{
					"id": 752570108,
					"content": "Ấy? Hai vị đồng ý giúp sao? Tôi đang cần người giúp lắm. Nội dung không phức tạp đâu, chỉ cần bố trí bối cảnh chụp ảnh theo yêu cầu của khách là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yiztli"
				}
			]
		},
		{
			"id": 7525702,
