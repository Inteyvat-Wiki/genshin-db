			"dialogs": [
				{
					"id": 752570701,
					"content": "Cuối cùng cũng xong. May nhờ có hai vị giúp đỡ, nếu không thì chắc là tôi đã bị khiếu nại rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570702
					],
					"speakerTitle": "Yiztli"
				},
				{
					"id": 752570702,
					"content": "Đừng khách sáo, hihi. Chúng tôi là những nhà mạo hiểm nhiệt tình nhất mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752570703
					]
				},
				{
					"id": 752570703,
					"content": "Nhà mạo hiểm sao? Vậy hay là để tôi chụp cho hai vị một tấm nhé? Ghi lại dáng vẻ nhiệt tình của hai vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570704
					],
					"speakerTitle": "Yiztli"
				},
				{
					"id": 752570704,
					"content": "Nào, cười lên nào! Natlan nhàn nhã, mùa hè nhàn nhã!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570705
					],
					"speakerTitle": "Yiztli"
				},
				{
					"id": 752570705,
					"content": "Cảm ơn, những thứ này cũng nhận lấy nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yiztli"
				}
			]
		},
