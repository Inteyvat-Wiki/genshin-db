			"dialogs": [
				{
					"id": 752570801,
					"content": "Cảnh trước chụp rất đẹp đấy. Cuối cùng là anh chàng bảnh bao này, anh muốn chụp gì nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570802
					],
					"speakerTitle": "Yiztli"
				},
				{
					"id": 752570802,
					"content": "Nói hay lắm, từ khi sinh ra đến nay, tôi luôn đặt khí chất và phong thái lên hàng đầu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570803
					],
					"speakerTitle": "Inti"
				},
				{
					"id": 752570803,
					"content": "Con người mà không có phong thái thì không nho nhã, không có khí chất thì không sang trọng. Các vị hiểu yêu cầu của tôi rồi chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570804
					],
					"speakerTitle": "Inti"
				},
				{
					"id": 752570804,
					"content": "Hmm... Để tôi suy nghĩ đã... Ừm, chúng ta bắt đầu đi!",
