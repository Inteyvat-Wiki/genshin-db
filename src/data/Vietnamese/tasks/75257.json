			"dialogs": [
				{
					"id": 752570301,
					"content": "Cảnh trước chụp rất đẹp đấy! Tiếp theo là vị Fatui này, anh muốn chụp gì nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570302
					],
					"speakerTitle": "Yiztli"
				},
				{
					"id": 752570302,
					"content": "Hãy chụp tôi như một tay thiện xạ, vừa nhìn đã biết là bách phát bách trúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570303
					],
					"speakerTitle": "Wechtekah"
				},
				{
					"id": 752570303,
					"content": "Như vậy tôi sẽ không cần phiền não vì xếp bét trong cuộc thi bắn súng nữa.",
					"roleType": "TALK_ROLE_NPC",
