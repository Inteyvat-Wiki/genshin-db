				"objectNames": [
					"Molli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741510301,
					"content": "#Chị Paimon, {M#anh}{F#chị} {NICKNAME}, em đã cho Nana ăn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510302
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510302,
					"content": "Được rồi, vậy chúng ta cùng nhau gõ cửa tìm ông Leroy đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510303,
					"content": "Nhưng em hơi lo, không biết ông ấy có ra ngoài được không... Dạo này em đến tìm thì ông Leroy đều không nói chuyện với em.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510304
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510304,
					"content": "#Trước khi {F#hai chị}{M#anh chị} đến thì em có gõ cửa, ông ấy vừa ra ngoài thì đã bị ông anh hung dữ kia kéo lại vào trong rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510305
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510305,
					"content": "Anh trai hung dữ kia cho em ít kẹo rồi bảo em về nhà, sau đó đóng cửa lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510306
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510306,
					"content": "Ông Benoit rõ ràng rất thân thiện, nhưng sao người nhà ông ấy lạnh lùng thế nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510307,
					"content": "Anh trai đó bảo ông Leroy bị bệnh, không tiện gặp, nhưng em thấy ông ấy rất khỏe mà, tại sao lại không nói chuyện với em được chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510308
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510308,
					"content": "Chị Paimon, bài văn không viết được cũng không sao, hiện giờ em lo lắng cho ông Leroy hơn đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510309
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510309,
					"content": "Nếu ông ấy bị bệnh thì chắc là khó chịu lắm. Mẹ em từng nói người bị bệnh đáng thương lắm, phải được quan tâm nhiều hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510310
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510310,
					"content": "#{F#Hai chị}{M#Anh chị} có thể đi với em để hỏi anh trai kia được không? Xem thử xem ông Leroy bị bệnh gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510311
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510311,
					"content": "Không biết do ăn nhiều đồ ngọt hay ngủ không đắp chăn nhỉ? Để em về nhà hỏi cha mẹ xem nên làm gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510312,
						741510313
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510312,
					"content": "Cùng nhau gõ cửa nào.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510314
					]
				},
				{
					"id": 741510314,
					"content": "#Em hơi sợ anh trai kia, {F#hai chị}{M#anh chị} nói chuyện giúp em nhé? Anh ấy dữ lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510315
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510315,
					"content": "#Molli đừng sợ, {F#hai chị}{M#anh chị} sẽ hỏi hộ em.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510313,
					"content": "Ừm, chúng ta đã hứa rồi mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510314
					]
				}
			]
		},
		{
