			"dialogs": [
				{
					"id": 741500501,
					"content": "Cha, dạo này giấc ngủ của cha sao rồi? Còn mất ngủ không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500502
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500502,
					"content": "Cha đỡ nhiều rồi, dạo này ít khi gặp ác mộng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500503
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500503,
					"content": "(Cuộc nói chuyện của nhà Leroy dần nghe không rõ nữa...)",
