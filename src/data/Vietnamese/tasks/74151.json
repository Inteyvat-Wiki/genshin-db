			"dialogs": [
				{
					"id": 741510501,
					"content": "Athos mà mọi người gặp qua trước đó, mở cửa đi ra.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741510502
					]
				},
				{
					"id": 741510502,
					"content": "Lại là mấy người sao? Mấy người đến đây làm gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510503
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741510503,
					"content": "Cho hỏi ông Benoit có nhà không? Chúng tôi nghe nói ông ấy bị bệnh nên lo cho sức khỏe ông ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510504,
					"content": "Cha tôi ở trong nhà, nhưng sức khỏe ông ấy không ổn lắm, không tiếp khách được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510505
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741510505,
					"content": "Có thể nói cho em biết ông ấy bị bệnh gì không? Để em bảo cha mẹ mang thuốc tới cho ông Leroy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510506
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510506,
					"content": "Không cần đâu, anh tự mua được, với lại cha anh cũng không hề thiếu thuốc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510507
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741510507,
					"content": "Chúng tôi chỉ quan tâm người bệnh một chút thôi, sao anh lạnh lùng thế...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510508,
					"content": "(Tên Athos này không muốn cho chúng ta gặp ông Benoit!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510509,
						741510510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510509,
					"content": "(Lạnh lùng hơi quá đà rồi...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510511
					]
				},
				{
					"id": 741510511,
					"content": "Các người lo chuyện bao đồng nhiều quá rồi đấy. Được rồi, còn chuyện gì khác không? Không còn thì tôi vào nhà đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510512
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741510512,
					"content": "Chờ chút đã.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510513
					]
				},
				{
					"id": 741510513,
					"content": "Muốn gì đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510514,
						741510516
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741510514,
					"content": "Ông Benoit bị bệnh thật sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510515
					]
				},
				{
					"id": 741510515,
					"content": "Tất nhiên, bị bệnh rất nặng đấy. Tôi và Morticia đang nghĩ cách đây. Việc này không cần người khác phải phiền lòng đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510518
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741510518,
					"content": "Athos, sao bên ngoài ồn ào thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510519
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741510519,
					"content": "Không có gì đâu Morticia, bên ngoài có mấy người đòi vào thăm cha thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510520
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741510520,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510521
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741510521,
					"content": "Cha à, họ thích cha thật đấy nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510522
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741510522,
					"content": "Cha có muốn ra ngoài chào hỏi đôi câu không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510523
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741510523,
					"content": "Để cha ra ngoài xem thử... được chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510524
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741510524,
					"content": "Tất nhiên là được rồi, tùy theo ý cha thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510525
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741510525,
					"content": "Cánh cửa mở ra, ông Benoit từ từ bước ra ngoài.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						741510526
					]
				},
				{
					"id": 741510526,
					"content": "Những vị khách bé nhỏ lại đến rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510527
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741510527,
					"content": "Ông Leroy, ông có khỏe không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510528
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510528,
					"content": "Ông ư? ...Khụ, tình trạng sức khỏe của ông không tốt lắm, nhưng đừng lo, ông đang tịnh dưỡng rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510529
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741510529,
					"content": "Con gái và con rể rất tốt với ông. Mọi thứ đều tốt, các cháu về nhà đi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510530
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741510530,
					"content": "Cha, sức khỏe của cha không sao chứ? Nếu thấy không ổn thì vào trong thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510531
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741510531,
					"content": "Benoit nhìn ánh mắt của Athos, sau đó im lặng bước vào trong.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741510532
					]
				},
				{
					"id": 741510532,
					"content": "Được rồi, mọi người cũng thấy rồi đó, sức khỏe của cha tôi rất không ổn đấy, vừa lòng chưa? Không có việc gì thì tôi về đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510533
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741510533,
					"content": "Chúng tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510534
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510534,
					"content": "Athos mặc kệ các bạn.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741510535
					]
				},
				{
					"id": 741510535,
					"content": "Lần này chỉ nói được vài câu với ông Leroy... Haiz, hy vọng ông ấy mau khỏe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510536
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510536,
					"content": "Chị Paimon ơi, hình như em lại gây phiền phức cho người khác rồi. Thật ra em không muốn như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510537
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510537,
					"content": "Tại sao lại nghĩ như vậy chứ? Em không hề gây phiền phức cho người khác đâu, theo chị thì người có vấn đề chính là tên Athos kia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510538
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510538,
					"content": "Hừ... Anh ta từ đầu đến cuối cứ nói là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510539,
						741510540
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510539,
					"content": "Molli về nhà trước đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510541
					]
				},
				{
					"id": 741510541,
					"content": "#Ơ, {NICKNAME}, sao lại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510542
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510542,
					"content": "Ừm, em cũng về đây. Thật ra cha mẹ không thích em đến đây đâu. Nếu để họ biết sáng nay em đi đâu thì chắc chắn họ sẽ nổi giận mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510543
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510543,
					"content": "Không biết có còn cơ hội gặp lại ông Leroy không. Thật ra em muốn nói cho ông ấy biết là đồ ngọt của ông ấy rất ngon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510544
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510544,
					"content": "#Đợi đến khi nào ông ấy khỏe lại, nếu {F#hai chị}{M#anh chị} có gặp ông ấy thì chuyển lời thay em nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510545,
						741510546
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510545,
					"content": "Không thành vấn đề.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510547
					]
				},
				{
					"id": 741510547,
					"content": "À ừm, được thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510548
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510548,
					"content": "#Dạ, cảm ơn {M#anh}{F#chị} {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510549
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510549,
					"content": "Em về đây, hẹn gặp lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510550
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510550,
					"content": "#{NICKNAME}, nghĩ ra gì rồi đúng không? Hồi nãy hình như muốn nói gì đó thì phải.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510551,
						741510552
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510551,
					"content": "Chúng ta qua chỗ khác nói chuyện đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510553
					]
				},
				{
					"id": 741510553,
					"content": "Được rồi, chúng ta qua chỗ khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510552,
					"content": "Đừng nói lớn tiếng ở đây.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510553
					]
				},
				{
					"id": 741510546,
					"content": "Được thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510547
					]
				},
				{
					"id": 741510540,
					"content": "#{F#Chị}{M#Anh} và Paimon cũng phải về rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510541
					]
				},
				{
					"id": 741510516,
					"content": "Tại sao anh lại ngăn chúng tôi gặp ông Benoit?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510517
					]
				},
				{
					"id": 741510517,
					"content": "Tại sao tôi phải cho người không liên quan đến thăm cha tôi chứ? Tôi nói rồi, tình hình sức khỏe của ông ấy không phù hợp để gặp khách.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510518
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741510510,
					"content": "(Lạnh lùng một cách đáng ngờ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510511
					]
				}
			]
		},
