			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Molli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741510101,
					"content": "#{M#Anh chị}{F#Hai chị} đến rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510102
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510102,
					"content": "#Chị tên là Paimon, còn đây là {NICKNAME}, sau này cứ gọi thẳng tên của nhau nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510103,
					"content": "Molli đến tìm ông Benoit hả?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510104
					]
				},
				{
					"id": 741510104,
					"content": "Dạ, nhưng em và ông Leroy không nói chuyện với nhau được... Haiz, thế này thì không thể viết xong bài văn được rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510105
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510105,
					"content": "Bài văn? À nhớ rồi, Molli vì viết văn nên mới làm người tốt việc tốt nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510106,
					"content": "Không phải thế, em vốn rất thích ông Benoit mà. Ông ấy rất... ừm... trơn bóng! Đúng rồi, là trơn bóng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510107
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510107,
					"content": "Hả, miêu tả kiểu gì vậy? Phải nói kiểu như là giỏi giao tiếp mới đúng chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510108,
					"content": "Chị Paimon giỏi quá, có thể giúp em suy nghĩ ý tưởng không? Em không viết nổi nữa rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510109
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510109,
					"content": "Cô gia sư nói đoạn văn mà em giúp ông Leroy cho mèo ăn \"vừa hao tốn vừa chân thành\", bảo em viết thêm một bài nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510110
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510110,
					"content": "Gì mà \"hao tốn\" chứ, là \"khiêm tốn\" đúng không? Hiểu rồi, chẳng trách sao em lại đến nhà ông Benoit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510111,
					"content": "Mặc dù em là vì bài tập về nhà, nhưng em cũng rất thích chơi với ông Leroy mà! Ông ấy có nhờ em gửi lời chào đến cha mẹ, em cũng có làm theo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510112
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510112,
					"content": "Ba mẹ nghe thấy tên của ông ấy thì rất không vui, không cho em đến nữa. Em cũng không biết tại sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510113
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510113,
					"content": "Tư liệu mà Molli cần để viết văn không hề đơn giản. Cứ như lần trước, tiếp tục cho mèo ăn là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510114,
					"content": "Như thế thì chỉ viết được một dòng thôi... Ít quá, không được đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510115
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510115,
					"content": "#Vậy thì để {F#hai chị}{M#anh chị} làm chung với em.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510116
					]
				},
				{
					"id": 741510116,
					"content": "#Đúng vậy. Giống như lần trước nhé, em cho mèo ăn, {F#hai chị}{M#anh chị} dọn dẹp trước cửa và sau nhà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510117,
					"content": "Sau đó chúng ta cùng nhau gõ cửa tìm ông Benoit để trò chuyện, thế là em lại có nội dung để viết rồi, đúng chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510118,
					"content": "Thế cũng được! Chị Paimon thông minh quá, vậy em đi cho mèo ăn đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Molli"
				}
			]
		},
		{
