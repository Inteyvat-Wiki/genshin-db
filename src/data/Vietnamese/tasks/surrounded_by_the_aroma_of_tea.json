				"points": []
			},
			"dialogs": [
				{
					"id": 705070101,
					"content": "Zhong... Zhongli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705070102,
					"content": "Lâu rồi không gặp, dạo này thế nào rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070103
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 705070103,
					"content": "Không, không đúng... Zhongli, sao anh lại ở đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705070104,
					"content": "Nếu đã là ngao du thì đâu giới hạn phạm vi trước mắt chứ. Vương quốc của gió là nơi tự do, rất đáng để ghé thăm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070105
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 705070105,
					"content": "Có thể gặp được các bạn ở đây, đúng là bất ngờ đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070106,
						705070107
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 705070106,
					"content": "Anh có muốn uống gì không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705070108
					]
				},
				{
					"id": 705070108,
					"content": "Cho tôi một ly Vườn Sương Mù nhé. Cho trà đậm một chút, cảm ơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 705070107,
					"content": "Có thể vừa uống trà vừa tâm sự.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705070108
					]
				}
			]
		},
		{
			"id": 7050702,
			"completionStepIds": [
				7050703
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7050703",
							"2"
						],
						"stepId": 7050703,
						"stateName": "QUEST_STATE_UNFINISHED"
