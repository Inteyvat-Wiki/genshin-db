				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhongli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705070201,
					"content": "Để anh đợi lâu rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705070202,
					"content": "Từ từ thưởng thức nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705070203
					]
				},
				{
					"id": 705070203,
					"content": "Nước trà trong suốt, màu sắc dễ chịu, vị ngọt vừa miệng, có thêm hương hoa và trái cây. Ừm, rất ngon đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070204
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 705070204,
					"content": "Woa, Zhongli đúng là bậc thầy trong lĩnh vực thưởng trà đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705070205,
					"content": "Như tôi thì chỉ có thể ực ực cái uống sạch rồi nói ra ba chữ đã cái bụng thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705070206,
					"content": "Dùng tấm lòng để thưởng thức, chính là thành ý dành cho người pha trà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070207
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 705070207,
					"content": "Trà ngon khó tìm, người có thể pha ra ly trà có cảm xúc như vậy càng khó tìm hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070208,
						705070209
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 705070208,
					"content": "Quá khen rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705070210
					]
				},
				{
					"id": 705070210,
					"content": "Paimon hiểu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705070211,
					"content": "Vậy... có thể dạy tôi cách thưởng trà không. Hình như là ngửi xong mới uống, đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705070212,
					"content": "Đúng vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070213
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 705070213,
					"content": "Mỗi loại lá trà đều có đặc tính khác nhau, uống nhiều rồi sẽ có tâm đắc của riêng mình. Từ đó ngửi mùi là sẽ nhận biết được đôi chút về chất lượng của trà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070214
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 705070214,
					"content": "Trà thứ phẩm sẽ có mùi ẩm và mốc, còn trà thượng hạng sẽ có mùi ngọt ngào và thanh tao, pha với hương thơm nhẹ nhàng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070215
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 705070215,
					"content": "Nếu muốn chuyên sâu hơn thì dựa theo truyền thống của Liyue, phải dùng thêm \"cốc thưởng vị\". Dụng cụ này được sử dụng để kiểm tra mùi thơm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070216
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 705070216,
					"content": "Làm sao đây, trước đây Paimon đã bỏ lỡ nhiều thứ quá rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705070217,
					"content": "Không sao, nếu có ý muốn học thì không lúc nào là trễ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070218
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 705070218,
					"content": "Người mới tìm hiểu có thể thử giám định như sau: Đầu tiên quan sát màu trà, rồi ngửi nhẹ mùi thơm, sau đó mới nếm thử.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070219
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 705070219,
					"content": "\"Bắt đầu từ căn bản\", đây luôn là quy luật của vạn vật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070220,
						705070221
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 705070220,
					"content": "Hôm nay tôi học được rất nhiều...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705070222
					]
				},
				{
					"id": 705070222,
					"content": "Phía tây bắc Liyue có một nơi gọi là \"Làng Kiều Anh\", nổi danh với nghề trà. Sau này nếu có cơ hội thì đến đó tham quan thử nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070223
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 705070223,
					"content": "Những chuyện nói hôm nay, đa số đều là thói quen cổ xưa của một người Liyue như tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070224
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 705070224,
					"content": "Thói quen và văn hóa uống trà của mỗi đất nước đều có sự khác biệt. Thân ở quốc gia khác, nên nhập gia tùy tục sẽ thích hợp hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070225
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 705070225,
					"content": "Paimon hiểu hết rồi! Nhưng có nhớ hay không thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705070226,
					"content": "Vẫn cứ là Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705070227
					]
				},
				{
					"id": 705070227,
					"content": "#{NICKNAME}, hôm nay thật cảm ơn bạn. Có thể thưởng thức được ly trà ngon như vậy, quả thật không uổng chuyến đi này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070228
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 705070228,
					"content": "Nếu sau này bạn có thể mở quán trà, tôi nhất định sẽ đến ủng hộ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070229
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 705070229,
					"content": "Nhưng chúng tôi bận lắm, không có thời gian đi mở quán trà đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705070230,
					"content": "Biết đâu được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705070231
					]
				},
				{
					"id": 705070231,
					"content": "Nói chung, nếu có cơ hội, tôi nhất định sẽ ủng hộ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070232
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 705070232,
					"content": "Hôm nay đến đây thôi, không làm phiền mọi người nữa, chúc công việc thuận lợi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070233,
						705070234
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 705070233,
					"content": "Ừm, đi thong thả.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705070235
					]
				},
				{
					"id": 705070235,
					"content": "À ừm, cứ như thường lệ... tính vào Vãng Sinh Đường nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070236
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 705070236,
					"content": "Đi thong thả nhé, gửi lời hỏi thăm đường chủ giùm chúng tôi nha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705070234,
					"content": "Khoan đã, còn chuyện tiền trà...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705070235
					]
				},
				{
					"id": 705070221,
					"content": "Tôi muốn học nhiều hơn nữa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705070222
					]
				},
				{
					"id": 705070209,
					"content": "Thật ngại quá...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705070210
					]
				}
			]
		}
	]
}