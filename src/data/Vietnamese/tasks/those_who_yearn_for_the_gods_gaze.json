				},
				{
					"id": 20140803,
					"content": "Đợi một chút, để tôi đứng lên...Kỳ lạ, cứ cảm thấy toàn thân không có chút sức lực...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140804,
