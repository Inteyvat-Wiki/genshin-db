				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Teppei",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20140501,
					"content": "Phù...cuối cùng cũng xử xong rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140502,
					"content": "Đúng là một tên khó đối phó mà, nhưng sao ở đây lại có một tên Vua Giáp Lôi Hilichurl to như vậy chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140503,
					"content": "Thật không hiểu...hơn nữa không khí ở đây cũng có chút quái lạ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140504,
					"content": "Tóm lại, chuyện ở đây chắc đã giải quyết xong rồi, chúng ta mau chạy thôi... Úi, Teppei, sao bạn cũng ở đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140505,
					"content": "Khụ khụ...Bất ngờ thật, hóa ra các bạn đang điều tra ở đây à.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140506
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140506,
					"content": "Tôi vừa mới vận chuyển xong vật tư từ tiền tuyến trở về, định sẵn tiện dẹp sạch các mối nguy hiểm ở xung quanh đây. Khụ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140507
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140507,
					"content": "Không sao chứ, trông bạn hơi là lạ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140508,
					"content": "Không sao không sao, chắc do mấy hôm trước bị cảm lạnh trong lúc ra biển.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140509
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140509,
					"content": "Lúc đi ngang qua đây, tôi nghe nói vừa có người lên đảo điều tra, nên đã đến xem thử.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140510
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140510,
					"content": "Nếu có gì nguy hiểm, không chừng tôi còn có thể làm anh hùng...Nhưng đáng tiếc là gặp phải các bạn, xem ra đã uổng công tôi đến đây rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140511
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140511,
					"content": "Teppei, bạn có thấy không khí ở đây có gì đó đặc biệt không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140512,
					"content": "Ừm...Nói như vậy thì quả thật là có một chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140513
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140513,
					"content": "Có thể là do nơi này gần với xương cốt của Ma Thần Orobaxi, nên mùi của Họa Thần tương đối nặng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140514
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140514,
					"content": "Ma Thần Orobaxi, đó là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140515,
					"content": "Bạn nhìn xem, đó chính là xương cốt của Orobaxi để lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140516
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140516,
					"content": "Quào! Bộ xương rắn lớn như vậy, trông thật đáng sợ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140517,
					"content": "Là do Orobaxi đã đưa tổ tiên của chúng tôi từ Enkanomiya sâu thẳm lên mặt đất, nên mới có Đảo Watatsumi của ngày nay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140518
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140518,
					"content": "Tổ tiên của chúng tôi luôn xem Orobaxi là vị thần bảo vệ, nhưng trong thời kỳ chiến tranh Ma Thần, Orobaxi đã xâm chiếm Đảo Yashiori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140519
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140519,
					"content": "Raiden Shogun đã đích thân đuổi đến, dùng \"Lưỡi Đao Vô Tưởng\" để trảm sát. Nhát đao đó cũng đã hình thành nên Hẻm Núi Musoujin ngày nay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140520
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140520,
					"content": "Hẻm Núi Musoujin là do Raiden Shogun chém ra sao...Thật lợi hại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140521
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140521,
					"content": "Đúng vậy, cuộc chiến Ma Thần vô cùng tàn khốc, Đảo Yashiori cũng biến thành phế tích trong trận chiến đó, nghe nói Shogun cũng từng mất đi thứ quan trọng vào lúc đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140522
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140522,
					"content": "Sau khi Orobaxi chết, Đảo Watatsumi và Shogunate có rất nhiều chuyện bất hòa. Nhưng lần này thành lập quân kháng chiến, không phải là vì tín ngưỡng, mà là để đối phó với Lệnh Truy Lùng Vision.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140523
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140523,
					"content": "Orobaxi đã phá hủy nền văn minh, là Shogun đã đứng ra ngăn cản.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140524
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140524,
					"content": "Ngày nay Shogun ban bố Lệnh Truy Lùng Vision, tước đoạt đi ước nguyện của dân chúng, cũng phải có người đứng ra ngăn cản Shogun...khụ khụ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140525
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140525,
					"content": "Tôi quay về trước, vừa giải quyết xong đám samurai tinh nhuệ của quân Shogunate, tôi về nghỉ ngơi một lát, chút nữa còn có việc khác phải làm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140526
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140526,
					"content": "Các bạn cũng mau về báo cáo với Sangonomiya đại nhân đi. Ở đây không chừng vẫn còn hơi thở tàn dư của Họa Thần, ở lâu sẽ không tốt cho sức khỏe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140527
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140527,
					"content": "Khụ khụ...khụ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140528,
						20140529
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140528,
					"content": "Bạn cũng phải chú ý sức khỏe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140530
					]
				},
				{
					"id": 20140530,
					"content": "Đừng lo, sức khỏe của tôi còn tốt lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140531
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140531,
					"content": "Thật không ngờ Teppei đã có thể giao chiến với samurai của quân Shogunate rồi, không biết từ lúc nào anh ấy đã trưởng thành hơn nhiều như thế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140532
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140532,
					"content": "#{NICKNAME}, chúng ta quay về báo cáo với <color=#00E1FFFF>Kokomi</color> thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140529,
					"content": "Bạn cũng phải cẩn thận.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140530
					]
				}
			]
		},
		{
			"id": 201406,
