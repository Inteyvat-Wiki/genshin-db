			},
			"dialogs": [
				{
					"id": 400210901,
					"content": "Đáng ghét, chúng ta lại bị đá ra rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400210902,
					"content": "Lần sau đừng để anh trai kia mở miệng ra nữa, xui thật đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210903
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400210903,
					"content": "Tôi không chịu nổi bí cảnh này nữa rồi! Kamuna Harunosuke có phải không dám đối mặt với chúng ta không, đúng là đồ chết nhát mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400210904,
					"content": "Nhưng mà, gần đây có samurai của Hiệp Hội Tenryou canh giữ, anh trai kia với Shiki Taishou bị kẹt trong đó cũng xem như tránh được phiền phức.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210905
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400210905,
					"content": "(Kamuna... rốt cuộc đang ở đâu?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400210906
					]
				},
				{
					"id": 400210906,
					"content": "Cứ theo quy tắc cũ thôi, đợi bí cảnh tái lập xong chúng ta vào trong đó tìm họ vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210907
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400210907,
					"content": "Trước lúc đó thì chúng ta tạm lánh trước đã, không được để người của Hiệp Hội Tenryou biết chúng ta còn đang lảng vảng ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210908
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400210908,
					"content": "Lần sau vào lại, nhất định sẽ lôi cho được tên chủ mưu đó ra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4002114,
			"completionStepIds": [
				4002114
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4002114",
							"2"
						],
						"stepId": 4002114,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Shiki Taishou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400211401,
					"content": "Bùa phép trên \"bản sao\" là có hạn, ký ức mà tôi tìm về được cũng có hạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211402
					],
					"speakerTitle": "Shiki Taishou"
				},
				{
					"id": 400211402,
					"content": "Vẫn chưa đủ sao? Vậy thì theo kế hoạch, tiếp tục tiến về phía trước thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211403
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 400211403,
					"content": "Không đúng không đúng, khi bí cảnh tái lập, lộ trình trước đó mà chúng ta vất vả tìm được cũng trở nên vô dụng rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400211404,
					"content": "Chuyện này các bạn cứ yên tâm, bí cảnh tái lập là có quy luật riêng, tôi đã nhớ được phương hướng rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211405
					],
					"speakerTitle": "Shiki Taishou"
				},
				{
					"id": 400211405,
					"content": "Đi theo hướng kia có lẽ không sai đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211406
					],
					"speakerTitle": "Shiki Taishou"
				},
				{
					"id": 400211406,
					"content": "Đợi đã, tôi có chuyện muốn hỏi! Shiki Taishou, ban nãy bạn nói phép thuật sót lại trên \"bản sao\" không đủ, ký ức hồi phục cũng có hạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400211407,
					"content": "Vậy sao bạn lại biết được chính xác lộ trình như vậy chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400211408,
					"content": "Lần trước đi theo bạn qua cánh cửa đó, chúng tôi đã bị đưa ra khỏi bí cảnh... điều này có nghĩa là cửa ở đây có thể không phải là cửa thật!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400211409,
					"content": "Nếu như bạn không phân biệt được mà dẫn chúng tôi vào chỗ nguy hiểm thì xong đời chúng tôi mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400211410,
					"content": "Các bạn lo lắng như vậy cũng không có gì lạ, tiếc rằng tôi không thể đưa ra đáp án khiến mọi người tin tưởng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211411
					],
					"speakerTitle": "Shiki Taishou"
				},
				{
					"id": 400211411,
					"content": "Nếu như tôi nói đây chỉ là trực giác của một người quản lý thì bạn có chấp nhận không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211412
					],
					"speakerTitle": "Shiki Taishou"
				},
				{
					"id": 400211412,
					"content": "Có lẽ là không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400211413,
					"content": "Paimon nói không phải là vô lý, nhưng chúng ta chỉ có thể tin tưởng vào Shiki Taishou, nếu không, không lẽ chúng ta phải chịu bị kẹt ở đây mãi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211414
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400211414,
					"content": "Với lại, lỡ như bí cảnh lại khởi động lại... vậy thì lúc đó chúng ta sẽ càng mất phương hướng hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211415
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400211415,
					"content": "Ừm, ra ngoài xong quay về lại có vẻ gấp gáp hơn nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211416
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 400211416,
					"content": "Để tôi đoán xem, có phải đã gặp chuyện gì đó phiền phức không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211417
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 400211417,
					"content": "Như tôi biết thì thế cục Inazuma hiện giờ chưa ổn định. Nhưng bí cảnh như vậy phải do Hiệp Hội Tenryou xử lý, nhưng hiện giờ nhân lực không đủ nên không thể bao quát cục diện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211418
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 400211418,
					"content": "Cho nên, mọi người đến đây là do nhận được ủy thác từ Hiệp Hội Tenryou đúng chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211419
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 400211419,
					"content": "Với tác phong của họ, e rằng sẽ càn quét bí cảnh này, nghiền nát tất cả. Như vậy thì Shiki Taishou sẽ không còn cơ hội tìm lại được ký ức.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211420
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 400211420,
					"content": "Vì vậy nên bạn mới gấp gáp như vậy đúng chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211421
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 400211421,
					"content": "Anh quả nhiên đang điều tra Inazuma.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400211422
					]
				},
				{
					"id": 400211422,
					"content": "Tất cả đều là do âm mưu của anh đúng không!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400211423,
					"content": "Đúng là tôi đang điều tra một số chuyện, nhưng không phải như các bạn nghĩ. Chuyện này chúng ta nói sau nhé, chúng ta cần phải giải quyết việc trước mắt đã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211424
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 400211424,
					"content": "Nhà lữ hành, với giao tình của chúng ta, có lẽ không cần phải cố ý đề phòng nữa. Sau khi đến Inazuma, tôi thấy xung quanh có vết tích của ma vật nên mới theo dấu đến đây mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211425
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 400211425,
					"content": "Nơi đây giống như một khu huấn luyện cho đấu sĩ... chỉ có chiến đấu và tàn sát. Tôi đang rất thỏa mãn đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211426
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 400211426,
					"content": "Nói câu hơi khó nghe, thì ngoại trừ nhà lữ hành và Paimon ra, hai vị còn lại mới gặp tôi lần đầu. Các bạn có lẽ không biết tôi là một người không chú trọng lập trường lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211427
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 400211427,
					"content": "Thiện ác, chính tà, sứ mệnh... những chuyện này có quan trọng không? Có hấp dẫn hơn việc chiến đấu thỏa thích không chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211428
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 400211428,
					"content": "Quả nhiên là một người hiếu chiến. Anh trai, vậy ý của anh là...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211429
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400211429,
					"content": "Tôi không có suy nghĩ gì đặc biệt, chỉ muốn nói với các bạn rằng cứ tiếp tục tiến lên đi, đừng lo sợ ma vật trên đường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211430
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 400211430,
					"content": "Nếu như các bạn không thể đối phó được, thì chính tôi sẽ thay thế các bạn nghiền nát tất cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211431
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 400211431,
					"content": "Bởi vì... chiến đấu chính là sở trường của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211432
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 400211432,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211433
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400211433,
					"content": "Này, đừng nhìn tôi thế chứ! Vậy thì tôi đi là được rồi đúng không!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}