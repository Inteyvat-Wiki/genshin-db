			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Childe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400210501,
					"content": "Woa! Anh ở đây sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400210502,
					"content": "Yo, đến rồi sao. Để tôi đợi lâu quá đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210503
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 400210503,
					"content": "Các bạn đã bỏ qua một tiết mục hay rồi, thật đáng tiếc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210504
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 400210504,
					"content": "Cái tên này hăng hái như vậy chắc là không bị thương rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400210505,
					"content": "Hử? Lo lắng cho tôi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210506,
						400210508
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 400210506,
					"content": "Ai thèm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400210507
					]
				},
				{
					"id": 400210507,
					"content": "Xem ra bạn rất tin tưởng vào thực lực của tôi đúng không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210510
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 400210510,
					"content": "Là một đồng đội và đối thủ cũ, có lẽ bạn cũng biết những trận chiến như thế này rất hợp với khẩu vị của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210511
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 400210511,
					"content": "Trong thời gian bí cảnh tái lập, những gian phòng sẽ di chuyển lên xuống, ma vật cũng di chuyển tứ tung. Ừm! Mấy ngày nay tôi chiến đấu rất thỏa thích.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210512
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 400210512,
					"content": "Còn những \"bản sao\" này nữa, đều là thứ mà Shiki Taishou cần. Bên trong có chứa sức mạnh và ký ức đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210513
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 400210513,
					"content": "Đúng là đến sớm không bằng đến kịp lúc, mau thu hồi chúng đi Shiki Taishou!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400210508,
					"content": "Một chút thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400210509
					]
				},
				{
					"id": 400210509,
					"content": "Thật sao? Để bạn phải lo lắng như vậy, tôi thấy vinh hạnh ghê.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210510
					],
					"speakerTitle": "Childe"
				}
			]
		},
		{
			"id": 4002108,
			"completionStepIds": [
				4002108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4002108",
							"2"
						],
						"stepId": 4002108,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Shiki Taishou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400210801,
					"content": "Căn phòng này sắp là nơi sâu nhất trong đền rồi. Tôi nhớ là... tôi và Harunosuke đã ở đây rất lâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210802
					],
					"speakerTitle": "Shiki Taishou"
				},
				{
					"id": 400210802,
					"content": "Chúng tôi đã quan sát những samurai đến từ khắp nơi trên Inazuma. Khi họ uống rượu ăn mừng, họ luôn hô vang: \"Chúng ta cũng có khả năng chiến thắng ma vật mạnh mẽ rồi!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210803
					],
					"speakerTitle": "Shiki Taishou"
				},
				{
					"id": 400210803,
					"content": "Không lẽ, bạn và Kamuna Harunosuke dẫn theo nhóm samurai đó đi tiêu diệt ma vật sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210804
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400210804,
					"content": "Cũng có khả năng này, nhưng cũng không chỉ là khả năng này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210805
					],
					"speakerTitle": "Shiki Taishou"
				},
				{
					"id": 400210805,
					"content": "Nói cách khác, cảnh tượng này cũng có khả năng là do Harunosuke sắp xếp. Vì để tiếp quản lại Đền Âm Dương này, anh ta đã chiêu mộ những samurai đó và lệnh cho họ vào đây tiêu diệt ma vật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210806
					],
					"speakerTitle": "Shiki Taishou"
				},
				{
					"id": 400210806,
					"content": "Suy đoán của Shiki Taishou giờ đây có vẻ khá giống Tartaglia rồi đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400210807,
					"content": "Còn không phải sao, tôi luôn suy nghĩ đến tình huống xấu nhất mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210808
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 400210808,
					"content": "Đây chỉ là suy đoán theo hướng hợp lý nhất mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210809
					],
					"speakerTitle": "Shiki Taishou"
				},
				{
					"id": 400210809,
					"content": "Ký ức của tôi vẫn chưa hoàn chỉnh, nhưng phần thiếu đi càng ngày càng ít rồi, có lẽ tôi sắp nhớ lại được tất cả rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210810
					],
					"speakerTitle": "Shiki Taishou"
				},
				{
					"id": 400210810,
					"content": "Với lại, tôi có cảm giác... nếu như tiếp tục đi về phía trước, nói không chừng chúng ta sẽ gặp được Harunosuke.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210811
					],
					"speakerTitle": "Shiki Taishou"
				},
				{
					"id": 400210811,
					"content": "Ngôi Đền Âm Dương này chỉ mới xây dựng gần đây thôi đúng không? Vậy là anh ta vẫn luôn ở trong này đúng không? Ối...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210812,
						400210813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400210812,
					"content": "Shiki Taishou.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400210814
					]
				},
				{
					"id": 400210814,
					"content": "Nhà lữ hành? Đợi đã, không lẽ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210815
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400210815,
					"content": "Có vài chuyện, cần phải do tôi nói.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400210816
					]
				},
				{
					"id": 400210816,
					"content": "Nhìn vẻ mặt nghiêm túc của các vị... có lẽ đây là chuyện rất quan trọng đúng không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210817
					],
					"speakerTitle": "Shiki Taishou"
				},
				{
					"id": 400210817,
					"content": "Chúng ta không cần phải quá nghiêm trọng, đúng không? Ở đây đã đủ kỳ lạ và căng thẳng rồi! Thôi để Paimon nói cho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210818
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400210818,
					"content": "Là như vậy, ban đầu chúng tôi nghe nói bí cảnh này có ma vật tràn ra ngoài, cho nên cùng các samurai của Hiệp Hội Tenryou đến kiểm tra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210819
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400210819,
					"content": "Khi chúng tôi gặp được bạn, bạn hoàn toàn không biết được lai lịch của bí cảnh này, cũng không biết được bản thân tại sao lại xuất hiện... Nhưng chúng tôi tin rằng bạn thật sự không biết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210820
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400210820,
					"content": "Cho dù chúng tôi không tin bạn, nhưng cũng sẽ tin khả năng phán đoán của Xinyan. Xinyan thừa nhận bạn nên chúng ta đã đi chung với nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210821
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400210821,
					"content": "Ừm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400210822
					]
				},
				{
					"id": 400210822,
					"content": "Càng mạo hiểm về sau, chúng ta đã càng tiếp cận đến tận cùng bí cảnh, chân tướng trước mắt có vẻ như sắp lộ ra rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210873
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400210873,
					"content": "Nhưng đến giờ chúng ta vẫn không thể xác nhận được tòa bí cảnh này được tạo ra với mục đích gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210823
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400210823,
					"content": "Một chiếc rương có thể chứa kho báu hoặc cạm bẫy, chúng ta đã đi đến thời khắc cuối cùng này, không thể không có sự phòng bị trước được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210824,
						400210825,
						400210826
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400210824,
					"content": "Nếu như Kamuna thực sự đang mưu tính gì đó...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400210827
					]
				},
				{
					"id": 400210827,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210828
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400210828,
					"content": "Tôi không thích nhìn người khác phải lựa chọn trong miễn cưỡng, nhưng mà... đúng như nhà lữ hành nói, chúng ta cần phải có sự chuẩn bị, đó là trách nhiệm của những người đồng đội dành cho nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210829
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400210829,
					"content": "Tôi hiểu rồi... có lẽ đây là lúc tôi phải quyết định rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210830
					],
					"speakerTitle": "Shiki Taishou"
				},
				{
					"id": 400210830,
					"content": "Tôi từ lúc bắt đầu đến giờ đều nhờ các bạn giúp đỡ trong mơ hồ. Cho dù chỉ là cùng nhau chiến đấu vài ngày, nhưng giữa chúng ta cũng không nên che giấu chuyện gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210831
					],
					"speakerTitle": "Shiki Taishou"
				},
				{
					"id": 400210831,
					"content": "Với những thông tin trước mắt, tôi không thể đảm bảo được. Tôi nghĩ tôi sẽ tin tưởng Harunosuke, nhưng tôi không biết được anh ta có thay đổi trong từng ấy năm không, hoặc cũng có thể những ký ức của tôi là giả...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210832
					],
					"speakerTitle": "Shiki Taishou"
				},
				{
					"id": 400210832,
					"content": "Tôi chỉ là \"shikigami\" được \"onmyouji\" tạo ra, ký ức vụn vỡ không đầy đủ. Đối với tôi hiện giờ mà nói, bốn người các bạn là những người thân thiết và tin cậy nhất của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210833
					],
					"speakerTitle": "Shiki Taishou"
				},
				{
					"id": 400210833,
					"content": "Tôi tin cậy các bạn... và cũng có trách nhiệm với Harunosuke.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210834
					],
					"speakerTitle": "Shiki Taishou"
				},
				{
					"id": 400210834,
					"content": "Anh ta tạo ra tôi, tôi có nghĩa vụ phải đi theo anh ta. Nếu đúng như các bạn nói, anh ta là kẻ gian ác, vậy thì thứ mà anh ta đang nắm giữ là vận mệnh của tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210835
					],
					"speakerTitle": "Shiki Taishou"
				},
				{
					"id": 400210835,
					"content": "Nếu có thể, tôi muốn duy trì tấm lòng lương thiện này đến phút cuối cùng. Nhưng vũ khí sẽ không thể phản bội ý chí của chủ nhân, anh ta tạo ra tôi, thì sẽ có thể khống chế tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210836
					],
					"speakerTitle": "Shiki Taishou"
				},
				{
					"id": 400210836,
					"content": "Nếu như sau này tôi và Harunosuke làm ra những chuyện trái với lương tâm, tôi cũng tin rằng... các bạn cũng sẽ sắp xếp cho tôi một cái kết hợp lý nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210837
					],
					"speakerTitle": "Shiki Taishou"
				},
				{
					"id": 400210837,
					"content": "Phù... không ngờ lại đẩy phần khó nhất về lại cho chúng tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210838
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400210838,
					"content": "Tuy nhiên, đó là một bài phát biểu trung thực và đầy cảm hứng đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210839
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400210839,
					"content": "#{NICKNAME}, đáp án này rất phù hợp với mong đợi của chúng ta đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210840,
						400210841
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400210840,
					"content": "Ừm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400210842
					]
				},
				{
					"id": 400210842,
					"content": "Các bạn có phải đã tập luyện trước với nhau không đó? Đúng là kẻ tung người hứng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210843
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400210843,
					"content": "Hahaha, thủ pháp hay đó. Có thể dùng cách này để do thám được ký ức của Shiki Taishou có bị thiếu không... Nhà lữ hành, bạn trưởng thành hơn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210844
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 400210844,
					"content": "Do thám gì chứ! Đây chỉ là diễn thôi, diễn để lừa anh đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210845
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400210845,
					"content": "Xinyan không phải đã nói rồi sao? Cô ấy đã dùng ngôn ngữ của chính mình để xác nhận mức độ đáng tin cậy của đồng đội, chúng tôi cũng có cách của riêng chúng tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210846
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400210846,
					"content": "Hơn nữa, việc này cũng sẽ khiến Shiki Taishou phấn chấn hơn mà! Để cho Shiki Taishou biết rằng cho dù xung quanh có mù mờ đến đâu, chỉ cần chúng ta tin tưởng nhau, cũng đều có thể tiếp tục tiến bước!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210847
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400210847,
					"content": "Shiki Taishou là đồng đội, vì chỉ có như vậy mới thành thật nói cho chúng ta biết sự uy hiếp lớn nhất đối với bản thân, đó là trách nhiệm của một đồng đội tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210848
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 400210848,
					"content": "Tôi cũng cảm nhận được sự chân thành này.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400210849
					]
				},
				{
					"id": 400210849,
					"content": "Tôi không giỏi nói dối đâu... cảm ơn mọi người đã cảm nhận được tấm lòng của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210850
					],
					"speakerTitle": "Shiki Taishou"
				},
				{
					"id": 400210850,
					"content": "Người tốt cũng có thể lừa gạt được... ở phía ngược lại, kẻ xấu đôi khi cũng có nỗi niềm riêng của bản thân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210851
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 400210851,
					"content": "Có thể nói ra được sự thật tàn nhẫn của mình, bạn đã thực sự giác ngộ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210852
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 400210852,
					"content": "Cũng như Xinyan có nói, hừm... nói sao nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210853
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400210853,
					"content": "Nói cái gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210854
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400210854,
					"content": "Nhớ ra rồi nhớ ra rồi! \"Loại ngôn ngữ này rất chân thành, có thể chạm đến trái tim mỗi người!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210855
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400210855,
					"content": "Không sai một chữ luôn, không ngờ bạn nhớ được luôn đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210856
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400210856,
					"content": "Vậy thì, chúng ta đã chuẩn bị xong tinh thần trước trận chiến rồi chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210857
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 400210857,
					"content": "Xong rồi thì chúng ta đi nhé, tốc chiến tốc thắng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210858
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 400210858,
					"content": "Shiki Taishou, đừng lo lắng, chúng tôi đều ở bên bạn mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210859
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400210859,
					"content": "Tôi hiểu. Tôi sẽ toàn lực hỗ trợ cho các bạn, sẽ không gây thêm phiền phức đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210860
					],
					"speakerTitle": "Shiki Taishou"
				},
				{
					"id": 400210860,
					"content": "Gây thêm chút cũng được, chỉ cần chúng ta thắng là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210861
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400210861,
					"content": "Chỉ cần đánh thắng trận chiến quyết định này...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400210862
					]
				},
				{
					"id": 400210862,
					"content": "Không, cũng phải tính đến trường hợp xấu nhất. Giả sử đằng sau cánh cửa này không dẫn đến nơi sâu nhất của bí cảnh, mà là một cơ quan nguy hiểm thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210863
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 400210863,
					"content": "Không phải chứ? Cái tên mồm thối này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210864
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400210864,
					"content": "Giả sử thôi mà, ai mà đảm bảo được chuyện này sẽ không xảy ra chứ, đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210865
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 400210865,
					"content": "Thật không may là nếu đúng như vậy, tôi không nghĩ rằng tôi sẽ có thể ngăn chặn nó trong tình trạng hiện tại của tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210866
					],
					"speakerTitle": "Shiki Taishou"
				},
				{
					"id": 400210866,
					"content": "Tôi vẫn chưa hoàn toàn kiểm soát được nơi này. Xin lỗi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210867
					],
					"speakerTitle": "Shiki Taishou"
				},
				{
					"id": 400210867,
					"content": "Không sao đâu, một thánh địa chiến đấu hiếm có nhưng vậy cho dù có tái lập mười lần đi nữa thì tôi cũng sẽ rất sẵn lòng hưởng thụ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210868
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 400210868,
					"content": "...Thôi khỏi, anh tự đi mà hưởng một mình đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210869
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400210869,
					"content": "Nói chung, nếu như bị tái lập lần nữa, chúng ta cũng cần phải bảo vệ tốt bản thân và hội hợp lại với nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210870
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 400210870,
					"content": "Vậy còn anh thì sao? Anh đi chiến đấu nữa sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210871
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400210871,
					"content": "Tôi sao, không cần lo lắng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210872
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 400210872,
					"content": "Tôi đương nhiên sẽ đi hưởng thụ những nguy hiểm này rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Childe"
				},
				{
					"id": 400210841,
					"content": "Chúng tôi hoàn toàn tin tưởng bạn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400210842
					]
				},
				{
					"id": 400210825,
					"content": "Nếu như anh ta muốn hãm hại Inazuma.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400210827
					]
				},
				{
					"id": 400210826,
					"content": "Bạn sẽ đứng cùng chiến tuyến với chúng tôi chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400210827
					]
				},
				{
					"id": 400210813,
					"content": "Tôi có chuyện cần phải nói.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400210814
					]
				}
			]
		},
		{
			"id": 4002109,
