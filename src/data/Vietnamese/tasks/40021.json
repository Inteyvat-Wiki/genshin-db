			"dialogs": [
				{
					"id": 400210101,
					"content": "Nhà lữ hành, Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210102
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400210102,
					"content": "Ban nãy Kujou Sara có đến qua, cô ấy đang ở bên kia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210103
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400210103,
					"content": "Cô ấy có vẻ như không yên tâm để chúng ta ở đây lắm... tính cảnh giác cao thật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400210104,
					"content": "Đó là do cô ấy có trách nhiệm thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400210105
					]
				},
				{
					"id": 400210105,
					"content": "Tình hình có chút phức tạp, chúng ta đi nói chuyện với Sara trước vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinyan"
				}
			]
		},
		{
			"id": 4002102,
			"completionStepIds": [
				4002102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4002102",
							"2"
						],
						"stepId": 4002102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kujou Sara"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400210201,
					"content": "Ba vị, khoảng thời gian này làm phiền các bạn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210202
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 400210202,
					"content": "Tôi đã dẫn theo người đến rồi, có thể nói thời khắc nguy hiểm nhất đã qua. Sau này chúng ta chỉ cần canh giữ tuyến đường này là sẽ có thể phòng ngự ma vật. Nếu như có ma vật tẩu thoát thì cũng sẽ có thể cô lập chúng ở Araumi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210203
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 400210203,
					"content": "Trước đó tôi có nghe thấy tiếng động lớn phát ra từ trong bí cảnh, có thể trong đó sẽ có rất nhiều cơ quan... Chúng tôi đang chuẩn bị, chờ thời cơ thích hợp sẽ tổng tấn công vào đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210204
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 400210204,
					"content": "Các bạn không định đóng quân gần bí cảnh sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400210205,
					"content": "Lần hành động trước, các samurai không nghĩ đến việc phải giữ khoảng cách với bí cảnh. Kết quả là ma vật đột kích, họ đành phải vội vàng rút lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210206
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 400210206,
					"content": "Lần đầu là sơ ý, lần thứ hai thì sẽ là sai lầm. Tôi sẽ không để sự việc này xảy ra lần nữa đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210207
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 400210207,
					"content": "Thì ra là vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400210208,
					"content": "(Tốt quá, chúng ta có cơ hội rồi.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400210209
					]
				},
				{
					"id": 400210209,
					"content": "Chút nữa tôi sẽ quay về Doanh Trại Kujou, chuẩn bị cho công tác phòng bị ở những khu vực khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210210
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 400210210,
					"content": "Tuy nói có hơi trễ, nhưng Hiệp Hội Tenryou đã tiếp quản nơi này, cảm ơn ba vị đã giúp đỡ. Thù lao đã hứa tôi sẽ ghi nhớ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210211
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 400210211,
					"content": "Tiểu thư Xinyan, hãy nhận lấy bức thư này, trong đó là \"Giấy Thông Hành\" do chính tay tôi viết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210223
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 400210223,
					"content": "Tôi đã đăng ký giấy thông hành thời hạn lâu nhất cho bạn, hy vọng bạn có thể dùng quãng thời gian này thỏa chí du ngoạn Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210212
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 400210212,
					"content": "Ngoài ra tôi còn sắp xếp cho bạn chỗ ăn nghỉ, đợi khi về thành bạn cứ đi theo hướng dẫn trong thư là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210213
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 400210213,
					"content": "Ôi trời! Tôi có nằm mơ không? Ăn nghỉ miễn phí sao, thật tuyệt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210214
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400210214,
					"content": "Đừng khách sáo, đây là việc phải làm mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210215
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 400210215,
					"content": "Cảm ơn bạn. Xem ra dạo này bạn khá bận, cũng không biết khi nào mới có thời gian rảnh... nếu khi nào bạn rảnh rỗi mà tôi vẫn còn ở Inazuma thì tôi sẽ mời bạn đi xem buổi biểu diễn đường phố của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210216
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400210216,
					"content": "Thật không giấu gì, tôi không có hứng thú lắm với âm nhạc. Nhưng bạn đã giúp Hiệp Hội Tenryou rất nhiều, nếu như có cơ hội... thì tôi cũng sẽ đi xem thử.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210217
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 400210217,
					"content": "Vậy thì chuyện mà Xinyan lo lắng nhất cũng đã được giải quyết rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400210218,
					"content": "Không không, chuyện lo lắng nhất chính là Shiki Taishou mới đúng! Việc này không liên quan đến lợi ích của bản thân tôi... là bạn bè nên tôi phải quay về đó giúp bạn ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210219
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400210219,
					"content": "Còn vị anh trai kia nữa, nhà lữ hành, bạn sẽ cứu anh ấy chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210220,
						400210221
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400210220,
					"content": "Tuy là anh ta sẽ không sao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400210222
					]
				},
				{
					"id": 400210222,
					"content": "Vậy đi thôi, chúng ta lén lén đi tìm Shiki Taishou nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400210221,
					"content": "Nhưng tôi cũng không thể bỏ mặc không lo được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400210222
					]
				}
			]
		},
		{
			"id": 4002103,
