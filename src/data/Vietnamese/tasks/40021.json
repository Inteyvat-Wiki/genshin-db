			},
			"dialogs": [
				{
					"id": 400210301,
					"content": "Xinyan, nhà lữ hành, Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210302
					],
					"speakerTitle": "Shiki Taishou"
				},
				{
					"id": 400210302,
					"content": "Ban nãy có một nữ tướng dẫn theo nhiều người đến gần đây thám thính.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210303
					],
					"speakerTitle": "Shiki Taishou"
				},
				{
					"id": 400210303,
					"content": "Cô ấy là người của Hiệp Hội Tenryou, Kujou Sara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400210304,
					"content": "Kujou Sara... Tôi chưa từng nghe qua về người này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210305
					],
					"speakerTitle": "Shiki Taishou"
				},
				{
					"id": 400210305,
					"content": "Tôi hình như có nghe nói chủ tướng của Hiệp Hội Tenryou, là một người đàn ông, tên là Kujou... gì gì đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210306
					],
					"speakerTitle": "Shiki Taishou"
				},
				{
					"id": 400210306,
					"content": "Tôi có chút không nhớ rõ, nhưng tôi nhớ là Harunosuke đã từng chơi cờ với anh ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210307
					],
					"speakerTitle": "Shiki Taishou"
				},
				{
					"id": 400210307,
					"content": "Nghe có vẻ như Harunosuke là một nhân vật tai to mặt lớn đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400210308,
					"content": "Chuyện này chúng ta nói sau vậy, nhân lúc không có ai, chúng ta mau quay về Đền Âm Dương đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210309
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400210309,
					"content": "Đúng vậy, còn phải tìm cái tên phiền phức kia nữa, đi thôi đi thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400210310,
					"content": "Được, các vị đi theo tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shiki Taishou"
				}
			]
		},
		{
			"id": 4002105,
			"completionStepIds": [
				4002105
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4002105",
