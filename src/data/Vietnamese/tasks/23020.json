			"dialogs": [
				{
					"id": 230200501,
					"content": "Ôi! Cảm ơn bạn, Nhà Lữ Hành. Đây là thù lao của bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200502
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200502,
					"content": "Chậc, số vật liệu này nặng thật đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200503
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200503,
					"content": "Tôi sẽ nhanh chóng bắt tay vào làm. Con thuyền nhỏ này không dài lắm, chắc một thời gian là xuống nước thử được rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200504
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200504,
					"content": "...Đến lúc đó anh phải chuẩn bị một số đồ cứu hộ đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200505
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230200505,
					"content": "Haiz, được rồi, chắc chắn không có vấn đề gì đâu, cô cứ tin tôi đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rafiq"
				}
			]
