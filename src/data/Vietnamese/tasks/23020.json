				},
				{
					"id": 230200202,
					"content": "Nhưng nếu thật sự xuống nước thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200203
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230200203,
					"content": "Quên đi, anh ấy sẽ không muốn nghe những gì tôi nói đâu...",
