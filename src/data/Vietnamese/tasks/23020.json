			"trigger": {
				"objectNames": [
					"Rafiq",
					"Qishan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230200101,
					"content": "...Bởi vậy, tôi cảm thấy không thể tiết kiệm về mặt vật liệu ở mảng này được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200102
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230200102,
					"content": "Yên tâm đi, sức bền ở mảng này chắc chắn đủ rồi, tôi đã tính rất nhiều lần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200103
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200103,
					"content": "Đã bảo có rất nhiều vấn đề không thể tính ra được mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200104
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230200104,
					"content": "Mọi người đang cãi nhau về chuyện gì thế?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230200105
					]
				},
				{
					"id": 230200105,
					"content": "Là bạn à, chúng tôi đang thảo luận về thiết kế con tàu đó của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200106
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200106,
					"content": "Tôi đã thực hiện đủ các bước tính toán, đảm bảo rằng mỗi chỗ đều có đủ sức bền.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200107
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200107,
					"content": "Nhưng Qishan cứ khăng khăng rằng, sức bền ở mấy chỗ đó chưa chắc đáng tin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200108
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200108,
					"content": "Những \"sức bền\" anh nói tới chỉ tồn tại trên lý thuyết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200109
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230200109,
					"content": "Sức bền mà con thuyền phải chịu sau khi xuống nước chắc chắn sẽ cao hơn con số này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200110
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230200110,
					"content": "Tôi hiểu rõ điều này... nhưng tài chính của tôi có hạn... và...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200111
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200111,
					"content": "Nếu mua những vật liệu đắt tiền hơn, cùng lắm tôi chỉ có thể đóng được sống thuyền thôi... Khụ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200112
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200112,
					"content": "Tóm lại! Trước mắt con thuyền này cứ làm theo kế hoạch của tôi, về phần vật liệu thì tôi đã mua xong rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200113
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200113,
					"content": "Nhà Lữ Hành, nếu bạn đồng ý, có thể đi chuyển một phần nguyên liệu về trước được không? Một mình tôi chuyển không hết...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200114,
						230200115
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200114,
					"content": "Không thành vấn đề.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230200118
					]
				},
				{
					"id": 230200118,
					"content": "Vậy làm phiền bạn rồi, tôi phải tính một số thứ ở đây đã. Chờ tính xong tôi sẽ chuyển chỗ nguyên liệu còn lại về...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200115,
					"content": "Qishan cũng biết đóng thuyền sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230200116
					]
				},
				{
					"id": 230200116,
					"content": "Không, nhưng cô ấy tính toán có khi còn nhanh hơn cả tôi tính nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200117
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200117,
					"content": "Không hiểu sao cô ấy lại chịu làm nhân viên phục vụ trong thành nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200118
					],
					"speakerTitle": "Rafiq"
				}
			]
		},
