				]
			},
			"dialogs": [
				{
					"id": 747150101,
					"content": "Freminet, sao trông mệt mỏi thế này? Dạo này đi trục vớt vất vả lắm sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747150102,
					"content": "Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150103
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747150103,
					"content": "Thôi đừng trốn vào mũ lặn nữa! Chúng ta là bạn tốt mà, nói ra sẽ thoải mái hơn là cứ dồn nén trong lòng đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747150104,
					"content": "...Ừm, tôi hiểu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150105
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747150105,
					"content": "Lúc nãy khi xuống nước để trục vớt, tôi đã gặp một người khá đáng ghét.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150106
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747150106,
					"content": "Người đáng ghét sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747150107,
					"content": "Ừm... phải bắt đầu từ đâu nhỉ. Theo quy định của Fontaine, hàng hóa chìm xuống nước, nếu chủ cũ đã nhận được khoản bồi thường bảo hiểm thì chúng sẽ trở thành tài sản tự do.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150108
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747150108,
					"content": "Theo quy tắc này, có người xem việc lặn là cách làm giàu. Bằng cách trục vớt đồ đạc của người khác, rồi khi lên bờ thì đem bán lấy Mora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150109
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747150109,
					"content": "Cách này không yêu cầu quá cao, dẫn đến việc có không ít... người chỉ muốn làm giàu lẫn vào trong số các thợ lặn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150110
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747150110,
					"content": "Đôi khi, họ sẽ hung hăng xua đuổi cá và Hải Thú Bồng Bềnh, chỉ vì chúng cản trở việc kiếm tiền... Tôi không nhận một số ủy thác cũng vì phần nào liên quan đến những người như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150111
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747150111,
					"content": "Ra là vậy... Có thể hiểu được tâm trạng của Freminet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747150112,
					"content": "Lúc nãy ở dưới nước, tôi lại gặp phải tình huống tương tự. Tôi đã lấy hết can đảm để ngăn chặn hành vi của họ. Mặc dù cuối cùng vẫn... bị mắng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150113
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747150113,
					"content": "Sao lại thế chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150114,
						747150115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747150114,
					"content": "Cậu đã làm đúng mà!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747150116
					]
				},
				{
					"id": 747150116,
					"content": "#Cảm ơn ý tốt của {NICKNAME} và Paimon, nhưng mà... dù với tôi, việc này rất khó và mệt mỏi, nhưng tôi vẫn muốn tự mình nỗ lực để thay đổi điều gì đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150117
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747150117,
					"content": "Tôi thích cảm giác được bơi lội dưới nước, quan sát các đường vân của Ốc Beryl, cảm nhận hơi thở của Hoa Romaritime...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150118
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747150118,
					"content": "Khi nhận được sự công nhận của thế giới dưới nước, nó sẽ đáp lại chúng ta bằng thiện ý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150119
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747150119,
					"content": "Tôi nghĩ, đây mới là cách chúng ta nên chọn để sống chung với thế giới, chứ không phải cứ ích kỷ mà chiếm đoạt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150120
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747150120,
					"content": "Tôi thấy những điều Freminet nói cũng hay lắm đó! Thấy không, khi thực sự có điều muốn làm, muốn nói, thì bộc lộ ra sẽ thoải mái hơn nhiều chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747150121,
					"content": "Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150122
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747150122,
					"content": "Freminet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747150123,
					"content": "Xin lỗi... tôi hơi xấu hổ. Tóm lại... tôi sẽ tiếp tục cố gắng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150124
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747150124,
					"content": "Suýt quên... Đây là những thông tin thăm dò dưới nước mới nhất, hãy cầm lấy nhé, chắc chắn sẽ có ích với hai người đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747150115,
					"content": "Lần sau chúng tôi có thể ra mặt giúp cậu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747150116
					]
				}
			]
		}
	]
}