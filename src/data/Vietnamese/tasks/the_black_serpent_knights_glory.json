			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dainsleif"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80070301,
					"content": "Làm sao đây, dù cho tiêu diệt tên Vực Sâu đó rồi nhưng vẫn không thể dừng thiết bị lại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80070302,
					"content": "Halfdan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070303,
						80070304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80070303,
					"content": "Hãy để tôi thay thế anh ấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80070305
					]
				},
				{
					"id": 80070305,
					"content": "#Không được! Chỉ cần thiết bị vẫn đang chạy, những người hứng chịu lời nguyền như chúng tôi sẽ không thể phát huy sức mạnh như ban đầu, chỉ có {F#cô}{M#cậu} mới có thể chống lại Vực Sâu thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070306
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80070306,
					"content": "#Nếu {F#cô}{M#cậu} quý trọng sự cống hiến của anh ấy, thì đừng tiếp tục lãng phí thời gian ở đây nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070307
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80070307,
					"content": "Nhìn thấy những tia sáng và cửa dịch chuyển đó không? Chúng chắc là đã phân tán các thiết bị đến những nơi khác. Mau qua đó kiểm tra tình hình đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070308
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80070308,
					"content": "Phải đi xuyên qua cửa dịch chuyển của Vực Sâu sao... Này đợi đã!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80070304,
					"content": "Tôi sẽ không bị ảnh hưởng bởi hiệu quả thanh tẩy lời nguyền.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80070305
					]
				}
			]
		},
