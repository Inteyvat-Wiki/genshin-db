			},
			"dialogs": [
				{
					"id": 80070101,
					"content": "Cứ ngỡ là linh hồn của Halfdan sẽ tan biến ngay chứ... không ngờ anh ấy lại kiên cường như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070102
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80070102,
					"content": "Thứ cản đường! Mau tránh ra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070103
					],
					"speakerTitle": "Linh Mục Vực Sâu"
				},
				{
					"id": 80070103,
					"content": "Nhìn đi đâu vậy? Cơ hội hiếm có, cuối cùng ngươi cũng có cơ hội để trừ khử ta rồi, không phải sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070104
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80070104,
					"content": "...Dainsleif!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070105
					],
					"speakerTitle": "Linh Mục Vực Sâu"
				},
				{
					"id": 80070105,
					"content": "Tiêu diệt hắn rồi đóng thiết bị đó lại đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				}
			]
		},
		{
			"id": 800703,
			"completionStepIds": [
				800703
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
