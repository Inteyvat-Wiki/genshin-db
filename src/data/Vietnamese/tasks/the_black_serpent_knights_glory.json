			"dialogs": [
				{
					"id": 80070901,
					"content": "Lần này cuối cùng cũng đóng được thiết bị đó rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80070902,
					"content": "Cảm thấy dễ chịu hơn rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070903
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80070903,
					"content": "Chúng ta đã ngăn cản được kế hoạch của Vực Sâu rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070904,
						80070905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80070904,
					"content": "Nhưng mà Halfdan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80070906
					]
				},
				{
					"id": 80070906,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070907
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80070907,
					"content": "Để tôi xác nhận lại xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070908
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80070908,
					"content": "Dain, anh ấy... hẳn đang rất buồn nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070909
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80070909,
					"content": "Chiến hữu năm xưa, không ngờ lại tái ngộ như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070910
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80070910,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070911
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80070911,
					"content": "...Đi thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80070905,
					"content": "Anh ấy hình như đã không còn sống nữa rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80070906
					]
				}
			]
		},
