			},
			"dialogs": [
				{
					"id": 80071001,
					"content": "Ban nãy là... linh hồn của Halfdan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80071002,
					"content": "Nơi này không chỉ tập trung một loại sức mạnh kỳ lạ, đến cả linh hồn cũng rất kỳ quái.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071003
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80071003,
					"content": "Nhưng mà, nếu hai người muốn tiếp tục đi về phía trước thì phải hết sức cẩn thận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071004
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80071004,
					"content": "Khụ khụ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071005
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80071005,
					"content": "Ừm, chúng tôi sẽ cẩn thận. À đúng rồi, Dain không đi cùng chúng tôi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071006
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80071006,
					"content": "Thiết bị lúc nãy gây ra cho tôi khá nhiều chấn thương, tôi cần chút thời gian để hồi phục.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071007
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80071007,
					"content": "Thì ra là vậy... Không đúng, thật ra tôi đã nhìn ra từ lâu rồi, anh chỉ đang gắng gượng mà thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071008
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80071008,
					"content": "Cũng nên nghỉ ngơi rồi, Dain... Ví dụ như là, hãy tự cho mình một kỳ nghỉ hay gì đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80071009,
					"content": "Nghỉ phép sao? Đây không phải là một từ nên xuất hiện ở tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071010
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80071010,
					"content": "Tôi còn có việc quan trọng hơn phải làm. Kế hoạch \"Máy Dệt Vận Mệnh\" vẫn đang được tiến hành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071011
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80071011,
					"content": "Thậm chí tôi còn nghi ngờ rằng những thiết bị khuếch đại ở đây có liên quan đến kế hoạch đó nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071012,
						80071013
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80071012,
					"content": "Tôi cũng sẽ để ý.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80071014
					]
				},
				{
					"id": 80071014,
					"content": "#Cám ơn sự thông cảm của {F#cô}{M#cậu}, \"chủ nhân\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071015
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80071015,
					"content": "#Chỉ hy vọng lần sau gặp lại, {F#cô}{M#cậu} sẽ không đứng ở chiến tuyến bên kia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071016
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80071016,
					"content": "Này, có phải Dain thù dai nên mới nói như vậy không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071017
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80071017,
					"content": "#Mặc dù không thể gặp lại {M#em gái}{F#anh trai} bạn lần nữa, nhưng cũng xem như tìm hiểu được rất nhiều thông tin có ích đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071018
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80071018,
					"content": "Chỉ cần tiếp tục nỗ lực với hành trình của mình, hai người nhất định sẽ gặp lại nhau, và mọi thứ sẽ trở lại bình thường thôi, đúng chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071019
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80071019,
					"content": "À đúng rồi, bạn còn nhớ lý do ban đầu chúng ta đến đây là để điều tra hành tung của Hilichurl không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071020
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80071020,
					"content": "Bây giờ xem ra đã có thể tìm anh thợ mỏ để báo cáo rồi, có điều... những chuyện xảy ra ở đây quá phức tạp đối với những người bình thường!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071021
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80071021,
					"content": "Tóm lại, đừng quên ủy thác này là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80071013,
					"content": "Đợi anh bình phục, tôi và anh sẽ thảo luận thêm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80071014
					]
				}
			]
		},
