			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ootomo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726910101,
					"content": "#{M#Chàng trai}{F#Cô gái}, ta thấy cháu quanh quẩn ở đây đã lâu, chắc cũng là một người tao nhã, biết thưởng thức văn học nghệ thuật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910102
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726910102,
					"content": "Hiện tại ta có một việc liên quan đến tao nhã muốn nhờ cháu giúp đỡ, không biết ý cháu thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910103
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726910103,
					"content": "Xin cứ nói.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726910104
					]
				},
				{
					"id": 726910104,
					"content": "Ta và nhà thơ đến từ Mondstadt - Lenne mới gặp mà như đã quen từ lâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910105
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726910105,
					"content": "Ngài Ootomo nói đúng, tuy tôi mới biết ông ấy được vài ngày nhưng tôi rất ngưỡng mộ kiến thức của ông ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910106
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726910106,
					"content": "Haha, Lenne khách sáo rồi. Tóm lại, hai chúng tôi quyết định trở thành bạn bè hội thơ ca, và nhân cơ hội này cùng nhau sáng tác một số tác phẩm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910107
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726910107,
					"content": "Vì đã rất vất vả mới đến được Inazuma, nên Lenne rất muốn đưa những yếu tố đặc sắc về Inazuma vào tác phẩm của mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910108
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726910108,
					"content": "Đúng vậy, đáng tiếc hành trình ở Inazuma quá đỗi bận rộn, không có thời gian để dạo chơi ngắm cảnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910109
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726910109,
					"content": "Vậy tôi có thể làm gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726910110
					]
				},
				{
					"id": 726910110,
					"content": "Tôi đang viết một bài thơ về chủ đề \"Nhớ Nhà\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910111
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726910111,
					"content": "Người lữ khách nhìn thấy cảnh vật nơi đất khách quê người, thường bất giác nhớ về quê hương của mình, vì vậy tôi muốn thêm vào bài thơ một số hình ảnh độc đáo của nơi đất khách.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910112
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726910112,
					"content": "Không biết bạn có thể chụp vài tấm hình bằng máy ảnh, giúp tôi tìm thấy cảm hứng sáng tác không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910113
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726910113,
					"content": "Inazuma chắc chắn là có rất nhiều cảnh vật độc đáo phải không? Ví dụ như khi nhắc đến Mondstadt, người ta sẽ nghĩ ngay đến \"bồ công anh\" và \"Cúc Cánh Quạt\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910114
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726910114,
					"content": "Ồ! Tôi hiểu rồi, vậy thì chúng tôi đi chụp vài tấm hình về những đặc sản của Inazuma là được chứ gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726910115,
					"content": "Ừm, vậy thì làm phiền các bạn rồi! Tôi đã chép một bản sao của bài thơ mới sáng tác được một nửa để cho các bạn tham khảo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910116
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726910116,
					"content": "Về số lượng cần chụp, tôi chỉ cần <color=#00E1FFFF>4 tấm</color> hình có nội dung khác nhau là được, tôi cũng sẽ chuẩn bị thù lao tương xứng cho các bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910117
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726910117,
					"content": "#{NICKNAME}, nếu đã rõ yêu cầu của Lenne rồi thì chúng ta xuất phát thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
