					"nextDialogs": [
						726910302
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726910302,
					"content": "Chụp xong rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726910303
					]
				},
				{
					"id": 726910303,
					"content": "Cảm ơn bạn rất nhiều. Để tôi xem nào... quả nhiên là những thứ mà tôi chưa từng thấy! Hmm, tấm này chụp rất đẹp! Tấm này có vẻ cũng đáng để viết về...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910304
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726910304,
					"content": "Nhờ những tấm hình mà các bạn chụp, tôi đã có cảm hứng rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910305
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726910305,
					"content": "Dựa trên những hình ảnh các bạn cung cấp, tôi đã cố gắng viết một vài câu khác nhau, nhưng thực sự không biết nên sử dụng câu nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910306
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726910306,
					"content": "Tôi rất muốn biết ý kiến của bạn, nếu là bạn thì bạn sẽ chọn câu nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lenne"
				}
			]
		},
