			"dialogs": [
				{
					"id": 120460201,
					"content": "Mizuki, chúng tôi đến để đặt lịch cho lần trị liệu tâm lý tiếp theo đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460202,
					"content": "Hộc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460203
					],
					"speakerTitle": "Hyakujitsuhaku Shion"
				},
				{
					"id": 120460203,
					"content": "Thật khó chịu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460204
					],
					"speakerTitle": "Shiba Murasaki"
				},
				{
					"id": 120460204,
					"content": "Hả? Có chuyện gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460205,
					"content": "Khi vừa tỉnh dậy là họ đã thành ra thế này rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460206
					],
					"speakerTitle": "Aikawa Susumu"
				},
				{
					"id": 120460206,
					"content": "...Là tình trạng khó tiêu cực độ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460207
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460207,
					"content": "Hả? Không lẽ hôm qua Shion và Murasaki đã ăn rất nhiều ác mộng sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460208,
					"content": "#Chắc không đâu nhỉ... Khách đăng ký hôm qua ngoài {NICKNAME} và Paimon ra thì chỉ còn hai người nữa thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460209
					],
					"speakerTitle": "Aikawa Susumu"
				},
				{
					"id": 120460209,
					"content": "Hai người đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460210,
					"content": "Ác mộng của hai người đó có vấn đề. Ngoại trừ số lượng ra thì còn có cả cường độ của ác mộng nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460211
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460211,
					"content": "Ý là, không một người bình thường nào lại gặp phải cơn ác mộng lớn đến thế này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460212
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460212,
					"content": "Ọe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460213
					],
					"speakerTitle": "Hyakujitsuhaku Shion"
				},
				{
					"id": 120460213,
					"content": "Nếu không giúp họ nhanh chóng tiêu hóa ác mộng thì sẽ nguy mất...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460214
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460214,
					"content": "Tiếp theo cần làm gì? Chúng tôi sẽ giúp!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460215,
					"content": "Phải tìm được hai vị khách đó trước, tìm hiểu nguyên nhân họ gặp ác mộng, rồi tôi mới có thể giúp Shion và Murasaki tiêu hóa ác mộng được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460216
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460216,
					"content": "#{NICKNAME}, Paimon, hôm qua hai vị đã trò chuyện với họ rồi, có thể tìm được họ không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460217
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460217,
					"content": "À đúng rồi, họ nói còn phải tìm Emura Ichigensai để được hướng dẫn thêm lần nữa. Rất có thể hôm nay sẽ đến nơi đó tiếp!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460218,
					"content": "Hãy đưa tôi đến đó nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yumemizuki Mizuki"
				}
			]
		},
