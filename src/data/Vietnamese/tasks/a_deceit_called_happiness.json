						],
						"pointId": 322100714
					}
				]
			},
			"dialogs": [
				{
					"id": 120460301,
					"content": "Hôm nay ra biển, lúc quăng lưới do sơ ý nên đã làm mất tấm lưới lớn luôn. Nhưng cũng không sao, haha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460302
					],
					"speakerTitle": "Umihiko"
				},
				{
					"id": 120460302,
					"content": "Tôi cũng làm hỏng một chuyện. Nhưng giờ nghĩ lại, thả mấy tên cướp đi cũng không có gì to tát cả, haha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460303
					],
					"speakerTitle": "Susukida"
				},
				{
					"id": 120460303,
					"content": "Này, hai người kia! Chính vì ác mộng của hai người mà Murasaki và Shion mới thành ra như vậy đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460304,
					"content": "Sao đứa nhóc này lại tức giận thế? Thật là thú vị, haha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460305
					],
					"speakerTitle": "Susukida"
				},
				{
					"id": 120460305,
					"content": "Thú vị thật, haha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460306
					],
					"speakerTitle": "Umihiko"
				},
				{
					"id": 120460306,
					"content": "Chuyện này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460307,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460308
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460308,
					"content": "Hai người này kỳ lạ quá. Tôi thấy giọng điệu ban nãy của mình hơi dữ, nhưng họ lại chẳng tức giận chút nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460309,
					"content": "...Để tôi. Này, hai anh còn nhớ chuyện tối qua đến Phòng Tắm Hơi Aisa để điều tiết giấc mơ không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460310
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460310,
					"content": "Có chuyện đó sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460311
					],
					"speakerTitle": "Umihiko"
				},
				{
					"id": 120460311,
					"content": "Hình như không có nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460312
					],
					"speakerTitle": "Susukida"
				},
				{
					"id": 120460312,
					"content": "Hừm... Dạo gần đây hai anh có gặp ác mộng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460313
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460313,
					"content": "Không. Thế giới này đâu có thứ gì khiến người ta phải gặp ác mộng chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460314
					],
					"speakerTitle": "Susukida"
				},
				{
					"id": 120460314,
					"content": "Để tôi nghĩ xem... Hình như không có. Người bình thường sao có thể gặp ác mộng được chứ? Chúng ta đều ngắm biển, ngắm hoa, cuộc đời tươi đẹp biết bao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460315
					],
					"speakerTitle": "Umihiko"
				},
				{
					"id": 120460315,
					"content": "Chuyện gì thế này? Họ hoàn toàn không nhớ gì về chuyện tối qua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460316,
					"content": "Nhưng mà, tình trạng hiện tại của họ thì tôi nghĩ họ sẽ không gặp phải ác mộng... Lẽ nào Emura Ichigensai đó thực sự không nói dối sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460317,
					"content": "#Không, trạng thái tâm lý này rất kỳ lạ... {NICKNAME}, Paimon, đừng phân tâm, có lẽ tôi sẽ phải dùng một vài phương pháp đặc biệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460318
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460318,
					"content": "Đây là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460319,
					"content": "Tôi phát hiện ra trạng thái phân ly trong tiềm thức của họ rồi. Như vậy tôi có thể dùng cách tương tự như lúc đi vào giấc mơ để bước vào đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460320
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460320,
					"content": "Đáng ghét! Đáng ghét! Không thể thả chúng ra được! Tuyệt đối không!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460321
					],
					"speakerTitle": "Susukida",
					"speakerSubtitle": "Susukida Phẫn Nộ"
				},
				{
					"id": 120460321,
					"content": "Sóng gió lớn quá, cho tôi về bờ đi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460322
					],
					"speakerTitle": "Umihiko",
					"speakerSubtitle": "Umihiko Sợ Hãi"
				},
				{
					"id": 120460322,
					"content": "Hả?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460323,
					"content": "Mọi người thấy đấy, \"phiền não\" của họ vẫn chưa được xóa bỏ hoàn toàn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460324
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460324,
					"content": "Susukida hơi dễ nóng giận, chuyện này sẽ khiến anh ta bộc phát những hành động bất thường, khó tránh khỏi tổn thương sâu sắc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460325
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460325,
					"content": "Còn Umihiko... có lẽ là vì đã trải qua tai nạn nào đó mà trở nên sợ hãi với sóng biển, không muốn ra khơi. E rằng kế sinh nhai của anh ta cũng bị ảnh hưởng rất lớn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460326
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460326,
					"content": "Cảm xúc tiêu cực của họ đã bị cưỡng chế để tách ra khỏi tâm trí, phân ly sâu sắc trong tiềm thức. Vậy nên họ sẽ chỉ thể hiện ra sự vui vẻ bên ngoài.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460327
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460327,
					"content": "Tuy nhiên, những cảm xúc bị kìm nén đó sẽ liên tục lan rộng trong tiềm thức, cuối cùng biến thành cơn ác mộng không thể tiêu hóa của Murasaki và Shion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460328
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460328,
					"content": "Tại sao lại như vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460329
					]
				},
				{
					"id": 120460329,
					"content": "E là Emura Ichigensai không đơn giản như chúng ta nghĩ. Có lẽ anh ta thực sự có khả năng tác động đến cảm xúc con người, nên những người đó không thể nhìn thấu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460330
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460330,
					"content": "Hôm qua lúc hai vị đến đây có thấy điểm gì bất thường không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460331
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460331,
					"content": "Lúc đó hai người họ cực kỳ nghiêm túc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460332
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460332,
					"content": "Để mà nói thì...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460333
					]
				},
				{
					"id": 120460333,
					"content": "Bạn nhớ lại giấc mơ kỳ quái hôm qua, sau đó miêu tả lại cho Mizuki.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						120460334
					]
				},
				{
					"id": 120460334,
					"content": "Có chuyện như vậy nữa à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460335
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460335,
					"content": "Lúc đó tôi không để ý lắm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460336
					]
				},
				{
					"id": 120460336,
					"content": "Lẽ nào... Hmm, chúng ta phải nhanh chóng tìm ra Emura Ichigensai thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460337
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460337,
					"content": "Mizuki, sao đột nhiên lại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460338
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460338,
					"content": "Hiện tại tôi có thể xác nhận Emura Ichigensai đó không phải người thường, những người từng được \"hướng dẫn\" đều là nạn nhân của anh ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460339
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460339,
					"content": "Nếu không kịp thời giải quyết căn nguyên là Emura Ichigensai, thì nhân cách của những nạn nhân sẽ bị tổn hại đến mức không thể cứu vãn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460340
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460340,
					"content": "Woa... Vậy thì cũng chỉ có thể hỏi hai người họ thôi! Này, hai anh có biết khi nào Emura Ichigensai sẽ đến đây không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460341
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460341,
					"content": "Sao đột nhiên gấp gáp vậy? Lúc nào đến thì có liên quan gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460342
					],
					"speakerTitle": "Susukida"
				},
				{
					"id": 120460342,
					"content": "Lúc nào đến mà chẳng được chứ, haha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460343
					],
					"speakerTitle": "Umihiko"
				},
				{
					"id": 120460343,
					"content": "Tức chết đi mất!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460344
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460344,
					"content": "Thực ra hai anh vẫn nhớ chuyện xảy ra tối qua đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460345
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460345,
					"content": "Hai anh không muốn nhắc đến là vì cơn ác mộng quấy rối đêm qua không phù hợp với \"niềm vui\" hiện tại, đúng chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460346
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460346,
					"content": "Chỉ cần nhớ lại một chút là sẽ xuất hiện cảm giác tan vỡ không thể diễn tả, gần như muốn xé tan tâm trí của hai anh, phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460347
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460347,
					"content": "Đừng nói nữa... Chỉ cần không nghĩ đến thì mọi chuyện đều sẽ ổn thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460348
					],
					"speakerTitle": "Umihiko"
				},
				{
					"id": 120460348,
					"content": "Đây chính là hiểm họa tiềm ẩn mà Emura Ichigensai để lại cho hai anh. Nhưng hiện giờ tôi cũng không định đính chính những lời tự lừa dối của hai anh đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460349
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460349,
					"content": "Chỉ cần hai anh trả lời câu hỏi vừa rồi một cách đàng hoàng là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460350
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460350,
					"content": "Được rồi... Nhưng thực sự chúng tôi không biết. Vừa nãy chúng tôi cũng hỏi rồi, chỉ biết là hôm nay ngài ấy sẽ không đến thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460351
					],
					"speakerTitle": "Susukida"
				},
				{
					"id": 120460351,
					"content": "Đúng đó, chắc là do hôm qua mệt quá rồi chăng?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460352
					],
					"speakerTitle": "Umihiko"
				},
				{
					"id": 120460352,
					"content": "Anh ta lại cố ý tránh né tôi rồi à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460353
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460353,
					"content": "Lẽ nào vẫn không thể hỏi được thông tin gì hữu ích sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460354
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460354,
					"content": "Hai vị đã thăm dò được là Emura Ichigensai sống ở đâu chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460355
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460355,
					"content": "Hôm qua có hỏi rồi, người quản lý cũng không biết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460356
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460356,
					"content": "Nếu đã như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460357,
						120460358
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460357,
					"content": "Mizuki, bây giờ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460359
					]
				},
				{
					"id": 120460359,
					"content": "Hiện giờ thì... Tôi đã hiểu được ác mộng của hai người đó, đúng là có thể chữa trị cho Murasaki và Shion rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460360,
						120460361
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460360,
					"content": "Vậy đi chữa trị cho họ trước đi nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460362
					]
				},
				{
					"id": 120460362,
					"content": "...Thực ra sau khi hai vị đưa tôi đến đây, tôi đã không còn lý do để làm phiền hai vị nữa rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460363
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460363,
					"content": "#{NICKNAME} và tôi vẫn đang đợi lần trị liệu tâm lý tiếp theo mà. Nếu Mizuki vẫn phải lo lắng về tên đó thì không biết khi nào chúng tôi mới có cơ hội đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460364
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460364,
					"content": "Vậy nên, trước khi Mizuki có thể yên tâm vận hành Phòng Tắm Hơi Aisa thì chúng tôi nhất định sẽ giúp đỡ đến cùng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460365
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460365,
					"content": "...Tôi không thể do dự về tình trạng hiện tại của Murasaki và Shion lâu hơn được nữa, vậy đành làm phiền hai vị một lần nữa vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460366
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460366,
					"content": "Nhưng tôi có một thỉnh cầu. Nếu tìm thấy Emura Ichigensai, chỉ cần theo dõi, xin đừng ra tay, tìm người báo tin cho tôi trước đã nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460367
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460367,
					"content": "Tóm lại, tôi không muốn hai vị gặp nguy hiểm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460368
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460368,
					"content": "#Đừng lo, tôi và {NICKNAME} đã từng đánh bại nhiều kẻ địch mạnh mẽ rồi mà. Tên này chỉ là hạng tôm tép thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460369
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460369,
					"content": "Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460370
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460370,
					"content": "Được rồi, chúng tôi nhất định sẽ báo tin cho cô trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460371
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460371,
					"content": "Vậy thì được rồi, chúng ta hành động thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460372
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460372,
					"content": "#{NICKNAME} không muốn Mizuki lo lắng phải không? Nhưng nếu không tìm được tên đó thì phải làm sao đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460373
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460373,
					"content": "Hai tên kia... Có hỏi thêm nữa cũng vô ích.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460374,
						120460375
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460374,
					"content": "Chắc chắn là họ không biết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460376
					]
				},
				{
					"id": 120460376,
					"content": "Miko? Nhớ rồi, hôm qua chúng ta có thể tìm được đến đây cũng là nhờ cô ấy. Xem ra Miko biết khá nhiều thông tin đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460377
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460377,
					"content": "Không thể chậm trễ nữa, mau đến Đền Narukami thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460375,
					"content": "Nhưng có lẽ Miko sẽ biết...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460376
					]
				},
				{
					"id": 120460361,
					"content": "Tôi sẽ lo việc tìm kiếm Emura Ichigensai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460362
					]
				},
				{
					"id": 120460358,
					"content": "Có thể chữa trị cho Murasaki và Shion chưa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460359
					]
				}
			]
		},
