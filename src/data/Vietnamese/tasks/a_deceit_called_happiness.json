				},
				{
					"id": 120460403,
					"content": "Woa! Từ lúc nào mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460404,
					"content": "Đã lâu không gặp rồi, đại nhân Guuji.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460405
					]
				},
				{
					"id": 120460405,
					"content": "Giọng điệu này hơi giống người bạn cũ của tôi đó... Đừng khách sáo nữa, trông hai cưng hình như có việc gì gấp gáp nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460406,
						120460407
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460406,
					"content": "Chúng tôi muốn hỏi thăm một người.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460408
					]
				},
				{
					"id": 120460408,
					"content": "Hôm qua tôi đã nói rõ rồi, thế mà vẫn chưa tìm được người sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460409
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460409,
					"content": "Quả nhiên hôm qua cô cố ý nói như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460410,
					"content": "...Thôi bỏ qua đã. Nếu đã đến đây nhờ giúp đỡ thì ít nhất cũng phải nói rõ tình hình chứ nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460411
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460411,
					"content": "Thôi được. Hôm qua chúng tôi đã đến địa chỉ đó, tiếc là không nắm bắt được cơ hội.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460412,
					"content": "Bây giờ tên đó không còn xuất hiện ở đó nữa. Nghe nói hắn đang ở ẩn để tu luyện, chúng tôi không biết phải đi đâu tìm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460413,
					"content": "Haiz... Để tìm được địa chỉ hôm qua đã không hề dễ dàng rồi mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460414
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460414,
					"content": "Nếu cần thì chúng tôi có thể chia sẻ thêm chút thông tin mới. Emura Ichigensai đó có thể chính là vị khách mà Mizuki từng làm việc, tôi nhớ tên là Emura Chuuya gì đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460415,
					"content": "Ồ? Là tên đó sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460416
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460416,
					"content": "Miko biết à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460417,
					"content": "Lần đó khi tôi bảo Nhà Xuất Bản Yae tổ chức sự kiện nhận thư từ độc giả, tôi vốn dĩ muốn tìm người cùng chung sở thích để bàn một số chuyện thú vị, kết quả là cái tên này xuất hiện...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460418
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460418,
					"content": "Tên gieo rắc phiền não và người giúp xóa bỏ phiền não... là cùng một người sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460419
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460419,
					"content": "Với tình hình điều tra trước mắt của chúng tôi thì quả thật rất có khả năng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460420,
					"content": "Được rồi. Nếu hai cưng muốn tìm tên này thì có thể đến địa chỉ này xem thử.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460421
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460421,
					"content": "Địa chỉ này... Thực sự có người sống ở đó sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460422,
					"content": "Hắn ta từng đặt mua một lúc vài chục cuốn tiểu thuyết từ Nhà Xuất Bản Yae, sau đó để lại địa chỉ nhận hàng này, còn yêu cầu mang hàng đến nơi rồi mới trả tiền nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460423
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460423,
					"content": "Bên kho tưởng là trò đùa, nên đã từ chối đơn hàng. Kết quả là bị hắn ta mắng cho một trận trong lá thư độc giả gửi về đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460424
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460424,
					"content": "Giờ nghĩ lại, người có tính cách như vậy thực sự có thể sống ở nơi đó đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460425
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460425,
					"content": "Chà... Đi tìm Miko quả là đúng đắn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460426
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460426,
					"content": "Giúp được người bạn cũ của tôi thì tốt rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460427
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460427,
					"content": "Vậy là cô cũng muốn giúp Mizuki à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460428
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460428,
					"content": "Tôi thấy Mizuki đã đầu tư không ít vào Phòng Tắm Hơi Aisa rồi. Hiện giờ nơi đó đang gặp khó khăn, tôi là bạn bè, nên đương nhiên cũng phải quan tâm đôi chút rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460429
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460429,
					"content": "Trông dáng vẻ hôm qua, tôi còn tưởng cô định đi cãi nhau chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460430,
					"content": "Chắc Mizuki cũng đã nói với hai cưng là chúng tôi có mối quan hệ cạnh tranh đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460431
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460431,
					"content": "Từ khi còn là đồng môn thì cô ấy đã luôn cho là như vậy rồi. Giờ tôi là Guuji của Đền Narukami, chắc chắn cô ấy cũng muốn chứng minh bản thân bằng Phòng Tắm Hơi Aisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460432
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460432,
					"content": "Nếu vấn đề kinh doanh sống còn này cần phải nhờ đến tôi để giải quyết... Thì tôi cũng sẽ cân nhắc đến tâm trạng của người bạn cũ đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460433
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460433,
					"content": "Hiếm khi thấy cô chu đáo như vậy đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460434
					]
				},
				{
					"id": 120460434,
					"content": "Tôi sẽ coi đó là lời khen. Người bạn cũ kia đã quá quen với việc chu đáo với người khác rồi, cũng nên có người chu đáo lại với cô ấy thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460435,
						120460436
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460435,
					"content": "Nếu cô không tiện ra mặt thì...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460437
					]
				},
				{
					"id": 120460437,
					"content": "Cưng hiểu nhanh lắm. Lúc đến đây cả hai vội vàng như vậy, giờ còn thời gian để tán gẫu sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460438
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460438,
					"content": "À, chúng ta mau đi báo cho Mizuki đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460436,
					"content": "Để tôi giúp vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460437
					]
				},
				{
					"id": 120460407,
					"content": "Cô có biết Emura Ichigensai đang ở đâu không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460408
					]
				}
			]
		},
