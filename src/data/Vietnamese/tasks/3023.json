			"dialogs": [
				{
					"id": 30230201,
					"content": "Đừng sốt ruột. Chuyện lớn như vậy đâu thể chuẩn bị xong ngay được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230202
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30230202,
					"content": "Cứ từ từ suy nghĩ, cần đảm bảo tính hợp lý của kế hoạch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230203
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30230203,
					"content": "Đang nói chuyện sao lại chuyển sang đọc sách rồi! Này! Anh thật là!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30230204,
					"content": "Cần tôi cho Paimon mượn quyển sách không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230205
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30230205,
					"content": "Không cần, sách của anh không phù hợp với tôi đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30230206,
					"content": "Nói khách sáo thôi. Sách của tôi đúng là không phù hợp với Paimon tí nào, nên sẽ không có chuyện cho mượn đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230207
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30230207,
					"content": "Hừ! Tức chết được...",
					"roleType": "TALK_ROLE_NPC",
