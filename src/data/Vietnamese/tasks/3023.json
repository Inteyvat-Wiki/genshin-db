					"nextDialogs": [
						30230402
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30230402,
					"content": "Hơn nữa, công việc độ khó cao như vậy lại không mang lại lợi nhuận nào cả, thật không thể tin được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230403
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30230403,
					"content": "Nghĩ theo chiều hướng tốt đi, biết đâu xong việc này sẽ phát tài thì sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30230404,
					"content": "Nói cũng phải. Ừm, nếu Paimon đột nhiên trở thành người giàu có thì Paimon muốn làm gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230405
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30230405,
					"content": "Tôi muốn mua rất nhiều rất nhiều đồ ăn ngon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30230406,
					"content": "Thế thôi á?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230407
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30230407,
					"content": "Ừm... rồi mua thêm đồ uống ngon nữa nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30230408,
					"content": "Hahaha, đáng yêu thật đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230409
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30230409,
					"content": "Nếu vậy, vì những tưởng tượng tốt đẹp này... tôi cũng sẽ giúp đỡ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230410
