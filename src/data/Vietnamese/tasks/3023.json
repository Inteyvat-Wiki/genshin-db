			"dialogs": [
				{
					"id": 30230301,
					"content": "Nếu tôi có thể giúp gì được cho mọi người thì cứ nói cho tôi biết nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230302
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 30230302,
					"content": "Tuy không thể rời khỏi Làng Aaru, nhưng trông dáng vẻ của các bạn, không hiểu sao tim tôi lại đập rộn cả lên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230303
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 30230303,
					"content": "Trước đây tôi chỉ một thân một mình chiến đấu, đâu có háo hức được như hôm nay...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230304
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 30230304,
					"content": "Tôi nghĩ, đây chính là sức mạnh của bạn đồng hành chăng.",
					"roleType": "TALK_ROLE_NPC",
