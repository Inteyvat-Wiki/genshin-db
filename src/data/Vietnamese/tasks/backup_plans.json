			"dialogs": [
				{
					"id": 766530501,
					"content": "Hm... Nghiên cứu này có nên tiếp tục không nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530502
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530502,
					"content": "Đây là cái gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766530503,
					"content": "Gián Điệp Zip-zap Số 1!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530504
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530504,
					"content": "Không hiểu lắm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766530505,
					"content": "Nói chính xác thì đây là nền tảng thử nghiệm của Gián Điệp Zip-zap Số 1, và nó là loại robot tàng hình mới nhất mà Aino thiết kế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530506
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 766530506,
					"content": "Không lâu trước đây, cô ấy đã mua một con robot dọn dẹp bị bỏ đi từ chợ đen. Sau khi cải tạo nó thì đã có được Gián Điệp Zip-zap Số 1 như hiện tại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530507
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 766530507,
					"content": "Còn nền tảng này mô phỏng rất nhiều loại môi trường thù địch nguy hiểm, có thể dùng nó để kiểm tra khả năng tàng hình của Gián Điệp Zip-zap Số 1.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530508
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 766530508,
					"content": "Tại sao Aino lại thiết kế robot tàng hình?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766530509,
					"content": "Sau khi phát hiện Krum-clank 70% Ngọt bị trộm đi, Aino đã quyết tâm: \"dù đối phương có thế lực mạnh đến đâu thì cũng phải cứu đồng đội về\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530510
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 766530510,
					"content": "Sau đó cô ấy nhanh chóng hoàn thành bản thảo thiết kế của Gián Điệp Zip-zap Số 1 và bắt đầu nghiên cứu phát triển.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530511
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 766530511,
					"content": "Theo dự kiến, một khi nghiên cứu phát triển hoàn tất, dù là Cục Thiết Kế Thí Nghiệm Kuuvahki được canh phòng nghiêm ngặt thì nó cũng có thể dễ dàng lẻn vào và cứu đồng đội ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530512
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 766530512,
					"content": "Nghe có vẻ lợi hại ghê!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766530513,
					"content": "Nhưng Aino nhanh chóng nhận ra việc hoàn thiện phương án cần rất nhiều thời gian, thế là cô ấy lại từ bỏ ý định này. Aino cảm thấy trực tiếp lật tung cả Nod-Krai sẽ nhanh hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530514
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 766530514,
					"content": "Tôi quyết định rồi! Nếu đã bình tĩnh xử lý thì cứ tiếp tục đẩy mạnh việc phát triển Gián Điệp Zip-zap Số 1 thôi. Nó chắc chắn sẽ góp sức vào việc giải cứu đồng đội!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530515
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530515,
					"content": "#Nếu đã vậy, có thể nhờ {NICKNAME} và Paimon giúp kiểm tra một chút không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530516
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 766530516,
					"content": "Dựa trên kết quả thống kê trước đây, nếu có dữ liệu tham khảo từ những người thử nghiệm khác thì tốc độ phát triển của Aino ít nhất có thể tăng 30%.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530517
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 766530517,
					"content": "Nghe có vẻ thú vị đấy! Tôi tham gia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766530518,
					"content": "Cả tôi nữa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766530519
					]
				},
				{
					"id": 766530519,
					"content": "Vậy tôi xin thay mặt Aino cảm ơn hai vị trước. Tôi sẽ mở quyền hạn cho hai vị, sau này muốn thử nghiệm thì cứ trực tiếp sử dụng nền tảng này là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ineffa"
				}
			]
		}
	]
}