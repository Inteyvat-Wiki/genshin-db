			"dialogs": [
				{
					"id": 716662101,
					"content": "Hay lắm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662102
					],
					"speakerTitle": "Nghe Đánh Giá Lần Tới"
				},
				{
					"id": 716662102,
					"content": "Thì ra đấu bọ của Bang Arataki đã phát triển thành một cuộc thi mang tính cạnh tranh khốc liệt như vậy. Hmm, đúng là có thể viết thành một câu chuyện hấp dẫn và kể cho mọi người nghe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662103
					],
					"speakerTitle": "Nghe Đánh Giá Lần Tới"
				},
				{
					"id": 716662103,
					"content": "Tian huynh đài nhường đã rồi. Ta đấu rất là sảng khoái!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662104
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716662104,
					"content": "Phải là \"đã nhường\" mới đúng, Quỷ Vương.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662105
					],
					"speakerTitle": "Tướng Quân Hanakado"
				},
				{
					"id": 716662105,
					"content": "Hừm! Chi tiết nhỏ thì không quan trọng! Nói chung... cảm ơn Tian huynh đài đã nể mặt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662106
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716662106,
					"content": "Làm phiền bang chủ Arataki rồi. Trong thời gian này, tôi sẽ đến quan sát đấu bọ để thu thập tư liệu! Mọi người cứ chơi thoải mái, không cần bận tâm đến tôi đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662107
					],
					"speakerTitle": "Nghe Đánh Giá Lần Tới"
				},
				{
					"id": 716662107,
					"content": "Đúng là một đối thủ tao nhã, nói đến mức đầu óc mình mông lung theo, như học được một số kiến thức khác ngoài đấu bọ vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662108
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716662108,
					"content": "Xem ra Tập Huấn Đấu Bọ Arataki Rực Cháy lần này đã có một khởi đầu tốt đẹp!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				}
			]
		},
