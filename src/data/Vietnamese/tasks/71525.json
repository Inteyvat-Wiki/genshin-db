			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nghe Đánh Giá Lần Tới"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-336.767,
							200.419,
							-709.591
						],
						"pointId": 7026
					}
				]
			},
			"dialogs": [
				{
					"id": 716662001,
					"content": "Các vị, Tian Miệng Sắt tôi mang bảng thông báo chính thức của Tập Huấn Đấu Bọ Arataki Rực Cháy đến rồi đây, xin hãy nhận lấy. Đây cũng xem như là giấy phép tổ chức sự kiện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662002
					],
					"speakerTitle": "Nghe Đánh Giá Lần Tới"
				},
				{
					"id": 716662002,
					"content": "Ồ! Đây là Tên Thả Bò và Xích Hồng Chùy sao? Khoa trương thật đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716662003,
					"content": "Tuyệt quá! Tuy không phải kiệt tác của bổn đại gia... nhưng hãy xem bố cục và đường nét này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662004
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716662004,
					"content": "Hoành tráng! Oai phong! Hoàn toàn thể hiện được khí thế cao thủ đấu bọ của bổn đại gia đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662005
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716662005,
					"content": "Vị... à ừm... cách gọi tôn kính của người Liyue là gì nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662006
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716662006,
					"content": "\"Huynh đài\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662007
					],
					"speakerTitle": "Tướng Quân Hanakado"
				},
				{
					"id": 716662007,
					"content": "Đúng rồi! Vị huynh đài đây vẽ giỏi thật! Bang Arataki... vô cùng cảm kích!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662008
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716662008,
					"content": "Quá khen rồi bang chủ Bang Arataki, Tian Miệng Sắt tôi chỉ là người kể chuyện mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662009
					],
					"speakerTitle": "Nghe Đánh Giá Lần Tới"
				},
				{
					"id": 716662009,
					"content": "Bức tranh này là do một tiểu thư trong Tổng Vụ vẽ đó. Ngày thường cô ấy được tiểu thư Yanfei giúp đỡ, nên khi nghe nói tổ chức một sự kiện như vậy, đã chủ động cống hiến một kiệt tác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662010
					],
					"speakerTitle": "Nghe Đánh Giá Lần Tới"
				},
				{
					"id": 716662010,
					"content": "Thì ra là quà của Yanfei! Đại ân nhân thậm chí còn nghĩ đến thứ này nữa... Chu toàn thật!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662011
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716662011,
					"content": "Nghe Tướng Quân Hanakado nói Tập Huấn Đấu Bọ Arataki Rực Cháy là một cuộc tập huấn có hoài bão và ý nghĩa to lớn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662012
					],
					"speakerTitle": "Nghe Đánh Giá Lần Tới"
				},
				{
					"id": 716662012,
					"content": "Tôi không phải chuyên gia đấu bọ, nhưng đã nghe qua rất nhiều câu chuyện liên quan, nên từ lâu đã muốn thử rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662013
					],
					"speakerTitle": "Nghe Đánh Giá Lần Tới"
				},
				{
					"id": 716662013,
					"content": "Nói không chừng còn có thể tìm được cảm hứng viết ra những câu chuyện xuất sắc để kể cho hàng xóm nghe nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662014
					],
					"speakerTitle": "Nghe Đánh Giá Lần Tới"
				},
				{
					"id": 716662014,
					"content": "Đấu bọ rất cần năng khiếu, như \"Dưa Tím Thép Trắng Kinh Thiên Động Địa\" đại nhân đây, chỉ thử thôi mà đã thể hiện được sức mạnh vượt trội của mình rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662015
					],
					"speakerTitle": "Tướng Quân Hanakado"
				},
				{
					"id": 716662015,
					"content": "Nói không chừng sau khi vị huynh đài Tian đây hiểu được thú vui trong đấu bọ, sẽ có thể quảng bá giúp chúng tôi thông qua cách kể chuyện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662016
					],
					"speakerTitle": "Tướng Quân Hanakado"
				},
				{
					"id": 716662016,
					"content": "Có chuyện tốt vậy sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662017
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716662017,
					"content": "Vậy thì xin người anh em Tian... nói sao nhỉ... à, xin hãy chỉ giáo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				}
			]
		},
