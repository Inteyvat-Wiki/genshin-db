			"dialogs": [
				{
					"id": 761930130,
					"content": "(Ơ? Không lẽ đó là... là, là Melusine!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930101
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761930101,
					"content": "Ối! Thật sự là Melusine! Melusine dễ thương, Melusine ngoan ngoãn, Melusine bé nhỏ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930102
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761930102,
					"content": "Ơ...? Đây là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930103
					],
					"speakerTitle": "Mamere"
				},
				{
					"id": 761930103,
					"content": "Ừm... tôi có thể thử chạm vào nhóc không? Tôi luôn tò mò, không biết khi chạm vào một Melusine nhỏ xinh, vừa đáng yêu vừa thông minh thì cảm giác sẽ thế nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930104
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761930104,
					"content": "Là trơn trượt, mềm mại, hay là êm ái... Hihi, đừng sợ nhé, thật sự chỉ chạm thử thôi mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930105
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761930105,
					"content": "Hả, hả...?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930106
					],
					"speakerTitle": "Mamere"
				},
				{
					"id": 761930106,
					"content": "Xin hãy giữ bình tĩnh, thưa quý cô, để tránh vi phạm pháp luật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930107
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761930107,
					"content": "Tiểu thư Mamere là công dân của Đại Sảnh Fontaine. Tiếp xúc thân thể khi chưa được phép sẽ gây ra hiểu lầm và dẫn đến hậu quả nghiêm trọng, bao gồm án tù trên ba năm cùng với lệnh cấm nhập cảnh vĩnh viễn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930108
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761930108,
					"content": "Ốiii! Cỗ, cỗ máy biết chuyển động và nói chuyện!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930109
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761930109,
					"content": "...Khụ! Xin lỗi xin lỗi, vì Melusine thực sự quá dễ thương nên tôi không kiềm chế được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930110
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761930110,
					"content": "Tôi tên là Linnea, là cố vấn của Hiệp Hội Nhà Mạo Hiểm! Thật sự không phải là người kỳ quái đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930111
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761930111,
					"content": "Phủ nhận. Bất kỳ kẻ kỳ quái nào cũng sẽ không tự nhận mình là kẻ kỳ quái. Đây là logic suy luận cơ bản, thưa cô Linnea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930112
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761930112,
					"content": "Aah...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930113
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761930113,
					"content": "Không được tuỳ tiện nói người khác là kẻ kỳ quái đâu, Seymour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930114
					],
					"speakerTitle": "Mamere"
				},
				{
					"id": 761930114,
					"content": "Chị gái fae nhỏ nhắn, có màu sắc rất đẹp. Tuy không giống như ch{RUBY#[D]Elynas}a, nhưng ấm áp, rất xinh đẹp. Vì vậy không phải là người kỳ quái.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930115
					],
					"speakerTitle": "Mamere"
				},
				{
					"id": 761930115,
					"content": "Phủ nhận. Ngoài màu tím ra, các màu sắc thường không liên quan đến lập trường. Đây là logic suy luận cơ bản, tiểu thư Mamere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930116
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761930116,
					"content": "...Không phải nói về màu sắc trang phục đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930117
					],
					"speakerTitle": "Mamere"
				},
				{
					"id": 761930117,
					"content": "Ơ? Sao lại loại trừ màu tím vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930118
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761930118,
					"content": "Dù sao thì... Xin chào, Linnea. Em là Mamere, một họa sĩ du lịch đến từ Fontaine. Còn đây là Seymour, bạn thân của em.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930119
					],
					"speakerTitle": "Mamere"
				},
				{
					"id": 761930119,
					"content": "Không ngờ lại gặp người khác ở nơi này. Chị gái Linnea cũng đến tìm cảm hứng sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930120
					],
					"speakerTitle": "Mamere"
				},
				{
					"id": 761930120,
					"content": "Tìm cảm hứng à... Ừm, để tôi nghĩ xem, bổ sung thêm vào cẩm nang cũng có thể coi là tìm cảm hứng chứ nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930121
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761930121,
					"content": "Kể với Mamere về chú Cá Voi Vây Sương màu hồng đó...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						761930122
					]
				},
				{
					"id": 761930122,
					"content": "Nhưng mà... Hihi, biết đâu Maisie nói đúng, chú Cá Voi Vây Sương đó thực sự là loài động vật mang lại may mắn cho mọi người! Thậm chí còn giúp tôi gặp được Melusine xinh đẹp nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930123
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761930123,
					"content": "Xin hãy giữ bình tĩnh, thưa quý cô, để tránh vi phạm pháp luật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930124
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761930124,
					"content": "T-tôi biết rồi! Tôi sẽ không đụng chạm lung tung đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930125
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761930125,
					"content": "Ra vậy. Chị Linnea thích động vật lắm à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930126
					],
					"speakerTitle": "Mamere"
				},
				{
					"id": 761930126,
					"content": "Đúng vậy! Huhu, giá như tôi cũng có thể bơi nhanh như Melusine thì tốt biết mấy! Đám Cá Voi Vây Sương chơi vui quá, tôi cũng muốn chơi cùng chúng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930127
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761930127,
					"content": "Ừm... Vậy thì tặng bức tranh này cho chị Linnea nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930128
					],
					"speakerTitle": "Mamere"
				},
				{
					"id": 761930128,
					"content": "Tuy không thể giúp chị bơi nhanh dưới nước. Nhưng treo trong phòng thì chắc cũng sẽ có cảm giác \"đang chơi cùng Cá Voi Vây Sương\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930129
					],
					"speakerTitle": "Mamere"
				},
				{
					"id": 761930129,
					"content": "Woa, cảm ơn nhóc nhé! Bức tranh đẹp quá! Đợi khi trở về, tôi nhất định phải cho mọi người ở Speranza xem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linnea"
				}
			]
		}
	]
}