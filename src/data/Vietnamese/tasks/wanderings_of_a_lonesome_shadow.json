					],
					"speakerTitle": "Thư Với Nét Chữ Nắn Nót"
				},
				{
					"id": 191737202,
					"content": "\"Các ghi chú và bản thảo do Tamimi để lại đều đã được sắp xếp và sao chép, tất cả chúng đều được ký tên bằng quý danh của tiền bối.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191737203
					],
					"speakerTitle": "Thư Với Nét Chữ Nắn Nót"
				},
				{
					"id": 191737203,
					"content": "\"...Mong rằng sau trăm năm, các thế hệ học trò mai sau vẫn nhớ tên của tiền bối Faruzan.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Thư Với Nét Chữ Nắn Nót"
