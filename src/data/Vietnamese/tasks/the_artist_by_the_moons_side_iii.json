			"dialogs": [
				{
					"id": 760600101,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600102
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760600102,
					"content": "Hả? Đó không phải là Maalaus sao? Nó lại ra ngoài tìm cảm hứng à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600103,
					"content": "Ừm, nhưng sau khi quay về thì cứ như thế, giống như đang suy nghĩ chuyện gì đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600104
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760600104,
					"content": "Không chừng là chủ đề lần này sâu sắc hơn, giống như họa sĩ vĩ đại đột nhiên ngộ ra chân lý thế gian gì đó ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600105,
					"content": "Kể ra thì Maalaus đã cho chúng ta rất nhiều tranh rồi. Nếu cứ vẽ tiếp, không khéo có thể tổ chức triển lãm tranh cho nó luôn đấy nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600106,
					"content": "Hihi, đến lúc đó tôi sẽ kể cho mọi người nghe về quá trình sáng tác của họa sĩ Maalaus. Đương nhiên, nếu thực sự muốn tổ chức triển lãm thì cũng phải được Columbina đồng ý đã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600107,
					"content": "Hửm? Tại sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600108
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760600108,
					"content": "Maalaus toàn vẽ về cô thôi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760600109
					]
				},
				{
					"id": 760600109,
					"content": "À, không sao, tôi không để ý đâu. Chuyện này nghe có vẻ thú vị đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600110
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760600110,
					"content": "~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600111
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760600111,
					"content": "Ồ! Hình như Maalaus đã quyết định sẽ vẽ gì rồi! Mau lên nào, xem chúng ta có màu vẽ nào phù hợp không đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600112,
					"content": "Lần này... hãy chọn những tông màu trầm lắng tĩnh lặng đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
