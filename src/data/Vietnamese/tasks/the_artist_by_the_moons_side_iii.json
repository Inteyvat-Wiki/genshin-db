			"dialogs": [
				{
					"id": 760600301,
					"content": "Được rồi, thế này đi. Maalaus thấy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600302,
					"content": "~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600303
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760600303,
					"content": "Xem ra nó khá hài lòng đấy. Hihi... Lần này sẽ là bức tranh thế nào đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600304,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600305
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760600305,
					"content": "Hả? Đã vẽ xong rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600306,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600307
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760600307,
					"content": "Trông Maalaus có hơi đau lòng, có phải vì bức tranh không? Để tôi xem nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600308,
					"content": "Ah, lần này cũng vẫn vẽ Columbina này. Đây là đang... đi dạo dưới ánh trăng sao? Trong tranh, cô đang ngẩng đầu nhìn bầu trời đêm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600309,
					"content": "Có lẽ tôi... đang nhìn vầng trăng ở bên ngoài bầu trời giả đấy. Trước kia tôi hay đi dạo vào ban đêm như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600310
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760600310,
					"content": "Trước kia? À... Kể ra thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600311,
					"content": "(Giờ đây Columbina hầu như chỉ có thể ở trong khu vườn này... Rõ ràng Nod-Krai là nơi cô ấy sinh ra mà...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760600312
					]
				},
				{
					"id": 760600312,
					"content": "Trước đây khi đi dạo, tôi sẽ nghĩ, trên Sương Nguyệt thực sự đó rốt cuộc có những gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600313
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760600313,
					"content": "Liệu có nhiều động vật nhỏ giống như ở đây không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600314
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760600314,
					"content": "Hay là thật ra chẳng có gì cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600315
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760600315,
					"content": "Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600316,
						760600319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600316,
					"content": "Hay là mang một ít lên đó nhé?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760600317
					]
				},
				{
					"id": 760600317,
					"content": "#Hah, suy nghĩ của {F#cô}{M#cậu} thú vị thật đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600318
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760600318,
					"content": "Nhưng mà... mặt trăng đó là ở bên ngoài bầu trời giả. Có lẽ không nên để những động vật nhỏ cùng tôi mạo hiểm thì hơn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600322
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760600322,
					"content": "(Một bên là mái nhà không thể tự do đi lại... Một bên là mái nhà không biết sẽ có những gì...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760600323
					]
				},
				{
					"id": 760600323,
					"content": "(...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760600324
					]
				},
				{
					"id": 760600324,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600325
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760600325,
					"content": "Maalaus chắc sẽ không nỡ để cô đi đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600326,
					"content": "Tôi cũng không nỡ xa chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600327
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760600327,
					"content": "Nhưng rốt cuộc thì đây cũng là chuyến đi của một mình tôi, cần tôi tự mình đi tìm đáp án.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600328
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760600328,
					"content": "Biết đâu đáp án này thực ra rất tuyệt vời thì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600329
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760600329,
					"content": "Vậy đến lúc đó... Chúng tôi sẽ đưa Maalaus đến thăm cô!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600330
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600330,
					"content": "Được thôi. Cùng tổ chức triển lãm tranh trên mặt trăng nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600331
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760600331,
					"content": "Woa, nghe cũng được đấy nhỉ! Chốt như thế nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600332
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600332,
					"content": "Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600333
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760600333,
					"content": "Mong là vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760600319,
					"content": "Nói không chừng còn có những sinh linh đáng yêu khác đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760600320
					]
				},
				{
					"id": 760600320,
					"content": "Ừm, mong là vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600321
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760600321,
					"content": "Cũng mong chúng sẽ chào đón vị \"thần\" đột nhiên trở về nhà như tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600322
					],
					"speakerTitle": "Columbina"
				}
			]
		},
