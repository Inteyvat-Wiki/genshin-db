			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jinwu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710890201,
					"content": "Jinwu, chúng tôi tìm thấy cái này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710890202,
					"content": "Được rồi, đừng có cuống lên. Các bạn tìm thấy cái gì? Có liên quan đến tung tích của Zhiqiong hả?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890203
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710890203,
					"content": "Là thư cô ấy để lại, cô ấy đi vào nơi sâu hơn trong Vực Đá Sâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710890204
					]
				},
				{
					"id": 710890204,
					"content": "...Cảm ơn, mau đưa tôi xem trong thư viết gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890205
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710890205,
					"content": "Jinwu cẩn thận đọc lá thư của Zhiqiong.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710890206
					]
				},
				{
					"id": 710890206,
					"content": "Con bé này... Tôi không nghĩ đến vấn đề lại nghiêm trọng thế này, cũng không tiện đánh giá lựa chọn của Zhiqiong. Nhưng có lẽ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890207
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710890207,
					"content": "Có lẽ là do tôi đã không thừa nhận phát hiện của nó, cũng không đủ thấu hiểu và tôn trọng nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890208
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710890208,
					"content": "Rõ ràng, nếu không có bản đồ của nó, cuộc thăm dò tiếp theo sẽ khó hoàn thành... Nhưng tôi luôn lo lắng cho thể trạng của con bé, mà bỏ qua những nỗ lực và thành tích của nó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890209
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710890209,
					"content": "Dù sao ngay từ đầu con bé đã không giống với những thợ mỏ đó, sao tôi lại không nghĩ đến điểm này chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890210
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710890210,
					"content": "Cô ấy chỉ không muốn bị lãng quên.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710890211
					]
				},
				{
					"id": 710890211,
					"content": "Đối với những người thường không được thần linh để ý tới như chúng tôi, ai mà không như vậy cơ chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890212
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710890212,
					"content": "Ai mà không như vậy... Nhưng có mấy ai cố chấp như con bé chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890213
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710890213,
					"content": "Nhưng một khi nghĩ đến bản thân đã từng có một lúc nào đó từ bỏ mong muốn mình trở nên vĩ đại... một khi nghĩ đến bản thân đã quen với sự bình phàm này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890214
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710890214,
					"content": "Lại càng không có mặt mũi nào để phán xét những người trẻ tuổi như Zhiqiong nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinwu"
				}
			]
		}
	]
