			"dialogs": [
				{
					"id": 721380201,
					"content": "A, bạn đến rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380202
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380202,
					"content": "Bạn hái được thuốc chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasumoto"
