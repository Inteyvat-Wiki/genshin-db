					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380302,
					"content": "Là những thứ này à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380303
					]
				},
				{
					"id": 721380303,
					"content": "Tốt lắm, chừng này đủ rồi. Có thể nghiên cứu thuốc mới rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380304
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380304,
					"content": "Một lần nữa cảm ơn bạn, đây là thù lao đã hứa với bạn. Mong bạn đừng chê.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380305
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380305,
					"content": "Tiện thể, người ngoại quốc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380306
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380306,
					"content": "À, xin lỗi. Làm phiền bạn nhiều rồi mà vẫn chưa biết phải xưng hô thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380307
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380307,
					"content": "#Gọi tôi {NICKNAME} là được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380308
					]
				},
				{
					"id": 721380308,
					"content": "#{NICKNAME}, nếu bạn còn muốn giúp đỡ thì một thời gian nữa lại đến nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380309
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380309,
					"content": "Đương nhiên sẽ không thiếu thù lao, haha.",
