	"talks": [
		{
			"id": 7213801,
			"completionStepIds": [
				7213801
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7213801",
							"2"
						],
						"stepId": 7213801,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Yasumoto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721380101,
					"content": "Á! Tôi...Tôi không phải người khả nghi, tôi chỉ là một bác sĩ địa phương thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380102
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380102,
					"content": "Nếu không tin, tôi có thể đưa các bạn đến chỗ tôi ở, các bạn thiếu gì thì cứ lấy, hãy tha cho tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380103
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380103,
					"content": "Hoặc là đưa tôi đến chỗ Kujou đại nhân! Anh ta biết tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380104,
						721380105
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380104,
					"content": "Chắc bạn hiểu lầm gì đó rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380106
					]
				},
				{
					"id": 721380106,
					"content": "Ơ...? Trông các bạn không giống người của Quân Shogunate...cũng không giống bọn người đến từ Quân Sangonomiya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380107
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380107,
					"content": "Các bạn là...người ngoại quốc? Tại sao lại xuất hiện ở đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380108,
						721380109
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380108,
					"content": "Thật ra...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380110
					]
				},
				{
					"id": 721380110,
					"content": "Haiz...dù thế nào, tốt nhất là các bạn nên sớm rời khỏi đây. Bây giờ Đảo Yashiori rất nguy hiểm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380111
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380111,
					"content": "Đến hôm nay, Họa Thần vẫn chưa có dấu hiệu tiêu tan, Hiệp Hội Tenryou cũng không có ý định rút quân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380112
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380112,
					"content": "Hòn đảo này không còn thích hợp để ở nữa, huống gì là tham quan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380113
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380113,
					"content": "Nếu bạn là người ngoại quốc vì trốn chạy sự truy bắt Tenryou mà chạy đến đây thì hãy chạy về phía tây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380144
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380144,
					"content": "Hiệp Hội Tenryou không hoan nghênh những kẻ đào tẩu không rõ nguồn gốc, nhưng nói không chừng hải tặc sẽ chấp nhận bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380114,
						721380115
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380114,
					"content": "Trên đảo đã xảy ra chuyện gì sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380116
					]
				},
				{
					"id": 721380116,
					"content": "Hừm...bạn tự xem đi. Người trong thành và bọn Quân Sangonomiya đã gây ra những gì!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380117
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380117,
					"content": "Đầu tiên là vụ nổ của Tatarasuna, bầu trời đêm hôm đó nhuộm một màu kỳ lạ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380140
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380140,
					"content": "Rất nhiều người thân bạn bè không còn việc làm, không cơm ăn áo mặc, rất nhiều người bị thương nặng khi trở về nhà, trông rất kinh khủng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380141
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380141,
					"content": "Cũng có rất nhiều người...không chạy thoát được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380118
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380118,
					"content": "Sau đó bọn Quân Sangonomiya đã phá hủy vật trấn giữ Xương Rắn, Họa Thần bùng lên, người trên đảo bỏ chạy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380119
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380119,
					"content": "Những căn bệnh kỳ lạ do Họa Thần gây ra cũng ngày càng lan rộng, người dân ở đây hầu hết đều nhiễm bệnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380142
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380142,
					"content": "E là chuyện tràn vào hai doanh trại cũng chỉ là vấn đề thời gian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380143
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380143,
					"content": "Đây là nơi nào?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380120
					]
				},
				{
					"id": 721380120,
					"content": "Nơi này vốn là nơi sản xuất Tinh Thạch cần cho việc chế tạo \"Thép Ngọc\" của Inazuma. Chỉ cần khoáng thạch không cạn kiệt, chúng tôi sẽ có thể sống tốt mà không bị các đại nhân trong thành phố chèn ép.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380121
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380121,
					"content": "Bây giờ thì sao? Trên đảo chẳng còn được mấy người...Ý tôi nói là \"người\" có thể nói chuyện đàng hoàng như tôi đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380122
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380122,
					"content": "Sao bạn không rời đi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380123
					]
				},
				{
					"id": 721380123,
					"content": "Ai không muốn đi chứ? Đại nhân của Hiệp Hội Tenryou cũng từng mời gọi tôi...có lẽ bây giờ anh ta vẫn đang ở trong quân đốc thúc chiến đấu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380124
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380124,
					"content": "\"Anh biết y thuật, không giống với dân thường. Ở trên đảo thật sự rất nguy hiểm, chi bằng gia nhập quân y của tôi. Tôi có thể đề cử anh với phụ thân.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380145
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380145,
					"content": "Anh ta nói như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380125
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380125,
					"content": "Trước khi chiến tranh xảy ra, việc chữa bệnh cho Tenryou đại nhân của Đảo Narukami là vinh dự mà cả đời một bác sĩ nhỏ bé như tôi cũng không dám nghĩ tới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380126
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380126,
					"content": "Nhưng bây giờ...bạn nghĩ xem, bên cạnh Tenryou đại nhân có không ít danh y, còn Đảo Yashiori thì sao? Ở đây bệnh nhân chỉ có thể trông cậy vào tôi thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380127
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380127,
					"content": "Cho nên tôi sẽ không đi, cũng không xem bệnh cho riêng quân sĩ nào cả. Kẻ địch của tôi chỉ có Họa Thần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380128
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380128,
					"content": "Có thể giúp được gì không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380129
					]
				},
				{
					"id": 721380129,
					"content": "Không có...ừm, mà thôi, tôi thật sự cần giúp đỡ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380130
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380130,
					"content": "Tôi cần một ít thảo dược đặc biệt để điều chế thuốc, thử trị những căn bệnh kì lạ do Họa Thần gây ra. Dù không biết hiệu quả thế nào...nhưng thử vẫn hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380131
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380131,
					"content": "Có điều...những thảo dược đó bị nhiễm Họa Thần, và hầu hết mọc ở những nơi nguy hiểm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380146
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380146,
					"content": "Dù cho ở đây có ngăn cách với đất trời, hay có ma vật chiếm đóng, vả lại nơi đây bị nhiễm \"Họa Thần\" rất nghiêm trọng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380132
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380132,
					"content": "Với bản lĩnh và khả năng của mình, e là rất khó ứng phó được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380133
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380133,
					"content": "Hơn nữa tôi là bác sĩ, không dám mạo hiểm như vậy để hái thuốc, chỉ có thể sử dụng các liệu pháp điều trị kéo dài...lâu rồi không nghiên cứu được loại thuốc nào mới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380134
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380134,
					"content": "Tôi thấy bạn có Phong Chi Dực, chắc bạn là Nhà Lữ Hành giàu kinh nghiệm. Mức độ nguy hiểm này có lẽ rất dễ khắc phục.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380135
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380135,
					"content": "Vì vậy hy vọng bạn có thể giúp tôi hái thuốc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380136
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380136,
					"content": "Hái được thuốc rồi thì đến đây gặp tôi. Đừng lo chuyện thù lao, tôi vẫn còn chút tiền để dành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380137
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380137,
					"content": "Mặc dù đây chỉ là ủy thác từ người lạ, nhưng tôi hy vọng bạn hãy suy nghĩ về nó. Cảm ơn rất nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380138
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380138,
					"content": "Bạn đi đường cẩn thận nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380115,
					"content": "Trông bạn có vẻ rất mệt mỏi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380116
					]
				},
				{
					"id": 721380109,
					"content": "Chuyện dài lắm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380110
					]
				},
				{
					"id": 721380105,
					"content": "Thật đáng nghi ngờ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380106
					]
				}
			]
		},
