				{
					"id": 722040401,
					"content": "Đi chơi đi, đi chơi đi...Bà sẽ không đi đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040402
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040402,
					"content": "Hoa ơi...hoa ơi...quê hương của hoa trông như thế nào nhỉ...?",
					"roleType": "TALK_ROLE_NPC",
