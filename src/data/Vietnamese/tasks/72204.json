			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Una"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722040701,
					"content": "Xin chào, xin chào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040702
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040702,
					"content": "Haiz, xin lỗi, lớn tuổi rồi nên không tránh khỏi đầu óc mơ hồ...cháu là ai vậy...? Ta có quen biết cháu sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040703,
						722040704
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040703,
					"content": "#Cháu là {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040705
					]
				},
				{
					"id": 722040705,
					"content": "Chưa từng nghe tên này bao giờ...là người từ bên ngoài đến sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040706
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040706,
					"content": "Kỳ lạ, kỳ lạ...Không được Lôi Điểu đại nhân cho phép, lẽ ra không ai có thể lên đảo mới phải chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040707,
						722040708
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040707,
					"content": "Lôi Điểu từ lâu đã không còn nữa rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040709
					]
				},
				{
					"id": 722040709,
					"content": "Haiz...Thấy cháu, bà lại nhớ tới người chồng đáng thương...Nhưng bây giờ, dáng vẻ của ông ấy bà cũng không còn nhớ nổi nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040710
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040710,
					"content": "Lúc đó ông bà đều còn trẻ, trong đầu đều là những điều viễn vông không thực tế...Nhưng có một số người, chung sống với nhau lâu rồi, nhưng vẫn không thể trưởng thành hơn chút nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040711
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040711,
					"content": "Ông ấy bỏ bà đi, làm một chiếc bè để vượt biển sang bên kia, đến hòn đảo của người ngoài...Ông ấy nói ông ấy muốn tự do đánh bắt ở đó, hái những đóa hoa chưa từng được thấy ...những đóa hoa xinh đẹp...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040712
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040712,
					"content": "Từ nhỏ ông ấy đã nói như vậy...nhưng thực ra ông ấy chưa từng trưởng thành bao giờ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040713
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040713,
					"content": "Sau này, con của tư tế đại nhân đã nhìn thấy ông ấy...nằm trên bãi biển, yên lặng như vỏ ốc, và còn trắng hơn cả cát biển...tay ông ấy, đang nắm lấy những cánh hoa này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040714
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040714,
					"content": "Tư tế đại nhân vừa khóc vừa nói với bà rằng...con thuyền của tổ tiên đã từ chối ông ấy. \"Linh hồn\" của ông ấy từ nay về sau chỉ có thể lang thang ở nơi đất khách quê người...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040715
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040715,
					"content": "Lúc đó bà vừa sinh con...chuyện này bà cũng không biết phải nói thế nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040716
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040716,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040717
					]
				},
				{
					"id": 722040717,
					"content": "Sau đó thì...con của bà cũng có con, rồi sau đó, bà lại đưa chúng lên con thuyền bạc sáng lấp lánh...nhưng bà vẫn cứ sống trên mảnh đất này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040718
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040718,
					"content": "Bây giờ lòng bà chỉ còn vướng bận về hai đứa Kito và Kina mà thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Una"
				},
				{
					"id": 722040708,
					"content": "Thật khó để giải thích nguyên nhân với bà...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040709
					]
				},
				{
					"id": 722040704,
					"content": "#Chào bà, gọi cháu là {NICKNAME} là được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040705
					]
				}
			]
		},
