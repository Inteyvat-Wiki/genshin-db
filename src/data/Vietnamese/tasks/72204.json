			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Una"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722040101,
					"content": "Kito, Kina, các cháu đến rồi à...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040102
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040102,
					"content": "Thật là...lại đi lung tung, bà không theo kịp các cháu nữa rồi...nếu lỡ gặp nguy hiểm thì phải làm sao chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040103,
						722040104
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040103,
					"content": "Chào bà...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040105
					]
				},
				{
					"id": 722040105,
					"content": "Ôi! Các cháu thật là...các cháu còn nhỏ, đừng nói những lời như vậy, nói như vậy sẽ làm bà đau lòng đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040106
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040106,
					"content": "Đã đến rồi thì đừng chạy lung tung...ở đây chơi với bà có được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040107,
						722040108
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040107,
					"content": "Xin lỗi, cháu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040109
					]
				},
				{
					"id": 722040109,
					"content": "Chuyện lần trước nói đến đâu rồi nhỉ...? À đúng rồi...đó là khi ông nội của ông nội các cháu còn trẻ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040110
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040110,
					"content": "Ở bên ngoài biển sương mù, trên hòn đảo của người ngoài, có một gia tộc tên là Sumari...chủ mẫu của họ là một cô gái trông giống hồ ly...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040111
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040111,
					"content": "Họ nói, vùng đất nơi đó có rất nhiều hoa sấm sét...Người dân Sumari đã xây nhà, sống trên những ngọn núi những cánh đồng như vậy, và yêu thương lẫn nhau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040112
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040112,
					"content": "Sau đó...hơ...hoa của họ...hơ...zzz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040113
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040113,
					"content": "Zzz...zzz...bên ngoài biển sương...ừm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040114,
						722040115
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040114,
					"content": "Bà ơi...? Bà không sao chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040116
					]
				},
				{
					"id": 722040116,
					"content": "Ơ...Kito? Kina? Ồ...các cháu sắp phải đi à? Haiz...thật ngại quá, bà ngủ quên mất...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040117
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040117,
					"content": "Trước khi đi, đừng quên cái này nhé...bà giữ nó cho các cháu đó...đây là hoa ở bên ngoài biển sương mù...đừng làm mất nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Una"
				},
				{
					"id": 722040115,
					"content": "(Hay thôi không làm phiền bà nữa...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040116
					]
				},
				{
					"id": 722040108,
					"content": "Thôi được...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040109
					]
				},
				{
					"id": 722040104,
					"content": "Chắc bà nhận nhầm người rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040105
					]
				}
			]
		},
