					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040602,
					"content": "Rốt cuộc đang nghĩ gì vậy...Rốt cuộc là đang nghĩ gì vậy chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
