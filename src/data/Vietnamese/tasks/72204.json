						722040906
					]
				},
				{
					"id": 722040906,
					"content": "Haiz...bà...sắp đi rồi, phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040907
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040907,
					"content": "Đi...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040908
					]
				},
				{
					"id": 722040908,
					"content": "Người lái thuyền đó, gần đây cứ đến hối thúc bà mãi đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040909
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040909,
					"content": "Lần nào cũng đến một cách thầm lặng, trên người mặc một chiếc áo lông màu vàng kim, một chiếc quần dài màu vàng kim và đội chiếc mũ tơ vàng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040910
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040910,
					"content": "Giống như những gì mẹ đã kể cho bà nghe, như những gì bà đã kể cho Kito và Kina...đưa những người ở đây lên con thuyền lấp lánh ánh bạc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040911
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040911,
					"content": "Mái chèo khua trên con sông lấp lánh...khua mãi cho đến khi cập bến giấc mơ. Vùng đất trong mơ ấy không có sương mù, trong đó có một ngôi nhà lớn màu vàng...có 70 cái nôi, lại 70 cái nôi...đung đưa đung đưa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040912
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040912,
					"content": "Mọi người ngủ say trong đó rồi hóa thành những đốm sáng lung linh...sau đó thì trở thành giấc mơ của những đứa trẻ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040913,
						722040914
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040913,
					"content": "Ồ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040915
					]
				},
				{
					"id": 722040915,
					"content": "Người lái thuyền nói...ông ấy thay Kito và Kina chuyển thứ này lại cho bà. Ha ha...hai đứa nhóc này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040916
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040916,
					"content": "Thật sự vẫn chưa phải lúc đâu...vẫn chưa phải lúc đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Una"
				},
				{
					"id": 722040914,
					"content": "Ý của bà là...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040915
					]
				},
				{
					"id": 722040905,
					"content": "#Cháu là {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040906
