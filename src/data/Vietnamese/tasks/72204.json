			"dialogs": [
				{
					"id": 722040301,
					"content": "Haiz...càng lúc càng không rõ...càng lúc càng không nhớ được mọi chuyện...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040302,
						722040303
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040302,
					"content": "Xin chào?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040304
					]
				},
				{
					"id": 722040304,
					"content": "Haiz...trí nhớ ngày càng kém. Già rồi, càng ngày càng nhiều chuyện không thể nhớ nổi nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040305
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040305,
					"content": "Như vậy phải làm sao chứ...cũng không biết Kito và Kina có đói không, chơi ở bên ngoài có an toàn không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040306,
						722040307
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040306,
					"content": "Sẽ không sao đâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040308
					]
				},
				{
					"id": 722040308,
					"content": "Kito, Kina! Sao bây giờ các cháu mới đến...trên đường có bị té ngã va quệt gì không? Có đi trèo cây không...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040309
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040309,
					"content": "Bà lo lắng quá đi thôi...Haiz, gần đây không biết xảy ra chuyện gì, người trên đảo càng ngày càng ít...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040310
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040310,
					"content": "Những người bà còn nhớ tên cũng ít hơn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040311
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040311,
					"content": "Haiz, lỡ như đến một lúc nào đó bà quên cả các cháu...vậy thì phải làm sao chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040312
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040312,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040313
					]
				},
				{
					"id": 722040313,
					"content": "Haiz...Những cánh hoa này bà cho các cháu, nếu một lúc nào đó bà quên cháu, thì hãy cho bà xem chúng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040314
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040314,
					"content": "Bà còn rất nhiều câu chuyện muốn kể cho các cháu nghe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Una"
				},
				{
					"id": 722040307,
					"content": "Cháu có thể giúp được gì không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040308
					]
				},
				{
					"id": 722040303,
					"content": "Xảy ra chuyện gì sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040304
					]
				}
			]
		},
