					"Una"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722040501,
					"content": "Là Abe à. Chuyện thu hoạch nấm ở nhà thế nào rồi? Khụ khụ...đừng có mà đi làm phiền tư tế đại nhân đó nha, ông ấy có khuyên nữa thì tôi cũng không đồng ý đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040502
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040502,
					"content": "Khụ khụ, xin lỗi! Chỉ là một người nội trợ thôi, sao tôi lại làm không xuể vậy? Khụ khụ, xin lỗi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040503
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040503,
					"content": "Xin lỗi...haiz...xin lỗi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040504,
						722040505
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040504,
					"content": "Chào bà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040506
					]
				},
				{
					"id": 722040506,
					"content": "À...! Là ông à! Thật là...có mất mặt không chứ! Mau vào đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040507,
						722040508
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040507,
					"content": "Ơ...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040509
					]
				},
				{
					"id": 722040509,
					"content": "Ở bên ngoài đánh bắt thế nào...? Có đánh được cá không...không sao, không sao, có mảnh vườn nhỏ ở nhà là đủ. Chỉ là không đủ để hiến tế cho Lôi Điểu đại nhân thôi...ừm, sao rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040510
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040510,
					"content": "Sao lại ngây ngốc ra vậy! Tế lễ năm nay rõ ràng rất thuận lợi, sang năm ắt hẳn sẽ tốt đẹp...Tư tế đại nhân cũng nói chúng ta sẽ có một đứa con mạnh khỏe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040511
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040511,
					"content": "Nhưng tại sao đột nhiên lại nói với tôi chuyện này! Ông quên kết cục của Kama rồi sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040512,
						722040513
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040512,
					"content": "Bà bình tĩnh một chút!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040514
					]
				},
				{
					"id": 722040514,
					"content": "Nếu ông cũng muốn rời bỏ Lôi Điểu đại nhân, muốn bị những con sóng dữ dội nuốt chửng thì cứ đi đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040515
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040515,
					"content": "Con của ta...đứa con đáng thương...haiz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Una"
				},
				{
					"id": 722040513,
					"content": "\"Kama\"...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040514
					]
				},
				{
					"id": 722040508,
					"content": "Ừm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040509
					]
				},
				{
					"id": 722040505,
					"content": "Bà vẫn ổn chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040506
					]
				}
			]
		},
