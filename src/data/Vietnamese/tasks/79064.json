			"dialogs": [
				{
					"id": 790640801,
					"content": "Đây là tổng bộ phòng vệ binh, chỉ cần nói rõ với họ, nhất định có thể gỡ bỏ giới nghiêm của vệ binh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640802
					],
					"speakerTitle": "Albizzi",
					"speakerSubtitle": "Người Giám Sát Màu Lam"
				},
				{
					"id": 790640802,
					"content": "Xin chào...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790640803
					]
				},
				{
					"id": 790640803,
					"content": "Gì vậy? Tôi đang cầm ảnh của bạn tôi, hoài niệm về những ngày tháng xa xưa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640804
					],
					"speakerTitle": "Gõ Cửa"
				},
				{
					"id": 790640804,
					"content": "Giọng nói này, là Winston sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640805
					],
					"speakerTitle": "Albizzi",
					"speakerSubtitle": "Người Giám Sát Màu Lam"
				},
				{
					"id": 790640805,
					"content": "Hahaha, cuối cùng thì anh cũng chán nản quay về rồi à... Đã nói rồi, anh chỉ có một người bạn là tôi, tại sao lại nhận nhiệm vụ đi cùng hai người lạ chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640806
					],
					"speakerTitle": "Gõ Cửa"
				},
				{
					"id": 790640806,
					"content": "Khi đó anh rất ngây thơ: \"Tôi nhất định sẽ trở thành bạn của họ!\" Kết quả thì sau cùng cũng chỉ còn tôi đang đợi, chỉ có tôi là bạn của anh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640807
					],
					"speakerTitle": "Gõ Cửa"
				},
				{
					"id": 790640807,
					"content": "#Cũng không hẳn... Không những hai người đó cũng tới, mà còn có Hầu Tước {NICKNAME} và đồng đội của {F#cô}{M#ngài} ấy nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640808
					],
					"speakerTitle": "Albizzi",
					"speakerSubtitle": "Người Giám Sát Màu Lam"
				},
				{
					"id": 790640808,
