			"dialogs": [
				{
					"id": 705400101,
					"content": "Khịt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400102
					],
					"speakerTitle": "Kỵ Sĩ Pouncelot"
				},
				{
					"id": 705400102,
					"content": "Hmm... Tiểu thư Rosaria, nó dữ quá đi, tôi sợ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400103
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705400103,
					"content": "Tốt nhất là cô nên lùi lại đi, không thôi nó cào cho tơi tả đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400104
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705400104,
					"content": "Chuyện gì vậy? Valerina bị mèo bắt nạt à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400105,
						705400106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705400105,
					"content": "Lẽ nào là mèo hoang xâm nhập sao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705400107
					]
				},
				{
					"id": 705400107,
					"content": "Kỵ Sĩ Danh Dự! Phù Thủy Mèo Trắng! Lúc Kem Tuyết ra ngoài đi dạo thì đã bị con mèo lớn này nhắm đến, nó theo dấu rồi xông vào đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400108
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705400108,
					"content": "Đừng căng thẳng, ở đây không có ai làm hại mi đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400109
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705400109,
					"content": "Những kẻ độc ác bắt mi làm những điều xấu xa... đều đã ở bên ngoài vách tường rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400110
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705400110,
					"content": "Sẽ có những người tốt vây quanh mi, tuy có hơi phiền, nhưng họ đều muốn tốt cho mi cả. Thư giãn đi, làm quen với cuộc sống nhàn hạ cũng không tệ đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400111
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705400111,
					"content": "*Khịt*... *rừ rừ*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400112
					],
					"speakerTitle": "Kỵ Sĩ Pouncelot"
				},
				{
					"id": 705400112,
					"content": "Con mèo... Con mèo lớn đó nghe hiểu được sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400113
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705400113,
					"content": "Hình như có tác dụng, xem ra chú mèo này khá thông minh đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400114
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705400114,
					"content": "So với những con mèo khác thì nó lớn hơn hẳn, màu sắc cũng giống như nước ép của Trái Bulle vậy. Nhìn kỹ thì nó còn đeo khăn choàng, trên đó còn có biểu tượng của Đội Kỵ Sĩ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705400115,
					"content": "Hay chúng ta cứ gọi nó là Kỵ Sĩ Pouncelot nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705400116,
					"content": "Meo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400117
					],
					"speakerTitle": "Kỵ Sĩ Pouncelot"
				},
				{
					"id": 705400117,
					"content": "Cách này tuyệt đấy, nó hoàn toàn buông bỏ cảnh giác rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400118
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705400118,
					"content": "Nhưng tôi thấy, Kỵ Sĩ Pouncelot sau khi trò chuyện vài câu với Rosaria là đã bớt hung dữ rồi, nên lần này là Rosaria lập công lớn đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400119,
						705400120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705400119,
					"content": "Mối quan hệ giữa Rosaria và loài mèo đã tốt lên rồi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705400121
					]
				},
				{
					"id": 705400121,
					"content": "Cũng bình thường. Dù sao thì những phiền phức đáng yêu này cũng không quá nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400122
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705400122,
					"content": "#Tiếp theo, {NICKNAME}, chúng ta hãy sử dụng phép thuật mèo, khiến cho Kỵ Sĩ Pouncelot từng tức giận đó trở nên thư giãn vui vẻ đi nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705400120,
					"content": "Công việc đặc biệt của Rosaria đã thú vị hơn rồi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705400121
					]
				},
				{
					"id": 705400106,
					"content": "Có vẻ như có... kỵ sĩ mèo đơn độc xuất hiện.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705400107
					]
				}
			]
		}
	]
}