			"dialogs": [
				{
					"id": 401540101,
					"content": "Sau một thời gian nỗ lực kinh doanh, doanh thu của Tiệm Giả Kim đã vượt cả dự kiến...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401540102
					]
				},
				{
					"id": 401540102,
					"content": "Ái chà, không ngờ trong thời gian ngắn như vậy mà cưng lại có thể tăng mức doanh thu lên cao đến thế này đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540103
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540103,
					"content": "Chẳng lẽ cưng là thiên tài kinh doanh sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540104,
						401540107
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540104,
					"content": "Cũng nhờ có Lisa giúp đỡ cả.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401540105
					]
				},
				{
					"id": 401540105,
					"content": "Haha, cưng vẫn khiêm tốn nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540106
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540106,
					"content": "Đạt được thành quả ấn tượng thế này, vẫn nên tự hào hơn một chút đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540109
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540109,
					"content": "Nếu giữ cưng lại làm trợ lý thì kỳ nghỉ của chị chắc là sẽ được tăng gấp đôi đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540110
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540110,
					"content": "Số liệu bán hàng thu được trong giai đoạn này cũng đã đủ. Cả hai đã vất vả nhiều rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540111
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540111,
					"content": "Tất nhiên, nếu cưng đồng ý tiếp tục trông coi cửa tiệm thì chị đây cũng rất mừng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540112
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540112,
					"content": "Lần này chị cũng đã có thể báo cáo với Jean rồi, haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540113
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540113,
					"content": "#{NICKNAME}, Paimon, lâu rồi không gặp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540114
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540114,
					"content": "Đội trưởng Jean!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401540115,
					"content": "Tới rồi sao! Tôi định là xong việc với bé cưng này rồi quay về Đội Kỵ Sĩ tìm cô đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540116
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540116,
					"content": "Ừm, tôi đã nắm được tình hình đại khái từ các kỵ sĩ khác rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540117
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540117,
					"content": "#Không ngờ lần này cô lại để {NICKNAME} tới giúp đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540118
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540118,
					"content": "Ây da, công việc quan trọng thế này mà muốn có đột phá, thì làm sao mà thiếu được đối tác thông minh và có năng lực chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540119
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540119,
					"content": "Cô thấy đấy, nếu chỉ có mình tôi thì sẽ không thể nào đạt được hiệu suất như thế này đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540120
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540120,
					"content": "Đúng thật là thành tích của mọi người rất đáng kinh ngạc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540121
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540121,
					"content": "Tôi vốn định sắp xếp xong xuôi những việc khác rồi tới xem tình hình, nhưng lại mãi không có thời gian... Ít nhất thì tôi cũng muốn trực tiếp nói lời cảm ơn với hai vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540122,
						401540123
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540122,
					"content": "Đội trưởng Jean luôn ở phía sau cổ vũ chúng tôi mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401540124
					]
				},
				{
					"id": 401540124,
					"content": "Ừm. Có đồng đội ưu tú như hai vị, thật khiến người khác yên tâm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540125
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540125,
					"content": "Haha, sau khi mọi việc kết thúc thì tôi có thể nghỉ phép được rồi nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540126
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540126,
					"content": "Dạo này tóc có vẻ rụng nhiều hơn rồi này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540127
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540127,
					"content": "Không thành vấn đề. Thời gian này cô vất vả nhiều rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540128
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540128,
					"content": "Trước đây thấy cô ngày nào cũng ở trong thư viện, lâu dần có thể sẽ thấy buồn chán, nên tôi mới sắp xếp một số công việc có thể phát huy tài năng của cô hơn đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540129
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540129,
					"content": "Có phải là đã gây cho cô nhiều áp lực quá không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540130
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540130,
					"content": "#Thật ra cũng không sao đâu. Dù sao cũng có sự hỗ trợ của Đội Kỵ Sĩ mà, còn có cả {NICKNAME} giúp đỡ nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540131
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540131,
					"content": "Thỉnh thoảng làm lại nghề cũ, nghiên cứu một chút cũng rất thú vị mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540132
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540132,
					"content": "Ừm, cô nghĩ như thế thì tôi yên tâm rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540133
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540133,
					"content": "#{NICKNAME}, cảm ơn {F#cô}{M#cậu} đã giúp đỡ, hãy nhận lấy phần thù lao này nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540134
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540134,
					"content": "À, nói mới nhớ, chị cũng làm cho cưng một món đồ lưu niệm đây, hy vọng cưng sẽ thích.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540123,
					"content": "Đây là thành quả nỗ lực của tất cả mọi người.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401540124
					]
				},
				{
					"id": 401540107,
					"content": "Bất giác tìm ra được bí quyết thôi ấy mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401540108
					]
				},
				{
					"id": 401540108,
					"content": "Ừm, năng lực học tập của cưng đúng là rất tốt đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540109
					],
					"speakerTitle": "Lisa"
				}
			]
		}
	]
}