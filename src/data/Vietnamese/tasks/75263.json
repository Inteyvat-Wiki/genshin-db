					"nextDialogs": [
						752630504
					]
				},
				{
					"id": 752630504,
					"content": "#{M#Cậu ấy}{F#Cô ấy} như một tia chớp vàng vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630505
					]
				},
				{
					"id": 752630505,
					"content": "Này, không có tia chớp bạc à? Mấy người không thấy tia chớp bạc sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752630506,
					"content": "Tôi thua rồi... Đây chắc là tốc độ mà tôi sẽ không bao giờ có thể đạt tới...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630507
					],
					"speakerTitle": "\"Nanas Gió Mạnh\""
				},
				{
					"id": 752630507,
					"content": "Đừng từ bỏ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752630508
					]
				},
				{
					"id": 752630508,
					"content": "#Tôi... Tôi sẽ lấy {F#cô}{M#cậu} ra làm mục tiêu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
