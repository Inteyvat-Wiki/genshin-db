			"dialogs": [
				{
					"id": 752630301,
					"content": "Thật không thể tin nổi! Thật sự có người đánh bại được \"Nanas Gió Mạnh\"!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630302
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630302,
					"content": "#Người khiêu chiến này đã giành được ngôi vị quán quân ngày hôm nay với những bước chân nhanh như gió. Chúng ta hãy cùng chúc mừng cho {M#cậu ấy}{F#cô ấy} nào!",
