				"points": []
			},
			"dialogs": [
				{
					"id": 752630101,
					"content": "Các vị khách quý, cuộc thi Đua Tốc Độ Nhàn Nhã sắp bắt đầu rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630102
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630102,
					"content": "Ai có thể đánh bại quán quân \"Nanas Gió Mạnh\" của hôm qua, hôm kia và hôm trước nữa, người đó sẽ nhận được phần thưởng bất ngờ của chúng tôi ngày hôm nay! Những vị khách chưa đăng ký thì hãy tranh thủ thời gian nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630103
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630103,
					"content": "Hừm, không ai dám đăng ký nữa sao? Không ai dám đối mặt với \"Nanas Gió Mạnh\" tôi nữa sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630104
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630104,
					"content": "Haiz, \"Nanas Gió Mạnh\" quá mạnh, đã giành được phần thưởng liên tiếp ba ngày rồi, không ai thắng được đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630105
					]
				},
				{
					"id": 752630105,
					"content": "Awrrrh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630106
					]
				},
				{
					"id": 752630106,
					"content": "Hả? Ngươi muốn thử sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630107
					]
				},
				{
					"id": 752630107,
					"content": "Hừm, đến mức chỉ dám để Saurian ra mặt sao? Những tên nhát gan, thả Saurian của các người ra đây, \"Nanas Gió Mạnh\" sẽ cho các người biết thế nào là tốc độ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630108
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630108,
					"content": "Đúng là một cuộc thi Đua Tốc Độ Nhàn Nhã độc đáo! Hãy xem liệu những người bạn Saurian to lớn này có thể đánh bại \"Nanas Gió Mạnh\" đã giành ngôi quán quân ba lần liên tiếp không nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kinowa"
				}
			]
		},
		{
			"id": 7526302,
			"completionStepIds": [
				7526301
