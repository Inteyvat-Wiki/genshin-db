					"nextDialogs": [
						752630303
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630303,
					"content": "Tôi thua sao... Không thể nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630304
					],
					"speakerTitle": "\"Nanas Gió Mạnh\""
				},
				{
					"id": 752630304,
					"content": "Giỏi quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630305
					]
				},
				{
					"id": 752630305,
					"content": "Nhưng mà...! Những khán giả cũ chắc đều biết, \"Nanas Gió Mạnh\" không phải là tuyển thủ mạnh nhất từng xuất hiện tại cuộc thi Đua Tốc Độ Nhàn Nhã!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630306
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630306,
					"content": "Trước \"Nanas Gió Mạnh\", còn có hai tuyển thủ địa phương khác đạt đến trình độ đáng sợ, hôm nay họ cũng đến nơi thi đấu này rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630307
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630307,
					"content": "Chúng ta hãy cùng chào đón... \"Đến Nhanh\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630308
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630308,
					"content": "♪, ♩~~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630309
					]
				},
				{
					"id": 752630309,
					"content": "Và... \"Đi Vội\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630310
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630310,
					"content": "♫ , ♩~~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630311
					]
				},
				{
					"id": 752630311,
					"content": "#Người khiêu chiến, hai vị này là đối thủ thực sự đáng gờm. Với thực lực của {F#cô}{M#cậu} lúc nãy, muốn đánh bại họ e là khó như lên trời.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630312
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630312,
					"content": "#{F#Cô}{M#Cậu} đã chuẩn bị xong chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630313
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630313,
					"content": "Chuẩn bị xong rồi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752630314
					]
				},
				{
					"id": 752630314,
					"content": "Các nhân viên bố trí xong khu vực thi đấu, khán giả cũng đã tụ tập đông đủ... Bạn đã đứng ở vạch xuất phát...",
