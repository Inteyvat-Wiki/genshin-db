					"nextDialogs": [
						752630510
					]
				},
				{
					"id": 752630510,
					"content": "♫ , ♩~~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630511
					]
				},
				{
					"id": 752630511,
					"content": "#Hãy nhận lấy phần thưởng mà chúng tôi đã chuẩn bị cho quán quân lần này. Đây là phần thưởng {F#cô}{M#cậu} xứng đáng nhận được!",
