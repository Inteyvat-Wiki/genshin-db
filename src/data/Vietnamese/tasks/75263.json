			"dialogs": [
				{
					"id": 752630201,
					"content": "Tôi cũng muốn đăng ký.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752630202
					]
				},
				{
					"id": 752630202,
					"content": "Bước ngoặt bất ngờ, một người khiêu chiến dũng cảm đã xuất hiện rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630203
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630203,
					"content": "Ồ? Đúng là không biết tự lượng sức.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630204
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630204,
					"content": "Đúng là một bước tiến đầy bất ngờ... Cuối cùng ai sẽ là người chiến thắng đây? Chúng ta hãy cùng chờ xem nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630205
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630205,
					"content": "Các nhân viên bố trí xong khu vực thi đấu, khán giả cũng đã tụ tập đông đủ... Bạn đã đứng ở vạch xuất phát...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
