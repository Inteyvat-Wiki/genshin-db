			"dialogs": [
				{
					"id": 752630501,
					"content": "Cuộc thi kết thúc! Kết thúc rồi! Kết quả khiến mọi người kinh ngạc đã xuất hiện rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630502
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630502,
					"content": "#Tôi tuyên bố, người chiến thắng cuối cùng của cuộc thi này là... {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630503
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630503,
					"content": "#Woa! {M#Cậu ấy}{F#Cô ấy} mạnh quá! Không ngờ lại đánh bại được cả \"Đến Nhanh\" và \"Đi Vội\"!",
