			"dialogs": [
				{
					"id": 751910201,
					"content": "Sau khi cơ thể chìm vào Phlogiston Thể Lỏng, hình ảnh tựa như hồi ức ấm áp hiện lên trong đầu.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751910202
					]
				},
				{
					"id": 751910202,
					"content": "Đó là hồi ức từ rất lâu về trước, vị vua vĩ đại từng soi sáng thế giới bằng cặp sừng dài của mình, đã thay đổi kết cấu bên trong ngọn núi này bằng những cái vỗ cánh.\\nÁnh sáng và nhiệt độ hóa thành thông tin cùng mệnh lệnh, được truyền vào các hình thái khác nhau của dòng lửa.\\nSau đó, vị vua vĩ đại ấy đã xây dựng nên nơi lưu trữ tất cả hồi ức và trí tuệ.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751910203
					]
				},
				{
					"id": 751910203,
					"content": "Vì vậy mà Thánh Thành Tollan mới được xây dựng nên và mang diện mạo như thuở ban đầu.\\nĐây cũng là đoạn hồi ức đầu tiên được lưu giữ trong hồ lửa.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
		{
