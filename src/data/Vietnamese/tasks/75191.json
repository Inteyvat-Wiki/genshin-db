			"dialogs": [
				{
					"id": 751910401,
					"content": "Sau khi cơ thể chìm vào Phlogiston Thể Lỏng, hình ảnh tựa như hồi ức ấm áp hiện lên trong đầu.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751910402
					]
				},
				{
					"id": 751910402,
					"content": "Đó là chuyện của rất nhiều năm sau khi Hỏa Long Vương và vị thần loài người đời đầu cùng rơi xuống vực núi lửa.\\nThánh Thành vì bị phong tỏa mà trở nên tối tăm. Tộc rồng cổ đại vì mất đi lửa nguồn, hoặc vì để thích nghi với vương quốc của loài người bây giờ mà từ bỏ trí tuệ và hình thể, hoặc cũng có thể đã bị lò lửa trong lòng thiêu thành tro bụi.\\nBóng hình màu bạc một mình bước vào hồ lửa sôi sục trong tòa thành ngày càng cô đơn này.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751910403
					]
				},
				{
					"id": 751910403,
					"content": "Anh ta biết mình không thể có thêm được trí tuệ gì mới từ đó nữa.\\nTại sao? Anh ta tự hỏi.\\n\"Có lẽ vì hồi ức cũng là một trải nghiệm hiếm có.\"\\nAnh ta tự chế giễu mình, vì có rất nhiều bóng dáng mà nay chỉ có thể gặp lại ở nơi này.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		}
