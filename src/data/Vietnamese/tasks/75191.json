				]
			},
			"dialogs": [
				{
					"id": 751910301,
					"content": "Sau khi cơ thể chìm vào Phlogiston Thể Lỏng, hình ảnh tựa như hồi ức ấm áp hiện lên trong đầu.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751910302
					]
				},
				{
					"id": 751910302,
					"content": "Rất nhiều con rồng đã nhúng mình vào hồ lửa, với cách này thì trí tuệ và thông tin trong Phlogiston Thể Lỏng đã được truyền vào tâm trí của chúng.\\nNhưng đó là chuyện rất lâu về trước, hiện nay đã không còn ai đến đây để theo đuổi trí tuệ nữa.\\nThay vào đó, những kết tinh của trí tuệ này được dùng làm minh chứng cho sức mạnh... Thành quả đủ để thúc đẩy cả dòng tộc bước vào thời đại tiếp theo, vậy mà lại chỉ được dùng như một món vũ khí.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751910303
					]
				},
				{
					"id": 751910303,
					"content": "Khi vị Chúa Tể Lửa của loài rồng vì bị bóng đen u tối bao trùm mà rơi vào trạng thái chết giả, thì con người ở bên ngoài núi lửa giương cao lá cờ phản kháng.\\nCó lẽ chỉ có bạo lực mới đủ để áp chế nỗi bất an mơ hồ trong lòng.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
