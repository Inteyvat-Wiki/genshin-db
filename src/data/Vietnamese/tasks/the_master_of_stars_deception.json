			"dialogs": [
				{
					"id": 111000601,
					"content": "Có Tinh Nguyệt Thiên Quân, Thiên Nham Quân có thể sa thải hết rồi nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000602
					],
					"speakerTitle": "Tín Đồ Thương Nhân"
				},
				{
					"id": 111000602,
					"content": "Về Tinh Nguyệt Thiên Quân...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000603
					]
				},
				{
					"id": 111000603,
					"content": "Tôi là thương nhân, do lần trước vận chuyển lô hàng quá đắt, bèn mạo muội nhờ Tinh Nguyệt Thiên Quân đi cùng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000604
					],
					"speakerTitle": "Tín Đồ Thương Nhân"
				},
				{
					"id": 111000604,
					"content": "Chỉ thấy Thiên Quân niệm thần chú, ma vật hết thảy rút lui, cả đường chẳng thấy bóng dáng đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000605
					],
					"speakerTitle": "Tín Đồ Thương Nhân"
				},
				{
					"id": 111000605,
					"content": "Tuy chi phí hơi đắt... nhưng dù sao \"Thỉnh Tiên\" là chuyện đại sự, cũng không biết người ngoại quốc như các vị có trả nổi không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tín Đồ Thương Nhân"
				}
			]
		},
