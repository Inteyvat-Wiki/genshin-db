				"objectNames": [
					"Tín Đồ Nam"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111000401,
					"content": "Nhìn thấy Tinh Nguyệt Thiên Quân làm phép chưa? Đúng là thần thông quảng đại!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000402
					],
					"speakerTitle": "Tín Đồ Nam"
				},
				{
					"id": 111000402,
					"content": "Bệnh tình của gia phụ có lẽ có hy vọng rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000403
					],
					"speakerTitle": "Tín Đồ Nam"
				},
				{
					"id": 111000403,
					"content": "Về Tinh Nguyệt Thiên Quân...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000404
					]
				},
				{
					"id": 111000404,
					"content": "Trông thấy pháp thuật ấy thì có gì phải nghi ngờ nữa, đương nhiên là tiên nhân thật sự.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000405
					],
					"speakerTitle": "Tín Đồ Nam"
				},
				{
					"id": 111000405,
					"content": "Ngày trước, tôi cầu phương thuốc cho gia phụ ốm liệt giường, khác hẳn so với phương thuốc Nhà Thuốc Bubu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000406
					],
					"speakerTitle": "Tín Đồ Nam"
				},
				{
					"id": 111000406,
					"content": "Thuốc nấu xong còn có lớp sương mỏng bay bay, tiên khí cực kỳ! Tuy nhiên, cũng có khả năng do đã thêm Băng Vụ Hoa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000407
					],
					"speakerTitle": "Tín Đồ Nam"
				},
				{
					"id": 111000407,
					"content": "Phương thuốc Tiên gia rất hiệu nghiệm, bệnh tình gia phụ chắc chắn sẽ khá lên...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000408
					],
					"speakerTitle": "Tín Đồ Nam"
				},
				{
					"id": 111000408,
					"content": "So với tính mạng của phụ thân thì những món đồ cổ dâng lên Tinh Nguyệt Thiên Quân chả đáng là bao... phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tín Đồ Nam"
				}
			]
		},
		{
