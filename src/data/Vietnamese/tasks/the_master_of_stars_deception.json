					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000803
					]
				},
				{
					"id": 111000803,
					"content": "Ha ha ha... các hạ nói đùa rồi. Có vị cao nhân tên Xue Wuliang, danh xưng Liangzi từng nói...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000804
					],
					"speakerTitle": "Tinh Nguyệt Thiên Quân"
				},
				{
					"id": 111000804,
					"content": "Thực ra, mọi thứ đều được liên kết với nhau. Cái người phàm gọi là \"hiệu ứng tâm lý\" đơn thuần cũng chỉ là cầu nối giữa tinh thần và vật chất mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000805
					],
					"speakerTitle": "Tinh Nguyệt Thiên Quân"
				},
				{
					"id": 111000805,
					"content": "Nói cách khác, nguyện vọng của họ sớm muộn cũng thành hiện thực. Nói vậy hai vị đã hiểu chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000806
					],
					"speakerTitle": "Tinh Nguyệt Thiên Quân"
				},
				{
					"id": 111000806,
					"content": "Hoàn toàn không hiểu... nhưng tóm lại nguyện vọng của họ đều có thể thực hiện nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000807,
					"content": "Không sai, người bạn nhỏ này rất thông minh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000808
					],
					"speakerTitle": "Tinh Nguyệt Thiên Quân"
				},
				{
					"id": 111000808,
					"content": "Nói vậy... còn có một vấn đề...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000809,
					"content": "Ừm? Cứ nói.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000810,
						111000811
					],
					"speakerTitle": "Tinh Nguyệt Thiên Quân"
				},
				{
					"id": 111000810,
					"content": "Tại sao lại đeo mặt nạ vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000814
					]
				},
				{
					"id": 111000814,
					"content": "Bổn tiên... đi khắp nhân gian, cứu thế hành thiện. Không lộ mặt tránh thị phi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000815
					],
					"speakerTitle": "Tinh Nguyệt Thiên Quân"
				},
				{
					"id": 111000815,
					"content": "Ra là vậy, ra là vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000816
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000816,
					"content": "Vậy nguyện vọng của hai vị là gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000817,
						111000819,
						111000821
					],
					"speakerTitle": "Tinh Nguyệt Thiên Quân"
				},
				{
					"id": 111000817,
					"content": "Muốn biết tung tích của người thân.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000818
					]
				},
				{
					"id": 111000818,
					"content": "Ừm... đằng sau nhất định có câu chuyện thương tâm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000824
					],
					"speakerTitle": "Tinh Nguyệt Thiên Quân"
				},
				{
					"id": 111000824,
					"content": "...Được thôi, muốn thực hiện nguyện vọng này cũng không phải không thể...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000825
					],
					"speakerTitle": "Tinh Nguyệt Thiên Quân"
				},
				{
					"id": 111000825,
					"content": "Chỉ là... vẫn thiếu chút gì đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000826
					],
					"speakerTitle": "Tinh Nguyệt Thiên Quân"
				},
				{
					"id": 111000826,
					"content": "Thiếu... cái gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000827
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000827,
					"content": "Tiên đạo dựa vào \"ngộ tính\", nếu hai vị không nhìn thấu ý trong lời của ta, vậy thứ lỗi bổn tiên khó lòng tương trợ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000828
					],
					"speakerTitle": "Tinh Nguyệt Thiên Quân"
				},
				{
					"id": 111000828,
					"content": "Làm thế nào đây, tôi vẫn không hiểu ý của ngài ấy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000829,
						111000830
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000829,
					"content": "Xem ra phải đưa một chút lợi ích...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000831
					]
				},
				{
					"id": 111000831,
					"content": "À! Vừa rồi những tín đồ kia cũng nhắc tới, mời tiên nhân giúp đỡ phải trả cái giá không nhỏ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000832
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000832,
					"content": "Nhưng trên người chúng ta cũng chẳng có gì đáng giá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000833
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000833,
					"content": "Thậm chí ngay đến Vision bạn cũng không có...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000834,
						111000835
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000834,
					"content": "Chắc sẽ không có người bán Vision nhỉ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000836
					]
				},
				{
					"id": 111000836,
					"content": "Haiz! Hay là chúng ta làm vài món ngon cho ngài ấy? Chẳng ai có thể cưỡng lại sự hấp dẫn của đồ ăn ngon nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000837,
						111000838
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000837,
					"content": "Theo cách nghĩ của Paimon thì đúng là vậy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000839
					]
				},
				{
					"id": 111000839,
					"content": "Ừm, đồ ăn ngon! Cách này chắc chắn sẽ thành công, he he.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000840
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000840,
					"content": "Chi bằng chúng ta mau xuất phát, đến Quảng Cáo Vạn Văn Tập xem thử có công thức nấu ăn thịnh hành nào mới nhất ngon nhất không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000838,
					"content": "Đồ ăn ngon!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000839
					]
				},
				{
					"id": 111000835,
					"content": "Phải đó, thật đáng tiếc...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000836
					]
				},
				{
					"id": 111000830,
					"content": "Xem ra là phải đưa Mora...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000831
					]
				},
				{
					"id": 111000819,
					"content": "Muốn có sức mạnh ngang với thần linh.",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						111000820
					]
				},
				{
					"id": 111000820,
					"content": "#Khi sở hữu sức mạnh, rất nhiều vấn đề có thể giải quyết dễ dàng. Nhưng ta rất hiếu kỳ, lẽ nào {F#cô}{M#cậu} có vướng mắc với thần linh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000824
					],
					"speakerTitle": "Tinh Nguyệt Thiên Quân"
				},
				{
					"id": 111000821,
					"content": "Muốn giàu sụ trong một đêm!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000822
					]
				},
				{
					"id": 111000822,
					"content": "#Ấy ấy! Bạn không cần {F#anh trai}{M#em gái} của bạn nữa à!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000823
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000823,
					"content": "#Ừm, lẽ thường tình. Trông {F#cô}{M#cậu} không phải người Liyue, nhưng hình như đã nhiễm không ít mùi tiền ở Liyue rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000824
					],
					"speakerTitle": "Tinh Nguyệt Thiên Quân"
				},
				{
					"id": 111000811,
					"content": "Có thể gỡ mặt nạ ra không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000812
					]
				},
				{
					"id": 111000812,
					"content": "Ấy! Có phải thất lễ quá rồi không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000813,
					"content": "Ha ha, quả là không tiện lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000814
					],
					"speakerTitle": "Tinh Nguyệt Thiên Quân"
				}
			]
		},
