				"points": []
			},
			"dialogs": [
				{
					"id": 111000101,
					"content": "#Là ảo giác của tôi ư, {NICKNAME}... Những Hilichurl kia trông có vẻ hơi kỳ lạ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000102,
						111000104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000102,
					"content": "Trên người toát ra... tà khí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000103
					]
				},
				{
					"id": 111000103,
					"content": "Đúng vậy, Hilichurl từng thấy trước đây, tuy là ma vật, nhưng chưa từng như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000106,
					"content": "A! Nhà Trọ Vọng Thư ở gần đây, liệu có gây nguy hiểm cho khách khứa không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000107,
					"content": "#Nếu nhìn thấy mà ngó lơ, cứ cảm thấy cắn rứt lương tâm... thử đối phó chúng đi, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000104,
					"content": "Có vẻ hung hãn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000105
					]
				},
				{
					"id": 111000105,
					"content": "Đúng vậy, lẽ nào có liên quan đến tà khí trên người chúng?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000106
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1110003,
			"completionStepIds": [
				1110003
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
