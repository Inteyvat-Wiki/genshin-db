			"dialogs": [
				{
					"id": 111000501,
					"content": "Cảm giác bây giờ mỗi ngày đều ngập tràn hy vọng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000502
					],
					"speakerTitle": "Tín Đồ Nữ"
				},
				{
					"id": 111000502,
					"content": "Về Tinh Nguyệt Thiên Quân...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000503
					]
				},
				{
					"id": 111000503,
					"content": "Hai người cũng là Tín Đồ của Tinh Nguyệt Thiên Quân à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000504
					],
					"speakerTitle": "Tín Đồ Nữ"
				},
				{
					"id": 111000504,
					"content": "Từ khi vị hôn phu của tôi không từ mà biệt, ngày nào tôi cũng khóc ròng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000505
					],
					"speakerTitle": "Tín Đồ Nữ"
				},
				{
					"id": 111000505,
					"content": "Sau này thử Tiên pháp của Tinh Nguyệt Thiên Quân, đốt bỏ tranh của anh ấy, thổi tro ra biển lúc mặt trời mọc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000506
					],
					"speakerTitle": "Tín Đồ Nữ"
				},
				{
					"id": 111000506,
					"content": "Trong mơ, tôi dường như cảm thấy anh ấy đã trở về, là thật đó! Tuyệt đối không phải tác dụng tâm lý...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000507
					],
					"speakerTitle": "Tín Đồ Nữ"
				},
				{
					"id": 111000507,
					"content": "Thế là tôi vui vẻ dâng của hồi môn lên Tinh Nguyệt Thiên Quân. Dù sao nếu không phải ngài ấy giúp tôi tìm lại phu quân, của hồi môn này có lẽ cả đời cũng chẳng dùng đến...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tín Đồ Nữ"
				}
			]
		},
