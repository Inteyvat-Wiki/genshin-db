			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111000301,
					"content": "Mấy tên tà khí khắp người này đúng là khó đối phó hơn hẳn Hilichurl thông thường một chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000302,
					"content": "Í, bạn nhìn bên kia, một đám người tụ tập...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000303,
					"content": "Ôi... bạn nhìn thấy người đeo mặt nạ không? Hilichurl cũng sợ hãi chạy mất dạng rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000304,
						111000305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000304,
					"content": "Lẽ nào anh ấy là \"Tiên nhân\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000306
					]
				},
				{
					"id": 111000306,
					"content": "Bạn nói là giống tiên nhân như Xiao à? Nói vậy thì quả thực... Xiao cũng từng đeo mặt nạ hao hao vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000307,
					"content": "Nhìn anh ấy \"làm phép\", hình như còn giống tiên nhân hơn Xiao. Hay là qua nói chuyện thử đi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000305,
					"content": "Trông giống \"Pháp thuật Tiên gia\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000306
					]
				}
			]
		},
		{
			"id": 1110004,
			"completionStepIds": [
				1110004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
