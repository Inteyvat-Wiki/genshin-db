						111001002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111001002,
					"content": "Hầy. Không cần cảm ơn, trừ ma cứu thế là bổn phận Tiên gia, không đáng nhắc đến...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001003
					],
					"speakerTitle": "Tinh Nguyệt Thiên Quân"
				},
				{
					"id": 111001003,
					"content": "Ô? Hình như chưa từng gặp các vị, bổn tiên cứ tưởng là tín đồ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001004,
						111001007
					],
					"speakerTitle": "Tinh Nguyệt Thiên Quân"
				},
				{
					"id": 111001004,
					"content": "Chúng tôi là Nhà Lữ Hành qua đường...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111001005
					]
				},
				{
					"id": 111001005,
					"content": "#Tôi là Paimon! Vị này là bạn đồng hành của tôi, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001006
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111001006,
					"content": "Thì ra là thế, vậy bổn tiên cũng tự giới thiệu một chút mới hợp lễ nghĩa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001010
					],
					"speakerTitle": "Tinh Nguyệt Thiên Quân"
				},
				{
					"id": 111001010,
					"content": "Bổn tiên là Tinh Nguyệt Thiên Quân mà các tín đồ thường hay nhắc đến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001011
					],
					"speakerTitle": "Tinh Nguyệt Thiên Quân"
				},
				{
					"id": 111001011,
					"content": "Lần này bổn tiên xuống núi cứu thế, hữu duyên tương phùng, nếu hai vị có tâm nguyện gì, cứ việc nói với ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001012
					],
					"speakerTitle": "Tinh Nguyệt Thiên Quân"
				},
				{
					"id": 111001012,
					"content": "Tâm nguyện? Thiên Quân... còn có thể giúp người ta thực hiện tâm nguyện ư? Tôi cứ tưởng Tiên nhân Cảng Liyue đều chỉ giỏi đánh đấm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001013
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111001013,
					"content": "Ha ha, dù sao địa vị tiên của \"Thiên Quân\" cũng cao hơn \"Chân Quân\" một bậc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001014
					],
					"speakerTitle": "Tinh Nguyệt Thiên Quân"
				},
				{
					"id": 111001014,
					"content": "Khoe khoang sự thần thông của mình không phải tác phong của bổn tiên, chi bằng hai vị nói chuyện với các tín đồ rồi hẵng phán đoán.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tinh Nguyệt Thiên Quân"
				},
				{
					"id": 111001007,
					"content": "Chúng tôi cũng là người theo đạo Tiên gia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111001008
					]
				},
				{
					"id": 111001008,
					"content": "#Tôi là Paimon! Vị này là bạn đồng hành của tôi, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111001009,
					"content": "Thì ra là đồng đạo, vậy bổn tiên cũng tự giới thiệu một chút mới hợp lễ nghĩa.",
					"roleType": "TALK_ROLE_NPC",
