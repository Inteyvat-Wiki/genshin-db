					"speakerTitle": "Jiayi"
				},
				{
					"id": 718080302,
					"content": "Về tình hình của Nam Thiên Môn",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718080303
					]
				},
				{
					"id": 718080303,
					"content": "Động đất, ma vật, còn bé gái này nữa... là con của ai đi lạc thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080304
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 718080304,
					"content": "Về những lời của bé gái đó nói...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718080305
					]
				},
				{
					"id": 718080305,
					"content": "Đứa nhóc đó nói gì vậy? \"Vị đó\" hồi sinh? Chứng kiến? Là cái gì thế...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080306
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 718080306,
					"content": "Lại xem phải quyển sách kỳ lạ nào đó rồi... Thôi vậy, tôi sẽ sắp xếp người đi đưa nó về ngay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080307
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 718080307,
					"content": "Vừa động đất vừa ma vật, đứa bé này đừng để bị thương chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080308
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 718080308,
					"content": "Cảm ơn bạn, hãy nhận lấy những thứ này, cảm ơn bạn đã giúp đỡ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080309
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 718080309,
					"content": "Haiz, công việc đúng là chỉ có nhiều thêm chứ không có ít hơn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiayi"
