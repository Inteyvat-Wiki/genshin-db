					"content": "Đợi lúc tỉnh lại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080202
					],
					"speakerTitle": "Jiu"
				},
				{
					"id": 718080202,
					"content": "Bạn vẫn ổn chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718080203
					]
				},
				{
					"id": 718080203,
					"content": "#{F#Chị}{M#Anh} đến để chứng kiến \"ngài ấy\" hồi sinh đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080204
					],
					"speakerTitle": "Jiu"
				},
				{
					"id": 718080204,
					"content": "#{F#Chị}{M#Anh} đến hơi sớm rồi... Nhưng cũng không phải quá trễ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080205
					],
					"speakerTitle": "Jiu"
				},
				{
					"id": 718080205,
					"content": "Cô bé đang nói gì vậy, nghe không hiểu gì cả...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718080206,
					"content": "Này, em đang nói gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718080207
					]
				},
				{
					"id": 718080207,
					"content": "#Kaka, {F#chị}{M#anh} vẫn chưa ý thức được sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080208
					],
					"speakerTitle": "Jiu"
				},
				{
					"id": 718080208,
					"content": "#Với {F#chị}{M#anh} thì như vậy cũng tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080209
					],
					"speakerTitle": "Jiu"
				},
				{
					"id": 718080209,
					"content": "#Về đi, đợi khi \"người ấy\" hồi phục, {F#chị}{M#anh} sẽ hiểu tất cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiu"
				}
			]
		},
