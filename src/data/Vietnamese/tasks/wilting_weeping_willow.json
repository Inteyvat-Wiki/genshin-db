			"dialogs": [
				{
					"id": 740820701,
					"content": "Một giọt nước long lanh xuất hiện trên tế đàn.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740820702
					]
				},
				{
					"id": 740830102,
					"content": "Hm... Không lẽ giọt nước này chính là kho báu sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830103,
					"content": "Trông không giống kho báu lắm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830104
					]
				},
				{
					"id": 740830104,
					"content": "Cũng phải... Dù gì lấy được cũng khá là dễ... Vậy nó là thứ gì nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830105,
						740830110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830105,
					"content": "Không chừng chính là chìa khóa phong ấn ma vương đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830106
					]
				},
				{
					"id": 740830110,
					"content": "Nói không chừng là do người khác giấu ở đây đó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830111
					]
				},
				{
					"id": 740830106,
					"content": "Hả? Vậy là chúng ta gỡ phong ấn rồi à? Mau để nó lại đi! Hy vọng vẫn còn kịp!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830107,
					"content": "A...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830108
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830108,
					"content": "Tiêu rồi! Ma vương xuất hiện rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830109,
					"content": "Ma vương? Melusine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830115
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830111,
					"content": "Hả? Vậy chẳng phải chúng ta thành ăn trộm rồi sao? Xin lỗi... Chúng ta mau để nó về chỗ cũ đi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830112,
					"content": "A...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830113
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830113,
					"content": "Tiêu rồi! Chủ nhân của nó xuất hiện rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830114,
					"content": "Chủ nhân? Melusine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830115
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830115,
					"content": "Hết hồn... Hóa ra là Melusine... Sao cô lại ở đây vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830116,
					"content": "Chìa khóa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830117
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830117,
					"content": "Chìa khóa... gì cơ? Giọt nước này là chìa khóa sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830118,
					"content": "Pahsiv.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830119
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830119,
					"content": "Hả... Giọt nước này là Pahsiv à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830120,
					"content": "Melusine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830121
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830121,
					"content": "Hả! Nghĩa là sao? Giọt nước này là Melusine à? Tôi hơi nhức đầu rồi đấy, không phải cô mới là Melusine sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830122,
					"content": "Pahsiv...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830123
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830123,
					"content": "Hừm... Cô là Pahsiv hay tên cô là Pahsiv? Tôi bị câu trả lời của cô xoay cho chóng mặt rồi đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830124,
					"content": "Tôi quyết định sẽ gọi cô là Pahsiv nhé, được chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830125,
					"content": "Melusine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830126
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830126,
					"content": "#{NICKNAME}... Sao bây giờ? Tôi chịu rồi, rốt cuộc cô ấy đang nói gì vậy...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830127,
					"content": "Cô có thể nghe hiểu lời của chúng tôi chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830128
					]
				},
				{
					"id": 740830128,
					"content": "Pahsiv...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830129
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830129,
					"content": "Giọt nước này là chìa khóa, phải không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830130
					]
				},
				{
					"id": 740830130,
					"content": "Pahsiv.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830131
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830131,
					"content": "Cô không phải con người, đúng không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830132
					]
				},
				{
					"id": 740830132,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830133
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830133,
					"content": "Này... Sao lại đột nhiên mắng người ta thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830134,
					"content": "Tôi không phải con người, đúng không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830135
					]
				},
				{
					"id": 740830135,
					"content": "Me... Melusine?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830136
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830136,
					"content": "À đợi đã, hình như tôi hiểu được chút rồi... \"Pahsiv\" là khẳng định, \"Melusine\" là phủ định. Hình như là vậy đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830137,
					"content": "Pahsiv! Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830138
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830138,
					"content": "Hóa ra tên cô không phải là Pahsiv... Xin lỗi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830139,
					"content": "Pahsiv... Thích...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830140
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830140,
					"content": "Cô thích cái tên này sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830141
					]
				},
				{
					"id": 740830141,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830142
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830142,
					"content": "#Tốt quá! Thế thì cứ gọi như vậy nhé, hihi. Tôi là Paimon, đây là {NICKNAME}, rất vui được gặp Pahsiv. Tôi chưa từng gặp qua Melusine nào như cô đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830143
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830143,
					"content": "#Paimon, Pahsiv! {NICKNAME}, Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830144
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830144,
					"content": "Erinnyes... Melusine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830145
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830145,
					"content": "Ý là Erinnyes và phủ định sao? À ừm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830146
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830146,
					"content": "Đảo Erinnyes đang không ổn sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830147
					]
				},
				{
					"id": 740830147,
					"content": "Erinnyes, Melusine, bây giờ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830148
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830148,
					"content": "Pahsiv, Erinnyes, bảo vệ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830149
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830149,
					"content": "Đảo Erinnyes đang dần không ổn, và cô muốn bảo vệ nó?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830150
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830150,
					"content": "#Paimon, {NICKNAME}, Erinnyes, ka-pow, ka-pow...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830151
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830151,
					"content": "#Chậc... Có hẳn năm từ. Hmm... Cô muốn {NICKNAME} và tôi đến Đảo Erinnyes để KA-POW một thứ gì đó đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830152
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830152,
					"content": "Melusine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830153
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830153,
					"content": "Muốn chúng tôi giúp đỡ à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830154
					]
				},
				{
					"id": 740830154,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830155
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830155,
					"content": "Thì ra là muốn giúp đỡ. Cũng được thôi, nhưng nếu chúng tôi ra tay trên Đảo Erinnyes thì hơi không ổn lắm. Dù gì đây cũng là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830156
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830156,
					"content": "Ka-pow, Ka-pow.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830157,
						740830161
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830157,
					"content": "Có thù lao không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830158
					]
				},
				{
					"id": 740830161,
					"content": "Vậy phải giúp thế nào?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830162
					]
				},
				{
					"id": 740830158,
					"content": "Thù... lao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830159
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830159,
					"content": "#Chậc, {NICKNAME}, không thấy Pahsiv không giỏi nói chuyện à? Có lẽ cô ấy không tìm được người giúp đỡ rồi, chúng ta giúp cô ấy đi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830160
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830160,
					"content": "Vậy phải giúp thế nào?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830162
					]
				},
				{
					"id": 740830162,
					"content": "Chìa khóa, chìa khóa, chìa khóa, số lượng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830163
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830163,
					"content": "Sau đó thì sao? Số lượng chìa khóa là sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830164
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830164,
					"content": "Chìa khóa! Chìa khóa! Chìa khóa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830165
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830165,
					"content": "Ba chiếc chìa khóa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830166
					]
				},
				{
					"id": 740830166,
					"content": "Pahsiv! Chìa khóa, đường sương, nam...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830167
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830167,
					"content": "Chìa khóa, suối, bắc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830168
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830168,
					"content": "Chìa khóa, liễu rũ, đông...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830169
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830169,
					"content": "À... Vậy là tổng cộng có ba chìa khóa chia thành các khu vực, gồm đường sương phía nam, suối phía bắc, và liễu rũ phía đông... Phải vậy không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830170
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830170,
					"content": "Chìa khóa, chìa khóa, chìa khóa, quảng trường, tây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830171
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830171,
					"content": "Quảng trường phía tây còn có ba chìa khóa nữa sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830172
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830172,
					"content": "Thu thập ba chiếc chìa khóa và đến quảng trường?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830173
					]
				},
				{
					"id": 740830173,
					"content": "#Paimon, Melusine! {NICKNAME}, Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830174
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830174,
					"content": "#Nào Pahsiv, đừng nói những lời như kiểu {NICKNAME} thông minh hơn tôi vậy chứ! Chúng tôi thông minh ngang nhau mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830175
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830175,
					"content": "Nói tóm lại, giờ chúng ta đã có một chìa khóa rồi, chỉ cần lấy được hai chìa khóa còn lại nữa là xong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830176
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830176,
					"content": "Erinnyes, Melusine... Pahsiv, bảo vệ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830177
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830177,
					"content": "Yên tâm đi. Tuy không biết đã xảy ra chuyện gì, nhưng chúng tôi sẽ giúp cô bảo vệ Đảo Erinnyes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830178
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830178,
					"content": "Nhưng tôi muốn bổ sung một điều. Nếu Pahsiv vô tình nhìn thấy một thứ đồ tròn trịa, vàng lấp lánh mà không ai cần, hoặc là một chiếc rương nào đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830179
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830179,
					"content": "...Thì hãy nói cho chúng tôi biết nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830180
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820780,
					"content": "Pahsiv gãi đầu bối rối, rồi lại vui vẻ nhảy tung tăng, sau đó vội vã đi mất.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740820781
					]
				},
				{
					"id": 740830181,
					"content": "#Chạy luôn rồi. Chắc cô ấy có chuyện gấp. {NICKNAME}, giờ chúng ta đi tìm hai chiếc chìa khóa còn lại nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
