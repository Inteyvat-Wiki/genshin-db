					"nextDialogs": [
						740831002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831002,
					"content": "Chìa khóa, chìa khóa, Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831003
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831003,
					"content": "Chà, Pahsiv, sao đột nhiên lại xuất hiện thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831004
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831004,
					"content": "Không dấu vết, Pahsiv.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831005
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831005,
					"content": "Được rồi... Cô là Melusine đặc biệt nhất tôi từng gặp đấy... À, tôi nhớ là đa số Melusine đều sống ở Đại Sảnh Fontaine hoặc Làng Merusea... Sao cô lại ở đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831006
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831006,
					"content": "Đại Sảnh Fontaine? Làng Merusea?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831007
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831007,
					"content": "Trông cô bối rối như vậy... Không lẽ là chưa từng nghe qua hai cái tên này sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831008
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831008,
					"content": "Đại Sảnh Fontaine, Melusine... Làng Merusea, Melusine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831009
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831009,
					"content": "A... Erinnyes, Pahsiv, quê hương.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831010
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831010,
					"content": "Erinnyes, Pahsiv, bảo vệ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831011
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831011,
					"content": "Đợi đã, cô nói nơi này là quê hương của mình sao? Và cô đang bảo vệ quê hương à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831012
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831012,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831013
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831013,
					"content": "Nhưng quê hương của Melusine là ở Làng Merusea mà nhỉ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740831014
					]
				},
				{
					"id": 740831014,
					"content": "Đúng vậy, kỳ lạ thật. Có Melusine sinh ra ở nơi khác sao? Nhưng hình như ở đây không có Melusine nào khác cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831015
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831015,
					"content": "Pahsiv sống một mình ở đây đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831016
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831016,
					"content": "Một mình? Melusine. Vị khách đó! Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831017
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831017,
					"content": "Vị... vị khách đó? Còn vị khách nào sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831018
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831018,
					"content": "#Vị khách đó! Paimon, Paimon, {NICKNAME}, {NICKNAME}, vị khách đó, vị khách đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831019
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831019,
					"content": "Vậy thì vị khách đó là ai?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740831020
					]
				},
				{
					"id": 740831020,
					"content": "Hình như ý của Pahsiv là vị khách đó tên là \"vị khách đó\", giống như Paimon là Paimon, đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831021
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831021,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831022
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831022,
					"content": "Quả nhiên là vậy, tôi đúng là thông minh mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831023,
						740831024
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831023,
					"content": "Cái tên này kỳ lạ quá.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740831025
					]
				},
				{
					"id": 740831025,
					"content": "Vị khách đó, Pahsiv, tri thức, ka-pow.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831026
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831026,
					"content": "Ừm... Ý là vị khách đó đã giúp cô học hỏi kiến thức đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831027
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831027,
					"content": "Pahsiv! Rất nhiều. Ngôn ngữ, trí tuệ... rất nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831028
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831028,
					"content": "Ừm, tôi thấy thực ra cũng không nhiều mấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831029
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831029,
					"content": "Pahsiv, vị khách đó, bảo vệ, ka-pow.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831030
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831030,
					"content": "Vị khách đó cũng đang giúp cô bảo vệ nơi này sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831031
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831031,
					"content": "Melusine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831032
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831032,
					"content": "Là cô giúp vị khách đó bảo vệ nơi này?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740831033
					]
				},
				{
					"id": 740831033,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831034
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831034,
					"content": "Ra là vậy... Thế vị khách đó rốt cuộc là ai? Tại sao lại cần cô bảo vệ nơi này?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831035
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831035,
					"content": "Hơn nữa, ở đây đúng là đã xảy ra chuyện không hay. Chúng tôi nhìn thấy chữ trên bia đá bị phá hủy, còn có không ít thứ ô uế... Là kẻ địch sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831036
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831036,
					"content": "Paimon tò mò, Pahsiv! Nhưng thời gian, còn lại rất ít.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831037
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831037,
					"content": "Chìa khóa, chìa khóa, chìa khóa, quảng trường, tây, ka-pow, ka-pow.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831038
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831038,
					"content": "Chúng tôi sẽ tranh thủ!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740831039
					]
				},
				{
					"id": 740831039,
					"content": "#Paimon, Pahsiv! {NICKNAME}, Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831040
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831040,
					"content": "Pahsiv vui vẻ nhảy tung tăng, sau đó vội vã rời đi.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740831041
					]
				},
				{
					"id": 740831041,
					"content": "Xem ra không còn nhiều thời gian nữa. Cũng may chúng ta đã có được hai chìa khóa, mau tìm chìa khóa thứ ba thôi nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831024,
					"content": "Cái tên này ngầu thật.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740831025
					]
				}
			]
		},
