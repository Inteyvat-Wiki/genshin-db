				},
				{
					"id": 740830203,
					"content": "Chìa khóa, chìa khóa, chìa khóa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830204
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830204,
					"content": "Không dấu vết, Pahsiv!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830205
					]
				},
				{
					"id": 740830205,
					"content": "#Paimon, Pahsiv! {NICKNAME}, Pahsiv! Chìa khóa, chìa khóa, chìa khóa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830206
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830206,
					"content": "Quảng trường, tây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830207,
					"content": "Hihi, có phải cô muốn nói điều này không? Đừng vội, giờ chúng ta qua đó đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
