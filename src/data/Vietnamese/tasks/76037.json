					"nextDialogs": [
						760370602
					]
				},
				{
					"id": 760370602,
					"content": "\"Mục tiêu truy nã: Cựu lái tàu Atlas, Hark 'Hàm Nứt'. Lý do truy nã: Dính líu đến nhiều vụ án mạng, thủ đoạn tàn nhẫn, hiện không rõ tung tích.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370603
					],
					"speakerTitle": "Treo Thưởng"
				},
				{
					"id": 760370603,
					"content": "\"Bất kỳ ai có thể cung cấp manh mối của hắn, sau khi xác minh sẽ được trọng thưởng.\"",
					"roleType": "TALK_ROLE_NPC",
