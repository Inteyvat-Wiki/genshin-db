			"dialogs": [
				{
					"id": 760370401,
					"content": "(Về Kairagi...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760370402
					]
				},
				{
					"id": 760370402,
					"content": "\"Mục tiêu truy nã: Gonpachi, người Inazuma, mặc trang phục Kairagi. Lý do truy nã: Tấn công bừa bãi các thương nhân qua lại, đã có vài người không may thiệt mạng.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370403
					],
					"speakerTitle": "Treo Thưởng"
				},
				{
					"id": 760370403,
					"content": "\"Mục tiêu đã được nhìn thấy xuất hiện ở gần <color=#00E1FFFF>Hành Lang Trống</color>. Người tiêu diệt và chứng minh được cái chết của hắn thì thương hội sẽ hậu tạ.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Treo Thưởng"
				}
			]
		},
		{
