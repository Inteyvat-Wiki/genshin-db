			"dialogs": [
				{
					"id": 760370501,
					"content": "(Về kẻ buôn lậu...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760370502
					]
				},
				{
					"id": 760370502,
					"content": "\"Mục tiêu truy nã: Bang Tân Thiết Diêm. Lý do truy nã: Bị tình nghi buôn lậu và vận chuyển hàng cấm quy mô lớn.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370503
					],
					"speakerTitle": "Treo Thưởng"
				},
				{
					"id": 760370503,
					"content": "\"Theo điều tra, bang này có một cứ điểm tạm thời tại <color=#00E1FFFF>doanh trại ở bãi biển phía bắc thị trấn</color>. Spina di Rosula xin hậu tạ người giúp đỡ ngăn chặn hành vi buôn lậu của chúng.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Treo Thưởng"
				}
			]
		},
