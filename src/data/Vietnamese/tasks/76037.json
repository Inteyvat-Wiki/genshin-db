			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 760370301,
					"content": "(Về Hidimbi...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760370302
					]
				},
				{
					"id": 760370302,
					"content": "\"Mục tiêu truy nã: Nhà tiên tri Sumeru Hidimbi, nữ, tuổi không rõ. Lý do truy nã: Bị nghi ngờ nguyền rủa người khác và lừa đảo số tiền lớn.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370303
					],
					"speakerTitle": "Treo Thưởng"
				},
				{
					"id": 760370303,
					"content": "\"Ả ta đã lừa của lão già này cả mười tám triệu Mora, nói là chỉ cần đeo sợi dây chuyền mà ả ta vất vả cầu xin được từ thần tình yêu Al-Ahmar là có thể khiến các cô gái vừa gặp đã yêu.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370304
					],
					"speakerTitle": "Treo Thưởng"
				},
				{
					"id": 760370304,
					"content": "\"Sau này mới biết Al-Ahmar căn bản không phải là thần tình yêu. Hắn không những đã chết mấy nghìn năm, mà cả đời còn chẳng tán đổ được cô gái mà hắn yêu.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370305
					],
					"speakerTitle": "Treo Thưởng"
				},
				{
					"id": 760370305,
					"content": "\"Nên sợi dây chuyền ả ta bán tuy là hàng thật, nhưng đó lại là thứ nguyền rủa khiến ta không thể yêu đương. Ai có thể tìm ra tung tích của ả ta giúp ta giải nguyền thì ta sẽ hậu tạ.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Treo Thưởng"
				}
			]
		},
		{
