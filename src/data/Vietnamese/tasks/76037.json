				"points": []
			},
			"dialogs": [
				{
					"id": 760370101,
					"content": "Thông tin của bốn mục tiêu truy nã đều ở trên bảng. Hỏi tôi cũng được, nhưng về tiền thưởng thì không thể thương lượng nữa đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370107,
						760370102,
						760370108
					],
					"speakerTitle": "Leszek"
				},
				{
					"id": 760370107,
					"content": "Nộp bằng chứng về việc đã giải quyết mục tiêu truy nã.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 760370102,
					"content": "Về mục tiêu treo thưởng...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760370103
					]
				},
				{
					"id": 760370103,
					"content": "Hiện tại có bốn mục tiêu, nhưng chỉ có ba có manh mối. Nhà tiên tri Sumeru Hidimbi bị cáo buộc lừa đảo và bị truy nã, thường xuất hiện ở <color=#00E1FFFF>khu vực gần cảng phía nam</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370104
					],
					"speakerTitle": "Leszek"
				},
				{
					"id": 760370104,
					"content": "Inazuma Kairagi điên cuồng đã sát hại nhiều thương nhân đi qua <color=#00E1FFFF>Hành Lang Trống</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370105
					],
					"speakerTitle": "Leszek"
				},
				{
					"id": 760370105,
					"content": "Thành viên băng đảng buôn lậu hàng nguy hiểm, nghe nói đang chiếm giữ <color=#00E1FFFF>doanh trại ở bãi biển phía bắc thị trấn</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370106
					],
					"speakerTitle": "Leszek"
				},
				{
					"id": 760370106,
					"content": "Tên hải tặc hung ác là Hark \"Hàm Nứt\" thì tạm thời không có manh mối. Có lẽ đang ẩn nấp ở đâu đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Leszek"
				},
				{
					"id": 760370108,
					"content": "Tạm biệt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760370109
					]
				},
				{
					"id": 760370109,
					"content": "Không tiễn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Leszek"
				}
			]
		},
