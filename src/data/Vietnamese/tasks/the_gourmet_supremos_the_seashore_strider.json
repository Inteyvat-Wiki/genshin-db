			"dialogs": [
				{
					"id": 721690201,
					"content": "Thế nào, Nhà Lữ Hành, có thu hoạch không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690202
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690202,
					"content": "Ồ! Con cua này trông ngon đấy, bạn tuyệt thật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690203
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690203,
					"content": "Được rồi, nguyên liệu đã đủ, bây giờ tôi sẽ bắt đầu chế biến đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690204
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690204,
					"content": "Tôi chuẩn bị một chút, Nhà Lữ Hành, bạn hãy đợi thêm một lát nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				}
			]
		},
