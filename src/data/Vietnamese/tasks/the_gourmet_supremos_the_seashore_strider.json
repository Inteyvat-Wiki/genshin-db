			"dialogs": [
				{
					"id": 721690301,
					"content": "Gạch Cua Xào...Tại sao lại gọi là Gạch Cua Xào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690302
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690302,
					"content": "Thôi, để nấu ra trước rồi tính.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690303
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690303,
					"content": "Hoàn thành rồi! Đây chính là Gạch Cua Xào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690304
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690304,
					"content": "Tôi muốn một miếng! Ừm...cái này là được rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690305
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 721690305,
					"content": "Cho tôi miếng nhỏ thôi, to quá tôi ăn không hết...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690306
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721690306,
					"content": "Nào, đây là phần của bạn, Nhà Lữ Hành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690307
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690307,
					"content": "Và cả cách chế biến món Gạch Cua Xào này nữa, tôi cũng chép cho bạn một bản.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690308
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690308,
					"content": "Món này chế biến cũng khá đơn giản, khi nào rảnh bạn hãy thử làm xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690311
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690311,
					"content": "Tiếp theo chúng tôi sẽ đến <color=#00E1FFFF>Đảo Yashiori</color>, nếu bạn có thời gian thì đến đó tìm chúng tôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690309
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690309,
					"content": "Được rồi, tôi cũng ăn một chút...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690310
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690310,
					"content": "Ê! Julie! Chừa cho tôi nữa, đừng ăn hết đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				}
			]
		},
