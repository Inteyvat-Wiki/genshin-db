				"points": []
			},
			"dialogs": [
				{
					"id": 721690101,
					"content": "Tên của món ăn này cũng quả là, rất có phong cách của Julie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690102
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690102,
					"content": "Uhm, lần đầu tiên nhìn thấy, tôi còn tưởng là món ăn của Mondstadt, thật không ngờ là đặc sản của Inazuma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690103
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721690103,
					"content": "Tên nghe hay như vậy, chắc chắn rất ngon, Xudong, nhờ cả vào bạn đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690104,
						721690105
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 721690104,
					"content": "Lại gặp nhau rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721690106
					]
				},
				{
					"id": 721690106,
					"content": "Ồ? Nhà Lữ Hành, hi hi, tôi nói mà, chúng ta nhất định còn gặp nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690107
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690107,
					"content": "Xudong vừa lấy được một công thức nấu ăn mới từ trong thành! Gọi là Gạch Cua Xào, thế nào, tên nghe hay chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690108
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 721690108,
					"content": "Món này làm thì không phức tạp, nhưng cần có rất nhiều Cua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690109
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690109,
					"content": "Tôi đã chuẩn bị sẵn một ít Cua thường, đang tìm thêm một ít Cua...đặc biệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690110
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690110,
					"content": "Cua đặc biệt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721690111
					]
				},
				{
					"id": 721690111,
					"content": "Đúng vậy, chính là Cua sinh sống ở dưới gốc cây Lôi Anh Đào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690112
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690112,
					"content": "Chi bằng anh nói thẳng là... cua bị sét đánh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690113
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721690113,
					"content": "Ha ha ha, tóm lại tôi rất hiếu kỳ, cua sống trong môi trường đó...ăn vào sẽ có cảm giác thế nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690114
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690114,
					"content": "Nhưng mà...vì xung quanh cây Lôi Anh Đào đó sấm sét không ngớt, chúng tôi cũng không dám đến gần...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690115
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690115,
					"content": "Trong quyển sách của tôi nói...cũng giống như trước đây, phải chạm vào Cành Lôi Anh Đào trước, để Hạt Giống Lôi dính lên người bạn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690116
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721690116,
					"content": "Như vậy, bạn sẽ không bị sấm sét quanh cây Lôi Anh Đào đánh trúng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690117
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721690117,
					"content": "Nhưng mà cảnh tượng xung quanh cây đó như bạn cũng thấy rồi, chỉ dựa vào vài dòng ghi chép này, tôi cũng không dám thử...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690118
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721690118,
					"content": "Nhưng nếu có thể chạy nhanh, chắc không có vấn đề gì chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690119
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690119,
					"content": "Tôi nói bạn chứ...Bạn chạy nhanh cỡ nào, thì có nhanh bằng tốc độ sấm sét không?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690120
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721690120,
					"content": "Vậy chúng ta đứng bên ngoài, dùng cành cây để gắp Cua ra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690121
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 721690121,
					"content": "Theo tôi thì, chúng ta hãy đào một cái rãnh ở bên cạnh, để dẫn nước và Cua ra ngoài là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690122
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721690122,
					"content": "Ha ha ha...Mọi người đều có ý kiến riêng, khá lắm khá lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690123
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690123,
					"content": "Nhà Lữ Hành, nếu bạn đồng ý, hãy thử đi bắt Cua ở cây Lôi Anh Đào xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690124
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690124,
					"content": "Nếu bắt được, thì đem về cho tôi, tôi sẽ làm một bữa ăn ngon để cảm tạ bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690125
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690125,
					"content": "À, đúng rồi, chờ một chút...Mấy mồi nhử này bạn hãy cầm lấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690126
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690126,
					"content": "Nếu bạn muốn đi bắt Cua, hãy dùng mồi nhử này dụ chúng ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690127
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690127,
					"content": "Như vậy thì, khi bạn bắt Cua sẽ dễ hơn một chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690128
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690128,
					"content": "Cua sinh sống ở cạnh cây Lôi Anh Đào...Ừm, không biết mùi vị ra sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690105,
					"content": "Lại là món gì ngon sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721690106
					]
				}
			]
		},
