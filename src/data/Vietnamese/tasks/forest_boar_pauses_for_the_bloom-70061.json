			"dialogs": [
				{
					"id": 700610701,
					"content": "Ô, hai người về rồi sao? Thế nào rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610702
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610702,
					"content": "Đã đuổi nó đi rồi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700610703
					]
				},
				{
					"id": 700610703,
					"content": "#Ah, cảm ơn {F#cô}{M#cậu} nhiều lắm. Đây, đây là thù lao của {F#cô}{M#cậu}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610704
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610704,
					"content": "Đã bỏ công bỏ sức ra rồi mà, phải nhận thù lao chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610705
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610705,
					"content": "Giờ thì có thể sửa sang lại cánh đồng hoa rồi. Hy vọng lần này sẽ không còn thứ gì không phải con người đến phá hoại nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Leopoldine"
				}
			]
		}
