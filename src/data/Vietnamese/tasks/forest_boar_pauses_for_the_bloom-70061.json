			},
			"dialogs": [
				{
					"id": 700610101,
					"content": "Haiz, lại thế nữa rồi, sao cánh đồng hoa lại bị biến thành thế này chứ... Thật là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610102
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610102,
					"content": "Thế này thì không thể giao hoa đúng hạn được rồi, biết ăn nói thế nào với khách đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610103
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610103,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700610104
					]
				},
				{
					"id": 700610104,
					"content": "#Cánh đồng hoa bị phá mất rồi... Haizz, {F#cô}{M#cậu} xem này, lúc trước hoa đẹp biết bao, giờ bị phá thành thế này rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610105
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610105,
					"content": "Tất cả là tại cái tên đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610106
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610106,
					"content": "Thật quá đáng, cái đồ không phải con người!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700610107
					]
				},
				{
					"id": 700610107,
					"content": "Đúng vậy! Thật sự không phải con người... Nói vậy thôi chứ kẻ gây ra chuyện này đúng là không phải con người, mà là một con heo rừng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610108
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610108,
					"content": "Không hiểu sao dạo này nó cứ chạy xuống gặm hoa, lại còn lăn lộn khắp nơi nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610109
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610109,
					"content": "Mà nó ranh mãnh lắm. Mỗi lần gây ra động tĩnh, chỉ cần có người vây lại là bỏ chạy ngay. Vừa rồi còn suýt đâm gãy lưng cụ già đi ngang qua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610110
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610110,
					"content": "Thật quá đáng, cái đồ không phải... cái đồ heo rừng xấu xa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610111
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610111,
					"content": "#Ô, nhìn kỹ lại thì... Ôi, {F#cô}{M#cậu} là Kỵ Sĩ Danh Dự đấy à, anh hùng cứu tinh của Mondstadt, vậy hãy... hãy giúp tôi với.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610112
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610112,
					"content": "Được, để tôi đuổi nó đi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700610113
					]
				},
				{
					"id": 700610113,
					"content": "#{F#Cô}{M#Cậu} sẵn lòng giúp đỡ thì tốt quá... Tôi nhớ là nó chạy vào thung lũng rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610114
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610114,
					"content": "Nhưng mà nó ranh ma lắm đấy, chắc phải dùng hoa mới dụ được nó ra... Tiếc là bây giờ cánh đồng hoa đã thành thế này rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610115
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610115,
					"content": "#Chắc là {F#cô}{M#cậu} có thể hái một ít Hoa Gió Lặng ở dọc đường để dụ nó, cho nó biết mùi vị bị trêu đùa là như thế nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Leopoldine"
				}
			]
		},
