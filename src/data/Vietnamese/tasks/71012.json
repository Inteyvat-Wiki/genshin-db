				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710120201,
					"content": "\"Gió mang đến những câu chuyện mới, thời gian sẽ khiến chúng trở thành thần thoại.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710120202
					],
					"speakerTitle": "Chữ Khắc Cũ Kỹ"
				},
				{
					"id": 710120202,
					"content": "Chiếc đồng hồ được nhắc tới trong cuốn nhật ký đó, chắc là nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710120203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710120203,
					"content": "Có điều, rốt cuộc chiếc đồng hồ này có chỗ nào đặc biệt nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710120204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710120204,
					"content": "Ừm, chúng ta hãy xem kỹ lại cuốn nhật ký đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7101210,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7101210",
							"2"
						],
						"stepId": 7101210,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Henry Morton"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710121001,
					"content": "Hả? Nhà Lữ Hành, bạn đến có việc gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121002
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121002,
					"content": "Về mắt bão...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710121003
					]
				},
				{
					"id": 710121003,
					"content": "Mắt bão? Tôi vẫn luôn ở quanh đây, nhưng chưa từng thấy những thứ như vậy, chỉ là vừa rồi một cơn gió mạnh bất chợt thổi qua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121004
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121004,
					"content": "Có điều chắc chắn là chưa từng xuất hiện mắt bão. Nếu có thứ to lớn ấy, tôi nhất định sẽ không quên được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121005,
						710121007
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121005,
					"content": "Được rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710121006
					]
				},
				{
					"id": 710121006,
					"content": "Tin tôi đi, nếu thứ đó đến đây phá rối việc nghiên cứu của tôi, tôi chắc chắn sẽ không quên đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121009
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121009,
					"content": "Chính xác mà nói... thì là thực hiện nghiên cứu cùng với một người bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121010
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121010,
					"content": "Người bạn đó của tôi cũng là một học giả, chúng tôi đã từng học chung ở Giáo Viện Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121011
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121011,
					"content": "Sau đó, anh ấy làm một nhà khảo cổ học, đi khảo sát khắp mọi nơi trên thế giới, còn tôi tiếp tục học ở Giáo Viện...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121012
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121012,
					"content": "Khi anh ấy đến Mondstadt, còn rất hào hứng nói với tôi rằng anh ấy đang khảo sát ở Thiên Phong Thần Điện của Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121013
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121013,
					"content": "Còn nói gì mà \"đợi tôi khai quật được bí mật quê hương bạn, sẽ nói cho bạn biết đầu tiên\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121014
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121014,
					"content": "Rồi anh ấy bỗng bặt vô âm tín, tôi nhờ người mang thư đến cho ngài Cyrus, nhờ Hiệp Hội Nhà Mạo Hiểm tìm kiếm tung tích người bạn của mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121015
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121015,
					"content": "Nhưng mãi mà không có bất kỳ tin tức gì nên tôi đã ngừng việc học ở Sumeru, vội vàng trở về đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121016
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121016,
					"content": "Có điều, ở đây cũng chỉ có một chiếc đồng hồ, không có manh mối nào khác...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121017
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121017,
					"content": "Về chiếc đồng hồ trên hòn đảo đó...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710121018
					]
				},
				{
					"id": 710121018,
					"content": "Gì cơ? Không ngờ còn có một chiếc đồng hồ giống hệt như vậy, còn ở một hòn đảo biệt lập trên biển?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121019
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121019,
					"content": "Ừm, tôi nhớ ra rồi, khi thời tiết đẹp, tôi đã nhìn thấy hòn đảo đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121020
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121020,
					"content": "Đợi đã, bạn nói... tìm thấy một cuốn nhật ký bên cạnh chiếc đồng hồ trên hòn đảo kia? Lẽ nào anh ấy đã ở đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121021
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121021,
					"content": "Cảm ơn bạn, nếu có cơ hội tôi sẽ lên hòn đảo biệt lập đó xem sao, bây giờ tôi vẫn muốn nghiên cứu rõ ràng chỗ này đã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121022
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121022,
					"content": "Tôi phải tiếp tục nghiên cứu, nếu bạn có hứng thú có thể xem các ghi chép nghiên cứu của tôi, tôi để ở bên đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121023
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121023,
					"content": "Nói không chừng có cái gì đó có ích với bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121007,
					"content": "Bạn đang làm gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710121008
					]
				},
				{
					"id": 710121008,
					"content": "Tôi? Tôi đang thực hiện một số nghiên cứu ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121009
					],
					"speakerTitle": "Henry Morton"
				}
			]
		},
