			"dialogs": [
				{
					"id": 710122401,
					"content": "Thứ đó từ đâu chui ra vậy! Trước đây chưa thấy bao giờ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710122402
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710122402,
					"content": "Bạn làm thể nào để gọi thứ to lớn ấy ra vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710122403
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710122403,
					"content": "Là như vậy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710122404
					]
				},
				{
					"id": 710122404,
					"content": "Quả nhiên là \"thời gian và gió\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710122405
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710122405,
					"content": "Trên hòn đảo biệt lập đó, còn có chiếc đồng hồ giống hệt như vậy phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710122406
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710122406,
					"content": "Hơn nữa, cách giải câu đố cũng hoàn toàn giống nhau. Hai chiếc đồng hồ này, hai nơi này, chắc chắn có một mối liên hệ nào đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710122407
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710122407,
					"content": "Không được, tôi phải nghĩ cách, mau chóng lên hòn đảo đó xem sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710122408
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710122408,
					"content": "Cảm ơn Nhà Lữ Hành, tôi sẽ đến tìm bạn khi sẵn sàng, chúng ta cùng nhau lên đảo hoang đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Henry Morton"
				}
			]
		}
