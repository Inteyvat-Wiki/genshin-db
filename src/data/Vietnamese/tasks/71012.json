			},
			"dialogs": [
				{
					"id": 710120101,
					"content": "\"Gió mang đến những câu chuyện mới, thời gian sẽ khiến chúng trở thành thần thoại.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710120102
					],
					"speakerTitle": "Chữ Khắc Cũ Kỹ"
				},
				{
					"id": 710120102,
					"content": "Câu này có ý nghĩa gì vậy... không có manh mối gì cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710120103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710120103,
					"content": "Ừm, có điều dường như nơi này nhìn có bí mật gì đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710120104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710120104,
					"content": "Chúng ta đi xung quanh xem sao, nói không chừng sẽ tìm ra manh mối.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7101202,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
