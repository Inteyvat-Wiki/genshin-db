			},
			"dialogs": [
				{
					"id": 710121101,
					"content": "Thời gian và gió... Rốt cuộc tên đó đã nghiên cứu ra thứ gì nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121102,
						710121106
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121102,
					"content": "Thời gian và gió?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710121103
					]
				},
				{
					"id": 710121103,
					"content": "Ừm, đó là từ được nhắc đến trong lá thư cuối cùng mà bạn tôi đã viết cho tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121104
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121104,
					"content": "Anh ấy nói, trong \"thời gian và gió\" có cất giấu một bí mật của Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121105
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121105,
					"content": "Có điều một người địa phương như tôi cũng chưa từng nghe đến thuật ngữ này, tên đó làm sao mà biết được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121106,
					"content": "Bạn đã học ở Sumeru?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710121107
					]
				},
				{
					"id": 710121107,
					"content": "Đúng vậy, mặc dù tôi là người Mondstadt, nhưng vẫn luôn học ở Giáo Viện Sumeru, thời gian học ở Giáo Viện còn nhiều hơn thời gian ở Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121108
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121108,
					"content": "Bạn muốn biết tình hình bên trong Giáo Viện không? Cũng không phải bí mật, bên trong đó... ừm... nên nói thế nào nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121109
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121109,
					"content": "Toàn là một đám... người lập dị? Kiểu miêu tả này có chút thất lễ... phải nói là một đám người \"khiến người ta có ấn tượng sâu sắc\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121110
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121110,
					"content": "Nếu trong tương lai bạn có cơ hội đến Giáo Viện, có thể tự mình trải nghiệm, nhưng... trải nghiệm là trải nghiệm, đừng ở đó quá lâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Henry Morton"
				}
			]
		},
