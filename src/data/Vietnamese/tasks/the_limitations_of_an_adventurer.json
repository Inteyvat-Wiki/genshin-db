					"content": "Bạn tìm được cọc gỗ chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620302
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620302,
					"content": "Tìm được rồi, nhưng mà...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200620303
					]
				},
				{
					"id": 200620303,
					"content": "Ha... Bạn xuống tay cũng quá mạnh rồi, cọc gỗ chắc chắn như vậy cũng đều bị bạn đánh gãy cả rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620304
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620304,
					"content": "Dù vậy khi chiến đấu thật sự sẽ không có người vì cọc gỗ mà nương tay...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620305
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620305,
					"content": "Mặc dù không thể trực tiếp đưa cho Ellin... nhưng nguyên liệu đã có rồi, để tôi gia công một chút là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620306
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620306,
					"content": "Miễn cưỡng lắp ráp với nhau, bạn xem, khụ... Cũng có chút dáng vẻ, phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620307
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620307,
					"content": "Dù sao cũng cảm ơn bạn. Đây là thù lao, tôi đã nói không để bạn làm không công.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620308
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620308,
					"content": "Mặc dù tôi không còn là nhà mạo hiểm, nhưng quy định của nhà mạo hiểm không thể phá vỡ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Herman"
				}
			]
		},
