			"dialogs": [
				{
					"id": 200620201,
					"content": "Bạn tìm được cọc gỗ chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620202
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620202,
					"content": "Tìm được rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200620203
					]
				},
				{
					"id": 200620203,
					"content": "Ừm... haha, nhìn này, chất lượng thật sự không tồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620204
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620204,
					"content": "Cọc gỗ này có thể chịu được sự dày vò Hilichurl, nhất định cũng chịu được sự dày vò của Ellin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620205
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620205,
					"content": "Cảm ơn bạn, à đúng rồi, theo quy củ của nhà mạo hiểm, đây là thù lao của bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Herman"
				}
			]
		},
		{
