					"nextDialogs": [
						200620402
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620402,
					"content": "Vẫn chưa tìm được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200620403
					]
				},
				{
					"id": 200620403,
					"content": "Ellin đang nỗ lực tập luyện, điều tôi có thể làm được cho con bé cũng chỉ có vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620404
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620404,
					"content": "Nếu như tôi vẫn là Nhà Mạo Hiểm, tôi có thể tự đi lấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620405
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620405,
					"content": "Hơn nữa với tình trạng hiện tại của Hiệp Hội Nhà Mạo Hiểm Mondstadt... Những bạn \"đồng hành\" cũ của tôi, họ cũng không làm Nhà Mạo Hiểm nữa rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620406
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620406,
					"content": "Cũng không có cách nào khác, Đội Kỵ Sĩ Tây Phong ở Thành Mondstadt mạnh như vậy, người trẻ đều muốn đi làm Kỵ Sĩ, còn những Nhà Mạo Hiểm lăn lộn ở nơi hoang dã thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620407
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620407,
					"content": "Sớm chẳng còn ai muốn làm nữa rồi",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Herman"
				}
			]
		},
