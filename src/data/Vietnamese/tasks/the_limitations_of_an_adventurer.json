			"dialogs": [
				{
					"id": 200620501,
					"content": "Phải dạy dỗ thế nào đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620502
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200620502,
					"content": "Đang làm gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200620503
					]
				},
				{
					"id": 200620503,
					"content": "Ồ, tôi đang tập luyện cho đợt tuyển Kỵ Sĩ. Thế nhưng không biết làm thế nào, cũng không có người hướng dẫn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620504
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200620504,
					"content": "Bố tôi luôn nói rằng ông là Nhà Mạo Hiểm, có thể hướng dẫn cho tôi, thế nhưng tôi không tin điều ấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620505
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200620505,
					"content": "Ông ấy như vậy, làm sao có thể hướng dẫn tôi thông qua được đợt tuyển Kỵ Sĩ cơ chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620506
					],
					"speakerTitle": "Ellin"
				},
