			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Herman"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200620101,
					"content": "Phải làm sao đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620102
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620102,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200620103
					]
				},
				{
					"id": 200620103,
					"content": "Là thế này... Con gái của tôi là Ellin muốn gia nhập Đội Kỵ Sĩ Tây Phong, đang chuẩn bị cho việc tuyển chọn kỵ sĩ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620104
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620104,
					"content": "Hừm... Tôi vốn muốn đích thân chỉ dạy nó, nhưng có làm sao nó cũng không tin tôi trước đây là nhà mạo hiểm, khăng khăng tự tập luyện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620105
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620105,
					"content": "Tôi cũng không còn cách nào chứng minh cho nó thấy... sau khi có vợ con, tôi đã không còn muốn mạo hiểm khắp nơi nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620106
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620106,
					"content": "So với việc thỏa mãn ham muốn mạo hiểm và lòng tự tôn của bản thân, chăm sóc gia đình mới là nhiệm vụ quan trọng hiện tại tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620107
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620107,
					"content": "Haha, nhưng \"nhà mạo hiểm\" tôi đây, chung quy cũng có thể làm chút gì đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620108
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620108,
					"content": "Trước đây khi tôi mạo hiểm khắp nơi, đã để ý đến những cọc gỗ đám Hilichurl dùng để tập luyện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620109
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620109,
					"content": "Những cọc gỗ đó chất lượng có vẻ không tệ, nhất định sẽ thích hợp để Ellin dùng tập luyện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620110
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620110,
					"content": "Giúp tôi đi tìm 1 vài cọc gỗ của Hilichurl trở về. Theo quy củ của nhà mạo hiểm, tôi cũng sẽ không để bạn làm việc không công, bạn thấy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620111,
						200620112
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620111,
					"content": "Tôi biết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200620113
					]
				},
				{
					"id": 200620113,
					"content": "Ừm, tôi rất thích những người thẳng thắn, bạn rất có tác phong của tôi khi mới vào nghề năm đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620114
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620114,
					"content": "Đùa thôi, đùa thôi, được rồi, mau đi đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620112,
					"content": "Chỉ là Hilichurl, một mình bạn cũng có thể...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200620115
					]
				},
				{
					"id": 200620115,
					"content": "Không, không được không được, năng lực của nhà mạo hiểm có hạn. 1 nhà mạo hiểm cùng lúc chỉ có thể ứng phó với 1 trận mạo hiểm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620116
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620116,
					"content": "Và cuộc phiêu lưu trong \"cuộc sống hôn nhân\"... cho dù là nhà mạo hiểm vĩ đại thế nào đều phải đầu tư toàn bộ thể xác lẫn tinh thần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620117
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620117,
					"content": "Cho nên việc tìm kiếm cọc gỗ phải nhờ cậy vào bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Herman"
				}
			]
		},
		{
			"id": 2006202,
