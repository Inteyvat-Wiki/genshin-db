			"dialogs": [
				{
					"id": 727310201,
					"content": "Hahahahahahaha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310202
					],
					"speakerTitle": "Tướng Quân Hanakado"
				},
				{
					"id": 727310202,
					"content": "Vui quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310203
					],
					"speakerTitle": "Tướng Quân Hanakado"
				},
				{
					"id": 727310203,
					"content": "Hahahahahahaha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310204
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310204,
					"content": "Sảng khoái!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310205
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310205,
					"content": "Mặc dù phong cách đấu bọ không giống ta, nhưng niềm đam mê mà ngươi đổ vào Onikabuto khiến ta tìm thấy sự cộng hưởng mạnh mẽ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310206
					],
					"speakerTitle": "Tướng Quân Hanakado"
				},
				{
					"id": 727310206,
					"content": "Một ngày nào đó, ngươi chắc chắn sẽ trở thành cao thủ đấu bọ hàng đầu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310207
					],
					"speakerTitle": "Tướng Quân Hanakado"
				},
				{
					"id": 727310207,
					"content": "Ngươi cũng không tệ! Trong 1141 cuộc so tài, cũng miễn cưỡng thắng được bổn đại gia 570 trận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310208
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310208,
					"content": "Trong số những đối thủ đấu với bổn đại gia hơn trăm trận, ngươi là người có nghị lực nhất. Không thể không nói, ngươi đã làm cho ta nhìn ngươi bằng con mắt khác đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310209
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310209,
					"content": "Là 571 trận, ta thắng nhều lần hơn. Xét đến việc đấu trên sân khách, lẽ ra ta phải chiếm ưu thế hơn mới đúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310210
					],
					"speakerTitle": "Tướng Quân Hanakado"
				},
				{
					"id": 727310210,
					"content": "Hả? Sao thế? Đến lúc này vẫn còn cứng miệng sao? Bổn đại gia nhớ rất rõ, Mamoru cũng có thể làm chứng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310211
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310211,
					"content": "Đúng không, Mamoru?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310212
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310212,
					"content": "Đại ca... Em, em thật sự không chịu nổi nữa rồi... Cho em ngủ một chút đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310213
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 727310213,
					"content": "Ôi, không lẽ họ vẫn ở đây đấu bọ suốt mà không hề nghỉ ngơi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310214,
					"content": "Họ vẫn ở đây đấu bọ mà không hề nghỉ ngơi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310215,
						727310216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310215,
					"content": "Lôi đài sắp sập luôn rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727310217
					]
				},
				{
					"id": 727310217,
					"content": "Được! Bổn đại gia sẽ khoan dung, nhường ngươi một trận cũng không sao, dù sao thì bổn đại gia cũng sẽ thắng lại thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310218
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310218,
					"content": "Nhìn bộ dạng không phục của ngươi, các trận sau đấu ở sân nhà ngươi đi. Bổn đại gia sẽ cho ngươi hiểu, địa điểm không ảnh hưởng gì cả, quan trọng hơn hết vẫn là người đấu bọ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310219
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310219,
					"content": "Đúng ý ta lắm, vậy thì đi theo ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310220
					],
					"speakerTitle": "Tướng Quân Hanakado"
				},
				{
					"id": 727310220,
					"content": "Ơ? Bạn thân của ta và Dưa Tím Lùn Biết Bay, cuối cùng thì hai ngươi cũng tới!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310221
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310221,
					"content": "Sao lại quay về với Dưa Tím Lùn Biết Bay rồi, không lẽ lúc không đấu bọ thì anh chỉ nghĩ đến biệt danh khó nghe này thôi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310222,
					"content": "Chuyện này dẹp qua một bên trước đi! Phiếu ưu đãi ramen miễn phí 2 tháng như đã hứa đây, cầm lấy đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310223
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310223,
					"content": "Phiếu ưu đãi ramen? Đúng rồi, ramen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310224,
					"content": "Vậy mới phải chứ, xem như anh biết điều!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310225,
						727310226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310225,
					"content": "Chúc mừng!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727310227
					]
				},
				{
					"id": 727310227,
					"content": "Không đúng không đúng, lần này chỉ là buổi diễn tập của \"Đại Hội Đấu Bọ Arataki Siêu Hoành Tráng\" thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310228
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310228,
					"content": "Dù sao cũng không có khán giả nên khá vắng vẻ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310229
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310229,
					"content": "May mà Tướng Quân Hanakado đã bỏ cái tôi của mình xuống, thừa nhận bổn đại là cao thủ đấu bọ hiếm thấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310230
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310230,
					"content": "Trận đấu của chúng ta vẫn chưa kết thúc, lần sau bổn đại gia phải một mình xông vào doanh trại của Tướng Quân Hanakado, đánh một trận thật nhiệt huyết mới được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310231
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310231,
					"content": "Đến lúc đó, Tướng Quân Hanakado cũng sẽ nghe theo ta, mọi người cùng nhau tổ chức \"Đại Hội Đấu Bọ Arataki Siêu Hoành Tráng\" cho thật vang dội!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310232
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310232,
					"content": "Lần này cảm ơn các ngươi, chờ tin thắng lợi của bổn đại gia nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310233
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310233,
					"content": "Hihi, lần này Tên Thả Bò xem như thỏa mãn rồi, chúng ta cũng kiếm được hai tháng ăn ramen nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310234,
						727310235
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310234,
					"content": "Đại bội thu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727310236
					]
				},
				{
					"id": 727310236,
					"content": "Đại ca, đại ca! Có thư của chị Shinobu gửi này, đại ca mau xem đi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310237
					],
					"speakerTitle": "Akira"
				},
				{
					"id": 727310237,
					"content": "Ơ? Đại ca đâu rồi? Ban nãy rõ ràng vẫn còn ở đây đấu bọ mà?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310238
					],
					"speakerTitle": "Akira"
				},
				{
					"id": 727310238,
					"content": "Ủa? Có chuyện gì quan trọng sao? Tên thả bò vừa đi cùng Tướng Quân Hanakado rồi, nói là phải tiếp tục so tài...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310239
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310239,
					"content": "Cũng không phải việc quan trọng gì, chỉ là chút bất ngờ thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310240
					],
					"speakerTitle": "Akira"
				},
				{
					"id": 727310240,
					"content": "Nội dung cụ thể thì mọi người xem trong thư đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310241
					],
					"speakerTitle": "Akira"
				},
				{
					"id": 727310241,
					"content": "Chậc, cuối cùng thì Tướng Quân Hanakado cũng được xem là người của Bang Arataki sao? Chẳng qua là Tướng Quân Hanakado nói chuyện không đàng hoàng, làm cho Tên Thả Bò cứ như là gặp phải kẻ thù vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310242
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310242,
					"content": "Đúng như dự đoán của Shinobu, Tên Thả Bò đã mải mê việc đấu bọ đến mức quên ăn quên ngủ luôn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310243
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310243,
					"content": "Nhưng đã tìm chúng ta để tổ chức \"Đại Hội Đấu Bọ Arataki Siêu Hoành Tráng\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310244
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310244,
					"content": "Xem ra không thể tính là \"tạm nghỉ\" được...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727310245
					]
				},
				{
					"id": 727310245,
					"content": "Xem ra phiếu ưu đãi ramen phải nhường cho Shinobu mới đúng! Đợi Shinobu về, chúng ta cùng đi ăn đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310246
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310246,
					"content": "Ơ? Khoan đã...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310247
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310247,
					"content": "Nói chứ, Tên Thả Bò vẫn chưa nói cho chúng ta biết phiếu ưu đãi này có thể ăn ở tiệm mì nào mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310248
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310248,
					"content": "Chẳng lẽ chúng ta phải tự mình đi tìm sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310235,
					"content": "Được rồi, thật ra vui vẻ vẫn quan trọng hơn...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727310236
					]
				},
				{
					"id": 727310226,
					"content": "\"Đại Hội Đấu Bọ\" kết thúc tốt đẹp!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727310227
					]
				},
				{
					"id": 727310216,
					"content": "Onikabuto sắp mệt xỉu rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727310248
					]
				}
			]
		},
