			"dialogs": [
				{
					"id": 752580101,
					"content": "Ơ? Sao ở đây lại có người bị ngất rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752580102,
					"content": "Này! Có nghe thấy gì không? Anh không sao chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752580103,
					"content": "Các bạn đỡ người dưới đất dậy, rồi anh ấy từ từ tỉnh lại...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752580104
					]
				},
				{
					"id": 752580104,
					"content": "Ôi, ôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580105,
						752580106
					],
					"speakerTitle": "Nhân Viên Bất Tỉnh"
				},
				{
					"id": 752580105,
					"content": "Xin chào, anh uống say rồi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752580107
					]
				},
				{
					"id": 752580107,
					"content": "Chóng mặt quá... Chuyện gì đang xảy ra vậy... Để tôi nhớ lại xem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580108
					],
					"speakerTitle": "Nhân Viên Bất Tỉnh"
				},
				{
					"id": 752580108,
					"content": "Ah! Nhớ ra rồi! Hình như tôi bị người ta đánh ngất... Nhưng tôi không thấy được người đó. Đợi đã... Chẳng lẽ là hai người sao?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580109
					],
					"speakerTitle": "Nhân Viên Bất Tỉnh"
				},
				{
					"id": 752580109,
					"content": "Này! Chúng tôi có lòng tốt đỡ anh dậy đấy, đừng có mà ăn vạ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752580110,
					"content": "Ồ, xin lỗi... Hmm, tôi là nhân viên Quán Rượu Mật Ngọt, vốn dĩ phải đến cảng phía bắc giao hàng... Thương hội Nod-Krai có mua một số rượu mật ở chỗ chúng tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580111
					],
					"speakerTitle": "Nhân Viên Bất Tỉnh"
				},
				{
					"id": 752580111,
					"content": "Ôi! Tiêu rồi, hàng của tôi đâu rồi? Rượu mật mất hết rồi! Không lẽ bị cướp mất rồi sao? Đợi đã... Không lẽ là hai người đã cướp mất sao?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580112
					],
					"speakerTitle": "Nhân Viên Bất Tỉnh"
				},
				{
					"id": 752580112,
					"content": "Đã nói chúng tôi là người có lòng tốt đỡ anh đứng dậy mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752580113,
					"content": "Xin lỗi, bây giờ tôi hơi choáng váng. Cảm ơn các vị, nhưng tôi phải về quán rượu báo cáo tình hình đã...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580114
					],
					"speakerTitle": "Nhân Viên Bất Tỉnh"
				},
				{
					"id": 752580114,
					"content": "Nếu thực sự có cướp thì các vị cũng đừng đi về phía bắc nhé. Có thể sẽ gặp nguy hiểm đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nhân Viên Bất Tỉnh"
				},
				{
					"id": 752580106,
					"content": "Cần tôi đưa về nhà không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752580107
					]
				}
			]
		}
	]
