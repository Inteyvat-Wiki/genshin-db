			"trigger": {
				"objectNames": [
					"Jean"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3580101,
					"content": "...Sự việc diễn ra như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580102
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3580102,
					"content": "Mondstadt chào mừng bạn, Nhà Lữ Hành đến từ những cơn gió.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580103
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3580103,
					"content": "Tôi là Đội Trưởng Đại Diện, Jean. Vị này là Lisa, người quản lý thư viện Đội Kỵ Sĩ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580104
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3580104,
					"content": "A, là vì nhân lực không đủ, nên đây là những bạn trẻ tốt bụng đến giúp đỡ phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580105
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3580105,
					"content": "Thật dễ thương.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580106
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3580106,
					"content": "Chỉ là, không đúng lúc lắm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580107
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3580107,
					"content": "Từ khi Phong Ma Long thức tỉnh, thường hoạt động xung quanh thành, gây ra hỗn loạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580108
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3580108,
					"content": "Hiện nay dòng chảy Nguyên Tố, địa mạch tuần hoàn của Mondstadt, đều trở nên lộn xộn giống như cuộn len bị mèo cào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580109
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3580109,
					"content": "Tình hình tồi tệ nhất đối với ma pháp sư là... làn da và tâm trạng đều trở nên thật tệ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580110
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3580110,
					"content": "Nếu không bị những thứ này làm phiền, Đội Kỵ Sĩ sẽ có cách tốt hơn là dán cáo thị tìm người để giúp các bạn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580111
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3580111,
					"content": "Tạm thời mời các bạn ở lại Mondstadt, Đội Kỵ Sĩ Tây Phong sẽ cố gắng giải quyết vấn đề.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580112,
						3580114
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3580112,
					"content": "Cũng chỉ có Đội Kỵ Sĩ lo được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3580113
					]
				},
				{
					"id": 3580113,
					"content": "Paimon cũng sẽ giúp!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3580116,
					"content": "Vậy thì, cùng xác định kế hoạch tác chiến trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580117
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3580117,
					"content": "Phong Ma Long tấn công Mondstadt, nhưng lại giúp chúng ta nhìn thấy được cơ hội để kết thúc nguồn gốc tai họa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580118
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3580118,
					"content": "Dưới sự do thám bằng ma pháp của Lisa, cơn bão phủ kín Mondstadt đã để lộ nguồn gốc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580119
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3580119,
					"content": "Ồ? Vậy thì câu trả lời là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580120
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3580120,
					"content": "<color=#00E1FFFF>Đền Tứ Phong Thủ Hộ</color> bị bỏ hoang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580121
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3580121,
					"content": "Phong Ma Long có thể gây ra cơn bão ở mức độ này, chính là nhờ đã lợi dụng sức mạnh còn sót lại ở đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580122
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3580122,
					"content": "Mà mục tiêu của chúng ta, là <color=#00E1FFFF>3</color> trong 4 khu đền bị bỏ hoang này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580123
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3580123,
					"content": "Lý do chỉ chọn 3 ngôi đền... chắc mọi người cũng đều hiểu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580124
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3580124,
					"content": "Tôi không hiểu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580125,
						3580126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3580125,
					"content": "Đây có thể là sự hiểu ý ngầm giữa những người bản địa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3580127
					]
				},
				{
					"id": 3580127,
					"content": "Các vị Kỵ Sĩ Tây Phong, việc không thể chậm trễ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580128
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3580128,
					"content": "Bão đang tiến vào, phòng thủ bị động cũng không có ý nghĩa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580129
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3580129,
					"content": "Trước khi hiểm họa rồng lan rộng, chúng ta phải đi trước một bước, hướng đến <color=#00E1FFFF>di tích</color> của <color=#00E1FFFF>đền bỏ hoang</color> nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jean"
				},
				{
					"id": 3580126,
					"content": "Lát nữa chúng ta sẽ hỏi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3580127
					]
				},
				{
					"id": 3580114,
					"content": "Vậy thì nhờ cả vào Đội Kỵ Sĩ rồi. Nhà trọ ở đâu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3580115
					]
				},
				{
					"id": 3580115,
					"content": "Này! Không được lười biếng, chúng ta cũng nên tham gia chung chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580116
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}