			},
			"dialogs": [
				{
					"id": 400670501,
					"content": "Chậu bonsai kia, lẽ ra phải có cái cây chết khô trong đó. Nhưng ở đây lại không thấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670502
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400670502,
					"content": "...Lúc mọi người không có ở đây, tôi đã suy nghĩ rất nhiều, cuối cùng cũng hiểu ra được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670503
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400670503,
					"content": "Đây là ảo cảnh của tôi, trong chậu bonsai trống rỗng không có gì, cũng như thâm tâm của tôi vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670504
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400670504,
					"content": "Trong lòng \"tịnh\", đất trời vạn vật đều sẽ \"tịnh\"; Trong lòng trống \"không\", đất trời cũng hóa thành \"không\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670505
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400670505,
					"content": "Tịnh và không, là thâm tâm hiện giờ của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670506
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400670506,
					"content": "Nhưng đó chưa chắc không phải là nỗi tiếc nuối. Nếu trong lòng hụt hẫng, cũng là \"không\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670507
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400670507,
					"content": "Vậy nên chậu bonsai này mới xuất hiện bên trong ảo cảnh của tôi, cho tôi cơ hội để hoàn thành tâm nguyện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670508
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400670508,
					"content": "Không ngờ sâu trong lòng tôi, lại luôn muốn làm ra một chậu bonsai thuộc về mình như thế... Có vậy thì tôi mới coi như đã kế thừa truyền thống chân chính của nhà Kaedehara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				}
			]
		},
