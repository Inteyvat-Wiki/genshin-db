			"dialogs": [
				{
					"id": 400671401,
					"content": "Những căn phòng kỳ lạ hôm nay, trông như ảo cảnh... ừm... chậu bonsai? Dù sao thì toàn những thứ kỳ lạ! Tôi nghĩ, không biết có nên nói với Venti không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671402,
						400671403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671402,
					"content": "Tôi cũng nghĩ như vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400671404
					]
				},
				{
					"id": 400671404,
					"content": "Dodoco... Dodoco...",
					"roleType": "TALK_ROLE_NPC",
