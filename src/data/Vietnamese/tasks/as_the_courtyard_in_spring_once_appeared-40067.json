				},
				{
					"id": 400670402,
					"content": "Anh... sao anh lại giúp tôi? Tôi là tội phạm bị truy nã đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670403
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400670403,
					"content": "Tất nhiên là vì Hiệp Hội Yash... À khụ khụ! Có người trả tiền, nhờ tôi đưa anh rời khỏi Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670404
					],
					"speakerTitle": "Lắng nghe"
				},
				{
					"id": 400670404,
					"content": "Nhưng người đó cũng chỉ giúp được đến đây thôi, con đường sau này phải dựa vào chính bản thân anh đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lắng nghe"
				}
			]
		},
