					"nextDialogs": [
						400671205
					]
				},
				{
					"id": 400671205,
					"content": "Những thứ cổ xưa thường đi kèm với sự tiếc nuối. Kaedehara cũng như thế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671206
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400671206,
					"content": "Không sao, chia ly cũng là đoàn tụ. Nếu không ở đây, thì cũng là ở một nơi khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671209
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400671209,
					"content": "Bí cảnh này rất thú vị, giống như một vở kịch vậy, mỗi tập đều đặc biệt và cảm động hơn tập trước.",
