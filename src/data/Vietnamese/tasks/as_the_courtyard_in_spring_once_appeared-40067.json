			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bộ Liên Lạc Dodoco"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400670101,
					"content": "...Hình như mỗi lần gặp bạn đều trong tình huống thế này nhỉ. Xem bói, giải quẻ, xác định mục tiêu rồi giải quyết vấn đề.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670102
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670102,
					"content": "Bên cạnh bạn có đủ kiểu bạn bè, đều có bí mật và số phận riêng, thật bất ngờ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670103
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670103,
					"content": "Đúng nhỉ, chuyện của Leonard cũng đã cùng Mona và Fischl giải quyết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400670104,
					"content": "Đối với nhà chiêm tinh mà nói thì cũng là một chuyện tốt mà nhỉ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400670105
					]
				},
				{
					"id": 400670105,
					"content": "Cũng gần như thế. Chỉ mong lần này chúng ta có thể hợp sức để nhanh chóng giải quyết vấn đề.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670106
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670106,
					"content": "Nói tới hợp sức, ý là chỉ hai người các bạn hay ba người chúng ta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400670107,
					"content": "Heh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670108
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670108,
					"content": "Được rồi được rồi, tôi sẽ không để Paimon ra rìa nữa. Đôi khi cách nhìn của Paimon rất độc đáo nhạy bén, giúp ích cho tôi rất nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670109
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670109,
					"content": "Thật sao? Tôi bắt đầu thích cô rồi đấy, thiên tài Mona!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400670110,
					"content": "Đúng không nè? Một thuật sĩ chiêm tinh vừa thông minh lại quyến rũ như tôi, không thể tìm được người thứ hai giống vậy trên thế giới này đâu, hahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670111
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670111,
					"content": "Thì đúng là thông minh, nhưng cô có thể... đừng cười giống Fischl được không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400670112,
					"content": "Khụ! Ngại quá... ở chung lâu rồi nên bị lây đó mà... haha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670113
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670113,
					"content": "#Ngày tháng sau này, tôi sẽ tiếp tục quan sát tinh tượng. Hãy giữ liên lạc nhé, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
