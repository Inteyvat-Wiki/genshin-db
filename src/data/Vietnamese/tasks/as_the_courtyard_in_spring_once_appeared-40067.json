			"dialogs": [
				{
					"id": 400670401,
					"content": "Anh là Kaedehara Kazuha sao? Mau lên thuyền, tôi đưa anh đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670402
