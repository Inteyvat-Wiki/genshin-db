					"nextDialogs": [
						400671210
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400671210,
					"content": "Thuật sĩ chiêm tinh là người hiểu biết sâu rộng. Nếu cô thừa nhận điều này thì ảo cảnh này cũng không tồn tại một cách vô ích rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671211
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400671211,
					"content": "Này, ngươi... cảm thấy thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671212
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400671212,
					"content": "Ý tiểu thư là muốn hỏi thăm Kazuha, mong tâm trạng của anh không xuống dốc quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671213
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400671213,
					"content": "Khó mà vui được khi nhớ lại một trải nghiệm như thế này nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671214,
					"content": "Haha, đúng vậy. Cảm ơn mọi người đã quan tâm. May mà những điều này đã là quá khứ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671215
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400671215,
					"content": "Lần đầu tiên tôi nhìn thấy chậu bonsai, tôi đã nghĩ đến khả năng này... Tôi đang đợi mọi người, có lẽ đây cũng là lý do tôi bị bỏ lại ở điểm cuối.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400671207,
					"content": "Dù không hoàn hảo, nhưng cũng không hổ thẹn với nó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400671208
					]
				},
