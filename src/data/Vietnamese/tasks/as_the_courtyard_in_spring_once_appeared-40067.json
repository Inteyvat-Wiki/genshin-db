			},
			"dialogs": [
				{
					"id": 400670201,
					"content": "...Không ngờ lại gặp phải chuyện đáng kinh ngạc như thế này ở một nơi có phong cảnh tuyệt vời như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670202
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670202,
					"content": "Cảm thấy thế nào?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400670203
					]
				},
				{
					"id": 400670203,
					"content": "Khá ổn. Sẽ tốt hơn nếu bạn có thể giúp tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670204
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670204,
					"content": "Vậy chính xác thì chúng ta cần làm gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400670205,
					"content": "Ừm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670206
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670206,
					"content": "À... À hình như không có gì cả?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670207
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670207,
					"content": "Cô, cô đang xem thường chúng tôi sao?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400670208,
					"content": "Không, tôi chỉ nhận ra rằng, tuy bạn không nói nhiều, nhưng bạn đã luôn làm rất nhiều chuyện cho mọi người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670209
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670209,
					"content": "Những người như bạn là kiểu đồng đội mà mọi người cần nhất. Chỉ cần có mặt bạn ở đây thì mọi người đều an tâm hơn rất nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670210
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670210,
					"content": "Mặc dù tự ý kỳ vọng như vậy sẽ gây áp lực cho bạn, nhưng tôi nghĩ... nhà chiêm tinh cần phải tinh ý, phát hiện ra ưu điểm của người khác cũng là một kiểu quan sát.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670211
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670211,
					"content": "Cho nên cô đang cố gắng khen ngợi chúng tôi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400670212,
					"content": "Tôi chỉ nói thật thôi, không phải tìm cách khen bạn đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670213
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670213,
					"content": "Hóa ra là thế, Mona không chịu thừa nhận...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400670214
					]
				},
				{
					"id": 400670214,
					"content": "Không chịu thừa nhận rằng cô ấy đang khen người khác!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400670215,
					"content": "Này, đang cười gì thế, đã bảo là đánh giá khách quan chứ không phải là khen mà! Không phải khen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670216
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670216,
					"content": "#Ngày tháng sau này, tôi sẽ tiếp tục quan sát tinh tượng. Hãy giữ liên lạc nhé, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
