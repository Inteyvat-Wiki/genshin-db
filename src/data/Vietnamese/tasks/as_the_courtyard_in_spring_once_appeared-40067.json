			"dialogs": [
				{
					"id": 400670601,
					"content": "Chắc chuyện mà Kazuha muốn làm đã hoàn thành rồi nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400670602,
					"content": "Ừm, nói như vậy cũng đúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670603
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400670603,
					"content": "Mọi người đã nhìn thấy tôi của quá khứ, đã chào tạm biệt tôi khi đó. Nhưng phải chờ tới khi mọi người tận mắt nhìn thấy mọi thứ thuộc về tôi thì chúng mới thực sự trở thành quá khứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670604
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400670604,
					"content": "Cái quan trọng nhất trong cuộc đời con người chính là những mối ràng buộc với người khác, chứ không phải tự trách móc bản thân. Người dừng chân trong quá khứ thì sẽ mãi không thấy được tương lai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670605
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400670605,
					"content": "Vì thế mong mọi người hãy tin rằng, tôi đã đến và sẽ tiếp tục bước đi. Sau này, xin các vị hãy chiếu cố cho tôi nhiều hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				}
			]
		},
