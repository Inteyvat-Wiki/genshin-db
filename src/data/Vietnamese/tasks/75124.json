			"dialogs": [
				{
					"id": 751240301,
					"content": "Aha, thời cơ vừa chuẩn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240302
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240302,
					"content": "Hình ảnh mà tôi bận rộn lâu như vậy vẫn chưa hoàn thành, nhờ hai vị giúp đỡ mà mới đó đã xong rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240303
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240303,
					"content": "Chim Nước Xanh, cơ thể lắc lư trong phao bơi... Thật là khiến người ta cảm động rớt nước mắt mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240304
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240304,
					"content": "Thật sự cảm động đến thế à...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240305
					]
				},
				{
					"id": 751240305,
					"content": "Những thứ mà người khác không thể hiểu được, thậm chí còn cảm thấy hoang đường, lại là thứ mà tôi theo đuổi cả cuộc đời này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240306
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240306,
					"content": "Nhưng tôi tin là nếu tôi có thể chụp được thêm nhiều bức ảnh đáng yêu về Chim Nước Xanh, thì số lượng người thích chúng sẽ ngày càng đông đảo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240307
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240307,
					"content": "Tôi cũng rất tin tưởng vào tương lai này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751240308,
					"content": "Cảm ơn hai vị đã giúp. Những thứ này coi như là quà cảm ơn nhé, hãy nhận lấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jonvelle"
				}
			]
		},
