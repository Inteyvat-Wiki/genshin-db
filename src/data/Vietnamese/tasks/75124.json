			},
			"dialogs": [
				{
					"id": 751240101,
					"content": "Haiz, lại chạy rồi. Để xem nào, chỉ còn lại một con trong phao... Phải làm thế nào đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240102
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240102,
					"content": "Phải mất bao lâu nữa đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240103
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240103,
					"content": "Ồ, không ngờ lại có người chụp ảnh ở đây... Là đang chụp Chim Nước Xanh sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751240104,
					"content": "Chim Nước Xanh đúng là rất đáng yêu mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240105,
						751240107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751240105,
					"content": "Ừm, cơ thể nó cứ lắc lư...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240106
					]
				},
				{
					"id": 751240106,
					"content": "Đúng thế, rất đáng yêu. Hơn nữa, khi nó phồng lên thì biến thành quả bóng nổi trên mặt nước. Đúng là khiến người ta nhìn thôi cũng thấy vui mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751240109,
					"content": "Tiểu thư có mái tóc màu bạc lấp lánh này nói đúng lắm! Đấng sáng tạo tạo ra sinh vật Chim Nước Xanh này xứng đáng nhận được mọi lời tán dương trên thế gian...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240110
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240110,
					"content": "À, xin lỗi, tôi vẫn chưa tự giới thiệu. Tôi là người đam mê chụp ảnh Chim Nước Xanh, cứ gọi tôi Jonvelle là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240111
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240111,
					"content": "#Ừm, tôi là Paimon, còn đây là {NICKNAME}... Nhưng ở đây có nhiều Chim Nước Xanh như vậy, sao anh còn than thở thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751240112,
					"content": "Dài dòng lắm... Nhưng hãy để tôi nói ngắn gọn nhé. Có rất nhiều người đam mê chụp ảnh Chim Nước Xanh, mọi người đều muốn chụp được những bức ảnh thú vị hơn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240113
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240113,
					"content": "Mấy hôm trước, tôi đã nảy ra một ý tưởng thiên tài... Đó là đưa tất cả Chim Nước Xanh trong ống kính vào trong phao bơi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240114,
						751240117
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240114,
					"content": "Như vậy có ý nghĩa gì không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240115
					]
				},
				{
					"id": 751240115,
					"content": "Tất nhiên, ý nghĩa nằm ở việc nó chẳng có nghĩa gì cả. Rõ ràng là Chim Nước Xanh có thể nổi trên mặt nước, nhưng vẫn đeo phao bơi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240116
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240116,
					"content": "Cũng giống như tiêu Mora để kiếm Mora vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240120
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240120,
					"content": "Chim Nước Xanh gánh vác nhiều ý nghĩa quá rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751240121,
					"content": "Đây gọi là chụp ảnh siêu thực, phải tìm ra ý nghĩa sâu xa hơn từ trong ảnh... À, nhưng bây giờ tôi gặp phải rắc rối rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240122
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240122,
					"content": "Chim Nước Xanh trong thực tế quả nhiên sẽ không đeo phao bơi... Cho nên cơ bản là không thể chụp được tấm ảnh đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240123
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240123,
					"content": "Dù sao cũng là chụp ảnh \"siêu thực\" mà...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240124
					]
				},
				{
					"id": 751240124,
					"content": "#Nhưng mà chỉ cần đặt tất cả phao bơi vào Chim Nước Xanh là được đúng không? {NICKNAME} cũng là người yêu thích Chim Nước Xanh, chúng ta tới giúp đỡ đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240125,
						751240127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751240125,
					"content": "Tuyệt! Người yêu thích Chim Nước Xanh thì nên giúp đỡ lẫn nhau!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240126
					]
				},
				{
					"id": 751240126,
					"content": "Đúng thế!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751240129,
					"content": "Thật không? Hai vị đồng ý giúp sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240130
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240130,
					"content": "Hihi, chỉ cần khi xong việc cho chúng tôi vài tấm ảnh đẹp là được rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751240131,
					"content": "Vậy, vậy thì nhờ hai vị nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240127,
					"content": "Tuy là tôi vẫn thích Sóc Bay hơn...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240128
					]
				},
				{
					"id": 751240128,
					"content": "Đừng nói những lời mất hứng như thế ở đây chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751240117,
					"content": "Người bình thường đúng là sẽ không nghĩ đến...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240118
					]
				},
				{
					"id": 751240118,
					"content": "Rõ ràng là Chim Nước Xanh có thể nổi trên mặt nước, nhưng vẫn đeo phao bơi. Như vậy sẽ tạo ra nhiều lớp ý nghĩa trong một bức ảnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240119
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240119,
					"content": "Thật ra đây là để thể hiện chủ đề về việc \"sử dụng quá mức\" và \"lãng phí\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240120
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240107,
					"content": "Thật ra tôi thích Sóc Bay hơn...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240108
					]
				},
				{
					"id": 751240108,
					"content": "#Sóc Bay tất nhiên là cũng rất đáng yêu rồi. Nhưng mà, {NICKNAME} nỡ nói như thế trước mặt những chú Chim Nước Xanh đang bơi này sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240109
					],
					"speakerTitle": "Paimon"
				}
			]
		},
