			"dialogs": [
				{
					"id": 705310101,
					"content": "Tiền bối, chờ một chút! Tiền bối cũng đến tham gia \"Giải Đấu Vua Triệu Hồi\" sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310102
					],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310102,
					"content": "Nếu tiền bối rảnh, tôi muốn giới thiệu cho tiền bối về sự kiện Tuần Du Thắng Cảnh do Hiệp Hội Nhà Mạo Hiểm chúng tôi tổ chức.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310103,
						705310104
					],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310103,
					"content": "Tôi cũng rảnh...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705310105
					]
				},
				{
					"id": 705310105,
					"content": "Cảm ơn tiền bối! Tôi xin giới thiệu sơ lược với tiền bối về Tuần Du Thắng Cảnh lần này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310106
					],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310106,
					"content": "Nói một cách đơn giản, Hiệp Hội Nhà Mạo Hiểm chúng tôi đã bố trí rất nhiều Đài Tuần Cảnh ở Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310107
					],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310107,
					"content": "Việc tiền bối phải làm là tìm những Đài Tuần Cảnh đó, và dùng ấn chương trên Đài Tuần Cảnh để đóng dấu kỷ niệm lên Sổ Tay Tuần Cảnh mà chúng tôi phát cho tiền bối.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310108
					],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310108,
					"content": "Chỉ cần tìm được Đài Tuần Cảnh, và thu thập đủ tất cả ấn chương... là xem như hoàn thành khiêu chiến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310109
					],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310109,
					"content": "Sự kiện này... đúng là mang phong cách của Hiệp Hội Nhà Mạo Hiểm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705310110
					]
				},
				{
					"id": 705310110,
					"content": "Hihi... Vị trí đặt Đài Tuần Cảnh là do chúng tôi thiết kế riêng cho sự kiện này đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310111
					],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310111,
					"content": "Mặc dù... có một số vị trí của Đài Tuần Cảnh có hơi xa, nói không chừng còn có ma vật xuất hiện nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310112
					],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310112,
					"content": "Nhưng tôi thấy với thân thủ của tiền bối thì đối phó với lũ ma vật đó chắc cũng nhẹ nhàng thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310113
					],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310113,
					"content": "Vậy để tôi đưa Sổ Tay Tuần Cảnh cho tiền bối, chúc tiền bối trải nghiệm vui vẻ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310104,
					"content": "Cô nói thử xem...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705310105
					]
				}
			]
		}
	]
