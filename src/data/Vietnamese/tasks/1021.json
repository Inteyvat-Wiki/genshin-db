			"dialogs": [
				{
					"id": 10211101,
					"content": "Xin chào, Meng Dan nói với tôi là có thể đến của cửa hàng nhận một chiếc hộp sang trọng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211102,
					"content": "Lão Meng đã nói với tôi rồi, thật cảm ơn sự giúp đỡ của hai vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211103
					],
					"speakerTitle": "Xingxi"
				},
				{
					"id": 10211103,
					"content": "Những món hàng tốt nhất tại cửa hàng của tôi, phần lớn là do Lão Meng tìm được. Nếu như anh ấy gặp chuyện thì việc làm ăn của tôi coi như xong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211104
					],
					"speakerTitle": "Xingxi"
				},
				{
					"id": 10211104,
					"content": "Hộp đựng quà này vốn là một món đồ cổ có ít nhất 140 năm lịch sử rồi. Nó đã được cọ rửa cẩn thận. Bạn có thích không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211105
					],
					"speakerTitle": "Xingxi"
				},
				{
					"id": 10211105,
					"content": "Uhm, cảm thấy rất thích!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211106,
					"content": "Đúng rồi, tôi có thể mượn một cái giống như vậy không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211107,
					"content": "Đương nhiên rồi. Ở trên giá ấy, bạn cứ tùy ý lấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211108
					],
					"speakerTitle": "Xingxi"
				},
				{
					"id": 10211108,
					"content": "Nhà Lữ Hành, món đồ gốm này trông rất tuyệt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211109,
					"content": "Dùng đồ cổ để trộn thì món điểm tâm nhất định ngon lắm đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211110,
					"content": "Làm xong rồi! Slime Phủ Đường độc nhất vô nhị! Đặt cẩn thận vào hộp quà, rồi dùng bột đường trang trí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211111,
					"content": "Đây là hoa vừa mới hái, để thêm hai bông hoa vào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211112
					],
					"speakerTitle": "Xingxi"
				},
				{
					"id": 10211112,
					"content": "Thật là đẹp quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211113,
					"content": "(Không hiểu sao, có gì đó không yên tâm lắm...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10211114
					]
				},
				{
					"id": 10211114,
					"content": "Chà, tất cả vinh hoa phú quý của chúng ta đều nằm trong chiếc hộp này. Bây giờ hãy đến \"Quần Ngọc Các\" để tìm Ningguang thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 102112,
			"completionStepIds": [
				102112
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"102112",
							"2"
						],
						"stepId": 102112,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 10211201,
					"content": "Huh? Nhìn kỹ lại thì quá ổn rồi. Tờ giấy ghi chép to nhất được ghim ở vị trí dễ thấy nhất. Được rồi, chọn tờ giấy này đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211202,
					"content": "Là lá la... Tới xem thử trên này viết gì trước đã...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211203,
					"content": "Hửm? Chỗ này có điểm khoanh lại, lẽ nào là kho báu! Hay là cơ hội phát tài nào đó? Để tôi xem xem, mấy chữ cạnh mép này viết gì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211204,
					"content": "\"Bách Vô\"... \"Cấm Kỵ Lục\"... Cái gì cơ... \"Fatui\"... \"Nghiên cứu\"... Hừm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211205,
					"content": "Hình như... không phải rương báu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211206,
					"content": "Trên tờ giấy này viết, là nghiên cứu bí mật về <color=#00E1FFFF>Bách Vô Cấm Kỵ Lục</color> của Fatui, bị tai mắt của Thất tinh phát hiện tung tích.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211207,
					"content": "Ồ... Vừa nãy Ningguang nói, Fatui đã gây nhiều chuyện xấu xa ở Liyue, ví dụ như phát tán tin đồn, dòm ngó Tiên thế v...v...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211208,
					"content": "Nhưng nghiên cứu Bách Vô Cấm Kỵ Lục là chuyện xấu xa như thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211209,
					"content": "#{NICKNAME}, kể ra thì Bách Vô Cấm Kỵ Lục cũng có chút quan hệ với bạn, có cần đi điều tra một chút không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211210,
						10211211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211210,
					"content": "Sự việc tiến triển... có chút cố ý.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10211212
					]
				},
				{
					"id": 10211212,
					"content": "Í? Là vậy ư?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211213,
					"content": "Vậy... vậy chúng ta không đi nữa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211214,
					"content": "Không, tôi chỉ nghĩ vậy thôi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10211215
					]
				},
				{
					"id": 10211215,
					"content": "Ồ, thì ra ý bạn là, nếu không thể hoàn toàn tin tưởng Ningguang, thì càng phải đích thân đi kiểm chứng lời Ningguang nói.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211216,
					"content": "Ừm... Có chút vượt quá phạm vi hiểu biết của tôi. Tôi cảm thấy cô ấy rất thân thiết với chúng ta, là người tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211217,
					"content": "Kệ đi, cứ theo bạn nói, hành động trước đã!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211218,
					"content": "Trước khi đi Địch Hoa Châu tìm Zhongli, chúng ta hãy đến nơi trong tư liệu này xem thử, Fatui có phải thực sự đang làm một số chuyện mờ ám?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211211,
					"content": "Rõ ràng Ningguang muốn dẫn chúng ta tới đó...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10211212
					]
				}
			]
		},
		{
			"id": 102113,
			"completionStepIds": [
				102113
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"102113",
							"2"
						],
						"stepId": 102113,
						"stateName": "QUEST_STATE_UNFINISHED"
