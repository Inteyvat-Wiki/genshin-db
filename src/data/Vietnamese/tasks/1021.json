			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ningguang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10211301,
					"content": "Bạn có lẽ nghe qua về cuộc chiến ma thần rồi phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211302,
						10211303
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10211302,
					"content": "Không rõ lắm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10211304
					]
				},
				{
					"id": 10211304,
					"content": "Có rất nhiều ma thần trên thế giới, và cũng đã có những cuộc chiến kéo dài không hồi kết cho đến tận hai nghìn năm trước. Trong thời kỳ ấy, các sinh vật lầm than và máu chảy không ngừng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211305
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10211305,
					"content": "Cuối cùng, đại lục Teyvat chỉ còn lại bảy người chiến thắng. Họ thành lập các vương quốc và thành bang trên đống đổ nát của kẻ bại trận, và bắt đầu thời đại của bảy vị thần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211306
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10211306,
					"content": "Bạn đã đến \"Cô Vân Các\" chưa? Đó không phải là địa hình tự nhiên mà được tạo nên từ ngọn giáo đá khổng lồ do Đế Quân ném xuống trong chiến tranh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211307
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10211307,
					"content": "Dùng ngọn giáo đá, Đế Quân trấn áp tất cả những kẻ bại trận năm xưa: Họ là những ma thần không giành được vị trí của bảy vị thần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211308
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10211308,
					"content": "Không chỉ các ma thần sẽ chết, mà \"bảy vị chấp chính trần thế\" cũng thay đổi trong hai hai nghìn năm qua. Sự ra đi của Đế Quân là một thảm kịch khó tưởng đối với Liyue, nhưng trật tự bảy vị thần cai trị Teyvat sẽ không sụp đổ chỉ vì điều đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211309
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10211309,
					"content": "Nham Thần tiếp theo sớm muộn cũng sẽ xuất hiện, nhưng tôi làm sao có thể quên được Đế Quân? Khi đó, mối quan hệ giữa người Liyue và tiên nhân chắc chắn sẽ khác xưa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211310
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10211310,
					"content": "Ngay cả trong thời đại mới, Thất Tinh vẫn là con dân của Đế Quân. Tội danh ám sát Đế Quân... Bạn cho rằng chúng tôi có thể làm được điều đó sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211311
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10211311,
					"content": "Tại sao, mọi người lại phải giấu Tiên Tổ Pháp Thoái?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10211312
					]
				},
				{
					"id": 10211312,
					"content": "Haha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211313
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10211313,
					"content": "Sự việc ngày hôm đó tại Ngọc Kinh Đài xảy ra quá đột ngột mà tôi không có sự chuẩn bị. Bạn có mặt ở hiện trường, chắc cũng thấy tất cả rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211314
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10211314,
					"content": "Kẻ thù của Thất Tinh đang ẩn nấp ở cảng Liyue. Nếu không hành động ngay, sẽ bị đánh bại hoàn toàn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211315
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10211315,
					"content": "Còn việc giấu đi Tiên Tổ Pháp Thoái là cách làm duy nhất, chỉ có như vậy tôi mới có thể chuyển từ nơi sáng vào chỗ tối, lấy tĩnh khắc động.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211316
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10211316,
					"content": "“Kẻ thù” mà bạn đang nói đến là ai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211317,
					"content": "Nhà Lữ Hành, bạn nghĩ đó là ai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211318,
						10211319
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10211318,
					"content": "Chẳng lẽ là anh ta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10211320
					]
				},
				{
					"id": 10211320,
					"content": "Hử? Bạn và Ningguang đang nói chuyện bí mật gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211321,
					"content": "Đáp án chính xác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211322
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10211322,
					"content": "Hử???",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211323,
					"content": "Tuy rằng phong cảnh bên ngoài rất đẹp, nhưng gió có chút lớn. Bên trong đã chuẩn bị sẵn sàng tiếp đón khách, mời hai vị theo tôi vào trong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10211319,
					"content": "Chính là hắn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10211320
					]
				},
				{
					"id": 10211303,
					"content": "Có chút ấn tượng với điều này.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10211304
					]
				}
			]
		},
