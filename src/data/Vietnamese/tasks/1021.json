			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Meng Dan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10210801,
					"content": "Cám ơn các hạ ra tay giúp đỡ, nếu không tôi đã chết trong tù rồi! Đám Đạo Bảo Đoàn nếu tâm trạng tốt sẽ cắt tỉa những chậu Hoa Ngọt, còn tâm trạng không tốt lại đến hành hạ tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210802
					],
					"speakerTitle": "Meng Dan"
				},
				{
					"id": 10210802,
					"content": "Chỉ là chuyện nhỏ, chuyện nhỏ mà thôi! Không nhất thiết phải cảm ơn chúng tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210803,
					"content": "Haha... Tôi hiểu mà, quà cảm ơn đã chuẩn bị xong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210804
					],
					"speakerTitle": "Meng Dan"
				},
				{
					"id": 10210804,
					"content": "Thật là không cần mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210805
					]
				},
				{
					"id": 10210805,
					"content": "Đừng nói như vậy! Nhờ có bạn tôi mới thoát được kiếp nạn này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210806
					],
					"speakerTitle": "Meng Dan"
				},
				{
					"id": 10210806,
					"content": "Tôi là người cung cấp hàng cho Minh Tinh Trai trong thành Liyue, Meng Dan thường xuyên vào trong núi, tìm kiếm những món đồ cổ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210807
					],
					"speakerTitle": "Meng Dan"
				},
				{
					"id": 10210807,
					"content": "Không ngờ rằng, đám Đạo Bảo Đoàn cũng đang dòm ngó một di tích, chỉ vì bất cẩn... Nên bị bắt giam mất rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210808
					],
					"speakerTitle": "Meng Dan"
				},
				{
					"id": 10210808,
					"content": "Bạn còn thiếu thứ gì không, ân nhân? Đồ cổ, những thứ quý giá, hay đồ trang trí bắt mắt... Chỉ cần những thứ tôi có đều sẽ đáp ứng được cho bạn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210809
					],
					"speakerTitle": "Meng Dan"
				},
				{
					"id": 10210809,
					"content": "Ý tốt của bạn tôi xin nhận.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210810
					]
				},
				{
					"id": 10210810,
					"content": "Đợi một lát, chúng tôi đang tìm một thứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210811,
					"content": "Ồ? Thứ gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210812
					],
					"speakerTitle": "Meng Dan"
				},
				{
					"id": 10210812,
					"content": "Bạn có hộp đựng quà không? Phải đẹp một chút... Hmmm, thứ mà đặt được những món điểm tâm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210813,
					"content": "Đương nhiêu là có rồi, làm đồ cổ sao lại không chuẩn bị hộp đựng cơ chứ? <color=#00E1FFFF>Minh Tinh Trai</color> có sẵn những hộp đựng quà nổi tiếng bậc nhất ở bảy quốc gia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210814
					],
					"speakerTitle": "Meng Dan"
				},
				{
					"id": 10210814,
					"content": "Bạn đợi một lát, tôi đi nói chuyện với bà chủ. Khi nào cần, bạn cứ đến cửa hàng tìm cô ấy là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210815
					],
					"speakerTitle": "Meng Dan"
				},
				{
					"id": 10210815,
					"content": "Vậy thì tốt quá, Slime Phủ Đường của chúng ta có hộp đựng quà sang trọng rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
