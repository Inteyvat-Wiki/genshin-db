			"dialogs": [
				{
					"id": 10210601,
					"content": "Woa! Phòng khách lớn quá! Tôi chưa từng thấy căn phòng nào lộng lẫy như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210602,
					"content": "Hai vị cứ tự nhiên, xem nơi này là nhà nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210603
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210603,
					"content": "Có thật là được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210604,
					"content": "Tôi mời các bạn đến, tất nhiên là coi mọi người là bạn. Bạn bè đến chơi tất nhiên vui vẻ phải đặt lên hàng đầu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210605
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210605,
					"content": "Nơi đó là...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210606
					]
				},
				{
					"id": 10210606,
					"content": "Ơ? Đây chính là \"bức tường trong truyền thuyết\" sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210607,
					"content": "Ồ? Tin tức của bạn có chắc chắn không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210608
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210608,
					"content": "Đến những người kể chuyện cũng nhắc đến... Việc rất nhiều người muốn mua tờ giấy trên bức tường nổi tiếng này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210609,
					"content": "Bởi vì bức tường đó ghi chép lại những bí mật của Liyue. Đám thương nhân luôn thích thú với những điều bí mật mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210610
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210610,
					"content": "Nhà Lữ Hành, những bí mật thương mại ở Liyue không có ý nghĩa gì với bạn, bạn rất đặc biệt, bạn cũng biết điều này phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210611
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210611,
					"content": "Nếu có thể, tôi muốn nhận được sự tin tưởng của bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210612
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210612,
					"content": "Nhưng nếu buộc phải lựa chọn người đáng tin cậy nhất giữa tôi và Keqing thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210613,
						10210614
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210613,
					"content": "Ningguang là người tôn kính thần linh, còn Keqing thì không...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210615
					]
				},
				{
					"id": 10210615,
					"content": "...Haha bạn chọn Keqing ư? Trực giác cũng mách bảo tôi như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210616
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210616,
					"content": "Tôi luôn nghĩ rằng, cứng quá dễ gãy. Người như cô ấy trở thành Thất Tinh, thì vẫn cần tôi đứng sau hỗ trợ vài việc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210617
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210617,
					"content": "Nhưng cô ấy nói câu \"Thời đại của Tiên nhân đã qua, nếu đến cả Thất Tinh của Liyue cũng không dám đối mặt với điều này, vậy tương lai của Liyue sẽ ra sao?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210618
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210618,
					"content": "Khiến tôi có chút lo ngại trong lòng tôi đã được xua tan đi rất nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210619
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210619,
					"content": "Không sai, tôi không phủ nhận việc Đế Quân băng hà rất có lợi cho Thất Tinh. Nhưng vì Liyue, tôi không thể bị những lời đồn \"Thất Tinh soán ngôi\" ảnh hưởng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210620
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210620,
					"content": "Những lời dèm phá ấy một phần đến từ lũ Fatui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210621
					]
				},
				{
					"id": 10210621,
					"content": "Hừm... Xem ra chỉ mới bắt đầu thôi mà bạn đã hiểu rõ tôi muốn nói gì rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210622
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210622,
					"content": "Tôi ra lệnh phong tỏa tin tức, cất giấu tiên thể, một là để ổn định tình hình, hai là để tránh... Những chuyện từng xảy ra đối với Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210623
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210623,
					"content": "Đám người Fatui dựa cớ Đế Quân băng hà thực hiện rất nhiều hành động mờ ám vượt quá giới hạn ngoại giao của hai nước. Bản thân tôi là \"Thiên Quyền\" phụ trách Liyue, đến lúc phải chiến đấu cũng không cần câu nệ quá nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210624
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210624,
					"content": "Đồng ý làm \"Điển Lễ Tiễn Tiên\" cũng là để Thất Tinh tiếp quản toàn bộ Liyue, tranh thủ chút thời gian...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210625
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210625,
					"content": "Giống như lời Zhongli, Thất Tinh cung cấp được nơi tiến hành tế lễ cũng chỉ để lợi dụng chúng tôi hoàn thành mục đích của mình mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210626
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210626,
					"content": "Nói đến việc \"hoàn thành mục đích\"... Vẫn còn một chuyện nữa, tôi có nên nói không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210627
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210627,
					"content": "Cứ việc nói.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210628
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210628,
					"content": "Nghe nói khách mang tặng quà gặp mặt sẽ nhận được một vài lợi lộc... Vậy chúng tôi có phần không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210629
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210629,
					"content": "Paimon, bạn không thể nói những vấn đề khác sao!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210630
					]
				},
				{
					"id": 10210630,
					"content": "Haha... Không sao, tôi rất thích những người thẳng thắn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210631
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210631,
					"content": "Thời gian gần đây cũng phiền các bạn nhiều rồi. Như vậy đi, coi như là quà cảm ơn, bạn có thể chọn một món yêu thích bất kỳ từ chỗ tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210632
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210632,
					"content": "Tốt quá! Chỉ đợi câu nói này thôi. Tôi đã nghĩ xong rồi! Tôi muốn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210633
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210633,
					"content": "<color=#00E1FFFF>Tờ giấy</color> trên bức tường kia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210634
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210634,
					"content": "???",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210635
					]
				},
				{
					"id": 10210635,
					"content": "Đừng có nhìn tôi bằng ánh mắt như vậy chứ! Bạn không hiểu sao? Là tờ giấy trên tường ấy, cho dù chỉ lấy được một góc bé bằng đầu ngón tay, cũng có thể bán được giá rất hời rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210636
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210636,
					"content": "Còn nếu là... Một tờ giấy nguyên vẹn, chưa bị xé rách thì...! Tôi không dám tưởng tượng giá trị của nó bao nhiêu Mora nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210614,
					"content": "Sự \"bất kính\" của Keqing còn đáng tin tưởng hơn...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210615
					]
				}
			]
		},
		{
			"id": 102108,
			"completionStepIds": [
				102108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
