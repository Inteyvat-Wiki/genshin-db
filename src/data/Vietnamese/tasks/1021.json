			"dialogs": [
				{
					"id": 10210201,
					"content": "Hừm? Trong không khí có mùi thơm ngọt rất nồng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210202,
					"content": "Hơn nữa... bạn có nghe thấy tiếng gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210203,
						10210205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210203,
					"content": "Hình như có người kêu cứu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210204
					]
				},
				{
					"id": 10210204,
					"content": "Nghe có vẻ là tiếng phát ra từ trong Di Tích...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210207,
					"content": "...A, là Đạo Bảo Đoàn nhốt người lại ư?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210205,
					"content": "Hình như có người đang hát.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210206
					]
				},
				{
					"id": 10210206,
					"content": "Không phải, là tiếng kêu cứu! Phát ra từ trong Di Tích...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210207
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 102103,
			"completionStepIds": [
				102103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
