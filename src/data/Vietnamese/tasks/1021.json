			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bu'yun"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10210301,
					"content": "(Theo lời dạy của Keqing, bây giờ nên nói như thế này...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210302,
					"content": "Xin chào, ở đây có bán mặt trăng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210303,
					"content": "Đúng vậy, cần mấy chiếc?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210304
					],
					"speakerTitle": "Bu'yun"
				},
				{
					"id": 10210304,
					"content": "Số lượng không tiện tiết lộ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210305,
					"content": "Đáp hay lắm, hai vị lên Các theo lối này. Phải rồi, hai vị chính là khách hẹn gặp Ningguang đại nhân hôm nay nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210306
					],
					"speakerTitle": "Bu'yun"
				},
				{
					"id": 10210306,
					"content": "Không sai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210307,
					"content": "(Nhưng đây không phải ám hiệu của \"Khách\", mà là ám hiệu của \"Ngọc Hành\". Chuyện này là thế nào...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bu'yun"
				}
			]
		},
		{
			"id": 102104,
			"completionStepIds": [
				102104
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
