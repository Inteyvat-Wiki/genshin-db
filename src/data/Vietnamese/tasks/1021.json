			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ningguang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10210401,
					"content": "Chờ đợi đã lâu, người trở về từ Tuyệt Vân Gián.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210402
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210402,
					"content": "A, là Ningguang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210403,
					"content": "Lần đầu gặp mặt, chúng tôi chuẩn bị một món quà, hy vọng bạn thích!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210404,
					"content": "Tặng tôi? Xin đa tạ. Mời hai vị tới đây, khiến hai vị mất công rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210405
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210405,
					"content": "Không mất công, không mất công, hi hi~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210406,
						10210408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210406,
					"content": "Quần Ngọc Các rất đẹp.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210407
					]
				},
				{
					"id": 10210407,
					"content": "Ha ha, rất vui vì bạn thích nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210409
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210409,
					"content": "Toà cung điện bồng bềnh giữa trời này cao hơn hết thảy mọi ngọn núi, từ đây có thể nhìn rõ mọi thứ của Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210410
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210410,
					"content": "Từ khi bắt đầu học làm ăn buôn bán, tôi đã tích luỹ vốn xây dựng. Sau khi trở thành Thiên Quyền, tôi mời thợ thủ công giỏi nhất tới, không ngừng mở rộng nó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210411
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210411,
					"content": "Ban đầu, nó chỉ rộng bằng một gian phòng, nay đã có thể che khuất cả mặt trăng soi sáng Liyue rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210412
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210412,
					"content": "Tôi tin một ngày nào đó... bóng của nó sẽ che phủ cả bảy đất nước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210413
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210413,
					"content": "(Vị Thiên Quyền đại nhân này, rất có dã tâm...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210414
					]
				},
				{
					"id": 10210414,
					"content": "Khách bên ngoài có tư cách lên Quần Ngọc Các không nhiều, nhưng Đội Trưởng Đại Diện của Đội Kỵ Sĩ Tây Phong thường thư từ qua lại, họ khen ngợi bạn rất nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210415
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210415,
					"content": "Vậy nên, từ ngày đầu tiên bạn đến Liyue, tôi đã bắt đầu rải tai mắt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210416
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210416,
					"content": "Sao cơ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210417,
					"content": "Cuối cùng khi các bạn đến Nhà Trọ Vọng Thư, tôi đã đại khái nắm được mục đích của các bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210418
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210418,
					"content": "Lẽ nào Verr Goldet, là người của bạn?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210419,
					"content": "Không phải.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210420
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210420,
					"content": "Cả toà Nhà Trọ Vọng Thư đều là người của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210421
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210421,
					"content": "##%^%*&...!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210422,
					"content": "Không lâu trước kia, còn gặp cả Ngọc Hành Tinh...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210423
					]
				},
				{
					"id": 10210423,
					"content": "Gặp ở gần máy Guizhong, đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210424
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210424,
					"content": "Chắc không phải bạn luôn nhìn trộm từ trên trời đó chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210425
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210425,
					"content": "Ha ha... khoảng cách xa như vậy, nhìn trộm hơi khó đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210426
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210426,
					"content": "...Dựa vào \"tai mắt\" là được. Tôi rất có hứng thú với các bạn, theo dõi là đương nhiên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210427
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210427,
					"content": "Keqing nói, Thất Tinh sẽ không ám hại Đế Quân.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210428
					]
				},
				{
					"id": 10210428,
					"content": "Ừm, bạn qua lại khá nhiều với tiên nhân, không tín nhiệm chúng tôi cũng dễ hiểu. Lần này mời bạn đến là muốn gỡ bỏ hiểu lầm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210408,
					"content": "Lần đầu đến nơi cao thế này...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210409
					]
				}
			]
		},
