						730030502
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730030502,
					"content": "Chuyện khẩn cấp, chúng ta nói ngắn gọn thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030503
					],
					"speakerTitle": "Paimon"
				},
				{
