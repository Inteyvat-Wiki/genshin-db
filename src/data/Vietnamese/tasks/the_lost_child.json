						730030705,
						730030708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030705,
					"content": "Ararakalari?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030706
					]
				},
				{
					"id": 730030706,
					"content": "Ừ đúng đúng! Chính là nó! Hình như nói là nó có thể kháng cự được sự ăn mòn của Marana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030707,
					"content": "Ừm. Nara thông minh. Ararakalari đó có thể kháng cự được Marana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030711
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030711,
					"content": "Ôi!",
					"roleType": "TALK_ROLE_NPC",
