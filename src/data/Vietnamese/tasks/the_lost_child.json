					"nextDialogs": [
						730030749
					]
				},
				{
					"id": 730030749,
					"content": "#Nara {NICKNAME}, thật hài hước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030750
					],
					"speakerTitle": "Arana"
				},
				{
