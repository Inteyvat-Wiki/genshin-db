					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030726
					]
				},
				{
					"id": 730030726,
					"content": "Hả? Đang nói về Aranara ư? Nhìn thì đúng là lúc trước chúng ta đã gặp...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030715,
					"content": "Rau củ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030716
					]
				},
				{
					"id": 730030708,
					"content": "Cái gì cơ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030709
					]
				},
				{
					"id": 730030709,
					"content": "Hình như là thứ có thể kháng cự được sự ăn mòn của Marana gì đó... một thứ có tên rất kì lạ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030710,
					"content": "Là Ararakalari, có thể kháng cự được Marana, tên không lạ lắm.",
