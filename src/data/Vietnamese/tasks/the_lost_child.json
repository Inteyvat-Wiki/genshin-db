					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030506
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030506,
					"content": "#Không sao, em không sao là tốt rồi... {NICKNAME}, bạn chờ tôi một chút. Tôi chuẩn bị ít thuốc, sau đó đi cùng bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030507
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730030507,
					"content": "Không còn thời gian nữa. Vị trí ở đây, anh tự đi đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030508
					]
				},
				{
					"id": 730030508,
					"content": "Đúng, chúng ta phải mau quay lại xem Rana mới được...",
