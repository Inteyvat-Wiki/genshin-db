					"content": "Iotham... sao lại như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030202
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030202,
					"content": "#Huhu, chị Rana... Có cả {M#anh}{F#chị} nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030203
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030203,
					"content": "Ủa? Sao Iotham lại ở... Tử Vực... Hơn nữa nhiều ma vật quá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030204,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030205,
						730030206
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030205,
					"content": "Ở đây cứ giao cho tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030207
					]
				},
				{
					"id": 730030207,
					"content": "Không được... không còn thời gian nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030208
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030208,
					"content": "#Tức quá, {NICKNAME}, nhờ bạn đó! Chúng ta cùng lên nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030209
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030209,
					"content": "Iotham, ngoan ngoãn đợi ở đó! Bọn chị tới cứu em!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030206,
					"content": "Thứ màu xanh kia là gì...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030207
					]
