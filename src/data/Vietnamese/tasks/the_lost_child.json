			"dialogs": [
				{
					"id": 730030301,
					"content": "Phù... phù... Cuối cùng cũng xong...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030302
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030302,
					"content": "Chị Rana... Huhu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030303
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030303,
					"content": "Iotham... Em là con trai, đừng có khóc. Em xem... chị có thể nói lại cho học giả của Giáo Viện... cảm giác trong Tử Vực... sau đó họ sẽ có thể giải quyết Tử Vực...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030304
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030304,
					"content": "#Hơn nữa... Em thấy không... lúc chị Rana chiến đấu, không... lúc {M#anh}{F#chị} {NICKNAME} chiến đấu ấy, em phải cảm ơn {M#anh ấy}{F#chị ấy}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030305
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030305,
					"content": "Rana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030306,
						730030308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030306,
					"content": "Đừng nói nữa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030307
					]
				},
				{
					"id": 730030307,
					"content": "Rana, bạn nghỉ ngơi một chút đi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030309,
					"content": "Phù... Phù phù... Không sao, tôi thấy hơi choáng váng, hơi mệt thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030310
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030310,
					"content": "Chị Rana... Em xin lỗi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030311
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030311,
					"content": "Nói... nói gì vậy, em chính là bé hổ nhỏ của chị mà, đừng khóc! Em không sao chứ? Iotham... Có thấy chỗ nào không khỏe không...? Có thấy đau đầu, mất sức...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030312
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030312,
					"content": "Em không sao, nhưng chị Rana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030313
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030313,
					"content": "Ừm! Không sao đâu... Chị Rana không sao cả. Dù sao chị cũng là Đội Trưởng Kiểm Lâm dày dặn kinh nghiệm mà! Chúng ta đi thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030308,
					"content": "Tôi đi tìm người tới giúp.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030309
					]
				}
			]
		},
