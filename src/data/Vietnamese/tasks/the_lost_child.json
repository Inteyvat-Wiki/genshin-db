					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030826
					]
				},
				{
					"id": 730030826,
					"content": "Cũng chính là... Tử Vực.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030827
					],
					"speakerTitle": "Rana"
