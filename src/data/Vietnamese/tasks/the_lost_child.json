					"nextDialogs": [
						730030723
					]
				},
				{
					"id": 730030723,
					"content": "Hình như lúc kể chuyện với Iotham từng nghe qua tên này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030724
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030724,
					"content": "Ừ. Nara Iotham là bạn của Arana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030725
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030725,
