					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730031006,
					"content": "Alphonso...? Bỏ đi. Dù sao thì các người cũng đừng hòng an toàn rời khỏi đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730031007
					],
					"speakerTitle": "Sĩ Quan Fatui"
				},
				{
					"id": 730031007,
					"content": "Thiệt tình, xem ra không thể nói chuyện đàng hoàng rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rana"
				},
				{
					"id": 730031004,
					"content": "Là Fatui. Cẩn thận.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
