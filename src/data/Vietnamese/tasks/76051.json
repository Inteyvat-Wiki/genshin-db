			"dialogs": [
				{
					"id": 760510101,
					"content": "#{NICKNAME}, Paimon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510102
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760510102,
					"content": "Sao thế? Columbina, trông cô như đang gặp rắc rối gì vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510103,
					"content": "Hai người có màu vẽ không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510104
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760510104,
					"content": "!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510105
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760510105,
					"content": "Ah! Nhóc là... là Maalaus đúng không!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510106,
					"content": "~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510107
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760510107,
					"content": "Lại muốn vẽ tranh sao? Sao cả người lại dính đầy màu vẽ thế này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510108,
					"content": "Nó đi ra ngoài một chuyến, khi về thì đã thành ra thế này. Những màu vẽ này cũng không thể rửa sạch ngay được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510109
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760510109,
					"content": "Chẳng lẽ lúc ra ngoài tìm cảm hứng đã gặp rắc rối gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510110,
					"content": "Nhưng mà nhìn cũng không tệ, rất có cảm giác nghệ thuật đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510111,
					"content": "??",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510112
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760510112,
					"content": "Hmm! Nói đến màu vẽ thì chỉ cần đưa cho nó thứ gì đó có màu sắc như lần trước là được rồi nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510113,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510114
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760510114,
					"content": "Hihi, nhìn nó vui như vậy, hẳn là đã tìm được cảm hứng gì đó hay ho rồi! Vẫn là kiểu rất vui vẻ nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510115,
					"content": "Vậy lần này chúng ta tìm vài màu sắc ấm áp và vui tươi cho Maalaus nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
