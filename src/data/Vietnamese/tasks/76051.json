			"dialogs": [
				{
					"id": 760510301,
					"content": "Vậy là được rồi nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510302,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510303
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760510303,
					"content": "Ồ! Nó bắt đầu vẽ rồi kìa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510304,
					"content": "E hèm, các vị giám khảo hãy cùng chờ xem, lần này họa sĩ Kuuhenki thiên tài Maalaus sẽ đem tới cho chúng ta những gì nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510305,
					"content": "!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510306
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760510306,
					"content": "Ơ! Vẽ xong rồi sao? Lời dẫn khuấy động sân khấu của tôi còn chưa nói xong nữa đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510307,
					"content": "Ồ! Quả nhiên vẫn là vẽ Columbina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510308,
						760510309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510308,
					"content": "Trông rất đẹp đấy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760510310
					]
				},
				{
					"id": 760510310,
					"content": "Đây là... ở trong rừng của Nod-Krai sao? Có nhiều động vật nhỏ quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510311,
					"content": "Đó có lẽ... là cảnh sắc chỉ có khi tôi chưa rời khỏi Dòng Dõi Sương Nguyệt nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510312
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760510312,
					"content": "Woa, thật ngưỡng mộ. Những động vật nhỏ đó thật sự sẽ tập trung lại như vậy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510313,
					"content": "Ừm, hầu hết bọn chúng đều thích Kuuvahki mà tôi tỏa ra, cảm thấy nằm cạnh tôi ngủ sẽ rất an tâm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510314
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760510314,
					"content": "Hả! Vậy chẳng phải là có thể tùy ý vuốt ve mà chúng cũng không chạy lung tung sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510315,
					"content": "Ừm... Thích nhất chắc là Lửng Áo Choàng đấy, đuôi của nó vừa to vừa bồng bềnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510316
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760510316,
					"content": "Lông trên cổ Hươu Sừng Lạnh cũng rất mềm, dùng làm gối ngủ rất thoải mái.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510317
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760510317,
					"content": "Hai người thích con nào hơn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510318
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760510318,
					"content": "Sao lại hỏi những chuyện chúng tôi chưa từng trải nghiệm qua chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510319,
					"content": "Nhưng mà nếu thử thì... chắc là tôi sẽ muốn sờ đuôi của Lửng Áo Choàng đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510320,
					"content": "Có những con Lửng Áo Choàng rất sợ người lạ. Nếu xung quanh không đủ an toàn thì chúng sẽ không cho người khác chạm vào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510321
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760510321,
					"content": "Ah... Nhưng mà Paimon phải cẩn thận đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510322
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760510322,
					"content": "Hả? Sao vậy? Chúng cắn người sao? Tôi... tôi sẽ không khiến chúng nổi giận đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510323,
					"content": "Không, cần phải cẩn thận trên trời ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510324
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760510324,
					"content": "Trên trời á?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510325,
					"content": "Ừm, Cò Lông Dài sẽ bắt động vật cỡ nhỏ. Trước đây, nhưng cũng là sau khi tôi nhắc nhở, chúng mới dần thay đổi thói quen bắt Kuuhenki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510326
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760510326,
					"content": "Nguy hiểm thế này thì phải nói ngay từ lần đầu gặp mặt chứ! Đến giờ này tôi còn chưa bị bắt đã là kỳ tích rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510327,
					"content": "Ừm... Được rồi, lần sau gặp Cò Lông Dài thì tôi sẽ nhắc chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510328
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760510328,
					"content": "Bây giờ đi nhắc nhở luôn đi! Nếu không tôi không dám bước ra khỏi chỗ này đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510329,
					"content": "Vậy tôi sẽ nói với Cò Lông Dài rằng Paimon là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510330,
						760510332,
						760510334
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760510330,
					"content": "Đồng đội tốt nhất.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760510331
					]
				},
				{
					"id": 760510331,
					"content": "Đúng đó! Không thể bắt đồng đội tốt đi được đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510336
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510336,
					"content": "!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510337
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760510337,
					"content": "Đứa nhỏ này... rất hứng thú với việc Paimon bị Cò Lông Dài bắt đi đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510338
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760510338,
					"content": "Đừng có mà lấy cảnh này làm tư liệu đấy nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510332,
					"content": "Người dẫn đường giỏi nhất.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760510333
					]
				},
				{
					"id": 760510333,
					"content": "#Ừm... {NICKNAME} còn nhớ là tôi vui rồi. Nhưng mà chắc Cò Lông Dài không biết người dẫn đường là gì đâu nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510336
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510334,
					"content": "Là thứ ăn vào sẽ bị đau bụng đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760510335
					]
				},
				{
					"id": 760510335,
					"content": "Đừng có lấy việc ăn làm tiền đề chứ! Lỡ như Cò Lông Dài thật sự muốn thử thì sao đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510336
					],
					"speakerTitle": "Paimon"
