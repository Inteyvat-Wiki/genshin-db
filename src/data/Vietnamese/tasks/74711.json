			"dialogs": [
				{
					"id": 747110101,
					"content": "Ừm, mong mọi chuyện sẽ thuận lợi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110102
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747110102,
					"content": "Giờ tôi có thể khẳng định, việc chữa trị cho bầy cá hung hăng đã bước vào giai đoạn cuối cùng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110103
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747110103,
					"content": "Ngoài việc tìm lại một số cá bệnh, tra soát kỹ lưỡng, còn có một nhiệm vụ đặc biệt nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110104
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747110104,
					"content": "Từ những vùng nước bị ảnh hưởng, tìm ra các cơ quan then chốt dưới nước, thu hồi dữ liệu mà thiết bị thăm dò của chúng đã ghi lại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110105,
						747110106
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747110105,
					"content": "Rồi từ đó tìm ra quy luật liên quan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747110107
					]
				},
				{
					"id": 747110107,
					"content": "Chính xác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110108
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747110108,
					"content": "Còn phải nhắc nhở chủ thuyền và thợ lặn, tổng kết lại bài học lần này nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747110109,
					"content": "Ừm, còn cả ngư dân và khách du lịch, những người đi thuyền trên mặt nước, những người lặn dưới nước...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110110
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747110110,
					"content": "Tất cả những người làm việc liên quan đến vùng nước đều cần phải chú ý, đừng vứt rác bừa bãi khiến môi trường nước trở nên hỗn loạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110111
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747110111,
					"content": "Nếu không, có thể sẽ có những chú cá hung hăng lật úp cả thuyền luôn đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747110106,
					"content": "Để ngăn ngừa những sự cố tương tự trong tương lai à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747110107
					]
				}
			]
		}
	]
