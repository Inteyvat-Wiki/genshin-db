			"dialogs": [
				{
					"id": 190030601,
					"content": "Ơ? Xin chào, còn chuyện gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030602
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030602,
					"content": "Về kỳ nghỉ của Barbara...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030603
					]
				},
				{
					"id": 190030603,
					"content": "À chuyện này sao, đúng vậy, Barbara vừa xin nghỉ nửa ngày, nói là phải đi cùng một người bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030604
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030604,
					"content": "Nhưng chuyện này hiếm hoi thật...Barbara lại xin nghỉ phép vì một người bạn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030605
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030605,
					"content": "Được rồi, nói vào việc chính nào, bạn tìm tôi có việc gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030606
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030606,
					"content": "Về \"Trà sủi bọt san hô giải sầu mộng ảo vô đối\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030607
					]
				},
				{
					"id": 190030607,
					"content": "Ơ? Barbara muốn cùng bạn đi mua...đồ uống đặc biệt này sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030608
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030608,
					"content": "Chẳng lẽ người bạn mà Barbara nói đến chính là bạn sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030609
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030609,
					"content": "A...Nếu là \"Kỵ Sĩ Danh Dự\" như bạn thì nghe có lý đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030610
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030610,
					"content": "Được rồi, tôi đã nắm tình hình. Thế thì phiền hai bạn chăm sóc cho Barbara nhé, Kỵ Sĩ Danh Dự.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030611
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030611,
					"content": "Vì sao phải báo cáo lộ trình về ngày nghỉ của Barbara?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030612
					]
				},
				{
					"id": 190030612,
					"content": "Bạn cũng biết đó, do quá nhiều nguyên do mà Barbara rất được hoan nghênh ở Thành Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030613
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030613,
					"content": "Tuy cư dân đều xuất phát từ ý tốt, nhưng nếu quá nhiều ý tốt, thì Barbara cũng sẽ có lúc bận sấp mặt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030614
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030614,
					"content": "Nếu trong phạm vi công việc, người của giáo hội có thể kịp thời giải vây cho bạn ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030615
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030615,
					"content": "Nhưng nếu trong ngày nghỉ...thì chỉ đành trông cậy vào bản thân Barbara thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030616
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030616,
					"content": "Nhưng cô ấy lại quá...dịu dàng, lúc nào cũng sẽ cố gắng đáp ứng lời thỉnh cầu của mọi người, thậm chí còn khiến bản thân mệt mỏi hơn cả ngày làm việc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030617
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030617,
					"content": "Vì thế chúng tôi nghĩ là, bảo Barbara báo cáo lộ trình của ngày nghỉ, để khi cần thiết, chúng tôi sẽ ra mặt giải vây kịp lúc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030618
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030618,
					"content": "Mong rằng Barbara đừng quá ép buộc bản thân mình nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						0
					],
					"speakerTitle": "Victoria"
				}
			]
		},
