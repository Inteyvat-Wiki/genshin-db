				"points": []
			},
			"dialogs": [
				{
					"id": 190030301,
					"content": "Sao bạn lại về rồi, nếu bạn vẫn muốn tìm tiểu thư Barbara thì cô ấy chưa về đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030302,
						190030303
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030302,
					"content": "Đã tìm được Barbara ở Lang Lãnh rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030304
					]
				},
				{
					"id": 190030304,
					"content": "Vậy à...cô ấy không xảy ra chuyện gì thì tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030305
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030305,
					"content": "Nhưng tạm thời chắc cô ấy không về kịp, xem ra tôi phải giao việc của giáo hội cho người khác làm rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030306
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030306,
					"content": "Để tôi giúp cho.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030307
					]
				},
				{
					"id": 190030307,
					"content": "Nếu bạn đồng ý thì tốt quá, ngại ghê, còn làm phiền đến bạn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030308
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030308,
					"content": "Để tôi nghĩ xem...vậy bạn giúp tôi dọn dẹp xung quanh giáo hội nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030309
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030309,
					"content": "Xung quanh giáo hội kẻ đến người đi tấp nập, nền đất lúc nào cũng bẩn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030310
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030310,
					"content": "Những việc này trước giờ đều do một mình tiểu thư Barbara phụ trách, cô ấy vừa không có mặt thì đã...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030311
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030311,
					"content": "Nơi rộng lớn như vậy đều do một mình tiểu thư Barbara dọn dẹp sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030312
					]
				},
				{
					"id": 190030312,
					"content": "Đúng thế, tiểu thư Barbara luôn nói không thành vấn đề, cũng không cho người khác giúp một tay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030313
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030313,
					"content": "Nhưng sau mỗi lần quét dọn xong, trông cô ấy đều rất mệt mỏi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030314
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030314,
					"content": "Nói thật, bạn chịu giúp tôi, hoặc có thể nói là... tiểu thư Barbara chịu để bạn giúp, là điều khiến tôi ngạc nhiên đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030315
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030315,
					"content": "Nhưng như vậy thì gánh nặng của cô ấy mới có thể ít đi một chút...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030316
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030316,
					"content": "Nói chung là, việc quét dọn phải nhờ bạn rồi đó, \"Kỵ Sĩ Danh Dự\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						0
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030303,
					"content": "Barbara đến Tửu Trang Dawn khám bệnh cho ông Tunner rồi đó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030304
					]
				}
			]
		},
