			"dialogs": [
				{
					"id": 716620401,
					"content": "Woa! Không hổ danh là bạn, tìm hiểu nhanh lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620402
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620402,
					"content": "Vậy thì nhờ vào bạn nhé, cứ thỏa sức tưởng tượng để khiến cho bí cảnh này biến hóa đi nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620403
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620403,
					"content": "Hy vọng... chúng ta có thể nhanh chóng nắm bắt được quy luật biến hóa của bí cảnh này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Honglang"
				}
			]
