			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716620101,
					"content": "Nhà lữ hành, đến đúng lúc lắm, ở đây có một ủy thác đang cần bạn giúp đỡ đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620102,
						716620103
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 716620102,
					"content": "Là ủy thác nguy hiểm gì sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620104
					]
				},
				{
					"id": 716620104,
					"content": "Ủy thác lần này liên quan đến một tòa bí cảnh không rõ lai lịch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620105
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 716620105,
					"content": "Tuy rằng hiệp hội đã điều tra bí cảnh này rất lâu, nhưng đến giờ vẫn chưa thu thập được tư liệu hữu ích nào cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620106
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 716620106,
					"content": "Người phụ trách hành động điều tra lần này có nói, anh ấy cần tìm một nhà mạo hiểm giỏi ứng biến để hỗ trợ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620107
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 716620107,
					"content": "Nên tôi nghĩ đến bạn ngay đấy nhà lữ hành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620108
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 716620108,
					"content": "Rốt cuộc đó là bí cảnh như thế nào...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620109
					]
				},
				{
					"id": 716620109,
					"content": "Honglang đang ở chỗ cổng bí cảnh, nếu bạn đồng ý giúp đỡ thì có thể đến đó hỏi thăm thử.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620110
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 716620110,
					"content": "Vậy thì nhờ bạn nhé, Nhà Lữ Hành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 716620103,
					"content": "Là ủy thác khó khăn gì sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620104
					]
				}
			]
		},
		{
			"id": 7166202,
			"completionStepIds": [
				7166202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7166202",
							"2"
						],
						"stepId": 7166202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Honglang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716620201,
					"content": "Bí cảnh này rốt cuộc là sao nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620202
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620202,
					"content": "Về ủy thác...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620203
					]
				},
				{
					"id": 716620203,
					"content": "Ấy? Đợi đã... không lẽ bạn là nhà mạo hiểm mà Katheryne nói sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620204
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620204,
					"content": "Tôi nghe nói bạn rất giỏi ứng biến, có kiến thức mạo hiểm phong phú, thân thủ độc nhất vô nhị đúng không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620205,
						716620206
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620205,
					"content": "Đúng vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620207
					]
				},
				{
					"id": 716620207,
					"content": "Tốt quá rồi, có bạn đến giúp sức thì tôi có thể yên tâm hơn chút rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620208
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620208,
					"content": "Nhưng mà, bí cảnh này rốt cuộc là...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620209
					]
				},
				{
					"id": 716620209,
					"content": "Tôi quên mất... để tôi nói qua về tình hình hiện giờ cho bạn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620210
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620210,
					"content": "Chuyện là thế này. Dạo trước trong hiệp hội có một đội nhà mạo hiểm phát hiện ra một cánh cổng kỳ lạ... chính là cánh cổng ở bên cạnh tôi đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620211
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620211,
					"content": "Đi qua cánh cổng này thì đội mạo hiểm đó đến được một bí cảnh không rõ nguồn gốc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620212
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620212,
					"content": "Theo như lời họ nói, sau khi vào bí cảnh, nó giống như là \"một căn nhà trống\" vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620213,
						716620214
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620213,
					"content": "Ý là sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620215
					]
				},
				{
					"id": 716620215,
					"content": "Chỉ là ví dụ thôi, nói chính xác thì đó là một khu vực \"dài 52 bước, rộng 52 bước, chiều cao chưa rõ\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620216
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620216,
					"content": "Trong khu vực 52 bước này đều được lát gạch rất bình thường, nhưng ở bên ngoài 52 bước đó toàn bộ là sương mù xám xịt bao quanh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620217
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620217,
					"content": "Hơn nữa, khi có người muốn vượt qua khỏi khu vực 52 bước đó thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620218
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620218,
					"content": "Người đó đã đổi hướng một cách đột ngột rồi bắt đầu đi theo hướng ngược lại... hoặc là đột nhiên biến mất rồi xuất hiện phía sau những người khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620219
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620219,
					"content": "Nói tóm lại, cho dù dùng cách gì thì cũng không ai có thể vượt qua khỏi khu vực 52 bước đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620220
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620220,
					"content": "Đã thử dùng những công cụ mạo hiểm khác chưa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620221
					]
				},
				{
					"id": 716620221,
					"content": "Họ đã thử qua rồi, nhưng những thứ được ném vào sẽ quay về chỗ cũ, đến ánh lửa của ngọn đuốc cũng không thể vượt qua khỏi khu vực đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620222
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620222,
					"content": "Cho nên, ý của anh là muốn chúng tôi giúp anh đi thám hiểm bí cảnh đó đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716620223,
					"content": "Đúng vậy, nhưng mà... việc mà các bạn cần làm không đơn giản chỉ là \"thám hiểm\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620224
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620224,
					"content": "Khó nói lắm, chúng ta vào trong bí cảnh xem trước vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620214,
					"content": "Một căn nhà... trống?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620215
					]
				},
				{
					"id": 716620206,
					"content": "Có, có lẽ là vậy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620207
					]
				}
			]
		},
		{
			"id": 7166203,
			"completionStepIds": [
				7166204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7166204",
							"2"
						],
						"stepId": 7166204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Honglang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716620301,
					"content": "Ở đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716620302,
					"content": "Chính là bí cảnh \"căn nhà trống\" mà anh nói đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620303,
						716620304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716620303,
					"content": "Nó giống như một bí cảnh bình thường vậy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620305
					]
				},
				{
					"id": 716620305,
					"content": "Đúng rồi! Đây không phải là kiểu di tích mà chúng ta thường xuyên đi thám hiểm hay sao?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716620306,
					"content": "Nơi đây đúng là bí cảnh mà chúng ta hay thám hiểm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620307
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620307,
					"content": "Bí cảnh này trở nên như vậy, là bởi vì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620308
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620308,
					"content": "Cách đây không lâu, nó đã trở nên như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620309
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620309,
					"content": "Sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716620310,
					"content": "\"Biến\" thành như vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620311
					]
				},
				{
					"id": 716620311,
					"content": "Đúng vậy. Bí cảnh này... sẽ thay đổi theo tâm ý của con người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620312
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620312,
					"content": "Theo như đội trưởng đội mạo hiểm nói, họ đã loanh quanh trong khu vực mờ mịt đó hồi lâu, khiến cho ai cũng mất tinh thần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620313
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620313,
					"content": "Nhưng trong lúc đó, có một thành viên bắt đầu nhỏ tiếng oán trách.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620314
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620314,
					"content": "\"Nếu như đây là di tích bình thường thì chúng ta đã thám hiểm xong lâu rồi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620315
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620315,
					"content": "Mọi người trong đội vừa đói vừa mệt nên ai cũng đồng tình như thế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620316
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620316,
					"content": "Thế là đột nhiên, đội mạo hiểm phát hiện bản thân đang đứng trong một \"khu di tích bình thường\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620317
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620317,
					"content": "\"Khu di tích bình thường\" đó có cơ quan, có đường đi, có kho báu... đến cả đuốc cũng có thể đốt được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620318
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620318,
					"content": "Đội mạo hiểm đó không hiểu gì cả, nên đành phải quay về hiệp hội để báo cáo lại trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620319
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620319,
					"content": "Chúng tôi đã gấp rút tăng cường nhân lực để nghiên cứu sâu hơn về bí cảnh này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620320
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620320,
					"content": "Nhưng cho đến giờ, chúng tôi chỉ có thể biết được rằng tòa bí cảnh này sẽ thay đổi theo tâm ý của con người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620321
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620321,
					"content": "Nếu có nhiều người cùng lúc tiến vào bí cảnh, bí cảnh sẽ căn cứ vào suy nghĩ mạnh mẽ nhất trong số những người đó để thay đổi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620322
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620322,
					"content": "Woa! Vậy là có thể biến ra nguyên cái cảng Liyue sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716620323,
					"content": "Cái này chúng tôi cũng thử rồi, nhưng đến giờ vẫn chưa thành công... Theo tôi nghĩ, có thể là do tâm nguyện của chúng tôi chưa đủ mạnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620324
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620324,
					"content": "Nói chung, chúng tôi hiện đang chiêu mộ nhà mạo hiểm để vào trong bí cảnh đó, nhờ họ dùng tâm nguyện của mình để khiến cho bí cảnh không ngừng biến hóa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620325
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620325,
					"content": "Trong quá trình này, chúng tôi cũng sẽ có thể tìm ra quy luật biến đổi của bí cảnh để phục vụ cho công tác nghiên cứu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620326,
						716620327
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620326,
					"content": "Vậy chúng tôi phải thao tác như thế nào?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620328
					]
				},
				{
					"id": 716620328,
					"content": "Bạn có thấy cơ quan ở bên đó không? Đó chính là \"máy kích hoạt\" mà chúng tôi đã thiết lập, được chế tạo từ một nhà mạo hiểm đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620329
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620329,
					"content": "Đơn giản mà nói, tâm nguyện của anh ta là \"chỉ cần chạm vào cơ quan này là sẽ khiến cho bí cảnh biến hóa\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620330
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620330,
					"content": "Sau đó, bí cảnh này đã đáp lại tâm nguyện của anh ta, nhưng để đảm bảo cho cơ quan này luôn tồn tại, chúng tôi cứ cách một khoảng thời gian đều sẽ mời anh ta quay trở vào một lần...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620331
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620331,
					"content": "Không ngờ lại có cách thức này...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620332
					]
				},
				{
					"id": 716620332,
					"content": "Đây cũng là một phương án khẩn cấp, nếu không, nói không chừng bí cảnh này sẽ biến hóa không ngừng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620333
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620333,
					"content": "Nhưng mà nhìn từ một góc độ khác, bí cảnh này rất thích hợp để rèn luyện nhà mạo hiểm, dẫu sao thì chỉ cần tập trung suy nghĩ là sẽ có thể tạo ra nhiều địa hình và cơ quan khác nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620334
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620334,
					"content": "Những lời nói ban nãy có thể bạn không hiểu đâu, hay là thử tự mình trải nghiệm nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620335
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620335,
					"content": "Bạn thấy \"Đồng Mạo Hiểm\" màu vàng bên kia chứ? Đó cũng chính là món đồ tạo ra từ tâm nguyện của chúng tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620336
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620336,
					"content": "Nhà lữ hành, bạn đi lấy thử \"Đồng Mạo Hiểm\" ở đó trước đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620327,
					"content": "Có dùng cách thức đặc biệt gì không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620328
					]
				},
				{
					"id": 716620304,
					"content": "Trông còn có vẻ rất quen nữa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716620305
					]
				}
			]
		},
