			"dialogs": [
				{
					"id": 730391001,
					"content": "Đúng rồi, ngày vui vẻ như hôm nay, Aranara bọn họ đều đang làm đồ ăn cho chúng ta, \"có qua có lại\", chúng ta cũng làm chút gì đó cho bọn họ đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730391002,
					"content": "Ừm... Có lẽ Aranara sẽ thích... vậy làm Canh Rau Củ đi! He he, cho Aranara nếm thử tay nghề của Nara!",
