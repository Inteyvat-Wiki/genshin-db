					"Arapas",
					"Araphala"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730391224,
					"content": "#Ờ, vẫn phải để {NICKNAME} hỗ trợ mới được, nếu không lại nấu ra món ăn như trước nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391201
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730391201,
					"content": "Hướng dẫn Aranara hoàn thành món ăn theo cách cải thiện mà lúc trước Paimon nghĩ đến.\\nSau đó thưởng thức cùng Aranara...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730391202
					]
				},
				{
					"id": 730391202,
					"content": "Sao nào? Thức ăn Nara ngon chính tông!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730391203,
					"content": "#Ưm... Tuy Arapacati đề nghị để Nara {NICKNAME} tới chỉ đạo các anh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391204
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730391204,
					"content": "Đồ ăn Nara... Đây, đây là \"Hương Vị Vui Vẻ\" của đồ ăn Nara ư?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391205
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730391205,
					"content": "Vui tới nỗi muốn bay bổng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391206
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730391206,
					"content": "Nước của Vanarana... rõ ràng là \"Thứ nước tốt nhất\"... sao lại nấu ra món như thế này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391207
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730391207,
					"content": "Nhưng \"Quả Tươi Độc Nhất\" vẫn ngon như thế... ừm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391208
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730391208,
					"content": "Hở? Sao lại như vậy? Aranara thấy không ngon ư? Rõ ràng tôi thấy rất ngon mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730391209,
					"content": "Tuy không biết cái gì gọi là \"không ngon\"... ừm... có hương vị \"mãnh liệt\", giống như khi chạy nhanh quá đập vào cây ấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391210
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730391210,
					"content": "Wow... cái này... chắc chắn là xung đột văn hóa giữa Nara và Aranara rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730391211,
					"content": "#Nhưng các anh à, vậy không tốt. Các anh phải cảm ơn Nara {NICKNAME} mới đúng, sao có thể nói những lời này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391212
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730391212,
					"content": "Huhu... Xin lỗi mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391213
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730391213,
					"content": "Không phải! Phải nói cảm ơn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391214
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730391214,
					"content": "#Cảm ơn Nara {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391215
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730391215,
					"content": "#Nhưng... Nara {NICKNAME} và Paimon ăn vui vẻ là được rồi! Kệ mấy ông anh ngốc nghếch kia đi, chỉ cần người bạn Nara vui vẻ, chúng tôi sẽ vui vẻ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391216
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730391216,
					"content": "#Có điều, Nara {NICKNAME} không giống Nara Varuna. Khi đó Nara Varuna nói nhiều chuyện về \"{M#anh trai}{F#em gái}\" lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391217
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730391217,
					"content": "#Còn Nara {NICKNAME} nói rất ít, không thoải mái à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391218
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730391218,
					"content": "#Này... {NICKNAME}, nói gì đó đi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391219,
						730391220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730391219,
					"content": "Cảm ơn đã quan tâm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730391222
					]
				},
				{
					"id": 730391222,
					"content": "#Là vậy ư? Nếu Nara {NICKNAME} không sao là tốt rồi. Cảm ơn các bạn, những đóa hoa nhỏ là món quà mà Arapacati và các anh tặng cho Nara {NICKNAME} và Paimon đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391223
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730391223,
					"content": "#Mong Nara {NICKNAME} và Paimon nhận được nhiều \"Hương Vị Vui Vẻ\" ở Vanarana hơn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730391220,
					"content": "(Giữ im lặng)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730391221
					]
				},
				{
					"id": 730391221,
					"content": "#... Nói chung, Arapacati đừng nói! {NICKNAME} không sao cả!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391222
					],
					"speakerTitle": "Paimon"
				}
			]
