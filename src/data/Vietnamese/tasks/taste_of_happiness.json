			},
			"dialogs": [
				{
					"id": 730390101,
					"content": "Các anh đã tự kiểm điểm bản thân rồi. Lễ Hội Utsava là khoảng thời gian vui vẻ. Arapacati đừng giận mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390102
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730390102,
					"content": "Đúng, Arapacati đừng giận nữa nhé, ngày vui vẻ, nên lấy \"Hương Vị Vui Vẻ\" ra chúc mừng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390103
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730390103,
					"content": "Đây là thời điểm để triển lãm thành quả \"luyện nấu ăn\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390104
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730390104,
					"content": "Đã chuẩn bị xong từ lâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390105
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730390105,
					"content": "Ưm ưm! Lễ Hội Utsava là bữa tiệc lớn! Tôi mong chờ từ lâu lắm rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390106,
						730390107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730390106,
					"content": "Đúng đó! Bữa tiệc lớn Lễ Hội Utsava!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730390108
					]
				},
				{
					"id": 730390108,
					"content": "Có nước của Vanarana, thứ nước tốt nhất, sẽ làm ra được món canh ngon nhất. Nara uống vào chắc chắn sẽ hài lòng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390109
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730390109,
					"content": "#Muốn đưa \"Hương Vị Vui Vẻ\" cho Nara {NICKNAME} và Paimon, nên để Nara {NICKNAME} và Paimon \"chỉ đạo\" các anh mới đúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390110
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730390110,
					"content": "Chỉ như vậy mới có thể làm ra món ăn khiến Nara vừa lòng, đây mới là \"lễ tiết\" để chiêu đãi \"khách\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390111
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730390111,
					"content": "#Nara {NICKNAME}, bạn có bằng lòng \"chỉ đạo\" các anh ấy nấu nướng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730390107,
					"content": "Đừng mong chờ quá...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730390108
					]
				}
			]
		},
