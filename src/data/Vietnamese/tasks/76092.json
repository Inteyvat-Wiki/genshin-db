			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Rolf"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760920101,
					"content": "#Tránh xa ra đi! Chỗ này rất nguy hiểm! Lát nữa nếu Cuộc Săn Hoang Dã xuất hiện, tôi không có sức để bảo vệ {F#cô}{M#cậu} đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760920102,
						760920109,
						760920112
					],
					"speakerTitle": "Rolf"
				},
				{
					"id": 760920102,
					"content": "Sao anh biết sẽ có Cuộc Săn Hoang Dã?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760920103
					]
				},
				{
					"id": 760920103,
					"content": "Là một Người Giữ Đèn, đối phó với Cuộc Săn Hoang Dã là trách nhiệm của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760920104
					],
					"speakerTitle": "Rolf"
				},
				{
					"id": 760920104,
					"content": "Thấy cái Tịch Ấn Thạch bên cạnh này không? Để đảm bảo việc tiêu diệt Cuộc Săn Hoang Dã không có sai sót, tôi phải canh ở đây ba ngày ba đêm rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760920105
					],
					"speakerTitle": "Rolf"
				},
				{
					"id": 760920105,
					"content": "Tịch Ấn Thạch?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760920106
					]
				},
				{
					"id": 760920106,
					"content": "Tịch Ấn Thạch là phong ấn mà chúng tôi, những Người Giữ Đèn đã thiết lập để xua tan khí tức của Cuộc Săn Hoang Dã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760920107
					],
					"speakerTitle": "Rolf"
				},
				{
					"id": 760920107,
					"content": "Tuy tôi cũng không rõ nguyên lý trong đó, nhưng thông thường mà nói, khí tức còn sót lại ở những nơi đã từng xuất hiện Cuộc Săn Hoang Dã rất dễ thu hút chúng quay trở lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760920108
					],
					"speakerTitle": "Rolf"
				},
				{
					"id": 760920108,
					"content": "Do đó sau khi đẩy lùi chúng, chúng tôi sẽ thiết lập loại Tịch Ấn Thạch này. Nếu Cuộc Săn Hoang Dã xuất hiện lần nữa thì nó cũng có thể bảo vệ chúng tôi trong trận chiến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rolf"
				},
				{
					"id": 760920109,
					"content": "Tôi không sợ Cuộc Săn Hoang Dã.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760920110
					]
				},
				{
					"id": 760920110,
					"content": "#Tuy không biết {F#cô}{M#cậu} lấy đâu ra sự tự tin này, nhưng Cuộc Săn Hoang Dã không phải kẻ địch mà {F#cô}{M#cậu} có thể tùy tiện đối phó đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760920111
					],
					"speakerTitle": "Rolf"
				},
				{
					"id": 760920111,
					"content": "Nghe lời khuyên của tôi đi, khi gặp những nơi có loại Tịch Ấn Thạch này thì tốt nhất là nên cẩn thận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rolf"
				},
				{
					"id": 760920112,
					"content": "Không làm phiền anh nữa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760920113
					]
				},
				{
					"id": 760920113,
					"content": "Được rồi, đi đường cẩn thận nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rolf"
				}
			]
		},
