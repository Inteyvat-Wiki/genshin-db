			"dialogs": [
				{
					"id": 751210101,
					"content": "Có người nhờ tôi đi tìm hai cuốn sách...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751210102
					]
				},
				{
					"id": 751210102,
					"content": "Bạn mô tả cho Kuroda nghe về cuốn sách đã ngừng xuất bản mà Citlali cần.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						751210103
					]
				},
				{
					"id": 751210103,
					"content": "Bản đầu tiên của \"Chuyển Sinh Thành Raiden Shogun, Sau Đó Thiên Hạ Vô Địch\" và bản giới hạn của \"Làm Phiền Rồi Guuji Hồ Ly Của Ta\" sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751210104
					],
					"speakerTitle": "Kuroda"
				},
				{
					"id": 751210104,
					"content": "#Người bạn này của {F#cô}{M#cậu} đúng là rất chuyên nghiệp đấy. Nói đến giá trị sưu tầm thì những cuốn sách mà Nhà Xuất Bản Yae đang xuất bản đều không thể so được với hai cuốn này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751210105
					],
					"speakerTitle": "Kuroda"
				},
				{
					"id": 751210105,
					"content": "Tiếc là tôi lại không có cơ hội để quen biết độc giả như thế này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751210106
					],
					"speakerTitle": "Kuroda"
				},
				{
					"id": 751210106,
					"content": "Những loại sách này vẫn còn chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751210107
					]
				},
				{
					"id": 751210107,
					"content": "Dù là cuốn nào thì cũng không thể tìm thấy trên thị trường được đâu. Trong kho thì càng không cần nói đến, đã bị mua hết từ lâu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751210108
					],
					"speakerTitle": "Kuroda"
				},
				{
					"id": 751210108,
					"content": "Nhưng mà, chỗ tôi vừa hay mỗi loại có một cuốn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751210109
					],
					"speakerTitle": "Kuroda"
				},
				{
					"id": 751210109,
					"content": "Tôi có thể mua lại.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751210110
					]
				},
				{
					"id": 751210110,
					"content": "#Không không, hai cuốn sách này ở trong tay người bạn đó của {F#cô}{M#cậu} mới thể hiện được giá trị của chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751210111
					],
					"speakerTitle": "Kuroda"
				},
				{
					"id": 751210111,
					"content": "#Cứ để tôi tặng {F#cô}{M#cậu} làm quà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuroda"
				}
			]
		}
	]
