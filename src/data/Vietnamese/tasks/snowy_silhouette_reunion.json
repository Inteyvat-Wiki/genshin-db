				"points": []
			},
			"dialogs": [
				{
					"id": 708030101,
					"content": "Ơ? Người này là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030102,
						708030103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708030102,
					"content": "Lẽ nào là cha của Joel?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708030104
					]
				},
				{
					"id": 708030104,
					"content": "Ồ! Bạn đến rồi à, Nhà Lữ Hành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030105
					],
					"speakerTitle": "Pallad Lỗ Mãng"
				},
				{
					"id": 708030105,
					"content": "Để tôi giới thiệu một chút, vị này là cha của Joel, Joserf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030106
					],
					"speakerTitle": "Pallad Lỗ Mãng"
				},
				{
					"id": 708030106,
					"content": "Cha! Vị này là Nhà Lữ Hành mà con nói với cha đó, lúc trước đã từng giúp con rất nhiều, lần này còn cùng con đắp người tuyết nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030107
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 708030107,
					"content": "Joel có nói với tôi rồi, ôi, thật sự cảm ơn rất nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030108,
						708030109
					],
					"speakerTitle": "Joserf"
				},
				{
					"id": 708030108,
					"content": "Đoàn tụ là mừng rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708030110
					]
				},
				{
					"id": 708030110,
					"content": "Đúng vậy, đây thật sự là một điều tuyệt vời!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708030111,
					"content": "Pallad, lần này xem như bạn lập công lớn rồi, làm tốt lắm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030112
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708030112,
					"content": "Lại chuyện gì? Pallad lại làm gì nữa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708030113,
					"content": "Các bạn có nhớ lần trước tôi nói có thấy một bóng người ở núi tuyết không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030114
					],
					"speakerTitle": "Pallad Lỗ Mãng"
				},
				{
					"id": 708030114,
					"content": "Hôm đó sau khi các bạn cùng tôi vào núi tuyết, còn giúp tôi đánh bại lũ ma vật, tôi đã bắt đầu tìm kiếm xung quanh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030115
					],
					"speakerTitle": "Pallad Lỗ Mãng"
				},
				{
					"id": 708030115,
					"content": "Khi đang tìm kiếm, tôi đã không cẩn thận bị lăn từ trên núi xuống...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030116
					],
					"speakerTitle": "Pallad Lỗ Mãng"
				},
				{
					"id": 708030116,
					"content": "Lăn, lăn xuống...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708030117,
					"content": "May mà bên dưới tuyết rất dày, nên tôi không bị thương.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030118
					],
					"speakerTitle": "Pallad Lỗ Mãng"
				},
				{
					"id": 708030118,
					"content": "Đúng lúc tôi đang tìm đường quay lại thì đột nhiên bên cạnh có tiếng động, có một người đột nhiên chui ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030119
					],
					"speakerTitle": "Pallad Lỗ Mãng"
				},
				{
					"id": 708030119,
					"content": "Lúc đó tôi không hề biết đó là người tôi cần tìm, còn tưởng đó là nhà mạo hiểm vào núi tìm kiếm cứu hộ như tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030120
					],
					"speakerTitle": "Pallad Lỗ Mãng"
				},
				{
					"id": 708030120,
					"content": "Nói chuyện một lúc mới biết có rất nhiều chuyện anh ấy đã không còn nhớ nữa, ngay cả tên của mình cũng không nhớ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030121
					],
					"speakerTitle": "Pallad Lỗ Mãng"
				},
				{
					"id": 708030121,
					"content": "Lúc đó tôi không kịp nghĩ nhiều, trên núi tuyết quá lạnh, tôi vội giục anh ấy cùng leo lên núi trở về doanh trại, có chuyện gì đợi trở về rồi nói!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030122
					],
					"speakerTitle": "Pallad Lỗ Mãng"
				},
				{
					"id": 708030122,
					"content": "Về đến doanh trại, chúng tôi gặp Joel, Joel vừa nhìn thấy đã ngây người rồi gọi to: \"Cha!\" Lúc này anh ấy mới chợt nhớ ra điều gì đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030123
					],
					"speakerTitle": "Pallad Lỗ Mãng"
				},
				{
					"id": 708030123,
					"content": "Cha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030124
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 708030124,
					"content": "Joel, cha đây, cha đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030125
					],
					"speakerTitle": "Joserf"
				},
				{
					"id": 708030125,
					"content": "Anh Joserf thật sự không nhớ được chuyện gì khác sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708030126,
					"content": "Công Chúa Heo Rừng, còn những con cáo trên núi mà anh từng cho chúng ăn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708030127,
					"content": "Rất xin lỗi, tôi không có ấn tượng. Có lẽ là vì bị thương phần đầu chăng? Tôi cũng không rõ nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030128
					],
					"speakerTitle": "Joserf"
				},
				{
					"id": 708030128,
					"content": "Khi tôi tỉnh lại, khắp người toàn là máu. Ngay cả hành lý cũng không còn, không còn gì có thể chứng minh thân phận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030129
					],
					"speakerTitle": "Joserf"
				},
				{
					"id": 708030129,
					"content": "Tôi đành phải bò vào một cái hang, ở trong đó từ từ dưỡng thương, khi đôi chân hồi phục, tôi đã đi săn để có thể sống sót.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030130
					],
					"speakerTitle": "Joserf"
				},
				{
					"id": 708030130,
					"content": "Cha... Con thật sự rất lo lắng cho cha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030131
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 708030131,
					"content": "Không sao không sao, Joel đừng khóc, từ giờ cha không đi đâu nữa, cha sẽ ở bên cạnh con.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030132
					],
					"speakerTitle": "Joserf"
				},
				{
					"id": 708030132,
					"content": "Anh Joserf, vậy tiếp theo anh dự định thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708030133,
					"content": "Tôi...bây giờ tôi chỉ muốn ở cùng gia đình mình lâu hơn một chút thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030134
					],
					"speakerTitle": "Joserf"
				},
				{
					"id": 708030134,
					"content": "Có thể trở về là tốt rồi. Chuyện này cũng xem như có một cái kết tốt đẹp, hahaha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030135
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708030135,
					"content": "Nhưng mà Pallad, bị sẩy chân rơi xuống núi trong quá trình tìm kiếm thì kỹ năng mạo hiểm của anh vẫn cần phải cải thiện...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030136
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708030136,
					"content": "Trở về hiệp hội, tôi phải dạy thêm cho anh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030137
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708030137,
					"content": "Hả, hội, hội trưởng Cyrus...không phải tôi đã lập công rồi sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030138
					],
					"speakerTitle": "Pallad Lỗ Mãng"
				},
				{
					"id": 708030138,
					"content": "Đi thôi! Trở về hiệp hội!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030139
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708030139,
					"content": "Hội trưởng! Có thể tha cho tôi không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pallad Lỗ Mãng"
				},
				{
					"id": 708030109,
					"content": "Không sao là tốt rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708030110
					]
				},
				{
					"id": 708030103,
					"content": "Joel khổng lồ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708030104
					]
				}
			]
		}
	]
}