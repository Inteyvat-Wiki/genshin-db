			"dialogs": [
				{
					"id": 221150101,
					"content": "Bé Thường sao vẫn chưa quay về cơ chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150102
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 221150102,
					"content": "Bé Thường là ai vậy bà...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150103
					]
				},
				{
					"id": 221150103,
					"content": "Là bé Thường chứ ai, mọi người hay gọi là \"Thường Cửu Gia\" đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150104
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 221150104,
					"content": "Lão gọi bé Thường nhiều nên cũng thành quen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150105
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 221150105,
					"content": "Tối qua, bé Thường nói ra ngoài tìm cảm hứng viết tiểu thuyết, lão cũng không có để ý lắm chỉ dặn dò vài câu nhớ quay về sớm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150106
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 221150106,
					"content": "Kết quả là đến giờ vẫn chưa thấy về nhà. Bà sợ bé Thường gặp chuyện gì bất trắc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150107
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 221150107,
					"content": "Thân già này không dám đi tìm, chỉ có thể nhở các cháu mà thôi, có thể giúp bà tìm bé Thường được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150108,
						221150110
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 221150108,
					"content": "Để chúng tôi giúp cho.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150109
					]
				},
				{
					"id": 221150109,
					"content": "Vậy thì tốt quá, nhờ các cháu giúp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 221150110,
					"content": "Bà biết ông ấy đi đâu không ạ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150111
					]
				},
				{
					"id": 221150111,
					"content": "Haizz, còn có thể đi đâu nữa ngoài \"Dốc Vô Vọng\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150112
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 221150112,
					"content": "Các cháu giúp bà nhé, đã đi lâu như vậy rồi chỉ sợ có chuyện bất trắc thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ruoxin"
				}
			]
		},
		{
