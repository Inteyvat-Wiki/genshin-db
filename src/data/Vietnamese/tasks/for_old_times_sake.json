			},
			"dialogs": [
				{
					"id": 221150201,
					"content": "Đám quái vật phiền phức...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150202
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 221150202,
					"content": "Ta đến đây là để tìm cảm hứng viết tiểu thuyết mới, chưa gì phải chạm trán với lũ quái vật này rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150203
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 221150203,
					"content": "Cảm ơn các cháu nhé, nếu không có các cháu ta thực sự không biết phải giải quyết thế nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150204
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 221150204,
					"content": "Bà Ruoxin đang rất lo lắng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150205
					]
				},
				{
					"id": 221150205,
					"content": "Lo lắng? Ta có bị sao đâu mà lo lắng, lớn tuổi như vậy rồi không tự biết chăm sóc bản thân sao. Í... Chuyện nhỏ như vậy một mình ta cũng xử lý được, chỉ là hơi mất công sức thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150206
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 221150206,
					"content": "Nhưng mà vẫn phải cảm ơn các cháu... Ta cũng mau quay về thôi, không bà ý lại lải nhải.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Thường Cửu Gia"
				}
			]
		},
		{
			"id": 2211503,
			"completionStepIds": [
				2211505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
