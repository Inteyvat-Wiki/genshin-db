					"Thường Cửu Gia"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221150501,
					"content": "Haizz, phải làm thế nào mới viết được một cuốn tiểu thuyết hay cơ chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150502
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 221150502,
					"content": "Ông ơi đây là món đồ ông làm rơi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150503
					]
				},
				{
					"id": 221150503,
					"content": "Hả? Đây quả thật là đồ ta làm rơi, nhưng bên trong đều là bản thảo vứt đi thôi, vốn định vứt xuống sông để tiêu hủy ấy mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150504
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 221150504,
					"content": "Các cháu còn nhặt lại sao... Chữ bên trong đều mờ hết rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150505
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 221150505,
					"content": "Bên trong viết về cái gì đó ạ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150506
					]
				},
				{
					"id": 221150506,
					"content": "Ồ, là câu chuyện ta viết cho một cô bé, mấy chương này xem như bỏ đi. Các cháu biết không, hồi còn nhỏ con bé suốt ngày quấn lấy ta, bắt ta kể chuyện cho nó nghe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150507
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 221150507,
					"content": "Thật đáng tiếc, trước kia không có thời gian viết chỉ mới hoàn thành phần mở đầu để con bé đọc, dự định về sau có thời gian ta sẽ viết tiếp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150508
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 221150508,
					"content": "Rồi đến một ngày con bé tự nhiên biến mất, ta có tìm thế nào cũng không thấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150509
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 221150509,
					"content": "Hừm, ta đoán chắc là người nhà của cô bé không thích ta, không muốn hai đứa chơi với nhau, họ tìm cách rời khỏi Khinh Sách Trang mà không nói với ai một lời.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150510
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 221150510,
					"content": "Cứ đợi đấy, đến khi trở thành nhà văn nổi tiếng rồi họ sẽ ngưỡng mộ danh tiếng của ta! Cuốn sách ta viết cho cô bé đó sẽ được xuất bản ra toàn thế giới!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150511
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 221150511,
					"content": "Như vậy cho dù có sống ở đâu đi chăng nữa, cô bé sẽ biết là ta đã thay đổi! Không còn như xưa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150512
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 221150512,
					"content": "Hai chúng ta sẽ lại được gặp nhau... Nhưng trước tiên phải hoàn thành cuốn chuyện này đã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150513
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 221150513,
					"content": "...Vừa rồi lại nghe ta lải nhải rồi. Haizz, ta nên tập trung suy nghĩ làm thế nào để viết được cuốn sách hay mới được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Thường Cửu Gia"
				}
			]
		},
