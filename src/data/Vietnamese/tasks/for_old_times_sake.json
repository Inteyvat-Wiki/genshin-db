			"dialogs": [
				{
					"id": 221150601,
					"content": "Haizz, bé Thường này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150602
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 221150602,
					"content": "Thường Cửu Gia quay về rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150603
					]
				},
				{
					"id": 221150603,
					"content": "Ừm bà gặp ông ấy rồi, thật vật vả cho các cháu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150604
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 221150604,
					"content": "Tính cách của ông ấy vẫn như hồi bé vậy, lần nào cũng gây họa ở bên ngoài. Cứ nói bản thân mình đủ lớn nhưng thật ra vẫn còn bé lắm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150605
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 221150605,
