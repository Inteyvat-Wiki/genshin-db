					}
				]
			},
			"dialogs": [
				{
					"id": 746960101,
					"content": "Nhớ ra chưa? Qiqi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960102
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960102,
					"content": "Ừm... Xin lỗi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960103
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960103,
					"content": "Không cần xin lỗi đâu, không sao cả. Còn một đoạn nữa mới đến Palais Mermonia, chúng ta đi thêm một lát, không chừng Qiqi sẽ nhớ ra nhà mình ở đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960104
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960104,
					"content": "#{NICKNAME} nhìn kìa, là Qiqi! Còn có một Melusine nữa. Một tổ đội chưa từng thấy bao giờ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746960105,
					"content": "#A! {NICKNAME}, còn có... Pai... Paimon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960106
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960106,
					"content": "Xin chào.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746960107
					]
				},
				{
					"id": 746960107,
					"content": "Là người quen của Qiqi sao? Tốt quá, khi tôi đang điều tra vụ án gần Cảng Lumidouce thì gặp đứa trẻ bị lạc này... Là trẻ con đúng không nhỉ? Nhìn vóc dáng thì có vẻ là trẻ con loài người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960108
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960108,
					"content": "Qiqi là... là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960109
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960109,
					"content": "Là bạn tốt của chúng tôi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746960110
					]
				},
				{
					"id": 746960110,
					"content": "Đúng, đúng! Chúng tôi đã quen biết nhau từ rất lâu rồi, là bạn tốt của nhau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746960111,
					"content": "#Ồ! Phản ứng của {NICKNAME} nhanh thật đấy, lỡ như Qiqi nói mình là cương thi thì chắc sẽ làm cô ấy sợ lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746960112,
					"content": "Ừm... Bạn tốt... Đúng vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960113
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960113,
					"content": "Xem ra cuối cùng cũng có chút manh mối rồi. Nói thật, đây cũng là lần đầu tiên tôi gặp phải tình huống bó tay như thế này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960114
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960114,
					"content": "Chắc mọi người cũng biết rồi, hình như cô bé ấy có vấn đề về trí nhớ, ngoài tên ra thì những chuyện khác đều rất khó nhớ ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960115
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960115,
					"content": "Đôi khi Qiqi sẽ như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746960116,
					"content": "Thật là một đứa trẻ đáng thương. Tôi vốn định đưa cô bé đến Đội Hắc Ảnh Marechaussee để sắp xếp chỗ ở, tiện thể trên đường đi cũng xem Qiqi có thể khôi phục lại được chút ký ức nào không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960117
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960117,
					"content": "Nếu mấy người là bạn tốt, vậy có biết nhà của Qiqi ở đâu không? Tôi có thể đưa cô bé về nhà, như vậy cũng đỡ được nhiều rắc rối.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960118
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960118,
					"content": "Biết thì có biết... Ừm, nhưng cách đây rất xa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746960119,
					"content": "Rất... xa...? Qiqi đi theo Tiên Linh một đoạn đường dài, đến Cảng Lumidouce...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960120
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960120,
					"content": "Hả? Qiqi nhớ ra rồi à? Vậy còn chuyện trước đó thì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960121
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960121,
					"content": "Trước đó... Baizhu tiên sinh đưa Qiqi đi khám bệnh, ở Di... ừm, Di gì nhỉ? Qiqi đi hái thuốc, sau đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960122
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960122,
					"content": "Ồ! Bến Tàu Di Lung đúng không! Siêu thám tử Paimon biết đã xảy ra chuyện gì rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746960123,
					"content": "Baizhu đưa Qiqi cùng đi khám bệnh ở Bến Tàu Di Lung, Qiqi bị lạc đường khi đi hái thuốc ở đó, tình cờ gặp Tiên Linh nên đã đi theo đến Cảng Lumidouce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746960124,
					"content": "#Hì hì, may mà tôi và {NICKNAME} đã từng đọc \"Siêu Trộm Và Thám Tử Lừng Danh\", suy luận đơn giản như vậy không làm khó được tôi đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746960125,
					"content": "Thật ra câu chuyện đó hoàn toàn là hư cấu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746960126
					]
				},
				{
					"id": 746960126,
					"content": "Ồ ồ! Đúng là rất hợp lý, vậy tôi sẽ lập tức khởi hành đưa Qiqi về Bến Tàu Di Lung. Baizhu tiên sinh là người giám hộ của Qiqi đúng không? Chắc anh ấy đang rất lo lắng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960127,
						746960128
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960127,
					"content": "Khoan đã, trong số những người mà Barbeloth đang đợi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746960129
					]
				},
				{
					"id": 746960129,
					"content": "Ừ nhỉ! Suýt nữa thì quên mất chuyện này. Barbeloth... cô có ở đó không? Có nghe thấy không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746960130,
					"content": "Không cần hét to như vậy đâu. Tôi vẫn luôn ở đây, chỉ là không muốn cắt ngang cuộc trò chuyện của mọi người thôi. Lắng nghe là bản năng của một nhà chiêm tinh ưu tú.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960131
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960131,
					"content": "Cái gọi là Tiên Linh dẫn đường, cũng có thể coi là một loại chỉ dẫn của vận mệnh. Hahaha... Đã đến đây rồi thì chi bằng \"xem bói\" thử xem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960132
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960132,
					"content": "Xem... bói?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960133
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960133,
					"content": "Ây da, làm phiền chút nhé. Barbie, thái độ làm việc nghiêm túc này của cô sẽ làm bạn nhỏ sợ đấy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960134
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960134,
					"content": "Cô tránh sang một bên đã. Nhìn cho kỹ này, phải như tôi đây, gửi tặng món quà bất ngờ nho nhỏ này mới đúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960135
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960135,
					"content": "E hèm, bạn nhỏ Qiqi của Hội Ma Nữ Nhí, dì là Alice, mẹ của Klee đồng minh của Qiqi, cũng là đại ma nữ giỏi nhất trên thế giới này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960136
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960136,
					"content": "Chào dì Alice...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960137
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960137,
					"content": "Đúng là một đứa trẻ lễ phép đáng yêu. Đến đây nào, để đại ma nữ chủ trì nghi thức tiên tri đầy bất ngờ cho ma nữ nhỏ nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960138
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960138,
					"content": "Nghi thức... tiên tri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960139
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960139,
					"content": "Đúng vậy! Nhìn những lá bài trước mặt xem, có đẹp không? Có thích không nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960140
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960140,
					"content": "Thích...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960141
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960141,
					"content": "Thích là tốt rồi, vậy thì hãy rút một lá bài nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960142
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960142,
					"content": "Ừm... lá này, được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960143
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960143,
					"content": "Tất nhiên là được. Để thưởng cho sự phối hợp rất tốt này, lá bài này sẽ thuộc về Qiqi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960144
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960144,
					"content": "...Cảm ơn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960145
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960145,
					"content": "Được rồi, Barbie, thời gian nghỉ ngơi của cô đã kết thúc, đến lúc giúp bạn nhỏ Qiqi giải mã rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960146
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960146,
					"content": "Đừng lắc vai tôi nữa... Tôi đang xem rồi. Ồ, là Người Treo Ngược, đặt xuôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960147
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960147,
					"content": "Người có thể rút được nó không nhiều đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960148
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960148,
					"content": "Cũng có nghĩa là bạn nhỏ Qiqi rất đặc biệt đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960149
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960149,
					"content": "Nó tượng trưng cho sự chờ đợi và vượt qua, đồng thời cũng ẩn ý việc thoát khỏi thế tục.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960150
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960150,
					"content": "Qiqi đang ở trong một giới hạn nhất định, nhưng bản thân lại không muốn chủ động thoát khỏi giới hạn đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960151
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960151,
					"content": "Giới hạn... là chỉ mệnh lệnh sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960152
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960152,
					"content": "Xét từ bề ngoài thì hiểu như vậy cũng không sai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960153
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960153,
					"content": "Về tương lai, chỉ cần chờ đợi là được. Đương nhiên, với Qiqi, thứ không thiếu nhất chính là thời gian. Nhưng mà... ồ, lạ thật, lạ thật...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960154
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960154,
					"content": "Được rồi, được rồi, dừng lại! Nói quá nhiều trong một hồi sẽ làm bạn nhỏ bị áp lực đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960155
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960155,
					"content": "Hãy để Qiqi cảm nhận món quà này trước đã, với bạn nhỏ thì phải kiên nhẫn một chút, thư thả thêm chút thời gian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960156
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960156,
					"content": "Thế nào, bạn nhỏ Qiqi, thích món quà bất ngờ này không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960157
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960157,
					"content": "Thẻ bài đẹp quá... cảm ơn dì Alice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960158
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960158,
					"content": "Ây da, ngoan quá đi, lại còn cố gắng nhớ tên của dì nữa chứ. Tuy dì còn muốn trò chuyện thêm với Qiqi, nhưng cũng muộn rồi, bé ngoan thì phải về nhà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960159
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960159,
					"content": "Nếu Barbie còn gì muốn nói, thì lần sau khi các thành viên của Hội Ma Nữ Nhí tụ họp, hãy dành cho mỗi ma nữ nhỏ một lời tiên tri nhé! Mọi người nhất định sẽ rất vui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960160
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960160,
					"content": "...Cô có thể đừng tự ý tăng thêm việc cho tôi được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960161
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960161,
					"content": "Quyết định vậy đi! Chúng ta gặp lại sau nhé, Qiqi và những người chứng kiến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960162
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960162,
					"content": "Tạm biệt... dì Alice và... bạn tốt của dì Alice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960163
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960163,
					"content": "Phù... Thế là kết thúc rồi sao? Giọng nói của hai người vừa rồi là từ con búp bê này phát ra à? Đồ chơi kiểu mới gì đây, dễ thương quá, ở đâu có thể...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960164
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960164,
					"content": "Ối! Không đúng không đúng, bây giờ không nên nghĩ về những chuyện này. Qiqi, chúng ta đi tìm Baizhu tiên sinh trước đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960165
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960165,
					"content": "#...Ừm, đến giờ rồi, Qiqi phải về thôi. Lần sau... gặp lại nhé, {NICKNAME}, Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960166,
						746960167
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960166,
					"content": "Đi đường cẩn thận.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746960168
					]
				},
				{
					"id": 746960168,
					"content": "Thẻ bài... quà tặng, ừm... đẹp...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960167,
					"content": "Chú ý an toàn nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746960168
					]
				},
				{
					"id": 746960128,
					"content": "Cũng có Qiqi phải không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746960129
					]
				}
			]
		},
