			"dialogs": [
				{
					"id": 140030101,
					"content": "Xin lỗi Charlotte. Hôm nay tôi và em gái hơi bận, tạm thời không nhận phỏng vấn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030102
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140030102,
					"content": "Yên tâm, tôi chỉ xin một chút thời gian thôi. Làm ơn đi mà, anh Lyney!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030103
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030103,
					"content": "Hửm, đã xảy ra chuyện gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140030104,
					"content": "Tôi đã dành cả đêm để viết chuyên mục về Chồn Bóng Ma, sáng nay là có thể đăng báo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030105
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030105,
					"content": "Nhưng sáng nay... đột nhiên tôi nhận được tin. Cô Jemma, vị hôn thê của Cesar đã chủ động liên hệ với đội hiến binh, thừa nhận cô ấy mới chính là Chồn Bóng Ma thật sự!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030106
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030106,
					"content": "Nhanh vậy sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140030107,
					"content": "Khụ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030108
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140030108,
					"content": "Hửm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030109
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030109,
					"content": "Không kịp rồi, anh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030110
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 140030110,
					"content": "Haha... phản ứng của hai bạn là \"nhanh vậy sao\", xem ra hai bạn đã biết trước sự thật rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030111
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030111,
					"content": "Úi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140030112,
					"content": "Quả nhiên trực giác của tôi không sai, chắc chắn hai người có chuyện gì đó giấu tôi! Lý do khiến Jemma tự thú... chắc chắn có liên quan đến màn ảo thuật tối qua!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030113
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030113,
					"content": "Có thể là sau khi xem màn ảo thuật đó, Jemma đã nhớ lại khoảng thời gian cô ấy ở bên cạnh Cesar, và lương tâm thức tỉnh chăng?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030114
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140030114,
					"content": "Ra là vậy... Không đúng, nếu đơn giản như vậy thì mười năm qua cô ấy đã làm gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030115
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030115,
					"content": "Chuyện này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030116
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140030116,
					"content": "(Cảm giác như trực giác phóng viên của Charlotte đang bùng cháy, phải tìm cách đánh lạc hướng cô ấy mới được...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140030117
					]
				},
				{
					"id": 140030117,
					"content": "Tôi nhớ ra rồi! Sau màn biểu diễn tối qua, cả hai người và Jemma đều biến mất. Lẽ nào là lúc đó sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030118
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030118,
					"content": "Một câu hỏi nhanh, mọi người đã đi đâu sau buổi biểu diễn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030119
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030119,
					"content": "Sau buổi biểu diễn? Chúng tôi và Lyney ở nghĩa trang, Lyney còn biểu diễn ảo thuật cho riêng chúng tôi xem nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140030120,
					"content": "Nhắc mới nhớ, nhờ Charlotte mà giờ Lyney đã biết dùng Tường Vi Cầu Vồng trong ảo thuật rồi đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140030121,
					"content": "Khụ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030122
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140030122,
					"content": "...Hửm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030123
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 140030123,
					"content": "Em nhớ là em chưa từng nhận được một bông Tường Vi Cầu Vồng nào từ anh cả. Vậy ý của anh là họ quan trọng hơn em sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030124
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 140030124,
					"content": "Không phải! Chuyện này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030125
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140030125,
					"content": "Sao ngay cả cô cũng phản ứng như vậy nhỉ? Tôi lại nói sai gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140030126,
					"content": "#Bầu không khí trở nên kỳ lạ quá... {NICKNAME}, bây giờ chúng ta phải làm sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140030127,
					"content": "Haiz, xem ra hôm nay không thích hợp để phỏng vấn rồi. Thôi vậy, lần sau tôi lại đến nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030128
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030128,
					"content": "Thứ lỗi cho sự cố chấp của tôi, nhưng tôi không thể bỏ qua tin tức nóng hổi này được! Chuyện của Jemma vừa lan truyền đã gây ra chấn động lớn, tôi phải cố gắng hết sức để tìm ra sự thật đằng sau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030129
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030129,
					"content": "Nghe nói cô ấy còn nói với đội hiến binh rằng \"tâm nguyện cuối cùng là được gặp lại Lorenzo\". Chậc... Mối quan hệ thật phức tạp, tò mò quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030130
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030130,
					"content": "Tóm lại tôi đi trước đây. Mọi người cứ thong thả nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030131
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030131,
					"content": "À ừm, Lynette, thật ra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140030132,
					"content": "Không sao, tôi không giận, lúc nãy chỉ là để đánh lạc hướng cô ấy thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030133
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 140030133,
					"content": "Ra là vậy, làm tôi giật cả mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140030134,
					"content": "Phù, ngay cả tôi cũng suýt nữa bị lừa... May mà hiệu quả không tệ, đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030135
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140030135,
					"content": "...Tường Vi Cầu Vồng, hãy giữ nó thật kỹ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030136
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 140030136,
					"content": "Nếu để mất, tôi cũng sẽ rất buồn đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lynette"
				}
			]
		}
	]
}