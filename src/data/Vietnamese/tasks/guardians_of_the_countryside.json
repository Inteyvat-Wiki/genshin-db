			"trigger": {
				"objectNames": [
					"Zhi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718230201,
					"content": "Ừm, hình như vẫn không đủ thuốc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230202
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718230202,
					"content": "Bạn muốn đi hái thuốc sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718230203
					]
				},
				{
					"id": 718230203,
					"content": "Ừm, tôi đang chuẩn bị đi hái thêm thuốc. Những ngày này mỗi năm tôi đều chuẩn bị thêm chút thuốc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230204
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718230204,
					"content": "Cũng không phải thuốc gì ghê gớm lắm... Chỉ là chút thuốc trị thương hàn, hoặc thuốc hỗ trợ tiêu hóa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230205
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718230205,
					"content": "Sao không đến thẳng Nhà Thuốc Bubu để mua?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718230206
					]
				},
				{
					"id": 718230206,
					"content": "Vì Nhà Thuốc Bubu ở quá xa, từ đây đến cảng Liyue phải mất rất nhiều thời gian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230207
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718230207,
					"content": "Hơn nữa Khinh Sách Trang cũng toàn người già và trẻ nhỏ, không giống như các nhà mạo hiểm, họ không đi được xa như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230208
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718230208,
					"content": "Vì vậy, tôi mới chuẩn bị trước các loại thuốc này để điều trị một số bệnh vặt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230209
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718230209,
					"content": "Nhưng nếu đó thật sự là một loại bệnh rất nghiêm trọng và cần đơn thuốc đàng hoàng, vậy thì phải đến Nhà Thuốc Bubu... Haiz, mong là không xảy ra chuyện như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230210
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718230210,
					"content": "Thôi không nói nữa, tôi còn phải đi hái thuốc, hái xong còn phải xử lý qua mới được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230211
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718230211,
					"content": "Để tôi giúp cho.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718230212
					]
				},
				{
					"id": 718230212,
					"content": "Ơ? Bạn đồng ý giúp thật sao? Thật tốt quá, tôi đang lo một mình phải hái đến bao giờ đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230213
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718230213,
					"content": "Để tôi xem... Còn cần thêm ba vị thuốc nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230214
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718230214,
					"content": "Ừm... Một là Thanh Tâm mọc trên đỉnh núi, rất tốt cho dưỡng khí và tiêu hóa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230215
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718230215,
					"content": "Một vị nữa là Hoa Calla Lily tươi mọc ở bãi sông, có tác dụng khứ phong thấp, tán hàn giảm đau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230216
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718230216,
					"content": "Hoa Calla Lily mọc bên bãi sông chất lượng tốt nhất, thông thường tôi chỉ hái Hoa Calla Lily ở đó để làm thuốc, hoa ở những nơi khác chất lượng kém hơn rất nhiều...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230217
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718230217,
					"content": "Vị cuối cùng là Đài Sen trong hồ bên cạnh, dùng làm thuốc có tác dụng an thần, nhưng thời gian hái có chút đặc biệt, phải hái từ lúc nửa đêm đến sáu giờ sáng hôm sau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhi"
				}
			]
		},
