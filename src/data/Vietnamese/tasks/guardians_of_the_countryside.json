			},
			"dialogs": [
				{
					"id": 718230901,
					"content": "Về rồi à, hái được đủ thuốc chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230902
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718230902,
					"content": "Đều hái được rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718230903
					]
				},
				{
					"id": 718230903,
					"content": "Cảm ơn bạn, tôi đã nhờ Bai đến giúp tôi xử lý thuốc, chúng ta đưa số dược liệu này đến Xưởng Xay đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhi"
				}
			]
		},
		{
			"id": 7182310,
			"completionStepIds": [
				7182310
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
