			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xiaobai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718231001,
					"content": "...Ừm, chúng ta cùng nhau xử lý chỗ thuốc này, xử lý xong bạn cũng có thể lấy đi làm thuốc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231002
					],
					"speakerTitle": "Xiaobai"
				},
				{
					"id": 718231002,
					"content": "Ừm, cảm ơn bạn, tôi phải nghĩ cách để làm thuốc ngọt một chút, nếu không chắc chắn bọn trẻ con sẽ không chịu uống...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231003
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718231003,
					"content": "Thời điểm này trong năm các bạn thường làm gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718231004
					]
				},
				{
					"id": 718231004,
					"content": "Ừm, cũng như vậy thôi, thanh niên ở Khinh Sách Trang cũng chẳng có mấy người, những việc có thể giúp, chúng ta cố gắng giúp thì tốt hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231005
					],
					"speakerTitle": "Xiaobai"
				},
				{
					"id": 718231005,
					"content": "Thật ra, mỗi năm cũng chỉ bận rộn mấy ngày này, cũng không sao, vả lại năm nay có bạn giúp cũng nhẹ nhàng hơn nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231006
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718231006,
					"content": "Mấy năm nay, mỗi lần hái thuốc tôi đều tốn rất nhiều thời gian, đừng nói là làm thuốc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231007
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718231007,
					"content": "Được rồi, cảm ơn sự giúp đỡ của các bạn, chúng ta cũng phải nhanh chóng xử lý dược liệu, sau đó đi chuẩn bị đèn tiêu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231008
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718231008,
					"content": "Năm ngoái tôi suýt quên thả đèn tiêu, năm nay không thể quên được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231009
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718231009,
					"content": "Bạn muốn ước gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718231010
					]
				},
				{
					"id": 718231010,
					"content": "Ừm... Mong người của Khinh Sách Trang đều khỏe mạnh? Hihi, gần như là vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231011
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718231011,
					"content": "Nhưng mà nguyện vọng nói ra sẽ mất linh, không nói cho bạn nghe đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231012
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718231012,
					"content": "Những thứ này cho bạn, cảm ơn bạn đã giúp đỡ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhi"
				}
			]
		},
