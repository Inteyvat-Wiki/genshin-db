			"dialogs": [
				{
					"id": 200170101,
					"content": "Đừng, đừng đánh tôi! Đừng... hở? Nhà Lữ Hành, cái đám đó đâu? Đã bị bạn đuổi đi rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170102
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 200170102,
					"content": "Thật tốt quá! Cám ơn bạn... bọn chúng đi hết rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170103
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 200170103,
					"content": "Phù... may mà có bạn, nhưng bị chậm mất rồi, tôi sẽ không theo kịp đội buôn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170104
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 200170104,
					"content": "Mà xe cũng bị đám này làm hỏng rồi, phải nhanh chóng sửa lại rồi chuyển về thành, nếu không thì trái cây sẽ bị hỏng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170105
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 200170105,
					"content": "Bạn sẽ không muốn biết đâu, sau khi trái cây để trên xe bị hỏng, có một cái mùi không tẩy sạch được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170106
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 200170106,
					"content": "Tôi phải kiểm tra lại hết một lượt trái cây ở đây, tôi đã ngửi thấy nhiều trái cây bị hư rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170107
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 200170107,
					"content": "Phiền bạn hãy đi tìm vật liệu sửa xe ở xung quanh đây giúp tôi, một <color=#00E1FFFF>thanh gỗ chắc chắn</color> là đủ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Farrah"
				}
			]
		},
