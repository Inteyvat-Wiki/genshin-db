			"dialogs": [
				{
					"id": 250250101,
					"content": "Nào, lên bờ một lát được không? Ta còn phải dọn dẹp cái hồ bên này đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250250102
					],
					"speakerTitle": "Pele Nui"
				},
				{
					"id": 250250102,
					"content": "Grào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250250103
					],
					"speakerTitle": "Koholasaurus Lười Biếng"
				},
				{
					"id": 250250103,
					"content": "Bé cưng, lên đây nào! Nếu không thì ta sẽ bế ngươi lên đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250250104
					],
					"speakerTitle": "Pele Nui"
				},
				{
					"id": 250250104,
					"content": "Grào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250250105
					],
					"speakerTitle": "Koholasaurus Lười Biếng"
				},
				{
					"id": 250250105,
					"content": "Ối... Lại bơi đi mất rồi. Thế này làm sao bế được nó lên đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250250106
					],
					"speakerTitle": "Pele Nui"
				},
				{
					"id": 250250106,
					"content": "Cô đang làm gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250250107
					]
				},
				{
					"id": 250250107,
					"content": "#{F#Cô}{M#Cậu} đến tắm suối nước nóng sao? Xin lỗi, tôi đang dọn dẹp hồ bên này, chắc phải chờ một chút rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250250108
					],
					"speakerTitle": "Pele Nui"
				},
				{
					"id": 250250108,
					"content": "Hơn nữa, đứa nhóc này nói thế nào cũng không chịu lên bờ. Haiz... Tôi còn rất nhiều hồ cần dọn dẹp nữa đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250250109
					],
					"speakerTitle": "Pele Nui"
				},
				{
					"id": 250250109,
					"content": "Chẳng lẽ do mấy hôm trước tôi cố tình bế nó ra ngoài, nên khiến nó giận rồi sao? Thật là khó khăn mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pele Nui"
				}
			]
		},
