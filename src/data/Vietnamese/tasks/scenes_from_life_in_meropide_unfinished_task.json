					"nextDialogs": [
						740630509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740630509,
					"content": "Có vấn đề gì sao? Tôi thấy tuyệt lắm mà! Tiền bối sẽ không ngờ tới cho mà xem.",
