					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630510,
					"content": "Thật không hiểu nổi tiêu chuẩn của cô luôn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740630511,
					"content": "Ôi, đây là \"ý nghĩa của biểu tượng lớn hơn nội dung thực tế\". Tôi tin tiền bối sẽ hiểu được ý nghĩa của nó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630512
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630512,
					"content": "Dù sao thì cũng cảm ơn các vị đã giúp đỡ, cái này cho các vị. Hihi, lần sau nếu có thể nói chuyện với nhau ở chỗ câu cá thì tốt quá rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630506,
					"content": "Quá sống động, giống như đang cử động luôn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630507
					]
				},
				{
					"id": 740630507,
