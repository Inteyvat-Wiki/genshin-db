			},
			"dialogs": [
				{
					"id": 740630201,
					"content": "Ồ? Sao trong này lại có máy chụp ảnh nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740630202,
					"content": "\"Nơi có tin tức thì sẽ có máy chụp ảnh\", hai người chưa từng nghe câu nói này sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630203,
						740630206
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630203,
					"content": "Hình như có nghe rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630204
					]
				},
				{
					"id": 740630204,
					"content": "Nghe thấy ở đâu đấy? Câu đó tôi vừa mới bịa ra mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630205
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630205,
					"content": "Ôi, quả nhiên trên đời này vốn dĩ không có thứ gì mới lạ cả. Mặc kệ tôi nói cái gì, viết cái gì, đều giống như bắt chước người khác ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630208
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630208,
					"content": "Máy chụp ảnh đã có đây rồi, nhưng tin tức ở đâu đây?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630209
					]
				},
				{
					"id": 740630209,
					"content": "Tin tức... cũng giống như câu cá vậy. Phải kiên nhẫn chờ đợi, cho ra phán đoán chính xác vào thời điểm thích hợp, như thế mới có thể câu được cá lớn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630210
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630210,
					"content": "À không, ý tôi là, như thế mới có thể câu được tin tức nổi bật. Hửm? Hình như cũng không đúng lắm, thôi kệ đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630211,
						740630213
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630211,
					"content": "Nghe có vẻ nghiệp dư ghê. Cô là phóng viên sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630212
					]
				},
				{
					"id": 740630212,
					"content": "Nhầm rồi. Tôi là phóng viên nghiệp dư.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630222
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630222,
					"content": "Vả lại, tại sao phóng viên nghiệp dư lại ở đây chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740630223,
					"content": "Để hoàn thành đề bài mà tiền bối đã giao cho tôi, chính là dùng máy ảnh chụp lấy khoảnh khắc sinh động khi cai ngục Pháo Đài Meropide đang làm việc!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630224
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630224,
					"content": "Nhưng lúc trước vì giải quyết giấy tờ có liên quan nên tốn khá nhiều thời gian... Cứ xem thử đây này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630225
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630225,
					"content": "Nelly lấy ra một xấp giấy tờ, viết chi chít đủ loại điều khoản với ký tên. Nhìn thôi đã thấy chóng mặt...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740630226
					]
				},
				{
					"id": 740630226,
					"content": "Lo liệu xong toàn bộ quá trình này thì đã quá giờ trực ban rồi. Nếu dùng câu cá để ví dụ thì bây giờ hết cá để câu rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630227
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630227,
					"content": "Hả? Nhưng lúc này vẫn đang có cai ngục trực ban mà?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740630228,
					"content": "Nhưng tôi muốn câu Phiên Bản Bạch Kim ấy, nếu như chọn Chức Năng Cơ Bản hoặc Dọn Dẹp Biển Sâu thì cứ có cảm giác thiếu ấn tượng... Cho dù hoàn thành được đề bài đi nữa, tiền bối chắc chắn cũng sẽ không khen tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630229,
						740630230
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630229,
					"content": "Nếu không muốn trắng tay thì đừng kén chọn nữa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630233
					]
				},
				{
					"id": 740630233,
					"content": "Nói đúng lắm, tôi nên nhìn thẳng vào năng lực của mình, không mơ mộng nữa... Hic, tôi là một thợ câu vô dụng... À không, là phóng viên nghiệp dư vô dụng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630234
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630234,
					"content": "Được rồi, than thở xong rồi thì phải lấy lại tinh thần thôi! Có thể nhờ các vị giúp tôi một chuyện không? Tôi sẽ trả thù lao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630235
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630235,
					"content": "Cô nhanh thật đấy... Nhưng giúp đỡ thì cũng phải xem nội dung là gì đã. Cô nói yêu cầu ra trước đi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740630236,
					"content": "Cai ngục bên đó tên là Grainville, theo suy đoán của tôi thì giá trị tin tức của anh ấy tương đương với Robot Bảo Trì Xử Lý Tình Huống...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630237
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630237,
					"content": "Nếu chụp ảnh anh ấy thì mới có thể hoàn thành công việc. Tiền bối sẽ không thể nói gì được nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630238
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630238,
					"content": "Nhưng anh ấy không hề đi qua bên này! Các vị có thể dẫn anh ấy tới chỗ thích hợp để tôi chụp ảnh không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630239,
						740630241
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630239,
					"content": "Cô cứ nói rõ tình hình với anh ấy là được rồi mà?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630240
					]
				},
				{
					"id": 740630240,
					"content": "Như vậy thì anh ấy sẽ đơ lắm, khác gì với tạo dáng chụp ảnh chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630243
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630243,
					"content": "Tôi nghĩ trước tiên cứ tắt loa đi, sau đó báo với Grainville, nói loa bên này bị trục trặc, nhờ anh ấy đến xem thử.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630244
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630244,
					"content": "Như vậy thì sẽ chụp được tấm ảnh cai ngục Pháo Đài Meropide đang làm việc cực kỳ sinh động rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630245
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630245,
					"content": "Đề bài này hoàn thành hay không đều trông cậy vào hai vị đó! Hãy giúp tôi nhé!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630246
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630246,
					"content": "#Nghe cũng không khó lắm. {NICKNAME}, chúng ta giúp cô ấy đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740630241,
					"content": "Thế thì cầm máy ảnh đi qua kia là được mà?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630242
					]
				},
				{
					"id": 740630242,
					"content": "Nhưng mà chụp bên này đẹp hơn. Hơn nữa nếu để cho anh ấy nhìn thấy máy ảnh thì nhất định sẽ để ý tới nó, cuối cùng chụp ra một bức ảnh cứng ngắc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630243
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630230,
					"content": "Vậy thì cô chờ tiếp đi nhé, tạm biệt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630231
					]
				},
				{
					"id": 740630231,
					"content": "Cứ vậy mà đi sao? Không giúp đỡ tôi à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630232
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630232,
					"content": "Chúng tôi cũng đâu thể biến thành Phiên Bản Bạch Kim mà cô muốn chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740630213,
					"content": "Đừng nhắc tới tin tức nữa, tôi cũng thích câu cá lắm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630214
					]
				},
				{
					"id": 740630214,
					"content": "Thật sao? Vậy thì tốt quá, thật ra tôi chỉ là tay mơ thôi, đang có vài thắc mắc không biết hỏi ai. Ví dụ như câu phải Robot Bảo Trì, nhưng nó lại cắn người... Nếu vậy thì phải xử lý như thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630215,
						740630216,
						740630217
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630215,
					"content": "Cứ thả đi là được rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630219
					]
				},
				{
					"id": 740630219,
					"content": "Thì ra là thế. Ừm, cũng có giá trị tham khảo lắm, tôi sẽ ghi nhớ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630220
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630220,
					"content": "...Ơ! Sao lại nói tới câu cá rồi? Hai người giỏi dẫn dắt chủ đề ghê! Xem ra phóng viên nghiệp dư như tôi còn rất nhiều điều phải học hỏi đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630221
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630221,
					"content": "Do cô nói trước mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740630216,
					"content": "Đương nhiên là đánh nó một trận rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630219
					]
				},
				{
					"id": 740630217,
					"content": "Nấu lên mời Paimon thưởng thức.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630218
					]
				},
				{
					"id": 740630218,
					"content": "#Chà, tuy tôi tin tưởng vào tài nấu nướng của {NICKNAME}, nhưng thứ đó nhìn thế nào cũng không giống có thể ăn được mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740630206,
					"content": "Chưa nghe thấy bao giờ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630207
					]
				},
				{
					"id": 740630207,
					"content": "Ồ! Vậy thì bây giờ nghe thấy rồi đấy. Nhớ kỹ, nếu nhìn thấy nơi khác trích dẫn thì phải bảo họ ghi nguồn vào nhé! Chính là tôi đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630208
					],
					"speakerTitle": "Nelly"
				}
			]
		},
		{
