				},
				{
					"id": 762260102,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260103
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 762260103,
					"content": "Hihi, không cần khách sáo đâu. Dù sao thì trong những bức tranh này cũng có công lao của chúng tôi mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762260104,
					"content": "Paimon hiểu được lời của Maalaus từ khi nào vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762260105
					]
				},
				{
					"id": 762260105,
					"content": "#Ây da, tôi đã cùng {NICKNAME} đến Sảnh Trăng Bạc bao nhiêu lần rồi, hiểu được ý của Maalaus cũng chẳng có gì lạ cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762260106,
					"content": "Vậy Maalaus nói tranh bị mất như thế nào?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762260107
					]
				},
				{
					"id": 762260107,
					"content": "Ừm... cái này... để tôi tìm hiểu xem... Maalaus nói...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762260108,
					"content": "Có thể là bị Kuuhenki khác trộm mất...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762260109,
					"content": "Ừm... cũng có thể là bị cơ quan vận chuyển thần kỳ trên mặt trăng trộm mất...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762260110,
					"content": "Ừm... còn có thể là do Columbina trộm mất nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762260111,
					"content": "Điều này tuyệt đối không thể nào!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762260112
					]
				},
				{
					"id": 762260112,
					"content": "Hả? Đúng nhỉ... Chẳng lẽ tôi hiểu sai ý rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762260113,
					"content": "Hóa ra chỉ là đoán mò thôi à.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762260114
					]
				},
				{
					"id": 762260114,
					"content": "Hừm, học ngoại ngữ đâu có dễ như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762260115,
					"content": "Tôi cần một giáo viên giỏi, khi nào có cơ hội, tôi sẽ nhờ Columbina chỉ dạy tận tình.",
					"roleType": "TALK_ROLE_NPC",
