			"dialogs": [
				{
					"id": 762260201,
					"content": "Ơ? Là Maalaus đây mà? Không ngờ lại gặp nhau trên mặt trăng, thật là ngoài sức tưởng tượng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762260202,
					"content": "Nhất định là Columbina đưa nhóc tới, đúng không? Dù sao cô ấy cũng từng nói sẽ đưa Maalaus lên mặt trăng để tổ chức triển lãm tranh mà.",
					"roleType": "TALK_ROLE_NPC",
