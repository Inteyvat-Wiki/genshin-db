					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 762260207,
					"content": "Sao lại như vậy? Đây là mặt trăng mà, chắc không thể nào là bị trộm mất chứ...",
					"roleType": "TALK_ROLE_NPC",
