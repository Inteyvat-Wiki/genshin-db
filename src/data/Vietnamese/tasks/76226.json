					"speakerTitle": "Paimon"
				},
				{
					"id": 762260203,
					"content": "À đúng rồi, nói đến triển lãm tranh... tranh của nhóc đâu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
