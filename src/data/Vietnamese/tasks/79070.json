				"points": []
			},
			"dialogs": [
				{
					"id": 790700101,
					"content": "Tôi đại diện cho Vương Quốc Chuông Gió, xin chào đón hai vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700102
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700102,
					"content": "Tiếp theo mọi người định làm thế nào?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700103
					]
				},
				{
					"id": 790700103,
					"content": "Hmm... Đầu tiên, tôi sẽ thông báo cho khắp vương quốc rằng thánh vật đã đưa ra phán quyết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700104
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700104,
					"content": "Và Người Bảo Vệ... chính là Faurobert từ xa đến đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700105
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700105,
					"content": "Tại sao phải làm như vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790700106,
					"content": "Nếu giải thích cho mọi người về những chuyện chúng tôi đã trải qua thì thật sự quá phức tạp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700107
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700107,
					"content": "Hơn nữa, trong chốc lát mọi người chắc cũng không hiểu được tại sao tôi lại vừa là công chúa, vừa là Người Bảo Vệ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700108
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700108,
					"content": "Đến thời điểm thích hợp, tôi sẽ ghi chép lại chi tiết mọi chuyện và thông báo cho tất cả thần dân dưới dạng văn bản.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700109
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700109,
					"content": "Trước đó, tôi vẫn sẽ xử lý các công việc của vương quốc với tư cách là công chúa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700110
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700110,
					"content": "Sau khi cải tạo xong \"sân thí luyện\" thành \"sân tập luyện\" thì tôi sẽ lên đường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700111,
						790700112
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700111,
					"content": "Lên đường?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700113
					]
				},
				{
					"id": 790700113,
					"content": "Công chúa điện hạ còn nhớ... Khi ở trong hang động, thánh vật đó rốt cuộc đã sáng lên vì ai không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700114
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700114,
					"content": "Hả? Sáng lên... vì ai ư?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700115
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700115,
					"content": "Đúng vậy, lúc đó chúng ta đều ở bên cạnh thánh vật. Công chúa điện hạ đương nhiên đáng được công nhận, nhưng tôi, tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700116
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700116,
					"content": "Anh là quán quân được quán quân công nhận.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700117
					]
				},
				{
					"id": 790700117,
					"content": "Đúng thế. Vị quán quân đó đến nhờ riêng anh, vậy còn có gì là không xứng được công nhận nữa chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790700118,
					"content": "Có lẽ vì hào quang của công chúa điện hạ quá lóa mắt, làm cho mọi người đều hiểu lầm rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700119
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700119,
					"content": "Vậy thì quán quân, anh có sẵn sàng trải qua thí luyện một lần nữa không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700120
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700120,
					"content": "Tôi, công chúa Cimest của Vương Quốc Chuông Gió, sẽ đích thân dùng thánh vật làm chứng cho anh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700121
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700121,
					"content": "Tất nhiên! Tôi sẵn sàng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700122,
						790700123
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700122,
					"content": "Đừng kích động quá...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700124
					]
				},
				{
					"id": 790700124,
					"content": "Chỉ cần nhắc đến công chúa điện hạ là đã kích động thế này. Haha, Faurobert...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790700125,
					"content": "Mọi người đừng hiểu lầm! Tôi, tôi là vì sứ mệnh của Ao Khúc Hát Mưa thôi! Tôi đã trải qua bao nhiêu đợt huấn luyện, chính là để cứu... ừm, bảo vệ công chúa điện hạ đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700126
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700126,
					"content": "Với nhiệm vụ quan trọng như vậy, tất nhiên tôi phải đảm bảo tuyệt đối không có sai sót rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700127
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700127,
					"content": "Anh có bằng lòng đồng hành với công chúa điện hạ không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700128
					]
				},
				{
					"id": 790700128,
					"content": "Bằng, bằng lòng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700129
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700129,
					"content": "Haha, vậy là tốt rồi. Vậy thì quán quân Faurobert, anh đã sẵn sàng tiếp nhận thí luyện của tôi chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700130
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700130,
					"content": "Vâng, công chúa điện hạ! Bất cứ lúc nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700131
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700131,
					"content": "Woa! Thánh vật lại sáng lên rồi! Sáng, sáng quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790700123,
					"content": "Đau, đau tai quá.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700124
					]
				},
				{
					"id": 790700112,
					"content": "Cô muốn đi đâu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700113
					]
				}
			]
		},
		{
			"id": 7907002,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
