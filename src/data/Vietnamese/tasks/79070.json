				"points": []
			},
			"dialogs": [
				{
					"id": 790700201,
					"content": "Estampe! Anh đã đi đâu bấy lâu nay vậy!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700202
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700202,
					"content": "Khụ, tôi đi dạo xung quanh để thử thí luyện đó. Khá thú vị đấy, nhưng cần phải dùng cách khác để vượt qua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700203
					],
					"speakerTitle": "Estampe"
				},
				{
					"id": 790700203,
					"content": "Horellou đã kể cho tôi nghe chuyện của mọi người rồi. Tuyệt thật, Người Bảo Vệ, anh rất có bản lĩnh đấy nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700204
					],
					"speakerTitle": "Estampe"
				},
				{
					"id": 790700204,
					"content": "Anh, anh, anh... Nếu anh ở bên cạnh tôi, chắc chắn tôi sẽ đẩy anh ra giúp tôi! Có mười lần thì tôi sẽ đẩy anh ra cả mười!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700205
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700205,
					"content": "Chính vì vậy nên tôi mới đi thí luyện đấy. Faurobert, tôi tin anh có thể xử lý được mà. Thấy chưa, anh đã làm được rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700206
					],
					"speakerTitle": "Estampe"
				},
				{
					"id": 790700206,
					"content": "Hahaha, hôm nay quả là ngày may mắn cho Ao Khúc Hát Mưa của chúng ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700207
					],
					"speakerTitle": "Horellou"
				},
				{
					"id": 790700207,
					"content": "Cuối cùng chúng ta cũng có một quán quân chân chính rồi. Mặc dù Faurobert chưa có cơ hội giải cứu công chúa, nhưng tôi tin rằng sẽ có chỗ cho anh ấy thể hiện tài năng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700208
					],
					"speakerTitle": "Horellou"
				},
				{
					"id": 790700208,
					"content": "Haiz... Tôi chẳng hề làm gì cả, Horellou à. Tôi chỉ đứng nhìn thôi, mọi chuyện đều do công chúa lo liệu mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700209
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700209,
					"content": "Vậy không tốt hơn sao? Chẳng lẽ anh muốn công chúa gặp nguy hiểm ư?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700210
					],
					"speakerTitle": "Horellou"
				},
				{
					"id": 790700210,
					"content": "Tôi... Chuyện này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700211
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700211,
					"content": "Được rồi. Faurobert, anh chính là người được vị Cibrelus kia đích thân giao phó sứ mệnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700212
					],
					"speakerTitle": "Horellou"
				},
				{
					"id": 790700212,
					"content": "Tôi còn chẳng biết rốt cuộc đó có phải là Cibrelus không nữa! Tôi chỉ nghe kể về anh ấy, chứ chưa từng nghe anh ấy nói chuyện qua!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700213
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700213,
					"content": "Hơn nữa, anh còn tiếp nhận thí luyện của công chúa nữa. Thật không hổ danh là quán quân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700214
					],
					"speakerTitle": "Estampe"
				},
				{
					"id": 790700214,
					"content": "Chúng ta có thể tạm gác lại chuyện này không? Đi mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700215
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700215,
					"content": "Tóm lại, tương lai của Ao Khúc Hát Mưa chúng ta phụ thuộc vào anh cả đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700216
					],
					"speakerTitle": "Horellou"
				},
				{
					"id": 790700216,
					"content": "Bây giờ, cuối cùng chúng ta cũng có thể thoải mái nhảy rồi. Khi về tôi sẽ đề xuất với ban tổ chức thêm nhiều nội dung thú vị vào nội dung thi nhảy xa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700217
					],
					"speakerTitle": "Horellou"
				},
				{
					"id": 790700217,
					"content": "Đó là một ý kiến hay, tôi sẵn sàng ủng hộ. Chúng ta về thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700218
					],
					"speakerTitle": "Estampe"
				},
				{
					"id": 790700218,
					"content": "Mọi người đừng bỏ tôi lại đây chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Faurobert"
				}
			]
		},
		{
			"id": 7907003,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
