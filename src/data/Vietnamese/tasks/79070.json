			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cimest",
					"Saborn",
					"Souffache"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790700301,
					"content": "Cô và vị ếch giấy đó, cả hai đều được công nhận là Người Bảo Vệ sao?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700302
					],
					"speakerTitle": "Saborn"
				},
				{
					"id": 790700302,
					"content": "Không thể tin được, chưa nghe bao giờ! Trước đây cũng chưa từng có ghi chép nào về việc này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700303
					],
					"speakerTitle": "Souffache"
				},
				{
					"id": 790700303,
					"content": "Hơn nữa, cô còn muốn cải tạo lại thí luyện sao... Không được! Không được đâu! Công chúa điện hạ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700304
					],
					"speakerTitle": "Saborn"
				},
				{
					"id": 790700304,
					"content": "Cô không thể tùy ý thay đổi truyền thống lâu đời nay được! Công chúa điện hạ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700305
					],
					"speakerTitle": "Souffache"
				},
				{
					"id": 790700305,
					"content": "Được rồi, hai người nói nhỏ thôi, tai tôi sắp điếc cả rồi đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700306
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700306,
					"content": "Chuyện đã được quyết định rồi. Hiện giờ tôi vừa là công chúa, vừa là Người Bảo Vệ được thánh vật công nhận, hai người không thể ngăn cản tôi được nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700307
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700307,
					"content": "Nhưng mà, công chúa điện hạ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700308
					],
					"speakerTitle": "Saborn"
				},
				{
					"id": 790700308,
					"content": "Hai người cứ yên tâm. Tôi sẽ chủ trì nghi lễ luyện tập, huấn luyện ra nhiều sóc bay đáng tin cậy để bảo vệ vương quốc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700309
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700309,
					"content": "Sau đó, tôi mới rời khỏi vương quốc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700310
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700310,
					"content": "Điện hạ, chúng tôi... Haiz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700311
					],
					"speakerTitle": "Souffache"
				},
				{
					"id": 790700311,
					"content": "Yên tâm đi. Tôi sẽ tự chăm sóc bản thân mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700312
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700312,
					"content": "Công chúa tôi đây, cuối cùng cũng phải tự mình đối mặt với gió lớn bên ngoài rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700313
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700313,
					"content": "...Tuân lệnh, công chúa điện hạ.",
					"roleType": "TALK_ROLE_NPC",
