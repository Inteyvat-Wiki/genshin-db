					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710640201,
					"content": "(Một bia đá nhỏ, nội dung trên đó như sau...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640202
					],
					"speakerTitle": "Bia Đá"
				},
				{
					"id": 710640202,
					"content": "...\"Sau trận chiến ở Vực Đá Sâu, tôi tứ chi tàn phế, chỉ nhờ vào khẩu hình để nhờ người ghi chép lại ở nơi này.\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640203
					],
					"speakerTitle": "Bia Đá"
				},
				{
					"id": 710640203,
					"content": "...\"Trong trận ác chiến, tuy giữ được tính mạng, nhưng mỗi giây phút đều nhớ đến các đồng bào, đêm đêm khó chợp mắt. Huống chi giờ đây thân thể tàn phế, chỉ hận không thể đi theo các vị.\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640204
					],
					"speakerTitle": "Bia Đá"
				},
				{
					"id": 710640204,
					"content": "...\"Tự tử bất thành, Đế Quân nghe được, mắng chửi một trận, nay đã tỉnh ngộ kịp thời.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640205
					],
					"speakerTitle": "Bia Đá"
				},
				{
					"id": 710640205,
					"content": "...\"Tiếc thay đế quân nhân từ, ban cho Thiên Nham mũ giáp, nhưng không thể báo đáp ân tình, giữ lại cũng chỉ phủ bụi mà thôi, nên đặt ở đây, chờ người hữu duyên nhận lấy.\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640206
					],
					"speakerTitle": "Bia Đá"
				},
				{
					"id": 710640206,
					"content": "...\"Các vị, kiếp này đã không còn cơ hội, hy vọng kiếp sau vẫn được làm đồng bào của nhau, cùng nhau nâng cao chén rượu thề, cùng nhau đẩy lui kẻ địch của Liyue.\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bia Đá"
				}
			]
		},
		{
			"id": 7106403,
			"completionStepIds": [
				7106411
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7106411",
							"2"
						],
						"stepId": 7106411,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Wang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710640301,
					"content": "Thật không ngờ hai người lại tìm được... đây chính là \"Kho Báu Của Thiên Nham Quân\" sao...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640302
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640302,
					"content": "Tuy không biết trong có chứa cái gì, nhưng mà... báu vật này được bạn tìm thấy thì Thiên Nham Quân của năm xưa xem như cũng đã được an ủi phần nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640303
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640303,
					"content": "Đã 500 năm kể từ khi trận tai họa đó diễn ra, mỗi khi nghĩ đến trận chiến khiến vô số người phải hy sinh đó tôi đều tự hỏi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640304
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640304,
					"content": "Trong thời đại đó, vô số dân thường đi theo Nham Vương Gia chinh chiến, mỗi người trong số họ đều cho rằng bản thân đang tham gia vào một trận chiến được khắc cốt ghi tâm cả ngàn năm sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640305
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640305,
					"content": "Không lẽ họ chưa từng nghi ngờ trách nhiệm của mình? Những người không có Vision lại trung thành với một vị thần chưa từng dõi theo họ, có chết cũng không tiếc sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640306,
						710640307
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640306,
					"content": "Bởi vì thần chưa bao giờ rời xa họ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710640308
					]
				},
				{
					"id": 710640308,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640309
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640309,
					"content": "Ừm, bạn nói đúng, có Vision cũng được, không có cũng được... con người sẽ luôn cố gắng vì tương lai. Đó chính là động lực đúng không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640310
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640310,
					"content": "Chúng ta cũng vậy, không phải là vì những ngày tháng huy hoàng đã qua, cũng không phải vì chúng ta của hiện tại... mà chính là vì cùng nhau để lại tiếng nói và dấu ấn của mình trong thời đại này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640311
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640311,
					"content": "Có thể rất lâu sau này, Vực Đá Sâu cũng sẽ trở thành tấm bia kỷ niệm của chúng ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640314
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640314,
					"content": "Nơi đây đầy rẫy những vết đào bới, thấm đẫm mồ hôi nước mắt của bao thế hệ thợ mỏ... Nơi đây cũng chứng kiến con đường gian nan mà chúng tôi đã chọn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640312
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640312,
					"content": "Cũng giống như bia đá kỷ niệm này vậy, trăm năm sau, không, cả ngàn năm sau cũng sẽ đứng vững tại đây, làm chứng cho sự hy sinh của các tướng sĩ là không hề vô ích.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640313
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640313,
					"content": "Haha, tuy lúc đó tôi sẽ không thể thấy được... nhưng hy vọng lúc đó sẽ có người dâng rượu lên cho tôi, như vậy thì tôi cũng đã mãn nguyện rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640307,
					"content": "Bởi vì họ trung thành với sự lựa chọn của mình.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710640308
					]
				}
			]
		},
