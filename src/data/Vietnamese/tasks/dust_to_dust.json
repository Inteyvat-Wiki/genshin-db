			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Childe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10031801,
					"content": "Các bạn cuối cùng đã về rồi, hành trình Tuyệt Vân Gián thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031802
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031802,
					"content": "...Hóa ra là vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031806,
					"content": "Chưa từng được gặp tất cả tiên nhân... theo cách nói của họ thì là \"không có duyên phận\" đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031807
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031807,
					"content": "Không sao! Nếu có thời gian thì đi thử vận may cũng tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031808
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031808,
					"content": "#Mà tin tình báo của Hàng Ma Đại Thánh đã rất quý báu rồi. Để đền đáp, tôi cũng có tin tức dành cho {F#cô}{M#cậu}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031809
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031809,
					"content": "Đối với cái chết của thần, phản ứng của Thất Tinh Liyue vô cùng tế nhị...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031810
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031810,
					"content": "Bọn họ tuyên bố, bởi chưa tìm được thủ phạm thực sự, không cho phép bất cứ ai chiêm ngưỡng Tiên Tổ Pháp Thoái.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031811
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031811,
					"content": "Thậm chí còn thử phong tỏa tin tức... nhưng rốt cuộc Điển Lễ Thỉnh Tiên nhiều người qua lại, cho dù là Thất Tinh cũng khó mà ngăn cấm được lời đồn đại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031812
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031812,
					"content": "Tiên Tổ Pháp Thoái?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10031813,
					"content": "Về mặt thường thức Liyue mà nói, Nham Vương Đế Quân cũng là một tiên nhân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031814
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031814,
					"content": "Nham Thần là thần khế ước, đồng thời cũng được gọi là Chúng Tiên Tổ Sư.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031815
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031815,
					"content": "Tất cả \"Tam Nhãn Ngũ Hiển Tiên Nhân\" ngày nay, đều đã từng lập khế ước bảo vệ Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031816
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031816,
					"content": "Vậy à... thảo nào đối với việc của Liyue bọn họ lại để tâm như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031817
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10031817,
					"content": "Không sai, bọn họ có trách nhiệm, cũng có tư cách.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031818
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031818,
					"content": "Nếu Thất Tinh cai trị Liyue xảy ra vấn đề, bọn họ sẽ có tư cách khởi binh vấn tội.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031819
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031820,
					"content": "Điều này cũng là rắc rối lớn với tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10031822
					]
				},
				{
					"id": 10031821,
					"content": "Tôi cũng không đồng ý cách này.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10031822
					]
				},
				{
					"id": 10031819,
					"content": "Linh hồn của Nham Thần bay lên trời cao, lưu lại thân xác, tại sao lại bị Thất Tinh giấu kín? Thật sự đáng nghi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031820,
						10031821
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031822,
					"content": "A! Không sai! Chúng tôi đến tìm vị thần linh này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031823
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10031823,
					"content": "Nếu như Thất Tinh Liyue đem Tiên Tổ Pháp Thoái cất giấu, không để bất cứ ai đến gần...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031824
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10031824,
					"content": "#Mục tiêu của {NICKNAME} muốn tìm gặp tất cả bảy vị thần xem như đã hoàn toàn vô vọng rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031825
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10031826,
					"content": "Không liên quan đến anh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10031828
					]
				},
				{
					"id": 10031827,
					"content": "Không có gì để nói.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10031828
					]
				},
				{
					"id": 10031825,
					"content": "Hả? Các bạn đang tìm kiếm bảy vị thần? Để làm gì chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031826,
						10031827
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031828,
					"content": "Hì... Câu trả lời không tồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031829
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031829,
					"content": "Kỵ sĩ dễ dàng bị Fatui chế giễu, không phải là Kỵ Sĩ tốt, đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031830
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031830,
					"content": "#Chẳng qua... lần này, tôi có thể giúp đỡ {F#cô}{M#cậu}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031831
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031831,
					"content": "Í? Thật vậy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031832
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10031832,
					"content": "Cho tôi chút thời gian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031833
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031833,
					"content": "Một chút thời gian... để đi tìm người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031834
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031834,
					"content": "#Tôi sẽ tìm ra cho {F#cô}{M#cậu}, người có thể thay đổi tình thế này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031835
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031835,
					"content": "Ha... Thật là thú vị. Càng kìm nén càng yên lặng, cuối cùng khi bùng nổ lại càng mãnh liệt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031836
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031836,
					"content": "Để có thể tận mắt nhìn thấy bờ bị dòng nước ngầm rẽ đôi, nhất định phải sống để gặp lại tôi đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Childe"
				}
			]
		},
