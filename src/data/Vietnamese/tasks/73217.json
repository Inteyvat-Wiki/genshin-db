					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171001,
					"content": "\"Dạo này Mahamata được phái xuống càng lúc càng vô dụng, hỏi gì cũng không biết cả.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171002
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732171002,
					"content": "\"Huống hồ bây giờ đã mở quyền hạn Akasha, trình độ của những Mahamata ngoài ngành này còn chẳng bằng tôi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171003
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732171003,
					"content": "\"Chỉ có Quan Thư Ký đại nhân mà không gặp thường xuyên ấy, lần trước còn giúp chúng tôi sắp xếp lịch trình điều động thuyền bè. Xem ra Giáo Viện không phải chỉ toàn là đám nấm ngu.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Thông Báo"
				}
			]
		},
		{
			"id": 7321711,
			"completionStepIds": [
				7321711
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321711",
							"2"
						],
						"stepId": 7321711,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171101,
					"content": "\"Kể từ khi tiền bối Cyno lên làm Tổng Quản Mahamatra, dù nhiều việc cần làm hơn, nhưng vì không cần phải dính líu vào cuộc đấu tranh của các học phái nhàm chán nữa nên cũng cảm thấy nhẹ nhõm hơn nhiều.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171102
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732171102,
					"content": "\"Bằng không thì tôi cũng không thể nhân lúc đi công tác điều tra mà đến đây để lười biếng được.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171103
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732171103,
					"content": "\"Không biết dạo này tiền bối Cyno đi đâu nữa, viết ở đây chắc anh ta không thấy đâu nhỉ.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171104
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732171104,
					"content": "\"Tôi thấy rồi. Hãy đến báo cáo trước trưa mai và chịu hình phạt.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171105
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732171105,
					"content": "\"Đừng lãng phí thời gian của tôi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Thông Báo"
				}
			]
		},
		{
			"id": 7321712,
			"completionStepIds": [
				7321712
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321712",
							"2"
						],
						"stepId": 7321712,
