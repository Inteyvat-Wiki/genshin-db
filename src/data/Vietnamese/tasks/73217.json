			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732170101,
					"content": "Đây là bảng thông báo do Quản Lý Cảng Vụ Cảng Ormos lập ra, vấn đề quan trọng trong ngoài Cảng Ormos đều được thông báo ở đây, nếu có vấn đề gì cũng có thể để lại tin nhắn ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Thông Báo"
				}
			]
		},
		{
			"id": 7321702,
			"completionStepIds": [
				7321702
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321702",
							"2"
						],
						"stepId": 7321702,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732170201,
					"content": "\"Còn đang buồn phiền về hình thức luận văn sao? Còn tìm ý tưởng luận văn ở khắp nơi không? Đã đến lúc thử phương pháp mới rồi đấy!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170202
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732170202,
					"content": "\"Tôi vốn xuất thân từ Học Phái Haravatat, và thành thạo luôn cả Học Phái Spantamad và Học Phái Kshahrewar, tiếp nhận hướng dẫn viết luận văn và giải đáp nghi vấn.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170203
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732170203,
					"content": "\"Đã đến lúc thoát khỏi bể khổ rồi, đến nhà trọ tìm ngài Amandeep đi, có thể thương lượng về giá cả đấy.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170204
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732170204,
					"content": "\"Có thể viết thay không?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170205
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732170205,
					"content": "\"Không được, quan giám sát đại nhân sẽ không cho phép điều đó xảy ra.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170206
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732170206,
					"content": "\"Đúng thế, hãy nỗ lực học hỏi, đừng suy nghĩ lệch lạc.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Thông Báo"
				}
			]
		},
		{
			"id": 7321703,
			"completionStepIds": [
				7321703
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321703",
							"2"
						],
						"stepId": 7321703,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732170301,
					"content": "Bạn có nghe nói về thuật bay lượn chưa? Bạn nhìn thấy người bay trong không trung chưa? Bạn muốn biết bí mật ẩn giấu phía sau Thú Thồ Hàng biết bay không? Vậy thì đừng bỏ lỡ buổi biểu diễn đầu tiên của Đoàn Nghệ Thuật Bay Lượn Fontaine tại Sumeru nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170302
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732170302,
					"content": "Hoan nghênh ghé đến, đừng lỡ mất cơ hội, đến lúc nào xem lúc đó, chỉ cần 5 Mora là có thể thưởng thức một màn trình diễn nghệ thuật đặc biệt này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170303
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732170303,
					"content": "\"Thật sự rất đặc sắc, ở Fontaine tôi chưa từng xem qua màn trình diễn xuất sắc như vậy!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Thông Báo"
				}
			]
		},
		{
			"id": 7321704,
			"completionStepIds": [
				7321704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321704",
							"2"
						],
						"stepId": 7321704,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732170401,
					"content": "Nhắc nhở đặc biệt, toàn bộ ngành lính đánh thuê của Sumeru đều do \"Eremite\" tiếp nhận, không có bên nào khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170402
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732170402,
					"content": "Đừng dễ dàng tin tưởng người khác, đề phòng bị người không rõ lai lịch gạt mất tiền thuê.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170403
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732170403,
					"content": "Nếu cần thuê vệ sĩ, thủ vệ, hoặc là những ủy thác khác nữa, hãy liên hệ với đội trưởng Feroz đóng quân ở Cảng Ormos của \"Lữ Đoàn 30\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Thông Báo"
				}
			]
		},
		{
			"id": 7321705,
			"completionStepIds": [
				7321705
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
