			"dialogs": [
				{
					"id": 732170801,
					"content": "Nhà trọ lớn nhất Cảng Ormos cung cấp dịch vụ tận tâm nhất cho các thương khách.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170802
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732170802,
					"content": "Lữ khách vào ở nếu có học tịch ở Giáo Viện sẽ có thêm ưu đãi đặc biệt nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170803
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732170803,
					"content": "Nếu có hàng hóa cần lưu trữ trong kho, hãy liên hệ với Nhà Trọ Wikala.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Thông Báo"
				}
			]
		},
		{
			"id": 7321709,
			"completionStepIds": [
				7321709
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
