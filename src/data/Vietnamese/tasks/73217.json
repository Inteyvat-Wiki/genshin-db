					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732170901,
					"content": "\"Tuy dịch vụ của Nhà Trọ Shapur không tệ, nhưng cách âm kém quá.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170902
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732170902,
					"content": "\"Ban đầu thấy vật giá ở Cảng Ormos rẻ nên mới quyết định ở lại nơi này để chuẩn bị cho kỳ thi, xem ra tôi vẫn nên dọn vào trong Thành Sumeru mới ổn.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170903
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732170903,
					"content": "\"Nếu năm nay vẫn không thi đậu, thì đành phải về quê làm ruộng rồi. Không biết lúc đó có thể mang một chút \"Kiến Thức Màu Mỡ\" về không...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Thông Báo"
				}
			]
		},
		{
			"id": 7321710,
			"completionStepIds": [
				7321710
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321710",
