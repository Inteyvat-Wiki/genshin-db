			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171801,
					"content": "\"Hiện tại đã khai thông tuyến đường đến Cảng Dornman, kính mời các bạn tham gia thương hội mua bán trái cây của chúng tôi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171802
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732171802,
					"content": "\"Đợi đã, theo như lộ trình từ nơi này đến Mondstadt thì nhập khẩu trái cây có vẻ đâu có ổn. Nếu bạn nói về mua bán rượu thì tôi có hứng thú hơn.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171803
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732171803,
					"content": "\"Nhắc đến nhập khẩu thì mọi người đều nghĩ được đến rượu ngon Mondstadt, nhưng trái cây nhập khẩu thì chỉ có ở chỗ chúng tôi, đây là cơ hội làm ăn, bạn hiểu không!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171804
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732171804,
					"content": "\"Huống chi đâu nhất thiết phải nhập hàng từ Mondstadt...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Thông Báo"
				}
			]
		},
		{
			"id": 7321719,
			"completionStepIds": [
				7321719
