			"dialogs": [
				{
					"id": 732172001,
					"content": "Hải thú xuất hiện!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732172002
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732172002,
					"content": "Gần đây hải thú đang gia tăng hoạt động, tàu thuyền rời cảng hãy chú ý thông tin cảnh báo từ Hải Đăng Pharos, hoặc tìm hiểu trước thông tin hàng hải thông qua thông báo của Mahamata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732172003
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732172003,
					"content": "Nếu có thắc mắc hãy liên hệ thủ vệ tháp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Thông Báo"
				}
			]
