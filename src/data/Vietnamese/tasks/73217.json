			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732170501,
					"content": "Tất cả thuyền bè cập cảng đều cần phải đăng ký thông tin tất cả mọi người và lý do cập cảng ở Quản Lý Cảng Vụ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170502
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732170502,
					"content": "Các thuyền buôn cần cung cấp thêm thông tin chi tiết về hàng hóa vận chuyển.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170503
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732170503,
					"content": "Thuyền buôn chưa đăng ký không được dỡ hàng hoặc triển khai hoạt động buôn bán ở đây, một khi phát hiện nhất định sẽ xử phạt nghiêm khắc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Thông Báo"
				}
			]
		},
		{
			"id": 7321706,
			"completionStepIds": [
				7321706
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321706",
							"2"
						],
						"stepId": 7321706,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732170601,
					"content": "Cảng đang điều tra gay gắt về hành vi buôn lậu, tất cả hàng hóa ra vào cảng đều cần phải đăng ký và tiếp nhận kiểm tra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170602
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732170602,
					"content": "Nếu phát hiện hàng hoá chưa được đăng ký hoặc vật phẩm nằm trong danh mục cấm xuất nhập cảng sẽ bị tịch thu toàn bộ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170603
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732170603,
					"content": "Tất cả hậu quả tạo thành sẽ do mọi người tự gánh vác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Thông Báo"
				}
			]
		},
		{
