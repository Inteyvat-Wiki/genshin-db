			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171401,
					"content": "\"Thuyết giáo của các bậc hiền giả thật khô khan, chi bằng rót đầy một ly rượu hoa, bắt đầu hành trình chinh phục bảy vùng biển.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Thông Báo"
				}
			]
		},
		{
			"id": 7321715,
			"completionStepIds": [
				7321715
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321715",
							"2"
						],
						"stepId": 7321715,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171501,
					"content": "Đối với thủy thủ, thương khách vãng lai, người dân trong ngoài thành, quy định của cảng đều được thông báo tại đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171502
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732171502,
					"content": "Nếu trong trường hợp có tranh chấp, hãy liên hệ Sheriff Shyam để được hỗ trợ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Thông Báo"
				}
			]
		},
		{
			"id": 7321716,
			"completionStepIds": [
				7321716
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321716",
							"2"
						],
						"stepId": 7321716,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171601,
					"content": "\"Thay vì du lịch Đại Khu Bazaar gì đó ở Thành Sumeru, chi bằng đến Thị Trấn Cũ của Cảng Ormos chúng tôi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171602
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732171602,
					"content": "\"So với Đại Khu Bazaar bị Mahamata khua tay múa chân làm cho thay đổi hoàn toàn, chỗ chúng tôi duy trì nhiều đặc sắc của Sumeru hơn.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171603
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732171603,
					"content": "\"Đương nhiên, nếu muốn xem biểu diễn vũ đạo thì phải đến Nhà Hát Zubayr rồi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171604
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732171604,
					"content": "\"Quê mùa đúng là quê mùa. Quy hoạch của Thành Sumeru được các học giả tận tâm thiết kế, phân vùng nơi đây đều tuân theo các nghiên cứu khoa học.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171605
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732171605,
					"content": "\"Trái lại có người chẳng hiểu biết gì lại phát ngôn xằng bậy ở đây, xem phố xá lộn xộn của Cảng Ormos như báu vật vậy!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171606
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732171606,
					"content": "\"Không nghe, không nghe, không nghe thấy gì hết!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Thông Báo"
				}
			]
		},
		{
			"id": 7321717,
			"completionStepIds": [
				7321717
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321717",
							"2"
						],
						"stepId": 7321717,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171701,
					"content": "\"Nhắc đến thì thật ngại quá. Chúng tôi vốn là công nhân phụ trách tu sửa thuyền buôn, kiếm sống bằng kỹ năng sửa chữa được truyền từ đời này sang đời khác.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171702
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732171702,
					"content": "\"Nhưng bắt đầu từ dạo trước, Akasha có thêm kỹ thuật mới, kinh nghiệm lúc trước đã không còn dùng được nữa. Người trẻ tuổi còn có thể học tập thông qua Akasha, nên những người lớn tuổi như chúng tôi đây chỉ còn cách đổi nghề thôi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171703
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732171703,
					"content": "\"Tuy là Quan Thư Ký đại nhân nói chúng tôi có thể ra biển thử vận may, nhưng vì không có tiền và cần thêm thời gian để chuẩn bị. Mọi người có công việc gì thì hãy tìm đến chúng tôi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171704
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732171704,
					"content": "\"Đừng nghe theo Quan Thư Ký kia, vừa hay tôi biết có chủ thuê cần thợ mộc, để tôi đề cử mọi người cho cô ấy. Mọi người cầm số tiền này trước đi, đừng cân nhắc chuyện ra biển gì nữa.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171705
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732171705,
					"content": "\"Mong anh bớt làm những chuyện vô ích đi. Có người thành công thì sẽ có người thất bại, đây là quy tắc vận hành của thế gian này, sao cứ phải ham làm người tốt rồi can thiệp vào làm gì?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171706
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732171706,
					"content": "\"Quan Thư Ký đại nhân của chúng ta lại bắt đầu giảng dạy chương trình chủ nghĩa thần bí rồi đấy. Tại sao thế? Tại như vậy sẽ làm tôi vui sao!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171707
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732171707,
					"content": "\"Anh cũng đừng quên rằng sự tương trợ, sự công bằng và sự phẫn nộ cũng chính là đạo lý thúc đẩy quy luật vận hành thế giới, chứ không phải luận điệu hoang đường như \"mạnh được yếu thua\" nhé.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171708
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732171708,
					"content": "\"Anh cũng đừng nhầm lẫn, cho đến giờ tôi chưa từng phủ định những gì anh nói, nhưng anh thật sự không hiểu tôi đang nói gì với anh cả, tôi cũng chẳng muốn giải thích với anh nữa!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171709
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732171709,
					"content": "\"Thật nhức đầu khi tranh luận với mấy người máu lên não như vậy... Nói chứ, ngân sách của anh đâu rồi? Đừng nói với tôi là anh đã lấy phụ cấp của Giáo Viện đi dùng vào mấy chuyện vớ vẩn này nhé.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171710
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732171710,
					"content": "\"Hiền giả Zolfikar từng nói \"sự nghèo khổ của người nghèo là do sự sung túc của người giàu, nên người giàu cần dùng tài sản của mình để làm việc tốt\"!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171711
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732171711,
					"content": "\"Ông ta chưa từng nói thế.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171712
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732171712,
					"content": "\"Ông ta có nói.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171713
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732171713,
					"content": "\"Ông ta không có nói, anh tự đi mà trả tiền rượu của tháng này đi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171714
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732171714,
					"content": "\"Tôi không tranh luận chuyện này với anh, nhưng hãy cho tôi thời gian một tháng, tôi sẽ chứng minh là ông ta đã từng nói.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Thông Báo"
				}
			]
		},
		{
			"id": 7321718,
			"completionStepIds": [
				7321718
