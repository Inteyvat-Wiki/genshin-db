			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171901,
					"content": "\"Tuyến đường xuất nhập khẩu đến Đảo Ritou đã được mở lại, chân thành mời các bạn gia nhập thương hội.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171902
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732171902,
					"content": "\"Việc buôn bán nấm giữa Sumeru và Inazuma của thương hội đã được Quản Lý Cảng Vụ phê duyệt, hoan nghênh các nhà buôn nấm liên hệ tôi để bàn chuyện hợp tác.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171903
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732171903,
					"content": "\"Bạn cũng có thể liên hệ với thương hội nếu bạn gặp bất kỳ vấn đề hoặc khó khăn nào trên đường đến Inazuma.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Thông Báo"
				}
			]
		},
