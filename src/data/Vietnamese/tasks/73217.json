			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171201,
					"content": "Thương hội kinh doanh chế phẩm đá quý và khoáng thạch quý giá sản xuất tại Liyue, với kênh cung cấp ổn định, nguồn hàng dồi dào và có hợp tác lâu dài với nhiều đội thuyền.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171202
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732171202,
					"content": "Ngoài ra bán thêm tơ lụa hợp thời trang với số lượng ít, muốn mua thì nhanh tay nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171203
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732171203,
					"content": "Nếu có nguồn cung ứng hàng hóa chất lượng cao như thảm, thảo dược, trang sức đá quý, gấm vóc của Sumeru, thì kính mời phía hợp tác liên hệ để trao đổi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Thông Báo"
				}
			]
		},
		{
			"id": 7321713,
			"completionStepIds": [
				7321713
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321713",
							"2"
						],
						"stepId": 7321713,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171301,
					"content": "\"Có ai tin không? Tháng trước tôi ra biển đến một quốc gia, quốc vương của họ còn chưa từng nhìn thấy ngựa.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171302
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732171302,
					"content": "\"Thế nên, tôi quyết định bán một số Thú Thồ Hàng qua đó, rồi nói với họ đây là ngựa, haha. Nếu đơn hàng này mà thành công thì biết đâu tôi cũng có thể trở thành quốc vương gì đó đấy!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171303
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732171303,
					"content": "\"Quốc vương là gì?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171304
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732171304,
					"content": "\"Giống như Quan Cảng Vụ hay Vizier vậy, nhưng còn có uy quyền hơn cả họ nữa, giống như 29 Dey trong truyền thuyết ấy. .. Ôi, thật khó mà giải thích được.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171305
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732171305,
					"content": "\"Nhìn là biết chém gió rồi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Thông Báo"
				}
			]
		},
		{
			"id": 7321714,
			"completionStepIds": [
				7321714
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
