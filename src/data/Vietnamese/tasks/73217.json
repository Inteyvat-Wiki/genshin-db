			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732170701,
					"content": "Hải thú xuất hiện!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170702
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732170702,
					"content": "Gần đây hải thú thường xuyên hoạt động, thuyền bè ra cảng hãy chú ý thông tin báo động từ Hải Đăng Pharos, hoặc tìm hiểu trước thông tin hàng hải thông qua Akasha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170703
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732170703,
					"content": "Nếu có thắc mắc hãy liên hệ thủ vệ tháp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Thông Báo"
				}
			]
		},
		{
