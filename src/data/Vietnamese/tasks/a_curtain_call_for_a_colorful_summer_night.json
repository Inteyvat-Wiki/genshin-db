			},
			"dialogs": [
				{
					"id": 150450701,
					"content": "Tên hát rong, anh vẫn rất biết cách chọn địa điểm nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450702,
					"content": "Haha, thấy vui là được rồi. Có những chuyện không thích hợp với chim chóc, chỉ có thể kể cho những vì sao nghe thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450703
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450703,
					"content": "Muốn kể chuyện trước khi đi ngủ sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450704
					]
				},
				{
					"id": 150450704,
					"content": "Haha... Câu chuyện này bắt đầu từ \"Thời Gian\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450705
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450705,
					"content": "Rất lâu rất lâu về trước, \"Thời{RUBY#[D]Istaroth} Gian\" đã bắt đầu ghi chép lại thế giới này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450706
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450706,
					"content": "Cô ấy đối xử công bằng với tất cả sinh linh, mọi thứ trong lòng cô đều bình đẳng như nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450707
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450707,
					"content": "Cô ấy giống như một quyển sách cổ, đem tất cả mọi người, mọi chuyện, mọi cuộc gặp gỡ và chia ly khắc ghi trong ký ức của mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450708
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450708,
					"content": "Lúc đó tôi vẫn còn là tinh linh gió, tôi đã vô tình gặp được \"Thời Gian\" tại Thiên Phong Thần Điện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450709
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450709,
					"content": "Cô ấy đã lắng nghe nguyện vọng của tôi, chia cho tôi vài mảnh sức mạnh và quyền năng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450710,
						150450711
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450710,
					"content": "Hạt giống mà cơn gió mang tới...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450712
					]
				},
				{
					"id": 150450712,
					"content": "#Xem ra đây không phải lần đầu tiên {F#cô}{M#cậu} nghe được câu chuyện \"Thời Gian Và Gió\" nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450713
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450713,
					"content": "Rất có ý thơ, đúng chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450714
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450714,
					"content": "Dựa vào những ký ức khắc sâu trong tế lễ, thơ ca, di tích và sách cổ, những sinh linh bị coi là bé nhỏ kia đã lần lượt \"nhìn thấy\" thời gian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450715
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450715,
					"content": "Đây là câu chuyện mà anh muốn kể sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450716,
					"content": "Ừm... Chỉ có thể coi như là phần mở đầu của câu chuyện mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450717
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450717,
					"content": "Sự ô nhiễm của Vùng Biển Lặng gắn liền với chính thời gian. Nói cách khác, đó là một tai họa hiện hữu trong từng khoảnh khắc của thời gian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450718
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450718,
					"content": "Khác với \"Thời Gian\", trong lòng tôi luôn tồn tại rất nhiều nguyện vọng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450719
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450719,
					"content": "Năm trăm năm trước, để ngăn chặn sự ô nhiễm của Vùng Biển Lặng tiếp tục lan rộng sang nhiều khu vực khác ngoài Tenochtzitoc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450720
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450720,
					"content": "Tôi đã thổi Vùng Biển Lặng khỏi trục thời gian, khiến nó trở thành \"nơi không có gió\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450721
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450721,
					"content": "Đây chính là chân tướng về sự biến mất của Vùng Biển Lặng sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450722
					]
				},
				{
					"id": 150450722,
					"content": "#Chà, có vẻ như khiến {F#cô}{M#cậu} nhầm lẫn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450723
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450723,
					"content": "Nếu là hỏi về chuyện Vùng Biển Lặng biến mất khỏi Tenochtzitoc hai ba mươi năm trước, có lẽ sẽ có người kể chuyện phù hợp hơn cả tôi đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450724
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450724,
					"content": "Vùng Biển Lặng đã chứa đựng quá nhiều câu chuyện không nên thuộc về nó... Mà tôi chỉ tham gia vào một chương trong đó thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450725
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450725,
					"content": "Và sự lựa chọn của tôi vào năm trăm năm trước cũng có cái giá phải trả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450726
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450726,
					"content": "Có những linh hồn vì thế mà không thể trở về Mondstadt... Số khác lại lắng đọng tại mảnh đất này, hòa vào Monetoo, trở thành Asha mà chúng ta đã gặp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450727
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450727,
					"content": "Cho nên, lần này anh đến Tenochtzitoc là vì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450728,
					"content": "Đúng vậy, tôi cần hợp tác với Hỏa Thần đương nhiệm, Mavuika.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450729
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450729,
					"content": "Là lúc thắp nến đó sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450730
					]
				},
				{
					"id": 150450730,
					"content": "Đoán đúng rồi đấy. Ngọn lửa là ám hiệu của chúng tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450731
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450731,
					"content": "Sau khi Mavuika mở khe nứt dẫn tới Vùng Biển Lặng từ trong không gian đó, tôi mới có thể lẻn vào và đưa tất cả những linh hồn muốn về nhà trở về.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450732
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450732,
					"content": "Còn về mánh khóe để lấy lại ký ức thì... Heh, cũng không phải lần đầu tôi làm chuyện này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450733
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450733,
					"content": "#Mavuika còn nói với tôi là {F#cô}{M#cậu} định dẫn tôi đến làm quen đấy... Không ngờ lại bị tôi giành trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450734
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450734,
					"content": "Rất mừng vì cô ấy cũng thích tự do và rượu ngon... Chúng tôi nói chuyện rất hợp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450735,
						150450736
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450735,
					"content": "May mà có anh đấy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450737
					]
				},
				{
					"id": 150450737,
					"content": "Tôi đã mệt mỏi suốt mấy ngày rồi, tôi lại sắp đi ngủ một giấc thật sâu đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450738
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450738,
					"content": "Thật sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450739
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450739,
					"content": "Nhưng tôi chưa uống đủ rượu mật và rượu bồ công anh, nên phải kiên trì thêm một chút nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450740
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450740,
					"content": "Tôi thấy anh vẫn chưa mệt lắm đâu, nên chỉ dựa vào lý do nhỏ này thì còn lâu chúng tôi mới mời.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450741
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450741,
					"content": "Ơ... Sao nghiêm khắc với tôi thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450742
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450742,
					"content": "Venti...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450743
					]
				},
				{
					"id": 150450743,
					"content": "#{NICKNAME} sẽ tiếp tế rượu ngon cho tôi, phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450744,
						150450745
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450744,
					"content": "Tôi có hơi hiếu kỳ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450746
					]
				},
				{
					"id": 150450746,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450747
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450747,
					"content": "Có lẽ là để bảo vệ Mondstadt, để tất cả ai muốn ở lại đó đều có quyền tự do lựa chọn con đường riêng của mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450745,
					"content": "...Nguyện vọng bây giờ của anh là gì thế?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450746
					]
				},
				{
					"id": 150450736,
					"content": "Anh đã làm được một chuyện lớn rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450737
					]
				},
				{
					"id": 150450711,
					"content": "Thời gian sẽ khiến nó nảy mầm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450712
					]
				}
			]
		},
