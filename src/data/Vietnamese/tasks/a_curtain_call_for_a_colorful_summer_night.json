			"dialogs": [
				{
					"id": 150450601,
					"content": "Ồ, đẹp thật đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450602
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450602,
					"content": "Mọi người ơi, tập trung chụp ảnh thôi nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450603
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450603,
					"content": "Ừm... Được đó chứ! Tinh thần của mọi người đều rất tốt, không có tóc bết hay mắt thâm vì thức khuya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450604
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450604,
					"content": "Trước khi chụp còn phải kiểm tra những thứ này nữa sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450605,
					"content": "Chụp ảnh không tốt thì làm sao có thể tự xưng mình là người dẫn đường giỏi được chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450606
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450606,
					"content": "Đúng đó, cũng như mê rượu thì mới là nhà thơ giỏi được chứ, đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450607
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450607,
					"content": "...Không ngờ hai ý tưởng này lại liên kết được luôn đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450608,
					"content": "Haha, nhưng bầu không khí rất tuyệt mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450609
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450609,
					"content": "Mọi người đã đủ thân để cùng nhau nói chuyện phiếm rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450610
					]
				},
				{
					"id": 150450610,
					"content": "#Thật sao? {NICKNAME} lại học theo Bennett chiều hư cái tên hát rong này đấy à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450611,
					"content": "Thì cũng không có gì xấu mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450612
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150450612,
					"content": "#Nào, {NICKNAME}, đeo chiếc băng đầu Asha này lên đi. Đây là quà lưu niệm mà mọi người đã mua cho {F#cô}{M#cậu} đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450613
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450613,
					"content": "Cảm ơn nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450614
					]
				},
				{
					"id": 150450614,
					"content": "Rất hợp đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450615
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450615,
					"content": "Vậy thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450616
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450616,
					"content": "Ba, hai, một...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450617
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450617,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450618,
					"content": "Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450619
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450619,
					"content": "Ngại thật, ban nãy nghe nhiều lời nói đùa quá nên đầu tôi bỗng ngừng hoạt động rồi, không nghĩ ra được nên nói gì nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450620,
					"content": "Cộng thêm việc không nỡ rời xa mọi người đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450621
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150450621,
					"content": "Cảm thấy khi nói ra thì sẽ đặt dấu chấm hết cho kỳ nghỉ ấy nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450622
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150450622,
					"content": "Cô...! Tôi cứ tưởng người hòa giải sẽ không biết đọc suy nghĩ chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450623
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450623,
					"content": "Haha, Paimon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450624
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450624,
					"content": "Không sao đâu, Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450625
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450625,
					"content": "Mùa hè sẽ còn đến mà, giống như lời cầu nguyện của Paimon với Hỏa Thần ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450626
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450626,
					"content": "Hành trình của mọi người vẫn đang tiếp tục. Nhưng chỉ cần chúng ta trân trọng nhau, thì một ngày nào đó chúng ta sẽ gặp lại nhau thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450627
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450627,
					"content": "Có phải Bennett đã trở nên rất biết cách ăn nói rồi không, thầy Venti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450628
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450628,
					"content": "Ây da, không phải tôi dạy đâu mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450629
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450629,
					"content": "\"Không phải tôi dạy đâu\" mà giọng điệu đắc ý thế! Thiệt tình, khó khăn lắm tôi mới cảm động một chút đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450630
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450630,
					"content": "Vậy chúng ta làm lại lần nữa nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450631
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450631,
					"content": "Mọi người cùng nhau luôn nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450632
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450632,
					"content": "Hô thế nào được nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450633
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150450633,
					"content": "Ngôi sao may mắn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450634
					]
				},
				{
					"id": 150450634,
					"content": "Được đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450635
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450635,
					"content": "Ba, hai, một...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450636
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450636,
					"content": "Ngôi sao may mắn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450641
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450641,
					"content": "Bạn cùng bạn bè tận hưởng khoảng thời gian vui vẻ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150450642
					]
				},
				{
					"id": 150450642,
					"content": "...Sau này Bennett có dự định gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450643
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150450643,
					"content": "Đúng vậy. Nếu bây giờ chưa quyết định được thì có thể đến Cư Dân Suối Nước chúng tôi, muốn ở lại bao lâu cũng được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450644
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450644,
					"content": "...Ừm, cảm ơn lòng tốt của Mualani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450645
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450645,
					"content": "Trước đó, tôi đã đi gặp Hỏa Thần đại nhân và bày tỏ lòng biết ơn với cô ấy rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450646
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450646,
					"content": "Cô ấy nói không gian đó là Vùng Biển Lặng do Vực Sâu mô phỏng ra. Bản thân không gian rất bất ổn, nhưng giờ đã hoàn toàn biến mất rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450647
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450647,
					"content": "Nói đến chuyện của tôi thì Hỏa Thần rất hoan nghênh tôi ở lại Natlan, nhưng cũng nói là sẽ tôn trọng quyết định của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450648
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450648,
					"content": "Tôi đã suy nghĩ kỹ lưỡng... và quyết định sẽ quay về Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450649
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450649,
					"content": "Không yên tâm về những người cha sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450650
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150450650,
					"content": "Đó là một trong những nguyên nhân. Tôi đã hứa là sẽ kể những câu chuyện của mình cho họ nghe, không thể thất hứa được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450651
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450651,
					"content": "Còn những thứ khác thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450652
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450652,
					"content": "Lúc tạm biệt nhau, tôi đã nói với cha mẹ rằng tôi nhất định sẽ trở thành nhà mạo hiểm huyền thoại vĩ đại nhất Teyvat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450653
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450653,
					"content": "Và nhà mạo hiểm thì không thể chỉ ở yên một chỗ được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450654
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450654,
					"content": "Bennett...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450655
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450655,
					"content": "Nếu như sau khi rời khỏi Natlan lại có những chuyện không may xảy ra... Vậy thì phải làm sao đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450656
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450656,
					"content": "Haha, chuyện này cũng không sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450657
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450657,
					"content": "Sự ấm áp nhận được trong suốt chuyến hành trình này đủ để giúp tôi đối mặt với tất cả thử thách trong tương lai rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450658
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450658,
					"content": "Tôi muốn nắm giữ vận mệnh của chính mình, và muốn tiếp tục lan tỏa sự ấm áp này. Suy nghĩ này chưa từng thay đổi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450659
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450659,
					"content": "Kính đoàn trưởng của chúng ta một ly nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450660
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150450660,
					"content": "Kính đoàn trưởng Bennett!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450661
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450661,
					"content": "Cạn ly cạn ly!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450662
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450662,
					"content": "Ối... Sắp thâu đêm luôn rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450663
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450663,
					"content": "Chơi vui quá mà! Tiếp theo đến lượt ai biểu diễn đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450664
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450664,
					"content": "Tôi thấy Bennett như sắp ngủ gật mấy lần rồi đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450665
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150450665,
					"content": "Không, không... Tôi vẫn có thể...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450666
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450666,
					"content": "Mọi người về nghỉ ngơi đi thôi. Mualani, công việc dọn dẹp chỗ này giao cho cô nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450667
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150450667,
					"content": "Hả? Tại sao lại là tôi...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450668
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450668,
					"content": "#{NICKNAME}, đi dạo với tôi chút nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450669
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450669,
					"content": "Tôi biết một nơi có phong cảnh rất đẹp đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
