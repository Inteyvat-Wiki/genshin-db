			"dialogs": [
				{
					"id": 150450401,
					"content": "#{NICKNAME}, Paimon! Tôi đem theo Bóng Nổi đến chào buổi sáng đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450402
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450402,
					"content": "Chào buổi sáng, Mualani! Sao hôm nay phấn chấn vậy? Đêm qua chẳng phải cô là người chơi hết mình nhất sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450403,
					"content": "Đó là chuyện tối qua! Ngủ một giấc là hết mệt rồi mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450404
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450404,
					"content": "Đây, cầm lấy này. Đây là phần thưởng của album kỷ niệm đó, tôi đã lấy hộ luôn rồi, đỡ phải đi thêm một chuyến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450405
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450405,
					"content": "Ồ! Mualani chu đáo quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450406,
					"content": "Một người dẫn đường giỏi thì sẽ suy nghĩ trước và luôn ra tay giúp đỡ chứ, đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450407
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450407,
					"content": "Nói đến công việc thì hình như kỳ nghỉ cũng sắp kết thúc rồi. Nếu còn không về nhà, e là chú cún nhà tôi cũng không còn nhận ra tôi nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450408
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450408,
					"content": "Tôi đã hỏi những người khác rồi, ai cũng có nỗi trăn trở riêng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450409
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450409,
					"content": "Nhớ người nhà, nhớ hương vị của rượu bồ công anh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450410
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450410,
					"content": "Ngay cả Chasca dù không nói gì, nhưng cứ đến chiều tối là lại ngồi trên ngọn cây, nhìn về hướng Hội Hoa Vũ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450411
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450411,
					"content": "Tôi có thể hiểu được...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450412
					]
				},
				{
					"id": 150450412,
					"content": "Vì vậy, trước khi mùa hè tuyệt vời này kết thúc, chúng ta hãy làm thêm vài việc có ý nghĩa để kỷ niệm nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450413
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450413,
					"content": "Như là... cùng chụp thêm một tấm ảnh chẳng hạn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450414
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450414,
					"content": "Chụp ở đây luôn sao? Ở lâu như vậy, đúng là cũng có chút tình cảm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450415,
					"content": "Được! Vậy mau trang trí cho bức tường thôi. Để tôi gọi mọi người đến tập hợp... Gặp nhau ở quảng trường nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mualani"
				}
			]
		},
