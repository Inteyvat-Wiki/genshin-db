			},
			"dialogs": [
				{
					"id": 700010301,
					"content": "Nơi đâu cũng náo nhiệt, hay quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010302
					],
					"speakerTitle": "Cư dân khả nghi"
				},
				{
					"id": 700010302,
					"content": "Hoa gió bay trên trời...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010303
					]
				},
				{
					"id": 700010303,
					"content": "À? Ừm... dòng người lén ngắm nhìn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010304
					],
					"speakerTitle": "Cư dân khả nghi"
				},
				{
					"id": 700010304,
					"content": "Thì ra là cộng sự, bạn đến thật đúng lúc, tôi đang quan sát mấy cặp tình nhân sơ ý, chúng ta kiếm chút Mora nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010305
					],
					"speakerTitle": "Cư dân khả nghi"
				},
				{
					"id": 700010305,
					"content": "Ngươi gây sự chú ý với chúng, ta sẽ thừa cơ ra tay. Chờ xong việc chúng ta sẽ đến Phong Khởi Địa tìm những anh em khác, không biết bọn họ thu hoạch thế nào rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010306
					],
					"speakerTitle": "Cư dân khả nghi"
				},
				{
					"id": 700010306,
					"content": "Trước đó, bạn phải đi với tôi một chuyến.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010307
					]
				},
				{
					"id": 700010307,
					"content": "Ủa?! Khoan, khoan đã, ngươi đâu phải người của nhóm trộm, ngươi là ai?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010308
					],
					"speakerTitle": "Cư dân khả nghi"
				},
				{
					"id": 700010308,
					"content": "Người của Đội Kỵ Sĩ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010309
					]
				},
				{
					"id": 700010309,
					"content": "Hắn ta đã bị Đội Kỵ Sĩ đưa đi rồi. Nhưng Kỵ Sĩ Tây Phong sao đến nhanh vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700010310,
					"content": "Ừm, tạm khoan nói đến những chuyện này đã, hình như hắn vừa nói muốn đến Phong Khởi Địa tìm đồng bọn, chúng ta hãy đến Phong Khởi Địa xem thử đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
