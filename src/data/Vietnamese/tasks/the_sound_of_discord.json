				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700010501,
					"content": "Rốt cuộc có còn cơ hội không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010502
					],
					"speakerTitle": "Cư dân thất lạc"
				},
				{
					"id": 700010502,
					"content": "Sao? Có chuyện gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010503
					],
					"speakerTitle": "Cư dân thất lạc"
				},
				{
					"id": 700010503,
					"content": "Hoa gió bay trên trời...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010504
					]
				},
				{
					"id": 700010504,
					"content": "Ừm, ý bạn là, \"dù xảy ra chuyện gì cũng phải tận hưởng Lễ Hội Hoa Gió\" sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010505
					],
					"speakerTitle": "Cư dân thất lạc"
				},
				{
					"id": 700010505,
					"content": "Cũng đúng, không thể vì bị từ chối mà nản lòng, ngày lễ vẫn chưa kết thúc mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
