			},
			"dialogs": [
				{
					"id": 700010401,
					"content": "Ủa? Sao rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010402
					],
					"speakerTitle": "Cư dân nôn nóng"
				},
				{
					"id": 700010402,
					"content": "Hoa gió bay trên trời...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010403
					]
				},
				{
					"id": 700010403,
					"content": "Hoa Gió? Hoa Gió gì, ý bạn là Bồ Công Anh à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010404
					],
					"speakerTitle": "Cư dân nôn nóng"
				},
				{
					"id": 700010404,
					"content": "Vậy thì sao, bình thường mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010405
					],
					"speakerTitle": "Cư dân nôn nóng"
				},
				{
					"id": 700010405,
					"content": "Xin lỗi đã làm phiền!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700010406,
					"content": "Hình như chỉ là cư dân bình thường thôi, chúng ta hỏi thử người khác xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7000105,
			"completionStepIds": [
				7000107
