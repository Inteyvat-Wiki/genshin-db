			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vile"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700010201,
					"content": "A, Nhà Lữ Hành, lại gặp nhau nữa rồi, sao, còn thích bầu không khí trong thành không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010202
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 700010202,
					"content": "Cũng thích đó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010203
					]
				},
				{
					"id": 700010203,
					"content": "Bạn thích là được. Ừm...tuy không liên quan lắm, nhưng tôi vẫn còn một chuyện có liên quan đến Lễ Hội Hoa Gió muốn nhờ bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010204
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 700010204,
					"content": "Không đúng, chính xác là, \"ngài kia\" lại có chuyện muốn nhờ vả bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010205
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 700010205,
					"content": "Trong thời gian Lễ Hội Hoa Gió chẳng phải không nên nhờ người khác làm việc sao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010206
					]
				},
				{
					"id": 700010206,
					"content": "À đừng lo, vì chuyện mà tôi muốn nhờ vả không thuộc quy tắc của Lễ Hội Hoa Gió.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010207
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 700010207,
					"content": "Chắc bạn cũng để ý thấy, Lễ Hội Hoa Gió hàng năm đều rất đông vui, người dân nô nức kéo tới, chìm đắm trong bầu không khí lễ hội, Kỵ Sĩ Tây Phong để duy trì trật tự, cũng bận rộn tối tăm mặt mày...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010208
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 700010208,
					"content": "Đối với đám Đạo Bảo Đoàn thì việc đám đông tụ tập không hề cảnh giác, Kỵ Sĩ Tây Phong bận tối tăm mặt mũi chính là thời cơ tốt để chúng ra tay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010209
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 700010209,
					"content": "Theo tin tình báo của \"vị tiên sinh đó\", có vài thành viên Đạo Bảo Đoàn đã trà trộn vào thành, đang đến gần các tiệm ở cổng thành giả vờ mừng ngày lễ, thực chất là thăm dò cho hành động tiếp theo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010210
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 700010210,
					"content": "Nếu Đội Kỵ Sĩ rầm rộ lục soát, một mặt sẽ bứt dây động rừng, mặt khác cũng sẽ phá hỏng bầu không khí ngày lễ. Nhưng cũng không thể để mặc chúng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010211
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 700010211,
					"content": "Vì vậy, bạn tới tìm tôi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010212
					]
				},
				{
					"id": 700010212,
					"content": "Đúng vậy, lần này cũng là \"vị tiên sinh đó\" chỉ đích danh bạn, theo lời ngài ấy nói thì bạn là ứng viên hàng đầu để giải quyết chuyện này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010213
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 700010213,
					"content": "Được rồi, chúng ta bàn việc chính thôi. Theo tình báo mà tôi thăm dò, bọn Đạo Bảo Đoàn trà trộn đã đánh dấu thân phận cho nhau, chúng đều mang theo một cái <color=#00E1FFFF>túi nhỏ</color>, hơn nữa, lúc xác nhận đồng bọn còn dùng một <color=#00E1FFFF>ám hiệu</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010214
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 700010214,
					"content": "<color=#00E1FFFF>\"Hoa gió bay trên trời, dòng người lén ngắm nhìn.\"</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010215,
						700010216
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 700010215,
					"content": "Thật là dễ nhớ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010217
					]
				},
				{
					"id": 700010217,
					"content": "Kẻ nói được ám hiệu là Đạo Bảo Đoàn trà trộn vào thành, hơn nữa chắc có thể moi được tin tình báo của doanh trại ngoài thành từ miệng chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010218
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 700010218,
					"content": "Sau khi có được tin tình báo, bạn hãy đánh lui hết bọn chúng luôn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010219
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 700010219,
					"content": "Sao không giao cho Đội Kỵ Sĩ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010220
					]
				},
				{
					"id": 700010220,
					"content": "Để duy trì trật tự trong thành, Đội Kỵ Sĩ hẳn là bận tối tăm mặt mày rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010221
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 700010221,
					"content": "Vào lúc này, giúp được gì cho họ thì giúp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010222
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 700010222,
					"content": "Vậy thì nhờ bạn nhé, \"Kỵ Sĩ Danh Dự\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				},
				{
					"id": 700010216,
					"content": "Là phong cách của chúng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010217
					]
				}
			]
		},
