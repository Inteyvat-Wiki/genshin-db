			"dialogs": [
				{
					"id": 705050101,
					"content": "Lão gia Diluc! Thật hiếm có đó! Hôm nay không có việc gì làm sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705050102,
					"content": "Nhà bao việc, tôi chỉ là nhận được thông tin về việc hai người đang làm pha chế, nên đến đây xem thử thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050103
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050103,
					"content": "Woa, thông tin lan nhanh thật!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705050104,
					"content": "#Hừm, {NICKNAME}, cảm thấy làm pha chế như thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050105
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050105,
					"content": "Chỉ vừa mới bắt đầu thôi mà...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705050106
					]
				},
				{
					"id": 705050106,
					"content": "Đúng vậy, lão gia Diluc hỏi sớm quá, chúng tôi chỉ mới khai trương không lâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705050107,
					"content": "Tôi chỉ muốn hỏi cảm nhận ban đầu thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050108
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050108,
					"content": "Hứng thú? Hay là phiền phức? Có cảm nhận gì xin cứ nói thẳng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050109,
						705050110
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050109,
					"content": "Tương đối lạ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705050111
					]
				},
				{
					"id": 705050111,
					"content": "Hóa ra là vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050112
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050112,
					"content": "Không hỏi tôi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705050113,
					"content": "Cảm nhận đầu tiên của tôi là... đồ uống ngon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705050114,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050115
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050115,
					"content": "Vậy thì tốt rồi, mừng cho bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050116
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050116,
					"content": "Có thể làm cho tôi một ly Hoàng Hôn Thung Lũng Xám không? Cỡ nào cũng được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050117
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050117,
					"content": "Hiểu rồi, đợi chút nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705050118
					]
				},
				{
					"id": 705050118,
					"content": "Ừm, không vội đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050110,
					"content": "Có chút lóng ngóng...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705050111
					]
				}
			]
		},
