				"points": []
			},
			"dialogs": [
				{
					"id": 705050201,
					"content": "Mùi vị rất tuyệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050202
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050202,
					"content": "Chủ yếu vẫn là do có nguyên liệu ngon thôi! Chỉ cần trái cây đủ độ tươi thì cho dù không thêm gì vào cũng sẽ ngọt mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705050203,
					"content": "Vậy thì phải cảm ơn thổ nhưỡng của Mondstadt rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050204
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050204,
					"content": "...Hoàng Hôn Thung Lũng Xám, đây cũng là thức uống đầu tiên mà tôi pha ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050205
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050205,
					"content": "Lúc đó tôi còn nhỏ, cha tôi đưa cho tôi vài loại nguyên liệu để tôi tự mình làm thử.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050206
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050206,
					"content": "Không có gợi ý, không có yêu cầu, dựa cả vào sức sáng tạo của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050207
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050207,
					"content": "Cuối cùng, thức uống mà tôi làm ra chính là ly nước ép như thế này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050208
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050208,
					"content": "Ừm, tại sao lại là nước ép nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705050209,
					"content": "Cha tôi rất bất ngờ. Lúc đó tôi cũng không để ý đến những nhân tố khác, chỉ biết là nước ép sẽ rất ngọt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050210
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050210,
					"content": "Giờ đây nghĩ lại, trông tôi thật ấu trĩ thiển cận...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050211
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050211,
					"content": "Tôi không cho là như vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705050212
					]
				},
				{
					"id": 705050212,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050213,
						705050214
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050213,
					"content": "Đối với ông ấy mà nói thì đó nhất định là một ly đồ uống tuyệt vời.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705050215
					]
				},
				{
					"id": 705050215,
					"content": "Tôi chưa từng có suy nghĩ này... dẫu sao thì, lúc đó cha tôi cũng không nói gì cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050216
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050216,
					"content": "Nhưng mà, cảm ơn bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050217
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050217,
					"content": "Ngoài ra, tôi có thứ này muốn tặng bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050218
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050218,
					"content": "...Nhưng mà đợi khi bạn trải nghiệm công việc này nhiều hơn rồi tôi mới đưa nhé. Với năng lực của bạn thì sẽ sớm có được thành quả thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050219
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050219,
					"content": "Tôi cũng sẽ... ra sức cổ vũ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705050220,
					"content": "Ừm, tôi rất mong chờ đấy. Vậy tôi cáo từ trước nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050221
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050221,
					"content": "Rảnh nhớ ghé chơi nha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705050214,
					"content": "Ông ấy nhất định sẽ thấy rất ngon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705050215
					]
				}
			]
		}
	]
