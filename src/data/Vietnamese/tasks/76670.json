				"points": []
			},
			"dialogs": [
				{
					"id": 766700101,
					"content": "Dạo này thế nào rồi Lyylikki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700102
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766700102,
					"content": "Ồ! Xin chào, cô Lauma, dạo này mọi việc ở trong tiệm đều rất suôn sẻ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700103
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766700103,
					"content": "Nguồn cung nguyên liệu không bị gián đoạn, cũng chẳng có ai đến gây rối, hơn nữa tay nghề nấu nướng của tôi cũng ngày càng tiến bộ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700104
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766700104,
					"content": "À phải rồi, những người bạn mà cô nhắc đến lần trước, là... những con vật đó sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700105
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766700105,
					"content": "Chúng đều rất là ngoan, cứ đứng nhìn chằm chằm vào những người xếp hàng, tôi định cho chúng chút thức ăn nhưng chúng đều không ăn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700106
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766700106,
					"content": "Những đứa nhóc đó đều biết mình mang trọng trách, khi đang làm nhiệm vụ thì sẽ canh giữ vị trí của mình và tập trung cao độ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700107
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766700107,
					"content": "Sau khi chúng đổi ca thì cô có thể chiêu đãi chúng một chút. Haha, tôi nghĩ chúng cũng sẽ rất vui đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700108
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766700108,
					"content": "Được đấy, vậy hôm nay tôi sẽ làm một bữa thật ngon để cảm ơn chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700109
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766700109,
					"content": "Vất vả rồi, Lyylikki. Nếu cần người giúp đỡ thì cứ nói với tôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700110
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766700110,
					"content": "Không, không cần đâu, tôi xử lý được mà, huống chi còn có Kantor và Jahoda giúp nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700111
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766700111,
					"content": "Được rồi, vậy tôi không làm phiền nữa. Tạm biệt, Lyylikki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700112
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766700112,
					"content": "Ừm, tôi cũng phải đi bưng thức ăn mới ra đây... À phải rồi, mời cô nếm thử phần thức ăn này nhé. Tôi vừa mới làm xong, tươi ngon lắm đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700113
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766700113,
					"content": "Được rồi, tiếp theo là phải bày thức ăn ra đĩa... Ơ? Mấy cái đĩa vừa rửa xong đâu rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lyylikki"
				}
			]
		}
	]
}