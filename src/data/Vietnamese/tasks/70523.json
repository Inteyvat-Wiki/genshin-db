				"points": []
			},
			"dialogs": [
				{
					"id": 705230101,
					"content": "Vị khách đến từ vùng khác sao? Chào mừng đến với Khinh Sách Trang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230102,
						705230103
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230102,
					"content": "Xin chào...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230104
					]
				},
				{
					"id": 705230104,
					"content": "Tôi nói này, chúng ta phải tự giới thiệu bản thân trước đã!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230105,
					"content": "#Đây là Nhà Lữ Hành toàn năng {NICKNAME}, còn tôi là đồng đội tốt nhất của Nhà Lữ Hành, Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230106,
					"content": "Chúng tôi đang giúp khách nơi khác đặt mua đồ uống đặc sắc của Lễ Hội Rượu, nhìn thấy ủy thác của anh nên đến thương lượng với anh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230107,
					"content": "Ra là vậy, đúng là người thẳng thắn! Vậy tôi không phí lời nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230109
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230109,
					"content": "Tôi là đầu bếp Guanchui, tôi đang cần mua <color=#00E1FFFF>100 thùng \"Hương Vị Lễ Hội\"</color> để pha đồ uống cho các anh em lao động tay chân uống thoải mái.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230110
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230110,
					"content": "Được! Vậy chúng ta bắt đầu làm việc thôi nào, anh hãy đưa kinh phí mua sắm cho chúng tôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230111,
					"content": "Đã chuẩn bị xong từ lâu rồi, xin hãy nhận số \"Pha Lê Fairbrew\" này! Sau khi đặt hàng xong chắc hẳn vẫn còn dư, mặc kệ còn dư bao nhiêu thì đấy đều là phần thưởng cho sự vất vả chăm chỉ của hai bạn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230112
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230112,
					"content": "Chúng tôi đã nhận rồi, lát nữa sẽ lên đường ngay!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230113,
					"content": "Tốt quá! Tôi chờ tin tốt của các bạn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230114,
						705230115
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230114,
					"content": "Trao đổi nhanh ghê...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230116
					]
				},
				{
					"id": 705230116,
					"content": "#Đừng ngây người nữa, {NICKNAME}, chúng ta mau đi thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230117,
					"content": "Có gì muốn nói thì chờ đặt xong đơn hẵng nói tiếp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230118,
					"content": "Làm xong sớm, chúng ta sẽ có thể mở tiệm sớm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230119,
					"content": "Mở tiệm mở tiệm, mmhmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230115,
					"content": "Paimon cũng thạo việc rồi đó...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230116
					]
				},
				{
					"id": 705230103,
					"content": "Xin hỏi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230104
					]
				}
			]
		},
		{
