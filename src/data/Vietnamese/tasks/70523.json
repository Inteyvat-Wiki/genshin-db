			"dialogs": [
				{
					"id": 705230201,
					"content": "Ồ! Các bạn lại tới à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230202
					],
					"speakerTitle": "Georg"
				},
				{
					"id": 705230202,
					"content": "Lần này vẫn đặt hàng giùm người nước khác nữa sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230203
					],
					"speakerTitle": "Georg"
				},
				{
					"id": 705230203,
					"content": "Đúng vậy, lần này chúng tôi cần 100 thùng \"Hương Vị Lễ Hội\", người ủy thác là đầu bếp Guanchui ở Khinh Sách Trang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230204,
					"content": "Chúng tôi đã tính xong giá cả rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230205,
						705230206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230205,
					"content": "Sao có cảm giác như sắp phải trả giá kịch liệt thế nhỉ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230207
					]
				},
				{
					"id": 705230207,
					"content": "Ồ! Khí thế mạnh mẽ lắm! Vậy để tôi xem thử khả năng của các bạn nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Georg"
				},
				{
					"id": 705230206,
					"content": "Mời tiếp chiêu, anh Georg!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230207
					]
				}
			]
		},
		{
			"id": 7052303,
			"completionStepIds": [
				7052303
