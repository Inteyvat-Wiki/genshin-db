				"points": []
			},
			"dialogs": [
				{
					"id": 705230301,
					"content": "Anh Guanchui, chúng tôi về rồi này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230302,
					"content": "100 thùng \"Hương Vị Lễ Hội\" anh cần đã đặt xong rồi, đây là biên lai của anh, xin hãy nhận lấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230303,
					"content": "Tốt quá! Hai bạn thật sự đã giúp đỡ tôi rất nhiều!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230304
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230304,
					"content": "Tôi muốn nghiên cứu \"Hương Vị Lễ Hội\", pha thức uống mới lạ này với nước trà theo tỷ lệ đặc biệt để mang lại hương vị thơm ngon nhất, giúp cho các anh em có động lực hơn khi ra đồng làm việc!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230305
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230305,
					"content": "Chà, nghe hơi giống pha rượu nhỉ, nhưng đổi thành nước trà... thật sự có thể làm ra sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230306,
					"content": "Yên tâm đi, trước đây tôi đã làm đầu bếp ở bên ngoài một khoảng thời gian rồi. Cách làm này có thể tạo ra sự cân bằng tốt nhất giữa chi phí và hương vị, tôi đã pha chế rất nhiều lần rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230307
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230307,
					"content": "Hơi muốn nếm thử...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230308
					]
				},
				{
					"id": 705230308,
					"content": "Lần sau các bạn tới Khinh Sách Trang chơi, tôi sẽ lấy thành phẩm đãi các bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230309
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230309,
					"content": "#Được đó! Đến lúc ấy cứ để {NICKNAME} nếm thử trước!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230310,
					"content": "Cố lên, đầu bếp pha chế đồ uống!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230311
					]
				},
				{
					"id": 705230311,
					"content": "Cảm ơn các bạn! Có rảnh thì ghé chơi nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Guanchui"
				}
			]
		},
		{
			"id": 7052304,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
