					"Guanchui"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705230401,
					"content": "Thức uống đặc biệt của Lễ Hội Rượu năm nay, có lẽ rất hợp với nước trà ở Khinh Sách Trang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230402
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230402,
					"content": "May nhờ có hai bạn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230403,
						705230407,
						705230415
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230403,
					"content": "Về bản thân anh...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230404
					]
				},
				{
					"id": 705230404,
					"content": "Tôi và mấy anh em mới chuyển về đây chưa được bao lâu. Bình thường tôi phụ trách nấu cơm, đưa ra ngoài đồng cho mấy anh em đang làm ruộng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230405
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230405,
					"content": "Nhưng hầu hết những món tôi nấu đều là mấy món đơn giản chắc bụng, nếu mang ra chiêu đãi khách đến từ vùng khác thì hơi đơn điệu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230406
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230406,
					"content": "Tuy Khinh Sách Trang không náo nhiệt, nhưng có rất nhiều món ngon, bạn đi dạo một vòng sẽ thấy ngay!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230407,
					"content": "Về nước trà...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230408
					]
				},
				{
					"id": 705230408,
					"content": "Các anh em đi làm ruộng về khát nước lắm, bình thường mới một lúc đã uống hết cả ấm trà lớn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230409
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230409,
					"content": "Đồng ruộng không gần quán trà trong làng, đi lại không thuận tiện lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230410
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230410,
					"content": "Chú Kai đã lớn tuổi rồi, cũng không thể làm phiền chú ấy mang trà cho họ được, cho nên tôi mới lo việc này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230411
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230411,
					"content": "Bọn tôi ra đồng làm việc được một lúc, nước trà thì hơi nhạt với bọn tôi, có lúc anh em lại muốn uống thứ gì đó đậm đà chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230412
					],
