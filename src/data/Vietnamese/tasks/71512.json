				"points": []
			},
			"dialogs": [
				{
					"id": 715120101,
					"content": "Thiệt tình... Nơi này dọn dẹp chưa? Ồ... hình như dọn qua rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120102
					],
					"speakerTitle": "Zhaoqin"
				},
				{
					"id": 715120102,
					"content": "Haizz, đau đầu quá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120103
					],
					"speakerTitle": "Zhaoqin"
				},
				{
					"id": 715120103,
					"content": "Bạn là... Nhà Lữ Hành sao! Xin lỗi, tôi bận quá nên không thấy bạn đến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120104
					],
					"speakerTitle": "Zhaoqin"
				},
				{
					"id": 715120104,
					"content": "Anh đang bận gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715120105
					]
				},
				{
					"id": 715120105,
					"content": "Là thế này, Tết Hải Đăng năm nay dưới sự chỉ đạo của Tổng Vụ, Hiệp Hội Nhà Mạo Hiểm tại cảng Liyue tiếp nhận vài công tác hỗ trợ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120106
					],
					"speakerTitle": "Zhaoqin"
				},
				{
					"id": 715120106,
					"content": "Thiên Nham Quân chủ yếu phụ trách tuần tra trong thành và những nơi trọng yếu, còn chúng tôi làm công tác dọn dẹp đám ma vật ngoài thành... và đánh đuổi đám cướp sinh sự.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120107
					],
					"speakerTitle": "Zhaoqin"
				},
				{
					"id": 715120107,
					"content": "Đúng rồi... Nói mới nhớ, bạn cũng từng đăng ký làm Nhà Mạo Hiểm đúng không, tôi nghe không ít kỳ tích về bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120108
					],
					"speakerTitle": "Zhaoqin"
				},
				{
					"id": 715120108,
					"content": "Nếu như bạn đồng ý, có thể giúp chúng tôi được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120109,
						715120110
					],
					"speakerTitle": "Zhaoqin"
				},
				{
					"id": 715120109,
					"content": "Chẳng phải tết đến rồi sao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715120111
					]
				},
				{
					"id": 715120111,
					"content": "Chà... Vì chúng tôi giúp Tổng Vụ trong kỳ nghỉ, nên họ sẽ trả thêm thù lao cho những nỗ lực của chúng tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120112
					],
					"speakerTitle": "Zhaoqin"
				},
				{
					"id": 715120112,
					"content": "Những Nhà Mạo Hiểm chấp nhận ủy thác và hoàn thành chúng có thể nhận được rất nhiều tiền...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120113,
						715120115
					],
					"speakerTitle": "Zhaoqin"
				},
				{
					"id": 715120113,
					"content": "Rốt cuộc là bao nhiêu tiền?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715120114
					]
				},
				{
					"id": 715120114,
					"content": "Hãy tin tôi, thù lao rất nhiều!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120123
					],
					"speakerTitle": "Zhaoqin"
				},
				{
					"id": 715120123,
					"content": "Vậy thì... tôi phải xem có bao nhiêu việc cần làm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715120116
					]
				},
				{
					"id": 715120116,
					"content": "Hahah! Được mà! Biết chắc là bạn sẽ giúp, để tôi đánh dấu vài địa điểm mà hiệp hội đã xác nhận. Còn ống pháo hoa này bạn cầm lấy nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120117
					],
					"speakerTitle": "Zhaoqin"
				},
				{
					"id": 715120117,
					"content": "Nếu bạn chấp nhận ủy thác... thì mỗi khi dọn sạch một khu vực, nhớ dùng ống này bắn một quả pháo hoa nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120118
					],
					"speakerTitle": "Zhaoqin"
				},
				{
					"id": 715120118,
					"content": "Một khi bắn pháo hoa, nhân viên ghi chép của chúng tôi sẽ đánh dấu khu vực là \"Đã Dọn Sạch\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120119
					],
					"speakerTitle": "Zhaoqin"
				},
				{
					"id": 715120119,
					"content": "Sau đó, chúng tôi sẽ điều chỉnh kế hoạch cho phù hợp với tình hình dọn dẹp của các khu vực trong toàn vùng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120120
					],
					"speakerTitle": "Zhaoqin"
				},
				{
					"id": 715120120,
					"content": "Nghe rất có kế hoạch đó...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715120121
					]
				},
				{
					"id": 715120121,
					"content": "Đây là Tết Hải Đăng mà, không thể để xảy ra sự cố gì. Chúng tôi... đang làm việc hết mình đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120122
					],
					"speakerTitle": "Zhaoqin"
				},
				{
					"id": 715120122,
					"content": "Không nói chuyện này nữa, tôi đi xem tình hình thế nào. Đợi chút nữa còn phải đến chỗ Lan báo cáo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhaoqin"
				},
				{
					"id": 715120115,
					"content": "Anh... phải cho tôi biết có bao nhiêu việc cần làm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715120116
					]
				},
				{
					"id": 715120110,
					"content": "Tết Hải Đăng thì sao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715120111
					]
				}
			]
		}
	]
}