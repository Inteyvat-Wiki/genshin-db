				"objectNames": [
					"Yanxiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718201501,
					"content": "Sao rồi, đã làm xong chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201502
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718201502,
					"content": "Xong hết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201503
					]
				},
				{
					"id": 718201503,
					"content": "Cám ơn nhé, tôi phải nhanh chóng làm cho xong mấy món này, không thôi khách khứa chờ lâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yanxiao"
				}
			]
		},
		{
			"id": 7182016,
			"completionStepIds": [
				7182016
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182016",
							"2"
						],
						"stepId": 7182016,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Verr Goldet"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718201601,
					"content": "Bạn về rồi à, Yanxiao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201602
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718201602,
					"content": "Bây giờ chắc đã đỡ bận hơn rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201603
					]
				},
				{
					"id": 718201603,
					"content": "Vậy thì tốt rồi, cám ơn bạn đã giúp nhé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201604
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718201604,
					"content": "Ở đây cũng không có...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201605,
						718201606
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718201605,
					"content": "Í, Wang'ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201607
					]
				},
				{
					"id": 718201607,
					"content": "Nhà Lữ Hành? Trùng hợp thật, không ngờ có thể gặp bạn ở đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201608
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718201608,
					"content": "ừm...có thể xem là vậy, bạn có biết Khinh Sách Trang không? Nơi đó cách thành phố rất xa, người dân cũng đều là người già và trẻ nhỏ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201609
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718201609,
					"content": "Vì thế Tết Hải Đăng mỗi năm, tổng vụ sẽ đặc biệt lưu ý cho người qua đó, để mang một số vật dụng lễ tết cho họ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201610
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718201610,
					"content": "Đợt vật tư đầu tiên đã gửi đi rồi, nhưng tôi vẫn muốn làm thêm chút gì đó để Khinh Sách Trang có không khí ngày tết hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201611
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718201611,
					"content": "Cho nên tôi đã đi mời nhà thơ Qingzhou, anh ấy đã hứa với tôi sẽ chuẩn bị một số câu đố đèn để chơi với bọn trẻ con ở Khinh Sách Trang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201612,
						718201613
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718201612,
					"content": "Qingzhou...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201614
					]
				},
				{
					"id": 718201614,
					"content": "Nhà thơ đó chắc không có vấn đề gì. Tôi còn tìm Bohuan nữa, bạn ấy viết chữ rất đẹp, nếu có thể giúp những cụ già ở Khinh Sách Trang viết lên Đèn Tiêu thì quá tuyệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201615
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718201615,
					"content": "Nhưng tôi không tìm được Bohuan, nghe nói anh ấy đã đến Địch Hoa Châu tìm đề tài, nên tôi đến đây tìm thử...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201616,
						718201617
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718201616,
					"content": "Không chừng bà chủ biết đó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201618
					]
				},
				{
					"id": 718201618,
					"content": "Bohuan? Để tôi nhớ xem...đúng là anh ấy có ghé qua nhà trọ một chuyến, hình như có nói muốn đi sưu tầm gì đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201619
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718201619,
					"content": "Nhưng nơi đó rất nhiều ma vật, tôi cũng không chắc là anh ấy có còn ở đó không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201620
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718201620,
					"content": "Vậy sao, nhưng tôi đã hẹn Qingzhou rồi, lát nữa sẽ gặp ở Nhà Trọ Vọng Thư...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201621
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718201621,
					"content": "Nhà Lữ Hành có thể giúp tôi đi tìm Bohuan không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201622
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718201622,
					"content": "Cứ để tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201623
					]
				},
				{
					"id": 718201623,
					"content": "Vậy thì phiền bạn nhé, tôi ở đây chờ Qingzhou đến, có một số chuyện phải dặn dò anh ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201624
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718201624,
					"content": "Hu hu...lo không xuể rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718201617,
					"content": "Bà chủ, chuyện của Bohuan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201618
					]
				},
				{
					"id": 718201613,
					"content": "(Ơ, không phải bạn ấy đã hẹn với Vermeer rồi sao...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201614
					]
				},
				{
					"id": 718201606,
					"content": "Bạn đến đây \"tặng Đèn Tiêu\" sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201607
					]
				}
			]
		},
		{
			"id": 7182019,
			"completionStepIds": [
				7182019
			],
