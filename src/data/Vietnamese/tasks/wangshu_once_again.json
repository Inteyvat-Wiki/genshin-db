					"Bohuan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718201901,
					"content": "Cám ơn cám ơn bạn nhiều... haiz... đều tại tôi không cẩn thận...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201902
					],
					"speakerTitle": "Bohuan"
				},
				{
					"id": 718201902,
					"content": "Bạn ở đây làm gì thế?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201903
					]
				},
				{
					"id": 718201903,
					"content": "Tôi đến đây tìm đề tài, bây giờ không phải Tết Hải Đăng sao? Tôi muốn viết vài chữ để tặng cho bạn bè...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201904
					],
					"speakerTitle": "Bohuan"
				},
				{
					"id": 718201904,
					"content": "Tôi vốn định đến đây dạo vài vòng tìm ít nguyên liệu để làm thành mấy thỏi mực đặc biệt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201905
					],
					"speakerTitle": "Bohuan"
				},
				{
					"id": 718201905,
					"content": "Không ngờ lại chạm trán ma vật, thật là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201906
					],
					"speakerTitle": "Bohuan"
				},
				{
					"id": 718201906,
					"content": "Về yêu cầu của Wang'ya...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201907
					]
				},
				{
					"id": 718201907,
					"content": "Đến Khinh Sách Trang viết chữ giúp người khác sao... được, không thành vấn đề, việc này cứ giao cho tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201908
					],
					"speakerTitle": "Bohuan"
				},
				{
					"id": 718201908,
					"content": "Khinh Sách Trang...hình như rất nhiều cụ già phải không, ừm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201909
					],
					"speakerTitle": "Bohuan"
				},
				{
					"id": 718201909,
					"content": "Vậy đi, bạn giúp tôi tìm một miếng Thạch Phách, một đóa Thanh Tâm đến đây nhé, tôi về chuẩn bị mực.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201910
					],
					"speakerTitle": "Bohuan"
				},
				{
					"id": 718201910,
					"content": "Những thứ này làm mực được sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201911
					]
				},
				{
					"id": 718201911,
					"content": "Ha ha ha, vậy là bạn không biết rồi. Bột thạch phách hòa vào mực đen, sẽ giúp chữ viết ra ánh lên sắc vàng, rất may mắn đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201912
					],
					"speakerTitle": "Bohuan"
				},
				{
					"id": 718201912,
					"content": "Hòa nước của Thanh Tâm vào mực sẽ khiến mực phảng phất hương thơm thanh mát, chỉ cần mài kỹ, hai thứ này hòa vào nhau sẽ vô cùng tuyệt vời.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201913,
						718201914
					],
					"speakerTitle": "Bohuan"
				},
				{
					"id": 718201913,
					"content": "Ồ, chuyên nghiệp ghê...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201915
					]
				},
				{
					"id": 718201915,
					"content": "Ha ha, như vậy đã là gì, nếu thật sự bảo người chuyên nghiệp chuẩn bị mực, thì mới gọi là phiền phức đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201916
					],
					"speakerTitle": "Bohuan"
				},
				{
					"id": 718201916,
					"content": "Lần này chúng ta cố gắng làm đơn giản thôi, bạn thu thập xong thì mang đến cho tôi nhé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201917
					],
					"speakerTitle": "Bohuan"
				},
				{
					"id": 718201917,
					"content": "Ây da...tôi phải nghỉ ngơi một chút, lúc nãy căng thẳng quá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bohuan"
				},
				{
					"id": 718201914,
					"content": "Phiền phức vậy sao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201915
					]
				}
			]
		},
