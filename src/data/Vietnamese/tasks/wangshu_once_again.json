					"nextDialogs": [
						718202104
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718202104,
					"content": "Cám ơn bạn đã giúp, tôi sẽ ở đây chờ Bohuan để thảo luận chi tiết một số việc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718202105
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718202105,
					"content": "Sau đó tôi phải về Liyue xử lý một số chuyện lặt vặt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718202106
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718202106,
					"content": "Thời gian này chắc tôi phải đi đi về về giữa Nhà Trọ Vọng Thư và Liyue nhiều rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718202107
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718202107,
					"content": "Chờ xử lý xong mấy việc vặt đó sẽ đến Khinh Sách Trang, nếu bạn thích cũng có thể đến Khinh Sách Trang tìm bọn tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718202108
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718202108,
					"content": "Haiz, hy vọng sẽ xử lý xong sớm mấy chuyện vặt vãnh đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
