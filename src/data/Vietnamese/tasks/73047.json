				"points": []
			},
			"dialogs": [
				{
					"id": 730470101,
					"content": "#Nara {NICKNAME}, Paimon, lại gặp nhau rồi, hahaha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470102
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730470102,
					"content": "Trông Araja có vẻ rất vui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730470103,
					"content": "Haha... Già này nhìn Vanarana náo nhiệt, nhiều Aranara về nhà như thế thì vui lắm. Ai u, không ngờ có thể tự mình tham gia Lễ Hội Utsava...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470104,
						730470105
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730470104,
					"content": "Araja chưa từng tham gia à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730470107
					]
				},
				{
					"id": 730470107,
					"content": "Trong câu chuyện của già này, đã từng tham gia một lần. Đó là câu chuyện từ rất lâu, lâu thật là lâu trước đây rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470108
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730470108,
					"content": "Già này, Aramuhukunda, Arana, Araji... Vô số Aranara chúng tôi, cùng Nara Varuna, tham gia Lễ Hội Utsava.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470109
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730470109,
					"content": "Đó là thời kỳ vô cùng khó khăn. Thế nhưng trong Lễ Hội Utsava ấy, chúng tôi vẫn cười đùa, hát ca. Già này thích câu chuyện ấy lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470110
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730470110,
					"content": "Ơ, chẳng phải Araja từng tham gia rồi sao...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730470111,
					"content": "Ờm, trong câu chuyện ấy, đúng là đã từng tham gia. Thế nhưng, già này không nhớ nổi nữa rồi. Những câu chuyện ấy đều do đám Arana kể lại cho già nghe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470112
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730470112,
					"content": "Ừm... Cảm giác Araja nói chuyện như ông cụ ấy, có lẽ do cao tuổi rồi, không nhớ rõ nữa nhỉ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730470113,
					"content": "#Có lẽ như thế cũng ổn... Dù thế nào, Nara {NICKNAME}, Paimon, các bạn có bằng lòng nhận lấy thứ này không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470114
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730470114,
					"content": "Là hoa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730470115,
					"content": "Ừ, hy vọng trong cuộc hành trình sau này, đóa hoa ấy sẽ luôn làm bạn với các bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470116,
						730470117
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730470116,
					"content": "Tôi nhận rồi nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730470118
					]
				},
				{
					"id": 730470118,
					"content": "Thời gian của Nara quý giá hơn Aranara nhiều, già này không chậm trễ thêm nữa, hãy thỏa sức hưởng thụ đi. Lát nữa mọi người hãy đi tìm Arakavi, cậu ta cũng đang chuẩn bị nghi thức của Lễ Hội Utsava đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araja"
				},
				{
					"id": 730470117,
					"content": "Cảm ơn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730470118
					]
				},
				{
					"id": 730470105,
					"content": "Tôi cũng vui lắm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730470106
					]
				},
				{
					"id": 730470106,
					"content": "Tôi cũng vui lắm! Nhưng trước đây Araja chưa bao giờ tham gia Lễ Hội Utsava sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470107
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
