				},
				{
					"id": 721680404,
					"content": "Có thể nói lại cách đó không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721680405
					]
				},
				{
					"id": 721680405,
					"content": "Để tôi nói cho. Cách cụ thể chính là, tìm Cành Lôi Anh Đào ở xung quanh, sau đó chạm vào nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680406
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721680406,
					"content": "Sau đó, sẽ có một thứ gọi là Hạt Giống Lôi dính lên người bạn, giúp bạn có thể vào bên trong rào chắn đó.",
