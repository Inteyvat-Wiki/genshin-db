			"trigger": {
				"objectNames": [
					"Xudong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721680301,
					"content": "Thế này...rồi lại thế này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680302
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680302,
					"content": "Bạn đã làm xong chưa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721680303
					]
				},
				{
					"id": 721680303,
					"content": "Chỉ còn một chút nữa thôi...Tôi áo một lớp bột bên ngoài trước, sau đó bỏ vào chiên...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680304
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680304,
					"content": "Đã hoàn thành rồi! Tempura Anh Đào, hãy mau nếm thử đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680305
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680305,
					"content": "Ngon, ngon lắm, chỉ là hơi...hơi nóng...phù phù phù...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680306
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 721680306,
					"content": "Xudong, trên sách nói món Tempura này, nên ăn kèm với nước chấm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680307
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721680307,
					"content": "Nước chấm? Cái này tôi chưa chuẩn bị, lần sau có cơ hội tôi sẽ nghiên cứu xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680308
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680308,
					"content": "Món Tempura Anh Đào này xin tặng bạn, bạn hãy nhận lấy đi, Nhà Lữ Hành, cám ơn bạn đã giúp đỡ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680309
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680309,
					"content": "Cách làm món Tempura Anh Đào này, tôi cũng đã ghi chép cho bạn, bạn hãy cầm lấy đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680310
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680310,
					"content": "Sau này có cơ hội, bạn cũng thử chế biến xem, việc nấu ăn cũng rất thú vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680311,
						721680313
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680311,
					"content": "Cám ơn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721680312
					]
				},
				{
					"id": 721680312,
					"content": "Đừng khách sáo, đừng khách sáo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680314
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680314,
					"content": "Chúng tôi sẽ ở lại Inazuma một thời gian, nói không chừng sẽ đến <color=#00E1FFFF>Kannazuka</color> dạo vài vòng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680316
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680316,
					"content": "Hơn nữa Julie nói, cô ấy muốn đi xem cây Anh Đào Thần ở Đền Narukami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680317
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680317,
					"content": "Nghe nói, tất cả Tú Cầu Anh Đào trên đảo, đều rơi rụng từ cây đại thụ đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680318
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680318,
					"content": "Rốt cuộc là cây to như thế nào, mới có thể rơi rụng nhiều cánh hoa như thế...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680319
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680319,
					"content": "Nếu bạn có hứng thú thì có thể đến đó xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680320
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680320,
					"content": "Nhà Lữ Hành, một lần nữa xin cám ơn bạn đã giúp đỡ. Tôi phải đi ăn chút gì đây, đói muốn xỉu rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680313,
					"content": "Tiếp theo các bạn sẽ đi đâu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721680314
					]
				}
			]
		},
