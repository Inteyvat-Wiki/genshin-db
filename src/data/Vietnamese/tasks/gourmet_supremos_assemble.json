				"points": []
			},
			"dialogs": [
				{
					"id": 721680201,
					"content": "Parvaneh, quả thật không còn cách khác nữa sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680202
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680202,
					"content": "Trong cuốn sách trên tay tôi chỉ ghi mỗi cách đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680203
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721680203,
					"content": "Hix...Nếu chỉ có ma vật cản đường thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680204
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 721680204,
					"content": "Đây là Tú Cầu Anh Đào mà các bạn cần sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721680205
					]
				},
				{
					"id": 721680205,
					"content": "Uhm! Không sai, đây chính là Tú Cầu Anh Đào mà chúng tôi cần, màu sắc này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680206
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680206,
					"content": "Quá tốt rồi! Cuối cùng đã có thể làm món ngon rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680207
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 721680207,
					"content": "Chờ đã, bạn đã vượt qua được rào chắn đó sao? Dùng cách mà chúng tôi nói với bạn sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680208
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721680208,
					"content": "Đúng vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721680209
					]
				},
				{
					"id": 721680209,
					"content": "Có thể nói với tôi bạn tìm thấy Cành Lôi Anh Đào ở đâu không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680210
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721680210,
					"content": "Sau khi chạm vào Cành Lôi Anh Đào, thì làm sao để Hạt Giống Lôi dính lên người bạn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680211
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721680211,
					"content": "Xin lỗi, để tôi lấy quyển sổ ra...Được rồi, bạn bị Hạt Giống Lôi bám vào người, có cảm giác thế nào? Còn nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680212
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721680212,
					"content": "Parvaneh, chờ một chút, Nhà Lữ Hành này vừa mới giúp đỡ chúng ta, nghiên cứu này của cô để từ từ đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680213
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680213,
					"content": "Nhà Lữ Hành, cám ơn bạn đã giúp đỡ, nhất định sẽ không thiếu phần thù lao của bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680214
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680214,
					"content": "Nhưng trước lúc đó, xin bạn hãy chờ một chút. Có được Tú Cầu Anh Đào do bạn lấy về, tôi có thể nghiên cứu ra món mới rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680215
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680215,
					"content": "Trước đây tôi có nghe nói, Inazuma có một món đặc biệt tên là Tempura Anh Đào, bây giờ đã có cơ hội để thử chế biến rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680216
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680216,
					"content": "Để tôi chuẩn bị một chút, sẽ nhanh chóng làm xong thôi, bạn chờ một lát rồi quay lại tìm tôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				}
			]
		},
		{
			"id": 7216803,
			"completionStepIds": [
				7216804
			],
