			"dialogs": [
				{
					"id": 752710101,
					"content": "#Xin đừng làm hỏng số bóng bay này. Nếu {F#cô}{M#cậu} muốn chơi, tôi có thể tặng {F#cô}{M#cậu} vài quả khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710102
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710102,
					"content": "Những quả bóng bay này đặc biệt thật.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752710103
					]
				},
				{
					"id": 752710103,
					"content": "Nói ra thì có hơi ngại, đây là đạo cụ quan trọng đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710104
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710104,
					"content": "#Nhìn nó, chắc {F#cô}{M#cậu} cũng đoán được là dùng để làm gì rồi nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710105,
						752710107
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710105,
					"content": "...Cầu hôn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752710106
					]
				},
				{
					"id": 752710106,
					"content": "Là để tỏ tình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710109
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710109,
					"content": "#Tôi sẽ tỏ tình với Yopoyi giữa những quả bóng bay lãng mạn này, {F#cô}{M#cậu} thấy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710110
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710110,
					"content": "Nên dùng bóng bay màu đỏ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752710111
					]
				},
				{
					"id": 752710111,
					"content": "#Hửm? {F#Cô}{M#Cậu} nói cũng có lý... Có phải tôi không được lãng mạn cho lắm không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710112
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710112,
					"content": "Nhưng Yopoyi sắp tới rồi, lúc này tìm đâu ra bóng bay màu đỏ đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710107,
					"content": "Tỏ tình?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752710108
					]
				},
				{
					"id": 752710108,
					"content": "Đúng... đúng thế!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710109
					],
					"speakerTitle": "Ziki"
				}
			]
		},
		{
