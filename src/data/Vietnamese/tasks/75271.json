			"dialogs": [
				{
					"id": 752710601,
					"content": "Yopoyi đến rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710602
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710602,
					"content": "Ziki? Sao lại ăn mặc lạ thế...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710603
					],
					"speakerTitle": "Yopoyi"
				},
				{
					"id": 752710603,
					"content": "Người Nanas mà em thích nhất này... Anh đi thuê về đó, đẹp không? Còn cả số bóng bay này, anh đã cố tình chuẩn bị đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710604
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710604,
					"content": "Thật ra anh có một câu muốn nói với em từ lâu rồi... Hãy hẹn hò với anh nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710605
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710605,
					"content": "Anh... anh điên rồi à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710606
					],
					"speakerTitle": "Yopoyi"
				},
				{
					"id": 752710606,
					"content": "Không! Cô gái trong lòng anh, Yopoyi, xin hãy hẹn hò với anh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710607
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710607,
					"content": "Anh điên thật rồi! Hôm nay là kỷ niệm ba năm ngày cưới của chúng ta đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710608
					],
					"speakerTitle": "Yopoyi"
				},
				{
					"id": 752710608,
					"content": "Tất nhiên là anh nhớ! Nhưng em luôn nói anh không lãng mạn, trước khi kết hôn còn chưa từng tỏ tình nghiêm túc lần nào... Vì vậy... Đây chính là lời tỏ tình muộn màng của anh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710609
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710609,
					"content": "Hah... Hiểu rồi, vậy thì em đồng ý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710610
					],
					"speakerTitle": "Yopoyi"
				},
				{
					"id": 752710610,
					"content": "Hả? Thật sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710611
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710611,
					"content": "Em đã nói em đồng ý rồi, chàng trai lãng mạn của em.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710612
					],
					"speakerTitle": "Yopoyi"
				},
				{
					"id": 752710612,
					"content": "Ngọn gió nhẹ nhàng thổi qua, ôm lấy hai người họ.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
