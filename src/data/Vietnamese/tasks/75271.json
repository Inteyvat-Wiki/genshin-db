			"dialogs": [
				{
					"id": 752710401,
					"content": "Để tôi giúp anh sơn chúng thành màu đỏ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752710402
					]
				},
				{
					"id": 752710402,
					"content": "#Thật sao? Cảm ơn rất nhiều! {F#Cô}{M#Cậu} thật tốt bụng!",
