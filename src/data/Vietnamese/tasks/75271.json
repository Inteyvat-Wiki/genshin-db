				"points": []
			},
			"dialogs": [
				{
					"id": 752710301,
					"content": "Bóng bay màu đỏ lãng mạn! Đẹp thật... Yopoyi yêu dấu của tôi chắc chắn sẽ thích...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710302
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710302,
					"content": "Đúng không nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710303,
						752710304
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710303,
					"content": "Hmm... Tôi không chắc nữa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752710305
					]
				},
				{
					"id": 752710305,
					"content": "#Dù sao đi nữa cũng rất cảm ơn {F#cô}{M#cậu}. Khoan rời đi nhé, tôi cũng muốn giới thiệu {F#cô}{M#cậu} với Yopoyi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710306
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710306,
					"content": "Tính thời gian thì chắc cô ấy sắp đến rồi. Chúng tôi đã hẹn trước với nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710304,
					"content": "Cô ấy chắc chắn sẽ rất cảm động.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752710305
					]
				}
			]
		},
