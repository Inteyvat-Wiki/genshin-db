			},
			"dialogs": [
				{
					"id": 752710201,
					"content": "#Người bạn tốt bụng, gặp được {F#cô}{M#cậu} đúng là may mắn. Hãy giúp tôi sơn bóng bay thành màu đỏ lãng mạn nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ziki"
