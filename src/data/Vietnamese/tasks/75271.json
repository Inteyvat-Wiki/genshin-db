			"dialogs": [
				{
					"id": 752710501,
					"content": "Cảm ơn nhé, người bạn tốt bụng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710502
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710502,
					"content": "#Chắc là Ziki đã gây rắc rối cho {F#cô}{M#cậu} rồi. Suy nghĩ của anh ấy không giống người thường cho lắm, nhưng đây cũng là điểm mà tôi thích ở anh ấy.",
					"roleType": "TALK_ROLE_NPC",
