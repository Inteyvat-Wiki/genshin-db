					"speakerTitle": "Aradashan"
				},
				{
					"id": 731010102,
					"content": "Chúng ta phải sử dụng Ararakalari, cởi bỏ từng lớp khóa \"cục sắt bự hình vuông\", chiến đấu với \"cục sắt bự hình vuông\" không bị Ararakalari áp chế...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731010103
					],
					"speakerTitle": "Aradashan"
				},
				{
					"id": 731010103,
					"content": "Vậy nên, lần này Aradashan sẽ không giúp bạn áp chế \"cục sắt bự hình vuông\" nữa. Nhưng không sao, Arasata, Arayuta và Arasaha sẽ giúp, thử không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aradashan"
				}
			]
		},
