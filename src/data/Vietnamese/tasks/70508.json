				"points": []
			},
			"dialogs": [
				{
					"id": 705080101,
					"content": "#Ồ! Đây không phải là {NICKNAME} sao, đến đúng lúc lắm, ngồi xuống uống vài ly chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080102
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080102,
					"content": "Gặp được bạn ở đây, đúng là một chuyện vui đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080103
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080103,
					"content": "Hai vị sao lại đến đây vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705080104
					]
				},
				{
					"id": 705080104,
					"content": "Khoan đã, tại sao hai người lại đi chung với nhau?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705080105,
					"content": "Vị đại nhân này tự nhiên nổi hứng nói muốn đi nghỉ dưỡng, cho nên chạy đến đây chơi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080106
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080106,
					"content": "Nhưng mà gu đi du lịch của chúng tôi khác nhau, còn chưa leo được ngọn núi nào mà đã đến đây nghỉ ngơi, đúng là bệnh nhà giàu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080107
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080107,
					"content": "Nói câu này nghe hơi tổn thương đấy. Tôi chiều theo ý cô nên mới cố tình chọn một nơi có rượu để uống đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080108
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080108,
					"content": "Chỉ tiếc là vị thuyền trưởng đây hiểu biết sâu rộng, chắc là chê quán rượu nhỏ này rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080109
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080109,
					"content": "Hừ, bữa này tôi mời, vậy là được rồi đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080110
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080110,
					"content": "Beidou muốn bao ăn hả? Bao luôn tôi được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705080111,
					"content": "Paimon, chúng ta đang làm việc đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705080112
					]
				},
				{
					"id": 705080112,
					"content": "Đúng ha, cứ quen miệng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705080113,
					"content": "Hai vị khách quý muốn dùng món gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705080114
					]
				},
				{
					"id": 705080114,
					"content": "Cho tôi một ly Bạch Dương nhỏ nhé, chua một chút càng tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080115
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080115,
					"content": "Một ly Màn Đêm, cỡ bự nhé, cảm ơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080116
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080116,
					"content": "Hiểu rồi, đợi chút nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7050802,
			"completionStepIds": [
				7050804
