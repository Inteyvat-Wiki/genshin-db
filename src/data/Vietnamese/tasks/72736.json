			"trigger": {
				"objectNames": [
					"Tướng Quân Hanakado"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 727360101,
					"content": "Đáng khen, đáng khen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360102
					],
					"speakerTitle": "Tướng Quân Hanakado"
				},
				{
					"id": 727360102,
					"content": "Thật không ngờ Bang Arataki lại có thể đánh bại các cao thủ đấu bọ. Xem ra các ngươi cũng có hiểu biết về đấu bọ đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360103
					],
					"speakerTitle": "Tướng Quân Hanakado"
				},
				{
					"id": 727360103,
					"content": "Ta sẽ rút lại thành kiến trước đây. Tiếp theo, ta sẽ xem các ngươi như một đối thủ xứng tầm để so tài với ta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360104
					],
					"speakerTitle": "Tướng Quân Hanakado"
				},
				{
					"id": 727360104,
					"content": "Tên Thả Bò, đến lượt anh ra trận rồi đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727360105,
					"content": "À ừm, đừng nghĩ những lời nói lúc trước là thật nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360106,
						727360107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727360106,
					"content": "Ra trận đi, Quỷ Vương Đấu Bọ Thiên Tài!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727360108
					]
				},
				{
					"id": 727360108,
					"content": "Hahahahahaha, đương nhiên rồi! Trận đấu cuối cùng này chắc chắn cũng sẽ là ta thắng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360109
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727360109,
					"content": "Mặc dù không biết ngươi đã chỉ huy thuộc hạ thế nào, nhưng kết quả đã rõ: Bang Arataki của bổn đại gia thắng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360110
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727360110,
					"content": "Chuẩn bị tiếp chiêu đi! Tướng Quân Hanakado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727360107,
					"content": "Đại chiến, quỷ vương đối đầu với tướng quân!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727360108
					]
				}
			]
		},
		{
			"id": 7273602,
			"completionStepIds": [
				7273603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7273603",
							"2"
						],
						"stepId": 7273603,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tướng Quân Hanakado"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 727360201,
					"content": "Thì ra là vậy, thì ra là vậy... Đấu thêm một trận đi, chắc chắn ta sẽ có thể nhìn ra cách thức đấu bọ của ngươi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360202
					],
					"speakerTitle": "Tướng Quân Hanakado"
				},
				{
					"id": 727360202,
					"content": "Thắng thua dường như không còn quan trọng nữa, chúng ta cứ đấu một trận thoải mái, thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360203
					],
					"speakerTitle": "Tướng Quân Hanakado"
				},
				{
					"id": 727360203,
					"content": "Hiếm khi có một đối thủ hợp cạ như vậy, vài phút ngắn ngủi đã kết thúc, chưa đã!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360204
					],
					"speakerTitle": "Tướng Quân Hanakado"
				},
				{
					"id": 727360204,
					"content": "Haha, đấu thì đấu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360205
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727360205,
					"content": "Nhưng mà... muốn nhìn thấu bí kíp đấu bọ của bổn đại gia sao? Ngươi đừng có mà ảo tưởng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360206
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727360206,
					"content": "Nếu ngươi chịu thừa nhận bản lĩnh đấu bọ của ta mạnh hơn thì dù có đấu bao nhiêu trận ta cũng sẽ theo đến cùng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360207
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727360207,
					"content": "Ừm, Tên Thả Bò và Tướng Quân Hanakado vẫn đang sục sôi ý chí, cứ để họ tiếp tục đấu bọ đi, đấu đến khi nào hoàn toàn thỏa mãn thì thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}