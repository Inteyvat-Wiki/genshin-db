			"dialogs": [
				{
					"id": 745040101,
					"content": "Hai vị đợi không nổi mà muốn bắt đầu luôn rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745040102
					],
					"speakerTitle": "Alberre"
				},
				{
					"id": 745040102,
					"content": "Nói nhỏ này, thực ra tôi lại cảm thấy kế hoạch của chúng ta không có tiền đồ. Có thời gian thì đến Tiệm Đồng Hồ Lepaute chơi còn hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745040103
					],
					"speakerTitle": "Alberre"
				},
				{
					"id": 745040103,
					"content": "Woa! Đây là lời nói thật lòng à? Cứ thế mà nói vậy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745040104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745040104,
					"content": "Suỵt, khẽ thôi, để người khác nghe thấy thì tôi bị coi là gián điệp mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745040105
					],
					"speakerTitle": "Alberre"
				},
				{
					"id": 745040105,
					"content": "Haiz, chủ đề này nên kết thúc ở đây thì hơn. Dù sao tôi cũng chỉ là người làm thuê, giờ nói chuyện công việc đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745040106
					],
					"speakerTitle": "Alberre"
				},
				{
					"id": 745040106,
					"content": "Tôi nói trước, dữ liệu thu thập lần này chia ra hai phần chính, tôi và Arbon mỗi người phụ trách một phần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745040107
					],
					"speakerTitle": "Alberre"
				},
				{
					"id": 745040107,
					"content": "Phần dữ liệu tôi thu thập là để mô phỏng sức chiến đấu của Đấu Sĩ Đại Diện. Vì vậy cần phải hoàn thành thử thách khiêu chiến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745040108
					],
					"speakerTitle": "Alberre"
				},
				{
					"id": 745040108,
					"content": "Chúng tôi tìm được một số vị trí có ma vật ở ngoại ô, và đã đặt thiết bị thu thập thông tin ở xung quanh. Hai vị chỉ cần tới tiêu diệt đám ma vật đó là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745040109
					],
					"speakerTitle": "Alberre"
				},
				{
					"id": 745040109,
					"content": "Vị trí cụ thể tôi đã đánh dấu trên bản đồ rồi. Đây là cuốn sổ tay ghi lại những lưu ý khác, hai vị có thể xem sau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745040110
					],
					"speakerTitle": "Alberre"
				},
				{
					"id": 745040110,
					"content": "Thế nào, còn thắc mắc gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745040111
					],
					"speakerTitle": "Alberre"
				},
				{
					"id": 745040111,
					"content": "Không thành vấn đề.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745040112
					]
				},
				{
					"id": 745040112,
					"content": "Vậy chúc hai vị thu thập dữ liệu thành công.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alberre"
				}
			]
		}
	]
