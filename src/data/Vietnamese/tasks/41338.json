					"nextDialogs": [
						413380304
					]
				},
				{
					"id": 413380304,
					"content": "Ha ha, đương nhiên rồi, tôi đã phải dày công bố trí đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
