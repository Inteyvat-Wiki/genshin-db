			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tiantian"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413380101,
					"content": "Haiz... Sao vẫn không có người đến nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380102
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380102,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413380103
					]
				},
				{
					"id": 413380103,
					"content": "Nhà lữ hành! Hãy nghe tôi nói... hiện giờ đang trong dịp Tết Hải Đăng, hiệp hội muốn tạo thêm chút không khí cho ngày lễ, nên cần phải chiêu mộ nhà mạo hiểm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380104
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380104,
					"content": "Tôi nghe nói Qian đã nghĩ ra... trò chơi mới gì đó, tôi cũng không thể để bị tuột lại phía sau được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380105
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380105,
					"content": "Vì vậy tôi cũng đã nghĩ ra được hoạt động của mình, gọi là \"Trải Nghiệm Mạo Hiểm\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380106
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380106,
					"content": "Đơn giản mà nói, tôi muốn lấy Đèn Tiêu làm ký hiệu để tạo ra một lộ trình bay trong không trung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380107
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380107,
					"content": "Sau đó, người tham gia cần phải dùng \"Phong Chi Dực\" để bay men theo con đường đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380108
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380108,
					"content": "Vừa hồi hộp vừa có thể mạo hiểm, lại có thể trải nghiệm được cảnh đẹp của Liyue, cảm giác rất tuyệt đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380109
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380109,
					"content": "Tôi vốn dĩ muốn thiết kế hai lộ trình, nhưng khi trình báo với Thiên Nham Quân thì họ bảo tôi cần tìm người đánh giá mức độ an toàn trước, nên tôi phải tìm người bay thử...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380110
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380110,
					"content": "Bạn có rất nhiều kinh nghiệm trong việc mạo hiểm đúng không? Bạn có thể giúp tôi \"đánh giá\" được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380111
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380111,
					"content": "Không thành vấn đề.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413380112
					]
				},
				{
					"id": 413380112,
					"content": "Cảm ơn bạn đã đồng ý giúp tôi, vậy chúng ta mau đến Thiên Hoành Sơn đi, tôi đã bố trí sẵn đường bay ở đó rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tiantian"
				}
			]
		},
		{
