				},
				{
					"id": 413380202,
					"content": "Được rồi, bạn chuẩn bị xong rồi thì chúng ta bắt đầu thôi, vừa thu thập Đèn Tiêu vừa bay đến đích nhé.",
					"roleType": "TALK_ROLE_NPC",
