				"points": []
			},
			"dialogs": [
				{
					"id": 220190601,
					"content": "Các bạn cứ đi xem thử đi, may mắn thì sẽ có thể bắt quả tang luôn. Tôi sẽ đợi tin tốt của mọi người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190602
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190602,
					"content": "Thế nào, còn có chuyện gì không nhà lữ hành?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190603,
						220190607
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190603,
					"content": "Tinh thần của bạn có vẻ không tốt lắm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190604
					]
				},
				{
					"id": 220190604,
					"content": "Một vụ án không có ý nghĩa, một tên tội phạm không có ý nghĩa, thủ pháp cũng không phải tinh tế, chỉ là có chút lượn lẹo thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190605
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190605,
					"content": "Nếu để tôi đánh giá vụ án này...thì chỉ là vụ án \"vô vị\" mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190606
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190606,
					"content": "Nhưng mà, dù sao thì cũng là một vụ án, có thể khép lại thì cũng là chuyện đáng mừng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190607,
					"content": "Bạn không đi chung sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190608
					]
				},
				{
					"id": 220190608,
					"content": "Đối với tôi mà nói thì vụ án này đã kết thúc rồi, những chuyện còn lại tôi sẽ không tham dự vào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190609
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190609,
					"content": "Hơn nữa, với thân thủ này của tôi, lỡ như bị tên tội phạm bắt giữ rồi uy hiếp ngược lại các bạn thì không hay lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190610
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190610,
					"content": "Tôi hiểu rõ khả năng của bản thân. Vì vậy chuyện bắt tội phạm tôi giao cho mọi người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				}
			]
		}
	]
}