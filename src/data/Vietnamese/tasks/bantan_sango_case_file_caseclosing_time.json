						220190405
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190404,
					"content": "Vậy là xong rồi sao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190406
					]
				},
				{
					"id": 220190406,
					"content": "Dù sao thì công việc còn lại cũng do Amano và Andou làm mà. Cảm giác này cũng rất bình thường, đây là thù lao của bạn, bạn cầm lấy thì sẽ có lại chút cảm giác đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190407,
						220190409
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190407,
					"content": "Vậy thù lao của bạn thì sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190408
					]
				},
				{
					"id": 220190408,
					"content": "Tôi? Tôi có thể làm việc phá án giúp đỡ Hiệp Hội, bảo vệ sự bình yên cho khu phố này là đã mãn nguyện rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190412
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190412,
					"content": "Thành thật mà nói, lần này đúng là tôi \"không có thu hoạch gì cả\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190413
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190413,
					"content": "Vừa không thấy được cách phạm tội mới, lại không nghe được các loại tâm lý tội phạm gì hay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190414
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190414,
					"content": "Chỉ là một tên trộm vô vị mà tôi, cũng may không tốn nhiều thời gian lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190415,
						220190417
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190415,
					"content": "Hội trưởng Sango...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190416
					]
				},
				{
					"id": 220190416,
					"content": "Thế nào? Bạn lần đầu tiên thấy một người có hứng thú với \"tội phạm\" như tôi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190419
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190419,
					"content": "Chính vì muốn theo đuổi hứng thú này nên tôi mới trở thành một thám tử.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190420
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190420,
					"content": "...Bạn cũng muốn \"phạm tội\" sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190421
					]
				},
				{
					"id": 220190421,
					"content": "Đúng thế. Tôi cũng rất muốn \"phạm tội\" gì đó, nhưng tôi sẽ có một kế hoạch \"phạm tội\" hoàn hảo, không một sơ hở.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190422
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190422,
					"content": "Nhưng tiếc rằng...khi con người phạm tội thì luôn luôn để lại vết tích gì đó. Mà khi để lại vết tích rồi thì sớm muộn gì cũng sẽ bị quy án thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190423,
						220190424,
						220190425
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190423,
					"content": "Nếu thứ phạm tội không phải là người thì sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190426
					]
				},
				{
					"id": 220190426,
					"content": "Bạn xem, bạn cũng bất giác có ý định \"phạm tội\" rồi đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190427
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190427,
					"content": "Cũng không có gì cả, bạn chỉ là suy nghĩ mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190428
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190428,
					"content": "Tôi cũng thường hay có suy nghĩ liên quan đến vấn đề \"phạm tội\", ví dụ như kế hoạch, lý do...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190429
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190429,
					"content": "Bạn suy nghĩ như vậy để làm gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190430
					]
				},
				{
					"id": 220190430,
					"content": "Đương nhiên là để nâng cao năng lực phá án rồi, những vụ án mà tôi thụ lý gần đây càng ngày càng phức tạp, cho nên không suy nghĩ là không được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190431
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190431,
					"content": "Nhưng mà, những vụ án đó vẫn chưa có vụ nào đáng để ghi nhận là \"vụ án hoàn hảo\" cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190432
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190432,
					"content": "Bạn gặp qua \"vụ án hoàn hảo\" chưa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190433
					]
				},
				{
					"id": 220190433,
					"content": "Tôi đã gặp qua rồi, vụ án đó...đến giờ tôi vẫn chưa tìm được tên tội phạm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190434
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190434,
					"content": "Nhưng mà, tôi vẫn sẽ tin rằng chỉ cần có tội phạm gây án, thì nhất định sẽ để lại vết tích, tôi chỉ là...chưa tìm được vết tích đó mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190435
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190435,
					"content": "Được rồi, đây là thù lao của bạn, cảm ơn bạn đã giúp đỡ tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190436
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190436,
					"content": "Sau này nếu rảnh thì bạn cứ đến đây chơi nhé, không có thời gian thì...cũng không sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190437
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190437,
					"content": "Tôi có cảm giác là, chúng ta sau này vẫn sẽ còn cơ hội hợp tác đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190424,
					"content": "Nếu tội phạm không tồn tại thì sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190426
					]
				},
				{
					"id": 220190425,
					"content": "Làm sao để xóa được tất cả vết tích?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190426
					]
				},
				{
					"id": 220190417,
					"content": "Vậy ra đây là \"thám tử\" sao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190418
					]
				},
				{
					"id": 220190418,
					"content": "Cũng không nên vội kết luận như thế. Nhưng đối với tôi mà nói thì tôi rất có hứng thú với \"tội phạm\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190419
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190409,
					"content": "Bạn không cần gì cả sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190410
					]
				},
				{
					"id": 220190410,
					"content": "Tôi đã thu hoạch được sự \"chính nghĩa\" trong lòng rồi, ngoài ra thì tôi không cần gì nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190411
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190411,
					"content": "...Tôi nói vậy có hợp lý hơn không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190412
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190405,
					"content": "Vẫn chưa có cảm giác kết thúc lắm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190406
					]
				}
			]
		},
