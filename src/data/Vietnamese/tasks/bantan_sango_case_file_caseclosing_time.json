					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220190301,
					"content": "Lần này bắt ngay tại trận, cảm ơn Ryuuji và nhà lữ hành, mọi người vất vả rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190302
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220190302,
					"content": "Tôi và Amano sẽ dẫn đám Đạo Bảo Đoàn này về, việc còn lại cứ giao cho chúng tôi là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190303
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220190303,
					"content": "Nhưng mà, Sango đúng là tài giỏi thật, có thể đoán ra tội phạm một cách chính xác như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190304
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220190304,
					"content": "Dù sao thì cũng là hội trưởng của Trụ Sở Thám Tử mà, những vụ án kiểu này không làm khó được cô ấy đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190305
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220190305,
					"content": "Ryuuji, vậy chúng tôi quay về trước, đợi sau khi xử lý xong đám này thì chúng tôi sẽ qua trụ sở của anh cảm ơn sau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190306
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220190306,
					"content": "Hai vị khách sáo rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190307
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220190307,
					"content": "Được rồi, nhà lữ hành, chúng tôi về hiệp hội báo cáo trước đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				}
			]
		},
		{
			"id": 2201904,
			"completionStepIds": [
