				"points": []
			},
			"dialogs": [
				{
					"id": 220190101,
					"content": "...Vậy thì làm phiền hai vị rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190102
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190102,
					"content": "Cứ giao cho chúng tôi, yên tâm nhé Sango.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190103
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220190103,
					"content": "Dám qua mặt chúng tôi lâu như vậy sao, thật to gan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190104
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220190104,
					"content": "Hơn nữa...lại còn dùng thân phận này để che giấu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190105
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220190105,
					"content": "Dù sao đi nữa thì hôm nay cũng sẽ chấm dứt những ngày phạm tội của hắn. Ryuuji, chuyện tôi bàn giao anh đã nhớ rồi chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190106
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190106,
					"content": "Đã nhớ rồi thưa hội trưởng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190107
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220190107,
					"content": "Vậy thì tốt...nhà lữ hành, bạn cũng đến rồi, thật tốt quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190108,
						220190109
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190108,
					"content": "Bây giờ đi bắt tội phạm đúng không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190111
					]
				},
				{
					"id": 220190111,
					"content": "Chứng cứ đã chuẩn bị xong rồi, hành vi của tội phạm đã bị nắm thóp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190112
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190112,
					"content": "Nhà lữ hành, bạn và Ryuuji, còn có Andou và Amano nữa, các bạn hãy đi bắt tên tội phạm nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190113
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190113,
					"content": "Tên đó có lẽ vẫn còn đồng bọn, nếu như có bạn thì tỉ lệ thành công của hành động lần này sẽ rất cao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190114,
						220190117
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190114,
					"content": "Tôi cần phải làm gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190115
					]
				},
				{
					"id": 220190115,
					"content": "Dùng khả năng của bạn để trấn áp tội phạm là được rồi, để tránh việc hắn...làm những chuyện vượt tầm kiểm soát.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190116
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190116,
					"content": "Nhưng mà theo tôi thấy thì những tên trộm lén lút như vậy cũng sẽ không thể làm ra những hành động mất kiểm soát đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190121
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190121,
					"content": "Nếu như tôi dự đoán không sai thì giờ tên đó đang ở ngoài thành để chôn mớ tài sản vừa trộm được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190122
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190122,
					"content": "Các bạn cứ đi xem thử đi, may mắn thì sẽ có thể bắt quả tang luôn. Tôi sẽ đợi tin tốt của mọi người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190117,
					"content": "Bạn không đi chung sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190118
					]
				},
				{
					"id": 220190118,
					"content": "Đối với tôi mà nói thì vụ án này đã kết thúc rồi, những chuyện còn lại tôi sẽ không tham dự vào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190119
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190119,
					"content": "Nhà lữ hành, bạn có thể dùng khả năng của bạn để trấn áp tội phạm, tránh việc hắn sẽ làm ra...những hành động vượt tầm kiểm soát.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190120
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190120,
					"content": "Nhưng mà theo tôi thấy thì những tên trộm lén lút như vậy cũng sẽ không thể làm ra những hành động mất kiểm soát đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190121
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190109,
					"content": "Sắp khép lại vụ án rồi đúng không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190110
					]
				},
				{
					"id": 220190110,
					"content": "Ừm, nếu mọi thứ thuận lợi thì hôm nay sẽ phá được án.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190111
					],
					"speakerTitle": "Sango"
				}
			]
		},
		{
