			"dialogs": [
				{
					"id": 220190201,
					"content": "Đã phát hiện tên đó rồi, quả nhiên là đang chôn tang vật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190202,
						220190204
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220190202,
					"content": "Chúng ta lên!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190203
					]
				},
				{
					"id": 220190203,
					"content": "Đợi đã, nhà lữ hành, giờ chưa phải lúc chúng ta xông lên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190206
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220190206,
					"content": "Đợi thêm chút nữa...có thể sắp đến lúc rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190207
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220190207,
					"content": "Tên này, anh làm gì vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190208
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220190208,
					"content": "Bỏ những thứ trên tay xuống mau, không được cử động!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190209
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220190209,
					"content": "Các, các người...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190210
					],
					"speakerTitle": "Ishikawa Hachirou"
				},
				{
					"id": 220190210,
					"content": "Đáng ghét...! Cùng xông lên đi! Giải quyết xong hai tên này thì chúng ta sẽ có thể cao chạy xa bay!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190211
					],
					"speakerTitle": "Ishikawa Hachirou"
				},
				{
					"id": 220190211,
					"content": "Chỉ là vài tên Đạo Bảo Đoàn thôi mà cũng dám hống hách à...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190212
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220190212,
					"content": "Andou, Amano, tôi đến giúp sức đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190213
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220190213,
					"content": "Trông cậy vào các bạn rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190214
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220190214,
					"content": "Nhà lữ hành, đến lượt chúng ta rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190215
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220190215,
					"content": "Phiền phức vậy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190216
					]
				},
				{
					"id": 220190216,
					"content": "Đây là dặn dò của hội trưởng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190217
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220190217,
					"content": "Được rồi, chúng ta lên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220190204,
					"content": "Xông lên chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190205
					]
				},
				{
					"id": 220190205,
					"content": "Đợi chút đã, hiện giờ chưa phải lúc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190206
					],
					"speakerTitle": "Ryuuji"
				}
			]
		},
		{
