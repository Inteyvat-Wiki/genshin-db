			"dialogs": [
				{
					"id": 220190401,
					"content": "...Andou và Amano giờ có lẽ đã dẫn tội phạm về đến hiệp hội rồi đó hội trưởng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190402
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220190402,
					"content": "Ừm, tôi biết rồi, đã giải quyết xong thì tốt rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190403
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190403,
					"content": "Nhà lữ hành, bạn cũng về rồi sao, lần này vất vả cho bạn rồi.",
					"roleType": "TALK_ROLE_NPC",
