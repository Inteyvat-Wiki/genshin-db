					"Huai'an"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221130101,
					"content": "Đúng thật là việc xấu cứ một đống...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130102
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130102,
					"content": "Vẫn đang sửa cầu thang sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221130103
					]
				},
				{
					"id": 221130103,
					"content": "Bạn đến vừa đúng lúc. Cảm ơn bạn về lần trước... lần này vẫn phải làm phiền bạn nữa rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130104
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130104,
					"content": "Vết gãy hơi lớn, và các tấm ván dùng không đủ. Tôi đã mua một lô khác. Vốn định để người thợ khuân vác của quán trọ mang lên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130105
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130105,
					"content": "Nhưng tôi không ngờ rằng anh ta đã bị một nhóm quái vật tấn công trên đường, do quá hoảng loạn mà bỏ lại tất cả các miếng gỗ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130106
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130106,
					"content": "Người này đã bị hoảng sợ. Sau khi chỉ ra nơi lô gỗ bị rơi, anh ta nhất quyết không quay trở lại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130107
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130107,
					"content": "Tôi muốn đi, nhưng chỉ có thể làm phiền bạn làm hộ, bạn có thể giúp tôi lấy lại những tấm ván đó không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130108,
						221130110
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130108,
					"content": "Tôi biết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221130109
					]
				},
				{
					"id": 221130109,
					"content": "Vậy phiền bạn rồi, tôi ở đây đợi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130110,
					"content": "Vết gãy to như vậy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221130111
					]
				},
				{
					"id": 221130111,
					"content": "Đừng nhìn tôi như thế, chỗ này không phải do một con quái vật đập phá, phải quái vật lớn thế nào mới đập thành như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130112
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130112,
					"content": "Lỗ hổng này xuất hiện là như thế này... Trong nhà trọ có hai vị khách, họ có chút thù hằn, người trốn kẻ tìm, cứ như vậy không gặp được nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130113
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130113,
					"content": "Không ngờ cả hai đều đến nhà trọ chúng tôi thuê phòng, khi vừa lên cầu thang là thấy nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130114
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130114,
					"content": "Sau đó hai người lao vào đánh nhau một hồi, đánh vỡ cả cầu thang một miếng to, tôi phải khuyên mãi mới được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130115
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130115,
					"content": "Thật bực mình... lúc đó tôi đã thu thêm tiền phòng của họ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130116
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130116,
					"content": "Không buôn chuyện nữa, bạn giúp tôi lấy lô gỗ về, tôi phải sửa chỗ này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130117
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130117,
					"content": "Còn gẫy tiếp thì tôi sẽ không thu thêm tiền phòng nữa, ai làm hỏng thì người đó sửa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				}
			]
		},
