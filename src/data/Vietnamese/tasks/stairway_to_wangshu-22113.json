			"dialogs": [
				{
					"id": 221130501,
					"content": "Vậy là đã sửa xong, thế nào, tay nghề của tôi cũng không tồi phải không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130502
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130502,
					"content": "Như vậy thuận tiện cho khách đến nhà trọ hơn nhiều. Haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130503
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130503,
					"content": "Đúng rồi, bạn cầm lấy, thật vất vả cho bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130504
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130504,
					"content": "Nếu có thời gian, bạn có thể ngồi uống một tách trà và ăn đồ điểm tâm. Đầu bếp của chúng tôi rất lành nghề.",
					"roleType": "TALK_ROLE_NPC",
