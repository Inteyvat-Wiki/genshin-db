			},
			"dialogs": [
				{
					"id": 745280401,
					"content": "#Là {F#cô}{M#cậu} à? Hành trình của chúng ta lại giao thoa với nhau rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745280402,
						745280403
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 745280402,
					"content": "Skirk, lâu rồi không gặp.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745280404
					]
				},
				{
					"id": 745280404,
					"content": "Tôi đang quan sát \"vết sẹo\" thế giới này để lại. Vụ nổ lần đó đã san bằng nơi đây thành một đống đổ nát...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745280405
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 745280405,
					"content": "Nhưng ngày nay, con người lại xây dựng những thứ mới mẻ trên đống đổ nát.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745280406
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 745280406,
					"content": "Vạn vật đều có điểm kết thúc, nhưng sau khi lụi tàn, cũng sẽ thai nghén những khả năng mới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745280407
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 745280407,
					"content": "#Sức mạnh của {F#cô}{M#cậu} đã tiến bộ hơn so với lần gặp trước rồi. Xem ra {F#cô}{M#cậu} không lơ là việc rèn luyện. Tốt lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745280408,
						745280409
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 745280408,
					"content": "Thật ra, tôi có một thỉnh cầu nhỏ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745280410
					]
				},
				{
					"id": 745280410,
					"content": "Chụp ảnh à? Đối với thế giới này thì tôi chỉ là khách qua đường, đâu cần phải để lại dấu vết tồn tại nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745280411,
						745280412
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 745280411,
					"content": "Nhưng với tôi, cô không phải khách qua đường.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745280413
					]
				},
				{
					"id": 745280413,
					"content": "#...Nếu đó là điều {F#cô}{M#cậu} muốn, vậy thì cứ thực hiện đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745280414
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 745280414,
					"content": "Tôi ở ngay đây. Có thể bắt đầu bất cứ lúc nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Skirk"
				},
				{
					"id": 745280412,
					"content": "Mỗi lần gặp lại đều đáng để ghi nhớ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745280413
					]
				},
				{
					"id": 745280409,
					"content": "Tôi hy vọng có thể chụp cho cô một bức hình.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745280410
					]
				},
				{
					"id": 745280403,
					"content": "Cô đang làm gì ở đây thế?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745280404
					]
				}
			]
		}
