			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732011301,
					"content": "\"Đã nhiều năm trôi qua rồi mà nơi này vẫn náo nhiệt như thế. Mỗi lần đến đây, tôi đều nhớ đến quãng thời gian tranh luận với anh ta trong quán cà phê chỉ vì cách lý giải về một ký tự.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011302
					],
					"speakerTitle": "Bảng Tin Nhắn"
				},
				{
					"id": 732011302,
					"content": "Nhờ có bạn mà tiệm mới có được như hôm nay, sau này thường xuyên ghé đến nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Tin Nhắn"
				}
			]
		}
	]
