			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732010101,
					"content": "Đây là bảng tin nhắn của Tiệm Cà Phê Puspa. Vì một số nguyên nhân, tiệm tạm thời do tôi quản lý, nếu quý khách có cảm nghĩ gì thì xin vui lòng để lại lời nhắn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Tin Nhắn"
				}
			]
		},
		{
			"id": 7320102,
			"completionStepIds": [
				7320102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320102",
							"2"
						],
						"stepId": 7320102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732010201,
					"content": "\"Tuần này tiếp tục kể về câu chuyện truyền kỳ của bậc anh hùng Antara!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010202
					],
					"speakerTitle": "Bảng Tin Nhắn"
				},
				{
					"id": 732010202,
					"content": "\"Do \"người kể chuyện đặc biệt của Tiệm Cà Phê Puspa\" - Maddah trình bày, hãy đón chờ nhé!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010203
					],
					"speakerTitle": "Bảng Tin Nhắn"
				},
				{
					"id": 732010203,
					"content": "Maddah... Cửa tiệm sẽ tặng anh một tách cà phê nếu anh ngừng việc quảng cáo tại đây đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Tin Nhắn"
				}
			]
		},
		{
			"id": 7320103,
			"completionStepIds": [
				7320103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320103",
							"2"
						],
						"stepId": 7320103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732010301,
					"content": "\"Hì hì, Gata, hì hì.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010302
					],
					"speakerTitle": "Bảng Tin Nhắn"
				},
				{
					"id": 732010302,
					"content": "Dường như Gata cũng rất thích cô đấy, cô Nilou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Tin Nhắn"
				}
			]
		},
		{
			"id": 7320104,
			"completionStepIds": [
				7320104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320104",
							"2"
						],
						"stepId": 7320104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732010401,
					"content": "\"Hội bài Puspa \"Thất Thánh Triệu Hồi\" đang chiêu mộ!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010402
					],
					"speakerTitle": "Bảng Tin Nhắn"
				},
				{
					"id": 732010402,
					"content": "\"Muốn cùng nhau giao lưu kỹ xảo tổ hợp thẻ bài thì tới bàn chơi tìm tôi!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010403
					],
					"speakerTitle": "Bảng Tin Nhắn"
				},
				{
					"id": 732010403,
					"content": "Anh Nayab, chí ít hãy gọi một tách cà phê nếu muốn so kỹ thuật đánh bài ở tiệm nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Tin Nhắn"
				}
			]
		},
		{
			"id": 7320105,
			"completionStepIds": [
				7320105
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320105",
							"2"
						],
						"stepId": 7320105,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732010501,
					"content": "\"Gần đây liên tiếp phát sinh nhiều vụ án buôn lậu Hũ Tri Thức.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010502
					],
					"speakerTitle": "Bảng Tin Nhắn"
				},
				{
					"id": 732010502,
					"content": "\"Matra đặc biệt nhắc nhở, vui lòng thông qua các kênh chính thống để nhận được kiến thức liên quan mà bạn muốn.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010503
					],
					"speakerTitle": "Bảng Tin Nhắn"
				},
				{
					"id": 732010503,
					"content": "\"Nhận kiến thức cấm thông qua các kênh bất hợp pháp, một khi phát hiện sẽ bị tước đoạt tư cách học tập ở Giáo Viện, xin hãy lưu ý.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Tin Nhắn"
				}
			]
		},
		{
			"id": 7320106,
			"completionStepIds": [
				7320106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320106",
							"2"
						],
						"stepId": 7320106,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732010601,
					"content": "\"So với quán rượu thì hoàn cảnh nơi này tốt hơn đối với học sinh đang chuẩn bị cho kỳ thi như tôi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010602
					],
					"speakerTitle": "Bảng Tin Nhắn"
				},
				{
					"id": 732010602,
					"content": "\"Chẳng những có cà phê giúp tỉnh táo, mà còn có rất nhiều tiền bối có thể thỉnh giáo.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010603
					],
					"speakerTitle": "Bảng Tin Nhắn"
				},
				{
					"id": 732010603,
					"content": "\"Chủ tiệm cũng đã nói, từ kết quả xem bói cho thấy năm nay chắc chắn tôi có thể thông qua kỳ thi của Giáo Viện!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010604
					],
					"speakerTitle": "Bảng Tin Nhắn"
				},
				{
					"id": 732010604,
					"content": "Mong bạn được như mong muốn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Tin Nhắn"
				}
			]
		},
		{
			"id": 7320107,
			"completionStepIds": [
				7320107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320107",
							"2"
						],
						"stepId": 7320107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732010701,
					"content": "\"Mọi người cẩn thận, lần trước khi bạn tôi lên đường vào giữa khuya thì gặp phải Vua Hổ Lông Dài ở khu rừng phía tây bắc! May mà mạng lớn nên chẳng bị thương gì, nhưng mà cũng đừng nên ra ngoài vào buổi tối!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Tin Nhắn"
				}
			]
		},
		{
			"id": 7320108,
			"completionStepIds": [
				7320108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320108",
							"2"
						],
						"stepId": 7320108,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732010801,
					"content": "\"Nghiên cứu mới nhất của đại học giả Pursina cho thấy, uống nhiều cà phê có thể nâng cao khả năng tư duy của não bộ.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010802
					],
					"speakerTitle": "Bảng Tin Nhắn"
				},
				{
					"id": 732010802,
					"content": "\"Nếu muốn thi vào Giáo Viện, hãy ghé đến tiệm cà phê này nhiều hơn.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010803
					],
					"speakerTitle": "Bảng Tin Nhắn"
				},
				{
					"id": 732010803,
					"content": "Mặc dù rất cảm ơn vì đã quảng cáo cho tiệm, nhưng cà phê chỉ có thể giúp mọi người tỉnh táo mà thôi... Với lại, những lời nói vô căn cứ thế này liệu có bị Mahamata để mắt tới không?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Tin Nhắn"
				}
			]
		},
		{
			"id": 7320109,
			"completionStepIds": [
				7320109
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320109",
							"2"
						],
						"stepId": 7320109,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732010901,
					"content": "\"Những người đến tiệm cà phê chơi bài hãy nhớ kỹ bài học của tôi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010902
					],
					"speakerTitle": "Bảng Tin Nhắn"
				},
				{
					"id": 732010902,
					"content": "\"Lúc chơi \"Thất Thánh Triệu Hồi\", không nên tùy tiện tạo ra thẻ bài ảo để lừa người chơi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010903
					],
					"speakerTitle": "Bảng Tin Nhắn"
				},
				{
					"id": 732010903,
					"content": "\"Dưới sự chỉ bảo của đại nhân Jackal, tôi đã nhận ra những sai lầm của mình, và đã tự kiểm điểm lại.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010904
					],
					"speakerTitle": "Bảng Tin Nhắn"
				},
				{
					"id": 732010904,
					"content": "\"Có thể nhận ra sai lầm thì đã hơn hẳn một số người rồi. Nhưng ai là đại nhân Jackal vậy?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Tin Nhắn"
				}
			]
		},
