			"dialogs": [
				{
					"id": 762050101,
					"content": "Làm sao đây... Phải làm thế nào bây giờ... Tính thời gian thì họ sắp tới rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050102
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050102,
					"content": "Chúng tôi đến rồi đây! Này này, Nicole, đừng đẩy chúng tôi ra ngoài chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762050103,
					"content": "Khụ khụ... Xin lỗi nhé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050104
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050104,
					"content": "Vẫn chưa chuẩn bị xong sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762050105
					]
				},
				{
					"id": 762050105,
					"content": "Phải giải thích thế nào đây... Không được, khó mà nói rõ, đành phải kể lại từ đầu thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050106
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050106,
					"content": "...Cụ thể phải kể từ lần đầu tiên các ma nữ khiêu chiến Phong Thần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050107
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050107,
					"content": "Vậy thì xa quá rồi đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762050108,
					"content": "Ôi, quá đáng, chính miệng nói ra như vậy thì thật mất mặt... Thôi kệ vậy, hết cách rồi, sự thật rành rành thế mà... Chỉ cần Alice không biết thì chắc sẽ không bị chê cười đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050109
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050109,
					"content": "Những suy nghĩ trong lòng cô ấy dường như lại lộ ra ngoài rồi, hơn nữa, cô ấy cũng chẳng thể \"chính miệng\" nói ra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762050110,
					"content": "Suỵt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762050111
					]
				},
				{
					"id": 762050111,
					"content": "Tôi đã tạm giấu chiếc lông vũ ở nơi cao nhất trong phòng đọc sách, nghĩ rằng nếu tăng độ khó lên thì cảm giác thành tựu khi hoàn thành thử thách cũng sẽ mạnh mẽ hơn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050112
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050112,
					"content": "Nhưng tôi thật sự không giỏi khống chế những cơn gió tùy hứng đó, có vẻ như đến một độ cao nhất định thì dù thế nào cũng không thể bay lên được nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050113
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050113,
					"content": "Không thể dùng phép thuật để đưa lông vũ xuống sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762050114,
					"content": "Vậy thì còn gì thú vị nữa chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050115
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050115,
					"content": "Ừm, cũng đúng... vậy đúng là bế tắc thật rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762050116,
					"content": "Nicole, có thể nói thêm một câu không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762050117
					]
				},
				{
					"id": 762050117,
					"content": "Nói gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050118,
						762050119
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050118,
					"content": "Ở Simulanka, ngôn ngữ chính là phép thuật.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762050120
					]
				},
				{
					"id": 762050120,
					"content": "A! Tôi hiểu rồi! Chúng ta thử xem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050121
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050121,
					"content": "Ôi, quá đáng, chính miệng nói ra như vậy thì thật mất mặt...",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						762050122
					]
				},
				{
					"id": 762050122,
					"content": "Thôi kệ vậy, hết cách rồi, sự thật rành rành thế mà...",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						762050123
					]
				},
				{
					"id": 762050123,
					"content": "Chỉ cần Alice không biết thì chắc sẽ không bị chê cười đâu...",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": []
				},
				{
					"id": 762050119,
					"content": "Nếu có thể biến những lời nói của cô thành bậc thang...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762050120
					]
				}
			]
