			"dialogs": [
				{
					"id": 762050201,
					"content": "Khoảng cách dài quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762050202,
					"content": "Vạn vật dẫn lối, tên thánh khắc ghi. Văn chương giao thoa, chư sứ đồng hành. Tại thánh điện này, lấy ngôn từ đúc thành bậc thang tiến bước.",
					"roleType": "TALK_ROLE_NPC",
