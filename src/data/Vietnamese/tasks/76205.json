			"dialogs": [
				{
					"id": 762050301,
					"content": "Lấy được rồi! Tốt quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762050302,
					"content": "Tuy... tuy bây giờ đầu óc vẫn còn đang ong ong, vì để dựng thang, có vẻ như cô ấy đã đặc biệt dùng sức khi nói...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762050303,
					"content": "Hửm? Phàn nàn tôi sao? Không sợ ma nữ hùng mạnh như tôi đây chỉ cần động ngón tay là biến hết đồ trong rương thành Cà Rốt sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050304,
						762050305
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050304,
					"content": "Paimon không hiểu chuyện...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762050306
					]
				},
				{
					"id": 762050306,
					"content": "Hì hì, đương nhiên rồi, sao tôi có thể là Thiên Sứ lặng im nhớ hết những chuyện vụn vặt thường ngày trong đầu được chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050307
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050307,
					"content": "#...Và rồi đến ngày hôm đó, {NICKNAME} cùng Paimon bước lên bảy bậc thang, nhưng thứ chờ đợi trước mặt họ lại là một bóng lưng quen thuộc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050308
