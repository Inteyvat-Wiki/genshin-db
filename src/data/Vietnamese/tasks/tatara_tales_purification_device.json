			"dialogs": [
				{
					"id": 721160401,
					"content": "Cảm ơn bạn, bấy nhiêu chắc là đủ để thiết lập kết cấu cơ bản rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160402
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160402,
					"content": "Tiếp theo chính là chờ số đèn hiệu kia thu thập đủ dữ liệu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160403
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160403,
					"content": "Chờ khi nắm được dữ liệu, tôi sẽ tính toán chúng và điều chỉnh lại thiết bị này một chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160404
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160404,
					"content": "Sau khi mọi thứ sẵn sàng, chúng ta sẽ đi giải quyết triệt để chuyện này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				}
			]
