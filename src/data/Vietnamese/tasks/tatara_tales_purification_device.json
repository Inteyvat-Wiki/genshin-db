			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xavier"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721160101,
					"content": "Vẫn cần đợi thêm một khoảng thời gian nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160102
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160102,
					"content": "Đã thu thập xong dữ liệu chưa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721160103
					]
				},
				{
					"id": 721160103,
					"content": "Là bạn à, thật vinh hạnh. Dữ liệu tạm thời chưa thu thập xong, tôi nghĩ chắc vẫn cần một chút thời gian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160104
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160104,
					"content": "Nhưng, tôi cũng nhân dịp này suy nghĩ một chút về kết cấu của máy thanh tẩy khẩn cấp...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160105,
						721160107
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160105,
					"content": "Máy thanh tẩy khẩn cấp là gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721160106
					]
				},
				{
					"id": 721160106,
					"content": "Chỉ là mẹo nhỏ khẩn cấp của tôi mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160109
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160109,
					"content": "Theo kế hoạch mà chúng ta thương lượng trước đó, chúng ta phải đồng thời đối phó với Fatui và Họa Thần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160110
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160110,
					"content": "Tôi tin rằng bạn thừa sức xử lý đám Fatui kia, còn tôi, đương nhiên sẽ phải phụ trách xử lý Họa Thần rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160111
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160111,
					"content": "Máy thanh tẩy khẩn cấp này chính là thiết bị giúp tôi xử lý đám Họa Thần kia. Nhưng để chế tạo thiết bị này vẫn cần bạn giúp một tay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160112,
						721160113
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160112,
					"content": "Cần tôi giúp việc gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721160117
					]
				},
				{
					"id": 721160117,
					"content": "Để thiết bị này có thể vận hành thuận lợi trong \"Lò Luyện Mikage\", tôi cần một số nguyên liệu đặc biệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160118
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160118,
					"content": "\"Tủy Pha Lê\" loại tinh thể chứa sức mạnh Họa Thần thuần khiết này rất thích hợp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160119
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160119,
					"content": "Trên thực tế, bí mật Thép Ngọc nổi tiếng chính là khi nấu chảy thép, nguyên liệu này được thêm vào theo cách đặc biệt để tăng độ cứng của thép.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160120
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160120,
					"content": "Đương nhiên rồi, \"phương thức đặc biệt này\" thuộc về bí mật thương mại rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160121
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160121,
					"content": "Tôi nhớ, ở gần đây có loại tinh thể này. Phiền bạn giúp tôi thu thập 3 Tủy Pha Lê nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160122
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160122,
					"content": "Tôi biết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721160123
					]
				},
				{
					"id": 721160123,
					"content": "Vậy việc này phiền bạn rồi, sau khi thu thập 3 Tủy Pha Lê hãy đem về cho tôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160113,
					"content": "Tôi còn tưởng nó có tên chính thức...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721160114
					]
				},
				{
					"id": 721160114,
					"content": "Tên chính thức chẳng phải chính là \"Máy Thanh Tẩy Khẩn Cấp\" sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160115
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160115,
					"content": "À...ý bạn là, mã vạch sản phẩm chính thức và ngày sản xuất ấy à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160116
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160116,
					"content": "Đây là thiết bị khẩn cấp thôi, không cần mấy thứ đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160117
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160107,
					"content": "Đây cũng là \"cách xử lý khẩn cấp\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721160108
					]
				},
				{
					"id": 721160108,
					"content": "Chắc là vậy, nhưng mẹo này bình thường tôi sẽ không cung cấp khi phục vụ khách hàng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160109
					],
					"speakerTitle": "Xavier"
				}
			]
		},
