					"nextDialogs": [
						708101205
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 708101205,
					"content": "Thứ lấy được từ trong xe...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708101206
					]
				},
				{
					"id": 708101206,
					"content": "Ồ, đó là nguyên liệu pha rượu loại mới tôi vừa mới đặt mua, tôi đang định làm mấy loại rượu mới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101207
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 708101207,
					"content": "Được rồi, để tôi pha chế cho bạn đồ uống đặc sắc như đã hứa, tôi xem xem... nguyên liệu trong này chắc đã đủ dùng, chờ một lát.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Charles"
				}
			]
