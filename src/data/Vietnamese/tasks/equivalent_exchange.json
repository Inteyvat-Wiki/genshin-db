					"nextDialogs": [
						708101708
					]
				},
				{
					"id": 708101708,
					"content": "Quan chấp hành đại nhân... kẻ thấp cổ bé họng như tôi nhiều nhất cũng chỉ nghe được chút lời đồn đại mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101709
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 708101709,
					"content": "Tôi nói bừa ấy mà, bạn nghe cho vui là được, không cần xem là thật, tôi cũng là nghe người ta nói vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101710
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 708101710,
					"content": "Quan Chấp Hành đứng thứ 6 - đại nhân Scaramouche, nghe nói rất khó tính... rất nhiều người không thích ngài ấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101711
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 708101711,
					"content": "Nguyên nhân à... biết nói sao nhỉ, có người bảo, là vì đại nhân Scaramouche tính cách không được tốt lắm, có người lại bảo là ngài ấy nói chuyện quá thẳng thắn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101712
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 708101712,
					"content": "Tôi quen một người bên cạnh Quan Chấp Hành đại nhân, anh ta nói với tôi rằng, một số Quan Chấp Hành cũng không thích đại nhân Scaramouche lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101713
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 708101713,
					"content": "Nhưng, đại nhân Scaramouche tốt xấu gì cũng là Quan Chấp Hành, không biết so với kẻ thấp cổ bé họng như tôi liệu tốt hơn được bao nhiêu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		},
