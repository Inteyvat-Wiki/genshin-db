			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sara"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708100201,
					"content": "Về đặc sản thành Mondstadt...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708100202
					]
				},
				{
					"id": 708100202,
					"content": "Đặc sản thành Mondstadt? Tuy món ăn của chúng tôi có thể nói là đặc sắc của Mondstadt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100203
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 708100203,
					"content": "Nhưng, trong tiệm chúng tôi các món thông thường đều không thể để quá lâu, cũng không tiện mang theo đi đường dài.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100204
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 708100204,
					"content": "Dù chúng tôi cũng có thể gia công món ăn thông thường thành món dự trữ mang theo người... Nhưng làm vậy thì khẩu vị sẽ giảm đi rất nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100205
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 708100205,
					"content": "Không sao.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708100206
					]
				},
				{
					"id": 708100206,
					"content": "Được rồi, nếu bạn vẫn muốn vậy thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100207
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 708100207,
					"content": "Nhưng hàng trong tiệm đã để một thời gian quá lâu rồi, nếu bạn dùng để tặng người khác, tốt nhất cứ nên làm một phần mới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100208
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 708100208,
					"content": "Xin hỏi bạn của bạn là người ở đâu? Để tôi nghĩ xem nên tặng món ăn gì mới tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100209,
						708100211
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 708100209,
					"content": "Đến từ Snezhnaya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708100210
					]
				},
				{
					"id": 708100210,
					"content": "Snezhnaya? Là nơi rất xa đó, phải nghĩ kỹ xem dùng món gì tốt nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100213
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 708100213,
					"content": "Ừm, tuy không biết khẩu vị của người Snezhnaya ra sao, nhưng có một món chắc chắn không tệ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100214
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 708100214,
					"content": "Bạn hãy giúp tôi làm một phần Gỏi Mãn Nguyện đi, sau đó tôi sẽ giúp bạn xử lý một chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100215
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 708100215,
					"content": "Lâu lắm rồi chưa gia công qua rồi, tôi phải đi tìm dụng cụ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				},
				{
					"id": 708100211,
					"content": "Đến từ Fatui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708100212
					]
				},
				{
					"id": 708100212,
					"content": "Fa.. Fatui? Bạn nói mấy người đến từ Snezhnaya... bạn giao thiệp rộng thật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100213
					],
					"speakerTitle": "Sara"
				}
			]
		},
