			},
			"dialogs": [
				{
					"id": 708102401,
					"content": "(Lấy \"Đồ uống đặc sắc\" ra)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708102402
					]
				},
				{
					"id": 708102402,
					"content": "Đồ uống này cũng không tồi... Ừm, nhìn ngon đấy, để tôi thử xem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708102403
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 708102403,
					"content": "Ngon nhất khi uống lạnh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708102404
					]
				},
				{
					"id": 708102404,
					"content": "Hả? Phải uống lạnh à, thế thôi vậy, tôi đem về đây, về rồi sẽ tìm đá lạnh dễ hơn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708102405
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 708102405,
					"content": "Vẫn là câu đó, Fatui chúng tôi nói được làm được. Giao việc cho chúng tôi, bạn tuyệt đối không bị thiệt thòi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708102406
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 708102406,
					"content": "Có gì muốn hỏi thì mau nói đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708102407
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 708102407,
					"content": "Về các vị Quan Chấp Hành khác.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708102408
					]
				},
				{
					"id": 708102408,
					"content": "Quan chấp hành đại nhân... kẻ thấp cổ bé họng như tôi nhiều nhất cũng chỉ nghe được chút lời đồn đại mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708102409
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 708102409,
					"content": "Tôi nói bừa ấy mà, bạn nghe cho vui là được, không cần xem là thật, tôi cũng là nghe người ta nói vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708102410
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 708102410,
					"content": "Bạn có biết đại nhân Tartaglia không? Nghe nói vị đại nhân đó thường du ngoạn bên ngoài, khi trở về còn mang theo cả quà cho người trong nhà nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708102411
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 708102411,
					"content": "Một người quen của tôi nói với tôi là anh ta nghe nói các em trai em gái của đại nhân Tartaglia rất thích anh ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708102412
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 708102412,
					"content": "Haiz, nhưng tôi không muốn bị điều đi làm thuộc hạ của đại nhân Tartaglia đâu, làm thuộc hạ của vị đại nhân đó nói không chừng tôi lại phải bôn ba khắp nơi nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708102413
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 708102413,
					"content": "Mong cấp trên có lòng nhân ái, điều tôi đến nơi có khí hậu dễ chịu, để tôi an dưỡng tuổi già...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		}
	]
