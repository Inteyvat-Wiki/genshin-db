			"dialogs": [
				{
					"id": 708101501,
					"content": "(Lấy ra \"Món ăn của Người Săn Hươu\")",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708101502
					]
				},
				{
					"id": 708101502,
					"content": "Đây là món gì, còn đặc biệt phơi khô, quả là dễ mang theo, nhưng mùi vị chắc không ngon lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101503
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 708101503,
					"content": "Hahaha, có điều tốt xấu gì cũng là đặc sản của Mondstadt, cái này tôi sẽ mang về tặng cho người khác nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101504
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 708101504,
					"content": "Bạn làm việc cừ lắm, có gì muốn hỏi thì mau hỏi đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101505
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 708101505,
					"content": "Về Signora",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708101506
					]
				},
				{
					"id": 708101506,
					"content": "Tôi biết ngay bạn muốn hỏi cái này, nhưng cái này tôi thật sự không biết, bản thân tôi cũng thấy kỳ lạ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101507
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 708101507,
					"content": "Cấp trên gửi tôi đến thành Mondstadt làm việc cho đại nhân Signora, nhưng cho đến hôm nay đại nhân Signora vẫn chưa kêu tôi làm việc gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101508
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 708101508,
					"content": "Nghe người ta nói, đại nhân Signora ghé qua thành Mondstadt một lần, sau đó lại rời khỏi, nghe nói tâm trạng cô ấy rất tốt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101509
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 708101509,
					"content": "Haiz, cũng không biết có phải là đại nhân Signora đã làm xong việc rồi không, nếu vậy có phải tôi cũng có thể trở về rồi không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101510
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 708101510,
					"content": "Không hiểu sao cả ngày ở đây cứ bị tu nữ và Kỵ Sĩ Tây Phong nhìn chằm chằm, bản thân tôi cũng không được thoải mái...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		},
