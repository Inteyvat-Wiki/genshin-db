						708101602
					]
				},
				{
					"id": 708101602,
					"content": "Đây là, kẹp sách... Hừ, cũng được, coi như đồ trang sức cũng không tồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101603
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 708101603,
					"content": "Quả nhiên nhờ bạn là không sai mà, có gì muốn hỏi thì mau hỏi đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101604
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 708101604,
					"content": "Bạn phải về rồi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708101605
					]
				},
				{
					"id": 708101605,
					"content": "Tôi? Tôi muốn chứ, tôi muốn về từ sớm rồi, trong thành Mondstadt này chán lắm, cũng không có ai chuyện trò với tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101606
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 708101606,
					"content": "Tôi chỉ có thể ngồi đây cả ngày, bị mấy tu nữ lườm cháy mắt, cứ như tôi làm điều gì thương thiên hại lý lắm ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101607
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 708101607,
					"content": "Nhưng mà các quý ông trong khách sạn Goth, dạo này lại đóng cửa không ra ngoài, một chút tin tức cũng không có.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101608
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 708101608,
					"content": "Theo tôi, nếu đại nhân Signora đã làm xong chuyện, vậy thì mau đi thôi. Dù sao người Mondstadt cũng không thích bọn tôi, cứ ở lại đây không phải là tự chịu khổ à.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101609
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 708101609,
					"content": "Nhưng, bên trên mãi chưa ra lệnh quay lại, tôi chỉ có thể nghĩ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
