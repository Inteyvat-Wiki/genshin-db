					"Viktor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708100121,
					"content": "Bạn còn chuyện gì khác không? Nếu muốn hỏi thì mau lên, đừng lề mề nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100122,
						708100127
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 708100122,
					"content": "Bạn tìm tôi làm gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708100123
					]
				},
				{
					"id": 708100123,
					"content": "Ha, câu hỏi rất hay, tôi tìm bạn làm gì... bởi vì người Fatui như tôi ở trong thành Mondstadt không được yêu thích cho lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100124
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 708100124,
					"content": "Ngày trước là tu nữ nhìn tôi bằng ánh mắt kỳ lạ, bây giờ ánh mắt của Kỵ Sĩ Tây Phong nhìn tôi cứ như là muốn bắt tôi ngay lập tức vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100125
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 708100125,
					"content": "Ngoài việc có thể nói chuyện với Nhà Lữ Hành như bạn ra, tôi thực sự không dám đi nhờ người Mondstadt khác giúp đỡ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100126
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 708100126,
					"content": "Tôi cứ thấy kỳ lạ, rốt cuộc mình đã làm gì mà khiến người ta ghét bỏ như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				},
				{
					"id": 708100127,
					"content": "Còn có bao nhiêu Fatui trong thành?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708100128
					]
				},
				{
					"id": 708100128,
					"content": "Số lượng cụ thể tôi cũng không rõ, nhưng những tiên sinh trong khách sạn Goth đã đóng cửa không ra ngoài rồi, cũng không biết xảy ra chuyện gì nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100129
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 708100129,
					"content": "Tôi nghĩ, chưa biết chừng những nhân vật lớn kia lại đang mưu tính chuyện gì rồi. Nhưng mà... hừ, những việc này chẳng có chút quan hệ nào với kẻ thấp cổ bé họng như tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		},
