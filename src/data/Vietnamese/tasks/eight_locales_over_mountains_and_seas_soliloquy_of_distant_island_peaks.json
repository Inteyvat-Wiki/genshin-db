						726750303
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726750303,
					"content": "Ối! Sao lại không phải màu vàng thế này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750304,
						726750305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750304,
					"content": "Cho dù mọi người có ngạc nhiên đi nữa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750306
					]
				},
				{
					"id": 726750306,
					"content": "Nghĩ kỹ lại thì tuy chúng ta đã bắt qua rất nhiều tinh điệp, nhưng lại không chú ý tới điểm này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750307,
					"content": "Tôi có chút... có chút cảm giác như mình đột nhiên trưởng thành rồi, cảm giác như ảo tưởng bị dập tắt...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750308,
					"content": "Xem ra Paimon cũng cần phải tu luyện đó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750309
					]
				},
				{
					"id": 726750309,
					"content": "Lông trắng cố lên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750310
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726750310,
					"content": "Thiệt tình, đừng có cổ vũ thế chứ! Rõ ràng chỉ có Kichiboushi là cần phải tu luyện thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750311,
					"content": "Nhưng mà, có chút thất vọng thật... tại sao tinh hạt nhân của Nham Tinh Điệp không phải màu vàng nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750312,
					"content": "Đúng vậy. Tinh điệp màu vàng, tại sao không phải màu vàng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750313,
						726750314
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726750313,
					"content": "Có lẽ tinh điệp chính là loài vật như vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750315
					]
				},
				{
					"id": 726750315,
					"content": "Ừm... hết cách rồi. Nói chung thì cứ hành động theo kế hoạch định sẵn đi, chúng ta dẫn Kichiboushi đi ngắm Ngôi Sao Chết Chóc nào!",
					"roleType": "TALK_ROLE_NPC",
