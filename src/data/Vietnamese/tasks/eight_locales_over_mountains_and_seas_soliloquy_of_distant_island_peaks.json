			"dialogs": [
				{
					"id": 726750401,
					"content": "Nhìn kìa, Ngôi Sao Chết Chóc đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750402,
					"content": "Lợi hại quá! Nhiều nước ghê!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750403
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726750403,
					"content": "Với lại, to quá! Lại còn nổi trên nước nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750404
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726750404,
					"content": "To như vậy, chắc là nặng lắm, tại sao lại không bị chìm nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750405
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726750405,
					"content": "Bởi vì đó là thuyền mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750406,
					"content": "Nhưng mà thuyền đất sét cũng chìm mà. Ioroi có kể qua, câu chuyện của thỏ, Bake-danuki và thuyền đất sét.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750407
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726750407,
					"content": "Ừm... nhưng mà Ngôi Sao Chết Chóc đó không phải là thuyền đất sét, cho nên sẽ không bị chìm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750408,
					"content": "Tại sao không phải thuyền đất sét, thì sẽ không bị chìm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750409
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726750409,
					"content": "Kichiboushi nói chuyện càng ngày càng lưu loát rồi... nhưng phải trả lời thế nào nhỉ... đúng rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750410,
					"content": "#Hì hì, {NICKNAME}, đố bạn tại sao thuyền lại nổi trên mặt nước?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750411,
						726750414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750411,
					"content": "Thuyền làm bằng gỗ mà, nguyên tố Thảo lợi hại lắm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750412
					]
				},
				{
					"id": 726750412,
					"content": "Hả? Nguyên tố Thảo có tác dụng này sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750413,
					"content": "Hừm... nhưng mà tại sao Hilichurl cầm khiên thì lại không nổi trên mặt nước nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750416,
					"content": "Mm mm, không hiểu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750417
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726750417,
					"content": "Không sao đâu, khi Kichiboushi lớn lên, thông minh như Paimon thì sẽ tự hiểu thôi. Tại sao thuyền lại nổi, tại sao núi tuyết lại có tuyết, Kichiboushi sẽ hiểu được hết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750418,
						726750420,
						726750421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750418,
					"content": "Nhưng mà Paimon cũng có hiểu đâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750419
					]
				},
				{
					"id": 726750419,
					"content": "Ê!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750422,
					"content": "Dù thế nào đi nữa thì ở đây cũng có thể ngắm được Ngôi Sao Chết Chóc, chúng ta chụp ảnh cho Kichiboushi đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750423,
					"content": "Chụp ảnh! Chụp ảnh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750424
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726750424,
					"content": "Ừm, đúng rồi! Kichiboushi đừng chạy lung tung nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750420,
					"content": "Giờ không cần hiểu cũng được.",
