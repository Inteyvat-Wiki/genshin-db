			"dialogs": [
				{
					"id": 726750101,
					"content": "Khác với núi tuyết, không lạnh. Cũng không có tuyết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750102
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726750102,
					"content": "Đây là Cô Vân Các! Theo truyền thuyết thì Nham Vương Đế Quân đã đánh bại cái con... cái con... rắn nhiều đầu gì gì đó, quên mất tên rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750103,
						726750104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750103,
					"content": "Ma Thần Lốc Xoáy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750105
					]
				},
				{
					"id": 726750105,
					"content": "A đúng đúng! Ma Thần Lốc Xoáy Osial! Nó đã bị đánh bại và bị trấn áp ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750106,
					"content": "Woa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750107
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726750107,
					"content": "Hihi, lợi hại chứ? Chúng tôi cũng từng chiến đấu qua với nó đó! Lúc đó chúng tôi đang đứng trên Quần Ngọc Các...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750108,
					"content": "Tinh điệp màu vàng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750109
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726750109,
					"content": "Thì ra là đang để ý cái này! Phải nghe người khác nói chuyện chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750110,
					"content": "Dù sao tinh điệp này cũng khác với khi ở Inazuma mà...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750111
					]
				},
				{
					"id": 726750111,
					"content": "Kichiboushi lúc trước có lẽ chỉ gặp tinh điệp màu tím thôi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750112
					]
				},
				{
					"id": 726750112,
					"content": "#Ừm... cũng đúng, thật hết cách. {NICKNAME}, bắt một con tinh điệp cho Kichiboushi chơi nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750113,
						726750115,
						726750117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750113,
					"content": "Sao Paimon không tự đi bắt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750114
					]
				},
				{
					"id": 726750114,
					"content": "Bạn quen tay hơn mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750118,
					"content": "Đúng là có thể bắt được, nhưng chỉ toàn bắt được Tinh Hạt Nhân thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750119
					]
				},
				{
					"id": 726750119,
					"content": "Hay quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726750115,
					"content": "Nhưng Paimon biết bay mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750116
					]
				},
				{
					"id": 726750116,
					"content": "Nhưng mà vẫn là bạn quen bắt tinh điệp hơn mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750117,
					"content": "Được rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750118
					]
				},
