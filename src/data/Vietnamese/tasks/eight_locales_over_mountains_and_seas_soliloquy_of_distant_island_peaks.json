					"nextDialogs": [
						722641403
					]
				},
				{
					"id": 722641403,
					"content": "Lông vàng lợi hại. Bum bum, tròn tròn to to mất rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722641404
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722641404,
					"content": "Bởi vì thường ngày cũng có tập luyện.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722641405
					]
				},
				{
					"id": 722641405,
					"content": "Mm! Muốn lợi hại như lông vàng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722641406
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722641406,
					"content": "Cho nên tu luyện, cần phải tu luyện, để mạnh hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722641407
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722641407,
					"content": "Kichiboushi mạnh hơn để làm gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722641408
					]
				},
				{
					"id": 722641408,
					"content": "Trả thù Gyoubu Koban, mmhaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722641409
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722641409,
					"content": "Giải phong ấn cho Ioroi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722641410
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722641410,
					"content": "Cố lên, lộ trình tu luyện cứ giao cho chúng tôi nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722641411
					]
				},
				{
					"id": 722641411,
					"content": "Mm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722641412,
					"content": "Thích là được rồi, gặp lại sau nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722641413
