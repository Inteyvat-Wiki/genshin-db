					"speakerTitle": "Paimon"
				},
				{
					"id": 726750314,
					"content": "Cho dù mọi người hỏi tôi thì tôi cũng không biết đâu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750315
					]
				},
				{
