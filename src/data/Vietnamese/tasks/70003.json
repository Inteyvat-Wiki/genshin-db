			"dialogs": [
				{
					"id": 700030501,
					"content": "Đúng là có một con mèo con, sao lại chạy đến đây vậy chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700030502,
					"content": "Meo... meo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030503,
						700030504
					],
					"speakerTitle": "Mèo con lạc đường"
				},
				{
					"id": 700030503,
					"content": "Meo meo meo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030505
					]
				},
				{
					"id": 700030505,
					"content": "Meo, meo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030506
					],
					"speakerTitle": "Mèo con lạc đường"
				},
				{
					"id": 700030506,
					"content": "Ừm... tôi nghĩ nó không hiểu bạn nói gì đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700030507,
					"content": "Cứ bế nó xuống đi đã, nói không chừng Aramis biết chủ của nó là ai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700030504,
					"content": "Bé mèo con lạc đường rồi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030505
					]
				}
			]
		},
		{
			"id": 7000306,
			"completionStepIds": [
				7000308
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
