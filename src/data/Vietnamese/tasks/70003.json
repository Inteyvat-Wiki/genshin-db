			"dialogs": [
				{
					"id": 700030101,
					"content": "Ối, phải làm sao đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030102
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 700030102,
					"content": "Bạn đã gặp vấn đề gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030103
					]
				},
				{
					"id": 700030103,
					"content": "Vào dịp Lễ Hội Hoa Gió, luôn có người đến đây dâng hoa cho tượng thần, mỗi khi nổi gió thì cánh của những bông hoa đó bay khắp thành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030104
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 700030104,
					"content": "Để dọn sạch những bông hoa tàn này, chúng tôi đã tốn khá nhiều công sức. Hoa và lá rụng trên quảng trường tôi còn có thể dọn được, nhưng không có cách nào dọn những cánh hoa bay trên mái nhà và tường thành cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030105
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 700030105,
					"content": "Đặc biệt là đầu gối của tôi, thật sự càng ngày càng không thể chịu nổi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030106
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 700030106,
					"content": "Tôi có thể giúp.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030107
					]
				},
				{
					"id": 700030107,
					"content": "Bạn đồng ý giúp sao? Vậy thì tốt quá, đống cánh hoa rất dễ thấy, bạn trèo lên nóc nhà chắc sẽ nhìn thấy được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aramis"
				}
			]
		},
