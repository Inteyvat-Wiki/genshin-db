			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aramis"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700030601,
					"content": "Thực sự xin lỗi, hình như tôi chưa gặp, nếu thật sự đã gặp thì tôi phải có ấn tượng mới phải...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030602
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 700030602,
					"content": "Vậy sao, mèo con nhà tôi rất thích hoa, tôi còn tưởng nó sẽ đuổi theo cánh hoa mà chạy đến đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030603
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700030603,
					"content": "Các bạn đang tìm mèo à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030604
					]
				},
				{
					"id": 700030604,
					"content": "Meo... meo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030605
					],
					"speakerTitle": "Mèo con lạc đường"
				},
				{
					"id": 700030605,
					"content": "Tiếng này là của... Bướm Nhỏ? Thiệt tình, mi chạy đi đâu rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030606
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700030606,
					"content": "Nó chạy lên nóc nhà rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030607
					]
				},
				{
					"id": 700030607,
					"content": "Quả đúng như tôi nghĩ ... Cảm ơn bạn rất nhiều. Bướm nhỏ luôn thích đuổi theo những cánh hoa khắp nơi, trong Lễ Hội Hoa Gió này, cánh hoa bay khắp thành phố cũng thật khiến người ta đau đầu, may mà có bạn giúp đỡ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030608
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700030608,
					"content": "Lần sau nếu bạn đến \"Quán Rượu Đuôi Mèo\", tôi sẽ mời bạn một ly. À! Đương nhiên là không cồn nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030609,
						700030610
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700030609,
					"content": "Quả nhiên là vậy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030611
					]
				},
				{
					"id": 700030611,
					"content": "Ha ha, tóm lại là cám ơn bạn, vậy hẹn gặp lại nhé. Chúc bạn có một Lễ Hội Hoa Gió vui vẻ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030612
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700030612,
					"content": "Không ngờ mèo mà cũng bị cánh hoa thu hút, Lễ Hội Hoa Gió thật là đông vui... Nhưng may mà bạn tìm được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030613
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 700030613,
					"content": "Muốn tôi trèo lên tường thành tìm mèo, đầu gối tôi thật sự chịu hết nổi rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030614
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 700030614,
					"content": "Thật là làm phiền bạn, số quà này bạn hãy nhận cho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aramis"
				},
				{
					"id": 700030610,
					"content": "Thôi thì cứ để sau này vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030611
					]
				}
			]
		}
	]
