			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732100501,
					"content": "Ừm... Không biết nơi này có kho báu nào không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732100502,
					"content": "Trong tủ chất đầy sổ sách, các bạn lật thử, hầu như là tài liệu bệnh viện như hồ sơ bệnh án và ghi chép tài vụ.\\nThất vọng đóng cửa tủ.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732100503
					]
				},
				{
					"id": 732100503,
					"content": "Hừ, tôi cứ tưởng bên trong có kho báu đặc biệt gì chứ... Còn không bằng lúc bình thường chúng ta mạo hiểm gặp được thùng gỗ, rương gỗ nữa! Bên trong ít nhất còn có Bắp Cải Cuộn và Thịt Gia Cầm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732100504,
					"content": "Ôi, đây là gì? Hình như rớt ra từ bên trong...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732100505,
					"content": "Tôi xem xem... Nói không chừng có manh mối kho báu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732100507,
					"content": "Ối, bệnh \"Eleazar\" nhìn đáng sợ quá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732100508,
					"content": "Tài liệu còn lại viết cái gì thế nhỉ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732100510,
					"content": "Ừm... Không hiểu gì hết!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100511,
						732100513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732100511,
					"content": "Tôi cũng xem không hiểu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732100512,
					"content": "Tôi chỉ xem hiểu cái gì mà \"Âm thanh của Thần dẫn lối\"... Chẳng lẽ nơi này thật sự sẽ xuất hiện âm thanh kỳ lạ, dẫn lối người khác sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732100515,
					"content": "Có thể là \"Mạch nước ngầm hoặc hoạt động sinh vật\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732100516
					]
				},
				{
					"id": 732100516,
					"content": "Ừm! Chính xác, nói không chừng dưới lòng đất có di tích gì đó! Nếu chú ý có âm thanh, chúng ta đi xem thử nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732100513,
					"content": "Xem không hiểu có lẽ sẽ tốt hơn...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732100514
					]
				},
				{
					"id": 732100514,
					"content": "Hả? Bạn xem hiểu không? Tôi chỉ xem hiểu cái gì mà \"Âm thanh của Thần dẫn lối\"... Chẳng lẽ nơi này thật sự sẽ xuất hiện âm thanh kỳ lạ, dẫn lối người khác sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100515
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
