	"talks": [
		{
			"id": 7321005,
			"completionStepIds": [
				7321005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
