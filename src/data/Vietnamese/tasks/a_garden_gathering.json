			"dialogs": [
				{
					"id": 761820101,
					"content": "Đây là nơi cô từng sống à? Đẹp thật đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820102
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761820102,
					"content": "Trước đây còn đẹp hơn cơ. Tôi giỏi chăm sóc vườn hoa lắm đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820103
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761820103,
					"content": "Haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820104
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761820104,
					"content": "Lại cười ngớ ngẩn gì nữa thế...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820105
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761820105,
					"content": "Tôi đang tưởng tượng cảnh Sandrone khi đó ngồi xổm bên bụi hoa, cảm thấy rất dễ thương.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820106
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761820106,
					"content": "Chốc nữa tôi có thể vào trong xem một chút không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820107
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761820107,
					"content": "Tất nhiên, tôi đã dọn dẹp sạch sẽ hết rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820108
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761820108,
					"content": "Sau này cô định xử lý ngôi nhà này thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820109
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761820109,
					"content": "Ừm... Quả nhiên vẫn muốn giữ lại nó. Khi có thời gian thì sẽ về đây dọn dẹp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820110
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761820110,
					"content": "Nếu bận quá thì tôi cũng có thể qua dọn dẹp giúp cô.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820111
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761820111,
					"content": "Nơi này cho tôi cảm giác như căn phòng của cô ngày xưa vậy, khiến người ta rất yên tâm, tôi rất thích.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820112
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761820112,
					"content": "Hừ... Tùy cô thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sandrone"
				}
			]
		},
