	"talks": [
		{
			"id": 102402,
			"completionStepIds": [
				102402
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"102402",
							"2"
						],
						"stepId": 102402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10240201,
					"content": "Phù... Phù... Mệt quá đi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10240202,
					"content": "Nếu không đúng lúc bắt gặp Quần Ngọc Các đang bay trên trời khi vừa ra khỏi Hoàng Kim Ốc, thì có lẽ đến giờ cũng không biết nên chạy về hướng nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10240203,
					"content": "Chúng ta đuổi kịp không? Ma Thần Lốc Xoáy vẫn đang ở dưới đáy biển chưa vào cảng Liyue phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10240204,
					"content": "Sao các bạn... Lại đến đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240205
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 10240205,
					"content": "Í?... Hả! Là các tiên nhân sao! Tại sao mọi người lại ở Quần Ngọc Các? Lúc trước nghe nói mọi người đang cãi nhau với Thất Tinh... đã cãi nhau xong rồi à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10240206,
					"content": "Ý của các vị tiên nhân là trong lúc nguy cấp, tiên nhân và Thất Tinh sẽ tạm thời gác bỏ mọi hiềm khích, cùng nhau chống lại kẻ thù chung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240207
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10240207,
					"content": "Hừ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240208
					],
					"speakerTitle": "Tước Nguyệt Trúc Dương Chân Quân"
				},
				{
					"id": 10240208,
					"content": "Thì ra là vậy. Vậy mọi người đã nghĩ ra được cách phòng ngự chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10240209,
					"content": "Ma Thần Lốc Xoáy này... Theo quan sát từ xa của tôi, cảm giác vị Ma Thần này hít thở có chút khó khăn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10240210,
					"content": "Những tân binh của Thiên Nham đứng không vững nữa rồi. Xem ra uy lực của Ma Thần viễn cổ rất bất lợi đối với người phàm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240211
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10240211,
					"content": "Cho dù có như vậy cũng không để cho quái vật làm hại người dân ở cảng Liyue!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240212
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10240212,
					"content": "Thật là đáng sợ... Chúng ta phải chiến đấu với kẻ địch đến từ chiến tranh Ma Thần hai nghìn năm trước sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10240213,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240214
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 10240214,
					"content": "Cho nên, dựa vào sức mạnh của Thất Tinh, Thiên Nham Quân và vài vị tiên nhân có thể đánh bại Ma Thần từ biển sâu không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10240215,
					"content": "Sau khi cùng các vị tiên nhân thảo luận, đáp án cuối cùng là... chưa chắc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240216
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10240216,
					"content": "Không phải chứ?! Nhưng... Nhưng mà mọi người đều là tiên nhân và Thất Tinh bảo vệ Liyue mà! Không còn cách nào khác sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10240217,
					"content": "Thực ra là có thể.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240218
					],
					"speakerTitle": "Lưu Vân Tá Phong Chân Quân"
				},
				{
					"id": 10240218,
					"content": "Ơ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10240219,
					"content": "Sự việc liên quan đến \"máy Guizhong\" trước kia đã được Thất Tinh chú ý đến và cho người đi tìm hiểu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240220
					],
					"speakerTitle": "Lưu Vân Tá Phong Chân Quân"
				},
				{
					"id": 10240220,
					"content": "Tiên nhân chế tạo ra \"máy Guizhong\" vừa đúng lúc có mặt ở đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240221
					],
					"speakerTitle": "Lưu Vân Tá Phong Chân Quân"
				},
				{
					"id": 10240221,
					"content": "Cơ quan do tiên nhân chế tạo, đám người thường các ngươi làm sao có thể nghiên cứu ra được gì cơ chứ? Chỉ cần tiên nhân ta tiến hành cải tạo chiếc nỏ bắn cũ kỹ này, mọi người sẽ thấy được sự cải tiến khôn lường của nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240222
					],
					"speakerTitle": "Lưu Vân Tá Phong Chân Quân"
				},
				{
					"id": 10240222,
					"content": "Haha... Cũng coi là có \"duyên với tiên\" vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240223
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10240223,
					"content": "Vậy thì chúng ta có thể sử dụng \"máy Guizhong cải tiến\" để đối phó với Ma Thần. Các vị tiên nhân tại đây cũng có thể truyền tiên khí vào máy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240224
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10240224,
					"content": "Sự việc không thể chậm trễ, thời khắc quyết định đã đến!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ningguang"
				}
			]
		},
		{
			"id": 102408,
			"completionStepIds": [
				102408
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
