			"dialogs": [
				{
					"id": 401470301,
					"content": "Sáng nay xem như là một khởi đầu tốt, phần còn lại giao cho hai người nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470302
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 401470302,
					"content": "Bạn và Paimon bận tối mặt tối mũi đến lúc đóng cửa. Khách đến nườm nượp, khẩu vị mỗi người mỗi khác, nhưng đều đánh giá tích cực như nhau.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 4014704,
			"completionStepIds": [
