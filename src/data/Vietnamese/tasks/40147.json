			"dialogs": [
				{
					"id": 401470201,
					"content": "Món ăn đến đây! Các vị dùng ngon miệng nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401470202,
					"content": "Woa, thơm thật đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470203
					],
					"speakerTitle": "Faruzan"
				},
				{
					"id": 401470203,
					"content": "#...A, phải rồi, {NICKNAME} và Paimon cũng chưa ăn sáng đúng không? Hay là cùng ngồi xuống nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470204
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 401470204,
					"content": "Ơ, từ lúc nào mà Dori lại tốt bụng thế này? Không ngờ lại có bữa sáng miễn phí nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401470205,
					"content": "Haha, những mối kinh doanh lớn đều được thương thảo trên bàn ăn mà... Nào nào, ngồi xuống đi! Mọi người không cần khách sáo đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470206
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 401470206,
					"content": "(Món này nhìn có vẻ bình thường, chắc không tốn nhiều Mora đâu nhỉ? Cùng lắm tốn tầm mười ngàn Mora...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470207
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 401470207,
					"content": "#(Món này có đáng để thức suốt đêm không nhỉ? Phải trông chờ vào {NICKNAME} để lấy lại vốn rồi!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470208
					],
					"speakerTitle": "Faruzan"
				},
				{
					"id": 401470208,
					"content": "(Mệt quá... Buồn ngủ nữa... Muốn đi ngủ... Ăn mau rồi về ngủ thôi...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470209
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 401470209,
					"content": "Mỗi người đều có tâm sự riêng và bắt đầu dùng bữa...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401470210
					]
				},
				{
					"id": 401470210,
					"content": "Này là... thịt đùi gà sao? Không đúng, vị giống như Heo Nấm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470211
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 401470211,
					"content": "Mỗi miếng đều có hương vị khác nhau. Còn có thêm vị xông khói nữa... Thật không thể tin được, rốt cuộc là làm như thế nào vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470212
					],
					"speakerTitle": "Faruzan"
				},
				{
					"id": 401470212,
					"content": "Là giăm bông, tôi đã thêm giăm bông vào.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401470213
					]
				},
				{
					"id": 401470213,
					"content": "Giăm bông? Nhưng trong đĩa này đâu có... Ối!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470214
					],
					"speakerTitle": "Faruzan"
				},
				{
					"id": 401470214,
					"content": "Hihi, đã có người phát hiện ra rồi sao? Đúng vậy, mỗi miếng thịt đều được làm từ những sợi thịt khác nhau! Tôi và Yanxiao đã tốn không ít công sức đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401470215,
					"content": "Tuy tôi không rõ lắm... nhưng không phải các loại thịt khác nhau thì có thời gian nấu khác nhau sao? Nhưng món ăn này lại kết hợp rất hài hòa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470216
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 401470216,
					"content": "#Ờ... Ừm... Đây chính là bí mật kinh doanh của {NICKNAME} đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470217,
						401470218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401470217,
					"content": "Chỉ là do thành thạo thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401470219
					]
				},
				{
					"id": 401470219,
					"content": "#Không ngờ đây lại là món ăn độc quyền của {F#cô}{M#cậu}, xem như không uổng công đi chuyến này. À mà món ăn này tên gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470220
					],
					"speakerTitle": "Faruzan"
				},
				{
					"id": 401470220,
					"content": "Ối, tôi quên mất giới thiệu, món ăn này là \"Giai Điệu Hối Hả\", không chỉ miêu tả sự đan xen lẫn nhau, mà còn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401470221,
					"content": "Diễn tả sự kết hợp giữa các tầng hương vị khác nhau? Bắt nguồn từ tục ngữ của Liyue sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470222
					],
					"speakerTitle": "Faruzan"
				},
				{
					"id": 401470222,
					"content": "Mục đích ban đầu là cùng lúc diễn tấu nhiều loại nhạc cụ, tưng bừng náo nhiệt... Ừm, cái tên này xem ra rất phù hợp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470223
					],
					"speakerTitle": "Faruzan"
				},
				{
					"id": 401470223,
					"content": "Ồ... Hóa ra cô cũng biết à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401470224,
					"content": "Thanh niên nào cũng phải học ít nhất hai mươi ngôn ngữ trước khi tốt nghiệp mà. Ủa? Lẽ nào không phải sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470225
					],
					"speakerTitle": "Faruzan"
				},
				{
					"id": 401470225,
					"content": "Hả? Trước đây có sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470226
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 401470226,
					"content": "Suýt thì quên cô cũng thuộc Học Phái Haravatat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401470227,
					"content": "Vậy giá của món này là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470228
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 401470228,
					"content": "Hihi, không đắt lắm đâu, tổng cộng 30.000 Mora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401470229,
					"content": "3... 30.000 Mora! Hah... haha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470230
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 401470230,
					"content": "#Nói chứ, Paimon, {NICKNAME}, ban nãy tôi chỉ bảo hai người \"ngồi xuống\" thôi... Đâu nói mời cả hai người đâu đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470231
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 401470231,
					"content": "Vậy chúng ta xem như là... chia hóa đơn nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470232
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 401470232,
					"content": "Quả là không có bữa sáng miễn phí mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470233,
						401470236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401470233,
					"content": "30.000 Mora thôi mà, đối với cô đâu là gì.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401470234
					]
				},
				{
					"id": 401470234,
					"content": "Đúng rồi đó! Làm ăn là phải giữ chữ tín chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470235
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401470235,
					"content": "Hic... 1 Mora cũng là tiền mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470239
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 401470239,
					"content": "Haiz, quyết định vậy đi... Xem như đóng học phí vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470240
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 401470240,
					"content": "...Đợi về Sumeru, tôi nhất định sẽ tìm người về nấu được món ăn này, rồi kiếm chác một khoản mới được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dori"
				},
				{
					"id": 401470236,
					"content": "Giảm 20% nhé, lát nữa tôi sẽ nói với chưởng quỹ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401470237
					]
				},
				{
					"id": 401470237,
					"content": "#Thật là... thôi được rồi, dù sao đây cũng là công sức của {NICKNAME} mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401470238,
					"content": "30.000 mà giảm 20%... Cũng đau lòng lắm rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470239
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 401470218,
					"content": "Tôi có cách nấu nướng đặc biệt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401470219
					]
				}
			]
		},
