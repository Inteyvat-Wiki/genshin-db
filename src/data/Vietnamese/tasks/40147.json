						401479402
					],
					"speakerTitle": "Faruzan"
				},
				{
					"id": 401479402,
					"content": "Không ngờ cô lại nhận ủy thác không liên quan đến di tích...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401479403
					]
				},
				{
					"id": 401479403,
					"content": "Chuyện này... Mặc dù cơ quan mới này không thuộc chuyên môn của tôi, nhưng mà thù lao mà Dori đề xuất cũng rất hấp dẫn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401479404
					],
					"speakerTitle": "Faruzan"
				},
				{
					"id": 401479404,
					"content": "Mỗi khi đến một bến cảng mới, đều có thể lên phố kiếm vài cuốn sách cổ để nghiên cứu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401479405
					],
					"speakerTitle": "Faruzan"
				},
				{
					"id": 401479405,
					"content": "Ha, không uổng công tôi báo giá thấp nhất để dọa cho các đối thủ ở Học Phái Kshahrewar chạy mất!",
					"roleType": "TALK_ROLE_NPC",
