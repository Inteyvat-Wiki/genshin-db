				]
			},
			"dialogs": [
				{
					"id": 401470101,
					"content": "#Chào buổi sáng, {NICKNAME}! Chưởng quỹ nói với tôi rằng cả thực khách mới và cũ đều khen ngợi {F#cô}{M#cậu} hết lời đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470102
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 401470102,
					"content": "#Trước đây tôi còn lo lắng {F#cô}{M#cậu} sẽ không thể thích nghi, giờ xem ra {F#cô}{M#cậu} có thể ứng phó được công việc hằng ngày rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470103
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 401470103,
					"content": "#Trừ khi có một vị khách vừa kén chọn lại lắm yêu cầu khắt khe, bằng không thì chẳng thể nào làm khó được {F#cô}{M#cậu} cả...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470104
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 401470104,
					"content": "Ôi, còn có khách như vậy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401470105,
					"content": "Có chứ, nhất là mấy học giả chỉ biết đọc sách chứ chẳng nấu được món nào cả đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470106
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 401470106,
					"content": "Rảnh rỗi là lại đến đây bới lông tìm vết, nào là cách nấu không theo truyền thống, hương vị khác với của hàng trăm năm trước...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470107
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 401470107,
					"content": "Đây là Nhà Trọ Vọng Thư sao? Cũng xem như là cửa hiệu lâu đời rồi nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470108
					],
					"speakerTitle": "Faruzan"
				},
				{
					"id": 401470108,
					"content": "Giọng nói này là...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401470109
					]
				},
				{
					"id": 401470109,
					"content": "Chủ tiệm! Có món đặc sản nào mang hết ra đây! Món đắt nhất nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470110
					],
					"speakerTitle": "Faruzan"
				},
				{
					"id": 401470110,
					"content": "Tiền bối... Faruzan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401470111,
					"content": "#Ơ! {NICKNAME}, Paimon? Sao hai người lại ở đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470112
					],
					"speakerTitle": "Faruzan"
				},
				{
					"id": 401470112,
					"content": "Tôi vừa định hỏi luôn đấy. Sao cô lại có kinh phí đi du lịch vậy? Còn gọi món đắt nhất nữa chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401470113,
					"content": "Hừm, không phải đi du lịch đâu nhé. Học giả như tôi đây là được mời làm \"cố vấn theo thuyền\", nên việc đi công tác khắp nơi chỉ là chuyện như cơm bữa thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470114
					],
					"speakerTitle": "Faruzan"
				},
				{
					"id": 401470114,
					"content": "Tiền bối Faruzan... Xin... hãy chậm một chút... Rõ ràng đêm qua mọi người đều thức khuya mà, sao tiền bối vẫn còn tươi tỉnh vậy? Tiền bối một trăm tuổi thật sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470115
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 401470115,
					"content": "Hộc... hộc... Cô ấy đã như thế kể từ khi tôi nói chiêu đãi rồi... Thất sách thật...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470116
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 401470116,
					"content": "Layla! Còn có Dori nữa? Tổ đội này quả thật hiếm thấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401470117,
					"content": "Nghỉ ngơi chút đã nhé...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401470118
					]
				},
				{
					"id": 401470118,
					"content": "Các bạn đưa ba người họ vào bàn, đồng thời giải thích việc mình đang phụ giúp ở Nhà Trọ Vọng Thư...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401470119
					]
				},
				{
					"id": 401470119,
					"content": "#Thì ra là vậy... {F#Cô}{M#Cậu} cũng bận rộn thật đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470120
					],
					"speakerTitle": "Faruzan"
				},
				{
					"id": 401470120,
					"content": "#Nhưng nếu ngay cả đầu bếp ở đây cũng công nhận tài nghệ của {F#cô}{M#cậu}, thì chúng tôi không lo không ăn được món đặc sản chính thống rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470121
					],
					"speakerTitle": "Faruzan"
				},
				{
					"id": 401470121,
					"content": "Mà sao mọi người lại đến Liyue vậy? Vừa nãy hình như tôi nghe thấy \"cố vấn theo thuyền\" gì đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401470122,
					"content": "Haha, dạo trước tôi vừa nhập một chiếc thuyền mới từ Fontaine, được lắp đặt thiết bị chỉ đường tiên tiến nhất! Nếu mà quảng bá rộng rãi thì đây sẽ là cơ hội kinh doanh rất lớn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470123
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 401470123,
					"content": "Mấy ngày gần đây đang chạy thử nghiệm. Từ Cảng Ormos đến Đảo Ritou, rồi từ Đảo Ritou đến Cảng Liyue, sau đó còn định đến Cảng Dornman...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470124
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 401470124,
					"content": "Tôi và tiền bối được thuê đến giúp điều chỉnh la bàn và cơ quan. Tối qua chúng tôi đã lênh đênh trên Vân Lai Hải cả đêm chỉ để thử nghiệm áp suất...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470125
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 401470125,
					"content": "Đây là tăng ca bất hợp pháp rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401470126
					]
				},
				{
					"id": 401470126,
					"content": "Có... có trợ cấp tăng ca mà! Hai vị đây cũng là tự nguyện, lúc ký hợp đồng có nhắc đến rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470127
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 401470127,
					"content": "Cô thận trọng thật đấy... thế nên mời ăn cũng xem là một phần trợ cấp sao? Hèn gì phải gọi món đắt nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401470128,
					"content": "Haha, cơ hội \"muốn ăn gì thì gọi nấy\" hiếm có lắm! Vậy thì cho tôi một phần...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470129
					],
					"speakerTitle": "Faruzan"
				},
				{
					"id": 401470129,
					"content": "Khụ! Tiền bối... Faruzan, đương nhiên tôi cũng muốn gọi món đắt nhất để tiếp đãi hai vị, nhưng đắt chưa chắc sẽ ngon mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470130
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 401470130,
					"content": "Tôi nghe nói mấy món ăn đắt nhất ở Liyue, không phải dùng nhiều hải sản tươi thì sẽ là cách chế biến cầu kỳ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470131
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 401470131,
					"content": "Chúng ta cũng đã lênh đênh trên biển mấy ngày liền rồi, còn ăn hải sản nữa thì cũng chẳng cảm nhận được mùi vị gì cả, đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470132
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 401470132,
					"content": "Hmm, nghe cô nói thì đúng là như vậy thật...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470133
					],
					"speakerTitle": "Faruzan"
				},
				{
					"id": 401470133,
					"content": "Với lại trông Layla như sắp đói ngất đến nơi rồi kìa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470134
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 401470134,
					"content": "Hả? Tôi không phải vì đói đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470135
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 401470135,
					"content": "...Chắc hẳn tiền bối Faruzan đức cao vọng trọng không nỡ để hậu bối phải bụng đói mà chờ đợi đâu nhỉ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470136
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 401470136,
					"content": "Ừm, đúng là phải chăm lo cho hậu bối... Nhưng nghe sao cứ như là bị mắc bẫy vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470137
					],
					"speakerTitle": "Faruzan"
				},
				{
					"id": 401470137,
					"content": "#Cho nên không cần lên những món ăn cần tốn nhiều thời gian chế biến đâu! Ngoài chuyện này ra thì món nào đắt cứ đem hết ra đây nhé. Giao cho {NICKNAME} đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dori"
				}
			]
		},
		{
			"id": 4014702,
