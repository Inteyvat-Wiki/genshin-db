						],
						"pointId": 310400533
					}
				]
			},
			"dialogs": [
				{
					"id": 401470401,
					"content": "Vừa phải đắt tiền, vừa không có hải sản, lại không tốn nhiều thời gian... Vậy là loại bỏ phần lớn các món trong thực đơn rồi. Rốt cuộc là người nào đưa ra yêu cầu khó nhằn như vậy thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470402
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 401470402,
					"content": "Dori thật là! Không phải cố ý đấy chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401470403,
					"content": "Chắc là cố ý rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401470404
					]
				},
				{
					"id": 401470404,
					"content": "Nhà trọ của chúng tôi không giống với Lưu Ly Đình hay Tân Nguyệt Hiên, không phải lúc nào cũng chuẩn bị sẵn nguyên liệu đắt tiền, chúng tôi thường chỉ chuẩn bị khi có khách đặt trước thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470405
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 401470405,
					"content": "Phải sử dụng nguyên liệu thường để làm ra một món ăn đắt tiền trong thời gian ngắn... Vậy thì thứ đắt giá ở đây chính là \"tài năng\" của đầu bếp và sự \"sáng tạo\" trong món ăn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470406
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 401470406,
					"content": "#{NICKNAME}, tôi biết có một món tên là \"Giai Điệu Hối Hả\". Món ăn này được làm từ những nguyên liệu có sẵn, chế biến cũng không tốn thời gian, một đĩa có giá là... 30.000 Mora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470407
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 401470407,
					"content": "30.000 sao! Chẳng phải nói là nguyên liệu bình thường và không tốn thời gian sao? Tại sao lại đắt vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401470408,
					"content": "Món này tuy không tốn thời gian, nhưng yêu cầu tay nghề dùng dao và khống chế độ lửa của đầu bếp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470409
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 401470409,
					"content": "Dùng nhiều loại thịt khác nhau được thái thành từng sợi mảnh, làm thành dải rồi chiên trên chảo, nên món ăn sẽ có hương vị đa dạng, thay đổi theo từng lớp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470410
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 401470410,
					"content": "Làm thế nào để các loại thịt liên kết với nhau, đồng thời đạt được độ chín vừa phải mà hương vị không xung đột, mới là giá trị thực sự của món ăn này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470411
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 401470411,
					"content": "Nếu làm tốt thì sẽ là một kiệt tác ẩm thực; Còn làm hỏng thì nó chỉ thành một đĩa thịt bằm thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470412
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 401470412,
					"content": "Ồ, tôi hiểu rồi. Vì thế món ăn này không đắt ở phần nguyên liệu, mà là ở tay nghề đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401470413,
					"content": "Làm tôi cũng không tự tin cho mấy rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401470414
					]
				},
				{
					"id": 401470414,
					"content": "#Không sao đâu, việc vặt vãnh như nhào nặn cứ giao cho tôi. {F#Cô}{M#Cậu} chỉ cần tập trung vào phần quan trọng là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470415
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 401470415,
					"content": "Cứ mạnh dạn thử đi, dù có làm hỏng thì thịt bằm làm ra tôi cũng thích ăn mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
