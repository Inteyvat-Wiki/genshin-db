			"dialogs": [
				{
					"id": 760740101,
					"content": "Chiếc đàn thật kỳ lạ, dù gảy thế nào cũng không phát ra âm thanh... Không phải là hỏng rồi đấy chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760740102,
						760740104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760740102,
					"content": "Cứ đi theo những Tiên Linh trước đã.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760740103
					]
				},
				{
					"id": 760740104,
					"content": "Hả? Nhưng rõ ràng là tôi nghe thấy tiếng đàn và tiếng hát mà...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760740105
					]
				},
				{
					"id": 760740103,
					"content": "Ừm ừm, tạm thời cứ kệ chiếc đàn đó đi, chỉ cần đi theo sự chỉ dẫn của Tiên Linh lên trên kia, chắc chắn sẽ tìm được kho báu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760740105,
					"content": "Thật, thật sao? Hmm, ngoài tiếng gió thì tôi chẳng nghe thấy gì cả. Hay đây là trường hợp \"chỉ người chơi đàn mới nghe được\" nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760740106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760740106,
					"content": "Được rồi, để tôi thử đàn xem sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760740107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760740107,
					"content": "Paimon dùng sức gảy dây đàn...\\n",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760740108
					]
				},
				{
					"id": 760740110,
					"content": "#Ôi, vẫn chẳng nghe thấy gì cả! {NICKNAME}, không nghe nhầm đấy chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760740111
					],
					"speakerTitle": "Paimon"
				},
				{
