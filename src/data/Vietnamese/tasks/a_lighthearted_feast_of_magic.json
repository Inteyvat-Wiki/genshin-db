			"dialogs": [
				{
					"id": 756750101,
					"content": "Hây! Ha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750102
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 756750102,
					"content": "Đầu óc tôi đã bị âm nhạc bao trùm rồi, nhảy thôi, nhảy thôi nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750103
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 756750103,
					"content": "Lắc lư lắc lư...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750104
					],
					"speakerTitle": "Sedile"
				},
				{
					"id": 756750104,
					"content": "Vui vẻ thật đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750105
					],
					"speakerTitle": "Manaia"
				},
				{
					"id": 756750105,
					"content": "Krraaa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750106
					],
					"speakerTitle": "Moo"
				},
				{
					"id": 756750106,
					"content": "Còn kiếm thêm được tiền nữa chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750107
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 756750107,
					"content": "Ơ? Chuyện từ khi nào vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750108
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 756750108,
					"content": "Cô Nusta bận quá, tôi tranh thủ đi hỗ trợ đồ đệ của cô ấy, dọn dẹp mấy hang ổ ma vật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750109
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 756750109,
					"content": "Ở Natlan, chiến đấu cũng thú vị như nhảy múa vậy, tôi thích lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750110
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 756750110,
					"content": "Thật phiền cô quá, Marine. Ý của tôi là để những người mới luyện tập nhiều hơn, không ngờ họ vẫn không thể độc lập hoàn thành nhóm nhiệm vụ đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750111
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 756750111,
					"content": "Đợi tôi trở về, tôi sẽ rèn luyện thêm cho họ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750112
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 756750112,
					"content": "Không phiền gì đâu, họ chiến đấu rất tốt mà. Chỉ là trước đó không ngờ trong hang ổ lại có lượng ma vật gấp khoảng bảy lần dự tính thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750113
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 756750113,
					"content": "Hội Hoa Vũ trả nhiều lắm, tôi gom đủ tiền mua quà cho Aeval rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750114
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 756750114,
					"content": "Nhưng kỳ nghỉ của cô cũng sắp hết rồi nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750115
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 756750115,
					"content": "Chơi thêm vài ngày nữa là có thể đặt vé tàu, tính chuyện trở về rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750116
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 756750116,
					"content": "Không vội, vẫn còn có thể nhảy múa mà. Roxane, Letellier, Chenee và Frejus dạo này đang tranh nhau làm nhiệm vụ, tôi không thể giành với họ được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750117
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 756750117,
					"content": "Vậy thì cứ tiếp tục nhảy thôi, tiếp tục vui vẻ đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750118
					],
					"speakerTitle": "Sedile"
				},
				{
					"id": 756750118,
					"content": "Mệt thì ăn, no thì ngủ, vô lo vô nghĩ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750119
					],
					"speakerTitle": "Manaia"
				},
				{
					"id": 756750119,
					"content": "Raargh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750120
					],
					"speakerTitle": "Moo"
				},
				{
					"id": 756750120,
					"content": "Các Melusine và Koholasaurus nhỏ xếp thành một hàng, nhảy nhót tiến về phía sân khấu.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						756750121
					]
				},
				{
					"id": 756750121,
					"content": "Đúng là một nhóm khách mời dễ thương...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750122
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 756750122,
					"content": "Hihi, Nusta cũng đang rất thích thú mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750123,
						756750124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756750123,
					"content": "Nụ cười trông rạng rỡ hơn hẳn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756750125
					]
				},
				{
					"id": 756750125,
					"content": "Thật sao? Vậy thì từ nay, mỗi lần có tiệc khiêu vũ, tôi nhất định phải tham gia mới được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750126
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 756750126,
					"content": "Phải để cho những hậu bối luôn miệng gọi tôi là \"chị\", thậm chí là \"dì\" ấy... một ngày nào đó phải nhận ra rằng, tinh thần của tôi còn trẻ trung hơn họ nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750127
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 756750127,
					"content": "Những buổi tiệc khiêu vũ trong tương lai nên lấy lần này làm chuẩn, tổ chức càng thường xuyên càng tốt! Trở thành thông lệ mỗi tháng một lần cũng hoàn toàn hợp lý!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nusta"
				},
				{
					"id": 756750124,
					"content": "Trông cả người trẻ ra đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756750125
					]
				}
			]
		}
	]
}