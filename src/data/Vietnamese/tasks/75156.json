			"dialogs": [
				{
					"id": 751560101,
					"content": "Huhu, cuối cùng cũng được thả ra rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751560102
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751560102,
					"content": "Xe vận chuyển Saurian này thực sự vừa ngột ngạt vừa nóng bức, lại còn hôi hám nữa. Mới ngồi nửa ngày mà cảm giác như mất hai ba năm tuổi thọ rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751560103
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751560103,
					"content": "Là cô à? Lần này lại sao nữa đây?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751560104
					]
				},
				{
					"id": 751560104,
					"content": "Thì ra là ân nhân à! Chúng ta lại gặp được nhau một lần nữa rồi... Không, là một lần nữa được ân nhân cứu giúp mới đúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751560105
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751560105,
					"content": "Lần trước không phải tôi từng nói tôi tên Conulaf, là tư tế thực tập của Chủ Nhân Gió Đêm rồi sao...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751560106
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751560106,
					"content": "Bây giờ đang trong quá trình tu tập... Các bậc trưởng bối trong tộc bảo là khắp Natlan đều có kho báu của tổ tiên để lại, nên hãy \"Đi tìm kho báu đi, Conulaf!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751560107
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751560107,
					"content": "Nên họ đã dùng danh nghĩa tu luyện để đá tôi ra khỏi cổng bộ tộc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751560108
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751560108,
					"content": "Tôi dùng đôi tai nhạy bén của mình để dò được manh mối kho báu ở gần đây... Nói là đi theo bước chân của con thú nào đó là có thể tìm được kho báu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751560109
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751560109,
					"content": "Vậy chẳng phải đang nói về Thú Thồ Hàng sao? Hay là Alpaca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751560110
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751560110,
					"content": "Tóm lại, ân nhân à... Tôi đi theo một con Thú Thồ Hàng, kết quả là theo vào tận doanh trại của đám người này. Họ tưởng tôi định trộm Thú Thồ Hàng nên đã nhốt tôi lại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751560111
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751560111,
					"content": "Kho báu còn chưa kịp tìm thấy là bản thân suýt nữa đã bị chôn xuống mồ luôn rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751560112
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751560112,
					"content": "Manh mối của cô không đầy đủ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751560113
					]
				},
				{
					"id": 751560113,
					"content": "Nói đúng lắm, lần sau tôi sẽ không hành động tùy tiện như vậy nữa... Có lẽ đây chính là kho báu tốt nhất tôi có được từ việc bị nhốt đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751560114
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751560114,
					"content": "Ôi, toàn thân bốc mùi... Phải tìm chỗ đi tắm mới được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751560115
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751560115,
					"content": "Lần này cảm ơn ân nhân nhiều nhé! Để tỏ lòng biết ơn, tôi sẽ trích một khoản nhỏ từ số tiền lộ phí ít ỏi ra làm quà cảm ơn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Conulaf"
				}
			]
		},
