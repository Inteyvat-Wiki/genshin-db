				},
				{
					"id": 120190102,
					"content": "Về \"Sữa Dango\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120190103
					]
				},
				{
					"id": 120190103,
					"content": "Ei khoái mấy món đồ uống này lắm, chỉ là giữ ý tứ nên không thể hiện ra thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190104
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120190104,
					"content": "Chơi lâu với Ei nên tôi biết ý của Ei là: \"Mau mở một tiệm giống vậy trong Nhất Tâm Tịnh Thổ lẹ!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190101
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120190105,
					"content": "Về Raiden Shogun...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120190106
					]
				},
				{
					"id": 120190106,
					"content": "Con rối đó đúng không, việc sửa chữa con rối phức tạp lắm, chuyện này tôi cũng nghe qua rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190107
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120190107,
					"content": "Khó khăn này chưa từng có tiền lệ, các bạn có thể suy nghĩ rằng, đó là việc mà làm khó được cả một vị thần...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190108
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120190108,
					"content": "Ngay cả \"Lưỡi Đao Vô Tưởng\" cũng không thể giải quyết được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190101
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120190109,
					"content": "Về \"tiểu thuyết\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120190110
					]
				},
				{
					"id": 120190110,
					"content": "Chuyển sinh thành Raiden Shogun không phải thú vị lắm sao, đã là tiểu thuyết thì chỉ cần thú vị là đủ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190111
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120190111,
					"content": "Nhưng cô ấy có chút không quen lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190112
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120190112,
					"content": "Ừm, vậy lần sau lấy đề tài là chuyển sinh thành Yae Miko được chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190101
