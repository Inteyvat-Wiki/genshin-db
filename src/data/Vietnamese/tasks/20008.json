			"dialogs": [
				{
					"id": 200080101,
					"content": "#Cảm ơn, cảm ơn {F#chị}{M#anh} đã cứu em.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200080102
					],
					"speakerTitle": "Arthur"
				},
				{
					"id": 200080102,
					"content": "Đám Slime đột nhiên xông ra, em không nghĩ Slime sẽ xuất hiện ở đây, chưa kịp chạy đã bị bọn chúng bao vây rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200080103
					],
					"speakerTitle": "Arthur"
				},
				{
					"id": 200080103,
					"content": "#{F#Chị}{M#Anh} đừng nói với phụ thân em. Phụ thân muốn em ở trong thành. Ông ấy nói gần đây Slime xung quanh rất hung dữ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200080104
					],
					"speakerTitle": "Arthur"
				},
				{
					"id": 200080104,
					"content": "Mà Slime đã bắt đầu xuất hiện xung quanh thành Mondstadt rồi, em đã ở trong nhà mấy ngày, hôm nay là lén đi ra ngoài.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200080105
					],
					"speakerTitle": "Arthur"
				},
				{
					"id": 200080105,
					"content": "#Nếu {F#chị}{M#anh} đồng ý, có thể đến phía trước xem chút không, nếu có Slime, hãy tiêu diệt chúng nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200080106,
						200080107
					],
					"speakerTitle": "Arthur"
				},
				{
					"id": 200080106,
					"content": "Không thành vấn đề.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200080108
					]
				},
				{
					"id": 200080108,
					"content": "Thật tốt quá! Em có thể yên tâm đi chơi rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arthur"
				},
				{
					"id": 200080107,
					"content": "Còn có việc gấp khác.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200080109
					]
				},
				{
					"id": 200080109,
					"content": "#Nhưng, nhưng mà, em không dám nói với phụ thân... chỉ có {F#chị}{M#anh} mới giải quyết được việc này, năn nỉ {F#chị}{M#anh} đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arthur"
				}
			]
		}
	]
