					{
						"sceneId": 3,
						"position": [
							2407.146,
							343.151,
							2391.287
						],
						"pointId": 10444
					}
				]
			},
			"dialogs": [
				{
					"id": 401870301,
					"content": "Nếu nói ai giỏi hơn thì tôi chọn Vạn Tượng Phong Giác Linh Quan, dù gì thì đó cũng là tổ sư sáng lập nên Kỳ Môn Thuật mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870302
					],
					"speakerTitle": "Chongyun"
				},
				{
					"id": 401870302,
					"content": "Đúng! Tôi cũng bỏ một phiếu cho tổ tiên của tôi. Cộng thêm cả Huyền Yến tiên tử nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870303
					],
					"speakerTitle": "Lan Yan"
				},
				{
					"id": 401870303,
					"content": "Vậy thì tôi chọn Liên Sơn Nhị Hiền, những cao nhân đó đều rất giỏi che giấu tài năng. Trong tiểu thuyết đều viết như vậy cả, đúng không nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870304
					],
					"speakerTitle": "Gaming"
				},
				{
					"id": 401870304,
					"content": "Nếu là tiểu thuyết võ hiệp, thì có lẽ tôi cũng sẽ chọn như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870305
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 401870305,
					"content": "Nhưng không may, tôi từng đọc \"Đêm Trăng Rừng Trúc\", nên tôi cho rằng mạnh nhất sẽ là Bạch Mã tiên tử trong Đào Đô Tam Tiên. Trên người cô ấy chắc chắn có bí mật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870306
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 401870306,
					"content": "Ối? Không ai chọn Vân Lai Điếu Tẩu sao? Ngay cả Ngọc Hành đại nhân cũng nói, kiếm pháp của cô ấy là đến từ tư thế ném cần câu của Vân Lai Điếu Tẩu đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870307
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870307,
					"content": "Tuy nói là vậy... Nhưng hình tượng có vẻ như không được ngầu cho lắm nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870308
					],
					"speakerTitle": "Gaming"
				},
				{
					"id": 401870308,
					"content": "Hmm... Nhưng việc thần tiên cải trang thành người câu cá cũng là chuyện có thật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870309
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 401870309,
					"content": "Hah, mọi người đoán sai hết rồi! Lợi hại nhất đương nhiên phải là Vô Vọng Lão Gia và U Điệp tiên tử rồi. Nếu không có họ thì sẽ không có Vãng Sinh Đường của ngày nay đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870310
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 401870310,
					"content": "Nói vậy cũng rất có lý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870311
					],
					"speakerTitle": "Chongyun"
				},
				{
					"id": 401870311,
					"content": "Chà, mọi người đều đến đủ rồi à!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870312,
					"content": "#{NICKNAME} và Paimon cuối cùng cũng đến rồi. Hoan nghênh, hoan nghênh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870313
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 401870313,
					"content": "Ối! Hu Tao, nón của cô!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870314,
					"content": "Lần này tinh mắt đấy, Paimon. Đúng vậy, tôi lại làm thêm một cành hoa khác rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870315
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 401870315,
					"content": "#Ồ, vậy là hai cành hoa của cô và {NICKNAME} thành một cặp rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870316,
					"content": "Nhưng mà mọi người đang làm gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870317,
					"content": "Chúng tôi đang thảo luận xem trong Bát Kỳ ai lợi hại hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870318
					],
					"speakerTitle": "Lan Yan"
				},
				{
					"id": 401870318,
					"content": "Hahaha, toàn là mỗi người một ý thôi, sẽ không ra được kết luận đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870319
					],
					"speakerTitle": "Gaming"
				},
				{
					"id": 401870319,
					"content": "Ừm, trừ khi chúng ta có loại mắt kính như trong tiểu thuyết, đeo vào rồi biết được lực chiến của mỗi người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870320
					],
					"speakerTitle": "Chongyun"
				},
				{
					"id": 401870320,
					"content": "Haha, Chongyun bị Xingqiu dẫn vào con đường tiểu thuyết rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870321
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870321,
					"content": "#Hoan nghênh nhé, {NICKNAME}. Tôi nghe người trong nhà nói {F#cô}{M#cậu} và Hu Tao đã hoàn thành một nghi lễ rất nguy hiểm, nên ông cố của tôi mới khỏi bệnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870322
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 401870322,
					"content": "Ơn nghĩa này tôi không chỉ dùng lời nói để cảm ơn đâu. Sau này dù có gặp vấn đề gì cũng đều hoan nghênh đến tìm Thương Hội Phi Vân chúng tôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870323
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 401870323,
					"content": "Còn có công lao của những người khác nữa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870324
					]
				},
				{
					"id": 401870324,
					"content": "Ừm, tôi biết. Cha và anh tôi sẽ lần lượt ghé thăm họ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870325
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 401870325,
					"content": "Có gì đâu, Xingqiu. Chi bằng hôm nay ngoan ngoãn công nhận người lợi hại nhất là Vô Vọng Lão Gia và U Điệp tiên tử nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870326
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 401870326,
					"content": "Thôi nào, đừng thảo luận chủ đề không có kết quả này nữa! Nếu mọi người đều đến rồi thì chúng ta mau bắt đầu thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870327
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870327,
					"content": "Paimon, nhanh nào! Đến lúc truyền thụ lý tưởng cuộc đời rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870328
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870328,
					"content": "T-tôi sao? Ừm... Để nhớ lại xem... Hình như là... đời người đắc ý thỏa sức ăn, chớ để... chớ để gì nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870329,
					"content": "Chớ để đũa vàng thẹn trước trăng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870330
					]
				},
				{
					"id": 401870330,
					"content": "Đúng đúng, chính là câu này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870331
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870331,
					"content": "Woa, Paimon ngay cả phương châm sống cũng nói lắp bắp như vậy sao? Cẩn thận cuộc đời cũng trắc trở theo đó. Cố lên! Hô thêm một lần xem nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870332
					],
					"speakerTitle": "Gaming"
				},
				{
					"id": 401870332,
					"content": "Đời người đắc ý thỏa sức ăn! Chớ để đũa vàng thẹn trước trăng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870333
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870333,
					"content": "Rất hăng hái đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870334
					]
				},
				{
					"id": 401870334,
					"content": "Hihi, vậy chúng ta bắt đầu ăn được chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870335
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870335,
					"content": "Paimon quên rồi sao, còn một vị khách mời đặc biệt nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870336
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870336,
					"content": "Đúng rồi! Tôi nhớ ra rồi, thật ra tôi đã sớm đoán được là ai, nhưng tôi không nói.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870337
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870337,
					"content": "Hm? Giọng điệu của Paimon có hơi chột dạ đó, thật ra là đoán không ra đúng không nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870338
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 401870338,
					"content": "#Chậc, tôi đoán được thật mà, chính là người đó ấy... {NICKNAME}, mau giúp tôi nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870339
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870339,
					"content": "Là Yun Jin đúng không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870340
					]
				},
				{
					"id": 401870340,
					"content": "#Đúng vậy! Chính là Yun Jin tốt của chúng ta! Xem ra {F#cô}{M#cậu} cũng không quên lời cô ấy đã nói.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870341
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 401870341,
					"content": "Nhìn xem, Yun Jin lên sân khấu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870342
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 401870342,
					"content": "Woa! Đó không phải là đương gia của Vân Hàn Xã sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870343
					],
					"speakerTitle": "Lixing"
				},
				{
					"id": 401870343,
					"content": "Thật may mắn, không ngờ Yun tiên sinh lại đến Bến Tàu Di Lung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870344
					],
					"speakerTitle": "Jiewu"
				},
				{
					"id": 401870344,
					"content": "Xin chào các vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870345
					],
					"speakerTitle": "Yun Jin"
				},
				{
					"id": 401870345,
					"content": "Đêm nay tôi xin hát lại \"Bát Kỳ Luyện Đào Đô\" một lần nữa cho vài người bạn đã bỏ lỡ trong dịp Tết Hải Đăng. Lần này không dựng lại được sân khấu như đêm đó, mong mọi người bỏ qua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870346
					],
					"speakerTitle": "Yun Jin"
				},
				{
					"id": 401870346,
					"content": "Woa! Yun Jin đến hát cho những người đã bỏ lỡ nghe kìa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870347
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870347,
					"content": "Suỵt! Cô ấy sắp bắt đầu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870356
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 401870356,
					"content": "Nhớ lại lời nói ngông cuồng của Đào Đô",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870348
					],
					"speakerTitle": "Yun Jin"
				},
				{
					"id": 401870348,
					"content": "Tiếng ồn ã, cãi vã dưới gốc cây... Lưỡng giới tách biệt duyên chẳng thành, hãy nghe hiệu lệnh của ta đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870349
					],
					"speakerTitle": "Yun Jin"
				},
				{
					"id": 401870349,
					"content": "Rời giới u sầu vào hồng trần, lửa hận thiêu tận, xương hóa đao kiếm, máu hóa ngựa phi, náo loạn tận trời cao, dã tâm nực cười biết bao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870350
					],
					"speakerTitle": "Yun Jin"
				},
				{
					"id": 401870350,
					"content": "Truyền mãi ngọn đèn cứu thế vá trời, rọi bóng đao thương kiếm kích rạc rời.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870351
					],
					"speakerTitle": "Yun Jin"
				},
				{
					"id": 401870351,
					"content": "Sống chết âm dương chẳng thể làm trái, gây hại sinh linh tự gieo oan trái.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870352
					],
					"speakerTitle": "Yun Jin"
				},
				{
					"id": 401870352,
					"content": "Đạo trời chính nghĩa chẳng bao nhiêu, còn ngươi lòng tham lại quá nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870353
					],
					"speakerTitle": "Yun Jin"
				},
				{
					"id": 401870353,
					"content": "Lời thề nguyện diệt trừ tà ma, Bát Môn giơ đao Đào Đô bị hạ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870354
					],
					"speakerTitle": "Yun Jin"
				},
				{
					"id": 401870354,
					"content": "Thân xác kiệt quệ, hồn phách tan tác, về sau tự có người phân định thiện ác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870355
					],
					"speakerTitle": "Yun Jin"
				},
				{
					"id": 401870355,
					"content": "Nước mắt cành liễu ngấm ruộng đồng, năm mới, én làm tổ đón xuân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yun Jin"
				}
			]
		},
