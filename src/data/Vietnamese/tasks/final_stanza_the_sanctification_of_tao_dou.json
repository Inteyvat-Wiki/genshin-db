			"dialogs": [
				{
					"id": 401870701,
					"content": "Nha đầu ở Vãng Sinh Đường, đúng là có chút lợi hại đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870702
					],
					"speakerTitle": "Xianyun"
				},
				{
					"id": 401870702,
					"content": "Trước đây chỉ vì Đế Quân đến đó làm khách khanh gì đấy mà bổn tiên mới có hứng thú với cô ấy, giờ đây mới hiểu được ý nghĩa thực sự bên trong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870703
					],
					"speakerTitle": "Xianyun"
				},
				{
					"id": 401870703,
					"content": "Tuy nói như vậy, nhưng nghe được lời khen này của Lưu Vân Tá Phong, quả đúng là hiếm thấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870704
					],
					"speakerTitle": "Tước Nguyệt Trúc Dương Chân Quân"
				},
				{
					"id": 401870704,
					"content": "Hiếm thấy chỗ nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870705
					],
					"speakerTitle": "Xianyun"
				},
				{
					"id": 401870705,
					"content": "Nếu là trước đây thì chắc sẽ là \"Nha đầu đó tuy có chút tài năng, nhưng nếu đổi thành Shenhe và Ganyu của chúng ta thì cũng sẽ không thua kém.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870706
					],
					"speakerTitle": "Lí Thủy Điệp Sơn Chân Quân"
				},
				{
					"id": 401870706,
					"content": "Hừ! Lẽ nào bổn tiên lại là kẻ thích khoe khoang đề cao bản thân vậy à? Nha đầu đó có nghĩa khí như thế, chẳng lẽ không đáng để bổn tiên khen ngợi đôi lời sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870707
					],
					"speakerTitle": "Xianyun"
				},
				{
					"id": 401870707,
					"content": "Hahaha, đương nhiên là đáng rồi. Sống ở Cảng Liyue lâu như vậy, tôi đã sớm biết Vãng Sinh Đường đời đời đều có người tài rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870708
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 401870708,
					"content": "Ca Trần nói đúng lắm. Ma Thần Đào Đô ngày xưa tuy không phải kẻ địch, cũng không phải bạn bè. Nhưng nếu không phải ông ta một lòng nghĩ cho chúng sinh, tình nguyện tự luyện thân mình để dẹp yên u minh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870709
					],
					"speakerTitle": "Tước Nguyệt Trúc Dương Chân Quân"
				},
				{
					"id": 401870709,
					"content": "Thì đừng nói là Bát Kỳ, có thêm cả Bát Tiên cũng không làm gì được ông ấy. Sau đó thân thể ông ấy hóa thành ranh giới, không ngờ lại được người phàm bảo vệ đến tận ngày nay, thật đáng cảm thán.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870710
					],
					"speakerTitle": "Tước Nguyệt Trúc Dương Chân Quân"
				},
				{
					"id": 401870710,
					"content": "Nói ra thì, còn chưa biết cô gái nhỏ ở Vãng Sinh Đường đó tên gì nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870711
					],
					"speakerTitle": "Lí Thủy Điệp Sơn Chân Quân"
				},
				{
					"id": 401870711,
					"content": "Đường chủ họ Hu, tên Tao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870712
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 401870712,
					"content": "Hu... Theo nghĩa của con bướm sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870713
					],
					"speakerTitle": "Tước Nguyệt Trúc Dương Chân Quân"
				},
				{
					"id": 401870713,
					"content": "Không... Là theo nghĩa của gây rối.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870714
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 401870714,
					"content": "Vậy còn \"Tao\"... Theo nghĩa nghịch ngợm à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870715
					],
					"speakerTitle": "Tước Nguyệt Trúc Dương Chân Quân"
				},
				{
					"id": 401870715,
					"content": "Không, là Tao trong \"Đào{RUBY#[D]Tao Dou} Đô\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870716
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 401870716,
					"content": "Ồ, tên hay lắm, người cũng như tên vậy. Đúng là một cái tên tốt mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870717
					],
					"speakerTitle": "Lí Thủy Điệp Sơn Chân Quân"
				},
				{
					"id": 401870717,
					"content": "Không, là theo nghĩa gây rối, bám riết dai dẳng, ăn không ngừng nghỉ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870718
					],
					"speakerTitle": "Xianyun"
				},
				{
					"id": 401870718,
					"content": "Xem kìa, ta chỉ là đang khuấy động bầu không khí mà. Sao nào? Cô ấy gây rối được, ta thì không được à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870719
					],
					"speakerTitle": "Lí Thủy Điệp Sơn Chân Quân"
				},
				{
					"id": 401870719,
					"content": "Ồ? Ngươi đổi danh hiệu từ hồi nào vậy? Gây Rối Chân Quân?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870720
					],
					"speakerTitle": "Xianyun"
				},
				{
					"id": 401870720,
					"content": "Haha, đến uống trà nào. Đây là Quỷ Sơn Linh Nha mà Đế Quân đem từ Khinh Sách Trang về, vô cùng hiếm gặp, đừng nên bỏ lỡ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870721
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 401870721,
					"content": "Hy vọng năm sau cũng có trà ngon để uống.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870722
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 401870722,
					"content": "Ừm, chắc chắn rồi.",
