			"dialogs": [
				{
					"id": 401870501,
					"content": "Nguy cơ đã được giải quyết, Thiên Quyền đại nhân của chúng ta sao vẫn đăm chiêu vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870502
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 401870502,
					"content": "#Nhờ phúc của đường chủ Hu và {NICKNAME} mà vấn đề này xem như được giải quyết viên mãn. Nhưng nguyên nhân của nguy cơ này vẫn chưa được tìm ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870503
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 401870503,
					"content": "Thông tin của thuyền trưởng nhanh nhạy, chắc phải biết Natlan gần đây cũng xảy ra chuyện lớn liên quan đến Địa Mạch và sinh tử.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870504
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 401870504,
					"content": "Tôi đang nghĩ, liệu có mối liên hệ bí ẩn nào trong việc này không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870505
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 401870505,
					"content": "Nếu có chuyện như vậy thì không thể chỉ xảy ra ở mỗi Liyue và Natlan được. Tôi sẽ nhờ đối tác làm ăn giúp cô để ý tin tức ở những nơi khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870506
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 401870506,
					"content": "Còn bây giờ thì tôi kiến nghị cô không nên nghĩ nhiều mà bỏ lỡ cảnh đẹp mùa lễ này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870507
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 401870507,
					"content": "Haha, sao có thể chứ? Tôi nào giống Keqing, tôi sẽ luôn cân bằng giữa công việc và cuộc sống mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870508
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 401870508,
					"content": "Vậy sao cô vẫn đeo cây trâm cũ này vậy? Phần thù lao của tôi không phải là để cô mua trâm mới sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870509
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 401870509,
					"content": "Không xác nhận thêm vài lần thì sao tôi dám động đến tiền của thuyền trưởng Beidou chứ? Lỡ như người nào đó không thật lòng mà chỉ đang trêu tôi thì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870510
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 401870510,
					"content": "Hahaha, cô thật là... Buộc tôi phải chọn cho cô đúng không? Được rồi, đi thôi, cùng tôi đi dạo chợ nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870511
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 401870511,
					"content": "Chà... Thuyền trưởng Beidou trở nên tinh tế như vậy từ khi nào thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870512
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 401870512,
					"content": "Haha, vậy có đi không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870513
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 401870513,
					"content": "Cớ sao lại không chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ningguang"
				}
			]
		},
