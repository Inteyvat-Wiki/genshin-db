			"dialogs": [
				{
					"id": 401870601,
					"content": "Ganyu còn đang bận việc sao? Vất vả cho cô rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870602
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 401870602,
					"content": "#Ơ? Keqing... Không có, tôi cũng chẳng làm gì lớn lao cả. Vấn đề lần này đều nhờ cả vào {NICKNAME} và đường chủ Hu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870603
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 401870603,
					"content": "Đừng tự xem nhẹ mình chứ. Hai người họ đương nhiên có công lớn nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870604
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 401870604,
					"content": "Nhưng chúng ta cũng không phụ lòng tin tưởng của mọi người mà. Chẳng phải Tổng Vụ đã chi viện rất nhanh sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870605
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 401870605,
					"content": "Tuy nhìn bề ngoài chuyện này không nghiêm trọng như tai họa Ma Thần lúc trước, nhưng nếu nguy cơ xảy ra thì hậu quả thật sự rất khó lường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870606
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 401870606,
					"content": "Ừm... Đúng vậy, mà nói đến chuyện này thì tôi luôn thắc mắc. Chuyện là tôi chưa từng thấy qua Bát Môn Thất Môn Đại Trận Pháp đó trong tư liệu của Nguyệt Hải Đình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870607
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 401870607,
					"content": "Ồ, cô đang nghĩ về nguồn gốc của trận pháp sao? Đó là do Ningguang bịa ra đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870608
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 401870608,
					"content": "Hả?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870609
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 401870609,
					"content": "Haha, nói đùa thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870610
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 401870610,
					"content": "Thật ra hôm đó, lá thư về trận pháp này đã đột nhiên xuất hiện ở Ngọc Kinh Đài, ngay cả Yelan cũng không điều tra được nguồn gốc của nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870611
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 401870611,
					"content": "Đột nhiên xuất hiện? Vậy... Ningguang có phải đã mạo hiểm quá rồi không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870612
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 401870612,
					"content": "Nhìn thì giống như đang mạo hiểm, nhưng nghĩ kỹ lại thì sẽ hiểu được tính hợp lý trong đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870613
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 401870613,
					"content": "Tìm khắp Liyue, người vừa nhận biết được nguy cơ, lại hiểu bí pháp, còn có thể tránh được tai mắt của Yelan, ra tay giúp đỡ trong lúc khó khăn ở Ngọc Kinh Đài... Liệu có được bao nhiêu người chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870614
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 401870614,
					"content": "A... Chẳng lẽ là nhóm của sư phụ sao...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870615
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 401870615,
					"content": "Tôi hiểu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ganyu"
				}
			]
