					}
				]
			},
			"dialogs": [
				{
					"id": 401870101,
					"content": "#Chào nhé! {NICKNAME}, Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870102
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870102,
					"content": "Xiangling! Tìm chúng tôi có việc gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870103,
					"content": "Haha, tôi thì còn có việc gì chứ, đương nhiên là buổi hẹn gặp mặt của chúng ta rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870104
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870104,
					"content": "Cuối cùng cũng hẹn được rồi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870105
					]
				},
				{
					"id": 401870105,
					"content": "Ừm! Chắc là có thời gian rảnh rỗi mà nhỉ? Không được từ chối nữa đâu nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870106
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870106,
					"content": "Người luôn bận rộn không phải chúng tôi, mà là Hu Tao đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870107,
					"content": "Ai bảo cô ấy là đường chủ chứ, máu mặt lắm! Không thêm vài người là không hẹn được cô ấy đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870108
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870108,
					"content": "Nhưng cứ yên tâm, lần này chúng tôi đã ép cô ấy không được tìm cớ nữa rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870109
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870109,
					"content": "Ồ? Còn có người khác ra tay sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870110,
					"content": "Hihi, là Xingqiu đó! Anh ấy nói đã muốn hẹn gặp mọi người từ lâu rồi, nhưng do chuyện của ông cố nên mãi vẫn chưa có dịp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870111
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870111,
					"content": "Nhưng vào đêm Tết Hải Đăng, ông cố của Xingqiu đột nhiên tỉnh lại, anh ấy vui lắm, vì vậy mới có cơ hội ra ngoài. Chúng tôi đương nhiên là triển khai kế hoạch này ngay rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870112
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870112,
					"content": "Woa! Ông cố đã không sao rồi chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870113,
					"content": "Ừm, đại phu đã đến xem qua, bảo là đã hoàn toàn khỏe lại rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870114
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870114,
					"content": "Xingqiu kể rằng, ông cố của anh ấy vừa tỉnh lại đã ăn rất nhiều, giống như Paimon vậy, cũng vô cùng ngon miệng nữa. Người nhà thấy vậy liền bắt đầu sợ là no quá sẽ bị khó tiêu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870115
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870115,
					"content": "Sao có cảm giác đây không phải là một lời khen nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870116,
					"content": "Đương nhiên là lời khen rồi, khả năng ăn uống của Paimon là một dạng thái độ sống tích cực mà. \"Đời người đắc ý thỏa sức ăn, chớ để đũa vàng thẹn trước trăng\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870117
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870117,
					"content": "Xiangling nói hay lắm! Tôi đúng là đã mang theo tư tưởng này để kiên trì đến ngày hôm nay đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870118,
					"content": "Có chuyện như vậy à? Sao tôi không biết vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870119
					]
				},
				{
					"id": 401870119,
					"content": "Có mà! Đời người đắc ý thỏa sức ăn, chớ để... chớ để gì nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870120,
					"content": "Haha, Paimon tạm để dành đến khi nào nhập tiệc rồi mới chia sẻ nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870121
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870121,
					"content": "Hihi, không thành vấn đề! Vậy chúng ta đi dùng bữa ở đâu vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870122,
					"content": "Ở Bến Tàu Di Lung, ngay tối nay. Nhóm Xingqiu còn đang ở bên đó đấy. À, Hu Tao nói cô ấy còn dẫn theo một vị khách mời đặc biệt nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870123
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870123,
					"content": "Ai vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870124
					]
				},
				{
					"id": 401870124,
					"content": "Tối nay đến rồi sẽ biết thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870125
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870125,
					"content": "A! Tôi đại khái đoán được là mời ai rồi... Hihi, nhưng tôi không nói đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870126,
					"content": "Tôi cũng đoán được rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870127
					]
				},
				{
					"id": 401870127,
					"content": "#Ơ? {NICKNAME} đoán ai vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870128,
					"content": "Tôi cũng không nói.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870129
					]
				},
				{
					"id": 401870129,
					"content": "Hừ, vậy tối nay xem thử xem ai đoán đúng hơn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
