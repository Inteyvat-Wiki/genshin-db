			},
			"dialogs": [
				{
					"id": 401870401,
					"content": "#Hôm đó cô nên cùng {NICKNAME} vào ranh giới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870402
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 401870402,
					"content": "#Hàng Ma Đại Thánh đây lo lắng quá nên thiếu tỉnh táo rồi. Nếu việc mà ngay cả {NICKNAME} cũng không xử lý được, thì tôi có đi theo cũng không giúp được gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870403
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 401870403,
					"content": "Hơn nữa, Ningguang đã phái tôi đi Vực Đá Sâu, tôi cũng không thể phân thân xuất hiện ở hai nơi được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870404
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 401870404,
					"content": "Hàng Ma Đại Thánh nếu không hài lòng, hay là hôm khác đến Ngọc Kinh Đài tố cáo cô ấy nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870405
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 401870405,
					"content": "Hừm, đi gặp Thiên Quyền tố cáo Thiên Quyền sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870406
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 401870406,
					"content": "Hàng Ma Đại Thánh xem nhẹ Ngọc Hành Tinh rồi, cô ấy không sợ gây phiền phức với ai bao giờ đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870407
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 401870407,
					"content": "Bỏ đi, mọi người đều không sao là tốt rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870408
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 401870408,
					"content": "Ừm, Nhà Trọ Vọng Thư đúng là một nơi tuyệt vời.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870409
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 401870409,
					"content": "Cả Liyue đều là một nơi tuyệt vời.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870410
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 401870410,
					"content": "Haha, nói đúng lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870411
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 401870411,
					"content": "Chủ tiệm, thêm một phần Tôm Nhuốm Sương, cùng phần chấm cay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870412
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 401870412,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870413
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 401870413,
					"content": "Và thêm một phần Đậu Hũ Hạnh Nhân nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yelan"
				}
			]
		},
