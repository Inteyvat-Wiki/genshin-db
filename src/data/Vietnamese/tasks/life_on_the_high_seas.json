	"talks": [
		{
			"id": 1905101,
			"completionStepIds": [
				1905101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1905101",
							"2"
						],
						"stepId": 1905101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yinxing"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190510101,
					"content": "Xin chào, nhà lữ hành, tôi là Yinxing, là bác sĩ của Nam Thập Tự.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510102
					],
					"speakerTitle": "Yinxing"
				},
				{
					"id": 190510102,
					"content": "Các thủy thủ dù có bị say sóng chóng mặt, cảm nhiễm phong hàn, hay cụt tay cụt chân gì đó cũng đều do tôi phụ trách chữa trị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510103
					],
					"speakerTitle": "Yinxing"
				},
				{
					"id": 190510103,
					"content": "Tôi muốn tìm hiểu một số kiến thức chữa bệnh trên biển.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510104
					]
				},
				{
					"id": 190510104,
					"content": "Ừm, là do chị Beidou phái bạn đến đúng không? Vậy để tôi giới thiệu cho bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510105
					],
					"speakerTitle": "Yinxing"
				},
				{
					"id": 190510105,
					"content": "Đầu tiên, bạn có biết đối với lính mới mà nói thì điều nguy hiểm nhất khi đi biển là gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510106,
						190510107,
						190510108
					],
					"speakerTitle": "Yinxing"
				},
				{
					"id": 190510106,
					"content": "Say sóng?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510109
					]
				},
				{
					"id": 190510109,
					"content": "Cái này đúng là cũng phiền phức thật, nhưng không phải là nguy hiểm nhất. Đối với lính mới mà nói, điều nguy hiểm nhất khi đi biển chính là \"xem nhẹ hiểm nguy\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510110
					],
					"speakerTitle": "Yinxing"
				},
				{
					"id": 190510110,
					"content": "Tôi đã từng thấy qua nhiều lính mới cậy bản thân trẻ khỏe, không lo đề phòng bệnh tật, cho rằng trên đất liền không sao nghĩa là trên biển cũng có thể khỏe mạnh như thường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510111
					],
					"speakerTitle": "Yinxing"
				},
				{
					"id": 190510111,
					"content": "Những tên lính mới đó cuối cùng cũng phải nếm trái đắng. Cho nên mọi người đều cần phải biết, đi biển, đặc biệt là đi xa, là một chuyện rất nguy hiểm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510112
					],
					"speakerTitle": "Yinxing"
				},
				{
					"id": 190510112,
					"content": "Chúng ta phải đối diện với sự thiếu thốn lương thực, khiến mất cân bằng dinh dưỡng; còn phải đối mặt với việc nhiễm phong hàn do sự chênh lệch nhiệt độ và thời tiết khắc nghiệt gây ra;",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510113
					],
					"speakerTitle": "Yinxing"
				},
				{
					"id": 190510113,
					"content": "Thậm chí sẽ còn thiếu hụt thông tin, dẫn đến việc không có thú vui giải trí, làm cho dễ bị trầm cảm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510114
					],
					"speakerTitle": "Yinxing"
				},
				{
					"id": 190510114,
					"content": "Quan trọng hơn cả, là trên biển không có thuốc và điều kiện thuận lợi để cấp cứu, cho nên dù là vấn đề nhỏ cũng có khả năng dẫn đến hậu quả nghiêm trọng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510115
					],
					"speakerTitle": "Yinxing"
				},
				{
					"id": 190510115,
					"content": "Vì vậy nên bạn mới nói cụt tay cụt chân là vậy sao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510116
					]
				},
				{
					"id": 190510116,
					"content": "Haha, bạn cho rằng tôi nói đùa sao? Cũng khó trách, đại đa số lính mới đều sẽ suy nghĩ như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510117
					],
					"speakerTitle": "Yinxing"
				},
				{
					"id": 190510117,
					"content": "Nhưng hy vọng giờ đây bạn sẽ chú ý hơn để không xảy ra những chuyện không đáng có này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510118
					],
					"speakerTitle": "Yinxing"
				},
				{
					"id": 190510118,
					"content": "Được rồi, điều mà tôi muốn nói với lính mới chắc cũng bấy nhiêu thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510119
					],
					"speakerTitle": "Yinxing"
				},
				{
					"id": 190510119,
					"content": "Bạn còn điều gì cần hỏi không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510120,
						190510129,
						190510137
					],
					"speakerTitle": "Yinxing"
				},
				{
					"id": 190510120,
					"content": "Beidou thấy chuyện này như thế nào?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510121
					]
				},
				{
					"id": 190510121,
					"content": "Chị Beidou sao... cô ấy quan tâm nhất là sự an toàn của mọi người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510122
					],
					"speakerTitle": "Yinxing"
				},
				{
					"id": 190510122,
					"content": "Tuy tôi chỉ là một bác sĩ trên thuyền, nhưng nhờ có chị Beidou, tôi mới có quyền ra lệnh cho những tên lính mới không đủ tiêu chuẩn xuống thuyền, bắt họ phải chuẩn bị thật kỹ mới được phép lên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510123
					],
					"speakerTitle": "Yinxing"
				},
				{
					"id": 190510123,
					"content": "Mỗi lần ra khơi chị ấy cũng ưu tiên thuốc men lên hàng đầu, thậm chí giao cho tôi chọn nhà cung cấp, không câu nệ giá cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510124
					],
					"speakerTitle": "Yinxing"
				},
				{
					"id": 190510124,
					"content": "Bạn biết ở chỗ kế toán Máy Đốt Mora chúng tôi gọi đó là gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510125
					],
					"speakerTitle": "Yinxing"
				},
				{
					"id": 190510125,
					"content": "Gọi là rủi ro tài chính nghiêm trọng đó, ha ha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510126
					],
					"speakerTitle": "Yinxing"
				},
				{
					"id": 190510126,
					"content": "Nhưng vì để tránh những tổn thương vô nghĩa cho thuyền viên, nên chị Beidou vẫn giao cho tôi quyền hạn này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510127
					],
					"speakerTitle": "Yinxing"
				},
				{
					"id": 190510127,
					"content": "Tôi là người mà cô ấy tin tưởng, cô ấy cũng tin là tôi sẽ có thể giải quyết những vấn đề này... Đương nhiên, sự thật đã chứng minh cho sự lựa chọn của cô ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510128
					],
					"speakerTitle": "Yinxing"
				},
				{
					"id": 190510128,
					"content": "Đây cũng là tầm nhìn của cô ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510119
					],
					"speakerTitle": "Yinxing"
				},
				{
					"id": 190510129,
					"content": "Vậy những thuyền viên bị cụt tay chân sau này như thế nào rồi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510130
					]
				},
				{
					"id": 190510130,
					"content": "Ừm... bạn quan tâm họ sao? Khó trách chị Beidou coi trọng bạn như vậy, xem ra không phải chỉ có mỗi sức mạnh đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510131
					],
					"speakerTitle": "Yinxing"
				},
				{
					"id": 190510131,
					"content": "Nếu như bạn có thể thuyết phục Máy Đốt Mora đưa sổ sách cho bạn xem thử, bạn sẽ phát hiện ra trong đội thuyền có một mục chi phí cố định, tên là \"Quỹ Bồi Dưỡng Tàn Tật\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510132
					],
					"speakerTitle": "Yinxing"
				},
				{
					"id": 190510132,
					"content": "Cho dù thu nhập của đội thuyền có ra sao thì khoản này vẫn sẽ không được động vào, mỗi năm đều sẽ trích ra để gửi cho những đồng đội từng kề vai sát cánh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510133
					],
					"speakerTitle": "Yinxing"
				},
				{
					"id": 190510133,
					"content": "Giờ đây họ đã quay về đất liền, có một số khởi nghiệp thành công, một số thì đi ra ngoài vân du tứ phương.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510134
					],
					"speakerTitle": "Yinxing"
				},
				{
					"id": 190510134,
					"content": "Nếu có thể quên đi khiếm khuyết của bản thân thì có lẽ cuộc sống của họ sẽ còn tiêu diêu tự tại hơn chúng tôi đấy, haha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510135
					],
					"speakerTitle": "Yinxing"
				},
				{
					"id": 190510135,
					"content": "Chỉ tiếc là, ai lại có thể quên được nỗi đau phải đi theo mình cả đời chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510136
					],
					"speakerTitle": "Yinxing"
				},
				{
					"id": 190510136,
					"content": "Điều duy nhất có thể an ủi họ, chính là chị Beidou của Nam Thập Tự, người sẽ không bao giờ bỏ rơi ai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510119
					],
					"speakerTitle": "Yinxing"
				},
				{
					"id": 190510137,
					"content": "Cảm ơn, tôi hiểu rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510138
					]
				},
				{
					"id": 190510138,
					"content": "Ừm, chính là vậy đó, vậy nên hãy tự chú ý sức khỏe nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yinxing"
				},
				{
					"id": 190510107,
					"content": "Cảm sốt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510109
					]
				},
				{
					"id": 190510108,
					"content": "Cụt tay chân?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510109
