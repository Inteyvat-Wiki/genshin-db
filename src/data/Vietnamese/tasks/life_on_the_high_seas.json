			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huixing"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190510201,
					"content": "Nhà lữ hành, thật ngại quá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510202
					],
					"speakerTitle": "Huixing"
				},
				{
					"id": 190510202,
					"content": "Ban nãy tôi hơi hứng thú quá đà khi thấy bạn lên thuyền, thành ra có chút thất lễ, cũng may có chị đại nhắc nhở...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510203
					],
					"speakerTitle": "Huixing"
				},
				{
					"id": 190510203,
					"content": "Không sao đâu. À, tôi muốn tìm hiểu thêm về hải đồ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510204
					]
				},
				{
					"id": 190510204,
					"content": "À, vậy thì tìm đúng người rồi, nói không phải tự khen chứ tôi là hoa tiêu giỏi nhất cảng Liyue đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510205
					],
					"speakerTitle": "Huixing"
				},
				{
					"id": 190510205,
					"content": "Để tôi giới thiệu sơ qua một chút về những kiến thức để đọc hải đồ nhé. Nếu có vấn đề gì thì bạn có thể hỏi ngay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510206
					],
					"speakerTitle": "Huixing"
				},
				{
					"id": 190510206,
					"content": "Khi chúng ta lấy được một tấm hải đồ có tham số phức tạp, bạn biết điều quan trọng nhất là phải xem cái gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510207
					],
					"speakerTitle": "Huixing"
				},
				{
					"id": 190510207,
					"content": "Chính là phải xem những ký hiệu quan trọng như bờ biển, đá ngầm, mực nước, vật nguy hiểm và các yếu tố thủy văn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510208
					],
					"speakerTitle": "Huixing"
				},
				{
					"id": 190510208,
					"content": "Có những nội dung này thì ít ra có thể xác định được là có thể tìm được một tuyến đường an toàn hay không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510209
					],
					"speakerTitle": "Huixing"
				},
				{
					"id": 190510209,
					"content": "Về phương thức biểu thị thì hải đồ dùng các phương pháp vẽ khá đặc biệt. Bởi vì nó không có những tham chiếu dễ thấy như trên đất liền, cho nên phần lớn hải đồ sẽ không có kích thước tỉ lệ nhất định, rất khó để phán đoán khoảng cách.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510210
					],
					"speakerTitle": "Huixing"
				},
				{
					"id": 190510210,
					"content": "Chỉ có những bản hải đồ tân tiến nhất mới kèm thêm một tấm bản đồ phụ, trên đó dùng những ký hiệu đường vẽ màu sắc khác nhau để biểu thị khoảng cách.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510211
					],
					"speakerTitle": "Huixing"
				},
				{
					"id": 190510211,
					"content": "Đặc biệt hơn là, dưới sự dẫn dắt của tôi thì Nam Thập Tự đã sử dụng loại hải đồ này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510212
					],
					"speakerTitle": "Huixing"
				},
				{
					"id": 190510212,
					"content": "Ngoài ra, người vẽ sẽ còn thêm những ghi chú riêng trên hải đồ, thông thường là những ký hiệu đặc biệt. Nếu như không có chú thích thì hầu như rất khó để hiểu được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510213
					],
					"speakerTitle": "Huixing"
				},
				{
					"id": 190510213,
					"content": "Như hải đồ của hoa tiêu tiền nhiệm sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510214
					]
				},
				{
					"id": 190510214,
					"content": "Haha, không chỉ thế, còn có nhiều mảnh hải đồ đến từ nhiều nơi khác nhau nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510215
					],
					"speakerTitle": "Huixing"
				},
				{
					"id": 190510215,
					"content": "Nói thật thì, tôi thích những thứ này lắm, bởi vì chúng rất có thể đã có lịch sử lâu đời, với lại những ký hiệu trên đó tôi cũng... chưa từng thấy qua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510216
					],
					"speakerTitle": "Huixing"
				},
				{
					"id": 190510216,
					"content": "Nhưng càng như vậy thì tôi càng cảm thấy nếu như giải được bí mật của chúng, nói không chừng sẽ biết được thêm bí mật về biển cả!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510217
					],
					"speakerTitle": "Huixing"
				},
				{
					"id": 190510217,
					"content": "Cũng may có chị đại, không biết cô ấy tìm đâu ra một quyển sách cổ có những ký hiệu này, như vậy là tôi có thể vừa học vừa nghiên cứu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510218
					],
					"speakerTitle": "Huixing"
				},
				{
					"id": 190510218,
					"content": "Càng ngày tôi càng thấy chị đại rất giỏi, có thể tìm được những thứ không có trên thị trường, dù là hải đồ cổ xưa hay là sách cổ về ký hiệu học cũng có thể tìm thấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510219
					],
					"speakerTitle": "Huixing"
				},
				{
					"id": 190510219,
					"content": "Ấy da, nói hơi lan man rồi! Hihi, thực ra những kiến thức cơ bản để đọc hải đồ thì chỉ có những nội dung này thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510220
					],
					"speakerTitle": "Huixing"
				},
				{
					"id": 190510220,
					"content": "Bạn còn muốn biết thêm gì nữa không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510221,
						190510236
					],
					"speakerTitle": "Huixing"
				},
				{
					"id": 190510221,
					"content": "Về chuyện vẽ hải đồ, cô có kinh nghiệm không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510222
					]
				},
				{
					"id": 190510222,
					"content": "Vẽ hải đồ sao? Chuyện này khó đấy, nói thật thì trình độ của tôi cũng chỉ ở tầm trung thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510223
					],
					"speakerTitle": "Huixing"
				},
				{
					"id": 190510223,
					"content": "Bởi vì hải đồ mà chúng tôi đang dùng, hoàn toàn là bản chỉnh sửa dựa trên cơ sở mà vị hoa tiêu cũ để lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510224
					],
					"speakerTitle": "Huixing"
				},
				{
					"id": 190510224,
					"content": "Chỉ là tôi có thêm chút \"tính thời sự\" vào mà thôi, chính là vẽ thêm tình hình thay đổi của biển cả vào trong hải đồ. Tôi nghĩ kinh nghiệm của tôi chỉ có bấy nhiêu thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510225
					],
					"speakerTitle": "Huixing"
				},
				{
					"id": 190510225,
					"content": "Nhưng mà, tôi cảm thấy chuyện này bạn có thể đi hỏi chị đại đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510226
					],
					"speakerTitle": "Huixing"
				},
				{
					"id": 190510226,
					"content": "Bởi vì trước đó có lần, đội thuyền đi lạc vào trong vùng biển lạ. Do lo lắng gặp phải nguy hiểm nên chúng tôi không vào quá sâu, chọn cách rút lui an toàn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510227
					],
					"speakerTitle": "Huixing"
				},
				{
					"id": 190510227,
					"content": "Nhưng tuyến đường mà chúng tôi đi qua đều được chị đại ghi lại cẩn thận vào trong hải đồ, đề phòng cho sau này có thể quay lại thám hiểm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510228
					],
					"speakerTitle": "Huixing"
				},
				{
					"id": 190510228,
					"content": "Không ngờ đúng không? Lúc đó tôi cũng bất ngờ lắm, chỉ một mình chị đại thôi là đã xử lý êm xuôi cả rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510229
					],
					"speakerTitle": "Huixing"
				},
				{
					"id": 190510229,
					"content": "Vậy tại sao lại cần cô đảm nhiệm vị trí hoa tiêu nhỉ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510230
					]
				},
				{
					"id": 190510230,
					"content": "Bởi vì tôi có tố chất mà, cô ấy đương nhiên sẽ đào tạo cho tôi rồi. Hihi, thực ra không chỉ có mình tôi đâu, mọi người đều như vậy cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510231
					],
					"speakerTitle": "Huixing"
				},
				{
					"id": 190510231,
					"content": "Trước đó tôi cũng nghi ngờ giống như bạn vậy, dẫu sao thì trong rất nhiều đội thuyền, thuyền trưởng cũng sẽ kiêm thêm vai trò hoa tiêu mà. Vì vậy, tôi đã đi hỏi cô ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510232
					],
					"speakerTitle": "Huixing"
				},
				{
					"id": 190510232,
					"content": "Kết quả là cô ấy cười phá ra, nói là cho dù là Nham Vương Đế Quân đi nữa cũng không thể đơn đả độc đấu được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510233
					],
					"speakerTitle": "Huixing"
				},
				{
					"id": 190510233,
					"content": "Cô ấy hy vọng mỗi một người trên thuyền sẽ giỏi một phương diện khác nhau, có như vậy thì đội thuyền Nam Thập Tự mới không phải dựa vào sức của một mình cô ấy nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510234
					],
					"speakerTitle": "Huixing"
				},
				{
					"id": 190510234,
					"content": "Cho dù sau này cô ấy không còn ở đây nữa, thì đội ngũ này vẫn sẽ tiếp tục tiến về phía trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510235
					],
					"speakerTitle": "Huixing"
				},
				{
					"id": 190510235,
					"content": "Đừng thấy bình thường chị đại ăn to nói lớn như thế mà hiểu lầm, chị đại luôn chuẩn bị chu toàn cho mọi người đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510220
					],
					"speakerTitle": "Huixing"
				},
				{
					"id": 190510236,
					"content": "Tôi không còn gì để hỏi rồi, cảm ơn nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510237
					]
				},
				{
					"id": 190510237,
					"content": "Điều nên làm mà, bạn là bạn của chị đại mà, cho nên cũng sẽ là bạn của tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huixing"
				}
			]
		},
		{
			"id": 1905103,
			"completionStepIds": [
				1905103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
