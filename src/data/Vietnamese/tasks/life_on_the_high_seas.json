			"dialogs": [
				{
					"id": 190510301,
					"content": "Nhà lữ hành! Xin chào, bạn đến tìm tôi để tìm hiểu về cách quan sát thiên văn đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510302
					],
					"speakerTitle": "Xu Liushi"
				},
				{
					"id": 190510302,
					"content": "Làm sao anh biết?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510303
					]
				},
				{
					"id": 190510303,
					"content": "Haha, đây là nghề của tôi mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510304
					],
					"speakerTitle": "Xu Liushi"
				},
				{
					"id": 190510304,
					"content": "Ban nãy tôi thấy chị đại dẫn bạn đi tham quan chỗ huấn luyện lính mới, sau đó bạn cũng đến chỗ của Yinxing với Huixing để nói chuyện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510305
					],
					"speakerTitle": "Xu Liushi"
				},
				{
					"id": 190510305,
					"content": "Như vậy là tôi đoán ra ngay chị đại muốn bạn tìm hiểu thêm về cuộc sống trên biển của chúng tôi rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510306,
						190510307
					],
					"speakerTitle": "Xu Liushi"
				},
				{
					"id": 190510306,
					"content": "Quả nhiên lợi hại nhỉ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510308
					]
				},
				{
					"id": 190510308,
					"content": "Haha, vậy tôi sẽ không vòng vo nữa, để tôi giới thiệu những kiến thức quan trọng về quan sát thiên văn cho bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510309
					],
					"speakerTitle": "Xu Liushi"
				},
				{
					"id": 190510309,
					"content": "Thiên văn mà chúng ta tìm hiểu, chủ yếu là thời tiết và hiện tượng trên biển, ví dụ như sương mù, bão tố, vòi rồng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510310
					],
					"speakerTitle": "Xu Liushi"
				},
				{
					"id": 190510310,
					"content": "Những yếu tố này đa số đều sẽ ảnh hưởng đến sự an toàn của chuyến hành trình, nhưng cũng may là cho dù là hiện tượng nào trước khi xảy ra cũng đều có dấu hiệu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510311
					],
					"speakerTitle": "Xu Liushi"
				},
				{
					"id": 190510311,
					"content": "Lấy ví dụ như vòi rồng chẳng hạn, nó là một cơn lốc xoáy tốc độ cao xảy ra trên biển, sức hút của nó có thể dễ dàng cuốn bay các loại tàu lớn, rất nguy hại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510312
					],
					"speakerTitle": "Xu Liushi"
				},
				{
					"id": 190510312,
					"content": "Nhưng mà vòi rồng chỉ có thể sinh ra trong môi trường có nhiệt độ cao, độ ẩm cao và mây đen lớn. Vì vậy chúng ta có thể chuẩn bị trước được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510313
					],
					"speakerTitle": "Xu Liushi"
				},
				{
					"id": 190510313,
					"content": "Ngoài ra, trước khi vòi rồng xuất hiện, mặt biển sẽ có gió ngược hướng và tốc độ chênh lệch lớn, như vậy đã đủ để bạn cảnh giác rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510314
					],
					"speakerTitle": "Xu Liushi"
				},
				{
					"id": 190510314,
					"content": "Điều quan trọng nhất là, nếu bạn nhận thấy có một dòng xoáy nhỏ màu trắng nổi lên từ đám mây đen, bạn nên nhanh chóng thông báo cho mọi người và chuẩn bị tránh tuyến đường phía trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510315
					],
					"speakerTitle": "Xu Liushi"
				},
				{
					"id": 190510315,
					"content": "Đó chính là những dấu hiệu của vòi rồng trên biển. Rất may là trong những năm qua tôi chưa từng bỏ sót một dấu hiệu nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510316,
						190510324
					],
					"speakerTitle": "Xu Liushi"
				},
				{
					"id": 190510316,
					"content": "Anh tinh mắt thật.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510317
					]
				},
				{
					"id": 190510317,
					"content": "Hì. Nói về con mắt quan sát biển cả thì tôi cũng tàm tạm. Nhưng nói về mắt nhìn người, thì tôi thua xa chị Beidou rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510318
					],
					"speakerTitle": "Xu Liushi"
				},
				{
					"id": 190510318,
					"content": "Bạn biết làng chài nhỏ ở gần Nhà Trọ Vọng Thư không? Nghe nói chị đại lúc còn nhỏ đã làm công việc đánh cá ở đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510319
					],
					"speakerTitle": "Xu Liushi"
				},
				{
					"id": 190510319,
					"content": "Sau đó lại chuyển đến bến cảng để mưu sinh, một đứa trẻ bé xíu như thế, mà có thể sống trong môi trường như vậy, thì bạn thấy chị đại của chúng tôi có bản lĩnh không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510320
					],
					"speakerTitle": "Xu Liushi"
				},
				{
					"id": 190510320,
					"content": "Haiz, nếu không phải chị đại vỗ vai bảo tôi có thể làm một quan sát viên tài giỏi, thì tôi cũng không dám nghĩ tới chuyện này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510321
					],
					"speakerTitle": "Xu Liushi"
				},
				{
					"id": 190510321,
					"content": "Bạn không biết đâu, chuyện mà những người ngoài kia nói về tôi nhiều nhất chính là chuyện đáng xấu hổ như uống không quá ba ly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510322
					],
					"speakerTitle": "Xu Liushi"
				},
				{
					"id": 190510322,
					"content": "Uống say té xuống biển, bị người khác chế giễu, là hàng thải của đội thuyền khác, nhưng giờ đây tôi lại là quan sát viên của Nam Thập Tự. Chuyện này nói ra cũng không ai tin, haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510323
					],
					"speakerTitle": "Xu Liushi"
				},
				{
					"id": 190510323,
					"content": "Cho nên theo tôi thấy, chỉ dựa vào tài cán thôi chưa đủ, bạn còn phải tìm được một người dẫn lối có tầm nhìn như chị đại nữa mới được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510332
					],
					"speakerTitle": "Xu Liushi"
				},
				{
					"id": 190510332,
					"content": "Cảm ơn sự hướng dẫn của anh, tôi đã hiểu rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510333
					]
				},
				{
					"id": 190510333,
					"content": "Sau này nếu có thắc mắc gì cần hỏi thì có thể đến đây nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xu Liushi"
				},
				{
					"id": 190510324,
					"content": "Kinh nghiệm của anh thật phong phú.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510325
					]
				},
				{
					"id": 190510325,
					"content": "Nói ra thì thật là xấu hổ, những kinh nghiệm mà tôi có được phần lớn đều là học từ chỗ chị đại đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510326
					],
					"speakerTitle": "Xu Liushi"
				},
				{
					"id": 190510326,
					"content": "Bao gồm cả việc quan sát thiên văn mà ban nãy tôi hướng dẫn bạn, chị đại mới là chuyên gia đích thực trong lĩnh vực này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510327
					],
					"speakerTitle": "Xu Liushi"
				},
				{
					"id": 190510327,
					"content": "Bạn biết làng chài nhỏ ở gần Nhà Trọ Vọng Thư không? Nghe nói chị đại lúc còn nhỏ đã làm công việc đánh cá ở đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510328
					],
					"speakerTitle": "Xu Liushi"
				},
				{
					"id": 190510328,
					"content": "Sau đó chị đại chuyển đến bến cảng để mưu sinh, mỗi ngày đều phải lăn lộn kiếm sống trong hoàn cảnh khó khăn, cho nên bây giờ cô ấy mới bản lĩnh như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510329
					],
					"speakerTitle": "Xu Liushi"
				},
				{
					"id": 190510329,
					"content": "Những ngày đầu khi tôi lên thuyền, mỗi ngày tôi đều nghi ngờ tự hỏi, không lẽ những kinh nghiệm làm thủy thủ đó giờ của mình đều là giả sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510330
					],
					"speakerTitle": "Xu Liushi"
				},
				{
					"id": 190510330,
					"content": "Cho đến khi tôi dần quen được kiến thức mới, thông tin mới, tôi mới hiểu ra được tại sao Nam Thập Tự lại lớn mạnh như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510331
					],
					"speakerTitle": "Xu Liushi"
				},
				{
					"id": 190510331,
					"content": "Dẫu sao thì mỗi chiếc thuyền đều có một vị \"Long Vương\" và luật lệ riêng mà. Tôi thật may mắn khi được gia nhập vào nơi này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510332
					],
					"speakerTitle": "Xu Liushi"
				},
				{
					"id": 190510307,
					"content": "Beidou quả nhiên biết dùng người.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510308
					]
				}
			]
		},
