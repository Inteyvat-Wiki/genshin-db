				{
					"id": 751780901,
					"content": "#{M#Anh}{F#Chị} {NICKNAME}, xin chào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780902,
						751780903
					],
					"speakerTitle": "???"
				},
				{
					"id": 751780902,
					"content": "Sao lại ủ rũ thế?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780904
					]
				},
				{
					"id": 751780904,
					"content": "Thực ra... So với lúc trước, nước của suối nước nóng hình như vẫn hơi lạnh... Lần này em gây họa lớn rồi, sau khi trở về phải làm sao đây...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780905
					],
					"speakerTitle": "???"
				},
				{
					"id": 751780905,
					"content": "Đừng lo, cứ chờ thêm xem sao.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780906
					]
				},
				{
					"id": 751780906,
					"content": "Ừm, em biết rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "???"
				},
				{
					"id": 751780903,
					"content": "Tạm biệt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780907
					]
				},
				{
					"id": 751780907,
					"content": "#Ừm... Đi đường cẩn thận nhé, {M#anh}{F#chị} {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
