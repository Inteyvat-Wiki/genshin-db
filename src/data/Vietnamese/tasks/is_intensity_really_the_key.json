					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751781011,
					"content": "#Đợi đã! {REALNAME[ID(2)|SHOWHOST(true)]}, đừng chạy lung tung!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781005,
					"content": "Trong núi lửa chắc là có rất nhiều dung nham...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751781006
					]
				},
				{
					"id": 751781006,
					"content": "À! Tôi hiểu rồi, để cậu nhóc đào một cái hố, sau đó dùng dung nham của núi lửa để làm nóng suối nước nóng đúng không? Cách này cũng hay đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781007
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781007,
					"content": "Rawr! Rawr! Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781008
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751781008,
					"content": "#Còn lâu nhé! Dùng dung nham sẽ gây tai nạn chết người đó! Nghiêm túc chút đi! {REALNAME[ID(2)|SHOWHOST(true)]} tin là thật rồi đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781009
					],
					"speakerTitle": "Paimon"
				}
			]
