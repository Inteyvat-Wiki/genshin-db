				]
			},
			"dialogs": [
				{
					"id": 751780701,
					"content": "Lạnh lẽo thế sao! Lạnh lẽo tới mức nào chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780702
					],
					"speakerTitle": "Ma'chah"
				},
				{
					"id": 751780702,
					"content": "Hả? Lạnh á? Lạnh ở đâu? Không phải anh đang ở trong suối nước nóng sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780703,
					"content": "Không đủ! Vẫn không đủ! Lạnh lẽo thế này thì sao có thể xưng là mạnh nhất chứ! Muốn trở thành người mạnh nhất của Cộng Đồng Trù Phú, à không, phải là mạnh nhất Natlan, thì độ nóng bỏng thế này còn kém xa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780704
					],
					"speakerTitle": "Ma'chah"
				},
				{
					"id": 751780704,
					"content": "Hả? Sao lại ngồi xuống nữa rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780705,
						751780707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780705,
					"content": "Xem ra độ \"nóng bỏng\" vẫn chưa đủ!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780706
					]
				},
				{
					"id": 751780706,
					"content": "Độ \"nóng bỏng\" rốt cuộc là cái gì thế? Sao mà tôi nghe chẳng hiểu gì cả vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780709,
					"content": "#Tốt quá, hai vị chắc hẳn là nhà mạo hiểm nổi tiếng {NICKNAME} và Paimon! Lần này được cứu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780710
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780710,
					"content": "Hả? Đã xảy ra chuyện gì thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780711,
					"content": "Không giấu gì, theo lời đại sư thì anh ấy đang tiến về con đường \"mạnh nhất\", chìm đắm trong việc tu hành ở suối nước nóng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780712
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780712,
					"content": "Tu, tu hành? Ở trong suối nước nóng sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780713,
					"content": "Đúng, đúng vậy... Tuy... Tuy rằng tôi cũng không tin lắm. Nhưng cách này là do đại sư xem trong cuốn sách võ đạo có tên \"Liệt Tuyền Đạo\" đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780714
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780714,
					"content": "Trong sách nói, nếu tu luyện theo cách của suối nước nóng thì một ngày nào đó, chỉ bằng độ \"nóng bỏng\" của bản thân thôi là sẽ có thể khiến cho <color=#00E1FFFF>nước lạnh sôi sục</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780715
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780715,
					"content": "Không chỉ vậy, trong sách còn ghi lại rất nhiều người mạnh mẽ. Có người chỉ trong một đêm có thể tay không xuyên qua ngọn núi, còn có người dùng tay không mà biến đá thành bảo thạch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780716
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780716,
					"content": "#Không ngờ trên thế gian còn có võ đạo thần kỳ như vậy! Nếu như {NICKNAME} cũng học được thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780717,
						751780718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780717,
					"content": "Đây là tình tiết chỉ có trong tiểu thuyết thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780719
					]
				},
				{
					"id": 751780719,
					"content": "Có lẽ hai vị sẽ cảm thấy cuốn sách đó rất hoang đường, nhưng đây dù sao cũng là cuốn sách quý giá mà đại sư đã lựa chọn từ trong đống sách của Chủ Nhân Gió Đêm. Quan trọng nhất là, chính bản thân đại sư rất tin tưởng vào nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780720
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780720,
					"content": "Để thực hành Liệt Tuyền Đạo, đại sư cố tình chọn suối nước nóng đặc biệt này. À không, là suối lạnh. Phải biến suối lạnh cực độ thành suối nóng cực độ, bằng cách dùng độ \"nóng bỏng\" thuần túy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780721
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780721,
					"content": "Thật, thật là, nước trong suối nước nóng không nóng chút nào! Nhưng mà... cứ ngâm mãi trong loại nước này thì người lợi hại đến đâu cũng sẽ ốm thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780722
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780722,
					"content": "Haiz, không ốm cũng không được ấy chứ! Khiêu Chiến Dũng Sĩ bên đó đã dừng mấy ngày rồi, đang đợi đại sư quay lại đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780723
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780723,
					"content": "Nhưng đại sư nói, bỏ cuộc giữa chừng là hành vi không có nhiệt huyết. Vì vậy, trừ phi nước suối sôi sục, không thôi đại sư tuyệt đối sẽ không rời đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780724
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780724,
					"content": "Người quản lý bên cạnh cũng không tìm được nguyên nhân suối nước nóng trở nên lạnh. Haiz, lúc này nếu có nhà mạo hiểm giàu kinh nghiệm thì tốt quá... Tôi chuẩn bị xong thù lao rồi, nhiều lắm luôn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780725,
						751780726
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780725,
					"content": "Chuyện này nên đi tìm Cư Dân Suối Nước...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780727
					]
				},
				{
					"id": 751780727,
					"content": "(Đừng vội từ chối, chúng ta xem thử số thù lao của anh ta là bao nhiêu trước đã.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780728,
					"content": "Khụ khụ, yên tâm, chúng tôi nhất định sẽ làm cho suối nước nóng ấm lên. Hơn nữa, chúng tôi cũng không thể nhìn đại sư đó bị bệnh vì suối nước lạnh được. Dù sao thì nhà mạo hiểm tốt sẽ luôn sẵn sàng giúp đỡ mọi người mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780729
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780729,
					"content": "Tốt quá, vậy thì nhờ cả vào hai vị rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780730
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780730,
					"content": "Cứ ở đây đợi tin tốt của chúng tôi nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780726,
					"content": "Định dùng thù lao để mua chuộc tôi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780727
					]
				},
				{
					"id": 751780718,
					"content": "Paimon nghĩ là thật sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780719
					]
				},
				{
					"id": 751780707,
					"content": "Bởi vì đứng lên sẽ càng lạnh hơn...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780708
					]
				},
				{
					"id": 751780708,
					"content": "Ra là vậy, chẳng trách toàn thân đại sư đều run rẩy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780709
					],
					"speakerTitle": "Paimon"
				}
			]
		},
