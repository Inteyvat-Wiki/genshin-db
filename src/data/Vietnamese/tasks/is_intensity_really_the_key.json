				"objectNames": [
					"Loshts"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751780501,
					"content": "Dũng sĩ từ nơi xa, sao rồi? Hai vị đã tìm được con đường đến chỗ \"người mạnh nhất\" chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780502,
						751780503
					],
					"speakerTitle": "Loshts"
				},
				{
					"id": 751780502,
					"content": "Về vị trí của \"người mạnh nhất\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780504
					]
				},
				{
					"id": 751780504,
					"content": "Đi lên núi, có một vùng núi tràn ngập \"Nước Nóng Bỏng\". Ở đó, có lẽ sẽ tìm thấy bóng dáng của \"người mạnh nhất\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Loshts"
				},
				{
					"id": 751780503,
					"content": "Vẫn đang cố gắng...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780505
					]
				},
				{
					"id": 751780505,
					"content": "Tốt lắm, tốt lắm!",
