				]
			},
			"dialogs": [
				{
					"id": 751780101,
					"content": "Xin chào! Cho hỏi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780102,
					"content": "#Nóng bỏng đến mức này này! Không hổ danh là {NICKNAME} và Paimon trong truyền thuyết! Hai vị từ xa đến, chẳng lẽ là để giành danh hiệu \"Mạnh Nhất Cộng Đồng Trù Phú\" ư?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780103
					],
					"speakerTitle": "Loshts"
				},
				{
					"id": 751780103,
					"content": "\"Mạnh Nhất Cộng Đồng Trù Phú\"? Ở đây không phải chỉ là \"Khiêu Chiến Dũng Sĩ\" thông thường thôi sao? Bên kia rõ ràng có nhiều người xếp hàng như vậy mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780104,
					"content": "Hahaha, họ không có cơ hội so sánh với hai vị đâu. Phải biết rằng, muốn đạt được danh hiệu \"mạnh nhất\" thì chỉ có thể chiến thắng \"người mạnh nhất\". Người bình thường không có tư cách này đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780105
					],
					"speakerTitle": "Loshts"
				},
				{
					"id": 751780105,
					"content": "Hai vị đến thì tốt quá! Nhưng hơi tiếc là lại không đúng lúc rồi. Hiện tại đại sư không có thời gian nghĩ về những chuyện thế tục trên đời, e rằng tạm thời không có cơ hội đối đầu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780106,
						751780107
					],
					"speakerTitle": "Loshts"
				},
				{
					"id": 751780106,
					"content": "\"Người mạnh nhất\" đang ở nơi nào thế?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780108
					]
				},
				{
					"id": 751780108,
					"content": "#Ồ? {F#Cô}{M#Cậu} chuẩn bị khiêu chiến ư? Gan dạ thật! Vậy tôi cho {F#cô}{M#cậu} biết vị trí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780110
					],
					"speakerTitle": "Loshts"
				},
				{
					"id": 751780110,
					"content": "Tìm kiếm dọc theo con đường khổ luyện gập ghềnh đó sẽ phát hiện ra một vùng núi tràn ngập \"Nước Nóng Bỏng\". Ở đó, có lẽ sẽ tìm thấy bóng dáng của \"người mạnh nhất\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Loshts"
				},
				{
					"id": 751780107,
					"content": "Được rồi, vậy chúng tôi đợi đại sư quay lại.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780109
					]
				},
				{
					"id": 751780109,
					"content": "Đúng lắm, nóng bỏng và nóng bỏng cuối cùng cũng sẽ thu hút lẫn nhau, người mạnh nhất và người mạnh nhất cũng nhất định sẽ gặp nhau, chờ đợi cũng là một lựa chọn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Loshts"
				}
			]
		},
		{
			"id": 7517802,
