			},
			"dialogs": [
				{
					"id": 751780201,
					"content": "Có, có ai giúp một tay không! Có người bị ngất rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780202
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780202,
					"content": "#Thôi, thôi xong rồi! Đại sư hình như ngất đi rồi! Chúng ta mau đi giúp thôi, {NICKNAME}!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780203
					]
				},
				{
					"id": 751780203,
					"content": "Hình như đại sư chỉ bị ngất vì nóng quá, cơ thể không có gì đáng lo ngại. Dưới sự giúp đỡ của các bạn, đại sư bị ngất đã được Yoleehe đưa đi...\\nXem ra độ \"nóng bỏng\" của đại sư vẫn cần phải tăng thêm...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
