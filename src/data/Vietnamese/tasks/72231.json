			},
			"dialogs": [
				{
					"id": 722310101,
					"content": "Ngài Guuji Đại Diện vui mừng như vậy, xem ra người đó thật sự rất là quan trọng đối với nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310102
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722310102,
					"content": "Nhưng, không biết rốt cuộc cô ấy đang ở đâu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7223102,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7223101",
							"2"
						],
						"stepId": 7223101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Etsuko",
					"Taisuke"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722310201,
					"content": "Quả thực, Hibiki, Đền Asase và Domeki đều khiến người khác để tâm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310202,
						722310207
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722310202,
					"content": "Các bạn xuất hiện từ lúc nào vậy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722310203
					]
				},
				{
					"id": 722310203,
					"content": "Trên đảo có tiếng ồn lớn như vậy, nên chúng tôi đến đây thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310204
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722310204,
					"content": "Nhưng có một số chuyện tôi cảm thấy phải nói với các bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310205
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722310205,
					"content": "Taisuke, nói rõ hơn đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310206
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722310206,
					"content": "Ừm...được thôi, tiểu thư Etsuko. Là thế này, tôi muốn nói những chuyện...liên quan đến hòn đảo Seirai này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310208
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722310208,
					"content": "Lịch sử của đảo Seirai thật sự quá lâu đời, mặc dù hiệp hội đã từng cố gắng thu thập tư liệu, nhưng dường như cũng không tìm được gì hữu ích...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310209
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722310209,
					"content": "Theo tư liệu của hiệp hội, mấy trăm năm trước, nơi này từng là nơi tụ tập của hải tặc, khi đó, Shogunate đã đứng ra quét sạch bọn hải tặc, và đưa cư dân trên đảo đến một nơi khác...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310210
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722310210,
					"content": "Nếu không nằm ngoài dự đoán, thì có lẽ Domeki kia chính là thủ lĩnh hải tặc Ako Domeki từng xung đột với Shogunate, trong tài liệu có ghi rõ tên hắn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310211
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722310211,
					"content": "Theo ghi chép trong tư liệu mà hiệp hội đưa cho chúng tôi, Ako Domeki này đã chỉ huy một đội thuyền hải tặc và chiến đấu chống lại Shogunate trên biển.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310212
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722310212,
					"content": "Mặc dù đội thuyền của hắn rất nhanh đã bị Shogunate áp chế, buộc phải chạy trốn đến đảo Seirai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310213
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722310213,
					"content": "Nhưng khi đội thuyền của Shogunate đang truy kích hắn, một cơn bão sét không rõ nguyên nhân đã nổ ra trên đảo Seirai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310214
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722310214,
					"content": "Đội thuyền của Ako Domeki và Shogunate đều bị sét đánh trúng...và tất cả đều mất hết dấu vết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310215
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722310215,
					"content": "Bão sét...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722310216
					]
				},
				{
					"id": 722310216,
					"content": "Để tôi nói tiếp...điểm đáng nghi nhất trong chuyện này là trận bão sét bất ngờ đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310217
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722310217,
					"content": "Mặc dù đội thuyền của Ako Domeki cũng bị ảnh hưởng bởi cơn bão sét và gần như bị xóa sổ hoàn toàn...nhưng đội thuyền do Shogunate phái đến đảo Seirai cũng gần như bị hủy diệt và buộc phải rút về đảo Narukami, phải mất một thời gian để tổ chức lại đội thuyền.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310218
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722310218,
					"content": "Cơn bão sét đó ập đến quá đúng lúc, cứ như...ai đó đang cố tình thao túng vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310219
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722310219,
					"content": "Bạn còn nhớ những \"Trấn Thạch\" bị giải phong ấn trên hòn đảo này không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310220
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722310220,
					"content": "Còn nữa, sau khi chúng tôi phong ấn số \"Trấn Thạch\" đó thì cơn bão sét trên đảo cũng giảm dần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310221
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722310221,
					"content": "Tôi không muốn suy đoán, nhưng mà...tôi cảm thấy những chuyện này ít nhiều cũng có liên quan đến nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310222
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722310222,
					"content": "Hay là chúng ta đi hỏi Neko đại nhân đi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310223
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722310223,
					"content": "...Bỏ đi. Tư liệu ghi là Domeki đã mất tích. Nói là mất tích, nhưng bị sét đánh trúng, có lẽ cũng đã...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310224
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722310224,
					"content": "Chúng tôi sẽ tiếp tục thăm dò trên đảo và tiếp tục thu thập manh mối về vấn đề này, một thời gian nữa, chúng tôi sẽ quay lại báo cáo với hiệp hội.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310225
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722310225,
					"content": "Hì hì, Nhà Lữ Hành, nói không chừng đến lúc đó chúng ta sẽ lại tiếp tục hợp tác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310226
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722310226,
					"content": "Đến lúc đó xin hãy giúp đỡ nhiều hơn!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722310227
					]
				},
				{
					"id": 722310227,
					"content": "Cùng giúp đỡ nhau nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310228
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722310228,
					"content": "Taisuke, chuẩn bị đi, chúng ta tiếp tục lên kế hoạch thám hiểm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310229
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722310229,
					"content": "Ừm...tiểu thư Etsuko, vậy Neko đại nhân...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310230
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722310230,
					"content": "Trước đây anh sống với con mèo đó thế nào thì sau này cũng cứ như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310231
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722310231,
					"content": "Nhưng nhớ là đừng nói những lời không nên nói.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310232
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722310232,
					"content": "Có lẽ bây giờ...nó đang rất vui vẻ, đừng nói những lời khiến nó mất vui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310233
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722310233,
					"content": "Tôi biết rồi! Tiểu thư Etsuko, hihi, cô đúng là rất...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310234
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722310234,
					"content": "...Chỉ là để hoàn thành tốt ủy thác thôi, mau đi làm việc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310235
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722310235,
					"content": "Đảo Seirai...xem ra hòn đảo này còn rất nhiều bí mật...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722310207,
					"content": "Các bạn biết gì sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722310208
					]
				}
			]
		}
	]
}