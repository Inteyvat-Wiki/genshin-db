			"dialogs": [
				{
					"id": 402070201,
					"content": "Chào Ineffa! Lần này Jahoda lại ở đây à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402070202,
					"content": "Vất vả bao ngày, ít nhất cũng phải cho tôi một miếng bánh kem chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070203
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 402070203,
					"content": "Có bánh kem à!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402070204,
					"content": "#Đúng vậy. {NICKNAME} và Paimon đến đúng lúc lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070205
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070205,
					"content": "Aino luôn muốn cảm ơn các vị, vừa hay đã cứu được Krum-clank 70% Ngọt, nên muốn mời mọi người nếm thử tài nghệ nấu nướng của nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070206
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070206,
					"content": "Clank... clank...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070207
					],
					"speakerTitle": "Krum-clank 70% Ngọt"
				},
				{
					"id": 402070207,
					"content": "Woa, đây chính là dáng vẻ vốn có của Krum-clank 70% Ngọt sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402070208,
					"content": "Cũng may lõi vẫn hoàn chỉnh, nên Aino đã tạo lại một cơ thể mới cho nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070209
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070209,
					"content": "Clank... clank...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070210
					],
					"speakerTitle": "Krum-clank 70% Ngọt"
				},
				{
					"id": 402070210,
					"content": "Món ngon nóng hổi đã ra lò rồi à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402070211,
					"content": "Rộp...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070212
					],
					"speakerTitle": "Krum-clank 70% Ngọt"
				},
				{
					"id": 402070212,
					"content": "Này, nó tự mình ăn mất rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402070213,
					"content": "Trước khi đầu bếp đem món lên thì luôn lén nếm thử một chút mà, cũng không có gì lạ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070214
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 402070214,
					"content": "Không cần lo, nó ăn xong sẽ làm phần khác cho mọi người. Một lát là xong ngay thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070215
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070215,
					"content": "Được rồi... Nhưng sao đến lúc ăn đồ ngọt thì lại không thấy Aino đâu vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402070216,
					"content": "Aino vừa nghĩ ra một ý tưởng chế tạo robot mới, nên đã lập tức lao vào xưởng. Từ khi tôi tới xưởng thì cô ấy đã luôn như vậy rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070217
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070217,
					"content": "Tại sao Aino lại thích chế tạo robot thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402070218,
					"content": "Hm... Muốn trả lời câu hỏi này thì cần phải tra cứu rất nhiều dữ liệu lịch sử.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070219
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070219,
					"content": "Ban đầu Aino có thể chỉ bất ngờ vì trên thế giới này vẫn còn một thứ khác thu hút cô ấy hơn là đồ ngọt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070220
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070220,
					"content": "May mắn là sở thích của Aino được bạn bè tôn trọng. Cho dù việc duy trì cuộc sống đã tiêu hao gần hết thời gian hàng ngày của cô ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070221
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070221,
					"content": "Cho đến khi một giáo viên ưu tú xuất hiện, sở thích của Aino mới được xem là tài năng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070222
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070222,
					"content": "Cũng như những bạn bè trước kia, Aino đã tìm thấy việc mình muốn làm nhất, và cũng giỏi nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070223
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070223,
					"content": "Khi một thiên tài tìm thấy việc mình thật sự muốn làm, thì cô ấy sẽ rất khó để dừng bước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070224
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070224,
					"content": "Aino cuối cùng vẫn rời xa những người bạn thời thơ ấu để thành lập Xưởng Krumkake Clink-Clank, bắt đầu chế tạo các loại robot.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070225
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070225,
					"content": "Đối với Aino khi đó, có lẽ tất cả đều xuất phát từ bản năng của thiên tài. Cô ấy khao khát biến những suy nghĩ kỳ diệu của mình thành hiện thực.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070226
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070226,
					"content": "Ồ... Vậy nên mới thích chế tạo robot đến vậy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402070227,
					"content": "Nhưng mà theo kinh nghiệm của mình, tôi nghĩ đó không phải là toàn bộ câu trả lời.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070228
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070228,
					"content": "Từ lâu trước khi thu nhận tôi, Aino đã bắt đầu dùng mọi kỹ thuật của mình để trao cá tính độc lập cho từng con robot được chế tạo ra, xem chúng như bạn đồng hành...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070229
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070229,
					"content": "Tôi cũng không vì xuất thân của mình mà trở thành ngoại lệ trong xưởng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070230
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070230,
					"content": "Phân tích nguyên nhân, có lẽ cô ấy đã đi rất xa trên con đường thiên tài này. Khi nhìn lại thì bên cạnh không còn ai cả, nên sẽ không khỏi cảm thấy cô độc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070231
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070231,
					"content": "Cho nên tôi, Krum-clank 70% Ngọt và tất cả robot gia nhập xưởng qua bàn tay Aino, đều không chỉ là một loại minh chứng cho thiên tài.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070232
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070232,
					"content": "Chúng tôi còn là người nhà của Aino, là sự đồng hành mà cô ấy cần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070233
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070233,
					"content": "Đây là cách tôi hiểu về mối quan hệ giữa Aino và robot.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070234
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070234,
					"content": "Thì ra là vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070235
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402070235,
					"content": "Aino không quan tâm đến việc Krum-clank 70% Ngọt có sức mạnh khiến các thế lực khác phải kiêng dè hay không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070236
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070236,
					"content": "Nó đã được xác định là một thành viên của xưởng, điều này đủ để Aino làm tất cả những việc đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070237
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070237,
					"content": "Ừm, tôi cũng thấy vậy! Nên tôi cũng rất lấy làm lạ khi người như Aino lại ở lại Nod-Krai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402070238,
					"content": "...Chương trình logic của tôi không thể hiểu câu nói này của Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070239
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070239,
					"content": "Ý tôi là, nơi có đủ loại người như Nod-Krai xung quanh đầy rẫy mưu kế, những người có thể đứng vững ở đây chắc chắn đều không nên dây vào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070240
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402070240,
					"content": "Nếu những người khác có được kỹ thuật như Aino, thì chắc chắn sẽ cải tạo robot thành vũ khí mạnh mẽ, dùng chúng để uy hiếp người khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070241
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402070241,
					"content": "Nhưng Aino... Cô ấy là người có thể biến vũ khí tàn sát thành máy làm bánh, cảm thấy cô ấy không hợp với Nod-Krai chút nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070242
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402070242,
					"content": "Không, tôi thì có quan điểm hoàn toàn ngược lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070243
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070243,
					"content": "Tôi đã tiếp xúc với rất nhiều người ở Nod-Krai, nhưng đa số họ đều không được định nghĩa là \"người Nod-Krai\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070244
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070244,
					"content": "Nhưng chính Aino lại khớp với định nghĩa \"người Nod-Krai\" trong suy nghĩ của tôi nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070245
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070245,
					"content": "Ding... Ding...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070246
					],
					"speakerTitle": "Krum-clank 70% Ngọt"
				},
				{
					"id": 402070246,
					"content": "Đã làm xong đồ ngọt rồi à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070247
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 402070247,
					"content": "Ừm, không cần vội, để tôi chia ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070248
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070248,
					"content": "Tôi muốn cái có nhiều kem nhất!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070249
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 402070249,
					"content": "Được rồi, mọi người hãy thưởng thức nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070250
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070250,
					"content": "Ngon quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}