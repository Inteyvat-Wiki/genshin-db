			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Beidou",
					"Xinyan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400390401,
					"content": "Lại là cô nàng phiền phức đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390402
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 400390402,
					"content": "Tòa Quần Ngọc Các đó đã vỡ vụn cả rồi, số đồ vật trong đó cũng tan nát hết cả, làm sao có thể vớt lên được chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390403
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 400390403,
					"content": "Công việc trục vớt vẫn thuận lợi chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400390404
					]
				},
				{
					"id": 400390404,
					"content": "Nhà lữ hành sao? Sao bạn lại ở đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390405
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 400390405,
					"content": "Tôi đến để giúp đỡ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400390406
					]
				},
				{
					"id": 400390406,
					"content": "Ồ! Đúng lúc lắm, giờ toàn bộ người trên thuyền đều đã điều động hết cả rồi, nhân lực đúng là không đủ dùng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390407
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 400390407,
					"content": "Nhìn xem, đến cả Xinyan cũng bị tôi kéo đến giúp đỡ kìa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390408
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 400390408,
					"content": "Xinyan cũng ở đây sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400390409
					]
				},
				{
					"id": 400390409,
					"content": "Đúng vậy, Xinyan sao lại ở trên thuyền chứ? Không lẽ là đi biểu diễn sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400390410,
					"content": "Đúng vậy! Tuy cũng không phải là buổi diễn chính thức gì, chỉ là buổi tiệc do chị Beidou tổ chức thôi, cho nên mời tôi đến hát vài bài.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390411
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400390411,
					"content": "Nhưng tiệc vẫn chưa bắt đầu thì có một người tự xưng là thư ký của Ningguang đến kéo chị Beidou đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390412
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400390412,
					"content": "Hình như tên là Baiwen hay Baixiao gì gì đó... nói chung là quên mất rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390413
					],
					"speakerTitle": "Beidou"
