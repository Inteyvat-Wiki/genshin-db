		{
			"id": 4003902,
			"completionStepIds": [
				4003902
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003902",
							"2"
						],
						"stepId": 4003902,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ningguang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400390201,
					"content": "Đúng là vẫn còn thiếu nhiều thứ thật...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390202
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 400390202,
					"content": "Thiếu gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400390203
					]
				},
				{
					"id": 400390203,
					"content": "So với trước đây thì Quần Ngọc Các hiện giờ thiếu đi khá nhiều thứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390204
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 400390204,
					"content": "Những quyển sách quý, đồ gia dụng và trang sức mà tôi sưu tầm đều đã chìm xuống biển chung với tòa Quần Ngọc Các đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390205
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 400390205,
					"content": "Những món đồ này đa số đều đã tan tành trong trận chiến đó rồi, số ít may mắn còn sót lại thì rơi hết xuống biển, rất khó thu hồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390206
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 400390206,
					"content": "Chỉ có những người quen với công việc trên biển mới có thể thay tôi làm việc này. Chỉ là... không biết Beidou có thể trục vớt được hết không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390207
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 400390207,
					"content": "Trục vớt về sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400390208
					]
				},
				{
					"id": 400390208,
					"content": "Hử? Cô nhờ Beidou đi trục vớt đồ đạc sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400390209,
					"content": "Dùng chữ \"nhờ\" là không chính xác nhé, đây là cuộc giao dịch công bằng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390210
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 400390210,
					"content": "Beidou nhận tiền để làm việc sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400390211
					]
				},
				{
					"id": 400390211,
					"content": "Ngoài \"tiền\" ra thì vẫn còn cách khác để trả \"thù lao\" mà... Haha, chuyện này phức tạp lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390212
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 400390212,
					"content": "Nói chung thì Beidou đang ở Cô Vân Các đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390213
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 400390213,
					"content": "Nếu các bạn có hứng thú thì có thể đến đó xem thử, nói không chừng có thể giúp được cô ấy đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ningguang"
				}
			]
		},
		{
			"id": 4003904,
			"completionStepIds": [
				4003904
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
