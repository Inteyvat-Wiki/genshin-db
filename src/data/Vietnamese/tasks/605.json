			"dialogs": [
				{
					"id": 6050201,
					"content": "Hai vị vất vả rồi, phòng ngự tốt lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050202
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 6050202,
					"content": "Tiếp theo cứ giao cho chúng tôi là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050203
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 6050203,
					"content": "Đội trưởng Kaeya! Swan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050204
					],
					"speakerTitle": "Lawrence"
				},
				{
					"id": 6050204,
					"content": "Này! Tôi không sao. Nhưng bắp chân của anh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050205
					],
					"speakerTitle": "Swan"
				},
				{
					"id": 6050205,
					"content": "Swan, Lawrence, đến Giáo Hội Tây Phong chữa trị đi, đừng miễn cưỡng. Chúng tôi sẽ tiếp quản nơi này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050206
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 6050206,
					"content": "Nhưng mà, lão gia Diluc cũng... Ngài không phải đã rời khỏi Đội Kỵ Sĩ từ lâu rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050207
					],
					"speakerTitle": "Swan"
				},
				{
					"id": 6050207,
					"content": "Đúng vậy, nhưng cũng không phải chỉ có người của Đội Kỵ Sĩ mới có thể canh giữ cánh cổng này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050208
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 6050208,
					"content": "Diluc trước giờ luôn rất nhiệt tình mà. Đừng lo nữa, công dân đã muốn góp sức thì cứ để họ làm đi, cũng không có gì xấu cả mà, phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050209
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 6050209,
					"content": "...Tôi hiểu rồi. Rất xin lỗi, thực sự rất cảm ơn ngài vì đã hỗ trợ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050210
					],
					"speakerTitle": "Swan"
				},
				{
					"id": 6050210,
					"content": "Chúng tôi sẽ tranh thủ quay lại, hai vị cố lên nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050211
					],
					"speakerTitle": "Lawrence"
				},
				{
					"id": 6051104,
					"content": "Nhân lúc có thời gian, tôi định chế thuốc phân phát cho các chiến sĩ xung quanh, như vậy chắc sẽ giúp ích được một chút!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6051105
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 6051105,
					"content": "Phán đoán tốt lắm, vất vả rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6051106
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 6051106,
					"content": "Hãy chú ý an toàn nhé. Nếu thật sự không thể ứng phó thì hãy lập tức rút lui đến khu vực an toàn. Không cần lo về trận chiến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6051107
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 6051107,
					"content": "Vâng, tôi hiểu rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sucrose"
				}
			]
		},
