			"dialogs": [
				{
					"id": 6051101,
					"content": "#Ngài Albedo! {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6051102
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 6051102,
					"content": "Tình hình vẫn ổn chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6051103
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 6051103,
					"content": "Vẫn ổn! Ban nãy có vài con ma vật xông vào thành, nhưng tôi đã cùng lão gia Diluc và ngài Kaeya đánh lui bọn chúng rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6051104
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 6059901,
					"content": "Cách đó không lâu...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
