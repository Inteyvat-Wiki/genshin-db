			"dialogs": [
				{
					"id": 20210201,
					"content": "Đây không phải là nhà lữ hành sao, đến đây để cầu phúc à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210202
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20210202,
					"content": "Không phải là cô gọi chúng tôi đến sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20210203,
					"content": "Haha... đùa thôi, tôi đang đợi mọi người đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210204
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20210204,
					"content": "Trông Miko đã phấn chấn hơn nhiều rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20210205,
					"content": "Đúng vậy, khó khăn lắm mới được gặp lại bạn cũ nói chuyện xưa, đây có thể xem là một chuyện đáng vui mừng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210206
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20210206,
					"content": "Tôi còn nghe nói... bạn đã phát động ngự tiền quyết đấu với một quan chấp hành Fatui, lòng dũng cảm này thật đáng khen ngợi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210207,
						20210208
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20210207,
					"content": "Chỉ là bất đắc dĩ mà thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210209
					]
				},
				{
					"id": 20210209,
					"content": "Có thể trực tiếp đả bại \"Signora\", sức mạnh của bạn đã vượt xa tôi nghĩ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210210
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20210210,
					"content": "Nói chung thì, thắng là được, rất đáng chúc mừng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210211
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20210211,
					"content": "Cuối cùng cũng có thể phá hủy được kế hoạch của Fatui rồi, hì hì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20210212,
					"content": "Ít ra thì lần này không để cho chúng lấy mất \"Gnosis\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20210213,
					"content": "Đợi đã, các bạn nhắc đến Gnosis sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210214
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20210214,
					"content": "Là một thứ có hình dạng giống quân cờ đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210215
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20210215,
					"content": "Đúng vậy, Miko cũng thấy qua rồi sao? Nó thuộc về Thất Thần, có mối liên hệ mật thiết với Đảo Thiên Không đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20210216,
					"content": "À ừm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210217
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20210217,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20210218,
					"content": "Thứ đó, tôi đã giao ra rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210219
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20210219,
					"content": "Ừm?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210220
					]
				},
				{
					"id": 20210220,
					"content": "Sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20210221,
					"content": "Nếu không như vậy... thì sao tôi có thể cứu được bạn từ tay \"Scaramouche\" chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210222,
						20210223
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20210222,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210224
					]
				},
				{
					"id": 20210224,
					"content": "\"Scaramouche\" là quan chấp hành thứ 6 của Fatui, xét về thực lực, hắn còn vượt trên cả \"Signora\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210225
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20210225,
					"content": "Tôi không phải kiểu người hành động bất chấp nguy hiểm tính mạng đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210226
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20210226,
					"content": "Chậc, đúng là không biết phải nói sao nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20210227,
					"content": "Nhưng mà, sao cô lại có được \"Gnosis\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210228
					]
				},
				{
					"id": 20210228,
					"content": "Ei từ khi tạo ra bản thể con rối, đã không còn quan tâm đến \"Gnosis\" nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210229
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20210229,
					"content": "Thân là một người bạn thân của Ei... Ei đã giao \"Gnosis\" cho tôi để bảo quản trong đền.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210230
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20210230,
					"content": "Bản thân cô ấy đã không cần sức mạnh của \"Gnosis\" nữa, theo lời cô ấy nói, cô ấy đã đoạn tuyệt quan hệ với Đảo Thiên Không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210231
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20210231,
					"content": "Nếu vậy thì \"Gnosis\" đã trở thành một thứ vô dụng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210232
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20210232,
					"content": "Cho nên, dùng nó để đổi lấy nhân vật trọng tâm trong \"kế hoạch\", không phải là cuộc giao dịch thỏa đáng sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210233
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20210233,
					"content": "Vả lại nếu xét về kết quả hiện giờ thì xem như tôi đã có lời rồi, haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210234
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20210234,
					"content": "Nói vậy nghĩa là... tính mạng của nhà lữ hành quan trọng hơn cả Gnosis sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210235,
						20210236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20210235,
					"content": "Hèn gì sau này không còn gặp lại \"Scaramouche\" nữa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210237
					]
				},
				{
					"id": 20210237,
					"content": "Thôi kệ vậy, chuyện đã qua rồi thì để cho qua vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20210238,
					"content": "Nhưng mà, lần này Miko gọi chúng tôi đến là có chuyện gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210239
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20210239,
					"content": "Là để cảm ơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210240
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20210240,
					"content": "Thật sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210241
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20210241,
					"content": "Nếu như các bạn đang trong cuộc hành trình khắp Teyvat, thì có vẻ như chuyến viếng thăm Inazuma đã dần đến hồi kết rồi đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210242
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20210242,
					"content": "Để cảm tạ, tôi sẽ giải đáp cho hai bạn những nghi vấn từ trước đến giờ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210243
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20210243,
					"content": "Bạn có gì cần hỏi không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210301,
						20210401,
						20210501,
						20210601,
						20210701
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20210301,
					"content": "Về \"con rối\" Shogun...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210302
					]
				},
				{
					"id": 20210302,
					"content": "\"Con rối\" Shogun là một loại kỹ thuật đến từ nền văn minh đã lụi tàn, có thể chỉ có thần linh như cô ấy mới biết được nguồn gốc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210303
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20210303,
					"content": "Nhưng mà... các bạn có vẻ sẽ có hứng thú với chuyện này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210304
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20210304,
					"content": "Trước khi Ei tạo ra cơ thể thần linh của mình, đã từng tạo ra một \"con rối nguyên bản\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210305
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20210305,
					"content": "Vậy, không lẽ có đến ba vị Raiden Shogun sao!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20210306,
					"content": "Không, mẫu nguyên bản đó chỉ là thử nghiệm về tính khả thi thôi, xét về dung mạo và tư duy cũng không thiết kế theo bản thân Ei. Có thể nói đó chỉ là vật thí nghiệm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210307
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20210307,
					"content": "Chiếu theo lý thì đáng lẽ Ei phải phá hủy vật thí nghiệm này, nhưng có lẽ do Ei cảm thấy như vậy là quá tàn nhẫn, nên chỉ phong ấn sức mạnh của hắn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210308
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20210308,
					"content": "Sau đó, hắn giống như một người bình thường, dựa vào ý thức của mình để lang thang trên lãnh thổ Inazuma, cho đến khi... gặp được Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210309
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20210309,
					"content": "Fatui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20210310,
					"content": "Con rối nguyên bản đó trải qua cuộc thí nghiệm của Fatui, đã giải trừ được phong ấn, thậm chí còn trở nên mạnh mẽ hơn trước đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210311
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20210311,
					"content": "Không lẽ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210312
					]
				},
				{
					"id": 20210312,
					"content": "Đúng vậy, tạo vật của thần đã đích thân lấy đi Gnosis... Hắn chính là \"Scaramouche\" của bây giờ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210313
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20210313,
					"content": "Có, có chuyện này thật sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20210314,
					"content": "Đúng vậy, không biết đây là sự trùng hợp, hay là do duyên số.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210301,
						20210401,
						20210501,
						20210601,
						20210701
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20210401,
					"content": "Về Raiden Shogun tiền nhiệm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210402
					]
				},
				{
					"id": 20210402,
					"content": "Một người ngoại quốc như bạn lại muốn biết được quá khứ của Lôi Thần sao... tham lam quá đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210403
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20210403,
					"content": "Là do Morax đã từng đề cập qua chuyện Lôi Thần Baal đã qua đời...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20210404,
					"content": "Ừm, sự thật đúng là vậy, \"Baal\" và \"Beelzebul\" là một cặp ma thần song sinh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210405
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20210405,
					"content": "Ma thần... song sinh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20210406,
					"content": "Họ đã cùng nhau chiến thắng cuộc chiến Ma Thần, sau khi Baal thành lập Shogunate, Beelzebul chính là phân thân của Baal dưới thân phận Kagemusha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210407
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20210407,
					"content": "Beelzebul chính là Ei, còn Baal, tên thật là \"Makoto\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210408
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20210408,
					"content": "Trong mắt dân chúng, hai người họ là một thể thống nhất, họ cũng luôn hỗ trợ lẫn nhau, cùng trị vì Inazuma. Chính vì vậy mà dân chúng cũng không cần phải biết sự thật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210409
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20210409,
					"content": "Cho dù là danh xưng \"Baal\", hay là Raiden Shogun cũng được, trước giờ họ đều dùng chung với nhau, cho đến khi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210410
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20210410,
					"content": "Cho đến khi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20210411,
					"content": "Cho đến khi Makoto chết trong một trận chiến vài trăm năm trước mà chính bản thân tôi cũng không thể có mặt. Sau đó Ei mới đảm nhận Shogunate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210412
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20210412,
					"content": "Chuyện này nhất định là một cú sốc đối với Ei, dù sao thì họ cũng là chị em...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210413,
						20210414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20210413,
					"content": "Cuộc chiến... vài trăm năm trước...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210415
					]
				},
				{
					"id": 20210415,
					"content": "Từ sau sự kiện đó, Ei đã phải gánh chịu sự \"mất mát\" lớn nhất trong đời.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210416
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20210416,
					"content": "Thì ra họ có một quá khứ đau thương như vậy... Vậy \"Makoto\" là một vị thần như thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20210417,
					"content": "Thời gian tôi ở bên cô ấy không lâu, nhưng trong ấn tượng của tôi... cô ấy là một vị thần hiền dịu, rất trân trọng những điều tốt đẹp trước mắt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210418
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20210418,
					"content": "Là vậy sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210301,
						20210401,
						20210501,
						20210601,
						20210701
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20210501,
					"content": "#Về {F#anh trai}{M#em gái} của tôi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210502
					]
				},
				{
					"id": 20210502,
					"content": "Xin lỗi, chuyện này tôi không có manh mối, tôi không có thông tin gì về vị thần mà các bạn miêu tả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210503
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20210503,
					"content": "Nhưng nếu bạn vẫn còn nghi ngờ Ei, thì tôi cho rằng chuyện này uổng công vô ích rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210504
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20210504,
					"content": "Ei không những không giống với miêu tả của bạn, mà từ rất lâu rồi Ei đã chủ động từ bỏ Gnosis, cắt đứt mối quan hệ với Đảo Thiên Không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210505
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20210505,
					"content": "Sau khi gặp mặt, cảm giác đúng là không phải cô ấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210506
					]
				},
				{
					"id": 20210506,
					"content": "Vậy thì tốt, nếu không thì mối liên hệ giữa chúng ta lại phải xấu đi rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210507
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20210507,
					"content": "Yên tâm đi, chúng tôi sẽ không đánh nhau với cô đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20210508,
					"content": "Hahaha... vậy chúc các bạn sớm ngày đạt được mục đích, biết được tất cả chân tướng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210509
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20210509,
					"content": "#Về phần {F#anh trai}{M#em gái} của bạn, tôi sẽ dùng hết tất cả mọi khả năng để điều tra, bao gồm cả việc điều động Shuumatsuban từ Ayato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210510
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20210510,
					"content": "Nếu có thông tin gì thì tôi sẽ báo cho bạn, xem như là một phần trong quà cảm ơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210301,
						20210401,
						20210501,
						20210601,
						20210701
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20210601,
					"content": "Về chuyến hành trình tiếp theo",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210602
					]
				},
				{
					"id": 20210602,
					"content": "Sau khi rời khỏi Inazuma, tôi nghĩ... đi đến Sumeru là tiện nhất rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210603
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20210603,
					"content": "Sumeru sao, chúng tôi đã từng gặp qua rất nhiều học giả đến từ Sumeru đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20210604,
					"content": "Ừm, Sumeru là đất nước của Thần Trí Tuệ, họ rất xem trọng việc phát triển trí tuệ và kiến thức.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210605
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20210605,
					"content": "Nhưng chấp niệm này cũng dẫn đến những việc khiến người khác khó hiểu, ví dụ như...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210606
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20210606,
					"content": "...Ở Sumeru, tri thức là một loại \"tài nguyên\" được quản lý chặt chẽ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210607
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20210607,
					"content": "Tri thức... cũng là tài nguyên sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20210608,
					"content": "Ừm, chỉ là không biết quyết định này được đưa ra bởi \"hiền giả\", hay là \"Tiểu Vương Kusanali\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210609
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20210609,
					"content": "\"Tiểu Vương Kusanali\"? Cái tên nghe dễ thương vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20210610,
					"content": "Các bạn vẫn chưa biết sao, Tiểu Vương Kusanali chính là vị thần của Sumeru, và đó là tên thân mật mà người dân gọi cô ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210611
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20210611,
					"content": "Có lẽ các bạn sẽ có một số chuyện cần tìm cô ấy để xác nhận đúng không? Chúc các bạn thượng lộ bình an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210301,
						20210401,
						20210501,
						20210601,
						20210701
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20210701,
					"content": "Đã không còn gì để hỏi rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210702
					]
				},
				{
					"id": 20210702,
					"content": "Vậy sao, vậy thì tốt rồi. À đúng rồi, lá bùa hộ mệnh tôi tặng cho bạn, bạn còn giữ chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210703
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20210703,
					"content": "Ừm, tôi vẫn luôn giữ trong người.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210704
					]
				},
				{
					"id": 20210704,
					"content": "Chỉ giữ trong người thôi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210705
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20210705,
					"content": "Tôi còn nghĩ rằng bạn sẽ đeo nó trước ngực. Khi có người hỏi sẽ còn tự hào nói rằng đây là do Yae Miko tài sắc vẹn toàn tặng cho nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210706
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20210706,
					"content": "Ai lại làm như thế chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20210707,
					"content": "Haha... được rồi được rồi. Nói ra thì, nhà lữ hành, nguyện vọng của bạn là gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210708
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20210708,
					"content": "#Ừm... được gặp lại {F#anh trai}{M#em gái}!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210709
					]
				},
				{
					"id": 20210709,
					"content": "Vậy sao... nhưng theo tôi thấy thì đây có lẽ chỉ là một mục tiêu nhỏ của bạn mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210710
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20210710,
					"content": "Đối với bạn mà nói, \"nguyện vọng\" hẳn là thứ có thể vượt qua trần thế và trời sao, lấp lánh như vận mệnh vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210711
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20210711,
					"content": "Bạn không có Vision, có thể là do nguyện vọng đó chưa được hình thành... nói không chừng đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210712
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20210712,
					"content": "Bạn cứ từ từ kiểm chứng trong chuyến hành trình sau này nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20210414,
					"content": "Không lẽ là... Khaenri'ah...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210415
					]
				},
				{
					"id": 20210236,
					"content": "Thì ra tôi có giá đến vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210237
					]
				},
				{
					"id": 20210223,
					"content": "Thì ra từ lúc đó đã...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210224
					]
				},
				{
					"id": 20210208,
					"content": "Lúc đó do tình hình nguy cấp quá.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210209
					]
				}
			]
		},
		{
			"id": 202103,
			"completionStepIds": [
				202102
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"202102",
