			"dialogs": [
				{
					"id": 705060101,
					"content": "Ôi, chào cưng, lâu rồi không gặp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060102
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705060102,
					"content": "Tuy thật hiếm khi gặp nhau ở những nơi như vậy, nhưng tôi cũng rất vui khi gặp lại bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060103
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 705060103,
					"content": "Haiz, sao lại gọi là chỗ này chỗ nọ chứ? Quán rượu rõ ràng là một nơi tốt để giải khuây mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060104
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705060104,
					"content": "Chắc cưng cũng không ngờ đến, chị phải tốn bao công sức, khuyên hết nửa ngày mới có thể kéo được đội trưởng đến đây đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060105
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705060105,
					"content": "Mới ngồi xuống không bao lâu, mà trên mặt Jean đã toàn là suy nghĩ về công việc rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060106
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705060106,
					"content": "Lisa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060107
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 705060107,
					"content": "Dù sao thì trong đội kỵ sĩ cũng có rất nhiều việc mà...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705060108
					]
				},
				{
					"id": 705060108,
					"content": "Ừm, Jean là Đội Trưởng Đại Diện mà, tất nhiên là phải quan tâm đến công việc rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705060109,
					"content": "Nhưng mà... đến thì cũng đã đến rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705060110,
					"content": "#Hay là để {NICKNAME} pha cho hai người hai ly đặc biệt nhé, uống xong là sẽ vui lên thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705060111,
					"content": "Xem như đổi gió vậy nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705060112
					]
				},
				{
					"id": 705060112,
					"content": "Haiz, chỉ có Jean mới cần phải học cách thả lỏng thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060113
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705060113,
					"content": "Này cưng, cho chị một ly Thơ Tình nhé, ly vừa thôi, thêm chút ngọt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060114
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705060114,
					"content": "Jean muốn uống gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060115
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705060115,
					"content": "Cho tôi... một ly cà phê là được, cỡ vừa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060116
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 705060116,
					"content": "Đội trưởng Jean thường ngày uống nhiều cà phê lắm rồi mà, lần này có định đổi khẩu vị không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705060117,
					"content": "Cảm ơn Paimon, nhưng mà, tôi cần uống gì đó để tỉnh táo hơn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060118
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 705060118,
					"content": "Hiểu rồi, đợi chút nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705060119
					]
				},
				{
					"id": 705060119,
					"content": "Ừm, vất vả cho bạn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jean"
				}
			]
		},
		{
