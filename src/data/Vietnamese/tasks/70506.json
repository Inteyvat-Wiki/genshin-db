			},
			"dialogs": [
				{
					"id": 705060201,
					"content": "Mmm... đúng là mùi vị này rồi, ngon thật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060202
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705060202,
					"content": "Cà phê rất đậm, vị đắng cũng vừa đủ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060203
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 705060203,
					"content": "Hai cô hài lòng là được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705060204
					]
				},
				{
					"id": 705060204,
					"content": "...Tôi hiểu ý của Lisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060205
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 705060205,
					"content": "Hở?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060206
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705060206,
					"content": "Dạo này tôi thường hay suy ngẫm về những khuyết điểm của bản thân. Nhìn chung thì tôi vẫn cần phải cải thiện thêm về mọi mặt chẳng hạn như năng suất làm việc hay kỹ năng quản lý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060207
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 705060207,
					"content": "Xem ra áp lực trên người tôi, đã bắt đầu ảnh hưởng đến Lisa rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060208
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 705060208,
					"content": "Tôi nghĩ cô chưa hiểu rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705060209
					]
				},
				{
					"id": 705060209,
					"content": "Ơ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060210
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 705060210,
					"content": "Đúng vậy. Cưng hiểu rõ đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060211
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705060211,
					"content": "Tôi thấy cô lao lực quá nên muốn dẫn cô ra ngoài hóng gió thư thả chút thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060212
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705060212,
					"content": "Kết quả là đến quán rượu rồi mà cô vẫn cứ lo lắng công việc, đây mới là điều đáng quan ngại đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060213
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705060213,
					"content": "Đầu óc cứ luôn căng thẳng như vậy, có ngày mệt đến ngất xỉu luôn cho mà xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060214
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705060214,
					"content": "Đúng vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705060215
					]
				},
				{
					"id": 705060215,
					"content": "#{NICKNAME} cũng nghĩ như vậy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060216
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 705060216,
					"content": "Ừm, vậy thì... học cách nghỉ ngơi mới là thử thách lớn nhất mà tôi cần phải vượt qua đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060217
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 705060217,
					"content": "Tục ngữ Liyue có câu: \"Mọi thứ đều cần có sự cân bằng\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705060218
					]
				},
				{
					"id": 705060218,
					"content": "Đúng đó! Trong giờ làm thì nên làm, trong giờ nghỉ thì nên nghỉ. Đơn giản mà nói thì Jean cần phải làm ít nghỉ nhiều hơn đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705060219,
					"content": "Nói năng lung tung quá...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705060220
					]
				},
				{
					"id": 705060220,
					"content": "Hì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060221
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705060221,
					"content": "Tôi hiểu rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060222
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 705060222,
					"content": "Cảm ơn mọi người. Tâm trạng của tôi cũng được thả lỏng hơn nhiều rồi, đây chính là nguyên nhân khiến cho Lisa và Kaeya thường xuyên đến quán rượu sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060223
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 705060223,
					"content": "Đúng, mà cũng không đúng, còn phải xem người pha chế là ai nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060224
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705060224,
					"content": "Hôm nay, may mà nhờ có bé cưng mới khuyên được Jean đấy, cưng quả là có khiếu ăn nói mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060225,
						705060226
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705060225,
					"content": "Có gì đâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705060227
					]
				},
				{
					"id": 705060227,
					"content": "Haha, vậy chúng tôi đi trước đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060228
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705060228,
					"content": "Từ nay nếu có cơ hội thì tôi sẽ suy nghĩ đến việc đến đây thư giãn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060229
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 705060229,
					"content": "Hay quá, hai người đi thong thả nha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705060226,
					"content": "Giúp được mọi người là được rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705060227
					]
				}
			]
		}
	]
}