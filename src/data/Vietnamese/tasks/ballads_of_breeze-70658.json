			"dialogs": [
				{
					"id": 706580101,
					"content": "Xin chào, bạn có tận hưởng Lễ Hội Hoa Gió không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706580102,
						706580103
					],
					"speakerTitle": "Lizz"
				},
				{
					"id": 706580102,
					"content": "Xin cám ơn bạn đã giới thiệu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706580104
					]
				},
				{
					"id": 706580104,
					"content": "Hì hì, vậy tôi còn có một hoạt động khá nhẹ nhàng, tên của nó là \"Bài Ca Của Gió\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706580105
					],
					"speakerTitle": "Lizz"
				},
				{
					"id": 706580105,
					"content": "Chắc bạn đã từng gặp nhà thơ ở Mondstadt rồi, tham gia hoạt động này, bạn sẽ giống như họ biểu diễn những khúc nhạc hay!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706580106
					],
					"speakerTitle": "Lizz"
				},
				{
					"id": 706580106,
					"content": "Trên núi cao, bên bờ hồ, cảm nhận hơi thở của gió, toàn tâm diễn tấu một khúc nhạc, nhất định sẽ giúp bạn quên hết mọi phiền não.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706580107,
						706580108
					],
					"speakerTitle": "Lizz"
				},
				{
					"id": 706580107,
					"content": "Chưa có kinh nghiệm ở mặt này...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706580109
					]
				},
				{
					"id": 706580109,
					"content": "Đừng lo, hoạt động này dành cho những người chưa có kinh nghiệm biểu diễn cũng có thể tận hưởng niềm vui trong âm nhạc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706580110
					],
					"speakerTitle": "Lizz"
				},
				{
					"id": 706580110,
					"content": "Chỉ cần theo kịp gợi ý, theo kịp nhịp điệu, những thứ còn lại đều không thành vấn đề.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706580111,
						706580112
					],
					"speakerTitle": "Lizz"
				},
				{
					"id": 706580111,
					"content": "Vậy tôi yên tâm rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706580113
					]
				},
				{
					"id": 706580113,
					"content": "Ừm ừm, chúc bạn có trải nghiệm vui vẻ trong Lễ Hội Hoa Gió!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lizz"
				},
				{
					"id": 706580112,
					"content": "Tôi sẽ đi thử xem.",
