			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110440141,
					"content": "Tôi về rồi, hai người có thấy thứ gì thú vị không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440142,
						110440144
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440142,
					"content": "Đọc không hiểu gì hết.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440143
					]
				},
				{
					"id": 110440143,
					"content": "Không sao, chỉ là một số vật dụng dùng cho thuật giả kim thôi, không dùng trong sinh hoạt hằng ngày.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440146
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440146,
					"content": "Tranh thủ thời gian thực hiện nghiên cứu tiếp theo nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440101
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440101,
					"content": "Giữa các thế giới khác nhau có thể tồn tại sự khác biệt cực kỳ lớn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440102
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440102,
					"content": "Ví dụ, ở Teyvat, người có Vision sẽ có thể dùng sức mạnh nguyên tố.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440103
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440103,
					"content": "Nhưng cũng có thể tồn tại \"thế giới chỉ có một người dùng được sức mạnh nguyên tố\", hoặc \"thế giới mà ai cũng đều dùng được sức mạnh nguyên tố\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440104
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440104,
					"content": "#Vì vậy, {NICKNAME}, ngoài nguyên tố... thì {F#cô}{M#cậu} còn nắm giữ sức mạnh đặc biệt nào mà thế giới này không có không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440105
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440105,
					"content": "Hay là chỉ có thể dùng cách trước đây, dùng thực nghiệm để xác định.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440106,
						110440107
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440106,
					"content": "Lại phải đánh Slime hả?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440108
					]
				},
				{
					"id": 110440108,
					"content": "Không không, lần này sẽ không phức tạp thế nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440109
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440109,
					"content": "#Bên này có cái cột, {F#cô}{M#cậu} thử dùng sức mạnh ý chí đánh gãy nó xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440110,
						110440113
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440110,
					"content": "Xin lỗi, tôi không làm được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440111
					]
				},
				{
					"id": 110440111,
					"content": "Đã nghiêm túc thử qua chưa? Phải không... Ừm, không sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440112
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440112,
					"content": "Vậy mới bình thường chứ, sao tôi thấy anh có vẻ hơi thất vọng nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440116,
					"content": "#Đúng rồi, {F#cô}{M#cậu} đã từng thử dùng sức mạnh nguyên tố để nấu ăn chưa? Không phải xào nấu nha, mà là đặt sức mạnh nguyên tố vào thức ăn ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440117
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440117,
					"content": "Tôi rất tò mò rằng thức ăn có vì vậy mà ngon hơn không, hay là mùi vị thay đổi, thậm chí là... sinh sôi thêm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440118,
						110440119
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440118,
					"content": "Suy nghĩ của Giả Kim Thuật Sĩ quả là độc đáo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440120
					]
				},
				{
					"id": 110440120,
					"content": "Ha ha, đặt lòng hiếu kỳ vào những nơi mà bình thường người ta không để ý, sẽ dễ phát hiện được những điều bất ngờ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440121
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440121,
					"content": "Vậy nhờ hai người làm món \"Cá Áp Chảo\" nhé, đây là công thức nấu ăn mà tôi vừa chuẩn bị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440151
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440151,
					"content": "Còn nghĩ là anh đi chuẩn bị thứ gì quái lạ, ai ngờ là công thức hả?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440122,
					"content": "Tại vì bình thường tôi hay ăn món này, dù là thí nghiệm hay thưởng thức, thì nó cũng là lựa chọn rất tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440123
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440123,
					"content": "Tôi cá là anh đói rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440124,
					"content": "Nhưng nếu muốn nấu món gì ngon ngon thì tôi sẽ không phản đối đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440125,
						110440126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440125,
					"content": "Được được, hiểu rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440127
					]
				},
				{
					"id": 110440127,
					"content": "Ừm ừm, đúng là bạn bè hiểu nhau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440128,
					"content": "Vậy thì giao cho hai người đó, tôi rất mong chờ kết quả thí nghiệm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440130
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440130,
					"content": "Nếu chúng ta ăn không hết, thì có thể mời Timaeus ăn cùng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440131
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440131,
					"content": "Có tôi ở đây thì đừng lo chuyện đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440126,
					"content": "Không quên phần của bạn đâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440127
					]
				},
				{
					"id": 110440119,
					"content": "Chắc không phải do anh đói phải không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440120
					]
				},
				{
					"id": 110440113,
					"content": "Đánh gãy nó đi, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440114
					]
				},
				{
					"id": 110440114,
					"content": "Dù là bạn hay là tôi thì đều không làm được đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440115,
					"content": "Đã nghiêm túc thử qua chưa? Phải không... Ừm, không sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440116
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440107,
					"content": "Lại phải uống thuốc hả?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440108
					]
				},
				{
					"id": 110440144,
					"content": "Hơi lộn xộn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440145
					]
				},
				{
					"id": 110440145,
					"content": "Ừ, đồng ý, tôi cũng đang tìm thời gian để dọn dẹp, nhưng cứ hết thí nghiệm này đến thí nghiệm khác...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440146
					],
					"speakerTitle": "Albedo"
				}
			]
		},
		{
			"id": 1104403,
			"completionStepIds": [
				1104403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104403",
							"2"
						],
						"stepId": 1104403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110440320,
					"content": "Không ngờ mọi người có thể tìm được hết, vô cùng cảm ơn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440321
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440321,
					"content": "Tìm đồ vật, và lúc trước đến Núi Tuyết tìm tôi đều là dùng Góc Nhìn Nguyên Tố, đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440322
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440322,
					"content": "Đúng rồi, đây có phải là siêu năng lực không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440323,
					"content": "Có chút đáng tiếc, mặc dù \"Góc Nhìn Nguyên Tố\" tương đối hiếm, nhưng dù sao cũng là sức mạnh của đại lục Teyvat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440324
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440324,
					"content": "Chỉ có siêu năng lực dị giới chưa từng được nhắc đến, mới có thể giúp ích cho sự nghiên cứu của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440325
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440325,
					"content": "Có nghĩa là lại làm chuyện vô ích sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440326,
					"content": "Đừng chán nản, điều này nằm trong dự kiến của tôi, ngoài ra có thể thu hồi vật đã mất cũng là một thử nghiệm giá trị đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440301
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440301,
					"content": "Mọi người có thể nghĩ ra đồ thất lạc sẽ mang sức mạnh nguyên tố cũng là điều đáng khen rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440302
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440302,
					"content": "#Xong rồi, trước đây đều chỉ nghiên cứu về sự khác biệt tồn tại ở thế giới khác, còn đối với việc nghiên cứu thân phận loài người của {F#cô}{M#cậu}, thì bây giờ mới bắt đầu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440303,
						110440304
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440303,
					"content": "Đã sẵn sàng để theo đến cùng rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440305
					]
				},
				{
					"id": 110440305,
					"content": "Cơ thể con người khác nhau, tập trung ở năng lực trí tuệ và chức năng của cơ thể, chúng ta hãy bắt đầu từ chức năng của cơ thể nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440306
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440306,
					"content": "Từ đây nhìn ra, có thể thấy Sucrose đang làm gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440307
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440307,
					"content": "Không thể.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440308
					]
				},
				{
					"id": 110440308,
					"content": "#Nhưng nếu {F#cô}{M#cậu} nhảy lên từ mặt đất, nhảy đến vách núi bên kia, thì có thể thấy không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440309
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440309,
					"content": "Không thể.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440310
					]
				},
				{
					"id": 110440310,
					"content": "#Vậy nếu {F#cô}{M#cậu} đấm vỡ ngọn núi phía trước, thì có thể thấy không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440311,
						110440312
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440311,
					"content": "Không thể.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440313
					]
				},
				{
					"id": 110440313,
					"content": "Nếu vậy có lẽ phải hạ yêu cầu xuống. Thay vì hỏi, chúng ta nên làm thực nghiệm thì trực quan hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440314
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440314,
					"content": "Tôi biết một chỗ rất phù hợp với việc kiểm tra thể chất, đi theo tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440312,
					"content": "Tôi cảm thấy đây vẫn là thử nghiệm siêu năng lực.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440313
					]
				},
				{
					"id": 110440304,
					"content": "Cái này gọi là \"đâm lao thì phải theo lao\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440305
					]
				}
			]
		},
		{
			"id": 1104405,
			"completionStepIds": [
				1104405,
				1104416
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104416",
							"2"
						],
						"stepId": 1104416,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110440501,
					"content": "Ô, đều là những món bình thường nhưng rất ngon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440502
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440502,
					"content": "#Hiện tượng sinh sôi mà tôi kỳ vọng không xuất hiện, xem ra thế giới của {F#cô}{M#cậu} cũng không thể thoát khỏi sự cám dỗ của thức ăn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440503
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440503,
					"content": "#Không đúng, có thể là do quy luật thế giới hạn chế sức mạnh đặc biệt của {F#cô}{M#cậu}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440504
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440504,
					"content": "Đầu tiên không biết làm sao để đưa sức mạnh nguyên tố vào món ăn như cho gia vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440505,
					"content": "Không sao, ít ra chúng ta đã không lãng phí thức ăn, mọi người không cần phải ủ rũ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440506
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440506,
					"content": "Đây là phần đã hứa sẽ dành cho Paimon, cứ từ từ dùng, đem về cũng được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440507
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440507,
					"content": "Cảm ơn nhé, vì đã nhớ đến việc này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440508,
						110440509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440508,
					"content": "Anh tốt với Paimon quá.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440510
					]
				},
				{
					"id": 110440510,
					"content": "#Bởi vì tôi biết cô ấy là bạn tốt của {F#cô}{M#cậu}, trong quá trình thử nghiệm, cô ấy luôn nhắc nhở {F#cô}{M#cậu}, cũng rất lo lắng cho sự an toàn của {F#cô}{M#cậu}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440511
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440511,
					"content": "Nhưng việc nhắc nhở và lo lắng này có tác dụng gì hay không, thì phải thảo luận thêm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440512
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440512,
					"content": "Ê, đừng có nói xấu tôi đấy nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440513,
					"content": "Nhưng nếu anh mời tôi ăn ngon, tôi sẽ sẵn sàng tha thứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440514,
					"content": "Cũng không cần ngưỡng mộ quan hệ tốt của chúng tôi đâu, anh cũng có bạn bè kia mà, còn có học trò nữa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440515,
					"content": "...Ừm, đúng thế. Xem ra tôi cũng may mắn. Đừng nói việc này nữa, chúng ta hãy bắt đầu thí nghiệm tiếp theo nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440516
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440516,
					"content": "Đồ dùng dành cho thuật giả kim rất nhiều loại, làm sao để thu thập và cất giữ là một vấn đề hóc búa. Trước đây vì sơ ý, mà vật sưu tập của tôi bị thất lạc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440517
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440517,
					"content": "Mặc dù đã tìm lại được phần lớn, nhưng có một bình chiết nguyên tố Phong Tinh Điệp, và một hộp Bột Lôi Nguyên Bản, tìm mãi không thấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440518
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440518,
					"content": "Nấu cơm xong, việc tiếp theo là tìm đồ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440519,
					"content": "Không sao, tôi cũng định chế tạo lại, chỉ là nếu có thể tìm lại thì đỡ phiền phức hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440520
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440520,
					"content": "#Nếu {F#cô}{M#cậu} có siêu năng lực \"Xuyên Đêm\" hoặc \"Cảm Nhận Chấn Động\" thì việc tìm kiếm này dễ như trở bàn tay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440521
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440521,
					"content": "Món đồ chắc chắn rơi ở đâu đó trong những nơi mà hai người đã từng tham quan thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440522
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440522,
					"content": "Thế... đành thử xem sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440523
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440523,
					"content": "Những đồ vật bị mất dường như đều có sức mạnh nguyên tố.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440524
					]
				},
				{
					"id": 110440524,
					"content": "Đúng vậy! Có thể dùng Góc Nhìn Nguyên Tố!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440509,
					"content": "Rất ít người tốt với Paimon như vậy",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440510
					]
				}
			]
		},
