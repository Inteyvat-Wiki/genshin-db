			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 790460101,
					"content": "Diễn viên đã có mặt đủ, tất cả thiết bị vận hành bình thường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460102
					],
					"speakerTitle": "Loa Thông Báo"
				},
				{
					"id": 790460102,
					"content": "\"Ba Ngày Mơ Mộng Của Daiya\" - \"Ánh Nhìn Hóa Đá\" chính thức bắt đầu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460103
					],
					"speakerTitle": "Loa Thông Báo"
				},
				{
					"id": 790460103,
					"content": "Bên rìa rừng rậm, hai trí giả gan dạ có học thức đã phát hiện ra một Eidolon Thủy lạc lõng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460104
					],
					"speakerTitle": "Lời Dẫn Truyện Từ Loa"
				},
				{
					"id": 790460104,
					"content": "Ai giúp tôi với... tôi không muốn bỏ rơi đồng đội của mình...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460105
					],
					"speakerTitle": "Eidolon Thủy Lạc Lõng"
				},
				{
					"id": 790460105,
					"content": "Giọt Nước Nhỏ? Giọt Nước Nhỏ đang nói chuyện kìa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460106,
						790460107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790460106,
					"content": "Chỉ là chiếc loa đang nói hộ thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790460108
					]
				},
				{
					"id": 790460108,
					"content": "Ra là vậy, Giọt Nước Nhỏ này chắc là diễn viên quan trọng của vở kịch rồi, sẽ diễn chung với chúng ta sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790460109,
					"content": "Thật may mắn, hai trí giả sớm đã nghiên cứu ngôn ngữ của Eidolon Thủy, nên hiểu được lời cầu cứu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460110
					],
					"speakerTitle": "Lời Dẫn Truyện Từ Loa"
				},
				{
					"id": 790460110,
					"content": "Đây chính là định mệnh! Đúng là một cuộc gặp gỡ cảm động, sao có thể không giúp đỡ Eidolon Thủy chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460111
					],
					"speakerTitle": "Lời Dẫn Truyện Từ Loa"
				},
				{
					"id": 790460111,
					"content": "Chúng ta cũng có vai diễn sao? Lợi hại ghê!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460112,
						790460113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790460112,
					"content": "Vào vấn đề chính nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790460114
					]
				},
				{
					"id": 790460114,
					"content": "Chúng tôi... khi bị lạc trong rừng, đã tìm thấy một tòa lâu đài cổ. Sơ ý đánh thức bóng ma trong đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460115
					],
					"speakerTitle": "Eidolon Thủy Lạc Lõng"
				},
				{
					"id": 790460115,
					"content": "Hai tên thủ lĩnh trong đó đã... gán lời nguyền lên chúng tôi, rằng chỉ cần để bóng ma nhìn thấy là sẽ bị hóa thành đá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460116
					],
					"speakerTitle": "Eidolon Thủy Lạc Lõng"
				},
				{
					"id": 790460116,
					"content": "Khó khăn lắm tôi mới thoát ra được, nhưng bạn tôi đã...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460117
					],
					"speakerTitle": "Eidolon Thủy Lạc Lõng"
				},
				{
					"id": 790460117,
					"content": "Huhu... Họ chắc là rất đau đớn... đây là lỗi của chúng tôi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460118
					],
					"speakerTitle": "Eidolon Thủy Lạc Lõng"
				},
				{
					"id": 790460118,
					"content": "Đương nhiên không phải rồi, cho dù có cáu vì bị kêu dậy thì cũng không nên bắt nạt người khác chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790460119,
					"content": "Đáng ghét... Biến Giọt Nước Nhỏ lạc đường thành cục đá, đây không chỉ đơn giản là bắt nạt nữa rồi, đúng là xấu xa mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460120,
						790460121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790460120,
					"content": "Nếu xử lý chúng...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790460122
					]
				},
				{
					"id": 790460122,
					"content": "Không được, hai tên thủ lĩnh đó chưa bao giờ lộ diện. Lâu đài cũng rất lớn, dù giỏi đến mấy cũng không thể tìm ra chúng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460123
					],
					"speakerTitle": "Eidolon Thủy Lạc Lõng"
				},
				{
					"id": 790460123,
					"content": "Nhưng tôi nghe thấy một tên nói, là rương báu nằm sâu trong lâu đài có thuốc giải trừ lời nguyền. Đó chính là hy vọng duy nhất...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460124
					],
					"speakerTitle": "Eidolon Thủy Lạc Lõng"
				},
				{
					"id": 790460124,
					"content": "Rương báu bị khóa trong một căn phòng bí mật, cần phải tìm chìa khóa ở gần đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460125
					],
					"speakerTitle": "Eidolon Thủy Lạc Lõng"
				},
				{
					"id": 790460125,
					"content": "Nhưng tôi đã bị dính lời nguyền, nếu quay lại đó thì chắc chắn sẽ bị hóa đá và mãi mãi nằm im một chỗ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460126
					],
					"speakerTitle": "Eidolon Thủy Lạc Lõng"
				},
				{
					"id": 790460126,
					"content": "Cũng không có gì khó khăn! Chúng tôi sẽ đưa bạn quay về lâu đài để tìm thuốc giải.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790460127,
					"content": "Chỉ cần giúp bạn tránh khỏi... tầm nhìn của bóng ma kia là được đúng không? Cũng đâu khó lắm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790460128,
					"content": "Đúng rồi, các bạn là... trí giả, chắc sẽ có cách... Xin làm ơn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460129,
						790460130
					],
					"speakerTitle": "Eidolon Thủy Lạc Lõng"
				},
				{
					"id": 790460129,
					"content": "Paimon nhập vai nhanh thật.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790460131
					]
				},
				{
					"id": 790460131,
					"content": "Hihi, cũng đơn giản mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790460132,
					"content": "#Tuy không thể đánh kẻ chủ mưu, nhưng dọn dẹp bóng ma để cứu các Giọt Nước Nhỏ khác thì dễ mà. Đúng không {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790460133,
					"content": "Yên tâm nhé Giọt Nước Nhỏ. Chúng ta sẽ cùng nhau tìm thuốc để hóa giải lời nguyền và giải cứu đồng đội của bạn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790460130,
					"content": "Lại còn đoán được hướng cốt truyện nữa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790460131
					]
				},
				{
					"id": 790460121,
					"content": "Là sẽ cứu được đồng đội đúng không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790460122
					]
				},
				{
					"id": 790460113,
					"content": "Đồng đội của bạn bị sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790460114
					]
				},
				{
					"id": 790460107,
					"content": "Cứ coi như lời thoại của Giọt Nước Nhỏ đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790460108
					]
				}
			]
		},
