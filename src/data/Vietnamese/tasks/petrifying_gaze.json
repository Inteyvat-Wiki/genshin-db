					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 790461101,
					"content": "Lời dẫn truyện từ chiếc loa tiếp tục miêu tả lại khung cảnh thần kỳ trước mắt...\\nHai vị trí giả đem thuốc giải khẽ nhỏ lên tượng đá Eidolon Thủy, hiện tượng kỳ diệu đã xảy ra...\\nThời gian như bị đảo ngược, Eidolon Thủy đã hồi phục lại như ban đầu...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						790461102
					]
				},
				{
					"id": 790461102,
					"content": "Ôi... Cảm giác bị hóa đá toàn thân thật khó chịu. Không thể để đồng đội phải chịu đựng cảm giác này nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461103
					],
					"speakerTitle": "Eidolon Thủy Lạc Lõng"
				},
				{
					"id": 790461103,
					"content": "Giọt Nước Nhỏ cứ thế mà lao lên, làm sợ muốn chết! Cũng may chúng tôi lấy được thuốc giải đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461104,
					"content": "Khi nãy lũ bóng ma đó liên tục rên rỉ, tôi sợ quá không dám nói gì cả...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461105
					],
					"speakerTitle": "Eidolon Thủy Lạc Lõng"
				},
				{
					"id": 790461105,
					"content": "Hơn nữa hai bạn là trí giả, tôi cảm thấy không cần phải cảnh báo các bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461106
					],
					"speakerTitle": "Eidolon Thủy Lạc Lõng"
				},
				{
					"id": 790461106,
					"content": "Cho dù tôi bị biến thành đá, thì khi lấy được thuốc giải các bạn chắc chắn sẽ cứu tôi. Nên tôi không lo lắng nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461107
					],
					"speakerTitle": "Eidolon Thủy Lạc Lõng"
				},
				{
					"id": 790461107,
					"content": "Lẽ nào tôi đã quá nhập tâm sao? Chỉ mải lo lắng cho Giọt Nước Nhỏ thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461108,
						790461109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461108,
					"content": "Nhập tâm cũng tốt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790461110
					]
				},
				{
					"id": 790461110,
					"content": "Úi! Rõ ràng là khách đến đây chơi, thế mà lại tự mình diễn nhập tâm quá, ngại ghê...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461111,
					"content": "Tóm lại... chúng ta đã thành công, bây giờ bạn hãy đem thuốc giải đi cứu đồng đội của mình đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461112,
					"content": "Rất cảm ơn hai bạn, tôi... thực sự vô cùng cảm kích!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461113
					],
					"speakerTitle": "Eidolon Thủy Lạc Lõng"
				},
				{
					"id": 790461113,
					"content": "Tôi và các đồng đội sẽ luôn ghi nhớ ân tình này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461114,
						790461115
					],
					"speakerTitle": "Eidolon Thủy Lạc Lõng"
				},
				{
					"id": 790461114,
					"content": "Không có gì!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790461116
					]
				},
				{
					"id": 790461116,
					"content": "Cũng không biết những tên kia sẽ còn gây chuyện nữa không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461117,
					"content": "Sau này các bạn có vào rừng chơi thì nhớ phải cẩn thận hơn, đừng bén mảng tới lâu đài cổ này nữa nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461118,
					"content": "Thật đáng mừng! Kế sách hoàn hảo của hai vị trí giả và lòng dũng cảm của Eidolon Thủy đã phối hợp ăn ý, giải trừ lời nguyền của bóng ma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461119
					],
					"speakerTitle": "Lời Dẫn Truyện Từ Loa"
				},
				{
					"id": 790461119,
					"content": "Sự hiện diện của trí giả khiến cho bóng ma không còn dám làm loạn, Eidolon Thủy và các đồng đội lại có thể vô tư chơi đùa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461120
					],
					"speakerTitle": "Lời Dẫn Truyện Từ Loa"
				},
				{
					"id": 790461120,
					"content": "Rừng rậm vốn âm u quỷ dị, lại dần hiện ra vẻ yên tĩnh và thanh bình...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461121
					],
					"speakerTitle": "Lời Dẫn Truyện Từ Loa"
				},
				{
					"id": 790461121,
					"content": "\"Ánh Nhìn Hóa Đá\" kết thúc, xin cảm ơn quý vị đã theo dõi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461122
					],
					"speakerTitle": "Lời Dẫn Truyện Từ Loa"
				},
				{
					"id": 790461122,
					"content": "Được rồi, chúng ta đã hoàn thành xong \"Ánh Nhìn Hóa Đá\"! Cảm thấy rất tốt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461123,
					"content": "Xem ra lời thoại và dẫn truyện hợp lý đã ảnh hưởng không nhỏ tới cảm xúc của người xem... Daiya rốt cuộc đã học những phương pháp này ở đâu nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461124,
					"content": "Nếu có dịp được gặp Daiya, chúng ta phải hỏi rõ cô ấy mới được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461115,
					"content": "Đừng khách sáo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790461116
					]
				},
				{
					"id": 790461109,
					"content": "Chứng tỏ Paimon đang rất tận hưởng!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790461110
					]
				}
			]
