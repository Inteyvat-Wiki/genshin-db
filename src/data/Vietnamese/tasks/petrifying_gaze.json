			"dialogs": [
				{
					"id": 790461001,
					"content": "Đáng ghét, vậy thì sao mà né được chứ. Ăn gian!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461002,
					"content": "Muốn đá bay hết đống thiết bị này ghê!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461003,
					"content": "Đợi đã, Giọt Nước Nhỏ định làm gì vậy? Bên đó nguy hiểm lắm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461004
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461004,
					"content": "Kẻ ồn ào kia, ngươi điên rồi à? Hay là tuyệt vọng rồi, muốn gặp lại đồng đội của mình ở thế giới bên kia sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461005
					],
					"speakerTitle": "Thủ Lĩnh Bóng Ma Phẫn Nộ"
				},
				{
					"id": 790461005,
					"content": "Không, là dùng thân mình để che tầm nhìn sao... Sao lại đơn giản như vậy chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461006
					],
					"speakerTitle": "Thủ Lĩnh Bóng Ma Vui Vẻ"
				},
				{
					"id": 790461006,
					"content": "Thật bất ngờ! Eidolon Thủy lạc lõng đã chặn trước mặt bóng ma, dần dần hóa đá để chặn tầm nhìn chết người đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461007
					],
					"speakerTitle": "Lời Dẫn Truyện Từ Loa"
				},
				{
					"id": 790461007,
					"content": "Giọt Nước Nhỏ... đã chủ động biến thành đá... Chỉ vì chìa khóa thôi sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461008,
						790461009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461008,
					"content": "Giọt Nước Nhỏ vẫn có thể hồi phục!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790461010
					]
				},
				{
					"id": 790461010,
					"content": "Đúng! Chỉ cần không bị bóng ma nhìn quá lâu thì sẽ không sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461011
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461011,
					"content": "Giọt Nước Nhỏ đã lợi dụng điểm này sao? Thật là dũng cảm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461012
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461012,
					"content": "#{NICKNAME}, chúng ta mau đi tìm chìa khóa và thuốc giải đi, đừng để Giọt Nước Nhỏ phải chờ quá lâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461009,
					"content": "Chúng ta phải tranh thủ thời cơ!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790461010
					]
				}
			]
		},
		{
			"id": 7904611,
			"completionStepIds": [
				7904612
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7904612",
