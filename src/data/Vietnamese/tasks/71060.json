			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katarina"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710591101,
					"content": "Thế nào? Đến để quấy rầy tôi nghỉ ngơi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591102
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591102,
					"content": "Không có, chúng tôi thấy cô ở đây cô đơn một mình nên muốn trò chuyện cùng cô thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591103,
						710591104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710591103,
					"content": "Uống rượu một mình chán lắm đúng không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591105
					]
				},
				{
					"id": 710591105,
					"content": "...Vậy sao? Cảm ơn các bạn. Trông dáng vẻ của các bạn... làm tôi nhớ đến Lyudochka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591106
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591106,
					"content": "Cô ấy cũng là một người nhiệt tình... Lúc nào cũng luôn ở bên cạnh tôi, sẵn sàng nói với tôi bất cứ điều gì... Nhiều khi chỉ nói với tôi thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591107
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591107,
					"content": "Haiz, nếu Lyudochka cũng ở đây thì tốt quá... Cô ấy là một người rất thú vị, chắc chắn bạn sẽ thích cô ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591108,
						710591113
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591108,
					"content": "Lyudochka? Là ai?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591109
					]
				},
				{
					"id": 710591109,
					"content": "Cô ấy à... Là một người bạn của tôi, trông rất nghiêm túc, nhưng thật ra lại ngốc nghếch rất thú vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591110
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591110,
					"content": "Khi còn ở \"Căn Nhà Hơi Ấm\", chúng tôi tốt với nhau như chị em vậy... có lẽ còn hơn cả chị em nữa. Cô ấy rất thích tôi trêu đùa... Tôi thì được cô ấy chăm sóc rất tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591111
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591111,
					"content": "Haha, tóm lại, tôi có linh cảm rằng cô ấy đang sống một cuộc sống rất tốt. Cứ nghĩ đến điều này thì những vết thương mà tôi phải chịu ở nơi quỷ quái này chẳng đáng là gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591112
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591112,
					"content": "Mong là cô ấy cũng đang làm tốt nhiệm vụ của mình... Mong là cô ấy đừng nhớ đến tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591113,
					"content": "Lyudochka... Cô đang nói đến cô gái người Inazuma sao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591114
					]
				},
				{
					"id": 710591114,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591115
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591115,
					"content": "Nói vậy là cô ấy đã bị lộ rồi sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591116
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591116,
					"content": "Ơ... Sao cô biết...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591117,
						710591118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710591117,
					"content": "Cô ấy... đã trốn thoát rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591119
					]
				},
				{
					"id": 710591119,
					"content": "Vậy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591120
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591120,
					"content": "Haha... Vậy thì được, hy vọng cô ấy cũng đang làm tốt nhiệm vụ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591121
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591121,
					"content": "Nhưng nếu cô ấy tham sống sợ chết, chống lại ý muốn của Nữ Hoàng bệ hạ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591122
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591122,
					"content": "...Mong là cô ấy đừng nhớ đến tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591118,
					"content": "Cô ấy vẫn còn sống, và sống rất tốt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591119
					]
				},
				{
					"id": 710591104,
					"content": "Chúng tôi đến để nói chuyện với cô.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591105
					]
				}
			]
		},
