				"points": []
			},
			"dialogs": [
				{
					"id": 140180901,
					"content": "Có vẻ như tôi đã lo lắng quá nhiều rồi, tôi phải nhanh chóng phấn chấn lên và trở nên đáng tin cậy hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140180902
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140180902,
					"content": "Nhớ lại bộ dạng hôm nay thật có chút mất mặt, haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140180903,
						140180907,
						140180912
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140180903,
					"content": "Về món quà của mọi người...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140180904
					]
				},
				{
					"id": 140180904,
					"content": "Mỗi người đều có thứ mà đối với người khác là quá đỗi bình thường, nhưng dù thế nào đi nữa bản thân cũng không có được nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140180905
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140180905,
					"content": "Đối với tôi thì thứ đó chính là ảnh chụp gia đình. Từ nhỏ tôi đã rất ngưỡng mộ người khác...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140180906
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140180906,
					"content": "Không ngờ tôi lại nhận được nó theo hình thức này, xem ra có lúc tôi cũng may mắn đó chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Navia"
				},
				{
					"id": 140180907,
					"content": "Về mẹ cô, bà Clementine...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140180908
					]
				},
				{
					"id": 140180908,
					"content": "Tôi từng nghĩ rằng mẹ tôi muốn tôi sống một cuộc sống hạnh phúc, đó thực sự là một kỳ vọng rất cao... Thậm chí không thua kém những kỳ vọng mà cha tôi đã đặt ra cho tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140180909
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140180909,
					"content": "Dù hai người họ có tính cách hoàn toàn khác nhau, nhưng trong thâm tâm họ vẫn luôn công nhận nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140180910
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140180910,
					"content": "Tàu Luân Chuyển là một công trình lớn mang đến lợi ích cho toàn bộ Fontaine. Nếu dùng góc độ \"tổ chức\" để đo lường và đánh giá thì hơi hạn hẹp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140180911
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140180911,
					"content": "Cho nên bà ấy mới không ngăn cản cha tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Navia"
				},
				{
					"id": 140180912,
					"content": "Về chuyện xem nhau như cộng sự...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140180913
					]
				},
				{
					"id": 140180913,
					"content": "Ối, đừng nhắc lại nữa mà... Tôi ngại lắm đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140180914
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140180914,
					"content": "Mau quên đi, mau quên đi! À không đúng, không được quên...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140180915
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140180915,
					"content": "Tóm lại thì giữ trong lòng là được, đừng mang ra nói nữa nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Navia"
				}
			]
		}
	]
}