			"dialogs": [
				{
					"id": 710070101,
					"content": "Bạn vẽ thế nào rồi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710070102
					]
				},
				{
					"id": 710070102,
					"content": "Tôi vẫn luôn vẽ tranh ở bên cạnh hai bức tượng, từ khi mắt của chúng phát sáng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070103
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070103,
					"content": "Nhưng mà, nói sao nhỉ... tôi vẫn cảm thấy mình vẫn chưa vẽ được bức tranh hoàn hảo nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070104
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070104,
					"content": "Tôi luôn cảm thấy bức tranh của mình vẫn thiếu một cái gì đó... bạn có hiểu không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070105
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070105,
					"content": "Giống như một món ăn, bất kể là nguyên liệu hay là cách làm, tất cả đều rất tốt, nhưng... nhưng vẫn cảm thấy thiếu cái gì đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070106
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070106,
					"content": "Ôi, tôi cũng không biết diễn tả như thế nào, mà cũng không nắm bắt được cảm xúc, cho nên tôi chỉ có thể tiếp tục vẽ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070107
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070107,
					"content": "Hahaha, tôi cũng không ngại bạn chê cười, tôi vẽ đến nỗi đầu óc choáng váng, muốn nhắm mắt nghỉ ngơi một chút...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070108
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070108,
					"content": "Nhưng không hiểu sao, khi nhắm mắt lại, bỗng thấy trước mặt... mắt của hai bức tượng ấy lại sáng ngời. Như thể hai bức tượng ấy sống dậy, cứ nhìn chằm chằm vào tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070109
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070109,
					"content": "Tôi, tôi trở về đây, muốn nghỉ ngơi một chút, ở đây có lẽ không nhìn thấy mắt của hai bức tượng đó nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070110
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070110,
					"content": "Phải rồi, bạn hãy nhận lấy bức tranh này đi, đây là bức tranh đẹp nhất cho đến thời điểm hiện tại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070111
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070111,
					"content": "Bạn đừng để ý những lời tôi nói, chắc là tôi quá mệt rồi, nghỉ ngơi chút là được rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070112
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070112,
					"content": "Nhưng bức tranh của tôi còn thiếu cái gì, rốt cuộc là thiếu gì nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vermeer"
				}
			]
		}
	]
}