			"dialogs": [
				{
					"id": 741490201,
					"content": "Áo của Athos giá 1000 Mora... Vòng cổ của Morticia... Chậc, người trẻ bây giờ biết tiêu tiền thật đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490202
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490202,
					"content": "Xin chào, ngài Leroy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490203
					]
				},
				{
					"id": 741490203,
					"content": "Xin chào, chúng cháu được tiểu thư Euphrasie giới thiệu đến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490204,
					"content": "Các bạn kể cho ngài Leroy nghe mục đích đến đây.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741490205
					]
				},
				{
					"id": 741490205,
					"content": "Haha, chuyện này từ cách đây hơn nửa năm rồi mà Euphrasie vẫn còn giữ bức thư ủy thác của ta à.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490206
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490206,
					"content": "Đúng là ta từng có ý tưởng thuê người giúp việc. Dù một người lúc trẻ có giỏi giang đến mấy thì khi già vẫn cần người chăm sóc mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490207
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490207,
					"content": "Cả một đời ta vất vả kiếm được cả đống nhà cửa thế này, già rồi mới nhận ra mình rất cô đơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490208
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490208,
					"content": "Trước đây ta đúng là không thể chịu nổi chuyện này, may mà giờ đây có con gái và con rể đến chăm nom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490209
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490209,
					"content": "Hai đứa nó ngoan ngoãn và thân thiết lắm, có chúng bầu bạn thì ta không còn mong đợi gì hơn nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490210
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490210,
					"content": "Thế nên, người trẻ tuổi à, giờ ta không cần thuê người giúp việc nữa rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490211,
						741490212
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490211,
					"content": "Đúng là uổng công đi một chuyến thật...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490213
					]
				},
				{
					"id": 741490213,
					"content": "Cũng đừng thất vọng, ta ghét nhất là chứng kiến bộ dạng thất vọng của người trẻ. Người trẻ thì phải mỉm cười mà tận hưởng tất cả những thứ tốt đẹp chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490214
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490214,
					"content": "Dù sao cũng đến rồi, còn là do Euphrasie giới thiệu nữa, ta ở đây vẫn có mấy việc vặt nhờ các cháu làm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490215
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490215,
					"content": "Đúng lúc mấy đứa con của ta không có ở nhà, nên một mình ta làm không nổi. Tất nhiên ta vẫn sẽ trả tiền công.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490216
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490216,
					"content": "Chà, ngài Leroy đúng là người tốt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490217,
					"content": "Hahaha, rất biết nịnh đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490218
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490218,
					"content": "Đi đi, quét dọn giúp ta bụi bẩn trước cửa và sau nhà nhé... Nhân tiện lấy cho Nana ít cá luôn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490219
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490219,
					"content": "À, Nana là con mèo của ta, đang ở trước cửa kia kìa. Ta thay nó cảm ơn các cháu trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490220
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490220,
					"content": "Cũng đơn giản mà, cứ để đó bọn cháu lo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490212,
					"content": "Tiểu thư Euphrasie đúng là...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490213
					]
				}
			]
		},
