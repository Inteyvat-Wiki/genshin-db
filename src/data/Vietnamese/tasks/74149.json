			},
			"dialogs": [
				{
					"id": 741490101,
					"content": "Về công việc mới...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490102
					]
				},
				{
					"id": 741490102,
					"content": "Hửm? Coi bộ đối với hai vị đây thì ủy thác của \"Cuộc Sống Muôn Màu\" không có khó khăn gì nhỉ... Hay là dạo này cần thêm nhiều Mora sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490103,
						741490105
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490103,
					"content": "Mora không bao giờ là đủ cả.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490104
					]
				},
				{
					"id": 741490104,
					"content": "Ừm, suy nghĩ này cũng rất đúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490107
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490107,
					"content": "Chỗ này của tôi không thiếu công việc ủy thác. Ngoại trừ Hiệp Hội Nhà Mạo Hiểm thì Tòa Soạn Chim Hơi Nước hẳn là nơi tập trung nhiều thông tin thuê mướn nhất Đại Sảnh Fontaine rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490108
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490108,
					"content": "Mặc dù nói thẳng ra thì chúng tôi không cần phải gánh vác trọng trách của xã hội như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490109
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490109,
					"content": "Nói chung, nếu cần Mora thì tôi sẽ giới thiệu cho hai vị công việc lâu dài này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490110
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490110,
					"content": "Đây là bức thư do ngài Leroy gửi cho chuyên mục \"Cuộc Sống Muôn Màu\" chúng tôi từ hơn nửa năm trước. Ngài Leroy thì cả khu phố chúng tôi đều biết cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490111
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490111,
					"content": "Mặc dù thanh danh của ông ấy lúc trẻ không tốt cho lắm, nhưng mấy năm nay tôi không nghe được tin đồn xấu nào về ông ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490112
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490112,
					"content": "Ông ấy cô độc cả đời, người con gái duy nhất cũng không ở bên. Không có ai chăm sóc, nên cần một người giúp việc theo giờ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490113
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490113,
					"content": "Theo tôi biết thì ngài Leroy không thiếu Mora, nên thù lao chắc sẽ không thấp đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490114
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490114,
					"content": "Tôi nghĩ công việc này không có gì nguy hiểm cả, thù lao cũng tốt, nên có thể xem xét thử.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490115
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490115,
					"content": "Chỉ cần giúp việc nhà thôi hả? Nghe cũng rất ổn nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490116,
					"content": "Cho tôi xin địa chỉ liên hệ nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490117
					]
				},
				{
					"id": 741490117,
					"content": "Được thôi. Chỉ cần rẽ hai lần và đi vòng đến... À mà thôi, để tôi đưa bản đồ cho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490118
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490118,
					"content": "Nhớ nói với ông ấy là tôi giới thiệu hai vị qua ấy nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490105,
					"content": "Cả hai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490106
					]
				},
				{
					"id": 741490106,
					"content": "Đúng là người trẻ tuổi cầu tiến, được thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490107
					],
					"speakerTitle": "Euphrasie"
				}
			]
		},
