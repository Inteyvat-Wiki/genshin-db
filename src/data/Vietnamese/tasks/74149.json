			"dialogs": [
				{
					"id": 741490501,
					"content": "Các cháu làm xong rồi à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490502
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490502,
					"content": "Đúng vậy, thưa ngài Leroy. À ừm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490503,
					"content": "Muốn có kẹo hay muốn tiền công tiêu vặt đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490504
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490504,
					"content": "Cháu muốn cả hai, hihi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490505,
					"content": "Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490506
					]
				},
				{
					"id": 741490506,
					"content": "Đúng là tham lam mà, hahaha. Không sao, trẻ con là như thế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490507
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490507,
					"content": "Đặc biệt là đối với một cô bé đáng yêu như Paimon thì phải được ăn macaron, mặc váy xinh, sống trong ngôi nhà đẹp mới phải.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490508
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490508,
					"content": "#Cháu cũng thấy thế đó! {NICKNAME}, chúng ta liệu có thể mua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490509,
					"content": "Không.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490510
					]
				},
				{
					"id": 741490510,
					"content": "#Huhu, đáng ghét, đồ {NICKNAME} keo kiệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490511,
						741490512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490511,
					"content": "Paimon, chúng ta là nhà mạo hiểm mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490513
					]
				},
				{
					"id": 741490513,
					"content": "Thì cũng đâu liên quan gì với macaron, váy xinh và nhà lầu đâu đúng không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490514,
					"content": "Này, sao lại cãi nhau rồi? Nhưng mà cãi nhau như vậy cũng hay, chứng tỏ hai đứa vẫn còn trẻ tuổi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490515,
						741490516
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490515,
					"content": "Thực ra tuổi của cháu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490517
					]
				},
				{
					"id": 741490517,
					"content": "Tuổi thơ không có lâu đâu, phải quý trọng đấy nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490518
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490518,
					"content": "Được rồi, ta cho cả tiền công và đồ ngọt này, đừng cãi nhau nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490519
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490519,
					"content": "Hay quá! Cảm ơn ngài Leroy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490520,
					"content": "Gọi ta Benoit là được rồi, Leroy là họ của ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490521
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490521,
					"content": "Khắp Đại Sảnh Fontaine giờ đây chỉ còn một mình ta là họ Leroy. Gọi như vậy sẽ khiến lão già này cô đơn lắm, nên là cứ gọi thẳng tên đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490522
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490522,
					"content": "Con gái của ông Le... Benoit không mang họ Leroy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490523
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490523,
					"content": "Morticia không phải con gái ruột, mà chỉ là con gái nuôi từ nửa năm trước thôi. Nhưng đối với ta thì nó không khác gì con gái ruột cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490524
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490524,
					"content": "Các cháu nếu muốn gặp thì ngày mai có thể tới đây, khi đó Morticia và Athos cũng về đến rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490525
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490525,
					"content": "Nhờ hai đứa nhỏ đáng yêu làm chút việc nhà, ăn chút đồ ngọt, ta nghĩ Morticia sẽ không để tâm đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490526
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490526,
					"content": "Thỉnh thoảng cũng có những đứa trẻ khác đến chỗ ta, các cháu có thể chơi với nhau. Ta rất thích trẻ con, trong nhà có càng nhiều trẻ con thì càng vui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490527
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490527,
					"content": "Sau này lúc đến đây, nếu như không có ta thì các cháu cứ gõ cửa nhé, Athos sẽ ra đón.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490528
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490528,
					"content": "Dạ vâng, ngày mai chúng cháu sẽ quay lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490529
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490529,
					"content": "Được, ta cũng phải vào nhà đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490530
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490530,
					"content": "Ngày mai gặp lại.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490531
					]
				},
				{
					"id": 741490531,
					"content": "Chào nhé mấy đứa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490516,
					"content": "Đây là minh chứng cho một mối quan hệ tốt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490517
					]
				},
				{
					"id": 741490512,
					"content": "Paimon, đừng quên mục đích chính của chuyến hành trình chứ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490513
					]
				}
			]
		},
