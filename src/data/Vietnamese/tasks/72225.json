					"Ku"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722250301,
					"content": "Cây Cư Trú đang phát sáng kìa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250302
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722250302,
					"content": "Xem như đã hoàn thành việc cúng tế Cây Cư Trú rồi. Đúng là chẳng dễ dàng gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250303
					],
					"speakerTitle": "Ku"
				},
				{
					"id": 722250303,
					"content": "Hi hi, chúng tôi là chuyên gia giải quyết rắc rối đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722250304,
					"content": "Cũng không khác gì mấy so với \"Nghi Thức Dẫn Sáng\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250305
					]
				},
				{
					"id": 722250305,
					"content": "Muốn giải quyết một việc, phải đi giải quyết ba việc khác ở ba chỗ khác nhau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722250306,
					"content": "Tôi cảm thấy đi với bạn luôn gặp những chuyện như vậy thì phải!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722250307,
					"content": "Tuy em không hiểu mấy chuyện khác lắm, nhưng người lớn có một câu nói như thế này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250308
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722250308,
					"content": "Đó là \"lần thứ 3 định mệnh\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250309
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722250309,
					"content": "Lần thứ 3 định mệnh... là ý gì thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722250310,
					"content": "Ừm... đại khái là, bất kỳ chuyện gì cũng phải trải qua 3 lần thì mới có kết quả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250311
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722250311,
					"content": "Ví dụ như, điều may mắn phải xảy ra 3 lần thì điềm may thực sự mới xuất hiện. Còn điềm xấu xảy ra 3 lần thì chắc chắn sau đó sẽ còn chuyện tồi tệ hơn nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250312
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722250312,
					"content": "Họ cũng nói rằng, làm việc gì cũng vậy, phải qua ba lần khó khăn thì lần thứ tư mới thành công được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250313
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722250313,
					"content": "Ủa nếu vậy thì phải là \"lần thứ 4 định mệnh\" mới đúng chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722250314,
					"content": "Cũng đúng ha! Paimon giỏi toán ghê!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250315
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722250315,
					"content": "Hi hi, đương nhiên rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250316,
						722250318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722250316,
					"content": "Vậy quan trọng là phải tính toán à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250317
					]
				},
				{
					"id": 722250317,
					"content": "À mà, vết thương của Ku không sao chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722250319,
					"content": "Đừng lo. Lúc nào anh Ku cũng vậy đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250320
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722250320,
					"content": "Xấu hổ thật... hi vọng sẽ không làm ảnh hưởng đến tế lễ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250321
					],
					"speakerTitle": "Ku"
				},
				{
					"id": 722250321,
					"content": "Nếu không thì thật có lỗi với Ruu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250322
					],
					"speakerTitle": "Ku"
				},
				{
					"id": 722250322,
					"content": "Không đâu, anh Ku lúc nào cũng tốt với em mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250323
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722250323,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250324
					],
					"speakerTitle": "Ku"
				},
				{
					"id": 722250324,
					"content": "#{F#Chị}{M#Anh} {NICKNAME}, Paimon, mọi người đi trước đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250325
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722250325,
					"content": "Em ngồi với anh Ku một chút rồi thu xếp việc cúng tế ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722250318,
					"content": "Vết thương của Ku...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250319
					]
				}
			]
