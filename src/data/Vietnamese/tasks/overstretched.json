				"points": []
			},
			"dialogs": [
				{
					"id": 210033001,
					"content": "Vậy phải làm sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033002
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033002,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210033003
					]
				},
				{
					"id": 210033003,
					"content": "Hửm? Bạn là ai? Tất cả những ai ra vào cầu đều phải khám xét, bạn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033004
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033004,
					"content": "Nhìn bộ dạng ăn mặc của bạn chắc cũng không phải người xấu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033005
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033005,
					"content": "Vì sao ư... Bạn nghĩ xem, nếu muốn làm việc xấu nhất định sẽ cố tỏ ra bình thường chứ? Làm gì có ai ăn mặc lố lăng như bạn để người khác để ý...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033015
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033015,
					"content": "Bạn ở đây làm gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033006
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033006,
					"content": "Tôi chính là \"Thiên Nham Quân\" phụ trách canh giữ khu vực này. Nơi đây là tuyến đường giao thông huyết mạch của Địch Hoa Châu, tôi được cử đến đây để bảo vệ người dân và thương nhân đi qua khu vực này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033007
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033007,
					"content": "Mấy ngày trước, tôi phát hiện ra một đám quái vật... Chúng dường như đang cố ý thiết lập doanh trại ở đây, trước mắt tuy không có động tĩnh gì đáng ngờ thế nhưng vì sự an toàn tôi vẫn phải chú ý đến chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033008
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033008,
					"content": "Mặc dù rất muốn ra tay xử lý bọn chúng, nhưng rất sợ có quái vật khác tấn công người qua đường trong lúc tôi rời đi, chính vì vậy chỉ có thể đứng canh gác tại khu vực này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033009
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033009,
					"content": "Đã tiêu diệt toàn bộ đám quái vật rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210033010
					]
				},
				{
					"id": 210033010,
					"content": "Bạn đã xử lý xong rồi ư? Trời ơi... Vậy thì tốt quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033011
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033011,
					"content": "Bạn vất vả rồi, thật là ngại quá đáng lẽ ra là công việc của tôi lại phải đi nhờ bạn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033012
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033012,
					"content": "Haizz cũng không biết vì sao cấp trên không cử thêm người đến, chỉ cử một mình tôi đến đây thì làm sao lo được hết được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033013
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033013,
					"content": "Tôi nhất định phải báo cáo chuyện này lên cấp trên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033014
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033014,
					"content": "Cám ơn bạn, đây là quà cảm ơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qiaoxi"
				}
			]
		},
