					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210039904,
					"content": "...Bạn không cần phải giấu, nhìn vết bùn lấm lem trên người tôi đoán chắc bạn vừa đánh nhau với đám quái vật đằng kia phải không.",
					"roleType": "TALK_ROLE_NPC",
