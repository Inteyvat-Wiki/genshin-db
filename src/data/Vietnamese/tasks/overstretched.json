				},
				{
					"id": 210039902,
					"content": "Ừm, giải quyết xong rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210039903
					]
				},
				{
					"id": 210039903,
					"content": "Thật vất vả cho bạn, đúng là ngại quá đáng lẽ ra là công việc của tôi lại phải đi nhờ bạn...",
					"roleType": "TALK_ROLE_NPC",
