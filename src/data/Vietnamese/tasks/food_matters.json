			"dialogs": [
				{
					"id": 766670301,
					"content": "Để tôi giúp chuẩn bị thêm cho.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766670302
					]
				},
				{
					"id": 766670302,
					"content": "#{F#Cô}{M#Cậu}... đồng ý giúp tôi sao? Cảm ơn, cảm ơn nhiều lắm! Vậy... phiền {F#cô}{M#cậu} giúp tôi hái <color=#00E1FFFF>5 Quả Lakka</color> nhé, chừng đó là đủ rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670303
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670303,
					"content": "#Sau khi mang về, tôi nhất định sẽ làm cho {F#cô}{M#cậu} phần Tiệc Ánh Trăng ngon nhất!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lyylikki"
				}
			]
		},
