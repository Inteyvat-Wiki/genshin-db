			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lyylikki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 766670101,
					"content": "Hic... Sớm biết thế thì đã chuẩn bị nhiều Quả Lakka hơn rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670102,
						766670103
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670102,
					"content": "(Lần trước, khi Lauma ở đây...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766670104
					]
				},
				{
					"id": 766670104,
					"content": "#Chào {NICKNAME}, {F#cô}{M#cậu} đến để nhận Tiệc Ánh Trăng à? Xin lỗi, cần phải đợi một chút rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670105
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670105,
					"content": "Tiệc Ánh Trăng là gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766670106
					]
				},
				{
					"id": 766670106,
					"content": "#Ơ? Lần trước không phải {F#cô}{M#cậu} đã nhận rồi sao... À, lần trước là do Lauma chủ trì, có vẻ chưa nói cho {F#cô}{M#cậu} biết tên chính thức của loại thức ăn này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670107
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670107,
					"content": "Nói một cách đơn giản, Tiệc Ánh Trăng là thức ăn miễn phí mà Dòng Dõi Sương Nguyệt chúng tôi phát cho những người có nhu cầu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670108
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670108,
					"content": "Dòng Dõi Sương Nguyệt chúng tôi vốn có truyền thống tiếp tế cho những người cần hỗ trợ, ban đầu chỉ giới hạn ở khu vực xung quanh Đảo Hiisi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670109
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670109,
					"content": "Nhưng dưới sự dẫn dắt của Lauma và sự nỗ lực của mọi người, chúng tôi cũng dần mở rộng phạm vi phát Tiệc Ánh Trăng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670110
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670110,
					"content": "Lauma nói rằng đây cũng là để mang phước lành của Nguyệt Thần đến cho mọi người. Chính là câu nói... ừm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670111
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670111,
					"content": "\"Loại quả hái được đầu tiên này phải đặt ở Tế Đàn Ánh Trăng. Đây không phải để dâng lên cho thần linh, mà là để giữ lại...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670112
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670112,
					"content": "\"Giữ lại...\" Giữ lại gì nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670113
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670113,
					"content": "Khụ, tóm lại, cửa tiệm này là một trong những địa điểm chính để phát Tiệc Ánh Trăng. Haha, hầu như là một mình tôi quản lý nơi này đấy, giỏi không nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670114
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670114,
					"content": "Tuy việc phát Tiệc Ánh Trăng ở Thị Trấn Nasha gặp nhiều khó khăn... Nhưng tôi tin vào lời của Lauma, làm như vậy chắc chắn sẽ giúp được nhiều người cần giúp đỡ hơn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670115
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670115,
					"content": "Tuy nhiên... Hôm qua lúc chuẩn bị nguyên liệu tôi quên đóng chặt nắp thùng, sáng dậy thì thấy có rất nhiều quả bị chim mổ hỏng mất, không thể dùng được nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670116
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670116,
					"content": "Số Quả Lakka còn lại vốn không thể làm được thêm bao nhiêu Tiệc Ánh Trăng nữa... Giờ phải làm sao đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670103,
					"content": "(Hình như là đang phát đồ ăn...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766670104
					]
				}
			]
		},
