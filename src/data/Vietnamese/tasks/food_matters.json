					"nextDialogs": [
						766670403
					]
				},
				{
					"id": 766670403,
					"content": "#Xong rồi đây, mời {F#cô}{M#cậu} dùng thử nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670404
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670404,
					"content": "#Một lần nữa cảm ơn sự giúp đỡ của {F#cô}{M#cậu}, lần sau nếu đói bụng thì cứ ghé qua đây, tôi sẽ chuẩn bị riêng cho {F#cô}{M#cậu} một phần.",
					"roleType": "TALK_ROLE_NPC",
