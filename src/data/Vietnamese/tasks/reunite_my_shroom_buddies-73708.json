			"dialogs": [
				{
					"id": 737080201,
					"content": "Xem ra lời nhắn được truyền đạt rất thuận lợi đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080202
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080202,
					"content": "Cuối cùng cũng gặp lại nhau rồi, Sao Băng Vàng và Ngôi Sao Bạc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080203
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080203,
					"content": "Vẻ mặt rạng rỡ của hai người khiến tôi cảm thấy thời gian như ngừng trôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080204,
						737080208
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080204,
					"content": "Lâu lắm rồi không gặp đấy, Haniyyah!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080205
					]
				},
				{
					"id": 737080205,
					"content": "Là Haniyyah và Nón Trống Tròn thật này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080206,
					"content": "Chẳng trách đọc lời nhắn mà tôi cứ thấy quen quen... Chứng tỏ là tôi với Nón Trống Tròn vẫn còn ăn ý lắm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080207,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080212
					],
					"speakerTitle": "Nón Trống Tròn"
				},
				{
					"id": 737080212,
					"content": "Tôi đã tưởng tượng ra nhiều kịch bản trùng phùng lắm, như tổ chức tiệc linh đình, hay tiệc chào đón đầy sáng tạo, để cho hai người một bất ngờ thật lớn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080213
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080213,
					"content": "Nhưng lại thấy hơi khách sáo. Hai người vốn đã bận rộn, biết đâu chiếm quá nhiều thời gian lại khiến hai người thấy phiền.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080214
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080214,
					"content": "Hơn nữa, các Nấm Quỷ bây giờ cũng thích môi trường yên tĩnh, nên chúng ta hãy gặp lại nhau theo cách tự nhiên và thoải mái nhất nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080215
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080215,
					"content": "Đúng thế đúng thế, những bài văn xuôi Haniyyah từng đọc giờ đã phát huy tác dụng rồi, giữ tâm trạng bình tĩnh tốt cho cuộc sống!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080216
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 737080216,
					"content": "Cứ thoải mái trò chuyện thế này là vui nhất rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080217
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 737080217,
					"content": "♫~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080218
					],
					"speakerTitle": "Ngọn Lửa Hân Hoan"
				},
				{
					"id": 737080218,
					"content": "Cô Souka cũng ở đây nữa, cả Ngọn Lửa Hân Hoan luôn. Còn... đây là?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080219,
					"content": "Đồng đội Nấm Quỷ của tôi, Vũ Công Gió. Hồi đó ở vòng đấu top 32, đã bị hai người và Nón Trống Tròn đánh bại trong chốc lát!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080220
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 737080220,
					"content": "Ôi, cô nhớ rõ thật đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080221,
						737080222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080221,
					"content": "Cảm giác quen thuộc dần quay lại rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080223
					]
				},
				{
					"id": 737080223,
					"content": "Tóm lại, hai người thấy đấy, chúng ta không cần hẹn gặp lại nhau vào lúc nào hay ở đâu nữa rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080224
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 737080224,
					"content": "Haniyyah và tôi đã mua lại cả khu thương mại này, cải tạo nó thành \"Công Viên Nấm Nhỏ\" luôn luôn mở cửa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080225
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 737080225,
					"content": "Khoan đã, nghĩa là cơ sở vật chất ở đây không phải cho thuê để làm trò chơi trên bàn mới, mà là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080226,
					"content": "Đúng vậy, từ giờ chúng tôi sẽ sống tại Cảng Bayda, quảng bá trò chơi trên bàn về Nấm Quỷ, cũng như lý thuyết giao tiếp với động vật cho mọi người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080227
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080227,
					"content": "Nếu rảnh, hai người cứ thoải mái đến đây chơi với các Nấm Quỷ nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080228
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080228,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080229,
						737080230
					],
					"speakerTitle": "Nón Trống Tròn"
				},
				{
					"id": 737080229,
					"content": "Tuyệt vời! Đồng đội Nấm Quỷ!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080231
					]
				},
				{
					"id": 737080231,
					"content": "Đây... Đây là một trong những tin tuyệt vời nhất mà hôm nay tôi được nghe đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080232,
					"content": "Sau lần cuộc thi Nấm Quỷ đầu tiên, tôi đã nghĩ ra rất nhiều... ý tưởng để chơi cùng Nón Trống Tròn, giờ có thể từ từ thực hiện rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080233,
					"content": "Kể ra thì chi phí ở đây không rẻ đâu nhỉ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080234
					]
				},
				{
					"id": 737080234,
					"content": "Yên tâm đi, giờ thì Mora không phải là vấn đề nữa rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080235
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 737080235,
					"content": "Trong thời gian này, nhờ sự giúp đỡ của anh Balfour, ngoài việc vận hành trò chơi trên bàn như Kỳ Trận Nấm Linh và Đấu Nấm Chiến Thuật để kiếm tiền...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080236
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080236,
					"content": "Chúng tôi còn tổng hợp kinh nghiệm trước đây, hệ thống hóa kiến thức huấn luyện thú và Nấm Quỷ thành lý thuyết, rồi thử xuất bản vài cuốn sách.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080237
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080237,
					"content": "Thậm chí, còn có vài học giả tài trợ cho tôi nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080238
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080238,
					"content": "Dùng kiến thức tích lũy được để mang đến sự tiện lợi cho mọi người, đổi lấy Mora, giúp các Nấm Quỷ có cuộc sống tốt hơn. Mọi thứ đều đã đi vào vòng tuần hoàn tích cực.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080239
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080239,
					"content": "Lợi, lợi hại thật đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080240
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080240,
					"content": "Cảm giác như Haniyyah đã trở thành chuyên gia lý luận luyện thú vững vàng, có thể giải quyết mọi vấn đề một cách gọn gàng rồi đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080241
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080241,
					"content": "May nhờ có Souka chỉ dẫn đấy. Cô ấy đã để tôi làm theo cách của các học sinh, tự thử thách những kỹ năng mình nên học.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080242
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080242,
					"content": "Thôi nào! Đừng có học cái tính khiêm tốn đấy chứ, tôi có phải giáo viên giỏi giang gì đâu, khen thì cứ nhận đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080243,
						737080244
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 737080243,
					"content": "Nói thì dễ vậy thôi, chứ chắc cũng khó khăn lắm hả?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080245
					]
				},
				{
					"id": 737080245,
					"content": "Đúng là đã gặp rất nhiều khó khăn, nhưng đều đã qua rồi. Những chuyện không hay thì cứ để chúng trôi qua cùng thời gian thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080246
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080246,
					"content": "Điều làm tôi tiếc nuối nhất là suốt một năm qua đã không đưa các Nấm Quỷ ra ngoài chơi thật vui vẻ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080247
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080247,
					"content": "Từ khi bắt đầu tổng hợp lý luận luyện thú, phần lớn thời gian chúng tôi đều ở trong hang động và nhà cây, sống cuộc sống viết lách ngày đêm hỗn loạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080248
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080248,
					"content": "Cuộc sống công việc mệt mỏi quá, những ngày gấp rút viết bản thảo cũng thật khó khăn, giờ thì tôi đã hiểu suy nghĩ của Souka hơn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080249
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080249,
					"content": "Cũng không phải toàn là phản hồi tiêu cực đâu! Khoảnh khắc viết xong vẫn có cảm giác thành tựu tuyệt vời mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080250
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 737080250,
					"content": "Ừm, tôi đồng ý. Mỗi lần viết xong đều xứng đáng ăn một bữa thỏa thích để chúc mừng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080251
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080251,
					"content": "Nhưng mà các Nấm Quỷ lại không thể thưởng thức đồ ăn của chúng ta. Có lẽ trong mắt chúng, cuộc sống ngày càng nhàm chán.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080252
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080252,
					"content": "Nếu cứ như vậy, tình hình tinh thần của chúng cũng sẽ xấu đi, không ổn chút nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080253
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080253,
					"content": "Vậy nếu giờ tình hình của mọi người đã ổn định rồi, còn có chỗ ở cố định nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080254
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080254,
					"content": "Thực ra hai chúng tôi có thể dẫn các Nấm Quỷ đi chơi thỏa thích rồi đưa về sau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080255
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080255,
					"content": "Vậy thì hai người sẽ có thể tập trung làm việc, còn các Nấm Quỷ cũng được vui chơi thoải mái!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080256,
						737080257
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080256,
					"content": "Ý này của Paimon hay đấy!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080258
					]
				},
				{
					"id": 737080258,
					"content": "Tôi ủng hộ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080259
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 737080259,
					"content": "Nói đến chỗ đi chơi, tôi hoàn toàn là người theo trường phái lý luận, chỉ có thể tìm địa điểm từ trong sách. Lần đầu đến Fontaine, thật ra còn bị lạc đường nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080260
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 737080260,
					"content": "Haniyyah còn ngốc nghếch hơn, thậm chí còn không biết Sumeru có những nơi vui chơi nào, trước giờ chỉ mải lo làm việc thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080261
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 737080261,
					"content": "Lần trước ở Fontaine lâu như vậy mà cũng không sắp xếp được lịch trình ổn thỏa. Cuối cùng đến cả tiệm bánh ngọt muốn ghé cũng không đến được, lỡ mất món Macaron đã tò mò từ lâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080262
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 737080262,
					"content": "E hèm... Nếu là Sao Băng Vàng và Ngôi Sao Bạc, chắc chắn sẽ tìm được rất nhiều nơi tuyệt vời cho các Nấm Quỷ mở mang tầm mắt và vui chơi thỏa thích.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080263,
						737080264
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080263,
					"content": "Vậy thì tôi phải chọn địa điểm thật cẩn thận rồi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080265
					]
				},
				{
					"id": 737080265,
					"content": "Chờ chút, hãy mang theo chiếc máy ảnh nhỏ này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080266
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080266,
					"content": "Haniyyah lấy ra một chiếc máy ảnh trông rất bình thường và đặt lên đầu Nón Trống Tròn. Không ngờ Nón Trống Tròn lại đội chiếc máy ảnh rất vững vàng, xem ra là đã quen bay với chiếc máy ảnh trên đầu rồi...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						737080267
					]
				},
				{
					"id": 737080267,
					"content": "Dù trông rất bình thường, nhưng đây là món quà lưu niệm đặc biệt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080268
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080268,
					"content": "Nón Trống Tròn từng cứu con của một thương nhân lạc đường ở phía nam Rừng Apam. Thương nhân đó đã tặng Nón Trống Tròn rất nhiều quà để cảm ơn, trong đó có chiếc máy ảnh này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080269
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080269,
					"content": "Nón Trống Tròn rất thích những bức ảnh được chụp bằng chiếc máy này. Lần này đi chơi cũng có thể dùng nó để lưu lại kỷ niệm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080270
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080270,
					"content": "Tôi đã tìm chuyên gia thiết bị Helene, nhờ cô ấy đóng kín vỏ máy ảnh, để có thể hoạt động trong môi trường ẩm ướt mà Nón Trống Tròn yêu thích... thậm chí là ở dưới nước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080271
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080271,
					"content": "Vậy thì chiếc máy ảnh này cũng là một trong những biểu tượng vinh dự của Nón Trống Tròn rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080272,
						737080273
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080272,
					"content": "Nón Trống Tròn giỏi quá!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080274
					]
				},
				{
					"id": 737080274,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080275
					],
					"speakerTitle": "Nón Trống Tròn"
				},
				{
					"id": 737080275,
					"content": "#Còn chuyện chụp ảnh thì cứ yên tâm, tôi với {NICKNAME} cũng là chuyên gia mà! Thiết bị trông như thế nào không quan trọng, chụp đẹp là được rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080276
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080276,
					"content": "#{NICKNAME}, chúng ta chuẩn bị xong rồi thì xuất phát thôi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080277
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080277,
					"content": "Ngoài hành lý, còn có cả thức ăn đặc biệt dành cho các Nấm Quỷ nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080278
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080278,
					"content": "Đúng rồi, Paimon nhớ rõ quá. Hãy mang đủ Rau Câu Kỳ Diệu nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080279
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080279,
					"content": "Phiên bản cải tiến mới nhất có hương vị ngon hơn, lại còn dễ bảo quản. Dù ở trong môi trường nóng bức cũng không lo bị hỏng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080280
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080280,
					"content": "Cẩn thận, đừng cho các đồng đội ăn quá nhiều một lúc nhé, ăn nhiều quá không tốt đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080281
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 737080281,
					"content": "Hihi, tôi nhớ hết rồi, rau câu phải cất vào túi nhỏ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080282
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080282,
					"content": "Cứ chờ chúng tôi vui vẻ mang quà lưu niệm về nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080273,
					"content": "Làm tốt lắm, Nón Trống Tròn!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080274
					]
				},
				{
					"id": 737080264,
					"content": "Tôi sẽ chọn ra những nơi vừa vui vừa đẹp!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080265
					]
				},
				{
					"id": 737080257,
					"content": "Tôi cũng muốn dẫn Nấm Quỷ đi chơi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080258
					]
				},
				{
					"id": 737080244,
					"content": "Cảm giác như đã lược đi nhiều phần gian khổ rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080245
					]
				},
				{
					"id": 737080230,
					"content": "Sau này có thể gặp nhau thường xuyên rồi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080231
					]
				},
				{
					"id": 737080222,
					"content": "Không khí thân thiện khiến tôi thư giãn hơn hẳn...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080223
					]
				},
				{
					"id": 737080208,
					"content": "Tuy không nhớ rõ lắm, nhưng mà xin chào nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080209
					]
				},
				{
					"id": 737080209,
					"content": "Đúng là Haniyyah và Nón Trống Tròn này! Bạn bè mà chúng ta quen ở Giải Đấu Luyện Thú Cúp Nilotpala từ rất lâu rồi đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080210,
					"content": "Sau đó, tôi nhớ là chúng ta còn gặp nhau ở gần Cảng Ormos và cả Đại Sảnh Fontaine! Không ngờ đã qua lâu như vậy rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080211,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080212
					],
					"speakerTitle": "Nón Trống Tròn"
				}
			]
		},
