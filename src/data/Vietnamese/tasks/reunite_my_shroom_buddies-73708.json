			"dialogs": [
				{
					"id": 737080301,
					"content": "Phù... Cuối cùng cũng đến rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080302,
					"content": "Tuy đường xa, nhưng tôi nghĩ Đỉnh Teticpac đặc sắc ở Dòng Dõi Vườn Treo chắc chắn sẽ khiến các Nấm Quỷ thấy vô cùng mới mẻ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080303,
					"content": "Tôi có mấy bức tranh phong cảnh, có thể cho các Nấm Quỷ so sánh giữa bức tranh với cảnh vật trước mắt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080304,
					"content": "Nếu quan sát kỹ, đối chiếu hai thứ với nhau, rồi từ từ chú ý đến những chi tiết không mấy nổi bật, rồi thấy hứng thú... thì chứng tỏ nơi này rất phù hợp để chúng ta khám phá thêm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080305,
					"content": "♪♫！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080306
					],
					"speakerTitle": "Nón Trống Tròn"
				},
				{
					"id": 737080306,
					"content": "♫...♩?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080307,
						737080308
					],
					"speakerTitle": "Ngọn Lửa Hân Hoan"
				},
				{
					"id": 737080307,
					"content": "Còn có cách này sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080309
					]
				},
