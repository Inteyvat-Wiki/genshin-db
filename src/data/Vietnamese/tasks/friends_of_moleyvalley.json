			"dialogs": [
				{
					"id": 760240501,
					"content": "Tuy không hiểu tại sao, nhưng tóm lại là cứ đến bên cạnh cô bé trước...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760240502
					]
				},
				{
					"id": 760240502,
					"content": "#Phải cẩn thận với những con Chồn Đạo Bảo đó, chúng đã chiếm Thung Lũng Moley một thời gian rồi. Nếu bị chúng đánh trúng, {F#hai chị}{M#anh chị} cũng sẽ biến thành người không có bóng đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240503
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240503,
					"content": "Chồn Đạo Bảo? Đâu có Chồn Đạo Bảo đâu? Còn người không có bóng là gì...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240504,
					"content": "Woa! Cái máy đó là sao vậy? Có phải là Chồn Đạo Bảo đang điều khiển nó tấn công chúng ta không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240505,
					"content": "Chúng được người nuôi, nói không chừng còn thông minh hơn cả người. Chính vì thông minh hơn nên mới đuổi được đám to xác kia đi đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240506
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240506,
					"content": "Mấy tên to xác đó cũng đã thử rồi, nhưng đều thất bại. Nói là chỉ cần <color=#00E1FFFF>lấy đi lõi năng lượng</color> là được, nhưng luôn thất bại ở bước cuối cùng. Xem ra cũng không dễ như lời đồn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240507
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240507,
					"content": "#Hmm, vậy là chỉ cần lấy đi lõi năng lượng là có thể ngăn chặn Chồn Đạo Bảo đúng không? {NICKNAME}, hay là chúng ta thử xem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240508,
					"content": "Nếu mặc kệ không làm gì thì nguy hiểm quá, ở đây còn có cả trẻ con nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240509,
					"content": "Nếu đó là yêu cầu của Paimon thì đương nhiên không có vấn đề gì rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240510
					]
				},
				{
					"id": 760240510,
					"content": "Vậy em cứ trốn ở đây đã nhé... Đúng rồi, em tên là gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240511,
					"content": "Nhưng... không phải ai nhỏ nhất thì sẽ là em sao? ...Chị tên là Auni, chị nghĩ em nên gọi chị là chị Auni, nếu không thì sẽ không đúng đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240512
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240512,
					"content": "#À... Vấn đề xưng hô cứ để sau! {NICKNAME}, chúng ta đi ngăn chặn Chồn Đạo Bảo trước đã!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
