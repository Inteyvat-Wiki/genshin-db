					"speakerTitle": "Auni"
				},
				{
					"id": 760240802,
					"content": "Về Bang Ốc Biển...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240803
					]
				},
				{
					"id": 760240803,
					"content": "#{F#Chị}{M#Anh} cũng muốn gia nhập sao? Vậy hãy đi tìm anh Jurva nhé, anh ấy ở Speranza. Ừm, nếu cần bỏ phiếu thì Helka lại không có ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240804
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240804,
					"content": "Nhưng không sao, anh Jurva chắc chắn có cách khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240805,
					"content": "Về Chuột Chũi Khịt Khịt...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240806
					]
				},
				{
					"id": 760240806,
					"content": "Em đoán là vì chúng luôn sống cùng con người, nên một số hành vi cũng giống như con người. Chồn Đạo Bảo cũng vậy, nghe nói Saurian của Natlan cũng vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240807
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240807,
					"content": "Nhưng mà, thế này rốt cuộc là chuyện tốt hay xấu đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240808,
