						760241502
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760241502,
					"content": "Ra là Chuột Chũi Khịt Khịt à! Nhưng Auni làm sao phân biệt được chúng thế? Nhìn chúng giống hệt nhau mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760241503,
					"content": "Mỗi con đều có tính cách khác nhau! Ở chung lâu rồi sẽ biết thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241504
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760241504,
					"content": "Nhưng chúng đều có chung một thói quen xấu là ăn xin con người. Haiz, thật là những động vật đáng thương, nếu con người tuyệt chủng thì chúng phải sống sao đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241505
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760241505,
					"content": "...Loài người tuyệt chủng? Mà sau đó Chuột Chũi Khịt Khịt vẫn còn sống sao? Chắc là không đâu nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760241506,
					"content": "Chị Linnea đã nói động vật sẽ tuyệt chủng vì đủ loại lý do. Vậy thì con người đương nhiên cũng có thể sẽ tuyệt chủng, tại sao Paimon lại nghĩ là không thể chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241507,
						760241509
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760241507,
					"content": "#{F#Chị}{M#Anh} chắc sẽ sống lâu hơn chuột chũi một chút...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760241508
					]
				},
				{
					"id": 760241508,
					"content": "Nhưng như vậy cũng không trả lời được câu hỏi của Auni. Ừm, tình cảnh của loài người thật là nguy hiểm, có quá nhiều thứ đe dọa đến sự tồn vong của loài người...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760241512,
					"content": "Nhưng nếu cả nhà chuột chũi đều đã được tìm thấy, vậy ba con Chồn Đạo Bảo này nên xử lý thế nào đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760241513,
					"content": "Nếu không biết phải làm sao thì cứ giao cho người của Soái Hạm là được rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241514
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760241514,
					"content": "Rương báu! Hay là trong trường hợp này nên gọi là hối lộ nhỉ? Kệ đi, nếu đã là cho chúng ta thì cứ nhận thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760241515,
					"content": "#Nhìn dáng vẻ của chúng, chắc là đã biết lỗi rồi. {NICKNAME}, lần này tha cho chúng đi. Đương nhiên không phải là vì rương báu rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760241509,
					"content": "Nghe nói côn trùng đã tồn tại trước khi loài người xuất hiện...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760241510
					]
				},
				{
					"id": 760241510,
					"content": "Sau khi loài người tuyệt chủng thì chúng chắc vẫn sẽ còn đó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760241511
					]
				},
				{
					"id": 760241511,
					"content": "Lại còn thua cả côn trùng sao...? Có cảm giác không cam lòng đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241512
					],
					"speakerTitle": "Paimon"
				}
			]
