			"dialogs": [
				{
					"id": 760240601,
					"content": "Chắc là Đại Ca Chồn Đạo Bảo muốn học theo những tên to xác đó, muốn biến cả nhà Moley thành tay sai của bọn chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240602
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240602,
					"content": "Nhưng giống như đám người to xác đó, Đại Ca Chồn Đạo Bảo và đồng bọn cũng thất bại rồi. Dù Thung Lũng Moley có bị Chồn Đạo Bảo phá tan tành thì bọn họ cũng chỉ biết trốn trong hang mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240603,
						760240605
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240603,
					"content": "Cũng không thể yêu cầu quá nhiều với chuột chũi được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240604
					]
				},
				{
					"id": 760240604,
					"content": "Dù sao cũng chỉ là Chuột Chũi Khịt Khịt... Mà Chồn Đạo Bảo còn có vũ khí nguy hiểm nữa! Dù nghĩ thế nào đi nữa, Chồn Đạo Bảo biết điều khiển máy móc nguy hiểm như vậy cũng quá vô lý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240607,
					"content": "#Bây giờ Thung Lũng Moley lại thuộc về gia đình ông Moley rồi. Đây là số Mora đã hứa trước đó, cảm ơn {F#hai chị}{M#anh chị} đã giúp đỡ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240608
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240608,
					"content": "#Đúng rồi, cái này cũng cho {F#hai chị}{M#anh chị} luôn. Helka nói tác phẩm hư cấu thì đừng cho vào cuốn sổ nhỏ của chị ấy, nếu không sẽ không phân biệt được đâu là thật đâu là giả nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240609
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240609,
					"content": "Em thấy rõ ràng là không có vấn đề gì... Dù là giả nhưng bên trong vẫn có thật mà, đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240610
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240610,
					"content": "#{F#Chị}{M#Anh} {NICKNAME} và Paimon, vậy tạm biệt nhé. Nếu lần sau Đại Ca Chồn Đạo Bảo lại làm gì thì em sẽ lại tìm {F#hai chị}{M#anh chị} nhờ giúp đỡ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240611
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240611,
					"content": "#{NICKNAME}, xem ra chúng ta có uy tín ổn đấy chứ nhỉ, hihi. Nhưng tốt nhất là chúng đừng gây thêm chuyện gì nữa! Auni cũng phải cẩn thận đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240612,
					"content": "#Dạ, {F#chị}{M#anh} {NICKNAME} và Paimon cũng lên đường bình an nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240605,
					"content": "Lần này cũng dựa dẫm cả vào con người nhỉ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240606
					]
				},
				{
					"id": 760240606,
					"content": "Dù sao cũng chỉ là Chuột Chũi Khịt Khịt thôi... Mà nếu nghĩ theo hướng khác, Chồn Đạo Bảo biết điều khiển máy móc nguy hiểm vốn cũng là do con người. Con người giải quyết vấn đề của con người, rất hợp lý mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240607
					],
					"speakerTitle": "Paimon"
				}
			]
		},
