			"dialogs": [
				{
					"id": 760240401,
					"content": "Nói mới nhớ, vừa rồi để ý hướng Chồn Đạo Bảo chạy trốn hình như đều là về phía ngọn đồi nhỏ đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240402,
					"content": "Đúng vậy, đó cũng là thứ mà gã to xác huấn luyện Đại Ca Chồn Đạo Bảo và đồng bọn mang đến. Trước đây Đại Ca Chồn Đạo Bảo dùng nó để đánh những gã to xác đó đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240403,
						760240404
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240403,
					"content": "Thật khó tưởng tượng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240406
					]
				},
				{
					"id": 760240406,
					"content": "#Vậy thì đến ngọn đồi nhỏ đó điều tra xem sao, nhưng biết đâu Chồn Đạo Bảo sẽ mai phục ở đó. {NICKNAME} cũng phải cẩn thận nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240404,
					"content": "Đáng ghét thật, nếu như có mặt ở đó thì...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240405
					]
				},
				{
					"id": 760240405,
					"content": "#Định giúp chúng sao? ...Không đúng, không lẽ {NICKNAME} chỉ muốn hóng chuyện thôi à!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240406
					],
					"speakerTitle": "Paimon"
				}
			]
		},
