			"dialogs": [
				{
					"id": 760241501,
					"content": "Woa, là gia đình Moley! Ông, bố mẹ, Moley nhỏ và Moley tí hon... Còn có những con Moley khác nữa, không thiếu một ai.",
					"roleType": "TALK_ROLE_NPC",
