			"dialogs": [
				{
					"id": 760240101,
					"content": "Hừ, giờ thì bó tay chịu trói rồi nhỉ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240102,
					"content": "Đây là lần đầu tiên em nhìn thấy Đại Ca Chồn Đạo Bảo gần như vậy đó... Paimon cũng phải gọi nó là đại ca đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240115
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240115,
					"content": "Hả... Sao lại phải gọi tên trộm xấu xa đó là đại ca chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240118,
					"content": "Cũng phải, trẻ hư thì không xứng đáng làm đại ca. Cũng chẳng có ai đến dự đám tang... Mà chắc cũng không có tổ chức đám tang đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240132
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240132,
					"content": "Đúng rồi, trước đây Helka từng nói hình như có một số kẻ kỳ quặc thích ăn thịt lạ, trong đó có cả Chồn Đạo Bảo. Còn có người thích sưu tầm tiêu bản nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240133
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240133,
					"content": "Nghĩ như vậy thì dù làm tiêu bản hay là ăn luôn cũng đều chẳng cần phải tổ chức tang lễ nữa nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240134
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240134,
					"content": "Auni hình như đang nói những chuyện đáng sợ một cách thản nhiên đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240135,
					"content": "(Bộ dạng trông rất sợ hãi...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240136
					],
					"speakerTitle": "Đại Ca Chồn Đạo Bảo"
				},
				{
					"id": 760240136,
					"content": "Khoan đã, đừng có chạy mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240137,
					"content": "Ủa? Hình như không phải chạy trốn, mà là đang đợi chúng ta ở đằng kia sao? Chúng ta qua đó xem sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7602402,
