						"pointId": 360700011
					},
					{
						"sceneId": 3,
						"position": [
							1650.233,
							213.48,
							9657.646
						],
						"pointId": 360700069
					}
				]
			},
			"dialogs": [
				{
					"id": 760240201,
					"content": "#{F#Chị}{M#Anh} {NICKNAME} còn lợi hại hơn cả mấy tên to xác đó nữa. Hóa ra không phải cứ to con là mạnh nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240202
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240202,
					"content": "#Hihi, đúng chứ? {NICKNAME} tuy không cao to, nhưng dù đối phó với ma vật to hơn mình gấp mấy lần cũng dễ như trở bàn tay đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240203,
						760240205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240203,
					"content": "Đâu có, so với Paimon vẫn còn kém một bậc mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240204
					]
				},
				{
					"id": 760240204,
					"content": "#Ơ? Dù có khen tôi như vậy thì... Được rồi, lần sau có đồ ăn ngon, tôi sẽ chia cho {NICKNAME} phần nhiều hơn một chút!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240206,
					"content": "#Vậy {F#chị}{M#anh} {NICKNAME} chắc chắn có thể đuổi Đại Ca Chồn Đạo Bảo ra khỏi Thung Lũng Moley nhỉ? Đây đâu phải nhà của bọn chúng, vậy mà chúng lại khiến nơi này trở nên hỗn loạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240207
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240207,
					"content": "Đám tang lẽ ra phải tổ chức cũng không thể làm được, ông Moley chắc cũng bị chúng hại chết rồi. Nhưng dù có muốn tổ chức tang lễ mới thì cũng phải tìm được gia đình họ trước đã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240208
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240208,
					"content": "Hả?! Chồn Đạo Bảo lại... Mà tang lễ vừa nói đến ấy, lúc nãy chưa kịp hỏi, không lẽ thật sự có người muốn tổ chức tang lễ ở đây sao? Tại sao lại chọn nơi này...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240209,
					"content": "#Tất nhiên rồi. Em đã chuẩn bị xong xuôi hết cả, bài hát trong tang lễ cũng đã nghĩ xong. Nè, cho {F#hai chị}{M#anh chị} xem, nhưng phải nhỏ tiếng một chút nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240210
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240210,
					"content": "Auni từ trong túi lấy ra một hộp diêm nhỏ. Sau khi mở ra, trên một tấm vải lót hoa nhỏ là một con bọ cánh cứng màu sắc xinh đẹp đang nằm, xung quanh còn được trang trí bằng vài cánh hoa trắng...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760240211
					]
				},
				{
					"id": 760240211,
					"content": "Bởi vì cậu ấy đã yên nghỉ mãi mãi, nên phải tổ chức tang lễ cho cậu ấy. Nhưng nơi em chọn đã bị Chồn Đạo Bảo chiếm mất, chính là những gò đất nhỏ có gắn máy móc đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240212
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240212,
					"content": "Nếu gia đình ông Moley không chạy thoát thì chắc là đã chết rồi. Nhà của họ đã bị Chồn Đạo Bảo phá tan hoang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240213
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240213,
					"content": "#({NICKNAME} này, ông Moley mà Auni nhắc đến không lẽ là...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240214,
						760240216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240214,
					"content": "(Chắc là một con vật nhỏ nào đó thôi.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240215
					]
				},
				{
					"id": 760240215,
					"content": "(Ừm, tôi cũng nghĩ vậy. Có lẽ là người bạn động vật của em ấy.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240218,
					"content": "Hmm, nếu đã vậy, hay là chúng ta giúp Auni bắt con Chồn Đạo Bảo xấu xa đó đi! Còn về gia đình ông Moley... Đợi sau khi bắt được Chồn Đạo Bảo thì chúng ta cùng nhau đi tìm thử xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240219,
					"content": "#Woa, {F#chị}{M#anh} {NICKNAME} và Paimon tốt quá. Em mời mọi người đến dự tang lễ nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240220
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240220,
					"content": "Cái đó thì không cần đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240221,
					"content": "Thôi được. Vậy thì, kẹo điêu khắc đường đã mua lúc trước... Ơ, hết rồi à.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240222
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240222,
					"content": "#Tiền tiêu vặt anh Jurva cho vẫn còn. Ừm, vậy cho {F#hai chị}{M#anh chị} tiền tiêu vặt này, hãy tự đi mua kẹo điêu khắc đường mà ăn nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240223
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240223,
					"content": "Nhờ người khác giúp thì phải trả thù lao, còn phải nói cảm ơn nữa, như vậy mới đúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240224,
						760240226
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240224,
					"content": "Không ngờ Paimon lại đi giành kẹo của trẻ con...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240225
					]
				},
				{
					"id": 760240225,
					"content": "Sao lại nói như thể tôi là người xấu vậy chứ!? Nhưng Auni còn nhỏ tuổi mà lễ phép quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240227,
					"content": "Cảm ơn nhé. Nhưng Mora chỉ đủ cho mỗi người một cái kẹo điêu khắc đường thôi, có khen em nữa cũng không có thêm đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240228
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240228,
					"content": "Đúng là thực tế thật... À, chắc không chỉ có một con Chồn Đạo Bảo gây chuyện phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240229,
					"content": "Dạ. Con vừa chạy trốn không phải là Đại Ca Chồn Đạo Bảo em từng gặp. Nó có bao nhiêu đàn em thì em cũng không biết nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240230
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240230,
					"content": "Nhưng bên kia cũng có những cỗ máy bắn đạn như bên này, biết đâu có thể tìm thấy đàn em Chồn Đạo Bảo ở đó đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240231
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240231,
					"content": "#Được thôi, lần này không thể để Chồn Đạo Bảo chạy thoát nữa! {NICKNAME}, chúng ta đi dạy dỗ chúng đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240226,
					"content": "Auni lễ phép thật đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240227
					]
				},
				{
					"id": 760240216,
					"content": "(Có lẽ là người từng sống ở đây.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240217
					]
				},
				{
					"id": 760240217,
					"content": "(Ừm? Chỗ này trông không giống có người ở lâu dài... Tôi nghĩ có lẽ là người bạn động vật của Auni! Nhìn mà xem, em ấy còn tổ chức tang lễ cho bọ cánh cứng nữa mà.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240205,
					"content": "Đối phó với ma vật nhỏ cũng không nương tay mà!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240206
					]
				}
			]
		},
