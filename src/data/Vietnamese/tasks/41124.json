			},
			"dialogs": [
				{
					"id": 411240801,
					"content": "Bạn đã hạ gục hết đám Đạo Bảo Đoàn đó rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240802
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240802,
					"content": "Hạ gục hết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240803
					]
				},
				{
					"id": 411240803,
					"content": "Không hổ là người được vị tiên sinh đó chỉ đích danh, hiệu quả làm việc thực sự rất cao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240804
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240804,
					"content": "Đây là tiền công của bạn, mau nhận lấy, và hợp tác... à, hợp tác lần này rất vui vẻ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240805
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240805,
					"content": "Có thể trong tương lai chúng ta sẽ còn rất nhiều cơ hội hợp tác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				}
			]
		},
