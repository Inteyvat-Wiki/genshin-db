	"talks": [
		{
			"id": 4112402,
			"completionStepIds": [
				4112402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4112402",
							"2"
						],
						"stepId": 4112402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vile"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411240201,
					"content": "Ôi, các bạn cuối cùng cũng đến rồi, tôi đã đợi rất lâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240202
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240202,
					"content": "Bạn đợi tôi làm gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240203
					]
				},
				{
					"id": 411240203,
					"content": "Đừng có lạnh lùng như vậy, tôi có chuyện rất quan trọng muốn nhờ bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240204
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240204,
					"content": "Bạn cũng đã thấy những thiên thạch đó, mặc dù không có thiên thạch nào rơi vào thành Mondstadt, nhưng giờ đây vì để xử lý thiên thạch và các vấn đề liên quan trong ngoài thành Mondstadt, tất cả đã loạn cào cào rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240205
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240205,
					"content": "Nước trong hồ của thành Mondstadt đã bị khuấy đục, một số kẻ muốn thừa nước đục thả câu, chắc chắn sẽ không bỏ qua cơ hội này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240206,
						411240208
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240206,
					"content": "Ý của bạn là... Đạo Bảo Đoàn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240207
					]
				},
				{
					"id": 411240207,
					"content": "Ui da, quả là một nhà mạo hiểm nhạy bén trải qua nhiều trận chiến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240212
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240212,
					"content": "Mặc dù các kỵ sĩ Tây Phong đã tăng cường cảnh giác, nhưng vì phải hỗ trợ khu vực xung quanh, nên việc phòng thủ của thành Mondstadt vẫn còn rất nhiều sơ hở.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240213
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240213,
					"content": "Đám người Đạo Bảo Đoàn đó sẵn sàng vì tiền mà làm mọi chuyện này, chắc hẳn đã bắt đầu lên kế hoạch chuẩn bị lợi dụng sơ hở để vào thành \"kiếm một số tiền lớn\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240214,
						411240217
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240214,
					"content": "Vậy tôi có thể làm gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240215
					]
				},
				{
					"id": 411240215,
					"content": "Ui da, bạn đồng ý nhanh vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240216
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240216,
					"content": "Hahaha, xem ra cách đối phó mà vị tiên sinh ấy nói với tôi không cần dùng đến nữa rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240222
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240222,
					"content": "Phải rồi, đơn giản mà nói... thành viên của Đạo Bảo Đoàn đến do thám xung quanh thành Mondstadt, đã bị vị tiên sinh đó hạ gục.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240223
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240223,
					"content": "Dựa theo những gì chúng khai ra, có khoảng ba nhóm Đạo Bảo Đoàn đang có ý định thừa nước đục thả câu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240224
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240224,
					"content": "Vì vậy chúng ta cứ tương kế tựu kế, giúp Đạo Bảo Đoàn thiết kế ra \"Địa điểm xâm nhập tốt nhất\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240225,
						411240226
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240225,
					"content": "Tôi phải làm gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240231
					]
				},
				{
					"id": 411240231,
					"content": "Chuyện bạn cần làm rất đơn giản.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240232
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240232,
					"content": "Để đảm bảo cả đám sẽ không bị một lưới bắt gọn, Đạo Bảo Đoàn đi thăm dò trước sẽ không trực tiếp trở về báo cáo. Thay vào đó, tin tình báo sẽ được ghi lên giấy và đặt tại nơi chỉ định.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240233
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240233,
					"content": "Vì đề phòng xảy ra sự cố, chúng cử ra ba tên đến thăm dò, và địa điểm giao tin tình báo cũng ở ba nơi khác nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240234
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240234,
					"content": "Có điều, bọn chúng không nghĩ đến, cả ba tên này đều bị vị tiên sinh đó bắt được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240235
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240235,
					"content": "Sau khi nhận được tình báo, những tên Đạo Bảo Đoàn khác mới bắt đầu lên kế hoạch, chọn địa điểm xâm nhập tốt nhất...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240236
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240236,
					"content": "Nhưng lần này chúng không cần hao tổn tâm trí, vị tiên sinh đó đã giúp chúng vạch sẵn toàn bộ kế hoạch một cách chi tiết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240237
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240237,
					"content": "Hãy cầm lấy ba bức thư này, và đặt chúng tại ba điểm đã được chỉ định của Đạo Bảo Đoàn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240238
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240238,
					"content": "Sau khi làm xong, thì quay lại báo cho tôi, những chuyện còn lại... chúng ta sẽ bàn sau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240226,
					"content": "Lời của Đạo Bảo Đoàn có đáng tin không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240227
					]
				},
				{
					"id": 411240227,
					"content": "Hahaha, bạn suy nghĩ thật chu đáo. Yên tâm, mấy kẻ Đạo Bảo Đoàn đó làm gì có chuyện không khuất phục.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240228
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240228,
					"content": "Mấy kẻ đó, suy cho cùng cũng chỉ là một lũ trộm cắp kiếm tiền.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240229
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240229,
					"content": "\"Hợp tác với chúng tôi sẽ kiếm được nhiều tiền hơn, nếu giở trò sẽ phải đền đến khuynh gia bại sản.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240230
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240230,
					"content": "Chỉ cần chúng ý thức được điểm này, chúng sẽ ngoan ngoãn hợp tác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240231
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240217,
					"content": "Kỵ sĩ Tây Phong sẽ xử lý được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240218
					]
				},
				{
					"id": 411240218,
					"content": "Hahaha, quả nhiên bạn lại nói vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240219
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240219,
					"content": "Yên tâm đi, lần này vị tiên sinh đó đã đưa cho tôi một khoản lớn, sẽ không thiếu tiền công cho bạn đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240220
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240220,
					"content": "Nếu bạn có bắt kỳ thu hoạch gì trong lúc làm việc, cũng có thể giữ lấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240221
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240221,
					"content": "Mà chuyện này chỉ bạn mới có thể làm được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240222
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240208,
					"content": "Ý của bạn là... Hilichurl?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240209
					]
				},
				{
					"id": 411240209,
					"content": "Hahaha, bạn nghĩ đi đâu vậy, Hilichurl làm gì có cơ hội thừa nước đục thả câu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240210
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240210,
					"content": "Chỉ cần chúng tiến gần thành, các kỵ sĩ Tây Phong sẽ đẩy lùi bọn chúng ngay lập tức.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240211
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240211,
					"content": "Tôi nói những kẻ muốn thừa nước đục thả câu đó chính là Đạo Bảo Đoàn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240212
					],
					"speakerTitle": "Vile"
				}
			]
		},
		{
			"id": 4112406,
			"completionStepIds": [
				4112406
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4112406",
							"2"
						],
						"stepId": 4112406,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vile"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411240601,
					"content": "Bạn đã đặt thư xong chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240602
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240602,
					"content": "Đặt xong cả rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240603
					]
				},
				{
					"id": 411240603,
					"content": "Như vậy đám Đạo Bảo Đoàn đó chắc chắn sẽ lên kế hoạch xâm nhập dựa vào ba mẩu thông tin tình báo đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240604
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240604,
					"content": "Và \"thời điểm xâm nhập thích hợp nhất\" trong kế hoạch của chúng chắc chắn là từ nửa đêm cho đến rạng sáng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240605
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240605,
					"content": "Còn \"địa điểm xâm nhập thích hợp nhất\"... chắc chắn cũng chỉ có một mà thôi, để tôi đánh dấu trên bản đồ cho bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240606
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240606,
					"content": "Như vậy thì chúng ta chỉ cần đợi đám Đạo Bảo Đoàn đó tự mình sa lưới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240607,
						411240610
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240607,
					"content": "Nếu mà bị kỵ sĩ Tây Phong biết được...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240608
					]
				},
				{
					"id": 411240608,
					"content": "Ừm... lo lắng của bạn cũng có lý. Suy cho cùng thủ đoạn mà chúng ta sử dụng không theo lẽ thường, nếu bị kỵ sĩ Tây Phong biết được chắc chắn sẽ gây ra rất nhiều rắc rối...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240609
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240609,
					"content": "Có điều, vị tiên sinh đó đã bảo đảm với tôi rằng sẽ không xảy ra vấn đề đó. Chúng ta hãy... tin vào ngài ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240612
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240612,
					"content": "Được rồi, đợi khi đêm tối, bạn hãy hạ gục hết lũ Đạo Bảo Đoàn tự chui đầu vào rọ đó đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240610,
					"content": "Nếu không xuất hiện thì...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240611
					]
				},
				{
					"id": 411240611,
					"content": "Chắc chắn sẽ xuất hiện, bạn đừng lo. Đây là kế hoạch do chính ngài ấy lập ra, sẽ không có vấn đề gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240612
					],
					"speakerTitle": "Vile"
				}
			]
		},
