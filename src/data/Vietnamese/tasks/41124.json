			},
			"dialogs": [
				{
					"id": 411245201,
					"content": "Bạn vẫn chưa đi sao? À... còn có điều gì muốn hỏi nữa sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411245202,
						411245205
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411245202,
					"content": "Vị tiên sinh ấy là ai?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411245203
					]
				},
				{
					"id": 411245203,
					"content": "À, vị tiên sinh đó với bạn là người quen cũ, ngài ấy còn nói đã từng cùng bạn kề vai sát cánh chiến đấu một thời gian nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411245204
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411245204,
					"content": "Tuy nhiên tôi không thể trực tiếp nói cho bạn biêt tên của ngài ấy, nếu không vị tiên sinh đó chắc chắn sẽ trách tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				},
				{
					"id": 411245205,
					"content": "Tại sao không trực tiếp một lưới bắt gọn đám người Đạo Bảo Đoàn đó?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411245206
					]
				},
				{
					"id": 411245206,
					"content": "Ý bạn là... cho dù có đánh bại đám Đạo Bảo Đoàn bị ba bức thư này thu hút, những kẻ còn lại sẽ trốn thoát sau khi nhận được tin tức phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411245207
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411245207,
					"content": "Ừm... đúng vậy, đây chính là mục đích của ngài ấy. Không phải \"một lưới bắt gọn\" mà chỉ là \"một chút uy hiếp\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411245208
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411245208,
					"content": "Ở hoàn cảnh hiện tại, đội kỵ sĩ không thể dành nhân lực cho một cuộc truy bắt quy mô lớn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411245209
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411245209,
					"content": "Suy cho cùng, việc quan trọng và cũng cấp bách nhất lúc này là những thiên thạch từ trên trời rơi xuống kia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411245210
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411245210,
					"content": "Còn với Đạo Bảo Đoàn... miễn là khiến chúng không gây rắc rối trong thời điểm này là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				}
			]
