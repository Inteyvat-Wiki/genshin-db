			"dialogs": [
				{
					"id": 721650201,
					"content": "Xin chào. Hôm nay có chuyện gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650202
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650202,
					"content": "Xin hãy bói cho cháu một quẻ!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721650203
					]
				},
				{
					"id": 721650203,
					"content": "Hi hi, hôm nay vận may sẽ như thế nào ta?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721650204,
					"content": "Ừm...theo tiên đoán của \"Tảo Thần\"...sẽ có vận rủi đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650205
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650205,
					"content": "Trong hang động ở phía nam Đảo Watatsumi, sào huyệt của bọn cướp, hai cháu sẽ gặp vận rủi không lường trước được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650206
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650206,
					"content": "Ơ, vận rủi sao! Vậy chúng ta tránh chỗ đó đi thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721650207,
					"content": "Ha ha, nhưng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650208
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650208,
					"content": "Nếu khắc chế được vận rủi thì không chừng sẽ có thu hoạch không ngờ đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650209
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650209,
					"content": "Thu hoạch...? Là kho báu sao? Kho báu à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721650210,
					"content": "Bà không nói phải...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650211
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650211,
					"content": "Ồ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721650212,
					"content": "Nhưng cũng không nói không phải...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650213
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650213,
					"content": "Úi! Lão bà này sao thế nhỉ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
