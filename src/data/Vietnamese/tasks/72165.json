					"nextDialogs": [
						721650504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721650504,
					"content": "Ừm...ánh sáng của \"Tảo Thần\" đã rất yếu rồi, xem ra phải nghỉ ngơi một chút...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650505
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650505,
					"content": "Nhưng không sao, vẫn còn có thể bói cho các cháu một lần nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650506
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650506,
					"content": "Ừm...theo ánh sáng mờ mịt của \"Tảo Thần\" thì...là vận may đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650507
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650507,
					"content": "Tàn tích ở phía đông bắc, tòa thành cổ trên biển, linh hồn xưa cũ sẽ hướng dẫn cho các cháu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650508
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650508,
					"content": "Nhưng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650509
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650509,
					"content": "Cháu phải mở một cánh cổng lớn cho cô ấy, đưa cô ấy trở về tổ ấm của những giấc mơ vĩnh cửu...mới có thể nhận được phần thưởng trong số mệnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650510
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650510,
					"content": "Ơ...gì mà thành cổ, tổ ấm...lung tung thế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721650511,
					"content": "Ha ha, không sao, bà luôn ở đây, khi nào rối quá thì cứ đến tìm bà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650512
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650512,
					"content": "Ơ ơ, bà ấy đang nói tôi ngốc sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
