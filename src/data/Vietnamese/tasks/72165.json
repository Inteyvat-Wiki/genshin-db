			"dialogs": [
				{
					"id": 721650101,
					"content": "Các cháu về rồi, có chuyện gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650102
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650102,
					"content": "Xin hãy bói cho cháu một quẻ!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721650103
					]
				},
				{
					"id": 721650103,
					"content": "#Paimon cũng muốn biết {NICKNAME} hôm nay có may mắn không!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721650104,
					"content": "Ừm...theo đường vân trên lá của \"Tảo Thần\" thì...may mắn đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650105
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650105,
					"content": "Hai cháu sẽ gặp vận may ở nơi cao nhất của Đảo Watatsumi, nơi xưa kia dành cho việc cúng tế thần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650106
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650106,
					"content": "Hmm...sao tôi lại không thấy được nhiều thông tin như vậy nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721650107,
					"content": "Ha ha, đây là trí tuệ của người già ở đây đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650108
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650108,
					"content": "Câu trả lời qua loa này...đáng nghi ghê!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
