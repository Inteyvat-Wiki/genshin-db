			"trigger": {
				"objectNames": [
					"Ziryab",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230260101,
					"content": "Những câu hỏi này có khó quá không nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260102
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260102,
					"content": "Hửm? Nhà Lữ Hành! Vui lòng dừng bước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260103
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260103,
					"content": "Anh gọi tôi à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260104
					]
				},
				{
					"id": 230260104,
					"content": "Đúng vậy! Hahaha, sở dĩ tôi mạo muội xin bạn dừng bước là vì muốn nhờ bạn giúp một việc nhỏ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260105,
						230260106,
						230260107
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260105,
					"content": "Anh bị mất đồ à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260108
					]
				},
				{
					"id": 230260108,
					"content": "Hả? Sao mà... nghe có vẻ rành rẽ quá vậy? Hahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260109
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260109,
					"content": "Không phải, tôi không làm rơi gì, cũng không thiếu tài liệu nghiên cứu, về phần lấy ý tưởng thì... tôi cũng đã tự tìm đủ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260110
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260110,
					"content": "Khụ khụ, thật ra, để giúp các học sinh mới nhanh chóng hiểu được các thuật ngữ khác nhau được lưu hành trong Sumeru, tôi đang biên soạn một quyển \"Tuyển Tập Hỏi Đáp\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260111
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260111,
					"content": "Nói cho dễ hiểu thì là giải thích những từ ngữ phức tạp cho mọi người hiểu dưới dạng hỏi đáp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260112
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260112,
					"content": "Như vậy hiệu quả học tập sẽ cao hơn, quá trình học cũng sẽ không bị nhàm chán.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260113
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260113,
					"content": "Nhưng mà, tôi không chắc về độ khó của những câu hỏi này... Nên tôi muốn nhờ bạn đánh giá giúp tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260114,
						230260116
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260114,
					"content": "Tôi không hiểu nhiều về Giáo Viện...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260115
					]
				},
				{
					"id": 230260115,
					"content": "Hahaha, không sao, đợi bạn trả lời xong mấy câu hỏi của tôi thì sẽ biết sơ bộ về Giáo Viện thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260119
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260119,
					"content": "Đừng lo, những câu hỏi này cũng không khó lắm đâu, chỉ là... mấy vấn đề vặt vãnh thường ngày thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260120
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260120,
					"content": "Vậy chúng ta bắt đầu nhé, xin lắng nghe câu hỏi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260116,
					"content": "Sao cứ có cảm giác hình như mình đã từng làm chuyện thế này qua rồi nhỉ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260117
					]
				},
				{
					"id": 230260117,
					"content": "Ý bạn là những câu hỏi mà ngài Swan ở Mondstadt đã hỏi bạn à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230260118,
					"content": "Lúc đó Swan đã cho chúng tôi đáp án để tham khảo trước. Còn anh thì... chắc sẽ không cho chúng tôi đáp án trước đâu nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230260106,
					"content": "Anh thiếu tài liệu à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260108
					]
				},
				{
					"id": 230260107,
					"content": "Anh muốn lấy ý tưởng à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260108
					]
				}
			]
		},
