			"dialogs": [
				{
					"id": 230260301,
					"content": "Có lẽ trong quá trình du lịch của mình, bạn đã từng gặp không ít các \"học giả thực địa\" tự xưng là \"Driyosh\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260302
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260302,
					"content": "Trên thực tế, trong học viện nào đó của Giáo Viện cũng có một lượng lớn \"Driyosh\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260303
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260303,
					"content": "Học viện này lấy nguyên tố làm lý thuyết cốt lõi, nghiên cứu những thứ liên quan mật thiết đến sức mạnh nguyên tố.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260304
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260304,
					"content": "Câu hỏi của tôi là, tên của học viện này là gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260305,
						230260307,
						230260309
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260305,
					"content": "Học viện Spantamad.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260306
					]
				},
				{
					"id": 230260306,
					"content": "Đúng vậy, chính là học viện Spantamad, nơi tập hợp các học giả nghiên cứu về bảy nguyên tố lớn, là bản chất của mọi vật chất và sự sống.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260307,
					"content": "Học viện Haravatat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260308
					]
				},
				{
					"id": 230260308,
					"content": "Haha, trả lời sai rồi, các học giả \"Học Phái Haravatat\" nghiên cứu về ngôn ngữ, ký hiệu và logic... Tin tôi đi, thực sự rất phức tạp đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260309,
					"content": "Học viện Rtawahist.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260310
					]
				},
				{
					"id": 230260310,
					"content": "Chà, thật đáng tiếc, bạn đáp sai rồi. \"Học viện Rtawahist\" là đại bản doanh của các học giả \"Học Phái Rtawahist\", cốt lõi nghiên cứu của họ là bầu trời sao trên đầu chúng ta đấy... Haha, nghe có vẻ rất thú vị phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ziryab"
				}
			]
		},
