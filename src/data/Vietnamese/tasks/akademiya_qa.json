			"trigger": {
				"objectNames": [
					"Ziryab"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230260201,
					"content": "Khụ khụ... Có thể bạn cũng đã biết, nghiên cứu của mỗi học phái trong Giáo Viện đều có thế mạnh riêng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260202
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260202,
					"content": "Vậy thì xin hỏi, học viện có số lượng học giả nhiều nhất trong Giáo Viện, cũng chính là nơi có phần lớn học giả thuộc Học Phái Amurta, tên của nó là gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260203,
						230260205,
						230260207
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260203,
					"content": "Học viện Amurta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260204
					]
				},
				{
					"id": 230260204,
					"content": "Rất tốt, hoàn toàn chính xác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260205,
					"content": "Học viện Armuta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260206
					]
				},
				{
					"id": 230260206,
					"content": "Ồ, ngược với đáp án đúng mất rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260207,
					"content": "Học viện Atamur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260208
					]
				},
				{
					"id": 230260208,
					"content": "Haha, thật đáng tiếc. Không phải đáp án này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ziryab"
				}
			]
		},
