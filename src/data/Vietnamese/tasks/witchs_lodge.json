			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": [
					{
						"sceneId": 3,
						"position": [
							5461.151,
							198.892,
							9742.186
						],
						"pointId": 14953
					}
				]
			},
			"dialogs": [
				{
					"id": 766730101,
					"content": "Người trẻ tuổi tiếp tục bước đi, người đó để ý thấy trên lãnh thổ của ma nữ có rất nhiều tác phẩm điêu khắc tinh xảo. \"Đây là gì vậy?\" Người trẻ tuổi thắc mắc hỏi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730102
					],
					"speakerTitle": "Quan Sát"
				},
				{
					"id": 766730102,
					"content": "\"Đây là những kẻ chống đối ma nữ, chúng thèm muốn sức mạnh của ma nữ nên đã bị biến thành đá.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730103
					],
					"speakerTitle": "Quan Sát"
				},
				{
					"id": 766730103,
					"content": "Dù chỉ mới nghĩ ra, nhưng tình tiết này cũng không tệ đấy. Ma nữ vốn phải là sự tồn tại vừa mạnh mẽ vừa nguy hiểm... Còn nguy hiểm sẽ mang đến cảm giác bí ẩn, nếu không có bí ẩn thì mọi thứ trên thế gian sẽ trở nên ảm đạm vô vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730104
					],
					"speakerTitle": "Quan Sát"
				},
				{
					"id": 766730104,
					"content": "(Nhưng biến người ta thành đá có phải hơi quá đáng rồi không? Chắc không ai muốn ở cạnh một người kỳ lạ vậy đâu, vẫn nên xem những lời vừa rồi như là cảnh cáo thì hơn.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730105
					],
					"speakerTitle": "Quan Sát"
				},
				{
					"id": 766730105,
					"content": "Nghe xong, người trẻ tuổi toát mồ hôi lạnh. Ngay lúc đó, tiếng cười của ma nữ lại vang lên: \"Haha, tin thật đấy à? Đó chỉ là cách dùng tượng điêu khắc để lưu lại khoảnh khắc mà thôi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730106
					],
					"speakerTitle": "Quan Sát"
				},
				{
					"id": 766730106,
					"content": "\"Điêu khắc... Đây chính là việc tôi cần người giúp đỡ hoàn thành, căn nhà của ma nữ đang cần thêm nhiều bạn nhỏ đáng yêu.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quan Sát"
				}
			]
		},
		{
			"id": 7667302,
			"completionStepIds": [
				7667302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
