			},
			"dialogs": [
				{
					"id": 766731132,
					"content": "Tiếp theo, chỉ cần nhờ Nicole điều chỉnh thêm một chút...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766731133,
					"content": "Đã loại bỏ những phần đá thừa rồi à? Để tôi xem nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731134
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731134,
					"content": "Hihi, vậy là xong rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731101
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766731101,
					"content": "Ối... Căn nhà của ma nữ! Nó xuất hiện từ lúc nào vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766731102,
					"content": "Đây là sức mạnh của ma nữ sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766731103
					]
				},
				{
					"id": 766731103,
					"content": "\"Đây là sức mạnh của ma nữ sao?\" Biểu cảm của người trẻ tuổi vô cùng kinh ngạc. \"Thật tuyệt vời.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731104
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731104,
					"content": "Cuối cùng cũng tiếp tục kể câu chuyện lúc trước rồi sao? Sau đó ma nữ và người trẻ tuổi thế nào rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766731105,
					"content": "Họ chung sống vui vẻ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731106
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731106,
					"content": "...Chính là vậy đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731107
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731107,
					"content": "Hả?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731108,
						766731109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766731108,
					"content": "Thế còn quá trình thì sao!?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766731110
					]
				},
				{
					"id": 766731110,
					"content": "Thật hết cách, nếu hai người muốn nghe đến vậy thì tôi sẽ kể lại từ đầu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731111
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731111,
					"content": "#Kể từ khi người trẻ tuổi nói \"Ước nguyện của cô cũng sẽ là ước nguyện của tôi\", {M#cậu ấy}{F#cô ấy} đã thành công thu hút sự chú ý của đại ma nữ Nicola Coco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731112
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731112,
					"content": "Tuy nhiên, ngay khi mối quan hệ giữa hai người dần trở nên thân thiết, thì một nhóm khách không mời đột ngột kéo đến và cưỡng chế bắt ma nữ đi mất!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731113
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731113,
					"content": "#Người trẻ tuổi vô cùng kinh ngạc, lúc này một ma nữ mới tên Alynas đã xuất hiện và ký kết khế ước với người trẻ tuổi, để {M#cậu ấy}{F#cô ấy} cũng có được phép thuật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731114
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731114,
					"content": "Sau khi trải qua quá trình huấn luyện vô cùng gian khổ, thì phát hiện sau tất cả ẩn chứa một âm mưu khác!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731115
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731115,
					"content": "Hóa ra đại ma nữ Nicola Coco là một sinh mệnh ngoài hành tinh, là trưởng nữ của quốc vương Meowtres III từ Hành Tinh Mèo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731116
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731116,
					"content": "Họ ngụy trang thành ma nữ với mục đích thật sự là để khiến toàn thế giới bất giác tôn thờ Hành Tinh Mèo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731117
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731117,
					"content": "\"Hỡi ma nữ vĩ đại của tôi, chẳng lẽ cô đã luôn lừa dối tôi sao?\" Người trẻ tuổi cảm thấy trái tim mình vụn vỡ, giọng nói không khỏi run lên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731118
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731118,
					"content": "\"Hãy quay về đi, cuộc chiến giữa Hành Tinh Mèo và các người là chuyện không thể tránh khỏi, ngay từ ban đầu chúng ta đã là kẻ thù của nhau.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731119
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731119,
					"content": "Ma nữ quay người lại, giấu đi những giọt nước mắt của mình...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731120
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731120,
					"content": "Người trẻ tuổi dũng cảm tiến lên, nắm lấy cổ tay của ma nữ, thề rằng sẽ không bao giờ rời xa cô. Cảm động trước sự kiên định của người trẻ tuổi, ma nữ đã quyết tâm giơ cao ngọn cờ phản kháng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731121
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731121,
					"content": "Nhưng lúc này Alynas, người đã từng giúp đỡ người trẻ tuổi, lại đứng về phía quốc vương.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731122
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731122,
					"content": "Thì ra cô ta là con gái thứ hai của Meowtres III, giúp đỡ người trẻ tuổi chỉ để thúc đẩy chị mình phản bội, rồi giành lấy quyền kế vị ngai vàng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731123
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731123,
					"content": "Nicole say sưa kể về quá trình phức tạp, trong đó chứa đầy những tình tiết kỳ lạ, cuối cùng ngay cả nhân vật chính cũng không còn thuộc phạm trù con người nữa...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						766731124
					]
				},
				{
					"id": 766731124,
					"content": "Tóm lại là như vậy đấy, cuối cùng người trẻ tuổi đã hóa thành mèo cùng ma nữ phá tan âm mưu, trở về căn nhà của ma nữ, sống một cuộc đời bình yên tách biệt với thế giới. Câu chuyện đến đây là hết rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731125
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731125,
					"content": "Hic... Thật tuyệt vời, một hành trình tràn ngập tình yêu và sự phản kháng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766731126,
					"content": "Cảm giác như là một câu chuyện hoàn toàn khác so với phần mở đầu vậy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766731127
					]
				},
				{
					"id": 766731127,
					"content": "Không còn cách nào khác, bất cứ thứ gì một khi đã được tạo ra, rồi sẽ có ngày thoát khỏi tầm kiểm soát của người tạo ra nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731128
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731128,
					"content": "Cũng như thiên sứ, dù từng được giao trọng trách dẫn dắt nhân loại, nhưng chỉ vì một số ít đã chọn đi theo con đường khác, mà khiến cả tộc phải gánh chịu sự trừng phạt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731129
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731129,
					"content": "Dù là Thiên Lý cũng không thể hoàn toàn kiểm soát những thứ mình tạo ra... Huống chi là tôi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731130
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731130,
					"content": "Khó mà nói trước được số phận sẽ ra sao, nhưng... tôi vẫn muốn dẫn dắt những người mình gặp đến với một kết thúc tốt đẹp. Cho dù chỉ là nhân vật trong câu chuyện đi nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731131
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731131,
					"content": "Được rồi, câu chuyện đã kết thúc, nhiệt huyết của tôi cũng cạn kiệt rồi. Lần sau có câu chuyện hay tôi sẽ kể tiếp nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731135
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731135,
					"content": "Thì ra cô ta là con gái thứ hai của Meowtres III...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731136
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731136,
					"content": "Giúp đỡ người trẻ tuổi chỉ để thúc đẩy chị mình phản bội...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731137
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731137,
					"content": "Rồi giành lấy quyền kế vị ngai vàng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731109,
					"content": "Giản lược nhiều quá rồi đó!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766731110
					]
				}
			]
		},
