					"content": "Đã cùng Paimon chụp được nhiều bức hình...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						766730702
					]
				},
				{
					"id": 766730702,
					"content": "Cảm thấy có vài bức chụp khá ổn đấy, nhưng hình như chưa chụp được mặt trước. Đợi nó quay lại xem nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766730703,
					"content": "Raargh!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730704
					],
					"speakerTitle": "Mandragora"
				},
				{
					"id": 766730704,
					"content": "Đúng rồi, chính là như này, rất có khí thế!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730705,
						766730706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766730705,
					"content": "Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766730707
					]
				},
				{
					"id": 766730707,
					"content": "Waaaaaah! Cứu tôi với!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766730706,
					"content": "Lui ra sau!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766730707
					]
				}
			]
		},
