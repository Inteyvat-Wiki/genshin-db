						],
						"pointId": 14939
					},
					{
						"sceneId": 3,
						"position": [
							5480.907,
							194.819,
							9712.115
						],
						"pointId": 14940
					},
					{
						"sceneId": 3,
						"position": [
							5481.945,
							194.575,
							9709.521
						],
						"pointId": 14942
					}
				]
			},
			"dialogs": [
				{
					"id": 766730201,
					"content": "#Người trẻ tuổi kinh ngạc trước vẻ cao quý và xinh đẹp của ma nữ, sau khi im lặng một hồi lâu, {M#cậu ấy}{F#cô ấy} nghiêm túc nói...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730202
					],
					"speakerTitle": "Quan Sát"
				},
				{
					"id": 766730202,
					"content": "\"Hỡi ma nữ xinh đẹp và thông thái ở phương xa! Ngay khi vừa gặp cô, trái tim tôi đã không khỏi xao động. Ước nguyện của cô cũng sẽ là ước nguyện của tôi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730203
					],
					"speakerTitle": "Quan Sát"
				},
				{
					"id": 766730203,
					"content": "Trên gương mặt của ma nữ xuất hiện nụ cười khó nhận ra: \"Đã như vậy thì hãy giúp tôi hoàn thành một số việc trong khả năng của mình. Chỉ dẫn đã được đưa ra, phần thưởng đang chờ ở phía trước.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730204
					],
					"speakerTitle": "Quan Sát"
				},
				{
					"id": 766730204,
					"content": "Chỉ dẫn... ý là quả cầu ánh sáng này sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7667303,
			"completionStepIds": [
				7667303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7667303",
							"2"
						],
						"stepId": 7667303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 766730301,
					"content": "\"Căn nhà bí mật à\", trong mắt người trẻ tuổi có nét bối rối. \"Căn nhà đó ở đâu vậy?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730302
					],
					"speakerTitle": "Quan Sát"
				},
				{
					"id": 766730302,
					"content": "Nghe thấy câu hỏi của người trẻ tuổi, giọng nói của ma nữ lộ ra chút hoảng loạn hiếm thấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730303
					],
					"speakerTitle": "Quan Sát"
				},
				{
					"id": 766730303,
					"content": "(Khoan đã, cô ấy là kiểu nhân vật e thẹn vậy sao? Thôi kệ, cứ để tạm vậy đã, Thầy Cửu sẽ giúp chỉnh sửa lại.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730304
					],
					"speakerTitle": "Quan Sát"
				},
				{
					"id": 766730304,
					"content": "#\"Khụ khụ, này người trẻ tuổi, đừng hỏi những câu thất lễ như vậy. Căn nhà ma nữ đang trong quá trình xây dựng, chẳng bao lâu nữa {F#cô}{M#cậu} sẽ phải trầm trồ trước vẻ lộng lẫy của nó.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730305
					],
					"speakerTitle": "Quan Sát"
				},
				{
					"id": 766730305,
					"content": "#\"Đây là thử thách dành cho {F#cô}{M#cậu}, hãy cống hiến sức lực của mình để xây dựng lãnh thổ của đại ma nữ nào.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quan Sát"
				}
			]
		},
		{
			"id": 7667304,
			"completionStepIds": [
				7667303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7667303",
							"2"
						],
						"stepId": 7667303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 766730401,
					"content": "#\"Được rồi, người trẻ tuổi. Giờ đây {F#cô}{M#cậu} đã biết được nỗi phiền muộn của ma nữ, Nicola Coco đang xây dựng lãnh địa thiêng liêng của cô ấy và cần sự giúp đỡ của {F#cô}{M#cậu}.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730402
					],
					"speakerTitle": "Quan Sát"
				},
				{
					"id": 766730402,
					"content": "#Ma nữ mỉm cười pha một tách trà cho người trẻ tuổi: \"Lựa chọn của {F#cô}{M#cậu} là gì?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730403,
						766730404
					],
					"speakerTitle": "Quan Sát"
				},
				{
					"id": 766730403,
					"content": "Vô cùng sẵn lòng!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766730405
					]
				},
				{
					"id": 766730405,
					"content": "Khoan đã nào! Với một người kỳ lạ không rõ lai lịch mà lại tự biên tự diễn thế này, chúng ta nên cẩn thận thì hơn đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766730406,
					"content": "Ơ... Nhưng mà cái tách trà này, sao nhìn quen quen thế nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730407,
						766730408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766730407,
					"content": "Cuối cùng cũng nhận ra rồi à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766730409
					]
				},
				{
					"id": 766730409,
					"content": "Nicola Coco... Ơ! Chẳng lẽ là ma nữ N... Nicole sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766730410,
					"content": "Đúng rồi. Câu chuyện vừa rồi thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730411
					],
					"speakerTitle": "Quan Sát"
				},
				{
					"id": 766730411,
					"content": "Thế nào à... Chuyện còn chưa kể hết nhỉ? Rồi sau đó chuyện gì đã xảy ra với người trẻ tuổi và ma nữ vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766730412,
					"content": "Vẫn chưa nghĩ ra. Phần còn lại để đợi khi căn nhà ma nữ sửa xong rồi tính tiếp, lúc đó biết đâu sẽ có ý tưởng mới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730413
					],
					"speakerTitle": "Quan Sát"
				},
				{
					"id": 766730413,
					"content": "Hai người có thể nghe được giọng của tôi, vậy nghĩa là hiện đang ở Nod-Krai nhỉ. Có thể nhờ hai người giúp tôi thu thập một số thứ được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730414,
						766730416
					],
					"speakerTitle": "Quan Sát"
				},
				{
					"id": 766730414,
					"content": "Là gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766730415
					]
				},
				{
					"id": 766730415,
					"content": "Tôi định vừa xây nhà vừa làm thêm vài bức tượng mới. Nhưng hiện tại tôi chưa có ý tưởng gì, nên muốn nhờ hai người chụp giúp vài bức hình đẹp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730418
					],
					"speakerTitle": "Quan Sát"
				},
				{
					"id": 766730418,
					"content": "#Thật là hết cách với cô mà, thôi thì cứ giao cho tôi và {NICKNAME} nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766730419,
					"content": "Vậy cô đợi nhé, chúng tôi sẽ ra ngoài xem có gì hay ho không. Khi nào hoàn thành bức tượng, nhớ kể nốt câu chuyện vừa rồi đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766730416,
					"content": "Có liên quan đến tượng điêu khắc sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766730417
					]
				},
				{
					"id": 766730417,
					"content": "Đúng vậy, tôi định vừa xây nhà vừa khắc thêm vài bức tượng mới. Nhưng hiện tại tôi chưa có ý tưởng gì, có thể giúp tôi chụp vài bức ảnh được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730418
					],
					"speakerTitle": "Quan Sát"
				},
				{
					"id": 766730408,
					"content": "Người này chính là...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766730409
					]
				},
				{
					"id": 766730404,
					"content": "Xin tuân theo sự chỉ dẫn của đại ma nữ Nicola Coco!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766730405
					]
				}
			]
		},
