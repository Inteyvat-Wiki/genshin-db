			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 766730901,
					"content": "Nicole, chúng tôi trở về rồi đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766730902,
					"content": "Nhanh thế! Quả không hổ danh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730903
					],
					"speakerTitle": "Quan Sát"
				},
				{
					"id": 766730903,
					"content": "Quá khen rồi, nhưng mà phải gửi hình cho cô bằng cách nào đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766730904,
					"content": "Cứ giữ tạm đi. Khoảng hai ngày nữa tôi sẽ đến đó, lúc đó chúng ta có thể cùng nhau bàn về chuyện tác phẩm điêu khắc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730905
					],
					"speakerTitle": "Quan Sát"
				},
				{
					"id": 766730905,
					"content": "Tuyệt quá, vậy chúng ta không gặp không về nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
