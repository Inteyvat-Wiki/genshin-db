			"dialogs": [
				{
					"id": 766730501,
					"content": "Đến đúng lúc lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730502
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766730502,
					"content": "Tôi rất hài lòng với những bức hình này, đều là những đề tài tôi quan tâm. Tôi cũng đã chuẩn bị sẵn dụng cụ điêu khắc rồi, cùng thử nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730503
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766730503,
					"content": "Dụng cụ điêu khắc... ý cô là mấy khối này à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766730504,
					"content": "Đúng vậy, bức tượng nằm trong những khối đá này, chúng ta chỉ cần loại bỏ những phần thừa thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730505
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766730505,
					"content": "Để dễ hiểu hơn, tôi còn có cả hướng dẫn điêu khắc này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730506
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766730506,
					"content": "Để tôi làm mẫu cho nhé, trước tiên là xác định tạo hình cơ bản...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730507
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766730507,
					"content": "Số trên khối đá chính là số lượng cần giữ lại trong cùng một cột. Như thế này... rồi như thế này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730508
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766730508,
					"content": "Ồ! Dần thành hình rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766730509,
					"content": "Hiểu rồi chứ? Điêu khắc như vậy thì đã có thể thấy được hình dáng cơ bản rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730510
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766730510,
					"content": "Sau đó chỉ cần tô điểm thêm một chút.. Hah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730511
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766730511,
					"content": "Khoan, khoan đã! Tôi chỉ mới chớp mắt một cái thôi mà sao lại thành ra thế này rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766730512,
					"content": "Phần này chỉ cần xem là được rồi, một ma nữ vĩ đại như tôi không thể tùy tiện tiết lộ bí mật về phép thuật được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730513
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766730513,
					"content": "Phần điều chỉnh chi tiết cứ để tôi lo, chắc hai người đã nắm rõ cách điêu khắc rồi phải không? Vậy nhờ hai người nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730514
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766730514,
					"content": "Được rồi, để chúng tôi thử xem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766730515,
					"content": "Ối! Cái gì thế này, vừa bắt đầu đã khó thế này rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766730516,
					"content": "Hửm? À, xin lỗi, vừa rồi tôi nhầm đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730517
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766730517,
					"content": "Cái đó là của tôi, còn của các vị ở bên này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730518
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766730518,
					"content": "Làm, làm tôi hết hồn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
