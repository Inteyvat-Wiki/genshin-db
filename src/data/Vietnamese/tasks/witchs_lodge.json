						],
						"pointId": 14930
					}
				]
			},
			"dialogs": [
				{
					"id": 766730801,
					"content": "#Ngày xửa ngày xưa, có một người trẻ tuổi bỏ nhà ra đi. {M#Cậu ấy}{F#Cô ấy} đã dùng hết số Mora mình có. Lúc này trên người chỉ có một bộ quần áo mỏng manh, run rẩy bước đi trong mùa đông lạnh giá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730802
					],
					"speakerTitle": "Quan Sát"
				},
				{
					"id": 766730802,
					"content": "#Ngay lúc đó, người trẻ tuổi bước hụt, rồi rơi xuống một nơi kỳ lạ. {M#Cậu ấy}{F#Cô ấy} chưa kịp phản ứng thì một giọng nói đã vọng đến từ xa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730803
					],
					"speakerTitle": "Quan Sát"
				},
				{
					"id": 766730803,
					"content": "#\"Đây là căn nhà bí mật của đại ma nữ bất tử Nicola Coco. Hỡi người trẻ tuổi đang lạc lối, hãy kể ra nguyện ước trong lòng mình, đại ma nữ vĩ đại sẽ dẫn lối để {F#cô}{M#cậu} thực hiện nó.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730804
					],
					"speakerTitle": "Quan Sát"
				},
				{
					"id": 766730804,
					"content": "Ôi... Cứ cảm thấy như nghe được tiếng gì đó kỳ lạ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766730805,
					"content": "Nicola Coco... là ai vậy nhỉ? Chúng ta có quen người này không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7667309,
			"completionStepIds": [
				7667309
