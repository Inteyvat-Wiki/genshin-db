			"dialogs": [
				{
					"id": 766730601,
					"content": "Ừm, câu chuyện về ma nữ đã có hình dáng ban đầu rồi, đoạn này có thể giao cho Thầy Cửu viết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730602
					],
					"speakerTitle": "Quan Sát"
				},
				{
					"id": 766730602,
					"content": "Đối với một đại ma nữ, điều quan trọng nhất là vẻ đẹp và khí thế, thêm tiếng cười cuồng loạn để khiến cô ấy nổi bật hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730603
					],
					"speakerTitle": "Quan Sát"
				},
				{
					"id": 766730603,
					"content": "\"Ahahaha, đã bị chinh phục rồi sao? Tôi chính là đại ma nữ bất tử đây!\" Cười như vậy có ồn quá không nhỉ? Thôi kệ, dù sao viết ra cũng đâu ai nghe thấy được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730604
					],
					"speakerTitle": "Quan Sát"
				},
				{
					"id": 766730604,
					"content": "Đã lên kế hoạch trang trí rồi, nhưng nên bắt đầu từ đâu đây? Mọi người đều biết căn nhà không thể tự dưng mà xuất hiện được. Khoan đã, thật sự không thể sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730605
					],
					"speakerTitle": "Quan Sát"
				},
				{
					"id": 766730605,
					"content": "Dùng thuật giả kim chắc cũng được, dù sao nguyên liệu cũng chỉ có gạch đá và gỗ thôi... Ừm, cứ vậy thì đỡ công hơn tự xây nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730606
					],
					"speakerTitle": "Quan Sát"
				},
				{
					"id": 766730606,
					"content": "Căn nhà của ma nữ hẳn phải khác với những căn nhà thông thường, nhưng khác ở chỗ nào thì tôi cũng chưa nghĩ ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730607
					],
					"speakerTitle": "Quan Sát"
				},
				{
					"id": 766730607,
					"content": "Nhưng chắc chắn một điều, nơi này phải là một nơi thần bí cổ xưa không bao giờ thay đổi, dù trải qua hàng trăm năm hay hàng nghìn năm vẫn sẽ giữ nguyên dáng vẻ như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730608
					],
					"speakerTitle": "Quan Sát"
				},
				{
					"id": 766730608,
					"content": "Được đấy, đúng với kỳ vọng của mọi người về một ma nữ. Nhưng thực ra, không phải tôi đã đóng băng thời gian nơi đây, mà chính thời gian đã đóng băng tôi, haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730609
					],
					"speakerTitle": "Quan Sát"
				},
				{
					"id": 766730609,
					"content": "Còn đứng ngẩn ra đó làm gì? Mau đi hoàn thành ủy thác của ma nữ đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730610
					],
					"speakerTitle": "Quan Sát"
				},
				{
					"id": 766730610,
					"content": "Hãy nhớ nhé, đừng chụp hình trông ảm đạm nặng nề quá, tôi cần những bức hình tràn đầy sức sống, có vậy mới khắc họa được thần thái và khí chất của chủ thể.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730611
					],
					"speakerTitle": "Quan Sát"
				},
				{
					"id": 766730611,
					"content": "Đừng nghĩ rằng điêu khắc chỉ cần giống hình dáng là được, quan trọng nhất là phải nắm bắt được sức sống tràn trề của đối tượng điêu khắc trong khoảnh khắc đó, nhớ chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730612
					],
					"speakerTitle": "Quan Sát"
				},
				{
