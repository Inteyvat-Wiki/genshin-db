			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Castiglione"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 762060101,
					"content": "Kanou này, chưa vẽ xong bức bình phong thì đừng có lang thang lung tung, nghĩ cách vẽ thác nước đi đã. Nể mặt Egeria, ai lại đi vẽ thác nước bằng phối cảnh phân tán chứ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762060102
					],
					"speakerTitle": "Castiglione"
				},
				{
					"id": 762060102,
					"content": "...Hmm? À, xin lỗi, hóa ra là người lạ à. Nghe tiếng bước chân, tôi cứ tưởng là Kanou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762060103
					],
					"speakerTitle": "Castiglione"
				},
				{
					"id": 762060103,
					"content": "Anh đang làm gì ở đây vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762060104
					]
				},
				{
					"id": 762060104,
					"content": "#Như {F#cô}{M#cậu} thấy đấy, tôi đang vẽ tranh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762060105
					],
					"speakerTitle": "Castiglione"
				},
				{
					"id": 762060105,
					"content": "Để tránh hiểu lầm, để tôi nói rõ trước nhé. Tuy tôi giỏi vẽ động vật, nhưng động vật tôi vẽ không phải để ăn đâu đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762060106
					],
					"speakerTitle": "Castiglione"
				},
				{
					"id": 762060106,
					"content": "Úi, hóa ra là ăn được à?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762060107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762060107,
					"content": "#Người trong tranh là người trước mắt, thú trong tranh tự nhiên cũng có thể là thú trên đĩa... Haizz, nói vậy thôi, mong là {F#cô}{M#cậu} đừng như cô Jinggui ở Liyue, cứ quấn lấy tôi đòi vẽ thịt cá mãi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762060108
					],
					"speakerTitle": "Castiglione"
				},
				{
					"id": 762060108,
					"content": "Nghệ thuật... Nghệ thuật đáng kính! Bất kể thời đại nào, chủ đề của nó luôn là cứu rỗi tâm hồn loài người, hun đúc tình cảm, lấy Chân - Thiện - Mỹ làm kim chỉ nam dẫn dắt chúng ta đến cảnh giới tinh thần cao hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762060109
					],
					"speakerTitle": "Castiglione"
				},
				{
					"id": 762060109,
					"content": "Chẳng hạn như, khi leo lên đỉnh núi cao nhất, tầm nhìn tự nhiên sẽ không bị che khuất và chân thực. Nghệ thuật mà tôi theo đuổi cũng vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762060110
					],
					"speakerTitle": "Castiglione"
				},
				{
					"id": 762060110,
					"content": "#Hmm... Nếu chỉ nói suông thì chắc {F#cô}{M#cậu} vẫn chưa hiểu được đâu. Thế này nhé, để tôi vẽ cho {F#cô}{M#cậu} một cái đài nổi, {F#cô}{M#cậu} lên đó trải nghiệm một chút là hiểu ngay ấy mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Castiglione"
				}
			]
		}
	]
}