			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jotautas"
				],
				"points": [
					{
						"sceneId": 20322,
						"position": [
							309.422,
							310.76,
							540.634
						],
						"pointId": 3
					}
				]
			},
			"dialogs": [
				{
					"id": 60030501,
					"content": "Các người... các người dám đến đây sao!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030502
					],
					"speakerTitle": "Jotautas",
					"speakerSubtitle": "Cấp Dưới Của Dottore"
				},
				{
					"id": 60030502,
					"content": "Theo những gì chúng tôi biết thì Dottore có thể đang ở trong viện nghiên cứu này, còn anh thì lại đang cố chạy trốn ra ngoài.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030503
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60030503,
					"content": "Hah... Nếu đến đây để gây rắc rối với ngài Dottore... thì cơ hội của các người mong manh lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030504
					],
					"speakerTitle": "Jotautas",
					"speakerSubtitle": "Cấp Dưới Của Dottore"
				},
				{
					"id": 60030504,
					"content": "Thời gian sống của anh sẽ được quyết định bởi giá trị của lời anh nói đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030505
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60030505,
					"content": "Đã có hai Quan Chấp Hành ở đây rồi. Nhưng thế thì sao nào? Ngài Dottore dám làm những chuyện này thì chắc chắn đã có sự chuẩn bị...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030506
					],
					"speakerTitle": "Jotautas",
					"speakerSubtitle": "Cấp Dưới Của Dottore"
				},
				{
					"id": 60030506,
					"content": "Vậy sao? Theo tôi thấy thì có vẻ như anh không muốn làm thuộc hạ của hắn cho lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030507
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60030507,
					"content": "Hơn nữa, ở gần đây có dấu hiệu của ma vật, chẳng lẽ anh thích ở riêng với chúng sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030508
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60030508,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030509
					],
					"speakerTitle": "Jotautas",
					"speakerSubtitle": "Cấp Dưới Của Dottore"
				},
				{
					"id": 60030509,
					"content": "Chúng tôi cần biết Dottore đang âm mưu chuyện gì, nếu anh biết bất kỳ thông tin nào thì hãy cho tôi biết đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030510
					]
				},
				{
					"id": 60030510,
					"content": "Không chỉ vì lợi ích của chúng tôi. Việc hắn làm rất có thể sẽ ảnh hưởng đến toàn bộ Nod-Krai, thậm chí cả Snezhnaya của các anh nữa đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030511
					]
				},
				{
					"id": 60030511,
					"content": "Tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030512
					],
					"speakerTitle": "Jotautas",
					"speakerSubtitle": "Cấp Dưới Của Dottore"
				},
				{
					"id": 60030512,
					"content": "Ngài ấy... đang chế tạo thứ gì đó rất lợi hại. Tôi nghĩ không phải kế hoạch mới chớm gần đây, mà là đã được tiến hành từ rất lâu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030513
					],
					"speakerTitle": "Jotautas",
					"speakerSubtitle": "Cấp Dưới Của Dottore"
				},
				{
					"id": 60030513,
					"content": "Mới đây, ngài Dottore nói muốn quay về Snezhnaya một chuyến, nhưng không ngờ lại quay về đây nhanh như vậy, còn mang theo thứ trông như hai viên đá quý phát sáng nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030514
					],
					"speakerTitle": "Jotautas",
					"speakerSubtitle": "Cấp Dưới Của Dottore"
				},
				{
					"id": 60030514,
					"content": "...Là Tủy Mặt Trăng. Dottore đã cướp đi thứ vốn thuộc về Columbina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030515
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60030515,
					"content": "Cô nói Columbina sao? Cô ấy đã rời đi từ lâu rồi. Trước khi đi còn nói là mình đã hoàn thành lời dặn dò của Nữ Hoàng bệ hạ, và sẽ đi làm những việc của riêng mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030516
					],
					"speakerTitle": "Jotautas",
					"speakerSubtitle": "Cấp Dưới Của Dottore"
				},
				{
					"id": 60030516,
					"content": "Đó giờ tôi luôn cho rằng rời khỏi tổ chức chưa chắc đã là chuyện tốt. Ngay cả ngài Capitano mà tôi kính trọng nhất cũng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030517
					],
					"speakerTitle": "Jotautas",
					"speakerSubtitle": "Cấp Dưới Của Dottore"
				},
				{
					"id": 60030517,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030518
					]
				},
				{
					"id": 60030518,
					"content": "Để hoàn thành kế hoạch, cấp trên đã điều động ba đội quân, lần lượt thuộc quyền chỉ huy của ba vị Quan Chấp Hành là Dottore, Sandrone và Columbina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030519
					],
					"speakerTitle": "Jotautas",
					"speakerSubtitle": "Cấp Dưới Của Dottore"
				},
				{
					"id": 60030519,
					"content": "Lúc đó, tôi đã theo đội của Columbina đến đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030520
					],
					"speakerTitle": "Jotautas",
					"speakerSubtitle": "Cấp Dưới Của Dottore"
				},
				{
					"id": 60030520,
					"content": "Cô ấy hiếm khi giao tiếp với chúng tôi, và cũng... không quan tâm đến xung quanh. Nhưng đó không phải cảm giác lơ đãng, mà là dù thế giới này có ra sao đi nữa thì cô ấy cũng chẳng bận tâm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030521
					],
					"speakerTitle": "Jotautas",
					"speakerSubtitle": "Cấp Dưới Của Dottore"
				},
				{
					"id": 60030521,
					"content": "Tôi cảm thấy cô ấy như không tìm được mục tiêu sống, nên đành phải ngắm nhìn về một nơi xa xăm... Phải rồi, cô ấy luôn ngước nhìn lên bầu trời.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030522
					],
					"speakerTitle": "Jotautas",
					"speakerSubtitle": "Cấp Dưới Của Dottore"
				},
				{
					"id": 60030522,
					"content": "Ngài Dottore thường đứng nhìn cô ấy từ xa. Nghe nói trước kia hai người họ từng có mối quan hệ tốt, nhưng sau đó Columbina lại đề phòng và không còn tiếp xúc nhiều với ngài ấy nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030523
					],
					"speakerTitle": "Jotautas",
					"speakerSubtitle": "Cấp Dưới Của Dottore"
				},
				{
					"id": 60030523,
					"content": "Sau khi Columbina rời đi, tôi được chuyển sang dưới quyền của ngài Dottore. Ngài ấy... cũng chẳng quan tâm đến xung quanh, mà chỉ mong chờ mặt trăng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030524
					],
					"speakerTitle": "Jotautas",
					"speakerSubtitle": "Cấp Dưới Của Dottore"
				},
				{
					"id": 60030524,
					"content": "Đối với ngài Dottore hiện tại, ba mặt trăng là thứ mà ngài ấy muốn có nhất. Ngài ấy còn nói, nếu thiếu một mặt trăng thì cứ tự mình tạo ra là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030525
					],
					"speakerTitle": "Jotautas",
					"speakerSubtitle": "Cấp Dưới Của Dottore"
				},
				{
					"id": 60030525,
					"content": "Tủy Mặt Trăng nhân tạo? Chẳng lẽ là dựa vào kiến thức từ những hư ảnh của Hyperborea sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030526
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60030526,
					"content": "Rất chi tiết. Cảm ơn tình báo của anh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030527
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60030527,
					"content": "Tôi cảm nhận được, thực ra anh muốn làm thuộc hạ của Columbina hơn, đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030528
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60030528,
					"content": "...Không, cô ấy đã không còn là Quan Chấp Hành nữa. Hơn hết, người mà Fatui phải tuyệt đối trung thành, mãi mãi chỉ có Nữ Hoàng bệ hạ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030529
					],
					"speakerTitle": "Jotautas",
					"speakerSubtitle": "Cấp Dưới Của Dottore"
				},
				{
					"id": 60030529,
					"content": "Tôi nói ra những điều này vì không thể hoàn toàn tin tưởng ngài Dottore. Hành động của ngài ấy không phù hợp với mục đích ban đầu khi chúng tôi đến Nod-Krai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030530
					],
					"speakerTitle": "Jotautas",
					"speakerSubtitle": "Cấp Dưới Của Dottore"
				},
				{
					"id": 60030530,
					"content": "Tôi hiểu rồi. Chúng tôi sẽ cố gắng ngăn cản hắn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030531
					]
				},
				{
					"id": 60030531,
					"content": "Thuộc hạ của Arlecchino đang ở Cục Thiết Kế Thí Nghiệm Kuuvahki, anh có thể đến đó với họ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030532
					]
				},
				{
					"id": 60030532,
					"content": "Vậy là tình hình đã được cập nhật. Tủy Mặt Trăng nhân tạo... Và nó cũng sắp hoàn thành rồi... Không ngờ công nghệ của Dottore lại tiến bộ đến mức này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030533
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60030533,
					"content": "Sắp tới chắc chắn sẽ là một trận chiến khốc liệt. Hãy chuẩn bị tinh thần nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flins"
				}
			]
		},
