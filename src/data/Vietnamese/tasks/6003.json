			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"600305",
							"2"
						],
						"stepId": 600305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
