			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": [
					{
						"sceneId": 20322,
						"position": [
							335.674,
							288.735,
							245.957
						],
						"pointId": 6
					}
				]
			},
			"dialogs": [
				{
					"id": 60030901,
					"content": "Rất hoan nghênh. Ta đã chờ đợi từ lâu rồi. Hy vọng quý vị sẽ thích viện nghiên cứu nhỏ này của ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030902
					],
					"speakerTitle": "Dottore"
				},
				{
					"id": 60030902,
					"content": "Thích à? Cũng đúng, trên đường đến đây toàn là ma vật đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030903
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60030903,
					"content": "Ngươi còn dám nhàn nhã đứng đây chờ vậy sao!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030904
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60030904,
					"content": "Tất nhiên rồi. Ta có gì phải vội chứ? Mọi thứ đều diễn ra suôn sẻ, các ngươi cũng đã đến rất đúng hẹn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030905
					],
					"speakerTitle": "Dottore"
				},
				{
					"id": 60030905,
					"content": "Đầu tiên là Sandrone và Arlecchino, rồi đến các ngươi. Hôm nay khách đến đông thật đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030906
					],
					"speakerTitle": "Dottore"
				},
				{
					"id": 60030906,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030907
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60030907,
					"content": "Nếu muốn tìm hai quý cô đó thì rất tiếc, Arlecchino đã biến mất ngay khi vừa vào viện nghiên cứu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030908
					],
					"speakerTitle": "Dottore"
				},
				{
					"id": 60030908,
					"content": "Còn Sandrone thì ban nãy vừa đứng ngay đây và lớn giọng chất vấn ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030909
					],
					"speakerTitle": "Dottore"
				},
				{
					"id": 60030909,
					"content": "Cô ta lúc nào cũng thế, chẳng có chút lễ phép nào cả. Nhưng có một điều khiến ta bất ngờ đấy, không ngờ là cả Sandrone cũng bắt đầu quan tâm đến người khác rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030910
					],
					"speakerTitle": "Dottore"
				},
				{
					"id": 60030910,
					"content": "Ai tiếp xúc nhiều với các ngươi đều sẽ trở nên như vậy sao? Nhưng đối với nhà nghiên cứu thì đây không phải là chuyện tốt, vì nó thiếu tính khách quan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030911
					],
					"speakerTitle": "Dottore"
				},
				{
					"id": 60030911,
					"content": "Sandrone đang ở đâu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030912
					]
				},
				{
					"id": 60030912,
					"content": "Chuyện đó thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030913
					],
					"speakerTitle": "Dottore"
				},
				{
					"id": 60030913,
					"content": "Ngươi mơ xa quá đấy, Dottore. Chẳng lẽ ngươi tưởng có được Tủy Mặt Trăng thì sẽ xưng được thần trong thế giới này sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030914
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 60030914,
					"content": "Ta không thích cách nói \"xưng thần\" đó đâu nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030915
					],
					"speakerTitle": "Dottore"
				},
				{
					"id": 60030915,
					"content": "Ta không tự xưng, mà đó là sự thật. Thân là nhà nghiên cứu, chắc ngươi phải hiểu được sự khác biệt giữa hai điều đó chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030916
					],
					"speakerTitle": "Dottore"
				},
				{
					"id": 60030916,
					"content": "Hah? Chỉ với thực lực của ngươi thôi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030917
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 60030917,
					"content": "Một tiểu thư như ta cũng khó tránh có lúc nói chuyện thất lễ, đừng để tâm nhé. Dù sao cũng là đồng nghiệp với nhau, ai cũng đều rõ ngươi là người như thế nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030918
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 60030918,
					"content": "Là đồng nghiệp với nhau, ta cũng đoán được là ngươi sẽ nói thế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030919
					],
					"speakerTitle": "Dottore"
				},
				{
					"id": 60030919,
					"content": "Chúng ta đều hiểu rõ, sự thật có giá trị hơn nói suông. Vì vậy ta đã cho người mang cho ngươi một món quà nhỏ, để giúp ngươi hiểu rõ hơn về vị thế hiện tại của ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030920
					],
					"speakerTitle": "Dottore"
				},
				{
					"id": 60030920,
					"content": "Món quà?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030921
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 60030921,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030922
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 60030922,
					"content": "Những tên thuộc hạ của ngươi đi đâu cả rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030923
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 60030923,
					"content": "Ai mà biết được chứ? Có lẽ chúng đã theo vị thần nào đó chưa biết tên đi đến thế giới mới rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030924
					],
					"speakerTitle": "Dottore"
				},
				{
					"id": 60030924,
					"content": "Mặc dù ngươi thiếu giáo dưỡng và tự cao tự đại, nhưng Sandrone thân mến à, ta sẽ không vì thế mà trút giận lên thuộc hạ của ngươi đâu. Họ cũng có quyền bình đẳng như nhau mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030925
					],
					"speakerTitle": "Dottore"
				},
				{
					"id": 60030925,
					"content": "Ngươi dám cử người đến Cục Thiết Kế Thí Nghiệm Kuuvahki sao? Đó là nơi thí nghiệm của Nữ Hoàng bệ hạ đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030926
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 60030926,
					"content": "Phải, chúng ta đương nhiên phải luôn ghi nhớ lời dặn của bệ hạ. Nhưng ngươi cũng biết đấy, việc này không hề xung đột với mục tiêu hiện tại của ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030927
					],
					"speakerTitle": "Dottore"
				},
				{
					"id": 60030927,
					"content": "Trong chuyện này, ta chỉ muốn thực hiện một thí nghiệm khác thôi thì có gì sai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030928
					],
					"speakerTitle": "Dottore"
				},
				{
					"id": 60030928,
					"content": "Vậy giờ ngươi đánh cược xem nào. Là ta đang nói dối và tất cả chỉ là kế điệu hổ ly sơn, hay là đang nói thật, thuộc hạ của ngươi đang thực sự gặp nguy hiểm đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030929
					],
					"speakerTitle": "Dottore"
				},
				{
					"id": 60030929,
					"content": "Dám ra tay với cả binh lính của Fatui, ngươi đúng là điên thật rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030930
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 60030930,
					"content": "Giờ đây ta đã đặt ra một quy tắc mới cho bản thân, đó là cho mỗi người một cơ hội. Tất nhiên, ngươi cũng sẽ như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030931
					],
					"speakerTitle": "Dottore"
				},
				{
					"id": 60030931,
					"content": "Nếu ngươi muốn rời đi, ta sẽ không ngăn cản. Dù sao, tất cả chúng ta đều là đồng nghiệp tốt của nhau mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030932
					],
					"speakerTitle": "Dottore"
				},
				{
					"id": 60030932,
					"content": "...Chết tiệt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030933
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 60030933,
					"content": "Nhưng thật không ngờ, cả Sandrone cũng bắt đầu quan tâm đến con người của thế giới này đấy. Tiếc quá, ta cứ tưởng sự ích kỷ chính là ưu điểm duy nhất còn sót lại trên người cô ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030934
					],
					"speakerTitle": "Dottore"
				},
				{
					"id": 60030934,
					"content": "Ngay cả Cục Thiết Kế Thí Nghiệm mà cũng phải đi bảo vệ, người như vậy thì làm được việc lớn gì chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030935
					],
					"speakerTitle": "Dottore"
				},
				{
					"id": 60030935,
					"content": "Việc bắt cóc con tin không phải là hành vi vinh quang gì. Hay là giờ ngươi cũng đã không còn sợ mất mặt nữa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030936
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60030936,
					"content": "Mất mặt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030937
					],
					"speakerTitle": "Dottore"
				},
				{
					"id": 60030937,
					"content": "Ta đang có hai viên Tủy Mặt Trăng trong tay, và viên còn thiếu cũng sắp được chế tạo xong. Bàn chuyện mất mặt với người sắp trở thành thần linh của thế giới mới à? Hài hước quá rồi đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030938
					],
					"speakerTitle": "Dottore"
				},
				{
					"id": 60030938,
					"content": "Ngươi hoàn toàn không xứng đáng sở hữu thánh vật đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030939
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60030939,
					"content": "Theo ta thấy, trên đời này còn có nhiều kẻ không đáng sống nữa kìa, nhưng ta vẫn nhân từ cho phép họ tồn tại đấy thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030940
					],
					"speakerTitle": "Dottore"
				},
				{
					"id": 60030940,
					"content": "Ngươi sẽ phải hối hận về những việc mình đã làm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030941
					]
				},
				{
					"id": 60030941,
					"content": "Vậy thì để xem các ngươi có bản lĩnh khiến người khác phải hối hận hay không rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dottore"
				}
			]
		},
