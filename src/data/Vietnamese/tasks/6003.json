			"dialogs": [
				{
					"id": 60030101,
					"content": "Có vẻ như mọi người đã tập trung đông đủ rồi nhỉ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60030102,
					"content": "#Đúng vậy, chúng tôi đã sẵn sàng rồi. Còn {NICKNAME} và Paimon thì sao? Tình trạng thế nào rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030103
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60030103,
					"content": "Tôi chuẩn bị xong rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030104,
						60030106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60030104,
					"content": "Tôi cũng đã chuẩn bị sẵn sàng rồi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030105
					]
				},
				{
					"id": 60030105,
					"content": "Tuyệt. Chúng ta bắt đầu vào vấn đề chính luôn thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030113
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60030113,
					"content": "Vậy thì, việc trước tiên là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030114
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60030114,
					"content": "Khoan đã!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030115
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 60030115,
					"content": "Có tiếng động...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030116
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60030116,
					"content": "Chúng tôi đã nghe thấy tiếng bước chân của anh. Dù cho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030117
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60030117,
					"content": "#Anh đã đến đây được một lúc rồi đấy. Anh đi theo {NICKNAME} đến đây sao? Nhưng dường như không có ác ý nào cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030118
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60030118,
					"content": "Vào đây đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030119
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60030119,
					"content": "Quả đúng như tôi dự đoán, phản ứng rất nhanh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030120
					],
					"speakerTitle": "Gediminas",
					"speakerSubtitle": "Cấp Dưới Của Arlecchino"
				},
				{
					"id": 60030120,
					"content": "Theo lệnh của quý cô Arlecchino, tôi đến đây để chuyển lời.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030121
					],
					"speakerTitle": "Gediminas",
					"speakerSubtitle": "Cấp Dưới Của Arlecchino"
				},
				{
					"id": 60030121,
					"content": "Việc Dottore giả vờ quay về Snezhnaya rõ ràng chỉ là cái cớ, nhưng hắn không hề quay lại Cục Thiết Kế Thí Nghiệm Kuuvahki, cũng không xuất hiện ở Thị Trấn Nasha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030122
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 60030122,
					"content": "Vậy nên hắn chỉ có thể ở phòng thí nghiệm nơi cực bắc. Hah, giờ mới hiểu tại sao hắn lại xin một khu vực riêng rồi... Thì ra là đã có kế hoạch từ trước!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030123
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 60030123,
					"content": "Hãy nói với họ rằng ta và Sandrone sẽ đi trước. Nếu họ cũng quan tâm đến diễn biến tiếp theo của vụ này thì hãy gặp nhau tại viện nghiên cứu ở cực bắc Nod-Krai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030124
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 60030124,
					"content": "Hai người họ đều là bạn thân của Columbina, nhưng trước khi hành động họ vẫn không quên chia sẻ thông tin... Quả thật rất cảm ơn sự giúp đỡ của Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030125
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60030125,
					"content": "Mặc dù Columbina đã rời khỏi tổ chức... Nhưng sự quan tâm của các vị Quan Chấp Hành đối với cô ấy đều là thật. Hơn nữa, theo tình hình hiện tại thì hành động của Dottore rất bí ẩn, chúng tôi buộc phải để tâm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030126
					],
					"speakerTitle": "Gediminas",
					"speakerSubtitle": "Cấp Dưới Của Arlecchino"
				},
				{
					"id": 60030126,
					"content": "Tuy chúng ta thường hay đối đầu với nhau, nhưng cũng chỉ vì lập trường khác biệt thôi. Chúng tôi vẫn luôn thấu hiểu tình người và đạo nghĩa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030127
					],
					"speakerTitle": "Gediminas",
					"speakerSubtitle": "Cấp Dưới Của Arlecchino"
				},
				{
					"id": 60030127,
					"content": "Các vị là bạn của Columbina, nên các vị có quyền được biết những chuyện này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030128
					],
					"speakerTitle": "Gediminas",
					"speakerSubtitle": "Cấp Dưới Của Arlecchino"
				},
				{
					"id": 60030128,
					"content": "Arlecchino quả nhiên rất biết phân tích tình thế, giúp chúng ta tiết kiệm được không ít công sức.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030129
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60030129,
					"content": "Tôi sẽ để bản đồ ở đây, nếu các vị quyết định đến viện nghiên cứu ở cực bắc thì xin hãy hết sức cẩn thận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030130
					],
					"speakerTitle": "Gediminas",
					"speakerSubtitle": "Cấp Dưới Của Arlecchino"
				},
				{
					"id": 60030130,
					"content": "Hãy nhớ rằng, ít nhất là ở Nod-Krai, những thuộc hạ của Arlecchino có thể là đồng đội của các vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030131
					],
					"speakerTitle": "Gediminas",
					"speakerSubtitle": "Cấp Dưới Của Arlecchino"
				},
				{
					"id": 60030131,
					"content": "Cảm ơn sự chu đáo của anh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030132
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60030132,
					"content": "Việc nên làm thôi. Vậy tôi xin cáo từ trước. Nếu cần gì thì hãy đến Cục Thiết Kế Thí Nghiệm Kuuvahki tìm chúng tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030133
					],
					"speakerTitle": "Gediminas",
					"speakerSubtitle": "Cấp Dưới Của Arlecchino"
				},
				{
					"id": 60030133,
					"content": "Dottore đã rời khỏi Cục Thiết Kế Thí Nghiệm Kuuvahki và đến viện nghiên cứu ở cực bắc sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60030134,
					"content": "Sandrone nói Dottore đã chuẩn bị từ trước, chẳng lẽ trước khi đến Nod-Krai là hắn đã có kế hoạch này rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030135
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60030135,
					"content": "Làm việc cho Nữ Hoàng có lẽ chỉ là nói dối mà thôi. Hoặc đơn giản hơn là chỉ bằng mặt không bằng lòng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030136
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60030136,
					"content": "Dottore hành sự quyết đoán, tác phong tàn nhẫn, rất khó đối phó. Chúng ta phải chuẩn bị sẵn sàng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030137
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60030137,
					"content": "Hiện tại, khó mà đoán được hành động tiếp theo của Dottore. Tôi đề nghị chia làm hai hướng, để lại một vài người canh giữ Thị Trấn Nasha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030138
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60030138,
					"content": "Hmm... Tuy rất muốn giúp đỡ, nhưng quả thực tôi không phải là người thích hợp cho việc đột nhập vào viện nghiên cứu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030152
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 60030152,
					"content": "Nhưng ít nhất hãy mang theo \"Vịt Bình Tĩnh\" đi! Có lẽ nó sẽ giúp ích được mọi người trong chiến đấu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030139
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 60030139,
					"content": "Ineffa có định ở lại bảo vệ Aino như mọi khi không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030140
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60030140,
					"content": "Kiểm tra logic hành động: Bảo vệ Aino. Mức độ ưu tiên: Cao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030141
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 60030141,
					"content": "Để đề phòng, tốt hơn hết là anh Varka cũng nên ở lại đây. Chuyện bên viện nghiên cứu cứ để chúng tôi lo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030142
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60030142,
					"content": "Thân là Kỵ Sĩ Bắc Phong, những lúc như thế này tôi nên ở tiền tuyến. Nhưng mà... Thôi được rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030143
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60030143,
					"content": "Vậy Thị Trấn Nasha cứ để tôi lo. Mọi người cũng phải hết sức cẩn thận nhé, nếu tình hình vượt ngoài tầm kiểm soát thì phải rút lui ngay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030144
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60030144,
					"content": "Jahoda cũng sẽ giúp đỡ. Khi tôi không có ở đây, công việc tình báo sẽ giao cho em ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030145
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60030145,
					"content": "Rõ thưa sếp. Mọi người phải an toàn trở về nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030146
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 60030146,
					"content": "Nhất định rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030147
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60030147,
					"content": "Đêm dài lắm mộng, chúng ta nên khởi hành sớm thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030148,
						60030149
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60030148,
					"content": "Tình hình lần này có thể sẽ rất nguy hiểm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030150
					]
				},
				{
					"id": 60030150,
					"content": "Đây là nhiệm vụ xâm nhập, lại còn là viện nghiên cứu nữa... Được rồi, nếu mọi người định chiến đấu một trận ác liệt thì tôi sẽ ở lại đây để giúp đỡ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030151
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60030151,
					"content": "#Tất cả chúng ta đều phải cố gắng hết sức. Trước khi đi, {F#cô}{M#cậu} còn việc gì cần làm không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030401,
						60030601
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60030401,
					"content": "Còn một vài chuyện...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030402
					]
				},
				{
					"id": 60030402,
					"content": "#Vậy đợi {F#cô}{M#cậu} chuẩn bị xong, chúng ta sẽ cùng nhau xuất phát.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60030601,
					"content": "Tôi có thể hành động bất cứ lúc nào!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030602
					]
				},
				{
					"id": 60030602,
					"content": "Vậy chúng ta hành động ngay thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60030603,
					"content": "Được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60030149,
					"content": "Paimon ở lại giúp mọi người nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030150
					]
				},
				{
					"id": 60030106,
					"content": "Ừm. Chúng ta xác nhận lại vấn đề một lần nữa nhé?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030107
					]
				},
				{
					"id": 60030107,
					"content": "Haha, hơi căng thẳng đúng không? Cũng khó nói, tất cả chúng ta đều lần đầu gặp phải chuyện như thế này mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030108
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60030108,
					"content": "#Vậy thì... Dạo trước Columbina vừa bị Dottore tấn công. Trong khoảnh khắc ngắn ngủi ấy, {F#cô}{M#cậu} đã thấy cô ấy biến mất vào trong hình bóng phản chiếu của mặt trăng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030109
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60030109,
					"content": "#Ừm, khi sự việc xảy ra, tất cả chúng tôi chỉ thấy Dottore xuất hiện và sử dụng một loại sức mạnh nào đó. Sau đó Columbina liền biến mất, và {F#cô}{M#cậu} cũng rơi từ trên không xuống biển.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030110
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60030110,
					"content": "Chúng ta phải cứu Columbina. Hơn nữa việc Dottore, một Quan Chấp Hành Fatui chiếm đoạt quyền năng của ba mặt trăng chắc chắn có mục đích của hắn. Chúng ta phải ngăn cản hắn lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030111
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60030111,
					"content": "Tìm lại Nguyệt Thần vốn là trách nhiệm của Dòng Dõi Sương Nguyệt chúng tôi. Tôi không ngờ là mọi người đều sẵn lòng giúp đỡ... Tôi xin thay mặt Dòng Dõi Sương Nguyệt cảm ơn các vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030112
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60030112,
					"content": "(Xóa)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030113
					]
				}
			]
		},
