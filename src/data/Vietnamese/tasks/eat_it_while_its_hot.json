			},
			"dialogs": [
				{
					"id": 205210101,
					"content": "Ăn cơm canh nóng hổi thì vẫn tốt hơn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210102
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210102,
					"content": "Cơm canh nóng hổi gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205210103
					]
				},
				{
					"id": 205210103,
					"content": "À, tôi đang nói đến Iris, người đã lên núi tuyết thám hiểm, nếu cô ấy có thể được ăn cơm canh nóng hổi thì tốt rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210104
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210104,
					"content": "Vì Iris lại muốn lập một đội thám hiểm, để chuẩn bị cho đợt thám hiểm này, cô ấy muốn tự mình lên núi lập trại, quan sát tình hình cụ thể rồi mới lên kế hoạch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210105
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210105,
					"content": "Trại quan sát của cô ấy không xa, gửi đồ tiếp tế đến đó cũng không khó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210106
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210106,
					"content": "Nhưng suy cho cùng cũng là dựng trại trong núi tuyết, nếu cô ấy có thể ăn được cơm canh nóng hổi thì sẽ càng có tinh thần hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210107
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210107,
					"content": "Nhưng tôi không dám lên núi một mình... bạn có thể giúp tôi gửi món \"Rau Củ Hầm Kem\" cho Iris không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210108,
						205210110
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210108,
					"content": "Cứ để tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205210109
					]
				},
				{
					"id": 205210109,
					"content": "Vậy thì nhờ bạn nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210113
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210113,
					"content": "Tôi vừa nấu xong món này, còn nóng hổi đó, bạn hãy tranh thủ gửi cho Iris, xung quanh lạnh như vậy, thức ăn nguội là không ăn được nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210114
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210114,
					"content": "Nhưng nếu gặp phải chuyện ngoài ý muốn, thức ăn không thể ăn nữa, thì cứ về tìm tôi, tôi sẽ làm lại cho bạn một phần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210110,
					"content": "Cô ấy ở chỗ nào?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205210111
					]
				},
				{
					"id": 205210111,
					"content": "Cô ấy nói trại quan sát của mình nằm ở sườn núi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210112
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210112,
					"content": "Nhà thám hiểm lão làng như cô ấy rất thận trọng, sẽ không tùy tiện đi lung tung vào núi tuyết cách quá xa doanh trại đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210113
					],
					"speakerTitle": "Harris"
				}
			]
		},
