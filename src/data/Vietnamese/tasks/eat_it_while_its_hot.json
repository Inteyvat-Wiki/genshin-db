			"dialogs": [
				{
					"id": 205210301,
					"content": "Gửi bạn phần Rau Củ Hầm Kem này.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205210302
					]
				},
				{
					"id": 205210302,
					"content": "Harris bảo bạn gửi đến đây à, cảm ơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210303
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 205210303,
					"content": "Ăn quen đồ ngon rồi, sau này phải gặm lương khô, chắc tôi ăn không nổi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210304
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 205210304,
					"content": "Ha ha ha, đùa thôi, tôi là Nhà Mạo Hiểm mà, lúc cần chịu khổ thì vẫn sẽ chịu được thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210305
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 205210305,
					"content": "Bạn vẫn tiếp tục tiến lên sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205210306
					]
				},
				{
					"id": 205210306,
					"content": "Đương nhiên, doanh trại này chỉ là điểm trung chuyển, chờ đến lúc thích hợp, tôi sẽ thử lập trại ở một số nơi xa hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210307
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 205210307,
					"content": "Đến lúc đó chắc chắn sẽ không còn cơ hội ăn cơm canh nóng hổi nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210308
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 205210308,
					"content": "Nhưng tôi sẽ không tiến vào bừa bãi, quan sát thêm một thời gian nữa, tôi sẽ trở về bản doanh, chờ lên kế hoạch cụ thể xong mới tính tiếp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210309
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 205210309,
					"content": "Cám ơn bạn đã gửi thức ăn cho tôi, những thứ này xem như là thù lao, bạn hãy nhận lấy nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iris"
				}
			]
