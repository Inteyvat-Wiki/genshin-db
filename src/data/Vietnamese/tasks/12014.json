				"points": []
			},
			"dialogs": [
				{
					"id": 120140101,
					"content": "Tôi muốn đợi thêm một chút, pháo hoa trong lòng tôi vẫn chưa kết thúc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140102
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140102,
					"content": "À, nếu như muốn nói chuyện thì cũng không thành vấn đề.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140103,
						120140108,
						120140115
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140103,
					"content": "Vậy tiếp theo cần phải làm gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120140104
					]
				},
				{
					"id": 120140104,
					"content": "Nhóm của Matsuzaka vẫn đang chờ tôi cùng đi tìm Siêu Mujina Youkai đó, chị Yoimiya không thể nói mà không giữ lời.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140105
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140105,
					"content": "Còn có cảm nghĩ của mọi người sau khi ngắm pháo hoa nữa, tôi cũng muốn tìm hiểu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140106
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140106,
					"content": "Những ngày tháng sau này, cần mọi người chiếu cố thêm rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140107
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140107,
					"content": "Sự chiếu cố của bạn và Paimon đối với tôi đương nhiên cũng không thể thiếu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140108,
					"content": "Đặt làm pháo hoa có đắt không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120140109
					]
				},
				{
					"id": 120140109,
					"content": "Nếu như là các bạn thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140110
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140110,
					"content": "Miễn phí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140111
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140111,
					"content": "Dẫu sao thì tôi cũng nhất mực muốn tặng cho các bạn, trên đường cũng làm phiền các bạn không ít. Hì hì, giờ thu phí nữa thì ngại lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140112
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140112,
					"content": "Thật ngại quá.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120140113
					]
				},
				{
					"id": 120140113,
					"content": "Đừng khách sáo, như vậy đi, xem như trao đổi, khi bạn tìm được người thân rồi thì hãy giới thiệu \"Tiệm Pháo Hoa Naganohara\" cho người đó nhé, như vậy thì tôi lại có thêm một khách hàng rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140114
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140114,
					"content": "Tôi cũng rất muốn gặp người thân mà bạn nói đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140115,
					"content": "Nếu như Hiệp Hội Tenryou đến làm phiền bạn nữa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120140116
					]
				},
				{
					"id": 120140116,
					"content": "Vậy thì làm một trận nữa thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140117
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140117,
					"content": "Ha ha, nói đùa thôi, tôi có nói rồi mà, gia đình tôi cũng hay có qua lại với Hiệp Hội Tenryou lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140118
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140118,
					"content": "Cùng lắm thì nhận lỗi, cười trừ, phạt hành chính chút đỉnh là xong thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140119
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140119,
					"content": "Nhưng các bạn cần cẩn thận nhé, khi gặp phải chuyện gì thì cũng đừng hành động lỗ mãng như tôi đó, hì hì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				}
			]
		}
	]
}