			"dialogs": [
				{
					"id": 740620101,
					"content": "Hai vị xin dừng bước. Nghe nói hai vị là người rảnh rỗi nhờ gì được nấy đúng không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620102,
						740620103
					],
					"speakerTitle": "Nakul"
				},
				{
					"id": 740620102,
					"content": "Đúng là có chuyện này.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620105
					]
				},
				{
					"id": 740620105,
					"content": "Khụ, thật ra trước đây có một cô bé mặc váy tím nhờ tôi chiếu cố hai vị nhiều hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620106
					],
					"speakerTitle": "Nakul"
				},
				{
					"id": 740620106,
					"content": "Tôi nghĩ nếu như hai vị nhờ gì cũng giúp, vậy thì cần gì tôi giúp đỡ nữa. Chi bằng nói hai vị hãy giúp đỡ tôi nhiều hơn mới đúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620107
					],
					"speakerTitle": "Nakul"
				},
				{
					"id": 740620107,
					"content": "Giúp đỡ thì được, nhưng không giảm giá nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620108
					]
				},
				{
					"id": 740620108,
					"content": "Cái này thì tôi biết. Dù có làm được hay không thì tôi cũng sẽ trả thù lao theo giá thị trường. Mora không dùng được ở đây, vậy thì dùng Phiếu Đặc Cách để thanh toán nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620109
					],
					"speakerTitle": "Nakul"
				},
				{
					"id": 740620109,
					"content": "Kết quả thế nào cũng được nhận thù lao sao? Có thật không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620110,
					"content": "Thật chứ. Chuyện này cũng rất khó khăn, cũng tại Nizami cả, nắm đấm thì lợi hại, nhưng lại dùng sai chỗ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620111
					],
					"speakerTitle": "Nakul"
				},
				{
					"id": 740620111,
					"content": "Tôi còn muốn ở lại đây tìm một nơi thích hợp để nghiên cứu học vấn. Tốt nhất là có giá sách, có bàn, có tấm bảng lớn để viết sách và dán tài liệu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620112
					],
					"speakerTitle": "Nakul"
				},
				{
					"id": 740620112,
					"content": "Hẳn là hai vị đã đoán được nơi mà tôi nghĩ tới là gì rồi đúng không? Nhưng chỗ đó không cho thuê, lý do là gì có hỏi thì cũng thế. Tôi thấy căn phòng đối diện có kết cấu tương tự, có thể dùng tạm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620113
					],
					"speakerTitle": "Nakul"
				},
				{
					"id": 740620113,
					"content": "Nhưng chỗ đó rất kỳ lạ, giống như bị người nào đó chiếm mất, lại còn ít khi mở cửa. Tôi chưa bao giờ gặp người đó, cũng chưa từng thấy cửa mở bao giờ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620114
					],
					"speakerTitle": "Nakul"
				},
				{
					"id": 740620114,
					"content": "Nên tôi đã nhờ Nizami làm người đại diện, anh ấy vốn là vệ sĩ mà tôi đã thuê, làm việc rất ổn. Nhưng anh ta nói chuyện với người đó không được, trao đổi thất bại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620115
					],
					"speakerTitle": "Nakul"
				},
				{
					"id": 740620115,
					"content": "Ừm... Cảm thấy hình như đàm phán không phải sở trường của anh ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620116,
					"content": "Đúng vậy. Anh ta ở bên ngoài đập cửa, còn bên trong thì quát ra. Đúng là khiến tôi phải bất ngờ mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620117,
						740620119
					],
					"speakerTitle": "Nakul"
				},
				{
					"id": 740620117,
					"content": "Chà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620118
					]
				},
				{
					"id": 740620118,
					"content": "Cái này không ăn nhập gì với đàm phán luôn á!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620121,
					"content": "Nên tôi mới muốn nhờ hai vị giúp tôi nói chuyện với người đó, để người đó đồng ý cho thuê không gian mình đang chiếm dụng. Giá cả trong vòng 54.000 Phiếu Đặc Cách là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620122
					],
					"speakerTitle": "Nakul"
				},
				{
					"id": 740620122,
					"content": "Tôi không mong là thành công đâu, nhưng tôi cũng muốn thử. Phiền hai vị nhé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nakul"
				},
				{
					"id": 740620119,
					"content": "Đúng là không chuyên nghiệp gì cả.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620120
					]
				},
				{
					"id": 740620120,
					"content": "Anh ấy vốn không phải chuyên gia trong vụ này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620103,
					"content": "Anh nghe ai nói thế?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620104
					]
				},
				{
					"id": 740620104,
					"content": "Cái này à... Nghe đồn, nghe đồn thôi ấy mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620105
					],
					"speakerTitle": "Nakul"
				}
			]
		},
