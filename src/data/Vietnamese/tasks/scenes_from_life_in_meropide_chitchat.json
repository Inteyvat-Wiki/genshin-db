			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ai Đó"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							4345.313,
							159.157,
							4639.87
						],
						"pointId": 4926
					},
					{
						"sceneId": 3,
						"position": [
							4345.289,
							158.024,
							4642.497
						],
						"pointId": 4927
					}
				]
			},
			"dialogs": [
				{
					"id": 740620301,
					"content": "(Nghe Nakul nói thì hình như người đó không hoan nghênh dân nước ngoài nhỉ? Có khi nào người đó cũng không thèm quan tâm tới chúng ta không?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620302,
					"content": "(Gõ cửa.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620303
					]
				},
				{
					"id": 740620303,
					"content": "Ai thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620304,
						740620306,
						740620309
					],
					"speakerTitle": "Ai Đó"
				},
				{
					"id": 740620304,
					"content": "Lữ khách vô danh, là nhà mạo hiểm chu du khắp các quốc gia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620305
					]
				},
				{
					"id": 740620305,
					"content": "...Nơi này biến thành điểm tham quan từ lúc nào thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620312
					],
					"speakerTitle": "Ai Đó"
				},
				{
					"id": 740620312,
					"content": "#{NICKNAME}, nghiêm túc một chút nào. Đừng quên mục đích của chúng ta đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620313,
						740620378
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620313,
					"content": "Chúng tôi được người khác ủy thác đến đây để thương lượng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620314
					]
				},
				{
					"id": 740620314,
					"content": "Chúng tôi được người khác ủy thác đến, không biết anh có thể cho thuê căn phòng này không? Đương nhiên, người ủy thác sẽ dùng Phiếu Đặc Cách để chi trả!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620315,
					"content": "Lúc trước cũng xảy ra vài chuyện tương tự thế... Chính là cái người nói chuyện õng ẹo kia cử các người tới à.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620316
					],
					"speakerTitle": "Ai Đó"
				},
				{
					"id": 740620316,
					"content": "Thôi được, nể tình anh ta kiên nhẫn như thế... Các người nói cái giá đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620317
					],
					"speakerTitle": "Ai Đó"
				},
				{
					"id": 740620317,
					"content": "(Tốt quá, xem ra có thể thương lượng rồi.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620318,
					"content": "(Nakul có nói mức giá chấp nhận được, chúng ta nên hỏi thẳng giá chót ngay từ đầu hay thử ép giá nhỉ?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620319,
						740620356
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620319,
					"content": "(Cứ nói giá chót ra đi.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620320
					]
				},
				{
					"id": 740620320,
					"content": "Được rồi, giá mong muốn của người ủy thác là 54.000 Phiếu Đặc Cách. Tôi cảm thấy cái giá này khá hời đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620321,
					"content": "54.000? So với cái giá mà tên điên đập cửa lần trước đưa ra... chỉ tăng lên có một chút thôi. Đúng là keo kiệt mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620322
					],
					"speakerTitle": "Ai Đó"
				},
				{
					"id": 740620322,
					"content": "Thế mà còn ít á? Tôi thấy nhiều lắm rồi mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620323,
					"content": "Các người không biết gì cả. Có biết Carranza không? Anh ta hào phóng hơn nhiều, anh ấy chấp nhận chi... 108.000 đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620324
					],
					"speakerTitle": "Ai Đó"
				},
				{
					"id": 740620324,
					"content": "Nhiều tới vậy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620325,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620326
					],
					"speakerTitle": "Ai Đó"
				},
				{
					"id": 740620326,
					"content": "...Đương, đương nhiên là thật rồi. Trông tôi giống người hay nói dối à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620327
					],
					"speakerTitle": "Ai Đó"
				},
				{
					"id": 740620327,
					"content": "Thì chúng tôi đã thấy được anh đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620328
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620328,
					"content": "(Nghe giọng rụt rè lắm, chắc anh ta chỉ bịa chuyện để lừa chúng ta thôi.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620329,
					"content": "#({NICKNAME}, tiếp theo chúng ta phải làm thế nào đây?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620330,
						740620340
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620330,
					"content": "(Chúng ta chỉ có bấy nhiêu, cho anh ta chọn thôi.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620331
					]
				},
				{
					"id": 740620331,
					"content": "Ngay từ đầu chúng tôi đã nói là chỉ có 54.000 rồi. Đòi đến 108.000 thì quá đáng quá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620332
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620332,
					"content": "Nếu không đồng ý thì chúng tôi cũng chẳng còn cách nào khác, chỉ đành từ bỏ thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620333
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620333,
					"content": "Để lâu hơn nữa là giá sẽ tăng lên đấy... Lần sau các người tới thì phải mang thêm rất nhiều phiếu mới thuê được đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620334
					],
					"speakerTitle": "Ai Đó"
				},
				{
					"id": 740620334,
					"content": "Tôi quan sát thị trường tốt lắm, nên sẽ không đồng ý dễ dàng như thế đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620335
					],
					"speakerTitle": "Ai Đó"
				},
				{
					"id": 740620335,
					"content": "Anh dựa vào đâu mà nói vậy chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620336
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620336,
					"content": "Đương nhiên là dựa vào kinh nghiệm rồi! Hai lần trước đã cho tôi biết là cứ không đồng ý thì giá sẽ tăng cao thêm. Đạo lý đơn giản mà?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620337
					],
					"speakerTitle": "Ai Đó"
				},
				{
					"id": 740620337,
					"content": "Cái đạo lý tào lao gì thế này!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620338
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620338,
					"content": "Trẻ con thì đương nhiên không hiểu rồi. Tóm lại là chưa đến lúc phải đồng ý đâu, đi đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620339
					],
					"speakerTitle": "Ai Đó"
				},
				{
					"id": 740620339,
					"content": "#Ơ... Xem ra anh ta không đồng ý rồi. {NICKNAME}, chúng ta về báo cho Nakul thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620340,
					"content": "(Muốn bẫy chúng ta rồi. Vậy thì lừa anh ta thôi.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620341
					]
				},
				{
					"id": 740620341,
					"content": "Hừm... Không ngờ lại có Carranza chen vào. Nhìn kiểu gì cũng thấy mình không bằng người ta rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620342
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620342,
					"content": "#{NICKNAME}, chúng ta về thôi. Nói cho Nakul biết là giá này thấp quá, người ta không thèm để ý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620343
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620343,
					"content": "Thế thì chúc anh và Carranza hợp tác vui vẻ nhé. Chúng tôi về trước đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620344
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620344,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620345
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620345,
					"content": "...Hả? Vậy là đi rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620346
					],
					"speakerTitle": "Ai Đó"
				},
				{
					"id": 740620346,
					"content": "Này, còn ở đó không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620347
					],
					"speakerTitle": "Ai Đó"
				},
				{
					"id": 740620347,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620348
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620348,
					"content": "Này! Đừng đi vội mà, quay lại đi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620349
					],
					"speakerTitle": "Ai Đó"
				},
				{
					"id": 740620349,
					"content": "Chúng tôi đi ra tận kia thì nghe thấy anh gọi. Sao nào, muốn nhờ chúng tôi gọi Carranza cho anh à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620350
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620350,
					"content": "Sao tôi lại có thể nhờ vả người khác như vậy chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620351
					],
					"speakerTitle": "Ai Đó"
				},
				{
					"id": 740620351,
					"content": "#Không phiền đâu, tiện đường mà, đúng không {NICKNAME}? Chỉ là chuyện nhỏ thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620352
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620352,
					"content": "Khụ... Mấy người khá đấy. Cái giá ban nãy còn tính không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620353
					],
					"speakerTitle": "Ai Đó"
				},
				{
					"id": 740620353,
					"content": "Giờ thì vẫn còn, nhưng lát nữa thì không biết.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620354
					]
				},
				{
					"id": 740620354,
					"content": "Được rồi, tôi chịu giá này. Nhưng người ủy thác phải tự mình tới đây nói chuyện mới được nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620355
					],
					"speakerTitle": "Ai Đó"
				},
				{
					"id": 740620355,
					"content": "#Được thôi! {NICKNAME}, chúng ta mau quay về báo cho Nakul biết đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620356,
					"content": "(Ra sức ép giá!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620357
					]
				},
				{
					"id": 740620357,
					"content": "Vậy... Vậy thì 27.000 Phiếu Đặc Cách nhé! Thấy thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620358
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620358,
					"content": "27.000?! Đùa tôi à? Sao còn thấp hơn cả lần trước thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620359
					],
					"speakerTitle": "Ai Đó"
				},
				{
					"id": 740620359,
					"content": "Tên điên đập cửa lần trước báo giá cao hơn mà tôi còn không đồng ý, giờ sao có thể chịu mức giá thấp hơn thế này chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620360
					],
					"speakerTitle": "Ai Đó"
				},
				{
					"id": 740620360,
					"content": "#({NICKNAME}, làm sao đây? Chúng ta vẫn giữ nguyên con số này à?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620361,
						740620370
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620361,
					"content": "Giá thị trường đang giảm, sau này sẽ giảm mạnh hơn nữa đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620362
					]
				},
				{
					"id": 740620362,
					"content": "Thật hay giả thế? Chẳng phải Nakul rất muốn thuê căn phòng này sao? Chắc chắn anh ta sẽ chấp nhận trả giá cao hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620363
					],
					"speakerTitle": "Ai Đó"
				},
				{
					"id": 740620363,
					"content": "Dù sao thì kiên nhẫn của con người cũng có hạn mà! Trước đây bị từ chối hai lần rồi, nói không chừng anh ta đã từ bỏ ý định rồi đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620364
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620364,
					"content": "Lần này ra nửa giá, nói không chừng lần sau sẽ... À! Nói không chừng sẽ không có lần sau đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620365
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620365,
					"content": "...Để tôi suy nghĩ cái đã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620366
					],
					"speakerTitle": "Ai Đó"
				},
				{
					"id": 740620366,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620367
					],
					"speakerTitle": "Ai Đó"
				},
				{
					"id": 740620367,
					"content": "Này! Anh suy nghĩ xong chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620368
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620368,
					"content": "Được rồi, tôi chịu giá này. Nhưng người ủy thác phải tự mình tới đây nói chuyện mới được nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620369
					],
					"speakerTitle": "Ai Đó"
				},
				{
					"id": 740620369,
					"content": "#Được thôi! {NICKNAME}, chúng ta mau quay về báo cho Nakul biết đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620370,
					"content": "(Nâng lên đến mức giá mong muốn của người ủy thác đi.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620371
					]
				},
				{
					"id": 740620371,
					"content": "Ừm... Vậy 54.000 Phiếu Đặc Cách thì sao? Giá đã gấp đôi rồi đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620372
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620372,
					"content": "54.000? So với cái giá mà tên điên đập cửa lần trước đưa ra... chỉ tăng lên có một chút thôi. Đúng là keo kiệt mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620373
					],
					"speakerTitle": "Ai Đó"
				},
				{
					"id": 740620373,
					"content": "Mấy người ra giá lúc cao lúc thấp... Tôi thấy chắc chắn là vẫn còn tăng lên được nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620374
					],
					"speakerTitle": "Ai Đó"
				},
				{
					"id": 740620374,
					"content": "Để lâu hơn nữa là giá sẽ tăng lên đấy... Lần sau các người tới thì phải mang thêm rất nhiều phiếu mới thuê được đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620375
					],
					"speakerTitle": "Ai Đó"
				},
				{
					"id": 740620375,
					"content": "Tôi quan sát thị trường tốt lắm, nên sẽ không đồng ý dễ dàng như thế đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620376
					],
					"speakerTitle": "Ai Đó"
				},
				{
					"id": 740620376,
					"content": "Các người đi đi. Tôi sẽ không đồng ý, ít nhất lần này tôi sẽ không đồng ý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620377
					],
					"speakerTitle": "Ai Đó"
				},
				{
					"id": 740620377,
					"content": "#Ơ... Xem ra anh ta không đồng ý rồi. {NICKNAME}, chúng ta về báo cho Nakul thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620378,
					"content": "(Thử mở cửa.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620379
					]
				},
				{
					"id": 740620379,
					"content": "...Này! Định làm cái gì đấy!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620380
					],
					"speakerTitle": "Ai Đó"
				},
				{
					"id": 740620380,
					"content": "Thì muốn mở cửa đó? Cách một cánh cửa thì sao thấy được cảm xúc của đối phương? Gặp trực tiếp sẽ dễ bàn bạc hơn mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620381
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620381,
					"content": "Hơn nữa, phòng của Pháo Đài Meropide không thuộc sở hữu của bất kỳ ai. Nếu chỉ là ở tạm thì chúng tôi cũng có thể vào trong mới phải.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620382
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620382,
					"content": "Không được! Các người sẽ không hiểu đằng sau cánh cửa ẩn giấu thứ gì đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620383
					],
					"speakerTitle": "Ai Đó"
				},
				{
					"id": 740620383,
					"content": "À, ý tôi là... Tôi mà đối mặt với người khác thì sẽ căng thẳng lắm. Cứ nói chuyện như vậy đi. Rốt cuộc các người tới đây có mục đích gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620384,
						740620449
					],
					"speakerTitle": "Ai Đó"
				},
				{
					"id": 740620384,
					"content": "Chúng tôi được người khác ủy thác đến đây để thương lượng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620385
					]
				},
				{
					"id": 740620385,
					"content": "Ừm, chúng tôi được ủy thác đến đây để đàm phán. Không biết anh có ý định cho thuê phòng này không? Đương nhiên là chúng tôi sẽ trả bằng Phiếu Đặc Cách!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620386
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620386,
					"content": "Lúc trước cũng xảy ra vài chuyện tương tự thế... Chính là cái người nói chuyện õng ẹo kia cử các người tới à.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620387
					],
					"speakerTitle": "Ai Đó"
				},
				{
					"id": 740620387,
					"content": "Thôi được, nể tình anh ta kiên nhẫn như thế... Các người nói cái giá đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620388
					],
					"speakerTitle": "Ai Đó"
				},
				{
					"id": 740620388,
					"content": "(Tốt quá, xem ra có thể thương lượng rồi.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620389
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620389,
					"content": "(Nakul có nói mức giá chấp nhận được, chúng ta nên hỏi thẳng giá chót ngay từ đầu hay thử ép giá nhỉ?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620390,
						740620427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620390,
					"content": "(Cứ nói giá chót ra đi.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620391
					]
				},
				{
					"id": 740620391,
					"content": "Được rồi, giá mong muốn của người ủy thác là 54.000 Phiếu Đặc Cách. Tôi cảm thấy cái giá này khá hời đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620392
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620392,
					"content": "54.000? So với cái giá mà tên điên đập cửa lần trước đưa ra... chỉ tăng lên có một chút thôi. Đúng là keo kiệt mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620393
					],
					"speakerTitle": "Ai Đó"
				},
				{
					"id": 740620393,
					"content": "Thế mà còn ít á? Tôi thấy nhiều lắm rồi mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620394
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620394,
					"content": "Các người không biết gì cả. Có biết Carranza không? Anh ta hào phóng hơn nhiều, anh ấy chấp nhận chi... 108.000 đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620395
					],
					"speakerTitle": "Ai Đó"
				},
				{
					"id": 740620395,
					"content": "Nhiều tới vậy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620396
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620396,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620397
					],
					"speakerTitle": "Ai Đó"
				},
				{
					"id": 740620397,
					"content": "...Đương, đương nhiên là thật rồi. Trông tôi giống người hay nói dối à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620398
					],
					"speakerTitle": "Ai Đó"
				},
				{
					"id": 740620398,
					"content": "Thì chúng tôi đã thấy được anh đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620399
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620399,
					"content": "(Nghe giọng rụt rè lắm, chắc anh ta chỉ bịa chuyện để lừa chúng ta thôi.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620400
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620400,
					"content": "#({NICKNAME}, tiếp theo chúng ta phải làm thế nào đây?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620401,
						740620411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620401,
					"content": "(Chúng ta chỉ có bấy nhiêu, cho anh ta chọn thôi.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620402
					]
				},
				{
					"id": 740620402,
					"content": "Ngay từ đầu chúng tôi đã nói là chỉ có 54.000 rồi. Đòi đến 108.000 thì quá đáng quá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620403,
					"content": "Nếu không đồng ý thì chúng tôi cũng chẳng còn cách nào khác, chỉ đành từ bỏ thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620404,
					"content": "Để lâu hơn nữa là giá sẽ tăng lên đấy... Lần sau các người tới thì phải mang thêm rất nhiều phiếu mới thuê được đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620405
					],
					"speakerTitle": "Ai Đó"
				},
				{
					"id": 740620405,
					"content": "Tôi quan sát thị trường tốt lắm, nên sẽ không đồng ý dễ dàng như thế đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620406
					],
					"speakerTitle": "Ai Đó"
				},
				{
					"id": 740620406,
					"content": "Anh dựa vào đâu mà nói vậy chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620407,
					"content": "Đương nhiên là dựa vào kinh nghiệm rồi! Hai lần trước đã cho tôi biết là cứ không đồng ý thì giá sẽ tăng cao thêm. Đạo lý đơn giản mà?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620408
					],
					"speakerTitle": "Ai Đó"
				},
				{
					"id": 740620408,
					"content": "Cái đạo lý tào lao gì thế này!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620409,
					"content": "Trẻ con thì đương nhiên không hiểu rồi. Tóm lại là chưa đến lúc phải đồng ý đâu, đi đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620410
					],
					"speakerTitle": "Ai Đó"
				},
				{
					"id": 740620410,
					"content": "#Ơ... Xem ra anh ta không đồng ý rồi. {NICKNAME}, chúng ta về báo cho Nakul thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620411,
					"content": "(Muốn bẫy chúng ta rồi. Vậy thì lừa anh ta thôi.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620412
					]
				},
				{
					"id": 740620412,
					"content": "Hừm... Không ngờ lại có Carranza chen vào. Nhìn kiểu gì cũng thấy mình không bằng người ta rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620413,
					"content": "#{NICKNAME}, chúng ta về thôi. Nói cho Nakul biết là giá này thấp quá, người ta không thèm để ý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620414,
					"content": "Thế thì chúc anh và Carranza hợp tác vui vẻ nhé. Chúng tôi về trước đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620415,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620416,
					"content": "...Hả? Vậy là đi rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620417
					],
					"speakerTitle": "Ai Đó"
				},
				{
					"id": 740620417,
					"content": "Này, còn ở đó không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620418
					],
					"speakerTitle": "Ai Đó"
				},
				{
					"id": 740620418,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620419,
					"content": "Này! Đừng đi vội mà, quay lại đi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620420
					],
					"speakerTitle": "Ai Đó"
				},
				{
					"id": 740620420,
					"content": "Chúng tôi đi ra tận kia thì nghe thấy anh gọi. Sao nào, muốn nhờ chúng tôi gọi Carranza cho anh à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620421,
					"content": "Sao tôi lại có thể nhờ vả người khác như vậy chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620422
					],
					"speakerTitle": "Ai Đó"
				},
				{
					"id": 740620422,
					"content": "#Không phiền đâu, tiện đường mà, đúng không {NICKNAME}? Chỉ là chuyện nhỏ thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620423,
					"content": "Khụ... Mấy người khá đấy. Cái giá ban nãy còn tính không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620424
					],
					"speakerTitle": "Ai Đó"
				},
				{
					"id": 740620424,
					"content": "Giờ thì vẫn còn, nhưng lát nữa thì không biết.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620425
					]
				},
				{
					"id": 740620425,
					"content": "Được rồi, tôi chịu giá này. Nhưng người ủy thác phải tự mình tới đây nói chuyện mới được nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620426
					],
					"speakerTitle": "Ai Đó"
				},
				{
					"id": 740620426,
					"content": "#Được thôi! {NICKNAME}, chúng ta mau quay về báo cho Nakul biết đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620427,
					"content": "(Ra sức ép giá!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620428
					]
				},
				{
					"id": 740620428,
					"content": "Vậy... Vậy thì 27.000 Phiếu Đặc Cách nhé! Thấy thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620429
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620429,
					"content": "27.000?! Đùa tôi à? Sao còn thấp hơn cả lần trước thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620430
					],
					"speakerTitle": "Ai Đó"
				},
				{
					"id": 740620430,
					"content": "Tên điên đập cửa lần trước báo giá cao hơn mà tôi còn không đồng ý, giờ sao có thể chịu mức giá thấp hơn thế này chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620431
					],
					"speakerTitle": "Ai Đó"
				},
				{
					"id": 740620431,
					"content": "#({NICKNAME}, làm sao đây? Chúng ta vẫn giữ nguyên con số này à?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620432,
						740620441
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620432,
					"content": "Giá thị trường đang giảm, sau này sẽ giảm mạnh hơn nữa đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620433
					]
				},
				{
					"id": 740620433,
					"content": "Thật hay giả thế? Chẳng phải Nakul rất muốn thuê căn phòng này sao? Chắc chắn anh ta sẽ chấp nhận trả giá cao hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620434
					],
					"speakerTitle": "Ai Đó"
				},
				{
					"id": 740620434,
					"content": "Dù sao thì kiên nhẫn của con người cũng có hạn mà! Trước đây bị từ chối hai lần rồi, nói không chừng anh ta đã từ bỏ ý định rồi đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620435
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620435,
					"content": "Lần này ra nửa giá, nói không chừng lần sau sẽ... À! Nói không chừng sẽ không có lần sau đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620436
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620436,
					"content": "...Để tôi suy nghĩ cái đã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620437
					],
					"speakerTitle": "Ai Đó"
				},
				{
					"id": 740620437,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620438
					],
					"speakerTitle": "Ai Đó"
				},
				{
					"id": 740620438,
					"content": "Này! Anh suy nghĩ xong chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620439
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620439,
					"content": "Được rồi, tôi chịu giá này. Nhưng người ủy thác phải tự mình tới đây nói chuyện mới được nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620440
					],
					"speakerTitle": "Ai Đó"
				},
				{
					"id": 740620440,
					"content": "#Được thôi! {NICKNAME}, chúng ta mau quay về báo cho Nakul biết đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620441,
					"content": "(Nâng lên đến mức giá mong muốn của người ủy thác đi.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620442
					]
				},
				{
					"id": 740620442,
					"content": "Ừm... Vậy 54.000 Phiếu Đặc Cách thì sao? Giá đã gấp đôi rồi đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620443
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620443,
					"content": "54.000? So với cái giá mà tên điên đập cửa lần trước đưa ra... chỉ tăng lên có một chút thôi. Đúng là keo kiệt mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620444
					],
					"speakerTitle": "Ai Đó"
				},
				{
					"id": 740620444,
					"content": "Mấy người ra giá lúc cao lúc thấp... Tôi thấy chắc chắn là vẫn còn tăng lên được nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620445
					],
					"speakerTitle": "Ai Đó"
				},
				{
					"id": 740620445,
					"content": "Để lâu hơn nữa là giá sẽ tăng lên đấy... Lần sau các người tới thì phải mang thêm rất nhiều phiếu mới thuê được đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620446
					],
					"speakerTitle": "Ai Đó"
				},
				{
					"id": 740620446,
					"content": "Tôi quan sát thị trường tốt lắm, nên sẽ không đồng ý dễ dàng như thế đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620447
					],
					"speakerTitle": "Ai Đó"
				},
				{
					"id": 740620447,
					"content": "Các người đi đi. Tôi sẽ không đồng ý, ít nhất lần này tôi sẽ không đồng ý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620448
					],
					"speakerTitle": "Ai Đó"
				},
				{
					"id": 740620448,
					"content": "#Ơ... Xem ra anh ta không đồng ý rồi. {NICKNAME}, chúng ta về báo cho Nakul thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620449,
					"content": "(Tiếp tục thử mở cửa.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620450
					]
				},
				{
					"id": 740620450,
					"content": "Trời ơi! Sao còn chưa chịu dừng lại chứ? Tôi nói rồi, mấy người không biết sau cánh cửa sẽ ẩn giấu thứ gì đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620451
					],
					"speakerTitle": "Ai Đó"
				},
				{
					"id": 740620451,
					"content": "Không mặt đối mặt thì sao chúng tôi biết anh là thật không chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620452
					]
				},
				{
					"id": 740620452,
					"content": "Thì đương nhiên là thật rồi... Với lại tôi cũng có biết các người có phải thật không đâu. Nhưng chúng ta vẫn trao đổi bình thường đấy thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620453,
						740620455
					],
					"speakerTitle": "Ai Đó"
				},
				{
					"id": 740620453,
					"content": "Tôi có thể véo má Paimon. Paimon ấy thật đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620454
					]
				},
				{
					"id": 740620454,
					"content": "Hai người có thể dàn dựng với nhau mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620458
					],
					"speakerTitle": "Ai Đó"
				},
				{
					"id": 740620458,
					"content": "Dù sao thì tôi cũng sẽ không mở cửa đâu, các người đừng làm chuyện như thế nữa nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620459
					],
					"speakerTitle": "Ai Đó"
				},
				{
					"id": 740620459,
					"content": "Haiz... Nhưng chúng tôi được người ta ủy thác đến đàm phán mà. Hy vọng anh có thể cho thuê căn phòng này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620460
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620460,
					"content": "Vậy thì bỏ cuộc đi. Chỉ một mình tôi làm bạn với bóng tối là đủ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620461
					],
					"speakerTitle": "Ai Đó"
				},
				{
					"id": 740620461,
					"content": "Từ nãy tới giờ cứ nói bóng tối bóng tối, rốt cuộc nó là cái gì chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620462
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620462,
					"content": "Trẻ con thì sẽ không hiểu đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620463
					],
					"speakerTitle": "Ai Đó"
				},
				{
					"id": 740620463,
					"content": "Hừ, tôi chỉ thấy anh giả bộ bí ẩn để lừa nhau thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620464
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620464,
					"content": "Haha, cũng có thể. Nhưng tôi đã nói hết rồi, tôi sẽ không mở cửa, cũng không đồng ý cho thuê phòng. Các người về cho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620465
					],
					"speakerTitle": "Ai Đó"
				},
				{
					"id": 740620465,
					"content": "Âm thanh sau cánh cửa đã biến mất.\\nChờ một lúc gõ cửa thêm vài lần cũng không có lời đáp lại nào. Cứ như ngay từ đầu đã không có ai tồn tại vậy.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740620466
					]
				},
				{
					"id": 740620466,
					"content": "Hình như anh ta lơ chúng ta rồi... Có phải chúng ta đã phá hỏng ủy thác rồi không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620467
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620467,
					"content": "Hừm, chúng ta cứ quay về báo lại cho Nakul trước đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620455,
					"content": "Có thể tôi chỉ là nhân vật trong mơ của ai đó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620456
					]
				},
				{
					"id": 740620456,
					"content": "Đây là giấc mơ của tôi ư? Tôi nghe thấy giọng nói của các người... đang nói chuyện với một cô bé hoạt bát nào đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620457
					],
					"speakerTitle": "Ai Đó"
				},
				{
					"id": 740620457,
					"content": "#Cũng có thể là giấc mơ của tôi chăng? Nếu vậy thì... sau khi tỉnh lại phát hiện {NICKNAME} vẫn ở bên cạnh thì tốt biết mấy. Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620458
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620306,
					"content": "Đừng hỏi tôi là ai, cũng đừng hỏi tôi từ đâu tới đây.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620307
					]
				},
				{
					"id": 740620307,
					"content": "Hả?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620308
					],
					"speakerTitle": "Ai Đó"
				},
				{
					"id": 740620308,
					"content": "(Làm cái gì thế? Nói như vậy sẽ làm vấn đề thêm trầm trọng đó!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740620309,
					"content": "Là Melusine.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620310
					]
				},
				{
					"id": 740620310,
					"content": "#{M#Giọng nói này là của Melusine sao? Thế thì tôi là Hải Thú Bồng Bềnh đấy!}{F#Tôi không có bệnh, tôi rất ổn, đừng có tới gần tôi.}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620311
					],
					"speakerTitle": "Ai Đó"
				},
				{
					"id": 740620311,
					"content": "(Tự xưng là Melusine thì sượng quá!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620312
					],
					"speakerTitle": "Paimon"
				}
			]
