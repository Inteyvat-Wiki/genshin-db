			"dialogs": [
				{
					"id": 740620201,
					"content": "Nếu lúc trước không chọc giận Carranza thì tốt rồi, không chừng bây giờ nói chuyện với anh ta sẽ dễ dàng hơn. Haiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nakul"
				}
			]
		},
		{
