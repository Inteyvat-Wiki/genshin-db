			"dialogs": [
				{
					"id": 40190201,
					"content": "Đoán xem lá tiếp theo là gì nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190202
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 40190202,
					"content": "Hừm... Mèo răng sứt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190203
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 40190203,
					"content": "A, là hai vị sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190204
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 40190204,
					"content": "#{NICKNAME}, Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190205
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 40190205,
					"content": "Xin chào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190206
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 40190206,
					"content": "Xem ra Freminet sắp khỏe hẳn rồi nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190207,
					"content": "Ừm, cũng nhờ mọi người đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190208
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 40190208,
					"content": "À! Tôi... cũng đã lấy hết can đảm ra để cảm ơn tiểu thư Clorinde rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190209
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 40190209,
					"content": "Chà, vậy cô ấy phản ứng thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190210,
					"content": "Cô ấy nói không cần cảm ơn... Hình như cô ấy thấy cứu người không phải chuyện gì to tát, bảo tôi đừng nghĩ nhiều quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190211
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 40190211,
					"content": "Cô ấy không muốn em phải thấy áp lực về chuyện này. Quả thật không nên để tâm quá nhiều thì tốt hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190212
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 40190212,
					"content": "Ừm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190213
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 40190213,
					"content": "À này! Chúng tôi đã quay về Viện Ca Kịch, còn gặp được Arlecchino ở đó nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190214,
					"content": "Vậy sao? \"Cha\" có nói gì với hai vị không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190215
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 40190215,
					"content": "Nói một vài điều kỳ lạ, còn nói là mong chờ ngày được hợp tác với chúng tôi nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190216,
					"content": "Bất ngờ thật.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190217
					]
				},
				{
					"id": 40190217,
					"content": "Thái độ của \"Cha\" với hai vị tốt hơn tôi nghĩ đó... Tốt quá rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190218
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 40190218,
					"content": "#{NICKNAME}, {M#cậu}{F#cô} phải tin \"Cha\", vì cha cũng có trách nhiệm riêng của mình. Khi cần thiết, cha sẽ kết nối mọi nguồn lực có thể dùng được, bao gồm cả {M#cậu}{F#cô}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190219
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 40190219,
					"content": "Ừm, \"Cha\" rất giỏi và rất đáng tin cậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190220
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 40190220,
					"content": "À, nói mới nhớ. Cô ấy còn nói Lyney có hơi tự cao, đôi khi phải học cách nhờ vả người khác nữa đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190221,
					"content": "Ừm... Tôi biết rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190222
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 40190222,
					"content": "Quả nhiên là \"Cha\" sẽ nói vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190223
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 40190223,
					"content": "Này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190224
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 40190224,
					"content": "Hai vị sẽ ở lại đây vài hôm sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190225
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 40190225,
					"content": "Chắc vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190226,
					"content": "Được, vậy chúng ta có thể mở tiệc trà rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190227
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 40190227,
					"content": "Thật à? Tôi muốn ăn bánh kem tiếp nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190228,
					"content": "Vậy là hai vị đã được ăn bánh ngon ở trên đó rồi sao. Hmm, thích thật đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190229
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 40190229,
					"content": "Lần tới hãy cùng chúng tôi uống trà và ăn bánh nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lynette"
				}
			]
		},
