					"nextDialogs": [
						40190409
					],
					"speakerTitle": "Cuistot"
				},
				{
					"id": 40190409,
					"content": "Ừm, tôi cũng vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190410
					],
					"speakerTitle": "Laverune"
				},
				{
					"id": 40190410,
					"content": "Mấy hôm nay tôi cũng bị điều đến nhà ăn để giúp việc, khi nãy làm việc Cuistot còn tự mình lẩm bẩm với mấy củ cà rốt: \"Hai người đó không sao chứ? Còn sống không ta?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190411
					],
					"speakerTitle": "Laverune"
				},
				{
					"id": 40190411,
					"content": "Mấy lúc đó tôi đành nói: \"Không sao đâu, chắc là đang ngồi uống nước ngắm cảnh ở đâu đó rồi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190412
					],
					"speakerTitle": "Laverune"
				},
				{
					"id": 40190412,
					"content": "#Haiz! Quan tâm bạn tù một chút thì có sao? {M#Cậu ấy}{F#Cô ấy} thích nghe tôi kể chuyện như vậy mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190413
					],
					"speakerTitle": "Cuistot"
				},
				{
					"id": 40190413,
					"content": "Hai người này... còn nhiệt tình và có tình nghĩa hơn tôi nghĩ đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190414,
						40190415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190414,
					"content": "Dạo này cơm phúc lợi chắc là ngon lắm nhỉ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190416
					]
				},
				{
					"id": 40190416,
					"content": "...Được rồi, nhớ là phải ăn nhiều vào đấy nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cuistot"
				},
				{
					"id": 40190415,
					"content": "Có hai anh giúp đỡ, nhà ăn chắc chắn rất ngon lành.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190416
