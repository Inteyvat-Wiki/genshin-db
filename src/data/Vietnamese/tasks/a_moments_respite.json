					"id": 40190602,
					"content": "Cảm thấy nhẹ nhõm hơn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190603
					]
				},
				{
					"id": 40190603,
					"content": "Đúng vậy, nhưng chúng ta đâu có làm gì xấu, nên lúc nào cũng phải nhẹ nhõm mới đúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190604,
					"content": "Có cảm giác lấy lại được tự do.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190605
					]
				},
				{
					"id": 40190605,
					"content": "Ừm! Cảm giác tự do thật là đặc biệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190606,
					"content": "Paimon có gì muốn nói không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190607
					]
				},
				{
					"id": 40190607,
					"content": "Hả? Sao biết hay vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190608,
					"content": "Vì bình thường Paimon sẽ ngủ liền mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190609
					]
				},
				{
					"id": 40190609,
					"content": "Này, tôi đâu có như thế! Thôi được... Tôi muốn nói là... thật ra chúng ta cũng rất lợi hại nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190610,
					"content": "Nhìn xem, chúng ta đã đi qua bao nhiêu nơi, quen biết bao nhiêu người. Không ngừng khám phá... không ngừng làm quen những người bạn mới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190611,
					"content": "Thế giới này có bao nhiêu rắc rối, còn chúng ta thì chỉ có hai người, thế mà mọi vấn đề đều được giải quyết hết... Như vậy không phải rất lợi hại sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190612,
					"content": "Chúng ta là những nhà mạo hiểm xuất sắc nhất mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190613
					]
				},
				{
					"id": 40190613,
					"content": "#Tính cả tôi sao? Chỉ có {NICKNAME} là nhà mạo hiểm thôi mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190614,
					"content": "Người dẫn đường cũng được tính mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190615
					]
				},
				{
					"id": 40190615,
					"content": "Vậy lần sau để Katheryne cấp cho tôi chứng nhận mạo hiểm nữa nhé! Tôi sẽ là nhà mạo hiểm Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190616
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190616,
					"content": "#Nghĩ cũng thấy vui rồi... Tôi ngủ đây, {NICKNAME} cũng ngủ sớm đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190617
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190617,
					"content": "Lần cuối khi ngủ ở đây, vừa tỉnh giấc đã ầm ĩ hỗn loạn... Nước Biển Khởi Nguyên cũng dâng lên, thật đáng sợ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190618,
					"content": "Hôm nay chắc không sao đâu nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190619
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190619,
					"content": "Ừm, yên tâm ngủ đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190620
					]
				},
				{
					"id": 40190620,
					"content": "Ừm, ngủ ngon nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190621
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190621,
					"content": "Paimon ngủ ngon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
