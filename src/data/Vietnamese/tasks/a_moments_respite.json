			"dialogs": [
				{
					"id": 40190101,
					"content": "Y tá trưởng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190102,
					"content": "#{NICKNAME}, Paimon, hai người về rồi à!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190103
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 40190103,
					"content": "Không sao chứ? Có bị thương ở đâu không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190104
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 40190104,
					"content": "Chúng tôi vẫn ổn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190105
					]
				},
				{
					"id": 40190105,
					"content": "Đúng đó! Còn mọi người thì sao? Xảy ra chuyện lớn như vậy, mọi người không vấn đề gì chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190106,
					"content": "Có vài người bị trầy xước nhẹ, nhìn chung vẫn ổn. Ngài Neuvillette đã đến đây một chuyến, cũng nhờ ngài ấy mà chúng tôi đã tạm thời ngăn chặn được nguy cơ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190107
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 40190107,
					"content": "Cũng phải cảm ơn sự giúp đỡ của hai người nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190108
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 40190108,
					"content": "Neuvillette sao lại biết nơi này cần anh ấy vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190109,
					"content": "Ngài Neuvillette có mối liên kết rất mạnh với Nguyên Tố Thủy. Khi nước dâng, trên biển cũng xảy ra biến động lớn, ngài ấy chắc đã cảm nhận được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190110
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 40190110,
					"content": "Khi tôi băng bó cho tù nhân thì gặp Anh Em Bùng Nổ, họ không ngừng nói về việc hai người chạy xuống bên dưới... Cho nên khi thấy cả hai không sao là tôi yên tâm rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190111
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 40190111,
					"content": "Nếu không vội thì hãy ở lại đây vài hôm nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190112
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 40190112,
					"content": "Muốn ăn gì thì cứ nói với tôi, tôi sẽ nhờ Wolsey sắp xếp. Nếu mệt rồi thì có thể đến Phòng Y Tế nghỉ ngơi cho khỏe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190113
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 40190113,
					"content": "Tôi cũng muốn quan sát thêm về cơ mặt của cả hai. Nụ cười vui vẻ này rất dễ lan tỏa, rất thú vị, khiến tôi nhớ mãi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sigewinne"
				}
			]
		},
