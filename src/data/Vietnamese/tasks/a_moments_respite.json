			"dialogs": [
				{
					"id": 40190301,
					"content": "Tù nhân ra tù rồi mà vẫn quay lại sao! Ngọn gió nào đưa hai người đến đây thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190302
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 40190302,
					"content": "Chúng tôi đến xem tình hình của Pháo Đài Meropide thôi! Ở đây vẫn ổn chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190303,
					"content": "Chuyện nhỏ thôi, Neuvillette đã đến đây để giải quyết một số vấn đề khó khăn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190304
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 40190304,
					"content": "Hmm... Vậy sao anh không mời anh ấy ở lại đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190305,
					"content": "Ồ, kế hoạch hay nhỉ! Chúng ta có thể cùng nhau thuyết phục vị thẩm phán tối cao đó từ bỏ cả tòa án dọn đến đây ở luôn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190306
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 40190306,
					"content": "Chắc chắn là không thể rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190307
					]
				},
				{
					"id": 40190307,
					"content": "Anh ấy vội vã xuống đây, chưa kịp uống ngụm trà thì đã phải về rồi. À, nhưng vẫn kịp cầm theo quà của y tá trưởng tặng đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190308
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 40190308,
					"content": "Cảm thấy anh ấy bận rộn thật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190309,
					"content": "Clorinde cũng về rồi, cũng mang theo quà của y tá trưởng luôn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190310
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 40190310,
					"content": "Mà quà là gì vậy, sữa lắc à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190311,
					"content": "Quà của Neuvillette là sữa lắc, còn Clorinde là son môi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190312
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 40190312,
					"content": "Hả? Sao khác nhau vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190313,
					"content": "Vì Clorinde không bận như Neuvillette, nên có đủ thời gian để chăm lo cho sức khỏe. Với lại y tá trưởng thích chọn quà là mỹ phẩm cho phái nữ hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190314
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 40190314,
					"content": "À, có cả quà cho hai người đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190315
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 40190315,
					"content": "Y tá trưởng cũng tặng cho chúng tôi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190316,
					"content": "Không, là tôi tặng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190317
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 40190317,
					"content": "Việc của hai người ở Pháo Đài Meropide đã xong, nên có thể về trên kia bất cứ lúc nào, chỉ là chưa mãn hạn tù thôi. Trước khi mãn hạn, hai người có thể thoải mái sử dụng phòng giam ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190318
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 40190318,
					"content": "Vậy sao? Vậy là có thể ở lại đây thêm một thời gian dài nữa rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190319,
					"content": "Có bao ăn không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190320
					]
				},
				{
					"id": 40190320,
					"content": "Nhà ăn sẽ cung cấp suất ăn miễn phí cho hai người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190321
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 40190321,
					"content": "Tuyệt vời!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190322,
					"content": "Nhớ đến chỗ tôi làm thủ tục vào ngày mãn hạn tù nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wriothesley"
				}
			]
		},
