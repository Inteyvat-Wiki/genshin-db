			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kerih"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752150201,
					"content": "#Không phải chứ, {F#cô}{M#cậu} đã đập vỡ một góc khối vuông rồi à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752150202
					],
					"speakerTitle": "Kerih"
				},
				{
					"id": 752150202,
					"content": "#Người có sức mạnh như vậy trước đây là tiền bối Varesa... Xem ra {F#cô}{M#cậu} cũng giống như cô ấy, đều là tuyển thủ có thiên phú!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752150203,
						752150204
					],
					"speakerTitle": "Kerih"
				},
				{
					"id": 752150203,
					"content": "Cũng có chút thử thách đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752150205
					]
				},
				{
					"id": 752150205,
					"content": "#Đúng là không thể nhìn mặt mà bắt hình dong, có cơ hội thì tôi thật sự muốn mời {F#cô}{M#cậu} làm huấn luyện viên đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752150206
					],
					"speakerTitle": "Kerih"
				},
				{
					"id": 752150206,
					"content": "#Đúng rồi, chai Nước Trái Cây Trù Phú này nghe nói có thể tăng cường hiệu quả vận động, các học viên đều thích uống, {F#cô}{M#cậu} cũng uống thử đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kerih"
				},
				{
					"id": 752150204,
					"content": "Mức độ này cũng nhẹ nhàng thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752150205
					]
				}
			]
		},
		{
			"id": 7521503,
