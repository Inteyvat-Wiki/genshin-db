			"dialogs": [
				{
					"id": 752150301,
					"content": "Thực ra thu hút người mới cũng không khó, vấn đề là sau khi huấn luyện một thời gian thì có rất nhiều người tìm cớ xin nghỉ, hoặc đơn giản là không đến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752150302
					],
					"speakerTitle": "Kerih"
				},
				{
					"id": 752150302,
					"content": "Để tăng sự tích cực của mọi người, huấn luyện viên đã nghĩ ra rất nhiều cách, thử thách khối vuông kia là một trong số đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752150303
					],
					"speakerTitle": "Kerih"
				},
				{
					"id": 752150303,
					"content": "Kết quả là một số người vì để nâng điểm số nên liên tục va vào khối vuông lớn, cuối cùng thì toàn mặt mũi sưng vù, người xin nghỉ càng nhiều hơn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kerih"
				}
			]
		},
