			},
			"dialogs": [
				{
					"id": 752150101,
					"content": "Sao vậy, có hứng thú với khu huấn luyện sức mạnh sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752150102
					],
					"speakerTitle": "Kerih"
				},
				{
					"id": 752150102,
					"content": "Thiết bị có thể thử tùy ý, nhưng nhìn tay chân mảnh khảnh thế kia, đừng có để mình bị thương đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752150103,
						752150104
					],
					"speakerTitle": "Kerih"
				},
				{
					"id": 752150103,
					"content": "Mỗi ngày tôi vận động nhiều lắm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752150105
					]
				},
				{
					"id": 752150105,
					"content": "Thật sao? Trước khi khoác lác với tôi, chi bằng đấu một trận với khối vuông bên cạnh đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752150106
					],
					"speakerTitle": "Kerih"
				},
				{
					"id": 752150106,
					"content": "#<color=#00E1FFFF>Tấn công</color> hoặc <color=#00E1FFFF>va chạm</color> vào khối vuông lớn, sẽ căn cứ theo lượng sức mạnh để nhận điểm. Để tôi xem thử {F#cô}{M#cậu} có khả năng đến đâu nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kerih"
				},
				{
					"id": 752150104,
					"content": "Tôi có thể một đấm đánh bay Hilichurl.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752150105
					]
				}
			]
		},
		{
			"id": 7521502,
			"completionStepIds": [
				7521502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7521502",
