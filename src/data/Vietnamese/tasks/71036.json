				"points": []
			},
			"dialogs": [
				{
					"id": 710411201,
					"content": "Cho hỏi tiền bối có việc gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411202,
						710411212,
						710411223,
						710411232
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710411202,
					"content": "Về bản đồ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710411203
					]
				},
				{
					"id": 710411203,
					"content": "Tiền bối nói bản đồ sao? Không có gì đáng nhắc tới cả... Trước khi gia nhập Hiệp Hội Nhà Mạo Hiểm, tôi từng là một người vẽ bản đồ trong hầm mỏ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411204
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710411204,
					"content": "Tất nhiên, tôi không nói về những người vẽ bản đồ ngồi trong văn phòng và vẽ... Hihi, tôi còn kém xa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411234
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710411234,
					"content": "Trước đây tôi từng nhận ủy thác của họ, chạy ngược chạy xuôi ở Làng Kiều Anh để khảo sát và vẽ bản đồ địa hình... kết quả là kế hoạch xây dựng đã bị hủy bỏ... cũng đều là lời họ nói.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411205
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710411205,
					"content": "Có thể họ chỉ cần ủy thác cho trợ thủ khảo sát hiện trường, thu thập thông tin bản đồ cho họ, sau đó họ mới làm việc... Nhưng những người vẽ bản đồ như chúng tôi thì không được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411206
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710411206,
					"content": "Vì vậy... Với tư cách cũng xem như là một thợ mỏ, từ lâu tôi đã quen với việc luồn lách dưới những đoạn đường hầm nguy hiểm. Công việc đòi hỏi như vậy, không còn cách nào khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411207
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710411207,
					"content": "Hơn nữa... sau khi xảy ra dị biến, tầng dưới Vực Đá Sâu thật sự rất... bất ổn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411208
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710411208,
					"content": "Ơ... bất ổn? Rất nguy hiểm sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710411209,
					"content": "Ừm, kết cấu địa chất đang dần thay đổi, lối đi hôm nay có thể sẽ trở thành bức tường đá vào tháng sau... Giống như... ừm, để tôi nghĩ xem phải nói thế nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411210
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710411210,
					"content": "Giống như Vực Đá Sâu đang thay đổi theo suy nghĩ của chính mình vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411211
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710411211,
					"content": "Woa... quỷ dị vậy sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710411212,
					"content": "Về cuộc đời của Nhà Mạo Hiểm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710411213
					]
				},
				{
					"id": 710411213,
					"content": "Haha, những điều này có là gì đâu, cuộc sống mà! Tiền bối đừng khách sáo quá, tôi vẫn chỉ là một Nhà Mạo Hiểm mới thôi... Còn kém tiền bối quá xa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411214
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710411214,
					"content": "Mặc dù lúc trước từng hoàn thành một số ủy thác của Hiệp Hội Nhà Mạo Hiểm, nhưng tôi vẫn còn thiếu kinh nghiệm, cũng chưa từng khám phá bất kỳ nơi nào một mình, cũng chưa từng để lại câu chuyện của mình ở đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411215
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710411215,
					"content": "Vì vậy tôi nghĩ, có lẽ Vực Đá Sâu có thể cho tôi để lại dấu chân, để người đời sau nhớ rằng tôi đã từng đến đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411216
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710411216,
					"content": "Giống như Nhà Mạo Hiểm Alice từng nói, nói không chừng Vực Đá Sâu sẽ là \"Rubicon\" của tôi.!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411217,
						710411220
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710411217,
					"content": "\"Rubicon\"... Là ngôn ngữ của Hilichurl sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710411218
					]
				},
				{
					"id": 710411218,
					"content": "Chưa từng nghe nói...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710411219,
					"content": "Ừm... Tôi cũng không hiểu lắm... Dù sao Alice cũng là một Nhà Mạo Hiểm lớn, có lẽ cũng là một trong những nơi cô ấy từng đến đúng không...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710411220,
					"content": "Ồ! Là \"Rubicon\" à! Thật lợi hại!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710411221
					]
				},
				{
					"id": 710411221,
					"content": "Này, chính bạn cũng không biết đó là gì đúng không!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710411222,
					"content": "Haha, dù sao cũng cảm ơn tiền bối đã động viên!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710411223,
					"content": "Về Clitopho...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710411224
					]
				},
				{
					"id": 710411224,
					"content": "Anh ta à... Hừm, người như anh ta không thể tin tưởng được. Không biết chúng tôi đã đối phó với bọn Đạo Bảo Đoàn trong hầm mỏ bao lâu rồi, còn không biết được ý đồ xấu của chúng sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411225
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710411225,
					"content": "Bọn người đó à... Tôi khuyên tiền bối không nên tin vào những lời ngụy biện của bọn họ, cái gì mà \"làm lại cuộc đời\", rồi \"rửa tay gác kiếm\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411226
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710411226,
					"content": "Nếu nghe bọn họ nói, thì sớm muộn gì cũng sẽ bị dụ thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411227
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710411227,
					"content": "Nếu tiền bối tin vào những lời nói dối của bọn họ, e là Nham Vương Gia cũng không giữ nổi túi tiền của tiền bối đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411228
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710411228,
					"content": "Hừm, tất nhiên không phải tôi có thành kiến với họ... Chỉ là tôi muốn nhắc nhở tiền bối nên cẩn thận, không thể tin Đạo Bảo Đoàn được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411229
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710411229,
					"content": "Rõ ràng là cô có thành kiến mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710411230
					]
				},
				{
					"id": 710411230,
					"content": "Có lẽ vậy... Là tiền bối, bạn hiểu biết nhiều hơn tôi, cũng có thể khoan dung hơn với bọn Đạo Bảo Đoàn. Nhưng tôi luôn phải để mắt đến bọn họ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411231
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710411231,
					"content": "Trừ phi tên này có thể chứng minh, anh ta không liên quan gì đến đồng bọn buôn lậu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710411232,
					"content": "Tạm biệt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710411233
					]
				},
				{
					"id": 710411233,
					"content": "Tạm biệt tiền bối!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiqiong"
				}
			]
		}
	]
}