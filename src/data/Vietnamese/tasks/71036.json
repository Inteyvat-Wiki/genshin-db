				"points": []
			},
			"dialogs": [
				{
					"id": 710360201,
					"content": "#Xin chào, {NICKNAME}! Dạo này thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360202,
						710360204
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360202,
					"content": "Vẫn ổn, cô khỏe hơn chút nào chưa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360203
					]
				},
				{
					"id": 710360203,
					"content": "Cảm ơn đã quan tâm, tôi không sao rồi. Xin lỗi vì đã làm mọi người lo lắng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360206
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360206,
					"content": "Cô thì đừng có mà chạy lung tung lên như lần trước nữa đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710360207,
					"content": "Không đâu. Cũng may nhờ có sự cố gắng của tiền bối mà Vực Đá Sâu đã an toàn hơn nhiều rồi. Các đặc điểm địa chất cũng trở nên... ổn định hơn rất nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360208
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360208,
					"content": "Nhưng mà chị Jinwu và Khedive vẫn cần phải tiến hành phân tích thêm về mảnh tinh thể thần bí... gọi là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360209
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360209,
					"content": "Hmm, bước sóng? Khedive đã nói vậy, không lẽ đây là một thuật ngữ kỳ lạ nào đó của Sumeru chăng... Tóm lại, trước hết cần được bố trí và thu hồi đèn hiệu để lấy dữ liệu đã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360210
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360210,
					"content": "Gần đây, cuối cùng chị Jinwu cũng đã có thời gian để lắp ráp tất cả các đèn hiệu, chúng ta cần bố trí chúng ở một vài vị trí khác nhau để thu thập dữ liệu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360211
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360211,
					"content": "Sau một khoảng thời gian sẽ đi thu hồi, và mang dữ liệu thu được giao cho Khedive phân tích.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360212
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360212,
					"content": "Trước đây do nhiều khu vực không an toàn, nên chúng tôi chỉ có thể hạn chế đọc số liệu trong khu vực doanh trại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360213
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360213,
					"content": "Nhưng bây giờ lối đi đã được tiền bối mở ra, có thể sử dụng đèn hiệu và tiến hành đo đạc thực địa để thu được dữ liệu chính xác hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360214
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360214,
					"content": "Phù... có việc làm vẫn tốt hơn là ngồi không. Đúng rồi, nếu tiền bối không bận việc gì thì hãy cùng tham gia nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360215,
						710360217
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360215,
					"content": "Vậy chúng ta xuất phát đi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360216
					]
				},
				{
					"id": 710360216,
					"content": "Ừm, chúng ta xuất phát thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360217,
					"content": "Chúng tôi có được lợi gì không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360218
					]
				},
				{
					"id": 710360218,
					"content": "Bạn thẳng thắn quá đấy! Mặc dù tôi cũng muốn biết...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710360219,
					"content": "Haha, đây chỉ là một chuyến đi đơn giản mà thôi, có lẽ chị Jinwu sẽ cảm ơn bạn đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360204,
					"content": "Không ổn lắm, nhưng ít ra thì vẫn còn sống. Còn cô?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360205
					]
				},
				{
					"id": 710360205,
					"content": "Tôi vẫn ổn... chà, không sao là tốt rồi, hào quang mạo hiểm đều bị tiền bối cướp mất rồi, haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360206
					],
					"speakerTitle": "Zhiqiong"
				}
			]
		},
		{
			"id": 7103603,
			"completionStepIds": [
				7103610
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
