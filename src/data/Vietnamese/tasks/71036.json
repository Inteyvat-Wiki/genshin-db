			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhiqiong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710360301,
					"content": "Chuyến này vất vả cho tiền bối rồi, đây là chút lòng thành, xin hãy nhận lấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360302
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360302,
					"content": "Cô khách sáo quá.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360303
					]
				},
				{
					"id": 710360303,
					"content": "Hừm... Gần đây, Vực Đá Sâu dường như đã ngừng thay đổi địa hình, cũng có nghĩa là tôi chỉ cần bổ sung một số thay đổi nhỏ cho bản đồ hiện có.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360304
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360304,
					"content": "Cảm ơn sự mạo hiểm của tiền bối, cũng nhờ vậy mà công việc của tôi cũng dễ dàng hơn nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360305
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360305,
					"content": "Ah, tôi không giữ tiền bối thêm nữa. Nếu như muốn nghỉ ngơi hoặc tiếp tục thám hiểm xin cứ tự nhiên!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360306
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360306,
					"content": "Phù... Còn khá lâu mới đến thời gian thu lại đèn hiệu, giá như lần mạo hiểm sau cũng có tiền bối thì tốt quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiqiong"
				}
			]
		},
		{
			"id": 7104116,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
