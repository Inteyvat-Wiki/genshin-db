			"dialogs": [
				{
					"id": 230290101,
					"content": "Cũng tới lúc rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290102
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290102,
					"content": "Cô vẫn đang nghiên cứu về Cây Thánh sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230290103
					]
				},
				{
					"id": 230290103,
					"content": "Nhà Lữ Hành, mỗi lần bạn tới đều trùng hợp như thế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290104
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290104,
					"content": "Rất cảm ơn sự giúp đỡ trước đây của bạn, tình hình của Cây Thánh đang rất tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290105
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290105,
					"content": "Tôi và Ladep đã thảo luận với nhau, cho rằng tình trạng tốt này vẫn sẽ duy trì trong thời gian rất dài.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290106
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290106,
					"content": "Cuối cùng chúng tôi cũng rảnh tay để chuẩn bị cho bài luận văn của chúng tôi rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290107
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290107,
					"content": "Nhìn xem, tôi đã mượn bộ máy ảnh này từ chỗ Pharez, tôi đang định đi ghi lại tình trạng của Cây Thánh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290108
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290108,
					"content": "Nhà Lữ Hành, bạn cũng giúp tôi ghi chép lại toàn cảnh của Cây Thánh nhé, tôi sẽ đánh dấu địa điểm cho bạn trên bản đồ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290109,
						230290110
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290109,
					"content": "Cứ giao cho tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230290110,
					"content": "Sao cô không tự đi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230290111
					]
				},
				{
					"id": 230290111,
					"content": "À thì... bên đó... bên đó... cao quá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290112
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290112,
					"content": "Mỗi lần một mình đi tới chỗ cao tôi đều thấy sợ... cảm giác... cảm giác sẽ có một cơn gió thổi bay tôi... hoặc bản thảo của tôi sẽ bay đi mất ấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290113
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290113,
					"content": "Bình thường đều do Pharez đến đó chụp ảnh, nhưng hôm nay hình như anh ấy bận chuyện khác, nên tôi chỉ có thể trông cậy vào bạn thôi, Nhà Lữ Hành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasmin"
				}
			]
		},
