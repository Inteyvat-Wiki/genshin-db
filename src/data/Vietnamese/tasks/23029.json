				{
					"id": 230290401,
					"content": "Sao rồi, các bạn đã chụp toàn cảnh Cây Thánh chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290402
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290402,
					"content": "Đã xong rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230290403
					]
				},
				{
					"id": 230290403,
					"content": "Ồ! Để tôi xem thử...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290404
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290404,
					"content": "Khá lắm, góc độ rất tốt, chụp cũng rất rõ ràng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290405
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290405,
					"content": "Thù lao này cho bạn, cảm ơn bạn đã giúp đỡ nhé, Nhà Lữ Hành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290406
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290406,
					"content": "Thân chính không có vấn đề... Hình dạng thân cành xung quanh cũng không thay đổi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290407
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290407,
					"content": "Chờ thêm số liệu do Ladep và Pharez thu thập là chúng tôi sẽ có thể tiếp tục đề tài tiếp theo rồi...",
					"roleType": "TALK_ROLE_NPC",
