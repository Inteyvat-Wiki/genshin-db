				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Beidou",
					"Kaedehara Kazuha",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20010301,
					"content": "Ha ha ha, không hổ danh là tuyển thủ hạt giống mà tôi xem trọng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010302
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20010302,
					"content": "#Bạn cũng nhìn thấy rồi chứ, Kazuha! {M#Anh ấy}{F#Cô ấy} rất dứt khoát khi chiến đấu, chiến thắng rất gọn gàng nhanh chóng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010303
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20010303,
					"content": "Đúng thế, nhưng tôi có cảm giác người này đang kiềm nén đi một phần sức mạnh, không muốn làm đối phương bị thương thì phải.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010304
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010304,
					"content": "#Tôi đã trải qua vô số trận chiến lớn nhỏ, chỉ cần nhìn trận này cũng có thể hiểu rõ thực lực mạnh mẽ của {M#anh ấy}{F#cô ấy}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010305
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20010305,
					"content": "Cho nên, bạn không cần phải keo kiệt lời khen ngợi đâu nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010306
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20010306,
					"content": "Ừm, nếu muốn khen thì để tôi nghĩ xem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010307
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010307,
					"content": "\"Đánh rất hay\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010308
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010308,
					"content": "Được thôi, tôi còn định bụng để nghe bạn khen ngợi mấy lời hoa mỹ, nhưng thôi bỏ đi vậy, đúng là không nên làm khó bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010309
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20010309,
					"content": "Thực ra vừa nãy rất nhiều người tham chiến đã nói với tôi, họ hoàn toàn không ngờ đại anh hùng của Liyue cũng đến tham gia trận tỷ võ này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010310
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20010310,
					"content": "Người báo danh cũng tăng đột biến, trong đó cũng có người võ công cao cường, tôi cảm thấy, rất nhiều người muốn so tài cao thấp với bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010311,
						20010312
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20010311,
					"content": "Không ngờ tôi có sức mạnh kêu gọi đến thế...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010313
					]
				},
				{
					"id": 20010313,
					"content": "Ha ha, cho nên tôi đang nghĩ, đáng lý nên cho bạn một đãi ngộ phù hợp hơn với danh nghĩa tuyển thủ \"hot\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010314
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20010314,
					"content": "Một là, không hi vọng bạn tốn sức quá nhiều trong lúc đánh với tuyển thủ bình thường, hai là, bạn chắc cũng mong chờ một trận đấu kịch liệt hơn nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010315
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20010315,
					"content": "Cho nên, tôi sẽ cho bạn vào thẳng vòng bán kết!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010316
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20010316,
					"content": "Hả? Trận ban nãy chỉ là dự tuyển thôi, vào thẳng bán kết có phải hơi lố không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20010317,
					"content": "Tính tình chị đại là thế đấy, bạn không khuyên nổi cô ấy đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010318
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010318,
					"content": "Hơn nữa với thực lực này, tôi thấy vị đại anh hùng này cũng có thể lọt vào vòng bán kết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010319
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010319,
					"content": "Điểm này thì tôi đồng ý...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20010320,
					"content": "Vậy chúng ta cứ xem trận đấu của những người khác đi, xem thử người có tư cách khiêu chiến với bạn sẽ có lai lịch thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010321
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20010321,
					"content": "Cuối cùng cũng đến rồi, cuối cùng cũng đến rồi, vở kịch hay của hôm nay!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010322
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20010322,
					"content": "Ha ha, chị đại rất mong chờ trận đấu này, lâu rồi tôi chưa thấy cô ấy phấn khích đến thế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010323
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010323,
					"content": "Đối thủ của bạn vượt qua được rất nhiều thử thách, lọt vào bán kết, là người đã từng trải qua hàng trăm trận chiến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010324
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010324,
					"content": "Có thể thực lực của hắn không bằng bạn, nhưng cũng đừng lơ là cảnh giác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010325,
						20010326
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010325,
					"content": "Đương nhiên là không rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010327
					]
				},
				{
					"id": 20010327,
					"content": "Vậy thì để tôi xem thử bạn đã chuẩn bị sẵn sàng để đột phá vùng giông tố kia chưa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010328
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010328,
					"content": "Nói đến đây thôi, khán giả không chờ được nữa rồi. Bạn hãy đi tìm thuyền viên phụ trách báo danh ở cạnh hội trường, cô ấy sẽ đưa bạn lên sàn đấu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20010326,
					"content": "Tôi không hề quên mục đích tham chiến của mình.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010327
					]
				},
				{
					"id": 20010312,
					"content": "Cũng không quan trọng cho lắm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010313
					]
				}
			]
		},
