			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Rongshi",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20010601,
					"content": "Đánh hay lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010602
					],
					"speakerTitle": "Rongshi"
				},
				{
					"id": 20010602,
					"content": "Tôi thừa nhận bạn nhỉnh hơn, tôi phải rèn luyện thêm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010603,
						20010604
					],
					"speakerTitle": "Rongshi"
				},
				{
					"id": 20010603,
					"content": "Bạn cũng rất lợi hại.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010605
					]
				},
				{
					"id": 20010605,
					"content": "Đúng thế, vừa nãy nguy hiểm thật...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20010606,
					"content": "Nếu bạn có Vision, chắc chắn sẽ rất lợi hại đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20010607,
					"content": "Lúc nhỏ tôi cũng muốn có Vision, họ nói chỉ cần đủ mạnh thì sẽ có cơ hội.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010608
					],
					"speakerTitle": "Rongshi"
				},
				{
					"id": 20010608,
					"content": "Nhưng, tôi không lấy được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010609
					],
					"speakerTitle": "Rongshi"
				},
				{
					"id": 20010609,
					"content": "Sau đó thì tôi không còn hứng thú nữa. Vision không có sức mạnh cơ bắp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010610
					],
					"speakerTitle": "Rongshi"
				},
				{
					"id": 20010610,
					"content": "Tôi cũng đã đánh thắng người có Vision. Sức mạnh đó là do thần ban tặng, tôi không ngưỡng mộ điều đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010611
					],
					"speakerTitle": "Rongshi"
				},
				{
					"id": 20010611,
					"content": "Ơ? Vậy bạn không phải nhắm đến Vision vô chủ đó sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20010612,
					"content": "Không, tôi chỉ muốn tỷ võ thôi, xem thử là ai mạnh hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010613
					],
					"speakerTitle": "Rongshi"
				},
				{
					"id": 20010613,
					"content": "Chỉ có thất bại mới có thể cảm nhận được khoảng cách, mới có cơ hội trưởng thành. Cho nên tôi rất vui, vì thất bại là để khiến chúng ta thành công hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010614
					],
					"speakerTitle": "Rongshi"
				},
				{
					"id": 20010614,
					"content": "Đây mới đúng là lời của người có thực lực chân chính.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20010615,
					"content": "Sau này có cơ hội hãy đến tỷ võ tiếp nhé, tôi sẽ tiếp tục trưởng thành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010616
					],
					"speakerTitle": "Rongshi"
				},
				{
					"id": 20010616,
					"content": "Tôi cũng thế.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010617
					]
				},
				{
					"id": 20010617,
					"content": "Đúng rồi, bạn biết ai sẽ tham gia chung kết không? Người đó có phải còn lợi hại hơn cả bạn không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20010618,
					"content": "Có lợi hại hơn tôi hay không thì không biết, nhưng nghe nói, hắn rất \"nhanh\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010619
					],
					"speakerTitle": "Rongshi"
				},
				{
					"id": 20010619,
					"content": "Đừng lơ là cảnh giác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rongshi"
				},
				{
					"id": 20010604,
					"content": "Bạn có tiềm năng trở thành quán quân.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010605
