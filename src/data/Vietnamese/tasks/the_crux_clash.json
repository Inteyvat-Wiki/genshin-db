					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011105
					]
				},
				{
					"id": 20011105,
					"content": "Ừm, từ khi mới gặp mặt, bạn cứ luôn nói bóng gió gì đó, thì ra đã phát giác từ lâu rồi sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20011106,
					"content": "Ừm, không nói ở hội trường vì nghĩ rằng nếu bị người khác biết bạn có thể sử dụng sức mạnh nguyên tố thì sẽ dẫn đến những hiểu lầm không đáng có.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011107
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011107,
					"content": "Cho dù gặp nguy hiểm trong thi đấu, bạn cũng không dùng sức mạnh nguyên tố, chắc cũng vì suy nghĩ giống tôi phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011108
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011108,
					"content": "Nhưng vì sao bạn biết được?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011109
					]
				},
				{
					"id": 20011109,
					"content": "Haha, \"nhìn thấy\" và \"ngửi thấy\" mà tôi nói, không phải chỉ là lời nói bóng bẩy, mà sự thực chính là vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011110
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011110,
					"content": "Từ khi còn rất nhỏ tôi đã có thể hiểu được thông điệp của thiên nhiên, tôi có thể nghe được tiếng hít thở của gió, lời thì thầm của lá cây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011111
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011111,
					"content": "Tôi nghe được những thứ tương tự trên người bạn, chỉ vậy thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011112
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011112,
					"content": "Tuy khó tin nhưng có vẻ không giống nói dối.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20011113,
					"content": "So với các bạn thì khả năng này của tôi rất nhỏ nhặt, không đáng kể đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011114
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011114,
					"content": "Không cần dựa vào Vision cũng có thể điều khiển được nhiều loại nguyên tố...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011115
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011115,
					"content": "Còn có \"mùi\" vô cùng phức tạp, không biết là sinh vật bí ẩn đến từ phương nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011116
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011116,
					"content": "Đừng dùng \"mùi\" để đánh giá tôi chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20011117,
					"content": "Có thể kể cho tôi nghe bạn có được sức mạnh nguyên tố tổng hợp này như thế nào không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011118,
						20011119
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011118,
					"content": "Tôi cũng không biết.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011120
					]
				},
				{
					"id": 20011120,
					"content": "Ừm...khó mà hiểu được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011121
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011121,
					"content": "Vậy bạn làm sao học được cách dùng sức mạnh nguyên tố để áp dụng vào chiến đấu thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011122,
						20011123
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011122,
					"content": "Hoàn toàn dựa vào kiến thức của Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011124
					]
				},
				{
					"id": 20011124,
					"content": "#Hi hi, không có đâu, tôi chỉ nói những thứ mình biết cho {NICKNAME} thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20011125,
					"content": "#Hành trình dài dẵng, nhiều chuyện xảy ra, hồi tưởng và trông ngóng, {NICKNAME} cũng tự nhiên học được cách sử dụng nguyên tố...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20011126,
					"content": "Nói thật thì tôi cũng không biết gì về nguyên lý trong đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20011127,
					"content": "Có lẽ, sự khó lý giải này mới là bản chất của thần và Vision.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011128
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011128,
					"content": "Nhưng tôi vẫn muốn tận mắt xem thử bạn sử dụng sức mạnh nguyên tố như thế nào, biết đâu tôi có thể có được một chút gợi ý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011129
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011129,
					"content": "Tôi cũng sẽ chia sẻ thông tin mà tôi nắm bắt được cho bạn, như thế cũng xem như một sự trao đổi hợp lý rồi nhỉ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011130,
						20011131
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011130,
					"content": "Được thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011132
					]
				},
				{
					"id": 20011132,
					"content": "Vậy hãy dùng thử thách để thể hiện kỹ năng của bạn đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011131,
					"content": "Cuối cùng có thể chiến đấu bình thường rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011132
					]
				},
				{
					"id": 20011123,
					"content": "Hoàn toàn dựa vào việc Paimon đồng hành.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011124
					]
				},
				{
					"id": 20011119,
					"content": "Tôi chỉ chạm vào Thất Thiên Thần Tượng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011120
					]
				},
				{
					"id": 20011104,
					"content": "Thảo nào không nói ở hội trường.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011105
					]
				}
			]
		},
		{
			"id": 200113,
			"completionStepIds": [
				200113
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200113",
							"2"
						],
						"stepId": 200113,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaedehara Kazuha",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20011301,
					"content": "Ừm, năng lực chiến đấu của bạn quả nhiên không thể tìm ra sơ hở, cho dù đối thủ chung kết có nhanh nhẹn đi nữa cũng không thể làm khó được bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011302
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011302,
					"content": "Người vào chung kết đó rất giỏi điều chỉnh nhịp thở, giữ thăng bằng, thực hiện những động tác mà người thường khó làm được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011303
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011303,
					"content": "Chiến thắng của hắn ta hầu như đều dựa vào \"đánh úp\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011304
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011304,
					"content": "Nhưng nói cách khác, chỉ cần lưu ý khả năng lợi dụng sơ hở của hắn, thì đòn tấn công của hắn không thể gây ra bất kỳ uy hiếp nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011305
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011305,
					"content": "Cám ơn bạn, tôi sẽ không khinh địch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011306
					]
				},
				{
					"id": 20011306,
					"content": "Không cần cám ơn, được chứng kiến cách vận dụng sức mạnh nguyên tố khác với bình thường, tôi mới là người phải cảm ơn bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011307
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011307,
					"content": "Quả nhiên, thế giới này thần bí như vậy, luôn xuất hiện những hiện tượng kỳ lạ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011308
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011308,
					"content": "Cảm giác như bạn có một chấp niệm nào đó về Vision...nhưng không phải bạn đã có rồi sao? Đâu cần phải miệt mài tìm hiểu mối quan hệ giữa sức mạnh nguyên tố và Vision chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20011309,
					"content": "Điều tôi muốn biết là, Vision có ý nghĩa gì đối với Thần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011310
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011310,
					"content": "Vì sao thần lại có quyết định ban tặng Vision?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011311
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011311,
					"content": "Xin lỗi, chắc chuyện này không là gì đối với các bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011312
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011312,
					"content": "Tôi đã chứng kiến được sức mạnh thần kỳ của các bạn, để báo đáp, các bạn có thắc mắc gì về Inazuma cứ hỏi, tôi sẽ giải đáp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011313
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011313,
					"content": "Muốn biết một vài chuyện \"bí mật\" đối với tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011314
					]
				},
				{
					"id": 20011314,
					"content": "Muốn biết chuyện này thật sao? Ha ha, vậy để tôi nói rõ một chút nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011315
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011315,
					"content": "Chắc các bạn cũng biết, Inazuma đang thi hành lệnh \"Truy Lùng Vision\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011316
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011316,
					"content": "Vision vốn là quà tặng của thần. Người ta nhận món quà này, nhưng lại bị tịch thu một cách vô lý, có lúc còn gây ra họa sát thân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011317
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011317,
					"content": "Nếu ban đầu Thất Thần đã có tính toán mới ban tặng Vision cho chúng sinh, vậy có thể Lôi Thần ngày nay đã hoài nghi về hành vi này rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011318
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011318,
					"content": "Đã lâu rồi không thấy Vision nguyên tố Lôi mới nữa, chắc cũng tỏ rõ thái độ của Raiden Shogun rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011319
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011319,
					"content": "Vị thần này...có vẻ bá đạo nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20011320,
					"content": "Theo tôi được biết, cô ấy là một vị thần bị ám ảnh bởi việc theo đuổi \"sự vĩnh hằng\" và sẽ thực hiện tư tưởng của mình một cách vô tình tàn nhẫn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011321
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011321,
					"content": "Nhưng \"khế ước\" của Liyue là vì người dân Liyue, còn \"sự vĩnh hằng\" của Inazuma ngày nay đã mang lại những gì cho dân chúng chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011322
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011322,
					"content": "Những người dân Inazuma bị giam giữ trong gông cùm thực sự có cuộc sống không mấy tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011323
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011323,
					"content": "Nghe có vẻ giống với việc mà vị thần ban đầu các bạn gặp làm ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20011324,
					"content": "Sao? Các bạn đã từng gặp Lôi Thần?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011325,
						20011326
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011325,
					"content": "Không chắc lắm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011327
					]
				},
				{
					"id": 20011327,
					"content": "Có lẽ chỉ có chúng tôi bị thời gian thay đổi, chứ không phải là tướng quân đại nhân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011328
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011328,
					"content": "Nếu bạn muốn tìm cô ấy thì cô ấy luôn luôn ở đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011329
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011329,
					"content": "Rồi sẽ có một ngày, tôi cũng phải tìm được câu trả lời cho \"sự vĩnh hằng\" từ chỗ cô ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011330
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011330,
					"content": "Xong rồi, cũng đã sắp đến giờ, chắc trận chung kết sắp bắt đầu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011331
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011331,
					"content": "Đúng rồi, nói nhiều chuyện về Inazuma quá đến nỗi quên mất vẫn còn trận đấu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011332
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20011332,
					"content": "Nếu không còn việc gì cần làm, thì chúng ta cùng về đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011333,
						20011335
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011333,
					"content": "Cùng đi nào.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011334
					]
				},
				{
					"id": 20011334,
					"content": "Được, đi thôi. Tôi rất muốn xem thử rốt cuộc là ai sẽ có được Vision.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011335,
					"content": "Lát nữa tự tôi về.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011336
					]
				},
				{
					"id": 20011336,
					"content": "Cũng được, nhớ đừng để lỡ thời gian thi đấu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011326,
					"content": "Cho dù phải thì cũng là chuyện từ rất lâu rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011327
					]
				}
			]
		},
