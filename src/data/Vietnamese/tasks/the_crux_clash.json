					"content": "Tuyệt vời, đáng được khen ngợi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010902
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010902,
					"content": "Tôi có thể cảm nhận được bạn có chút không quen, điều này cũng khiến trận đấu rơi vào thế khó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010903
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010903,
					"content": "Nhưng bạn đã nhanh chóng điều chỉnh lại trạng thái, giành được chiến thắng cuối cùng, đây mới đúng là sức mạnh đáng quý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010904,
						20010905
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010904,
					"content": "Rất nhạy bén.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010906
					]
				},
				{
					"id": 20010906,
					"content": "Thực ra là nghe được, có tiếng của sỏi đá và tiếng hít thở. Nhưng chuyện này không đáng nhắc đến đâu, với trình độ này, thì chị đại cũng có thể nhìn ra được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010907
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010907,
					"content": "Ha ha ha, quả thực là vậy, nhưng tôi chỉ dựa vào kinh nghiệm mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010908
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20010908,
					"content": "Đây cũng là trải nghiệm mới mẻ với bạn mà phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010909,
						20010910
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20010909,
					"content": "Đúng thế.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010911
					]
				},
				{
					"id": 20010911,
					"content": "Chúng tôi muốn hỏi thăm, đối thủ ở trận chung kết là người thế nào, có mạnh hơn người ở vòng bán kết này không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010912
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20010912,
					"content": "Chắc không đâu. Người vào được chung kết, thay vì nói \"mạnh\" thì hãy nói rằng rất có \"phong cách riêng\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010913
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20010913,
					"content": "Hắn rất \"nhanh\", có sở trường về thân pháp, hơn nữa vừa nhìn là biết có kinh nghiệm chiến đấu phong phú.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010914
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20010914,
					"content": "Thế nào? Bạn lo lắng sẽ trở tay không kịp ở trận chung kết sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010915,
						20010916
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20010915,
					"content": "Thận trọng một chút vẫn hơn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010917
					]
				},
				{
					"id": 20010917,
					"content": "Nếu đã vậy, tôi có một đề nghị, đi theo tôi đến một nơi yên tĩnh đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010918
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010918,
					"content": "Vẫn chưa giới thiệu, thực ra ở Inazuma, tôi là một Ronin Samurai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010919
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010919,
					"content": "Ừm, có thể nhìn thấy được điều này từ y phục của bạn. Nhưng khi bạn nói chuyện lại không giống như người cầm đao múa kiếm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010920
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20010920,
					"content": "Văn võ song toàn, trên con đường phiêu bạt dài đằng đẵng, có thêm một kỹ nghệ thì có gì không tốt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010921
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010921,
					"content": "Tuy không dám khoe khoang võ nghệ cao cường, nhưng cũng đã từng gặp đủ các cao thủ ở khắp nơi. Kỹ năng sở trường của đối thủ mà bạn sẽ gặp ở vòng chung kết, tôi cũng biết một chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010922
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010922,
					"content": "Với tài năng của bạn, tôi chỉ cần nhắc nhở thêm, bạn chắc chắn sẽ nghĩ được cách phá giải.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010923
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010923,
					"content": "Này này, có phải như vậy là phạm quy không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010924
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20010924,
					"content": "Thu thập tình báo cũng là một phần của quyết đấu, không có chỗ nào không thích hợp cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010925
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010925,
					"content": "#{NICKNAME} từ Mondstadt đến đây đã trải qua rất nhiều trận chiến, có thể tốc chiến tốc thắng hoàn toàn không chỉ dựa vào dũng võ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010926
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010926,
					"content": "Không sai không sai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010927
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20010927,
					"content": "Ê chờ đã, hình như chúng tôi chưa từng nói là đã đi qua Mondstadt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010928
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20010928,
					"content": "Ha ha, hễ là nơi nào đặt chân đến, các bạn cũng sẽ để lại dấu vết trong tự nhiên, còn tự nhiên cũng sẽ tặng lại cho các bạn những hơi thở đặc biệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010929
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010929,
					"content": "Nhưng hơi thở này có thể cho tôi lời nhắc nhở, chung quy không thể chạm vào bản chất, tôi vẫn còn rất nhiều thắc mắc chưa tìm được câu trả lời.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010930
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010930,
					"content": "Đi theo tôi, cứ xem như là niềm vui sau trận đấu đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010916,
					"content": "Chuyện đến Inazuma rất quan trọng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010917
					]
				},
				{
					"id": 20010910,
					"content": "Cũng xem như kết thúc rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010911
					]
				},
				{
					"id": 20010905,
					"content": "Khả năng quan sát của bạn rất sắc bén.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010906
					]
				}
			]
