			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sorush"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732570101,
					"content": "Kể ra thì từ sau khi rời khỏi di tích công xưởng, Sorush hình như chưa nói lời nào nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570102,
					"content": "Rõ ràng lúc nãy còn ríu rít cả đường, bây giờ yên lặng vậy có hơi không quen luôn đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570103,
						732570104,
						732570105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570103,
					"content": "Chắc không phải bị dọa đến ngơ người rồi chứ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570106
					]
				},
				{
					"id": 732570106,
					"content": "Tươi tỉnh lên nào, Sorush, chúng ta còn nhiều việc phải làm lắm đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570107,
					"content": "Ví dụ như hoàn thành cái... cái nghi thức có cái tên khó nhớ đó, sau đó mau chóng giải quyết lỗ hổng to lớn kia nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570108,
					"content": "Sau khi xong hết thì chúng ta đi ăn đồ ăn ngon đi, dù sao thì mọi người cũng cực khổ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570109,
					"content": "Ví dụ như... Ưm, nhưng tôi cũng không biết Pari thích ăn gì cả...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570110,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570111
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570111,
					"content": "...Pari không cần ăn đâu, Bóng Ngốc Bay Bay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570112
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570112,
					"content": "Haiz, không ngờ lại có ngày ta phải để Bóng Trắng Bay Bay an ủi, đúng là mất mặt quá mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570113
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570113,
					"content": "Thật chỉ muốn bị phong ấn trong Tinh Thạch Xám ngay luôn cho xong, nếu không thì tìm cho mình một cái hang động rồi ngủ mãi trong đó, cho đến khi những người biết ta đều biến mất hết là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570114
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570114,
					"content": "Đã nói không được gọi tôi là Bóng Trắng Bay Bay rồi mà, nhưng có loại hang động như vậy thật sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570115,
						732570117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570115,
					"content": "Trốn tránh cũng không giải quyết được vấn đề đâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570116
					]
				},
				{
					"id": 732570116,
					"content": "Giờ ta mặc kệ hết!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570119
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570119,
					"content": "Vừa nghĩ đến việc bị cái tên Nasejuna lừa cho xoay mòng thì ta chỉ muốn kiếm cái hố chui vào thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570120
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570120,
					"content": "Dù sao thì cũng có được Thánh Ca Khvarena rồi, nếu các người muốn giải quyết cái thiên tượng gì đó thì đi tìm Mihir hay Rashnu là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570121
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570121,
					"content": "Tóm lại thì xin các người để ta yên đi, những lời trước đây thì cứ xem như ta chưa từng nói là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570122
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570122,
					"content": "Ừm, đúng là cô từng nói nhiều câu kỳ quái thật...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570123,
						732570124,
						732570125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570123,
					"content": "\"Yasnapati của ta\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570126
					]
				},
				{
					"id": 732570126,
					"content": "Úi, ngươi đừng nói nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570127
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570127,
					"content": "#{NICKNAME}, đừng có trêu Sorush nữa. Dù sao thì chúng ta cũng cùng nhau mạo hiểm lâu như vậy rồi, không thể bỏ cuộc giữa chừng được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570128,
					"content": "Hơn nữa, Sorush cũng có chỗ rất lợi hại mà, ví dụ... ừm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570129,
					"content": "Ngươi vừa ngập ngừng đúng không! Huhu... Đừng an ủi ta nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570130,
						732570131
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570130,
					"content": "Ví dụ như rất nhiệt tình.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570132
					]
				},
				{
					"id": 732570132,
					"content": "Ừm, đúng vậy, hơn nữa chúng ta không phải luôn cùng nhau cố gắng giải quyết cái thiên tượng đó sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570133,
					"content": "Có thể đi được đến đây đều là nhờ vào Sorush cả đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570134,
					"content": "Có câu gì ấy nhỉ? À đúng, \"chỉ cần không ngừng tiến lên, thì việc trở thành một nhà mạo hiểm giỏi giang chỉ còn là vấn đề thời gian mà thôi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570135,
					"content": "Thật sao? Các người đang khen thật lòng đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570136
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570136,
					"content": "Đây là lời khen chân thành của bạn bè đó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570137
					]
				},
				{
					"id": 732570137,
					"content": "Hihi, ai da, quả không hổ danh là ta mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570138
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570138,
					"content": "Đột nhiên có động lực trở lại rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570139
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570139,
					"content": "Nếu Sorush phấn chấn lại rồi, vậy thì chúng ta mau chóng đi tìm Zurvan nào. Mau chóng giải quyết cái lỗ hổng to lớn đó để lấy thù lao, tôi đang cần ăn một bữa no nê đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570131,
					"content": "Ví dụ như rất có trách nhiệm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570132
					]
				},
				{
					"id": 732570124,
					"content": "\"Tư thế anh dũng\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570126
					]
				},
				{
					"id": 732570125,
					"content": "\"Định sẵn phải hy sinh\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570126
					]
				},
				{
					"id": 732570117,
					"content": "Cô còn chuyện cần phải làm mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570118
					]
				},
				{
					"id": 732570118,
					"content": "Tuy đúng là vậy thật, nhưng mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570119
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570104,
					"content": "Dù gì cũng trải qua chuyện như vậy mà...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570106
					]
				},
				{
					"id": 732570105,
					"content": "Chắc do cô ấy mệt thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570106
					]
				}
			]
		},
		{
			"id": 7325702,
			"completionStepIds": [
				7325702
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7325702",
