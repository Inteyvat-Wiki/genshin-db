						],
						"stepId": 7325702,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zurvan"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							390.447,
							312.914,
							5703.516
						],
						"pointId": 4535
					}
				]
			},
			"dialogs": [
				{
					"id": 732570201,
					"content": "Zurvan, chúng tôi đã quay về rồi đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570202,
					"content": "#Hừm, là {NICKNAME}, Sorush và Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570203
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570203,
					"content": "Nhìn bộ dạng của mọi người, chắc là đã lấy được tất cả Thánh Ca Khvarena rồi nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570204,
						732570205
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570204,
					"content": "Tuy có gặp chút trắc trở.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570206
					]
				},
				{
					"id": 732570206,
					"content": "Dù thế nào thì kết quả cũng như mong đợi, nhờ hai người quả thật là quyết định đúng đắn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570207
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570207,
					"content": "Nếu không phải nhờ hai người thì e là Thánh Ca Khvarena đã sớm bị những tên có âm mưu xấu xa đó cướp đi rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570208
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570208,
					"content": "Ủa, lời của Zurvan, sao nghe có vẻ như đã biết trước gì đó rồi vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570209,
					"content": "Haha, bị ta nói trúng thật rồi à, chẳng lẽ mọi người gặp phải những kẻ phục vụ cho vực thẳm thật sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570210,
						732570212
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570210,
					"content": "Sao Zurvan biết?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570211
					]
				},
				{
					"id": 732570211,
					"content": "Chuyện này à... thay vì nghiên cứu chuyện này thì hãy kể cho ta nghe chuyện gì đã xảy ra đi nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570214
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570214,
					"content": "Kể cho Zurvan về chuyến mạo hiểm trong di tích dưới lòng đất và việc Nasejuna phản bội.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732570215
					]
				},
				{
					"id": 732570215,
					"content": "Haha, thật không ngờ ngay cả Vijnanapati của Hội Nghi Hoặc cũng đi theo vực thẳm. Tuy không mong chờ gì ở họ, nhưng nghe ra cũng hơi quá đáng rồi đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570216
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570216,
					"content": "Hơn nữa nếu ta đoán không sai thì việc Nasejuna để ý đến Thánh Ca Khvarena, cũng do sự dụ dỗ từ kẻ phục vụ cho vực thẳm mà mọi người đã đụng độ. Dù sao thì người này cũng được xem là người quen cũ của ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570217
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570217,
					"content": "Hả? Zurvan quen biết người của Giáo Đoàn Vực Sâu sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570218,
					"content": "Hừ, tên đó vốn cũng là thành viên của Hội Nghi Hoặc. Vài trăm năm trước, từng có đội điều tra của rừng mưa đến nơi này để tìm hiểu về bí mật của người Dahri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570219
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570219,
					"content": "Bọn họ bỏ mặc sự khuyên ngăn của Hội Nghi Hoặc mà tiến vào di tích do người Dahri để lại. Để tránh xảy ra chuyện, Vijnanapati lúc đó đã ra lệnh cho hắn ta cùng đi theo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570220
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570220,
					"content": "Sau đó không biết đã gặp phải chuyện gì trong di tích, khi mọi người gặp lại hắn ta lần nữa thì hắn ta đã nhận được \"ban phước\" của sự ô uế, còn đội điều tra thì không rõ tung tích.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570221
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570221,
					"content": "Tín đồ của vực thẳm cũng kéo đến, bọn họ dòm ngó Thánh Ca Khvarena, và còn triệu hồi nhiều ma thú Dev tấn công Ốc Đảo Vourukasha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570222
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570222,
					"content": "Tuy nhờ nhiều Pari và dũng sĩ nhân loại mà Ốc Đảo Vourukasha mới được bảo toàn, nhưng mọi người đã không thể tiêu diệt hoàn toàn tín đồ vực thẳm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570223
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570223,
					"content": "Vì để ngăn chúng lọt vào, ta đã dùng sức mạnh của Thánh Ca Khvarena để phong ấn Ốc Đảo Vourukasha và các khu di tích lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570224
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570224,
					"content": "Còn Hội Nghi Hoặc cũng vì lần phản bội này mà bị tổn thất nặng nề, điển tích kế thừa bị đốt sạch. Từ đó về sau đã dần trở nên như bây giờ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570225
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570225,
					"content": "Trước kia nghe mọi người kể, ta đã nghi ngờ chúng đứng sau chuyện này rồi, nhưng không ngờ lần này ngay cả thủ lĩnh của Hội Nghi Hoặc cũng trở thành công cụ của chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570226
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570226,
					"content": "Nhưng lời của Nasejuna nói vẫn có điểm đáng để tâm, chắc Zurvan cũng biết một số việc liên quan đến tiền bối của Hội Nghi Hoặc đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570227,
					"content": "Dù sao thì Zurvan cũng từng kề vai chiến đấu cùng họ mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570228
					]
				},
				{
					"id": 732570228,
					"content": "Haha, lịch sử hóa thành truyền thuyết, truyền thuyết lại trở thành những câu chuyện, bản chất của nó chẳng qua chỉ có thế, quên đi nguyên bản cũng là một phần của câu chuyện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570229
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570229,
					"content": "Người nào càng cố chấp việc kế thừa thì càng có khuynh hướng chọn nhớ những câu chuyện mình muốn, để rồi cuối cùng lạc lối trong mê cung của những câu chuyện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570230
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570230,
					"content": "Trong thế giới không ngừng quên lãng này, so với những lời ngợi ca xa vời thì dấu vết mà chúng ta khắc ghi trên mặt đất đáng tin hơn nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570231
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570231,
					"content": "Vì vậy ta mới tin tưởng hai người, vì hai người nhìn giống loại người thẳng thắn không để tâm đến bình phẩm của người khác!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570232
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570232,
					"content": "Tuy có vẻ như đang khen chúng ta, nhưng không hiểu sao lại cảm thấy là lạ nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570233,
					"content": "Cảm giác như đang đá xéo ai đó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570234
					]
				},
				{
					"id": 732570234,
					"content": "Tiền bối đây là đang ám chỉ tôi đúng không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570235
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570235,
					"content": "Còn về chuyện của 500 năm trước, thay vì nghe ta kể thêm một câu chuyện nữa, thì chi bằng tự thân chứng kiến đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570236
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570236,
					"content": "Vừa hay giờ đây lại có cơ hội như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570237
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570237,
					"content": "Kể ra thì Sorush đã trông đáng tin cậy hơn nhiều rồi. Sau khi trải qua những chuyện này cũng đã đến lúc tỉnh giấc khỏi những truyền thuyết của nhân loại rồi nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570238
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570238,
					"content": "Tiền bối! Chuyện qua rồi thì đừng nhắc lại nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570239
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570239,
					"content": "#Xem ra nhờ {NICKNAME} và Paimon quả nhiên có tác dụng. Nếu vậy thì ta cũng yên tâm giao công việc hoàn thành \"Nghi Thức Ab-Zohr\" cho mọi người rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570240
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570240,
					"content": "\"Nghi Thức Ab-Zohr\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570241
					]
				},
				{
					"id": 732570241,
					"content": "Hình như từng nghe Zurvan nhắc qua rồi! Tôi nhớ là thanh tẩy sự ô uế gì đấy nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570242
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570242,
					"content": "Nghi Thức Ab-Zohr là nghi thức loại bỏ sự ô uế cho Harvisptokhm, thường thì chỉ cần cử hành dưới cây đại thụ trấn áp vực thẳm là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570243
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570243,
					"content": "Hiện giờ phong ấn của vực thẳm bị lung lay, hiện tượng lạ lần nữa xuất hiện trên bầu trời, nên đã không thể chỉ dùng nghi thức thông thường để giải quyết nữa rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570244
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570244,
					"content": "Hiện tượng này lại xuất hiện ở phía trên Harvisptokhm, là vì Harvisptokhm đã hấp thụ nhiều sự ô uế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570245
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570245,
					"content": "Trong Harvisptokhm tích lũy quá nhiều sự ô uế, đồng thời còn bị hiện tượng kỳ lạ ăn mòn, nên đã không thể duy trì được sức mạnh Khvarena nữa rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570246
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570246,
					"content": "Cách duy nhất bây giờ là đi vào trong Harvisptokhm để loại bỏ sự ô uế, đánh thức thần linh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570247
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570247,
					"content": "Thì ra là có thể đi vào bên trong Harvisptokhm sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570248
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570248,
					"content": "Nếu không chẳng lẽ mọi người cho rằng Nghi Thức Chinvat là để tiến vào trong vực thẳm sao? Cho dù là Pari thì cũng không có cách nào chịu được sự ô uế đó đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570249
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570249,
					"content": "Thần thức trú trên hoa sen khổng lồ Gaokerena nằm giữa Harvisptokhm, chỉ cần loại bỏ được sự ô uế thì nó sẽ nở ra Hoa Thánh Thuần mới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570250
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570250,
					"content": "Sau đó Amrita sẽ thanh tẩy mặt đất. Tuy có hơi phức tạp, nhưng nếu là hai người thì chắc sẽ giải quyết dễ dàng thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570251
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570251,
					"content": "Vậy nhé, ta đã để Rashnu và Mihir đến chỗ Vực Thẳm Tunigi trước rồi. Chỉ cần mang Thánh Ca Khvarena qua đó thì sẽ có thể hội tụ sức mạnh Khvarena rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570252
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570252,
					"content": "Khvarena sẽ đánh thức những cây đại thụ trấn áp vực thẳm, thanh tẩy sự ô uế dưới đáy. Sau đó tiến hành Nghi Thức Chinvat để mở ra con đường tiến vào Harvisptokhm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570253
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570253,
					"content": "Còn về sự nghiệp vĩ đại của những anh hùng thời xưa, chỉ cần tiến vào Harvisptokhm thì vòng hoa sẽ mở ra cho Sorush thấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570254
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570254,
					"content": "Dù sao tất cả ký ức liên quan đến Khvarena, cuối cùng cũng trở về với Harvisptokhm. Bất luận là lời truyền miệng trên thế gian muôn kiểu đổi thay, thì những ký ức này cũng sẽ không vì vậy mà phai mờ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570255
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570255,
					"content": "Đây là lần đầu tôi nghe về chuyện này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570256
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570256,
					"content": "Haha, vòng hoa vốn là một phần của Harvisptokhm, đợi đến khi đó thì cô sẽ biết thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570257
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570257,
					"content": "Vậy thì mọi người hãy đi dập tắt Thiên Tượng Apaosha đó nhé. Đợi khi Amrita từ trên trời đổ xuống thì khi đó chúng ta sẽ còn gặp lại nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570212,
					"content": "Đúng là vậy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570213
					]
				},
				{
					"id": 732570213,
					"content": "Nếu là vậy thì hãy kể cho ta nghe chuyện gì đã xảy ra đi nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570214
					],
					"speakerTitle": "Zurvan"
				},
				{
