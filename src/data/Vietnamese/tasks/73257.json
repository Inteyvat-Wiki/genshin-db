					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732573002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732573002,
					"content": "Những cái cây này được nuôi dưỡng bởi sức mạnh của Khvarena để chống lại sự ăn mòn của tai họa, nhưng sức mạnh đã dần hao mòn hết sau khoảng thời gian dài.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732573003
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732573003,
					"content": "Bây giờ có Thánh Ca Khvarena nuôi dưỡng, nó sẽ có thể khôi phục lại vinh quang ngày trước của mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732573004
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732573004,
					"content": "Nhưng nếu phong ấn đã bị giải trừ, vậy thì những ô uế tích lũy trong quá khứ có lẽ cũng sẽ bị giải phóng ra ngoài.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732573005
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732573005,
					"content": "Nếu ta và Rashnu tiếp tục tiêu hao hết sức mạnh ở đây thì sẽ không thể tiến hành nghi thức, nên những nơi tiếp theo cần nhờ mọi người rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732573006
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732573006,
					"content": "Haha, cứ giao cho ta đi, dù sao thì việc chống lại ô uế cũng là công việc của dũng sĩ mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sorush"
				}
			]
