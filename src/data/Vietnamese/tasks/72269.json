			"dialogs": [
				{
					"id": 722690101,
					"content": "Ta là Jibashiri - Eki. Dũng sĩ Sangonomiya, ta thừa nhận ngươi xứng đáng để thực hiện khiêu chiến này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722690102
					],
					"speakerTitle": "Eki"
				},
				{
					"id": 722690102,
					"content": "Ta sẽ chủ trì thí luyện \"điều tra\". Hãy giải tất cả các câu đố, để \"Ngọn Lửa Cửa Cao\" trở về vị trí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722690103
					],
					"speakerTitle": "Eki"
				},
				{
					"id": 722690103,
					"content": "Chiến trường thay đổi nhanh chóng. Tai phải nghe tám phương, mắt phải nhìn sáu hướng mới có thể nắm bắt tình hình, nắm chắc mọi thay đổi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722690103
					],
					"speakerTitle": "Eki"
				}
			]
		},
