			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Thoma"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20170403,
					"content": "#{NICKNAME}, sao hai bạn lại quay về đây rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170404
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170404,
					"content": "Đã gặp được quân kháng chiến chưa? Tình hình chiến trận thế nào rồi? Tôi có thể ra ngoài được chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170405
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170405,
					"content": "Có lẽ vẫn chưa... Khi chúng tôi tới vẫn thấy có rất nhiều lính tuần tra bên ngoài.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170406,
					"content": "Xem ra vẫn chưa kết thúc... vậy thì các bạn đến đây, tôi nghĩ là có chuyện cần tìm chúng tôi thương lượng đúng không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170407
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170407,
					"content": "Để tôi tìm người gọi tiểu thư đến, chờ chút nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170408
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170408,
					"content": "Kể tình hình hiện tại cho Thoma và Ayaka nghe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170409,
					"content": "Thì ra là vậy, các bạn cũng trải qua nhiều chuyện nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170410
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170410,
					"content": "Tôi đã nắm được tình hình rồi, chuyện tìm chứng cứ phản loạn của Hiệp Hội Tenryou, để tôi nghĩ cách...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170411
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170411,
					"content": "Nói ra tôi mới để ý, Shogunate và quân kháng chiến giao chiến đã lâu, nhưng Shogun chưa từng hỏi qua chuyện này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170412
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170412,
					"content": "Tôi tưởng rằng Shogun không để tâm đến việc này, nhưng giờ đây suy nghĩ lại, có thể <color=#00E1FFFF>công văn</color> của Hiệp Hội Tenryou trình cho Shogun có vấn đề.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170413
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170413,
					"content": "Ý của Ayaka là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170414,
					"content": "Hiệp Hội Tenryou nắm giữ mọi việc của quân đội, nếu như họ có ý muốn che giấu thì chúng tôi sẽ không thể nào biết được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170415
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170415,
					"content": "Kết quả cho thấy, Shogun đang hiểu sai về tình hình của Lệnh Truy Lùng Vision, cho nên vẫn hành động theo ý mình. Nếu như mình có thể lấy được công văn đó thì mọi chuyện sẽ sáng tỏ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170416
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170416,
					"content": "Theo tôi nhớ, người có quyền lực tiếp xúc với những công văn thượng tấu đó, chỉ có Kujou Takayuki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170417
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170417,
					"content": "Nhưng ở đó có nhiều thân binh canh giữ, cho dù có Sayu giúp đỡ đi nữa cũng khó lòng trộm được công văn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170418
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170418,
