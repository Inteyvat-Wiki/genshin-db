				"points": []
			},
			"dialogs": [
				{
					"id": 20170201,
					"content": "Ối, Tanuki biến thành người rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170202,
					"content": "Đây là gì vậy, lần đầu tiên thấy đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170203,
					"content": "Không phải Tanuki... mà là Mujina... Hơ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170204
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170204,
					"content": "Buồn ngủ quá... ngủ không đủ giấc thì sẽ không cao lên được đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170205
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170205,
					"content": "Không lẽ đây là \"chuyên gia\" mà tiểu thư Yae nhắc đến sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170206,
					"content": "Trông có vẻ sai sai sao ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170207,
					"content": "...Đây là thành viên của \"Shuumatsuban\", là một Ninja xịn đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170208
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20170208,
					"content": "Ninja! Vậy ban nãy, không lẽ là thuật thế thân trong truyền thuyết sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170209,
					"content": "Nhưng mà, \"Shuumatsuban\" là gì nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170210,
					"content": "Shuumatsuban trực thuộc Hiệp Hội Yashiro, là đội quân bí mật của Kamisato Ayato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170211
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20170211,
					"content": "Giờ đây Kamisato Ayato và Hiệp Hội Yashiro đang giữ thái độ trung lập, nên tôi cũng không thể điều động Shuumatsuban.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170212
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20170212,
					"content": "Nhưng mà, việc tóm cổ một thành viên lười biếng của Shuumatsuban đến giúp đỡ thì cũng không phải chuyện khó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170213
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20170213,
					"content": "Hứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170214
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170214,
					"content": "Vậy thì nhờ các bạn trà trộn vào trong thành để tìm chứng cứ phản loạn của Hiệp Hội Tenryou nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170215
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20170215,
					"content": "Dẫu sao dưới thân phận của tôi thì tôi cũng không thích hợp lộ mặt cho lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170216
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20170216,
					"content": "Cho dù có nói vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170217,
						20170218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170217,
					"content": "Cảm giác không có chút manh mối gì.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170219
					]
				},
				{
					"id": 20170219,
					"content": "Hừm? Tôi còn nghĩ bạn đã đoán ra rồi chứ. Được rồi, vậy tôi sẽ gợi ý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170220
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20170220,
					"content": "Đối với người ngoài mà nói, nếu muốn lật tẩy Hiệp Hội Tenryou đúng là rất khó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170221
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20170221,
					"content": "Nhưng Hiệp Hội Tam Cực cùng phò trợ Shogun, quan hệ rất mật thiết, vì vậy có một hiệp hội có thể phát hiện được sự bất thường trong đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170222
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20170222,
					"content": "Hiệp Hội Yashiro!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170223
					]
				},
				{
					"id": 20170223,
					"content": "Ha ha... xem ra bạn cũng hiểu được đôi chút rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170224
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20170224,
					"content": "Shogunate vẫn đang truy nã bạn, nhưng với sự giúp đỡ của vị ninja này, tin rằng rất nhanh thôi bạn sẽ gặp lại bạn bè.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170225
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20170225,
					"content": "Đừng quên lấy chứng cứ cho tôi trước giờ hẹn nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20170218,
					"content": "Chứng cứ rốt cuộc là gì chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170219
					]
				}
			]
		},
		{
