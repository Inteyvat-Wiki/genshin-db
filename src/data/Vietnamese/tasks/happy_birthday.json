			"dialogs": [
				{
					"id": 741430501,
					"content": "Lanoire! Lanoire! Cháu không sao chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430502
					],
					"speakerTitle": "Earnshaw"
				},
				{
					"id": 741430502,
					"content": "Ông ngoại! Cháu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430503
					],
					"speakerTitle": "Lanoire"
				},
				{
					"id": 741430503,
					"content": "A...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741430504,
					"content": "#Tốt quá rồi. Cảm ơn {NICKNAME} và Paimon. Nhờ các cháu mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430505,
						741430506
					],
					"speakerTitle": "Earnshaw"
				},
				{
					"id": 741430505,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741430507
					]
				},
				{
					"id": 741430507,
					"content": "Nhưng... Vừa rồi là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741430508,
					"content": "Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741430509
					]
				},
				{
					"id": 741430509,
					"content": "À ừm, nhưng mà... Ừm, hiểu rồi! Ôi... May mà Lanoire không sao, thật là tốt quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741430510,
					"content": "#Cảm ơn ông ngoại. Cảm ơn {M#anh}{F#chị} {NICKNAME} và chị Paimon nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430511
					],
					"speakerTitle": "Lanoire"
				},
				{
					"id": 741430511,
					"content": "Sau này không được chạy lung tung đó! Làm ông lo lắng chết mất...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430512
					],
					"speakerTitle": "Earnshaw"
				},
				{
					"id": 741430512,
					"content": "Thật ngại quá, phiền cô phải đến đây rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430513
					],
					"speakerTitle": "Earnshaw"
				},
				{
					"id": 741430513,
					"content": "Chuyện nên làm thôi, đứa nhỏ không sao thì tốt rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430514
					],
					"speakerTitle": "Charlene"
				},
				{
					"id": 741430514,
					"content": "(Lanoire, em vẫn ổn chứ...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741430515,
					"content": "#(Em hiểu những gì anh Caterpillar đã nói và tại sao {M#anh}{F#chị} {NICKNAME} lại không nói gì với ông ngoại rồi.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430516
					],
					"speakerTitle": "Lanoire"
				},
				{
					"id": 741430516,
					"content": "(Nên em cũng không nói với ông ngoại. Em sẽ không để ông ngoại lo lắng, bởi vì em là một đứa trẻ ngoan.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430517
					],
					"speakerTitle": "Lanoire"
				},
				{
					"id": 741430517,
					"content": "(Lanoire rất thông minh đấy.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741430518,
					"content": "(...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430519
					],
					"speakerTitle": "Lanoire"
				},
				{
					"id": 741430519,
					"content": "(Không, em không hề thông minh. Em không biết những lời cuối cùng của anh Caterpillar có ý gì, tại sao anh ấy lại cảm ơn em. Rõ ràng anh ấy luôn là người giúp đỡ em mà.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430520
					],
					"speakerTitle": "Lanoire"
				},
				{
					"id": 741430520,
					"content": "(Khi nào lớn lên em sẽ đến gặp anh Caterpillar để hỏi rõ ràng. Đến lúc đó, em sẽ kể cho anh ấy thật nhiều, còn phải đưa bánh kem cho anh ấy nữa.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430521
					],
					"speakerTitle": "Lanoire"
				},
				{
					"id": 741430521,
					"content": "#({M#Anh}{F#Chị} {NICKNAME}, chị Paimon, đợi em trưởng thành rồi chúng ta cùng đi tìm anh Caterpillar nhé?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430522,
						741430523
					],
					"speakerTitle": "Lanoire"
				},
				{
					"id": 741430522,
					"content": "Chờ em lớn trước đã.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741430524
					]
				},
				{
					"id": 741430524,
					"content": "Vậy thì quyết định thế nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430525
					],
					"speakerTitle": "Lanoire"
				},
				{
					"id": 741430525,
					"content": "Họ cùng nhau rời đi.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 741430523,
					"content": "Được...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741430524
					]
				},
				{
					"id": 741430506,
					"content": "Không cần cảm ơn chúng cháu đâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741430507
					]
				}
			]
