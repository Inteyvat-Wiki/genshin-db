			"dialogs": [
				{
					"id": 741430201,
					"content": "Các cháu... Ta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430202
					],
					"speakerTitle": "Earnshaw"
				},
				{
					"id": 741430202,
					"content": "Ơ, ông Earnshaw sao lại thở gấp thế...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741430203,
					"content": "Lanoire, Lanoire... Con bé bị Hilichurl bắt đi rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430204
					],
					"speakerTitle": "Earnshaw"
				},
				{
					"id": 741430204,
					"content": "Hả? Sao lại như thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741430205,
					"content": "Nó chạy hướng kia! Ta đi tìm người giúp, các cháu qua đó xem tình hình giùm ta nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430206
					],
					"speakerTitle": "Earnshaw"
				},
				{
					"id": 741430206,
					"content": "Chúng cháu hiểu rồi! Mau đuổi theo thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
