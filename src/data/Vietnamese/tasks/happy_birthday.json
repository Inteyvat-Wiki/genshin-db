					}
				]
			},
			"dialogs": [
				{
					"id": 741430401,
					"content": "Là hai vị à.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430402
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741430402,
					"content": "Hả! Hóa ra là Caterpillar à! Đúng là, làm tôi lo gần chết...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741430403,
					"content": "#Ôi! Là {M#anh}{F#chị} {NICKNAME}, có cả chị Paimon nữa! Hôm nay vui quá, những người em thích đều đến cả rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430404
					],
					"speakerTitle": "Lanoire"
				},
				{
					"id": 741430404,
					"content": "Ông ngoại còn làm cho em một chiếc bánh sinh nhật vừa to vừa ngọt đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430405
					],
					"speakerTitle": "Lanoire"
				},
				{
					"id": 741430405,
					"content": "Ồ! Hôm nay là sinh nhật của Lanoire sao? Sinh nhật vui vẻ nhé! Bánh kem... còn không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741430406,
					"content": "Hmm... Chúng em ăn hết rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430407
					],
					"speakerTitle": "Lanoire"
				},
				{
					"id": 741430407,
					"content": "Hả? Chậc, sao lại thế chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741430408,
					"content": "Caterpillar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741430409
					]
				},
				{
					"id": 741430409,
					"content": "Anh vẫn ổn chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741430410
					]
				},
				{
					"id": 741430410,
					"content": "Không cần lo cho tôi đâu. Hôm nay là ngày vui, nên đừng nói những chuyện làm mất hứng nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430411
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741430411,
					"content": "#Dù sao thì cũng cảm ơn nhé, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430412
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741430412,
					"content": "Đang nói gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741430413,
					"content": "Haha, không có gì. Chỉ cảm thấy lần cuối \"Đội Trẻ Con\" chúng ta gặp nhau đã là... chuyện lâu lắm rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430414
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741430414,
					"content": "Nhưng, tại sao anh Caterpillar lại đưa em đến đây? Thật kỳ lạ, ông Earnshaw nhìn thấy anh Caterpillar cũng rất sợ hãi. Ngay cả Dũng Sĩ, Hoàng Tử và Công Chúa cũng thế!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430415
					],
					"speakerTitle": "Lanoire"
				},
				{
					"id": 741430415,
					"content": "Rõ ràng mỗi lần ông ngoại nghe em kể về anh Caterpillar đều nói là muốn mời anh ấy đến nhà làm khách mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430416
					],
					"speakerTitle": "Lanoire"
				},
				{
					"id": 741430416,
					"content": "Ừm, dù sao thì hình dạng của Caterpillar... Sao anh lại không muốn biến thành hình dạng con người như trước đây vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741430417,
					"content": "Không phải không muốn. Chỉ là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430418
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741430418,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741430419,
					"content": "Hình dạng này của anh Caterpillar cũng rất tốt mà! Vừa rồi em ngồi trên vai anh ấy là có thể hái được Trái Bulle rồi. Anh ấy chạy nhanh như gió vậy, thật lợi hại!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430420
					],
					"speakerTitle": "Lanoire"
				},
				{
					"id": 741430420,
					"content": "Lanoire, em phải ghi nhớ. Nếu có gặp phải \"người\" trông giống anh thì tuyệt đối không được đến gần nhé, nguy hiểm lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430421
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741430421,
					"content": "Thật sao? Nhưng anh Caterpillar không có nguy hiểm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430422
					],
					"speakerTitle": "Lanoire"
				},
				{
					"id": 741430422,
					"content": "Lanoire, hãy hứa với anh nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430423
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741430423,
					"content": "Ban đầu cứ nghĩ rằng Caterpillar sẽ dùng trò gì đó để ảnh hưởng Lanoire.\\nNhưng cuối cùng thì anh ta không làm như vậy, mà chỉ nghiêm túc chờ đợi câu trả lời của Lanoire thôi.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741430424
					]
				},
				{
					"id": 741430424,
					"content": "Nhưng mà... Được rồi. Em hứa với anh Caterpillar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430425
					],
					"speakerTitle": "Lanoire"
				},
				{
					"id": 741430425,
					"content": "Nhưng mà... Sau này em phải làm thế nào mới nhận ra anh Caterpillar đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430426
					],
					"speakerTitle": "Lanoire"
				},
				{
					"id": 741430426,
					"content": "Đúng rồi! Anh Caterpillar, sau khi rời khỏi Pháo Đài Meropide, em mới biết là bên ngoài rộng lớn như vậy. Mỗi ngày em đều đi về các hướng khác nhau, nhưng đến giờ vẫn chưa thấy bức tường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430427
					],
					"speakerTitle": "Lanoire"
				},
				{
					"id": 741430427,
					"content": "Lúc có mặt trời thì rất nóng, buổi tối thì rất lạnh. Phải rồi! Đến ban đêm còn có gió thổi vào mặt hồ rất mát mẻ, không giống như quạt gió. Tại sao lại như vậy ạ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430428
					],
					"speakerTitle": "Lanoire"
				},
				{
					"id": 741430428,
					"content": "Còn nữa, lúc Dũng Sĩ nằm bên cạnh em và ông ngoại thì thường đưa mắt lên nhìn em. Lúc Hoàng Tử ngủ, thỉnh thoảng còn giật giật cái chân sau nữa, rất thú vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430429
					],
					"speakerTitle": "Lanoire"
				},
				{
					"id": 741430429,
					"content": "Sau đó... Em phát hiện ra, khi em đi trên cỏ mà không mang giày, cỏ sẽ lùa vào kẽ chân, cảm giác hơi nhói. Em đọc trong sách cứ tưởng là cỏ sẽ rất mềm chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430430
					],
					"speakerTitle": "Lanoire"
				},
				{
					"id": 741430430,
					"content": "Còn nữa, loài hoa mà chú Estienne từng tặng em, bên ngoài còn có rất nhiều. Không ngờ những bông hoa đó lại có rễ đâm sâu vào đất. Tại sao lại như vậy nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430431
					],
					"speakerTitle": "Lanoire"
				},
				{
					"id": 741430431,
					"content": "Thế giới này thật rộng lớn và diệu kỳ, lại có rất nhiều màu sắc khác nhau. Em có rất nhiều chuyện muốn kể cho anh Caterpillar nghe, và cũng muốn anh kể lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430432
					],
					"speakerTitle": "Lanoire"
				},
				{
					"id": 741430432,
					"content": "Nhưng em phải làm thế nào mới tìm được anh Caterpillar đây? Giống như học trò của phù thủy vẫn luôn muốn tìm được cá con vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430433
					],
					"speakerTitle": "Lanoire"
				},
				{
					"id": 741430433,
					"content": "Em vẫn còn nhớ câu chuyện đó sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430434
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741430434,
					"content": "Đương nhiên là em sẽ không quên! Em vẫn luôn chờ anh Caterpillar về để kể nốt câu chuyện này cho em đó. Cuối cùng học trò có tìm thấy cá con không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430435
					],
					"speakerTitle": "Lanoire"
				},
				{
					"id": 741430435,
					"content": "Chuyện đó à. Rất lâu sau đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430436
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741430436,
					"content": "Học trò ngốc nghếch đã lấy dũng khí để tạm biệt phù thủy, rời khỏi công xưởng, bước lên chuyến hành trình tìm kiếm cá con.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430437
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741430437,
					"content": "Nhưng học trò chưa bao giờ nhìn thấy biển cả rộng lớn, nên không hiểu quê hương mà cá con nhắc đến là nơi như thế nào. Vậy là học trò đành phải hỏi thăm dọc đường...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430438
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741430438,
					"content": "Học trò hỏi cỏ lau bên bờ sông, cỏ lau nghe xong liền cười to.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430439
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741430439,
					"content": "\"Thứ bạn đang tìm là biển cả\", cỏ lau nói. \"Đó là một nơi rộng hơn sông gấp trăm lần, là nơi mà mọi dòng sông đều đổ về.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430440
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741430440,
					"content": "Học trò men theo hướng sông chảy và tìm thấy biển. Nhưng biển rộng bao la, mà học trò thì hoàn toàn không có phương hướng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430441
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741430441,
					"content": "Thế là học trò hỏi Hải Âu Tử Kim bên bến cảng, hải âu nghe xong liền giật mình há miệng, rơi cả miếng khoai tây đang ngậm xuống đất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430442
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741430442,
					"content": "\"Này, đây là chuyện không thể nào\", hải âu nói. \"Từ xưa tới nay chưa từng có ai tìm thấy một con cá con trong biển cả. Hơn nữa, chưa biết chừng nó đã...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430443
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741430443,
					"content": "Học trò dùng bánh mì chặn miệng hải âu, và không để ý đến nó và đám bạn ồn ào của nó nữa. Sau đó tiếp tục vừa hỏi vừa tìm dọc theo đường bờ biển.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430444
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741430444,
					"content": "Vì là học trò ngốc, nên chỉ biết tìm theo cách ngốc nhất. Học trò đã dành rất nhiều thời gian để học lặn và bơi đến nơi sâu và xa hơn của biển cả...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430445
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741430445,
					"content": "Em đoán cuối cùng học trò sẽ tìm được! Chỉ cần khát vọng đủ mãnh liệt và không từ bỏ thì sẽ thực hiện được mong muốn! Đó là những gì ông ngoại đã nói với em.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430446
					],
					"speakerTitle": "Lanoire"
				},
				{
					"id": 741430446,
					"content": "Em thích một kết thúc có hậu sao... Được thôi, ông Earnshaw nói đúng, tuy học trò ngốc nghếch, nhưng cuối cùng cũng tìm được cá con bằng phương pháp ngốc nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430447
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741430447,
					"content": "Khi tìm thấy cá con, nó và gia đình đang vẫy vùng trong làn nước. Đàn cá tuy luôn thay đổi hình dạng, nhưng học trò chỉ nhìn thoáng qua đã nhận ra cá con trong đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430448
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741430448,
					"content": "\"Cuối cùng cũng tìm được rồi...\" Học trò đã hoàn thành tâm nguyện, nhưng tâm trạng khi đó lại không hưng phấn như tưởng tượng. Ngược lại có phần bối rối.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430449
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741430449,
					"content": "Đàn cá tò mò vây quanh, thúc giục học trò kể lại đầu đuôi câu chuyện. Học trò vụng về giải thích mọi chuyện đã xảy ra trước đó, rồi thở ra dòng bong bóng dài trong nước như trút được gánh nặng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430450
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741430450,
					"content": "\"Tôi nên xin lỗi hai lần\", học trò nói. \"Một lần vì lúc trước tôi không thể lấy hết dũng khí ra khi bạn xin giúp đỡ. Một lần là vì cuộc ghé thăm đường đột này...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430451
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741430451,
					"content": "\"Cuối cùng sau khi gặp lại, tôi mới nhận ra mình ích kỷ đến mức nào... Tôi chỉ nghĩ rằng nếu tôi có thể xin lỗi trước mặt bạn, thì tôi sẽ có thể tha thứ cho bản thân mình trong quá khứ.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430452
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741430452,
					"content": "\"Việc đó thì có liên quan gì đâu?\" Câu trả lời của cá con nằm ngoài dự đoán của học trò. \"Nhìn xem, trước kia bạn không thể giúp được tôi, nhưng bây giờ tôi cũng về được quê hương, về được bên cạnh người thân rồi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430453
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741430453,
					"content": "\"Tôi không tổn thương vì điều đó đâu, cho nên bạn cũng không cần xin lỗi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430454
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741430454,
					"content": "\"Vì chuyện nhỏ này mà tốn bao nhiêu thời gian và công sức, thật không biết nên nói bạn chính trực hay là ngốc nghếch đây. Nhưng dù như vậy thì chúng tôi cũng không ngại làm bạn với con người ngốc nghếch đâu...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430455
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741430455,
					"content": "Ối! Vậy là cuối cùng họ trở thành bạn bè sao? Tình tiết sau đó thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430456
					],
					"speakerTitle": "Lanoire"
				},
				{
					"id": 741430456,
					"content": "Tình tiết sau đó sao? Họ đã trở thành bạn bè thân thiết nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430457
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741430457,
					"content": "Hả? Hết rồi à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430458
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741430458,
					"content": "Câu chuyện sẽ kết thúc như vậy sao? Anh Caterpillar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430459
					],
					"speakerTitle": "Lanoire"
				},
				{
					"id": 741430459,
					"content": "Ừm, câu chuyện của anh đã kết thúc rồi. Nếu câu chuyện không dừng lại đúng chỗ thì sẽ thật nhàm chán. Anh hùng sẽ lại trở thành rồng ma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430460
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741430460,
					"content": "Anh đã từng nghe câu chuyện dài lê thê rồi, đoạn kết rất tệ. Những người trong câu chuyện đó cũng rất đau lòng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430461
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741430461,
					"content": "Nhưng Lanoire thân mến, câu chuyện phiêu lưu mang tên cuộc sống của em vẫn còn tiếp diễn. Chúc em sinh nhật vui vẻ. Một ngày nào đó, em hãy kể lại câu chuyện của mình cho anh nghe nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430462
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741430462,
					"content": "Vâng... Em hứa với anh Caterpillar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430463
					],
					"speakerTitle": "Lanoire"
				},
				{
					"id": 741430463,
					"content": "Chắc chắn em sẽ tìm được anh, sau đó sẽ kể cho anh nghe thật nhiều câu chuyện. Em còn muốn làm cho anh chiếc bánh sinh nhật vừa to vừa ngọt nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430464
					],
					"speakerTitle": "Lanoire"
				},
				{
					"id": 741430464,
					"content": "Haha, bánh sinh nhật thì thôi. Anh cũng không biết ngày sinh nhật của mình đâu, chỉ biết được thời gian khi tỉnh lại thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430465
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741430465,
					"content": "Cảm ơn em, Lanoire. Bởi vì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Caterpillar"
				}
			]
		},
