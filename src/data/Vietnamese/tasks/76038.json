				{
					"id": 760380409,
					"content": "(Chắc <color=#FFCC33FF>Flins</color> sẽ có hứng thú với điêu khắc đường nhỉ...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760380401
					]
				},
				{
					"id": 760380401,
					"content": "Cô Hunajatta, nếu được thì hãy làm cho tôi một phần điêu khắc đường nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380402
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760380402,
					"content": "Được thôi. Anh là... vị Ratnik tên Flins đúng không? Lúc trước tôi đã từng thấy anh trong cửa tiệm rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380403
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380403,
					"content": "Đúng thế. Thỉnh thoảng tôi có quay lại mua sắm đồ đạc. Cô vẫn nhớ tôi sao, thật là vinh hạnh quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380404
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760380404,
					"content": "Hôm nay tôi vừa hay đi ngang qua đây, mới được thấy tài nghệ tạo hình kẹo điêu khắc đường cao siêu của cô.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380405
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760380405,
