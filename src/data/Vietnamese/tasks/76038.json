			},
			"dialogs": [
				{
					"id": 760380310,
					"content": "(Chắc <color=#FFCC33FF>Lauma</color> sẽ có hứng thú với điêu khắc đường nhỉ...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760380301
					]
				},
				{
					"id": 760380301,
					"content": "Cô Hunajatta, làm cho tôi vài phần điêu khắc đường nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380302
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760380302,
					"content": "Không thành vấn đề, tiểu thư Lauma. Lần trước cô mang điêu khắc đường về bọn trẻ có thích không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380303
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380303,
					"content": "Haha, chúng rất thích. Có đứa cứ cầm mãi không nỡ ăn, đến khi kẹo sắp tan rồi mới từ từ nếm thử.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380304
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760380304,
					"content": "Vậy à... Ừm, lần sau tôi mang theo đồ nghề đến chỗ cô để làm cho bọn trẻ ngay tại chỗ luôn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380305
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380305,
					"content": "Thế thì tốt quá! Bọn trẻ nhất định sẽ rất vui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380306
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760380306,
					"content": "À, nói hơi xa rồi... Lát nữa tôi sẽ đi làm kẹo. Khi nào làm xong sẽ nhờ người đem đến chỗ các vị nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380307
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380307,
					"content": "Nhưng trước lúc đó... Hì hì, vừa hay tôi có một ý tưởng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380308
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380308,
					"content": "Tiểu thư Lauma chờ một chút nhé. Tôi sẽ làm cho cô một phần điêu khắc đường tạo hình đặc biệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hunajatta"
				}
			]
		},
