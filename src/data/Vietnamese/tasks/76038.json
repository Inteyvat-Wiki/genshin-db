					"Hunajatta"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760381001,
					"content": "(Chắc <color=#FFCC33FF>Illuga</color> sẽ có hứng thú với điêu khắc đường nhỉ...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760381002
					]
				},
				{
					"id": 760381002,
					"content": "Dù sao cũng đã đến rồi... Xin chào, cho tôi một phần điêu khắc đường nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381003
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760381003,
					"content": "Ồ! Nhờ cô làm phần nhỏ một chút nhé, tôi sợ sẽ có việc đột xuất, không ăn hết kịp...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381004
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760381004,
					"content": "Không thành vấn đề! Yên tâm đi, dù là điêu khắc đường phần nhỏ thì hương vị vẫn ngon như thường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381005
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381005,
					"content": "Nhưng mà nhiệm vụ của Ratnik đúng bận rộn thật đấy... đến mức không kịp ăn hết điêu khắc đường...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381006
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381006,
					"content": "Hahaha... Cũng không hoàn toàn là do nhiệm vụ đâu, thỉnh thoảng cũng do gặp phải người cần giúp đỡ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381007
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760381007,
					"content": "Cô cũng biết đấy, điêu khắc đường ăn giữa chừng sẽ rất khó bảo quản, cùng lắm thì tôi chỉ có thể dùng vải gói lại rồi bỏ vào túi thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381008
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760381008,
					"content": "Mà đợi đến khi tôi xong việc và lấy miếng vải ra, thì điêu khắc đường bên trong đã chảy hết rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381009
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760381009,
					"content": "Ra là vậy... Để tôi nghĩ xem nào, điêu khắc đường cỡ nhỏ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381010
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381010,
					"content": "Có rồi, tôi có thể làm nhiều điêu khắc đường cỡ nhỏ với hương vị khác nhau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381011
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381011,
					"content": "Đặt vị này ở dưới... rồi đặt vị kia lên trên...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381012
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381012,
					"content": "Được rồi, xem thử tác phẩm điêu khắc đường nhỏ kết hợp nhiều vị này có vừa ý không nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381013
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381013,
					"content": "Tuyệt lắm! Cảm ơn cô, Hunajatta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381014
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760381014,
					"content": "Không sao đâu. Tuy tôi không thể chia sẻ công việc với các Ratnik... nhưng nếu muốn ăn điêu khắc đường thì muốn bao nhiêu có bấy nhiêu nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381015
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381015,
					"content": "Đây là chức trách của chúng tôi, cô Hunajatta khách sáo quá rồi... Vậy tôi xin phép đi trước nhé, tôi còn nhiệm vụ cần phải xử lý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381016
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760381016,
					"content": "Được rồi, đi thong thả, lần sau muốn ăn điêu khắc đường thì cứ ghé qua nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hunajatta"
				}
			]
		},
