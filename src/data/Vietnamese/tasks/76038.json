			"trigger": {
				"objectNames": [
					"Hunajatta"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760380101,
					"content": "(Chắc <color=#FFCC33FF>Nefer</color> sẽ có hứng thú với điêu khắc đường nhỉ...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760380102
					]
				},
				{
					"id": 760380102,
					"content": "Cho tôi một phần điêu khắc đường nhé, Hunajatta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380103
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 760380103,
					"content": "Cô chủ Nefer, sao lại có thời gian đến mua điêu khắc đường thế này?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380104
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380104,
					"content": "Thỉnh thoảng ra ngoài đi bộ cũng tốt cho cơ thể và tinh thần mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380105
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 760380105,
					"content": "Ăn chút đồ ngọt cũng sẽ có lợi cho việc suy nghĩ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380106
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 760380106,
					"content": "Được thôi! Đợi một lát nhé, để tôi làm cho cô một phần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380107
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380107,
					"content": "Được. À, tiền này đưa cô trước, lần sau khi Jahoda đến...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380108
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 760380108,
					"content": "Làm cho cô ấy một phần to hơn? Hay là ngọt hơn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380109
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380109,
					"content": "Đưa chỗ tiền này cho cô ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380110
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 760380110,
					"content": "Nói là: \"Nefer trả tiền gấp đôi đấy. Sau khi lười biếng xong thì hãy đem một phần điêu khắc đường về cho cô ấy.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nefer"
				}
			]
		},
