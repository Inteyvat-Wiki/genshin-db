				{
					"id": 760381109,
					"content": "(Chắc <color=#FFCC33FF>Linnea</color> sẽ có hứng thú với điêu khắc đường nhỉ...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760381101
					]
				},
				{
					"id": 760381101,
					"content": "Cô Linnea, lại đến mua điêu khắc đường cho Lumi à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381102
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381102,
					"content": "Đúng vậy! Lumi rất thích điêu khắc đường cô làm, mỗi lần đều không nỡ ăn, chỉ nếm một chút rồi đưa tôi cất đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381103
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 760381103,
					"content": "Nhưng mà, dù sao nó cũng là điêu khắc đường... nếm nhiều là cũng tan hết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381104
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 760381104,
					"content": "Vậy nên, nhờ cô Hunajatta làm thêm một phần điêu khắc đường cho Lumi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381105
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 760381105,
					"content": "Không thành vấn đề! Xin đợi một chút...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381106
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381106,
					"content": "(Chà, Lumi đáng yêu quá! Thật muốn vuốt ve! Nhưng mà tùy tiện vuốt ve như vậy thì... Thôi thôi, như vậy thật mất lịch sự...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381107
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381107,
					"content": "Làm xong rồi đây, tiểu thư Linnea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381108
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381108,
					"content": "Cảm ơn nhé! Lumi, điêu khắc đường xong rồi nè, giờ ăn luôn nhé... Ối, ngủ thiếp mất rồi à, vậy để lát đưa sau vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linnea"
				}
