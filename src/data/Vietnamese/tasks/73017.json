			"trigger": {
				"objectNames": [
					"Paimon",
					"Arakunti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730170201,
					"content": "Chà! Xem như đã tìm thấy rồi! Bạn là Arakunti đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170202,
					"content": "Tôi không phải.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170203
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170203,
					"content": "Hả? Đây là ý gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170204,
					"content": "Bởi vì tôi có thể là cây cối, là cơn mưa, là giấc mơ của Vana, cũng có thể là dây đàn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170205
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170205,
					"content": "Ồ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170206,
					"content": "#Không hiểu gì luôn! {NICKNAME}, bạn có hiểu không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170207,
						730170209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170207,
					"content": "Tôi cũng không hiểu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170208
					]
				},
				{
					"id": 730170208,
					"content": "Tôi cảm thấy mình có thể hiểu nghĩa từng từ, nhưng gộp chung thành câu lại chẳng hiểu gì hết...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170213,
					"content": "Nara Vàng và thứ nhỏ bé biết bay, tại sao lại muốn tìm Arakunti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170214
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170214,
					"content": "Tôi không phải là \"thứ nhỏ bé biết bay\"! Khoan đã, hình như tôi đúng là...? Này! Tóm lại tôi là Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170215,
					"content": "#\"Nara Vàng\" cũng có tên riêng đó, là {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170216,
					"content": "Chính Arapandu đã nói cho chúng tôi biết rằng Arakunti đang ở trong Khoảnh Rừng Mơ, bảo chúng tôi đến xem tình hình thế nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170217,
					"content": "Paimon có thể nói cho Arapandu biết, Arakunti rất ổn, Khoảnh Rừng Mơ rất tốt, Giấc Mộng Ẩm Ướt cũng rất tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170218
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170218,
					"content": "#Được... {NICKNAME}, vậy chúng ta quay về tìm Arapandu thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170219,
					"content": "...Không phải thế! Chúng tôi tới đây để sửa chữa Cỗ Máy Varuna! Nguy hiểm quá, suýt nữa đã bị nắm mũi dắt đi rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170220,
					"content": "Paimon có thể nói cho Arapandu biết, Arakunti không muốn nắm mũi Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170221
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170221,
					"content": "Arapandu chắc không muốn biết về chuyện này.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170222
					]
				},
				{
					"id": 730170222,
					"content": "Tôi cũng không muốn biết! Aranara này bị sao thế!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170223,
					"content": "Nhớ những gì Arapandu từng nói...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170224
					]
				},
				{
					"id": 730170224,
					"content": "Lúc Arapandu nhắc tới Arakunti đã nói, \"Arakunti xa cách với Nara hơn\"... Ý là Arakunti không biết cách để giao tiếp với người khác sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170225,
					"content": "Là chúng ta không biết cách để giao tiếp với Aranara.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170226
					]
				},
				{
					"id": 730170226,
					"content": "À! Nói cũng đúng, \"nhập gia tùy tục\", có lẽ chúng ta nên học cách giao tiếp của họ mới đúng nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170227,
					"content": "Nhưng bây giờ nghĩ kỹ lại, cách giao tiếp của Aranara là như thế nào vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170228,
						730170230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170228,
					"content": "Thứ nhỏ bé biết bay nghĩ sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170229
					]
				},
				{
					"id": 730170229,
					"content": "Nara Vàng đã không biết, sao thứ nhỏ bé biết bay này lại biết được chứ? Hay là chúng ta hỏi Arakunti thần bí đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170233,
					"content": "Arakunti có thể cho chúng tôi biết cách giao tiếp giữa Aranara với nhau không? Chúng tôi cũng muốn học thử!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170234,
					"content": "Tại sao phải học? Nara là Nara, Paimon là Paimon, Aranara là Aranara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170235
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170235,
					"content": "...À hiểu rồi, chẳng lẽ Paimon cũng muốn biến thành hạt giống rồi chôn mình xuống đất sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170236
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170236,
					"content": "Không muốn! Tôi không hề muốn thế!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170237
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170237,
					"content": "Vậy Nara Vàng muốn biến thành hạt giống không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170238,
						730170240
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170238,
					"content": "Cảm ơn, không cần đâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170239
					]
				},
				{
					"id": 730170239,
					"content": "Tiếc thật, hạt giống rất tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170242
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170242,
					"content": "Nói một hồi suýt quên mục đích chúng tôi đến đây luôn, là vì Lễ Hội Utsava đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170243
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170243,
					"content": "Chúng ta phải sửa chữa Cỗ Máy Varuna vì Lễ Hội Utsava, thế thì thời tiết mới trở lại bình thường, sẽ không có đám Bào Tử khó chịu đó nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170244
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170244,
					"content": "Paimon nói đúng lắm, vì Lễ Hội Utsava, vì trung tâm của mảnh đất xanh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170245
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170245,
					"content": "Khoảnh Rừng Mơ bị hơi ẩm bao vây rất tốt, nhưng \"Bào Tử\" thì không, nấm biết chạy cũng không tốt. Mưa nhiều quá, nấm cũng trở nên khó nấu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170246
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170246,
					"content": "Ồ! Bạn đây cũng hiểu rõ thật đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170247
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170247,
					"content": "#Chúng ta đi sửa chữa Cỗ Máy Varuna thôi, Nara {NICKNAME} và Paimon đi theo Arakunti nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170240,
					"content": "Nếu có thể thì tốt quá.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170241
					]
				},
				{
					"id": 730170241,
					"content": "Đừng nói bậy, Arakunti sẽ tưởng thật đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170242
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170230,
					"content": "Tóm lại thử phép so sánh trước nhé?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170231
					]
				},
				{
					"id": 730170231,
					"content": "Để tôi thử! Nara Vàng giống... giống... à... giống như Trứng Chiên Teyvat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170232,
					"content": "...Thôi chúng ta cứ hỏi thẳng Arakunti đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170209,
					"content": "Có thể đoán được sơ sơ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170210
					]
				},
				{
					"id": 730170210,
					"content": "Hay quá! Vậy rốt cuộc câu đó nghĩa là gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170211,
					"content": "Ý là có thể biến hình thành nhiều thứ khác nhau.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170212
					]
				},
				{
					"id": 730170212,
					"content": "#Thật không? {NICKNAME} đừng lừa tôi đấy nhé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170213
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7301704,
			"completionStepIds": [
				7301704
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
