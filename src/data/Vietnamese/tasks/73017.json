					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730170401,
					"content": "Rễ cây to, rất tốt, có thể nghe thấy hơi thở ẩm ướt, là một giai điệu ru ngủ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170402
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170402,
					"content": "Ôi... Vẫn không hiểu Arakunti đang nói gì, thôi bỏ đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170403,
					"content": "Nhắc mới nhớ, không ngờ bên trong còn có một không gian rộng lớn như vậy, đây gọi là \"rối tung rối mù\" sao? Hơn nữa, tôi cứ cảm thấy bầu không khí ở đây rất khác so với những nơi khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170404,
					"content": "Phải tìm thấy \"lá\" vận chuyển năng lượng cho Cỗ Máy Varuna ở một nơi như thế này sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170405,
					"content": "Ở đây nhưng cũng không phải ở đây. Nghe thấy tiếng của nó, ngửi thấy mùi hương của nó, thấy được mạch của nó, nhưng Paimon không tìm thấy nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170406
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170406,
					"content": "Hả? Vậy là sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170407,
					"content": "Paimon không tìm thấy, vậy tôi thế nào?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170408
					]
				},
				{
					"id": 730170408,
					"content": "Nara Vàng có thể nhìn thấy giai điệu, như gió đêm mát mẻ, cơn mưa bất chợt, giấc mộng tan thành nghìn mảnh trên mặt hồ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170409
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170409,
					"content": "Nghe có vẻ rất lợi hại.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170410
					]
				},
				{
					"id": 730170410,
					"content": "#Không hổ danh là {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170411,
					"content": "Hì hì.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170412
					]
				},
				{
					"id": 730170412,
					"content": "#Hì hì... Không đúng! {NICKNAME} đang giành lời của tôi sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170413,
					"content": "#Nara {NICKNAME} trở thành Paimon... còn đáng sợ hơn nhảy múa với nấm ở Marana nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170414
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170414,
					"content": "Không thể tưởng tượng nổi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170415
					]
				},
				{
					"id": 730170415,
					"content": "Cho nên mấy chuyện này sẽ không xảy ra! Tốt hơn là đừng xảy ra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170416,
					"content": "Arakunti cũng thế, không thể nói rõ hơn được à? Rốt cuộc chúng tôi phải đi đâu mới tìm được \"lá\" của Cỗ Máy Varuna đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170417,
					"content": "Tìm nó trong giấc mơ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170418
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170418,
					"content": "Hả... Khoan đã, sao lại không nói ngay từ đầu chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170419,
					"content": "Bởi vì Paimon đã hỏi tại sao, không phải ở đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170420
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170420,
					"content": "Ấy... Hình như tôi đột nhiên hiểu ra cách giao tiếp của Aranara rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170421,
					"content": "Arakunti có thể cho chúng tôi biết vị trí chính xác của ba chiếc \"lá\" mà chúng tôi đang tìm không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170422,
					"content": "Được chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170423
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170423,
					"content": "Ồ, ra là Arakunti chỉ trả lời những câu hỏi trực tiếp... Được rồi, vậy vị trí chính xác của ba nơi này là ở đâu thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170424,
					"content": "Ở bên này, bên đó và bên kia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170425
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170425,
					"content": "Ừm ừm... Không đúng, nói gì huề vốn vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170426
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170426,
					"content": "Paimon thất bại rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170427
					]
				},
				{
					"id": 730170427,
					"content": "#Thất bại của Paimon hay thất bại của {NICKNAME} cũng như nhau thôi! Lời của Arakunti không có tính tham khảo... Làm sao chúng ta mới tìm được ba nơi đó đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170428
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170428,
					"content": "Cỗ Máy Varuna là thứ tuyệt vời nhất mà Aranara đã chế tạo ra, là quan hệ giữa \"cành\" và \"lá\", giữa vô hình và hữu hình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170429
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170429,
					"content": "#Nara {NICKNAME} có thể nhìn thấy Aranara, nhìn thấy dấu vết của Aranara thì sẽ tìm ra phương hướng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170430
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170430,
					"content": "Tôi, tôi hiểu rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170431,
					"content": "Cứ đi theo dấu vết của Aranara là tìm được đúng không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170432
					]
				},
				{
					"id": 730170432,
					"content": "Huhu... Ít nhất lần này cũng phải cho Paimon cơ hội trả lời chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
