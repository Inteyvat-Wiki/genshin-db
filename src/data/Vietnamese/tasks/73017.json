				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730171201,
					"content": "Chúng tôi về rồi đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730171202,
					"content": "Nghe thấy rồi, tiếng thút thít đã biến thành một giai điệu du dương, nhưng để hòa vào dòng âm thanh thì cần...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171203
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171203,
					"content": "Vẫn cần Arakunti giúp đỡ! Hì hì, chuyện tiếp theo phải nhờ bạn rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730171204,
					"content": "Arakunti biết rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171205
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171205,
					"content": "Ồ! Chuyện này chắc ổn rồi đấy! Hy vọng Cỗ Máy Varuna sẽ sớm được sửa chữa, nếu không thì Rừng Apam sẽ toàn là Bào Tử... chỉ nghĩ thôi đã... Hắt xì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730171206,
					"content": "Không thể tin được là Aranara lại không phản ứng gì với Bào Tử... Chẳng lẽ Aranara không bị ảnh hưởng sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730171207,
					"content": "Cũng không phải không bị ảnh hưởng, Aranara có thể nấu nấm. \"Bào Tử\" quá nhỏ lại quá nhiều, không bắt được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171208
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171208,
					"content": "Lúc Cỗ Máy Varuna chưa bị hỏng, Vana cũng không có nhiều nấm như vậy, cho nên nếu sửa được Cỗ Máy Varuna thì mọi thứ sẽ tốt hơn. Ngoại trừ Marana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171209
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171209,
					"content": "Nhất định sẽ trở nên tốt hơn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730171210
					]
				},
				{
					"id": 730171210,
					"content": "#Đúng vậy, tôi và {NICKNAME} cũng sẽ giúp nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730171211,
					"content": "Cũng sẽ có cách giải quyết Marana mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730171212
					]
				},
				{
					"id": 730171212,
					"content": "#Nara {NICKNAME} là Nara Varuna sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171213
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171213,
					"content": "Hả? Sao tự dưng lại hỏi câu này?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730171214,
					"content": "Arapandu nói Nara Varuna là Nara Vàng dũng cảm, đã cùng Aranara sửa chữa Cỗ Máy Varuna, xua đi mưa và bùn đen, mang mặt trăng và mặt trời quay lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171215
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171215,
					"content": "#Nara {NICKNAME} cũng đã giúp Aranara sửa chữa Cỗ Máy Varuna, cũng là Nara Vàng dũng cảm, không phải sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171216
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171216,
					"content": "Nhưng Nara Varuna không phải là người rất lâu về trước à...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730171217,
					"content": "#Nara Varuna không quay về Vana sao? Vậy Nara {NICKNAME} là một Nara hoàn toàn khác sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171218
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171218,
					"content": "Nara khác nhau sẽ có giai điệu giống nhau chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171219,
						730171220
					],
					"speakerTitle": "Arakunti"
				},
				{
