	"talks": [
		{
			"id": 7301301,
			"completionStepIds": [
				7301301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301301",
							"2"
						],
						"stepId": 7301301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Arapacati",
					"Arama",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730130101,
					"content": "A! Là Nara Vàng. Ấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130102
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130102,
					"content": "#Arapacati đừng sợ. Nara {NICKNAME} là một Nara tốt, giống như Nara trong câu chuyện. Nara {NICKNAME} và Paimon đã giúp đỡ mọi người rất nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130103
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730130103,
					"content": "#Ừm, không sợ nữa. Arama, Arapacati tin tưởng bạn, cũng tin vào lời của cỏ, lá cây và hạt giống, đã biết là một Nara tốt. Xin chào, Nara {NICKNAME} và Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130104
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130104,
					"content": "Xin chào, Arapacati!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130105,
						730130114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130105,
					"content": "Thật ra tôi là người xấu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130106
					]
				},
				{
					"id": 730130106,
					"content": "Này! Đừng nói đùa kiểu đó chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130107,
					"content": "Không phải đâu. Arapacati biết mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130108
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130108,
					"content": "#Nơi có nhiều gió, những hạt giống nho nhỏ. Chúng và Nara đã cùng nhau đến Vanarana. Chúng nói rằng, Nara {NICKNAME} rất tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130109
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130109,
					"content": "Lúc trước Arama cũng nói mấy câu tương tự! Nhưng mà, những hạt giống đến từ nơi có nhiều gió... có phải là Bồ Công Anh không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130110,
						730130111,
						730130112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130110,
					"content": "Cũng có thể là Cúc Cánh Quạt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130115
					]
				},
				{
					"id": 730130115,
					"content": "#Nara {NICKNAME} sẽ giúp Arana, tạo ra Bija. Cho nên chúng ta sẽ cùng nhau chuẩn bị cho Lễ Hội Utsava.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130116
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730130116,
					"content": "Ôi... Lễ Hội Utsava...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130117
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130117,
					"content": "Arapacati trông rất lạ. Có chuyện phiền não gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130118
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730130118,
					"content": "Các \"anh trai\" của Arapacati vẫn chưa quay về Vanarana. Nếu họ không quay về thì \"anh em\" chúng tôi sẽ không thể cùng nhau tham dự Lễ Hội Utsava mất...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130119
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130119,
					"content": "Đã lâu tôi cũng không gặp Arachatora, Arasaka, Arapas và Araphala ở Vanarana rồi. Sau chuyện lần trước là đã không gặp rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130120
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730130120,
					"content": "Đã lâu... là bao lâu nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130121,
					"content": "Đó là lúc cách đây rất nhiều rất nhiều mặt trăng. Khi những mầm non vừa đâm chồi khỏi mặt đất. Đến nay, chúng đã phát triển thành những đại thụ có thể che mưa cho Aranara, có cây còn cao bằng bảy Arapacati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130122
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130122,
					"content": "Từ hạt giống lớn thành đại thụ... Chà! Đó chẳng phải là khoảng thời gian rất dài sao! Các anh trai của Arapacati bị mất tích à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130123,
					"content": "\"Mất tích\"? Là một loại hạt giống sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130124
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130124,
					"content": "Ồ! Thì ra hạt giống của Nara gọi là mất tích. Giỏi thật!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130125
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730130125,
					"content": "#Nara giỏi quá! Nara {NICKNAME} chắc chắn có rất nhiều mất tích.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130126
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130126,
					"content": "Không phải là ý này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130127,
						730130130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130127,
					"content": "Ý là \"không biết đi đâu rồi\" ấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130128
					]
				},
				{
					"id": 730130128,
					"content": "À. Không phải như vậy. Arapacati biết rõ Arachatora, Arasaka, Arapas và Araphala ở đâu. Nên các anh không có mất tích.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130129
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130129,
					"content": "Họ rời Vanarana để luyện tập đã lâu rồi. \"Luyện Nấu Ăn\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130136
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130136,
					"content": "Hóa ra là vậy, là \"Luyện Nấu Ăn\" sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130137,
					"content": "Nghe có vẻ giống thứ mà Paimon sẽ cảm thấy hứng thú đấy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130138
					]
				},
				{
					"id": 730130138,
					"content": "#Hừm! Paimon cảm thấy hứng thú với việc \"{NICKNAME} Luyện Nấu Ăn\" hơn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130139,
					"content": "Cho nên \"Luyện Nấu Ăn\" rốt cuộc là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130140
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130140,
					"content": "Đó là chuyện của Lễ Hội Utsava lần trước. Lúc đó, Nara đã làm rất nhiều \"món ăn\" cho các Aranara nếm thử.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130141
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730130141,
					"content": "Nên nhóm Arachatora luôn \"Luyện Nấu Ăn\" để có thể nấu thật nhiều \"món ăn\" cho Nara trong Lễ Hội Utsava lần này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130142
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130142,
					"content": "...Tự nhiên mong tới Lễ Hội Utsava quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130143,
						730130145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130143,
					"content": "Nhưng đó là thức ăn của Aranara...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130144
					]
				},
				{
					"id": 730130144,
					"content": "Thức ăn ngon là ngôn ngữ chung của tất cả sinh vật! Không sao hết!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130146
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130146,
					"content": "Nhưng nếu Arapacati đã biết họ ở đâu, tại sao không tự mình đi tìm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130147
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130147,
					"content": "Lễ Hội Utsava long trọng sắp diễn ra rồi, Arapacati cũng có rất nhiều chuyện phải làm, không có thời gian đi tìm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130148
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130148,
					"content": "Vì Lễ Hội Utsava mà rời khỏi Vanarana luyện nấu ăn. Nhưng lại không biết Lễ Hội Utsava sắp diễn ra. Arachatora, Arasaka, Arapas, Araphala ngốc quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130149
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130149,
					"content": "#Vậy cứ giao cho chúng tôi! Dù sao chúng tôi và Arama cũng phải đi tìm lại các Aranara chuẩn bị cho Lễ Hội Utsava mà. Đúng không, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130150,
						730130151
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130150,
					"content": "Cứ giao cho chúng tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130152
					]
				},
				{
					"id": 730130152,
					"content": "Nhưng chúng tôi phải làm sao tìm tới chỗ của Arachatora, Ara... gì gì đó đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130153
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130153,
					"content": "Arachatora, Arasaka, Arapas và Araphala.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130154
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130154,
					"content": "Ôi, tôi vừa nghĩ tới sao tên của Arana, Arama, Araja, Arapacati... Aranara khó nhớ thế này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130155
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130155,
					"content": "Paimon, đừng nói tên Aranara không hay. Bằng không Aranara sẽ rất buồn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130156
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730130156,
					"content": "Được rồi, tôi hiểu rồi. Vậy chúng ta tìm họ bằng cách nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130157
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130157,
					"content": "Trước kia họ từng luyện nấu ăn ở Vanarana. Kết quả đã tạo ra một đống khói. Cho nên Arapacati mới đuổi họ ra ngoài.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130158
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730130158,
					"content": "Lúc ấy, mọi người đều rất sợ, có Aranara còn sợ tới mức ngất xỉu. May mà Arama dũng cảm đã trừng phạt đám khói đó. Arapacati rất tức giận nên đã đuổi họ ra ngoài.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130159
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130159,
					"content": "Trong rừng, chỉ cần nhìn thấy <color=#00E1FFFF>những cột khói bốc lên</color> thì sẽ có thể tìm được. Chắc thế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130160
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130160,
					"content": "Hóa ra chính bạn đã đuổi họ đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130161
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130161,
					"content": "Ừm. Không đúng à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130162
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130162,
					"content": "#Vậy thì không... Tóm lại, {NICKNAME}, chúng ta lên đường thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130163
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130163,
					"content": "À. Phải rồi. Còn có một chuyện. Nếu như các anh trai trở nên kỳ lạ thì cứ dùng <color=#00E1FFFF>sức mạnh của Nguyên Tố Thảo</color> \"pằng chíu\" họ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130164
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130164,
					"content": "Lúc trước, họ tạo ra rất nhiều khói. Cả Vanarana bốc khói nghi ngút. Họ cũng sợ hãi, nên đã chạy lung tung. Đôi khi gặp phải nấm lạ thì cũng sẽ trở nên như thế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130165
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130165,
					"content": "Nhưng Aranara là tinh linh của cây cối. Cho nên chỉ cần hấp thụ <color=#00E1FFFF>sức mạnh của Nguyên Tố Thảo</color> là sẽ có thể hồi phục và thức tỉnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130166
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130166,
					"content": "#Tôi hiểu rồi. {NICKNAME} chỉ cần ăn Gà Nấu Hoa Ngọt là có thể hồi phục lại. Cho nên {NICKNAME} là tinh linh của Gà Nấu Hoa Ngọt. Ừm! Rất có lý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130167,
						730130171
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130167,
					"content": "?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130168
					]
				},
				{
					"id": 730130168,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130169
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730130169,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130170
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130170,
					"content": "...Tóm lại, chúng ta lên đường thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130172
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130172,
					"content": "#Nara {NICKNAME} và Paimon cố lên!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arama"
				},
				{
					"id": 730130171,
					"content": "Tóm lại, lên đường nào.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130172
					]
				},
				{
					"id": 730130151,
					"content": "Ừm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130152
					]
				},
				{
					"id": 730130145,
					"content": "Hóng quá đi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130146
					]
				},
				{
					"id": 730130130,
					"content": "Tôi hiểu tâm trạng của bạn...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130131
					]
				},
				{
					"id": 730130131,
					"content": "#Nara {NICKNAME} cũng biết tâm trạng của tôi ư?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130132
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130132,
					"content": "#Ừ, {NICKNAME} cũng có {F#anh trai}{M#em gái} thất lạc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130133,
					"content": "#Ồ. {F#Anh trai}{M#Em gái} của Nara {NICKNAME} cũng đi \"Luyện Nấu Ăn\" à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130134
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130134,
					"content": "Hả? Sao tôi cứ thấy không ổn ở chỗ nào ấy... Mất tích chính là, \"không biết đã đi đâu rồi\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130135,
					"content": "Ồ. Không phải như thế đâu. Arapacati biết các anh trai không hề mất tích. Họ đã ra ngoài Vanarana để tập luyện từ rất lâu rồi. Là \"Luyện Nấu Ăn\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130136
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130111,
					"content": "Cũng có thể là Quả Thông.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130115
					]
				},
				{
					"id": 730130112,
					"content": "Có lẽ là hạt giống mang theo câu chuyện...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130113
					]
				},
				{
					"id": 730130113,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130114,
					"content": "Xin chào.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130115
					]
				}
			]
		},
		{
			"id": 7301302,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301302",
							"2"
						],
						"stepId": 7301302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arapacati"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730130201,
					"content": "...Trao đổi với Nara khó khăn quá. Lại còn cao nữa chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130202
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130202,
					"content": "Xin chào.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130203
					]
				},
				{
					"id": 730130203,
					"content": "#Ồ! Là Nara {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130204
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130204,
					"content": "Arapacati không sợ. Hơn nữa các anh rất can đảm, nhất định cũng sẽ không sợ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130205
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130205,
					"content": "Chỉ cần đi theo <color=#00E1FFFF>Cột Khói</color>, chắc là sẽ tìm thấy họ. Nếu như họ trở nên kỳ lạ, hãy dùng <color=#00E1FFFF>Năng Lượng Nguyên Tố Thảo</color> \"pằng chíu\" họ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapacati"
				}
			]
		},
		{
			"id": 7301303,
			"completionStepIds": [
				7301303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301303",
							"2"
						],
						"stepId": 7301303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arapacati",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730130301,
					"content": "Arapacati bây giờ đang rất tức giận, hừm, còn tức giận hơn cả rất tức giận nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130302
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130302,
					"content": "Trong rừng sâu nhiều nguy hiểm lắm, \"Marana\" hoành hành khắp nơi. Lúc lên đường, Arapacati còn cố ý dặn dò mấy anh phải đoàn kết...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130303
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130303,
					"content": "Kết quả vừa mới ra ngoài đã cãi nhau, Arachatora lại còn ăn phải thứ kỳ lạ nào đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130304
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130304,
					"content": "Huhu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130305
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730130305,
					"content": "Arapacati quyết định, trong thời gian mười lần Quả Nhật Lạc chín, Arachatora sẽ không được phép hái nấm nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130306
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130306,
					"content": "Sao lại như thế... Huhu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130307
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730130307,
					"content": "Nhưng nếu mang Bào Tử xấu vào, để mọc ra quái vật nấm thì sao được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130308
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730130308,
					"content": "Anh Araphala cũng thật là, chạy tới nơi cách Vanarana xa như vậy để hái trái cây. Bên đó có thứ rất xấu! Araja đã đặc biệt dặn dò rồi mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130309
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130309,
					"content": "Huhu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130310
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730130310,
					"content": "Đúng đó, đúng đó. Trái cây cũng phải uống nước, Aranara cũng phải uống nước. Nên nước là tốt nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130311
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730130311,
					"content": "Anh Arapas, anh muốn tới \"Cỗ Máy Varuna\" tìm nước. Chẳng lẽ không biết ngay cả Nara Varuna cũng từng nói, nước ở Vanarana là ngon nhất à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130312
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130312,
					"content": "Huhu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130313
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730130313,
					"content": "Bây, bây giờ mọi người nhìn đi, chỉ có \"Hương Vị Hạnh Phúc\", mới có thể khiến em gái hạnh phúc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130314
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730130314,
					"content": "#Anh Arasaka, em nghe nói, anh vì \"Hương Vị Hạnh Phúc\" mà mang đến rất nhiều rắc rối cho Nara {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130315
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130315,
					"content": "Đó, đó cũng là vì \"Món Ăn Quý Nhất\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130316
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730130316,
					"content": "Nấu \"Món Ăn Quý Nhất\" là để hoàn thành quá trình \"Luyện Nấu Ăn\", ây da, nhờ sức của người khác để hoàn thành việc luyện tập thì có nghĩa lý gì chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130317
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130317,
					"content": "Arapacati cảm thấy, anh Arasaka cần phải tự kiểm điểm mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130318
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130318,
					"content": "Huhu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130319
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730130319,
					"content": "Arapacati! Chúng tôi tới rồi đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130320,
					"content": "Ây da, là các bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130321
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130321,
					"content": "#Nara {NICKNAME} và Paimon chia sẻ phiền não của Arapacati, giải quyết ngọn nguồn của phiền não...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130322
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130322,
					"content": "Cuối cùng Arapacati không phải lo lắng không biết các anh trai có bỏ lỡ Lễ Hội Utsava hay có gặp nguy hiểm ở bên ngoài hay không. Đều nhờ có các bạn cả đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130323
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130323,
					"content": "Arapacati và các anh trai, đều rất biết ơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130324
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130324,
					"content": "Thế thì tốt rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130325,
					"content": "Nhưng có chuyện này tôi vẫn thấy rất lạ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130326,
					"content": "\"Nara Varuna\" rốt cuộc là ai?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130327
					]
				},
				{
					"id": 730130327,
					"content": "#{F#Anh ấy}{M#Cô ấy} là bạn của chúng tôi. Cũng là bạn của Vanarana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130328
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130328,
					"content": "#Rất lâu về trước, bạn của Aranara. Rất giống Nara {NICKNAME}, là một Nara Vàng rực.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130329
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130329,
					"content": "Hóa ra là vậy. Nhưng tôi vẫn còn một vấn đề...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130330
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130330,
					"content": "Liên quan đến chuyện \"anh em\" sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130331
					]
				},
				{
					"id": 730130331,
					"content": "Ừ. Mấy người anh của Arapacati, rốt cuộc ai lớn, ai nhỏ thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130332
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130332,
					"content": "Hả? Lớn nhỏ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130333,
						730130334
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130333,
					"content": "Ý chỉ tuổi tác...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130336
					]
				},
				{
					"id": 730130336,
					"content": "\"Tuổi tác\"... À. Arapacati hiểu rồi, giống như tính tuổi thực vật vậy. Những đứa con của rừng sâu không chia \"tuổi\" lớn nhỏ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130337
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130337,
					"content": "Hả? Vậy \"anh trai\" với \"em gái\" này là sao đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130338
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130338,
					"content": "#Cái này à. Trước kia chúng tôi có một người bạn Nara. Nara Varuna. {F#Anh ấy}{M#Cô ấy} nói, {F#anh ấy}{M#cô ấy} có một người \"{F#em gái}{M#anh trai}\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130339
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130339,
					"content": "#Arapacati và các anh nghe {F#anh ấy}{M#cô ấy} kể về người \"{F#em gái}{M#anh trai}\" thì cảm thấy rất hạnh phúc, nhưng cũng rất buồn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130340
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130340,
					"content": "Nên chúng tôi biết. Đối với \"anh trai\" thì \"em gái\" là Nara rất quan trọng. Đối với \"em gái\", \"anh trai\" cũng là Nara rất quan trọng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130341
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130341,
					"content": "Chúng tôi đều cảm thấy rất tốt. Nên Arapacati và các anh trai quyết định sẽ trở thành \"anh trai\" và \"em gái\". Nara Varuna nói như thế cũng tốt. Phải quý trọng người thân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130342
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130342,
					"content": "Đúng vậy, nhất định phải trân trọng người thân của mình.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130343
					]
				},
				{
					"id": 730130343,
					"content": "Ừm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130344
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130344,
					"content": "Tôi vẫn quan tâm một chuyện... Aranara có cần ăn cơm không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130345
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130345,
					"content": "Con người biết biến nguyên liệu thành thức ăn, những đứa con của rừng sâu cũng có thể biến nguyên liệu thành thức ăn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130346
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130346,
					"content": "Vì trước kia Nara Varuna từng dạy chúng tôi cách một Nara ăn cái gì đó. Nên Arapacati và các anh trai mới \"Luyện Nấu Ăn\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130347
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130347,
					"content": "Ồ, đúng là kỳ lạ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130348,
						730130349
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130348,
					"content": "Cứ như đang chơi trò chơi ấy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130350
					]
				},
				{
					"id": 730130350,
					"content": "Arapacati và các anh trai nghiêm túc lắm. Vì Nara Varuna từng nói, có thể cùng chia sẻ thức ăn là chuyện rất hạnh phúc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130351
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130351,
					"content": "#Đúng rồi, nghe anh Arapas nói, Nara {NICKNAME} cũng biết nấu nướng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130352
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130352,
					"content": "#Ừ, kỹ thuật của {NICKNAME} không tệ đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130353
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130353,
					"content": "#Vậy sao... Lễ Hội Utsava, Nara {NICKNAME} nhất định phải tới. Nấu nướng cùng các anh trai nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130354
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130354,
					"content": "Để bọn họ nhìn thấy một lần nữa, cách nấu nướng và thức ăn thật sự mà chỉ có Nara mới hiểu, Aranara vĩnh viễn không thể hiểu được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130355,
						730130356
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130355,
					"content": "Đến lúc đó đừng có bất ngờ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130357
					]
				},
				{
					"id": 730130357,
					"content": "Arapacati vô cùng chờ mong. Lễ Hội Utsava lần này nhất định sẽ cực kỳ, cực kỳ tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130356,
					"content": "Chờ tôi bộc lộ tài năng cho bạn xem!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130357
					]
				},
				{
					"id": 730130349,
					"content": "Cứ như đang chơi trò gia đình ấy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130350
					]
				},
				{
					"id": 730130334,
					"content": "Ý chỉ kích thước..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130335
					]
				},
				{
					"id": 730130335,
					"content": "Này! Không phải vậy nhé, là hỏi tuổi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130336
					],
					"speakerTitle": "Paimon"
				}
			]
		},
