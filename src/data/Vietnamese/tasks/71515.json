			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hesheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715150101,
					"content": "Chỉ nói chung chung là \"buổi biểu diễn đang diễn ra ở phía bắc bến cảng\" sao, còn không ghi là ai biểu diễn nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 715150102,
					"content": "Chúng ta tìm đường đến đó đi, nếu không biết có thể hỏi người qua đường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 715150103,
					"content": "Ở đó có rất nhiều người.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715150104
					]
				},
				{
					"id": 715150104,
					"content": "Woa, Paimon nhìn thấy rồi. Có rất nhiều người đang ở đây, chắc là đến xem biểu diễn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 715150105,
					"content": "Chúng ta đi hỏi thử xem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7151502,
			"completionStepIds": [
				7151502
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7151502",
							"2"
						],
						"stepId": 7151502,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qingxing"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715150201,
					"content": "\"Tài lộc và sức khỏe, bình an và giàu có...♪\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150202
					],
					"speakerTitle": "Qingxing"
				},
				{
					"id": 715150202,
					"content": "Xin chào.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715150203
					]
				},
				{
					"id": 715150203,
					"content": "Xin hỏi có phải sắp diễn ra biểu diễn tại đây không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 715150204,
					"content": "Đúng vậy, sắp diễn kịch múa rối rồi, mọi người đến xem đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150205,
						715150206
					],
					"speakerTitle": "Qingxing"
				},
				{
					"id": 715150205,
					"content": "Thì ra là \"Kịch Múa Rối\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715150207
					]
				},
				{
					"id": 715150207,
					"content": "Không phải, kịch múa rồi và kịch Liyue là hai thứ khác nhau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150208
					],
					"speakerTitle": "Qingxing"
				},
				{
					"id": 715150208,
					"content": "Qingxing! Buổi biểu diễn sắp bắt đầu rồi. Mọi người đừng nói chuyện nữa, sẽ ảnh hưởng đến người biểu diễn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150209
					],
					"speakerTitle": "Hesheng"
				},
				{
					"id": 715150209,
					"content": "Ồ kịch múa rối như thế nào ư, mọi người cứ xem là hiểu liền.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150210
					],
					"speakerTitle": "Qingxing"
				},
				{
					"id": 715150210,
					"content": "Thưa các vị khách quý, hôm nay chúng ta sẽ diễn vở \"Cầu Nhiêm Công\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150211
					],
					"speakerTitle": "Yinggong"
				},
				{
					"id": 715150211,
					"content": "Nhắc nhở trước buổi biểu diễn, nếu bạn muốn đi vệ sinh hoặc lấy đồ uống, giờ là thời điểm thích hợp. Buổi diễn sẽ không đợi ai đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150212
					],
					"speakerTitle": "Yinggong"
				},
				{
					"id": 715150212,
					"content": "(Thì ra đây là vở \"Cầu Nhiêm Công\" à, còn chưa nghe qua bao giờ.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 715150213,
					"content": "Suỵt, mọi người vẫn có thể nghe thấy tiếng nói chuyện ngay cả khi thì thầm. Hãy giữ yên lặng nhé, chỉ được nói chuyện lúc chọn kịch thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150214
					],
					"speakerTitle": "Hesheng"
				},
				{
					"id": 715150214,
					"content": "Ôi... xin lỗi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 715150215,
					"content": "Chọn kịch?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715150216
					]
				},
				{
					"id": 715150216,
					"content": "\"Cầu Nhiêm Công\" rất dài, nếu nghe toàn bộ thì mất rất nhiều thời gian. Vậy nên người biểu diễn sẽ để khán giả chọn phần muốn nghe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150217
					],
					"speakerTitle": "Qingxing"
				},
				{
					"id": 715150217,
					"content": "Qingxing! Mình không nghe rõ người diễn kịch nói gì rồi nè!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150218
					],
					"speakerTitle": "Hesheng"
				},
				{
					"id": 715150218,
					"content": "Ồ, lần này mình không nói chen vào nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150219
					],
					"speakerTitle": "Qingxing"
				},
				{
					"id": 715150219,
					"content": "Các vị muốn xem phần nào trong câu chuyện của \"Cầu Nhiêm Công\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150220
					],
					"speakerTitle": "Yinggong"
				},
				{
					"id": 715150220,
					"content": "Là đoạn \"lên núi\", \"bái tiên\", \"trừ quỷ\" hay \"thăng thiên\" đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150221
					],
					"speakerTitle": "Yinggong"
				},
				{
					"id": 715150221,
					"content": "Chỉ cần nêu tên, tôi có thể diễn cho quý khách.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150222
					],
					"speakerTitle": "Yinggong"
				},
				{
					"id": 715150222,
					"content": "Cháu muốn xem cảnh \"Cầu Nhiêm Công\" đánh nhau với yêu quái. Anh ấy quá đỉnh mà, lần nào cũng thắng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150223
					],
					"speakerTitle": "Qingxing"
				},
				{
					"id": 715150223,
					"content": "\"Bái tiên\", \"trừ quỷ\" đều xem mấy lần rồi, bạn không thấy chán sao? Mình muốn xem đoạn \"Cầu Nhiêm Công\" về thăm em gái.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150224
					],
					"speakerTitle": "Hesheng"
				},
				{
					"id": 715150224,
					"content": "\"Cầu Nhiêm Công\" còn có em gái sao? Sao mình không biết nhỉ, còn chưa xem qua nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150225
					],
					"speakerTitle": "Qingxing"
				},
				{
					"id": 715150225,
					"content": "Vị khách nhỏ này đúng là am hiểm mà, \"hồi hương\" thực ra không nổi lắm, nếu không phải người yêu kịch sẽ không biết đến đoạn này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150226
					],
					"speakerTitle": "Yinggong"
				},
				{
					"id": 715150226,
					"content": "Được rồi, đúng dịp Tết Hải Đăng, chúng ta không diễn mấy vở liên quan đến yêu quái nữa. Hãy xem anh ấy quay về gặp người thân thì như thế nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150227
					],
					"speakerTitle": "Yinggong"
				},
				{
					"id": 715150227,
					"content": "Có ba nhân vật sẽ xuất hiện trong cảnh này, ngoài Cầu Nhiêm Công quen thuộc của chúng ta, còn có một cô gái mồ côi tên Yibing và một chàng trai trung thực tên Nanfeng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150228
					],
					"speakerTitle": "Yinggong"
				},
				{
					"id": 715150228,
					"content": "#{NICKNAME} bạn có hiểu gì không? Sao Paimon vẫn cứ mù mịt thế nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 715150229,
					"content": "Hình như diễn về một người tên Cầu Nhiêm Công? Nhưng cảm giác ngoài nam chính còn có các nhân vật phụ nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 715150230,
					"content": "Nhưng trước mặt chúng ta chỉ có một diễn viên... Ừm, còn có một... màn chắn? Vậy sao mà diễn được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 715150231,
					"content": "Chà chà, ở đây có người chưa từng xem kịch múa rối.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150232
					],
					"speakerTitle": "Hesheng"
				},
				{
					"id": 715150232,
					"content": "Ồ? Có người ngồi phía sau hỏi tôi chỉ có một người sao có thể diễn nhiều vai được?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150233
					],
					"speakerTitle": "Yinggong"
				},
				{
					"id": 715150233,
					"content": "Vậy thì vị khách quan đây không biết rồi, kịch múa rối tuy không cầu kỳ như kịch Liyue, nhưng cũng có điểm đặc sắc riêng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150234
					],
					"speakerTitle": "Yinggong"
				},
				{
					"id": 715150234,
					"content": "Kịch Liyue đều được diễn bằng người thật, còn kịch múa rối của chúng ta diễn viên đều làm bằng giấy dán lụa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150235
					],
					"speakerTitle": "Yinggong"
				},
				{
					"id": 715150235,
					"content": "Kịch Liyue được diễn trên những sân khấu bằng gỗ cỡ lớn, còn kịch múa rối được diễn trên màn giấy dán trên gỗ. Diễn viên và sân khấu đều là giấy nên gọi là kịch múa rối.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150236
					],
					"speakerTitle": "Yinggong"
				},
				{
					"id": 715150236,
					"content": "Tôi là người dẫn truyện, còn người diễn kịch thì không phải tôi. Khách quan sẽ được thấy ba diễn viên giấy trong giây lát thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150237
					],
					"speakerTitle": "Yinggong"
				},
				{
					"id": 715150237,
					"content": "Cháu nghĩ họ không biết Cầu Nhiêm Công, hay là chú giới thiệu qua được không. Giống như mỗi lần mở đầu đều có...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150238
					],
					"speakerTitle": "Hesheng"
				},
				{
					"id": 715150238,
					"content": "Đó gọi là đoạn xưng danh, cháu cũng thích đoạn đó, có thể đọc lại cho tụi cháu nghe không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150239
					],
					"speakerTitle": "Qingxing"
				},
				{
					"id": 715150239,
					"content": "Đoạn xưng danh! Đoạn xưng danh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150240
					],
					"speakerTitle": "Hesheng"
				},
				{
					"id": 715150240,
					"content": "Truyện kể rằng, muốn trừ gian nhưng quỷ khí cao ngất trời.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150241
					],
					"speakerTitle": "Yinggong"
				},
				{
					"id": 715150241,
					"content": "Một chàng trai nọ tên Huanguang, sau khi chịu nhiều khổ nhục trên đời, đã vô núi sinh sống.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150242
					],
					"speakerTitle": "Yinggong"
				},
				{
					"id": 715150242,
					"content": "Một lần tình cờ gặp tiên nhân, anh đã thay đổi diện mạo, nuôi râu đen và lấy tên là Cầu Nhiêm Công.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150243
					],
					"speakerTitle": "Yinggong"
				},
				{
					"id": 715150243,
					"content": "Thuận lệnh tiên nhân, anh cầm kiếm xua đuổi yêu ma quỷ quái khắp thế gian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150244
					],
					"speakerTitle": "Yinggong"
				},
				{
					"id": 715150244,
					"content": "Cầu Nhiêm Công sau nhiều năm tu luyện nay đã ngộ đạo, đúng lúc quay trở về động phủ gặp tiên nhân thì được ngài chỉ bảo gợi nhắc chuyện xưa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150245
					],
					"speakerTitle": "Yinggong"
				},
				{
					"id": 715150245,
					"content": "Hóa ra duyên trần của anh chưa dứt, người em gái tội nghiệp nay cô đơn không nơi nương tựa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150246
					],
					"speakerTitle": "Yinggong"
				},
				{
					"id": 715150246,
					"content": "Còn người em gái cứ ngỡ anh trai sống cuộc đời kham khổ, nào dám quay về quê hương. Nếu muốn biết hồi sau thế nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150247
					],
					"speakerTitle": "Yinggong"
				},
				{
					"id": 715150247,
					"content": "Tôi sẽ kể cho quý vị nghe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150248
					],
					"speakerTitle": "Yinggong"
				},
				{
					"id": 715150248,
					"content": "Hay quá! Đừng đứng ngẩn người ra như thế, lúc này phải vỗ tay rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150249,
						715150250
					],
					"speakerTitle": "Hesheng"
				},
				{
					"id": 715150249,
					"content": "Hay quá!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715150251
					]
				},
				{
					"id": 715150251,
					"content": "Từ lúc nào cổ vũ cũng có quy định vậy? Ồ, được thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150252
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 715150252,
					"content": "Cảm ơn mọi người cổ vũ. Nói đến đây, đáng lẽ phải mời diễn viên bắt đầu vở kịch rồi nhưng tôi nghĩ hai vị khách đây vẫn còn nhiều câu hỏi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150253
					],
					"speakerTitle": "Yinggong"
				},
				{
					"id": 715150253,
					"content": "Chi bằng mời hai vị lên đây giúp tôi điều chỉnh bối cảnh nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150254
					],
					"speakerTitle": "Yinggong"
				},
				{
					"id": 715150254,
					"content": "Vừa giúp hai vị hiểu rõ hơn, lại còn có thể giúp diễn viên di chuyển trên sân khấu. Các vị có đồng ý không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150255
					],
					"speakerTitle": "Yinggong"
				},
				{
					"id": 715150255,
					"content": "Woa, sao không gọi cháu. Cháu rất quen với kịch múa rối, hãy gọi cháu đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150256
					],
					"speakerTitle": "Qingxing"
				},
				{
					"id": 715150256,
					"content": "Bạn lên mấy lần rồi, đừng có hò hét nữa, ngồi yên xem đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150257
					],
					"speakerTitle": "Hesheng"
				},
				{
					"id": 715150257,
					"content": "Cháu đồng ý.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715150258
					]
				},
				{
					"id": 715150258,
					"content": "Giúp điều chỉnh cảnh sao? Cảm giác rất mới lạ, cháu cũng đồng ý!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150259
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 715150259,
					"content": "Vậy thì chuẩn bị thôi. Sau khi các vị vào vị trí, màn trình diễn sẽ bắt đầu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yinggong"
				},
				{
					"id": 715150250,
					"content": "(Cùng mọi người cổ vũ)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715150251
					]
				},
				{
					"id": 715150206,
					"content": "Là kịch của Liyue phải không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715150207
					]
				}
			]
		}
	]
