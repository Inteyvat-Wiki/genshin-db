			"dialogs": [
				{
					"id": 230145501,
					"content": "Ôi... Lutong, đỡ tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145502
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230145502,
					"content": "Thưa ngài, hay là ngài quay về ngủ thêm một lúc đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145503
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230145503,
					"content": "Nhà Lữ Hành, bạn đến đúng lúc lắm! Mời bạn sang đây một chút, tôi muốn nhờ bạn giúp một việc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145504
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230145504,
					"content": "Anh ta sao thế?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230145505
					]
				},
				{
					"id": 230145505,
					"content": "Đơn giản mà nói... Ngài Garcia uống quá nhiều cà phê mà thời gian ngủ lại quá ít.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145506
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230145506,
					"content": "Nhưng cũng may là ngài Garcia chỉ uống cà phê chứ không uống rượu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145507
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230145507,
					"content": "Lutong, ừm... chúng ta cần tìm thêm mấy cái ấn mới được... Cái loại ấn mà Đạo Bảo Đoàn mang theo đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145508
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230145508,
					"content": "Nhà Lữ Hành! Sao bạn lại ở đây, xin lỗi, vừa rồi tôi không để ý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145509
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230145509,
					"content": "Bạn có muốn giúp tôi lấy loại ấn đó không? Chỉ cần vài cái là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145510,
						230145512
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230145510,
					"content": "Anh về nghỉ ngơi một lát đi.",
