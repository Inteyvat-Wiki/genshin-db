			"dialogs": [
				{
					"id": 230145001,
					"content": "Chúng ta phải nghĩ cách kiếm tiền thôi thưa ngài.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145002
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230145002,
					"content": "Tôi nghe nói trong thành Sumeru có một rạp hát, trong rạp hát ấy có khá nhiều đoàn kịch cần người làm công việc tính toán.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145003
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230145003,
					"content": "Hơn nữa, thành viên của những đoàn kịch đó... ngài hiểu mà. Bọn họ kiếm được rất nhiều, nhưng không biết quản lý tiền như nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145004
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230145004,
					"content": "Đây là cơ hội của chúng ta thưa ngài.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145005
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230145005,
					"content": "Tài năng tính toán sổ sách và làm ăn của anh đúng là khiến người ta khiếp sợ đó Lutong thân mến...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145006
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230145006,
					"content": "Để tôi nghĩ lại xem, nghĩ lại xem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
