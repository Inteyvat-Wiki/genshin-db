			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lutong",
					"Garcia"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230140101,
					"content": "Thưa ngài, lần này tôi thật lòng đề nghị, chúng ta tìm cách trả tiền đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140102
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230140102,
					"content": "Đám bán hàng kia đúng là quân ăn cướp! Tại sao có mấy cái ấn thôi mà lại bán giá đắt như vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140103
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230140103,
					"content": "Chắc do là bọn họ đã nhận ra, lúc ngài nhìn mấy cái ấn đó hai mắt cứ sáng lên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140104
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230140104,
					"content": "Bạn cần số ấn đó để làm gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230140105
					]
				},
				{
					"id": 230140105,
					"content": "Nhà Lữ Hành! Sao lần nào bạn cũng đến đúng lúc vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140106
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230140106,
					"content": "Lần trước cũng may có bạn giúp, trên cơ bản tôi đã chế tạo ra được một loại Chất Bôi Trơn sử dụng được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140107
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230140107,
					"content": "Nhưng tôi lại lập tức gặp vấn đề khác. Khi chế tạo lại một bộ phận nào đó, tôi phát hiện... nếu dùng vật liệu quá cứng để làm, sẽ dễ bào mòn hoặc gây tổn hại đến các bộ phận khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140108
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230140108,
					"content": "Hơn nữa, những bộ phận quá cứng đó chỉ cần chịu một lực tác động nhỏ sẽ dễ bị nứt ở một mức độ nào đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140109
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230140109,
					"content": "Vì vậy, tôi bắt đầu tìm kiếm những vật liệu có độ cứng nhất định, nhưng vẫn có độ đàn hồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140110
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230140110,
					"content": "Dưới sự nghiên cứu không ngừng của tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140111
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230140111,
					"content": "...Sau khi bị ngài Ahangar quấy rầy liên tục.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140112
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230140112,
					"content": "Tôi cảm thấy loại ấn... mà Đạo Bảo Đoàn mang theo, có lẽ đã dùng loại nguyên liệu nào đó mà tôi muốn tìm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140113
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230140113,
					"content": "Nhưng mà... đám thương nhân đó hét giá y như lũ Đạo Bảo Đoàn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140114,
						230140115
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230140114,
					"content": "Lại đến lúc tôi ra tay rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230140116
					]
				},
				{
					"id": 230140116,
					"content": "Quả thực tôi rất muốn khắc tên bạn vào cần trục của \"Máy Đánh Số\"! Vô cùng cảm ơn bạn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230140115,
					"content": "Để tôi tìm giúp anh xem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230140116
					]
				}
			]
		},
