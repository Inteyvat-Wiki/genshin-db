			"dialogs": [
				{
					"id": 230140301,
					"content": "Vô cùng cảm ơn bạn, Nhà Lữ Hành. Số ấn này đã đủ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140302
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230140302,
					"content": "Tôi phải đi làm lại bánh răng đã... À không đúng, có lẽ phải nghiên cứu ổ trục đã...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140303
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230140303,
					"content": "Đây là thù lao của bạn, Nhà Lữ Hành, hãy nhận lấy nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140304
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230140304,
					"content": "Theo tình hình hiện tại, có lẽ chúng ta phải hợp tác lâu dài với nhau rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140305
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230140305,
					"content": "Haiz, sổ sách của ngài Garcia sắp xếp lại khó thật...",
