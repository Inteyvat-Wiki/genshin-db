				{
					"id": 760150207,
					"content": "#Biết hát không? Yoohoo, chúng tôi hát một câu rồi {F#cô}{M#cậu} hát một câu nhé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150208
					],
					"speakerTitle": "Bóng Ma Lớn Tiếng"
				},
				{
					"id": 760150208,
					"content": "\"Tiếng nhạc của hàng xóm khiến tôi không khỏi nhún nhảy!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150209
					],
					"speakerTitle": "Bóng Ma Lớn Tiếng"
				},
				{
					"id": 760150209,
					"content": "\"Tôi đang kéo đàn, còn các bạn thì đang mỉm cười.\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150210
					]
				},
				{
					"id": 760150210,
					"content": "\"Mọi người đều đang vui vẻ nhảy múa. Hây! Ha!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150211
					],
					"speakerTitle": "Bóng Ma Lớn Tiếng"
				},
				{
					"id": 760150211,
					"content": "\"Chúng ta tụ họp với nhau, tụ họp lại cùng nhảy múa!\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150212
					]
				},
				{
					"id": 760150212,
					"content": "#Haha, đúng vậy, cứ hát như thế đi. {F#Cô}{M#Cậu} học nhanh đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150213
					],
					"speakerTitle": "Bóng Ma Lớn Tiếng"
				},
				{
					"id": 760150213,
					"content": "#Tên tôi là ███, thế là chúng ta coi như đã quen biết rồi. Ghế này {F#cô}{M#cậu} cứ ngồi đi, tôi không phải người keo kiệt đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150214
					],
					"speakerTitle": "Bóng Ma Lớn Tiếng"
				},
				{
					"id": 760150214,
					"content": "#{F#Cô}{M#Cậu} cũng là Ratnik đúng không? Ly bia này để tôi mời nhé, biết đâu trong lúc tập luyện chúng ta sẽ gặp lại nhau đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150215,
						760150216
					],
					"speakerTitle": "Bóng Ma Lớn Tiếng"
				},
				{
					"id": 760150215,
					"content": "Cảm ơn nhé, mặc dù tôi không uống được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150217
					]
				},
				{
					"id": 760150217,
					"content": "Tôi phải đi tuần đêm rồi, gặp lại sau nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bóng Ma Lớn Tiếng"
				},
				{
					"id": 760150216,
					"content": "Rất hân hạnh được làm quen, tôi tên là Flins.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150217
					]
				},
				{
					"id": 760150205,
					"content": "Nếu tôi muốn ngồi ở đây thì sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150206
					]
				}
			]
		},
