				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bóng Ma Lớn Tiếng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760150101,
					"content": "#Này, {F#cô}{M#cậu} là ai thế? Đây là ghế của tôi, ở quán rượu ai mà không biết đây là chỗ của ███ tôi cơ chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150102
					],
					"speakerTitle": "Bóng Ma Lớn Tiếng"
				},
				{
					"id": 760150102,
					"content": "Mới lên đảo này hay là thế nào? Đừng có chiếm chỗ của người khác chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150103
					],
					"speakerTitle": "Bóng Ma Lớn Tiếng"
				},
				{
					"id": 760150103,
					"content": "Bia của tôi sao vẫn chưa được mang lên thế? Nhanh lên chứ, tôi ngồi thêm một lát nữa là phải đi tuần đêm rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150104,
						760150105
					],
					"speakerTitle": "Bóng Ma Lớn Tiếng"
				},
				{
					"id": 760150104,
					"content": "Quán rượu? Bia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150106
					]
				},
				{
					"id": 760150106,
					"content": "Cũng được. Uống rượu hát hò cùng chúng tôi trước đã, quen rồi thì đều là bạn bè, lúc đó muốn ngồi thì cứ ngồi thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150107
					],
					"speakerTitle": "Bóng Ma Lớn Tiếng"
				},
				{
					"id": 760150107,
					"content": "#Biết hát không? Yoohoo, chúng tôi hát một câu rồi {F#cô}{M#cậu} hát một câu nhé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150108
					],
					"speakerTitle": "Bóng Ma Lớn Tiếng"
				},
				{
					"id": 760150108,
					"content": "\"Tiếng nhạc của hàng xóm khiến tôi không khỏi nhún nhảy!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150109,
						760150110,
						760150111
					],
					"speakerTitle": "Bóng Ma Lớn Tiếng"
				},
				{
					"id": 760150109,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150112
					]
				},
				{
					"id": 760150112,
					"content": "Không, không đúng. Mất hứng quá, người Nod-Krai sao có thể không biết hát bài này chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150113
					],
					"speakerTitle": "Bóng Ma Lớn Tiếng"
				},
				{
					"id": 760150113,
					"content": "Không biết hát, không biết chơi thì làm sao hòa nhập vào đội đây? Để đến lúc Cuộc Săn Hoang Dã ở ngay cạnh mà không có đồng đội chăm sóc thì tiêu đời rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150114
					],
					"speakerTitle": "Bóng Ma Lớn Tiếng"
				},
				{
					"id": 760150114,
					"content": "Đi học hát rồi hãy tới quán rượu nhé. Yoohoo, thêm một ly bia nữa đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bóng Ma Lớn Tiếng"
				},
				{
					"id": 760150110,
					"content": "\"Paimon nhà tôi khiến tôi không nhịn được cười!\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150112
					]
				},
				{
					"id": 760150111,
					"content": "\"Hồn ma trên đảo vây quanh chiếc ghế, vừa hát vừa nhảy!\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150112
					]
				},
				{
					"id": 760150105,
					"content": "Cho tôi ngồi một lát nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150106
					]
				}
			]
		},
