			"dialogs": [
				{
					"id": 4810102,
					"content": "Cảm thấy rất tốt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4810104
					]
				},
				{
					"id": 4810103,
					"content": "Tôi cứ lỡ bay quá cao.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4810104
					]
				},
				{
					"id": 4810101,
					"content": "#{NICKNAME}! Tôi tìm bạn mãi, lần trước cho bạn Phong Chi Dực, dùng cảm thấy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810102,
						4810103
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810104,
					"content": "Xem ra bạn dùng Phong Chi Dực chơi rất vui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810105
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810105,
					"content": "Nhưng mà cũng phải nói, hiện nay bạn chắc chắn vẫn chưa có bằng bay lượn nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810106
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810106,
					"content": "Bằng bay lượn? Đó là cái gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4810107,
					"content": "Nghe tên cũng rất rõ ràng rồi mà? Chỉ có lấy được bằng bay lượn, mới có thể bay hợp pháp trong thành Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810108
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810108,
					"content": "#Ồ... {NICKNAME} đã bay lâu vậy rồi, trước đây cũng chưa từng nghe nói thứ đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4810109,
					"content": "Chính là vì các bạn cứ bay qua bay lại cả ngày trong Mondstadt, khiến mọi người chú ý!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810110
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810110,
					"content": "À hì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4810111,
					"content": "Cho nên, hôm nay Amber đặc biệt mang bằng bay lượn đến à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4810112,
					"content": "Làm gì có! Kỵ sĩ cần có quy tắc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810113
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810113,
					"content": "Bằng bay lượn cần phải thi đậu, sau đó do đội Kỵ Sĩ cấp đồng loạt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810114
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810114,
					"content": "#Hôm nay tôi đến là để làm giám khảo, giám sát {NICKNAME} thi bằng bay lượn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810115
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810115,
					"content": "Dù gì cũng do tôi đưa các bạn Phong Chi Dực, cần phải chịu trách nhiệm, đội trưởng Jean nhất định sẽ nói như vậy nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810116
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810117,
					"content": "Có thể đi cửa sau không...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4810118
					]
				},
				{
					"id": 4810119,
					"content": "Tôi dựa vào sức mình để thi là được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4810120
					]
				},
				{
					"id": 4810116,
					"content": "Thi... nghe có vẻ rắc rối. Nhưng do Amber làm giám khảo, vậy thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810117,
						4810119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4810118,
					"content": "Đừng nhìn tôi như vậy, tuyệt-đối-không-thể.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810121
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810120,
					"content": "#{NICKNAME} chắc chắn sẽ thuận lợi vượt qua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810121
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810121,
					"content": "Chỉ là một bài kiểm tra nhỏ, khả năng bay khi bạn đánh lui Phong Ma Long cả thành Mondstadt đều thấy, chắc chắn không có vấn đề gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810122
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810122,
					"content": "Nhưng mà, vẫn phải tuân thủ theo quy tắc tiêu chuẩn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810123
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810123,
					"content": "Cho bạn quyển hướng dẫn bay này, tuy là không cần học thuộc, nhưng cũng phải hiểu hết mới được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810124
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810124,
					"content": "Ví dụ như không được phép hai người cùng dùng 1 Phong Chi Dực, không thể đem theo vật nặng quá trọng tải, không cho phép dùng Slime Phong để bay v.v...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810125
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810125,
					"content": "Tóm lại, bạn đọc qua một lượt đi, khi chị Lisa dạy tôi ma pháp, cũng bắt tôi đọc mấy quyển sách dày trước...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810126
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810126,
					"content": "Trông rất dày... hết cách, tóm lại đọc trước xem sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4810127,
					"content": "Ừm! Sau khi đọc xong hãy đến Phong Khởi Địa tìm tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810401,
					"content": "Hướng dẫn bay lượn của Đội Kỵ Sĩ Tây Phong, nghe có vẻ khó đọc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4810402,
					"content": "Cứ đọc trước xem sao.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 4810602,
					"content": "Vốn dĩ là một quyển ngụ ngôn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4810604
					]
				},
				{
					"id": 4810603,
					"content": "Cách học bay của người Mondstadt thật lãng mạn...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4810604
					]
				},
				{
					"id": 4810601,
					"content": "Đây là một câu chuyện rất hay... nhưng phong cách... hướng dẫn bay của đội Kỵ Sĩ... là như vậy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810602,
						4810603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4810604,
					"content": "Kệ nó đi, chúng ta mau về tìm Amber đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}