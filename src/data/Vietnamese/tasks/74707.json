					}
				]
			},
			"dialogs": [
				{
					"id": 747070101,
					"content": "...Được, ổn rồi đấy! Quay thêm một đoạn nữa nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070102
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747070102,
					"content": "Tốt lắm. Cắt...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070103
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747070103,
					"content": "Furina! Còn cả Columbina và Chiori nữa, lại gặp mọi người rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747070104,
					"content": "Ừm, chúng tôi vừa quay xong những cảnh phụ mà lần trước nói tới đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070105
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747070105,
					"content": "Ồ! Là mấy cảnh dùng cá làm diễn viên đấy à, thế nào rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747070106,
					"content": "Nhờ hai người giúp đỡ, chúng tôi đã tìm được một \"diễn viên\" phù hợp. Quá trình quay rất suôn sẻ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070107
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747070107,
					"content": "Hai người bố trí bể thủy sinh cũng rất tuyệt. Đạo diễn Furina vừa rồi còn nói, xem xong muốn đi quay luôn một bộ phim tài liệu dưới nước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070108,
						747070109
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 747070108,
					"content": "Quá khen rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747070110
					]
				},
				{
					"id": 747070110,
					"content": "Ừm, tôi cũng rất thích. Tôi có thể cảm nhận được đàn cá bơi lội rất thoải mái, rất hài lòng, hai người đã chăm sóc chúng rất tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070111
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 747070111,
					"content": "Tôi thực sự hy vọng thủy cung này có thể ở đây mãi, như vậy tôi có thể thỉnh thoảng ghé qua xem những con cá này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070112
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747070112,
					"content": "Nếu thực sự không nỡ thì cứ đưa thêm vài cảnh nữa vào trong phim đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070113
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 747070113,
					"content": "Cô nói đúng. Vậy thì tranh thủ bổ sung thêm luôn nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070114
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747070114,
					"content": "Bổ sung thêm vài con cá à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070115
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 747070115,
					"content": "Ý tôi là bổ sung thêm vài cảnh... Chuyên viên ánh sáng, quay phim, cả thư ký trường quay, chuẩn bị!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070116
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747070116,
					"content": "Đến rồi! Nhưng việc chỉ đạo cho cá thì đây đúng là lần đầu tiên luôn đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747070109,
					"content": "Mọi người thích là được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747070110
					]
				}
			]
		}
	]
}