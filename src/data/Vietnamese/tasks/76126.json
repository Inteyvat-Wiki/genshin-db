			"dialogs": [
				{
					"id": 761260101,
					"content": "Jahoda? Còn có... anh Zompaynco, cho hỏi có chuyện gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260102
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761260102,
					"content": "À... ừm... chuyện này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260103
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260103,
					"content": "Anh ta muốn đến Dòng Dõi Sương Nguyệt chơi nhưng lại ngại, nên muốn nhờ cô giúp đỡ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260104
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260104,
					"content": "Đúng! Là vậy đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260105
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260105,
					"content": "Xin chào, tiểu thư Lyylikki! Rất vui được gặp cô, ừm... đây là... tiêu bản hóa thạch mà tôi mang từ Natlan đến!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260106
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260106,
					"content": "Cảm ơn anh, nhưng mà... anh Zompaynco, tôi đã biết anh từ lâu rồi, anh không cần khách sáo như vậy đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260107
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761260107,
					"content": "Hả? Sao cô lại phát hiện ra tôi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260108
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260108,
					"content": "Lúc trước khi tôi phát thức ăn, không phải anh cũng có đứng cạnh xem sao? Cứ lượn lờ qua lại, nhưng chẳng bao giờ đứng vào trong hàng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260109
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761260109,
					"content": "Tôi còn tưởng anh muốn nhận thức ăn, nhưng lại ngại không đến lấy, nên cố tình để lại một phần cho anh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260110
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761260110,
					"content": "Nhưng mà... anh cũng chưa từng lấy thức ăn. Nếu hôm nay anh không tới thì tôi cũng sẽ nhờ người đi hỏi xem có việc gì cần giúp không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260111
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761260111,
					"content": "Ah... Xin lỗi, tôi đang do dự, không biết phải chào hỏi thế nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260112
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260112,
					"content": "Vậy thì... Cô Lyylikki, tôi có thể đến Dòng Dõi Sương Nguyệt xem thử không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260113
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260113,
					"content": "Được chứ. Trong Dòng Dõi Sương Nguyệt cũng có vài vị khách từ nơi khác đến. Nhưng anh muốn đến đó để làm gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260114
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761260114,
					"content": "Chụp hình lưu niệm và tìm kiếm tư liệu. Nếu được thì... tìm người hỏi thăm những câu chuyện truyền thuyết!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260115
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260115,
					"content": "Tôi là thành viên của Hiệp Hội Nghiên Cứu Di Vật Saurian ở Natlan, nếu tôi có thể thu thập một số tư liệu liên quan đến hướng nghiên cứu của mình thì tốt quá rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260116
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260116,
					"content": "Ồ... Vậy là anh muốn đến để đọc sách à? Để tôi suy nghĩ thử...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260117
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761260117,
					"content": "Hai người nói chuyện vui như vậy, ủy thác lần này cũng xem như xong xuôi rồi. Tôi cũng về báo cáo với sếp đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260118
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260118,
					"content": "Cảm ơn nhé, Jahoda! Phần chi phí tôi vẫn sẽ chi trả. Sao có thể để cô phải đi một chuyến không công được chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260119
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260119,
					"content": "Lúc quay về, cũng nhờ cô gửi lời cảm ơn của tôi đến cô chủ Nefer nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260120
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260120,
					"content": "Được. Vậy tôi đi trước đây, hai vị trò chuyện vui nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jahoda"
				}
			]
		},
