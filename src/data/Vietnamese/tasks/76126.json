			"dialogs": [
				{
					"id": 761260201,
					"content": "A... Jahoda? Sao cô lại đến đây? Hmm... cô chủ Nefer có đang rảnh không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260202
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260202,
					"content": "(Quả nhiên là muốn tìm sếp Nef... Hừm, chút chuyện nhỏ này thì mình cũng giải quyết được.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260203
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260203,
					"content": "Không cần phiền phức vậy đâu, là sếp cử tôi đến giúp đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260204
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260204,
					"content": "Hả? Cô nói vậy thì... lẽ nào cô chủ Nefer đã...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260205
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260205,
					"content": "Anh luôn muốn tới thăm Dòng Dõi Sương Nguyệt, đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260206
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260206,
					"content": "Vậy nên, trước tiên anh muốn làm thân với Lyylikki, rồi nhờ cô ấy đưa anh đến Dòng Dõi Sương Nguyệt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260207
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260207,
					"content": "A?! Cô chủ Nefer biết hết rồi sao? Rõ ràng tôi đã giấu kín những chuyện này trong lòng, không có nói với ai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260208
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260208,
					"content": "(Lúc này phải nói câu thật ngầu mới được! Sếp Nef đã nói thế nào ấy nhỉ... hmm, à!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260209
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260209,
					"content": "Haha, anh Zompaynco, khi người ta giữ bí mật, cũng cần phải học cách che giấu việc \"đang giữ bí mật\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260210
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260210,
					"content": "Nếu không, lớp phòng vệ trong lòng anh sớm muộn cũng sẽ xuất hiện lỗ hổng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260211
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260211,
					"content": "Haiz, từ ngày ở quê nhà, tôi đã không giỏi che giấu suy nghĩ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260212
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260212,
					"content": "(Nói được rồi! Chẳng bõ công luyện tập mãi, hihihi...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260213
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260213,
					"content": "Thôi được rồi, nếu đã biết thì cô có thể giới thiệu giúp tôi không? Tôi là người bên ngoài đến, nếu tùy tiện đi làm phiền cô Lyylikki thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260214
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260214,
					"content": "Yên tâm, Lyylikki tốt bụng lắm. Đừng nói là khách từ nơi khác tới, cho dù không phải người thì cô ấy cũng sẽ chào đón rất dịu dàng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260215
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260215,
					"content": "Hả? Thật hay đùa vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260216
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260216,
					"content": "Nhưng dù thế nào, tùy tiện làm phiền vẫn không được lịch sự... Hmm, nếu cô quen biết cô ấy thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260217
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260217,
					"content": "Đương nhiên là quen rồi. Bây giờ chắc họ cũng vừa phát xong thức ăn, chúng ta qua đó xem thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260218
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260218,
					"content": "À, sếp còn nói là... lần này không cần thu phí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260219
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260219,
					"content": "Cảm ơn cô nhiều! Tôi đi thu dọn đồ đạc đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zompaynco"
				}
			]
		}
	]
}