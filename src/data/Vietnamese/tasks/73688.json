			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kamisato Ayaka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736880301,
					"content": "Mọi người nhìn kìa, tiểu thư Ayaka và Nhà Lữ Hành đến rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880302
					],
					"speakerTitle": "Yuu"
				},
				{
					"id": 736880302,
					"content": "Tuy trước đây từng nhìn thấy bộ trang phục này trong ảnh minh họa tiểu thuyết, nhưng khi khoác lên người tiểu thư Ayaka thì lại có phong thái thật đặc biệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880303
					],
					"speakerTitle": "Sae"
				},
				{
					"id": 736880303,
					"content": "Không uổng công tôi xếp hàng từ sớm để giành hàng ghế đầu trong buổi biểu diễn. Trận đấu hôm nay chắc chắn sẽ vô cùng hấp dẫn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880304
					],
					"speakerTitle": "Matsumae"
				},
				{
					"id": 736880304,
					"content": "Woa, tiểu thư Ayaka vừa xuất hiện là đã trở thành tâm điểm rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880305,
					"content": "Quý vị xin hãy giữ yên lặng. Buổi biểu diễn \"Tinh Thần Võ Đạo\" sắp bắt đầu, mọi người giữ trật tự để vào võ đài nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880306
					],
					"speakerTitle": "Reina"
				},
				{
					"id": 736880306,
					"content": "Tiểu thư Ayaka và Nhà Lữ Hành, hai vị theo tôi vào trong nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880307
					],
					"speakerTitle": "Reina"
				},
				{
					"id": 736880307,
					"content": "Nhà Lữ Hành, bạn đã chuẩn bị xong chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880308,
						736880310
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880308,
					"content": "Đã chuẩn bị xong, chúng ta đi thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880309
					]
				},
				{
					"id": 736880309,
					"content": "Ừm, trận đấu tiếp theo phải nhờ bạn giúp đỡ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880310,
					"content": "Tôi cần chút thời gian chuẩn bị.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880311
					]
				},
				{
					"id": 736880311,
					"content": "Không vội, vẫn còn thời gian mà. Đợi bạn xử lý xong rồi chúng ta cùng vào võ đài.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamisato Ayaka"
				}
			]
		},
		{
			"id": 7368804,
			"completionStepIds": [
				7368806
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7368806",
							"2"
						],
						"stepId": 7368806,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kamisato Ayaka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736880401,
					"content": "#{NICKNAME}, Ayaka, chúng tôi ở đây nè!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880402,
					"content": "Đúng là một trận đấu tuyệt vời. Cho dù tôi không hiểu kiếm thuật, nhưng vẫn bị không khí dồn dập của võ đài cuốn hút. Kết thúc rồi mà tim vẫn đập thình thịch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880403
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 736880403,
					"content": "Đúng vậy, kẻ địch mấy lần xuất chiêu làm tôi sợ chết khiếp, nhưng hai người hình như sớm có chuẩn bị, hóa giải vô cùng nhẹ nhàng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880404,
					"content": "Nhà Lữ Hành, tiểu thư Ayaka, xin chúc mừng hai vị đã giành chiến thắng trong cuộc thi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880405
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 736880405,
					"content": "Woa, là Sara, cô cũng đến xem thi đấu sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880406,
					"content": "Tôi theo lệnh của đại nhân Shogun đến giám sát trận đấu. Kiếm thuật của hai vị vô cùng tinh thông, phối hợp lại rất ăn ý. Không chỉ cho khán giả được thấy vẻ đẹp của kiếm đạo, mà còn khiến tôi mở rộng tầm mắt nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880407
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 736880407,
					"content": "Quá khen rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880408
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880408,
					"content": "Ngay từ khi công tác chuẩn bị ban đầu, các vị đã luôn bận rộn, buổi diễn võ hôm nay là màn kết thúc tuyệt vời cho \"Tinh Thần Võ Đạo\". Những đóng góp to lớn này, đại nhân Shogun sẽ ghi nhận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880409
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 736880409,
					"content": "Giờ tôi phải quay về Thiên Thủ Các báo cáo với đại nhân Shogun đây. Tôi xin phép cáo từ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880411
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 736880411,
					"content": "Đúng rồi, mọi người có dự định gì không. Hay là đến Nhà Hàng Uyuu ăn mừng một bữa nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880412
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 736880412,
					"content": "Tốt quá rồi! Mấy ngày nay đầu óc luôn nghĩ đến thi đấu, lâu lắm rồi không ăn một bữa ngon! Chúng ta đi thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880413,
					"content": "Phù...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880414
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880414,
					"content": "Ayaka sao thế?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880415
					]
				},
				{
					"id": 736880415,
					"content": "Không có gì, chỉ là giờ mới dần cảm nhận được cảm giác thắng cuộc thôi. Kujou Sara nói cuộc thi lần này đã giúp cô ấy mở mang tầm mắt, thực ra thì đối với tôi cũng vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880416
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880416,
					"content": "Tuy khán giả dưới võ đài không cảm nhận được, nhưng tôi biết trong trận đấu vừa rồi, tôi nhờ có bạn đánh lạc hướng đối thủ nên mới nhiều lần thoát hiểm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880417
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880417,
					"content": "Nếu không có bạn, chỉ một mình tôi chắc sẽ không thể giành được chiến thắng. Quả thực, về mặt kiếm thuật thì tôi vẫn còn thua kém.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880418,
						736880419
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880418,
					"content": "Ayaka cũng đã giúp đỡ tôi rất nhiều.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880420
					]
				},
				{
					"id": 736880420,
					"content": "Thật sao? Nghe bạn nói vậy, tôi đột nhiên muốn so tài với bạn ghê.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880421
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880421,
					"content": "Thật không giấu gì, từ khi quen biết nhau, tôi luôn hy vọng sẽ có cơ hội so tài võ nghệ với bạn. Trận đấu hôm nay xem như đã thực hiện được một nửa nguyện vọng của tôi rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880422
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880422,
					"content": "Lần sau chúng ta cùng quyết đấu nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880423
					]
				},
				{
					"id": 736880423,
					"content": "Ừm. Nhưng mà... từ giờ đến lúc đó, bạn phải bảo quản tốt thanh kiếm của mình nhé. Nếu như có ngày bị tôi lấy mất, vậy thì tính mạng của bạn sẽ nằm trong tay tôi đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880424
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880424,
					"content": "Hihi... Tôi vẫn luôn muốn nói những lời như vậy, không kỳ lạ chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880425,
						736880426
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880425,
					"content": "Rất giống tiểu thư Orith.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880427
					]
				},
				{
					"id": 736880427,
					"content": "Nè, hai người sao đi chậm thế, lại đang tám chuyện gì đó?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880428
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880428,
					"content": "Chúng tôi vừa nói là phải tìm thời gian để so tài với nhau một trận, xem kiếm thuật của ai lợi hại hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880429
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880429,
					"content": "#Woa, Ayaka rất nghiêm túc với việc luyện kiếm nhỉ. Nhưng mà Ayaka với {NICKNAME} không phải là bạn bè sao, sao còn muốn so tài vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880430,
					"content": "Cũng chính vì là bạn bè nên mới phải thường xuyên so tài, cùng nhau tiến bộ mới đúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880431
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880431,
					"content": "Ừm, cũng đúng nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880432
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880432,
					"content": "Nhà Lữ Hành, lời nói vừa rồi nhớ giúp tôi giữ bí mật nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880433
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880433,
					"content": "Hả? Ayaka vừa nói gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880434
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880434,
					"content": "Không có gì, chúng ta mau đi thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880426,
					"content": "Rất dễ thương.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880427
					]
				},
				{
					"id": 736880419,
					"content": "Ayaka quá khiêm tốn rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880420
					]
				}
			]
		},
