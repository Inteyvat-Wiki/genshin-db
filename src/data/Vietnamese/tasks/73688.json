			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kamisato Ayaka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736880101,
					"content": "Các hạ võ thuật tinh thông, trận đấu này tôi tâm phục khẩu phục.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880102
					],
					"speakerTitle": "Akatsuki Saemon Juuzou"
				},
				{
					"id": 736880102,
					"content": "Quá khen rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880103
					]
				},
				{
					"id": 736880103,
					"content": "#Quý vị khán giả, với trận đấu đầy nhiệt huyết vừa rồi, quán quân cuộc thi \"Tinh Thần Võ Đạo\" đã được xác định, đó là {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880104
					],
					"speakerTitle": "Reina"
				},
				{
					"id": 736880104,
					"content": "#Chúng ta sẽ chờ đón màn biểu diễn cuối cùng vào ngày mai: Do {NICKNAME} và tiểu thư Ayaka hợp sức tiếp chiến đặc sứ của đại nhân Shogun, con rối kiếm sĩ \"Maguu Kengou\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880105
					],
					"speakerTitle": "Reina"
				},
				{
					"id": 736880105,
					"content": "Quý vị, chúng ta không gặp không về!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880106
					],
					"speakerTitle": "Reina"
				},
				{
					"id": 736880106,
					"content": "Nhà Lữ Hành, đúng là một trận đấu mãn nhãn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880107
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880107,
					"content": "Chúc mừng Nhà Lữ Hành, quán quân trao cho bạn là vô cùng hợp lý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880108
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 736880108,
					"content": "Chỉ là không ngờ đối thủ ngày mai lại là Maguu Kengou. Cái tên này nghe có vẻ giống với kẻ mà chúng ta từng gặp ở đảo Yashiori nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880109,
					"content": "Paimon đừng lo lắng, tuy thực lực của đặc sứ rất mạnh, nhưng trận đấu ngày mai không cấm sử dụng Vision. Chúng ta vẫn sẽ chiếm được thế thượng phong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880110
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880110,
					"content": "Hơn nữa, chỉ cần chúng ta chiến đấu hợp lý thì sẽ tìm được cơ hội phản kích thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880111
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880111,
					"content": "Ayaka nói vậy tôi yên tâm hơn nhiều rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880112,
					"content": "Có thể giành chiến thắng hay không thì tôi cũng không chắc, nhưng chỉ có chiến đấu hết mình thì mới có thể mang đến màn biểu diễn tuyệt vời cho khán giả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880113,
						736880114
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880113,
					"content": "Chúng ta chắc chắn sẽ giành chiến thắng, Ayaka.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880115
					]
				},
				{
					"id": 736880115,
					"content": "Hai người nhiệt huyết quá đi, vậy tối nay hãy nghỉ ngơi lấy sức nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880116
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 736880116,
					"content": "Ngày mai tỉnh dậy là có thể thấy Ayaka mặc trang phục mới rồi. Ayaka phong cách Fontaine... thật háo hức.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880117,
					"content": "Ừm, chuyện này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880118,
						736880120
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880118,
					"content": "Tôi cũng vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880119
					]
				},
				{
					"id": 736880119,
					"content": "Nhà Lữ Hành, sao bạn cũng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880121
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880121,
					"content": "Được rồi, Ayaka cứ đáp ứng sự mong đợi của họ đi. Nếu không phải ngày mai có việc bận thì tôi cũng muốn đến xem đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880122
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 736880122,
					"content": "Ừm, cứ vậy đi. Sáng mai tôi sẽ đợi bạn ở Lãnh Địa Kamisato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880120,
					"content": "Sáng mai có cần tôi đến đón Ayaka không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880121
					]
				},
				{
					"id": 736880114,
					"content": "Chúng ta chắc chắn sẽ cống hiến một buổi biểu diễn tuyệt vời.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880115
					]
				}
			]
		},
		{
			"id": 7368802,
			"completionStepIds": [
				7368803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7368803",
							"2"
						],
						"stepId": 7368803,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hirotatsu",
					"Kamisato Ayaka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736880201,
					"content": "Hai vị đến rồi sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880202
					],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880202,
					"content": "Ối, là Hirotatsu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880203,
					"content": "#Trận đấu mấy hôm trước, {NICKNAME} đã đánh bại anh, lại còn giành được quán quân nữa. Giờ còn gì để nói không!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880204,
					"content": "Yên tâm. Tôi không phải đến bắt bẻ hai vị, mà là muốn xin lỗi thôi. Nhà Lữ Hành, trận thua mấy ngày trước tôi đã tâm phục khẩu phục rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880205
					],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880205,
					"content": "Kiếm thuật của các hạ vô cùng cao cường, xuất chiêu nhanh gọn nhưng không hùng hổ dọa người, có thể thấy được đức tính của người cầm kiếm. Trước kia đã đánh giá sai về các hạ, ngôn từ và hành động có phần mạo phạm, các hạ bỏ qua cho tôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880206,
						736880207
					],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880206,
					"content": "Không sao, tôi không để bụng đâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880208
					]
				},
				{
					"id": 736880208,
					"content": "Hai vị đến đón tiểu thư Ayaka phải không? Cô ấy vẫn đang ở trong phòng chuẩn bị, chắc cũng sắp xong rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880209
					],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880209,
					"content": "Nhà Lữ Hành, trước khi tiểu thư đến, tôi có một thỉnh cầu, hy vọng các hạ đồng ý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880210
					],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880210,
					"content": "Được thôi, mời nói!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880211
					]
				},
				{
					"id": 736880211,
					"content": "Tuy tiểu thư chưa từng nhắc đến buổi biểu diễn với gia thần chúng tôi, nhưng dạo này tiểu thư có bận thế nào thì buổi tối cũng dành ra vài tiếng để luyện kiếm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880212
					],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880212,
					"content": "Tiểu thư là người chăm chỉ, cô ấy nói buổi biểu diễn hôm nay có thua cũng không sao, nhưng với tính cách của tiểu thư thì chắc chắn sẽ cố gắng hết mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880213
					],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880213,
					"content": "Thân là gia thần, tôi đương nhiên tin tưởng vào thực lực của tiểu thư, nhưng mà... vẫn hy vọng các hạ có thể giúp đỡ tiểu thư, bảo vệ an toàn cho cô ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880214
					],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880214,
					"content": "Yên tâm, tôi sẽ cố gắng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880215
					]
				},
				{
					"id": 736880215,
					"content": "Vậy thì nhờ các hạ nhé, Nhà Lữ Hành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880217
					],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880217,
					"content": "Woa, Ayaka xuất hiện rồi kìa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880218,
					"content": "Ồ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880219,
					"content": "Sao mọi người không nói gì thế... Bộ trang phục có chỗ nào đó không ổn ư?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880220
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880220,
					"content": "Không phải! Là do Ayaka xinh đẹp quá đó... Rất lung linh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880221,
						736880225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880221,
					"content": "Rất phù hợp với Ayaka.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880222
					]
				},
				{
					"id": 736880222,
					"content": "Đúng vậy, trông giống hệt với đại tiểu thư của Fontaine, tràn đầy khí chất!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880223,
					"content": "Thật sao? Tôi cứ lo là mình bị lố quá... Sợ sẽ không phù hợp với phong cách này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880224
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880224,
					"content": "Nếu mọi người đều thấy đẹp thì tôi yên tâm rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880229
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880229,
					"content": "Hihi, lát nữa thôi mọi người chắc chắn sẽ kinh ngạc khi nhìn thấy Ayaka đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880230,
					"content": "Cám ơn Nhà Lữ Hành và Paimon đã khen. Nếu đã chuẩn bị xong, vậy thì chúng ta đến đấu trường đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880231
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880231,
					"content": "Tiểu thư, Nhà Lữ Hành, hai vị cố lên nhé. Chúc cho buổi biểu diễn thuận lợi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880225,
					"content": "Bộ trang phục rất đẹp và hợp với Ayaka.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880226
					]
				},
				{
					"id": 736880226,
					"content": "Đúng vậy đó, nhìn kỹ thì thấy chiếc váy có thêu thêm hoa văn của nhà Kamisato nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880227,
					"content": "Ừm, là do Onodera cấp tốc tìm người thiết kế trong mấy ngày vừa rồi, nghe nói là dựa theo ý kiến bỏ phiếu của khán giả đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880228
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880228,
					"content": "Bộ trang phục được thiết kế rất vừa vặn, vận động thoải mái hơn tôi tưởng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880229
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880207,
					"content": "Trận đấu với anh, tôi cũng đã đấu hết mình mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880208
					]
				}
			]
		},
		{
			"id": 7368803,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
