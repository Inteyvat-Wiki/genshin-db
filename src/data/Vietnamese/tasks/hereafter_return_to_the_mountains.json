			"dialogs": [
				{
					"id": 718310501,
					"content": "Bạn đã dâng hương chưa, cảm giác thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310502
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718310502,
					"content": "Cũng khá lắm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718310503
					]
				},
				{
					"id": 718310503,
					"content": "Vậy là được rồi. Hy vọng ngôi miếu này sau này hương hỏa sẽ nhiều một chút...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310504
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718310504,
					"content": "Tôi sẽ ở đây một thời gian. Nơi này rất thanh tịnh, là nơi lý tưởng để biên soạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310505
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718310505,
					"content": "Tôi phải cố gắng sắp xếp các tư liệu thu thập được, rồi tiếp tục biên soạn quyển sách về Hộ Pháp Dạ Xoa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310506
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718310506,
					"content": "Sau này có thời gian, bạn có thể thường xuyên ghé thăm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310507
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718310507,
					"content": "Muốn dâng hương thì cứ trực tiếp gặp tôi để lấy là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310508
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718310508,
					"content": "Haiz, thực ra tôi muốn chỉnh sửa lại xung quanh một chút...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310509
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718310509,
					"content": "Đường phải làm lại, hai bên phải gắn rào chắn, bên cạnh miếu thì làm một bồn hoa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang Ping'an"
				}
			]
