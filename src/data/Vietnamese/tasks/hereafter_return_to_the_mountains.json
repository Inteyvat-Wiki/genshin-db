			"dialogs": [
				{
					"id": 718310301,
					"content": "Ngôi miếu nhìn cũng được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310302
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718310302,
					"content": "Quả thật rất đẹp.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718310303
					]
				},
				{
					"id": 718310303,
					"content": "Ủa? Bạn đến thật đúng lúc, ngôi miếu vừa sửa xong không bao lâu, tôi đã trả tiền cho thợ xong rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310304
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718310304,
					"content": "Haizz...Thật không ngờ phải chi nhiều tiền như vậy, số tiền mà tôi cực khổ kiếm được, đều đã đổ hết vào đây rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310305
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718310305,
					"content": "Nhưng dù thế nào đi nữa, ngôi miếu được sửa xong là được rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310306
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718310306,
					"content": "Bạn muốn vào miếu dâng hương không? Tôi đã đặt làm một lư hương mới luôn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310307,
						718310308
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718310307,
					"content": "Được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718310310
					]
				},
				{
					"id": 718310310,
					"content": "Mấy nén hương này bạn hãy cầm lấy, lư hương ở bên kia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718310308,
					"content": "Anh cũng dâng hương rồi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718310309
					]
				},
				{
					"id": 718310309,
					"content": "Đương nhiên. Ngôi miếu vừa xây xong, tôi đã dâng một nén hương rồi, vừa mới cháy hết đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310310
					],
					"speakerTitle": "Wang Ping'an"
				}
			]
		},
