			"dialogs": [
				{
					"id": 220480101,
					"content": "Đền thần lại có chút bừa bộn rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480102
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220480102,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220480103
					]
				},
				{
					"id": 220480103,
					"content": "Meo, là các ngươi à, đến thật đúng lúc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480104
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220480104,
					"content": "Xung quanh đền thần lại bừa bộn, lá rơi đầy sân, thật khó coi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480105
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220480105,
					"content": "Như vậy không thể tiếp đón loài người đến đền thần được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480106
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220480106,
					"content": "Các ngươi có thể giúp ta quét dọn đền thần giống lần trước được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480107,
						220480112
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220480107,
					"content": "Không phải đã có Taisuke và Etsuko rồi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220480108
					]
				},
				{
					"id": 220480108,
					"content": "Ta sẽ không chủ động đến nói chuyện với hai người xanh xanh đó đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480109
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220480109,
					"content": "Cái tên cao cao đó, cứ nhìn ta với ánh mắt rất kỳ lạ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480110
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220480110,
					"content": "Tên xanh xanh còn lại thì luôn làm bộ dạng không có tinh thần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480111
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220480111,
					"content": "Meo meo, hai tên đó đều không đáng tin cậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480115
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220480115,
					"content": "Vậy phiền các ngươi rồi. Vẫn giống như lần trước, dùng gậy dài để quét dọn, các ngươi hiểu không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480116,
						220480117
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220480116,
					"content": "Tôi biết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220480118
					]
				},
				{
					"id": 220480118,
					"content": "Vậy việc này nhờ hết vào ngươi đó, ta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480119
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220480119,
					"content": "Ta đợi các ngươi ở đây, meo meo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				},
				{
					"id": 220480117,
					"content": "Đại khái đã hiểu rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220480118
					]
				},
				{
					"id": 220480112,
					"content": "Có thể nhờ Ooshima...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220480113
					]
				},
				{
					"id": 220480113,
					"content": "Tên người đá đó luôn bận rộn, không biết đang gõ đùng đùng gì nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480114
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220480114,
					"content": "Tảng đá đã tạc xong rồi, tại sao lại cứ làm ồn như vậy chứ, thật phiền...",
					"roleType": "TALK_ROLE_NPC",
