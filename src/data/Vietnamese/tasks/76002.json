			"dialogs": [
				{
					"id": 760020301,
					"content": "Hừ... Lại để chúng chuồn mất rồi. Lũ nhãi nhép này đúng là chán sống, dám mò đến địa bàn của ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020302
					],
					"speakerTitle": "Basu"
				},
				{
					"id": 760020302,
					"content": "Cảm ơn nhé! Đợi các anh em đưa \"Tiểu Thư Belleville\" tới Thị Trấn Nasha rồi thì trả thù lao cho hai người sau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020303
					],
					"speakerTitle": "Basu"
				},
				{
					"id": 760020303,
					"content": "Ừm, nhớ đó... Hả, các người đang buôn người sao?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760020304,
					"content": "Haha, đừng hiểu nhầm nhé. Bọn ta không làm mấy chuyện bắt cóc này đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020305
					],
					"speakerTitle": "Basu"
				},
				{
					"id": 760020305,
					"content": "\"Tiểu Thư Belleville\" là tên của cái cục sắt này, được chuyển từ Fleuve Cendre đến đây, tốn rất nhiều công sức đấy. Nếu để hỏng vụ này thì các anh em đền đã luôn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020306
					],
					"speakerTitle": "Basu"
				},
				{
					"id": 760020306,
					"content": "Ồ, hóa ra là Robot Dây Cót của Fontaine... Kỹ thuật của Fontaine lợi hại thật đó, vận chuyển đến đây mà vẫn còn hoạt động được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760020307,
					"content": "Đùa sao? Hệ thống năng lượng của cái thứ này bị ta gỡ từ lâu rồi, sao có thể...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020308
					],
					"speakerTitle": "Basu"
				},
				{
					"id": 760020308,
					"content": "\"Cảnh báo. Chế độ khởi động <color=#FF5E41FF>Bất Thường</color>. Mô đun năng lượng <color=#FF5E41FF>Bất Thường</color>. Kiểm tra thất bại.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020309
					],
					"speakerTitle": "Tiểu Thư Belleville"
				},
				{
					"id": 760020309,
					"content": "\"Kiểm tra thất bại. <color=#FF5E41FF>Kiểm tra thất bại</color>. <color=#FF5E41FF>Kiểm tra thất bại</color>. <color=#FF5E41FF>Hủy diệt</color>. <color=#FF5E41FF>Hủy diệt</color>. <color=#FF5E41FF>Hủy diệt</color>. <color=#FF5E41FF>Hủy diệt hủy diệt hủy diệt hủy</color>...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020310
					],
					"speakerTitle": "Tiểu Thư Belleville"
				},
				{
					"id": 760020310,
					"content": "#Ối! {NICKNAME}, cẩn thận!",
					"roleType": "TALK_ROLE_NPC",
