			"dialogs": [
				{
					"id": 760020501,
					"content": "Hah! Cuối cùng cũng giải quyết xong! Cái tên ngoại quốc đó toàn nói nhăng nói cuội...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020502
					],
					"speakerTitle": "Hoyka"
				},
				{
					"id": 760020502,
					"content": "Vậy... Chắc là đã chặn được chuyến hàng cấm đến Thị Trấn Nasha rồi nhỉ? À, đừng quên thù lao của chúng tôi nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760020503,
					"content": "Hừm, để kiểm hàng trước đã...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020504
					],
					"speakerTitle": "Hoyka"
				},
				{
					"id": 760020504,
					"content": "Hửm? Kiểm... hàng?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760020505,
					"content": "Không thế thì sao? Nếu có chuyện gì xảy ra thì đừng nói là các người không nhận được Mora, đến các anh em của ta cũng ra về tay không đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020506
					],
					"speakerTitle": "Hoyka"
				},
				{
					"id": 760020506,
					"content": "Chậc... Những vết xước này, thậm chí còn có vết gỉ sét nữa! Fleuve Cendre làm việc chán quá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020507
					],
					"speakerTitle": "Hoyka"
				},
				{
					"id": 760020507,
					"content": "Đó chẳng phải Robot Dây Cót của Fontaine sao? Mà kỹ thuật của Fontaine lợi hại thật đó, vận chuyển đến đây mà vẫn còn hoạt động được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760020508,
					"content": "Hoạt động? Hệ thống năng lượng của cái thứ này bị gỡ từ lâu rồi, sao có thể...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020509
					],
					"speakerTitle": "Hoyka"
				},
				{
					"id": 760020509,
