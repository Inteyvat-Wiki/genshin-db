			"dialogs": [
				{
					"id": 760020101,
					"content": "Này, bồ tèo tóc vàng! Thật trùng hợp, ta đang cần người giúp đây. Vào phụ một tay đi, ta sẽ chia phần cho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020102
					],
					"speakerTitle": "Basu"
				},
				{
					"id": 760020102,
					"content": "#Cái quái gì vậy, đánh không lại đi gọi thêm người à? Được rồi, ta cũng làm thế! {M#Cậu trai}{F#Cô bé} nghe ta nói này, giúp ta xử lý cái tên này đi, chờ có Mora rồi ta sẽ chia cho một nửa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020103
					],
					"speakerTitle": "Hoyka"
				},
				{
					"id": 760020103,
					"content": "Hả!? Chờ đã, chúng tôi chỉ đi ngang qua thôi mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
