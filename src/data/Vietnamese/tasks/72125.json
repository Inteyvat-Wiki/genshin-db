			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hanayama Kaoru"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721250102,
					"content": "Phải mà trồng được thêm ít hoa thì tốt quá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250103
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250103,
					"content": "í, xin chào! Lần đầu gặp mặt...bạn cũng quay về đây sống sao? Xin lỗi nhé, hình như tôi chưa gặp bạn lần nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250104,
						721250109
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250104,
					"content": "Quay về đây sống?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721250105
					]
				},
				{
					"id": 721250105,
					"content": "Ừm, trước đây vì chuyện của Lò Luyện Mikage, những người vốn dĩ sống ở Tatarasuna đều phải sơ tán đi nơi khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250106
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250106,
					"content": "Một thời gian trước, tôi nghe nói Lò Luyện Mikage không sao nữa, Tatarasuna cũng đã an toàn, vì vậy tôi đi hỏi xem có thể trở về không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250107
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250107,
					"content": "Sau khi được phép, tôi mang theo đồ đạc và quay trở về đây sống.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250108
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250108,
					"content": "Nhưng mà...hình như cũng không nhiều người đồng ý quay về đây sống như tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250115
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250115,
					"content": "Nhưng mà đây cũng là chuyện bất đắc dĩ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250116
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250116,
					"content": "Dù sao thì vấn đề của Lò Luyện Mikage trước đây cũng quá nghiêm trọng, mọi người sợ nó lại xảy ra lần nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250117
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250117,
					"content": "Bạn không lo lắng sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721250118
					]
				},
				{
					"id": 721250118,
					"content": "Đương nhiên là có...nhưng tôi là người yêu nhà, hơn nữa tôi cũng không yên tâm với những bông hoa tôi trồng, hihi. Cho nên tôi vẫn quyết định quay về đây sống.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250119
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250119,
					"content": "Nhưng những bông hoa tôi trồng quanh đây đều héo úa rồi. Bây giờ tôi lại không tìm được hạt giống, thật đáng tiếc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250120
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250120,
					"content": "Nơi này rất thích hợp trồng hoa, dù gieo bất cứ loại nào thì cũng sẽ rất nhanh nở thành một biển hoa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250121
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250121,
					"content": "Trước đây tôi còn trồng hoa của nước ngoài nữa, Tiểu Đăng Thảo, Cúc Cánh Quạt và Bồ Công Anh của Mondstadt, Hoa Nghê Thường của Liyue tôi cũng từng trồng rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250122
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250122,
					"content": "Tiểu Đăng Thảo về đêm rất đẹp, nhưng phải trồng ở nơi râm mát, phải tưới thật nhiều nước và cắt tỉa lá khô.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250123
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250123,
					"content": "Tôi nghe nói ở những nơi nhiều gió, Cúc Cánh Quạt sẽ mọc rất tốt, nhưng tôi thấy Inazuma không nhiều gió bằng Mondstadt...nên tôi hay quạt cho nó, không biết có thật sự có ích hay không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250124
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250124,
					"content": "Trồng Bồ Công Anh là yên tâm nhất, nó có thể tự chăm sóc bản thân, nhưng mà...vì chăm sóc bản thân quá tốt nên nó luôn mọc ở những nơi kỳ lạ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250125
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250125,
					"content": "Hở, cái đó...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721250126
					]
				},
				{
					"id": 721250126,
					"content": "Còn Hoa Nghê Thường của Liyue, chăm sóc lá của nó rất phiền phức, một loại sâu tên Onikabuto thường bám trên cánh hoa, tôi đành phải nhặt bỏ từng con một.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250127
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250127,
					"content": "Nhưng mà tôi không trồng được Thanh Tâm, hễ trồng là không lớn được hoặc bị khô héo rất nhanh. Ôi, trên thế giới này có mảnh đất thần kỳ nào có thể trồng được tất cả các loại hoa không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250128
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250128,
					"content": "Tôi, tôi biết rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721250129
					]
				},
				{
					"id": 721250129,
					"content": "Còn nữa còn nữa, bạn có biết Liyue có một loại hoa tên Túi Lưu Ly không? Loại hoa đó rất khó tìm, tôi đã nhờ rất nhiều người...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250130
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250130,
					"content": "À...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250131
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250131,
					"content": "À! Xin lỗi, xin lỗi! Cứ nói đến hoa là tôi lại như vậy, thật sự xin lỗi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250132
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250132,
					"content": "Bạn thích hoa nhỉ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721250133
					]
				},
				{
					"id": 721250133,
					"content": "Chỉ là nghiên cứu một chút thôi, hihi...nhưng bây giờ ngay cả hạt giống tôi cũng không có, hoa cũng không thể trồng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250109,
					"content": "Tôi không phải người dân ở đây.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721250110
					]
				},
				{
					"id": 721250110,
					"content": "Ơ? Vậy sao? Tôi còn tưởng có người chịu quay về đây ở giống tôi chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250111
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250111,
					"content": "Trước đây vì chuyện của Lò Luyện Mikage, những người vốn dĩ sống ở Tatarasuna đều phải sơ tán đi nơi khác.",
					"roleType": "TALK_ROLE_NPC",
