			"dialogs": [
				{
					"id": 721250501,
					"content": "Số hạt giống này dùng được không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721250502
					]
				},
				{
					"id": 721250502,
					"content": "Đây là...được chứ! Đương nhiên là được, có số hạt giống này, chắc chắn tôi sẽ trồng được rất nhiều hoa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250503
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250503,
					"content": "À, xin lỗi, chờ một chút...tôi phải tặng bạn chút thù lao mới được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250504
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250504,
					"content": "Của bạn đây, cảm ơn hạt giống của bạn. Một thời gian nữa bạn quay lại đây, chắc chắn sẽ được thấy một biển hoa thật đẹp!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hanayama Kaoru"
