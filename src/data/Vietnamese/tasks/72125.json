						721250302
					]
				},
				{
					"id": 721250302,
					"content": "Tôi đang nghĩ xem phải tìm hạt giống ở đâu để lại trồng hoa khắp xung quanh đây.",
					"roleType": "TALK_ROLE_NPC",
