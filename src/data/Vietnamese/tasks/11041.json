					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110410401,
					"content": "Đó là Albedo sao? Vì sao anh ấy lại ở nơi này?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110410402,
					"content": "Nghe nói Albedo rất thích vẽ tranh, vì vậy ở nơi này vẽ vời cũng chẳng có gì kỳ quái.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410403
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110410403,
					"content": "Nơi này tầm nhìn rất tốt, phong cảnh cũng đẹp nữa, dù là cảnh vật từ xa hay gần cũng đều đáng để vẽ lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410404
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110410404,
					"content": "Nhưng... anh ta có thấy đám Hilichurl này không? Có bị đột kích không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110410405,
					"content": "Woa hu?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1104106,
			"completionStepIds": [
				1104106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104106",
							"2"
						],
						"stepId": 1104106,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110410601,
					"content": "Các người là ai? Vì sao lại làm chúng hốt hoảng?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410602
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410602,
					"content": "May là tôi đã vẽ xong con Hilichurl đặc biệt này, nếu không thì thật đáng tiếc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410603,
						110410604
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410603,
					"content": "Thì ra anh đang vẽ Hilichurl.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410605
					]
				},
				{
					"id": 110410605,
					"content": "Nhưng mà Hilichurl có gì hay để vẽ chứ, trông chúng giống nhau y hệt còn gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110410606,
					"content": "#Ừm... giải thích có hơi phức tạp, thôi thì mời {F#cô}{M#cậu} xem thử tranh của tôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410607,
						110410608
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410607,
					"content": "Chuyện này...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410609
					]
				},
				{
					"id": 110410609,
					"content": "Woa, có tên vẽ cực kỳ chi tiết này, nhưng mà, cũng có tên có vẻ là vẽ rất qua loa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110410610,
					"content": "Đó là những Hilichurl có thể thấy ở bất cứ nơi nào, chán lắm, không đáng để phí thời gian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410611
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410611,
					"content": "#Nhưng {F#cô}{M#cậu} xem tên này đi, vóc dáng của nó, lông của nó, tư thế của nó, đều toát lên sức sống căng tràn rất khác biệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410612
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410612,
					"content": "Trong cuộc sống tuần hoàn của quần tộc nguyên thủy, sự đặc biệt này tượng trưng cho sự tiến hóa. Tiến hóa, tức là từ không thành có, từ đã biết đến chưa biết...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410613
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410613,
					"content": "Chờ chút chờ chút, tôi có linh cảm đây sẽ là một bài thuyết trình tràng giang đại hải, tôi không có hứng thú đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410614
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110410614,
					"content": "Dù sao cũng đã tìm được người rồi, tôi đi trước đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410615
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110410615,
					"content": "A, cô không có gì muốn hỏi anh ấy sao? Ê!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410616
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110410616,
					"content": "Hừ, người gì kì lạ thật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410617
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110410617,
					"content": "Không ngờ nữ tu Rosaria dẫn đường cho hai người. À, chưa kịp cảm ơn cô ấy nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410618
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410618,
					"content": "Dù sao thì, theo ý của cô ấy, hai người đến là để tìm tôi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410619
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410619,
					"content": "Ừ đúng rồi, chúng tôi đã gặp một cô gái tên là Sucrose trong Thành Mondstadt, cô ấy nói, việc nghiên cứu của anh đang bị rơi vào bế tắc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110410620,
					"content": "Thì ra là vậy, là cô ấy giới thiệu hai vị đến đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410621
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410621,
					"content": "#Nếu tôi đoán không nhầm, thì {F#cô}{M#cậu} chính là Kỵ Sĩ Danh Dự mà gần đây Thành Mondstadt đang bàn luận phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410622
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410622,
					"content": "#Biểu hiện của {F#cô}{M#cậu} trong tai họa rồng, việc điều khiển sức mạnh nguyên tố kỳ lạ, và nhiều chuyện bí ẩn khác, tôi đều đã được nghe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410623
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410623,
					"content": "#Thôi thì nói thẳng kết luận luôn nhé, chỉ có một khả năng, đó là, {F#cô}{M#cậu} từ \"một thế giới khác\" đến đây, đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410624,
						110410625
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410624,
					"content": "Ừm, đúng vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410626
					]
				},
				{
					"id": 110410626,
					"content": "#Tốt quá rồi. Nếu được {F#cô}{M#cậu} giúp đỡ, thì việc nghiên cứu của tôi chắc chắn sẽ có tiến triển rất lớn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410627,
						110410628
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410627,
					"content": "Việc nghiên cứu của anh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410629
					]
				},
				{
					"id": 110410629,
					"content": "#A, xin lỗi, chắc bây giờ {F#cô}{M#cậu} đang có nhiều thắc mắc. Phải bắt đầu giải thích từ đâu nhỉ... ừm, nói về bản chất của sự sống trước nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410630
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410630,
					"content": "Khoan đã khoan đã, như vậy thì trừu tượng quá đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410631
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110410631,
					"content": "Ừm... có lý, so với việc giải thích bằng lời, thì cho hai vị xem gì đó sẽ tốt hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410632
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410632,
					"content": "Ví dụ như thức tỉnh sự sống, để cành cây khô có được \"cuộc sống mới\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410634
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410634,
					"content": "Làm được cả chuyện như vậy sao?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410635,
						110410636
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110410635,
					"content": "Thuật giả kim thật thần kỳ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410637
					]
				},
				{
					"id": 110410637,
					"content": "Nhưng... tôi có một hạt giống rất đặc biệt. Dùng cách ban nãy không hề có hiệu quả với nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410639
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410639,
					"content": "#Nó cũng giống {F#cô}{M#cậu}, đều đến từ thế giới khác. Bế tắc hiện giờ của tôi chính là làm sao để khiến nó sinh trưởng và nở rộ, cũng là việc nghiên cứu cần đến sự trợ giúp của {F#cô}{M#cậu}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410640
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410640,
					"content": "Việc mà anh không làm được thì chúng tôi cũng không giúp được đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410641
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110410641,
					"content": "Đương nhiên là giúp được, vì ngay cả tôi cũng không thể tưởng tượng rằng vẫn còn tồn tại những hình thức sống khác bên ngoài thế giới này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410642
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410642,
					"content": "#Nhưng chỉ cần nghiêm túc quan sát, nghiên cứu người cũng đến từ thế giới bên ngoài như {F#cô}{M#cậu}, nói không chừng sẽ giúp tôi tìm được cảm hứng khiến hạt giống nảy mầm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410643
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410643,
					"content": "Thì ra tôi là \"đối tượng bị nghiên cứu\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410644
					]
				},
				{
					"id": 110410644,
					"content": "#Làm thế nào đây {NICKNAME}? Tôi cảm thấy có gì đó quái dị...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410645,
						110410647
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110410645,
					"content": "Có nguy hiểm không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410646
					]
				},
				{
					"id": 110410646,
					"content": "#Có lẽ có đó, nhưng tôi sẽ dốc hết sức để bảo đảm sự an toàn cho {F#cô}{M#cậu}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410649
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410649,
