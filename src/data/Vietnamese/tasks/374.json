			"dialogs": [
				{
					"id": 3740301,
					"content": "Hehehe, tu nữ cô ấy không thèm nhìn mà đi mất rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740302
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740302,
					"content": "Nhưng mà, kỳ thực tôi cũng đã đạt được mục đích dự định.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740303
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740303,
					"content": "Ít nhất cô ấy không phủ nhận việc Đại Giáo Đường cất giữ Đàn Thiên Không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740304
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740304,
					"content": "#Vậy thì, {NICKNAME}. Nếu đã là người mới đang được yêu thích của đội Kỵ Sĩ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740305
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740305,
					"content": "Hay là, bạn cũng thử xem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
