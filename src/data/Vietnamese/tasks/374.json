				{
					"id": 3740401,
					"content": "Phong Thần chúc phúc bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740402,
						3740404
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740402,
					"content": "Xin chào.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740403
					]
				},
				{
					"id": 3740403,
					"content": "A, bạn là... thành viên mới của đội Kỵ Sĩ sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740406
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740406,
					"content": "Tại sao lại đến đây? Là đội trưởng đại diện đại nhân giao nhiệm vụ sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740411
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740411,
					"content": "Ừm, đội Kỵ Sĩ, cần mượn Đàn Thiên Không...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740412
					]
				},
				{
					"id": 3740412,
					"content": "Thật sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740413
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740413,
					"content": "Không phải tôi nghi ngờ bạn. Nhưng lúc trước có một nhà thơ khả nghi cũng đến mượn đàn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740414
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740414,
					"content": "Hắn nói nhảm liên hồi, dám tự xưng là Barbatos, nhất định là không có ý tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740415
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740415,
					"content": "Việc sử dụng Đàn Thiên Không cũng có quy định. Hiện nay chỉ có trong thời gian Lễ Đánh Cầu mới dùng đến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740416
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740416,
					"content": "Muốn cho mượn phải có sự đồng ý của đội trưởng, Giáo Chủ, đại biểu nhân dân, ký văn bản xác nhận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740417
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740417,
					"content": "Vậy thì, văn bản của đội Kỵ Sĩ đâu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740418,
						3740419,
						3740420
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740418,
					"content": "Hình như chưa từng nghe đội trưởng nhắc đến...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740422
					]
				},
				{
					"id": 3740422,
					"content": "Nói tóm lại văn bản là bắt buộc phải có.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740423
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740423,
					"content": "Nếu không có việc gì khác, tôi xin thất lễ. Gần đây thực sự rất bận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740419,
					"content": "Xin lỗi, tôi quên lấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740422
					]
				},
				{
					"id": 3740420,
					"content": "Trên đường đi bị Paimon ăn mất rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740421
					]
				},
				{
					"id": 3740421,
					"content": "Này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3740404,
					"content": "#Tôi là Kỵ Sĩ Danh Dự {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
