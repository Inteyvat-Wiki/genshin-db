				},
				{
					"id": 721130202,
					"content": "Wa! Là \"Đại cát\" nè!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130203,
					"content": "Xem ra hôm nay là ngày may mắn của Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130204,
					"content": "Của bạn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130205
					]
				},
				{
					"id": 721130205,
					"content": "Chính xác! Hạnh phúc của bạn chính là hạnh phúc của Paimon mà! Cho nên nói ngược lại thì, Paimon hạnh phúc, bạn cũng hạnh phúc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130206,
					"content": "Tôi được ăn món ngon là sẽ hạnh phúc. Thế nên vì sự hạnh phúc của chính bạn, hãy cho Paimon ăn ngon nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
