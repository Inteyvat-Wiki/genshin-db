						721130406
					]
				},
				{
					"id": 721130406,
					"content": "Đương nhiên! Bạn muốn chất vấn trí tuệ của cổ nhân à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130407,
					"content": "Trí tuệ của cổ nhân rất cao siêu đó! Tóm lại, phải tìm Bảng Ngự Thần trước đã!",
					"roleType": "TALK_ROLE_NPC",
