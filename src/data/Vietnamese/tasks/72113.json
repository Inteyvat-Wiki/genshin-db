					"content": "Được được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130503
					]
				},
				{
					"id": 721130503,
					"content": "Đền thờ đúng là nơi không coi trọng tình cảm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130504,
					"content": "Đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130505
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721130505,
					"content": "Ừm ờ, xem thử vận may đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130506,
					"content": "Đúng rồi. Mỗi ngày chỉ có thể rút quẻ 1 lần, bạn hãy ghi nhớ nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130507
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721130507,
					"content": "Nếu không tôi sẽ rất mệt...Không đúng, nếu không sẽ không thể cột lên Bảng Ngự Thần...cũng không phải, nên nói thế nào nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130508
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721130508,
					"content": "\"Bảng Ngự Thần là biểu hiện của ý chí thần linh. Cho nên phải tôn trọng ý chí của thần linh và cố gắng hết sức.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130509
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721130509,
					"content": "Nên mỗi ngày chỉ được rút quẻ 1 lần, nhớ nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gendou Ringo"
				}
			]
		},
