					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130611,
					"content": "Nhưng đã dùng ám hiệu thì chắc chắn đằng sau sẽ là một bí mật gì đó chứ nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130612,
					"content": "Tò mò quá. Lần sau đến Đền Narukami giải quẻ, có cần thử đối chiếu ám hiệu không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130608,
