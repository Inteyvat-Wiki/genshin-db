			"dialogs": [
				{
					"id": 721131001,
					"content": "Rốt cuộc ngươi là ai? Muốn làm gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131002
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131002,
					"content": "Chúng tôi mới phải hỏi đó! Tiểu thư Gendou muốn làm gì, tại sao lại đánh úp chúng tôi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721131003,
					"content": "Vô lễ. Trả lời câu hỏi của ta trước đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131004
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131004,
					"content": "#Tôi là {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131005
					]
				},
				{
					"id": 721131005,
					"content": "Ta biết tên của ngươi, nói thật cho ta biết, ngươi nghe chuyện ám hiệu từ đâu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131006,
						721131008
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131006,
					"content": "Là, là Paimon nói cho tôi biết...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131007
					]
				},
				{
					"id": 721131007,
					"content": "Này! Muốn làm gì đó? Mau nói sự thật ra đi, tiểu thư Gendou liếc chúng ta kìa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131010
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721131010,
					"content": "...Ra là vậy, ám hiệu là do hai người ngẫu nhiên nhận được sao. Xem ra, Momoka đã...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131011
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131011,
					"content": "\"Momoka\" là ai?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131012
					]
				},
				{
					"id": 721131012,
					"content": "Là chủ nhân của ám hiệu này, cũng là đồng liêu của ta. Nhưng xem ra, Momoka đã không thể làm tròn chức trách của mình đối với Inazuma rồi, thật đáng buồn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131013
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131013,
					"content": "Hừ, ta biết các ngươi có nhiều câu hỏi lắm, nên nói cho các ngươi nghe cũng chả sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131014
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131014,
					"content": "Ta và Momoka đều là ninja của Shuumatsuban. Tổ chức của bọn ta sẽ quét sạch mối nguy gây hại cho Inazuma, còn \"mảnh giấy\" là một trong những cách để trao đổi nhiệm vụ của chúng tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131015
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131015,
					"content": "Vì chuyện này, bọn ta cũng đã chịu rất nhiều oán hận và nguy hiểm. Ví dụ như, những kẻ địch kỳ lạ và nguy hiểm đang ẩn náu trong Inazuma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131016,
						721131018
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131016,
					"content": "Người Mondstadt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131017
					]
				},
				{
					"id": 721131017,
					"content": "Người Mondstadt ở đâu ra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131020
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721131020,
					"content": "Nếu biết ám hiệu là có thể nhận ra đồng đội.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131021
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131021,
					"content": "Nhưng ám hiệu của mỗi người đều là độc nhất vô nhị. Xem ra Momoka cố ý viết ra ám hiệu của mình và để lại dấu tích.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131022
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131022,
					"content": "...Để dụ những kẻ địch muốn lợi dụng ám hiệu này ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131023
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131023,
					"content": "Nói như vậy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131024
					]
				},
				{
					"id": 721131024,
					"content": "Tiểu thư Gendou nhìn thấy người đến tiếp đón không phải Momoka, là biết ngay có chuyện không ổn rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131025
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721131025,
					"content": "Đương nhiên, nên ta bắt buộc phải điều tra rõ tình hình. Nhưng thật sự rất kỳ lạ. Ta không tài nào hiểu nổi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131026
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131026,
					"content": "Nếu ngươi là thám tử Snezhnaya, tại sao không báo cáo chuyện này cho Fatui, mà lại ngoan ngoãn hoàn thành nhiệm vụ chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131027
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131027,
					"content": "...Cho nên, ta tin chuyện doanh trại bỏ hoang mà ngươi nói.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131028
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131028,
					"content": "Bởi vì từ hành động thực tế cho thấy, tuy rằng ban đầu các ngươi vì hiếu kỳ nên mới đáp đúng ám hiệu, nhưng đối với Inazuma mà nói, các ngươi là bạn chứ không phải kẻ địch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131029
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131029,
					"content": "Tuy rằng đã trả lại sự trong sạch cho chúng tôi, nhưng nghĩ lại chuyện tiểu thư Gendou đã bóc lột sức lao động của chúng tôi trong thời gian dài như vậy, vẫn thấy không được vui cho lắm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131030
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721131030,
					"content": "...Nhưng người đó, có thật là tiểu thư Gendou không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131031
					]
				},
				{
					"id": 721131031,
					"content": "Ừm, quả nhiên là ngươi đã nhận ra, Gendou giao nhiệm vụ cho các ngươi sau đó, là kẻ mạo danh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131032
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131032,
					"content": "Í?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131033
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721131033,
					"content": "Trên đường theo dõi ngươi, ta đã bị tấn công bởi một số mật thám Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131034
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131034,
					"content": "Vì ta cũng biết một vài nhẫn thuật nên đã dùng cách giả chết gạt chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131035
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131035,
					"content": "Không lâu sau đó chúng đã phái người cải trang thành ta, và thay thế vị trí của ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131036,
						721131037
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131036,
					"content": "Thảo nào cảm thấy cô ấy rất kỳ lạ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131038
					]
				},
				{
					"id": 721131038,
					"content": "Í? Có nghĩa là, Gendou khá thân thiện kia là giả mạo sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131039
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721131039,
					"content": "\"Thân thiện\"? Hừm, cái tên đó có vẻ như rất được hoan nghênh nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131040
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131040,
					"content": "Tóm lại, chắc chúng tưởng rằng ngươi là thành viên của Shuumatsuban, nên muốn thâm nhập tổ chức của bọn ta thông qua cách này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131041
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131041,
					"content": "Đối với ta mà nói, đây cũng là cơ hội rất tốt, nhân lúc tên giả mạo kia hôm nay không có ở đây, ta đã dùng \"cách của mình\" để dẫn ngươi tới đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131042
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131042,
					"content": "Ngươi nghe rõ nhé. Bây giờ ta sẽ cho ngươi lựa chọn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131043
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131043,
					"content": "Trở thành một thành viên bên ngoài, làm việc cho bọn ta. Hiện tại chúng không biết ta vẫn còn sống, cho nên chúng ta sẽ chiếm thế thượng phong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131044,
						721131047,
						721131048
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131044,
					"content": "Nếu tôi từ chối...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131045
					]
				},
				{
					"id": 721131045,
					"content": "Ừm, thử xem sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131046
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131046,
					"content": "#Dù sao thì, {NICKNAME}, Fatui cũng là kẻ thù của chúng ta. Chi bằng chúng ta cứ hợp tác thử đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131049
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721131049,
					"content": "Lựa chọn thông minh đấy. Đây là \"phòng an toàn\", tạm thời giao cho ngươi sử dụng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131050
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131050,
					"content": "Vậy thì, sau này nếu có động thái gì mới, ta sẽ liên lạc với ngươi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131051
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131051,
					"content": "Hy vọng chúng ta hợp tác vui vẻ. Tạm biệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131052
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131047,
					"content": "Có lý.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131049
					]
				},
				{
					"id": 721131048,
					"content": "Được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131049
					]
				},
				{
					"id": 721131037,
					"content": "Thảo nào cô ấy biết từ \"Thẻ Ngự Thần\" này.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131038
					]
				},
				{
					"id": 721131018,
					"content": "Fatui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131019
					]
				},
				{
					"id": 721131019,
					"content": "Đúng vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131020
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131008,
					"content": "Cô nghe tôi giải thích đã, chuyện là như vầy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131009
					]
				},
				{
					"id": 721131009,
					"content": "Chúng tôi tìm thấy một doanh trại bỏ hoang nằm trên một ngọn núi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131052
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}