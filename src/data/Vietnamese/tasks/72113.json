			},
			"dialogs": [
				{
					"id": 721130101,
					"content": "Bạn muốn rút quẻ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130102
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721130102,
					"content": "Ồ, lạnh lùng quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130103,
					"content": "Tôi muốn rút quẻ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130104
					]
				},
				{
					"id": 721130104,
					"content": "Hiểu rồi. Quy trình là thế này. Đầu tiên hãy dùng sức lắc thứ này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130105
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721130105,
					"content": "Nhớ rằng đó là \"Hộp Thẻ Ngự Thần\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130106
					]
				},
				{
					"id": 721130106,
					"content": "Chính xác. Từ bên trong sẽ rơi ra một quẻ trúc. Đưa thẻ trúc này cho tôi, tôi sẽ đưa bạn mảnh giấy tương ứng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130107
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721130107,
					"content": "Hình như gọi là \"Thẻ Ngự Thần\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130108
					]
				},
				{
					"id": 721130108,
					"content": "Thế nào cũng được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130109
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721130109,
					"content": "Tôi có câu hỏi! Nếu, nếu chúng tôi rút phải quẻ hung, thì làm thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130110,
					"content": "Là số mệnh khiến bạn rút phải quẻ hung, bạn còn muốn thế nào? Hử?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130111
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721130111,
					"content": "Hở!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130112,
					"content": "Thứ giống như cái giá ở bên ngoài...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130113
					]
				},
				{
					"id": 721130113,
					"content": "Chậc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130114
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721130114,
					"content": "Cô ấy \"chậc\" một cách lộ liễu vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130115,
					"content": "Tôi xem xem... là thế này. \"Cột quẻ hung lên Bảng Ngự Thần là có thể gặp dữ hoá lành\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130116
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721130116,
					"content": "A, đúng vậy! Nếu bạn rút phải quẻ hung, thì cột nó lên cái giá đó là được rồi mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130117
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721130117,
					"content": "Họ thật là... không đúng, Đền Narukami chúng tôi rất hoà nhã. Vậy nên dù rút phải quẻ hung, cũng sẽ cho các bạn cơ hội đổi vận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130118
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721130118,
					"content": "Mặc dù cảm thấy có gì đó kỳ quái...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130119,
					"content": "#{NICKNAME}, chúng ta rút quẻ đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
