			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paqarin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751880401,
					"content": "#Ba đứa nhóc này trở về rồi, chắc đều là công lao của {F#cô}{M#cậu}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880402
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880402,
					"content": "#Dũng sĩ qua đường, cảm ơn lòng tốt của {F#cô}{M#cậu}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880403
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880403,
					"content": "Tôi vẫn còn đau lưng, nhưng ít nhất có Saurian nhỏ ở bên cạnh bầu bạn cũng cảm thấy thoải mái hơn nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880404
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880404,
					"content": "#Tôi cũng không giàu có lắm, nhưng một chút thù lao tôi vẫn trả được. {F#Cô}{M#Cậu} hãy nhận lấy những thứ này nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paqarin"
				}
			]
		}
	]
}