				"points": []
			},
			"dialogs": [
				{
					"id": 751880101,
					"content": "Hãy giúp tôi ra đồng ruộng tìm <color=#00E1FFFF>ba con Saurian</color> và đưa chúng về chỗ tôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paqarin"
				}
			]
		},
		{
			"id": 7518802,
			"completionStepIds": [
				7518802
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7518802",
							"2"
						],
						"stepId": 7518802,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paqarin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751880201,
					"content": "#Người ở kia ơi... Đúng rồi, chính là {F#cô}{M#cậu} đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880202
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880202,
					"content": "#Nhìn {F#cô}{M#cậu} đi lại nhanh nhẹn như bay, chắc sức lực cũng rất tốt, giống như người thường xuyên tập thể dục vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880203
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880203,
					"content": "#{F#Cô}{M#Cậu} là dũng sĩ của Cộng Đồng Trù Phú chúng tôi sao? Hay là đến từ bộ tộc khác?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880204,
						751880205
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880204,
					"content": "Tôi là nhà mạo hiểm đi ngang qua đây thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751880206
					]
				},
				{
					"id": 751880206,
					"content": "Vậy à, hơi tiếc nhỉ. Haiz, cũng phải, ngay lúc đang thiếu người thì đột nhiên gặp được người giúp đỡ, chuyện tốt như vậy chỉ có thể là mơ thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880207
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880207,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751880208
					]
				},
				{
					"id": 751880208,
					"content": "#Là thế này, {F#cô}{M#cậu} cũng thấy rồi đó, chỗ tôi có một cái nông trại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880209
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880209,
					"content": "Tôi vẫn luôn tự chăm sóc cho nông trại này, nhưng dạo này khá là xui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880210
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880210,
					"content": "Mấy hôm trước, tôi đến so tài với dũng sĩ trong tộc, bị thương ở lưng... Phải rồi, tôi biết chuyện này rất ngu ngốc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880211
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880211,
					"content": "Kết quả là giờ tôi vừa không thể giúp cha khai khẩn đồng ruộng mới, vừa không thể xử lý việc ở nông trại của mình. Nói thật, đi bộ thôi cũng đau nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880212
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880212,
					"content": "#Đúng lúc tôi đang muốn thuê người giúp vài hôm thì gặp được {F#cô}{M#cậu}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880213
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880213,
					"content": "#Tiếc là {F#cô}{M#cậu} chỉ đi ngang qua. Trồng trọt là phải xuống ruộng mỗi ngày, {F#cô}{M#cậu} không tới thường xuyên, mảnh ruộng này của tôi e là bỏ hoang mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880214
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880214,
					"content": "Nhưng bây giờ tôi cũng không có sức mà đi xa đến tận bộ tộc tìm người. Haiz, ngoài mấy con Tatankasaur nhỏ tôi nuôi thì cũng chẳng còn ai có thể giúp được cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880215
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880215,
					"content": "Mấy đứa nhóc đó mấy ngày nay không ngoan lắm, cả ba đứa đều nằm ở lì trong ruộng, không chịu đến gần tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880216
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880216,
					"content": "#Thế này đi, tôi có thể nhờ {F#cô}{M#cậu} giúp một việc không? Hãy thay tôi tìm chúng về, tôi thật sự không tiện đi lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880217
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880217,
					"content": "Không thành vấn đề.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751880218
					]
				},
				{
					"id": 751880218,
					"content": "Vậy thì tốt quá rồi. Bình thường chúng cũng rất ngoan, thường cùng tôi làm việc ngoài đồng. Chỉ là hai hôm nay không biết tại sao lại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880219
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880219,
					"content": "#{F#Cô}{M#Cậu} gọi chúng một tiếng là ba con Saurian nhà tôi chắc sẽ tự trở về thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880205,
					"content": "Tôi không phải người Natlan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751880206
					]
				}
			]
		},
		{
			"id": 7518804,
			"completionStepIds": [
				7518804
			],
