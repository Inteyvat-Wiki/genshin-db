					"speakerTitle": "Paimon"
				},
				{
					"id": 700110111,
					"content": "Nó muốn chúng ta giúp nó đánh bại kẻ thù mà thôi, ở vị trí này...trên bản đồ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700110113
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700110113,
					"content": "Hóa ra là vậy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700110114
					]
				},
				{
					"id": 700110114,
					"content": "Vị trí của tên đó đã đánh dấu trên bản đồ, chúng ta quay về trước đã!",
					"roleType": "TALK_ROLE_NPC",
