			"dialogs": [
				{
					"id": 240190801,
					"content": "...Sao lại làm như vậy? Chúng đâu phải lũ đáng ghét ở Palais Mermonia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190802
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190802,
					"content": "Tôi hơi bất cẩn...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190803
					]
				},
				{
					"id": 240190803,
					"content": "Haiz, không biết tại sao bạn lại làm vậy... có con Hải Âu Tử Kim nào tấn công bạn à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190804
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190804,
					"content": "Đám Hải Âu Tử Kim này sợ bay mất rồi. Đợi mấy hôm nữa tôi lại mang ít đồ tới để xin lỗi chúng vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				}
			]
		},
