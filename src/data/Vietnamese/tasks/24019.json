				"objectNames": [
					"Iaune"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240190101,
					"content": "Như vậy là cho ăn cũng kha khá rồi. Hy vọng là chúng đều được ăn no.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190102
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190102,
					"content": "Đang làm gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190103
					]
				},
				{
					"id": 240190103,
					"content": "Tôi đang cho lũ Hải Âu Tử Kim ăn. Bạn xem, chúng hầu như đều ăn no cả rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190104
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190104,
					"content": "Woa... Quan hệ giữa anh và lũ Hải Âu Tử Kim sao đột nhiên tốt đẹp thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240190105,
					"content": "Chúng không cướp khoai tây nữa sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190106
					]
				},
				{
					"id": 240190106,
					"content": "Không. Ở đây thường xuyên có người tới cho ăn, nên lũ Hải Âu Tử Kim giờ không còn hứng thú gì với khoai tây của tôi nữa rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190107
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190107,
					"content": "Nhưng lần trước anh nói, nếu đi xa quá thì sẽ bỏ lỡ mất công việc mà?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240190108,
					"content": "Hahaha, không sao, hôm nay là ngày nghỉ hiếm hoi của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190109
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190109,
					"content": "Ở đây không có đồng nghiệp bàn công việc, cũng không có người hay động vật nào cướp khoai tây của tôi... Rất phù hợp để nghỉ ngơi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190110
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190110,
					"content": "Hơn nữa, Hải Âu Tử Kim ở đây thật sự rất thân thiện, không cướp khoai tây, cũng sẽ không lao tới quấy nhiễu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190111
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190111,
					"content": "Sau vài lần tự tay cho ăn, lũ Hải Âu Tử Kim có vẻ quen với tôi rồi. Dù có chạm vào lông chúng thì chúng cũng không phản kháng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190112
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190112,
					"content": "So với lũ Hải Âu Tử Kim ở Palais Mermonia thì đám này rất lịch sự đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190113
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190113,
					"content": "Nếu chúng mà biết dùng chân để đánh chữ thì có thể làm thay chúng tôi luôn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190114,
						240190116
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190114,
					"content": "Hải Âu Tử Kim không thể giúp người khác làm việc đâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190115
					]
				},
				{
					"id": 240190115,
					"content": "Ít nhất thì chúng không khiến mọi việc trở nên tồi tệ hơn. Hơn nữa mọi người đều biết có một số chuyện vượt ngoài khả năng của Hải Âu Tử Kim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190118
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190118,
					"content": "Không nói chuyện này nữa. Bạn có muốn thử làm quen với mấy quý ông này không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190119
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190119,
					"content": "Đã gọi chúng là quý ông luôn rồi sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190120,
						240190122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240190120,
					"content": "Tôi đi thẳng qua đó có hơi đường đột không.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190121
					]
				},
				{
					"id": 240190121,
					"content": "Không, những quý ông này rất rộng lượng, chỉ cần bạn không chạm vào lông chúng là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190124
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190124,
					"content": "Đây là thịt cá tôi đã xử lý đặc biệt, cứ mang qua bên đó rồi đặt vào khay là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190125
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190125,
					"content": "Thư giãn đi. Hải Âu Tử Kim rất rộng lượng, chỉ cần bạn cho chúng ăn thì chúng sẽ có thiện cảm, sẽ không hỏi lại bạn về nguồn gốc và cách chế biến đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190122,
					"content": "Làm bạn với Hải Âu Tử Kim cần chú ý gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190123
					]
				},
				{
					"id": 240190123,
					"content": "Cũng không có gì đặc biệt. Chỉ cần không chạm vào lông của chúng là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190124
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190116,
					"content": "Hải Âu Tử Kim không hiểu tiếng người.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190117
					]
				},
				{
					"id": 240190117,
					"content": "Cũng chưa chắc. Có thể chúng chỉ giả vờ không hiểu để cuộc sống thêm an nhàn thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190118
					],
					"speakerTitle": "Iaune"
				}
			]
		},
