			"dialogs": [
				{
					"id": 240190301,
					"content": "Sao nào? Tôi đã nói rồi, lũ Hải Âu Tử Kim này là quý ông, tuyệt đối không giống lũ thô lỗ ở Palais Mermonia đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190302
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190302,
					"content": "Quả thật rất lịch sự.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190303
					]
				},
				{
					"id": 240190303,
					"content": "Đúng không? Chỉ riêng việc ngồi ở đây đã khiến tôi cảm thấy cơ thể và tinh thần đều đang thư giãn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190304
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190304,
					"content": "Thử tưởng tượng, nếu bạn là một chú Hải Âu Tử Kim, có người tới đây cho bạn ăn, việc bạn cần làm chỉ là phơi nắng và suy tư về cuộc sống...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190305
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190305,
					"content": "Haiz, tại sao tôi không phải là một chú Hải Âu Tử Kim, mà lại là kiểm sát viên chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				}
			]
