					"nextDialogs": [
						221040109
					]
				},
				{
					"id": 221040109,
					"content": "Cám ơn bạn đã giúp đỡ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040113
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221040113,
					"content": "Tóm lại, nhờ cả vào bạn rồi, tiền thưởng cũng không tệ đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221040108,
					"content": "Cái nhà trọ này...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221040110
					]
				},
				{
					"id": 221040110,
					"content": "Haiz, chỉ là một nhà trọ thông thường, có điều nằm ở nơi hẻo lánh chút, khách đến trọ nhiều một chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040111
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221040111,
					"content": "Có điều di chuyển nơi rừng hoang, có nơi nghỉ ngơi thật là tốt biết mấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040112
					],
					"speakerTitle": "Verr Goldet"
				},
				{
