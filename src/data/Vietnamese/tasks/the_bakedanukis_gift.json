			"dialogs": [
				{
					"id": 790350101,
					"content": "#{NICKNAME}, Paimon, các bạn có thấy qua hai con Bake-Danuki không? Một con vác túi màu tím, một con vác túi màu vàng...",
					"roleType": "TALK_ROLE_NPC",
