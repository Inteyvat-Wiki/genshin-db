					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 790350102,
					"content": "A! Chắc là Mamesuke và Shibasuke đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790350103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790350103,
					"content": "Xem ra các bạn có biết chúng rồi, thật tốt quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790350104
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 790350104,
					"content": "Không lẽ chúng đã gặp phải chuyện gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790350105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790350105,
					"content": "Không phải, chỉ là chúng nó múa tay múa chân một hồi rồi giao cái này cho tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790350106
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 790350106,
					"content": "Nghe nói các bạn và Bake-Danuki của Inazuma đã từng ghé quán Người Săn Hươu, tôi đoán có lẽ hai con Bake-Danuki này cũng là bạn của hai người, nên chắc là chúng muốn nhờ tôi chuyển cho hai bạn đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790350107
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 790350107,
					"content": "Wow! Là quà của Mamesuke và Shibasuke!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790350108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790350108,
					"content": "Hì hì, xem ra chúng đi đường thuận lợi lắm, không biết sau này sẽ còn có cơ hội gặp lại nhau không...",
