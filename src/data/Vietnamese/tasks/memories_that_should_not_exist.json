			"dialogs": [
				{
					"id": 80200122,
					"content": "Các bạn tiếp tục thu thập manh mối từ cư dân ở Làng Vimara cho đến khi trời tối...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						80200123
					]
				},
				{
					"id": 80200123,
					"content": "Thì ra hai người nhận được ủy thác này nên mới đến đây sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200124
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200124,
					"content": "\"Dường như chỉ tồn tại trong ký ức\"... Đúng là rất thú vị. Tôi cũng không nghĩ đây là một vụ mất tích bình thường, nhưng cũng chưa xác định được là có liên quan đến Giáo Đoàn Vực Sâu hay không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200125
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200125,
					"content": "Tất cả manh mối mà chúng ta có chỉ là Hilichurl đang hoạt động rất sôi nổi, còn lại thì không có thu hoạch gì cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200126,
						80200127
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200126,
					"content": "Được rồi, vậy bây giờ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200128
					]
				},
				{
					"id": 80200128,
					"content": "#Chính là giọng nói thần bí trong ký ức của người thân {NICKNAME}, hình như là... \"Tội Nhân\" gì đó... Rốt cuộc người đó là ai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200129,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200130
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200130,
					"content": "#{NICKNAME}... {F#Cô}{M#Cậu} có cho rằng người thân của {F#cô}{M#cậu} đã phản bội {F#cô}{M#cậu} không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200131,
						80200132
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200131,
					"content": "#Tôi muốn tin tưởng {F#anh ấy}{M#em ấy}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200133
					]
				},
				{
					"id": 80200133,
					"content": "#Hmm... Tôi nhìn thấy được sự do dự ở trong {F#cô}{M#cậu}, dù sao thì {F#cô}{M#cậu} vẫn chưa làm rõ được là chuyện gì đang xảy ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200134
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200134,
					"content": "Trước khi có bất cứ chuyện gì không thể cứu vãn xảy ra, thì mối quan hệ giữa anh em hai người hoàn toàn còn có cơ hội xoay chuyển.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200135
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200135,
					"content": "Không giống như \"Tội Nhân\" mà hai người muốn tìm hiểu, hắn đã cùng với những \"Tội Nhân\" khác phản bội quốc gia, cũng như phản bội tôi từ lâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200136
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200136,
					"content": "Tên của hắn là \"Tiên Tri\" Vedrfolnir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200137
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200137,
					"content": "Tuy không muốn nhắc đến, nhưng hắn chính là người thân của tôi, là anh trai tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200138
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200138,
					"content": "Là... anh của Dain sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200139,
						80200140
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200139,
					"content": "Giữa các anh rốt cuộc đã xảy ra chuyện gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200141
					]
				},
				{
					"id": 80200141,
					"content": "Tổng cộng có năm kẻ... Cũng là \"Năm Tội Nhân\" của Khaenri'ah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200142
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200142,
					"content": "\"Hiền Giả\" Hroptatyr, \"Tiên Tri\" Vedrfolnir, \"Gold\" Rhinedottir. \"Kỵ Sĩ Cực Ác\" Surtalogi, và \"Thợ Săn Á{RUBY#[D]Rächer of Solnari}nh Trăng\" Rerir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200143
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200143,
					"content": "Dù ký ức của tôi bị mài mòn đến thế nào thì những cái tên này tôi cũng sẽ không bao giờ quên. Sẽ có một ngày... Tôi sẽ trả thù tất cả bọn họ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200144
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200144,
					"content": "Những cái tên này! Rất quen thuộc... Rhinedottir, người tạo ra Albedo, và sư phụ Surtalogi của Skirk...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200145,
					"content": "Còn có anh trai của Dain... \"Tiên Tri\" Vedrfolnir, người đã dẫn dắt Chlothar thành lập Giáo Đoàn Vực Sâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200146
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200146,
					"content": "Tất cả đều đã được kết nối với nhau rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200147
					]
				},
				{
					"id": 80200147,
					"content": "(Nếu như vậy thì phiến đá tiên tri được phát hiện trong di tích Fontaine... Rất có thể cũng là do Vedrfolnir tạo ra nhỉ.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200148
					]
				},
				{
					"id": 80200148,
					"content": "Họ từng là những người được đặt nhiều kỳ vọng ở Khaenri'ah, là anh tài xuất chúng trong các lĩnh vực khác nhau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200149
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200149,
					"content": "Kế hoạch vốn nên là sáu người bao gồm cả tôi... Chúng tôi vốn dĩ nên cùng nhau ngăn cản tai họa xảy ra, ngăn cản Hắc Vương tiếp tục lay chuyển gốc rễ của thế giới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200150
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200150,
					"content": "Thế nhưng năm người họ ẩn giấu dục vọng trong lòng, không thể chống lại cám dỗ của Vực Sâu, từ đó chia nhau những loại sức mạnh đủ để hủy diệt thế giới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200151
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200151,
					"content": "Họ trở thành Tội Nhân, cũng trở thành sự tồn tại siêu nhiên. Sức mạnh mà mỗi người họ nắm giữ đều có thể gây chấn động thế giới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200152
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200152,
					"content": "Khi thảm họa giáng xuống Khaenri'ah, không một ai trong số họ đứng ra ngăn cản bi kịch đó... Vì vậy, tôi sẽ không bao giờ tha thứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200153,
						80200154
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200153,
					"content": "Và sau đó...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200155
					]
				},
				{
					"id": 80200155,
					"content": "...Đúng vậy. Nếu cứ tiếp tục mặc kệ, tôi tin rằng một ngày nào đó họ cũng sẽ phản bội cả thế giới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200156,
						80200157
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200156,
					"content": "Có vẻ như anh rất khó chịu khi phải nói ra những điều này.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200158
					]
				},
				{
					"id": 80200158,
					"content": "#Không sao. Tôi đã nói rồi, tôi không định né tránh câu hỏi của {F#cô}{M#cậu}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200159
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200159,
					"content": "Vậy thì... Dain, trong khoảng thời gian trước đó anh có điều tra được gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200160
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200160,
					"content": "Tôi tiếp tục điều tra vấn đề liên quan đến \"Máy Dệt Vận Mệnh\". Đã khá lâu kể từ khi kế hoạch đó được triển khai rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200161
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200161,
					"content": "Dù sao thì chúng ta cũng từng đoạt được mắt của máy cày đầu tiên, nên đã ngăn cản được kế hoạch của họ một thời gian...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200162
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200162,
					"content": "Tôi nhớ, là họ muốn cải tạo Ma Thần Osial gì đó phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200163
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200163,
					"content": "Ừm... Nhưng rất hiển nhiên, đó chắc chỉ là một thử nghiệm kỹ thuật nào đó thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200164
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200164,
					"content": "Cho dù họ vẫn chưa có được \"con mắt của máy cày\", nhưng họ đã lựa chọn bỏ qua giai đoạn thử nghiệm mà tiếp tục thúc đẩy kế hoạch bằng cách nào đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200165
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200165,
					"content": "Có rất nhiều dấu hiệu cho thấy điều này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200166
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200166,
					"content": "Vậy phải làm sao đây? Liệu có còn kịp không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200167
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200167,
					"content": "Việc cấp bách trước mắt... là phải làm rõ rốt cuộc Máy Dệt Vận Mệnh dùng để làm gì, từ đó suy luận ra mục đích của Giáo Đoàn Vực Sâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200168
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200168,
					"content": "Dựa theo manh mối mà tôi hiện đang có, thì tôi đoán rằng Máy Dệt Vận Mệnh có liên quan đến Địa Mạch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200169
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200169,
					"content": "Địa Mạch?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200170
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200170,
					"content": "#{NICKNAME}, lần trước {F#cô}{M#cậu} có thể nhìn thấy ký ức của người thân, nguyên nhân cũng là do Địa Mạch ở đó không ổn định.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200171
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200171,
					"content": "Gần đây trong lúc điều tra Giáo Đoàn Vực Sâu, tôi phát hiện ra rằng chỉ cần là khu vực mà họ hoạt động thì đều sẽ đi kèm với một loạt vấn đề về Địa Mạch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200172
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200172,
					"content": "Thứ chảy trong Địa Mạch của Teyvat chính là... ký ức.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200173
					]
				},
				{
					"id": 80200173,
					"content": "Chờ đã! Vậy theo lời của Dain thì lần chúng ta đến Làng Vimara để tìm \"người dường như chỉ tồn tại trong ký ức\" này, có lẽ cũng có liên quan nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200174
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200174,
					"content": "(Ký ức... Địa Mạch... Máy Dệt Vận Mệnh... Người chỉ tồn tại trong ký ức...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200175
					]
				},
				{
					"id": 80200175,
					"content": "(Những chuyện này rốt cuộc có điểm chung gì...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200176
					]
				},
				{
					"id": 80200176,
					"content": "Những điều hai người nói không phải là không có khả năng. Ngày mai tôi cũng sẽ tham gia điều tra cùng hai người. Sự việc lần này rất có thể sẽ trở thành chìa khóa để làm sáng tỏ những bí ẩn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200177
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200177,
					"content": "Lại hành động cùng Dain sao? Vậy chúng ta mau nghỉ ngơi lấy sức đi, ngày mai chúng ta đến nơi xa hơn một chút xem sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200401
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200401,
					"content": "Hơ ơ... Hôm qua suy nghĩ hơi nhiều nên bây giờ vẫn còn buồn ngủ quá... Đều tại Dainsleif cả, nói toàn những thứ khó hiểu thật...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200402,
						80200403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200402,
					"content": "Tôi cũng có chút mất ngủ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200404
					]
				},
				{
					"id": 80200404,
					"content": "Chúng ta đi tìm Dain đi, hôm nay còn rất nhiều việc phải làm đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200403,
					"content": "Trong đầu thấy có hơi rối.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200404
					]
				},
				{
					"id": 80200157,
					"content": "Nhưng cảm ơn anh vì đã nói cho tôi biết.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200158
					]
				},
				{
					"id": 80200154,
					"content": "Người thân của tôi, đã tiếp xúc với anh trai của anh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200155
					]
				},
				{
					"id": 80200140,
					"content": "Khaenri'ah khi đó rốt cuộc đã xảy ra chuyện gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200141
					]
				},
				{
					"id": 80200132,
					"content": "Theo một góc độ nào đó thì đúng là vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200133
					]
				},
				{
					"id": 80200127,
					"content": "Thông tin mà anh đã hứa với tôi thì sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200128
					]
				}
			]
		},
