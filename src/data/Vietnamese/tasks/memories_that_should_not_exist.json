			"dialogs": [
				{
					"id": 80200301,
					"content": "Thì ra là ở đây sao? Nơi hoang vu thế này đúng là không dễ bị phát hiện nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200302,
					"content": "Vậy chúng ta mau đi xác nhận đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200303,
					"content": "#Khoan đã, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200304
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200304,
					"content": "Hửm?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200305
					]
				},
				{
					"id": 80200305,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200306
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200306,
					"content": "...Việc không thể chậm trễ, chúng ta mau vào trong đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200307
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200307,
					"content": "(Vừa rồi Dain muốn nói gì với mình nhỉ...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200308
					]
				},
				{
					"id": 80200308,
					"content": "Này, chờ tôi với!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
