			"dialogs": [
				{
					"id": 80200101,
					"content": "Đợi đã, bóng người đó là... Dainsleif!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200102,
					"content": "Ồ? Là hai người sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200103
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200103,
					"content": "Là bạn của hai vị sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200104
					],
					"speakerTitle": "Atossa"
				},
				{
					"id": 80200104,
					"content": "Vậy thì tôi vào trong làng để xác nhận tình hình của trưởng làng trước nhé. Gặp lại nhau sau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200105
					],
					"speakerTitle": "Atossa"
				},
				{
					"id": 80200105,
					"content": "Gặp lại nhau sau, Atossa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200106,
					"content": "Đúng là xuất quỷ nhập thần mà, sao mỗi lần anh xuất hiện cũng đều đột ngột như thế vậy hả?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200107,
					"content": "Chỉ cần hai người vẫn đang theo đuổi Vực Sâu thì con đường của chúng ta sẽ luôn giao nhau thôi. Chuyện này không liên quan gì đến cá nhân tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200108
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200108,
					"content": "Vậy có nghĩa là anh đuổi theo Giáo Đoàn Vực Sâu đến đây sao? Cho nên ban nãy anh đã giải quyết một nhóm ma vật Vực Sâu à...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200109,
					"content": "Đương nhiên rồi. Hửm? Lẽ nào hai người không phải vậy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200110,
						80200111
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200110,
					"content": "Chúng tôi cũng phát hiện ra động tĩnh của Giáo Đoàn Vực Sâu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200112
					]
				},
				{
					"id": 80200112,
					"content": "#Bất kể có chậm chạp đến thế nào thì bây giờ hẳn là {F#cô}{M#cậu} cũng phát hiện ra nơi này có gì đó kỳ lạ rồi nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200113
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200113,
					"content": "Giáo Đoàn Vực Sâu chắc chắn đang chuẩn bị gì đó ở gần đây, hoặc nghiêm trọng hơn là... đang thực hiện kế hoạch gì đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200114
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200114,
					"content": "Nên ý anh là Hilichurl xung quanh náo động như vậy là do Giáo Đoàn Vực Sâu gây ra sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200115,
					"content": "Chuyện đến nước này thì vấn đề nhỏ như gây náo động Hilichurl chắc chắn không phải là mục đích của chúng. Cùng lắm đây chỉ là tác dụng phụ của kế hoạch nào đó thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200116
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200116,
					"content": "Nhưng chuyện này vẫn ảnh hưởng đến Làng Vimara, nên tốt nhất là chúng ta ở lại để bảo vệ nơi này một thời gian thì hơn nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200117,
					"content": "Ngoài việc bảo vệ ra, quan trọng hơn là phải làm rõ xem Giáo Đoàn Vực Sâu đang có âm mưu gì ở đây. Việc này mới là điểm mấu chốt để ngăn chặn bi kịch tiếp theo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200118,
						80200119
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200118,
					"content": "Về chuyện này thì chúng ta đi hỏi thăm dân làng thêm đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200120
					]
				},
				{
					"id": 80200120,
					"content": "Tôi vốn cũng không có ý định trốn tránh những câu hỏi đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200121
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200121,
					"content": "Yên tâm... Lần này chúng ta có nhiều thời gian để từ từ trò chuyện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200119,
					"content": "Ngoài ra... Anh còn nợ chúng tôi rất nhiều câu trả lời đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200120
					]
				},
				{
					"id": 80200111,
					"content": "Được rồi, tôi thừa nhận là tôi tình cờ gặp phải chúng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200112
					]
				}
			]
		},
