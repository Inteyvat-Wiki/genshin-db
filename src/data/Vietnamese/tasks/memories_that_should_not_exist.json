			"dialogs": [
				{
					"id": 80200601,
					"content": "Đúng như tôi dự đoán... \"Ký ức giả\" quả nhiên là cái bẫy, Giáo Đoàn Vực Sâu thật sự đã đi theo chúng ta đến đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200602
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200602,
					"content": "Như vậy thì chúng ta cũng sẽ có cơ hội để gặp được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200603
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200603,
					"content": "Argh...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200604
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200604,
					"content": "Dain? Có chuyện gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200605,
					"content": "Hai người có cảm nhận được không? Là Địa Mạch đang nhiễu loạn. Giáo Đoàn Vực Sâu lại đang giở trò gì đó rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200606
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200606,
					"content": "Thể chất của anh nhạy cảm thật đó, tôi không cảm nhận được gì cả...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200607,
					"content": "#{NICKNAME}, làm theo tôi nói... Hai người dùng cơ quan bên kia rời đi trước đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200608
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200608,
					"content": "Để anh một mình ở đây sao? Thật sự không sao chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200609
					]
				},
				{
					"id": 80200609,
					"content": "Giáo Đoàn Vực Sâu đang hành động. Nếu bây giờ quay về Làng Vimara thì có lẽ sẽ có cơ hội bắt được \"người mất tích\" đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200610
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200610,
					"content": "...Cũng có thể xem như là chia nhau ra hành động vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200611
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200611,
					"content": "Ừm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200612
					]
				},
				{
					"id": 80200612,
					"content": "(Lý thuyết thì là vậy...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200613
					]
				},
				{
					"id": 80200613,
					"content": "(Nhưng cứ cảm thấy có gì đó không ổn... Là mình đã bỏ sót điều gì sao?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200614
					]
				},
				{
					"id": 80200614,
					"content": "#Hừ... Tôi biết ngay là trừ khi tôi chủ động bước vào bẫy của các người, nếu không thì {F#cậu}{M#cô} cũng sẽ không đến đây gặp tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200615
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200615,
					"content": "Anh đem bản thân mình ra để đặt cược vào con mắt đó sao...",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80200616
					]
				},
				{
					"id": 80200616,
					"content": "Món cược lớn như vậy, người không kìm được mà rơi vào bẫy phải là tôi mới đúng nhỉ? \"Kiếm Sĩ Hoàng Hôn\" Dainsleif.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80200617
					]
				},
				{
					"id": 80200617,
					"content": "#Một mình {M#cô}{F#cậu} đến đây sao? Đám tín đồ của {M#cô}{F#cậu} đâu, sao không đưa chúng theo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200618
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200618,
					"content": "Trước mặt Kiếm Sĩ Hoàng Hôn đã phòng bị sẵn sàng thì có mang bao nhiêu binh lính đến cũng chỉ là sự lãng phí vô nghĩa... Vậy thì cứ để một mình tôi đối diện với anh vậy.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80200619
					]
				},
				{
					"id": 80200619,
					"content": "Tôi biết anh có rất nhiều điều muốn nói...",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80200620
					]
				},
				{
					"id": 80200620,
					"content": "...Nhưng trước lúc đó thì anh phải đánh bại tôi trước đã, thế nào?",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": []
				}
			]
