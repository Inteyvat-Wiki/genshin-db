			"dialogs": [
				{
					"id": 80200201,
					"content": "Ơ, Dain? Này...! Sao anh lại ngẩn người ở đây vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200202,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200203
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200203,
					"content": "Đã gặp phải chuyện gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200204,
					"content": "Sao vậy, Dain?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200205
					]
				},
				{
					"id": 80200205,
					"content": "#{NICKNAME}，người bị mất tích đó... Rốt cuộc là người như thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200206
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200206,
					"content": "Hửm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200207,
					"content": "Là một chàng trai khoảng hai mươi tuổi... Đã xảy ra chuyện gì vậy Dain?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200208,
					"content": "Bây giờ trong đầu tôi dường như có thêm một số thứ đột nhiên xuất hiện...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200209
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200209,
					"content": "...Là đoạn \"ký ức\" liên quan đến người đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200210
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200210,
					"content": "Sao...? Có khi nào... Hôm qua chúng tôi nói quá nhiều về người đó, nên tối qua anh đã nằm mơ không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200211,
					"content": "Không. Đó không phải mơ, mà là một đoạn ký ức đột nhiên xuất hiện trong đầu tôi khi tỉnh dậy sáng nay...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200212
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200212,
					"content": "Hơn nữa, tôi rất chắc chắn là tôi chưa từng gặp qua người này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200213
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200213,
					"content": "Vậy nội dung của \"ký ức\" đó là gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200214
					]
				},
				{
					"id": 80200214,
					"content": "Tôi nhớ là trong đoạn ký ức đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200215
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200215,
					"content": "...Tôi đã đưa \"mắt của máy cày đầu tiên trên thế giới\" cho anh ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200216
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200216,
					"content": "!?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200217
					]
				},
				{
					"id": 80200217,
					"content": "Haaaả!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200218,
					"content": "...Vậy bây giờ chúng ta có thể chắc chắn là người mất tích đó có liên quan đến Giáo Đoàn Vực Sâu đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200219,
					"content": "Ừm, hơn nữa người đó có lẽ còn có khả năng \"cấy\" ký ức vào trong đầu mọi người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200220
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200220,
					"content": "Có thể làm được như vậy sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200221
					]
				},
				{
					"id": 80200221,
					"content": "Nói như vậy thì có khi nào mọi người trong Làng Vimara cũng bị cấy ký ức giả vào không? Sự thật là vốn dĩ họ không quen biết người đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200222,
					"content": "Nhưng mục đích của việc này là gì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200223,
					"content": "Dù Giáo Đoàn Vực Sâu có kế hoạch gì thì chuyện sáng nay cũng đã tiết lộ một sự thật cho chúng ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200224
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200224,
					"content": "Là sự thật gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200225,
					"content": "Mục tiêu của họ... vẫn là con mắt của máy cày đầu tiên trên thế giới. Họ không bỏ qua việc tìm kiếm nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200226
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200226,
					"content": "Việc cấy cho tôi một đoạn ký ức như vậy, chắc chắn là để làm rối loạn suy nghĩ của người duy nhất biết được tung tích của \"con mắt\" đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200227,
						80200228
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200227,
					"content": "Vậy con mắt đó bây giờ vẫn còn an toàn chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200229
					]
				},
				{
					"id": 80200229,
					"content": "#Sự lo lắng này của {F#cô}{M#cậu} không phải không có lý, nhưng tôi cho rằng Giáo Đoàn Vực Sâu vẫn chưa có khả năng biến đoạn ký ức đó thành hiện thực...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200230
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200230,
					"content": "Nhưng nghĩ đến việc họ chấp nhất với con mắt đó đến vậy, thì chúng ta cũng phải cẩn trọng ở mức độ tương đương mới được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200231
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200231,
					"content": "Đi theo tôi nhé. Chúng ta phải đi kiểm tra xem con mắt đó có còn ở trong tay chúng ta không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200232
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200232,
					"content": "Anh muốn đến nơi anh giấu con mắt đó sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200233,
					"content": "(...Nhưng mà, nếu chúng ta cứ đi như vậy, lỡ như bị theo dõi thì chẳng phải sẽ lộ vị trí sao?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200234
					]
				},
				{
					"id": 80200234,
					"content": "(Hoặc có lẽ đây vốn là mục đích của Giáo Đoàn Vực Sâu khi cấy đoạn ký ức đó cho Dain chăng? Họ khiến anh ta hoài nghi, khiến anh ta nảy sinh ý nghĩ muốn xác nhận lại...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200235
					]
				},
				{
					"id": 80200235,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200236
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200236,
					"content": "(Theo những gì mình biết về Dain thì anh ta phải ý thức được chuyện này... Có vẻ như anh ta đã có kế hoạch khác rồi...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200237,
						80200238
					]
				},
				{
					"id": 80200237,
					"content": "Vậy chúng ta đi thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200239
					]
				},
				{
					"id": 80200239,
					"content": "...Ừm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200238,
					"content": "Anh dẫn đường nhé, Dain.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200239
					]
				},
				{
					"id": 80200228,
					"content": "Liệu có khi nào \"ký ức\" này là thật không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200229
					]
				}
			]
		},
