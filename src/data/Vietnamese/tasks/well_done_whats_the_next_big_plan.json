			"dialogs": [
				{
					"id": 745310101,
					"content": "#{NICKNAME}, Paimon, hai người về rồi à!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310102,
						745310103
					],
					"speakerTitle": "Ninette"
				},
				{
					"id": 745310102,
					"content": "Lần này chụp được khá nhiều hình đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745310104
					]
				},
				{
					"id": 745310104,
					"content": "Tuyệt quá! Lần này thật sự rất cảm ơn hai người!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310105
					],
					"speakerTitle": "Ninette"
				},
				{
					"id": 745310105,
					"content": "Trong lúc hai người giúp đỡ chụp ảnh, tôi nghĩ mình không thể ngồi không, nếu không là sẽ mãi giậm chân tại chỗ mất...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310106
					],
					"speakerTitle": "Ninette"
				},
				{
					"id": 745310106,
					"content": "Cho nên, tôi đã lấy hết can đảm đi nhờ một số người qua đường. Sau đó, tôi cũng nỗ lực chụp được rất nhiều hình! Dữ liệu thử nghiệm như vậy chắc là đủ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310107
					],
					"speakerTitle": "Ninette"
				},
				{
					"id": 745310107,
					"content": "#Hmm hmm, không hổ danh là học trò của tôi! Cũng may nhờ có {NICKNAME} ra tay giúp đỡ đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310108
					],
					"speakerTitle": "Lepine-Pauline"
				},
				{
					"id": 745310108,
					"content": "Lepine-Pauline! Cô về lúc nào thế? Ninette nói dạo này cô đang bận việc khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745310109,
					"content": "Đó chắc chắn là một phi vụ kinh doanh siêu lớn giúp tôi kiếm được bộn tiền!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310110
					],
					"speakerTitle": "Lepine-Pauline"
				},
				{
					"id": 745310110,
					"content": "Dạo trước thực sự rất bận rộn, cũng may nhờ có hai người chăm sóc cho Ninette.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310111
					],
					"speakerTitle": "Lepine-Pauline"
				},
				{
					"id": 745310111,
					"content": "Cô nhóc này, kỹ thuật và thẩm mỹ đều không chê vào đâu được, chỉ là hơi nhút nhát chút. Có hai người giúp đỡ, cô ấy cũng coi như đã bước được một bước quan trọng rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310112
					],
					"speakerTitle": "Lepine-Pauline"
				},
				{
					"id": 745310112,
					"content": "Vậy rốt cuộc cô bận làm ăn lớn gì thế? Thần bí quá, chắc lại nghe được tin tức kỳ lạ gì đó, định dốc hết vốn liếng vào đấy à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745310113,
					"content": "Sao có thể chứ?! Lepine-Pauline tôi đây cũng biết rút kinh nghiệm đấy nhé! Lần này là một dự án siêu to khổng lồ chắc ăn một trăm phần trăm, không thể lỗ được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310114
					],
					"speakerTitle": "Lepine-Pauline"
				},
				{
					"id": 745310114,
					"content": "(Cứ cảm thấy không yên tâm...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745310115
					]
				},
				{
					"id": 745310115,
					"content": "Hừm, bây giờ nói ra thì mất vui. Đợi khi sản phẩm hoàn thành, tôi sẽ mời hai người đến trải nghiệm ngay lập tức!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lepine-Pauline"
				},
				{
					"id": 745310103,
					"content": "Hiệu quả của ống kính \"Tia Chớp\" thật tuyệt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745310104
					]
				}
			]
		}
	]
