				"objectNames": [
					"Huffman"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205180301,
					"content": "Treasure Hoarder ini... teruslah bersembunyi, jangan sampai aku menemukan... tempat persembunyian kalian!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180302
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 205180302,
					"content": "Aku tahu Treasure Hoarder di mana.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180303
					]
				},
				{
					"id": 205180303,
					"content": "Kamu? Bagaimana kamu... tanda di peta ini begitu detail... Dari mana kamu mendapatkannya? Vile? Ternyata dia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180304
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 205180304,
					"content": "... Ini sangat jauh dari lokasi yang kita temukan sebelumnya. Sebenarnya apa tujuan Treasure Hoarder...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180305
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 205180305,
					"content": "Maaf, biarkan aku mencatatnya sebentar... Baiklah, aku sudah tahu, kita segera kirim orang untuk memverifikasi, kalau benar keadaannya seperti itu, kita segera maju menyingkirkan mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180306
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 205180306,
					"content": "Sekali lagi terima kasih! Terima kasih kamu rela berkontribusi demi Mondstadt! Kali ini para Treasure Hoarder pasti tidak bisa kabur lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huffman"
				}
			]
		},
		{
