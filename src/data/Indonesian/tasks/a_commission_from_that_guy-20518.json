					"Vile"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205180401,
					"content": "Kamu sudah kembali, benar-benar efisien, aku jadi tahu kenapa pria itu begitu suka memberikan tugas padamu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180402
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180402,
					"content": "Masalah ini sudah dilaporkan ke Knights of Favonius.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180403
					]
				},
				{
					"id": 205180403,
					"content": "Dilaporkan ke Knights of Favonius... Hah, bukankah aku tadi mengatakan bahwa memberi tahu masalah ini kepada Knights of Favonius malah akan jadi merepotkan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180404
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180404,
					"content": "Kamu benar-benar malas, huh... untung pria itu sudah memberitahuku kalau kamu juga mungkin melakukan hal itu, jadi aku sudah mempersiapkan diri baik-baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180405
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180405,
					"content": "Jangan khawatir dengan masalah selanjutnya, aku akan segera pergi menyelesaikannya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180406
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180406,
					"content": "Tapi berdasarkan perkataan pria itu, mungkin kamu juga mungkin melakukan hal yang tak terduga...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180407
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180407,
					"content": "Lagi pula, kalau aku yang pergi melapor ke Knights of Favonius akan menjadi terlalu jelas, dan lagi Knights of Favonius sebaiknya tidak tahu mengenai identitas pria itu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180408
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180408,
					"content": "Hmmm... ini untukmu, terimalah. Anggap saja ini sebagai hadiah kecil karena kamu \"mengubah keadaan\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				}
			]
		},
		{
			"id": 2051805,
