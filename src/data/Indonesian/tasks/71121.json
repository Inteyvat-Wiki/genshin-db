				},
				{
					"id": 711215102,
					"content": "Siapa kamu?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711215103
					]
				},
				{
					"id": 711215103,
					"content": "Aku? Wah, aku, eh ... ceritanya panjang? Mereka maling, aku diminta bos untuk mencatat barang yang hilang dan mengembalikannya. Gitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711215104
					],
					"speakerTitle": "Pedagang Aneh"
				},
				{
					"id": 711215104,
					"content": "Yah, berhubung kalian sudah usir malingnya, dan kerjaanku juga sudah beres ... aku pamit dulu ya! Dah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711215105
					],
					"speakerTitle": "Pedagang Aneh"
				},
