			"dialogs": [
				{
					"id": 711210301,
					"content": "Ka-Kasihanilah aku, wahai pendekar welas asih ... APA, kalian?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711210302
					],
					"speakerTitle": "Pedagang Aneh"
				},
				{
					"id": 711210302,
					"content": "LAH, kamu?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711210303
					]
				},
				{
					"id": 711210303,
					"content": "Kebetulan sekali ya ... silakan, kalian lanjut sibuk saja. Aku permisi dulu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711210304
					],
					"speakerTitle": "Pedagang Aneh"
				},
				{
					"id": 711210304,
					"content": "Lihat dulu deh barang mereka. Oh, tak usah pedulikan aku, aku sudah catat semua ... nanti juga yang harus dikembalikan, akan dikembalikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711210305
					],
					"speakerTitle": "Pedagang Aneh"
				},
				{
					"id": 711210305,
					"content": "Tu-Tunggu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711210306
					]
				},
				{
					"id": 711210306,
					"content": "Tidak! Kita pasti bertemu lagi!",
					"roleType": "TALK_ROLE_NPC",
