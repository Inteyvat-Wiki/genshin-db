			"dialogs": [
				{
					"id": 718300401,
					"content": "Su-Sudah! Ampun! Kami kalah! Jangan teruskan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300402,
						718300403
					],
					"speakerTitle": "Bos Treasure Hoarder"
				},
				{
					"id": 718300402,
					"content": "Minggat sana!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300404
					]
				},
				{
					"id": 718300404,
					"content": "Si-Siap, laksanakan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300405
					],
					"speakerTitle": "Bos Treasure Hoarder"
				},
				{
					"id": 718300405,
					"content": "Tapi ... boleh tanya apa salah kami?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300406
					],
					"speakerTitle": "Bos Treasure Hoarder"
				},
				{
					"id": 718300406,
					"content": "Apa kamu nemu harta karun di sekitar sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300407
					],
					"speakerTitle": "Bos Treasure Hoarder"
				},
				{
					"id": 718300407,
					"content": "Kami lagi ada pekerjaan renovasi kuil di dekat sini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300408
					]
				},
				{
					"id": 718300408,
					"content": "Re-Renovasi kuil? Di tengah pegunungan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300409
					],
					"speakerTitle": "Bos Treasure Hoarder"
				},
				{
					"id": 718300409,
					"content": "Di sini ada kuil Adeptus?! Wah, jangan-jangan maksud kamu rumah tua itu ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300410
					],
					"speakerTitle": "Bos Treasure Hoarder"
				},
				{
					"id": 718300410,
					"content": "Bos, kita kan memang lihat ada patung burung waktu kita istirahat di sana tempo hari. Berarti patung itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300411
					],
					"speakerTitle": "Treasure Hoarder Sidekick"
				},
				{
					"id": 718300411,
					"content": "Itu Pervases, salah satu dari para Yaksha.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300412
					]
				},
				{
					"id": 718300412,
					"content": "HAH?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300413
					],
					"speakerTitle": "Bos Treasure Hoarder"
				},
				{
					"id": 718300413,
					"content": "Bo-Bos! Apa kita sudah menyinggung Adeptus ...?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300414
					],
					"speakerTitle": "Treasure Hoarder Sidekick"
				},
				{
					"id": 718300414,
					"content": "Ti-Tidak, jangan ngomong sembarangan! Kita kan tidak tahu, berarti tidak bisa dibilang salah, kan?! Kita cuma tidak sengaja! Kurasa Adeptus juga tidak akan menghukum kita ... iya kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300415
					],
					"speakerTitle": "Bos Treasure Hoarder"
				},
				{
					"id": 718300415,
					"content": "Ya sudah! Terima kasih sudah kasih tahu kami kalau kuil itu sedang direnovasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300416
					],
					"speakerTitle": "Bos Treasure Hoarder"
				},
				{
					"id": 718300416,
					"content": "Mohon maaf untuk ketidaktahuan dan ketidaksopanan kami sebelumnya ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300417
					],
					"speakerTitle": "Bos Treasure Hoarder"
				},
				{
					"id": 718300417,
					"content": "Kami akan kembali kasih tahu rekan-rekan untuk jauh-jauh dari kuil itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300418
					],
					"speakerTitle": "Bos Treasure Hoarder"
				},
				{
					"id": 718300418,
					"content": "Bos, apa kita tidak sebaiknya ke sana dan bakar dupa dulu? Untuk minta maaf ke Adeptus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300419
					],
					"speakerTitle": "Treasure Hoarder Sidekick"
				},
				{
					"id": 718300419,
					"content": "Hei, kamu kok jadi banyak omong gini sih! Sudah, ayo pergi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bos Treasure Hoarder"
				},
				{
					"id": 718300403,
					"content": "Awas kalau ke sini lagi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300404
					]
				}
			]
		},
