					"Wang Ping'an"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718300201,
					"content": "Sepertinya ini akan jadi proyek besar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300202
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300202,
					"content": "Kamu benar-benar mau merenovasi tempat ini ya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300203
					]
				},
				{
					"id": 718300203,
					"content": "Ah, ternyata kamu. Sudah kubilang kalau aku sudah jadi warga yang taat hukum dan hidup benar, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300204
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300204,
					"content": "Tapi tidak kusangka proyeknya jadi sebesar ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300205
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300205,
					"content": "Desainer yang kuminta menggambar rancangan kuil baru ini jadi sangat bersemangat begitu tahu ini adalah kuil Yaksha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300206
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300206,
					"content": "Dia bukan cuma bikin banyak sekali gambar, tapi dia juga paksa aku ikut dia belanja bahan bangunan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300207
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300207,
					"content": "Kalau usianya beberapa puluh tahun lebih muda, pasti dia akan minta kerjakan semuanya sendirian ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300208,
						718300210
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300208,
					"content": "Kalian tidak ketemu apa-apa yang berbahaya, kan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300209
					]
				},
				{
					"id": 718300209,
					"content": "Bahaya? Oh, maksudmu monster dan Treasure Hoarder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300212
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300212,
					"content": "Jangan khawatir. Setelah Bagian Urusan Sipil tahu kalau aku sedang memperbaiki kuil Yaksha, mereka langsung kirim Millelith untuk berjaga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300213
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300213,
					"content": "Sepertinya monster-monster di sekitar sini sudah mereka usir semua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300214
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300214,
					"content": "Kalau Treasure Hoarder ... Mereka sih tidak berani keluar karena ada Millelith.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300215
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300215,
					"content": "Tapi pekerjaan renovasi ini jauh lebih besar dari perkiraanku. Bahan bangunan yang sudah kami siapkan tidak cukup. Kami sampai harus pesan lagi tambahan dari kota.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300216
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300216,
					"content": "Meskipun para Treasure Hoarder itu tidak berani menyerang lokasinya langsung, tapi mereka bisa saja menyergap dan mencuri bahan bangunan yang lagi diantar ke sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300217
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300217,
					"content": "Para Millelith bisa menjaga lokasi， itu sih bukan masalah. Tapi mereka bakal kewalahan kalau jalur pengiriman yang diserang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300218
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300218,
					"content": "Boleh minta bantuanmu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300219
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300219,
					"content": "Aku tahu kamu hebat. Treasure Hoarder bukan tandinganmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300220
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300220,
					"content": "Mungkin kamu bisa kasih mereka pelajaran? Agar tidak mengganggu pekerjaan kami lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300221,
						718300223
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300221,
					"content": "Jelas bisa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300222
					]
				},
				{
					"id": 718300222,
					"content": "Terima kasih. Terima kasih banyak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300223,
					"content": "Kenapa tidak minta tolong Millelith?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300224
					]
				},
				{
					"id": 718300224,
					"content": "Mereka sudah sibuk jaga tempat ini siang dan malam. Aku tidak mau buat mereka jadi kewalahan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300225
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300225,
					"content": "Kalau begitu kuserahkan padamu, Pengembara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300210,
					"content": "Setahuku tempat ini tidak begitu aman ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300211
					]
				},
				{
					"id": 718300211,
					"content": "Maksudmu banyak monster dan Treasure Hoarder berkeliaran di sekitar sini ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300212
					],
					"speakerTitle": "Wang Ping'an"
				}
			]
		},
