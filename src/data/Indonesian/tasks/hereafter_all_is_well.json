			"dialogs": [
				{
					"id": 718300701,
					"content": "Halo! Jadi, ada Treasure Hoarder tidak di sekitar sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300702
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300702,
					"content": "Ah, mereka sudah pergi ya. Baguslah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300703
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300703,
					"content": "Masih ada yang bisa kubantu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300704
					]
				},
				{
					"id": 718300704,
					"content": "Hahaha. Terima kasih atas tawarannya. Tapi kamu sudah bantu banyak sekali. Aku tidak enak hati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300705
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300705,
					"content": "Tapi kalau mau, boleh tolong carikan beberapa <color=#00E1FFFF>Sandbearer Wood</color>? Anggap saja sumbangan resmimu untuk pekerjaan renovasi ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300706
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300706,
					"content": "Menyumbang ke kuil itu kan perbuatan baik. Nasib dan peruntunganmu pasti jadi lebih baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300707,
						718300709
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300707,
					"content": "Biar kucarikan untukmu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300708
					]
				},
				{
					"id": 718300708,
					"content": "Haha, baiklah. Bawa saja <color=#00E1FFFF>Sandbearer Wood</color> yang kamu dapat ke sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300709,
					"content": "Memangnya ada orang lain yang menyumbang untuk pekerjaan renovasi ini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300710
					]
				},
				{
					"id": 718300710,
					"content": "Hmmm, tidak banyak sih, sejujurnya. Tempat ini terpencil sekali, banyak yang tidak tahu ada kuil di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300711
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300711,
					"content": "Aku juga tidak yakin kalau orang-orang masih ingat ada Yaksha yang bernama Pervases ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300712
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300712,
					"content": "Tapi ya sudahlah. Sekarang tolong berikan saja <color=#00E1FFFF>Sandbearer Wood</color> yang bisa kamu temukan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang Ping'an"
				}
			]
		},
