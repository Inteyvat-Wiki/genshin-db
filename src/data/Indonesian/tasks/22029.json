					"Asakura"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220290101,
					"content": "Aku pasti! Aku pasti akan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290102
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290102,
					"content": "Eh? Siapa kamu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290103
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290103,
					"content": "Aku yang menerima misimu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290104
					]
				},
				{
					"id": 220290104,
					"content": "Oh, maksudmu permintaanku untuk mencari teman latihan ya? Betul, aku sedang mencari teman latihan bela diri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290105
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290105,
					"content": "Jadi kamu yang menerima misiku? Tapi kenapa aku tidak pernah melihatmu di kota?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290106
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290106,
					"content": "Maaf, aku tidak seharusnya meragukan kemampuanmu. Tapi aku benar-benar tidak tahu kemampuan bela dirimu seperti apa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290107,
						220290109
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290107,
					"content": "Aku pernah mengalahkan naga raksasa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290108
					]
				},
				{
					"id": 220290108,
					"content": "Hahaha... Benarkah? Aku penasaran di mana kamu menemukan naga raksasa itu. Aku saja cuma pernah mendengarnya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290112
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290112,
					"content": "Aku jago bela diri.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290113
					]
				},
				{
					"id": 220290113,
					"content": "Haha, tapi bagaimanapun juga, bela diri tidak bisa dibuktikan dengan kata-kata. Ayo kita duel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290114,
						220290115
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290114,
					"content": "Pikiran kita sama.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 220290115,
					"content": "Tunggu dulu, kenapa kamu memakai nama buatan saat mengajukan permintaanmu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290116
					]
				},
				{
					"id": 220290116,
					"content": "I-itu... alasannya sedikit memalukan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290117
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290117,
					"content": "*uhuk* Tapi karena kamu sudah menerima misinya, aku terus terang saja padamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290118
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290118,
					"content": "Jadi beberapa waktu lalu, aku dan beberapa Doushin pergi untuk menyelesaikan misi. Waktu pulang, kami melihat Kairagi yang bersiap-siap menyerang karavan pedagang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290119
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290119,
					"content": "Kami langsung maju dan menyelamatkan karavan pedagang itu. Awalnya kami berhasil, mereka mundur dengan cepat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290120
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290120,
					"content": "Tapi kami belum sempat menghela napas, tiba-tiba Kairagi yang lain muncul dari samping, dan ada pemimpin mereka juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290121
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290121,
					"content": "Sebelum kami sempat bereaksi, mereka sudah menyerang duluan, sampai kami babak belur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290122
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290122,
					"content": "Karena sudah tidak mungkin menang, kami cuma bisa menghadang serangan para Kairagi itu sambil melindungi pedagang kembali ke kota.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290123
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290123,
					"content": "Bukan cuma itu, waktu bertarung dengan para Kairagi... senjataku direbut oleh mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290124
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290124,
					"content": "Dan dia mengarahkan senjataku ke arahku sambil tertawa. Aku benar-benar merasa dipermalukan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290125
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290125,
					"content": "Bagaimana dengan para pedagangnya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290126
					]
				},
				{
					"id": 220290126,
					"content": "Waktu mundur, kami bertemu dengan Doushin yang sedang berpatroli. Semua Kairagi langsung mundur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290127
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290127,
					"content": "Pedagang-pedagang itu juga berhasil kami antar sampai ke kota dengan selamat. Tapi barang-barang mereka... Aih, semua ini karena ilmuku yang masih kurang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290128
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290128,
					"content": "Begitu kembali, aku diberi senjata lagi, tapi aku masih belum bisa melupakan kejadian itu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290129
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290129,
					"content": "Itu sebabnya aku mengajukan permintaan ini. Aku ingin menggunakan kesempatan ini untuk mengasah kemampuan bela diriku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290130
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290130,
					"content": "Nanti kalau aku sudah lebih kuat, aku sendiri yang akan mengalahkan Kairagi itu. Akan kuambil kembali senjataku, dan menghapus rasa malu ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290109,
					"content": "Aku pernah menyaksikan dewa turun dari langit.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290110
					]
				},
				{
					"id": 220290110,
					"content": "Eh, dari cara bicaramu, kamu pasti pernah ikut Rite of Descension di Liyue ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290111
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290111,
					"content": "Hahaha, dari perkataanmu, pasti banyak orang-orang Liyue yang sudah menyaksikan dewa turun dari langit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290112
					],
					"speakerTitle": "Asakura"
				}
			]
		},
