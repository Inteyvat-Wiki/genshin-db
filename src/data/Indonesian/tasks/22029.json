			"dialogs": [
				{
					"id": 220290301,
					"content": "*huff* *huff* Kamu kuat sekali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290302
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290302,
					"content": "Aku... aku sudah mendapat pelajaran darimu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290303,
						220290304
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290303,
					"content": "Ka-kamu tidak apa-apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290305
					]
				},
				{
					"id": 220290305,
					"content": "Ti-tidak apa-apa, aku cuma perlu atur napas saja...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290306
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290306,
					"content": "Tapi kamu kuat sekali, sepertinya sekarang aku percaya kalau kamu bilang pernah mengalahkan seekor naga...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290307
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290307,
					"content": "Sebenarnya, aku memang benar-benar mengalahkan naga itu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290308
					]
				},
				{
					"id": 220290308,
					"content": "Hahaha... tentu saja sekarang aku percaya. Terima kasih sudah latihan denganku, pertarungan ini akan selalu kuingat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290309
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290309,
					"content": "Jika bersedia, silakan datang dan sering-sering berlatih denganku kapan-kapan. Kalau ada teman berlatih sehebat kamu... aku pasti bisa berhasil menyelesaikan hal itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290310
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290310,
					"content": "Hal itu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290311
					]
				},
				{
					"id": 220290311,
					"content": "*ehem*... Cuma harapan kecilku saja. Terima kasih ya untuk kali ini, terimalah imbalan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290312
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290312,
					"content": "Aku harus pulang dan istirahat, jurusmu tadi... hebat sekali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290304,
					"content": "Maaf, aku terlalu bersemangat barusan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290305
					]
				}
			]
		},
