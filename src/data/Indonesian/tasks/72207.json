					"speakerTitle": "Shitoki"
				},
				{
					"id": 722070102,
					"content": "Harta yang kakak tinggalkan padaku ada di dalam keong ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722070103
					],
					"speakerTitle": "Shitoki"
				},
				{
					"id": 722070103,
					"content": "Tapi keong-keongnya sudah tersebar ke mana-mana ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722070104
					],
					"speakerTitle": "Shitoki"
				},
				{
					"id": 722070104,
					"content": "Ada harta milik kakak. Aku masih belum boleh pergi, tidak, tidak ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722070105,
						722070106
					],
					"speakerTitle": "Shitoki"
				},
				{
					"id": 722070105,
					"content": "Harta ...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722070107
					]
				},
				{
					"id": 722070107,
					"content": "Dia pergi ke lautan kabut dan membuat tetua agung marah besar. Katanya, jiwa kakakku tidak akan bisa kembali lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722070108
					],
					"speakerTitle": "Shitoki"
				},
				{
					"id": 722070108,
					"content": "Tapi kakak bilang, di sana ada bunga-bunga yang indah dan lautan mutiara. Ada ayah yang mendayung perahu di sana, dan ada adik perempuan yang melambaikan tangannya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722070109
					],
					"speakerTitle": "Shitoki"
				},
				{
					"id": 722070109,
					"content": "Dia meninggalkan harta karunnya sebelum pergi ke lautan kabut, dan dia tidak pernah kembali lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shitoki"
				},
				{
					"id": 722070106,
					"content": "Tentang kakakmu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722070107
					]
				}
			]
