					],
					"speakerTitle": "Masose"
				},
				{
					"id": 751790902,
					"content": "*huff* Jangan buang-buang waktu, aku sudah periksa. Kebanyakan barang pecah belah. Menurutmu masih ada yang utuh setelah gerobaknya terbalik begitu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790903
					],
					"speakerTitle": "Itsaho"
				},
				{
					"id": 751790903,
					"content": "Simpan tenagamu dan istirahatlah. Setelah Bos dan yang lainnya kembali, perjalanan kita masih panjang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790904
					],
					"speakerTitle": "Itsaho"
				},
				{
					"id": 751790904,
