			"dialogs": [
				{
					"id": 751790601,
					"content": "Fiuh ... situasinya parah juga. Bisa-bisanya hampir dihempas sama Tepetlisaurus ... Bikin emosi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790602
					],
					"speakerTitle": "Itzayah"
				},
				{
					"id": 751790602,
					"content": "Kalian salah! Mereka itu monster Abyss! Jauh lebih ganas dari Tepetlisaurus! Ternyata kalian pikir mereka Saurian biasa ya ... pantas saja jadi susah begini!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790603
					]
				},
				{
					"id": 751790603,
					"content": "Haha, begitu ya? Pantas saja. Kali ini aku berutang budi pada kalian. Kalau kalian tidak datang, aku pasti sudah tamat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790604
					],
					"speakerTitle": "Itzayah"
				},
				{
					"id": 751790604,
					"content": "Kalian tunggu di sini sebentar, aku perlu cari orang-orangku dulu. Dasar tidak berguna semua. Aku akan berterima kasih dengan benar setelah pastikan mereka semua baik-baik saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790605
					],
					"speakerTitle": "Itzayah"
				},
				{
					"id": 751790605,
					"content": "Berkat bantuanmu, orang-orang dari rombongan perlahan berkumpul kembali.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
