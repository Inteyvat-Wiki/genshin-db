			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tizlo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751790401,
					"content": "Hei! Kamu! Iya, kamu! Di luar bahaya, cepat masuk sini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790402
					],
					"speakerTitle": "Tizlo"
				},
				{
					"id": 751790402,
					"content": "Kamu tidak lihat jalannya separah apa? Gunung berapinya meletus, dan ada monster yang menghalangi jalan. Kalian sebaiknya jangan maju lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790403
					],
					"speakerTitle": "Tizlo"
				},
				{
					"id": 751790403,
					"content": "Dengarkan aku. Tunggu di sini sebentar, nanti keluarnya bareng rombongan kami. Kita bisa saling jaga. Kalau sendiri saja bahaya sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790404,
						751790408
					],
					"speakerTitle": "Tizlo"
				},
				{
					"id": 751790404,
					"content": "Monster?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790405
					]
				},
				{
					"id": 751790405,
					"content": "Iya, segerombolan Tepetlisaurus warna ungu! Mereka pasti terkontaminasi Abyss! Pokoknya parah deh! Jujur saja, aku belum pernah melihat Tepetlisaurus yang begitu mengerikan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790406
					],
					"speakerTitle": "Tizlo"
				},
				{
					"id": 751790406,
					"content": "Kuberi tahu ya, sekali mereka ayunkan ekor, gerobak kami langsung luluh lantak. Menurutku mereka jauh lebih kuat dari Tatankasaurus, dan jelas tidak bisa dilawan oleh sembarang orang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790407
					],
					"speakerTitle": "Tizlo"
				},
				{
					"id": 751790407,
					"content": "Serius! Jangan ajak mereka berkelahi. Kalau ketemu, langsung kabur saja, paham?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tizlo"
				},
				{
					"id": 751790408,
					"content": "Jangan khawatir, aku akan baik-baik saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790409
					]
				},
				{
					"id": 751790409,
					"content": "Kamu ... *huff* ya sudahlah. Hati-hati di jalan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tizlo"
				}
			]
		},
