			"dialogs": [
				{
					"id": 751791101,
					"content": "Aduh, gimana nih ... Gimana nih.... Bos pasti hajar aku begitu balik .....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751791102,
						751791106
					],
					"speakerTitle": "Cuchihua"
				},
				{
					"id": 751791102,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751791103
					]
				},
				{
					"id": 751791103,
					"content": "*huff* Ceritanya panjang ... Perjalanan kami tadinya lancar-lancar saja, tapi gunung berapinya mendadak meletus. Terus ... segerombolan Tepetlisaurus ungu muncul dari tanah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751791104
					],
					"speakerTitle": "Cuchihua"
				},
				{
					"id": 751791104,
					"content": "Aku tidak hati-hati, jadi rekan Saurian-ku takut dan bawa aku kabur. Setelah berhasil tenangkan dia, jalannya sudah terhalang, jadi sekarang aku tidak bisa balik ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751791105
					],
					"speakerTitle": "Cuchihua"
				},
				{
					"id": 751791105,
					"content": "Aku bahkan tidak tahu keadaan yang lain ... Bos pasti marah besar karena aku kabur sendiri tanpa izin. Gawat, gawat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cuchihua"
				},
				{
					"id": 751791106,
					"content": "Kalau aku jadi kamu sih, aku kabur ya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751791107
					]
				},
				{
					"id": 751791107,
					"content": "Kabur? Tidak, tidak, tidak! Bos itu seperti Kerajaan Malam, selalu membayangi! Aku tidak mungkin bisa lolos dari dia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751791108
					],
					"speakerTitle": "Cuchihua"
				},
				{
					"id": 751791108,
					"content": "Aku harus balik dan minta maaf. Tapi gimana caranya? Jalannya terhalang ... Aduh, mati deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cuchihua"
				}
			]
