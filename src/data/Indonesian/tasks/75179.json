						],
						"pointId": 10703
					},
					{
						"sceneId": 3,
						"position": [
							-2892.566,
							257.855,
							9924.833
						],
						"pointId": 10710
					},
					{
						"sceneId": 3,
						"position": [
							-2892.844,
							257.694,
							9921.14
						],
						"pointId": 10983
					}
				]
			},
			"dialogs": [
				{
					"id": 751790101,
					"content": "He-Hei! Jangan bergerak! Semua ini punya kami! Jangan bergerak! Aku kasih tahu ya, a-aku itu masih bisa ikut \"Perang Penjaga Malam\" loh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790102
					],
					"speakerTitle": "Masose"
				},
				{
					"id": 751790102,
					"content": "Ka-kalau kamu berani curi barang kami, aku hajar kamu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790103
					],
					"speakerTitle": "Masose"
				},
				{
					"id": 751790103,
					"content": "*Huff* Hari ini kenapa sih? Gunung berapi meletus, terus ada Tepetlisaurus ungu, sekarang, ada gerombolan penjahat ... sial banget deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790104
					],
					"speakerTitle": "Itsaho"
				},
				{
					"id": 751790104,
					"content": "Masose, dia kayaknya kuat banget, kita mana bisa kalahin dia ... Lupakan deh. Lagian kita cuma mau nonton, harusnya enggak termasuk ikutan, kan ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790105
					],
					"speakerTitle": "Itsaho"
				},
				{
					"id": 751790105,
					"content": "Itsaho, ka-kamu! Kok bisa ngomong kayak gitu? Ini kan barangnya semua orang! Lalu, memangnya kamu pikir kita tidak bisa mengalahkannya kalau kita serang bareng-bareng?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790106
					],
					"speakerTitle": "Masose"
				},
				{
					"id": 751790106,
					"content": "Bareng-bareng? Kalau kamu mau hajar, majulah, jangan ajak-ajak aku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790107
					],
					"speakerTitle": "Itsaho"
				},
				{
					"id": 751790107,
					"content": "Eh, halo kakak. Kami tidak mau barangnya lagi, kalau mau, ambil saja ambil. Asal jangan pukul kami ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790108,
						751790109
					],
					"speakerTitle": "Itsaho"
				},
				{
					"id": 751790108,
					"content": "Kurasa ada salah paham di sini ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790111
					]
				},
				{
					"id": 751790111,
					"content": "Kalian salah paham deh! Kami ini sebenarnya petualang yang mau membantu, bukan orang jahat yang mau malakin kalian!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751790112,
					"content": "Kenapa aku harus percaya kalian? Ah! Sakit! Itsaho, kok pukul aku sih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790113
					],
					"speakerTitle": "Masose"
				},
				{
					"id": 751790113,
					"content": "Kalau mereka mau, kita pasti sudah mati dari awal. Ngapain mereka repot-repot jelasin ke kita panjang lebar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790114
					],
					"speakerTitle": "Itsaho"
				},
				{
					"id": 751790114,
					"content": "Kami baru saja terpisah dari karavan kami. Kalian kan petualang, bisa tolong kasih tahu bos kami kalau kami lagi tunggu dia di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790115
					],
					"speakerTitle": "Itsaho"
				},
				{
					"id": 751790115,
					"content": "Semua barang yang ada di sini akan kami berikan, sebagai tanda terima kasih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790116
					],
					"speakerTitle": "Itsaho"
				},
				{
					"id": 751790116,
					"content": "Oh, gampang! Serahkan saja pada kami!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751790109,
					"content": "Kamu benar-benar pintar ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790110
					]
				},
				{
					"id": 751790110,
					"content": "Hei. Cara ngomongmu itu kayak kami orang jahat ya di sini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790111
					],
					"speakerTitle": "Paimon"
				}
			]
		},
