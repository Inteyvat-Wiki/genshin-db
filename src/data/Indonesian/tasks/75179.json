						751790202,
						751790204
					],
					"speakerTitle": "Zashari"
				},
				{
					"id": 751790202,
					"content": "Kamu baik-baik saja?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790203
					]
				},
				{
					"id": 751790203,
					"content": "I-Iya, aku cuma habis lari saja. Biar aku tarik napas dulu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zashari"
				},
				{
					"id": 751790204,
					"content": "Selamat istirahat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790205
					]
				},
				{
					"id": 751790205,
					"content": "Ah, terima kasih ....",
					"roleType": "TALK_ROLE_NPC",
