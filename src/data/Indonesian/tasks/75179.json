			"dialogs": [
				{
					"id": 751790701,
					"content": "Jadi Bos selamat berkat mereka bertiga?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790702
					],
					"speakerTitle": "Tizlo"
				},
				{
					"id": 751790702,
					"content": "Haha, betul! Kamu harusnya lihat aksi mereka, monsternya tumbang dalam sekejap mata!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790703
					],
					"speakerTitle": "Itzayah"
				},
				{
					"id": 751790703,
					"content": "Kalian selamatkan Bos. Ini utang budi yang tidak sanggup kubayar kembali, tapi terimalah ini sebagai tanda terima kasihku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790704
					],
					"speakerTitle": "Tizlo"
				},
				{
					"id": 751790704,
					"content": "Tizlo, kamu serius? Ternyata kamu orangnya sepelit ini ya? Kamu cuma kasih segitu ke penyelamatmu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Itzayah"
