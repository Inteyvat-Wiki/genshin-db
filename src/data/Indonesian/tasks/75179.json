			},
			"dialogs": [
				{
					"id": 751790301,
					"content": "Tentu saja, barang sekecil ini kalau dianggap imbalan menyelamatkan nyawa, rasanya agak pelit ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790302,
						751790303
					],
					"speakerTitle": "Itzayah"
				},
				{
					"id": 751790302,
					"content": "Iya, pelit banget.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790304
					]
				},
				{
					"id": 751790304,
					"content": "Haha, bagus! Aku suka orang terus terang seperti kamu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790306
					],
					"speakerTitle": "Itzayah"
				},
				{
					"id": 751790306,
					"content": "*uhuk* Singkatnya, ini hadiah dariku untuk kalian. Terimalah! Anggap sebagai uang jajan untuk Tepetlisaurus kecilmu. Tidak perlu terima kasih, tidak perlu sungkan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790307
					],
					"speakerTitle": "Itzayah"
				},
				{
					"id": 751790307,
					"content": "Nguk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790308
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751790308,
					"content": "Oke, kita masih harus cari kembali barang yang hilang di sepanjang jalan, jadi kita pergi dulu! Dadah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Itzayah"
				},
				{
					"id": 751790303,
					"content": "Tidak perlu. Ini sudah cukup.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790305
					]
				},
				{
					"id": 751790305,
					"content": "Ck, kamu ini tidak jujur ya. Tidak seru ah, nih ambil! Kalau beritanya nyebar, nanti aku dibilang pelit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790306
					],
					"speakerTitle": "Itzayah"
				}
			]
		},
