			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dainsleif"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80030201,
					"content": "O—Orang itu, apakah dia...?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030202,
					"content": "#{F#Aether}{M#Lumine}!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030203
					]
				},
				{
					"id": 80030203,
					"content": "#{F#Lumine}{M#Aether}...",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030204,
						80030205
					]
				},
				{
					"id": 80030204,
					"content": "Akhirnya aku menemukanmu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030206
					]
				},
				{
					"id": 80030206,
					"content": "Tu-tunggu, dia baru saja menahan serangan yang diarahkan ke Abyss Herald...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030207,
					"content": "#{M#Adikmu}{F#Kakakmu} dengan Abyss...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030208,
					"content": "#{F#Lumine}{M#Aether}, kenapa kamu bersama dengan Dain?",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030209,
						80030210
					]
				},
				{
					"id": 80030209,
					"content": "...Apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030211,
						80030212
					]
				},
				{
					"id": 80030211,
					"content": "(Kita sudah terpisah sekian lama...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030213
					]
				},
				{
					"id": 80030213,
					"content": "Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030214,
					"content": "#{M#Adikmu}{F#Kakakmu}... kenal dengan Dain?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030215,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030216
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030216,
					"content": "#{M#Lumine}{F#Aether}, kita bertemu lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030217
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030217,
					"content": "A-apa yang terjadi?! Dain juga tahu namanya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030218,
					"content": "Kamu sebaiknya tidak membantu pria ini.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030219
					]
				},
				{
					"id": 80030219,
					"content": "Dia adalah musuhku.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030220
					]
				},
				{
					"id": 80030220,
					"content": "#{F#Aether}{M#Lumine}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030221,
						80030222
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030221,
					"content": "Cukup!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030223
					]
				},
				{
					"id": 80030223,
					"content": "...",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030224
					]
				},
				{
					"id": 80030224,
					"content": "Tapi ini sesuatu yang harus kukatakan. Jangan coba-coba menghentikanku. Jangan coba-coba menghentikan Abyss.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030225
					]
				},
				{
					"id": 80030225,
					"content": "Orang itu... Dainsleif, adalah sang \"Twilight Sword\", salah satu penjaga dinasti terakhir Khaenri'ah. Lima ratus tahun yang lalu, dia gagal menghentikan kehancuran Khaenri'ah.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030226
					]
				},
				{
					"id": 80030226,
					"content": "Tubuhnya telah dikutuk dengan hidup abadi untuk mengembara alam liar selamanya... sembari melihat orang-orang yang seharusnya dia lindungi berubah menjadi monster Abyss.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030227
					]
				},
				{
					"id": 80030227,
					"content": "Maksudmu... Dain adalah orang Khaenri'ah?! Khaenri'ah yang sudah hancur lima ratus tahun lalu itu?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030228,
					"content": "Lalu kamu bilang orang-orang tersebut berubah menjadi monster... jadi maksudmu Abyss Order tidak hanya berhubungan dengan Khaenri'ah, melainkan adalah rakyat Khaenri'ah itu sendiri?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030229,
					"content": "Uhh... lalu soal Dain yang ternyata musuhmu? Duh, Paimon bingung sekali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030230,
						80030231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030230,
					"content": "#Kita pergi dulu saja, {F#Aether}{M#Lumine}! Ayo kita pulang!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030232
					]
				},
				{
					"id": 80030232,
					"content": "Rumah...",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030233
					]
				},
				{
					"id": 80030233,
					"content": "Ya, tentu saja, rumah adalah tempat di mana kita bersama.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030234
					]
				},
				{
					"id": 80030234,
					"content": "Tapi aku belum bisa pergi bersamamu ke dunia selanjutnya untuk mencari rumah baru... setidaknya, tidak sekarang.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030235
					]
				},
				{
					"id": 80030235,
					"content": "Selama Abyss belum merebut takhta para dewa, maka pertarunganku dengan takdir masih belum berakhir...",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030236
					]
				},
				{
					"id": 80030236,
					"content": "Takdir...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030237
					]
				},
				{
					"id": 80030237,
					"content": "#Dengarkan aku, {F#Lumine}{M#Aether}.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030238
					]
				},
				{
					"id": 80030238,
					"content": "Aku telah menjelajahi dunia ini. Saat kamu juga mencapai ujung perjalananmu sepertiku, maka kamu juga akan melihat kebenaran dunia ini dengan mata kepalamu sendiri.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": []
				},
				{
					"id": 80030231,
					"content": "Hal ini nanti saja kamu ceritakan padaku, kita pulang dulu ke rumah!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030232
					]
				},
				{
					"id": 80030222,
					"content": "#Jangan mengatakan hal-hal yang tidak kumengerti, {M#Lumine}{F#Aether}!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030223
					]
				},
				{
					"id": 80030212,
					"content": "(Kenapa dia bertanya seusatu... yang sangat tidak relevan?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030213
					]
				},
				{
					"id": 80030210,
					"content": "Kamu bertanya soal... Dain?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030211,
						80030212
					]
				},
				{
					"id": 80030205,
					"content": "Ayo kita pergi! Di sini bahaya sekali!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030206
					]
				}
			]
		},
		{
			"id": 800303,
			"completionStepIds": [
				800307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
