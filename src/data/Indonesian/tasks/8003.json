			"dialogs": [
				{
					"id": 80030501,
					"content": "Sepertinya kita sudah sampai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030502
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030502,
					"content": "Sebuah ruangan yang aneh dan terasa ngeri. Kini aku mengerti aura jahat yang kalian ceritakan tadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030503
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030503,
					"content": "Huuuu... Tempat ini seram banget...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030504,
					"content": "Hati-hati, jangan sampai termakan oleh kekuatan jahat dari Patung Ternoda ini — Abyss Herald ada di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030505
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030505,
					"content": "Muahahaha... Indramu cukup tajam...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030506
					],
					"speakerTitle": "Abyss Herald"
				},
				{
					"id": 80030506,
					"content": "Kamu masih sama saja menyebalkannya ya, Dansleif, musuh bebuyutan Abyss Order!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030507
					],
					"speakerTitle": "Abyss Herald"
				},
				{
					"id": 80030507,
					"content": "Aku bisa merasakannya, tubuhmu dipenuhi dengan bau pertumpahan darah. Apakah berasal dari mimpi terburukmu? Atau...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030508
					],
					"speakerTitle": "Abyss Herald"
				},
				{
					"id": 80030508,
					"content": "Oh, dan sesuatu yang sangat berbahaya! Aku juga mencium bau \"busuk\" yang sangat familier...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030509
					],
					"speakerTitle": "Abyss Herald"
				},
				{
					"id": 80030509,
					"content": "Kita berdua sebenarnya sama saja, sama-sama makhluk berbahaya. Tapi makhluk berbahaya yang berada di luar Abyss Order harus segera ditangkap dan dikurung...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030510
					],
					"speakerTitle": "Abyss Herald"
				},
				{
					"id": 80030510,
					"content": "Ckck.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030511
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030511,
					"content": "Sepertinya yang berbau \"busuk\" itu lidahmu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030512
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030512,
					"content": "Saatnya aku membungkam mulutmu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				}
			]
		},
