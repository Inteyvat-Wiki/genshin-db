					"nextDialogs": [
						80030402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030402,
					"content": "Lucu juga ya... Waktu itu kita sudah susah payah kabur dari sini, sekarang malah masuk lagi ke sini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030403
