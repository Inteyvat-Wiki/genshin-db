			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dainsleif"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80030301,
					"content": "Ini kan? Baiklah, ayo gunakan Elemental Sight untuk mencari matanya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030302,
					"content": "Hoooo... Jadi, apa yang kamu lihat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030303,
					"content": "Eh? Tidak ada apa-apa? Padahal Paimon sudah semangat sekali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030304,
					"content": "Kenapa ya... Kamu yakin caranya sudah benar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030305,
					"content": "Ini membutuhkan cara yang sedikit berbeda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030306
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030306,
					"content": "Menggunakan Elemental Sight pada Field Tiller tidak berguna karena dia tidak menggunakan tenaga elemen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030307
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030307,
					"content": "Biar kucoba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030308
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030308,
					"content": "...selesai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030309
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030309,
					"content": "Wuaaaaaw! I-ini kan...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030310,
					"content": "Benda yang selama ini dicari-cari oleh Abyss Herald — mata dari Field Tiller pertama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030311
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030311,
					"content": "Semua Ruin Guard yang ada sekarang hanyalah replika dari mesin ini. Sebagai model prototipe, kemampuan tempurnya tidak terbatas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030312
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030312,
					"content": "Prototipe?... Apa itu? Apa itu istilah khusus dari Khaenri'ah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030313,
					"content": "Sama dengan yang dipikirkan Abyss Order, kalau sampai \"mata\" ini diletakkan di tangan Patung Ternoda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030314
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030314,
					"content": "Dan jika patung itu digabungkan dengan Osial, Overlord of the Vortex, maka terciptalah seorang dewa mekanis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030315
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030315,
					"content": "Dan dengan begitu lahirlah sesosok dewa baru dengan sebuah kekuatan yang sanggup untuk \"menggulingkan takhta para dewa Celestia\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030316,
						80030317
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030316,
					"content": "Tindakan mereka benar-benar berbahaya...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030318
					]
				},
				{
					"id": 80030318,
					"content": "Benar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030319
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030319,
					"content": "Ka-Kalau begitu... Mata ini harus kita apakan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030320,
						80030321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030320,
					"content": "Kita sembunyikan dulu di suatu tempat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030322
					]
				},
				{
					"id": 80030322,
					"content": "Jangan, biar aku yang menjaganya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030323
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030323,
					"content": "Eh?! Kamu sendiri!? Dain... Kamu tidak berencana melakukan sesuatu yang gila kan...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030324,
					"content": "Kamu boleh saja meragukanku, tapi aku harus menjamin benda ini tidak jatuh ke tangan yang salah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030325
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030325,
					"content": "Mereka pasti akan menemukannya di mana pun kita menyembunyikannya. Kalau Church of Favonius... Kalian juga tahu aku tidak memercayai mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030326
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030326,
					"content": "Eh—heh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030327,
					"content": "Tapi tugas kita belum selesai. Kita masih harus \"membereskan\" Patung Ternoda itu untuk menghindari munculnya masalah lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030328,
						80030329
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030328,
					"content": "Bagaimana caranya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030330
					]
				},
				{
					"id": 80030330,
					"content": "Kita tidak boleh melibatkan mereka, biar kita yang urus sendiri. Sudah jelas kalau maksudku dari \"membereskan\" adalah menghancurkannya secara total.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030331
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030331,
					"content": "Me-menghancurkannya? Itu Patung The Seven! Itu adalah relik budaya yang penting sekali, itu cukup suci loh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030332
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030332,
					"content": "Fuhh, untung kita tidak memberi tahu hal ini ke Barbara tadi. Dia pasti marah besar kalau sampai tahu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030333
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030333,
					"content": "Huh... Apa para dewa The Seven benar-benar mengira aku akan membantu mereka menjaga barang milik mereka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030334
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030334,
					"content": "Ayo kita kembali ke <color=#00E1FFFF>reruntuhan</color> dan hancurkan patung terbalik itu. Kalau kita beruntung, mungkin kita bisa bertemu dengan Abyss Herald itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030335
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030335,
					"content": "Akan kujamin dia tidak bisa kabur kali ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030329,
					"content": "Tidak bisa kita serahkan ke Church of Favonius saja?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030330
					]
				},
				{
					"id": 80030321,
					"content": "Serahkan ke Church of Favonius untuk menjaganya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030322
					]
				},
				{
					"id": 80030317,
					"content": "Abyss Order harus segera dihentikan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030318
					]
				}
			]
		},
