					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80030601,
					"content": "Mereka sudah pergi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030602,
					"content": "Oh, jangan sedih... kita akan menemukan mereka lagi! Lihat positifnya saja, setidaknya kita berhasil mendapat beberapa petunjuk yang berguna!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030603,
						80030605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030603,
					"content": "Aku... tidak sedih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030604
					]
				},
				{
					"id": 80030604,
					"content": "Eh? Benarkah...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030607,
					"content": "Setidaknya sekarang kita tahu bahwa selain The Seven, Dain juga berperan penting untuk menemukan saudaramu kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030608,
						80030609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030608,
					"content": "Kita harus mencari petunjuk lain setelah sampai di Inazuma.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030610
					]
				},
				{
					"id": 80030610,
					"content": "Betul! Oh iya, ngomong-ngomong, ucapan mereka tadi sangat sulit dimengerti ya... apa kamu mengerti maksudnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030611,
						80030612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030611,
					"content": "Lumayan mengerti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030613
					]
				},
				{
					"id": 80030613,
					"content": "Oh, kalau begitu coba kita reka ulang ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030614,
					"content": "#Pertama-tama, Abyss Herald itu memanggil {F#kakakmu dengan panggilan \"Pangeran\"}{M#adikmu dengan panggilan \"Tuan Putri\"}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030615,
					"content": "#Sepertinya {F#kakakmu}{M#adikmu} adalah pemimpin Abyss Order, bahkan Abyss Herald pun patuh padanya... Yah, tapi kita masih belum tahu apakah dia pemimpin tertinggi di sana atau bukan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030616
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030616,
					"content": "#Lalu {F#kakakmu}{M#adikmu} juga bilang kalau dia berencana \"mengambil alih takhta, bertarung dengan takdir\". Apa sih maksudnya? Jangan-jangan... dia mau membasmi The Seven dan ketujuh bangsa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030617
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030617,
					"content": "Yang lebih mengejutkan lagi, ternyata para monster Abyss Order adalah penduduk Khaenri'ah yang berubah setelah Khaenri'ah hancur. Benar-benar cerita yang seram!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030618,
					"content": "Dan ternyata Dain juga berasal dari Khaenri'ah, dia bahkan menyaksikan kehancuran bangsanya lima ratus tahun lalu. Tapi... dia tidak berubah menjadi monster, dia malah bertarung melawan Abyss Order sekarang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030619
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030619,
					"content": "#Jadi itu alasan {F#kakakmu}{M#adikmu} bilang bahwa \"Dain adalah musuhku\", kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030620,
					"content": "Tapi, kalau monster-monster Abyss adalah orang-orang yang dulu Dain lindungi, kenapa sekarang dia malah bermusuhan dengan mereka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030621
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030621,
					"content": "Lalu kenapa... setelah sekian lama kita mencari saudaramu ternyata dia malah memihak Abyss? Ada apa dengan itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030622,
						80030623
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030622,
					"content": "Banyak pertanyaan baru, tapi tidak ada jawaban.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030624
					]
				},
				{
					"id": 80030624,
					"content": "Ya, benar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030625
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030625,
					"content": "Kalau begitu... kita tidak boleh membiarkan hal tersebut membuat kita bersedih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030626
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030626,
					"content": "Perjalanan kita masih belum berakhir, ayo kita berangkat! Waktunya pergi dari tempat yang suram ini dan kembali ke luar, di mana matahari bersinar terang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030627
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030627,
					"content": "#Kalau {M#adikmu}{F#kakakmu} ingin kamu mencapai \"akhir perjalananmu\"... baiklah, ayo kita pergi dan perlihatkan padanya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030628
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030628,
					"content": "Ayo Pengembara, kita berangkat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030623,
					"content": "Terus memikirkannya hanya akan membuang waktu saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030624
					]
				},
				{
					"id": 80030612,
					"content": "#Aku terlalu fokus pada {M#adik perempuanku}{F#kakak laki-lakiku}. Aku tidak mendengarnya dengan cermat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030613
					]
				},
				{
					"id": 80030609,
					"content": "Kita punya tujuan baru lagi untuk perjalanan kita.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030610
					]
				},
				{
					"id": 80030605,
					"content": "Kamu benar, Paimon. Masih ada harapan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030606
					]
				},
				{
					"id": 80030606,
					"content": "Iya, betul!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030607
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}