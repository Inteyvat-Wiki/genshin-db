			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dainsleif"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80030101,
					"content": "Dain, ternyata kamu di sini. Apa kamu lihat Master Jean?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030102,
					"content": "Aku melihatnya, tapi aku menghindarinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030103
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030103,
					"content": "Sebagai Lionfang Knight dan Acting Grand Master, dia pastinya agak keberatan dengan adanya diriku di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030104
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030104,
					"content": "Jika aku tidak berhati-hati, suatu hari mungkin saja aku menjadi salah satu objek investigasinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030105
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030105,
					"content": "Tapi kembali ke permasalahan kita... Aku mengalahkan beberapa pasukan Abyss tapi tidak berhasil mendapatkan informasi apa pun. Bagaimana denganmu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030106
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030106,
					"content": "Jadi begitu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030107
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030107,
					"content": "Baiklah. Minimal kita sudah bisa menarik kesimpulan di mana Field Tiller pertama ini berakhir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030108
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030108,
					"content": "Eh? Benarkah? Cuma berdasarkan dari cerita Lupus Boreas saja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030109,
					"content": "Informasi tersebut ditambah dengan beberapa analisis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030110
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030110,
					"content": "Contohnya, \"cerita lama\" yang kamu dengar di Katedral...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030111
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030111,
					"content": "\"Amarah Terakhir sang Tiran\"!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030112
					]
				},
				{
					"id": 80030112,
					"content": "Benar, cerita aneh yang suster itu katakan padamu, mereka menganggapnya sebagai kutukan oleh tiran terdahulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030113,
						80030114,
						80030126
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030113,
					"content": "Bola api turun dari langit itu mungkin misil...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030115
					]
				},
				{
					"id": 80030115,
					"content": "Ah, Paimon mengerti! Jadi \"Amarah Terakhir sang Tiran\" adalah misil yang ditembakkan Field Tiller setelah lari dari Wolvendom!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030116,
					"content": "Sepertinya dia rusak setelah bertarung dengan Wolf of the North, kemudian dia pasti berkeliaran sampai ke wilayah Mondstadt Tua dan berdiam di situ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030117,
					"content": "Jika ada yang berani mendekatinya —— PIU, PIU, BUM! Langsung ditembaki misil... Hingga suatu hari dia rusak total dan bola-bola api itu berhenti berjatuhan deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030118,
					"content": "Dulu orang-orang Mondstadt jarang melihat Ruin Guard, makanya mereka menyebutnya dengan julukan \"Amarah Terakhir sang Tiran\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030119,
					"content": "Sepertinya kita harus pergi ke tempat yang sekarang disebut sebagai <color=#00E1FFFF>Stormterror's Lair</color>, dan mulai mencarinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030120,
						80030121
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030120,
					"content": "Tidak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030122
					]
				},
				{
					"id": 80030122,
					"content": "Hmm? Maksudmu...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030123
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030123,
					"content": "Aku... Aku ingat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030124
					]
				},
				{
					"id": 80030124,
					"content": "Eh? Kamu ingat...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030125,
					"content": "Oh! Paimon juga ingat! Kita pernah melihat <color=#00E1FFFF>Ruin Guard yang duduk di atas menara </color> itu saat kita ke sana! Benar-benar mengesankan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030121,
					"content": "Tidak perlu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030122
					]
				},
				{
					"id": 80030114,
					"content": "Orang-orang Mondstadt zaman dahulu masih belum mengerti bola api seperti ini...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030115
					]
				},
				{
					"id": 80030126,
					"content": "Sebenarnya Barbara adalah seorang suster...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030115
					]
				}
			]
		},
		{
			"id": 800302,
