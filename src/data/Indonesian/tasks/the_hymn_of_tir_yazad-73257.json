						732572902
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732572902,
					"content": "Segampang itu? Kalian ngomong ritual, ritual mulu, Paimon kira bakal ada mantra atau jampi-jampi apa gitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732572903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732572903,
					"content": "Ha, hanya manusia yang perlu seperti itu, karena tidak bisa mengendalikan kekuatan elemen tanpa bantuan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732572904
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732572904,
					"content": "Kaum Pari berbeda. Kekuatan kami dan Khvarena berasal dari sumber yang sama. Kalau diumpamakan, seperti bagaimana kalian manusia tidak perlu merapal mantra untuk berjalan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732572905
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732572905,
					"content": "Oh ... tapi kamu tidak jalan sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732572906
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732572906,
