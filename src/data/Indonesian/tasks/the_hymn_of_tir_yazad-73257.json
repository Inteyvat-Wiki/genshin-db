				},
				{
					"id": 732571402,
					"content": "Sekarang lakukan Ritual Chinvat. Sebelum pencemaran meluap kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732571403
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732571403,
					"content": "Setelahnya, tugas kita selesai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732571404
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732571404,
					"content": "Lalu ... Bisa tidur dengan tenang ... tidak ada yang ganggu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732571405
					],
					"speakerTitle": "Rashnu"
