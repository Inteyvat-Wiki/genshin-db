					"nextDialogs": [
						732571703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732571703,
					"content": "Ah, jangan lihat aku. Aku juga tidak tahu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732571704
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732571704,
					"content": "Sorush sudah mengenakan Twin-Horned Chaplet, sekarang dia dapat terhubung dengan ingatan dan kebijaksanaan Harvisptokhm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732571705
