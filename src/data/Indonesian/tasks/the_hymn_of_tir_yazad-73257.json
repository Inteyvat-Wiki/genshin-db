					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732573002,
					"content": "Pohon-pohon ini sejak awal dibudidayakan dengan Khvarena, agar kuat menahan kikisan bencana dulu. Tapi kekuatannya sudah berkurang seiring berlalunya waktu.",
					"roleType": "TALK_ROLE_NPC",
