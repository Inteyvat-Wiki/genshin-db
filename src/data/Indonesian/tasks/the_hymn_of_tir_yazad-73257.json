			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zurvan"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							390.447,
							312.914,
							5703.516
						],
						"pointId": 4535
					}
				]
			},
			"dialogs": [
				{
					"id": 732570201,
					"content": "Zurvan, kami kembali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570202,
					"content": "#Ah, {NICKNAME}, Sorush, Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570203
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570203,
					"content": "Sepertinya kalian berhasil mengumpulkan Lagu Agung Khvarena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570204,
						732570205
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570204,
					"content": "Biarpun ketemu beberapa masalah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570206
					]
				},
				{
					"id": 732570206,
					"content": "Tidak apa, yang penting hasilnya memuaskan. Benar keputusanku memercayakannya kepada kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570207
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570207,
					"content": "Tanpa kalian, Lagu Agung Khvarena mungkin sudah dirampas oleh orang-orang berniat jahat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570208
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570208,
					"content": "Ha, kok kayaknya ... Zurvan sudah tahu duluan ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570209,
					"content": "Hehe, ternyata betul gitu ya! Kalian ketemu sama pengikut kegelapan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570210,
						732570212
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570210,
					"content": "Kok bisa tahu???",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570211
					]
				},
				{
					"id": 732570211,
					"content": "Itu ... Sudah, daripada bahas kenapa aku bisa tahu, mending kalian cerita saja detailnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570214
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570214,
					"content": "Kalian menceritakan petualangan di reruntuhan bawah tanah dan pengkhianatan Nasejuna kepada Zurvan.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732570215
					]
				},
				{
					"id": 732570215,
					"content": "Hehe, bahkan Vijnanapati Orde Pembenaran pun membelot ke pihak kegelapan. Di luar dugaan. Bukan berarti aku mengharap sesuatu dari mereka ya, cuma kali ini lumayan keterlaluan juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570216
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570216,
					"content": "Nasejuna digoda untuk mengejar Lagu Agung Khvarena oleh pengikut kegelapan yang kalian lawan, betul? Aku sudah lama kenal dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570217
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570217,
					"content": "Ha? Kamu kenal sama anggota Abyss Order?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570218,
					"content": "Ha, dia tadinya anggota Orde Pembenaran. Beberapa ratus tahun lalu, ada satu regu penyelidik yang datang dari hutan. Mereka kemari untuk mempelajari rahasia Dahri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570219
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570219,
					"content": "Mereka memaksa masuk ke reruntuhan Dahri meskipun sudah diperingati berulang kali oleh Orde. Vijnanapati yang menjabat ketika itu akhirnya mengutus satu orang untuk ikut mereka, jaga-jaga bila terjadi sesuatu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570220
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570220,
					"content": "Tidak ada yang tahu apa yang mereka temui di dalam reruntuhan, tapi ketika dia kembali, dia sudah merangkul kekuatan pencemaran, dan regu penyelidik itu tidak diketahui lagi kabarnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570221
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570221,
					"content": "Lalu para pengikut kegelapan datang. Mereka mengejar Lagu Agung Khvarena, dan memanggil banyak sekali Dev untuk menyerang Oasis Vourukasha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570222
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570222,
					"content": "Kami memang berhasil mempertahankan tempat ini berkat kerja sama antara Pari dan manusia, tapi pengikut kegelapan itu gagal kami binasakan seluruhnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570223
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570223,
					"content": "Supaya tidak ada celah yang sekiranya bisa mereka manfaatkan, aku mengunci Oasis Vourukasha dan banyak reruntuhan lain menggunakan kekuatan Lagu Agung Khvarena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570224
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570224,
					"content": "Orde Pembenaran tidak pernah bangkit lagi selepas peristiwa itu. Kitab-kitab kuno mereka habis dilalap api, dan akhirnya mereka menjadi seperti sekarang ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570225
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570225,
					"content": "Aku sudah curiga kalau mereka sedang bergerak diam-diam waktu terakhir kita ketemu. Tapi tidak kusangka mereka bahkan sudah berhasil menyesatkan pemimpin Orde Pembenaran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570226
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570226,
					"content": "Paimon masih penasaran sama omongan si Nasejuna. Zurvan tahu apa tidak soal nenek moyangnya Orde Pembenaran?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570227,
					"content": "Kalian kan pernah berjuang bersama.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570228
					]
				},
				{
					"id": 732570228,
					"content": "Hehe, sejarah menjadi legenda, legenda menjadi dongeng. Begitulah jalannya tradisi. Melupakan, juga adalah bagian dari kisah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570229
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570229,
					"content": "Semakin kamu memegang teguh tradisi, semakin pula kamu menyeleksi kisah mana yang diingat, dan mana yang dilupakan. Pada akhirnya, semuanya hilang di labirin cerita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570230
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570230,
					"content": "Dalam dunia yang melupakan sesuatu setiap hari dan setiap saat, apa yang kita ukirkan di permukaan tanah, lebih bisa bertahan dibandingkan dengan apa yang kita nyanyikan kepada angin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570231
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570231,
					"content": "Itulah kenapa aku percaya pada kalian. Kalian jujur, dan tidak ambil pusing dengan pendapat atau pun penghakiman dari orang lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570232
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570232,
					"content": "Kita dipuji, tapi kok dengernya malah aneh ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570233,
					"content": "Soalnya mujinya enggak tulus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570234
					]
				},
				{
					"id": 732570234,
					"content": "Yang dikatakan Tetua Zurvan itu ... untuk aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570235
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570235,
					"content": "Sedangkan untuk peristiwa yang terjadi lima ratus tahun silam, kurasa daripada dengar cerita versiku, lebih baik langsung lihat sendiri saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570236
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570236,
					"content": "Kebetulan sekarang ada kesempatan untuk itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570237
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570237,
					"content": "Sorush, kamu sudah tumbuh jadi sosok yang lebih bisa diandalkan. Setelah melalui semua itu, apa kamu sudah terbangun dari mimpi dongeng kosong buatan manusia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570238
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570238,
					"content": "Tetua! Tolonglah, jangan diungkit terus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570239
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570239,
					"content": "#Sepertinya aku tidak salah mempercayakan urusan ini ke {NICKNAME} dan Paimon. Baiklah, Upacara Ab-Zohr juga kalian yang urus ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570240
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570240,
					"content": "Upacara Ab-Zohr ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570241
					]
				},
				{
					"id": 732570241,
					"content": "Paimon ingat Zurvan pernah sebut itu! Eh, fungsinya buat ... bersihin pencemaran? Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570242
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570242,
					"content": "Upacara Ab-Zohr adalah ritual untuk menyucikan Harvisptokhm. Biasanya, kamu tinggal lakukan upacaranya di bawah pohon yang menghalangi kegelapan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570243
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570243,
					"content": "Namun, karena segelnya melemah dan tanda itu muncul lagi di langit, kali ini kita harus lakukan sesuatu yang di luar kebiasaan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570244
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570244,
					"content": "Tanda itu muncul di atas Harvisptokhm karena pohon itu telah menghisap banyak sekali pencemaran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570245
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570245,
					"content": "Karena begitu banyak pencemaran yang bersarang di dalamnya, ditambah lagi pengaruh kikisan dari tanda, Harvisptokhm sudah tidak kuat lagi menampung kekuatan Khvarena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570246
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570246,
					"content": "Sekarang kita mau tidak mau harus masuk ke Harvisptokhm dan bersihkan dia dari dalam, sekaligus membangunkan dewa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570247
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570247,
					"content": "Kita bisa masuk ke Harvisptokhm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570248
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570248,
					"content": "Tentu saja. Kamu kira Ritual Chinvat itu dilakukan di mana? Bahkan kaum Pari saja tidak kuat menahan pencemaran yang ada di dalam lubang itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570249
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570249,
					"content": "Di dalam Harvisptokhm ada teratai raksasa, Gaokerena. Kesadaran dewa kami tertidur di dalamnya. Dengan membersihkan pencemaran, Bunga Suci Murni akan kembali mekar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570250
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570250,
					"content": "Amrita akan menyucikan tanah ini dari segala pencemaran. Prosedurnya memang terdengar rumit, tapi kurasa bukan masalah buat kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570251
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570251,
					"content": "Nah, aku sudah mengirim Rashnu dan Mihir ke Lubang Tunigi. Bawa Lagu Agung ke sana, dan kumpulkan kekuatan Khvarena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570252
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570252,
					"content": "Khvarena akan membangkitkan pohon besar yang menahan kegelapan, lalu membersihkan lumpur yang ada di dalam. Setelah itu, lakukan Ritual Chinvat, dan buka jalan menuju Harvisptokhm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570253
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570253,
					"content": "Setelah sampai di dalam, Chaplet akan memberi tahu Sorush tentang perbuatan dan jasa para pahlawan zaman dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570254
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570254,
					"content": "Karena semua ingatan yang menyangkut Khvarena pada akhirnya akan kembali ke Harvisptokhm, tidak peduli bagaimana legenda diceritakan kembali dan berubah seiring berjalannya waktu, ingatan itu akan kekal dan abadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570255
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570255,
					"content": "Aku belum pernah dengar sama sekali soal ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570256
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570256,
					"content": "Hehe, Chaplet itu aslinya bagian dari Harvisptokhm. Kamu akan tahu kalau sudah di sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570257
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570257,
					"content": "Nah, sekarang pergilah dan padamkan Tanda Apaosha. Kita akan kembali bertemu ketika Amrita turun dari langit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570212,
					"content": "Iya, betul.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570213
					]
				},
				{
					"id": 732570213,
					"content": "Oh, bisa ceritakan bagaimana detailnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570214
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570205,
					"content": "Capeknya minta ampun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570206
					]
				}
			]
		},
		{
			"id": 7325704,
