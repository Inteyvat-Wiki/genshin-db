			},
			"dialogs": [
				{
					"id": 732570401,
					"content": "Sorush ... lama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570402
					],
					"speakerTitle": "Rashnu"
				},
				{
					"id": 732570402,
					"content": "Kami sudah tunggu lama sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570403
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732570403,
					"content": "Lelahnya ... Pulang ... Tidur ... *zzz*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570404
					],
					"speakerTitle": "Rashnu"
				},
				{
					"id": 732570404,
					"content": "Kurang ajar, dari tadi juga aku yang kerja keras. Kalian cuma nongkrong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570405
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570405,
					"content": "Salah. Menunggu juga pekerjaan penting. Tindakan hanya sekejap, menunggu itu abadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570406
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732570406,
					"content": "Itu... logikanya gimana sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570407,
					"content": "Begitulah falsafah kaum Pari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570408
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732570408,
					"content": "Tapi sekarang bukan waktunya bicara falsafah. Lagu Agung Khvarena, kalian sudah berhasil kumpulkan semuanya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570409
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732570409,
					"content": "Sudah dong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570410,
					"content": "Baiklah, sekarang kita buka segelnya. Setelah itu, kalian bisa pakai Lagu Agung untuk kumpulkan kekuatan Khvarena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570411
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732570411,
					"content": "Hati-hatilah. Pencemaran ini sudah menumpuk selama sekian abad, aku tidak tahu apa yang akan muncul begitu segelnya terbuka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mihir"
				}
			]
		},
