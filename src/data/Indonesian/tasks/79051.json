			"dialogs": [
				{
					"id": 790510101,
					"content": "Di sini ada buku harian, kayaknya masih terawat dengan baik deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510102
					],
					"speakerTitle": "Baca"
				},
				{
					"id": 790510102,
					"content": "*huff* ... lega rasanya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510103
					],
					"speakerTitle": "Baca"
				},
				{
					"id": 790510103,
					"content": "Ikatan emosi si pelukis itu sudah terlepas dan dia berhasil mengembangkan teknik melukisnya juga. Paimon rasa dia pasti bakal sukses!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510104
					],
					"speakerTitle": "Baca"
				},
				{
					"id": 790510104,
					"content": "Tapi pada akhirnya dia meninggalkan teman-teman Tetesan Air-nya ... Paimon jadi sedikit sedih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510105,
						790510106
					],
					"speakerTitle": "Baca"
				},
				{
					"id": 790510105,
					"content": "Tidak semua seniman bisa menerima imitasi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790510107
					]
				},
				{
					"id": 790510107,
					"content": "Iya, Paimon ngerti sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510108
					],
					"speakerTitle": "Baca"
				},
				{
					"id": 790510108,
					"content": "Masih ada satu yang bikin Paimon bingung. Dia bilang di buku hariannya kalau mural itu bisa kehilangan bentuk dan wujudnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510109
					],
					"speakerTitle": "Baca"
				},
				{
					"id": 790510109,
					"content": "Tapi habis kecelakaan parah gitu ... muralnya kelihatan masih bagus aja tuh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510110,
						790510111
					],
					"speakerTitle": "Baca"
				},
				{
					"id": 790510110,
					"content": "Kuncinya ada di para Tetesan Air ini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790510112
					]
				},
				{
					"id": 790510112,
					"content": "Oh gitu! Pantesan para Tetesan Air ini ngerti banget sama perbaikan mural dan Proyektor Penyiaran-nya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510113
					],
					"speakerTitle": "Baca"
				},
				{
					"id": 790510113,
					"content": "*hiks* ... Paimon terharu deh. Meski si Tetesan Air kelihatannya enggak begitu pintar, tapi perhatian banget, setia. Teman sejati deh....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Baca"
				},
				{
					"id": 790510111,
					"content": "Mereka melindungi mural temannya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790510112
					]
				},
				{
					"id": 790510106,
					"content": "Mempertahankan keunikan diri sendiri juga logis kok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790510107
					]
				}
			]
		},
