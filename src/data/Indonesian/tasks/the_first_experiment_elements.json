			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110420301,
					"content": "Bagus sekali, apa kamu merasakan sesuatu yang berbeda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420302
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420302,
					"content": "Kalau kamu terluka, aku mempunyai beberapa obat di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420303,
						110420304
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420303,
					"content": "Jangan khawatir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420305
					]
				},
				{
					"id": 110420305,
					"content": "Baguslah kalau begitu. Menurut pengamatanku, arus kekuatan elemental eksternalmu lancar, reaksi elemental juga normal, tidak ada yang aneh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420306
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420306,
					"content": "Setelah memastikan arus kekuatan elemental eksternalmu normal, sekarang coba kita tes arus internal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420307
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420307,
					"content": "Arus internal... bagaimana caramu mengujinya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420308,
					"content": "Sangat mudah, aku akan menggunakan alkimia untuk menciptakan potion yang bisa meng-ekstrak kekuatan elemental.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420309
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420309,
					"content": "Jika kekuatan elementalmu tersimpan atau terkumpul di dalam tubuhmu, maka potion ini akan memicu reaksi elemental.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420310,
						110420311
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420310,
					"content": "Akankah ada reaksi Swirl dalam perutku?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420312
					]
				},
				{
					"id": 110420312,
					"content": "Ke-kedengarannya seram sekali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420313,
					"content": "Jangan khawatir, kalau semuanya berjalan normal, kamu hanya akan merasakan mual yang bersifat sementara, namun tidak berbahaya bagi tubuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420314
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420314,
					"content": "Terus kalau tidak normal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420315,
					"content": "Jika terjadi sesuatu yang tidak terduga, aku telah mempersiapkan segala yang diperlukan, jadi tenang saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420316
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420316,
					"content": "Masih tidak terlalu meyakinkan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420317
					]
				},
				{
					"id": 110420317,
					"content": "Bukannya tidak ada risiko sih, tapi kalau memang ada kendala dalam arus elemental di tubuhmu, kita dapat menyadarinya melalui tes ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420318
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420318,
					"content": "Hanya peringatan, kalau reaksi elemental internal terjadi karena hal yang tidak diduga, itu pertanda buruk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420319
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420319,
					"content": "Semacam pemeriksaan kesehatan ya...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420320
					]
				},
				{
					"id": 110420320,
					"content": "Betul! Cara pikirmu tepat sekali. Sebelum kita mulai, potion yang akan kita gunakan untuk tes masih membutuhkan katalisator, kita harus menemukannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420321
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420321,
					"content": "Kita perlu mencari bijih yang dikenal sebagai Starsilver, tapi sayangnya tidak semua bijih ini cocok dijadikan sebagai katalisator.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420322
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420322,
					"content": "Aku akan membawamu ke perkemahanku, sekaligus mengumpulkan beberapa Starsilver dalam perjalanan kita. Kalau ada yang cocok, aku akan memberi tahumu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420323
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420323,
					"content": "Kalau semua berjalan lancar, kita bisa langsung meracik potionnya begitu tiba di perkemahan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420324
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420324,
					"content": "Paimon masih mengkhawatirkan beberapa masalah keamanan, tapi sepertinya ada baiknya juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420325,
					"content": "Ayo kita mulai pencariannya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420311,
					"content": "Akankah ada reaksi Crystallize dalam perutku?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420312
					]
				},
				{
					"id": 110420304,
					"content": "Hanya sedikit kedinginan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420305
					]
				}
			]
		},
		{
			"id": 1104205,
			"completionStepIds": [
				1104205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104205",
							"2"
						],
						"stepId": 1104205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110420501,
					"content": "Di sini adalah perkemahanku. Aku telah menambahkan bahan-bahan yang kita kumpulkan ke dalam potion tersebut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420502
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420502,
					"content": "Sambil menunggu, coba lihat ke sini dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420503
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420503,
					"content": "Ini adalah asistenku, Timaeus, dia membantu penelitianku di sini. Kurasa kalian mungkin sudah pernah bertemu di Mondstadt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420504
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420504,
					"content": "Halo, aku baru saja mendapatkan data eksperimenmu, laporannya sudah ada di papan sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420505
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420505,
					"content": "Wow! Lihat semua data ini! Kamu mendapatkan semua hasil ini dari satu pertempuran dengan Slime?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420506,
					"content": "Haha, ini masih belum bisa disebut sebagai hasil. Ini hanya beberapa kesimpulan dan tebakan saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420507
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420507,
					"content": "Kurasa arah yang paling rasional adalah menjelaskan hubungan filogenetik antara Pengembara dan Slime.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420508,
						110420509
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420508,
					"content": "Rasional?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420510
					]
				},
				{
					"id": 110420510,
					"content": "Coba pikirkan baik-baik, kamu tidak punya Vision, tapi kamu dapat memanipulasi elemen. Slime juga tidak punya Vision, dan mereka juga, bisa memanipulasi elemen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420511
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420511,
					"content": "Dengan alur pemikiran seperti ini, kita pasti akan mendapatkan lebih banyak data yang mendukung faktanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420512
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420512,
					"content": "Cukup bagus untuk ide pertama, tapi sebenarnya, Slime adalah makhluk elemental. Dengan kata lain, makhluk yang keseluruhannya terwujud dari unsur elemen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420513
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420513,
					"content": "Cryo Regisvine, atau bahkan Whopperflower mungkin merupakan analogi yang lebih baik. Tetapi untuk menelusuri kembali hubungan filogenetik antara tumbuhan dan hewan... mungkin kamu harus menelusuri kembali asal dunia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420514
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420514,
					"content": "Dan dengan perspektif ini, mungkin akan terlalu sulit, bukankah begitu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420515
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420515,
					"content": "Uh! betul. Kedengarannya demikian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420516
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420516,
					"content": "Apa lagi, kita sudah mendapatkan data primernya. Pengembara ini adalah pengunjung dari dunia lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420517
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420517,
					"content": "Jika ternyata dia memang memiliki hubungan filogenetik dengan dunia ini... Tidak terlalu masuk akal, bukan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420518
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420518,
					"content": "Ahhh, benar juga! Maaf, aku terlalu bersemangat untuk mendapatkan data. Lain kali aku tidak akan terburu-buru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420519
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420519,
					"content": "Ngomong-ngomong soal data, diperlukan lebih banyak data lagi untuk menyelesaikan penelitian kita. Aku akan melakukan analisis di sini untuk sementara waktu. Jika kamu ingin mengetahui hasil eksperimennya, kamu bisa datang mencariku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420520
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420520,
					"content": "Baiklah, kuserahkan padamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420521
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420521,
					"content": "Sepertinya potionnya sudah siap, aku akan mencicipinya dulu. Jika tidak ada masalah, akan kuberikan padamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420509,
					"content": "Kurasa bahkan Paimon dan aku lebih dekat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420510
					]
				}
			]
		},
		{
			"id": 1104206,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
