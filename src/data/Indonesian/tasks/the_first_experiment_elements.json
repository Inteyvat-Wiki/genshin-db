			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110420101,
					"content": "Paimon mau bertanya! Kalau biji itu berhasil tumbuh, memangnya akan tumbuh menjadi benda apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420102,
					"content": "Aku juga tidak tahu, tetapi aku merasa yang terpenting adalah caranya, bukan hasil akhirnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420103
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420103,
					"content": "Menggunakan ilmu alkimia untuk memberikan kehidupan kepada sesuatu yang bukan berasal dari dunia Teyvat, pasti akan menambah pengetahuanku tentang esensi kehidupan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420104
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420104,
					"content": "Setelah membangkitkan, bahkan menciptakan pun mungkin tidak lagi mustahil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420105
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420105,
					"content": "Uhhh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420106,
					"content": "Hahaha, masih terlalu sulit dimengerti ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420107
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420107,
					"content": "Bu-bukan begitu, Paimon kan cukup pintar! Tapi akan jadi apa biji itu? Bukannya itu lebih menarik daripada yang kamu bicarakan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420108,
						110420109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420108,
					"content": "Bilang saja kalau tidak mengerti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420110
					]
				},
				{
					"id": 110420110,
					"content": "Yah, kalau tumbuh menjadi buah yang lezat, berarti aku akan mentraktirmu makan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420111
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420111,
					"content": "Yey! Paimon akan ingat janjimu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420112,
						110420113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420112,
					"content": "Hebat juga caramu membujuk Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420114
					]
				},
				{
					"id": 110420114,
					"content": "Ya, karena aku... terkadang harus menjaga seorang anak kecil. Cukup panjang kalau harus kuceritakan. Anggap saja salah satu kedisiplinanku yang tidak terkait alkimia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420115
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420115,
					"content": "Subjek pertama penelitianku adalah elemen. Di dunia ini, mengendalikan elemen memerlukan sebuah Vision, tapi aku tidak melihatnya pada tubuhmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420116
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420116,
					"content": "Bagaimana kamu bisa mengendalikan kekuatan elemen adalah hal yang ingin kupelajari. Aku punya beberapa pertanyaan untukmu mengenainya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420117
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420117,
					"content": "Pertama-tama, apakah kamu memiliki organ tubuh ekstra? Seperti jantung kedua, lambung keempat... atau semacamnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420118,
						110420119
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420118,
					"content": "Tidak ada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420120
					]
				},
				{
					"id": 110420120,
					"content": "Baiklah kalau begitu. Lalu, anak kecil melayang ini... apakah dia terhubung dengan badanmu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420121
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420121,
					"content": "Pertanyaanmu bodoh sekali! Jelas-jelas tubuh kita terpisah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420122,
					"content": "Lalu satu lagi, namaku PAIMON! Bukan anak kecil melayang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420123,
					"content": "Ah, aku hanya mempertimbangkan kemungkinan bahwa kamu adalah sebuah organ eksternal, yang terhubung dengan kekuatan yang tidak kasat mata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420124,
						110420125
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420124,
					"content": "Aku bertemu Paimon saat sedang bertualang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420126
					]
				},
				{
					"id": 110420126,
					"content": "Oh, berarti kemungkinan itu bisa kita singkirkan. Kalau begitu apakah mungkin Paimon yang mengarahkan kekuatan elemental itu padamu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420127
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420127,
					"content": "Tetapi itu berarti kekuatan elemental Paimon harus sangat kuat, cukup kuat untuk menghancurkan batu setebal 10 meter, atau memutarbalikkan arus air terjun di Springvale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420128
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420128,
					"content": "Hmmm, sepertinya tidak mungkin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420129
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420129,
					"content": "Hei! Memangnya kamu sudah tahu!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420130,
					"content": "Sepertinya tidak ada perbedaan antara tubuhmu dengan tubuh manusia di dunia ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420131
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420131,
					"content": "Ketidakpastian di dalam penelitianku sepertinya hanya bisa dikonfirmasi dengan melakukan eksperimen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420132
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420132,
					"content": "Pertama-tama, kekuatan elemental yang misterius ini. Aku ingin meneliti bagaimana tepatnya bisa terwujud.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420133
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420133,
					"content": "Aku akan memancing beberapa Slime ke sini. Mungkin kamu bisa mengalahkan mereka, dengan cara apa pun yang menurutmu paling alami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420134
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420134,
					"content": "Hah? kedengarannya tidak terlalu \"sains\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420135,
					"content": "Pengamatan yang teliti dan jelas sangatlah penting untuk sebuah eksperimen. Ini hanya latihan kecil saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420136
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420136,
					"content": "Tentu saja kalau kalian merasa ini terlalu mudah, aku bisa membantumu memanggil enam Oceanid ke sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420137
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420137,
					"content": "Slime! Slime sudah sangat cukup!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420138,
						110420139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420138,
					"content": "Aku tidak mengerti, tapi sepertinya merepotkan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420140
					]
				},
				{
					"id": 110420140,
					"content": "Kalau begitu bersiap-siaplah, para Slime akan segera datang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420139,
					"content": "Selama aku tidak dipermainkan makhluk-makhluk Hydro itu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420140
					]
				},
				{
					"id": 110420125,
					"content": "Aku memancing Paimon dari dalam air.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420126
					]
				},
				{
					"id": 110420119,
					"content": "Sepengetahuanku sih tidak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420120
					]
				},
				{
					"id": 110420113,
					"content": "Kamu berhasil menebak pikiran Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420114
					]
				},
				{
					"id": 110420109,
					"content": "Aku juga ingin mendengar kisahmu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420110
					]
				}
			]
		},
		{
			"id": 1104203,
