				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110420701,
					"content": "#Bagaimana rasanya? {NICKNAME}, ekpresimu terlihat lucu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420702,
						110420703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420702,
					"content": "Rasanya... seperti terbakar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420704
					]
				},
				{
					"id": 110420704,
					"content": "Tadi katanya kamu telah mencicipinya! Kamu yakin potionnya sudah siap diminum? Apa yang terjadi padanya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420705,
					"content": "Hmm? Oh, ini adalah hasil yang kuharapkan, hasil yang sangat positif.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420706
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420706,
					"content": "Potion ini menyalurkan kekuatan elemental ke dalam tubuh. Dalam keadaan normal, wajar saja muncul reaksi penolakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420707
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420707,
					"content": "Tetapi kalau kekuatan elemental internal mengalir dengan lancar, kamu hanya akan mengalami ketidaknyamanan untuk sesaat, setelahnya tidak akan ada efek lainnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420708
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420708,
					"content": "Jadi kamu tahu ini akan terjadi dan masih tetap meminumnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420709,
					"content": "Haha, bagaimanapun ini potion buatanku, jadi aku harus bertanggung jawab untuk mengujinya dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420710,
						110420712
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420710,
					"content": "Apakah ini... pertimbangan objek penelitian?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420711
					]
				},
				{
					"id": 110420711,
					"content": "Tentu saja. Kamu adalah asistenku, aku tidak boleh membiarkanmu mengambil risiko untukku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420714
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420714,
					"content": "Singkatnya, kita akan mendapatkan kesimpulan! Dalam tes kekuatan elemental, kamu sama saja dengan siapa pun yang ada di dunia ini, tidak ada yang aneh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420715
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420715,
					"content": "Paimon berharap terjadi sesuatu yang lebih keren...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420716,
					"content": "Tapi kurasa lebih baik hasil biasa saja daripada aneh. Hasil yang aneh cenderung berasal dari... variasi penelitian yang tidak diinginkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420717
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420717,
					"content": "Sepertinya kamu merujuk pada sesuatu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420718
					]
				},
				{
					"id": 110420718,
					"content": "Keuntungan dari orang biasa adalah di mana-mana ada orang sepertimu, jadi orang-orang yang dapat memahamimu juga ada di mana-mana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420719
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420719,
					"content": "Karena mereka adalah orang yang sama, mereka dapat memahami, berempati, dan mendukung satu sama lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420720
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420720,
					"content": "Saat kamu sakit, dokter dapat dengan mudah mendiagnosis kondisimu. Jika terjadi kesalahan, kamu bisa menanyakan pengalaman seseorang yang melakukan kesalahan yang sama, karena kamu sama dengan mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420721
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420721,
					"content": "Tetapi orang-orang \"istimewa\" tidak dapat menikmati hal-hal seperti ini, karena esensi hidup mereka pada dasarnya berbeda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420722
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420722,
					"content": "Misalnya saja... manusia tidak dapat memahami kehidupan Pyro Regisvine, atau Eye of the Storm. Dengan penjelasanku ini, apakah kamu bisa memahaminya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420723,
						110420724
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420723,
					"content": "Kurasa aku memahaminya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420725
					]
				},
				{
					"id": 110420725,
					"content": "Singkatnya, ini adalah hasil yang positif. Jadi ke depannya, kamu dapat menggunakan kekuatan elemental tanpa rasa takut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420726
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420726,
					"content": "Timaeus, hasil eksperimen baru sudah keluar. Tolong lanjutkan untuk menyelesaikannya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420727
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420727,
					"content": "Baiklah, serahkan saja padaku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420728
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420728,
					"content": "Kamu memberiku banyak hal untuk dipertimbangkan, rasanya benar-benar melampaui batasku. Aku jadi bisa berpikir jauh lebih jernih sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420729
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420729,
					"content": "Mungkin agak tidak tepat untuk memposisikanmu setara \"hewan\", tetapi kalau kamu memulai dengan teori bentuk kehidupan \"makhluk elemental\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420730
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420730,
					"content": "Bagus juga, menurutku ini adalah arah penelitian yang menarik. Apa pun hasilnya nanti, kuharap itu adalah berdasarkan penelitianmu sendiri dan bukan dari penilaianku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420731
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420731,
					"content": "Serahkan padaku! Aku akan mengekstrak hasil yang memuaskan untuk kalian semua!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420732
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420732,
					"content": "Apakah dia mau bersiap bertempur? Semangat juangnya semakin membara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420733
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420733,
					"content": "Ah... maksud Paimon... itu semangat yang luar biasa! Tuan Albedo... Ayo katakan sesuatu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420734
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420734,
					"content": "Hmm... sebelum kita melanjutkan penelitiannya, aku perlu... menyiapkan sesuatu. Tunggu sebentar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420735
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420735,
					"content": "Kalau kamu tertarik, kamu bisa melihat-lihat saja dulu di sini untuk sekadar mengisi waktu luang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420724,
					"content": "Seperti masih ada... maksud lain dalam ucapanmu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420725
					]
				},
				{
					"id": 110420712,
					"content": "Apakah kamu tidak takut membahayakan dirimu sendiri?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420713
					]
				},
				{
					"id": 110420713,
					"content": "Mungkin karena kepercayaan diri dari seorang peneliti, jadi bisa mempercepat segalanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420714
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420703,
					"content": "Ternyata kamu bisa meminumnya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420704
					]
				}
			]
		},
