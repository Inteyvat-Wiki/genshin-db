				]
			},
			"dialogs": [
				{
					"id": 761240301,
					"content": "Oke, selesai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240302
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240302,
					"content": "Terima kasih, kalian berdua sudah membuatku sangat senang, terutama adik berambut emas ini. Kemampuanmu benar-benar luar biasa, bahkan mungkin lebih kuat dari anak Guhua yang kukenal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240303,
						761240304
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240303,
					"content": "Hebatnya diriku ini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761240306
					]
				},
				{
					"id": 761240306,
					"content": "Berkat kalian berdua, aku jadi mendapat pencerahan. Saus ikan memang perlu ditambahkan ke potongan daging segar untuk meningkatkan cita rasanya. Jika tidak, bau amisnya tidak akan tertutupi kalau dibiarkan terlalu lama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240307
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240307,
					"content": "Ah, ternyata gitu ... tunggu dulu, kayaknya enggak ada hubungannya deh?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761240308,
					"content": "Haha, jangan dianggap serius. Lain kali setelah aku minta Castiglione melukis lebih banyak ikan, aku akan kasih saus ikan untuk kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240304,
					"content": "Kamu terlalu memuji.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761240305
					]
				},
				{
					"id": 761240305,
					"content": "Ah, jangan merendah. Kemampuan pedangmu sangat hebat, aku bisa melihatnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240306
					],
					"speakerTitle": "Jinggui"
				}
			]
		},
