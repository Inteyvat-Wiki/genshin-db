					}
				]
			},
			"dialogs": [
				{
					"id": 761240401,
					"content": "Eh? Kayaknya ada lukisan lain di sini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761240402,
					"content": "Aha, matamu bagus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240403
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240403,
					"content": "Ini adalah sesuatu yang digambar oleh Castiglione atas permintaan anak-anak yang mengaku sebagai penerus Klan Guhua. Katanya tempat ini adalah \"aula latihan\" kebanggaan mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240404
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240404,
					"content": "Tapi, mereka semua sangat arogan, merasa sudah menjadi petarung hebat dan tidak lagi membutuhkan pelatihan dasar seperti itu, jadi mereka memberikan lukisannya padaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240405
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240405,
					"content": "Eh? Bukannya kamu dari Klan Guhua?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761240406,
					"content": "Hahaha, sebenarnya aku mau bilang iya, tapi kurasa anak Guhua itu pun tidak akan berani menerimaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240407
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240407,
					"content": "Dulu, saat kami mengalahkan bandit di Guili Plains, anak itu hampir kehilangan nyawanya karena kurang pelatihan. Aku tidak punya pilihan selain ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240408
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240408,
					"content": "Sudahlah, semua ini tidak menarik, tapi lukisan ini lumayan menarik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240409
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240409,
					"content": "Langsung buka dan lihat saja kalau kamu tertarik, robek pun tidak apa-apa. Lagi pula, Castiglione tidak ada kerjaan, paling aku minta dia lukis lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinggui"
				}
			]
		}
	]
}