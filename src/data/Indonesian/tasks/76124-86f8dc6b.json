						"pointId": 910303069
					}
				]
			},
			"dialogs": [
				{
					"id": 761240101,
					"content": "Heh, bahkan setelah menonton untuk sekian kalinya, ini masih saja tidak masuk akal ... aku tidak pernah dengar ada orang yang berlatih pedang dengan menebang bambu. Anak Guhua memang punya pemikiran yang unik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240102
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240102,
					"content": "Bambu bisa dianyam jadi keranjang, dipotong jadi pipa, dibentuk jadi seruling atau tongkat, atau mungkin dibuat jadi kuas. Tapi untuk dipakai latihan? Apa karena tidak sanggup beli kayu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240103
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240103,
					"content": "Oke, kalian berdua! Sekarang kita sudah mulai melukis, biar aku yang jelaskan aturannya atas nama anak-anak dari Klan Guhua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240104
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240104,
					"content": "Lihat orang-orangan bambu ini, ada yang <color=#00E1FFFF>berbaju biru</color> dan ada yang <color=#FF5E41FF>berbaju merah</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240105
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240105,
					"content": "Tahap pertama dari latihan ini adalah menyerang orang-orangan bambu yang <color=#00E1FFFF>berwarna biru</color>, tapi tidak boleh mengenai yang <color=#FF5E41FF>berwarna merah</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240106
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240106,
					"content": "Kalau sudah siap, kita bisa mulai langsung. Ayo, tunjukkan kemampuan pedangmu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinggui"
				}
			]
		},
