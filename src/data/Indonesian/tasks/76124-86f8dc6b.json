					"content": "Oke, kalian berdua! Sekarang kita sudah mulai melukis, biar aku yang jelaskan aturannya atas nama anak-anak dari Klan Guhua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240204
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240204,
					"content": "Lihat orang-orangan bambu ini, ada yang <color=#00E1FFFF>berbaju biru</color> dan ada yang <color=#FF5E41FF>berbaju merah</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240205,
						761240206
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240205,
					"content": "Oh, seperti yang di Balai Wangshan waktu itu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761240207
					]
				},
				{
					"id": 761240207,
					"content": "Paimon juga ingat! Kita harus pukul semua orang-orangan bambu <color=#00E1FFFF>berbaju biru</color>, tapi enggak boleh kena yang <color=#FF5E41FF>berbaju merah</color>, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761240208,
					"content": "Haha, benar sekali! Kalau begitu, aku tidak perlu menjelaskan lagi. Ayo tunjukkan kemampuan pedangmu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240206,
					"content": "Aku tahu aturannya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761240207
					]
				}
			]
		},
