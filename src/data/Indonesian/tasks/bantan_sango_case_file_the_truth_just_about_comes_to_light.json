			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400330301,
					"content": "Ah. Bagus! Ini seharusnya sudah semua ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330302
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330302,
					"content": "Tunggu. Kenapa tidak \"pasti\" begitu sih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330303
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330303,
					"content": "Uh-oh ... Kenapa Paimon merasa kasus ini jadi seperti makin panjang saja sih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400330304,
					"content": "Benar, terkadang menyelesaikan sebuah kasus membutuhkan kesabaran. Jika kita salah malah tidak akan menghasilkan apa-apa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330305
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330305,
					"content": "Kita sudah menemukan banyak sekali hewan-hewan kecil ini, jadi setidaknya kita berada di jalur yang tepat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330306
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330306,
					"content": "Kita mungkin melewatkan beberapa petunjuk di lokasi yang kita cari, makanya bisa berada pada posisi sekarang. Tapi aku percaya ini pasti hanya sementara waktu saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330307
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330307,
					"content": "Ooh, Paimon paham! Maksudmu kita memerlukan sedikit boom shaka-laka untuk bisa sampai pada akar permasalahannya ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400330308,
					"content": "Mm, iya, bisa dibilang kita butuh boom shaka-laka. Tapi tidak terlalu banyak, kalau boleh dibilang — kita telah membuat kemajuan yang luar biasa berkat kalian berdua",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330309,
						400330310
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330309,
					"content": "(Dia ... benar-benar memahamimu loh, Paimon.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400330311
					]
				},
				{
					"id": 400330311,
					"content": "Itu masuk akal sekali, Ryuuji!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400330312,
					"content": "Kamu terlalu memuji. Aku cuma bicara dari pengalamanku saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330313
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330313,
					"content": "Semakin dalam kebenaran itu terkubur, maka semakin berharga hal itu untuk diungkapkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330314
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330314,
					"content": "Sayang sekali kita tidak punya informasi tambahan sekarang. Hmm ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330315
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330315,
					"content": "Aku akan melaporkan kondisi kita sekarang pada Sango.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330316
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330316,
					"content": "Seharusnya dia bisa mempertimbangkannya dari beberapa sudut pandang yang belum terpikirkan olehku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330317
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330317,
					"content": "Oke! Paimon percaya pada instingmu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400330318,
					"content": "Oke sepakat ya. Ayo kita bertemu di tempat biasa saat petunjuk lain sudah muncul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330319
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330319,
					"content": "Jika aku tidak ada pada saat itu, kamu bisa langsung cari Sango.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330310,
					"content": "(Sepertinya dia begitu memahamimu ya, Paimon ....)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400330311
					]
				}
			]
		},
