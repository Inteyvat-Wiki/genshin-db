			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400330101,
					"content": "Oh, kamu datang tepat waktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330102
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330102,
					"content": "Aku baru saja selesai mengintai beberapa tempat yang mencurigakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330103
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330103,
					"content": "Salah satu perkemahan itu dijaga oleh \"Si Top\" ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330104
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330104,
					"content": "Ehem, maksudku \"Bayangan Hitam\". Kalau kamu punya pertanyaan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330105
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330105,
					"content": "Tentang penyelidikan kemarin ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400330106
					]
				},
				{
					"id": 400330106,
					"content": "Mengenai itu, aku tidak tahu apa pun saat ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330107
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330107,
					"content": "Eh? Bukannya Sango memintamu untuk menyelidiki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400330108,
					"content": "Iya memang, tapi ... Bagaimana ya aku bilangnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330109
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330109,
					"content": "Contohnya, \"beberapa Lavender Melon yang sudah terlalu matang\" dan \"jejak tangan berlumpur di pintu\" itu sepertinya tidak ada hubungannya sama sekali deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330110
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330110,
					"content": "Tapi bagi Sango, ini adalah bahan-bahan yang dia butuhkan untuk membuka misteri yang begitu kompleks seperti \"yosegizaiku\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330111
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330111,
					"content": "\"Melon yang sudah terlalu matang\" dan \"jejak tangan berlumpur di pintu\" ... Apa hubungannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400330112,
					"content": "Aku hanya menggunakan analogi. Dengan arahannya, aku menyelidiki beberapa lokasi di Pulau Yashiori dan Chinju Forest sebelum melaporkan padanya tentang apa yang kulihat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330113
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330113,
					"content": "Mengenai konklusi yang dibuat olehnya berdasarkan laporanku, hanya dia saja yang tahu mereka itu maksudnya apa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330114
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330114,
					"content": "Sejujurnya, hanya Shikanoin yang bisa mengikuti alur pikirannya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330115
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330115,
					"content": "Shikanoin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400330116
					]
				},
				{
					"id": 400330116,
					"content": "Seseorang dari Tenryou Commission. Kami kenal karena kasus sebelumnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330117
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330117,
					"content": "Dia benar-benar ... seseorang yang unik. Kamu akan tahu saat bertemu dengannya nanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330118
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330118,
					"content": "Baiklah. Para hewan itu kuserahkan padamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330119
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330119,
					"content": "Paimon masih memikirkan tentang \"Lavender Melon yang terlalu matang\" itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4003303,
			"completionStepIds": [
				4003303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
