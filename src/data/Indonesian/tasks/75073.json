			"dialogs": [
				{
					"id": 750730101,
					"content": "Ah, penolongku! Terima kasih sudah mengalahkan para Hilichurl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730102
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730102,
					"content": "Aku tadinya lagi berdiri menikmati pemandangan di atas tebing, lalu tiba-tiba dihantam sampai tak sadarkan diri. Begitu bangun, aku sudah ada di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730103
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730103,
					"content": "Dikunci. Kuncinya ... ada di peti sebelah sana. Boleh minta tolong sedikit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730104
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730104,
					"content": "Utang budi ini tak akan kulupakan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Conulaf"
				}
			]
		},
