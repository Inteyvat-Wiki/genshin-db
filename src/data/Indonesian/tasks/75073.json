			"dialogs": [
				{
					"id": 750730301,
					"content": "Bebas! Akhirnya bebas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730302
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730302,
					"content": "Balon udaranya goyang ke kiri dan ke kanan. Ha, mungkin bakal jatuh kalau ada angin kencang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730303
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730303,
					"content": "Nenek Itztli sekali pun tidak akan bisa menolong kita jika itu terjadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730304
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730304,
					"content": "Siapa kamu, dan kenapa bisa ada di sini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750730305
					]
				},
				{
					"id": 750730305,
					"content": "Ah, perkenalkan dulu. Namaku Conulaf, calon imam suku Penguasa Angin Malam ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730306
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730306,
					"content": "Aku masih latihan. Seumur hidup aku belum pernah keluar wilayah suku, makanya para tetua menyarankan aku untuk \"pergi melihat dunia\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730307
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730307,
					"content": "Intinya, aku diusir dengan dalih disuruh latihan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730308
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730308,
					"content": "Tapi ditangkap Hilichurl ... rasanya bukan \"melihat dunia\" dari sisi yang baiknya. Betul tidak, penolongku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730309,
						750730311
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730309,
					"content": "Bertualang sendirian itu bahaya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750730310
					]
				},
				{
					"id": 750730310,
					"content": "Ya, ya! Jika tidak ada dirimu, aku tidak tahu kapan bisa keluar dari kandang ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730313
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730313,
					"content": "Terima kasih banyak karena telah bersedia menolongku ... Sudah masuk angin sampai kayak gini, mungkin waktunya aku turun sambil mempertimbangkan lagi perihal kelanjutan latihannya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730314
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730314,
					"content": "Milikku tidak seberapa, tapi keluarga mengajarkan agar aku tidak pernah lupa membalas budi. Ini, silakan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730311,
					"content": "Yah, asal kuat sih apa pun juga jadi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750730312
					]
				},
				{
					"id": 750730312,
					"content": "Hehe ... bercanda ya. Jarang ada petualang sekuat dirimu di muka bumi ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730313
					],
					"speakerTitle": "Conulaf"
				}
			]
		},
