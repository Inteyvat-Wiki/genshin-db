			"dialogs": [
				{
					"id": 747080101,
					"content": "#Halo, {NICKNAME} dan Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080102
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080102,
					"content": "Nona Guillotin bilang kalian lagi kelola akuarium. Jadi tentu aku harus terima undangan untuk jadi konsultan laut!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080103,
						747080104
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080103,
					"content": "Selamat datang!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747080105
					]
				},
				{
					"id": 747080105,
					"content": "Oh iya! Kalau ada Suster Kepala Sigewinne sih, kita enggak perlu takut ikannya sakit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747080106,
					"content": "Hehe, sejak kamu minta aku jaga hewan-hewan di Chevalmarin Film Fantasyland, aku sudah belajar beberapa teknik berguna ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080107
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080107,
					"content": "Ternyata merawat hewan tidak jauh beda dengan merawat pasien ya. Buat yang nurut sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080108
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080108,
					"content": "Masalahnya, tidak semua ikan itu penurut. Jadi selain merawat ikan-ikan yang sudah ada sekarang, aku juga ingin bahas beberapa ide soal terapi rawat inap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080109
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080109,
					"content": "Silakan saja, aku mendengarkan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747080110
					]
				},
				{
					"id": 747080110,
					"content": "Kudengar dari Ceasth kalau belakangan ini ada beberapa ikan liar yang menjadi sangat agresif. Katanya dia menyerang makhluk-makhluk lain, bahkan penyelam dan perahu kecil pun diserang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080111
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080111,
					"content": "Aku jadi berpikir, mungkin kita bisa mengajak mereka ke akuarium untuk beristirahat dan bersantai. Kurasa itu akan mencegah mereka membuat masalah lagi untuk sementara waktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080112
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080112,
					"content": "Lalu, aku bisa mencari cara untuk menyembuhkan temperamen buruk mereka yang tiba-tiba muncul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080113
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080113,
					"content": "Dengan begitu, kita bisa membantu ikan-ikan dan perairan kembali normal, dan kamu juga bisa menambahkan beberapa bintang tamu unik ke akuariummu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080114
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080114,
					"content": "Ide bagus tuh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747080115,
					"content": "Aku setuju!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747080116
					]
				},
				{
					"id": 747080116,
					"content": "Oke, aku akan kasih semua informasi lokasi ikan agresif yang aku punya. Sisanya terserah kalian!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080104,
					"content": "Kamu membantu banget!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747080105
					]
				}
			]
		}
	]
}