					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110410401,
					"content": "Itu Albedo bukan ya? Kenapa dia ada di tempat seperti ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110410402,
					"content": "Kudengar dia sangat suka menggambar, dia rela berada di mana pun demi menggambar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410403
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110410403,
					"content": "Alam dan pemandangan di sini sangat bagus. Sejauh mata memandang, semuanya bisa dijadikan gambar yang indah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410404
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110410404,
					"content": "Tapi... apa dia tidak melihat para Hilichurl itu? Kan berbahaya?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110410405,
					"content": "Waaah?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1104106,
			"completionStepIds": [
				1104106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104106",
							"2"
						],
						"stepId": 1104106,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110410601,
					"content": "Siapa kalian? Kenapa kalian mengagetkan para Hilichurl itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410602
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410602,
					"content": "Untung saja gambar sketsaku sudah selesai, sayang sekali kalau gambar Hilichurl ini tidak selesai kugambar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410603,
						110410604
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410603,
					"content": "Kamu sedang menggambar Hilichurl?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410605
					]
				},
				{
					"id": 110410605,
					"content": "Apa serunya sih menggambar Hilichurl? Bukannya semua bentuknya sama saja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110410606,
					"content": "Hmmm... penjelasannya akan cukup rumit, mungkin lebih mudah kalau kalian langsung melihat hasil sketsaku saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410607,
						110410608
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410607,
					"content": "Ini...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410609
					]
				},
				{
					"id": 110410609,
					"content": "Wuah, detail sekali! Tapi... sepertinya beberapa bagian diselesaikan terlalu terburu-buru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110410610,
					"content": "Itu adalah Hilichurl yang bisa kamu temui di mana pun, cukup membosankan, tidak perlu untuk diperhatikan lebih dalam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410611
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410611,
					"content": "Tapi coba kalian lihat yang satu ini, fisiknya, bulu-bulunya... Sangat berbeda dengan yang lainnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410612
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410612,
					"content": "Di dalam siklus hidup sebuah komunitas Hilichurl yang primitif, perbedaan seperti ini menunjukkan adanya sebuah evolusi. Evolusi, transisi dari tidak ada menjadi ada; dari yang diketahui menjadi tidak dike...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410613
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410613,
					"content": "Tunggu dulu, aku punya firasat ini bakal jadi obrolan panjang kayak skripsi, aku tidak punya energi untuk mendengarkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410614
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110410614,
					"content": "Kita sudah menemukan orang yang kamu cari, aku pulang dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410615
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110410615,
					"content": "Eh? Kamu tidak mau menanyakan apa pun padanya? Hei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410616
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110410616,
					"content": "Huh, benar-benar orang yang aneh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410617
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110410617,
					"content": "Jadi Suster Rosaria yang mengantarkan kalian? Mengejutkan, dan aku bahkan tidak sempat berterima kasih padanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410618
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410618,
					"content": "Kembali ke inti pembicaraan, dari kata-katanya, kalian datang untuk mencariku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410619
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410619,
					"content": "Ya, benar sekali. Kita bertemu dengan seorang gadis bernama Sucrose di Mondstadt! Katanya kamu sedang mengalami kesulitan dalam penelitianmu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110410620,
					"content": "Ah, ternyata Sucrose yang mengirim kalian ke sini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410621
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410621,
					"content": "Berarti, kalau tebakanku tidak salah, kamu adalah sang Honorary Knight. Semua orang di Mondstadt membicarakan tentangmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410622
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410622,
					"content": "Aku sudah mendengar beberapa hal tentangmu, jasamu saat Stormterror menyerang, kemampuanmu mengendalikan elemen dan beberapa hal misterius lainnya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410623
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410623,
					"content": "Aku akan langsung ke kesimpulanku, bagaimanapun hanya ada satu kemungkinan. Kamu datang dari jauh —— dari dunia lain. Benar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410624,
						110410625
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410624,
					"content": "Ya, benar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410626
					]
				},
				{
					"id": 110410626,
					"content": "Bagus. Kalau aku mendapatkan bantuanmu, kurasa penelitianku akan berkembang pesat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410627,
						110410628
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410627,
					"content": "Penelitianmu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410629
					]
				},
				{
					"id": 110410629,
					"content": "Ah, maafkan aku, ini pasti membingungkan. Dari mana aku harus mulai menjelaskan... Dari... inti kehidupan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410630
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410630,
					"content": "Tunggu, tunggu! Kamu mau mulai dari situ!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410631
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110410631,
					"content": "Hmmm, kamu benar. Mungkin akan lebih mudah dimengerti kalau aku langsung memberikan demonstrasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410632
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410632,
					"content": "Misalnya, membangkitkan kehidupan. Memberikan napas kehidupan ke daun-daun yang sudah gugur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410634
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410634,
					"content": "Kamu bisa melakukan hal itu?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410635,
						110410636
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110410635,
					"content": "Ilmu alkimia benar-benar ajaib.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410637
					]
				},
				{
					"id": 110410637,
					"content": "Tetapi... aku memiliki sebutir biji yang unik. Cara yang kusebutkan tadi tidak memberikan hasil apa pun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410639
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410639,
					"content": "Sama sepertimu, biji ini juga dari dunia lain. Membuatnya tumbuh dan berkembang... itulah masalah yang kuhadapi saat ini. Maka dari itu aku membutuhkan bantuanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410640
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410640,
					"content": "Kalau bahkan orang sehebatmu saja kesulitan, Paimon tidak yakin kami bisa membantu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410641
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110410641,
					"content": "Aku tidak setuju. Karena aku tidak dapat memahami bentuk kehidupan yang ada di luar dunia yang kuketahui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410642
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410642,
					"content": "Tapi kamu bukan dari dunia yang kuketahui. Dengan memperhatikan dan menelitimu, aku mungkin bisa menemukan cara menumbuhkan biji itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410643
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410643,
					"content": "Jadi aku adalah... sebuah objek penelitian?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410644
					]
				},
				{
					"id": 110410644,
					"content": "#Uhhh, apa kita pergi saja, {NICKNAME}? Kedengarannya agak mengerikan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410645,
						110410647
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110410645,
					"content": "Apakah akan berbahaya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410646
					]
				},
				{
					"id": 110410646,
					"content": "Mungkin sedikit, tapi aku akan melakukan segala hal untuk menjamin keselamatanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410649
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410649,
					"content": "Waktunya berpindah tempat, ayo kita pergi. Penelitian menunggu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410650
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410650,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410651
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110410651,
					"content": "Albedo dan Pengembara itu sepertinya terlihat akur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410652
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110410652,
					"content": "Mungkin karena hanya orang aneh yang mengerti sesamanya... Apa hal ini akan berbahaya bagi Mondstadt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110410647,
					"content": "Apakah ada imbalannya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410648
					]
				},
				{
					"id": 110410648,
					"content": "Mora, pengetahuan, dan mungkin jawaban yang sedang kamu cari. Karena aku kebetulan mengetahui jawabannya. Bagaimana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410649
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410636,
					"content": "Ilmu alkimia benar-benar praktis.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410637
					]
				},
				{
					"id": 110410628,
					"content": "Aku tidak begitu paham.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410629
					]
				},
				{
					"id": 110410625,
					"content": "Kemampuanmu memang sehebat reputasimu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410626
					]
				},
				{
					"id": 110410608,
					"content": "Sangat... bergaya avant-garde.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410609
					]
				},
				{
					"id": 110410604,
					"content": "Kukira kamu sedang menggambar pemandangan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410605
					]
				}
			]
		}
	]
}