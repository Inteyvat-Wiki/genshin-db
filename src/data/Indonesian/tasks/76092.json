			},
			"dialogs": [
				{
					"id": 760920201,
					"content": "\"Malam yang diterangi bulan dan bintang, kini dibantai oleh kesunyian. Darah dan tulang kami olah menjadi bahan bakar, bersamanya kami nyatakan: Malam panjang yang gelap dan kelam. Tidak ada roh yang terbangun selama lentera ini ada di tangan, perjanjian ini disahkan demi bulan yang ada di langit malam.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Periksa"
				}
			]
		}
