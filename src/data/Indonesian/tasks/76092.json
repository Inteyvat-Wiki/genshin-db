				"objectNames": [
					"Rolf"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760920101,
					"content": "Menjauh sana, kawan! Tempat ini berbahaya, kalau nanti Perburuan Liar muncul, aku tidak bisa jamin kamu aman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760920102,
						760920109,
						760920112
					],
					"speakerTitle": "Rolf"
				},
				{
					"id": 760920102,
					"content": "Kok tahu bakal ada Perburuan Liar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760920103
					]
				},
				{
					"id": 760920103,
					"content": "Sebagai Lightkeeper, aku disumpah untuk melawan Perburuan Liar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760920104
					],
					"speakerTitle": "Rolf"
				},
				{
					"id": 760920104,
					"content": "Kamu lihat Tideseal Stone yang ada di sebelah sini? Untuk memastikan Perburuan Liar disapu bersih sampai tak bersisa, aku harus mengawasinya selama tiga hari tiga malam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760920105
					],
					"speakerTitle": "Rolf"
				},
				{
					"id": 760920105,
					"content": "Tideseal Stone?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760920106
					]
				},
				{
					"id": 760920106,
					"content": "Tideseal Stone adalah segel yang dipasang oleh kami para Lightkeeper untuk menghalau Perburuan Liar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760920107
					],
					"speakerTitle": "Rolf"
				},
				{
					"id": 760920107,
					"content": "Meskipun aku tidak tahu pasti bagaimana cara kerjanya, tapi biasanya, di tempat-tempat yang pernah dikunjungi Perburuan Liar, sisa-sisa hawanya dapat dengan mudah menarik mereka kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760920108
					],
					"speakerTitle": "Rolf"
				},
				{
					"id": 760920108,
					"content": "Oleh karena itu, setelah menghempas Perburuan Liar, kami akan memasang Tideseal Stone. Jika Perburuan Liar muncul lagi di sekitar sini, batu ini juga akan melindungi kita dalam pertempuran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rolf"
				},
				{
					"id": 760920109,
					"content": "Aku tidak takut sama Perburuan Liar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760920110
					]
				},
				{
					"id": 760920110,
					"content": "Meski aku tidak tahu dari mana kamu mendapat kepercayaan diri seperti itu, tapi Perburuan Liar bukanlah musuh yang bisa dihadapi dengan enteng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760920111
					],
					"speakerTitle": "Rolf"
				},
				{
					"id": 760920111,
					"content": "Dengarkan saranku, jika kamu menemukan tempat dengan Tideseal Stone seperti ini, sebaiknya tetap berhati-hati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rolf"
				},
				{
					"id": 760920112,
					"content": "Aku enggak ganggu deh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760920113
					]
				},
				{
					"id": 760920113,
					"content": "Baik, hati-hati di jalan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rolf"
				}
			]
		},
