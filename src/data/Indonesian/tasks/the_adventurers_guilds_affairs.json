			"dialogs": [
				{
					"id": 718030301,
					"content": "Meong...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030302
					],
					"speakerTitle": "Ash"
				},
				{
					"id": 718030302,
					"content": "Hah? Kenapa ada kucing di sini, apa mungkin suara tadi itu berasal darinya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030303,
					"content": "Meong... meong...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030304,
						718030308
					],
					"speakerTitle": "Ash"
				},
				{
					"id": 718030304,
					"content": "Kucing abu-abu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030305
					]
				},
				{
					"id": 718030305,
					"content": "Kucing abu-abu... tersesat di alam liar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030306,
					"content": "Ah! Lan menyebutkan komisi untuk menemukan kucing... Mungkinkah ini kucing tersebut? Sepertinya dia dipanggil Ash...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030307,
					"content": "Aku tidak menyangka akan menemukannya di sini... Apa dia bersembunyi di dekat sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030311,
					"content": "Karena Stonehide Lawachurl ada di sini, tidak ada yang berani datang dan mencarinya... dan dia tidak berani keluar, jadi dia hanya bisa bersembunyi di sini saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030312,
					"content": "Untungnya, kita ada di sini, jika tidak, tidak tahu berapa lama dia akan tinggal di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030313,
					"content": "Meong... meong meong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030314,
						718030317
					],
					"speakerTitle": "Ash"
				},
				{
					"id": 718030314,
					"content": "Meong... meong...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030315
					]
				},
				{
					"id": 718030315,
					"content": "Hei, apa yang kamu lakukan, dia pastinya juga tidak mengerti kata-kata kita kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030316,
					"content": "Mari kita bawa dia kepada Lan, biarkan dia mengembalikan kucing abu-abu itu kepada pemiliknya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030319,
					"content": "Meong... meong! Meong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030320,
						718030322
					],
					"speakerTitle": "Ash"
				},
				{
					"id": 718030320,
					"content": "Meong... meong! Meong!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030321
					]
				},
				{
					"id": 718030321,
					"content": "Tidak peduli bagaimanapun caranya, dia tidak akan mengerti! Ayo cepat kita bawa dia kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030322,
					"content": "Sepertinya kucing itu setuju.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030323
					]
				},
				{
					"id": 718030323,
					"content": "Bagaimana kamu mengerti... ah sudahlah, ayo kita bawa dia kembali secepatnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030317,
					"content": "Bawa kembali kepada Lan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030318
					]
				},
				{
					"id": 718030318,
					"content": "Nah, itulah satu-satunya cara. Bawa Ash kembali ke Lan, lalu biarkan Lan mengembalikan kepada pemiliknya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030308,
					"content": "Jadi dia Ash...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030309
					]
				},
				{
					"id": 718030309,
					"content": "Kucing abu-abu... tersesat di alam liar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030310,
					"content": "Ah! Itu adalah komisi yang Lan sebutkan sebelumnya, aku tidak menyangka akan menemukannya di sini... Apa dia bersembunyi di dekat sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030311
					],
					"speakerTitle": "Paimon"
				}
			]
