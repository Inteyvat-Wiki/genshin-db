						718030503
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 718030503,
					"content": "Ini Ash.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030504
					]
				},
				{
					"id": 718030504,
					"content": "Tunggu sebentar, aku akan mengambil komisi itu dan membandingkan karakteristiknya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030505
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 718030505,
					"content": "Biar kulihat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030506
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 718030506,
					"content": "Sebagian besar cocok... Tampaknya ini memang kucing yang dicari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030508
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 718030508,
					"content": "Pemiliknya pasti akan sangat senang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030509
					]
				},
				{
					"id": 718030509,
					"content": "Huff... setelah berkeliaran, tak disangka tiba-tiba malah kembali ke komisi untuk menemukan kucing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030510
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 718030510,
					"content": "Aku benar-benar tidak tahu harus berkata apa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030511
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 718030511,
					"content": "Aku akan melaporkan dua komisi tersebut kepada para klien secara terpisah. Terima kasih atas kerja kerasmu. Ini ada sedikit hadiah. Terimalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030512
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 718030512,
					"content": "Tetapi komisi untuk menemukan kucing itu... klien tampaknya sudah pindah, dan mungkin perlu beberapa saat untuk menghubungi mereka lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030513
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 718030513,
					"content": "Sebelum klien datang, aku akan mengurus si kecil ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030514
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 718030514,
					"content": "Meong meong, meong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
