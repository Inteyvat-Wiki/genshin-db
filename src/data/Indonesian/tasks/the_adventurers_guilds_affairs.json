			"dialogs": [
				{
					"id": 718030401,
					"content": "Apa kamu sudah mengalahkan Stonehide Lawachurl?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030402,
						718030404
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 718030402,
					"content": "Sudah beres.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030403
					]
				},
				{
					"id": 718030403,
					"content": "Terima kasih atas kerja kerasnya. Setelah menyelesaikan komisi ini, semestinya bisa membuktikan kekuatan dari Guild kita...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				},
				{
					"id": 718030404,
					"content": "Sudah dikalahkan, dan Ash juga telah ditemukan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030405
					]
				},
				{
					"id": 718030405,
					"content": "Terima kasih... eh, apa?",
					"roleType": "TALK_ROLE_NPC",
