			"dialogs": [
				{
					"id": 250290301,
					"content": "Kakak, keren banget! Naiknya sudah secepat Mayta loh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290302,
						250290304
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290302,
					"content": "Ah ... Ada salah sedikit tadi ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290303
					]
				},
				{
					"id": 250290303,
					"content": "Apa? Maksudnya Kakak masih bisa lebih cepat lagi? Memang \"petualang hebat\" berarti, bukan kaleng-kaleng ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290306
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290306,
					"content": "Kalau kita jadikan waktunya sebagai target latihan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290307
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290307,
					"content": "Groaaar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290308
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290308,
					"content": "Iya, kayaknya agak susah nih buat kamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290309
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290309,
					"content": "Aku coba kasih tahu Mayta deh soal ini. Mungkin dia bisa kasih kami program latihan yang ... lebih memungkinkan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290310
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290310,
					"content": "Makasih banyak ya Kak! Ini, Cacahuatl buat Kakak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290311
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290311,
					"content": "Kami petik sendiri, segar banget tuh. Pasti enak kalau dibikin cokelat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290312
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290312,
					"content": "Groar, grrroar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290313
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290313,
					"content": "Kalau begitu, kami jalan duluan. Mayta ada tidak ya? Atau dia sudah pergi manjat lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290304,
					"content": "Mayta? Siapa tuh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290305
					]
				},
				{
					"id": 250290305,
					"content": "Dia itu temanku. Dia jago sekali manjat tebing! Selain Kak Roca, kayaknya tidak ada yang bisa menandinginya deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290306
					],
					"speakerTitle": "Tlatem"
				}
			]
