			"dialogs": [
				{
					"id": 250290101,
					"content": "Ayo, jangan putus asa! Asal kamu cepat sehat dan terus semangat, nanti pasti bisa naik sampai puncak gunung!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290102
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290102,
					"content": "Groar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290103
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290103,
					"content": "Kamu lapar ya? Hmm ... mau makan dulu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290104
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290104,
					"content": "Groar ... grauu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290105
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290105,
					"content": "Lagi ngapain nih?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290106
					]
				},
				{
					"id": 250290106,
					"content": "Aku lagi main sama Qica. Dia masih mungil, tapi kata mama kalau sudah besar nanti ukurannya enggak akan kalah sama Yumkasaurus lain!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290107
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290107,
					"content": "Groar ... groarrr ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290108
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290108,
					"content": "Jangan sedih. Badan kamu masih lemah, dan baru sembuh dari luka parah! Itu doang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290109
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290109,
					"content": "Mama bilang asal kamu makan banyak dan sering latihan, pasti bakal sehat lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290110
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290110,
					"content": "Groar? Groar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290111,
						250290113
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290111,
					"content": "(Elus Qica.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290112
					]
				},
				{
					"id": 250290112,
					"content": "Groar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290119
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290119,
					"content": "Wah, sudah kelamaan nih ngobrolnya. Kami harus makan dulu, sebentar lagi sudah mau latihan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290120
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290120,
					"content": "Ini buah kering buatan mama. Disangrai dulu di panci gede, terus tambahin bumbu wangi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290121
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290121,
					"content": "Terus dikasih gula sama kelopak bunga juga ... Pokoknya, dijamin enak. Sebentar, kamu juga mau kan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290122
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290122,
					"content": "Eh? Mana buah keringnya? Jelas-jelas tadi disimpan di tas ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290123
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290123,
					"content": "Gro ... ar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290124
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290124,
					"content": "Wah! Qica! Kamu habisin semua?!? Duh! Kan sudah dibilang jangan rakus! Kalau kebanyakan makan, nanti jadi susah gerak loh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290125
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290125,
					"content": "Graok ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290126,
						250290127
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290126,
					"content": "Selera makannya masih ada. Bagus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290128
					]
				},
				{
					"id": 250290128,
					"content": "Groar! groaaar~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290129
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290129,
					"content": "Begitu ya? Kalau begitu ... Aku mau sama kayak Qica deh, makan banyak biar cepat gede. Mau bantuin mami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290130
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290130,
					"content": "Oke deh! Qica, kita mulai latihan yuk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290131
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290131,
					"content": "Wuaa",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290132
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290132,
					"content": "Hmm ... Latihan hari ini ... naik gunung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290133
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290133,
					"content": "Gro-groar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290134
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290134,
					"content": "Jangan gitu! Sama kok sama yang tempo hari. Enggak ada susah-susahnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290135
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290135,
					"content": "Groar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290136
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290136,
					"content": "Oh ya, Paman Yawar pernah bilang kalau latihan yang betul tuh \"target latihan\"-nya harus yang masuk akal ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290137
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290137,
					"content": "Kalau saja ada petualang yang hebat, yang tahu caranya ngasih target buat dikejar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290138,
						250290139
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290138,
					"content": "Petualang hebat? Aku dong.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290140
					]
				},
				{
					"id": 250290140,
					"content": "Wah ... Kakak, mau bantu aku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290141,
						250290142
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290141,
					"content": "Mau aku bawa naik gunung?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290143
					]
				},
				{
					"id": 250290143,
					"content": "Eh, eh, jangan! Jangan gitu. Kakak nih kan orang hebat, kami mana sanggup ngikutinnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290144
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290144,
					"content": "Aku akan hitung berapa lama Kakak bisa sampai ke atas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290145
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290145,
					"content": "Tolong ya, Kak! Manjatnya pakai tenaga penuh! Semangat!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290146
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290146,
					"content": "Grr! Grrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290142,
					"content": "Baiklah, ikut ya. Berangkat!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290143
					]
				},
				{
					"id": 250290139,
					"content": "Kebetulan petualang hebatnya ada nih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290140
					]
				},
				{
					"id": 250290127,
					"content": "Makan biar sehat. Anak sehat tubuhnya kuat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290128
					]
				},
				{
					"id": 250290113,
					"content": "Kenapa bisa luka?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290114
					]
				},
				{
					"id": 250290114,
					"content": "Enggak tahu ... mama deh yang tahu. Qica sudah begini dari semenjak dibawa ke rumah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290115
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290115,
					"content": "Dia enggak bisa makan dan enggak bisa gerak. Aku cuma bisa kasih dia air campur obat setiap hari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290116
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290116,
					"content": "Akhirnya dia sembuh, tapi badannya ... masih lemah. Makanya dia enggak bisa muter-muter di tebing kayak Yumkasaurus lainnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290117
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290117,
					"content": "Dia sedih banget gara-gara keadaan ini. Aku bantuin biar pulih, sehat, terus ... jadi lebih kuat dari Yumkasaurus yang lain!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290118
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290118,
					"content": "Wuaa",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290119
					],
					"speakerTitle": "Qica"
				}
			]
		},
