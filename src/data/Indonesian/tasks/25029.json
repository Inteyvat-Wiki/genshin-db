			"dialogs": [
				{
					"id": 250290201,
					"content": "Anak pintar, anak pintar! Sudah kenyang? Sudah siap latihan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290202
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290202,
					"content": "Groar~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290203
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290203,
					"content": "Hari ini semangatnya bagus banget! Menyala nih, ayo gas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290204
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290204,
					"content": "Menyala Saurian-ku!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290206
					]
				},
				{
					"id": 250290206,
					"content": "Oh, halo Kak! Kami sedang latihan naik lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290207
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290207,
					"content": "Groar, groar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290208
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290208,
					"content": "Groooar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290209,
						250290212
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290209,
					"content": "Gimana latihannya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290210
					]
				},
				{
					"id": 250290210,
					"content": "Yah ... \"ada perkembangan\" lah. Kali ini Qica naiknya sudah lebih jauh dibanding kemarin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290211
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290211,
					"content": "Si Qica cuma masih kurang bisa saja gerakan-gerakannya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290216
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290216,
					"content": "Kak, boleh tolong tunjukin sekali lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290217,
						250290221
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290217,
					"content": "Boleh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290218
					]
				},
				{
					"id": 250290218,
					"content": "Makasih Kak! Kali ini aku akan lebih perhatiin gerakannya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290219
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290219,
					"content": "Qica! Perhatiin baik-baik juga ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290220
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290220,
					"content": "Wuaa",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290223
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290223,
					"content": "Tolong ya, Kak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290224
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290224,
					"content": "Aku akan hitung berapa lama Kakak bisa sampai ke atas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290225
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290225,
					"content": "Groaaar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290221,
					"content": "Lihat baik-baik ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290222
					]
				},
				{
					"id": 250290222,
					"content": "Pasti! Aku dan Qica bakal pasang mata terus! Enggak akan ada yang kelewat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290223
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290212,
					"content": "Pemulihannya lumayan bagus dong.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290213
					]
				},
				{
					"id": 250290213,
					"content": "Yup. Kata mama aku pintar jagain Qica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290214
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290214,
					"content": "Perkembangannya lumayan banget. Naiknya sudah jauh lebih tinggi dibanding kemarin ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290215
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290215,
					"content": "Si Qica cuma masih kurang bisa saja gerakan-gerakannya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290216
					],
					"speakerTitle": "Tlatem"
				}
			]
		},
