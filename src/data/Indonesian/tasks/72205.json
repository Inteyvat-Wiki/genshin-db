			},
			"dialogs": [
				{
					"id": 722050501,
					"content": "Eh, ketemu lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050502
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050502,
					"content": "Halo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050503,
						722050504
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050503,
					"content": "Halo juga!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050505
					]
				},
				{
					"id": 722050505,
					"content": "Iya, masih dong! Oh iya, apa kakak tahu batu besar ini buat apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050506
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050506,
					"content": "Hehe! Kito serba tahu loh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050507,
						722050508
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050507,
					"content": "Aku tidak tahu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050509
					]
				},
				{
					"id": 722050509,
					"content": "Aku dengar Kakek Mata bilang batu ini adalah batu nisan yang berguna buat menuntun arwah orang yang sudah meninggal. Arwah gentayangan akan tertarik sama batu besar ini, dan akan bangun di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050510
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050510,
					"content": "Setelahnya, mereka akan kelilingi pulau ini sampai ketemu seseorang yang bisa mengabulkan keinginan mereka. Setelahnya, mereka akan terus nempel sama orang itu sampai keinginannya terkabul, lalu akhirnya baru bisa ikut dengan juru perahu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050511
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050511,
					"content": "Ada arwah yang baik, ada juga yang jahat, itulah kenapa siapa pun yang lewat sini di malam hari, harus meneriakkan nama dan klan asal mereka!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050512
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050512,
					"content": "Orang yang tahu asal muasal dan nenek moyang mereka, lebih percaya diri ketimbang arwah kesepian. Kalau arwahnya dengar dari mana kamu berasal, mereka akan takut lalu pergi, tidak akan berani ganggu kamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050513
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050513,
					"content": "Ah ... Masalahnya, kakak kan dari luar pulau ya? Berarti tidak punya nama klan yang bisa diteriakkan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050514
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050514,
					"content": "Benar juga. Apa jadinya kalau kakak sampai ketemu arwah jahat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050515
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050515,
					"content": "Hehe, tenang! Pasti bakal aman-aman saja, biar aku yang melindungi kakak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050516
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050516,
					"content": "Betul, betul itu! Aku akan bantu juga biar arwah jahatnya takut!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050508,
					"content": "Buat apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050509
					]
				},
				{
					"id": 722050504,
					"content": "Masih belum pergi ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050505
					]
				}
			]
		},
		{
