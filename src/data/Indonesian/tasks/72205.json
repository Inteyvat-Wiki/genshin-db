					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050711
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050711,
					"content": "... Maaf, harusnya aku tak boleh marah sama kamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050712,
						722050713
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050712,
					"content": "Tidak apa-apa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050714
					]
				},
				{
					"id": 722050714,
					"content": "Paman emas memaksa kami naik perahu lagi ... Dia bilang mau bawa kami ke rumah emas yang tidak ada kabutnya! Aku tidak mau! Aku mau sama Nenek Una saja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050715
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050715,
					"content": "Dia tidak mau main sama kami, dan dia juga tidak asyik ... Dia terus saja bilang kami harus pergi! Seram ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050716
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050716,
					"content": "Kami bukannya tidak bisa pergi, kami cuma takut Nenek Una khawatir ....",
