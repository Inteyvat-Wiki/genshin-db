			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kito",
					"Kina"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722050101,
					"content": "Hah, aneh. Padahal aku yakin benda itu ada di kantongku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050102,
						722050103
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050102,
					"content": "Halo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050104
					]
				},
				{
					"id": 722050104,
					"content": "Tidak bisa. Ini untuk Nenek Una ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050105
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050105,
					"content": "Dia sudah lanjut usia, dan mulai agak pikun juga. Baru-baru ini dia juga lebih sering cerita tentang masa mudanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050106
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050106,
					"content": "Dia selalu bilang soal bunga ini dan bunga itu ... juga bilang kalau bunganya berasal dari seberang Lautan Kabut, yang wujudnya berbeda dan sangat cantik ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050107
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050107,
					"content": "Lalu suatu hari, aku mimpi. Mimpi tentang kabut pulau yang hilang sekejap \"whush!\" begitu. Dan di sisi lain lautan, tampak satu rumah yang tinggi dan indah menawan. Rumah itu bukan terbuat dari kayu, dan bukan juga dari emas ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050108
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050108,
					"content": "Aku juga, aku juga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050109
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050109,
					"content": "Dalam mimpi itu, aku mendaki gunung tinggi dan memanjat pohon besar, lalu memetik banyak sekali bunga-bunga yang cantik. Aku belum pernah lihat bunga seperti itu sebelumnya, tapi aku tahu kalau bunga-bunga itu yang Nenek Una cari ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050110
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050110,
					"content": "Tapi bunganya terlalu berat, sehingga aku jatuh dari pohon. Aku jatuh, jatuh, dan terus jatuh, sampai akhirnya aku bangun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050111
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050111,
					"content": "Heh! Makanya jangan serakah. Aku kan sudah bilang kita sudah petik cukup banyak, tapi kamu malah tak mau dengar! Akhirnya kita malah jatuh barengan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050112
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050112,
					"content": "Sekarang kantong kita kosong, dan semuanya hilang ... Gimana kita bisa ketemu sama Nenek Una kalau begini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050103,
					"content": "Perlu dibantu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050104
					]
				}
			]
		},
		{
			"id": 7220503,
			"completionStepIds": [
				7220512
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7220512",
							"2"
