			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kito",
					"Kina"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722050301,
					"content": "Halo Kak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050302,
						722050303
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050302,
					"content": "Hai!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050304
					]
				},
				{
					"id": 722050304,
					"content": "Terima kasih sudah bantu kami petik bunga! Cuma saja ... aku tetap merasa ada yang aneh di sini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050305
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050305,
					"content": "Aku juga! Aneh itunya loh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050306
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050306,
					"content": "Setiap kali kami sampai di tempat berbeda, kami selalu saja ketemu orang-orang yang murung ... Lalu tidak ada yang bisa dengar omongan orang-orang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050307
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050307,
					"content": "Dan setiap kali kami nemu bunga cantik, kami petik, simpan di tas, terus hilang! Gitu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050308,
						722050309
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050308,
					"content": "Itu karena ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050310
					]
				},
				{
					"id": 722050310,
					"content": "Begitu ya ... Aku tidak paham sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050311
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050311,
					"content": "Kami harus pergi ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050312
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050312,
					"content": "Paman emas juga bilang hal yang sama ... Tapi kami masih belum bisa ikut dia pergi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050313
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050313,
					"content": "Kami masih harus berikan bunga-bunga cantik ini ke Nenek Una!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050309,
					"content": "Sudah waktunya pergi ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050310
					]
				},
				{
					"id": 722050303,
					"content": "Kalian berdua semangat sekali.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050304
					]
				}
			]
		},
		{
			"id": 7220505,
			"completionStepIds": [
				7220513
			],
