			"dialogs": [
				{
					"id": 711390601,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390602
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390602,
					"content": "Kenapa Lingyuan? Ada yang nyelip di gigiku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390603
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711390603,
					"content": "Bukan, cuma ... ah, tidak jadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390604
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390604,
					"content": "Misalkan kamu atau si ular minta aku menjelma jadi manusia lagi ... aku menolak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390605
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390605,
					"content": "Hehe, aku belum pernah minta kayak gitu, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390606
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711390606,
					"content": "Lupakan. Ayo pergi. Katanya masih mau lihat teh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lingyuan"
				}
			]
		},
		{
