			},
			"dialogs": [
				{
					"id": 711390301,
					"content": "Ha? Itu Lingyuan, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711390302,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390303
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390303,
					"content": "Maaf, kamu lagi berburu ya? Kami ganggu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711390304,
					"content": "Tidak. Aku tidak berburu. Kalian tidak mengganggu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390305
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390305,
					"content": "Lah ... terus kamu ngapain? Bengong? Ngelamunin makanan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711390306,
					"content": "Aku tidak sedang memikirkan kamu. Tapi aku memang sedang berpikir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390307
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390307,
					"content": "Memikirkan ... EH, TUNGGU DULU! Itu kalimat pertama maksudnya apa!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711390308,
					"content": "#Aku sedang memikirkan pertanyaan {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390309
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390309,
					"content": "\"Kalau tindakan manusia adalah bagian dari hukum alam, kamu menganggap manusia itu apa?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390310
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390310,
					"content": "Sudah lama berselang semenjak aku terakhir kali berhubungan dengan manusia di pemukiman ini. Tidak semenjak Fujin dan ular itu pergi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390311
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390311,
					"content": "Eh, si Mao juga orang WOI!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711390312,
					"content": "#Mao adalah manusia, dia bagian dari pemukiman, tapi bukan manusia yang membentuk pemukiman. Kamu dan {NICKNAME} \"membentuk\" pasangan teman seperjalanan, tapi kamu bukan \"bagian\" dari {NICKNAME}. Itu bedanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390313,
						711390315
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390313,
					"content": "Jadi maksudnya, si Mao tidak kamu anggap sebagai bagian dari masyarakat?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390314
					]
				},
				{
					"id": 711390314,
					"content": "Belum seluruhnya. Kebanyakan manusia muda juga sama, seperti itu hingga tiba saatnya masyarakat menyerap mereka menjadi bagian, seperti alam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390317
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390317,
					"content": "Aku sudah lama tidak berhubungan dengan manusia yang membentuk pemukiman. Apa karena benci? Atau takut? Atau keduanya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390318,
						711390319
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390318,
					"content": "Karena mereka menduduki alam?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390320
					]
				},
				{
					"id": 711390320,
					"content": "Tidak tahu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390321
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390321,
					"content": "Atau mungkin \"kami\" dan \"mereka\" sebenarnya tidak berbeda. Entahlah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390322
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390322,
					"content": "Manusia muda berjalan di sisiku, dan kaumku yang masih belia pun berjalan dengan manusia karena penasaran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390323
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390323,
					"content": "Ah? \"Kaumku yang masih belia\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711390324,
					"content": "Anak itu bertemu dengan manusia fana di pegunungan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390325
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390325,
					"content": "Jadi aku belum bisa menjawab. Masih harus lanjut mengamati manusia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390326
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390326,
					"content": "Ada banyak yang aku tidak pahami, tapi akan kucoba untuk mengerti. Sampai tiba harinya aku bisa menjawab pertanyaanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390319,
					"content": "Karena Fujin mengorbankan diri demi mereka?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390320
					]
				},
				{
					"id": 711390315,
					"content": "Masa sih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390316
					]
				},
				{
					"id": 711390316,
					"content": "Eh, jangan gitu dong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390317
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7113904,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
