			"dialogs": [
				{
					"id": 711390801,
					"content": "Kak Fujin! Selamat karena sudah kembali ... ke wujud asal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390802
					],
					"speakerTitle": "Mao"
				},
				{
					"id": 711390802,
					"content": "Aku sudah dengar dari Bluey! Dia selalu bilang \"wujud asli lebih baik\", dan \"aku tidak habis pikir kenapa harus pakai wujud manusia\", tapi dia juga senang loh! Sangat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390803
					],
					"speakerTitle": "Mao"
				},
				{
