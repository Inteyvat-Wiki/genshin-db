			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mao",
					"Hautemontagne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711390401,
					"content": "Kalau dengar ceritanya si Mountain, kayaknya \"opera\" di Fontaine tuh mirip sama yang punya kita ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390402
					],
					"speakerTitle": "Mao"
				},
				{
					"id": 711390402,
					"content": "Kesatria, penyihir, pejuang gagah berani, naga jahat, kamu bunuh aku, aku bunuh kamu, terus akhirnya, semuanya mati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390403
					],
					"speakerTitle": "Mao"
				},
				{
					"id": 711390403,
					"content": "Yang penting bukan akhirnya, tapi prosesnya! Bagaimana caranya mencapai ujung jalan. Tidak semua tragedi menampilkan adegan aksi demi adegan aksi semata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390404
					],
					"speakerTitle": "Hautemontagne"
				},
				{
					"id": 711390404,
					"content": "Terus, terus, cerita Golem \"Semur-liar\" Mountain juga keren! Gedenya gimana? Si Bluey kalah enggak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390405
					],
					"speakerTitle": "Mao"
				},
				{
					"id": 711390405,
					"content": "Eh? Bluey?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390406
					],
					"speakerTitle": "Hautemontagne"
				},
				{
					"id": 711390406,
					"content": "Oh ya, aku belum pernah ceritain tentang si Bluey ya? Gimana kalau kamu ceritain soal Golem \"Semur-liar\" dan aku ceritain soal Bluey!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mao"
				}
			]
		},
		{
			"id": 7113905,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fujin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711390501,
					"content": "Wuih, kita sudah kumpulin lumayan banyak kekuatan Adeptus loh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390502,
						711390503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711390502,
					"content": "Siapa dulu dong, aku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390505
					]
				},
				{
					"id": 711390505,
					"content": "Si Fujin bilang kekuatan Adeptus ini mesti diserahin ke \"Rainjade\", betul? Supaya Desa Qiaoying bisa dapat hasilnya tahun depan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711390506,
					"content": "Nanti pas waktunya tiba, Paimon mau minta Paman Luo bikinin makanan enak yang banyak! Hmm ... kue teh, burung dara, babi kecap, cha siu, dan ... *slurph*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711390507,
					"content": "Oh ya! Mau Chenyu Brew juga dong! Paimon harus tulis sih ini, biar enggak lupa ... Eh, siapa di sana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711390508,
					"content": "Fu-Fujin?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711390509,
					"content": "Hehe, maaf, kaget ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390510
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711390510,
					"content": "Wah, sudah balik lagi ke wujud manusia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711390511,
					"content": "Betul! Bukankah diriku telah berkata, bahwa luka yang dideritanya tidaklah parah, dan hanya memerlukan rehat sejenak saja untuk kembali ke wujud ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390512
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711390512,
					"content": "Terima kasih karena sudah mengumpulkan kekuatan Adeptus untuk Rainjade selama aku beristirahat. Kalian sudah berkontribusi untuk panen raya tahun depan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390513,
						711390514
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711390513,
					"content": "#Perkara mudah saja bagi {M#Tuan Muda}{F#Nona Muda} ini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390515
					]
				},
				{
					"id": 711390515,
					"content": "Eh, kamu kan sudah balik lagi ke wujud manusia dan enggak usah mengurung diri gua gelap itu lagi, kan? Selanjutnya mau ngapain nih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711390516,
					"content": "Ya ... aku belum tahu sih. Mungkin jalan-jalan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390517
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711390517,
					"content": "Mencoba teh hari ini, nonton opera hari ini, mengamati orang-orang hari ini ... Ah, maaf. Aku terlalu menekankan kata \"hari ini\" ya .....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390518
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711390518,
					"content": "Tapi aku memang suka sih, istilah \"hari ini\". Semua yang tidak bisa dikerjakan di masa lampau dapat dilakukan pada \"hari ini\". Semua yang tidak bisa tercapai, janji yang belum ditepati ... bisa terjadi pada \"hari ini\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390519
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711390519,
					"content": "Aku ingin melihat Guili Assembly, lalu ke Pelabuhan Liyue. Melihat orang-orang di sana, yang katanya menyenangkan dan baik, juga bertemu Herblord ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390520
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711390520,
					"content": "Perlu diantar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390521
					]
				},
				{
					"id": 711390521,
					"content": "Ya! Paimon ingat kamu pernah bilang \"tidak bisa berlama-lama di luar air\" dan \"harus tinggal di dalam Alam Poci jika ingin bepergian jauh\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390522
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711390522,
					"content": "Hehe ... terima kasih karena sudah ingat, dan terima kasih juga karena sudah mau bantu. Tapi aku masih mau diam di Lembah Chenyu dulu untuk sementara, menikmati pemandangan dan suasana kampung halaman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390523
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711390523,
					"content": "Yah, kalau mau bepergian jauh ... mungkin tunggu sampai Mao tumbuh dewasa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390524
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711390524,
					"content": "Kelamaan gila!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390525
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711390525,
					"content": "Bercanda kok! Yah, pokoknya aku mau diam di sini dulu untuk sementara, sambil membujuk Lingyuan agar mau ikut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390526
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711390526,
					"content": "#Oh ya! {NICKNAME}, satu hal lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390527
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711390527,
					"content": "Kamu melakukan banyak sekali untuk membantu aku dan Lingyuan. Sekarang kekuatan Adeptus perlahan-lahan pulih, jadi izinkan aku memberkati kalian agar selalu terlindungi sepanjang perjalanan ke depan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390528
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711390528,
					"content": "Hehe, sudah ya! Beres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390529,
						711390530
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711390529,
					"content": "Terima kasih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390532
					]
				},
				{
					"id": 711390532,
					"content": "#Baiklah ... terima kasih sekali lagi, {NICKNAME} dan Paimon. Untuk semua yang kalian lakukan bagi Lembah Chenyu dan aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711390530,
					"content": "Kok enggak kerasa apa-apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390531
					]
				},
				{
					"id": 711390531,
					"content": "Ah, \"nasib baik\" bukan sesuatu yang kasat mata!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390532
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711390514,
					"content": "Senang bisa membantu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390515
					]
				},
				{
					"id": 711390503,
					"content": "#{M#Tuan Muda}{F#Nona Muda} ini memanglah mahir dan berbakat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390504
					]
				},
				{
					"id": 711390504,
					"content": "Eh, sudah, sudah, jangan diterusin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390505
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7113906,
