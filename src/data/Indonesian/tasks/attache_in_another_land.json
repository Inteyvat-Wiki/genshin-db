			},
			"dialogs": [
				{
					"id": 230020301,
					"content": "Bagus, sudah cukup. Jamur ini kelihatannya lumayan bagus juga ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020302
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020302,
					"content": "Ini bayarannya, terima kasih atas bantuannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020303
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020303,
					"content": "Ini sudah dipotong pajak?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020304
					]
				},
				{
					"id": 230020304,
					"content": "Tentu saja sudah. Tenang saja, aku tidak mungkin membiarkan Anda kembali ke Inazuma hanya untuk membayar pajak.",
