			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hanbei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230020101,
					"content": "Sepertinya kualitas jamur di toko ini lumayan bagus, masukkan ke daftar belanja saja dulu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020102
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020102,
					"content": "Hanbei? Nama ini familier banget, kayaknya Paimon pernah dengar orang panggil nama ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020103,
						230020104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230020103,
					"content": "A ... apa jangan-jangan orang di Tatarasuna ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020105
					]
				},
				{
					"id": 230020105,
					"content": "Wah! Dia yang buat Mikage Furnace jadi kacau balau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020106,
						230020107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230020106,
					"content": "Seharusnya dia di sini jadi Atase Luar Negeri ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020108
					]
				},
				{
					"id": 230020108,
					"content": "Ternyata dia benar-benar datang ke Sumeru, Paimon kira \"Atase Luar Negeri\" itu cuma candaan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230020109,
					"content": "Eh? Berambut emas ... makhluk kecil yang terbang di sebelahnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020110
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020110,
					"content": "Jangan-jangan kamu si \"Pengembara\" itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020111,
						230020112
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020111,
					"content": "Benar, itu aku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020114
					]
				},
				{
					"id": 230020114,
					"content": "Haha, ternyata benar. Yousuke pernah menyebut kamu dalam suratnya. Dia bilang kamu dan Tuan Xavier sama-sama mengurus \"Mikage Furnace\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020115
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020115,
					"content": "Heh, aku benar-benar merasa bersalah, saat Anda dan Tuan Xavier memperbaiki \"Mikage Furnace\", aku malah sibuk dengan berbagai masalah administratif ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020116
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020116,
					"content": "Jadi pekerjaan administratif lebih penting dari Mikage Furnace ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020117
					]
				},
				{
					"id": 230020117,
					"content": "Prioritasmu salah total!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230020118,
					"content": "Tunggu dulu, kalau berkas administratif tidak diurus dengan baik, mana mungkin perbaikan Mikage Furnace bisa selesai dengan lancar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020119
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020119,
					"content": "Lihat ya, evakuasi orang-orang di sekitar, persiapan memperbaiki barang, pengarahan sumber daya manusia, dan koordinasi berbagai macam aspek permintaan produksi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020120
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020120,
					"content": "Kalau tidak ada dokumen yang mendukung semua, pasti akan jadi kacau balau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020121
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020121,
					"content": "Ternyata sama seperti yang dikatakan Toranosuke ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020122
					]
				},
				{
					"id": 230020122,
					"content": "Reputasimu ternyata tidak tipu-tipu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230020123,
					"content": "Toranosuke ... Dia tidak peduli dengan pekerjaan administratif. Kalau bekerja dengan dia, aku pasti selalu punya banyak pekerjaan bonus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020124
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020124,
					"content": "Tapi, sekarang aku sudah tidak mengelola Mikage Furnace lagi, sekarang aku sudah jadi \"Atase Luar Negeri\" di Sumeru dan bertanggung jawab untuk perdagangan jamur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020125
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020125,
					"content": "Ehm ... Pengembara, aku sudah pernah dengar Yousuke cerita tentang kehebatan Anda, aku rasa ... Anda adalah seseorang yang sangat bisa diandalkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020126
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020126,
					"content": "Apakah Anda bersedia membantuku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020127
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020127,
					"content": "Aku sekarang sedang mencari pemasok jamur yang bisa diandalkan, aku juga sudah menemukan banyak pedagang di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020128
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020128,
					"content": "Mereka selalu menunjukkan contoh jamur pilihan terbaik ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020129
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020129,
					"content": "Aku rasa aku harus ke tempat produksi jamur milik mereka untuk melihat langsung kualitasnya, untuk mempertimbangkan kualitas barang yang mereka sediakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020130
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020130,
					"content": "Tapi seperti yang Anda lihat sendiri, aku sebenarnya tidak punya pengalaman survei di alam liar. Dan kalau aku masuk ke hutan sendiri, aku tidak yakin aku bisa keluar dengan selamat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020131
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020131,
					"content": "Jadi, aku ingin minta bantuan Anda untuk mengumpulkan jamur di hutan, lalu diserahkan padaku. Bagaimana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020132,
						230020133
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020132,
					"content": "Yah, bisa sih ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020134
					]
				},
				{
					"id": 230020134,
					"content": "Anda sudah setuju? Bagus sekali! Tenang saja untuk bayarannya, aku sudah mempersiapkan dokumen kontraknya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020135
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020135,
					"content": "Lihat ini, benar, dokumen ini. Dokumen kontrak ini, termasuk perhitungan bayaran, pemberitahuan tugas dan perjanjian kerahasiaan sudah ada di dalamnya. Oh ya, juga ada peta tempat produksi jamurnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020136
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020136,
					"content": "Kamu dan Hanbei kelelahan setelah memeriksa semua dokumen dengan teliti ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230020137
					]
				},
				{
					"id": 230020137,
					"content": "Bagus, dengan begitu Anda sudah jelas tentang dokumennya. Kalau begitu, aku akan melapor pada Shogunate, setelah mendapatkan persetujuan, aku akan bisa merekrut Anda secara formal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020138
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020138,
					"content": "Tapi sebelumnya, aku akan membayarmu dengan uangku sendiri. Karena pengumpulan jamur tidak boleh ditunda lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020139
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020139,
					"content": "Tentu saja, aku juga akan menuliskan poin ini untuk dilaporkan pada Shogunate, karena gaji darimu juga perlu dilaporkan untuk dipotong pajak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020140
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020140,
					"content": "Waduh ... kalau begitu, aku petik jamur dulu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020141
					]
				},
				{
					"id": 230020141,
					"content": "Eh? Oh ... kalau begitu, mohon bantuannya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020142
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020142,
					"content": "Kita tidak bakal kena masalah lagi, kan? Buat khawatir saja ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020143,
						230020145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230020143,
					"content": "Aku datang untuk memantaunya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020144
					]
				},
				{
					"id": 230020144,
					"content": "Oh ya? Oke, masuk akal juga ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020147
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230020147,
					"content": "Eh? Kenapa ekspresimu tidak tenang begitu ya ... Tenanglah, aku sudah mempersiapkannya dengan baik, Anda tidak akan menemui masalah apa pun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020148
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020148,
					"content": "Kita bukan sedang bahas masalah ini sih ... Eh, intinya, kita pergi ke hutan untuk petik jamur dulu deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230020145,
					"content": "Entah masalah apa lagi yang ditimbulkannya nanti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020146
					]
				},
				{
					"id": 230020146,
					"content": "Hei! Kalau misalnya ada masalah baru, enggak bakal ada orang yang bakal bantu kita di sini loh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020147
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230020133,
					"content": "Tentukan dulu bayarannya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020134
					]
				},
				{
					"id": 230020112,
					"content": "Namanya Paimon ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020113
					]
				},
				{
					"id": 230020113,
					"content": "Paimon, bukan \"makhluk kecil yang terbang\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230020107,
					"content": "Sepertinya dia di sini untuk mengurus perdagangan jamur ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020108
					]
				},
				{
					"id": 230020104,
					"content": "Toranosuke dan Yousuke pernah membahasnya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020105
					]
				}
			]
		},
