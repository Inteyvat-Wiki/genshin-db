					"Alrani"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715551001,
					"content": "Terima kasih banyak. Aku pikir nasibku sudah tamat... Kelompok Treasure Hoarder terus mengikutiku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551002
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551002,
					"content": "Aku baru saja menemukan sesuatu dalam penelitian ini dan berniat untuk menemukan harta karun itu, lalu membawanya pulang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551003
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551003,
					"content": "Namun Treasure Hoarder tiba-tiba menerobos masuk ke kemah dan menculikku, lalu membawaku ke sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551004
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551004,
					"content": "Mereka terus menanyaiku letak harta karun itu. Mereka juga mengancam akan membunuhku bila tidak memberi tahu lokasinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551005
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551005,
					"content": "Tapi aku tahu, kalau aku memberi tahu mereka petunjuk hartu karun, mereka tetap akan membunuhku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551006
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551006,
					"content": "*fuhh* Aku seharusnya mendengarkan kata-kata Soraya. Dia selalu mengingatkanku bahwa seorang arkeolog harus fokus kepada penelitian, bukan pada harta karun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551007
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551007,
					"content": "Tapi aku tidak punya cukup uang, bayaran untuk beberapa tulisan esai bahkan tidak cukup untuk menanggung ongkos perjalananku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551008
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551008,
					"content": "Aku benar-benar tidak bisa membayangkan bagaimana Soraya bisa melakukan penelitian di Liyue begitu lama. Hanya melihat tumpukan naskah dia yang ditolak saja, sudah membuatku merasa lelah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551009
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551009,
					"content": "Apa rencanamu kemudian?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715551010
					]
				},
				{
					"id": 715551010,
					"content": "Masih bisa apa lagi? Aku sudah mengumpulkan bahan-bahan esai. Kalau harta karun... ah, untuk kalian saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551011
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551011,
					"content": "Aku tidak akan basa-basi lagi, harta karun itu terkubur <color=#00E1FFFF>di bawah pohon emas besar</color> di tengah Lingju Pass.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551012
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551012,
					"content": "Ambillah kalau kalian mau. Aku tuliskan lokasinya di sini agar kalian tidak lupa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551013
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551013,
					"content": "Aku mau istirahat sebentar, lalu kembali ke kemah untuk membereskan barang-barangku. Aku harus keluar dari tempat ini sesegera mungkin sebelum Treasure Hoarder menyerangku lagi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551014
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551014,
					"content": "Aku tidak tahu butuh berapa lama waktu baru bisa sampai ke Wangshu Inn. Aku harap sesampainya di sana, Soraya masih belum pergi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551015
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551015,
					"content": "*fuhh* Seandainya Nona Soraya mau menjadi guru pembimbingku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alrani"
				}
			]
		},
