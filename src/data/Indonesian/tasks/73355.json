			"dialogs": [
				{
					"id": 733550201,
					"content": "Hmm? Sepertinya tidak perlu meninggalkan pesan di Adventurers' Guild. Takdir akan selalu mempertemukan kita kembali ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550202
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 733550202,
					"content": "Kita bertemu lagi, \"Komet Emas\" dan \"Bintang Kejora\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550203
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 733550203,
					"content": "Kalian yang bersinar dan penuh semangat membuatku merasa waktu telah berhenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550204,
						733550208
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 733550204,
					"content": "Lama tak berjumpa, Haniyyah!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733550205
					]
				},
				{
					"id": 733550205,
					"content": "Ternyata benar-benar kalian, Haniyyah dan Topi Gendang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550206,
					"content": "Pantes Paimon terasa familier banget pas baca pesannya ... berarti Paimon dan Topi Gendang masih sedekat dulu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550207,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550212
					],
					"speakerTitle": "Topi Gendang"
				},
				{
					"id": 733550212,
					"content": "Aku sudah membayangkan banyak cara untuk merayakan reuni kita, seperti pesta makan besar, atau sambutan yang kreatif untuk memberi kalian kejutan besar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550213
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 733550213,
					"content": "Tapi semua itu terasa terlalu formal. Karena kalian juga sangat sibuk, kurasa ini semua justru akan merepotkan kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550214
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 733550214,
					"content": "Lagi pula, teman-teman Fungus kita juga lebih suka ketenangan, jadi mari kita rayakan reuni ini dengan santai dan sederhana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550215
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 733550215,
					"content": "Betul! Esai-esai yang dibaca Haniyyah benar-benar berguna. Ketenangan pikiran itu memang bagus untuk hidup!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550216
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 733550216,
					"content": "Seperti ini, mengobrol santai adalah hal yang paling menyenangkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550217
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 733550217,
					"content": "♫~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550218
					],
					"speakerTitle": "Pyro Sukacita"
				},
				{
					"id": 733550218,
					"content": "Nona Souka juga ada di sini! Ada juga Pyro Sukacita, dan ... siapa nih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550219,
					"content": "Ini teman Fungus aku, Penari Badai! Waktu itu, kamu dan Topi Gendang mengalahkan kami di babak 32 besar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550220
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 733550220,
					"content": "Ehehe, kamu masih ingat ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550221,
						733550222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550221,
					"content": "Aku sudah mulai teringat lagi ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733550223
					]
				},
				{
					"id": 733550223,
					"content": "Intinya, seperti yang kalian lihat, kita tidak perlu janjian untuk bertemu kembali ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550224
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 733550224,
					"content": "Haniyyah dan aku sudah beli area perdagangan ini dan mengubahnya menjadi Taman Fungus Kecil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550225
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 733550225,
					"content": "Tunggu, jadi maksudmu bukan disewa untuk permainan di atas meja yang baru, tapi untuk ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550226,
					"content": "Betul. Mulai sekarang, kami akan menetap di Pelabuhan Bayda, mempromosikan permainan di atas meja milik Fungus, dan teori berkomunikasi dengan hewan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550227
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 733550227,
					"content": "Silakan mampir dan main dengan teman-teman Fungus kapan pun kalian punya waktu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550228
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 733550228,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550229,
						733550230
					],
					"speakerTitle": "Topi Gendang"
				},
				{
					"id": 733550229,
					"content": "Hore! Teman Fungus!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733550231
					]
				},
				{
					"id": 733550231,
					"content": "I-i-ini salah satu kabar terbaik yang Paimon dengar hari ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550232,
					"content": "Setelah Turnamen Fungus pertama, Paimon udah mikirin banyak ide main sama Topi Gendang, akhirnya kesampaian juga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550233,
					"content": "Sayangnya kita enggak siapkan camilan untuk teman Fungus ... Paimon mau peluk teman Fungus sambil makan sepuasnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550234,
					"content": "Tidak perlu khawatir, aku sudah mempelajari makanan kesukaan Fungus melalui penelitian \"Ciri Khas Spesies Fungus\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550235
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 733550235,
					"content": "Tujuan aku adalah menemukan bahan makanan yang cocok untuk manusia dan Fungus, jadi teman-teman kita tidak perlu mengonsumsi berbagai rasa Marvelous Jelly sepanjang tahun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550236
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 733550236,
					"content": "Suatu hari nanti, aku pasti akan menemukan bahan yang cocok, dan merancang hidangan lezat yang bisa kita nikmati bersama!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550237
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 733550237,
					"content": "Nanti biar aku yang jadi koki utamanya! Aku tidak mau Haniyyah membakar panci kesebelas kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550238
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 733550238,
					"content": "Jadi, hari di mana kita duduk dan makan sama teman Fungus enggak lama lagi kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550239,
						733550240
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550239,
					"content": "Kalau begitu, kami akan menunggu kabar baik kamu, Haniyyah!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733550241
					]
				},
				{
					"id": 733550241,
					"content": "Kalau begitu, sering-sering mampir ke Taman Fungus Kecil ya! Kami dan teman-teman Fungus akan selalu menunggumu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550242
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 733550242,
					"content": "Siapa tahu kejutannya datang lebih cepat dari yang dibayangkan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550243
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 733550243,
					"content": "♪!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Topi Gendang"
				},
				{
					"id": 733550240,
					"content": "Kami menantikan hidangan Souka!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733550241
					]
				},
				{
					"id": 733550230,
					"content": "Sekarang kita sudah bisa sering-sering ketemu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733550231
					]
				},
				{
					"id": 733550222,
					"content": "Suasana yang hangat dan ramah membuatku merasa rileks ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733550223
					]
				},
				{
					"id": 733550208,
					"content": "Meskipun aku tidak begitu ingat, tapi halo semua!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733550209
					]
				},
				{
					"id": 733550209,
					"content": "Iya, itu Haniyyah dan Topi Gendang! Teman yang kita kenal dari Turnamen Piala Nilotpala untuk Pawang Penjinak waktu itu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550210,
					"content": "Paimon ingat kita ketemu mereka di sekitar Port Ormos dan di Court of Fontaine! Udah lama banget ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550211,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550212
					],
					"speakerTitle": "Topi Gendang"
				}
			]
		}
	]
