			"dialogs": [
				{
					"id": 733550101,
					"content": "Hei, di sana ada Fungus yang baru saja lewat. Enggak papa kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550102,
					"content": "Biasanya bahaya kan kalau ada Fungus yang aktif di kota? Kecuali yang udah dilatih dan dijinak ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550103,
					"content": "Tunggu dulu, kok rasanya familier? Kita udah pernah ngalamin kejadian ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550104,
						733550107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550104,
					"content": "Tunggu, apa itu Topi Gendang?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733550105
					]
				},
				{
					"id": 733550105,
					"content": "Iya! Topi Gendang! Teman Fungus kita di Sumeru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550106,
					"content": "Woahhh! Udah lama banget kita enggak ketemu! Ayo kita ke sana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550107,
					"content": "Kasus spesial apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733550108
					]
				},
				{
					"id": 733550108,
					"content": "Kayaknya itu ... Topi Gendang? Teman Fungus kita di Sumeru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550109
					],
					"speakerTitle": "Paimon"
