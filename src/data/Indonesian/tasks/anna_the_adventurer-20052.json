			"dialogs": [
				{
					"id": 200520301,
					"content": "Pengembara, tolong jaga Anna ya. Belakangan dia terlihat sangat bersemangat dan menggebu-gebu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200520302
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200520302,
					"content": "Kamu tidak mau dia jadi petualang?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200520303
					]
				},
				{
					"id": 200520303,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200520304
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200520304,
					"content": "Aku menghormati impian adikku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200520305
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200520305,
					"content": "Dia akhirnya sembuh dengan susah payah, dan dia juga mendapat kesempatan untuk mengejar impiannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200520306
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200520306,
					"content": "Sebagai kakaknya, a-aku akan mendukungnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200520307
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200520307,
					"content": "Hanya itu yang bisa kulakukan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				}
			]
