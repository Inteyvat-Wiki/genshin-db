			"dialogs": [
				{
					"id": 200520101,
					"content": "Baik, hari ini aku juga akan berusaha keras untuk menyelesaikan misi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200520102,
						200520106
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200520102,
					"content": "Semangat sekali kamu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200520103
					]
				},
				{
					"id": 200520103,
					"content": "Tentu dong. Jadi petualang itu menyenangkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200520104
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200520104,
					"content": "Tapi ... hehe, masih banyak hal yang tidak kuketahui waktu aku mengerjakan misi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200520105
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200520105,
					"content": "Pengembara, bisakah kamu menemaniku mengerjakan misi? Aku masih ada banyak hal yang perlu bimbinganmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200520108
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200520108,
					"content": "Kalau begitu, ayo kita berangkat. Misi hari ini adalah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200520109
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200520109,
					"content": "Hmm ... lagi-lagi mengantar dan mengawal kargo balon udara ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				},
				{
					"id": 200520106,
					"content": "Bagaimana kalau kutemani kamu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200520107
					]
				},
				{
					"id": 200520107,
					"content": "Wah, sungguh? Hehe, kebetulan aku punya banyak pertanyaan yang ingin kutanyakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200520108
					],
					"speakerTitle": "Anna"
				}
			]
		},
