			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Aberaku",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722490301,
					"content": "Namaku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490302
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490302,
					"content": "Aberaku, sang pencipta Helios!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490303
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490303,
					"content": "Hah, Helios itu apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722490304,
					"content": "Sesuatu yang hebat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722490305,
					"content": "Sangat hebat! Akulah yang mengatur pembangunan Helios dengan kekuatan seluruh bangsa di belakangku, agar kami bisa melawan Dragonheir of the Depths.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490306
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490306,
					"content": "Jasa tak tertandingi ini tidak bisa dilakukan oleh siapa pun di Byakuyakoku — tidak ada lagi selain aku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490307
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490307,
					"content": "Wah. Boleh juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722490308,
					"content": "Tapi mengapa orang hebat seperti itu dikurung di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722490309,
					"content": "Aku ... aku dikhianati ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490310
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490310,
					"content": "Ketika kerajaan langit jatuh ke kedalaman tanpa dasar, orang-orang dicelakai naga, lalu aku — ya, aku — mulai membangun Helios untuk menyelamatkan semua dari nasib.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490311
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490311,
					"content": "Tapi ... bajingan-bajingan itu! Saat hidup mereka tidak lagi dalam bahaya, mereka mulai menipu dan berbohong. Mereka bahkan menganjurkan untuk menempatkan bayi di atas takhta. Menggelikan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490312
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490312,
					"content": "Bahkan aku pun dijadikan target rencana mereka, dan dibiarkan membusuk di penjara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490313
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490313,
					"content": "TERKUTUK! TERKUTUKLAH MEREKA!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490314
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490314,
					"content": "Oh ya, kamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490315,
						722490317
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490315,
					"content": "Eh? Aku?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722490316
					]
				},
				{
					"id": 722490316,
					"content": "Ya, kamu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722490320,
					"content": "Memang kamu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490321
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490321,
					"content": "Jubah suci aku pernah ditempatkan di sini, tetapi semuanya telah membusuk selama bertahun-tahun, dan tidak bisa lagi dipakai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490322
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490322,
					"content": "Tapi jika kamu lulus ujian, aku akan memberikan sesuatu yang sudah bersarang di pikiranku kepadamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490323
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490323,
					"content": "Aku berdoa untuk ... keberhasilanmu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490324
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490324,
					"content": "Hal ini sangat berbahaya. Beri tahu aku jika kamu telah siap, wahai Pengembara, lalu akan kita mulai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490317,
					"content": "Paimon, kurasa yang dia maksud adalah kamu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722490318
					]
				},
				{
					"id": 722490318,
					"content": "Tidak, dia jelas-jelas melihatmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722490319,
					"content": "(Dan dia melihatmu dengan tatapan hangat.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490320
					],
					"speakerTitle": "Paimon"
				}
			]
		},
