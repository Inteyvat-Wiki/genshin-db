			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aberaku",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722490201,
					"content": "He-Hebat sekali! Mungkin kamu benar-benar bisa melakukannya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490202
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490202,
					"content": "Kalau begitu kumohon padamu, bawalah barang-barang ini semuanya ... harus ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490203
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490203,
					"content": "Kamu harus membawanya ke ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490204
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490204,
					"content": "Ke ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490205
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490205,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722490206,
					"content": "Aduh, suaranya makin lama makin tidak jelas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722490207,
					"content": "Bawa semuanya ... ke tempat keramat ... gabungkan bagian-bagian jiwaku, agar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490208
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490208,
					"content": "Halo, Tuan Roh Gentayangan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722490209,
					"content": "Karena ... karena ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490210
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490210,
					"content": "Agar apa tadi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722490211,
					"content": "Agar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490212
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490212,
					"content": "Duh, omongan orang ini tidak jelas deh! Tapi tadi Paimon dengar sepertinya kita harus bawa barang-barang ini ke suatu tempat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722490213,
					"content": "Sepertinya seserahan ini sudah lama sekali ada di sini. Siapa tahu ada yang bisa dimakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722490214,
					"content": "Lebih baik jangan dimakan sama sekali.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722490215
					]
				},
				{
					"id": 722490215,
					"content": "He-Hei! Paimon kan juga pilih-pilih makanan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722490216,
					"content": "#{NICKNAME}, kita bawa semuanya saja lah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7224903,
			"completionStepIds": [
				7224905
			],
			"beginWay": "TALK_BEGIN_MANUAL",
