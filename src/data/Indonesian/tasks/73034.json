			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 730340601,
					"content": "Hmm, surat ini kayaknya ditulis sama Collei. Yuk kita baca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730340602,
					"content": "Tapi dia kok masih belum pulang ya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730340603
					]
				},
				{
					"id": 730340603,
					"content": "Mungkin lagi pergi kerja bareng Tighnari lagi. Mereka kayaknya sibuk terus ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730340604,
					"content": "Ayo cepat baca suratnya. Lihat coretan tangan ini, Collei pasti pakai tenaga waktu nulis surat ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730340605,
					"content": "#\"{NICKNAME} dan Paimon, terima kasih ya sudah membantuku merawat bunga ini.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730340606,
					"content": "\"Terlalu banyak hal yang harus diselesaikan akhir-akhir ini di hutan, aku jadi lupa mengurusnya begitu sudah sibuk.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730340607,
					"content": "\"Sekali lagi, terima kasih bantuannya, nanti kalau aku sudah senggang, kita ke tempat Tuan Jahangir untuk makan 'Potato Boat' ya!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730340608,
					"content": "Oh! Lihat, Collei bilang dia mau traktir kita makan! Paimon harus catat ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730340609,
					"content": "Entah deh Collei sebenarnya sibuk ngapain. Tapi kerjaannya memang kelihatannya enggak beres-beres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730340610,
					"content": "Semoga saja dia masih sempat istirahat, enggak sampai kecapekan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
