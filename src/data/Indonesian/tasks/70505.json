			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Diluc"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705050201,
					"content": "Hmm, lumayan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050202
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050202,
					"content": "Kuncinya ada di bahannya! Kalau buahnya segar dan banyak sarinya, minumannya juga pasti enak dan manis dong! Enggak usah ditambah apa-apa lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705050203,
					"content": "Berarti aku harus mengucap syukur untuk tanah di Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050204
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050204,
					"content": "Kebetulan Gray Valley Sunset adalah minuman pertama yang pernah kubuat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050205
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050205,
					"content": "Sewaktu kecil dulu, ayah memberiku bahan-bahan dan memintaku bereksperimen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050206
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050206,
					"content": "Dia tidak memberikan ketentuan, maupun petunjuk apa pun. Kalau diingat-ingat, mungkin dia sebenarnya cuma ingin tahu sejauh apa kreativitasku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050207
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050207,
					"content": "Pada akhirnya, aku membuat jus. Mirip dengan yang satu ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050208
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050208,
					"content": "Oh? Kenapa jus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705050209,
					"content": "Ayahku juga kaget. Aku tidak pikir panjang, cuma merasa kalau hasilnya pasti manis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050210
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050210,
					"content": "Aku waktu kecil dulu sungguh naif.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050211
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050211,
					"content": "Tidak juga ah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705050212
					]
				},
				{
					"id": 705050212,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050213,
						705050214
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050213,
					"content": "Aku yakin ayahmu juga merasa minuman buatanmu enak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705050215
					]
				},
				{
					"id": 705050215,
					"content": "Aku tidak pernah memikirkannya. Ayahku memang tidak berkata apa-apa ketika itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050216
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050216,
					"content": "Tapi, terima kasih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050217
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050217,
					"content": "Oh, ada lagi. Ada sesuatu yang mau kuberikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050218
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050218,
					"content": "Tapi kurasa harus tunggu sampai kamu punya lebih banyak pengalaman sebagai bartender. Aku yakin kamu pasti bisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050219
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050219,
					"content": "Paimon juga ... bakal dukung kamu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705050220,
					"content": "Baiklah. Kunantikan kinerja kalian. Sampai jumpa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050221
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050221,
					"content": "Datang lagi ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705050214,
					"content": "Dia pasti suka sekali.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705050215
					]
				}
			]
		}
	]
}