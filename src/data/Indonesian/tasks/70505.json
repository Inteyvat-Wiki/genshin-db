			},
			"dialogs": [
				{
					"id": 705050101,
					"content": "Wah! Ada Bos Diluc! Tumben, hari ini enggak ada kerjaan ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705050102,
					"content": "Aku? \"Enggak ada kerjaan\"? Mana mungkin? Kudengar kalian sedang belajar jadi bartender. Jadi aku datang saja, sekalian lihat kerja kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050103
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050103,
					"content": "Waduh, berita cepat sekali menyebar ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705050104,
					"content": "#Nah, {NICKNAME}. Bagaimana rasanya jadi bartender? Suka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050105
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050105,
					"content": "Kami baru saja mulai ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705050106
					]
				},
				{
					"id": 705050106,
					"content": "Yah, ini masih terlalu awal sih. Kami belum bisa berkomentar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705050107,
					"content": "Katakan saja perasaan kalian waktu pertama mulai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050108
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050108,
					"content": "Tegang? Bingung? Apa saja. Bagaimana rasanya jadi bartender?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050109,
						705050110
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050109,
					"content": "Pengalaman baru sih, pastinya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705050111
					]
				},
				{
					"id": 705050111,
					"content": "Begitu ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050112
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050112,
					"content": "Loh, kok enggak tanya Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705050113,
					"content": "Perasaan Paimon ... minumannya enak semua!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705050114,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050115
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050115,
					"content": "Baguslah kalau begitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050116
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050116,
					"content": "Bisa buatkan aku Gray Valley Sunset? Porsinya terserah kamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050117
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050117,
					"content": "Oke, tunggu sebentar ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705050118
					]
				},
				{
					"id": 705050118,
					"content": "Bagus. Santai saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Diluc"
				},
				{
					"id": 705050110,
					"content": "Lumayan sibuk juga ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705050111
					]
				}
			]
		},
		{
			"id": 7050502,
			"completionStepIds": [
				7050503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
