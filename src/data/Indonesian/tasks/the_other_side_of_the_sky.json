			},
			"dialogs": [
				{
					"id": 751360501,
					"content": "Oh, kita berhasil! Tapi kenapa masih ada Ukiran Berwarna? Apa jangan-jangan ini Giok Kepulangan yang asli?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360502,
					"content": "Tunggu dulu, ini Cakram Emas Ultimatum? Persis sama kayak yang di tablet batu dulu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360503,
					"content": "Fuwaaa ... nguk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360504
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751360504,
					"content": "Wah, gila!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360505
					]
				},
				{
					"id": 751360505,
					"content": "Benda pusaka yang bisa menekan kotoran Abyss sama barang yang bisa menghalau kutukan dan bencana ... memang mirip sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360506,
					"content": "Lah, baru sadar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360507
					]
				},
				{
					"id": 751360507,
					"content": "HEH! Maksudnya apa? Sudah tahu dari dulu? Terus kenapa enggak bilang?! Jangan dijawab kalau mau ngomong \"pengalaman bertualang\" lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360508,
					"content": "Benda pusaka yang bisa menekan kotoran Abyss sama barang yang bisa menghalau kutukan dan bencana ... memang mirip sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360509,
					"content": "Tapi ini serius bisa buat menahan Abyss di Ochkanatlan? Paimon enggak pernah dengar orang Asosiasi Relik Saurian ngomong apa-apa tentang itu deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360510,
					"content": "Tapi ya, kalau Giok Kepulangan memang sama dengan Cakram Emas Ultimatum ... apa berarti kita diincar naga jahat tuh gara-gara benda ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360511,
					"content": "Fiuh, berarti bukan karena Paimon tadi pagi makan semur ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360512,
					"content": "Benang merahnya mulai kelihatan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360513
					]
				},
				{
					"id": 751360513,
					"content": "Memang betul pertandanya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360514
					]
				},
				{
					"id": 751360514,
					"content": "Hmm, tapi si Bona kayaknya belum tahu soal Cakram Emas Ultimatum ... Bona?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360515,
					"content": "Ada yang salah ... aku yakin pernah ke sini sebelumnya. Tonatiuh, dan Giok Kepulangan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360516
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360516,
					"content": "Iya ... hancurkan ... tidak boleh ... jatuh ke tangannya ....",
