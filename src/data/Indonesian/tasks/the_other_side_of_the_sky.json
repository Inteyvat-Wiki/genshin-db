			"dialogs": [
				{
					"id": 751360201,
					"content": "Apaan lagi ini? Bentuknya kayak Pyrophosphorite, tapi nyala dan keluar api. Kayaknya lebih kuat dari yang punya Bona nih.",
					"roleType": "TALK_ROLE_NPC",
