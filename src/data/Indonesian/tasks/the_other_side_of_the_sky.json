					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360203,
					"content": "AUW!!! PANAS!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360204
					]
				},
				{
					"id": 751360204,
					"content": "WOI, BESTIE! Jangan pegang-pegang sembarangan! Umur berapa sih?!",
