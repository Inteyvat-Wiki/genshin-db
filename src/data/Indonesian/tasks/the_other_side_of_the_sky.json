					"nextDialogs": [
						751360205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360205,
					"content": "Aku enggak ngeh ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360206
					]
				},
				{
					"id": 751360206,
					"content": "Ngaca!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360207
					]
				},
				{
					"id": 751360207,
					"content": "Fuwaaa! Nguk!",
