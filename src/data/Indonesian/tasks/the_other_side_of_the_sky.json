			"dialogs": [
				{
					"id": 751360401,
					"content": "Uhh, kenapa sudah sampai di Tonatiuh juga masih harus cari batu sih? Kirain bakal lebih seru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360402
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360402,
					"content": "Pokoknya, aku serahkan masalah batu api ini pada kalian. Kalau kalian butuh sesuatu, panggil saja aku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bona"
				}
			]
		},
