					"nextDialogs": [
						751360208
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751360208,
					"content": "#Apa, {REALNAME[ID(2)|SHOWHOST(true)]}? Kamu tahu sesuatu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360209,
					"content": "#Wah, {REALNAME[ID(2)|SHOWHOST(true)]}! Ini waktunya kamu bersinar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360210,
					"content": "#Oke, harta karun yang panas-panas gini bagiannya {REALNAME[ID(2)|SHOWHOST(true)]}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360211,
					"content": "NGUK! Fuwaa.",
