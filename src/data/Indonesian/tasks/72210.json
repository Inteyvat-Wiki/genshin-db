			},
			"dialogs": [
				{
					"id": 722100401,
					"content": "Kalian sudah menemukannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100402
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100402,
					"content": "Yap.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100403
					]
				},
				{
					"id": 722100403,
					"content": "Kamu ini! Kenapa tidak pernah menuruti kata-kataku? Kenapa sih kalian tidak bisa seperti Meshi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100404
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100404,
					"content": "Meshi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100405
					]
				},
				{
					"id": 722100405,
					"content": "Hahaha, kamu benar-benar memberi nama yang artinya bagus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722100406,
					"content": "Miaw, miaw miaw miaw... miaw...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100407
					],
					"speakerTitle": "\"Hachihou\""
				},
				{
					"id": 722100407,
					"content": "Miaw! Miaw miaw!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100408
					],
					"speakerTitle": "\"Konbumaru\""
				},
				{
					"id": 722100408,
					"content": "Jangan membangkang! Kalau tidak, diriku lain kali tidak akan mencarimu lagi, dan membiarkanmu kelaparan dari saat matahari terbit sampai saat bulan terbit, hingga saat matahari menggantung tinggi lagi. Dan diriku akan meninggalkanmu agar kamu cari jalan pulang sendiri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100409
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100409,
					"content": "Miaw...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100410
					],
					"speakerTitle": "\"Konbumaru\""
				},
				{
					"id": 722100410,
					"content": "Hah, anak baik. Bagus, bagus. Bagus kalau sudah pulang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100411
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100411,
					"content": "Diriku ini berutang banyak padamu. Kalau bukan karena bantuanmu, anak-anak bandel ini pasti sudah kelaparan di luar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100412
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100412,
					"content": "Mereka seharusnya bisa pulang sendiri...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100413
					]
				},
				{
					"id": 722100413,
					"content": "Tapi bagaimana pun, diriku sangat berterima kasih padamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100414
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100414,
					"content": "Datang lagi ya kalau kamu ada waktu. Diriku mungkin masih ada banyak urusan yang bisa kamu bantu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
		},
		{
