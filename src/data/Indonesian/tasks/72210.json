						722100302
					],
					"speakerTitle": "\"Konbumaru\""
				},
				{
					"id": 722100302,
					"content": "Wah! Kucing yang galak sekali, hati-hati...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100303,
						722100305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722100303,
					"content": "Miaw, miaw...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100304
					]
				},
				{
					"id": 722100304,
					"content": "Miaw miaw? Miaw...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100307
					],
					"speakerTitle": "\"Konbumaru\""
				},
				{
					"id": 722100307,
					"content": "Hehe, meskipun kelihatannya galak, tapi dia akhirnya membiarkanmu menggendongnya, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722100305,
					"content": "Aku mau bawa kamu pulang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100306
					]
				},
				{
					"id": 722100306,
