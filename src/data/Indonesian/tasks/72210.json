			},
			"dialogs": [
				{
					"id": 722100101,
					"content": "Oh, miaw, miaw... Ke mana mereka...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100102
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100102,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100103
					]
				},
				{
					"id": 722100103,
					"content": "Ah ternyata kamu. Ada beberapa anak bandel yang kabur bermain entah ke mana. Diriku sangat khawatir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100104
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100104,
					"content": "Di luar sana berbahaya sekali. Meskipun diriku sudah mengajarkan mereka berkali-kali. Para makhluk berbulu yang membawa tongkat dan bola-bola air dan api itu tetap saja berbahaya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100105
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100105,
					"content": "Apalagi kalau mereka ke tempat yang penuh setruman, rambut mereka bisa berdiri semua. Diriku tidak tega melihat anak-anak bandel itu mengalaminya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100106
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100106,
					"content": "Tapi selalu saja ada yang tidak menurut lalu pergi berkeliaran. Diriku harus berusaha keras menyeret mereka pulang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100107
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100107,
					"content": "Beberapa dari mereka kabur lagi hari ini. Sungguh mengkhawatirkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100108
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100108,
					"content": "Tolong, diriku butuh bantuanmu untuk mencari Konbumaru dan Hachihou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100109
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100109,
					"content": "Siapa itu Konbumaru...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100110
					]
				},
				{
					"id": 722100110,
					"content": "Dia anak baik. Konbumaru generasi ini sangat pintar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100111
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100111,
					"content": "\"Generasi ini\" katamu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100112
					]
				},
				{
					"id": 722100112,
					"content": "Kadang Hibiki bicara tentang ini. Diriku tidak begitu mengerti, tapi melihat ekspresi Hibiki saat bercerita tentang Konbumaru, pasti ini hal yang baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100113
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100113,
					"content": "Diriku memberi nama kucing-kucing kecil itu dengan arti yang bagus. Dan setelah mereka besar dan pergi, diriku akan menggunakan nama itu untuk anak kucing yang lebih kecil lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100114
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100114,
					"content": "Konbumaru suka tidur di tempat tinggi, mungkin kamu bisa mulai cari dari sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100115
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100115,
					"content": "Jadi, Hachihou itu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100116
					]
				},
				{
					"id": 722100116,
					"content": "Dia bertubuh kecil dan sangat lincah, dia juga sangat suka ikan. Maka dia kadang pergi ke tepi pantai untuk mencari ikan yang terdampar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100117
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100117,
					"content": "Tapi itu sangat bahaya. Air sangat berbahaya. Zaman dulu, dulu sekali, ada seekor ... tanuki? Ia terjatuh ke dalam air dan hampir saja tidak naik ke permukaan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100118
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100118,
					"content": "Kamu mungkin bisa menemukan Hachihou di dekat air laut, sedang mencari ikan atau kepiting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100119
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100119,
					"content": "Lingkupnya terlalu luas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100120
					]
				},
				{
					"id": 722100120,
					"content": "Benarkah? Pokoknya tempat yang tinggi dan dekat air laut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100121
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100121,
					"content": "Eh, bagaimana kalau kita kasih lihat Neko peta kita...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722100122,
					"content": "Kalian ... kurang pandai memahami ya? Ini tempat tingginya, dan ini air lautnya. Mereka pasti ada di sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100123,
						722100125
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100123,
					"content": "Ya, serahkan saja pada kami.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100124
					]
				},
				{
					"id": 722100124,
					"content": "Kalau begitu kuserahkan pada kalian, miaw, miaw. Ah, anak-anak ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100125,
					"content": "Aku bukan ahli menangkap kucing ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100126
					]
				},
				{
					"id": 722100126,
					"content": "Miaw, miaw. Tenang saja. Anak-anak itu tidak takut manusia... Bahkan, bisa dibilang mereka sering berkeliaran karena tidak ada yang mengajak mereka main.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100127
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100127,
					"content": "Kalau begitu kuserahkan pada kalian, miaw, miaw. Ah, anak-anak ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
		},
