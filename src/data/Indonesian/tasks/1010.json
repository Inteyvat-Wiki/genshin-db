			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ekaterina"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10100201,
					"content": "#Selamat datang {NICKNAME}, teman dari Childe. Dan selamat untuk hari pertamamu bersama para Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100202,
						10100203
					],
					"speakerTitle": "Ekaterina"
				},
				{
					"id": 10100202,
					"content": "Aku bukan teman Childe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100204
					]
				},
				{
					"id": 10100204,
					"content": "Kamu terdengar yakin sekali. Ingatlah, kita hanya manusia biasa. Pemikiran kita bagaikan air yang terus berubah bentuk. Hanya Tsaritsa yang memiliki tekad sekokoh bongkahan es.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100205
					],
					"speakerTitle": "Ekaterina"
				},
				{
					"id": 10100205,
					"content": "Mari kita kembali ke topik semula. Childe memberitahuku kalau dia sudah menepati janjinya denganmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100206
					],
					"speakerTitle": "Ekaterina"
				},
				{
					"id": 10100206,
					"content": "Janji? Ah, maksudmu janjinya mencari seseorang ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100207,
					"content": "Benar sekali, Childe berjanji akan menemukan seseorang yang dapat membantumu mencari jalan keluar. Seorang Harbinger tidak akan mengingkari janjinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100208
					],
					"speakerTitle": "Ekaterina"
				},
				{
					"id": 10100208,
					"content": "Ah. Tapi dia di mana ya sekarang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100209,
					"content": "Saat ini Childe berada di <color=#00E1FFFF>Liuli Pavilion</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100210
					],
					"speakerTitle": "Ekaterina"
				},
				{
					"id": 10100210,
					"content": "Liuli Pavilion?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100211
					]
				},
				{
					"id": 10100211,
					"content": "Oooh, oooh! Paimon tahu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100212,
					"content": "*ehem*... Jadi ada dua aliran masak di Liyue, yaitu aliran Li dan aliran Yue. Mereka sudah bersaing selama berabad-abad, tapi sampai sekarang masih belum ada yang bisa dibilang menang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100213,
					"content": "Restoran aliran Li namanya Liuli Pavilion. Pemiliknya buka di Feiyun Slope supaya bisa berhadapan sama Xinyue Kiosk, restoran aliran Yue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100214,
						10100215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100214,
					"content": "Yap, kamu memang ahli makanan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100216
					]
				},
				{
					"id": 10100216,
					"content": "Jangan gitu sama Paimon! Ah, Paimon lapar nih~ Jalan yuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100215,
					"content": "Kalau ngomongin makanan saja baru pintar ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100216
					]
				},
				{
					"id": 10100203,
					"content": "Aku tidak mau gabung dengan Fatui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100204
					]
				}
			]
		},
		{
			"id": 101003,
			"completionStepIds": [
				101003
