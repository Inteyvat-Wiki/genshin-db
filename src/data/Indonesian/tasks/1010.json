			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Childe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10100301,
					"content": "Ah, datang juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100302
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10100302,
					"content": "Sesuai janjiku, aku sudah dapat seseorang yang bisa membantu memecahkan misteri kenapa Liyue Qixing menyembunyikan tubuh Archon Geo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100303
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10100303,
					"content": "Terus dia di mana sekarang? <color=#00E1FFFF>Liuli Pavilion</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100304,
					"content": "Betul. Ayo ikut, biar kuperkenalkan kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100305
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10100305,
					"content": "Aku sudah atur jamuan makan malam, sesuai tradisi bisnis Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Childe"
				}
			]
		},
		{
			"id": 101005,
			"completionStepIds": [
				101005
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101005",
							"2"
						],
						"stepId": 101005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhongli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10100501,
					"content": "Kenalkan, ini Tuan Zhongli, konsultan sebuah organisasi yang bernama Wangsheng ... dan rekan terpercaya kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100502,
						10100503
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10100502,
					"content": "Rekan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100504
					]
				},
				{
					"id": 10100504,
					"content": "Ya, bidang usaha Wangsheng cukup ... sensitif. Anggap saja mereka tahu kapan harus tutup mulut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100505
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10100505,
					"content": "Dan Fatui sangat senang bisa bekerja sama dengan mereka yang berjalan di balik bayangan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100506
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10100506,
					"content": "Ber-Bergerak di balik bayangan?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100507,
					"content": "Suatu kehormatan bisa bertemu. Aku sudah mendengar banyak tentang kalian di Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100508
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100508,
					"content": "Menjaga rahasia ... bergerak di balik bayangan... Ah! Jangan-jangan usaha Wangsheng itu ... \"membereskan\" orang?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100509,
					"content": "Betul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100510
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100510,
					"content": "WAAAAH!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100511,
					"content": "Wangsheng Funeral Parlor mengurus pemakaman. Kami memastikan mereka yang sudah meninggal dapat beristirahat dengan tenang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100512
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100512,
					"content": "Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100513,
					"content": "Haha, kalian kira dia ini pembunuh bayaran ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100514
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10100514,
					"content": "Fatui memang punya banyak rekan di bidang itu, tapi Wangsheng Funeral Parlor bukan salah satunya ... Yah, tampaknya sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100515
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10100515,
					"content": "Tampaknya ya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100516
					]
				},
				{
					"id": 10100516,
					"content": "Yah, mereka ... Ah sudahlah, jangan dibahas. Aku bawa kalian ketemu Tuan Zhongli karena ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100517
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10100517,
					"content": "Karena aku bisa bawa kalian melihat tubuh Rex Lapis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100518
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100518,
					"content": "APA?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100519,
					"content": "Eh, jangan kaget dulu. Tubuh Archon Geo memang sudah disembunyikan atas perintah sang Tianquan, Ningguang. Tapi lebih baik kita dengar dulu komentar Tuan Zhongli deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100520
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10100520,
					"content": "Rex Lapis adalah sang terutama, sang Prime of Adeptus. Tapi Adeptus juga akan mangkat, pada akhirnya ... demikianlah yang sudah terjadi selama ribuan tahun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100521
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100521,
					"content": "Zaman telah berubah, dan kalian pasti turut merasakannya ketika ada di Jueyun Karst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100522,
						10100523
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100522,
					"content": "Memang benar. Para Adeptus menjauhi Liyue.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100525
					]
				},
				{
					"id": 10100525,
					"content": "Seperti yang sudah kalian saksikan, tirai zaman Adeptus sudah akan ditutup, dan zaman manusia akan segera dimulai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100526
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100526,
					"content": "Dahulu kala, tradisi Liyue adalah mengadakan upacara pemakaman besar untuk setiap Adeptus yang mangkat. Namun kali ini Qixing tidak melakukan apa pun untuk memperingati peristiwa ini. Sungguh suatu penistaan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100527
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100527,
					"content": "Yah, mereka kan sibuk cari pembunuhnya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100528
					]
				},
				{
					"id": 10100528,
					"content": "Iya, pembunuhnya juga belum tertangkap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100529
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100529,
					"content": "Pembunuhan atau bukan, Wangsheng Funeral Parlor hanya peduli satu hal: penyambutan tertinggi diberikan untuk dewa yang satu ini, maka semakin tidak pantas bila perpisahan terakhir dirinya tidak dilakukan dengan benar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100530
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100530,
					"content": "Pengembara, Childe sudah menceritakan banyak hal tentangmu. Karena kamu pernah berurusan dengan Archon Anemo, bisakah kamu membantuku mempersiapkan upacara perpisahan untuk Archon Geo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100531,
						10100534,
						10100536
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100531,
					"content": "Biar kupikirkan dulu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100532
					]
				},
				{
					"id": 10100532,
					"content": "#{NICKNAME}, memangnya kita punya pilihan apa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100533
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100533,
					"content": "Betul, dipikirkan lebih lama pun tidak ada gunanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100539
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10100539,
					"content": "Sang Tianquan, Ningguang, melarang siapa pun untuk melihat tubuh Rex Lapis. Yang harus kamu temui demi mencapai tujuanmu, yaitu menemui semua anggota The Seven.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100540
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10100540,
					"content": "Tepat. Kamu hanya bisa melihat Rex Lapis jika mengikuti Rite of Parting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100541
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100541,
					"content": "Tidak ada pilihan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100542
					]
				},
				{
					"id": 10100542,
					"content": "Kalau kita sudah sepakat, ikut aku. Kita akan bahas lebih lanjut sambil jalan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100543
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100543,
					"content": "(Layar hitam. Zhongli keluar)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100544
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100544,
					"content": "Baiklah, tugasku jadi penghubung sudah selesai. Lumayan kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100545
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10100545,
					"content": "Kalian jalan duluan saja, aku nanti. Aku masih mau minum dan ... belajar pakai \"sumpit\" yang menyebalkan ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Childe"
				},
				{
					"id": 10100534,
					"content": "Baiklah, aku bantu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100535
					]
				},
				{
					"id": 10100535,
					"content": "Keputusan yang bijak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100539
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10100536,
					"content": "Childe terlalu banyak bicara.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100537
					]
				},
				{
					"id": 10100537,
					"content": "Oh begitu? Di dunia kami, kata-kata seperti itu artinya kamu mau membungkamku. Menarik, keluarkan pedangmu. Kita—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100538
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10100538,
					"content": "Bercanda, haha. Kita lanjutkan pembicaraannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100539
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10100523,
					"content": "Archon Geo juga Adeptus?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100524
					]
				},
				{
					"id": 10100524,
					"content": "Dewa punya banyak nama. Archon Geo adalah Dewa Kontrak, Dewa Perdagangan, Dewa Perang, Morax, Rex Lapis ... apakah aneh bila dia juga Adeptus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100525
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100503,
					"content": "Wangsheng?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100504
					]
				}
			]
		},
		{
			"id": 101006,
			"completionStepIds": [
