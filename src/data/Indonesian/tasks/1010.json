			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhongli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10100601,
					"content": "Pengembara, setelah kota yang ditinggalkan dewanya, bagaimana perasaanmu mengetahui kalau Archon dan para Adeptus kami selalu ada di sekitarmu, di tanah Liyue ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100602,
						10100605
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100602,
					"content": "Aku lebih suka suasana di Mondstadt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100603
					]
				},
				{
					"id": 10100603,
					"content": "Begitu ya. Kamu tipe yang seperti itu. Tidak buruk juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100604
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100604,
					"content": "Tapi kamu belum merasakan sepenuhnya tiga ribu tujuh ratus tahun sejarah tanah yang selalu dijaga oleh para dewanya, Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100607
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100607,
					"content": "Mengurus Rite of Parting akan menjadi pengalaman yang membuka wawasanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100608
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100608,
					"content": "Liyue adalah bangsa paling makmur di antara ketujuh bangsa, tanah yang dilindungi oleh dewa dan diperintah oleh Qixing. Siasat dan muslihat diplomatik Fatui tidak mempan di tanah ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100609
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100609,
					"content": "Ningguang, salah satu dari Qixing, selalu waspada terhadap para Fatui, mungkin inilah alasan kenapa Childe ingin memanfaatkan koneksi Wangsheng Funeral Parlor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100610
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100610,
					"content": "Hmmm ... Tapi apa untungnya buat Childe kalau kami ikutan Rite of Parting?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100611,
					"content": "Aku tidak tahu, dan tidak ingin tahu. Bagiku Fatui hanyalah sumber dana. Yang kuharapkan adalah agar tradisi Liyue tidak luntur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100612
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100612,
					"content": "(Zhongli menyerahkan sekantong uang)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100613
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100613,
					"content": "Ini uang muka dari Childe. Kalau habis, kamu bisa mencarinya untuk meminta dana lebih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100614
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100614,
					"content": "Waw ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100615,
					"content": "Kalau begitu, ayo kita mulai. Pertama, kita harus mendapatkan <color=#00E1FFFF>Noctilucous Jade</color> terbaik yang layak untuk dewa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100605,
					"content": "Aku lebih suka Liyue.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100606
					]
				},
				{
					"id": 10100606,
					"content": "Ah. Tiga ribu tujuh ratus tahun bersama para dewa, demikianlah sejarah Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100607
					],
					"speakerTitle": "Zhongli"
				}
			]
		},
