			"dialogs": [
				{
					"id": 250220301,
					"content": "Oh? Bagus banget bunganya! Namanya sih keren ya. Hora mau coba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220304
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220304,
					"content": "GROAR!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220305
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250220305,
					"content": "(Hora mengunyahnya dengan hati-hati, mencicipi rasa kelopaknya dengan saksama.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220306
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250220306,
					"content": "Gro-groar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220307
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250220307,
					"content": "Oh! Kelihatannya sih dia suka banget. Tapi kalau cuma makan bunga sih tidak bakal kenyang-kenyang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220308
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220308,
					"content": "Ditambah lagi, jenis bunga ini kelihatannya tidak terlalu murah ... Okelah, pokoknya biar kucatat saja dulu sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220309
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220309,
					"content": "Gimana caranya olah bunga jadi makanan ya? Hmm ... atau bunganya ditaruh di roti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cazcal"
				}
			]
		},
		{
