			"dialogs": [
				{
					"id": 250220401,
					"content": "Wah! Gede banget nih buahnya, kayaknya bisa kenyang nih. Hora, mau coba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220404
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220404,
					"content": "GROAR!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220405
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250220405,
					"content": "(Hora mulai mengunyahnya dengan semangat, sebentar saja, makanannya sudah habis.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220406
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250220406,
					"content": "Groar! groaaar~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220407
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250220407,
					"content": "Haha. Langsung habis tuh. Kamu suka banget ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220408
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220408,
					"content": "Aum, aum! Auuum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220409
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250220409,
					"content": "Oke! Nanti aku langsung cari orang buat tanya-tanya apa ada yang tahu pedagang Inazuma di mana, terus harus borong Lavender Melonnya dulu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cazcal"
				}
			]
		},
		{
