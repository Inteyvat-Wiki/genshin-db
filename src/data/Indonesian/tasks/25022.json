			"dialogs": [
				{
					"id": 250220101,
					"content": "Hmm ... Kayaknya harus coba resep berbeda deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220102
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220102,
					"content": "Groar! groaaar~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220103,
						250220104
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250220103,
					"content": "Ada ide bagus apa lagi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250220106
					]
				},
				{
					"id": 250220106,
					"content": "Aum, aum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220107
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220107,
					"content": "Biasanya sih Hora bisa habisin sebaskom penuh buah ya. Habis itu, dia bakal main seharian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220108
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220108,
					"content": "Tapi sekarang dia cuma makan setengah. Setelah makan, dia cuma duduk saja, tidak mau bergerak sama sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220109
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220109,
					"content": "Aku takut dia sakit. Bahkan sempat sampai ganggu dokter di tengah malam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220110
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220110,
					"content": "Kami berdua begadang buat cari tahu dia kenapa. Ternyata bukan sakit, dia ... cuma hobi bikin repot. Suka pilih-pilih makanan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220111
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220111,
					"content": "Dokter bilang, solusi terbaik adalah mencarikan resep baru untuknya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220112
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220112,
					"content": "Terus dia bilang juga kalau aku bisa coba memutar musik buat Hora waktu dia makan, mungkin itu bisa merangsang nafsu makannya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220113,
						250220114
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220113,
					"content": "Lumayan juga tuh idenya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250220115
					]
				},
				{
					"id": 250220115,
					"content": "Hahaha, ya, dapat sih rekamannya dan Hora juga lumayan suka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220116
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220116,
					"content": "Tapi, waktu Hora melompat dan menggigit rekamannya sampai rusak ... aku terpaksa menghentikan rencana ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220117
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220117,
					"content": "Soalnya, bagi Tepetlisaurus, rekaman yang terbuat dari Obsidian dan Phlogiston itu saja sudah enak banget kan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220118
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220118,
					"content": "Makanya sekarang aku juga terpaksa cari bantuan ke Tirai Daun. Sambil berharap di sana ada yang bisa bantu cariin bahan makanan baru buat dicoba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220119,
						250220120
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220119,
					"content": "Aku bantu carikan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250220121
					]
				},
				{
					"id": 250220121,
					"content": "Serius kamu mau bantu aku? Baik banget! Sobatku di Tirai Daun cuma bisa cari bahan masak di Natlan, tapi kamu pasti bisa cari di luar Natlan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220124
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220124,
					"content": "Tunggu ya. Aku lihat dulu daftar bahan makanan rekomendasi yang dibuat dokter. Dokter itu kan sudah pengalaman, tahu banyak soal hal-hal yang ada di luar Natlan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220125
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220125,
					"content": "Hmm ... katanya kita boleh coba <color=#00E1FFFF>Rainbow Rose, Lavender Melon,</color> dan <color=#00E1FFFF>Qingxin</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220122
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220122,
					"content": "Tolong ya! Kalau sudah dapat bahan masak yang unik, langsung serahkan saja padaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220123
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220123,
					"content": "Groar, grrroar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hora"
				},
				{
					"id": 250220120,
					"content": "Kalau soal itu sih aku jagonya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250220121
					]
				},
				{
					"id": 250220114,
					"content": "Memang ada rekaman kayak gitu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250220115
					]
				},
				{
					"id": 250220104,
					"content": "(Elus Hora.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250220105
					]
				},
				{
					"id": 250220105,
					"content": "Aum, aum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220106
					],
					"speakerTitle": "Hora"
				}
			]
		},
