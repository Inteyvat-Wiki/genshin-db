			"dialogs": [
				{
					"id": 250220501,
					"content": "Ini ... Kalau dicium sih, bunga ini wangi juga ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220504
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220504,
					"content": "Hora, mau cob- Wah! Langsung ditelan ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220505
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220505,
					"content": "(Hora langsung menelan Qingxin itu. Setelahnya, dia mengedipkan mata kepada kalian ....)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220506
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250220506,
					"content": "Hora tiba-tiba berbalik badan dan langsung memakan sisa buah yang ada di sebelahnya, habis hingga buah terakhir.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						250220507
					]
				},
				{
					"id": 250220507,
					"content": "Eh? Kok tiba-tiba nafsu makan Hora balik lagi? Jadi Qingxin ini bisa meningkatkan nafsu makan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220508
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220508,
					"content": "Wah, aku harus diskusi sama dokter nih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cazcal"
				}
			]
		},
