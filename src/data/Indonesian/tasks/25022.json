			"dialogs": [
				{
					"id": 250221201,
					"content": "Oh ya! Ini untukmu. Anggap saja sebagai tanda terima kasih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250221202
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250221202,
					"content": "Berkat bantuanmu, aku bisa menemukan resep yang paling cocok untuk Hora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250221203
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250221203,
					"content": "Hora, makan yang banyak ya, biar cepat gede.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250221204
					],
					"speakerTitle": "Cazcal"
				},
				{
