			"dialogs": [
				{
					"id": 761160101,
					"content": "Heiii, ternyata rekan sehidup semati kami dan Bobik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761160102,
						761160105,
						761160108,
						761160110
					],
					"speakerTitle": "Anezka"
				},
				{
					"id": 761160102,
					"content": "Kalian berdua ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761160103
					]
				},
				{
					"id": 761160103,
					"content": "Akan tinggal di sini untuk sementara waktu. Pintu laboratorium Drzislav sudah rusak, jadi kami harus jaga agar orang-orang jahat itu tidak bisa memanfaatkan kesempatan untuk masuk lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761160104
					],
					"speakerTitle": "Anezka"
				},
				{
					"id": 761160104,
					"content": "Setelah pintunya diperbaiki, atau setelah Desla pulang, mungkin kami akan ikuti teladan kalian, berkelana bareng Bobik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anezka"
				},
				{
					"id": 761160105,
					"content": "Tentang Drzislav ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761160106
					]
				},
				{
					"id": 761160106,
					"content": "Entahlah ... tak tahu juga di mana dia. Tapi kalau kalian ketemu dia, titip salam ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761160107
					],
					"speakerTitle": "Anezka"
				},
				{
					"id": 761160107,
					"content": "Aku ingin ajak dia minum sampai pagi lagi di The Flagship!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anezka"
				},
				{
					"id": 761160108,
					"content": "Tentang Bobik ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761160109
					]
				},
				{
					"id": 761160109,
					"content": "Kangen sama Bobik? Kalau ada waktu, datang ke sini dan mainlah sama dia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anezka"
				},
				{
					"id": 761160110,
					"content": "Sampai jumpa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761160111
					]
				},
				{
					"id": 761160111,
					"content": "Ya, sampai ketemu lagi. Kita ini sahabat yang sudah melalui susah senang bersama!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anezka"
				}
			]
		}
	]
