			"dialogs": [
				{
					"id": 790550101,
					"content": "Ini adalah lokasi yang ditinggalkan untuk adegan singkat \"Kapal yang Hancur\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790550102
					],
					"speakerTitle": "Catatan Studio"
				},
				{
					"id": 790550102,
					"content": "Awalnya, cerita tentang dua Hydro Eidolon jatuh cinta saat menaiki kapal yang rusak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790550103
					],
					"speakerTitle": "Catatan Studio"
				},
				{
					"id": 790550103,
					"content": "Setelah mereka saling mengungkapkan perasaannya masing-masing, mereka berdiri di atas kapal di bawah sinar matahari terbenam. Pemandangannya benar-benar romantis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790550104
					],
					"speakerTitle": "Catatan Studio"
				},
				{
					"id": 790550104,
					"content": "Namun, alasan panggung ini ditinggalkan adalah karena ... dua Hydro Eidolon sebagai aktor terlalu energetik dan tidak bisa berhenti bergerak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790550105
					],
					"speakerTitle": "Catatan Studio"
				},
				{
					"id": 790550105,
					"content": "Hmm, kalau saja aku bisa mengambil adegan saat <color=#00E1FFFF>mereka berdua berada di atas kapal di waktu bersamaan</color>, pasti adegannya bakal sempurna ....",
					"roleType": "TALK_ROLE_NPC",
