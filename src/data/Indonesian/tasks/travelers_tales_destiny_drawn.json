			},
			"dialogs": [
				{
					"id": 727380101,
					"content": "Ya, segitu cukup. Cuma kerjaan bersih-bersih kecil yang cepat dan sederhana ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380102
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380102,
					"content": "Oh, halo~ Kamu datang di saat yang tepat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380103,
						727380104
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380103,
					"content": "Saat yang tepat ... untuk apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727380105
					]
				},
				{
					"id": 727380105,
					"content": "Lihat deh wajahmu, pasti lagi mikir, \"Uhh, dia mau suruh aku kerjakan tugas nyebelin lagi, ya?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380106
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380106,
					"content": "Tenang, aku cuma mau bilang renovasi kuilnya sudah selesai dan sedang bersiap meluncurkan layanan baru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380107
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380107,
					"content": "Aku bahkan belum sempat umumkan apa-apa, tapi kamu sudah muncul duluan. Waktunya pas sekali, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380108
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380108,
					"content": "Lihat kotak persembahan di sebelahku? Sebentar lagi akan ada tempat baru untuk berdoa di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380109
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380109,
					"content": "Bukannya sudah ada slip keberuntungan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727380110
					]
				},
				{
					"id": 727380110,
					"content": "Berbeda dong. Slip keberuntungan kan digunakan untuk meramal nasib, tapi ini ... untuk membuat permohonan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380111
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380111,
					"content": "Tutup saja matamu dan buat permohonan, lalu tuliskan di papan doa dan gantung di rak. Mungkin permohonanmu bisa terkabul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380112
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380112,
					"content": "Boleh minta apa pun, nih?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727380113
					]
				},
				{
					"id": 727380113,
					"content": "Tentu saja. Tapi soal mana yang terkabul, semuanya tergantung para dewa yang menjaga kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380114
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380114,
					"content": "Sayangnya aku hanyalah Guuji tak berdaya yang cuma bisa membantumu dalam urusan duniawi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380115,
						727380116
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380115,
					"content": "Aku tidak keberatan kalau bisa dapat teman baru ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727380117
					]
				},
				{
					"id": 727380117,
					"content": "Kalau memang itu harapanmu, kenapa tidak dicoba saja? Ini, ambil kertas keberuntungannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380118
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380118,
					"content": "Ini sisa dari menulis slip keberuntungan tadi. Ambil saja, buatmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380119
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380119,
					"content": "Tulis harapanmu di sana, siapa tahu lebih manjur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380120
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380120,
					"content": "Beneran nih?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727380121
					]
				},
				{
					"id": 727380121,
					"content": "Memangnya aku pernah bohong sama kamu? Ayo, bocah, waktunya bikin permohonan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380122
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380122,
					"content": "Jangan lupa tulis harapanmu di kertas keberuntungannya, lalu tempelkan di papan doa dan gantungkan di raknya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380123
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380123,
					"content": "Setelah itu, harapanmu akan dikirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380124
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380124,
					"content": "Iya, betul, yang khusyuk dan khidmat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380125
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380125,
					"content": "Yakin bisa terkabul ...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727380126
					]
				},
				{
					"id": 727380126,
					"content": "Baiklah, bocah. Waktunya kembali kerja. Ingat, pasang kuping dan buka mata lebar-lebar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380127
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380127,
					"content": "Mungkin saja orang yang ingin kamu temui sedang asyik makan di kedai ramen ... Nanti bawain juga ya satu mangkok buatku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380116,
					"content": "Aku ingin bertemu lagi dengan teman-teman lamaku ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727380117
					]
				},
				{
					"id": 727380104,
					"content": "Tunggu dulu ... Mau apa ini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727380105
					]
				}
			]
		}
	]
}