			"dialogs": [
				{
					"id": 750711321,
					"content": "Kalian mengalahkan musuh dan membuka kurungan. Si Sumpter Beast kecil melompat keluar sambil teriak kegirangan.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750711301
					]
				},
				{
					"id": 750711301,
					"content": "Wow ... Fyuh! Akhirnya beres. Seru juga ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750711302,
					"content": "Ssh—! Tuh lihat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711303
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711303,
					"content": "*klik*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711304
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711304,
					"content": "Sempurna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711305
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711305,
					"content": "Wow, mereka akur banget ... Padahal tadinya Paimon pikir Sumpter Beast-nya bakal dimakan gitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750711306,
					"content": "Hehe, Tepetlisaurus mungkin kelihatan sangar, tapi aslinya lemah lembut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711307
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711307,
					"content": "Oke, pengambilan fotonya selesai, ini salinan buatmu. Oh, iya, bayaranmu juga ... nih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711308
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711308,
					"content": "*huff* Padahal tadinya kupikir kita bisa ambil foto momen intim antara anak Tepetlisaurus dan induknya — tapi kayaknya Sumpter Beast gerak lebih cepat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711309
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711309,
					"content": "Hehe, ayolah, Sumpter Beast enggak terlalu nyebelin kok. Paimon yakin kamu ngerasa gitu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750711310,
					"content": "Apa yang kupikirkan itu tidak penting — yang penting itu pendapat juri waktu menilai fotografinya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711311
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711311,
					"content": "Tapi ... bahaya juga sih buat Sumpter Beast kecil jalan-jalan si lingkungan Natlan yang asing. Dan aku juga perlu rekan yang bisa bantu aku bawa beberapa barang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711312
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711312,
					"content": "Yah tinggal bawa saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711313
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711313,
					"content": "Loh terus pemilik aslinya gimana ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750711314,
					"content": "Hmph. Salah sendiri ninggalin dia sendiri di tempat bahaya gini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711317
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711317,
					"content": "Ah sudah deh jangan dipikirin! Galeri Fotografi Fontaine, bersiaplah karena aku akan datang! Nanti kalian harus datang juga ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711318
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711318,
					"content": "#Maaf, tapi aku harus pergi dulu dari sini. Sampai jumpa lagi, {NICKNAME}, Paimon, rekan cilikku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711319
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711319,
					"content": "Nguk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711320
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750711320,
					"content": "Terus ... nih tangkap! Kenang-kenangan supaya kamu tidak lupakan aku ya, cilik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
