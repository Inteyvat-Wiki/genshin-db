			"dialogs": [
				{
					"id": 750711101,
					"content": "Eh kamu lihat tidak tuh? Kayaknya makhluk kecil itu menyadari ada sesuatu ... Itu keluarganya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711102
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711102,
					"content": "Dia pergi ke arah sana sendiri! Yuk ikuti — jangan sampai kita kehilangan dia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Magnifico"
