			"dialogs": [
				{
					"id": 750711001,
					"content": "#Haha, {NICKNAME} dan Paimon terkasih, kalian adalah inspirasi dan ... em ... inspirasi cilikku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711002
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711002,
					"content": "#Ah iya, {REALNAME[ID(2)|SHOWHOST(true)]} juga pastinya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711003
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711003,
					"content": "Hah! Siapa yang kamu sebut cilik?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711004
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750711004,
					"content": "Nguk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711005
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750711005,
					"content": "Haha, jangan terlalu dipikirin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711006
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711006,
					"content": "Hmph. Paimon sudah mikirin nih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711007,
						750711011
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750711007,
					"content": "Inspirasi baru lagi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750711008
					]
				},
				{
					"id": 750711008,
					"content": "Iya dong! Tapi ... Hehe, inspirasi baru itu artinya ... aku perlu bantuanmu lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711009
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711009,
					"content": "Enggak masalah sih! Toh kamu selalu bayar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711010
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750711010,
					"content": "Haha, bagus sekali, tentara bayaran kecilku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711017
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711017,
					"content": "Jadi kali ini aku mau ambil foto Tepetlisaurus ... Ssst, kita harus hati-hati, jangan sampai ganggu mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711018
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711018,
					"content": "Ini pertama kalinya aku lihat Saurian begini, tapi aku sudah mengamati dari lama sih ... Mereka benar-benar makhluk yang luar biasa, punya kepribadian unik dengan cangkang yang keras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711019
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711019,
					"content": "Hehe, yang ini bahkan jadi paham beberapa perintah dasar setelah dikasih makan beberapa kali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711020
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711020,
					"content": "Tapi aku tetap butuh bantuanmu, wahai penjinak Saurian, untuk membawanya dan ambil foto saat dia lagi interaksi dengan Tepetlisaurus lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711021
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711021,
					"content": "Hehe, gampang, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711022
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711022,
					"content": "Iya, gampang banget!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711023,
						750711024
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750711023,
					"content": "(Lagian kan bukan kamu yang sibuknya ....)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750711025
					]
				},
				{
					"id": 750711025,
					"content": "Haha, benar, semangat sekali ya! Yuk bantu aku cari Tepetlisaurus kecilku, terus kita bisa mulai deh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711024,
					"content": "(Tidak segampang itu juga sih ...!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750711025
					]
				},
				{
					"id": 750711011,
					"content": "Kamu perlu bantuan buat ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750711012
					]
				},
				{
					"id": 750711012,
					"content": "Mousse ... duh Paimon keburu lapar nih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711013
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750711013,
					"content": "*krucuk* ... *krucuk* ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711014
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750711014,
					"content": "Oh, maksudnya \"inspirasi\", ya? Tapi itu tidak bisa dimakan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711015
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711015,
					"content": "Yah selama kamu bayar, Mora kan jadi makanan juga nantinya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711016
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750711016,
					"content": "Yah terserah kamu deh, Paimon ... Tapi aku memang punya uang, jadi tidak perlu khawatir bakal kerja gratis!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711017
					],
					"speakerTitle": "Magnifico"
				}
			]
		},
