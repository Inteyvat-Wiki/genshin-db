			"dialogs": [
				{
					"id": 732441901,
					"content": "Kapasitor Transformasi Energi ya ... Semoga Benben bisa sembuh setelah kita dapatkan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441902
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441902,
					"content": "Kalau kamu masih belum yakin, aku bisa pergi sama kalian!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441903,
						732441904
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441903,
					"content": "Kamu di sini saja sama Benben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441905
					]
				},
				{
					"id": 732441905,
					"content": "Oke. Kutunggu kabar baiknya ya ... hati-hati!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441904,
					"content": "Kami hanya akan pergi sebentar saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441905
					]
				}
			]
		},
