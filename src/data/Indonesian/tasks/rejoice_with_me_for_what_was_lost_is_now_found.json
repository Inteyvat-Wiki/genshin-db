			"dialogs": [
				{
					"id": 732441001,
					"content": "Lihat, nih si Benben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441002,
					"content": "Untung saja Aderfi tidak sempat membawa Benben pergi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441003
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441003,
					"content": "Atau bisa dibilang semua yang ada di sini masih sama seperti sebelumnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441004
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441004,
					"content": "Apa dia benar-benar pikir bisa menggulingkan Matriark dan kembali ke tendanya dengan aman ...? Dasar bodoh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441005
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441005,
					"content": "Tapi bagus sih, jadinya Benben tidak kenapa-napa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441006
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441006,
					"content": "Kayak gini kok \"enggak kenapa-napa\"? Huu, kasihan si Benben ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441007,
						732441008
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441007,
					"content": "Kok jadi begini ya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441009
					]
				},
				{
					"id": 732441009,
					"content": "Iya, kenapa dia tergeletak di tanah ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441010
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441010,
					"content": "Eh, jadi sebenarnya Benben kenapa? Terakhir kali kita ketemu dia baik-baik saja ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441011
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441011,
					"content": "Setelah pergi dari Khaj-Nisut, Benben secara perlahan mulai melemah ... Sepertinya beberapa komponennya rusak, dan suaranya juga semakin kecil ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441012
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441012,
					"content": "Akhirnya dia tidak bergerak dan bersuara sama sekali. Rasanya seperti melihat kekuatan hidupnya pelan-pelan menghilang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441013
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441013,
					"content": "Waktu itu, tidak ada anggota suku yang tahu Benben kenapa, kecuali Aderfi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441014
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441014,
					"content": "Jadi aku titipkan Benben padanya di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441015
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441015,
					"content": "Kok bisa gini ya ... masak Benben bakal gini terus selamanya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441016
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441016,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441017
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441017,
					"content": "Tapi minimal karena Benben masih ada, aku pasti akan mencari cara untuk memperbaikinya, cepat atau lambat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441018
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441018,
					"content": "Tapi kita tidak tahu harus mulai dari mana ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441019
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441019,
					"content": "Hmmm, coba kupikir-pikir. Aku ingat Aderfi pernah bilang padaku kalau masalah Benben tidak parah, jadi bisa diperbaiki dalam beberapa hari ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441020
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441020,
					"content": "Mengingat kebiasaan Aderfi, dia pasti meninggalkan catatan setelah melakukan penyelidikan. Ayo kita coba cari di sekitar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441021
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441021,
					"content": "Kalau memang masalahnya \"tidak terlalu parah\", mungkin kita bisa perbaiki Benben sendiri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441008,
					"content": "Benben kenapa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441009
					]
				}
			]
