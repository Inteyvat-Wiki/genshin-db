					"Taliesin",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710660701,
					"content": "*uhuk* Maaf, sebagai seorang penyair, aku selalu berusaha dramatis, bereksperimen dengan cerita-cerita baru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660702
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660702,
					"content": "Hehe, sebenarnya cincin itu aku curi dari sarang Weasel Thief beberapa tahun yang lalu ... Kondisinya masih bagus dan terlihat indah, jadi aku simpan saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660703
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660703,
					"content": "Bah, berarti sama hasil nyolong juga kan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710660704,
					"content": "Jelek banget sih istilahnya. Kan bisa bilang kalau aku ... dapat mungut gitu. Biarpun hasil nemu, tapi tetap saja berharga buat aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660705
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660705,
					"content": "Apa ada petunjuk tentang cincin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710660706
					]
				},
				{
					"id": 710660706,
					"content": "Hmm ... Aku dengar di sini sering muncul Weasel Thief. Mungkin mereka yang mencuri cincinku saat aku tidur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660707
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660707,
					"content": "Oh, jadi ada ya orang yang lepas cincin waktu mau tidur....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710660708,
					"content": "Aku tidak pernah dengar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710660709
					]
				},
				{
					"id": 710660709,
					"content": "Paimon sih enggak gitu! Harus mikir dulu dimana taruh cincinnya kan, itu sih namanya ngurangin waktu tidur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710660710,
					"content": "Apa benar ada cincin kecil yang bisa dipakai Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710660711
					]
				},
				{
					"id": 710660711,
					"content": "Huh! Tentu saja ada. Masih banyak yang kamu belum tahu loh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710660712,
					"content": "Sudah, kalian jangan mengomentari kebiasaan hidup orang lain, lalu bicara sendiri tanpa pedulikan mereka! Itu kebiasaan yang jelek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660713
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660713,
					"content": "Pokoknya, kalau mau bantu cari cincin ... Cari dulu apakah ada sarang Weasel Thief, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660714
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660714,
					"content": "Aku dengar kalau Treasure Hoarder mendirikan sebuah kemah yang mencurigakan pada lokasi ini. Aku akan menandainya di peta untukmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660715
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660715,
					"content": "Rumor mengatakan kalau Weasel Thief sering muncul di daerah ini. Mungkin ada kaitannya dengan Weasel Thief yang licik itu ... Silakan kamu pergi ke sana untuk lihat-lihat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660716
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660716,
					"content": "Huh ... Cincin yang dicuri dari sarang Weasel Thief, dicuri balik oleh Weasel Thief. Ya bisa dibilang dia balik ke yang punya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710660717,
					"content": "Paimon, tolong berhenti mengejekku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taliesin"
				}
			]
		},
		{
			"id": 7106608,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
