			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Clitopho"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710660801,
					"content": "Halo, apa akhir-akhir ini terjadi sesuatu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660802
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710660802,
					"content": "Tentang Weasel Thief",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710660803
					]
				},
				{
					"id": 710660803,
					"content": "Oh, maksudmu adalah Weasel Thief di Chasm, 'kan? Haha ... Tadinya aku yang urus, tapi karena aku membuat kekacauan ... Jadi, tidak ada yang perlu kukatakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660804
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710660804,
					"content": "Hmm ... Oh, kalau suruh aku tangkap mereka lagi sih tidak mungkin ... Lagi pula, mereka itu muncul dan hilang seperti hantu. Sulit untuk dikejar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660805
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710660805,
					"content": "Tapi, kalau ada barang seseorang yang dicuri oleh mereka, aku bisa memberikan sedikit petunjuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660806
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710660806,
					"content": "Weasel Thief melatih dan merawat Weasel Thief. Mereka memberi makan mereka di jadwal yang sudah ditentukan. Ada tiga Weasel Thief yang berbeda ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660807
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710660807,
					"content": "Yang paling hebat adalah \"Golden Weasel Thief\", lalu yang paling sering terlihat adalah \"Hoarder Weasel Thief\", dan yang paling bodoh adalah \"Amateur Weasel Thief\". Tapi jadwal munculnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660808
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710660808,
					"content": "Aduh ... Harusnya ada sebuah buku panduan latihan. Jadwal waktunya pun sudah ditulis di sana. Tapi, siapa yang niat menghafalnya. Buku itu harusnya ada di dekat kemah Weasel Thief.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660809
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710660809,
					"content": "Ah! Hampir saja lupa! Kamu harus bersiul untuk panggil mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660810
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710660810,
					"content": "Bersiul?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710660811
					]
				},
				{
					"id": 710660811,
					"content": "Ya, bersiul seperti biasa saja. Tidak perlu berlebihan, yang penting pas waktunya.",
