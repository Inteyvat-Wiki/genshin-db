			"dialogs": [
				{
					"id": 710660101,
					"content": "Eh ... A-Aneh, benar-benar aneh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660102
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660102,
					"content": "Seharusnya masih ada di sekitar sini, mengapa aku tidak dapat menemukannya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660103
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660103,
					"content": "Apa yang terjadi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710660104
					]
				},
				{
					"id": 710660104,
					"content": "Cincinku ... hilang. Cincin itu penting bagiku, tidak boleh hilang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660105
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660105,
					"content": "Seperti apa bentuk cincinmu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710660106
					]
				},
				{
					"id": 710660106,
					"content": "Cincin itu terbuat dari kuningan dan bertatahkan permata berwarna merah yang berkilauan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660107
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660107,
					"content": "Aku memungutnya di dekat kolam lava, yang menurut legenda adalah tempat gugurnya Durin sang naga beracun. Mungkin karena itulah, kilaunya mirip dengan kobaran api hitam ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660108
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660108,
					"content": "Wah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710660109,
					"content": "Legenda mengatakan, orang yang memakainya akan menerima tatapan dari \"Maharaja Abyss\" dan dikejar oleh tentara kegelapannya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660110
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660110,
					"content": "Oh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
