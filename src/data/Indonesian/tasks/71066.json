			},
			"dialogs": [
				{
					"id": 710660301,
					"content": "Benar, yang ini! Terima kasih banyak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660302
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660302,
					"content": "Mohon terima tanda terima kasih ini! Meski tidak banyak ... Tapi kumohon kamu jangan keberatan untuk menerimanya. Aku pasti akan menulis kisah ini menjadi puisi dan menyebarkannya ke semua tempat!",
					"roleType": "TALK_ROLE_NPC",
