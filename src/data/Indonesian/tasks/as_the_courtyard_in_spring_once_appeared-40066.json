			"trigger": {
				"objectNames": [
					"Kaedehara Kazuha",
					"Kaedehara Kageharu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400661101,
					"content": "Maaf aku tidak paham!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661102
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400661102,
					"content": "Kazuha, kamu lupa janji di antara kita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661103
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400661103,
					"content": "Anda yakin mau melepaskan semuanya? Walaupun ... walaupun kita hidup susah, setidaknya Anda masih memilikiku, apa aku tidak bisa membantumu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661104
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400661104,
					"content": "Ketika Anda seusiaku, Anda telah menjadi tangan kanan kakek! Apakah aku terlalu tidak kompeten? Apakah aku mengecewakan Anda? Atau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661105
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400661105,
					"content": "Kazuha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661106
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400661106,
					"content": "... Ugh, ini adalah bukti kegagalanku sebagai seorang ayah karena kamu mengkhawatirkan masalah ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661107
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400661107,
					"content": "Klan Kaedehara sudah banyak berkorban demi menebus kesalahan di masa lalu. Dari generasi kakek buyutmu sampai sekarang, kita belum pernah keluar dari bayang-bayang itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661108
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400661108,
					"content": "Teknik menempa adalah bisnis keluarga kita, tapi kamu harus ingat, bisnis keluarga bukan segalanya untukmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661109
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400661109,
					"content": "Kalau monster yang terluka ingin keluar dari jebakan, dia harus menahan sakit untuk melepaskan kakinya yang tertahan. Kamu mungkin menganggap hal tersebut adalah sesuatu yang merugikan, tapi kalau tidak keluar dari jebakan, dia mungkin akan kehilangan nyawanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661110
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400661110,
					"content": "Sudah cukup, Kazuha. Sebagai kepala klan, aku gagal membangkitkan klan kita. Aku cukup bersyukur bahwa kamu tidak menyalahkanku karena tidak menjadikanmu seorang bangsawan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661111
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400661111,
					"content": "Penderitaan beberapa generasi ini ... mari kita akhiri semuanya sekarang. Mulai sekarang jalanilah hidupmu tanpa beban.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661112
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400661112,
					"content": "Biarkan aku yang menanggung nama buruk karena meninggalkan bisnis keluarga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661113
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400661113,
					"content": "Ayah, jangan begitu, Anda tidak boleh menyandang beban itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661114
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400661114,
					"content": "Jika hari itu tiba, aku akan menanggungnya bersama Anda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661115
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400661115,
					"content": "Tunggu sebentar lagi. Suatu hari nanti Klan Kaedehara akan diwariskan untukku. Pada saat itu, aku akan membereskan masalah ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				}
			]
		},
		{
