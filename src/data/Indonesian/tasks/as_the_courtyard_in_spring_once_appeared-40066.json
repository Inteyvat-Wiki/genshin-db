				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400661701,
					"content": "Sudah diduga, kamu terperangkap di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400661702,
					"content": "Haha, aku sudah terbiasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661703
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400661703,
					"content": "Kita kembali lagi ke labirin alam fantasi, tapi kali ini ada yang berbeda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400661704,
					"content": "Kamu menceritakan apa yang kamu lihat kali ini ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400661705
					]
				},
				{
					"id": 400661705,
					"content": "Suasana hatinya jadi buruk, dan dekorasinya sepertinya sudah usang ... Hm, masuk akal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661706
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400661706,
					"content": "Yang kalian saksikan adalah kemunduran keluarga Kaedehara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661707
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400661707,
					"content": "Tapi, kamu yang ada di alam fantasi cuma kayak bayangan saja, enggak sama dengan yang sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400661708,
					"content": "Benar, aku setuju.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661709
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400661709,
					"content": "Dibandingkan dengan Tuan Kazuha yang sekarang, bayangan dalam ilusi itu terlihat ... tersesat, seperti sedang menghadapi takdir yang berat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661710
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400661710,
					"content": "Memang benar seperti itu. Nasibnya memang berbeban berat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661711
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400661711,
					"content": "Aku sudah dewasa sekarang. Maaf, aku di masa itu masih kekanak-kanakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661712
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400661712,
					"content": "Lama setelah aku meninggalkan Inazuma, hidupku tidak pasti. Tapi aku juga menarik pelajaran dari kehidupan seperti itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661713
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400661713,
					"content": "Kalau saja aku bisa bertemu dengan diriku yang dulu, agar dia bisa mengerti hal ini juga ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661714
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400661714,
					"content": "Perjalanan kehidupan ini masih sangat panjang, dan aku harus terus menjalaninya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				}
			]
		},
