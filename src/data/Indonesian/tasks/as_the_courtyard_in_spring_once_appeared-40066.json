			"dialogs": [
				{
					"id": 400660301,
					"content": "Wah, ruang baru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400660302,
					"content": "Sama seperti sebelumnya, cuma Tuan Kazuha yang tidak ada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660303
					],
