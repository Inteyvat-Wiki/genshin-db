		},
		{
			"id": 4006606,
			"completionStepIds": [
				4006606
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4006606",
							"2"
						],
						"stepId": 4006606,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaedehara Kageharu",
					"Kaedehara Kazuha"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400660601,
					"content": "Baik, begini saja. Ah, Kazuha, kamu datang tepat waktu. Bagaimana menurutmu ukiran batu ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660602
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400660602,
					"content": "Aku suka bentuknya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660603
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400660603,
					"content": "Hehe, ini pemandangan yang aku lihat dari buku. Ada banyak gunung terkenal di negara lain, aku mau ke sana kalau ada kesempatan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660604
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400660604,
					"content": "Anda bisa berangkat kapan pun kalau mau, Ayah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660605
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400660605,
					"content": "Tidak begitu. Aku kepala Klan Kaedehara saat ini, walaupun Klan Kaedehara sudah berbeda sekarang, tapi tetap tidak boleh melupakan hal yang harus dikerjakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660606
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400660606,
					"content": "Tapi ... apa semua setimpal dengan mempertahankan jalan yang dipilih Ayah untuk melakukan semuanya demi bisnis yang jatuh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660607
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400660607,
					"content": "Ayah, aku ... tidak mengerti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660608
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400660608,
					"content": "... Kazuha, aku harap kamu mengingat satu hal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660609
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400660609,
					"content": "Keluarga memang penting, tapi kita tidak bisa terus terikat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660610
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400660610,
					"content": "Keluarga ada karena ada kita di dalamnya. Kalau kita tidak bahagia, bagaimana membuat keluarga bahagia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660611
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400660611,
					"content": "Hal yang terjadi di masa lalu terlalu banyak. Tapi itu tidak boleh menjadi beban anak cucu di generasi selanjutnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660612
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400660612,
					"content": "Kalau suatu hari kamu bosan dengan hidup ini, keluarlah untuk berjalan-jalan. Jangan biarkan hidup menahanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660613
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400660613,
					"content": "Baik, Ayah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				}
			]
		},
		{
			"id": 4006611,
			"completionStepIds": [
				4006611
