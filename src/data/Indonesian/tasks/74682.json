					"Ranjit"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 746820101,
					"content": "Akhirnya kita sampai di sini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820102
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 746820102,
					"content": "Gimana soal mimpi masa kecilmu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746820103
					]
				},
				{
					"id": 746820103,
					"content": "Saat aku sudah dewasa, aku akhirnya paham kenapa para Pelindung Hutan itu langsung cemas begitu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820104
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 746820104,
					"content": "*uhuk* Tapi yah pokoknya aku sudah melakukan yang terbaik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820105
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 746820105,
					"content": "Aku juga sudah belajar kalau kamu tidak boleh bawa buah Pyro Regisvine yang belum diproses ke dekat-dekat Jadeplume Terrorshroom ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820106
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 746820106,
					"content": "Waktu aku mencium bau gosong, sudah terlambat deh. Aku hampir saja tenggelam dalam tumpukan spora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820107
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 746820107,
					"content": "Terkadang kita sering lupa kalau Fungus itu spesies yang beda dari Shroomboar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820108
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 746820108,
					"content": "Oh ya, tapi mereka itu sebenarnya sejenis Fungus juga, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746820109,
					"content": "Iya, terus kalau dijadikan sup juga enak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820110
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 746820110,
					"content": "Oke terus gimana itu soal tantangannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746820111,
					"content": "Aku memang masih belum tahu sih mau masak apa ... Oh! Maksudnya soal \"negosiasi\" ya, oke maaf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820112
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 746820112,
					"content": "Mungkin kalian pernah dengar kisah soal dua penguasa Fontemer Aberrant? Konon Millennial Pearl Seahorse itu makhluk yang sangat \"mulia\" dan \"agung\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820113
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 746820113,
					"content": "Nah sebaliknya, Emperor of Fire and Iron adalah sosok yang keras, kejam, kuat dan brutal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820114
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 746820114,
					"content": "Paimon pikir kamu bakal pilih lawan yang lebih kuat. Bukannya lawan yang lebih kuat bisa bikin ceritanya jadi lebih seru?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746820115,
					"content": "Benar, tapi Emperor kepiting itu cangkangnya kuat banget ... Sementara yang satunya lagi itu cuma kuda laut yang bisa terbang doang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820116,
						746820118
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 746820116,
					"content": "Ngomong-ngomong, kuda laut yang bisa terbang bukannya harusnya disebut Pegasus?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746820117
					]
				},
				{
					"id": 746820117,
					"content": "Tunggu, memang itu pertanyaan yang harusnya kamu pikirin sekarang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746820119,
					"content": "Kalau aku bisa menungganginya walau cuma sekali ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820120
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 746820120,
					"content": "Ya sudah, toh tekadmu kayaknya sudah bulat ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746820121,
					"content": "Toh kita sudah di sini, kan? Kita tidak bisa dong pulang dengan tangan kosong, kalau kamu sudah siap kita langsung berangkat yuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820122,
						746820123
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 746820122,
					"content": "Sudah beres.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 746820123,
					"content": "Aku masih ada urusan lain. Dadah!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746820124
					]
				},
				{
					"id": 746820124,
					"content": "Tidak masalah. Aku akan tunggu di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 746820118,
					"content": "Yah bagiku sih tidak ada bedanya ya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746820119
					]
				}
			]
		}
	]
}