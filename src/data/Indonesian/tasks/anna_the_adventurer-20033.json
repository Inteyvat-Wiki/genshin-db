				"points": []
			},
			"dialogs": [
				{
					"id": 200330101,
					"content": "Pengembara! Cepat lihat, bagaimana bajuku? Bagus tidak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330102
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330102,
					"content": "Baju ini ... jangan-jangan?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200330103
					]
				},
				{
					"id": 200330103,
					"content": "Benar sekali! Aku sudah lulus tes Adventurers' Guild dan resmi menjadi seorang petualang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330104,
						200330105
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330104,
					"content": "Keren!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200330106
					]
				},
				{
					"id": 200330106,
					"content": "Hehe, terima kasih. Aku awalnya berniat mengajak kakak untuk ikut, tapi dia tetap tidak mau walaupun sudah dibujuk bagaimana pun ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330107
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330107,
					"content": "Aku tidak tertarik dengan petualangan. Ditambah lagi, kalau kita berdua menjadi petualang, siapa yang bakal merawat orang tua kita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330108
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200330108,
					"content": "Kalau begitu kita bawa ayah ibu saja, dan kita pergi jalan-jalan ke seluruh dunia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330109
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330109,
					"content": "Dasar ... Sudahlah, kamu kan sudah berhasil jadi petualang, lakukanlah yang terbaik. Biar aku saja yang urus rumah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330110
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200330110,
					"content": "Tapi! Ingat ya, utamakan keselamatan dan jangan sampai terluka. Jangan terlalu capek juga ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330111
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200330111,
					"content": "Iya, iya, aku tahu! Aku mau keluar buat selesaikan misi dulu ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330112
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330112,
					"content": "Pengembara, maukah kamu pergi bersamaku? Aku masih punya banyak pertanyaan yang ingin kutanyakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330113,
						200330114
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330113,
					"content": "Tentu saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200330115
					]
				},
				{
					"id": 200330115,
					"content": "Coba kulihat ... Misi kali ini adalah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330116
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330116,
					"content": "Mengantar dan mengawal kargo balon udara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330114,
					"content": "Ayo kita berangkat!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200330115
					]
				},
				{
					"id": 200330105,
					"content": "Selamat!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200330106
					]
				}
			]
		},
