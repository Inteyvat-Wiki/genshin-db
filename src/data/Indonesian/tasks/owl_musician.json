			},
			"dialogs": [
				{
					"id": 790710101,
					"content": "#Selamat datang di Constellation Metropole, {NICKNAME}, Nona Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710102
					],
					"speakerTitle": "Alof"
				},
				{
					"id": 790710102,
					"content": "Rekanku sudah memberitahukan nama dan jasa-jasa kalian yang sungguh berani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710103
					],
					"speakerTitle": "Alof"
				},
				{
					"id": 790710103,
					"content": "Jika saja aku tidak ditugaskan melatih penjaga, aku pun ingin berlatih tanding denganmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710104
					],
					"speakerTitle": "Alof"
				},
				{
					"id": 790710104,
					"content": "Jadi kamu seorang penjaga juga?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790710105
					]
				},
				{
					"id": 790710105,
					"content": "Ya. Atas titah Yang Mulia Raja, untuk melindungi perdamaian di Constellation Metropole.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710106
					],
					"speakerTitle": "Alof"
				},
				{
					"id": 790710106,
					"content": "Pekerjaanku adalah melatih penjaga lainnya, agar kemampuan mereka dapat berguna dalam mengemban tugas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710107
					],
					"speakerTitle": "Alof"
				},
				{
					"id": 790710107,
					"content": "Di balik pintu itu ya tempat latihannya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790710108
					]
				},
				{
					"id": 790710108,
					"content": "Matamu tajam! Ya, pintu itu terhubung ke Domain yang baru saja selesai kami renovasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710109
					],
					"speakerTitle": "Alof"
				},
				{
					"id": 790710109,
					"content": "Di dalam sana, para peserta latihan harus mengayunkan pedang sesuai irama, dan lampu di arena akan terus berganti sesuai ritme pertarungannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710110
					],
					"speakerTitle": "Alof"
				},
				{
					"id": 790710110,
					"content": "Wuih, latihannya berat nih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790710111
					]
				},
				{
					"id": 790710111,
					"content": "Latihan ribet, tepatnya. Waktu bertarung juga harus ngikutin ritme itu, kah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790710112,
					"content": "Bagian latihan ini terinspirasi dari kisah berjudul \"Musisi Burung Hantu\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710113
					],
					"speakerTitle": "Alof"
				},
				{
					"id": 790710113,
					"content": "Dulu kisah ini sangat populer di kalangan para penjaga. Bahkan sampai ada yang jadi lupa latihan dan telat pergi patroli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710114
					],
					"speakerTitle": "Alof"
				},
				{
					"id": 790710114,
					"content": "Tapi karena semua suka, ya aku pikir lebih baik ditambahkan saja ke dalam latihannya supaya lebih seru gitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710115
					],
					"speakerTitle": "Alof"
				},
				{
					"id": 790710115,
					"content": "Dan hasilnya sangat terlihat ... sekarang tidak ada lagi yang telat patroli karena alasan pribadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710116
					],
					"speakerTitle": "Alof"
				},
				{
					"id": 790710116,
					"content": "Hehe, kalian mau coba latihannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710117
					],
					"speakerTitle": "Alof"
				},
				{
					"id": 790710117,
					"content": "Tantangan seperti ini tentunya sangat mudah bagi dua sosok pemberani seperti kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710118,
						790710120
					],
					"speakerTitle": "Alof"
				},
				{
					"id": 790710118,
					"content": "Boleh deh, coba yuk!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790710119
					]
				},
				{
					"id": 790710119,
					"content": "Keberanian yang luar biasa! Bagus, silakan masuk ke Domain-nya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alof"
				},
				{
					"id": 790710120,
					"content": "Aku masih ada kerjaan lain sih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790710121
					]
				},
				{
					"id": 790710121,
					"content": "Tidak apa. Datanglah lagi kalau kalian senggang. Aku akan selalu berjaga di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alof"
				}
			]
		}
	]
}