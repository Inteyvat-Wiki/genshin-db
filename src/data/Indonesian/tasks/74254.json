				{
					"id": 742540601,
					"content": "Hari yang damai sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540602,
						742540603
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742540602,
					"content": "(Ayo duduk seperti ini sebentar lagi.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540604
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742540604,
					"content": "Mmhmm, terima kasih atas undangannya. Sandrone ... Atau aku harus memanggilmu \"adikku\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742540603,
					"content": "Sudah waktunya beres-beres.",
