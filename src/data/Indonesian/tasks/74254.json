			"dialogs": [
				{
					"id": 742540501,
					"content": "Seymour! Sudah lama sekali! Mamere juga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540502
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 742540502,
					"content": "Haha, Seymour tidak pernah berhenti cerita sekangen apa dia kepada kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540503
					],
					"speakerTitle": "Mamere"
				},
				{
					"id": 742540503,
					"content": "Benar. Aku tidak pernah berhenti memikirkan Nona Mary-Ann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540504
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 742540504,
					"content": "Terima kasih, Nona Sandrone, karena sudah mengadakan pesta teh ini. Senang sekali bisa berkumpul dan mengobrol tentang perjalanan kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540505
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742540505,
					"content": "Tidak perlu sungkan. Rasanya kita semua seperti keluarga, punya sejarah panjang yang bisa kita bagikan bersama. Hem, setidaknya aku merasa begitu. Jadi tidak ada salahnya berkumpul kalau semuanya lagi santai,",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540506
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742540506,
					"content": "Keluarga? Entah kenapa, mendengarmu bilang begitu saja membuatku merasa senang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540507
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 742540507,
					"content": "Berarti, Nona Sandrone itu ... adik kecil kita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540508
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742540508,
					"content": "Uhm ... Mungkin kita bisa lewati dulu urusan kakak-adik ini ya ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540509
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742540509,
					"content": "Benar. Sebagai prototipe yang diciptakan Tuan Alain, Nona Sandrone harusnya memanggilku \"Kakak\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540510
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 742540510,
					"content": "Urghhh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540511
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742540511,
					"content": "Awww, asyik sekali. Apa aku juga boleh jadi bagian dari anggota keluarga ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540512
					],
					"speakerTitle": "Mamere"
				},
				{
					"id": 742540512,
					"content": "Tentu saja! Keluarga kami tidak konvensional kok dari awal, ada satu Melusine yang bergabung sih wajar-wajar saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540513
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742540513,
					"content": "Setuju. Nona Mamere sudah seperti keluargaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540514
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 742540514,
					"content": "Hehe. Aku senang sekali! Apa aku boleh gambar potret keluarga bahagia kita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540515
					],
					"speakerTitle": "Mamere"
				},
				{
					"id": 742540515,
					"content": "Potret keluarga? Sudah lama sekali sejak terakhir kali aku berpose untuk foto seperti itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540516
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742540516,
					"content": "Pastikan aku kelihatan keren! Kayak kakak tertua di keluarga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540517
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 742540517,
					"content": "Iya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540518
					],
					"speakerTitle": "Mamere"
				},
				{
					"id": 742540518,
					"content": "Heh ... tidak ada salahnya juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marionette"
				}
			]
		},
