			"dialogs": [
				{
					"id": 205130101,
					"content": "Sepertinya cukup normal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130102
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130102,
					"content": "Kamu terlihat baik-baik saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205130103
					]
				},
				{
					"id": 205130103,
					"content": "Iya, sepertinya aku hanya paranoid saja...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130104
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130104,
					"content": "Kondisi Anna semakin hari semakin membaik. Dokter itu benar-benar hebat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130105
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130105,
					"content": "Kalau kamu bersedia, bisakah kamu membantuku mencari bahan obat-obatan lagi? Kali ini butuh Windwheel Aster yang Ditiup Anemo Slime.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130106,
						205130111,
						205130115
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130106,
					"content": "Kedengarannya tidak seperti nama obat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205130107
					]
				},
				{
					"id": 205130107,
					"content": "Hmm, kadang Windwheel Aster memang digunakan untuk obat, tapi biasanya digunakan untuk menyembuhkan penyakit ringan saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130108
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130108,
					"content": "Mungkin Anemo Slime adalah kuncinya, tapi Windwheel Aster dan Anemo Slime tidak sering terlihat bersamaan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130109
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130109,
					"content": "Untungnya, Jack sudah melihatnya beberapa kali, dan dia sudah menunjukkan lokasinya padaku. Biarkan aku berikan tanda di petamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130110
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130110,
					"content": "Aku tidak bisa menghadapi Anemo Slime karena mereka bisa terbang, jadi aku hanya bisa mengandalkanmu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130111,
					"content": "Ini seperti kota Mondstadt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205130112
					]
				},
				{
					"id": 205130112,
					"content": "Iya, tapi Windwheel Aster dan Anemo Slime tidak sering terlihat bersamaan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130113
					],
					"speakerTitle": "Anthony"
				},
				{
