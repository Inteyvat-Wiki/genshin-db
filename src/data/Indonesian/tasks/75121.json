				"points": []
			},
			"dialogs": [
				{
					"id": 751210101,
					"content": "Ada yang minta aku cariin dua buku ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751210102
					]
				},
				{
					"id": 751210102,
					"content": "Kamu menyebutkan dua buku yang diminta Citlali ke Kuroda.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						751210103
					]
				},
				{
					"id": 751210103,
					"content": "Edisi pertama \"Shogun Mahakuasa: Terlahir Kembali Sebagai Raiden Dengan Kekuatan Tak Terbatas\" dan edisi terbatas \"Ayo dong Kitsune Guuji, Kamu Cantik deh\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751210104
					],
					"speakerTitle": "Kuroda"
				},
				{
					"id": 751210104,
					"content": "Wah, temanmu ini bisa sekali ya. Kalau dilihat dari nilainya, tidak ada koleksi di Yae Publishing House yang lebih langka dari kedua buku itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751210105
					],
					"speakerTitle": "Kuroda"
				},
				{
					"id": 751210105,
					"content": "Dan sayang sekali ya aku tidak kenal dengan pembaca luar biasa ini ... Benar-benar disayangkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751210106
					],
					"speakerTitle": "Kuroda"
				},
				{
					"id": 751210106,
					"content": "Masih ada enggak nih?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751210107
					]
				},
				{
					"id": 751210107,
					"content": "Kalau di pasaran sih sudah tidak ada, di gudang juga tidak. Semua yang dicetak sudah ludes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751210108
					],
					"speakerTitle": "Kuroda"
				},
				{
					"id": 751210108,
					"content": "Tapi ... kebetulan aku punya dua-duanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751210109
					],
					"speakerTitle": "Kuroda"
				},
				{
					"id": 751210109,
					"content": "Aku bayar kok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751210110
					]
				},
				{
					"id": 751210110,
					"content": "Tidak, tidak usah. Kedua buku ini lebih baik diberikan saja ke temanmu ini. Karena dia paham betul setinggi apa nilainya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751210111
					],
					"speakerTitle": "Kuroda"
				},
				{
					"id": 751210111,
					"content": "Oleh sebab itu, aku rela berpisah dengan keduanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuroda"
				}
			]
		}
	]
