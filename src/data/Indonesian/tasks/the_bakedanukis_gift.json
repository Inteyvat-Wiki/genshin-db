			"dialogs": [
				{
					"id": 790350101,
					"content": "#{NICKNAME}, Paimon, apa kalian pernah bertemu dengan dua bake-danuki? Yang satu membawa kantong ungu, yang satunya membawa kantong kuning ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790350102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 790350102,
					"content": "Ah! Itu pasti Mamesuke dan Shibasuke!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790350103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790350103,
					"content": "Ah, sepertinya kalian kenal mereka ya, baguslah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790350104
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 790350104,
					"content": "Eh? Memangnya mereka kenapa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790350105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790350105,
					"content": "Tidak, tadi setelah mereka memberi isyarat dengan bahasa tubuh, mereka memberiku ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790350106
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 790350106,
					"content": "Dengar-dengar kalian dan seekor bake-danuki dari Inazuma pernah pergi ke Good Hunter, jadi kupikir dua bake-danuki ini teman kalian juga. Sepertinya mereka mau aku memberikan ini pada kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790350107
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 790350107,
					"content": "Wah! Ini hadiah dari Mamesuke dan Shibasuke!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790350108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790350108,
					"content": "Hehe, sepertinya awal perjalanan mereka sih mulus-mulus saja ya, tapi enggak tahu masih ada kesempatan buat ketemu sama mereka lagi atau enggak ....",
