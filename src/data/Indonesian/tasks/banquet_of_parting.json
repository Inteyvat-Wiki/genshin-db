			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yae Miko",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120310101,
					"content": "Halo, bocah-bocah penolongku. Kalian tepat waktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310102
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310102,
					"content": "Huh, kami enggak ada pilihan lain kan. Kalau enggak datang, enggak dibayar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310103,
					"content": "Miko, kami harus buat apa biar Hyakkiyakou bisa terjadi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310104,
					"content": "Terus, kami juga sama sekali enggak tahu itu sebenarnya apa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310105,
					"content": "Hyakkiyakou kedengarannya acara yang menyeramkan, tapi sebenarnya itu cuma acara kumpul-kumpul para youkai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310106
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310106,
					"content": "Pada pertemuan youkai di zaman dulu, setelah semuanya puas minum, mereka akan mulai terbang ke langit satu per satu. Jumlahnya banyak sekali, sampai siluet mereka saja bisa menghalangi bulan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310107
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310107,
					"content": "Tapi sekarang, ingatan youkai yang bocor dari Ley Line melemah. Mereka tidak bisa terbang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310108
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310108,
					"content": "Jadi, aku akan melakukan ritual pertemuan untuk mengumpulkan semua ingatan yang berkeliaran di satu tempat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310109
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310109,
					"content": "Pada saatnya, mereka akan berkumpul di langit Kuil Agung Narukami. Setelah tenaga mereka habis, mereka akan puas dan kembali ke tempat mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310110
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310110,
					"content": "Oh begitu, aku mengerti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310111
					]
				},
				{
					"id": 120310111,
					"content": "Semua persiapan ritual sudah disiapkan dari awal. Ingat mantra dan \"malam tak berbulan\" yang aku tambahkan ke dalam novel?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310112
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310112,
					"content": "Oh iya, soal baca \"Mantra Sang Wanita Rubah\" ketika malam tak berbulan ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310113,
					"content": "Betul, yang itu. Sebenarnya mantra itu bukan untuk mengabulkan permohonan, melainkan untuk menenangkan ingatan Ley Line.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310114
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310114,
					"content": "Saat waktunya tiba, ayo kita ikutan dan bantu antar mereka ke tempat yang seharusnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310115
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310115,
					"content": "Aku harus buat apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310116
					]
				},
				{
					"id": 120310116,
					"content": "Aku akan mulai menyiapkan ritual. Pada saat itu, aku perlu kamu melakukan dua hal:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310117
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310117,
					"content": "Pertama, beri tahu para miko untuk meninggalkan gunung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310118
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310118,
					"content": "Selama Hyakkiyakou, kerumunan ingatan youkai akan muncul di langit Kuil Agung Narukami. Suruh para miko pergi, supaya tidak ada yang kesurupan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310119
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310119,
					"content": "Setelahnya, aku akan memulai ritual dan semua ingatan akan mulai berkumpul. Proses ini lumayan makan waktu. Aku perlu kamu untuk berjaga di kaki gunung dan mengawasi aktivitas monster.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310120
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310120,
					"content": "Ingatan biasanya tersebar dan tidak berbahaya. Tapi ketika kekuatan sebanyak itu berkumpul di satu tempat, para monster akan merasa terusik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310121
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310121,
					"content": "Mereka mungkin merasa itu kesempatan untuk naik gunung. Kalian harus jaga supaya itu tidak terjadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310122
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310122,
					"content": "Oke, paham. Habis itu apa lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310123,
					"content": "Hmm ... Yah, kalau kamu penasaran dan ingin ke kuil untuk lihat youkai dari dekat, boleh saja sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310124
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310124,
					"content": "#Baiklah. {NICKNAME}, ayo jalan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
