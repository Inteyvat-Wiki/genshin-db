			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yae Miko",
					"Paimon",
					"Okazaki Rikuto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120310401,
					"content": "Ah, bocah-bocah kecilku sudah datang ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310402
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310402,
					"content": "Miko ... apa ini? Kok kamu makan duluan!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310403,
					"content": "Iya, aku makan duluan. Kan kalian yang traktir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310404
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310404,
					"content": "Bayangkan, bisa makan mewah dan minum sake paling enak, gratisan pula ... Aih, aku mana tahan menunggu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310405
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310405,
					"content": "Ah, bos, lihat dua orang di sana? Ingat baik-baik muka mereka ya, soalnya nanti mereka yang bayar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310406
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310406,
					"content": "Siap!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310407
					],
					"speakerTitle": "Okazaki Rikuto"
				},
				{
					"id": 120310407,
					"content": "Uhhh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310408,
					"content": "....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310409
					]
				},
				{
					"id": 120310409,
					"content": "Loh, kenapa? Ayo, sini duduk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310410
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310410,
					"content": "Cobain deh ikan ini. Jenis ini cuma ada di perairan sekitar Pulau Seirai. Ikannya dikirim ke Inazuma dalam waktu semalam, dan masih hidup sampai aku pesan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310411
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310411,
					"content": "Atau mau coba yang ini? Iya, aku tahu kok. Biasanya aku juga tidak rela minum sake semahal ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310412
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310412,
					"content": "Kalau kamu tidak minum alkohol, tidak apa. Ada banyak jus buah dengan variasi harga yang sama banyaknya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310413
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310413,
					"content": "Grrr ... Miko! Ini sih kelewatan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310414,
					"content": "Waktu kami kerja bikin novel dulu, kamu cuma kasih kami makan Kushikatsu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310415,
					"content": "Hah, masa sih? aku tidak ingat tuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310416,
						120310417
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310416,
					"content": "Aku ingat. Ingat jelas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310418
					]
				},
				{
					"id": 120310418,
					"content": "Oh, terus kenapa? Kan kamu yang bilang mau traktir aku makan? Sudahlah, aku ini termasuk orang penting loh. Memangnya kamu tidak gengsi kalau cuma traktir aku makan yang biasa-biasa saja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310419
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310419,
					"content": "Miko, makanan ini mahal banget. Gimana kalau kami enggak mampu bayar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310420,
					"content": "Hehe, jangan takut. Kamu pasti bisa bayar ... Novel karanganmu masih terus dicetak loh. Kamu masih akan dibayar mahal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310421
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310421,
					"content": "A-A-Apa!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310422,
					"content": "#Ahhhhh, sialan!!! Dia menipu kita, {NICKNAME}! Miko mengincar uang kita dari awal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310423,
						120310424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310423,
					"content": "Kita harusnya tidak lengah ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310425
					]
				},
				{
					"id": 120310425,
					"content": "Hahaha, lihat tampang kalian sekarang. Hahaha, terlalu sempurna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310426
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310426,
					"content": "Oh, ngomong-ngomong, karena tidak ada permohonan yang terkabul ketika malam tak berbulan, novel yang menceritakan mantra kini sudah tidak populer lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310427
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310427,
					"content": "Jadi, kalian harus pikirkan sesuatu yang baru buat lanjutan cerita \"Petualangan Ajaib Sang Pengembara\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310428
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310428,
					"content": "Tenggat waktunya sudah mau tiba ... semangat ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310424,
					"content": "Kita dikerjain ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310425
					]
				},
				{
					"id": 120310417,
					"content": "Kushikatsu dan tahu goreng. Itu doang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310418
					]
				}
			]
