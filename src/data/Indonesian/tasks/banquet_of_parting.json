			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Maki",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120310201,
					"content": "Turun gunung? Apa ini perintah Lady Guuji?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310202
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 120310202,
					"content": "Ya, Miko bilang ritual yang mau dia lakukan mungkin bisa berbahaya buat kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310203,
					"content": "Begitu ya ... Baik, aku akan segera evakuasi semua orang. Kalian bagaimana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310204
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 120310204,
					"content": "Kami masih ada sedikit urusan, lalu habis itu kami akan kembali ke sini dan melakukan ritualnya sama-sama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310205,
						120310206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310205,
					"content": "Kami juga ingin pastikan keselamatannya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310207
					]
				},
				{
					"id": 120310207,
					"content": "Tampaknya Lady Guuji sangat percaya pada kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310208
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 120310208,
					"content": "Lady Guuji yang dulu tidak pernah mengizinkan siapa pun ada di dekat dirinya saat melakukan ritual seperti ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310209
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 120310209,
					"content": "Terima kasih telah membantu ritual, dan ... semoga beruntung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310210
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 120310210,
					"content": "Jangan khawatir, kami lebih kuat dari kelihatannya kok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310206,
					"content": "Kami juga ingin lihat youkai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310207
					]
				}
			]
		},
		{
			"id": 1203104,
