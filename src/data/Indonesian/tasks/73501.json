	"talks": [
		{
			"id": 7350101,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7350101",
							"2"
						],
						"stepId": 7350101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qasit",
					"Alia",
					"Mamdouh",
					"Fayez",
					"Ruhi",
					"Collei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735010101,
					"content": "Oh ... kok aku dapat yang sama lagi sih ... Kapan aku dapat yang paling tembem sama elastis nih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010102
					],
					"speakerTitle": "Qasit"
				},
				{
					"id": 735010102,
					"content": "Kayaknya aku perlu menabung dulu biar nanti semuanya bisa aku beli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010103
					],
					"speakerTitle": "Qasit"
				},
				{
					"id": 735010103,
					"content": "Hah?! Kamu kan sudah datang terus ke sini tiap hari! Bukannya kamu sudah berhasil ngumpulin semuanya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010104
					],
					"speakerTitle": "Alia"
				},
				{
					"id": 735010104,
					"content": "Daripada gitu, kamu mendingan belinya yang langsung satu paket saja. Jadi, nanti kamu bisa punya tujuh desain yang beda sekaligus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010105
					],
					"speakerTitle": "Alia"
				},
				{
					"id": 735010105,
					"content": "Tapi kalau gitu nanti sudah tidak ada kejutannya lagi dong ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010106
					],
					"speakerTitle": "Qasit"
				},
				{
					"id": 735010106,
					"content": "Kejutan bikin bosan saja ah! Pokoknya semua desainnya, aku mau! Nah, kalau kamu suka sama sesuatu itu harusnya gitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010107
					],
					"speakerTitle": "Alia"
				},
				{
					"id": 735010107,
					"content": "Akhirnya aku berhasil juga nabung cukup banyak, jadi cukup buat beli yang satu paket hari ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010108
					],
					"speakerTitle": "Alia"
				},
				{
					"id": 735010108,
					"content": "Maaf, tapi ukiran kami yang terakhir tadi sudah dibeli oleh Qasit. Jadi barang kami buat hari ini sudah habis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010128
					],
					"speakerTitle": "Mamdouh"
				},
				{
					"id": 735010128,
					"content": "Tapi, kami sedang berupaya untuk melakukan ekspansi untuk tim kami, jadi silakan periksa kembali besok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010109
					],
					"speakerTitle": "Mamdouh"
				},
				{
					"id": 735010109,
					"content": "Oke ... aku besok ke sini lagi. Sebentar, ukiran Aranara itu enggak boleh cuma disebut \"barang\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010110
					],
					"speakerTitle": "Alia"
				},
				{
					"id": 735010110,
					"content": "Iya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010111
					],
					"speakerTitle": "Qasit"
				},
				{
					"id": 735010111,
					"content": "Oh iya, benar, benar. Maafkan kata-kataku barusan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010112
					],
					"speakerTitle": "Mamdouh"
				},
				{
					"id": 735010112,
					"content": "Maaf nak, ukiran Aranara kami sudah habis terjual untuk hari ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010113
					],
					"speakerTitle": "Fayez"
				},
				{
					"id": 735010113,
					"content": "Habis terjual? Aduh, gimana dong ini ... Aku tadinya mau beli buat sepupu kecilku yang akan berkunjung besok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010114
					],
					"speakerTitle": "Ruhi"
				},
				{
					"id": 735010114,
					"content": "Hei, bagaimana kalau begini? Kamu tinggal di dekat rumah Razi, kan? Kami akan mengirimkan ukiran barunya pertama-tama buat kamu besok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010115
					],
					"speakerTitle": "Fayez"
				},
				{
					"id": 735010115,
					"content": "Terima kasih, Paman Fayez! Jangan sampai lupa ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010116
					],
					"speakerTitle": "Ruhi"
				},
				{
					"id": 735010116,
					"content": "Ya, Paman Fayez janji. Acara Crafts tidak akan mengecewakan satu anak pun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010117
					],
					"speakerTitle": "Fayez"
				},
				{
					"id": 735010117,
					"content": "Ah, pelanggan-pelanggan yang baru datang. Maaf, ukiran Aranara kami sudah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010118
					],
					"speakerTitle": "Fayez"
				},
				{
					"id": 735010118,
					"content": "Oh hei, ternyata kalian rupanya. Terima kasih banyak untuk bantuan kalian ya. Kami sudah merencanakan untuk berkunjung ke tempatmu untuk menyampaikan langsung rasa terima kasih kami. Tapi sekarang kalian lihat sendiri ... tokonya masih sibuk sekali sampai sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010119
					],
					"speakerTitle": "Fayez"
				},
				{
					"id": 735010119,
					"content": "Kalau bukan berkat kalian, mungkin ulang tahun toko kami yang kedua puluh ini akan menyisakan akhir cerita yang berbeda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010120,
						735010121
					],
					"speakerTitle": "Fayez"
				},
				{
					"id": 735010120,
					"content": "Kelihatannya bisnismu maju sekali.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735010122
					]
				},
				{
					"id": 735010121,
					"content": "Kelihatannya Aranara jadi populer sekali.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735010122
					]
				},
				{
					"id": 735010122,
					"content": "Ini semua berkat Razi. Dia punya begitu banyak kreativitas di usianya yang masih begitu muda ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010123
					],
					"speakerTitle": "Fayez"
				},
				{
					"id": 735010123,
					"content": "Oh iya, kami juga mau memberikan Prototipe Aranara untuk kalian sebagai sedikit bentuk rasa apresiasi kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010124
					],
					"speakerTitle": "Fayez"
				},
				{
					"id": 735010124,
					"content": "Wow, sebentar ... Ini kelihatannya sedikit ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010125
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 735010125,
					"content": "Terlalu kaya akan inspirasi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735010126
					]
				},
				{
					"id": 735010126,
					"content": "Benar, begitu kaya akan inspirasi. Seakan-akan terpancar sebuah ... perasaan yang misterius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010127
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 735010127,
					"content": "Uhm ... kami juga mau bilang terima kasih buat apresiasimu. Tapi kami minta waktu sebentar dulu ya buat mutusin apa kami mau menyimpannya atau enggak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735010129,
					"content": "Sekarang masalah si pembuat mainan sudah selesai, ayo kita kunjungi Tanger dan Razi!",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7350102,
