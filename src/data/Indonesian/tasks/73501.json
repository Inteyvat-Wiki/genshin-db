					"Fayez",
					"Qasit",
					"Alia",
					"Ruhi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735010201,
					"content": "Apakah Ayah Aranara yang sudah mengakui kesalahannya akan dimaafkan oleh anaknya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010202
					],
					"speakerTitle": "Razi"
				},
				{
					"id": 735010202,
					"content": "Hmm ... Kurasa semua orang akan suka sih sama isi ceritanya, tapi rasanya resolusi dari konfliknya terlalu cepat buat diselesaikan deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010203
					],
					"speakerTitle": "Razi"
				},
				{
					"id": 735010203,
					"content": "Atau mau kita buat mereka melewati semacam kesulitan bersama? Papa yakin mereka bakal jadi lebih bisa memahami satu sama lain. Kita bisa membuat ayah Aranara merasa menyesal setelah melihat usaha anaknya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010204
					],
					"speakerTitle": "Tanger"
				},
				{
					"id": 735010204,
					"content": "Terus nanti kalau ayahnya Aranara sudah mulai merasa menyesal, bagusnya dia bicara lebih pelan atau cepat ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010205
					],
					"speakerTitle": "Razi"
				},
				{
					"id": 735010205,
					"content": "Itu sebenarnya tergantung sama anaknya si Aranara ya. Menariknya sih mendengar mereka berbicara dengan kecepatan yang berbeda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010206
					],
					"speakerTitle": "Tanger"
				},
				{
					"id": 735010206,
					"content": "Hei Tanger, Razi, kalian lagi apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735010207,
					"content": "Ah, aku sedang membicarakan isi dongeng barunya dengan papa. Kali ini aku sendiri yang akan membacakan dongengnya ke orang lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010208
					],
					"speakerTitle": "Razi"
				},
				{
					"id": 735010208,
					"content": "Tapi aku grogi kalau harus bercerita di depan banyak orang. Jadi aku minta saran dari papa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010209
					],
					"speakerTitle": "Razi"
				},
				{
					"id": 735010209,
					"content": "Hooo! Kayaknya Sumeru bakal punya pendongeng muda baru nih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735010210,
					"content": "Kalau bukan karena kalian, Razi pasti sudah meninggalkanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010211
					],
					"speakerTitle": "Tanger"
				},
				{
					"id": 735010211,
					"content": "Paimon senang deh semuanya bisa beres!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735010212,
					"content": "Tapi ... masih ada beberapa hal yang mencurigakan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735010213,
					"content": "Oh? Kamu butuh bantuan untuk menyelidiki sesuatu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010214
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 735010214,
					"content": "Kok orang Mondstadt bisa ninggalin catatan di lubang pohon yang ada jauh di dalam Hutan Avidya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735010215,
					"content": "Ku-Kupikir kita sudah beranjak dari topik ini deh! Em, kurasa itu cuma kebetulan saja sih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010216
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 735010216,
					"content": "Banyak kok orang yang menulis rahasia sendiri lalu disembunyikan di dalam lubang pohon! Bukan hal yang aneh kok ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010217,
						735010218
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 735010217,
					"content": "Kok Collei kelihatan panik sekali tiba-tiba.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735010219
					]
				},
				{
					"id": 735010219,
					"content": "Oh ... *huff* ... baiklah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010220
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 735010220,
					"content": "Aku punya rahasia dan masalahku sendiri juga. Dan ... aku juga mau menceritakannya pada lubang-lubang pohon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010221
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 735010221,
					"content": "Tapi aku jadi kepikiran sesuatu setelah melihat Razi dan Tanger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010222
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 735010222,
					"content": "#{NICKNAME}, bisakah kamu jadi lubang pohonku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010223,
						735010224
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 735010223,
					"content": "Dengan senang hati.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 735010224,
					"content": "Boleh saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 735010218,
					"content": "Benarkah begitu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735010219
					]
				}
			]
		},
