				},
				{
					"id": 735010305,
					"content": "Itu sebenarnya tergantung sama anaknya si Aranara ya. Menariknya sih mendengar mereka berbicara dengan kecepatan yang berbeda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010306
					],
					"speakerTitle": "Tanger"
				},
				{
					"id": 735010306,
					"content": "Hei Tanger, Razi, kalian lagi apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735010307,
					"content": "Ah, aku sedang membicarakan isi dongeng barunya dengan papa. Kali ini aku sendiri yang akan membacakan dongengnya ke orang lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010308
					],
					"speakerTitle": "Razi"
				},
				{
					"id": 735010308,
					"content": "Tapi aku grogi kalau harus bercerita di depan banyak orang. Jadi aku minta saran dari papa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010309
					],
					"speakerTitle": "Razi"
				},
				{
					"id": 735010309,
					"content": "Hooo! Kayaknya Sumeru bakal punya pendongeng muda baru nih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735010310,
					"content": "Kalau bukan karena kalian, Razi pasti sudah meninggalkanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010311
					],
					"speakerTitle": "Tanger"
				},
				{
					"id": 735010311,
					"content": "Paimon senang deh semuanya bisa beres!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735010312,
					"content": "Tapi ... masih ada beberapa hal yang mencurigakan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735010313,
					"content": "Oh? Kamu butuh bantuan untuk menyelidiki sesuatu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010314
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 735010314,
					"content": "Kok orang Mondstadt bisa ninggalin catatan di lubang pohon yang ada jauh di dalam Hutan Avidya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735010315,
					"content": "Ku-Kupikir kita sudah beranjak dari topik ini deh! Em, kurasa itu cuma kebetulan saja sih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010316
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 735010316,
					"content": "Banyak kok orang yang menulis rahasia sendiri lalu disembunyikan di dalam lubang pohon! Bukan hal yang aneh kok ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010317,
						735010318
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 735010317,
					"content": "Kok Collei kelihatan panik sekali tiba-tiba.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735010319
					]
				},
				{
					"id": 735010319,
					"content": "Oh ... *huff* ... baiklah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010320
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 735010320,
					"content": "Sebenarnya aku kira-kira tahu siapa identitas si orang Mondstadt itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010321
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 735010321,
					"content": "Kalau ada kesempatan akan kuceritakan pada kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010322,
						735010323
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 735010322,
					"content": "Boleh deh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 735010323,
					"content": "Akan kutunggu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 735010318,
					"content": "Benarkah begitu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735010319
					]
				}
			]
		}
	]
