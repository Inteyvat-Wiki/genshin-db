				"points": []
			},
			"dialogs": [
				{
					"id": 721200101,
					"content": "Bagus! Pengujiannya berjalan lancar. Onikabuto yang terkontaminasi sudah berhasil dimurnikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200102
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200102,
					"content": "Sekarang, kita...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721200103
					]
				},
				{
					"id": 721200103,
					"content": "Sekarang kita tinggal menentukan jalurnya saja. Lebih baik memutar demi menghindari Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200104
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200104,
					"content": "Alat ini... besar, jadi kalau kita berdua harus pastikan jalur masuknya tidak terhalang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200105
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200105,
					"content": "Karena itu aku ingin minta tolong kamu periksa keadaan di dalam. Kalau ada jalan yang rusak, tolong perbaiki sedikit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200106
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200106,
					"content": "Aku masih belum menentukan jalurnya sih, tapi kalau ada lebih banyak pilihan kan lebih bagus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200107
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200107,
					"content": "Aku mana bisa perbaiki jalan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721200108
					]
				},
				{
					"id": 721200108,
					"content": "Tidak usah bingung, cukup taruh papan di atasnya agar alat ini bisa lewat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200109
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200109,
					"content": "Ah, kamu ambil papan dari sana. Aku lanjut di sini, agar alat ini bisa berfungsi sebaik-baiknya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				}
			]
		},
		{
			"id": 7212002,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
