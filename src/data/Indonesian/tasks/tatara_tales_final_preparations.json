			},
			"dialogs": [
				{
					"id": 721200201,
					"content": "Semoga semuanya lancar dan masalah ini cepat selesai. Kalau tertunda lagi, aku tidak tahu akan seperti apa jadinya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				}
			]
		},
		{
			"id": 7212003,
			"completionStepIds": [
				7212009
