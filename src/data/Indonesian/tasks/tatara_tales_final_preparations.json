			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xavier"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721200301,
					"content": "Bagaimana? Kamu sudah periksa semua jalan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200302
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200302,
					"content": "Jalanannya sudah mulus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721200303
					]
				},
				{
					"id": 721200303,
					"content": "Ba-baiklah, kalau begitu sebentar lagi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200304
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200304,
					"content": "Apa lagi sih...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721200305
					]
				},
				{
					"id": 721200305,
					"content": "Aku sedang... berpikir! Memikirkan masalah yang mungkin akan terjadi, paham kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200306
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200306,
					"content": "Misalnya bagaimana kalau pas masuk, eh ternyata intinya sudah dikeluarkan oleh para Fatui barbar itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200307
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200307,
					"content": "Kemudian mereka masukkan intinya ke dalam Ruin Guard, yang kemudian jadi kehilangan kendali dan menghajar kita semua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200308
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200308,
					"content": "Atau saat kita sedang memurnikan Mikage Furnace, inti Tatarigami dimakan makhluk oleh elemental yang tiba-tiba muncul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200309
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200309,
					"content": "Yang paling gawat adalah, kalau dewa ular dalam legenda itu hidup kembali, tamatlah riwayat kita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200310,
						721200311
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200310,
					"content": "Tenang, tenang dulu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721200312
					]
				},
				{
					"id": 721200312,
					"content": "Ma-maaf. Ini kebiasan burukku, selalu melihat kemungkinan terburuk...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200313
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200313,
					"content": "Aku akan buat rencana sebaik mungkin, agar masalah ini beres pada waktunya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200314
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200314,
					"content": "Semoga semuanya lancar, semoga semuanya lancar, semoga semuanya lancar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200311,
					"content": "Mikirnya kejauhan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721200312
					]
				}
			]
		},
