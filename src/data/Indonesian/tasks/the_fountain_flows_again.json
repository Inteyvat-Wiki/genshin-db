			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Edel"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740370301,
					"content": "Pipa yang ada di sini harus diganti ... terus katupnya ... ini juga harus dibersihkan ... *huff* masalah demi masalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370302
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370302,
					"content": "Hah? Kamu butuh sesuatu? Dari tampangmu ... Kamu sepertinya bukan orang yang diutus Estelle untuk memperbaiki air mancur ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370303
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370303,
					"content": "Tentang Remaudiere ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370304
					]
				},
				{
					"id": 740370304,
					"content": "Oh, dia? Heh, sulapnya benar-benar hebat. Dia merusak salah satu katup di pipa air mancur, dan juga hancurkan nozelnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370305
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370305,
					"content": "Hahah. Aku bercanda. Sebenarnya, katup yang macet itulah yang membuat seluruh sistem air tersumbat. Untuk alasan keamanan, kami menutup sementara seluruh air mancur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370306
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370306,
					"content": "Tapi kenapa nozelnya bisa rusak ya? Aku benar-benar tidak tahu ... aneh sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370307
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370307,
					"content": "Remaudiere terus-terusan bilang kalau air mancurnya tidak segera diperbaiki, dia bakalan mampus ... Tapi aku perlu memperbaiki banyak hal tiap harinya. Duh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370308
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370308,
					"content": "Akhirnya aku ada waktu buat pesan katup dan nozel baru dari Estelle hari ini, dan aku bakal ke kota buat ambil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370309
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370309,
					"content": "Kalau bersedia, kamu boleh ikut. Barang yang harus kuambil tidak sedikit, jadi takutnya sih agak susah kalau tidak ada yang bantuin bawa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Edel"
				}
			]
		},
