			},
			"dialogs": [
				{
					"id": 740370801,
					"content": "Ini tempatnya. Ayo mulai kerja. Air mancur ini sudah lama mati. Saatnya bekerja kembali dengan baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370802
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370802,
					"content": "Keduanya langsung bekerja ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740370803
					]
				},
				{
					"id": 740370803,
					"content": "Oke katupnya sudah masuk. Aku juga sudah periksa secara mendetail. Tidak ada masalah besar sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370804
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370804,
					"content": "Baiklah. Coba mundur sebentar. Sisanya paling tinggal buka pintu airnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370805
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370805,
					"content": "Coba aku lihat ... Pintu air utama ada di sana, dan pintu air sekunder juga perlu disesuaikan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370806
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370806,
					"content": "Tunggu aku sebentar di sini. Aku akan buka pintu airnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370807
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370807,
					"content": "Siapa sih yang rancang sistem begini? Kenapa pintu air utamanya jauh begini sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370808
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370808,
					"content": "Edel bergegas ke pintu air utama dan kembali setelah beberapa saat ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740370809
					]
				},
				{
					"id": 740370809,
					"content": "Argh, buka pintu air saja capek banget ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370810
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370810,
					"content": "Kita tunggu sebentar. Airnya sebentar lagi bakal keluar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370811
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370811,
					"content": "Setelah berbagai suara gemuruh, air mancurnya kembali bekerja dengan normal ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740370812
					]
				},
				{
					"id": 740370812,
					"content": "Luar biasa! Air mancurnya bekerja lagi ... Sekarang sekalipun Keratry bilang ke papa mama tentang kejadian di malam itu, aku bisa pura-pura tidak tahu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370813,
						740370814
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370813,
					"content": "Nah, mulai sekarang jangan main sulap kapan saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370815
					]
				},
				{
					"id": 740370815,
					"content": "Masalahnya tidak ada hubungannya dengan sulap sih ... tapi makasih ya. Ini sebagai tanda terima kasihku. Mohon diambil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370816
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370816,
					"content": "Bayaran yang aku janjikan juga ada di dalam sana. Terima kasih atas bantuannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370817
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370817,
					"content": "Terima kasih juga, Edel dan Nona Estelle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370818
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370818,
					"content": "Aku cuma menjalankan tugasku, tidak perlu berterima kasih. Lain kali jangan bawa adikmu keluar malam-malam lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370819
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370819,
					"content": "Kakak! Ngapain di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370820
					],
					"speakerTitle": "Keratry"
				},
				{
					"id": 740370820,
					"content": "Keratry?! Kamu ngapain di sini? Bukannya kamu ... Kamu harusnya lagi jalan-jalan sama Papa dan Mama?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370821
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370821,
					"content": "Hehe ... waktu mereka tidak lihat, aku langsung kabur. Aku mau lihat air mancurnya gimana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370822
					],
					"speakerTitle": "Keratry"
				},
				{
					"id": 740370822,
					"content": "Bukannya kakak pakai sulap buat bikin air mancurnya berhenti? Kupikir pasti tidak akan nyembur dulu untuk beberapa saat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370823
					],
					"speakerTitle": "Keratry"
				},
				{
					"id": 740370823,
					"content": "Haha ... Em ... Hehe ... sulap kan ada batasnya juga. Kamu juga tahu, kan kalau sulap cuma berlaku buat beberapa saat saja ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370824
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370824,
					"content": "Ooh ... Mau lihat lagi dong sulapnya! Kakak bisa kan, bikin air mancurnya berhenti lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370825
					],
					"speakerTitle": "Keratry"
				},
				{
					"id": 740370825,
					"content": "Ini ... hm ... *uhuk* Keratry, di sekitar sini banyak orang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370826
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370826,
					"content": "Kalau Kakak hentikan air mancurnya sekarang, orang-orang yang mau lihat bakal kecewa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370827
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370827,
					"content": "Hmm ... Kalau gitu kita balik lagi nanti! Kita bawa Papa dan Mama juga. Aku yakin mereka juga mau lihat sihir Kakak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370828
					],
					"speakerTitle": "Keratry"
				},
				{
					"id": 740370828,
					"content": "Hah?! Tidak, itu ... Dik, aku benar-benar ... belum sepenuhnya menguasai ilmu sulap air mancur itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370829
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370829,
					"content": "Aku yakin papa mama juga tidak mau melihat sulap yang abal-abal gitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370830
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370830,
					"content": "Nah, jadi kamu jangan bilang-bilang dulu soal \"sulap air mancur\" ke papa mama ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370831
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370831,
					"content": "Kakak mau pelajari lebih lanjut dulu sebelum kasih kejutan ke mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370832
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370832,
					"content": "Oke! Aku yakin mereka bakal suka!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370833
					],
					"speakerTitle": "Keratry"
				},
				{
					"id": 740370833,
					"content": "Iya, Kakak juga. Sekarang ayo kita pulang dulu, oke? Kakak bakal kasih kamu lihat sulap yang lain ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370814,
					"content": "Sulap dan keajaiban itu selalu ada harganya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370822
					]
				}
			]
		}
	]
