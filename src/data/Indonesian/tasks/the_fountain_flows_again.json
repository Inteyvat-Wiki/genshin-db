			"dialogs": [
				{
					"id": 740370101,
					"content": "*huff* ... Kenapa Edel belum perbaiki air mancur ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370102
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370102,
					"content": "Kalau ini tidak segera diperbaiki, Keratry akan memastikan semua orang di Teyvat pasti akan mendengarnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370103
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370103,
					"content": "Air mancur ini rusak ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370104
					]
				},
				{
					"id": 740370104,
					"content": "*huff* Padahal beberapa hari lalu masih oke, tapi sekarang malah jadi mati tiba-tiba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370105
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370105,
					"content": "Yang lebih parahnya lagi, rusak waktu aku sedang mempertunjukkan sulap untuk Keratry!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370106
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370106,
					"content": "Orang tuaku ada di opera waktu itu terjadi, lalu mereka bilang untuk hibur adikku dengan mainan atau buku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370107
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370107,
					"content": "Tapi Keratry merengek terus dan minta diajak keluar. Gagal membujuknya, terpaksa aku membawanya keluar untuk bermain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370108
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370108,
					"content": "Waktu kami tiba di air mancur ini, Keratry tiba-tiba bilang dia mau tunggu papa mama buat keluar dari opera terus pulang bareng mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370109
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370109,
					"content": "Kedengarannya oke.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370110
					]
				},
				{
					"id": 740370110,
					"content": "Iya. Paimon rasa karena kalian juga sudah jalan jauh gitu, kalau kalian tunggu orang tua kalian muncul, mungkin mereka bakal traktir kalian yang enak-enak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740370111,
					"content": "Tapi waktu itu sudah malam sekali ... kalau papa mama tahu aku mengajak adikku jalan-jalan di waktu malam begitu, bisa mati deh aku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370112
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370112,
					"content": "Jadi, aku bohong sedikit ke Keratry. Aku bilang kalau aku tahu jenis sulap tertentu yang dapat membuat aliran air mancur berhenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370113
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370113,
					"content": "Padahal, aku cuma hitung jeda antara semburan airnya buat hibur dia terus bisa bawa dia pulang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370114
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370114,
					"content": "Air mancurnya memang berhenti sesuai waktu yang kuperkirakan, dan adikku jadi percaya dengan \"sulap\"ku. Dia tidak henti-hentinya memintaku mengajarinya \"sulap\" itu saat pulang ke rumah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370115
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370115,
					"content": "Jadi aku bawa dia pulang ke rumah, ngarang-ngarang buat memuaskan rasa ingin tahunya, menyuruhnya masuk kamar, sementara aku juga masuk ke kamarku sendiri. Tak lama kemudian, papa mama kembali, semua tampak normal ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370116
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370116,
					"content": "Tapi di hari berikutnya, waktu aku sedang keluar cari kertas buat papa, aku sadar air mancurnya masih begitu ... air mancurnya rusak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370117,
						740370118
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370117,
					"content": "Ilmu sulapmu hebat juga ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370119
					]
				},
				{
					"id": 740370119,
					"content": "Ayolah, jangan sindir aku gitu! Kalau Keratry melaporkan ini ke papa mama, mampus deh aku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370120
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370120,
					"content": "\"Hah? Air mancur di plaza rusak? Sayang, menurutmu kenapa nih?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370121
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370121,
					"content": "\"Aneh ... aneh banget. Sebelum kita pergi nonton opera waktu itu kayaknya masih oke-oke saja deh.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370122
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370122,
					"content": "\"Oh, aku tahu! Remaudiere yang bikin berhenti! Ya kan?!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370123,
						740370124
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370123,
					"content": "Bagus juga.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370125
					]
				},
				{
					"id": 740370125,
					"content": "Dan lagi, papa mama akan tahu kalau aku dan adik keluar malam-malam, terus mereka akan marahi aku. Habislah aku dua bulan ke depan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370126
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370126,
					"content": "Tapi ... air mancur ini harusnya ada penanggung jawabnya, kan? Kalau rusak, harusnya orang itu datang dan perbaiki dong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740370127,
					"content": "Edel yang bertanggung jawab untuk air mancur ini, dan aku juga sudah bilang ke dia. Dia janji akan perbaiki secepatnya, tapi ... sampai hari ini masih belum kelihatan hasilnya sama sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370128
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370128,
					"content": "Aku tidak bisa sembunyikan ini lagi, habislah aku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370129,
						740370130
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370129,
					"content": "Biar aku bantu kamu buat tanya dia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370131
					]
				},
				{
					"id": 740370131,
					"content": "Yang benar? Kamu mau bantu? Kalau begitu, aku kasih um ... tabunganku! Semua kuberikan ke kamu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370132
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370132,
					"content": "Edel ada di sana. Tolong cepat tanya dia apa yang terjadi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370130,
					"content": "Ah. Ini sih masalah cetek. Aku bantu kamu deh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370131
					]
				},
				{
					"id": 740370124,
					"content": "Ceritamu antusias banget, aku jadi kebayang jelas kondisinya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370125
					]
				},
				{
					"id": 740370118,
					"content": "Wah pesulap kelas kondang beda ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370133
					]
				},
				{
					"id": 740370133,
					"content": "Selagi kamu mengamati air mancur, seseorang datang ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
