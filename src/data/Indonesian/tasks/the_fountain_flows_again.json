			"dialogs": [
				{
					"id": 740370701,
					"content": "Ini harusnya cukup! Sebentar ya, ini bakal cepat selesai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370702
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370702,
					"content": "Estelle mulai bekerja ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740370703
					]
				},
				{
					"id": 740370703,
					"content": "Baiklah. Sudah selesai. Katupnya dan pipanya lalu juga komponen tambahan yang biasa dipakai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370704
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370704,
					"content": "Edel, Pengembara, ayo ke Erinnyes. Selama ada aku, air mancurnya pasti bisa langsung diperbaiki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370705
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370705,
					"content": "Terima kasih ... Aku ambil ya, Pengembara. Yuk pergi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Edel"
				}
			]
