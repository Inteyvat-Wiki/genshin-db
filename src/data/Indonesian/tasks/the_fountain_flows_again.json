				{
					"id": 740370401,
					"content": "Tapi di sisi lain, anak itu, Remaudiere, pasti bakal ngamuk kalau air mancurnya tidak segera diperbaiki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Edel"
				}
			]
		},
