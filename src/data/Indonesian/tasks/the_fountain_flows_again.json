				]
			},
			"dialogs": [
				{
					"id": 740370501,
					"content": "Halo, ada yang bisa ... Oh, Edel?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370502
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370502,
					"content": "Aku ke sini buat ambil katup dan nozelnya. Kalau air mancurnya tidak segera diperbaiki, si bocah Remaudiere itu pasti panik setengah mati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370503
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370503,
					"content": "Ka-Katupnya ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370504
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370504,
					"content": "Hm, kenapa kamu terbata-bata? Estelle ... Kamu tidak lupa membuatnya, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370505
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370505,
					"content": "Tidak! Aku sudah buat katupnya kok. Tapi ... tadi ada pelanggan yang butuh banget buat memperbaiki sesuatu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370506
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370506,
					"content": "Ja-Jadi, aku kasih dia beberapa bagian ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370507
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370507,
					"content": "Jangan khawatir! Aku lagi bikin yang baru sekarang! Pasti bakal segera siap!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370508
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370508,
					"content": "Nona Estelle, aku sudah pesan dari lama loh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370509
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370509,
					"content": "Aku tahu! Tapi pelanggan itu buru-buru banget. Dia bilang dia harus perbaiki saluran air, dan dia sampai memohon-mohon segala ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370510
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370510,
					"content": "Tidak masalah kok! Kalau ... Iron Chunk yang kubeli sudah tiba, aku pasti bisa bikin katupnya! Pasti bakal segera tiba!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370511
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370511,
					"content": "Kamu kapan pesanannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370512
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370512,
					"content": "Ta-Tadi pagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370513,
						740370514
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370513,
					"content": "Serahkan saja soal Iron Chunk padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370515
					]
				},
				{
					"id": 740370515,
					"content": "Serius? Bagus deh, bagus! Kami mengandalkanmu, Pengembara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370516
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370516,
					"content": "Maaf! Aku benar-benar minta maaf! Cukup tiga Iron Chunk saja sudah cukup kok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370517
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370517,
					"content": "Oke, kami mengandalkanmu, Pengembara. Jangan khawatirkan bayarannya. Yang jelas kamu tidak akan kerja gratis kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370514,
					"content": "Aku akan carikan Iron Chunk-nya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370515
					]
				}
			]
		},
