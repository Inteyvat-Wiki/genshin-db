					"Fushizome"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726890101,
					"content": "Ah, halo. Waktunya pas sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726890102
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726890102,
					"content": "Setelah dua kali mencoba, pemahaman kalian dalam seni merangkai bunga sudah meningkat jauh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726890103
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726890103,
					"content": "Karena itu aku membuat sedikit penyesuaian untuk tema hari ini, siapa tahu bisa bantu kasih kalian sesuatu yang baru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726890104
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726890104,
					"content": "Kami siap.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726890105
					]
				},
				{
					"id": 726890105,
					"content": "Eh, kamu doang yang siap, Paimon sih tegang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726890106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726890106,
					"content": "Hehe, tenang, tidak perlu tegang. Santai saja, santai kayak di pantai ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726890107
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726890107,
					"content": "Kalau melihat bakat yang kalian punya, kurasa kalian hanya perlu pertimbangan sebentar saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726890108,
						726890111
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726890108,
					"content": "Kamu terlalu memuji. Silakan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726890109
					]
				},
				{
					"id": 726890109,
					"content": "Baiklah, tema hari ini adalah \"Hijau zamrud tenangkan daun, embusan angin lahirkan kembang\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726890110
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726890110,
					"content": "Nah, silakan dipikirkan jawabannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726890111,
					"content": "Aku masih ada urusan ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726890112
					]
				},
				{
					"id": 726890112,
					"content": "Tidak apa. Ikebana perlu konsentrasi penuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726890113
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726890113,
					"content": "Selesaikan dulu saja semua urusan yang ada. Nanti kalau sudah bisa fokus sepenuhnya, aku yakin hasil pekarangan bunga kalian juga akan sempurna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fushizome"
				}
			]
		},
		{
			"id": 7268903,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
