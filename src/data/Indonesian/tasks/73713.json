			"dialogs": [
				{
					"id": 737130101,
					"content": "Ta-da! Sudah sampai! Ayo kita mulai dari bagian dangkal dulu. Nanti kita kayak lagi masuk ke lukisan yang dibuka di depan mata kita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737130102,
					"content": "Ah, ternyata kalian ... dan kalian membawa teman baru? Apakah mereka ... Fungus? Aku hanya pernah melihatnya di buku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130103
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 737130103,
					"content": "Kebetulan banget! Ada Melusine yang lagi main di sini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130104,
						737130105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737130104,
					"content": "Kita bertemu lagi, Marine.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737130106
					]
				},
				{
					"id": 737130106,
					"content": "Aku tidak lagi bermain, aku lagi memetik Tidalga untuk membuat Tidalga yang diasinkan tahun ini. Ada banyak kakak-kakak yang kembali dan membantu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130107
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 737130107,
					"content": "Enghiene dan Roxane kecil mengambil cuti untuk kembali dan membantu. Mereka lagi bekerja keras sekarang, dan sebentar lagi aku juga mau masuk ke air.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130108
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 737130108,
					"content": "Kamu tahu ... Enghiene benar. Fungus biru itu memang mirip Tidalga ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130109
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 737130109,
					"content": "Maksudku mereka itu lucu! Bukan mau makan mereka ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130110
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 737130110,
					"content": "♫♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130111
					],
					"speakerTitle": "Topi Gendang"
				},
				{
					"id": 737130111,
					"content": "Hehe~ Kamu punya selera yang bagus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130112,
						737130113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737130112,
					"content": "Teman-teman Fungus kita memang sangat menggemaskan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737130114
					]
				},
				{
					"id": 737130114,
					"content": "Baiklah, senang bertemu kalian. Aku harus pergi sekarang. Selamat menikmati sisa waktu kalian di sini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130115
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 737130115,
					"content": "Oke, ayo kita berangkat! Kita akan ambil beberapa foto bawah laut yang cantik di Fontaine bersama teman-teman Fungus kita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737130113,
					"content": "Melusine juga menggemaskan kok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737130114
					]
				},
				{
					"id": 737130105,
					"content": "Halo, teman Melusine baru!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737130106
					]
				}
