				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220340101,
					"content": "Pengembara, tunggu sebentar. Sango ingin minta bantuanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340102
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340102,
					"content": "Apa kasusnya sudah ada kemajuan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220340103
					]
				},
				{
					"id": 220340103,
					"content": "Ketua Sango tidak bilang apa-apa. Dia cuma bilang masih harus melakukan lebih banyak persiapan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340104
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340104,
					"content": "Dia juga menyuruhku menunggumu, lalu meminta kita pergi ke alam liar untuk mencari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340105,
						220340107
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340105,
					"content": "Sebenarnya apa yang mau dia lakukan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220340106
					]
				},
				{
					"id": 220340106,
					"content": "Kalau kamu tanya aku... Sejujurnya, aku juga tidak tahu. Tapi selama kamu melakukan apa yang dikatakan Ketua Sango, biasanya bisa menyelesaikan kasus ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340112
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340112,
					"content": "Oke, ayo sekarang kita bicara hal yang penting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340113
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340113,
					"content": "Kata Ketua Sango, sejak Amano dan Andou melaporkan kejadian tersebut, patroli di kota memang diperketat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340114
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340114,
					"content": "Tapi anehnya, para pedagang di kota masih mengalami pencurian, dan tujuan para pencuri sangat jelas, mereka cuma mau barang yang diincar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340115
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340115,
					"content": "Menurut Kepala Sango, sangat kecil kemungkinan Treasure Hoarder masuk ke kota untuk mencuri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340116
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340116,
					"content": "Pelaku atau para pelaku yang melakukan kasus ini... pasti punya motif tertentu saat melakukan kejahatan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340117
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340117,
					"content": "Kemungkinan terbesar sekarang, ada \"orang dalam\" yang memberikan informasi ke luar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340118
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340118,
					"content": "Jadi tindakan para Doushin menjadi sia-sia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220340119
					]
				},
				{
					"id": 220340119,
					"content": "Tidak, tapi penjahat itu sudah tahu kalau tujuan para Doushin bukanlah dia, jadi dia tidak berhenti melakukan kejahatan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340120
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340120,
					"content": "Semakin banyak dia melakukan kejahatan, semakin mudah untuk menangkapnya. Dan semakin besar kemungkinan Kepala Sango mengetahui identitasnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340121
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340121,
					"content": "Jadi, kita harus tetap berpura-pura tidak peduli sehingga pencuri itu lengah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340122
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340122,
					"content": "Pengembara, itulah kenapa aku memintamu pergi ke alam liar bersamaku dan menarik perhatian Treasure Hoarder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340123
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340123,
					"content": "Tentu saja kami akan memberikan imbalan yang sesuai. Dan... setelah kasus ini selesai, ada hadiah lain untukmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340124
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340124,
					"content": "Apa Sango yang menyuruhmu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220340125
					]
				},
				{
					"id": 220340125,
					"content": "Eh, kamu tahu? Instingmu memang tajam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340126
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340126,
					"content": "Semua ini perintah Sango dan dia menyuruhku untuk membujukmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340127
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340127,
					"content": "Tapi percayalah padaku, kata-kata yang aku bilang tadi tidak bohong. Setidaknya... imbalannya benar-benar ada padaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340128
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340128,
					"content": "Jadi aku mohon bantuanmu untuk hal ini, Pengembara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340129
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340129,
					"content": "Tapi sebenarnya apa yang harus aku lakukan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220340130
					]
				},
				{
					"id": 220340130,
					"content": "Mudah, kita cuma perlu... memprovokasi para Treasure Hoarder. Semakin mereka terpancing, akan semakin baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340131
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340131,
					"content": "Sango sudah memberikan lokasi kemah Treasure Hoarder. Aku akan menandai di petamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340132
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340132,
					"content": "Oke, ayo berangkat sekarang ke tempat ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340107,
					"content": "Kenapa dia sendiri tidak datang?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220340108
					]
				},
				{
					"id": 220340108,
					"content": "Hal ini memang kebiasaan Ketua Sango. Dia selalu bilang... \"aku pandai berpikir, tapi tidak pandai bertindak\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340109
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340109,
					"content": "Dulu ada seorang penulis novel yang datang mewawancarai Kepala Sango, dan bilang mau membuat kisahnya menjadi sebuah novel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340110
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340110,
					"content": "Dia juga bilang Kepala Sango... \"detektif si kursi kerja\". Terus dia sepertinya suka dengan sebutan itu, sampai jadi ingin membeli sebuah kursi kerja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340111
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340111,
					"content": "Tetapi karena masalah keuangan, kursi kerja pun belum bisa dibeli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340112
					],
					"speakerTitle": "Ryuuji"
				}
			]
		},
