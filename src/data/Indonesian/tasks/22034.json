					"nextDialogs": [
						220340204
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340204,
					"content": "Mereka harus kembali dan memberikan informasi agar tujuan kita tercapai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340205
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340205,
					"content": "Terima kasih atas bantuanmu, Pengembara. Silakan terima hadiahnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340206
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340206,
					"content": "Aku juga harus segera kembali dan melaporkan keadaannya ke Sango.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340207
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340207,
					"content": "Entah apa Kepala Sango bisa menyimpulkan sesuatu dari sini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				}
			]
