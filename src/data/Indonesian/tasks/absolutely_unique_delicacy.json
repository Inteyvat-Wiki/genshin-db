			},
			"dialogs": [
				{
					"id": 220250101,
					"content": "Ah... lapar sekali... aduh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250102
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250102,
					"content": "Apa yang terjadi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220250103
					]
				},
				{
					"id": 220250103,
					"content": "Ak-aku juga tidak terlalu mengerti... rasanya aku jadi tidak terlalu semangat saja...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250104
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250104,
					"content": "Mungkin karena tadi malam aku bawa pulang makanan yang kamu buatkan dan memakannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250105
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250105,
					"content": "Meski masakannya memang terasa... \"berbeda\", tapi masih bisa sedikit mengisi perutku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250106
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250106,
					"content": "Setelah itu, aku berencana untuk tidur nyenyak dan bekerja keras hari ini. Alhasil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250107
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250107,
					"content": "Tiap kali aku hampir tertidur, samar-samar bau dari hidangan itu tiba-tiba keluar dari lambungku! Aku jadi langsung terbangun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250108
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250108,
					"content": "Karena terus-terusan seperti itu, aku jadi tidak bisa tertidur sampai matahari terbit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250109
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250109,
					"content": "Kalau hanya tidak cukup tidur sih bukan masalah. Sebelumnya juga aku sering begadang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250110
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250110,
					"content": "Masalahnya adalah hari ini! Kukira setelah aku bangun, aku akan baik-baik saja setelah makan sedikit, tapi tak kusangka waktu aku makan, mulutku masih bisa merasakan hidangan itu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250111
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250111,
					"content": "Masakanku sebegitu berkesannya ya...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220250112
					]
				},
				{
					"id": 220250112,
					"content": "*huff* Bagaimanapun juga, kurasa sekarang... sepertinya cuma makanan dengan rasa yang sangat unik baru bisa menghilangkan aroma aneh ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250113
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250113,
					"content": "Makanan dengan rasa yang unik? Bagaimana kalau kita tanyakan pada yang lainnya, sebenarnya makanan unik itu seperti apa sih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220250114,
					"content": "Lalu kita buatkan satu porsi untuk Nona Tang Wen... Siapa tahu masalahnya beres!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220250115,
					"content": "Wah, yang benar? Aku senang sekali, terima kasih! Ka-kalau boleh, coba kalian bertanya-tanya ke Ritou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250116
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250116,
					"content": "Aku ingat ada seorang pedagang di Ritou bernama Li Xiao, dia sangat ahli soal makanan. Dan Qiuyue dari Chuyu Trading Company, dia juga termasuk pecinta kuliner!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tang Wen"
				}
			]
		},
		{
