			"dialogs": [
				{
					"id": 220250301,
					"content": "Ada apa? Eh... Nona Tang Wen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250307
					],
					"speakerTitle": "Qiuyue"
				},
				{
					"id": 220250307,
					"content": "Rasa aneh di mulut, tidak nafsu makan dan tidak bisa makan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250302
					],
					"speakerTitle": "Qiuyue"
				},
				{
					"id": 220250302,
					"content": "Aku tidak salah dengar? Apa benar karena salah makan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250303
					],
					"speakerTitle": "Qiuyue"
				},
				{
					"id": 220250303,
					"content": "Kedengarannya seperti makan terlalu banyak dan pencernaan jadi tidak lancar. Ehm, coba kupikir-pikir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250304
					],
					"speakerTitle": "Qiuyue"
				},
				{
					"id": 220250304,
					"content": "Sudahlah, kalau tidak yakin apa penyebabnya, aku cuma bisa merekomendasikan satu hidangan, yaitu — Bamboo Shoot Soup!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250305
					],
					"speakerTitle": "Qiuyue"
				},
				{
					"id": 220250305,
					"content": "Rasanya asin dan gurih, dagingnya empuk, menyegarkan dan menggugah selera, dan kuahnya juga membantu pencernaan. Oh, rasanya jadi ingin makan juga sekarang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250306
					],
					"speakerTitle": "Qiuyue"
				},
				{
					"id": 220250306,
					"content": "Percaya padaku, yang Nona Tang Wen butuhkan sekarang adalah Bamboo Shoot Soup!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qiuyue"
				}
			]
