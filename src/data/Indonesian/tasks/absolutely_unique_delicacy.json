			"dialogs": [
				{
					"id": 220250201,
					"content": "Ada apa? Oh... Maksudmu Nona Tang Wen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250207
					],
					"speakerTitle": "Li Xiao"
				},
				{
					"id": 220250207,
					"content": "Tidak nafsu makan... rasa aneh di mulut... perlu hidangan yang unik baru bisa sembuh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250202
					],
					"speakerTitle": "Li Xiao"
				},
				{
					"id": 220250202,
					"content": "Kenapa bisa muncul masalah seperti ini... sulit juga yah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250203
					],
					"speakerTitle": "Li Xiao"
				},
				{
					"id": 220250203,
					"content": "Tapi menurutku, tidak perlu hidangan yang super mewah, asalkan tekstur dan rasanya khas, ditambah dengan aroma yang kuat, seharusnya sudah cukup...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250204
					],
					"speakerTitle": "Li Xiao"
				},
				{
					"id": 220250204,
					"content": "Jadi saranku — Jueyun Guoba! Rasa gurihnya unik dan aroma pedasnya sangat kuat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250205
					],
					"speakerTitle": "Li Xiao"
				},
				{
					"id": 220250205,
					"content": "Sejak pertama kali mencicipi Jueyun Guoba di Desa Qingce sepuluh tahun yang lalu, rasanya masih terbayang di ingatanku sampai sekarang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250206
					],
					"speakerTitle": "Li Xiao"
				},
				{
					"id": 220250206,
					"content": "Kurasa kalau dengan Jueyun Guoba, masalah apa pun pasti beres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Li Xiao"
				}
			]
		},
