			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kid Kujirai",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721760202,
					"content": "Eh, apakah terlalu sulit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760203
					],
					"speakerTitle": "Kid Kujirai"
				},
				{
					"id": 721760203,
					"content": "Tadi kondisinya tidak begitu baik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760204,
					"content": "Kakak, kalian mau coba lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760205
					],
					"speakerTitle": "Kid Kujirai"
				},
				{
					"id": 721760205,
					"content": "#Tentu saja! {NICKNAME}, kita harus perlihatkan pada Kujirai betapa kuatnya kita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760206,
					"content": "Sekali lagi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760207
					]
				},
				{
					"id": 721760207,
					"content": "Oke! Cari Temari dalam waktu yang sudah ditentukan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kid Kujirai"
				}
			]
		},
		{
			"id": 7217607,
			"completionStepIds": [
				7217605
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7217605",
							"2"
						],
						"stepId": 7217605,
						"stateName": "QUEST_STATE_UNFINISHED"
