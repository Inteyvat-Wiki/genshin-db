				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kid Kujirai",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721760702,
					"content": "Kakak hebat sekali, berhasil menemukannya dalam sekejap!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760703
					],
					"speakerTitle": "Kid Kujirai"
				},
				{
					"id": 721760703,
					"content": "#Fufu, {NICKNAME} itu Pengembara yang sudah melewati banyak pertempuran dan pergi ke banyak negara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760704,
					"content": "Wah! Jangan-jangan dia juga pernah ke \"Mondstadt\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760705
					],
					"speakerTitle": "Kid Kujirai"
				},
				{
					"id": 721760705,
					"content": "Tentu saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760706
					]
				},
				{
					"id": 721760706,
					"content": "Wah, hebat sekali! Kudengar dari kakak ada banyak tempat indah di Mondstadt, seperti \"Stormterror's Lair\" dengan menaranya yang tinggi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760707,
						721760708
					],
					"speakerTitle": "Kid Kujirai"
				},
				{
					"id": 721760707,
					"content": "Stormterror's Lair.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760709
					]
				},
				{
					"id": 721760709,
					"content": "Eh, aku tidak tahu menara itu atau Tenshukaku Shogun yang lebih tinggi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760710
					],
					"speakerTitle": "Kid Kujirai"
				},
				{
					"id": 721760710,
					"content": "Kujirai, kenapa kamu ada di alam liar sendirian?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760711,
					"content": "Saat kakak memancing, dia takut aku mengagetkan ikan, jadi dia membiarkanku pergi keluar seorang diri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760712
					],
					"speakerTitle": "Kid Kujirai"
				},
				{
					"id": 721760712,
					"content": "Waktu itu, aku bertemu dengan seorang Kakak Petualang. Dia melihatku kebosanan dan memberiku Temari supaya dapat \"mencari Pengembara yang tamak untuk bermain bersama\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760713
					],
					"speakerTitle": "Kid Kujirai"
				},
				{
					"id": 721760713,
					"content": "Pengembara yang tamak...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760714
					]
				},
				{
					"id": 721760714,
					"content": "Bukan tamak! Dia takut kamu akan bosan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760715
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760715,
					"content": "Ya, kakak, kalian sangat baik, aku senang sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760716
					],
					"speakerTitle": "Kid Kujirai"
				},
				{
					"id": 721760716,
					"content": "Seorang diri di alam liar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760717
					]
				},
				{
					"id": 721760717,
					"content": "Kamu tidak takut sendirian di sini? Apalagi kamu juga bawa banyak barang bagus loh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760718,
					"content": "Kakak sangat baik. Tidak perlu khawatir, Kakak Petualang sudah mengajariku cara mengubah Temari menjadi bom dengan gerakan khusus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760719
					],
					"speakerTitle": "Kid Kujirai"
				},
				{
					"id": 721760719,
					"content": "Bahaya sekali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760720
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760720,
					"content": "Tidak bahaya! Hilichurl, Slime, orang jahat, aku sudah meledakkan banyak sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760721
					],
					"speakerTitle": "Kid Kujirai"
				},
				{
					"id": 721760721,
					"content": "Maksudnya kamu yang bahaya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760722
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760722,
					"content": "Oh ya, kakak, jika kamu ingin bermain Temari bersama teman lain...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760723
					],
					"speakerTitle": "Kid Kujirai"
				},
				{
					"id": 721760723,
					"content": "Datanglah ke sini! Aturannya seperti ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760724
					],
					"speakerTitle": "Kid Kujirai"
				},
				{
					"id": 721760724,
					"content": "Kamu harus menyembunyikan Temari saat lagunya diputar. Setelah itu carilah. Dengan begitu baru adil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760725
					],
					"speakerTitle": "Kid Kujirai"
				},
				{
					"id": 721760725,
					"content": "Aku mengerti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760726
					]
				},
				{
					"id": 721760726,
					"content": "Paimon jadi takut kalau memikirkan mainan yang kita mainkan itu ternyata bom...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760727,
					"content": "Kakak tidak perlu takut, dia memberitahuku, \"Temari mungkin hanya dapat meledakkan orang jahat\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760728
					],
					"speakerTitle": "Kid Kujirai"
				},
				{
					"id": 721760728,
					"content": "\"Mungkin\"?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760729
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760729,
					"content": "Kalau begitu, aku akan pergi ke tempat lain! Sampai jumpa kakak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kid Kujirai"
				},
				{
					"id": 721760708,
					"content": "Oh ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760709
					]
				}
			]
		}
	]
}