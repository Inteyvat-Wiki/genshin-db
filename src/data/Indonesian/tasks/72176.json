				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Kid Kujirai",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721760101,
					"content": "Hai! Kakak, aku punya barang bagus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760102
					],
					"speakerTitle": "Kid Kujirai"
				},
				{
					"id": 721760102,
					"content": "Terima kasih, aku tidak tertarik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760103
					]
				},
				{
					"id": 721760103,
					"content": "Kasihan sekali, masih muda sudah disuruh melakukan bisnis yang mencurigakan begitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760104,
					"content": "Tidak! Aku ingin bermain Temari bersama kakak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760105
					],
					"speakerTitle": "Kid Kujirai"
				},
				{
					"id": 721760105,
					"content": "\"Temari\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760106,
					"content": "Sederhananya, aku akan menyembunyikan Temari di suatu tempat. Jika Kakak bisa menemukannya saat lagu Temari diputar, maka Kakak akan menjadi pemenangnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760107
					],
					"speakerTitle": "Kid Kujirai"
				},
				{
					"id": 721760107,
					"content": "Apa benar Temari dimainkan seperti itu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760108
					]
				},
				{
					"id": 721760108,
					"content": "Eh? Aku diajari oleh seorang Petualang. Dia bilang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760109
					],
					"speakerTitle": "Kid Kujirai"
				},
				{
					"id": 721760109,
					"content": "\"Kujirai, ingat baik-baik. Kamu harus bilang, \"Kalau kamu menang, kamu bisa mendapat barang bagus\".\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760110
					],
					"speakerTitle": "Kid Kujirai"
				},
				{
					"id": 721760110,
					"content": "Jadi kakak, kalau kamu menang, kamu bisa mendapat barang bagus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760111
					],
					"speakerTitle": "Kid Kujirai"
				},
				{
					"id": 721760111,
					"content": "#Bagus! {NICKNAME}, Paimon rasa oke kok main sama anak-anak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760112,
						721760115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760112,
					"content": "Tapi kurasa Temari tidak dimainkan seperti ini...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760113
					]
				},
				{
					"id": 721760113,
					"content": "Cuma orang lokal yang tahu cara mainnya, kita tidak usah memedulikan detailnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760114,
					"content": "Kamu Kujirai? Kami akan menemanimu bermain!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760116,
					"content": "Oke!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kid Kujirai"
				},
				{
					"id": 721760115,
					"content": "Baiklah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760116
					]
				}
			]
		},
		{
			"id": 7217602,
			"completionStepIds": [
				7217602
