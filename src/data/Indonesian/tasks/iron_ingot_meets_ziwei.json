				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413330601,
					"content": "Wah, ini terlihat sempurna! Oke, semua sudah siap, sekarang kita hanya tinggal menemui Ziwei!",
					"roleType": "TALK_ROLE_NPC",
