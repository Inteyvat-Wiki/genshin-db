			"trigger": {
				"objectNames": [
					"Iron Ingot"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413330101,
					"content": "Adeptus Misterius dari Surga Tertinggi yang Melayang Melintasi Langit. Indah sekali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330102
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330102,
					"content": "Apa kamu sedang melihat bintang-bintang?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330103
					]
				},
				{
					"id": 413330103,
					"content": "Benar... tapi juga bukan. Ini Festival Lantern Rite. Pada saat festival begini memang sudah seharusnya melihat pemandangan yang indah begini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330104
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330104,
					"content": "Aku juga belajar untuk menulis puisi. Pria itu bilang para wanita akhir-akhir ini tertarik sekali dengan hal-hal seperti itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330105
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330105,
					"content": "Heh, aku yakin Ziwei akan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330106,
						413330107
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330106,
					"content": "Belajar menulis puisi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330108
					]
				},
				{
					"id": 413330108,
					"content": "Ah, ehem, aku mendengar banyak nama-nama konstelasi dari Ziwei. *huff* Mereka semua terdengar indah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330109
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330109,
					"content": "Jadi bagaimana pun juga, aku harus berterima kasih padanya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330110
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330110,
					"content": "Aku berpikir mungkin aku sebaiknya menuliskan puisi pada Lentera Xiao dan menemukan tempat untuk menerbangkannya bersama-sama dengan Ziwei... Lalu kami bisa memakan camilan dan menyanyi bersama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330111
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330111,
					"content": "——Dengan ini, pasti berhasil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330112
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330112,
					"content": "Pasti berhasil...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330113
					]
				},
				{
					"id": 413330113,
					"content": "Ehem, maksudku... Ini akan membuat kita semua berhasil menikmati festival ini... Ya, maksudku begitu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330114
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330114,
					"content": "Baiklah, aku ingin menemukan tempat yang tenang dan jauh dari kerumunan orang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330115
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330115,
					"content": "Aku mulai bertanya pada orang-orang dan menemukan dua tempat yang menurutku bagus. Kemarilah, coba lihat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330116
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330116,
					"content": "Pria yang tadi bilang bahwa mereka menerbangkan Lentera Xiao di dua tempat ini sebelumnya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330117
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330117,
					"content": "Namun aku masih harus memikirkan puisinya... dan takutnya jika aku terlalu sibuk mencari tempat, hanya akan mematikan kreativitasku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330118
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330118,
					"content": "Bisakah kamu membantuku melihat kedua tempat tersebut?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330119
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330119,
					"content": "Tentu saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330120
					]
				},
				{
					"id": 413330120,
					"content": "Terima kasih atas bantuanmu, aku mengandalkanmu loh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330107,
					"content": "Ziwei?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330108
					]
				}
			]
		},
		{
			"id": 4133302,
			"completionStepIds": [
				4133304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
