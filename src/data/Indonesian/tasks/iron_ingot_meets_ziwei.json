		},
		{
			"id": 4133307,
			"completionStepIds": [
				4133309,
				4133310
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4133309",
							"2"
						],
						"stepId": 4133309,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ziwei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413330701,
					"content": "Dari sudut ini... konstelasi yang di sebelah sana terlihat seperti anjing. Sekarang, aku harus menemukan nama yang sesuai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330702
					],
					"speakerTitle": "Ziwei"
				},
				{
					"id": 413330702,
					"content": "Oh, ternyata kamu Iron Ingot. Apa yang sedang kamu lakukan di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330703
					],
					"speakerTitle": "Ziwei"
				},
				{
					"id": 413330703,
					"content": "Emm, jadi... eh, a-aku hanya sedang berjalan-jalan di pinggiran kota, lalu aku menemukan sebuah tempat yang indah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330704
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330704,
					"content": "Tempat yang indah? Maksudmu untuk melihat bintang-bintang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330705
					],
					"speakerTitle": "Ziwei"
				},
				{
					"id": 413330705,
					"content": "Be-betul! Tempat yang indah untuk melihat bintang-bintang. Tempat ini juga cukup bagus untuk menerbangkan Lentera Xiao... Lihat, aku sudah menyiapkannya untuk kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330706
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330706,
					"content": "Lihatlah, aku juga sudah menyiapkan pu-puisi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330707
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330707,
					"content": "\"Sebuah percikan cahaya muncul saat sekop dan meteorit bertemu.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330708
					],
					"speakerTitle": "Ziwei"
				},
				{
					"id": 413330708,
					"content": "Hmm... Walaupun aku tidak begitu mengerti apa harapanmu itu, tapi puisinya cukup bagus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330709
					],
					"speakerTitle": "Ziwei"
				},
				{
					"id": 413330709,
					"content": "Tapi kamu tidak boleh membiarkan orang lain membaca harapanmu sebelum menerbangkan Lentera Xiao, nanti harapanmu tidak akan terkabul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330710
					],
					"speakerTitle": "Ziwei"
				},
				{
					"id": 413330710,
					"content": "Lalu, ada perlu apa kamu denganku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330711
					],
					"speakerTitle": "Ziwei"
				},
				{
					"id": 413330711,
					"content": "Aku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330712,
						413330713
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330712,
					"content": "Dia menemukan tempat yang bagus untuk menerbangkan Lentera Xiao.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330714
					]
				},
				{
					"id": 413330714,
					"content": "Menerbangkan Lentera Xiao? Oh, maaf... aku sebenarnya berharap untuk pergi ke tempat yang jauh dari semua Lentera Xiao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330715
					],
					"speakerTitle": "Ziwei"
				},
				{
					"id": 413330715,
					"content": "Semua Lentera Xiao ini menghalangi pemandangan bintang-bintang yang ingin kulihat. Sepertinya aku ingin pergi ke tempat yang jauh dari keramaian festival...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330716
					],
					"speakerTitle": "Ziwei"
				},
				{
					"id": 413330716,
					"content": "Tapi terima kasih atas tawaranmu. Aku akan melanjutkan perjalananku, Selamat Hari Lantern Rite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330717
					],
					"speakerTitle": "Ziwei"
				},
				{
					"id": 413330717,
					"content": "Oh, uh... aku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330718,
						413330719
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330718,
					"content": "Oh, dia pergi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330720
					]
				},
				{
					"id": 413330720,
					"content": "A-aku tidak apa-apa. Sepertinya tulisanku terlalu abstrak sehingga Ziwei tidak mengerti maksudku sama sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330721
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330721,
					"content": "Jangan khawatir, ini tidak akan memengaruhiku. Dia akan mengerti artinya suatu hari nanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330722
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330722,
					"content": "Pengembara, terima kasih atas bantuanmu. Ini untukmu, terimalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330723
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330723,
					"content": "Oh, sepertinya aku harus menerbangkan Lentera Xiao itu sekarang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330719,
					"content": "Jangan bersedih begitu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330720
					]
				},
				{
					"id": 413330713,
					"content": "Jadi jika kamu mau menerbangkan lentera malam ini, kamu bisa pergi bersama dengannya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330714
					]
				}
			]
		},
