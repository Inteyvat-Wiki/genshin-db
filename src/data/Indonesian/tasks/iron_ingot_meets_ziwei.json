					"nextDialogs": []
				},
				{
					"id": 413330303,
					"content": "Aku masih butuh sedikit waktu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330304
					]
				},
				{
					"id": 413330304,
					"content": "Ah, tidak, tidak, tidak ada apa-apa. Aku harus memikirkan bagaimana menulis puisi ini...",
					"roleType": "TALK_ROLE_NPC",
