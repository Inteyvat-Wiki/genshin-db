			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iron Ingot"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413330201,
					"content": "\"Ziwei tersandung oleh sebuah besi\"... ah tidak, tidak, itu tidak bagus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330202
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330202,
					"content": "Oh, kapan kalian kembali? Apa kalian sudah melihat kedua tempat tersebut?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330203
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330203,
					"content": "Sudah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330204
					]
				},
				{
					"id": 413330204,
					"content": "Wah, cepat juga ya, coba kulihat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330205
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330205,
					"content": "Baiklah, coba kulihat dulu ya... Hmm, pemandangan di sini sungguh unik, tapi di tempat yang satunya lagi terlihat lebih menawan. Mengingatkanku pada sebuah pepatah, \"Sedikit demi sedikit, lama-lama menjadi...\" Eh, aku lupa lanjutannya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330206
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330206,
					"content": "Ah sudahlah... namun, tempat ini tetap saja terlihat cerah dan mengagumkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330207
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330207,
					"content": "Ah, aku tahu! Aku tahu mana yang akan kupilih... Tapi, aku masih membutuhkan bantuanmu, Pengembara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330208
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330208,
					"content": "Temanku bilang saat kamu mengunjungi seseorang, akan lebih baik jika kamu membawa sesuatu untuk dimakan. Menurutmu apa yang harus kubawa saat mengunjungi Ziwei nanti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330209,
						413330211
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330209,
					"content": "Grilled Tiger Fish.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330210
					]
				},
				{
					"id": 413330210,
					"content": "Grilled Tiger Fish, hmm... Apa menurutmu itu tidak terlalu berminyak? Mungkin sesuatu yang ringan dan mudah dimakan, seperti Almond Tofu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330212
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330212,
					"content": "Baiklah, Almond Tofu! Sempurna!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330213
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330213,
					"content": "Pengembara, bisakah kamu membantuku menyiapkan seporsi Almond Tofu? Sementara aku, aku akan mengerjakan puisiku di sini. Baiklah, sekarang baris selanjutnya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330214
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330214,
					"content": "\"Ribuan percikan api beterbangan\"... Kalimat ini lumayan bagus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330211,
					"content": "Almond Tofu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330212
					]
				}
			]
		},
