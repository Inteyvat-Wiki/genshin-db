					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171502
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 401171502,
					"content": "Tapi seperti yang Nona Panglima bilang ... Kalau memang bisa memperbaiki domainnya, maka ....",
