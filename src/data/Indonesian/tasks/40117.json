			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Klee",
					"Kaeya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401171301,
					"content": "Oh ya, Kak Kaeya. Kakak kemarin janji mau cerita soal Jinni di dalam botol kan kalau aku tidak lari-lari. Masih ingat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171302
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401171302,
					"content": "Ah, benar. Baiklah, kita sampai mana terakhir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171303
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401171303,
					"content": "Oh, Klee ingat! Jinni-nya keluar, terus dia mau makan bocah gembala yang buka botolnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171304
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401171304,
					"content": "Benar, begitu Jinni membuka mulutnya yang lebar dan menjijikkan, bocah gembala itu tiba-tiba punya ide cerdik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171305
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401171305,
					"content": "Apa dia lempar Jumpy Dumpty ke mulut Jinni itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171306
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401171306,
					"content": "Haha! Aku yakin kalau waktu itu bocah itu punya Jumpy Dumpty, dia pasti akan lakukan hal yang sama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171307
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401171307,
					"content": "Tapi si bocah gembala belum pernah lihat yang seperti itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171314
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401171314,
					"content": "Jadi dia bilang ke Jinni: \"Tunggu dulu, kamu kan besar sekali, apa kamu benar-benar keluar dari botol kecil itu? Aku tidak akan percaya kalau belum lihat dengan mata kepala sendiri!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171308
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401171308,
					"content": "Jinni menjadi marah dan berkata: \"Mwahaha! Dasar bocah bodoh! Berani-beraninya kamu mempertanyakan kekuatanku!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171309
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401171309,
					"content": "Jinni akhirnya kembali masuk ke dalam botol itu, lalu bocah gembala itu langsung menutup botolnya rapat-rapat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171310
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401171310,
					"content": "Yey! Jadi Jinni-nya tidak bisa keluar lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171311
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401171311,
					"content": "Tapi, apa Jinni benar-benar bisa tidur di tempat sekecil itu? Harusnya enggak nyaman, kan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171312
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401171312,
					"content": "Tidak, tapi Jinni itu ditangkap dan disegel di dalam botol karena dia melakukan banyak sekali hal jahat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171313
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401171313,
					"content": "Jadi hal paling penting yang perlu diingat adalah, kalau kamu melakukan hal yang salah dan tidak mau dikurung, ya jangan sampai tertangkap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171314
					],
					"speakerTitle": "Kaeya"
				}
			]
		},
		{
			"id": 4011714,
			"completionStepIds": [],
