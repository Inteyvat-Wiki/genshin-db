				"objectNames": [
					"Collei",
					"Eula"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401171401,
					"content": "Klee bilang dia menemukan rel misterius yang bisa dikendarai pakai \"Kereta Gedak-Geduk yang super seru\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171402
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 401171402,
					"content": "Ah, aku juga dengar. Jadi, keretanya itu akan ikut melaju di jalur yang \"menakutkan\" dengan \"kecepatan yang tidak terkendali\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171403
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401171403,
					"content": "Iya, harusnya yang itu. Sepertinya waktu keretanya jalan di jalanan curam, badanmu akan ikut melayang seolah badan kita jadi ringan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171404
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 401171404,
					"content": "Serius? Heh, aku dengar tas Klee hampir terbang di atas kereta. Kalau bukan Kaeya yang tangkap, mungkin semua Jumpy Dumpty-nya akan beterbangan ke atas udara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171405
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401171405,
					"content": "Oh, kok kedengarannya bahaya ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171406
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 401171406,
					"content": "*huff* Tapi, kalau kamu memang mau naik, aku akan temani kalau ada waktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171407
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401171407,
					"content": "Hah? Tapi Eula, kenapa kamu bisa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171408
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 401171408,
					"content": "Aku ngerti sih kamu ingin coba ... Tapi aku jelaskan dulu ya, aku tidak akan bantu pungut barangmu yang jatuh dari kereta nanti. Jadi sebelum naik kereta, pastikan kamu sudah keluarkan semua barang-barangmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171409
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401171409,
					"content": "Yep, yep!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Collei"
				}
			]
		},
		{
