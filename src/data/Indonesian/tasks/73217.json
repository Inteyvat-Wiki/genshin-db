			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732170901,
					"content": "\"Walaupun layanan Penginapan Shapur baik, peredam suaranya sangat buruk.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170902
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 732170902,
					"content": "\"Awalnya aku tinggal di sini karena biaya di Pelabuhan Ormos rendah. Sepertinya aku harus pindah ke Kota Sumeru.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170903
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 732170903,
					"content": "\"Kalau tahun ini gagal ujian lagi, aku akan pulang kampung dan menjadi petani. Aku tidak tahu apakah nanti bisa bawa sedikit Anahitian Blessing ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pengumuman"
				}
			]
		},
		{
			"id": 7321710,
			"completionStepIds": [
				7321710
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321710",
							"2"
						],
						"stepId": 7321710,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171001,
					"content": "\"Utusan Mahamata akhir-akhir ini makin lama makin tidak ada gunanya. Mereka tidak bisa menjawab semua pertanyaan yang aku ajukan.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171002
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 732171002,
					"content": "\"Sekarang saja Akasha sudah bisa diakses bebas, rasanya tingkat kemampuanku masih di atas mereka.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171003
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 732171003,
					"content": "\"Tidak terkecuali Panitera yang tidak sering terlihat itu, yang sudah membantu kita mengatur jadwal kapal. Sepertinya tidak semua orang dari Akademiya sebodoh itu.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pengumuman"
				}
			]
		},
		{
			"id": 7321711,
			"completionStepIds": [
				7321711
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321711",
							"2"
						],
						"stepId": 7321711,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171101,
					"content": "\"Walaupun pekerjaan yang harus kulakukan bertambah banyak sejak Cyno menjadi Mahamatra Agung, aku merasa lebih lega karena tidak harus berhadapan dengan perdebatan Darshan yang membosankan itu lagi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171102
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 732171102,
					"content": "\"Kalau tidak, aku tidak bisa bersantai di sini selagi melakukan perjalanan penelitian ini.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171103
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 732171103,
					"content": "\"Aku tidak tahu ke mana perginya Cyno baru-baru ini. Semestinya aku tidak akan ketahuan kalau menulis di sini, kan?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171104
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 732171104,
					"content": "\"Aku sudah melihatnya. Lapor padaku besok siang dan terimalah sanksinya.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171105
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 732171105,
					"content": "\"Jangan membuang-buang waktuku.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pengumuman"
				}
			]
		},
		{
			"id": 7321712,
			"completionStepIds": [
				7321712
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321712",
							"2"
						],
						"stepId": 7321712,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171201,
					"content": "\"Kami memperdagangkan hasil produksi Liyue yang meliputi produk permata dan bijih tambang. Didukung oleh jalur suplai yang stabil dan kerja sama jangka panjang dengan berbagai armada.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171202
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 732171202,
					"content": "Dijual sutera dan pakaian modis baru dengan jumlah terbatas. Penawaran terbatas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171203
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 732171203,
					"content": "Hubungi kami jika Anda memiliki jalur suplai untuk barang-barang seperti karpet lokal Sumeru, rempah-rempah, batu perhiasan, kain brokat, dan barang berkualitas lainnya. Mari berdagang dan menjalin hubungan yang baik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pengumuman"
				}
			]
		},
		{
			"id": 7321713,
			"completionStepIds": [
				7321713
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321713",
							"2"
						],
						"stepId": 7321713,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171301,
					"content": "\"Bulan lalu aku pergi ke negara lain yang bahkan rajanya tidak punya seekor kuda pun. Percayakah kamu?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171302
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 732171302,
					"content": "\"Jadi aku putuskan untuk menjual beberapa Sumpter Beast di sana dan memberitahu mereka kalau itu kuda, haha. Kalau ini berhasil, mungkin saja aku bisa jadi raja atau apalah di sana!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171303
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 732171303,
					"content": "\"Raja itu apa?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171304
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 732171304,
					"content": "\"Seperti Petugas Pelabuhan atau Vizier, tapi punya kuasa yang lebih besar dari mereka. Mirip dengan yang ada di Legenda Twenty-Nine Deys ... Duh, susah menjelaskannya.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171305
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 732171305,
					"content": "\"Cerita ini hanya karanganmu saja, kan?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pengumuman"
				}
			]
		},
		{
			"id": 7321714,
			"completionStepIds": [
				7321714
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
