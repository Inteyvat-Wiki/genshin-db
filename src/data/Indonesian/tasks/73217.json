			"dialogs": [
				{
					"id": 732170501,
					"content": "Laporkan data diri dan alasan merapatkan kapal ke Master Pelabuhan di pelabuhan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170502
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 732170502,
					"content": "Kapal dagang perlu menyertakan rincian barang yang dimuat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170503
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 732170503,
					"content": "Kapal dagang yang belum terdaftar tidak diperbolehkan membongkar muatan dan memulai aktivitas perdagangan di sini. Segala bentuk pelanggaran akan mendapatkan denda berat.",
					"roleType": "TALK_ROLE_NPC",
