				},
				{
					"id": 732171902,
					"content": "\"Perdagangan jamur liar antara Sumeru dan Inazuma sudah disetujui Master Pelabuhan. Peluang kerja sama kami dengan pedagang jamur sudah dibuka.\"",
					"roleType": "TALK_ROLE_NPC",
