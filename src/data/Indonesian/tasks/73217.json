			"dialogs": [
				{
					"id": 732170601,
					"content": "Investigasi ketat dilaksanakan di area pelabuhan untuk melacak tindak penyelundupan. Semua barang yang singgah di pelabuhan ini perlu didaftarkan dan diperiksa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170602
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 732170602,
					"content": "Seluruh barang yang tidak terdaftar atau barang selundupan akan disita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170603
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 732170603,
					"content": "Semua konsekuensi ditanggung oleh pemilik kargo.",
