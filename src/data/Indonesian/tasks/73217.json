			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171501,
					"content": "Kepada pelaut, pengembara, pedagang, dan penghuni pelabuhan: Peraturan pelabuhan diumumkan di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171502
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 732171502,
					"content": "Jika ada perselisihan, hubungi Sheriff Shyam untuk mendapatkan bantuan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pengumuman"
				}
			]
		},
		{
			"id": 7321716,
			"completionStepIds": [
				7321716
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321716",
							"2"
						],
						"stepId": 7321716,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171601,
					"content": "\"Daripada mengunjungi Grand Bazaar di Kota Sumeru, lebih baik kunjungi pasar tua di Pelabuhan Ormos.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171602
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 732171602,
					"content": "\"Dibandingkan dengan Grand Bazaar yang dikacaukan oleh Mahamata, di sini kami lebih menjaga banyak tradisi dan kekhasan Sumeru.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171603
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 732171603,
					"content": "\"Tapi tentu saja, kalau mau melihat pertunjukan tari, kamu masih harus datang ke Zubayr Theater.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171604
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 732171604,
					"content": "\"Orang desa tetaplah orang desa. Kota Sumeru dibangun dengan perencanaan peneliti yang sangat baik, termasuk pembagian wilayahnya yang juga didukung oleh penelitian ilmiah.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171605
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 732171605,
					"content": "\"Di sini ada orang yang tidak tahu apa-apa tapi suka omong kosong. Entah bagaimana jalanan semrawut di Pelabuhan Ormos sana bisa dipandang sebagai harta oleh mereka!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171606
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 732171606,
					"content": "\"Kamu bilang apa? Aku tidak bisa mendengarnya!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pengumuman"
				}
			]
		},
		{
			"id": 7321717,
			"completionStepIds": [
				7321717
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321717",
							"2"
						],
						"stepId": 7321717,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171701,
					"content": "\"Tidak enak hati membicarakannya. Kami awalnya adalah pekerja yang memelihara kapal dagang dan mencari nafkah dari keterampilan memelihara kapal yang diturunkan oleh leluhur kami.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171702
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 732171702,
					"content": "\"Tapi beberapa waktu yang lalu, teknologi baru disematkan pada Akasha. Akibatnya, pengalaman kami yang sudah bertahun-tahun itu jadi tidak berguna lagi. Anak muda juga bisa menggunakannya untuk belajar. Tapi umur kami sudah tidak muda lagi, jadi kami terpaksa beralih pekerjaan.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171703
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 732171703,
					"content": "\"Walaupun Panitera berkata kalau kami bisa pergi ke laut untuk mengadu peruntungan, kami benar-benar tidak punya uang sekarang. Kalau ada sesuatu yang bisa dikerjakan, tolong hubungi kami.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171704
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 732171704,
					"content": "\"Jangan dengarkan Panitera itu. Kebetulan aku ada pelanggan besar yang butuh pengrajin. Akan kukenalkan kalian kepadanya. Ambil saja uang ini dan lupakan pertimbanganmu untuk pergi ke laut.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171705
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 732171705,
					"content": "\"Kuharapkan kalian bisa kurangi melakukan sesuatu yang tidak berarti. Ada orang yang berhasil, ada juga yang gagal, begitulah hukum alam. Kenapa harus repot-repot melawannya demi menjadi orang baik?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171706
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 732171706,
					"content": "\"Panitera lagi-lagi membahas sesuatu yang mistis. Coba kenapa bisa seperti itu? Karena bisa membuat aku senang!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171707
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 732171707,
					"content": "\"Dan jangan lupa, kalau saling membantu, keadilan, dan kemarahan untuk sesuatu yang benar itulah hal yang membuat bumi berputar. Bukan omong kosong seperti 'siapa yang terkuat dialah yang menang'.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171708
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 732171708,
					"content": "\"Jangan salah tangkap. Aku tidak membantah apa yang kamu maksud, tapi kamu tidak mengerti apa yang aku bicarakan. Sudahlah, kita sudahi saja percakapan ini.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171709
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 732171709,
					"content": "\"Pusing sekali berdebat dengan orang yang bertindak tanpa berpikir ... Omong-omong anggaranmu sendiri di mana? Jangan bilang kalau subsidi Akademiya sudah kamu habiskan untuk omong kosong itu?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171710
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 732171710,
					"content": "\"'Orang miskin menderita karena harta orang kaya, jadi orang kaya harus memberikan kekayaannya untuk tujuan yang baik.' kata Sage Zolfikar.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171711
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 732171711,
					"content": "\"Dia tidak pernah bicara seperti itu.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171712
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 732171712,
					"content": "\"Pernah.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171713
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 732171713,
					"content": "\"Tidak pernah. Minuman bulan ini kamu sendiri yang bayar.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171714
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 732171714,
					"content": "\"Aku tidak mau mendebatkan ini denganmu. Tapi beri aku waktu sebulan, akan kubuktikan kalau dia pernah mengatakannya.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pengumuman"
				}
			]
		},
		{
			"id": 7321718,
			"completionStepIds": [
				7321718
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321718",
							"2"
						],
						"stepId": 7321718,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171801,
					"content": "\"Rute ke Pelabuhan Dornman sudah dibuka. Dengan tulus kami mengundang Anda untuk bergabung dalam bisnis buah-buahan kami.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171802
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 732171802,
					"content": "\"Tunggu dulu, mengimpor buah dari sini ke Mondstadt? Jauh sekali, mana bisa. Kalau dagang minuman beralkohol aku mungkin masih berminat.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171803
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 732171803,
					"content": "\"Semua orang tahu kalau bisnis impor minuman beralkohol dari Mondstadt itu ada, tapi kalau buah? Cuma aku satu-satunya yang punya bisnis itu, makanya ini adalah peluang! Paham?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171804
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 732171804,
					"content": "\"Dan kamu juga tidak perlu benar-benar mengimpornya dari Mondstadt ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pengumuman"
				}
			]
