			"dialogs": [
				{
					"id": 732170101,
					"content": "Papan pengumuman ini dipasang oleh Master Pelabuhan dari Pelabuhan Ormos untuk mempublikasikan informasi penting Pelabuhan Ormos. Jika ada pertanyaan dapat menyampaikannya di papan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pengumuman"
				}
			]
		},
		{
			"id": 7321702,
			"completionStepIds": [
				7321702
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321702",
							"2"
						],
						"stepId": 7321702,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732170201,
					"content": "\"Bingung dengan format tugas akhir? Susah cari ide untuk tugas akhir? Waktunya mencoba cara baru!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170202
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 732170202,
					"content": "\"Saya mengambil jurusan Haravatat dan mahir dalam Spantamad dan Kshahrewar. Menyediakan jasa konsultasi penulisan tugas akhir.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170203
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 732170203,
					"content": "\"Sudah waktunya menyudahi penderitaanmu. Hubungi Tuan Amandeep di hotel. Biaya jasa bisa dinegosiasikan.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170204
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 732170204,
					"content": "\"Bisa tolong tuliskan?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170205
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 732170205,
					"content": "\"Tidak bisa. Tuan Pengawas tidak mengizinkan tindakan seperti itu.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170206
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 732170206,
					"content": "\"Memang begitu. Fokuslah dalam belajar dan jangan coba-coba untuk curang.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pengumuman"
				}
			]
		},
		{
			"id": 7321703,
			"completionStepIds": [
				7321703
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321703",
							"2"
						],
						"stepId": 7321703,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732170301,
					"content": "Apakah kamu pernah mendengar teknik melayang? Pernahkah kamu melihat seseorang yang sedang terbang? Mau tahu rahasia di balik Sumpter Beast terbang? Kalau begitu jangan ketinggalan penampilan perdana Fontaine Flyers di Sumeru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170302
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 732170302,
					"content": "Selamat datang, petunjukannya sudah dimulai! Jangan ketinggalan pertunjukan seni yang unik ini! Cukup lima Mora saja untuk membeli tiketnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170303
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 732170303,
					"content": "\"Benar-benar menakjubkan! Aku belum pernah melihat pertunjukan sehebat ini di Fontaine!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pengumuman"
				}
			]
		},
		{
			"id": 7321704,
			"completionStepIds": [
				7321704
