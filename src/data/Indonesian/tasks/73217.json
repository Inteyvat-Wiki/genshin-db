			},
			"dialogs": [
				{
					"id": 732170401,
					"content": "Pengingat khusus: \"Eremite\" adalah satu-satunya pakaian prajurit resmi di Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170402
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 732170402,
					"content": "Jangan terlalu mudah percaya pada orang asing untuk menghindari penipuan",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170403
					],
					"speakerTitle": "Papan Pengumuman"
				},
				{
					"id": 732170403,
					"content": "Jika Anda membutuhkan pengawal, petugas keamanan, atau permintaan lainnya, mohon hubungi Kapten Feroz dari \"Corps of Thirty\" di Pelabuhan Ormos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pengumuman"
				}
			]
		},
