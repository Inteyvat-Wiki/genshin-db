			"dialogs": [
				{
					"id": 220170201,
					"content": "Pengembara, boleh tolong ambilkan beberapa novel? Aku mau bicara penting dengan dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170202
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170202,
					"content": "Haah... Kalau kubiarkan dia menulis sesuka hati, hasilnya pasti berantakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shigeru"
