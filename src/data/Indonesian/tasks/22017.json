				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Junkichi",
					"Shigeru"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220170101,
					"content": "Aku berhenti! Terserah kalian mau bilang apa! Pokoknya aku berhenti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170102
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170102,
					"content": "Astaga... Kamu bilang begitu tujuh kali, apa ada yang kejadian?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170103
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170103,
					"content": "Kalian ribut apa lagi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220170104
					]
				},
				{
					"id": 220170104,
					"content": "Akhirnya kamu datang, Pengembara! Tolonglah, bantu aku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170105
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170105,
					"content": "Sejak dibela olehmu tempo hari, orang ini jadi punya alasan. Lama-lama jadi keterlaluan, dia buat banyak sekali aturan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170106
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170106,
					"content": "Mulai dari penamaan sampai plot, semuanya... semuanya jadi ada standarnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170107
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170107,
					"content": "Kalau begini apa artinya aku menulis? Biar dia yang kerjakan sendiri! Tinggal ikut \"standar\" saja kan!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170108
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170108,
					"content": "Semua itu aku pelajari dari novel yang sudah sukses. Pengalaman berharga dari para penulis terdahulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170109
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170109,
					"content": "Bukannya itu sama saja memasukkan novel lain ke dalam karyaku? Sebenarnya yang menulis itu aku, atau para \"penulis terdahulu\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170110
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170110,
					"content": "Aku tidak mungkin menulis dengan... dengan kaku begini. Kalau kamu suka gaya begitu, silakan tulis saja sendiri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170111
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170111,
					"content": "Lagi pula, di Yae Publishing House sudah banyak novel seperti itu, dan tidak laku juga kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170112
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170112,
					"content": "Ah, itu masalah promosi sih, tapi kalau novelnya sendiri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170113
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170113,
					"content": "Jelas-jelas tidak ada hubungannya dengan promosi! Semua murni karena cara penulisannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170114
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170114,
					"content": "Kamu mungkin tidak memperhatikan setiap buku yang ada, tapi aku, sebagai seorang penulis, sudah baca semua buku yang diterbitkan Yae Publishing House.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170115
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170115,
					"content": "Pengembara, boleh tolong ambilkan beberapa novel? Aku mau bicara penting dengan dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170116,
						220170117
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170116,
					"content": "Boleh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 220170117,
					"content": "Mau novel seperti apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220170118
					]
				},
				{
					"id": 220170118,
					"content": "Tolong ambil novel-novel yang kutaruh di sekitar sini. Aku menjadikan novel-novel itu sebagai pengingat... untuk jangan pernah menulis seperti itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				}
			]
		},
