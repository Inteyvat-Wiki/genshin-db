			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Junkichi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220170301,
					"content": "Pengembara, novel-novelnya sudah kamu ambil kan? Mana, lihat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				}
			]
		},
		{
			"id": 2201704,
			"completionStepIds": [
				2201706
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201706",
							"2"
						],
						"stepId": 2201706,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Shigeru",
					"Junkichi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220170401,
					"content": "Aku ingat novel misteri ini. Bukannya ini sempat populer cukup lama dan disukai orang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170402
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170402,
					"content": "Justru novel ini sukses karena teka-tekinya yang cerdik dan alur cerita yang direncanakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170403
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170403,
					"content": "Meskipun banyak orang yang merasa kalau alur ceritanya terlalu lompat-lompat dan tidak terduga, sehingga sulit dimengerti, tapi pengarangnya tetap teguh pada prinsipnya sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170404
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170404,
					"content": "Karena itulah novel ini bisa menonjol dibanding dengan novel misteri lainnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170405
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170405,
					"content": "Tapi latar belakang novel ini sangat kuat. Harus punya latar belakang kuat dan tidak mudah berubah, baru bisa mendukung sebuah alur cerita yang sangat menegangkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170406
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170406,
					"content": "Uhh... ini... Pengembara, apa ada buku lainnya...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				}
			]
		},
		{
			"id": 2201705,
			"completionStepIds": [
				2201705
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201705",
							"2"
						],
						"stepId": 2201705,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Shigeru",
					"Junkichi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220170501,
					"content": "Novel ini? Setahuku gaya penulisannya bagus, alur cerita dan plotnya juga tersusun rapi, sampai editor-editor memujinya. Angka penjualannya waktu itu juga bagus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170502
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170502,
					"content": "...Benarkah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170503
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170503,
					"content": "Tapi karena plot dan latar belakangnya terlalu kaku, jadi tidak ada ruang untuk perkembangan alur cerita, akhirnya cuma bisa mengulang cerita yang sudah diketahui pembaca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170504
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170504,
					"content": "Karena tidak ada cerita baru lagi, lama-lama pembacanya jadi berkurang, sampai akhirnya tidak ada lagi yang membacanya dan novel ini pun terlupakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170505
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170505,
					"content": "Kalau alur atau latar belakang cerita dibatasi, pasti semua cerita akan jadi sama saja, dan pelan-pelan akan kehilangan daya tariknya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170506
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170506,
					"content": "Aku tidak mau novelku jadi seperti itu! Sebuah cerita yang baik harus memiliki daya tarik yang unik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170507
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170507,
					"content": "Lagi pula, kalau... kalau seorang penulis tidak tertarik pada ceritanya sendiri, bagaimana mungkin bisa menyentuh hati para pembacanya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170508
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170508,
					"content": "Tuan Shigeru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170509
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170509,
					"content": "...Aku mengerti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170510
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170510,
					"content": "Aku tidak menyangka kamu memikirkannya sampai sejauh itu. Tak heran deh kamu menulis novel seperti \"Onibudou\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170511
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170511,
					"content": "Sebenarnya aku bukan ingin kamu membatasi karyamu, tapi aku sudah lihat banyak sekali penulis yang merusak karyanya sendiri karena imajinasi dan keinginan berkreasi yang terlalu tinggi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170512
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170512,
					"content": "Aku ingin tahu pendapatmu tentang hal ini, Junkichi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170513
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170513,
					"content": "Menurutku, penulis yang tidak memiliki keinginan untuk berkreasi pasti tidak bisa menghasilkan karya yang bisa menyentuh hati pembaca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170514
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170514,
					"content": "Tapi menurutku, kemampuan untuk mengontrol diri atas keinginan berkreasi lebih penting lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170515,
						220170516
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170515,
					"content": "Masih tidak sepemahaman juga...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220170517
					]
				},
				{
					"id": 220170517,
					"content": "Tuan Shigeru, aku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170518
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170518,
					"content": "Tapi bukan aku yang menulis novel ini. Kamulah penulisnya. Aku cuma seorang editor yang membantumu menyelesaikan novel ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170519
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170519,
					"content": "Kalau kamu memang punya prinsip dan pemikiran sendiri, lakukanlah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170520
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170520,
					"content": "Aku tidak bisa bilang aku sepemahaman denganmu, tapi aku akan berusaha memahamimu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170521
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170521,
					"content": "Ah... terima kasih, Tuan Shigeru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170522
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170522,
					"content": "Tidak, sudah seharusnya. Tapi tentu saja, kamu juga harus memahamiku, contohnya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170523
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170523,
					"content": "Uh... Apa...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170524
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170524,
					"content": "Contohnya... Hari ini sudah lewat batas waktunya... Mana naskahmu!?",
					"roleType": "TALK_ROLE_NPC",
