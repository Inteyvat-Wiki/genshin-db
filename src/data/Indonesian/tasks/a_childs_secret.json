			},
			"dialogs": [
				{
					"id": 101100101,
					"content": "#{NICKNAME}, lihat ke sana, lihat ke sana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100102,
					"content": "Di, di sana tidak ada orang lain kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100103,
					"content": "Tapi dia jelas-jelas sedang berbicara dengan seseorang! Lihat, dia tertawa! Hiiii, menakutkan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100104,
					"content": "Saat kecil aku juga sering main dengan teman imajinasi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100105
					]
				},
				{
					"id": 101100105,
					"content": "#Wah? Kamu juga dulu melakukan hal seperti itu, {NICKNAME}!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100106,
					"content": "Jadi... apakah teman ini hanya teman imajinasi, atau... teman tidak terlihat yang menemanimu bermain?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100107,
						101100109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100107,
					"content": "\"Imajinasi\" berarti hanya di dalam pikiranmu saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100108
					]
				},
				{
					"id": 101100108,
					"content": "Teman imajinasi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100111,
					"content": "Oh, berarti... teman yang diimajinasikan, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100112,
					"content": "Teman imajinasimu terlihat seperti apa, cepat perlihatkan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100113,
						101100114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100113,
					"content": "Sekarang tidak begitu sering main bareng lagi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100115
					]
				},
				{
					"id": 101100115,
					"content": "Eh? Apakah teman imajinasi menghilang saat menjadi dewasa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100116,
						101100117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100116,
					"content": "Iya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100118
					]
				},
				{
					"id": 101100118,
					"content": "Uh... padahal aku ingin melihatnya... Oh iya, apakah saudara kembarmu juga punya teman imajinasi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100119,
					"content": "Ada dong.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100120
					]
				},
				{
					"id": 101100120,
					"content": "Ternyata ada juga! Enak sekali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100121,
					"content": "Apakah kamu pernah dengar tentang permainan kartu dari Liyue? Biasanya ada 4 pemain, tapi 2 orang juga sudah bisa bermain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100122,
					"content": "Pengembara! Kebetulan sekali, kalian juga di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100123
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100123,
					"content": "Pengamen, kamu lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100124,
					"content": "Haha, karena Lisa akhir-akhir ini membuat barang-barang yang menarik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100125
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100125,
					"content": "Yang disebut Lisa \"menarik\" membuatku takut...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100126,
					"content": "Hei, jangan menilai seorang wanita seperti itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100127
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100127,
					"content": "Untuk barang ini, Lisa sampai harus mengimpor bahan-bahan berbahaya dari Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100128
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100128,
					"content": "Ber, berbahaya!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100129,
						101100131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100129,
					"content": "Ini... kacamata dengan sejenis detektor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100130
					]
				},
				{
					"id": 101100130,
					"content": "Betul! Terlihat seperti kacamata, tapi sebenarnya dia adalah sebuah detektor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100133
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100133,
					"content": "Sayangnya, Lisa sendiri tidak bisa menggunakannya, jadi aku meminjamnya untuk sementara... dan juga membantu dia mengujinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100134
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100134,
					"content": "Eh? Kenapa Lisa tidak bisa menggunakannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100135,
					"content": "Hm... bagaimana ya, mungkin bisa dibilang karena dia tidak memiliki kepolosan anak kecil? Atau mungkin ada alasan lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100136
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100136,
					"content": "Lain kali ingat untuk menanyakan sendiri kepadanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100137
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100137,
					"content": "Jadi, kamu bisa melihatnya? Cepat beri tahu aku, teman imajinasi orang itu seperti apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100138,
					"content": "Hehe, ini... rahasia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100139
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100139,
					"content": "Ngomong-ngomong, sekarang alat ini menjadi milikmu, Pengembara. Cobalah lihat teman imajinasi milik Nora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100140
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100140,
					"content": "Bagaimana? Apakah kamu bisa melihatnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100141,
						101100142
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100141,
					"content": "Benar-benar ada!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100143
					]
				},
				{
					"id": 101100143,
					"content": "Ternyata kamu juga bisa melihatnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100144
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100144,
					"content": "Menyebalkan, aku juga ingin lihat! ...Tapi detektor ini bukan ukuranku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100145,
					"content": "#{NICKNAME}, kuserahkan kepadamu! Ayo kita lihat seperti apa teman imajinasi <color=#00E1FFFF>orang lain</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100142,
					"content": "Iya, sepertinya anak itu cocok sekali dengan dia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100143
					]
				},
				{
					"id": 101100131,
					"content": "Terlihat seperti kacamata biasa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100132
					]
				},
				{
					"id": 101100132,
					"content": "Ya kan? Menurutku juga begitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100133
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100117,
					"content": "Sangat disayangkan, tapi memang begitu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100118
					]
				},
				{
					"id": 101100114,
					"content": "Sudah tidak pernah kelihatan lagi sekarang...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100115
					]
				},
				{
					"id": 101100109,
					"content": "Teman imajinasi ya hanya dalam imajinasi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100110
					]
				},
				{
					"id": 101100110,
					"content": "Imajinasi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100111
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1011002,
