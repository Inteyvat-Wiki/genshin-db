				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Flora"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101100203,
					"content": "Lihat, itu teman imajinasi dia. Bloatty Floatty, cocok dengan Flora yang melayang-layang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100204
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100204,
					"content": "Wah, ternyata tumbuhan juga bisa menjadi teman imajinasi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100205,
					"content": "Hoo-hoo, Pengembara, Pengamen, halo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100206,
						101100207
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 101100206,
					"content": "Halo, apakah aku boleh menanyakan sesuatu kepadamu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100208
					]
				},
				{
					"id": 101100208,
					"content": "Boleh, ada apa mencari Flora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100209,
						101100212
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 101100209,
					"content": "Teman disampingmu itu...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100210
					]
				},
				{
					"id": 101100210,
					"content": "Oh? Kamu juga bisa melihat Floatty? Orang lain tidak bisa melihat Floatty.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100211
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 101100211,
					"content": "Floatty adalah teman terbaikku, kita tumbuh besar bersama-sama!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100216
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 101100216,
					"content": "(Uh... tidak adil... Paimon ditinggal sendirian...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100217,
					"content": "Flora... kenapa kamu berteman dengan Bloatty Floatty?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100218
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100218,
					"content": "Kenapa tidak boleh? Aku dari dulu ingin berteman dengan tumbuhan yang bisa terbang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100219
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 101100219,
					"content": "Tumbuhan yang bisa terbang? Teman? Kenapa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100220,
					"content": "Karena saat di luar berangin, aku bisa terbang bersama temanku! Keren kan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100221
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 101100221,
					"content": "Bukannya itu diterbangkan angin ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100222,
					"content": "Bisa dibilang juga begitu...",
					"roleType": "TALK_ROLE_NPC",
