							1803.217,
							240.145,
							10366.37
						],
						"pointId": 360600060
					}
				]
			},
			"dialogs": [
				{
					"id": 761180301,
					"content": "Kamu mau renovasi patung Kuutar!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180302,
					"content": "Tepat sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180303
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180303,
					"content": "Dia bukan lagi Kuu{RUBY#[S]Gadis Bulan}tar tanpa sayap yang hanya bisa memandang bulan di langit dalam kesepian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180304
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180304,
					"content": "Kita melihat dia membentangkan sayapnya, dan tahu dia sudah dapat kembali kebebasan untuk hidup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180305
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180305,
					"content": "Karena itu, sudah sepatutnya patung ini juga direnovasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180306
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180306,
					"content": "Ya, ide yang bagus banget!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180307,
					"content": "Kamu sudah cerita ke Bani Bulan Embun yang lain tentang ini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180308
					]
				},
				{
					"id": 761180308,
					"content": "Sudah. Aku sudah cerita ke mereka tentang pengorbanan Dewi Bulan, dan kepulangannya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180309
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180309,
					"content": "Juga bagaimana kita melawan kekuatan yang mencemari dunia ini dengan bimbingan cahaya yang lembut itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180310
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180310,
					"content": "Semua orang senang mendengar dia sudah kembali, jadi aku ambil kesempatan untuk sampaiin pikiran Columbina ke mereka ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180311
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180311,
					"content": "Dia ingin menganggap kita sebagai keluarga, dan berharap kita juga bisa begitu ke dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180312
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180312,
					"content": "Terus, mereka bilang apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180313
					]
				},
				{
					"id": 761180313,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180314
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180314,
					"content": "Dewi Bulan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180315
					],
					"speakerTitle": "Zirnytsia"
				},
				{
					"id": 761180315,
					"content": "Apa kita ... tidak terlalu lancang kalau menganggap dia keluarga?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180316
					],
					"speakerTitle": "Lauha"
				},
				{
					"id": 761180316,
					"content": "Aku yakin ini memang yang Columbina inginkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180317
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180317,
					"content": "(Pelantun Rembulan memanggil Dewi Bulan dengan sebutan \"Columbina\" begitu saja ...!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180318
					],
					"speakerTitle": "Kunegunda"
				},
				{
					"id": 761180318,
					"content": "Mungkin kalian masih ingat kata-kata dariku belum lama ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180319
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180319,
					"content": "\"Jalannya akan dibangun oleh kebenaran, dan kitalah yang akan membangunnya.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180320
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180320,
					"content": "Aku tidak akan minta kalian untuk membuat pilihan yang sama seperti aku, tapi ada beberapa kata yang ingin aku sampaikan pada kalian hari ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180321
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180321,
					"content": "\"Jika kita ingin mengundang cahaya bulan untuk tetap di sini, kita harus terlebih dulu membuka pintu yang dulunya tertutup rapat.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180322
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180322,
					"content": "... Itulah yang terjadi. Melihat situasi beberapa hari terakhir ini, sepertinya semuanya berjalan lebih baik dari yang aku kira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180323
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180323,
					"content": "Nona Lauma. Stok batu baru sudah tiba di gudang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180324
					],
					"speakerTitle": "Maciej"
				},
				{
					"id": 761180324,
					"content": "Baik. Aku akan segera ke sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180325
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180325,
					"content": "Kamu bisa rahasiakan dulu apa yang aku katakan dan apa yang kamu lihat dari Columbina? Aku ingin ini jadi kejutan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180326
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180326,
					"content": "Paimon tahu niatmu baik, tapi serius deh, kamu memang suka bikin kejutan ... Kamu, dan Dewi Bulan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180327,
					"content": "Aku tidak akan bilang apa-apa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180328
					]
				},
				{
					"id": 761180328,
					"content": "Hei, Lauma, soal uang tutup mulut Paimon ... Eh, maksud Paimon, kita punya porsi Sajian Purnama lebih enggak hari ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180329,
					"content": "Ada kok. Ayo, aku siapkan untukmu. Oh, satu lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lauma"
				}
			]
		},
