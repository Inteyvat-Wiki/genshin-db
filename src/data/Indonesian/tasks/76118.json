			"dialogs": [
				{
					"id": 761180101,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180102
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761180102,
					"content": "Ini perasaan Paimon doang, atau kamu cium bau enak juga?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180103,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180104
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761180104,
					"content": "Columbina lagi pesta sendirian!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180105,
					"content": "#{NICKNAME}, Paimon ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180106
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761180106,
					"content": "Kayaknya ada yang lagi senang-senang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180107,
					"content": "Mau coba juga?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180108
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761180108,
					"content": "Tidak, tidak, kamu makan saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180109
					]
				},
				{
					"id": 761180109,
					"content": "Jarang banget lihat kamu makan di sini! Sengaja keluar buat beli ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180110,
					"content": "Lauma yang kasih ke aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180111
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761180111,
					"content": "Wah, dia perhatian banget sama kamu ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180112,
					"content": "Syaratnya aku tidak boleh pergi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180113
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761180113,
					"content": "Eh, tunggu! Bukannya itu cuma suap biar kamu nerima jadi tahanan rumah? Suapnya juga murah banget lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180114,
					"content": "Dia juga bawa beberapa buku menarik dan mainan yang dibuat dengan indah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180115
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761180115,
					"content": "Um, sekarang malah kedengeran kayak ibu yang pergi dinas terus anaknya yang ditinggal aja di rumah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180116,
					"content": "Lauma sudah jelaskan alasannya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180117
					]
				},
				{
					"id": 761180117,
					"content": "Dia cuma bilang untuk tidak keluar dulu, dan yang paling penting harus hindari Bani Bulan Embun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180118
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761180118,
					"content": "Aku tanya hewan-hewan yang datang antar makanan, tapi Lauma sudah suruh mereka tetap diam, dan mereka memang tidak bicara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180119
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761180119,
					"content": "Eh, itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180120,
					"content": "Tebakanku, dia pasti sedang siapin sesuatu yang ada hubungannya denganku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180121
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761180121,
					"content": "Jangan khawatir. Aku tidak pernah merasa bosan tinggal di sini. Makanannya enak dan sesuai seleraku. Aku tidak masalah kalau tidak pergi ke mana-mana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180122
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761180122,
					"content": "Dan jika para Bani Bulan Embun memang sedang mempersiapkan sesuatu ... Justru itu alasan untuk tidak ganggu mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180123
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761180123,
					"content": "Coba kita tanya-tanya ke sekitar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180124
					]
				},
				{
					"id": 761180124,
					"content": "Ya. Paimon juga jadi penasaran nih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180125,
					"content": "Boleh saja ... tapi harus siap-siap dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180126
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761180126,
					"content": "Dia mungkin tahu kamu akan datang menemuiku, jadi dia tidak akan bilang apa-apa ke kamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"The Damselette\""
				}
			]
		},
