			"dialogs": [
				{
					"id": 761180401,
					"content": "Ah, kalian sudah kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180402
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761180402,
					"content": "Tahu enggak, Columbina? Kamu benar, Lauma enggak cerita apa pun ke kami!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180403,
					"content": "Tapi sepertinya dia sedang sibuk.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180404
					]
				},
				{
					"id": 761180404,
					"content": "Jadi kami akan nemenin kamu beberapa hari ke depan. Kamu tinggal duduk santai aja dan tetap berharap yang terbaik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180405,
					"content": "Berharap ... untuk apa ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180406
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761180406,
					"content": "Ah ...! Oh! Eh, bu-bukan apa-apa! Kami enggak tahu apa-apa, sumpah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180407,
					"content": "Hehe ... Baiklah kalau begitu. Aku tidak sabar untuk melewati beberapa hari ke depan bersamamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180408
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761180408,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180409
					],
					"speakerTitle": "Longplume Ibis"
				},
				{
					"id": 761180409,
					"content": "Oh, makanan kita udah datang nih ... Tunggu! Mana makanannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180410,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180411
					],
					"speakerTitle": "Longplume Ibis"
				},
				{
					"id": 761180411,
					"content": "Dia bilang, \"Waktunya sudah tiba.\" Kamu tahu apa artinya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180412
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761180412,
					"content": "Ohhhhh, Paimon paham.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180413,
					"content": "Columbina.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180414
					]
				},
				{
					"id": 761180414,
					"content": "Ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180415
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761180415,
					"content": "Kamu biasa pakai penutup mata, kan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180416
					]
				},
				{
					"id": 761180416,
					"content": "Ya, kenapa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180417
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761180417,
					"content": "Tapi kamu masih bisa pakai kuuvahki buat lihat dunia luar, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180418,
					"content": "Benar. Malah dengan cara ini, aku bisa merasakan semuanya dengan lebih jelas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180419
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761180419,
					"content": "Kalau begitu, bisa enggak kamu pura-pura jangan ngerasain perubahan di luar untuk sementara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180420,
					"content": "Supaya ini bisa jadi \"kejutan yang menyenangkan\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180421
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761180421,
					"content": "... Sepertinya kamu udah bisa tebak apa yang bakal terjadi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180422,
					"content": "Baiklah. Aku paham. Kalau begitu, kamu mau pegang tanganku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"The Damselette\""
				}
			]
