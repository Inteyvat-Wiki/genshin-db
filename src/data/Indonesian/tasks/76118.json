					"nextDialogs": [
						761180504
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761180504,
					"content": "(Dia benar-benar buka mata!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180505,
					"content": "(Padahal aku tadi cuma bicara asal ....)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180506
					]
				},
				{
					"id": 761180506,
					"content": "Indah sekali ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180507
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761180507,
					"content": "Sepasang sayap ini membuat semuanya jadi semakin sempurna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180508
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761180508,
					"content": "Ini hadiah dari kami, Bani Bulan Embun, untukmu, Columbina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180509
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180509,
					"content": "Untuk merayakan dewi yang kini bisa terbang bebas, yang jarinya akhirnya bisa menyentuh tempat yang dia sebut \"rumah.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180510
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180510,
					"content": "... Diriku yang dulu hanya akan teringat kebingungan saat dilahirkan ketika melihat patung ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180511
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761180511,
					"content": "Tapi sekarang, yang aku rasakan adalah kehangatan sebuah \"rumah.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180512
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761180512,
					"content": "Mungkin, seperti patung ini, aku memilih untuk tetap di sini meski sekarang aku sudah punya sayap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180513
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761180513,
					"content": "... Terima kasih semuanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180514
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761180514,
					"content": "Kami sudah siapkan hadiah lain, tapi kamu harus ikut aku jalan sedikit lebih jauh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180515
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180515,
					"content": "Eh? Masih ada kejutan lain?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180516,
					"content": "Aku dan saudara lainnya sudah siapkan perjamuan sederhana di hutan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180517
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180517,
					"content": "Mulai sekarang, ini juga akan jadi rumahmu, Columbina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180518
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180518,
					"content": "Kapan pun kamu rindu rumah, silakan tinggal di sini dan nikmati keramahan kami, meski mungkin tidak seberapa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180519
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180519,
					"content": "Baiklah. Terima kasih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180520
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 761180520,
					"content": "Wah, lihat itu. Bulannya sudah muncul.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180521
					]
				},
				{
					"id": 761180521,
					"content": "Ayo kita pergi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180522
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180522,
					"content": "Aku berharap setiap malam bisa seindah Malam Doa Rembulan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180523
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180523,
					"content": "Selamat datang kembali ke rumahmu, Columbina.",
					"roleType": "TALK_ROLE_NPC",
