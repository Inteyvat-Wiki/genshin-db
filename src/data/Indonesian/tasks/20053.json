				"points": []
			},
			"dialogs": [
				{
					"id": 200530101,
					"content": "Duh... pusing sekali, apa yang harus kulakukan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530102
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200530102,
					"content": "Apa yang sedang kamu lakukan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200530103
					]
				},
				{
					"id": 200530103,
					"content": "Aku berlatih untuk pemilihan Knights of Favonius berikutnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530104
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200530104,
					"content": "Uhhh, tapi biar bagaimanapun juga, aku tidak sekuat Jean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530105
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200530105,
					"content": "Daripada kekuatan, kupikir berlatih teknik lebih cocok untukku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530106
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200530106,
					"content": "Misalnya, cara menghancurkan semua boneka kayu ini dalam satu gerakan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530107
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200530107,
					"content": "Jika kamu ada waktu, ayo pikirkan caranya bersamaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530108,
						200530109
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200530108,
					"content": "Biar aku pikirkan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200530110
					]
				},
				{
					"id": 200530110,
					"content": "Tak masalah, pikirkan baik-baik, boneka kayu ini tidak akan ke mana-mana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530111
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200530111,
					"content": "Begitu pula dengan hidupku yang tidak akan ada kemajuan karena aku terjebak untuk menyelesaikan masalah ini, ugh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530114
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200530114,
					"content": "Dari jarak ini, mungkin solusi terbaik adalah berusaha mengatasi satu sisi lalu melemparkan bom ke sisi lain!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530115
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200530115,
					"content": "Hahaha aku bercanda, aku bahkan tidak tahu bagaimana cara mendapatkan bom tersebut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200530109,
					"content": "Ayo kita pikirkan bersama...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200530112
					]
				},
				{
					"id": 200530112,
					"content": "Kamu suka bertarung dalam kelompok? Wah aku iri sekali... Alangkah baiknya memiliki orang yang dapat selalu membantumu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530113
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200530113,
					"content": "Orang sepertiku, hanya bisa belajar bertarung sendirian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530114
					],
					"speakerTitle": "Ellin"
				}
			]
		},
