			"dialogs": [
				{
					"id": 2005910001,
					"content": "Ini adalah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910002
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 2005910002,
					"content": "Selamat datang! Anda sungguh mempunyai selera yang tinggi, Anda dapat mengenali barang terbaik hanya dengan sekali lihat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910003
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 2005910003,
					"content": "Ini adalah barang yang diambil dari kepala suku Hilichurl, oleh petualang pemberani ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910004
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 2005910004,
					"content": "Tidak ada yang tahu sudah berapa lama Hilichurl itu berkeliaran di sekitar Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910005
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 2005910005,
					"content": "Bahkan Pengembara pun sampai kesulitan menghadapinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910006
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 2005910006,
					"content": "Benarkah, wow... sepertinya Hilichurl ini kuat sekali ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910007
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 2005910007,
					"content": "... Mungkin jika aku menunjukkan barang ini kepada Cyrus, atau Stanley...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910008
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 2005910008,
					"content": "Mungkin pandangan mereka terhadapku akan berubah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910009
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 2005910009,
					"content": "Tentu saja, jangan khawatir, toko kami akan menjaga rahasia para tamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910010
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 2005910010,
					"content": "Sebaiknya jangan ragu untuk membelinya sebelum orang lain datang dan mengambilnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910011
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 2005910011,
					"content": "Biar kupikir terlebih dahulu... Pengembara, apa dia benar-benar mengatakan hal yang sesungguhnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				}
			]
		},
