			"dialogs": [
				{
					"id": 2005902001,
					"content": "Oh, sepertinya aku belum memberi tahu padamu apa yang cukup berharga untuk dijual, kamu pasti tidak tahu harus mencari apa.",
					"roleType": "TALK_ROLE_NPC",
