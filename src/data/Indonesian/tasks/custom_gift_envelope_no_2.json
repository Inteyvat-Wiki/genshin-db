			"dialogs": [
				{
					"id": 715340101,
					"content": "Hmm, mungkin harus lihat-lihat kartu lainnya dulu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340102
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 715340102,
					"content": "#Ah, {NICKNAME}. Lama tak jumpa ... kenapa wajahmu kaget begitu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340103
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 715340103,
					"content": "Aku ... enggak sangka ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715340104
					]
				},
				{
					"id": 715340104,
					"content": "Bisa melihat prajurit seperti aku menikmati suasana Lantern Rite?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340105
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 715340105,
					"content": "Ini ... kayaknya pertama kali aku lihat kamu santai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715340106
					]
				},
				{
					"id": 715340106,
					"content": "Tenryou Commission bertanggung jawab terhadap warga. Sebagai anggota, aku seringnya tidak ada waktu untuk bersantai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340107
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 715340107,
					"content": "Mungkin banyak yang memandang diriku sebagai prajurit yang selalu fokus untuk satu tujuan, sangat tidak pantas berada di wilayah yang sarat perayaan seperti Hanamizaka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340108
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 715340108,
					"content": "Tapi jika aku lengah, maka aku memberi celah untuk tindak kejahatan. Dan hal ini akan merusak bukan hanya kinerjaku dalam melaksanakan amanat, tapi juga berpengaruh ke suasana di Hanamizaka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340109
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 715340109,
					"content": "Maka dari itu, aku akan memanfaatkan setiap waktu senggang yang kebetulan ada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340110
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 715340110,
					"content": "Mohon maaf, harusnya aku tidak bahas yang seperti ini ketika berlibur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340111
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 715340111,
					"content": "Aku sedang coba buat Kartu Ucapan, tapi sepertinya masih belum bagus. Mungkin boleh beri petunjuk?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340112
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 715340112,
					"content": "Boleh, biar kupikir-pikir ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
