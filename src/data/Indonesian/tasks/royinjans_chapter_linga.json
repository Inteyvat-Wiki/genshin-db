				},
				{
					"id": 730280102,
					"content": "Omong-omong, dulu Ararycan bilang kalau komponen yang ada di markas rahasia dipindahkan olehnya. Betul begitu enggak sih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730280103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730280103,
					"content": "Betul itu, Ararycan tidak bohong sama Nara.",
