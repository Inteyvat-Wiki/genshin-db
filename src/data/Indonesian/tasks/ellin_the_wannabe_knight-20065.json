			"dialogs": [
				{
					"id": 200650101,
					"content": "Duh... pusing sekali, apa yang harus kulakukan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200650102
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200650102,
					"content": "Apa yang sedang kamu lakukan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200650103
					]
				},
				{
					"id": 200650103,
					"content": "Aku berlatih untuk pemilihan Knights of Favonius berikutnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200650104
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200650104,
					"content": "Uhhh, tapi biar bagaimanapun juga, aku tidak sekuat Jean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200650105
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200650105,
					"content": "Daripada kekuatan, kupikir berlatih teknik lebih cocok untukku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200650106
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200650106,
					"content": "Misalnya, cara menghancurkan semua boneka kayu ini dalam satu gerakan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200650107
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200650107,
					"content": "Mereka lebih kokoh dari yag terlihat, ini bukan barang biasa... Aku tidak tahu di mana ayah bisa menemukan barang seperti ini, tapi pasti sulit sekali mendapatkannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ellin"
				}
			]
		},
