			"dialogs": [
				{
					"id": 762040201,
					"content": "Nicole~ Aneh, di sini juga enggak ada orang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762040202,
					"content": "Kalian sudah sampai di ruanganku? Apa kalian lihat bunga-bunga dan tanaman yang kukoleksi dan kutanam dari berbagai tempat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040203
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040203,
					"content": "Aduh, sayangnya aku tidak bisa ke sana sekarang. Aku sedang buka stan jual patung di Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040204
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040204,
					"content": "Emmm ... ada yang bisa kami bantu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762040205
					]
				},
				{
					"id": 762040205,
					"content": "Tidak perlu. Ini satu-satunya kesempatanku untuk menulis sesuatu, meskipun yang kutulis sebagian besar adalah angka-angka ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040206
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040206,
					"content": "Kalian kan jarang datang ke sini, jadi silakan langsung mulai saja tanpaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040207
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040207,
					"content": "Aku ingat aku meninggalkan gulungan di sebelah barat, di dekat patung finch. Kalian bisa lihat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040208
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040208,
					"content": "Paimon lihat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762040209,
					"content": "Kalau begitu, biarkan pemanduku yang pendiam itu membantu kalian ya. Semangat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				}
			]
		},
