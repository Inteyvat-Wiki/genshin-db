			},
			"dialogs": [
				{
					"id": 762040301,
					"content": "Selamat ya kalian. Coba aku lihat ... Hmmm, bagus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040302
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040302,
					"content": "Berbeda dengan The Witch's Garden sekarang, ini adalah kuil tempat aku tinggal dulu saat masih menjadi malaikat. Aku tinggal di sana untuk waktu yang cukup lama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040303
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040303,
					"content": "Banyak banget malaikatnya, terus Nicole kayaknya populer banget deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762040304,
					"content": "Bukannya ingin pamer, tapi teman-temanku suka banget mendengarkan ceritaku, terutama yang tentang berjalan bersama manusia. Seperti memberikan pertanda, dan membimbing mereka membangun peradaban hebat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040305
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040305,
					"content": "Setiap kali aku sampai di bagian klimaksnya, para malaikat yang mendengarkan akan menahan napas dengan penuh konsentrasi, bahkan senar kecapi pun tidak lagi bergetar, dan kuas pun tidak lagi bergoyang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040306
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040306,
					"content": "Kemudian, warna-warna yang terjalin mulai mekar. Diiringi musik, cahaya keemasan menyebar ke segala penjuru, itulah nyanyian gembira dan kebahagiaan kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040307
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040307,
					"content": "Kedengarannya keren banget!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762040308,
					"content": "Iya kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040309
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040309,
					"content": "Meskipun keindahan masa lalu telah lenyap sepenuhnya, kehidupan sekarang selalu memberikan kejutan baru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040310
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040310,
					"content": "Ada orang yang lihat aku lagi baca koran, terus malah mau curi patungku? Ohoho, habislah kamu, teman kecilku! Akan kukirim kamu langsung ke Benteng Meropide!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040311
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040311,
					"content": "Ada orang yang lihat aku lagi baca koran, terus malah mau curi patungku?",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						762040312
					]
				},
				{
					"id": 762040312,
					"content": "Habislah dia!",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						762040313
					]
				},
				{
					"id": 762040313,
					"content": "Akan kukirim kamu langsung ke Benteng Meropide!",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": []
				}
			]
		}
	]
