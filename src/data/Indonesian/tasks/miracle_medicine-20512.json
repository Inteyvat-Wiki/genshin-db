			"dialogs": [
				{
					"id": 205120301,
					"content": "Apa kamu sudah menemukannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120302
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120302,
					"content": "Sudah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205120303
					]
				},
				{
					"id": 205120303,
					"content": "Ini... kelihatannya cukup padat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120304
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120304,
					"content": "Bisakah menggunakan ini untuk membuat obat? Aku akan mencobanya dulu setelah selesai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120305
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120305,
					"content": "Kalau sesuatu terjadi padaku, tolong bawa Anna...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120306
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120306,
					"content": "... dan biarkan Suster Grace yang menjaganya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120307
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120307,
					"content": "Beri tahu dia bahwa aku pergi bekerja ke suatu tempat yang sangat jauh. Tolong, itu adalah permintaan terakhirku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120308
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120308,
					"content": "Hei, kamu jangan menakuti dirimu sendiri...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205120309
					]
				},
				{
					"id": 205120309,
					"content": "Karena obat ini terlihat begitu mengerikan! Apa pun yang terjadi, ambillah ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120310
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120310,
					"content": "Dan ingat apa yang kukatakan tadi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				}
			]
		}
