				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205120101,
					"content": "Resepnya semakin aneh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120102
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120102,
					"content": "Bagaimana keadaan Anna?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205120103
					]
				},
				{
					"id": 205120103,
					"content": "Oh, kamu. Yah, mungkin terdengar sulit untuk percaya, tapi Anna mengatakan bahwa dia sudah merasa baikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120104
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120104,
					"content": "Mungkin resep dari dokter itu benar-benar berguna? Aku sendiri hampir tidak bisa percaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120105
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120105,
					"content": "Tapi, entah itu benar atau salah, tetap harus terus minum obatnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120106
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120106,
					"content": "Resep kali ini... Hmm, bisakah kamu membantuku mencari Hydro Slime condensate?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120107,
						205120112,
						205120117
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120107,
					"content": "Yang ini terdengar cukup normal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205120108
					]
				},
				{
					"id": 205120108,
					"content": "Hmm, benarkah? Aku malah berpikir sebaliknya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120109
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120109,
					"content": "Tapi, setidaknya mudah dicari. Aku sudah bertanya pada orang sekitar, kamu bisa mendapatkan Thick Condensate dengan mengalahkan Slime Besar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120110
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120110,
					"content": "Aku pernah mendengar Jack mengatakan bahwa kamu bisa memancing Slime Besar datang dengan terus-menerus mengalahkan Slime yang kecil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120111
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120111,
					"content": "Aku tidak punya kemampuan bertarung seperti itu, jadi aku hanya bisa mengandalkanmu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120112,
					"content": "Jangan khawatir, ini mungkin bisa dimakan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205120113
					]
				},
				{
					"id": 205120113,
					"content": "Bagaimana kamu tahu? Apakah kamu pernah mencobanya sebelumnya? Hmm, kenapa kamu tiba-tiba diam?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120114
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120114,
					"content": "Sudahlah, tidak perlu membahas itu lagi. Seharusnya Hydro Slime cukup mudah dicari. Aku sudah bertanya pada orang sekitar, kamu bisa mendapatkan Thick Condensate dengan mengalahkan Slime Besar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120115
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120115,
					"content": "Aku pernah mendengar Jack mengatakan bahwa kamu bisa memancing Slime Besar datang dengan terus-menerus mengalahkan Slime yang kecil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120116
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120116,
					"content": "Aku tidak punya kemampuan bertarung seperti itu, jadi aku hanya bisa mengandalkanmu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120117,
					"content": "Aku tahu di mana bisa mendapatkannya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205120118
					]
				},
				{
					"id": 205120118,
					"content": "Itu bagus. Sepertinya kamu cukup berpengalaman dalam menghadapi Slime.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120119
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120119,
					"content": "Kalau begitu tolong bantu aku. Seharusnya kamu bisa mendapatkan Thick Condensate hanya dengan mengalahkan Slime Besar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120120
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120120,
					"content": "Aku pernah mendengar Jack mengatakan bahwa kamu bisa memancing Slime Besar datang dengan terus-menerus mengalahkan Slime yang kecil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120121
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120121,
					"content": "Semoga beruntung, terima kasih ya~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				}
			]
		},
