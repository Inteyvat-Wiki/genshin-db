			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mualani",
					"Kinich",
					"Ajaw",
					"Kachina",
					"Citlali"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 50270101,
					"content": "Wah, Archon kita memang keren ya! Berani sekali. Dia bisa seimbang loh lawan Tuan Agung Xbalanque!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270102
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 50270102,
					"content": "Jangan merendah. Kamu juga pasti gitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270103
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 50270103,
					"content": "Hah, memangnya siapa yang enggak bakalan gitu? Aku sih kalau ada kesempatan pasti langsung sikat! Kamu sendiri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270104
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 50270104,
					"content": "Aku ... aku mana berani!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270105
					],
					"speakerTitle": "Kachina"
				},
				{
					"id": 50270105,
					"content": "Suka bertarung itu sifat alami seorang pejuang. Kalau ada kesempatan, aku yakin nalurimu yang akan bicara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270106
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 50270106,
					"content": "Ck, kalian bisa-bisanya semangat gitu. Ini Tuan Agung Xbalanque! Xbalanque! Nenek moyang kita semua! Segitunya ya kalian? Gila tarung sampai ingin adu jotos sama orang tua?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270107
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 50270107,
					"content": "Nenek Citlali! Kapan-kapan mau dong tanding!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270108
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 50270108,
					"content": "Tidak, tidak, tidak bisa. Tidak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Citlali"
				}
			]
		},
		{
			"id": 502702,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"502701",
							"2"
						],
						"stepId": 502701,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mausau",
					"Ororon",
					"Iansan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 50270201,
					"content": "Eh, kira-kira aku bakal jadi sayur kayak apa ya? Merah ... atau hijau?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270202
					],
					"speakerTitle": "Mausau"
				},
				{
					"id": 50270202,
					"content": "Kamu? Kamu kayaknya ... bisa jadi bawang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270203
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 50270203,
					"content": "Bawang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270204
					],
					"speakerTitle": "Mausau"
				},
				{
					"id": 50270204,
					"content": "Dari luar biasa saja. Tapi begitu diserang, yang nyerangnya bisa nangis sampai payah banget.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270205
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 50270205,
					"content": "Oh ya? Kuat banget tuh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270206
					],
					"speakerTitle": "Mausau"
				},
				{
					"id": 50270206,
					"content": "Mereka ngobrolin apa sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270207
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 50270207,
					"content": "Bawang itu kuat sekali. Salah satu temanku lagi motong bawang waktu aku mampir ke rumahnya. Dia lalu nangis, Saurian di dekatnya nangis semua, dan akhirnya semua makhluk hidup di dalam ruangan itu menangis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270208
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 50270208,
					"content": "Kamu sendiri? Ikutan nangis?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270209
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 50270209,
					"content": "Aku ada di dalam ruangan, tapi sempat angkat jubah buat nutupi mata. Cacucu dan Ifa tidak bisa lihat wajahku kan, jadi mereka kira aku juga ikutan nangis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270210
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 50270210,
					"content": "Aku mau jadi manusia bawang! Bisa bikin orang nangis!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270211
					],
					"speakerTitle": "Mausau"
				},
				{
					"id": 50270211,
					"content": "Bisa, aman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270212
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 50270212,
					"content": "Aku mau banget motong pembicaraan ini, tapi entah harus ngomongin apa buat nyela ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270213
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 50270213,
					"content": "Yah, kalau Iansan sih ... jamur. Jamur mini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270214
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 50270214,
					"content": "SIAPA yang nanya?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270215
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 50270215,
					"content": "Yah, tapi jamur mini? Lumayan juga. Kuat, keras, dan penuh semangat hidup. Aku suka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270216
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 50270216,
					"content": "Kak Iansan juga penuh semangat hidup! Ya kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270217
					],
					"speakerTitle": "Mausau"
				},
				{
					"id": 50270217,
					"content": "Selalu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270218
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 50270218,
					"content": "Terserahlah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iansan"
				}
			]
		}
	]
}