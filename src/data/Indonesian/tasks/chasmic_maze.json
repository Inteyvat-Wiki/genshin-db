			},
			"dialogs": [
				{
					"id": 10280801,
					"content": "Itu dia, aku mau lihat sekali lagi. Kali ini, aku, Arataki, satu-satunya Oni terkuat di dunia akan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280802
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280802,
					"content": "Bos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280803
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280803,
					"content": "Eh! Ngapain serius begitu sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280804
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280804,
					"content": "Waktunya Lavender Melon panggang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280805
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280805,
					"content": "Ha? Kita sedang terperangkap di situasi yang membahayakan nyawa di bawah tanah, terus kamu bilang waktunya Lavender Melon panggang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280806
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280806,
					"content": "Moo! Moo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280807
					],
					"speakerTitle": "Ushi"
				},
				{
					"id": 10280807,
					"content": "Dengar itu? Ushi bilang kamu benar total. Tunggu dulu, kamu berpihak sama siapa? ... Tunggu, Ushi, kamu lagi bela siapa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280808
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280808,
					"content": "Moo ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280809
					],
					"speakerTitle": "Ushi"
				},
				{
					"id": 10280809,
					"content": "Sangat penting untuk tetap kenyang, kita harus mempertahankan energi dan kondisi mental kita agar bisa menghadapi ketidakpastian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280810
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280810,
					"content": "Ushi saja ngerti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280811
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280811,
					"content": "Baiklah, kalian berdua ... Hei, kalian sudah makan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280812
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280812,
					"content": "Tunggu, sudah matang? Aromanya harum ... Hm ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280813
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280813,
					"content": "Baiklah, kita isi perut dulu, baru kita cari jalan keluarnya. Hei, jangan makan semua, sisakan sedikit untukku!",
