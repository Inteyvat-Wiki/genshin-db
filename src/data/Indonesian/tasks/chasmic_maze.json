			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yanfei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10280401,
					"content": "Heh? Tunggu, ada yang salah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280402
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280402,
					"content": "K-kok kita balik lagi ke sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10280403,
					"content": "Jadi kita sudah pernah lewat di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280404
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280404,
					"content": "Benar, ini adalah titik awal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280405
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280405,
					"content": "Tapi kita tidak mungkin salah jalan, kita terus menuju ke pintu keluar dan tidak pernah balik arah kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280406
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280406,
					"content": "Seingatku juga begitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280407
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 10280407,
					"content": "Pengembara, menurutmu kita tidak salah jalan kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280408
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280408,
					"content": "Ya, sudah benar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280409
					]
				},
				{
					"id": 10280409,
					"content": "Ada yang aneh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10280410,
					"content": "Ada cerita rakyat Inazuma tentang seorang pedagang yang ditipu oleh bake-danuki di suatu malam, dan akhirnya memutari tempat yang sama terus, terus begitu. Pagi hari tiba, dan si pedagang itu masih belum bisa keluar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280411
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280411,
					"content": "Ya. Paimon juga pernah dengar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10280412,
					"content": "Jadi kita semua tahu kan? Oke, karena aku rasa ini kejadian yang sama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280413
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280413,
					"content": "Tapi tidak perlu takut, aku punya bawahan yang bisa mengusir roh jahat dan sejenisnya. Aku akan panggil dia sekarang juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280414
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280414,
					"content": "Sulit dipercaya. Seorang oni punya teman yang bisa mengusir roh jahat ... Sungguh berhati besar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10280415,
					"content": "Bagi Bos, ketidaktahuan adalah sejenis kebajikan juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280416
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280416,
					"content": "Waktunya beraksi, Ushi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280417
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280417,
					"content": "Moo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280418
					],
					"speakerTitle": "Ushi"
				},
				{
					"id": 10280418,
					"content": "Dia Ushi, anggota eksternal kami dari Geng Arataki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280419
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280419,
					"content": "Moo Moo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280420
					],
					"speakerTitle": "Ushi"
				},
				{
					"id": 10280420,
					"content": "Oh, Ushi sedang menyapa kalian semua. Kalian boleh panggil dia Ushi, atau Banteng Ganteng juga. Ushi itu ahlinya kalau urusan jalan, jadi aku akan minta dia yang bawa jalan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280421
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280421,
					"content": "Ada anggota eksternal juga ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280422
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 10280422,
					"content": "Sepertinya kurang bisa diandalkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280423
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280423,
					"content": "Menurutku juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280424
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 10280424,
					"content": "Ushi, ayo pergi! Carikan jalan keluar untuk kita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280425
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280425,
					"content": "Moo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280426
					],
					"speakerTitle": "Ushi"
				},
				{
					"id": 10280426,
					"content": "Ushi mulai mencari jalan keluar tersembunyi di sekeliling ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						10280427
					]
				},
				{
					"id": 10280427,
					"content": "Moo ... Moo Moo ... Moo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280428
					],
					"speakerTitle": "Ushi"
				},
				{
					"id": 10280428,
					"content": "Hm? Apa tuh ... Hah? Benar? Tidak mungkin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280429
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280429,
					"content": "Kenapa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10280430,
					"content": "Ushi bilang dia sudah cari ke mana-mana, tapi tidak ada jalan keluarnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280431
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280431,
					"content": "Tapi tidak mungkin, kalau kita bisa masuk, pasti ada cara keluar dari sini. Sini, biar aku yang periksa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280432
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280432,
					"content": "Kalian sadar tidak? Awalnya kita jatuh dari atas, waktu itu jalan keluarnya ada jauh di atas ... Sekarang pintu keluarnya juga sudah hilang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280433
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280433,
					"content": "Ini di luar nalar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280434
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280434,
					"content": "Sepertinya bangunan bawah tanah ini tidak sesederhana yang kita kira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280435
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280435,
					"content": "Aku akan memeriksa di sekitar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280436
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 10280436,
					"content": "Ke mana pun kita lihat, cuma ada batu-batuan saja. Duh, a-apa kita yang salah ingat, mungkin kita memang bukan jatuh dari sini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280437
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10280437,
					"content": "Hei, kamu takut sekarang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280438
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280438,
					"content": "Pa-Paimon enggak takut kok. Paimon itu super berani!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280439
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10280439,
					"content": "Moo ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280440
					],
					"speakerTitle": "Ushi"
				},
				{
					"id": 10280440,
					"content": "Oh ya? Ushi bilang dia juga merasa kamu ketakutan. Tidak apa-apa, bilang saja kalau takut, kami akan melindungimu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280441
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280441,
					"content": "Tenang, Paimon. Ada aku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280442
					]
				},
				{
					"id": 10280442,
					"content": "#Kita tidak boleh diam saja, ayo kita cari jalan keluar lagi. Shinobu, kamu temani penyelamatku di sini, aku akan bawa {NICKNAME} dan Paimon bersamaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280443
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280443,
					"content": "Baik, berhati-hatilah kalian semua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280444
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280444,
					"content": "Tolong, jangan panggil aku \"penyelamat jiwa\" atau apa pun. Langsung saja Yanfei. Tuan Arataki, sepertinya kamu punya jiwa kepemimpinan yang kuat sebagai pemimpin dari Geng Arataki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280445
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280445,
					"content": "Tidak, jangan sungkan, panggil saja aku Itto. Karena kita sudah satu tim sekarang, kita harus saling menjaga. Paimon, kalau kamu takut, Tuan Besar ini bisa tutupin matamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280446
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280446,
					"content": "Semuanya berpisah untuk memeriksa di sekitar, tapi tidak ada yang ditemukan ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						10280447
					]
				},
				{
					"id": 10280447,
					"content": "... *huff*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280448
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280448,
					"content": "Rupanya memang enggak ada jalan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280449
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10280449,
					"content": "Moo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280450
					],
					"speakerTitle": "Ushi"
				},
				{
					"id": 10280450,
					"content": "Aku masih merasa ada yang salah dengan tempat ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280451
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280451,
					"content": "Bos, apa kalian menemukan sesuatu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280452
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280452,
					"content": "Tidak, tidak ada apa-apa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280453
					]
				},
				{
					"id": 10280453,
					"content": "Bukan cuma itu, sepertinya aku melihat sosok bayangan baru saja ... Jangan-jangan tempat ini benar ada hantunya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280454
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280454,
					"content": "Meski suasananya kurang tepat, Paimon harus tanya sekarang deh ... Itto, kamu kan oni ... Berarti ke mana pun kamu pergi, selalu akan ada perasaan ini, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280455
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10280455,
					"content": "Tidak! Bukan yang seperti aku, oke? Maksudku hantu yang mengerikan, yang melayang, yang kadang muncul dan kadang hilang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280456
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280456,
					"content": "Hah? Itto ... apa kamu ... takut hantu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280457
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10280457,
					"content": "Oh tidak. Sudah ketahuan orang lain, Bos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280458
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280458,
					"content": "Aku? Hah! Tidak kok! Jangan sembarang ngomong. Tapi, serius ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280459
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280459,
					"content": "Hihi, lihat kamu kayak ini, Paimon sendiri jadi enggak takut lagi ... Sini Pak Gembala, kalau takut, biar Paimon tutupin matamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280460
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10280460,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280461
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280461,
					"content": "Sepertinya ada hal lain yang lebih berharga yang bisa kukerjakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280462
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280462,
					"content": "(Hm? Shinobu berjalan, mengambil beberapa batu, lalu mengeluarkan ranting dan Lavender Melon dari sakunya ... Hm?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280463
					]
				},
				{
					"id": 10280463,
					"content": "Tambahkan sedikit garam ... dan sedikit merica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280464
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280464,
					"content": "Kamu lagi manggang Lavender Melon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280465
					]
				},
				{
					"id": 10280465,
					"content": "Benar. Lavender Melon sangat enak kalau dipanggang. Coba deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280466
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280466,
					"content": "Baik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280467
					]
				},
				{
					"id": 10280467,
					"content": "Oh ya ... Ada dua rasa: manis dan asin, kamu suka yang mana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280468
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280468,
					"content": "Yang mana saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280469
					]
				},
				{
					"id": 10280469,
					"content": "Hm, kalau begitu coba keduanya saja. Semakin genting situasi, kita harus semakin tenang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280470
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280470,
					"content": "Jika tebakanku benar, sepertinya ada rahasia tersembunyi di sini yang tidak boleh diketahui olehku dan boss. Tapi jangan khawatir, aku akan mengalihkan perhatian boss agar tidak mengganggu diskusi rahasia kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280471
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280471,
					"content": "Wah, wangi sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280472
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280472,
					"content": "Apa Yanfei mau coba juga?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280473
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280473,
					"content": "Aku tidak lapar, kalian makan saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280474
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280474,
					"content": "Omong-omong, sudah lama aku tidak melihatmu, Shinobu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280475
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280475,
					"content": "Benar. Sudah lama ya. Terakhir kali kita bertemu, aku sedang sekolah di Liyue, kamu mengajari kelasku sebagai guru pengganti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280476
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280476,
					"content": "Guru pengganti ... Oh ya, benar. Aku ingat, waktu itu musim dingin, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280477
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280477,
					"content": "Benar, teman-teman semua bilang kuliahmu menarik sekali. Karena itu ... seharusnya aku memanggilmu \"Senpai\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280478
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280478,
					"content": "Hm, nama yang cukup bagus, aku suka!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280479
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280479,
					"content": "Siapa yang sangka kita akan bertemu lagi dalam kondisi ini sekarang. Mungkin ini yang namanya takdir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280480
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280480,
					"content": "Oh, jadi Yanfei bisa mengajar juga? Hebat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280481
					]
				},
				{
					"id": 10280481,
					"content": "Bukan cuma itu, gaya mengajarnya lucu dan sangat menghibur, jadi dia sangat populer di kalangan pelajar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280482
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280482,
					"content": "Haha! Aduh, aku jadi malu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280483
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280483,
					"content": "Hei, kalian lagi di sini ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280484
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 10280484,
					"content": "Yelan, kami tadi sudah berpisah dan mencari tempat ini, tapi tidak ada jalan keluar di sekitar sini. Bagaimana denganmu? Apa ada yang kamu temukan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280485
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280485,
					"content": "Tidak ada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280486
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 10280486,
					"content": "Dan ... meski aku tidak ingin mengatakannya, sebaiknya kita mempersiapkan diri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280487
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 10280487,
					"content": "Kalau kita tetap tidak bisa menemukan jalan keluar, kita mungkin akan terperangkap di sini untuk sementara waktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280488
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 10280488,
					"content": "Aku juga berpikir begitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280489
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280489,
					"content": "... Baiklah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280490
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280490,
					"content": "Ruang bawah tanah dengan pintu masuk tanpa jalan keluar. Ini tidak masuk akal. Aku akan pikirkan lagi, tapi mungkin akan butuh sedikit waktu lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280491
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 10280491,
					"content": "Jika kalian menemukan sesuatu yang terlihat seperti jalan keluar, jangan lupa untuk terus berhati-hati sebelum melanjutkan penjelajahan kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280492
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 10280492,
					"content": "(Oh ya, Xiao juga ada di sini. Dia bilang kalau kita sedang kesulitan, kita boleh panggil namanya.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280493
					]
				},
				{
					"id": 10280493,
					"content": "(Hmmm, mungkin boleh dicoba.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280494
					]
				},
				{
					"id": 10280494,
					"content": "Hei Pengembara, serius banget sih. Apa kamu punya rencana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280495
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10280495,
					"content": "Oh, aku cuma sedang pikir kalau Xiao juga di sini, ingat?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280496
					]
				},
				{
					"id": 10280496,
					"content": "Xiao ... Benar juga! Apa kamu mau panggil dia untuk bantu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280497
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10280497,
					"content": "Aku rasa boleh dicoba.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280498
					]
				},
				{
					"id": 10280498,
					"content": "Oke, ayo kita coba!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280499
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10280499,
					"content": "....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280500
					]
				},
				{
					"id": 10280500,
					"content": "Xiao, kedengaran tidak?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280501
					]
				},
				{
					"id": 10280501,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10280502,
					"content": "....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280503
					]
				},
				{
					"id": 10280503,
					"content": "Xiao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280504
					]
				},
				{
					"id": 10280504,
					"content": "Huh. Enggak ada jawaban ... Paimon pikir Xiao bisa langsung ke tempat kita di mana pun kita berada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10280505,
					"content": "Apa mungkin bahkan Xiao juga enggak bisa merasakan keberadaan kita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10280506,
					"content": "(....)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280507
					]
				},
				{
					"id": 10280507,
					"content": "(Kalau memang begitu, apa artinya? Tempat apa ini?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
