			},
			"dialogs": [
				{
					"id": 10210601,
					"content": "Waauuw!! Ru-ruangan ini besar sekali! Paimon belum pernah melihat ruang semegah ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210602,
					"content": "Tenanglah, kalian berdua. Anggap saja rumah sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210603
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210603,
					"content": "Kami benar-benar boleh!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210604,
					"content": "Aku yang mengundang kalian berdua ke sini, tentu saja aku menganggap kalian sebagai teman. Dan saat teman datang untuk bermain, tentu saja kebahagiaan adalah yang utama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210605
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210605,
					"content": "Di sana, itu adalah...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210606
					]
				},
				{
					"id": 10210606,
					"content": "Oh! Bukankah ini adalah dinding legendaris?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210607,
					"content": "Oh? Kamu memiliki informasi yang baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210608
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210608,
					"content": "Itu karena bahkan pendongeng pun membicarakannya... Semua orang menginginkan selembar kertas dari dinding itu. Itu sangat terkenal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210609,
					"content": "Itu karena tembok tersebut mencatat rahasia Liyue. Pedagang selalu tertarik pada rahasia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210610
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210610,
					"content": "Tapi rahasia bisnis Liyue tidak menarik bagimu kan, Pengembara? Kamu cukup istimewa - dan aku rasa kamu sudah menyadarinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210611
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210611,
					"content": "Jika bisa, aku ingin mendapatkan kepercayaanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210612
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210612,
					"content": "Tetapi jika kamu memilih orang yang lebih bisa dipercaya antara aku dan Keqing...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210613,
						10210614
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210613,
					"content": "Yah, antara ortodoksmu dan heterodoksnya...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210615
					]
				},
				{
					"id": 10210615,
					"content": "Haha. Kamu memilih Keqing? Aku sudah punya firasat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210616
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210616,
					"content": "Awalnya aku berpikir dia agak terlalu keras kepala. Dengan kepribadiannya sebagai Qixing, membuatku perlu melakukan sesuatu di belakang layar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210617
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210617,
					"content": "Tetapi setelah dia mengucapkan kata-kata itu: \"Zaman Adeptus telah lama berlalu. Bahkan jika Liyue Qixing tidak berani menghadapi kebenaran itu, maka bagaimana masa depan Liyue...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210618
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210618,
					"content": "Beberapa keraguan di hatiku sudah hilang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210619
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210619,
					"content": "Aku tidak akan menyangkal bahwa kematian Rex Lapis tampaknya menguntungkan Qixing. Tapi demi Liyue, aku tidak boleh menghiraukan berita tentang para Qixing yang melakukan kudeta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210620
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210620,
					"content": "Aku menduga bahwa ada Fatui di balik kabar yang beredar ini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210621
					]
				},
				{
					"id": 10210621,
					"content": "Ya... Sepertinya kamu mengerti apa yang ingin aku katakan dari awal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210622
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210622,
					"content": "Aku memerintahkan agar Exuvia disembunyikan di tempat yang aman sampai situasi dapat terkendali, dan juga untuk menghindari kejadian serupa seperti di Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210623
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210623,
					"content": "Setelah kematian Rex Lapis, para Fatui telah melakukan hal di luar kewenangan diplomatik mereka. Sebagai Tianquan, yang bertanggung jawab atas Liyue, aku tidak bisa lagi memperhatikan penampilan saat berhadapan dengan mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210624
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210624,
					"content": "Membiarkan berlangsungnya Rite of Parting juga berarti memberikan kami waktu untuk mengendalikan administrasi Liyue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210625
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210625,
					"content": "Hmm... Itu persis seperti yang Zhongli katakan. Qixing hanya akan menyiapkan tempat untuk ritual sehingga mereka dapat memperalat kita dalam menjalankan tujuan mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210626
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210626,
					"content": "Tunggu dulu! Sebagai penutup... Bolehkah aku menyampaikan hal lainnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210627
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210627,
					"content": "Tentu saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210628
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210628,
					"content": "Paimon dengar bahwa siapa saja yang memberikan kado ucapan akan mendapatkan sedikit hadiah... Jadi, apakah kita juga termasuk?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210629
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210629,
					"content": "Paimon, tidak bisakah kamu memikirkan hal lain sebentar saja?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210630
					]
				},
				{
					"id": 10210630,
					"content": "Hahaha... tidak masalah, aku suka orang yang berbicara terus terang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210631
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210631,
					"content": "Baiklah, kami juga telah banyak merepotkan kalian. Bagaimana kalau begini? Pilihlah sesuatu yang kamu sukai di sini, dan aku akan memberikannya sebagai hadiah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210632
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210632,
					"content": "Ya! Paimon sudah menunggu kamu untuk mengatakannya! Biar kulihat, apa yang kita inginkan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210633
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210633,
					"content": "Salah satu <color=#00E1FFFF>kertas</color> di papan itu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210634
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210634,
					"content": "???",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210635
					]
				},
				{
					"id": 10210635,
					"content": "Jangan melihat Paimon seperti itu! Kertas ini dapat dijual dengan harga yang luar biasa, meskipun ukurannya hanya sebesar jari Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210636
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210636,
					"content": "Bayangkan... jika kertas ini tidak sobek, berapa banyak Mora yang dibutuhkan untuk membelinya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210614,
					"content": "Aku memilih Keqing dan skeptisismenya terhadap yang ilahi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210615
					]
				}
			]
		},
		{
			"id": 102108,
			"completionStepIds": [
				102108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
