			"dialogs": [
				{
					"id": 10211201,
					"content": "Hah? Setelah Paimon mengamatinya, kita tidak perlu memilih-milih lagi, kita ambil yang di atas sana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
