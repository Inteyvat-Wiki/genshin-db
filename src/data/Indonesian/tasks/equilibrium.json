			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mengdan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10210801,
					"content": "Terima kasih atas bantuanmu, pengembara baik hati. Aku pasti sudah membusuk di sel ini kalau kalian tidak datang! Para Treasure Hoarder itu... saat suasana hati mereka bagus, mereka akan mengatur ulang pot Sweet Flower. Tapi saat suasana hati mereka buruk, mereka akan mengatur ulang wajahku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210802
					],
					"speakerTitle": "Mengdan"
				},
				{
					"id": 10210802,
					"content": "Ah, itu bukan apa-apa. Tidak perlu berterima kasih kepada kami!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210803,
					"content": "Haha, aku mengerti. Jangan khawatir, aku akan memberikan kalian hadiah tanda terima kasih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210804
					],
					"speakerTitle": "Mengdan"
				},
				{
					"id": 10210804,
					"content": "Benar-benar tidak perlu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210805
					]
				},
				{
					"id": 10210805,
					"content": "Jangan begitu! Aku bisa kabur dari penderitaan ini berkat kamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210806
					],
					"speakerTitle": "Mengdan"
				},
				{
					"id": 10210806,
					"content": "Aku adalah Mengdan, pemasok untuk Mingxing Jewelry di Pelabuhan Liyue. Aku sering berjalan di sekitar pegunungan ini untuk mencari barang antik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210807
					],
					"speakerTitle": "Mengdan"
				},
				{
					"id": 10210807,
					"content": "Aku tidak pernah menyangka bahwa para Treasure Hoarder itu akan melihat reruntuhan yang sama denganku. Tanpa kusadari, mereka sudah menangkap dan memenjarakanku! *huff*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210808
					],
					"speakerTitle": "Mengdan"
				},
				{
					"id": 10210808,
					"content": "Apakah kamu kekurangan sesuatu? Barang antik, harta karun, berbagai pernak pernik... Selama aku bisa memberikannya, pasti kuberikan kepadamu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210809
					],
					"speakerTitle": "Mengdan"
				},
				{
					"id": 10210809,
					"content": "Niat baikmu sudah cukup untukku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210810
					]
				},
				{
					"id": 10210810,
					"content": "Tunggu sebentar! Sebenarnya, kami sedang mencari sesuatu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210811,
					"content": "Oh, barang apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210812
					],
					"speakerTitle": "Mengdan"
				},
				{
					"id": 10210812,
					"content": "Apa kamu punya kotak untuk menyimpan hadiah? Kami suka yang cantik... digunakan untuk menyimpan camilan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210813,
					"content": "Tentu saja punya, bagaimana mungkin seseorang menjual barang antik tanpa kotak? Di <color=#00E1FFFF>Mingxing Jewelry</color>, kami memiliki layanan pembungkusan kado terbaik di tujuh bangsa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210814
					],
					"speakerTitle": "Mengdan"
				},
				{
					"id": 10210814,
					"content": "Tunggu aku sebentar, aku akan memberi tahu bos. Kamu bisa pergi dan melihatnya kapan pun kamu membutuhkan kotak itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210815
					],
					"speakerTitle": "Mengdan"
				},
				{
					"id": 10210815,
					"content": "Bagus! Slime Lapis Gula milik Paimon sekarang ada kotaknya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 102111,
