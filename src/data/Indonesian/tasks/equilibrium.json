					"Xingxi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10211101,
					"content": "Hei! Seseorang bernama Mengdan memberi tahu kami kalau kami bisa mendapatkan kotak yang bagus dan cantik di tokomu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211102,
					"content": "Paman Meng sudah mengatakannya kepadaku. Terima kasih kepada kalian karena sudah menyelamatkannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211103
					],
					"speakerTitle": "Xingxi"
				},
				{
					"id": 10211103,
					"content": "Banyak barang terbaik di toko kami ditemukan oleh Paman Meng. Jika terjadi sesuatu padanya, mustahil bagi kami untuk terus berbisnis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211104
					],
					"speakerTitle": "Xingxi"
				},
				{
					"id": 10211104,
					"content": "Ini, kotak ini adalah barang antik, setidaknya berusia 140 tahun dan sudah dibersihkan... Silakan lihat... apakah cocok?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211105
					],
					"speakerTitle": "Xingxi"
				},
				{
					"id": 10211105,
					"content": "Yap-yap-yap! Ini sangat bagus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211106,
					"content": "Tunggu sebentar. Bolehkah kami meminjam satu barang lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211107,
					"content": "Tentu saja, silakan — selama itu ada di rak kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211108
					],
					"speakerTitle": "Xingxi"
				},
				{
					"id": 10211108,
					"content": "#{NICKNAME}, pot ini kelihatannya bagus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211109,
					"content": "Jika kita menggunakan barang antik sebagai mangkuk pencampur kita, kita pasti bisa membuat camilan yang enak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211110,
					"content": "Selesai! Slime Lapis Gula yang tiada duanya! Masukkan dengan hati-hati ke dalam kotak dan taburi sedikit bubuk gula...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211111,
					"content": "Oh ya. Kamu mungkin bisa menggunakan dua bunga yang baru dipetik ini sebagai dekorasinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211112
					],
					"speakerTitle": "Xingxi"
				},
				{
					"id": 10211112,
					"content": "Wuhuuu! Ini terlihat cantik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211113,
					"content": "(Entah kenapa, aku merasa sedikit bersalah...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10211114
					]
				},
				{
					"id": 10211114,
					"content": "Bagus! Sekarang kita sudah memasukkan semua yang kita punya ke dalam kotak ini, ayo pergi ke Jade Chamber untuk menemui Ningguang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
