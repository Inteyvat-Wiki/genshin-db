					"content": "Terima kasih karena telah menyelamatkan Paman Meng. Berhati-hatilah di perjalanan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10213002
					],
					"speakerTitle": "Xingxi"
				},
				{
					"id": 10213002,
					"content": "Hm, baiklah... sekarang aku harus membersihkan teko itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xingxi"
				}
			]
		},
		{
			"id": 102131,
			"completionStepIds": [],
