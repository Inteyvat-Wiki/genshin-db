					"Buyun"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10210301,
					"content": "(Menurut Keqing, ini yang harus kita katakan...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210302,
					"content": "Halo, apa kamu menjual bulan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210303,
					"content": "Ya. Kamu mau berapa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210304
					],
					"speakerTitle": "Buyun"
				},
				{
					"id": 10210304,
					"content": "Tidak nyaman membicarakan angka di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210305,
					"content": "Jawaban yang bagus. Silakan gunakan ini untuk naik ke Jade Chamber... Ah, iya. Ngomong-ngomong, apakah kalian berdua adalah tamu yang diatur untuk bertemu dengan Nona Ningguang hari ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210306
					],
					"speakerTitle": "Buyun"
				},
				{
					"id": 10210306,
					"content": "Benar sekali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210307,
					"content": "(Tapi kode yang mereka gunakan bukan untuk tamu, tapi untuk Yuheng. Apa yang terjadi di sini...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Buyun"
				}
			]
		},
		{
			"id": 102104,
			"completionStepIds": [
				102104
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
