						],
						"stepId": 102112,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ningguang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10213101,
					"content": "Bagaimana, kamu sudah memilih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10213102
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10213102,
					"content": "Ah, kamu tidak perlu bertanya apa pun kepadaku. Putuskanlah sendiri dan ambil yang kamu butuhkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10213103
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10213103,
					"content": "Setelahnya, mengapa tidak duduk sebentar saja dulu di Jade Chamber, atau berjalan-jalan sebentar? Istirahat juga merupakan bagian yang sangat penting dari sebuah perjalanan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10213104,
						10213106
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10213104,
					"content": "Terima kasih atas jamuannya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10213105
					]
				},
				{
					"id": 10213105,
					"content": "Jangan sungkan begitu, santai sedikit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10213106,
					"content": "Sudah waktunya kami melanjutkan perjalanan, sampai jumpa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10213107
					]
				},
				{
					"id": 10213107,
					"content": "Oh sudah mau pergi? Baiklah. Semoga lain kali saat kita bertemu lagi, kamu sudah melakukan hal yang benar... atau setidak akan melakukan hal yang benar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ningguang"
				}
			]
		}
	]
