			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ningguang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10210401,
					"content": "Aku sudah menunggumu, orang yang kembali dari Jueyun Karst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210402
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210402,
					"content": "Ah, Ningguang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210403,
					"content": "Kami sudah menyiapkan hadiah karena ini adalah pertemuan pertama kita! Semoga kamu menyukainya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210404,
					"content": "Untukku? Terima kasih banyak. Sepertinya aku malah merepotkan kalian, mengingat kalian berdua adalah tamuku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210405
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210405,
					"content": "Hehe... Oh tidak, ini bukan apa-apa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210406,
						10210408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210406,
					"content": "Tempat yang bagus, Jade Chamber ini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210407
					]
				},
				{
					"id": 10210407,
					"content": "Haha, aku senang kamu menyukainya juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210409
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210409,
					"content": "Istana ini mengapung di langit, lebih tinggi dari puncak gunung mana pun. Dari sudut pandang ini, seseorang bisa melihat seluruh Pelabuhan Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210410
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210410,
					"content": "Aku sudah mengumpulkan dana yang diperlukan untuk membangunnya sejak aku mulai mempelajari seni berdagang. Dan sejak menjadi Tianquan, aku terus mempekerjakan pengrajin terbaik untuk mengembangkannya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210411
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210411,
					"content": "Awalnya, di sini hanya ada satu ruangan. Sekarang, sudah cukup besar untuk menutupi bulan di atas langit Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210412
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210412,
					"content": "Aku yakin suatu hari bayangannya akan menutupi ketujuh bangsa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210413
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210413,
					"content": "(Tianquan ini sangat berambisi...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210414
					]
				},
				{
					"id": 10210414,
					"content": "Tidak banyak dari luar Liyue yang berhak naik ke Jade Chamber. Tapi aku sudah berkoordinasi dengan Grand Master dari Knights of Favonius, yang begitu memujimu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210415
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210415,
					"content": "Jadi, dari hari pertama kamu sampai di Liyue, aku sudah memasang mata dan telingaku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210416
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210416,
					"content": "APA?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210417,
					"content": "Dan akhirnya aku mengetahui tentangmu tepat saat kamu dalam perjalanan ke Wangshu Inn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210418
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210418,
					"content": "Tunggu. Apa Verr Goldet adalah orangmu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210419,
					"content": "Kurang tepat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210420
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210420,
					"content": "Semua orang di Wangshu Inn adalah orang-orang kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210421
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210421,
					"content": "ASTAGANAGA!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210422,
					"content": "Kami juga bertemu dengan sang Yuheng belum lama ini...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210423
					]
				},
				{
					"id": 10210423,
					"content": "Di Guizhong Ballista ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210424
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210424,
					"content": "Apa kamu mengintip kami dari atas langit sepanjang waktu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210425
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210425,
					"content": "Haha... Aku rasa mengintip dari ketinggian ini cukup sulit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210426
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210426,
					"content": "Mata dan telinga kami lebih dari cukup. Kalian berdua adalah orang yang sangat menarik. Wajar saja jika aku tertarik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210427
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210427,
					"content": "Keqing mengatakan bahwa Qixing tidak akan merugikan Rex Lapis.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210428
					]
				},
				{
					"id": 10210428,
					"content": "Yah, aku tidak berharap kamu memercayai kami, mengingat kamu lebih banyak berinteraksi dengan Adeptus. Alasanku mengundangmu ke sini adalah untuk menyelesaikan beberapa kesalahpahaman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210408,
					"content": "Ini adalah pertama kalinya aku datang ke tempat setinggi ini...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210409
					]
				}
			]
		},
		{
			"id": 102106,
