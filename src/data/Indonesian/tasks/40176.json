			"dialogs": [
				{
					"id": 401730501,
					"content": "#Hm? Ada apa, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730502
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730502,
					"content": "Aku harus kembaliin pedang upacaranya ke kepala suku, tapi kemah ini nanti saja diberesinnya. Silakan kalau mau pakai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730503
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730503,
					"content": "Uh, aku punya edisi terbaru \"Pendekar Fatamorgana\" ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401730504
					]
				},
				{
					"id": 401730504,
					"content": "Hah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730505
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730505,
					"content": "Sama edisi khusus cerita sampingan \"Berkas Kasus Nona Orith\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401730506
					]
				},
				{
					"id": 401730506,
					"content": "HAH?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730507
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730507,
					"content": "Mau baca bareng?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401730508
					]
				},
				{
					"id": 401730508,
					"content": "Uhh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730509
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730509,
					"content": "(Kenapa ini? Ada apa ini? Dari mana dia tahu aku suka yang begituan? Jangan-jangan ... dia memang sengaja cari tahu kesukaanku?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730510
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730510,
					"content": "(Tidak, itu mustahil ... jangan bodoh. Ini ulah Ororon, dasar mulut ember.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730511
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730511,
					"content": "(Tapi ... dia bisa ingat kesukaanku ya? Yah, ingat tidak ingat juga tidak penting sih, toh itu bukan sesuatu yang \"wow\" banget kalau menyangkut diriku ....)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730512
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730512,
					"content": "(Masalahnya sekarang, dia barusan ngajak aku bareng! GIMANA ini? Harus dijawab apa???)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730513
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730513,
					"content": "Ehem ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730514
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730514,
					"content": "Boleh, boleh. Kenapa tidak? Nanti juga aku senggang. Aku kabari yah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Citlali"
				}
			]
		}
	]
