				"points": []
			},
			"dialogs": [
				{
					"id": 221090201,
					"content": "Bagaimana? Apa kamu sudah mengalahkan mereka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090202
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090202,
					"content": "Masih belum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221090203
					]
				},
				{
					"id": 221090203,
					"content": "Apakah itu karena kamu mempersiapkan pertarungan dengan cermat, atau karena bermalas-malasan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090204
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090204,
					"content": "... Atau karena dua-duanya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				}
			]
		},
