			},
			"dialogs": [
				{
					"id": 221090101,
					"content": "*uhuk* Masih tidak ada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090102
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090102,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221090103
					]
				},
				{
					"id": 221090103,
					"content": "Oh, lagi-lagi kalian. Sepertinya misi Guild semakin hari semakin mudah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090104
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090104,
					"content": "Kalau berminat, apa kalian berminat menerima misi dariku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090105
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090105,
					"content": "Ada segerombol Hilichurl yang berpanah berkumpul di suatu tempat di tengah Guili Plains. Kehadiran mereka sangat mengancam untuk orang-orang yang lewat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090106
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090106,
					"content": "Walaupun hanyalah Hilichurl, namun jumlah mereka sangat banyak. Ditambah lagi, mereka berkumpul di tempat yang tinggi. Petualang biasa tidak bisa menangani mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090107
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090107,
					"content": "Yang harus kamu lakukan adalah menangani mereka sampai ke akar-akarnya. Setelah selesai ditangani, aku akan memberikanmu imbalan yang memuaskan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090108
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090108,
					"content": "Dan ada lagi, kalau kamu menemukan sesuatu yang berhubungan dengan \"pedang\", bawalah pulang untukku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090109,
						221090110
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090109,
					"content": "Tentu saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221090111
					]
				},
				{
					"id": 221090111,
					"content": "Aku tidak tahu harus menyebutmu pemberani atau naif.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090112
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090112,
					"content": "Tapi kamu memang memiliki jiwa seorang petualang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090115
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090115,
					"content": "Baiklah, aku tidak akan berbasa-basi lagi. Bersiap-siaplah dengan baik dan kalahkan mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090110,
					"content": "Apa hubungannya Hilichurl dengan pedang?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221090113
					]
				},
				{
					"id": 221090113,
					"content": "Tidak ada hubungannya. Kamu hanya perlu memperhatikannya sedikit. Kalau ada, bawa pulang untukku. Kalau tidak ada juga tidak apa-apa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090114
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090114,
					"content": "Target dari misi ini adalah para Hilichurl. Kalahkan mereka dan aku akan memberimu imbalan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090115
					],
					"speakerTitle": "Lan"
				}
			]
		},
