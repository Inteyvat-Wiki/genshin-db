			"dialogs": [
				{
					"id": 221090301,
					"content": "Bagaimana? Apa kamu sudah mengalahkan mereka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090302
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090302,
					"content": "Sudah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221090303
					]
				},
				{
					"id": 221090303,
					"content": "Bagus sekali. Para Hilichurl itu tidak menyebabkan masalah untukmu, bukan? Aku hanya bertanya untuk basa-basi saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090304
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090304,
					"content": "Kamu masih belum menemukan sesuatu yang berhubungan dengan \"pedang\"? Huh, lagi-lagi seperti dugaanku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090305
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090305,
					"content": "Baiklah, ini imbalanmu. Terima kasih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090306
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090306,
					"content": "Kenapa kamu begitu peduli dengan \"pedang\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221090307
					]
				},
				{
					"id": 221090307,
					"content": "... Kurasa tidak ada salahnya memberi tahumu. Nama pedang itu adalah Hidden Blade, kakakku adalah pemiliknya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090308
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090308,
					"content": "Tapi saat kakakku meninggal dunia, pedang itu tidak berada di sisinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090309
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090309,
					"content": "Tidak tahu apa yang terjadi dengannya hingga pedang yang selalu dibawanya bisa menghilang. Aku selalu mempertanyakan hal ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090310
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090310,
					"content": "Malangnya, sampai saat ini aku masih belum menemukan petunjuk sedikit pun. Aku tidak tahu di manakah pedang itu berada dan juga tidak tahu apa yang telah dialami kakak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090311
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090311,
					"content": "Itu saja yang kuceritakan. Ini imbalanmu. Kamu boleh pergi mengurus urusanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				}
			]
		}
	]
