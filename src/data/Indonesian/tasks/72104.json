			"dialogs": [
				{
					"id": 721043801,
					"content": "Nona Gendou, sepertinya suasana hatimu sangat baik hari ini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721043802
					]
				},
				{
					"id": 721043802,
					"content": "Hmm? Ada masalah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721043803
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721043803,
					"content": "Kok rasanya kamu agak beda ya dari biasanya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721043804
					]
				},
				{
					"id": 721043804,
					"content": "Eh? Iya ya? Aku akan lebih memperhatikannya lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721043805
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721043805,
					"content": "Mungkin karena suasana hatiku bagus hari ini... Aku barusan dapat nasib \"Sangat Beruntung\"! Jadi aku mau berbagi kebahagiaan, hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721043806
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721043806,
					"content": "Tapi, \"Sangat Beruntung\" untuk seseorang, bisa jadi \"Sangat Sial\" untuk orang lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721043807
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721043807,
					"content": "Mereka yang dapat nasib sangat sial ... Aku penasaran, apa yang menanti mereka di Gantungan Slip Keberuntungan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721043808
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721043808,
					"content": "Peruntunganmu sangat menarik! Sampai jumpa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gendou Ringo"
				}
			]
		},
