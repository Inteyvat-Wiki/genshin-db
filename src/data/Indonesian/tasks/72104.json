				{
					"id": 721043901,
					"content": "Nona Gendou, ada gerangan apa ke sini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721043902
					]
				},
				{
					"id": 721043902,
					"content": "Aku... eh? Ah? Kamu tanya aku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721043903
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721043903,
					"content": "Anu, eh, aku, belakangan ini aku sibuk! Ta-tapi kalau kamu mau, biar aku atur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721043904,
						721043905
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721043904,
					"content": "Kamu salah paham...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721043906
					]
				},
				{
					"id": 721043906,
					"content": "Oh, ternyata begitu. Dan kupikir hari itu pada akhirnya akan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721043905,
					"content": "Aku cuma merasa pikiranmu sedang di tempat lain...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721043906
					]
				}
			]
		},
