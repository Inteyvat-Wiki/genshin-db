			"dialogs": [
				{
					"id": 730310601,
					"content": "Rana kelihatannya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310602,
					"content": "Paimon mau bilang semoga dia \"mimpi indah\", tapi kok sepertinya kurang tepat ya ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310603,
					"content": "(Muncul sesuatu yang samar-samar dari \"gelembung\" yang menyelimuti Rana ....)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310604
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730310604,
					"content": "(Membenamkan diri ke dalam gambar ....)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310605
					]
				},
				{
					"id": 730310605,
					"content": "Kamu berada di hutan, semuanya terlihat besar dan hening. Tapi kamu merasa sangat nyaman.\\nSinar matahari sesekali menembus dedaunan, menyerupai lembaran emas yang berkilauan. Rumput liar yang tinggi seolah tertawa dengan suara rendah dan menyentuh tanganmu dengan lembut saat kamu melewatinya.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730310606
					]
				},
				{
					"id": 730310606,
					"content": "Kamu mendengar suara tangis sesenggukan di tengah alunan melodi angin yang melewati pepohonan dan air yang mengalir. Mengikuti suara itu, kamu menemukan seorang anak.\\nDia sepertinya kelelahan menangis dan tertidur di rerumputan. Kamu berjalan ke arahnya, menyanyikan lagu lembut yang menenangkan ....",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730310607
					]
				},
				{
					"id": 730310607,
					"content": "#Hei! {NICKNAME}, kamu kenapa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310608,
					"content": "Baguslah jika tidak apa-apa ... Melihatmu seperti mau pingsan ... Paimon jadi khawatir ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310609,
					"content": "#Nara {NICKNAME}! Kalian datang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310610
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310610,
					"content": "Wah! Bikin Paimon kaget saja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310611,
					"content": "Wah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310612,
						730310613
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310612,
					"content": "Wah!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310614
					]
				},
				{
					"id": 730310614,
					"content": "Benar-benar ya, kenapa kalian Aranara suka muncul tiba-tiba gitu sih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310615,
					"content": "Terus kenapa kamu juga tiba-tiba \"wah\" gitu, benda putih yang bisa terbang?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310616
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310616,
					"content": "Namaku Paimon, bukan benda putih yang bisa terbang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310617
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310617,
					"content": "Arana ada di bawah tanah, menjaga kekuatan Ararakalari. Dengan begitu，Narana tidak akan layu. Tapi, untuk menjadi kuat kembali memerlukan Bija.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310618
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310618,
					"content": "#Oh gitu. Omong-omong, apa yang terjadi sama {NICKNAME} tadi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310619
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310619,
					"content": "(Kamu menceritakan apa yang kamu lihat.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310620
					]
				},
				{
					"id": 730310620,
					"content": "Seharusnya ini ingatan Arana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310621
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310621,
					"content": "Ingatan ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310622
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310622,
					"content": "Paimon tidak tahu. Ingatan dan mimpi adalah kekuatan Aranara, benda yang paling berharga. Dengan ingatan dan mimpi, Arana dapat menggunakan Ararakalari, untuk membantu Nara dan Aranara yang butuh bantuan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310623
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310623,
					"content": "#Ada beberapa Nara yang dapat merasakan ingatan Ararakalari. Kelihatannya Nara {NICKNAME} juga dapat merasakannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310624
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310624,
					"content": "Kok kedengarannya Ararakalari itu benar-benar hebat ya! Kamu juga kan yang memakai Ararakalari untuk melindungi Iotham waktu di gua?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310625
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310625,
					"content": "Benar, itu Arana. Nara Iotham, Nara Kavus, dan Nara Sudabeh mereka semua adalah teman Nara. Jadi Arana melindungi mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310626
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310626,
					"content": "Mereka sering datang ke hutan dan bermain bersama Arana. Arana mengajari mereka tentang hutan, juga bahasa bunga dan tanaman. Mereka adalah teman yang sangat penting, seperti Narana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310627
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310627,
					"content": "Tentang anak yang hilang ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310628
					]
				},
				{
					"id": 730310628,
					"content": "Benar! Soal itu, sebelumnya Iotham, Kavus dan Sudabeh juga pernah menghilang sampai akhirnya mereka dikembalikan ke Desa Vimara. Apa itu juga perbuatan Arana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310629
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310629,
					"content": "Ya. Arana menyadari kalau Nara jahat dan Nara Valuka menculik mereka. Jadi Arana menolong Nara Kavus dan Nara Sudabeh untuk pergi saat Nara jahat tidak lihat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310630,
						730310632
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310630,
					"content": "Begitu ya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310631
					]
				},
				{
					"id": 730310631,
					"content": "Hm ... Tapi kenapa mereka tidak ingat apa-apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310633
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310633,
					"content": "Arana membiarkan Nara kecil masuk ke dalam mimpi, dan menghapus ingatan buruk yang ada di dalam mimpi. Dengan begini, mereka layaknya seperti pohon muda yang tumbuh menjadi pohon besar, mereka tidak akan menjadi jahat ketika tumbuh dewasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310634
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310634,
					"content": "Kalau tidak Nara kecil akan ketakutan. Jika selalu takut, mereka akan percaya pada kekuatan \"takut\" itu terus menerus, dan tumbuh menjadi Nara jahat yang menakutkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310635
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310635,
					"content": "Mereka adalah teman baik Arana, jadi Arana tidak mau jika nantinya mereka jadi Nara jahat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310636,
						730310638,
						730310640
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310636,
					"content": "Masuk akal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310637
					]
				},
				{
					"id": 730310637,
					"content": "Mereka akan tumbuh menjadi orang dewasa yang hebat! Tapi omong-omong, apa Arana punya petunjuk tentang Nara jahat yang mau nyulik mereka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310641
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310641,
					"content": "Arana tidak akan memaafkannya. Para Nara jahat itu bukan anak-anak yang berasal dari hutan, mereka membawa Nara Valuka bersama mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310642
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310642,
					"content": "Ada satu Nara yang aneh di Desa Vimara. Nara itu juga bukan anak yang berasal dari hutan, melainkan dari salju. Tapi kelihatannya adalah Nara yang baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310643
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310643,
					"content": "Tapi karena dia sering bersama Nara kecil, Nara kecil sering menceritakan kisahnya. Tapi Arana pernah melihatnya berbicara dengan Nara jahat, dan berbicara tentang Aranara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310644
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310644,
					"content": "Di dalam Desa Vimara ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310645,
						730310646
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310645,
					"content": "Komplotan Fatui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310647
					]
				},
				{
					"id": 730310647,
					"content": "Kok ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310648
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310648,
					"content": "Wah ... Paimon tidak mau memikirkan hal seperti itu, orang-orang di Desa Vimara harusnya memperlakukan satu sama lain kayak keluarga ... Dan orang itu yang membuat Rana jadi seperti ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310649,
						730310650
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310649,
					"content": "Saatnya menangkap orang jahat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310651
					]
				},
				{
					"id": 730310651,
					"content": "Ya. Bagaimanapun, kita harus menangkap orang itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310652
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310652,
					"content": "#Nara {NICKNAME}, Paimon, kalian harus berjanji.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310653
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310653,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310654
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310654,
					"content": "Kalian harus berjanji untuk menghukum Nara jahat. Dengan begitu Nara Iotham, Nara Kavus, dan Nara Sudabeh tidak akan merasa takut lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310655,
						730310656
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310655,
					"content": "Iya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310657
					]
				},
				{
					"id": 730310657,
					"content": "Narana telah tumbuh dewasa. Jadi, dia tidak bisa melihat Arana lagi. Tapi itu bukan masalah, Arana sudah sangat senang mengetahui bahwa dia baik-baik saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310658
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310658,
					"content": "Sudah lama sekali tidak bermain bersama Narana. Sudah berulang kali matahari terbit dan terbenam, dan kemudian bulan muncul di langit. Banyak buah yang muncul dan kembali lagi ke tanah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310659
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310659,
					"content": "Narana semakin tinggi, dulunya setara dengan Arana. Tapi kemudian menjadi setinggi pohon kecil. Terus dia tidak pernah datang bermain dengan Arana lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310660
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310660,
					"content": "Arana telah bercerita banyak tentang hutan kepadanya. Starshroom adalah pantulan bintang-bintang di langit yang jatuh ke bumi. Mereka yang melihat Nilotpala Lotus mekar, akan mendapatkan keberuntungan jika bulan terbit kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310661
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310661,
					"content": "Arana juga bisa mengajarkan ini semua ke Nara Iotham dan yang lain. Semoga mereka semua bisa tumbuh sehat seperti Narana. Ah, tapi jangan seperti Narana yang lari ke dalam Marana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310662
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310662,
					"content": "Apakah mereka akan lupa soal hutan saat mereka tumbuh dewasa? Sama seperti Rana ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310663
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310663,
					"content": "Nara Iotham, Nara Kavus, dan Nara Sudabeh akan tumbuh dewasa. Tidak masalah jika mereka lupa ketika tumbuh dewasa ... hutan akan selalu mengingat segalanya. Segalanya tidak akan menghilang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310664
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310664,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310665
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310665,
					"content": "Segalanya tidak akan menghilang. Semua hal indah tidak akan hilang. Semua rasa sakit akan menjadi nutrisi untuk sesuatu yang indah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310666
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310666,
					"content": "#Arana! Nara {NICKNAME}, Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310667
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730310667,
					"content": "Arama! Arana sudah lama tidak lihat kamu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310668,
						730310671
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310668,
					"content": "Paimon kenapa tidak bereaksi \"Wah\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310669
					]
				},
				{
					"id": 730310669,
					"content": "Yang benar saja, memangnya Paimon kagetan ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310670
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310670,
					"content": "Apa kamu ke sini mau jemput kami buat pergi merayakan Festival Utsava di Vanarana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310672
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310672,
					"content": "#Ya! Persiapan Festival Utsava sudah selesai, semuanya sedang menunggu Nara {NICKNAME} dan Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310673
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730310673,
					"content": "Hore, Festival Utsava! Tapi Arana tidak ikut?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310674
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310674,
					"content": "Hm, Arana tidak ikut. Jika Arana pergi terlalu jauh maka Ararakalari akan runtuh, Narana akan dalam bahaya. Jadi tidak bisa pergi ke Festival Utsava.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310675
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310675,
					"content": "Kenapa begitu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310676
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310676,
					"content": "#Tidak apa-apa. Kalau Nara {NICKNAME} dan Paimon bahagia, Arana, Arama dan semua orang di Vanarana juga akan bahagia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310677
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310677,
					"content": "Iya. Bija butuh kekuatanmu, Arana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310678
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730310678,
					"content": "Arana akan siap ketika saat itu tiba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310679
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310679,
					"content": "#Oh ya, Nara {NICKNAME} ini untukmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310680
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310680,
					"content": "Bunga ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310681
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310681,
					"content": "Iya. Tolong jaga baik-baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310682,
						730310683
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310682,
					"content": "Pasti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310684
					]
				},
				{
					"id": 730310684,
					"content": "#Terima kasih Nara {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310685
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310685,
					"content": "#Ok. Kalau begitu ayo kita kembali, Nara {NICKNAME}, Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arama"
				},
				{
					"id": 730310683,
					"content": "Baiklah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310684
					]
				},
				{
					"id": 730310671,
					"content": "Apa kita akan kembali untuk merayakan Festival Utsava?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310672
					]
				},
				{
					"id": 730310656,
					"content": "Aku akan berusaha sebaik mungkin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310657
					]
				},
				{
					"id": 730310650,
					"content": "Kita akan menangkap orang itu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310651
					]
				},
				{
					"id": 730310646,
					"content": "Seseorang yang buruk di mata anak-anak?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310647
					]
				},
				{
					"id": 730310638,
					"content": "Semoga saja begitu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310639
					]
				},
				{
					"id": 730310639,
					"content": "Mereka akan tumbuh menjadi orang dewasa yang hebat! Tapi omong-omong, apa Arana punya petunjuk tentang Nara jahat yang mau nyulik mereka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310641
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310640,
					"content": "Tentang Nara jahat ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310641
					]
				},
				{
					"id": 730310632,
					"content": "Tentang anak yang kehilangan ingatan ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310633
					]
				},
				{
					"id": 730310613,
					"content": "Sepertinya aku pernah melihat ini sebelumnya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310614
					]
				}
			]
		},
		{
			"id": 7303107,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7303107",
