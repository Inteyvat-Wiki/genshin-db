				},
				{
					"id": 730310102,
					"content": "#Senangnya bisa bertemu lagi dengan Nara {NICKNAME} dan Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310103
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730310103,
					"content": "#Wah wah, kalian sudah kembali ya! Semuanya bilang kalau ada Nara {NICKNAME} yang tinggi dan hebat sudah banyak membantu mereka. Mereka senang sekali loh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310104
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730310104,
					"content": "#Kalau ada yang bantu pastinya senang sekali! Iya kan, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310105,
						730310106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310105,
					"content": "Iya!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310107
					]
				},
				{
					"id": 730310107,
					"content": "Bukan. Mereka senang karena ketemu teman baru. Meski Aranakin, Aranaga dan Aragaru akan lupa, tapi hutan akan selalu mengingat segalanya. Ceritanya tidak bakalan hilang sama sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310108
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730310108,
					"content": "Oh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310109,
					"content": "Persiapan Festival Utsava-nya hampir selesai. Tinggal butuh sedikit waktu lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310110
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730310110,
					"content": "#Iya, ini semua berkat bantuan {NICKNAME} dan Paimon. Festival Utsava akhirnya bakal dimulai. Aku benar-benar tidak sabar lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araja"
				},
				{
					"id": 730310106,
					"content": "Oh.",
