			"dialogs": [
				{
					"id": 3700401,
					"content": "Ini adalah sebuah kristal yang mengandung suatu kekuatan ... Lisa, apa kamu bisa menelitinya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700402
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700402,
					"content": "Coba kulihat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700403
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3700403,
					"content": "Hmm ... Aku bisa melihat ketidakmurnian di dalam kristal ini, tapi dilihat lebih jauh lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700404
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3700404,
					"content": "Maaf, aku tidak bisa memberikan kesimpulan analisa yang tepat sekarang. Berikan aku sedikit waktu. Aku akan mencari-cari informasi di area terlarang perpustakaan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700405
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3700405,
					"content": "Baiklah, kalau begitu kuserahkan penelitian mengenai hal ini padamu, Lisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700406
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700406,
					"content": "Baik, aku akan memberi tahu kalian begitu aku mengetahui lebih banyak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700407
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3700407,
					"content": "Tapi, jangan terlalu banyak berharap dulu. Tulisan dalam buku-buku itu adalah tulisan yang sudah sangat kuno, belum lagi – Aw!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700408
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3700408,
					"content": "Aduh ... sakit sekali ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700409
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3700409,
					"content": "Ketidakmurnian di dalam kristal ini ... memberikan respon menyakitkan saat aku mendekatinya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700410
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3700410,
					"content": "Ah, aku tahu ... tampaknya benda ini bereaksi terhadap Vision.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700411
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3700411,
					"content": "Ketidakmurnian dan kekuatan elemen yang kita miliki saling bertentangan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700412
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3700413,
					"content": "....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3700414
					]
				},
				{
					"id": 3700412,
					"content": "#Tapi ini masih saja tetap aneh. {NICKNAME} kan punya kekuatan elemental juga, tapi kelihatannya kamu tidak terkena pengaruh dengan cara yang sama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700413
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3700415,
					"content": "Cutie?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3700417
					]
				},
				{
					"id": 3700416,
					"content": "Baiklah, biar aku yang simpan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3700417
					]
				},
				{
					"id": 3700414,
					"content": "Kalau begitu, sebaiknya kristal ini disimpan oleh si Cutie saja, karena benda ini bisa menyakiti kami kalau kami yang menyimpannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700415,
						3700416
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3700417,
					"content": "Menakjubkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700418
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700418,
					"content": "Apa kamu tahu sesuatu yang membuatmu spesial?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700419
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700420,
					"content": "Aku juga tidak tahu apa yang harus dilakukan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700421
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700421,
					"content": "#Kalau begitu, {NICKNAME} ... Knights of Favonius punya permintaan lain untukmu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700422
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700422,
					"content": "Terimalah gelar penghargaan Honorary Knight ... dan rasa terima kasih dari Grand Master.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700423
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700424,
					"content": "Honorary Knight ... of Favonius?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700425
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3700426,
					"content": "Dan kami masih butuh bantuanmu untuk mengungkapkan beberapa persoalan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700427
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700427,
					"content": "Amukan Stormterror ... dan kristal yang misterius tersebut ... Kedamaian Mondstadt ada di balik kedua hal ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700428
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700428,
					"content": "Semoga angin membukakan matamu kepada kebenaran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700429
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700429,
					"content": "Mari kita bertemu lagi di sini kalau kamu menemukan sesuatu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jean"
				},
				{
					"id": 4820221,
					"content": "Ikuti <color=#00E1FFFF>jalur yang sudah ditandai</color> sampai ke tujuan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820222
					],
					"speakerTitle": "Amber"
				}
			]
		}
	]
}