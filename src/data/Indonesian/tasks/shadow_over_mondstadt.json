			"dialogs": [
				{
					"id": 3700201,
					"content": "Eh, itu kan Jean?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3700202,
					"content": "Kayaknya dia lagi ngobrol sama seseorang deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3700203,
					"content": "Biarin dia selesai ngobrolnya dulu, terus kita ke sana buat nyapa yuk?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3700204,
					"content": "Itulah yang membawa kami kepada keputusan ini sejak awal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700205
					],
					"speakerTitle": "Anastasia"
				},
				{
					"id": 3700205,
					"content": "Kalau kalian tidak mampu untuk segera menangani serangan Stormterror, serahkan saja tugas melindungi Mondstadt ke tangan Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700206
					],
					"speakerTitle": "Anastasia"
				},
				{
					"id": 3700206,
					"content": "Kita bisa mengakhiri masalah naga Mondstadt. Yang perlu kita lakukan hanya membawa monster itu ke ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700207
					],
					"speakerTitle": "Anastasia"
				},
				{
					"id": 3700207,
					"content": "\"Monster\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700208
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700208,
					"content": "Iya, apa maksudmu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700209
					],
					"speakerTitle": "Anastasia"
				},
				{
					"id": 3700209,
					"content": "Ah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700210
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700210,
					"content": "Maksudku adalah aku berharap sikap yang lebih profesional dari para diplomat seperti kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700211
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700211,
					"content": "Kalian bermaksud \"memberantas\" salah satu dari Four Winds di Mondstadt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700212
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700212,
					"content": "Jangan sembarangan berbicara di hadapan Knights of Favonius!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700213
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700213,
					"content": "Heh ... Hehehe ... itu tidak akan segila yang kamu katakan kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700214
					],
					"speakerTitle": "Anastasia"
				},
				{
					"id": 3700214,
					"content": "Baiklah, negosiasi hari ini sampai di sini saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700215
					],
					"speakerTitle": "Anastasia"
				},
				{
					"id": 3700215,
					"content": "Pembicaraan kita sampai tahap ini, sederhananya bisa dianggap ... pertukaran pendapat yang bersifat membangun dan damai, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700216
					],
					"speakerTitle": "Anastasia"
				},
				{
					"id": 3700216,
					"content": "Aku akan ... mencatat semuanya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700217
					],
					"speakerTitle": "Anastasia"
				},
				{
					"id": 3700217,
					"content": "#Ah, kamu sudah kembali, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700218
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700218,
					"content": "Terima kasih atas bantuanmu, akhirnya aliran elemennya sudah kembali stabil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700219
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700219,
					"content": "Dampak serangan terakhir Stormterror akhirnya dapat dikendalikan untuk saat ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700220
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700220,
					"content": "Tapi, tekanan dari delegasi sudah terlalu besar untuk diabaikan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700221
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700221,
					"content": "Delegasi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3700222,
					"content": "Dari Pelabuhan Liyue, atau Kota Inazuma?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3700223,
					"content": "Snezhnaya. Mereka memilih untuk menjadi pengikut dari Archon Cryo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700224
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700224,
					"content": "Utusan mereka menggunakan nama tertentu, yaitu Fatui. Kalian pernah mendengar tentang mereka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700225
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700225,
					"content": "Oh, tentang mereka? Mereka memang terkenal sekali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3700226,
					"content": "Eh tunggu, tapi kayaknya terkenal karena hal-hal buruknya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3700227,
					"content": "Aku tidak setuju kalau membunuh Stormterror adalah jalan keluar yang tepat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700228
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700228,
					"content": "Lagi pula, Fatui pengikut Archon Cryo selalu mendambakan kekuatan Archon Anemo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700229
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700229,
					"content": "Aku tidak percaya kalau mereka memrioritaskan kepentingan Mondstadt sebagai hal yang terutama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700230
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700230,
					"content": "Ngomong-ngomong soal kekuatan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3700231
					]
				},
				{
					"id": 3700231,
					"content": "#Ada apa, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700232
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700232,
					"content": "Ada sesuatu yang ingin kuperlihatkan pada Knights of Favonius ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3700233
					]
				},
				{
					"id": 3700233,
					"content": "Oh? Kalau begitu ayo kita kembali ke markas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700234
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700234,
					"content": "Lebih baik kita tidak membahas hal-hal yang penting ... di tempat umum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jean"
				}
			]
		},
