				"points": []
			},
			"dialogs": [
				{
					"id": 721190101,
					"content": "Ah! Pengembara, kurasa... ada masalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190102
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190102,
					"content": "Para Fatui tiba-tiba berkumpul ke tengah. Sepertinya mereka menemukan sesuatu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190103
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190103,
					"content": "Mereka bukan mau menghancurkan pertahanan di inti kan...? Tidak, kita tidak boleh tunda lagi, pengujian fungsional harus segera dimulai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190104
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190104,
					"content": "Pengujian fungsional?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721190105
					]
				},
				{
					"id": 721190105,
					"content": "Menguji kemampuan alat kita ini. Aku tidak mau dia gagal setelah sampai ke dalam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190106
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190106,
					"content": "Jadi, kamu tolong cari tiga Onikabuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190107
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190107,
					"content": "Aku ingin taruh mereka di sekitar Mikage Furnace, agar terkontaminasi energi Tatarigami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190108
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190108,
					"content": "Lalu, ambil mereka dan murnikan dengan alat ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190109
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190109,
					"content": "Demikianlah \"pengujian fungsional\" rancanganku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190110
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190110,
					"content": "Di mana aku bisa menemukan \"Onikabuto\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721190111
					]
				},
				{
					"id": 721190111,
					"content": "Hmm... Mereka biasanya ada di daerah yang padat elemen Electro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190112
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190112,
					"content": "Aku juga dengar kalau mereka bisa hidup di dekat Mikage Furnace... Sungguh makhluk kecil yang luar biasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190113
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190113,
					"content": "Kalau gitu aku bukannya lebih baik langsung cari di Mikage Furnace saja?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721190114
					]
				},
				{
					"id": 721190114,
					"content": "Bisa juga... Tapi kalau pakai Onikabuto dari dalam Mikage Furnace untuk pengujian...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190115
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190115,
					"content": "Sejujurnya, aku khawatir sejauh mana alat ini dapat berfungsi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190116
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190116,
					"content": "Pengujian sebaiknya dilakukan secara \"bertahap\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190117
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190117,
					"content": "Uhuk, intinya tolong bawakan tiga Onikabuto... Aku tunggu di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190118,
						721190120
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190118,
					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721190119
					]
				},
				{
					"id": 721190119,
					"content": "Kalau begitu tolong ya, aku cuma perlu tiga Onikabuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190120,
					"content": "Lebih baik aku saja yang masuk dan berkeliling...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721190121
					]
				},
				{
					"id": 721190121,
					"content": "Hmm, kalau kamu masuk ke sana lalu terkontaminasi, sebenarnya kamu bisa juga dijadikan obyek pengujian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190122
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190122,
					"content": "Tapi kan aku sudah bilang, aku tidak tahu apakah alat ini dapat berfungsi sesuai perkiraan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190123
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190123,
					"content": "Kalau ada sesuatu yang terjadi saat pemurnian, kamu... ah, bisa kena masalah tak terduga...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190124
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190124,
					"content": "Uhuk, sebaiknya kita tetap pakai Onikabuto untuk pengujian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190125
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190125,
					"content": "Aku hanya perlu tiga saja. Setelah ketemu, tolong langsung bawa ke sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				}
			]
		},
