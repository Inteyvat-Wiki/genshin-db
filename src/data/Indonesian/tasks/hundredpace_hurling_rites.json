				"points": []
			},
			"dialogs": [
				{
					"id": 715230101,
					"content": "Hmm, segini sih harusnya sudah agak gampang lah ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715230102
					],
					"speakerTitle": "Ting Zhi"
				},
				{
					"id": 715230102,
					"content": "Kamu lagi apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715230103
					]
				},
				{
					"id": 715230103,
					"content": "Aku lagi siapkan permainan yang jadi tanggung jawabku ... sudah tahu \"Adat Lontar Seratus Langkah\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715230104
					],
					"speakerTitle": "Ting Zhi"
				},
				{
					"id": 715230104,
					"content": "Mau suruh aku lempar-lempar barang sampai jauh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715230105
					]
				},
				{
					"id": 715230105,
					"content": "Boleh juga pengamatannya! Separuh benar sih. Permainannya memang berkutat pada \"melempar\", tapi ada unsur \"adat\"-nya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715230106
					],
					"speakerTitle": "Ting Zhi"
				},
				{
					"id": 715230106,
					"content": "Ini permainan yang aku dapat dari buku kuno. Boleh kujelaskan dulu yah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715230107
					],
					"speakerTitle": "Ting Zhi"
				},
				{
					"id": 715230107,
					"content": "Tradisinya, setiap peserta harus duduk, mengikuti adat yang berlaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715230108
					],
					"speakerTitle": "Ting Zhi"
				},
				{
					"id": 715230108,
					"content": "Duduknya harus pakai postur khusus, yang sayang sekali tidak dapat aku peragakan karena di sini tidak ada bantalan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715230109
					],
					"speakerTitle": "Ting Zhi"
				},
				{
					"id": 715230109,
					"content": "Peserta harus mengikuti irama musik dan melempar \"anak panah\" ke \"kendi\" yang jauh, sambil duduk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715230110
					],
					"speakerTitle": "Ting Zhi"
				},
				{
					"id": 715230110,
					"content": "Ada banyak cara untuk melempar anak panahnya, dan masing-masing ada istilahnya sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715230111
					],
					"speakerTitle": "Ting Zhi"
				},
				{
					"id": 715230111,
					"content": "Contoh, anak panah pertama yang masuk ke kendi disebut \"Pertama\". Kalau anak panah berikutnya masuk lagi, istilahnya \"Beruntun\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715230112
					],
					"speakerTitle": "Ting Zhi"
				},
				{
					"id": 715230112,
					"content": "Kalau anak panah kena ke pegangan kendi, disebutnya \"Tindik\". Kalau kena leher kendi lalu terpantul keluar, namanya \"Gagah\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715230113,
						715230116
					],
					"speakerTitle": "Ting Zhi"
				},
				{
					"id": 715230113,
					"content": "Ribet banget!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715230114
					]
				},
				{
					"id": 715230114,
					"content": "Tenang, yang barusan itu versi tradisionalnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715230115
					],
					"speakerTitle": "Ting Zhi"
				},
				{
					"id": 715230115,
					"content": "Aku sudah sederhanakan kok buat yang mau main sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715230118
					],
					"speakerTitle": "Ting Zhi"
				},
				{
					"id": 715230118,
					"content": "Ehem. Pokoknya, lempar sebanyak mungkin anak panah ke dalam kendi sebelum waktunya habis! Sisanya aku yang urus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715230119
					],
					"speakerTitle": "Ting Zhi"
				},
				{
					"id": 715230119,
					"content": "Penyederhanaan yang luar biasa sekali, Bung!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715230120
					]
				},
				{
					"id": 715230120,
					"content": "Iya ... bukunya bilang siapa yang masukkan panah terbanyak, dia menang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715230121
					],
					"speakerTitle": "Ting Zhi"
				},
				{
					"id": 715230121,
					"content": "Lalu hukumannya ... kalau menurut buku, yang kalah harus minum lalu bikin puisi. Aku tidak mungkin minta semua peserta lakukan itu, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715230122
					],
					"speakerTitle": "Ting Zhi"
				},
				{
					"id": 715230122,
					"content": "Nah, persiapannya sudah mau beres. Kendi Penahan ada di sana, anak panahnya aku ambilkan sebentar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715230123
					],
					"speakerTitle": "Ting Zhi"
				},
				{
					"id": 715230123,
					"content": "Kamu bisa langsung coba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ting Zhi"
				},
				{
					"id": 715230116,
					"content": "Mana bisa ingat semua!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715230117
					]
				},
				{
					"id": 715230117,
					"content": "Tenang, kalian tidak usah susah-susah. Mengingat istilah-istilah kayak gitu tuh ... tugasku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715230118
					],
					"speakerTitle": "Ting Zhi"
				}
			]
		}
	]
}