			"dialogs": [
				{
					"id": 751270101,
					"content": "Oh, mau meninggalkan kenangan juga? Pernah ada pengunjung asing yang datang untuk tujuan yang sama. Pulau terbang itu memang sesuatu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751270102
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 751270102,
					"content": "Sayangnya dulu aku belum punya kamera. Akhirnya beli impor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751270103
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 751270103,
					"content": "Gimana, pengembara? Mau foto juga? Tapi sendiri ya, aku tidak begitu jago foto sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751270104
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 751270104,
					"content": "Aneh, kabut di laut tadi ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751270105
					]
				},
				{
					"id": 751270105,
					"content": "Kabut? Apaan? Angin sekencang ini mana bisa ada kabut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751270106
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 751270106,
					"content": "Aku belum pernah lihat kabut di laut, seumur hidup pun belum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751270107
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 751270107,
					"content": "Apa mungkin kamu salah ingat tempat ini dengan daerah berkabut di balik gunung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751270108
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 751270108,
					"content": "Mungkin ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751270109
					]
				},
				{
					"id": 751270109,
					"content": "Hehehe, menurutku sih kamu terlalu tegang ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751270110
					],
					"speakerTitle": "Sakaw"
				},
