			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dainsleif"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80020601,
					"content": "Masuk ke Katedral dan tanyakan orang sekitar. Aku akan menunggu di luar sini.",
					"roleType": "TALK_ROLE_NPC",
