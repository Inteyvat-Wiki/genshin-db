				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Barbara"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80020101,
					"content": "Honorary Knight! Hai, apa kabar? Apa kamu perlu sesuatu hari ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020102
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020102,
					"content": "Agh... Tapi harus kutegaskan dari awal jika kamu mau meminjam Holy Lyre der Himmel lagi, kami tidak bisa meminjamkannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020103
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020103,
					"content": "(sepertinya dia masih belum sadar kalau itu cuma ilusi...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020104,
					"content": "Kami di sini untuk menanyakan sesuatu. Barbara, apa kamu pernah dengar soal \"Field Tiller pertama\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020105,
					"content": "Hmm? Apa itu? \"Field Tiller\"... Benda apa itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020106
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020106,
					"content": "Ah, baiklah, jadi kamu tidak tahu. Oke, pertanyaan selanjutnya: Apakah gereja pernah kehilangan Patung The Seven?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020107,
					"content": "Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020108
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020108,
					"content": "Kamu di sini untuk bertanya tentang cerita lama itu? Hmm, aku tidak menduga... Jadi ini kejadian yang sudah lama sekali, hampir tidak ada orang lagi yang mengungkitnya sekarang ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020109
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020109,
					"content": "Jadi dulu sekali, pada suatu malam memang ada Patung The Seven yang menghilang tanpa jejak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020110
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020110,
					"content": "Hampir semua anggota gereja ikut mencarinya, tapi tidak pernah ditemukan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020111
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020111,
					"content": "Dalam catatan gereja, kejadian itu disebut sebagai \"Patung The Seven yang Hilang\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020112
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020112,
					"content": "Hmm... Ternyata benar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020113,
					"content": "Maksudnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020114
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020114,
					"content": "Eh, tidak ada apa-apa! Jadi, apa kamu punya petunjuk lain? Eh, maksud Paimon... apa ada cerita aneh lainnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020115,
					"content": "(Maaf, Barbara, tapi kami masih belum bisa bilang tentang patung yang kita lihat tadi... Seperti yang Dain katakan, ini demi kebaikanmu sendiri...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020116,
					"content": "Cerita aneh lain? Aku tidak yakin, coba kupikirkan tenang kejadian lain yang tidak biasa di catatan gereja... \"Amarah Terakhir sang Tiran\"? Tidak, zamannya berbeda, sepertinya tidak ada hubungannya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020117
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020117,
					"content": "\"Amarah Terakhir sang Tiran\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020118,
					"content": "Oh, ini merujuk ke zaman yang berbahaya di Mondstadt Tua, tempat yang sekarang dikenal dengan nama Stormterror's Lair.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020119
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020119,
					"content": "Bertahun-tahun yang lalu, ada suatu masa ketika bola api turun dari langit setiap kali ada orang yang mendekati Monstadt Tua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020120
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020120,
					"content": "Bola api turun dari langit?! Seram sekali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020121,
					"content": "Orang-orang pada saat itu percaya bahwa itu adalah kutukan yang dibuat oleh Dewa Badai, jadi mereka menyebutnya sebagai \"Amarah Terakhir sang Tiran\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020122
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020122,
					"content": "Fenomena aneh ini berlangsung sekitar satu tahun. Tidak ada yang bisa menyelesaikannya, dan akhirnya secara perlahan berakhir dengan sendirinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020123,
						80020124
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020123,
					"content": "Aneh sekali.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020125
					]
				},
				{
					"id": 80020125,
					"content": "Benar! Belakangan, teori tentang \"Amarah Terakhir sang Tiran\" menjadi kurang logis di mata gereja. Alasan umum lainnya adalah karena Dewa Badai tidak akan menembakkan bola api...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020126
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020126,
					"content": "Mungkin ada hal lain yang menyebabkan bencana itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020127
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020127,
					"content": "Oke jadi, kejadian ini sepertinya tidak berhubungan dengan \"Patung The Seven yang Hilang\", tapi aku tidak bisa memikirkan kejadian aneh lainnya lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020128
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020128,
					"content": "Tidak apa-apa, terima kasih ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020129,
					"content": "Uh... lagi-lagi kata-kata tidak berguna seperti \"terima kasih\". Aku sepertinya tidak akan pernah terbiasa mendengarnya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020130
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 80020130,
					"content": "Oh, Rosaria, ternyata kamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020131
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020131,
					"content": "Jika kamu mencari Knights of Favonius, mereka sibuk dengan para monster itu lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020132
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 80020132,
					"content": "\"Para monster\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020133
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020133,
					"content": "Para monster yang terakhir kali mencoba menyerang Mondstadt saat kejadian Stormterror.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020134
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 80020134,
					"content": "Bukannya itu Abyss Order? Mereka mulai lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020135,
					"content": "Benar. Mereka sedang berkumpul di <color=#00E1FFFF>Wolvendom</color>, para serigala menjadi sangat gelisah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020136
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 80020136,
					"content": "Mungkinkah... Abyss Order mengincar jiwa dari Lupus Boreas? Alasannya apa, aku juga tidak yakin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020137
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 80020137,
					"content": "Master Jean sudah menuju ke <color=#00E1FFFF>Wolvendom</color>. Aku juga sudah harus mulai bergerak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020138
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 80020138,
					"content": "Ka-kalau begitu aku juga ikut pergi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020139
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020139,
					"content": "Master Jean bilang kamu harus tetap tinggal di gereja, dan melanjutkan pekerjaanmu sebagai biarawati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020140
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 80020140,
					"content": "Ta-tapi... kamu juga anggota gereja...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020141
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020141,
					"content": "Jangan khawatir, aku juga akan pergi untuk membantu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020142
					]
				},
				{
					"id": 80020142,
					"content": "Benar, kita akan membantu Master Jean juga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020143
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020143,
					"content": "Oh... baiklah, jika Honorary Knight ada di sana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020144
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020144,
					"content": "Tapi tolonglah, semuanya, hati-hati. Semoga Archon Anemo selalu melindungi kalian semua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020124,
					"content": "Itu belum tentu terkait dengan tiran...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020125
					]
				}
			]
		},
		{
			"id": 800202,
			"completionStepIds": [
				800205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800205",
							"2"
						],
						"stepId": 800205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jean"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80020201,
					"content": "Fuh... Benar-benar banyak sekali musuh di sekitar sini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020202,
					"content": "Semakin kita dekat dengan targetnya, semakin banyak musuhnya. Hmph, ini benar-benar gayanya Abyss Order.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020203
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020203,
					"content": "Kita harus cepat dan temukan Lupus Boreas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020204
					]
				},
				{
					"id": 80020204,
					"content": "Iya! Ayo cepat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020205,
					"content": "Aku... tidak bisa pergi lebih jauh lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020206
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020206,
					"content": "Hah? Kenapa tidak? Apa karena kamu takut dengan hewan berbulu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020207,
						80020208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020207,
					"content": "Sepertinya... bukan itu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020209
					]
				},
				{
					"id": 80020209,
					"content": "Ini tidak ada hubungannya dengan para serigala. Karena Boreas adalah dewa kuno, tapi dia bersedia menjadi pelayan The Seven.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020210
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020210,
					"content": "Aku tidak bisa setuju dengan tindakannya. Jadi aku tidak mau berinteraksi dengannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020211
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020211,
					"content": "Lagi pula, orang-orang menyukaimu. Sementara aku... tidak begitu disukai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020212,
						80020214
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020212,
					"content": "Kamu benar-benar tidak menyukai The Seven ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020213
					]
				},
				{
					"id": 80020213,
					"content": "Tidak ada sesuatu yang spesial mengenai dewa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020216
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020216,
					"content": "Ini hanya pendapatku saja, tapi kusarankan: Selalu waspada saat berada di sekitar dewa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020217
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020217,
					"content": "Kamu jangan terlalu percaya pada mereka. Tapi di waktu yang sama, jangan bertindak terlalu jauh juga... Jangan mencoba untuk menggulingkan mereka, atau memburu mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020218
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020218,
					"content": "Walaupun dewa itu adalah musuh bebuyutanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020219
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020219,
					"content": "Jangan percaya mereka, dan jangan memburu mereka... Saran yang aneh. Dain membenci The Seven atau melindungi mereka sih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020220,
					"content": "Kenapa pendapatmu itu berlawanan sekali?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020221
					]
				},
				{
					"id": 80020221,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020222
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020222,
					"content": "Pelajaran dari masa lalu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020223
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020223,
					"content": "Aku... akan memberi tahu satu fakta terakhir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020224
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020224,
					"content": "Eh? Fakta apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020225,
					"content": "Kehancuran bangsa Khaenri'ah oleh para dewa... adalah alasan Abyss Order sekarang ingin menghancurkan bangsa yang diperintah oleh The Seven.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020226
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020226,
					"content": "Baiklah, cukup bicaranya. Kita harus kembali ke permasalahan utama. Aku akan membereskan Abyss Order yang tersisa di sini. Kamu coba kunjungi Boreas. Setelahnya, ayo kita bertemu di pintu masuk Wolvendom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020227
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020227,
					"content": "Oh... dia pergi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020228,
					"content": "Benar-benar pria yang aneh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020229,
					"content": "Aku bisa memahaminya sedikit.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020230
					]
				},
				{
					"id": 80020230,
					"content": "Iya, benar. Kamu juga harus waspada kepada dewa-dewa yang tak dikenal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020231,
					"content": "Pada Rite of Descension di Liyue, keputusanmu sangat mirip dengan apa yang akan Dain lakukan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020232,
					"content": "Saat tidak ada kepercayaan, menghindari situasi sepenuhnya masih lebih baik daripada mencoba untuk bernegodiasi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020233
					]
				},
				{
					"id": 80020233,
					"content": "*huff*...Situasinya sulit juga...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020234,
					"content": "Honorary Knight! Paimon! Apa yang kalian berdua lakukan di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020235
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 80020235,
					"content": "Oh, Master Jean! Senang sekali bisa menemukanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020236,
					"content": "Rosaria bilang kamu ke sini untuk melawan Abyss Order, jadi kami datang membantu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020237
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020237,
					"content": "Bantuanmu sangat kami hargai. Serangan Abyss Order yang begitu mendadak memang benar-benar aneh, mereka sudah mengepung Wolvendom. Aku sedang bersiap-siap untuk mengutus beberapa Knight untuk menyerang balik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020238
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 80020238,
					"content": "Aku baru saja memeriksa sekeliling Wolvendom... tapi aku tidak melihatmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020239
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 80020239,
					"content": "Rosaria bilang Abyss Order mengincar Boreas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020240
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 80020240,
					"content": "Tapi Abyss Order dan Boreas... Apa hubungan di antara mereka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020241
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 80020241,
					"content": "Mereka hanya suka menyebabkan masalah. Apa mereka benar-benar butuh alasan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020242
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020242,
					"content": "Abyss Order sudah pernah mengincar Dvalin, jadi tidak heran jika dia juga akan mengincar rekan lain Archon Anemo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020243
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020243,
					"content": "Hmm... Benar juga...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020244
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 80020244,
					"content": "Tapi, terlepas dari alasan di balik ancaman saat ini jelas atau tidak, aku akan tetap menangani situasinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020245
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 80020245,
					"content": "Honorary Knight, tolong pergi dan lihat apakah Lupus Boreas berada dalam bahaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020246
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 80020246,
					"content": "Jiwa dari dewa ini... dia tidak terlalu sering melihat manusia. Tapi kudengar kamu pernah bertemu dengannya sebelumnya. Mungkin akan lebih baik jika kamulah yang menemuinya kali ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020247
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 80020247,
					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020248
					]
				},
				{
					"id": 80020248,
					"content": "Baiklah, hati-hati. Terima kasih atas bantuanmu, Honorary Knight dari Knights of Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jean"
				},
				{
					"id": 80020214,
					"content": "Kamu benar-benar tidak suka interaksi sosial ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020215
					]
				},
				{
					"id": 80020215,
					"content": "Aku tidak masalah berinteraksi dengan orang. Tapi berinteraksi dengan dewa... itu lain cerita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020216
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020208,
					"content": "Bukannya hewan berbulu itu lucu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020209
					]
				}
			]
		},
		{
			"id": 800203,
			"completionStepIds": [
				800211
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
