			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Razor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80020301,
					"content": "Kamu... tidak disambut di sini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020302
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 80020302,
					"content": "Hahaha... Jadi, jiwa dari serigala yang hebat itu sekarang suka memelihara anak anjing liar ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020303
					],
					"speakerTitle": "Abyss Herald"
				},
				{
					"id": 80020303,
					"content": "Kamu mengaku sebagai penjaga? Cakarmu yang dulu tajam itu sudah tumpul sejak hari kejayaanmu berakhir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020304
					],
					"speakerTitle": "Abyss Herald"
				},
				{
					"id": 80020304,
					"content": "Jika kamu melayani kami, kami bisa mengembalikan kekuatan suci yang dulu pernah kamu miliki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020305
					],
					"speakerTitle": "Abyss Herald"
				},
				{
					"id": 80020305,
					"content": "Bohong... bohong...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020306
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 80020306,
					"content": "Upacara apa ini? Sepertinya dia kesakitan sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020307,
					"content": "Oh tidak... Apakah ini hal yang sama seperti waktu mereka meracuni pikiran Dvalin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020308,
					"content": "Serigala tidak pernah menyerah. Tapi... juga tidak bisa maju terus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020309,
						80020310
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 80020309,
					"content": "Aku akan menghentikannya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020311
					]
				},
				{
					"id": 80020311,
					"content": "Berapa kali pun kamu mencoba menahan kami, semuanya akan sia-sia saja...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Abyss Herald"
				},
				{
					"id": 80020310,
					"content": "Inilah waktuku untuk bertarung lagi dengan Abyss Herald.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020311
					]
				}
			]
		},
		{
			"id": 800204,
			"completionStepIds": [
				800209
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800209",
							"2"
						],
						"stepId": 800209,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dainsleif"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80020401,
					"content": "Patung yang besar, Katedral yang megah... Banyak sekali sumber daya dan energi yang sudah dihabiskan warga Mondstadt untuk membangun ini semua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020402
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020402,
					"content": "Tapi, apakah Archon Anemo sadar akan semua pemberian ini, dan sebaliknya berapa banyak yang dia sudah berikan sebagai balasannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020403
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020403,
					"content": "Bukannya kepercayaan itu ikhlas dan tidak menuntut imbalan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020404,
					"content": "Hmph, selama para dewa memiliki hati nurani yang bersih tentang itu semua, tidak ada yang bisa aku katakan tentang itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020405
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020405,
					"content": "Shh! Kita akan memasuki Katedral. Jangan katakan hal buruk mengenai Archon Anemo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020406,
					"content": "Dan sebenarnya, Archon Anemo itu... Ah, sudahlah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020407,
					"content": "Heh, aku tidak pernah bilang aku akan masuk Katedral. Biar kalian saja yang bicara pada para suster itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020408
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020408,
					"content": "Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020409,
						80020410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020409,
					"content": "Tapi kita sudah mengerjakan hal lainnya bersama-sama.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020411
					]
				},
				{
					"id": 80020411,
					"content": "Kamu adalah Honorary Knight dari Mondstadt. Mereka pasti akan mengizinkanmu untuk menyelidiki masalah ini dan memercayaimu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020412
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020412,
					"content": "Bila aku ikut denganmu, mereka akan curiga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020413,
						80020414
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020413,
					"content": "Karena mereka tidak mengenalmu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020415
					]
				},
				{
					"id": 80020415,
					"content": "Benar, dan seperti yang teman kecil kita bilang... Aku bisa kapan saja mengatakan hal buruk tentang gereja...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020416
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020416,
					"content": "Saat orang yang tidak percaya apa pun menginjak tempat suci, hasilnya tidak pernah baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020417
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020417,
					"content": "Aku tidak pernah menerima bantuan dari para dewa di masa lalu. Aku juga tidak melihat alasan kenapa aku membutuhkannya sekarang atau di masa depan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020418
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020418,
					"content": "Tapi cukup tentang itu. Selagi kita ngobrol, Abyss Order masih melanjutkan aksinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020419
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020419,
					"content": "#Baiklah kalau begitu, {NICKNAME}, ayo kita masuk dan bertanya-tanya sedikit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020420,
					"content": "Aku harus memperingatkanmu tentang satu hal. Jangan pernah menyebutkan tentang Patung Ternoda di dalam Katedral.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020421
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020421,
					"content": "Church of Favonius tidak akan mengabaikan masalah patung, tapi jika mereka dengan sembrono mencoba melawan Abyss Order, mereka akan terkejut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020422
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020422,
					"content": "Lalu... Ikut campur di dalam masalah Abyss biasanya tidak akan berakhir baik untuk semua orang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020414,
					"content": "Kamu tidak berpikir kalau kamu bakal populer di antara para suster?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020415
					]
				},
				{
					"id": 80020410,
					"content": "Apa kamu tidak penasaran?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020411
					]
				}
			]
		},
		{
			"id": 800205,
			"completionStepIds": [
				800210
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800210",
							"2"
						],
						"stepId": 800210,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dainsleif"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80020501,
					"content": "Begitu ya, apa Abyss Order sudah menjalankan operasi barunya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020502
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020502,
					"content": "Ini mungkin ada hubungannya dengan Patung Ternoda. Kita juga sebaiknya ikut pergi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020503
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020503,
					"content": "Tapi, buat apa Abyss Order pergi ke Wolvendom? Apa mereka mau melakukan sesuatu seperti yang mereka lakukan pada Dvalin? Aaaah.... Jangan begitu lagi dong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020504,
					"content": "Tidak, sepertinya bukan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020505
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020505,
					"content": "Tidak seperti Osial, yang hanya disegel saja. Andrius sudah mati sejak lama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020506
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020506,
					"content": "Sekarang hanya jiwanya saja yang menjaga Wolvendom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020507
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020507,
					"content": "Abyss Herald mungkin mengincar jiwa Andrius untuk mendapatkan sejumlah informasi dari salah satu teman lama Archon Anemo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				}
			]
		},
		{
			"id": 800206,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
