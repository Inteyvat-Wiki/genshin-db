			]
		},
		{
			"id": 800207,
			"completionStepIds": [
				800208
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800208",
							"2"
						],
						"stepId": 800208,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Boreas"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80020701,
					"content": "Hmph... Upacaranya terganggu. Kalian beruntung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020702
					],
					"speakerTitle": "Abyss Herald"
				},
				{
					"id": 80020702,
					"content": "Bagaimana mungkin jiwa yang sudah tua ini punya tekad yang begitu kuat...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020703
					],
					"speakerTitle": "Abyss Herald"
				},
				{
					"id": 80020703,
					"content": "Tidak masalah. Ini cuma variabel kecil yang tak terduga. Skenario besar kami tidak akan terpengaruh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020704
					],
					"speakerTitle": "Abyss Herald"
				},
				{
					"id": 80020704,
					"content": "Menghilang lagi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020705,
						80020706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020705,
					"content": "Setidaknya kali ini kita berhasil menghentikannya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020707
					]
				},
				{
					"id": 80020707,
					"content": "Terima kasih, kamu datang... tepat waktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020708
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 80020708,
					"content": "Lupical manusia... Sungguh memalukan karena kamu harus melihatku dalam kondisi seperti sekarang ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020709
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 80020709,
					"content": "Tapi tetap saja, Abyss Herald itu meremehkan kekuatanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020710
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 80020710,
					"content": "Lupus Boreas tidak pernah menolak tantangan. Tapi, pengunjung dari luar... tidak menghormati aturan tantangannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020711
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 80020711,
					"content": "Aku juga, tidak melihat... jebakannya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020712
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 80020712,
					"content": "Jadi maksudmu, Abyss Order sudah menyiapkan segalanya untuk meracuni pikiran Lupus Boreas, mereka memancingnya keluar dengan bilang ingin menantangnya dengan sebuah tantangan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020713,
						80020714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020713,
					"content": "Bukan salahmu, Razor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020715
					]
				},
				{
					"id": 80020715,
					"content": "#Terima kasih, {NICKNAME}. Ke depannya, cakarku, harus lebih tajam lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020716
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 80020716,
					"content": "Kamu... mencium bau bahaya, dan datang ke sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020717
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 80020717,
					"content": "Tidak, kami dengar tentang adanya bahaya. Hidung Paimon bahkan tidak tahu bau bahaya itu seperti apa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020718,
					"content": "Selain datang untuk menolong, kami sebenarnya punya sesuatu untuk ditanyakan juga padamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020719
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020719,
					"content": "Eh... Permisi, Tuan Dewa Serigala, apa kamu tahu sesuatu tentang Field Tiller pertama?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020720
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020720,
					"content": "Aku tidak peduli dengan alat-alat manusia. Aku tidak tahu apa itu \"Field Tiller\", tapi memang ada satu mesin buatan manusia yang tidak pernah bisa aku lupakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020721
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 80020721,
					"content": "Benda itu masuk secara tidak sengaja ke daerah tantangan, dan aku salah mengira itu sebagai penantang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020722
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 80020722,
					"content": "Tapi mesin itu tidak bisa berpikir, hanya bertarung saja. Mesin itu dibuat murni sebagai mesin pembunuh dari atas sampai bawah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020723
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 80020723,
					"content": "Aku akhirnya berhasil merusaknya dengan salah satu seranganku. Sebelum jatuh ke tanah, dia akhirnya melarikan diri dari tempatku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020724
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 80020724,
					"content": "Hmm... Dari ceritanya, kemungkinan besar itu Field Tiller pertama, ya kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020725,
						80020727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020725,
					"content": "Apa mesin itu bisa berputar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020726
					]
				},
				{
					"id": 80020726,
					"content": "Benar. Mesinnya bisa berputar, lompat tinggi ke udara, dan bahkan menembakkan bola api. Walaupun tidak sekuat dewa, tapi tetap saja lebih kuat daripada mereka yang bahkan memiliki Vision.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020730
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 80020730,
					"content": "Bola api...? Hei, bukannya belakangan kita pernah dengar tentang ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020731
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020731,
					"content": "Ah sudahlah, tapi ini sudah merupakan bukti bahwa Field Tiller pertama datang ke Mondstadt, ya kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020732
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020732,
					"content": "Kedengarannya sih yang pertama itu jauh lebih kuat daripada Ruin Guard yang diproduksi masal setelahnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020733
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020733,
					"content": "Tapi dalam cerita ini, mesin itu berhasil dilukai di dalam area tantangan saat bertarung melawan Wolf of The North...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020734
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020734,
					"content": "Tidak tahu... Tapi, apa kita cukup membantu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020735
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 80020735,
					"content": "Tentu saja, kalian sudah membantu banyak sekali! Terima kasih loh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020736
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020736,
					"content": "Kami harus terus melanjutkan menyelidiki sesuatu yang sangat amat penting. Abyss Herald mungkin sudah pergi, tapi pasukan Abyss masih menyerang — kalian berdua hati-hati ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020737
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020737,
					"content": "Iya. Aku mencium... bau bahaya. Bahaya yang lebih besar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020738
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 80020738,
					"content": "Kalian berdua, juga hati-hati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Razor"
				},
				{
					"id": 80020727,
					"content": "Apa mesinnya bisa menembakkan misil?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020728
					]
				},
				{
					"id": 80020728,
					"content": "\"Misil\"? Aku tidak tahu kata ini... Seperti yang kubilang, aku tidak peduli dengan alat-alat buatan manusia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020729
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 80020729,
					"content": "Mesinnya bisa berputar, lompat tinggi ke udara, dan bahkan menembakkan bola api. Walaupun tidak sekuat dewa, tapi tetap saja lebih kuat daripada mereka yang bahkan memiliki Vision.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020730
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 80020714,
					"content": "Ayo, semangat dong.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020715
					]
				},
				{
					"id": 80020706,
					"content": "Mereka lari cepat sekali.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020707
					]
				}
			]
		}
	]
}