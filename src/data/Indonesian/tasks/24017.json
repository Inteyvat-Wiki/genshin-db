			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yves"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240170201,
					"content": "Bandit serakah, brengsek ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170203
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170203,
					"content": "Gimana baju selamnya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170204
					]
				},
				{
					"id": 240170204,
					"content": "Ah, halo! Senang bisa ketemu lagi. Ini hal paling baik yang terjadi hari ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170205
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170205,
					"content": "Mau tahu tidak siksaan terbaru dari si Goldman ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170206
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170206,
					"content": "Dia panggil tukang catat yang pahit sekali hitungannya buat menentukan berapa banyak barang yang bisa kami ambil dari air setiap harinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170222
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170222,
					"content": "Kemudian dia memaksa kami untuk mengangkut barang bekas ke darat berdasarkan perhitungan ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170207
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170207,
					"content": "Kami ini manusia, bisa capek, luka, lapar, atau memang lagi tidak ada tenaga saja! Mana bisa kasih jumlah yang sama terus-terusan! Apa si Goldman peduli? OH, TIDAK!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170223
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170223,
					"content": "Kalau kuotanya tidak tercapai, dia bakal marah dan bahkan mengurangi bayaran kami!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170208
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170208,
					"content": "Bukan salah si tukang hitung sih, memang. Namanya Finnegan, dia orang baik kok, simpatis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170209
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170209,
					"content": "Waktu menghitung, dia tanya kami soal kerjaan sehari-hari. Terus satu hari, setelah dia dengar cerita kami dan beres menghitung ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170224
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170224,
					"content": "Terus tiba-tiba, dia bakal berdiri, terus buru-buru pergi ke rumah Goldman, dan mulai teriak-teriak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170210
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170210,
					"content": "Dia bilang gini: \"Keterlaluan! Yang kerja ini masih manusia loh, bukan mesin!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170211
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170211,
					"content": "Akhirnya dia diusir anak buah Goldman, sampai jatuh ke kubangan segala. Kami yang nolongin dia bangun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170212
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170212,
					"content": "Orang itu minta maaf berkali-kali, sampai nangis. Tidak satu pun yang tega menyalahkannya, termasuk aku. Dia juga korban si Goldman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170213
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170213,
					"content": "Dia janji mau cari keadilan buat kami, tapi ... kami semua cuma berdoa agar dia tidak akan pernah balik lagi ke kubangan sampah ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170214,
						240170215
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170214,
					"content": "Jadi hari ini masih harus kerja berapa lama?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170216
					]
				},
				{
					"id": 240170216,
					"content": "Aduh banyak banget deh. Aku bahkan tidak tahu kapan bisa beres. Pokoknya aku kerjakan dulu, sambil doa supaya tidak kena potong gaji. Mesti cari orang yang bisa pinjamkan baju selam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170217,
						240170218
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170217,
					"content": "Aku bantu deh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170219
					]
				},
				{
					"id": 240170219,
					"content": "Serius? Kamu mau bantu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170220
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170220,
					"content": "Kamu ... benar-benar penyelamatku. Kalau saja si Goldman itu punya hati kayak kamu, setengahnya saja! ... Oh, tidak. Maafkan aku, aku harusnya jangan bandingkan dia sama kamu ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170221
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170221,
					"content": "Seperti sebelumnya, aku akan menandai lokasi objeknya, terus kita cari ke dua-duanya. Duh, gawat kalau baju yang dapat minjam ini sampai rusak juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170218,
					"content": "Sini biar kubantu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170219
					]
				},
				{
					"id": 240170215,
					"content": "Kerjaannya masih banyak?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170216
					]
				}
			]
		},
