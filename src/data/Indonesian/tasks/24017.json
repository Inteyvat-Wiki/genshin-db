	"talks": [
		{
			"id": 2401701,
			"completionStepIds": [
				2401701
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
