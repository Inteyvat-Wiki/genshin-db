			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yves"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240170401,
					"content": "Benar, inilah yang kami lalui setiap hari. Itu cuma sampah, sampah, dan lebih banyak lagi sampah — mungkin si pelit Goldman itu bakal makan sampah-sampah ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170402
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170402,
					"content": "Terima kasih atas bantuanmu. Ini bayaran yang aku dapat dari Goldman — silakan ambil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170403
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170403,
					"content": "Aku tidak bisa terima.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170404
					]
				},
				{
					"id": 240170404,
					"content": "Tapi kamu harus — ini gaji atas \"kerjamu\", ini sudah bukan milikku lagi ... dan jika kamu tidak ambil, aku akan lempar koin-koin ini ke air.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170405
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170405,
					"content": "Oke, oke ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170406
					]
				},
				{
					"id": 240170406,
					"content": "Nah gitu dong! Kalau nanti kapan-kapan ada barang yang mau kamu ambil di laut, cari aku ya — aku bakal bantu ambil, pasti beres deh apa pun barangnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170407
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170407,
					"content": "Tapi untuk saat ini, aku harus terus melanjutkan memperbaiki baju selamku ini. *huff* lihat deh, lubangnya gede banget ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yves"
				}
			]
		},
		{
			"id": 2401705,
			"completionStepIds": [
				2401706
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2401706",
							"2"
						],
						"stepId": 2401706,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yves"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240170501,
					"content": "Terus ini ... pernak-pernik ini apa sih? Ini yang Goldman mau kita angkat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170502
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170502,
					"content": "Terima kasih banyak atas bantuanmu! Ini ... Ambil Mora ini, dan jangan bilang siapa-siapa soal ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170503
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170503,
					"content": "Kalau aku bisa jual ini, aku bisa beli baju selamku sendiri. Aku jadi tidak harus sewa dari Goldman lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170504,
						240170505
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170504,
					"content": "Aku tidak bisa ambil ini darimu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170506
					]
				},
				{
					"id": 240170506,
					"content": "Bukan begitu! Tapi gaji ini hakmu — ya memang sih, Mora ini tidak menutup semua kerja kerasmu! Tapi, ini semua adalah Mora yang kumiliki. Rencananya sih mau dibuat minum-minum malam ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170507
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170507,
					"content": "Jadi tolong, ambillah. Aku akan urus beberapa hal dulu, terus aku akan pikirkan cara untuk ... menjual barang-barang ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170505,
					"content": "Tenang, aku tidak akan bilang-bilang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170506
					]
				}
			]
		},
		{
			"id": 2401706,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2401705",
							"2"
						],
						"stepId": 2401705,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2401702",
							"2"
						],
						"stepId": 2401702,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yves"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240170601,
					"content": "Cih, si pelit itu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170602,
						240170608,
						240170612
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170602,
					"content": "Goldman itu orangnya gimana sih?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170603
					]
				},
				{
					"id": 240170603,
					"content": "Dia bosku. Jagonya merekrut orang yang tidak punya kemampuan, tapi mengandalkan otot untuk cari nafkah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170604
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170604,
					"content": "Otaknya isinya Fonta! Keras dan pelit bukan main. Dia paksa kami kerja ikut aturan sebuku tebal ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170614
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170614,
					"content": "Bahkan, baju selam yang kita pakai tuh, kita harus \"sewa\" dari dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170605
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170605,
					"content": "Kalau barang yang kita ambil rusak, kita malah harus bayar dia ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170615
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170615,
					"content": "Jadi, kalau aku ceroboh waktu kerja, bukan cuma aku harus bayar biaya sewa, tapi aku juga harus memohon padanya supaya aku tidak diusir! Bah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170606
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170606,
					"content": "Kamu mau tahu apa lagi? Tolong deh, jaga jarak saja dari dia — demi kebaikanmu sendiri loh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170616
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170616,
					"content": "Sungguh keterlaluan, yah begitulah dia, dan orang-orang di sekeliling dia juga begitu. Semua juga sama saja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170607
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170607,
					"content": "Kamu tidak perlu urusan sama dia deh — nanti kalau sudah kena kotornya, susah loh bersihinnya, mau pakai air segimana juga pokoknya ribet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170617
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170617,
					"content": "Tapi yah, mengotori kolam bersih pakai lumpur itu bukan perkara sulit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170608,
					"content": "Kerjaanmu kayaknya berat banget ya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170609
					]
				},
				{
					"id": 240170609,
					"content": "Hah, kan faktanya memang gitu? Tapi ini satu-satunya caraku bertahan hidup. Aku tidak pintar, dan aku tidak punya kemampuan lain, tapi aku juga tidak mau jadi kriminalitas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170618
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170618,
					"content": "Kalau aku harus melakukan hal jahat demi makan sih ... lebih baik aku kelaparan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170610
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170610,
					"content": "Yah memang berat sih, tapi setidaknya aku bisa tidur nyenyak di malam hari. Tidak perlu takut orang benci aku, atau mungkin bakal ada orang yang bunuh aku waktu aku tidur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170611
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170611,
					"content": "Dengan begitu, aku sudah hidup jauh lebih baik daripada Goldman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170612,
					"content": "Sampai jumpa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170613
					]
				},
				{
					"id": 240170613,
					"content": "#Baiklah. Aku serahkan pekerjaan ini kepadamu, {M#Tuan}{F#Nona}. Aku lanjut betulin baju selamnya ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yves"
				}
			]
		},
		{
			"id": 2401707,
			"completionStepIds": [
				2401701
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2401701",
							"2"
						],
						"stepId": 2401701,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"2401701",
							"2"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yves"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240170701,
					"content": "Ugh, apes banget sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170702
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170702,
					"content": "Apa kamu berhasil jual barang-barang itu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170703
					]
				},
				{
					"id": 240170703,
					"content": "Ah, kamu toh. Ugh, sudahlah. Aku barusan nemu pembeli, eh terus Goldman masuk ke rumahku dan merampas sekotak pernak-pernik itu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170704
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170704,
					"content": "Kalau dia sudah tidak butuh aku lagi, aku pasti bakal melawan ... Yah dia mengurangi gajiku selama 2 bulan sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170716
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170716,
					"content": "Dia bayarnya kalau aku sudah selesaikan pekerjaan selama setahun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170705
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170705,
					"content": "*huff* Sudahlah, lupakan. Keberuntungan tidak akan tersenyum pada orang bodoh sepertiku ... Tunggu. Goldman tidak datang ke kamu juga, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170706,
						240170709
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170706,
					"content": "Tidak tuh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170707
					]
				},
				{
					"id": 240170707,
					"content": "Bagus. Aku dipukul sih tidak apa-apa. Tapi aku tidak mau kamu sampai terseret masalah dengan orang seperti dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170708
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170708,
					"content": "Aku juga tidak bilang ke dia soal kamu yang ambil barang, tapi kurasa ada orang lain yang tahu terus kasih tahu dia ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170711
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170711,
					"content": "Namun, aku masih tetap butuh bantuanmu hari ini. Baju selamku masih belum selesai diperbaiki, tapi Goldman sudah menekanku untuk menyelesaikan pekerjaan yang tidak bisa kuselesaikan sebelumnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170712
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170712,
					"content": "Jadi aku tidak punya pilihan lain selain meminjam baju selam orang lain, tapi biarpun begitu, aku tidak bisa menyelesaikan pekerjaanku dengan cepat ... Sayangnya, aku harus mengandalkanmu lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170713,
						240170714
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170713,
					"content": "Tak masalah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170715
					]
				},
				{
					"id": 240170715,
					"content": "Terima kasih. Aku akan menandai lokasi objeknya, terus kita cari ke dua-duanya. Aku lanjut perbaiki baju selamnya ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170714,
					"content": "Oke.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170715
					]
				},
				{
					"id": 240170709,
					"content": "Kalau dia betulan datang padaku, aku akan beri dia pelajaran.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170710
					]
				},
				{
					"id": 240170710,
					"content": "Tolong, jangan sampai kamu terlibat dengan orang yang tidak tahu malu seperti itu! Seseorang yang terhormat sepertimu jangan sampai berurusan dengan orang seperti dia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170711
					],
					"speakerTitle": "Yves"
				}
			]
		}
	]
}