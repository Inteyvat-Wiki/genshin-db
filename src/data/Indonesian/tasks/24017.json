			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yves"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240170101,
					"content": "Fiuh ... benar-benar sial ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170102,
						240170103
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170102,
					"content": "Kamu penyelam?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170104
					]
				},
				{
					"id": 240170104,
					"content": "Iya. Eh, kan memang kelihatan kali aku pakai pakaian selam? Gimana, ada yang bisa dibantu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170105
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170105,
					"content": "Maaf ya, kamu kurang beruntung nih. Aku tidak akan menyelam di mana pun ... untuk sementara ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170106
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170106,
					"content": "Perairan di sini rumitnya minta ampun. Kalau terlalu dalam, arusnya bahaya. Terus sampah dan rumput lautnya banyak, kaki bisa tersangkut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170107
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170107,
					"content": "Lengah sedikit saja langsung ada pecahan logam yang merobek baju selam, bocor deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170108
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170108,
					"content": "Untungnya aku tidak jauh dari tepian, tapi tetap urusannya hidup dan mati waktu berenang sampai darat itu. Baju selam rusak, tapi untungnya kaki ini masih baik-baik saja ... aku tak ada uang buat ke dokter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170109
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170109,
					"content": "Tapi sekarang kerjaan dari Goldman tidak bisa dibereskan, malah mungkin aku harus ganti rugi ke si pelit itu. Sial banget kan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170110,
						240170112
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170110,
					"content": "Yang penting nyawa belum melayang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170111
					]
				},
				{
					"id": 240170111,
					"content": "Menghibur ya ceritanya ... betul sih, memang. Sayangnya selain tubuh yang sehat, aku tidak punya apa-apa lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170116
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170116,
					"content": "Ah, aku saat ini tidak bisa bantu apa-apa buat kamu. Harus betulin baju selam dan bersihin sampah bawah air buat si Goldman ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170117,
						240170118
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170117,
					"content": "Aku deh yang bantu kamu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170119
					]
				},
				{
					"id": 240170119,
					"content": "Terima kasih, tapi menyelam bukan perkara sederhana yang semua orang bisa. Dan aku tidak bisa bayar juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170120,
						240170121
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170120,
					"content": "Aku bisa nyelam eh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170122
					]
				},
				{
					"id": 240170122,
					"content": "Baiklah, baiklah. Lubangnya memang kebesaran untukku perbaiki secara langsung. Kalau begitu, aku mengandalkan bantuanmu ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170127
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170127,
					"content": "Kamu orang baik, pasti banyak yang suka padamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170123
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170123,
					"content": "Si serakah kurang ajar Goldman selalu suruh kami kerja yang paling kasar. Kalau bukan di air dalam, barang yang dia incar adanya di bawah tanah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170128
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170128,
					"content": "Sini, aku tandai lokasinya satu per satu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170124
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170124,
					"content": "Baiklah, aku sudah tandai lokasinya. Tolong ya ... Baju selamnya rusak parah, harus habis berapa ini betulinnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170121,
					"content": "Tenang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170122
					]
				},
				{
					"id": 240170118,
					"content": "Aku saja yang kerjain.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170119
					]
				},
				{
					"id": 240170112,
					"content": "Goldman siapa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170113
					]
				},
				{
					"id": 240170113,
					"content": "Dia? Bosku lah. Jagonya merekrut orang yang tidak punya kemampuan, tapi mengandalkan otot untuk cari nafkah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170114
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170114,
					"content": "Otaknya isinya Fonta! Keras dan pelit bukan main. Dia paksa kami kerja ikut aturan sebuku tebal ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170125
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170125,
					"content": "Bahkan, baju selam yang kita pakai tuh, kita harus \"sewa\" dari dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170115
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170115,
					"content": "Kalau barang yang kita ambil rusak, kita malah harus bayar dia ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170126
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170126,
					"content": "Artinya, ceroboh sedikit saja aku harus bayar uang \"sewa\", sambil bersujud biar tidak dipecat! Cuah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170116
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170103,
					"content": "Baru beres nyelam?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170104
					]
				}
			]
		},
		{
			"id": 2401702,
			"completionStepIds": [
				2401701
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
