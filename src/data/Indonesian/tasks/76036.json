						760360103,
						760360104
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760360103,
					"content": "Columbina?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760360105
					]
				},
				{
					"id": 760360105,
					"content": "Hmm? Oh, ternyata kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360106
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760360106,
					"content": "Bisa tolong bantu aku? Tenang, aku pasti balas budi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360107
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760360107,
					"content": "Uh ... kebiasaan kayak gitu sudah bisa dibuang belum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360108,
						760360109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360108,
					"content": "Kamu sudah banyak bantu kami juga kok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760360110
					]
				},
				{
					"id": 760360110,
					"content": "Iya, enggak usah ngomong balas budi-balas budi, kami pasti bantu kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360111,
					"content": "Jadi mau minta tolong apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360112,
					"content": "Ah ... dia sih yang perlu bantuan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360113
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760360113,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360114
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760360114,
					"content": "Kuuhenki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360115,
					"content": "Anak ini entah dapat kuas dari mana, lalu dia bersemangat dan mengayunkannya di sekelilingku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360116
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760360116,
					"content": "Aku sudah carikan kanvas dan cat, tapi setelah melukis cukup lama, dia masih tidak bisa mencampur warna yang diinginkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360117
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760360117,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360118
					],
					"speakerTitle": "Luonnotar"
				},
				{
