					"nextDialogs": [
						760360348
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360348,
					"content": "Enak ya sesajiannya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760360349
					]
				},
				{
