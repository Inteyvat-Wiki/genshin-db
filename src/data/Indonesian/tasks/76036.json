					"nextDialogs": [
						760360345
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760360345,
					"content": "Wah, dia makan semua sesajiannya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360346
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360346,
					"content": "Harusnya ... tidak boleh ya?",
