				{
					"id": 760360329,
					"content": "Kayak ... Columbina pas baru lahir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360330
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360330,
					"content": "Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360331
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760360331,
					"content": "Paimon ingat Lauma pernah bilang kalau hari kelahiranmu dicatat sama Bani Bulan Embun ... tapi gambar ini agak beda deh sama keterangan dari sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360332,
						760360333
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360332,
					"content": "Kuuhenki ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760360334
					]
				},
				{
					"id": 760360334,
					"content": "Si kecil ini ... Maalaus, dia salah satu Kuuhenki pertama yang lahir ke dunia. Mungkin dia menggabungkan berbagai pemahaman dan sudut pandang untuk memvisualisasikan keadaan saat itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360335
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760360335,
					"content": "Maalaus lagi berusaha ngenalin dewi pujaan hatinya ke kami. Gitu ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360336
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360336,
					"content": "~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360337
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760360337,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360338
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760360338,
					"content": "Maalaus tenang saja, kami bakal akur terus sama Columbina! Janji.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360339
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360339,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360340
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760360340,
					"content": "Wah, sudah bikin yang baru lagi? Cepat amat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360341
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360341,
					"content": "...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360342
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760360342,
					"content": "Ini ... Bani Bulan Embun yang memuja Columbina sebagai dewi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360343
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360343,
					"content": "Hmm? Columbina lagi apa itu di altarnya? Aduh, kecil banget, enggak jelas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360344
					],
					"speakerTitle": "Paimon"
				},
