						760360324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360324,
					"content": "Paimon kira bakalan kayak corat-coret anak kecil ... atau ... kayak bikinannya Melusine gitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360325,
					"content": "Kuuhenki sangat pandai merasakan sekelilingnya, dan ketika menciptakan ulang apa yang pernah mereka lihat, mereka akan menuangkannya sama persis dengan apa yang dirasakan.",
					"roleType": "TALK_ROLE_NPC",
