						760360304
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760360304,
					"content": "Paimon enggak nyangka Kuuhenki juga bisa melukis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360305,
					"content": "Sebenarnya mereka sama seperti kita, memiliki sifat dan hobi masing-masing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360306
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760360306,
					"content": "Sebentar ... kamu bisa bedain semua Kuuhenki di Nod-Krai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360307,
					"content": "Kalau yang sudah kenal, bisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360308
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760360308,
					"content": "Kok ... keren sih! Soalnya selain Luonnotar, Kuuhenki yang lain bentukannya sama semua ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360309,
					"content": "Si kecil yang suka melukis ini siapa namanya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360310,
					"content": "Nama ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360311
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760360311,
					"content": "Kamu ... enggak namain mereka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360312,
					"content": "Aku kenal mereka, dan mereka kenal aku. Tidak perlu memberi nama ... aku sendiri pun tidak punya nama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360313
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760360313,
					"content": "Eh, yang kayak gitu malah dipertahanin! Jangan dong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360314,
					"content": "Hmm, kalau gitu ... \"Luonnotar\" kan artinya \"makhluk yang lahir dari berkat Dewi Bulan\" ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360315,
					"content": "Kalau \"lukisan\", bahasa Bani Bulan Embun-nya apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360316,
					"content": "Kalau tidak salah ... Maa ... naus? Maalaus? Ya. Maalaus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360317
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760360317,
					"content": "Oh, cakep tuh! Oke, kita kasih dia nama itu.",
