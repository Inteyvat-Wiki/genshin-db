			"dialogs": [
				{
					"id": 740990101,
					"content": "Tentang pengalamanmu pancing ikan tapi malah kepancing monster ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740990102
					]
				},
				{
					"id": 740990102,
					"content": "Oh! Setelah dipikir-pikir ... kejadiannya unik juga ya, umpannya malah narik perhatian monster dan bukan ikan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740990103
					],
					"speakerTitle": "Delaroche"
				},
				{
					"id": 740990103,
					"content": "Walaupun sebenarnya aku tidak takut-takut amat sama monster sih. Aku sudah terbiasa jalan sendirian dari Institut Penelitian Fontaine ke Court of Fontaine dan sebaliknya. Juga sudah berkali-kali menang lawan bandit di sepanjang jalan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740990104
					],
					"speakerTitle": "Delaroche"
				},
				{
					"id": 740990104,
					"content": "Sekarang aku kan direktur Asosiasi Memancing Fontaine, jadi sikapnya harus benar juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740990105
					],
					"speakerTitle": "Delaroche"
				},
				{
					"id": 740990105,
					"content": "Mau itu kagetin ikan atau ganggu orang-orang yang sedang memancing di sekitar, semuanya akan mencoreng reputasi direktur yang dipercaya orang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740990106
					],
					"speakerTitle": "Delaroche"
				},
				{
					"id": 740990106,
					"content": "Karena itu, aku harus menjaga sikapku dan selalu waspada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Delaroche"
				}
			]
