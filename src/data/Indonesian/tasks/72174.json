					"\"Boatman\""
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721740101,
					"content": "Sisi sungai sebelah sini, ya ... Ada pohon perak, ya ... dan rumput perak, ya ... batu pun perak, ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740102,
						721740103
					],
					"speakerTitle": "\"Boatman\""
				},
				{
					"id": 721740102,
					"content": "Permisi ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740104
					]
				},
				{
					"id": 721740104,
					"content": "Oh, ada tamu? Mau naik perahu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740105
					],
					"speakerTitle": "\"Boatman\""
				},
				{
					"id": 721740105,
					"content": "Wah, wah, wah, ternyata orang dari luar sana ya? Tidak bisa ... tidak boleh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740106,
						721740107
					],
					"speakerTitle": "\"Boatman\""
				},
				{
					"id": 721740106,
					"content": "Tidak boleh ...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740108
					]
				},
				{
					"id": 721740108,
					"content": "Perahu perak hendak berlayar menuju rembulan, namun perahu ini bukan untuk dirimu ... Janganlah kamu naik ke perahu, janganlah kakimu menginjak geladaknya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740109
					],
					"speakerTitle": "\"Boatman\""
				},
				{
					"id": 721740109,
					"content": "Wah, wah, wah ... Kabut telah menyebar, telah lama menyebar ... Siapa gerangan yang belum naik ke perahu? Sang empunya rumah emas akan marah, sangat marah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740110
					],
					"speakerTitle": "\"Boatman\""
				},
				{
					"id": 721740110,
					"content": "Perahu ...? Mana?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740111
					]
				},
				{
					"id": 721740111,
					"content": "Wah, wah, wah ... Perahu perak, milik sang surya, milik putra-putri gunung! Mereka semua kan kembali, semua harus kembali, ke rumah emas di atas bulan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740112
					],
					"speakerTitle": "\"Boatman\""
				},
				{
					"id": 721740112,
					"content": "Tetapi, oh tetapi ... Masih ada anak-anak yang tersesat, tersesat hingga kini, hingga kini belum naik perahu ... Sang empunya rumah emas pasti marah, sangat, sangat marah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740113,
						721740114
					],
					"speakerTitle": "\"Boatman\""
				},
				{
					"id": 721740113,
					"content": "Apa kamu butuh bantuan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740115
					]
				},
				{
					"id": 721740115,
					"content": "Kemarilah, kemarilah! Naiklah ke perahu, ke atas perahu ... Sudahi perjalanan, tak perlu lagi tersesat, tiada lagi perkabungan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"Boatman\""
				},
				{
					"id": 721740114,
					"content": "Kamu dengar aku tidak?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740115
					]
				},
				{
					"id": 721740107,
					"content": "Apa maksudmu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740108
					]
				},
				{
					"id": 721740103,
					"content": "Kamu siapa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740104
					]
				}
			]
		},
