			"dialogs": [
				{
					"id": 752460384,
					"content": "#Sebagai yang paling tua, {M#Kakek}{F#Nenek} duluan saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460385
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460385,
					"content": "Dengan senang hati.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460301
					]
				},
				{
					"id": 752460301,
					"content": "#Wah, lombanya jadi seru begini! Jurus sakti {NICKNAME} sudah keluar ... dan umpannya langsung kegigit! {NICKNAME} pun mengulur benangnya dan yang didapatkannya adalah ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460302,
					"content": "Emmm ... seekor ... Asha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460303,
					"content": "Wah, tangkapan yang tidak terduga ya. Entah bagaimana kasih nilainya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460304
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460304,
					"content": "#{M#Kakek}{F#Nenek} memang hebat! Kita lihat dulu saja apa ada yang bisa dapat lebih unik lagi. Kalau tidak, kurasa ini sih juaranya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460305
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460305,
					"content": "Terima kasih, semuanya! Lawanku tangguh-tangguh, tapi sepertinya aku masih punya kesempatan. Semoga cucuku benar ya!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460306
					]
				},
				{
					"id": 752460306,
					"content": "#{NICKNAME} hebat! Dua peserta berikutnya bakal lebih tertekan nih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460307,
					"content": "Ifa, giliranmu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460308,
					"content": "Pasti bisa, bos! Ingat kerja samanya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460309
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460309,
					"content": "Maaf, Cacucu. Kali ini tidak bisa kerja sama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460310
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460310,
					"content": "Wuah, hati-hati, bos. Dapat sesuatu nih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460311,
						752460313
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460311,
					"content": "Ifa menarik pancingannya dengan sekuat tenaga. Sepertinya dia mendapatkan sesuatu yang besar ....",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752460312
					]
				},
				{
					"id": 752460312,
					"content": "Tapi ... tangkapannya juga mengejutkan.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 752460313,
					"content": "Hmmm, kayaknya Ifa mendapatkan seekor Koholasaurus .. yang sedang menarik Capybara? Sebenarnya ada apa ya ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460314,
					"content": "Hebat! Ifa memang paling disukai hewan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460315
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460315,
					"content": "Tunggu, ada yang aneh dengan ekor Koholasaurus-nya ... sepertinya terluka karena batu, lalu Capybara ini hanya mau bantu saja deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460316
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460316,
					"content": "Atau mungkin Capybara-nya mau makan ekornya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460317
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460317,
					"content": "Mana mungkin, bos. Cacucu, coba kamu tanyakan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460318
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460318,
					"content": "Siap, bos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460319
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460319,
					"content": "Nah, aku benar, kan? Tunggu, itu tidak penting sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460320,
						752460322
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460320,
					"content": "Ifa langsung memeriksa ekor Koholasaurus-nya. Untungnya hanya lecet biasa.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752460321
					]
				},
				{
					"id": 752460321,
					"content": "Setelah memberikan pertolongan pertama, Koholasaurus dan teman Capybara-nya pergi.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 752460322,
					"content": "Mereka jadi berteman deh. Sepertinya hari ini hari keberuntungan mereka juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460323
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460323,
					"content": "\"Juga\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460324
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460324,
					"content": "Oke, sekarang giliranku. Rasa-rasanya sih aku akan menang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460325
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460325,
					"content": "Ingat kerja samanya, bos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460326
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460326,
					"content": "Memang begitu ya caramu memberi semangat? Kamu belajar dari mana sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460327
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460327,
					"content": "Cacucu si pemandu sorak pemancing!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460328
					]
				},
				{
					"id": 752460328,
					"content": "\"Pemandu sorak pemancing\" kurang keren. Kita kan memperjuangkan sesuatu hal yang penting, jadi julukannya juga harus lebih hebo— Eh?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460329
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460329,
					"content": "Apa itu? Semuanya, minggir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460330
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460330,
					"content": "Oke, ini agak aneh ... tapi dapat Capybara lagi! Dan dia tadi menerjang ke arah kita! Bukannya katamu mereka ramah?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460331
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460331,
					"content": "Hmmm, dia juga pasti sedang memperjuangkan sesuatu, aku bisa merasakannya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460332
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460332,
					"content": "Atau ... mungkin tidak juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460333
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460333,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460334
					],
					"speakerTitle": "Capybara"
				},
				{
					"id": 752460334,
					"content": "Sepertinya dia sedang kesal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460335
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460335,
					"content": "Hei, teman kecilku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460336
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460336,
					"content": "...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460337
					],
					"speakerTitle": "Capybara"
				},
				{
					"id": 752460337,
					"content": "Haha! Keren bos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460338
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460338,
					"content": "E-Eh? Maksudnya Cacucu lagi coba tenangin dia apa gimana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460339
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460339,
					"content": "Dia lagi menghiburnya. Mungkin tidak terlihat, tapi Cacucu pandai sekali menenangkan emosi pasien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460340
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460340,
					"content": "Bahkan dengan ... kosakata-nya yang terbatas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460341
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460341,
					"content": "Kalau sedang bicara dengan Capybara, sepertinya kosakata bahasa manusia itu tidak penting deh, Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460342
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460342,
					"content": "Oh iya juga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460343
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460343,
					"content": "Dalam hal ini, kita percayakan saja pada Cacucu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460344
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460344,
					"content": "Lagi pula saat berkomunikasi, kurasa intonasi lebih penting daripada kata-katanya sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460345
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460345,
					"content": "Contohnya, \"halo\" itu artinya \"aku senang\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460346
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460346,
					"content": "Tapi \"halo\" ... artinya \"aku lagi capek\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460347
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460347,
					"content": "Dan \"halo!\" ... itu lagi marah, tandanya harus cepat kabur karena akan ada bahaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460348
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460348,
					"content": "Oke, Paimon enggak gitu ngerti, tapi iya aja deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460349
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460349,
					"content": "Aku jadi belajar hal baru. Terima kasih!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460350
					]
				},
				{
					"id": 752460350,
					"content": "Dengan senang hati! Itu cara yang kupakai untuk berkomunikasi dengan para Aphid.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460351
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460351,
					"content": "STAF Aphid ... ingat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460352
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460352,
					"content": "Tidak hanya para staf. Ada juga Aphid yang tidak mau bergabung jadi staf. Aku mengerti perasaan mereka kok, kuhormati pilihan mereka juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460353
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460353,
					"content": "Mungkin kamu bisa coba memahami perasaanku juga, bos? Aku sudah di ujung tanduk nih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460354
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460354,
					"content": "Oh, ya? Kukira kamu malah akan bangga. Coba lihat itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460355
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460355,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460356
					],
					"speakerTitle": "Capybara"
				},
				{
					"id": 752460356,
					"content": "Haha! Benar, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460357
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460357,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460358
					],
					"speakerTitle": "Capybara"
				},
				{
					"id": 752460358,
					"content": "Wow! Wow!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460359
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460359,
					"content": "Mereka berdua semangat sekali ngobrolnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460360
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460360,
					"content": "Oke, yah aku agak bangga sih, tapi ... Eh? Ororon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460361
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460361,
					"content": "Tenang, aku punya solusinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460362
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460362,
					"content": "Halo, Capybara King. Apa kamu mau makan sesuatu? Aku punya biskuit buatan Ifa nih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460363
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460363,
					"content": "Arrooo ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460364
					],
					"speakerTitle": "Capybara"
				},
				{
					"id": 752460364,
					"content": "Capybara King?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460365
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460365,
					"content": "Dimakan! Sepertinya dia senang deh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460366
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460366,
					"content": "Aduh! Aduh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460367
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460367,
					"content": "Kenapa kompetisi memancing kita jadi acara temu hewan begini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460368,
						752460369
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460368,
					"content": "Bagus juga, kan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460370
					]
				},
				{
					"id": 752460370,
					"content": "Iya sih, berarti Ororon ya pemenangnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460371
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460371,
					"content": "Karena dia berhasil memancing si ... Capybara King itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460372
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460372,
					"content": "Namanya cocok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460373
					]
				},
				{
					"id": 752460373,
					"content": "Setuju, Ororon saja yang menang. Kita tidak berhasil menangkap ikan juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460374
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460374,
					"content": "Haha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460375
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460375,
					"content": "Oke, berarti Aphimead-nya buatku ya! Tapi memang dari awal punyaku sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460376
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460376,
					"content": "Berarti kamu bisa simpan! Lumayan lah ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460377
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460377,
					"content": "Iya, lalu Capybara King itu memberikan kita sesuatu. Lihat, sepertinya hadiah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460378
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460378,
					"content": "\"Gift Egg\" dan sebuah gambar? Hmmm, lokasi di gambar ini terlihat familier ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460379
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460379,
					"content": "Apa maksudnya dia mau kita pergi ke sana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460380
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460380,
					"content": "Tidak ada salahnya dicoba.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460381
					]
				},
				{
					"id": 752460381,
					"content": "Iya, kalau lagi senggang kita coba ke sana saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460382
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460382,
					"content": "Mungkin ada barang bagus buat kita.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460383
					]
				},
				{
					"id": 752460383,
					"content": "Iya, siapa tahu. Tapi kita harus siap-siap juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460369,
					"content": "Lumayan seru, kan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460370
					]
				}
			]
		}
	]
}