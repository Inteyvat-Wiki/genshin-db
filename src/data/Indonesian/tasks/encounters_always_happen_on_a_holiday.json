			"dialogs": [
				{
					"id": 752460101,
					"content": "#{NICKNAME}, lihat! Ada orang di sana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460102,
					"content": "He? Kok kayak pernah lihat. Mereka ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460103
					]
				},
				{
					"id": 752460103,
					"content": "Ororon sama Ifa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460104,
					"content": "#Ah, aku tahu suara ini. {M#Kakek}{F#Nenek} dan Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460105
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460105,
					"content": "Bos! Bos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460106
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460106,
					"content": "Ternyata kalian ada di resor ini juga! Wah, sudah lama ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460107
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460107,
					"content": "Iya! Chasca sempat bilang kalau kalian kerja di sini. Tapi pas sekali tiba-tiba ketemu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460108,
					"content": "Iya, benar. Di sini suasananya enak ya? Kudengar semua orang suka tempat ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460109
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460109,
					"content": "Banget! Semoga tempat ini makin bagus lagi biar makin rame!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460110,
					"content": "Kalian berdua gimana? Kerjaan lancar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460111,
					"content": "Lumayan! Staf Saurian dan Aphid di sini semuanya sehat dan energik, jadi kami ada waktu luang untuk jalan-jalan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460112
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460112,
					"content": "STAF Aphid.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460113
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460113,
					"content": "Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460114
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460114,
					"content": "Para Aphid itu juga bagian dari staf, kamu lupa bilang tadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460115
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460115,
					"content": "Setuju, bos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460116
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460116,
					"content": "Ah, maaf. Tentu saja aku berterima kasih kepada semua staf-nya dan juga pada Tuan Ororon di sini. Dia merawat mereka semua dengan sangat baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460117
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460117,
					"content": "Kami datang lebih awal ke sini untuk memperjuangkan sesuatu yang penting. Itu saja sudah cukup untukku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460118
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460118,
					"content": "Ini pertama kalinya bosku dapat undangan resmi seperti ini. Jadi dia ... sangat bersemangat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460119
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460119,
					"content": "Antusias itu hal bagus kok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460120
					]
				},
				{
					"id": 752460120,
					"content": "#Ya, kan? {M#Kakek}{F#Nenek} juga bilang begitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460121
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460121,
					"content": "Setiap hari kita berkesempatan untuk memperjuangkan sesuatu yang penting. Aku belajar ini dari Cacucu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460122
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460122,
					"content": "Haha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460123
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460123,
					"content": "Tapi bukannya kamu cuma ... mancing ikan? Kenapa itu termasuk \"memperjuangkan hal penting\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460124,
					"content": "Hati-hati ngomongnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460125
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460125,
					"content": "Tentu saja penting, karena disarankan oleh temanku. Dia seorang petualang terkenal dari Mondstadt yang sangat beruntung. Kalau dia bilang berguna, aku pasti percaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460126
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460126,
					"content": "(Ah ... Bennett?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460127
					]
				},
				{
					"id": 752460127,
					"content": "Iya, si petualang itu putar ranting pohon lalu mengarah ke danau. Kalau kata Ororon, lebih baik mengikuti arah keberuntungan daripada membuatnya sendiri. Jadi kita memancing di sini deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460128
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460128,
					"content": "Oke, anggap saja semua itu masuk akal ... tapi danau ini isinya Capybara semua! Memangnya ada ikan di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460129,
					"content": "Tentu saja! Capybara ini hewan yang ramah kok. Lagi pula, Nenek bilang di mana ada air, memancinglah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460130
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460130,
					"content": "Ah, satu kata-kata mutiara lagi dari Nenek. Sama seperti \"di mana ada makanan, makanlah\" atau \"di mana ada lemon, buatlah jus lemon\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460131
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460131,
					"content": "#Benar sekali. Tapi kali ini kami yang memberikan lemon ke {M#Kakek}{F#Nenek} dan Paimon. Kalian sudah ada di sini, bagaimana kalau kita memancing sama-sama?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460132
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460132,
					"content": "Dan biar lebih seru ... siapa pun yang dapat ikan paling besar boleh minum Aphimead buatan Ororon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460133
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460133,
					"content": "Nah, begitu baru Paimon mau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460134,
					"content": "#Hehe, kalian lupa ya lagi ngomong sama siapa? Kami enggak pernah mundur dari tantangan, dan {NICKNAME} ini bukan orang biasa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460135,
						752460137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460135,
					"content": "Ayo langsung mulai, bos!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460136
					]
				},
				{
					"id": 752460136,
					"content": "Wah, langsung serius ya?! Ayo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460137,
					"content": "Ayo maju, \"cucu\"ku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460138
					]
				},
				{
					"id": 752460138,
					"content": "Oke, berarti yang menang dapat semuanya ya. Bukan hanya ikannya, tapi juga Aphimead-nya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ororon"
				}
			]
		},
