					"nextDialogs": [
						200700303
					]
				},
				{
					"id": 200700303,
					"content": "Apa kamu sudah mendapatkan kembali semua bunganya? Bagus sekali, ayo cepat perlihatkan padaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
