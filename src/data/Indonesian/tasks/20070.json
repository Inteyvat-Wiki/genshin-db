			"dialogs": [
				{
					"id": 200700201,
					"content": "Bagaimana bunganya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700202
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200700202,
					"content": "Maaf...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200700203
					]
				},
				{
					"id": 200700203,
					"content": "Eh? Ada apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700204
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200700204,
					"content": "Aku tidak sengaja merusak kotak dan bunganya ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200700205
					]
				},
				{
					"id": 200700205,
					"content": "Ru-rusak?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700206
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200700206,
					"content": "Uh... itu adalah bunga yang aku pilih secara khusus. Bunga yang bagus tidak mudah ditemukan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700207
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200700207,
					"content": "Apa Dragonspine itu benar-benar berbahaya? Sampai-sampai petualang seperti dirimu tidak bisa menaruh sekotak bunga di sana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700208
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200700208,
					"content": "Namun, terima kasih telah membantuku untuk tugas ini, ini untukmu, terimalah, aku akan lanjut merawat bunga di toko.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700209
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200700209,
					"content": "Ah, atau... mungkin aku akan mencoba lagi cara yang digunakan oleh Sara...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				}
			]
		},
