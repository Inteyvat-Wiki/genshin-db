			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zicheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250320601,
					"content": "Sudah balik? Fotonya sudah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320602
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320602,
					"content": "Sudah dong.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320603
					]
				},
				{
					"id": 250320603,
					"content": "Wah ... ini bagus-bagus banget! Jauh lebih bagus daripada asistenku. Dia harus jepret satu area bolak-balik buat dapat hasil yang bagus pas kami pergi survei dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320604
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320604,
					"content": "Kalau dulu kamu yang ikut, kayaknya tidak perlu ngerusak Kamera sampai sebanyak itu deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320605
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320605,
					"content": "Jadi semua foto ini bisa buat inspirasi puisi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320606
					]
				},
				{
					"id": 250320606,
					"content": "Harus ... nya? Kalau masih tetap tidak bisa, ya sudah. Jadikan kartu pos saja biar tidak mubazir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320607
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320607,
					"content": "Aku tulisin kata-kata salam di belakangnya, terus kirim ke Bagian Urusan Sipil. Kalau dikasih hadiah kayak gitu, tidak bakal ada yang banyak mulut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320608
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320608,
					"content": "EHEM, itu sudah jalan keluar terakhir ya. Sebelum itu, aku mau pikirin gimana cara tulis puisi yang baik dan benar sampai tidak kuat lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320609
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320609,
					"content": "Embusan ... gelora ... lima khazanah angin ... Duh, di Natlan total ada berapa suku sih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zicheng"
				}
			]
		},
