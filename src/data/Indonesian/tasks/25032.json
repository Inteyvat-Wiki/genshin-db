			},
			"dialogs": [
				{
					"id": 250321001,
					"content": "Oh iya! Katanya papan nama toko di suku Warga Mata Air tuh lain dari yang lain. Di sana ada toko yang namanya \"Djembe Studios\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250321002
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250321002,
					"content": "Tolong, tolong fotokan studio itu saat pagi ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zicheng"
				}
			]
		},
