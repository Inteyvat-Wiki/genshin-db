	"talks": [
		{
			"id": 2503201,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2503201",
							"2"
						],
						"stepId": 2503201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zicheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250320101,
					"content": "Hmm ... menguntai syair dari gambar, atau menggambar dari untaian syair ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320102
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320102,
					"content": "Dih, salah deh ... kalimatnya kurang pas ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320103,
						250320104
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320103,
					"content": "Ngomong apa sih?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320105
					]
				},
				{
					"id": 250320105,
					"content": "Oh, halo. Benar sekali. Aku sedang coba tulis puisi untuk menggambarkan pemandangan Natlan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320106
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320106,
					"content": "Tapi, jujur ya, pemandangan di sini dan Liyue beda banget. Aku juga tidak mengerti sejarah Natlan, jadi bingung mau mulai dari mana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320107
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320107,
					"content": "Lagian, aku kan bukan penyair yang pandai menyusun kata yang mengalir begitu. Bikin pantun jenaka juga garing terus ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320108
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320108,
					"content": "Duh, tapi sudah jauh-jauh ke sini tidak boleh pulang dengan tangan kosong. Nanti teman-teman di Bagian Urusan Sipil bakal bilang \"situ lagi cari inspirasi atau cuma berfantasi?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320109
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320109,
					"content": "Kamu kerja di Bagian Urusan Sipil?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320110
					]
				},
				{
					"id": 250320110,
					"content": "Pernah. Dulu aku dipekerjakan Bagian Urusan Sipil untuk survei tanah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320111
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320111,
					"content": "Namanya gitu, tapi kerjanya sih cuma bawa orang keliling Liyue untuk melihat perubahan pada air dan tanah, apa perlu ditambahkan atau dihilangkan dari peta, semacam itulah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320112
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320112,
					"content": "Sekali keliling capeknya minta ampun. Bahkan sepatuku entah sudah berapa yang jebol ... Makanya aku ambil cuti. Mending jalan-jalan karena ingin daripada karena disuruh, ya toh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320113
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320113,
					"content": "Masalahnya ... kayaknya pas pengajuan itu otakku kemasukan air. Aku tulis alasan cutinya \"hasrat untuk berpuisi tiba-tiba muncul, mau mencari inspirasi\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320114
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320114,
					"content": "Ternyata, HRD Bagian Urusan Sipil langsung setuju, dan alasanku dijawab kayak gini: \"semoga dewa puisi memalingkan wajahnya kepadamu\". Aku ... dikasih cuti setengah bulan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320115,
						250320117
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320115,
					"content": "Lah, bagus dong?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320116
					]
				},
				{
					"id": 250320116,
					"content": "Bagus? Iya, memang ... Masalahnya, sekarang alasan cutiku jadi konsumsi gibah orang-orang seantero Bagian Urusan Sipil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320119
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320119,
					"content": "*huff* Memang sih Natlan seru banget. Pemandangannya bagus-bagus. Makanannya juga enak. Banyak makhluk hidup unik dan menarik, terutama Saurian kecil yang lucu banget ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320120
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320120,
					"content": "Tapi, puisinya sebaris pun belum. Sama sekali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320121
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320121,
					"content": "Padahal sudah susah-susah pinjam Kamera buat cari inspirasi. Percuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320122
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320122,
					"content": "Kalau foto pemandangan sih aku masih okelah. Tapi kalau foto toko, orang, kerumunan ... kacau banget hasilnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320123,
						250320124
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320123,
					"content": "Mau dibantuin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320125
					]
				},
				{
					"id": 250320125,
					"content": "Oh? Serius? Terima kasih! Akhirnya ada orang yang mau bantu ... Baiklah! Inspirasi! Datanglah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320126
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320126,
					"content": "Hei, otak! Kerja. Mikir ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320124,
					"content": "Aku bisa kok foto-foto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320125
					]
				},
				{
					"id": 250320117,
					"content": "Dan apakah dewa puisi telah memalingkan wajahnya kepadamu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320118
					]
				},
				{
					"id": 250320118,
					"content": "Mana ada! Iya, cutinya dapat, asyik, oke, tapi sekarang orang-orang Bagian Urusan Sipil jadi tahu ALASANKU pergi ke Natlan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320119
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320104,
					"content": "Lagi nulis puisi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320105
					]
				}
			]
		},
		{
