			"dialogs": [
				{
					"id": 221130501,
					"content": "Selesai! Akhirnya tangga sudah diperbaiki. Bagaimana menurutmu? Hasil karyaku bagus bukan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130502
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130502,
					"content": "Dengan begini para tamu akan lebih leluasa bergerak. Hahaha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130503
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130503,
					"content": "Oh ya, ambillah ini sebagai ucapan terima kasihku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130504
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130504,
					"content": "Kamu bisa datang ke sini untuk minum teh atau makan kapan pun saja. Masakan koki kami sangat enak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
