					"nextDialogs": [
						221130303
					]
				},
				{
					"id": 221130303,
					"content": "Bagus sekali. *huff* Monster-monster ini sungguh merepotkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130304
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130304,
					"content": "Seharusnya jumlahnya sudah cukup. Terima kasih banyak! Aku akan memulai memperbaiki tangga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
