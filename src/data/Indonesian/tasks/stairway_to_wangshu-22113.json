						221130203
					]
				},
				{
					"id": 221130203,
					"content": "Ugh, bergegaslah. Kamu harus membawa Wooden Plank itu kembali agar aku bisa memulai perbaikan tangganya.",
					"roleType": "TALK_ROLE_NPC",
