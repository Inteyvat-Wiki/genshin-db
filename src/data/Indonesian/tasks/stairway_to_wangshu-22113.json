			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huai'an"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221130101,
					"content": "Jujur saja, masih ada masalah lain yang harus dibereskan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130102
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130102,
					"content": "Kamu masih memperbaiki tangga?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221130103
					]
				},
				{
					"id": 221130103,
					"content": "Ah! Kebetulan sekali kamu datang. Terima kasih atas bantuanmu waktu itu. Sekarang aku memerlukan bantuanmu lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130104
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130104,
					"content": "Kerusakan kali ini lebih parah dari yang sebelumnya dan sisa Wooden Plank tidak cukup. Aku sudah membelinya lagi dan mengutus salah satu pengangkut barang untuk mengambilnya, tapi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130105
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130105,
					"content": "Dia malah diserang oleh monster-monster. Dia melarikan diri dengan ketakutan sehingga Wooden Plank itu ditinggalkan di jalan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130106
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130106,
					"content": "Dia sangat ketakutan dan tidak berani kembali ke sana untuk mengambilnya. Untungnya aku berhasil memintanya menunjukkan lokasi di mana Wooden Plank itu ditinggalkan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130107
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130107,
					"content": "Aku telah memikirkannya cukup lama dan aku rasa hanya kamu yang bisa menolongku. Apakah kamu mau membantuku mengambil Wooden Plank itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130108,
						221130110
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130108,
					"content": "Baiklah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221130109
					]
				},
				{
					"id": 221130109,
					"content": "Bagus sekali. Aku akan menunggumu di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130110,
					"content": "Lubang ini sangat besar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221130111
					]
				},
				{
					"id": 221130111,
					"content": "Jangan merasa ngeri seperti itu... Lubang ini bukan disebabkan oleh monster. Kalaupun iya, hanya monster raksasa yang bisa menyebabkan lubang sebesar ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130112
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130112,
					"content": "Tidak, yang terjadi waktu itu adalah... Ada dua tamu yang datang ke sini dengan jarak waktu yang berdekatan. Sepertinya ada permusuhan di antara mereka, karena tamu yang pertama mengejar yang kedua, dan yang kedua bersembunyi dari yang pertama... Untungnya mereka tidak berpapasan dengan satu sama lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130113
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130113,
					"content": "Kemudian kedua tamu ini memutuskan untuk bermalam di penginapan ini. Lalu saat naik tangga, mereka berpapasan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130114
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130114,
					"content": "Begitu mereka melihat satu sama lain, mereka langsung bertarung... Tangga ini bisa rusak parah karena pertarungan mereka. Butuh waktu lama bagiku untuk bisa memisahkan mereka berdua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130115
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130115,
					"content": "Aku sangat marah... Aku meminta mereka membayar uang ekstra sebanyak 3 hari sewa kamar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130116
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130116,
					"content": "Baik, gosipnya cukup sampai di sini saja! Cepatlah ambilkan Wooden Plank agar aku bisa segera memperbaiki tangganya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130117
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130117,
					"content": "Jika kejadian seperti ini terjadi lagi, aku tidak akan meminta bayaran ekstra lagi, tapi aku akan memaksa mereka memperbaiki kerusakannya saat itu juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				}
			]
		},
