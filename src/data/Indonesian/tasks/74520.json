				"points": []
			},
			"dialogs": [
				{
					"id": 745200401,
					"content": "#Oh, {NICKNAME}, tidak kusangka bisa bertemu denganmu di tempat seperti ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200402,
						745200403
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 745200402,
					"content": "Lama tidak bertemu, Eula.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200404
					]
				},
				{
					"id": 745200404,
					"content": "Bisa dibilang ini patroli rutin. Tapi bagiku, ini lebih seperti aktivitas penting untuk menjaga kesiapan tempurku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200405
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 745200405,
					"content": "Akhir-akhir ini Mondstadt cukup damai, hampir tidak ada ancaman yang memerlukan seluruh anggota Pasukan Gerilya untuk beraksi. Anggota timku sekarang ... jadi agak terlalu santai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200406
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 745200406,
					"content": "Tidak ada salahnya istirahat setelah bekerja keras.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200407
					]
				},
				{
					"id": 745200407,
					"content": "Meskipun begitu, sebagai Kapten, aku harus selalu menjaga kekuatan bertarungku sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200408
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 745200408,
					"content": "Lagi pula, pedang musuh tidak akan jadi tumpul hanya karena sedang damai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200409
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 745200409,
					"content": "Karena itu, aku biasa berlatih pedang di tempat sepi saat sedang patroli, agar gerakanku tidak jadi kaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200410,
						745200411
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 745200410,
					"content": "Kalau begitu kebetulan sekali ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200412
					]
				},
				{
					"id": 745200412,
					"content": "Oh? Permintaan yang menarik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200413
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 745200413,
					"content": "Tapi, gerakanku sangat cepat, memangnya Kamera-mu bisa mengikuti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200414,
						745200415
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 745200414,
					"content": "Gunakan saja kecepatanmu seperti biasa!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200416
					]
				},
				{
					"id": 745200416,
					"content": "Baik. Karena kamu sangat percaya diri, aku juga akan berusaha sebaik mungkin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200417
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 745200417,
					"content": "Lihat baik-baik ya, momen ombak bergulung itu akan hilang dalam sekejap mata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Eula"
				},
				{
					"id": 745200415,
					"content": "Biar aku yang menyesuaikan, aman!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200416
					]
				},
				{
					"id": 745200411,
					"content": "Izinkan aku mengambil fotomu ya!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200412
					]
				},
				{
					"id": 745200403,
					"content": "Kamu sedang tugas ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200404
					]
				}
			]
		}
	]
