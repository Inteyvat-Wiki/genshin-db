			"dialogs": [
				{
					"id": 715070101,
					"content": "Hasilnya lebih baik dari perkiraan! Semua kejadian sudah dicatat, dan data yang berhasil dikumpulkan juga cukup ....",
					"roleType": "TALK_ROLE_NPC",
