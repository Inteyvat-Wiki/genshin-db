			"dialogs": [
				{
					"id": 760440101,
					"content": "Ada buronan berhadiah yang sulit banget di The Flagship, karena enggak ada petunjuk sama sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440102
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440102,
					"content": "Baru-baru ini si buron menyerang orang di sebelah utara Pulau Lempo, tapi lalu menghilang tanpa jejak. Enggak ada yang tahu ke mana perginya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440103
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440103,
					"content": "\"Tak ada jejak yang tak tergeletak\". Mau ditutupi seperti apa pun, setiap tindakan pasti akan meninggalkan jejak, termasuk ketika berusaha menutupi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440104
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 760440104,
					"content": "Tidak ada informasi lain tentang buronan tersebut, bukan berarti yang memasang pengumuman tidak punya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440105
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 760440105,
					"content": "Benar juga yah ... aku tanya Leszek deh. Harusnya bisa dong dapat sesuatu dari dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440106
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440106,
					"content": "Kalau begitu kuserahkan ini padamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440107
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 760440107,
					"content": "Siap, Bos Nef!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jahoda"
				}
			]
		},
