			"dialogs": [
				{
					"id": 760440301,
					"content": "Hmm, kayaknya kemarin banyak banget buronan yang dipajang di sini. Tapi sekarang sudah tinggal satu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440302
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440302,
					"content": "#Semuanya dikerjakan sama si {NICKNAME}, tapi bahkan dia pun belum bisa menangkap buronan terakhir ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440303
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 760440303,
					"content": "Yah, memangnya enggak ada petunjuk, kan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440304
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440304,
					"content": "Ah, tapi ... Hanya karena sesuatu enggak tertulis di papan pengumuman, bukan berarti hal itu enggak ada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440305
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440305,
					"content": "Sepertinya kamu tiba-tiba dapat inspirasi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440306
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 760440306,
					"content": "Aku mau ngobrol sama Leszek. Harusnya dengan pengalamanku selama ini, bisa deh dapat sesuatu dari dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440307
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440307,
					"content": "Kalau begitu kuserahkan ini padamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440308
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 760440308,
					"content": "Siap, Bos Nef!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jahoda"
				}
			]
		}
