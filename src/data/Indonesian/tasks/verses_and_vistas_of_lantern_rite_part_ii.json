			"dialogs": [
				{
					"id": 710331201,
					"content": "Hm? Ada perlu apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331202
					],
					"speakerTitle": "Nenek Ruoxin"
				},
				{
					"id": 710331202,
					"content": "Tentang pertandingan antara Qingzhou dan Vermeer...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331203
					]
				},
				{
					"id": 710331203,
					"content": "Ah maksudmu mereka berdua, tidak apa-apa, jika mereka bersedia bermain bersama anak-anak, itu saja sudah bagus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331204
					],
					"speakerTitle": "Nenek Ruoxin"
				},
				{
					"id": 710331204,
					"content": "Ini adalah hari raya yang besar, jadi suasananya harus meriah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331205
					],
					"speakerTitle": "Nenek Ruoxin"
				},
				{
					"id": 710331205,
					"content": "Tapi kamu, anak muda, demi kami kamu telah berlarian ke sana ke mari di Desa Qingce ini, kamu pasti lelah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331206,
						710331207
					],
					"speakerTitle": "Nenek Ruoxin"
				},
				{
					"id": 710331206,
					"content": "Tidak apa-apa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331208
					]
				},
				{
					"id": 710331208,
					"content": "Kamu adalah anak muda yang baik hati... ini terimalah untukmu, terima kasih banyak, dan nikmati festivalnya ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331209
					],
					"speakerTitle": "Nenek Ruoxin"
				},
				{
					"id": 710331209,
					"content": "Aku harap Festival Lantern Rite juga bisa meriah di sini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nenek Ruoxin"
				},
				{
					"id": 710331207,
					"content": "Tidak perlu sungkan begitu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331208
					]
				}
			]
		},
		{
