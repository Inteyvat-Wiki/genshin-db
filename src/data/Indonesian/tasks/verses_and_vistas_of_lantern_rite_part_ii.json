				"objectNames": [
					"Vermeer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710330301,
					"content": "Ini Desa Qingce, lalu... di mana penyair itu? Apa dia pergi ke suatu tempat untuk mencari inspirasi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330302
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330302,
					"content": "Terakhir kali kulihat dia bermain teka-teki lentera dengan anak-anak...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330303
					]
				},
				{
					"id": 710330303,
					"content": "Te-tebak teka-teki? Apa tuh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330304
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330304,
					"content": "Apa dia mau menyerah karena tidak bisa menemukan inspirasi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330305
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330305,
					"content": "Ah sudahlah, tidak peduli apa pun yang dia lakukan, hanya ada beberapa hari lagi yang tersisa pada Festival Lantern Rite ini, ini sudah tidak bisa ditunda lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330306
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330306,
					"content": "Ayo kita cari penanggung jawab di sini untuk bertanya padanya. Hari ini juga harus bisa memutuskan pemenangnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vermeer"
				}
			]
		},
		{
			"id": 7103304,
			"completionStepIds": [
				7103304
			],
