			},
			"dialogs": [
				{
					"id": 710331001,
					"content": "Paman Qingzhou sudah kembali! Paman Qingzhou, apa paman sudah selesai menuliskan teka-tekinya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331002
					],
					"speakerTitle": "Little Liu"
				},
				{
					"id": 710331002,
					"content": "Kali ini... aku pasti bisa menebaknya dengan benar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331003
					],
					"speakerTitle": "Little Zuo"
				},
				{
					"id": 710331003,
					"content": "Kali ini harus kupikirkan dengan baik...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331004
					],
					"speakerTitle": "Little You"
				},
				{
					"id": 710331004,
					"content": "Hahaha, aku sudah menuliskan teka-tekinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331005
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331005,
