			"trigger": {
				"objectNames": [
					"Vermeer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710330101,
					"content": "Pengembara, kemarilah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330102
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330102,
					"content": "Kamu adalah pelukis yang membuat janji dengan Qingzhou itu kan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330103
					]
				},
				{
					"id": 710330103,
					"content": "Benar, itu aku. Aku dan penyair itu sepakat untuk membuat sebuah karya yang bisa menyimpulkan keseluruhan dari Festival Lantern Rite ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330104
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330104,
					"content": "Kamu membantuku mengumpulkan bahan-bahannya terakhir kali, kamu pasti ingat kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330105,
						710330106
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330105,
					"content": "Aku masih ingat...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330107
					]
				},
				{
					"id": 710330107,
					"content": "Lukisanku... Oh, sebenarnya aku melukis banyak adegan, orang, bahkan hewan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330108
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330108,
					"content": "Aku yakin lukisan-lukisan ini secara akurat mengungkapkan apa yang ingin mereka ungkapkan, tapi tidak satu pun dari lukisan-lukisan ini bisa meringkas tentang Lantern Rite...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330109
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330109,
					"content": "Oh, aku tidak bisa makan dan tidur beberapa hari ini. Aku sudah kehabisan bahan melukis, sehingga aku masih belum melukisnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330110
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330110,
					"content": "Jadi, aku ingin mencari penyair itu dan melihat puisinya seperti apa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330111
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330111,
					"content": "Pengembara, apakah kamu tahu penyair itu pergi ke mana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330112
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330112,
					"content": "Dia pergi ke Desa Qingce.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330113
					]
				},
				{
					"id": 710330113,
					"content": "Desa Qingce? Kenapa dia pergi ke sana, apa mungkin dia menemukan inspirasinya di sana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330114
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330114,
					"content": "Pengembara, ayo cepat, kita pergi ke Desa Qingce sekarang untuk menemuinya! Mungkin aku juga bisa menemukan inspirasi di sana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330115
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330115,
					"content": "*uhuk* Singkatnya, ayo kita pergi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330106,
					"content": "Lukisanmu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330107
					]
				}
			]
		},
		{
			"id": 7103303,
			"completionStepIds": [
				7103303
