			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qingzhou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710331401,
					"content": "Anak-anak, lihatlah Lentera Xiao ini, ini adalah lentera yang sangat indah, ayo kalian tebak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331402
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331402,
					"content": "Aku mau melakukan sesuatu dulu dengan kakak ini, nanti kalau sudah selesai baru aku kembali lanjut main dengan kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331403
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331403,
					"content": "Eh, Paman Qingzhou mau apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331404
					],
					"speakerTitle": "Little Liu"
				},
				{
					"id": 710331404,
					"content": "Aku membuat sebuah janji dengan seorang pelukis, untuk membuat sebuah puisi terbaik lalu membandingkan dengan lukisan buatannya dan melihat siapa yang terbaik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331405
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331405,
					"content": "Oh, itu sudah pasti Paman Qingzhou yang menang. Dengan mempunyai begitu banyak teka-teki, itu sudah merupakan suatu hal yang bagus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331406
					],
					"speakerTitle": "Little Zuo"
				},
				{
					"id": 710331406,
					"content": "Benarkah, terima kasih atas pujianmu. Ini ambillah Lentera Xiao ini dan kembalilah ke Desa Qingce untuk menebaknya. Tidak aman berkeliaran di alam liar begini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331407
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331407,
					"content": "Paman tidak usah khawatir, kami sudah sangat mengenal daerah ini, kami bisa kembali sendiri, paman pergilah dan kalahkan pelukis itu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331408
					],
					"speakerTitle": "Little Zuo"
				},
				{
					"id": 710331408,
					"content": "Kalau begitu... Paman, setelah kamu menyelesaikan urusan dengan pelukis itu, cepat kembali kemari ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331409
					],
					"speakerTitle": "Little You"
				},
				{
					"id": 710331409,
					"content": "Tentu saja, tunggu aku menyelesaikan masalahku, aku pasti langsung kembali mencari kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331410,
						710331411
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331410,
					"content": "Ini memang puisi yang bagus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331411
					]
				},
				{
					"id": 710331411,
					"content": "Puisi ini bisa menang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331412
					]
				},
				{
					"id": 710331412,
					"content": "Eh, puisi apa ini, ini hanya teka-teki lentera biasa saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331413
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331413,
					"content": "Oke, ayo cari pelukis itu, dia pasti cemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
				}
			]
		},
