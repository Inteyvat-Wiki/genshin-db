				"objectNames": [
					"Qingzhou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710330501,
					"content": "Hahaha, kamu semakin jago ya. Kamu sudah mulai bisa menebak dengan lebih cepat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330502,
						710330503
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710330502,
					"content": "Vermeer sudah datang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330504
					]
				},
				{
					"id": 710330504,
					"content": "Vermeer... ah, pelukis itu, aku sudah menunggunya, dan ini memang waktunya untuk menepati janji itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330505
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710330505,
					"content": "Sangat disayangkan puisiku pada akhirnya tidak selesai, dan teka-teki dengan anak-anak ini juga belum sepenuhnya selesai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330506
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710330506,
					"content": "Haha, mungkin puisiku memang benar-benar terbatas... oh atau, kamu bisa saja membantuku untuk mencari inspirasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330507
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710330507,
					"content": "Hmm... Tidak bisa dikatakan sedang mencari inspirasi, ah sudahlah ayo jalan-jalan denganku saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330508
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710330508,
					"content": "Paman Qingzhou! Apa ini artinya kita tidak bisa bermain teka-teki lentera lagi? Aku masih ingin main...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330509
					],
					"speakerTitle": "Little Zuo"
				},
				{
					"id": 710330509,
					"content": "Paman Qingzhou, aku juga masih ingin main teka-teki lentera...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330510
					],
					"speakerTitle": "Little Liu"
				},
				{
					"id": 710330510,
					"content": "Ah, tapi aku masih ingin menebak beberapa teka-teki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330511
					],
					"speakerTitle": "Little You"
				},
				{
					"id": 710330511,
					"content": "Haha, tenang saja, tunggu aku dan kakak ini pergi berkeliling sebentar, nanti akan ada teka-teki baru saat kita kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330512
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710330512,
					"content": "Kembalilah dulu ke Desa Qingce, aku akan menemuimu di sana, bagaimana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330513
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710330513,
					"content": "Wow! Paman Qingzhou hebat sekali, bisa memikirkan banyak teka-teki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330514
					],
