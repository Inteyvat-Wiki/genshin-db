					"Nenek Ruoxin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710330401,
					"content": "Oh, halo Pengembara, terima kasih banyak, berkat dirimu sekarang ini suasana di Desa Qingce jadi lebih terasa seperti Festival Lantern Rite...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330402
					],
					"speakerTitle": "Nenek Ruoxin"
				},
				{
					"id": 710330402,
					"content": "Oh? Yang di sebelahmu ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330403
					],
					"speakerTitle": "Nenek Ruoxin"
				},
				{
					"id": 710330403,
					"content": "Ini pelukis yang datang untuk mencari Qingzhou.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330404
					]
				},
				{
					"id": 710330404,
					"content": "Oh, kamu di sini untuk mencari Tuan Qingzhou? Wah, kebetulan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330405
					],
					"speakerTitle": "Nenek Ruoxin"
				},
				{
					"id": 710330405,
					"content": "Ketika Nona Wang'ya pergi beberapa hari yang lalu, Tuan Qingzhou berkata dia akan tinggal di sini untuk sementara waktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330406
					],
					"speakerTitle": "Nenek Ruoxin"
				},
				{
					"id": 710330406,
					"content": "Sepertinya sekarang ini dia masih bermain teka-teki lentera dengan anak-anak, hm... jika aku tak salah ingat, dia sepertinya membawa anak-anak itu jalan-jalan ke luar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330407
					],
					"speakerTitle": "Nenek Ruoxin"
				},
				{
					"id": 710330407,
					"content": "Jika kamu ingin mencarinya, mungkin kamu bisa pergi ke luar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330408
					],
					"speakerTitle": "Nenek Ruoxin"
				},
				{
					"id": 710330408,
					"content": "Dia benar-benar main teka-teki lentera... Pengembara, maaf merepotkanmu tolong bantu aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330409
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330409,
					"content": "Pergilah dan katakan pada penyair itu bahwa aku ada di sini, aku akan bersiap-siap dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330410
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330410,
					"content": "Bagaimana pun juga, hari ini harus diputuskan siapa pemenangnya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vermeer"
				}
			]
		},
		{
