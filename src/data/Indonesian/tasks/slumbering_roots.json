			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Arakunti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730170201,
					"content": "Oh! Akhirnya aku menemukanmu! Kamu Arakunti, bukan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170202,
					"content": "Bisa saja bukan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170203
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170203,
					"content": "Ehm? Apa maksudnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170204,
					"content": "Karena aku juga bisa jadi pohon, bisa jadi hujan, bisa jadi mimpi Vana, juga bisa jadi senar alat musik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170205
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170205,
					"content": "Oh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170206,
					"content": "#Paimon enggak ngerti deh kamu ngomong apa! {NICKNAME}, kamu ngerti enggak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170207,
						730170209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170207,
					"content": "Aku juga enggak tahu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170208
					]
				},
				{
					"id": 730170208,
					"content": "Rasanya tahu maksud dari setiap kata, tapi enggak tahu setelah digabungkan menjadi kalimat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170213,
					"content": "Kenapa Nara Emas dan benda kecil yang bisa terbang mencari Arakunti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170214
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170214,
					"content": "Paimon bukan \"benda kecil yang bisa terbang\"! Tunggu, Paimon sepertinya memang bisa terbang sih tapi ... Ah! Pokoknya, namaku Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170215,
					"content": "#\"Nara Emas\" juga ada nama sendiri, namanya {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170216,
					"content": "Arapandu yang kasih tahu kami, dia bilang Arakunti ada di Grove of Dreams, dan menyuruh kita datang buat lihat situasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170217,
					"content": "Paimon bisa kasih tahu Arapandu tentang Arakunti, Grove of Dreams baik-baik saja, mimpi yang lain juga baik-baik saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170218
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170218,
					"content": "#Oke ... {NICKNAME}. Kalau gitu, ayo kita kembali cari Arapandu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170219,
					"content": "Bukan! Kami datang ke sini buat betulin Varuna Contraption! Bahaya sekali, hampir saja terbujuk ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170220,
					"content": "Paimon bisa beri tahu Arapandu, kalau Arakunti enggak mau bujuk Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170221
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170221,
					"content": "Arapandu mungkin enggak mau tahu soal ini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170222
					]
				},
				{
					"id": 730170222,
					"content": "Paimon juga enggak mau tahu! Sebenarnya ada apa sih dengan Aranara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170223,
					"content": "Aku ingat Arapandu pernah bilang ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170224
					]
				},
				{
					"id": 730170224,
					"content": "Waktu Arapandu nyebut Arakunti, dia kan bilang kalau \"Arakunti lebih jauh dari Nara\" ... Apa itu artinya kalau dia enggak tahu caranya berkomunikasi sama orang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170225,
					"content": "Kita yang enggak tahu gimana cara berkomunikasi degan Aranara.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170226
					]
				},
				{
					"id": 730170226,
					"content": "Ah! Benar juga, \"mengikuti adat istiadat setempat\", seharusnya kita belajar gimana cara mereka komunikasi, ya kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170227,
					"content": "Tapi kalau sekarang dipikir-pikir, sebenarnya gimana cara komunikasi Aranara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170228,
						730170230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170228,
					"content": "Bagaimana menurut benda kecil yang bisa terbang?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170229
					]
				},
				{
					"id": 730170229,
					"content": "Nara Emas saja enggak tahu, gimana benda kecil yang bisa terbang bisa tahu? Lebih baik kita tanya pada Arakunti yang ajaib!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170233,
					"content": "Apa Arakunti bisa kasih tahu kita tentang gimana cara Aranara komunikasi? Kita juga mau belajar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170234,
					"content": "Kenapa mau belajar? Nara adalah Nara, Paimon adalah Paimon, Aranara adalah Aranara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170235
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170235,
					"content": "Ah, begitu ya. Paimon juga mau berubah jadi biji yang dikubur di tanah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170236
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170236,
					"content": "Iih!!! Enggak mau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170237
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170237,
					"content": "Apakah Nara Emas juga mau menjadi biji?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170238,
						730170240
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170238,
					"content": "Enggak deh, makasih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170239
					]
				},
				{
					"id": 730170239,
					"content": "Sayang sekali, padahal biji tumbuhan itu bagus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170242
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170242,
					"content": "Kita sudah lupa tujuan kita datang ke sini. Tujuannya buat Festival Utsava!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170243
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170243,
					"content": "Demi Festival Utsava, kita harus memperbaiki Varuna Contraption. Dengan begitu cuaca akan kembali normal dan enggak ada lagi spora yang menyebalkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170244
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170244,
					"content": "Paimon benar. Demi Festival Utsava, demi pusat dari tanah biru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170245
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170245,
					"content": "Hutan lembap Grove of Dreams itu bagus. Namun, \"spora\" enggak bagus, jamur yang bisa lari juga enggak bagus, terlalu banyak hujan, jamur jadi susah buat dimasak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170246
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170246,
					"content": "Oh! Kamu tahu sekali ya soal itu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170247
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170247,
					"content": "#Kita pergi memperbaiki Varuna Contraption, Nara {NICKNAME} dan Paimon harus pergi bersama Arakunti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170240,
					"content": "Kalau memang bisa sih boleh saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170241
					]
				},
				{
					"id": 730170241,
					"content": "Jangan sembarangan ngomong, nanti dianggap serius sama dia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170242
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170230,
					"content": "Oke, coba kita bandingkan dulu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170231
					]
				},
				{
					"id": 730170231,
					"content": "Paimon coba! Nara Emas seperti ... seperti ... ehm ... sama seperti Teyvat Fried Egg?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170232,
					"content": "Lebih baik kita bertanya pada Arakunti saja langsung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170209,
					"content": "Kurang lebih aku bisa tebak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170210
					]
				},
				{
					"id": 730170210,
					"content": "Hebat! Terus tadi maksudnya dia ngomong apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170211,
					"content": "Dia bilang dia bisa berubah bentuk menjadi benda yang lain.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170212
					]
				},
				{
					"id": 730170212,
					"content": "#Oh ya? {NICKNAME}, kamu enggak bohong kan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170213
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7301704,
