			},
			"dialogs": [
				{
					"id": 730170401,
					"content": "Akar pohon besar. Bagus, bisa mendengar napas yang lembap dan nada yang mengantuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170402
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170402,
					"content": "Huh ... Paimon enggak tahu apa yang Arakunti bilang, tapi ya sudahlah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170403,
					"content": "Omong-omong, ternyata di dalam ada tempat yang besar. Apa ini yang dinamakan \"akar kolot\"? Lagi pula, Paimon selalu merasa situasi di sini beda banget ya sama tempat yang lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170404,
					"content": "Apa kita perlu cari \"daun\" yang ngasih energi buat Varuna Contraption di tempat seperti ini ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170405,
					"content": "Ada di sini tapi enggak ada. Bisa dengar suaranya, cium napasnya, lihat pembuluh darahnya, tapi Paimon enggak bisa nemuin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170406
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170406,
					"content": "Ah? Apa yang terjadi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170407,
					"content": "Paimon saja enggak bisa nemuin, apalagi aku?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170408
					]
				},
				{
					"id": 730170408,
					"content": "Nara Emas bisa lihat melodi, seperti angin sejuk malam, rintik hujan yang menghancurkan mimpi permukaan danau menjadi ribuan keping.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170409
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170409,
					"content": "Kedengarannya hebat ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170410
					]
				},
				{
					"id": 730170410,
					"content": "#{NICKNAME} memang hebat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170411,
					"content": "Hehe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170412
					]
				},
				{
					"id": 730170412,
					"content": "#Hehe ... salah! {NICKNAME} kamu barusan ambil kata-kataku ya?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170413,
					"content": "#Nara {NICKNAME} berubah jadi Paimon ... itu lebih menakutkan dibandingkan dengan Marana yang menari dengan jamur ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170414
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170414,
					"content": "Enggak bisa membayangkan ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170415
					]
				},
				{
					"id": 730170415,
					"content": "Makanya hal seperti ini enggak akan terjadi! Paling bagus enggak terjadi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170416,
					"content": "Arakunti juga. Apa kamu bisa ngomong lebih jelas? Sebenarnya ke mana kita harus pergi buat cari \"daun\" dari Varuna Contraption?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170417,
					"content": "Cari di mimpi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170418
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170418,
					"content": "Oh ... Tunggu, kenapa kamu eggak bilang itu dari awal sih?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170419,
					"content": "Karena Paimon bertanya kenapa, enggak bertanya di mana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170420
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170420,
					"content": "Heh ... Rasanya Paimon tiba-tiba jadi paham gimana cara komunikasi para Aranara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170421,
					"content": "Apa Arakunti bisa kasih tahu di mana letak masing-masing dari ketiga \"daun\" yang ingin kita cari?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170422,
					"content": "Bisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170423
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170423,
					"content": "Wah, Arakunti benar-benar cuma jawab pertanyaan yang ditanyakan secara langsung ya ... Oke, jadi ketiga lokasi itu di mana saja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170424,
					"content": "Di sebelah sini, di sana dan di sebelah sana lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170425
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170425,
					"content": "Ehm ... tunggu, itu sih enggak menjelaskan apa pun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170426
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170426,
					"content": "Paimon, kalah total.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170427
					]
				},
				{
					"id": 730170427,
					"content": "#Kekalahan besar Paimon dan kegagalan besar {NICKNAME} itu hal yang sama! Perkataan Arakunti enggak bisa dipahami ... Gimana kita bisa menemukan ketiga tempat itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170428
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170428,
					"content": "Varuna Contraption dibuat oleh Aranara yang paling hebat, hubungan antara \"cabang\" dan \"daun\" enggak terlihat tapi juga terlihat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170429
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170429,
					"content": "#Nara {NICKNAME} bisa melihat Aranara, bisa melihat jejak Aranara, maka bisa menemukan arahnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170430
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170430,
					"content": "Wo-Wow! Paimon bisa ngerti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170431,
					"content": "Kalau kita ikuti jejak Aranara bakal bisa ketemu, kan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170432
					]
				},
				{
					"id": 730170432,
					"content": "Huhu ... seenggaknya kasih kesempatan buat Paimon jawab!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
