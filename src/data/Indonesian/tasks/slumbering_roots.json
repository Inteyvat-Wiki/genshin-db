			},
			"dialogs": [
				{
					"id": 730171201,
					"content": "Kami sudah kembali nih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730171202,
					"content": "Aku sudah dengar. Rengekannya sudah berubah menjadi nada yang merdu. Tapi kalau mau mengubahnya menjadi suara yang besar maka butuh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171203
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171203,
					"content": "Masih butuh bantuan Arakunti! Hehe, selanjutnya Paimon serahkan padamu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730171204,
					"content": "Iya Arakunti paham.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171205
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171205,
					"content": "Oh! Kalau gitu, enggak akan ada masalah, kan? Semoga kita bisa cepat-cepat betulin Varuna Contraption, kalau enggak Apam Woods bakal penuh sama spora ... mikirinnya saja sudah bikin Paimon ... Hachuuu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730171206,
					"content": "Paimon enggak percaya Aranara enggak merespon apa-apa ke spora ... apa jangan-jangan Aranara enggak bakal terpengaruh sama sekali?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730171207,
					"content": "Aranara bisa masak jamur, jadi tidak terpengaruh. Tapi spora terlalu kecil dan banyak, enggak bisa ditangkap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171208
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171208,
					"content": "Waktu Varuna Contraption enggak rusak, Vana enggak punya begitu banyak jamur. Jadi, semua akan membaik kalau kita memperbaiki Varuna Contraption. Kecuali Marana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171209
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171209,
					"content": "Pasti akan membaik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730171210
					]
				},
				{
					"id": 730171210,
					"content": "#Benar, Paimon dan {NICKNAME} juga bakal bantu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730171211,
					"content": "Kita juga pasti bakal bantu untuk menyelesaikan masalah soal Marana.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730171212
					]
				},
				{
					"id": 730171212,
					"content": "#Apa Nara {NICKNAME} adalah Nara Varuna?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171213
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171213,
					"content": "Eh? Kenapa tiba-tiba tanya begitu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730171214,
					"content": "Arapandu bilang Nara Varuna itu berwarna emas, Nara yang berani. Mereka bersama Aranara memperbaiki Varuna Contraption, dan mengusir hujan hitam dan lumpur, dan membawa kembali bulan dan bintang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171215
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171215,
					"content": "#Nara {NICKNAME} juga membantu Aranara memperbaiki Varuna Contraption, juga warna emas dan Nara yang berani, ya kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171216
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171216,
					"content": "Namun, bukankah Nara Varuna itu orang yang berasal dari zaman dulu ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730171217,
					"content": "#Jadi, Nara Varuna enggak kembali ke Vana? Nara {NICKNAME} adalah Nara yang berbeda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171218
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171218,
					"content": "Nara yang berbeda tapi apa punya melodi yang sama?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171219,
						730171220
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171219,
					"content": "Mungkin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730171221
					]
				},
				{
					"id": 730171221,
					"content": "Arakunti enggak pernah bertemu Nara Varuna. Tapi Arapandu banyak cerita tentang Nara Varuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171222
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171222,
					"content": "#Melodi miliknya pasti sama dengan Nara {NICKNAME}, kalau mendengarnya akan bahagia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171223
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171223,
					"content": "#Iya, Paimon selalu senang selama bareng {NICKNAME}! Kalau nanti {NICKNAME} ninggalin Paimon, kayak Nara Varuna ninggalin hutan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730171224,
					"content": "Huhu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730171225,
					"content": "#Arapandu pasti menunggu kita di \"tempat istirahat\". Nara {NICKNAME} ayo kembali bersama Arakunti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171226,
						730171228
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171226,
					"content": "Ayo kita berangkat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730171227
					]
				},
				{
					"id": 730171227,
					"content": "Iya, ayo kita kembali bersama!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730171228,
					"content": "Tapi aku masih ada urusan lain.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730171229
					]
				},
				{
					"id": 730171229,
					"content": "Oke, Arakunti bisa kembali sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171220,
					"content": "Aku tidak tahu ....",
