				"points": []
			},
			"dialogs": [
				{
					"id": 701430201,
					"content": "Halo, Pengembara. Sepertinya petualanganmu berjalan dengan lancar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430202
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 701430202,
					"content": "Cukup lancar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701430203
					]
				},
				{
					"id": 701430203,
					"content": "Bagus. Sebenarnya, aku selalu mengikuti perkembanganmu. Dan aku yakin jika kamu tetap mempertahankan performamu seperti ini, kamu pasti akan menjadi petualang yang luar biasa suatu hari nanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430204
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 701430204,
					"content": "Mengenai aktivitas Guild, aku punya beberapa informasi yang ingin kuberi tahu padamu jika kamu tertarik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430205
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 701430205,
					"content": "Komisi lain lagi untukku? Baiklah, coba kudengar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701430206
					]
				},
				{
					"id": 701430206,
					"content": "Haha, dari nadamu sepertinya kamu sudah tak asing lagi dengan cara Guild dalam menangani masalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430207
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 701430207,
					"content": "Namun, kali ini aku tidak punya komisi untukmu. Aku hanya punya beberapa informasi yang bisa kuceritakan padamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430208
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 701430208,
					"content": "Ini tentang Dragonspine, gunung bersalju di dekat Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430209
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 701430209,
					"content": "Guild sudah membangun kemah dan menempatkan beberapa petualang di sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430210
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 701430210,
					"content": "Aku sudah menandai lokasinya di petamu. Saat kamu tiba, cari saja petualang yang bernama Iris. Dia akan memberitahumu secara singkat mengenai situasi di area tersebut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430211
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 701430211,
					"content": "Itu saja dariku. Selamat bertualang, ad astra abyssosque!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				}
			]
		}
	]
