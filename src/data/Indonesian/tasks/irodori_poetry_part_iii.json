			},
			"dialogs": [
				{
					"id": 726930201,
					"content": "#{M#Tuan}{F#Nona}, apakah fotonya sudah ada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930202
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726930202,
					"content": "Nih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726930203
					]
				},
				{
					"id": 726930203,
					"content": "Terima kasih. Dengan ini, aku akan bisa menulis bait-bait yang memuaskan. Sekarang, waktunya berpikir ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930204
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726930204,
					"content": "#Ini tulisan yang kubuat berdasarkan foto yang {M#Tuan}{F#Nona} berikan. Silakan pilih yang mana yang paling disuka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ootomo"
				}
			]
		},
