				"points": []
			},
			"dialogs": [
				{
					"id": 726930101,
					"content": "#{M#Tuan}{F#Nona}, kamu sudah kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930102
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726930102,
					"content": "Tuan Lenne menulis tentang dirinya yang menyesali pertemuan kami yang tidak terjadi lebih awal, maka dari itu hari ini aku pun menulis satu bait untuknya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930103
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726930103,
					"content": "Betapa beruntungnya diri ini, bisa menerima hadiah dari Tuan Ootomo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930104
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726930104,
					"content": "Aku sudah tua, tapi karena bertemu dengan kawan-kawan dari Mondstadt beberapa hari belakangan ini, muncul suatu ketertarikan dalam diriku akan tempat itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930105
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726930105,
					"content": "Puisi ini kutulis mengikuti gaya para penyair Mondstadt, dan baris-barisnya menceritakan pemandangan yang ada di sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930106
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726930106,
					"content": "#Sayangnya, aku sendiri belum pernah berkunjung ke sana. Maukah {M#Tuan}{F#Nona} fotokan <color=#00E1FFFF>produk khas Mondstadt</color> untukku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930107
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726930107,
					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726930108
					]
				},
				{
					"id": 726930108,
					"content": "#Haha, tolong ya, {M#Tuan}{F#Nona}. Seperti hari kemarin, 4 foto saja sudah cukup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ootomo"
				}
			]
		},
		{
			"id": 7269302,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
