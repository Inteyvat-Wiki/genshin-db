			"trigger": {
				"objectNames": [
					"Lenne",
					"Ootomo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726930601,
					"content": "Puisi Tuan Ootomo menembus batasan yang ada di bentuk puisi Inazuma yang biasa, tapi tetap menggunakan gaya kuno untuk menggambarkan sekian banyak pengalaman tak terlupakan dalam hidup manusia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930602
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726930602,
					"content": "Mungkin inti dari puisinya adalah, walaupun gaya Mondstadt dan Inazuma jauh bertolak belakang, namun nilai estetikanya tetaplah memiliki kesamaan. Demikian pula halnya kami berdua yang berasal dari dua bangsa berbeda, namun dapat membina hubungan antar sesama penyair.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930603
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726930603,
					"content": "Tuan Lenne begitu tangkas memahami makna yang terkandung di balik puisi ini sedemikian cepatnya, dan di usianya yang sedemikian muda ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930604
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726930604,
					"content": "Aku sebagai seorang tua yang awalnya tidak percaya persahabatan lintas generasi, kini aku paham kalau itu keliru. Ini benar-benar merupakan sebuah kebenaran yang menggembirakan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930605
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726930605,
					"content": "#Demikian pula dirimu, {M#Tuan}{F#Nona} yang terpelajar. Percayalah kalau takdir yang sudah mempertemukan kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930606
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726930606,
					"content": "Setuju. Perjalanan ke Inazuma kali ini memang banyak rintangan, namun semuanya kini terbayar. Bahkan sekembalinya aku Mondstadt nanti pun, semua yang kualami di tanah Inazuma ini akan selalu kuingat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930607
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726930607,
					"content": "Terima kasih juga untuk semua foto yang kamu berikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930608
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726930608,
					"content": "Semoga suatu hari nanti kita bertiga akan dipertemukan kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930609
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726930609,
					"content": "Pasti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lenne"
				}
			]
		},
