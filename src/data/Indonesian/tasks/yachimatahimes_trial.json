			"dialogs": [
				{
					"id": 722690101,
					"content": "Aku adalah Eki dari Jibashiri. Pahlawan Sangonomiya aku mengakuimu sebagai orang yang layak untuk tantangan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722690102
					],
					"speakerTitle": "Eki"
				},
				{
					"id": 722690102,
					"content": "Aku bertanggung jawab untuk ujian \"pengamatan\". Maju dan selesaikan semua teka-teki yang ada, dan kembalikan Api Gerbang Tinggi ke posisinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722690103
					],
					"speakerTitle": "Eki"
				},
				{
					"id": 722690103,
					"content": "Medan perang selalu berubah. Hanya dengan menjaga mata dan membuka lebar telinga setiap saat, kamu baru bisa memahami situasi dan mengatasi setiap perubahan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722690103
					],
					"speakerTitle": "Eki"
				}
			]
		},
