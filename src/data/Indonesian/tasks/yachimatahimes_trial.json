			"dialogs": [
				{
					"id": 722690301,
					"content": "Luar biasa. Ujian pun berhasil kamu selesaikan dengan mudah. Aku, Jibashiri Eki, mengakui keberanianmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722690302
					],
					"speakerTitle": "Eki"
				},
				{
					"id": 722690302,
					"content": "Pengamatanmu bisa dikatakan cukup hebat untuk mencari belut yang sedang berhibernasi di musim dingin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722690303
					],
					"speakerTitle": "Eki"
				},
				{
					"id": 722690303,
					"content": "Apa maksudnya itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722690304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722690304,
					"content": "Saat berkembang biak, bibit unagi berukuran sangat kecil. Matamu harus tajam banget, baru bisa kelihatan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Eki"
