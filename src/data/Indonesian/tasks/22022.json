			"dialogs": [
				{
					"id": 220220301,
					"content": "Di Liyue ada hidangan terkenal bernama Tianshu Meat. Coba kulihat... ugh, ternyata benar, dicoret-coret lagi sama Xudong...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220302
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220302,
					"content": "“Kentangnya dikupas dan dikukus, dihaluskan selagi panas, campurkan minyak dan garam, tuang ke dalam mangkok, lalu dicampur dengan tepung untuk membuat kanji yang kental dan dituang ke atasnya. Rasanya empuk dan bertekstur seperti daging waktu dicicipi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220303
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220303,
					"content": "Waktu dicicipi... kalau dimakan terus akan ketahuan bedanya kan? Resep ini cuma berguna untuk membodohi mereka yang belum pernah mencoba Tianshu Meat yang sebenarnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220304
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220304,
					"content": "Sudahlah... Pengembara, aku mau tanya bahan-bahan untuk Tianshu Meat selain Raw Meat, Sugar dan Matsutake, masih butuh bahan apa lagi ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220305,
