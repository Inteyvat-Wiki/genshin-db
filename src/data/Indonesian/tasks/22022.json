					"Parvaneh"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220220101,
					"content": "Kombinasi resep ini harusnya lebih cocok seperti ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220102
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220102,
					"content": "Apa yang sedang kamu lakukan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220103
					]
				},
				{
					"id": 220220103,
					"content": "Aku sedang memilah-milah resepnya, tapi sepertinya aku tidak mengingatnya dengan benar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220104,
						220220106
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220104,
					"content": "Tanyakan saja pada Xudong.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220105
					]
				},
				{
					"id": 220220105,
					"content": "Xudong... alasan utama kenapa aku tidak bisa mengingat resep ini dengan baik justru karena \"makanan kreatif\" yang buat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220109
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220109,
					"content": "Setiap mendapat resep baru, paling dia cuma memasaknya sesuai resep satu dua kali saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220110
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220110,
					"content": "Setelah itu, dia akan mulai... \"mengubah\" resep itu dengan berbagai cara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220111,
						220220113
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220111,
					"content": "Kenapa begitu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220112
					]
				},
				{
					"id": 220220112,
					"content": "Kata dia sih supaya biaya bahannya jadi lebih murah... tapi aku juga tidak terlalu mengerti kenapa dia melakukannya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220118
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220118,
					"content": "Tapi bagaimanapun juga, kalau dilihat dari hasilnya, dia memang berhasil mengubah hidangan itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220119
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220119,
					"content": "Rasanya kurang lebih sama dengan hidangan aslinya, tapi dengan biaya produksi yang sangat rendah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220120
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220120,
					"content": "Alasan kenapa aku jadi rekan perjalanannya juga karena teknik memasaknya itu. Begitu pula dengannya, dia bersamaku karena dia bisa menghargai kemampuanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220121,
						220220123
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220121,
					"content": "Jadi, kamu butuh aku bantu apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220122
					]
				},
				{
					"id": 220220122,
					"content": "Ah, oh iya! Karena membicarakan Xudong, aku sampai lupa urusan yang sebenarnya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220128
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220128,
					"content": "Karena Xudong selalu mengubah resep dan dia juga coret-coret langsung di resep tersebut... beberapa resep itu jadi berantakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220129
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220129,
					"content": "Untuk mendapatkan referensi yang akurat, aku bermaksud memulihkan versi asli dari resep-resep itu dan menyimpan salinannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220130
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220130,
					"content": "Pengembara, kalau kamu ingat resep-resep itu, bisakah kamu membantuku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220131,
						220220132
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220131,
					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220133
					]
				},
				{
					"id": 220220133,
					"content": "Kalau begitu tolong ya, aku akan memilah-milah resep yang kacau balau ini dulu, terus kamu bisa bantu perjelas bagian yang kurang jelasnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220132,
					"content": "Aku sudah pernah mencoba berbagai hidangan di Teyvat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220133
					]
				},
				{
					"id": 220220123,
					"content": "Kemampuanmu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220124
					]
				},
				{
					"id": 220220124,
					"content": "Bukannya aku sudah bilang? Topik penelitianku di Akademiya adalah mengenai \"bumbu spesial\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220125
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220125,
					"content": "Sederhananya, ini adalah bumbu super yang bisa membuat sayur apa pun jadi terasa lezat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220126
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220126,
					"content": "Untuk meneliti bumbu seperti ini, aku pergi berkelana dan mengumpulkan informasi tentang berbagai jenis bahan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220127
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220127,
					"content": "Ehem, lagi-lagi keluar dari topik, lebih baik kita bahas soal resepnya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220128
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220113,
					"content": "Bagaimana cara dia mengubah resepnya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220114
					]
				},
				{
					"id": 220220114,
					"content": "Hmm... caranya mengubah resep berbeda dengan koki lainnya. Kebanyakan koki akan mengubah resep agar lebih bervariasi supaya makanannya bisa dijual dengan harga lebih mahal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220115
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220115,
					"content": "Tapi kalau Xudong yang mengubah resep-resep itu, sepertinya dia punya cara tersendiri untuk mengubahnya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220116
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220116,
					"content": "Misalnya saja dia pakai kentang... jamur... dan sayur-sayur murah lainnya untuk membuat hidangan sayur-sayuran, tapi waktu dimakan rasanya bisa seperti Jueyun Chili Chicken...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220117
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220117,
					"content": "Terus dia pakai Potato, Rice, Lotus Seed, Jueyun Chili, Flour dan Raw Meat untuk membuat Adeptus' Temptation versi sederhana yang rasanya kurang lebih sama dengan hidangan aslinya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220118
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220106,
					"content": "Bukannya kalian ini Gourmet Supremos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220107
					]
				},
				{
					"id": 220220107,
					"content": "Tolong jangan sebut-sebut nama itu lagi, aku sudah pasti tidak akan menuliskannya di skripsi milikku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220108
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220108,
					"content": "Lagi pula, alasan utama kenapa aku tidak bisa mengingat resep ini dengan baik justru karena \"bahan-bahan kreatif\" dari Xudong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220109
					],
					"speakerTitle": "Parvaneh"
				}
			]
		},
