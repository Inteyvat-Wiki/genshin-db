			"dialogs": [
				{
					"id": 220220201,
					"content": "Di Mondstadt ada hidangan yang bernama Northern Apple Stew, lagi-lagi Xudong mencoret-coretnya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220202
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220202,
					"content": "“Mentega cukup mahal dan daging sulit disimpan. Lebih baik membuat adonan dan membersihkan glutennya. Lalu glutennya dikukus dalam nampan, kemudian tambahkan bumbu buah dan sayuran untuk mendapatkan tekstur seperti daging.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220203
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220203,
					"content": "Dia ini, mentega kan tidak mahal, terus daging kan bisa langsung dibeli?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220204
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220204,
					"content": "Sudahlah... Pengembara, aku mau tanya bahan-bahan untuk Northern Apple Stew selain Apple, Butter dan Raw Meat, masih butuh bahan apa lagi ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220205,
						220220206,
						220220208,
						220220209
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220205,
					"content": "Almond.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220210
					]
				},
				{
					"id": 220220210,
					"content": "Umm... begitu ya? Biar kucatat dulu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220206,
					"content": "Pepper.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220207
					]
				},
				{
					"id": 220220207,
					"content": "Umm... begitu ya? Biar kucatat dulu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220208,
					"content": "Jueyun Chili.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220210
					]
