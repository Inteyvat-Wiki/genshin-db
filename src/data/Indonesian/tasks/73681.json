			"dialogs": [
				{
					"id": 736810101,
					"content": "Halo, Pengembara, Paimon. Aku dengar kalian mengikuti acara \"Gentong Berlimpah\". Bagaimana, menarik tidak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736810102
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 736810102,
					"content": "Asyik juga yah! Paimon enggak yakin apa itu karena ada pasar ini pas Weinlesefest, tapi kita dapat segala macam pernak-pernik dekorasi sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736810103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736810103,
					"content": "Haha, memang ada orang yang menyiapkan ini semua sebagai hadiah. Oh ya, karena kita sudah di toko makanan, mau tidak kalau dekorasi-dekorasi itu dipajang sebagian di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736810104
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 736810104,
					"content": "Mempercantik toko dapat membantu kami menarik lebih banyak pelanggan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736810105
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 736810105,
					"content": "Aku yakin orang yang memberi hadiah juga akan senang waktu melihat hadiah yang mereka berikan ternyata digunakan di tokomu, Pengembara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736810106
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 736810106,
					"content": "#Informasi yang menarik tuh! Kalau gitu ayo kita hias toko kita, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
