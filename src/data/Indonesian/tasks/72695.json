			"trigger": {
				"objectNames": [
					"Bertrand"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726950101,
					"content": "Bertrand!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726950102,
					"content": "#{NICKNAME} dan Paimon. Waktunya pas sekali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950103
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950103,
					"content": "Mesin Gede sudah selesai memproses material yang kalian kumpulkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950104
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950104,
					"content": "Terus hasilnya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726950105
					]
				},
				{
					"id": 726950105,
					"content": "Mesin ini buatanku loh! Jelas tidak ada kendala sama sekali. Teknik yang kupakai kan ditempa di Fontaine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950106
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950106,
					"content": "Dan tentunya, tidak ada bangsa lain yang lebih tahu tentang mekanika dan cara kerja alat-alat seperti ini selain kami, orang Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950107
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950107,
					"content": "Ledakan yang terjadi ketika proses produksi yang lalu itu disebabkan oleh ... ah, pengerjaan yang terburu-buru dan ketidakadaan sukarelawan yang mau membantu mengumpulkan bahan yang layak. Kali ini hasilnya pasti beda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950108
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950108,
					"content": "Kamu kepedean banget ya kayaknya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726950109,
					"content": "Kalau tetap meledak ... yah, artinya tabungan pensiun dan hidupku juga ikut jadi asap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950110
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950110,
					"content": "Jadi biarpun kamu tidak yakin padaku, yakinlah pada resolusi dan nyaliku untuk mempertaruhkan hidupku dalam kesempatan ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950111
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950111,
					"content": "Tahu enggak, Paimon sekali pun enggak pernah kebayang kalau urusan bikin mainan saja perlu resolusi selevel itu loh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726950112,
					"content": "Pokoknya, kita harus tetap lanjut ke tahap berikutnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950113
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950113,
					"content": "Demi keamanan, biar kukasih kalian satu pertanyaan: dari ketiga tahap dalam proses ini, yang baru saja kalian selesaikan adalah tahap \"Pengumpulan Bahan Baku\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950114
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950114,
					"content": "Nah, apa tahap berikutnya? Pengumpulan Inti atau Pengisian Daya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950115,
						726950118
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950115,
					"content": "Pengumpulan Inti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726950116
					]
				},
				{
					"id": 726950116,
					"content": "Selamat! Jawabannya salah. Kalau kamu benar-benar lakukan itu, artinya kamu punya andil besar ketika aku akhirnya bangkrut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950117
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950117,
					"content": "Jawaban yang benar adalah \"Pengisian Daya Elemen\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950121
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950121,
					"content": "Intinya, Pengisian Daya Elemen ini dilakukan dengan cara berada dalam pengaruh elemen ketika mengenakan Material Collector.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950122
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950122,
					"content": "Misalnya, dengan cara berdiri di tengah sungai agar terkena elemen Hydro sambil mengenakan Material Collector. Terus misalnya kalau mau kumpulkan elemen Electro ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950123
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950123,
					"content": "Harus kesambar geledek?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726950124,
					"content": "Eh, yah ... kalian ini kan \"petualang\" ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950125
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950125,
					"content": "Aku percaya tubuh petualang semuanya tahan banting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950126
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950126,
					"content": "Oh, begitu ya. Tahan banting.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726950127
					]
				},
				{
					"id": 726950127,
					"content": "Jujur ya, kurasa cara terbaik adalah berhubungan dengan makhluk elemen. Pada perjalananku di Inazuma yang sebelumnya, aku sempat menandai beberapa tempat yang sering disambangi makhluk elemen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950128
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950128,
					"content": "Aku tadinya mau jadi penumpang gelap di sebuah kapal dan langsung melakukan kontak dengan makhluk elemen di sana, kalau tidak ada bala bantuan yang datang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950129
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950129,
					"content": "Itu sih menantang maut namanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726950130,
					"content": "Yah, tapi kan sekarang ada kalian. Mau dong, coba ke sana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950131
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950131,
					"content": "Oke, sudah diputuskan ya. Urusan ini kuserahkan pada kalian!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950118,
					"content": "Pengisian Daya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726950119
					]
				},
				{
					"id": 726950119,
					"content": "Hampir betul. Kurang satu kata, \"elemen\". Jawaban yang benar adalah \"Pengisian Daya Elemen\". Gimana, tidak nyangka kalau aku bakal kasih kamu pilihan yang salah semua, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950120
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950120,
					"content": "Orang ini ketawanya asli bikin sebel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950121
					],
					"speakerTitle": "Paimon"
				}
			]
		},
