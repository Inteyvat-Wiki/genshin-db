			},
			"dialogs": [
				{
					"id": 726950201,
					"content": "Hmm ... Elemen yang berhasil tersimpan di dalam Material Collector harus segera dipindahkan ke mesin segera setelah didapatkan. Jadi satu siklus produksi perlu tiga kali jalan. Cukup sibuk juga ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950202
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950202,
					"content": "Biar aku pikirkan cara dulu untuk mengoptimalisasikan tahap ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bertrand"
				}
			]
		},
		{
			"id": 7269503,
			"completionStepIds": [
				7269503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
