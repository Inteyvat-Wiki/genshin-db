			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bertrand"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726950301,
					"content": "Bagaimana? Semua lancar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950302
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950302,
					"content": "Lancar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726950303
					]
				},
				{
					"id": 726950303,
					"content": "\"Alat Pengumpul Material\" ini adalah karya kebanggaanku. Entah mengumpulkan material seperti dulu atau menyimpan elemen seperti saat ini, semuanya bisa dia lakukan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950304
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950304,
					"content": "Sejujurnya, aku terpikir ingin kasih nama baru buat Material Collector itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950305
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950305,
					"content": "Eh, kalau kata Paimon sih namanya sudah oke ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950306,
						726950307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726950306,
					"content": "Setuju.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726950308
					]
				},
				{
					"id": 726950308,
					"content": "Masa? Aku sih merasa namanya belum cukup untuk menggambarkan kemampuannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950309
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950309,
					"content": "Ya sudahlah, tolong kembalikan Material Collector-nya. Seperti yang sudah-sudah, proses uji coba produksi perlu pengawasan, terutama karena sekarang kita berurusan dengan energi elemen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950310
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950310,
					"content": "Kita hanya bisa lanjut setelah reaksi elemen di dalam Mesin Gede sudah stabil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950311
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950311,
					"content": "Kalau sudah sampai sana, aku akan mengandalkan kalian lagi ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950307,
					"content": "Sudah cocok kok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726950308
					]
				}
			]
		}
	]
}