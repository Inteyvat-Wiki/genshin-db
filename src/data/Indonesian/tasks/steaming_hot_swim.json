						250250107
					]
				},
				{
					"id": 250250107,
					"content": "Eh? Kamu datang untuk berendam air panas? Maaf. Aku sedang bersihin kolam di sini dulu, kamu mungkin perlu tunggu sebentar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250250108
					],
					"speakerTitle": "Pele Nui"
				},
				{
					"id": 250250108,
					"content": "Dan, si kecil itu sama sekali tidak mau naik ke atas ... Aku kan masih harus bersihin banyak kolam nih ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250250109
					],
					"speakerTitle": "Pele Nui"
				},
				{
					"id": 250250109,
					"content": "Apa dia ngambek gara-gara aku gendong tempo hari? Ampun deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pele Nui"
				}
			]
