			"dialogs": [
				{
					"id": 100100301,
					"content": "Ada apa sih sama hal-hal aneh di sini? Kenapa ada banyak banget Hilichurl?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100302,
					"content": "Hmm, mungkin para Hilichurl yang membawa semuanya ini ke sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100303,
					"content": "Ohhhh, pasti di sini bakal ada \"timbangan\" yang dimaksud!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100304
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100304,
					"content": "Hampir benar sih, tapi di catatannya ditulis \"rintangan\", bukan \"timbangan\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100305,
					"content": "Dan apa pun yang kita cari seharusnya terkubur di balik semua \"rintangan\" ini ... Hmm, di sekitar sini ada petunjuk lain enggak ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100306,
					"content": "Apa enggak ada alat Dodo yang bisa ngebantu kita di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100307,
					"content": "Ummm ... enggak ada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100308
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100308,
					"content": "Terus, kita mesti ngapain dong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100309,
					"content": "Hmm ... Kata Mama kalau kita menghadapi masalah, kita harus coba selesaiin dulu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100310
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100310,
					"content": "Kalau begitu, ayo kita singkirkan rintangan-rintangan ini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100100311
					]
				},
				{
					"id": 100100311,
					"content": "Oke!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Klee"
				}
			]
		},
