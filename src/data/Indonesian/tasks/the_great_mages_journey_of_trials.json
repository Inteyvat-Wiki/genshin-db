					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100502,
					"content": "Dan kita enggak ngebakar hutannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100503,
					"content": "Klee udah hati-hati banget sama Jumpy Dumpty!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100504
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100504,
					"content": "Akhir-akhir ini Klee udah lebih jarang dihukum kurungan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100505
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100505,
					"content": "Mantap, Klee!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100506,
					"content": "Mungkin nanti bahkan kamu sudah enggak perlu lagi masuk-masuk ke ruang tahanan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100507,
					"content": "Yah, coba saja Master Jean kasih izin Klee buat ngeledakin ruang tahanan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100508
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100508,
					"content": "Bukan itu maksud Paimon ... Tunggu, gimana soal tugasnya? Kita dapat info baru enggak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100509,
					"content": "Yap! Aku nemuin ini di lubang hasil ledakan Jumpy Dumpty ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100510
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100510,
					"content": "Huh, ada catatan lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100511,
					"content": "Yup, dan ini tulisan Mama lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100512
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100512,
					"content": "\"Nah, Dodoco mungkin saja berhasil menghancurkan semua rintangannya, meskipun pendekatan yang paling langsung terkadang adalah yang paling elegan. Bagaimanapun juga, dengan demikian, Dodoco berhasil mencapai tahap kedua ujiannya ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100513,
					"content": "\"Yang sekaligus juga merupakan tahap terakhir. Anak-anak yang paling bersemangat pun perlu mengatur tenaganya. Jadi ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100514,
					"content": "\"Dodoco melanjutkan perjalanan ke tepi danau bintang jatuh, melewati ujian terakhir, dan mendapatkan hadiahnya. Tapi apakah semuanya benar-benar sesederhana itu ...?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100515,
					"content": "Huh, \"danau bintang jatuh\" ... Itu pasti Danau Starfell!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100516,
					"content": "Yuk kita cari tahu apa yang bisa kita temuin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100517,
					"content": "Ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100518
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100518,
					"content": "Paimon penasaran banget sama hadiahnya. Semoga dapat harta karun yang keren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
