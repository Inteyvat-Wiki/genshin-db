					"content": "Kalian berdua juga boleh ikut kalau mau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100834
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 100100834,
					"content": "Hehe, mau dong! Paimon udah lama ngidam makan Sweet Madame!",
