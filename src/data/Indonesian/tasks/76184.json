			"dialogs": [
				{
					"id": 761840301,
					"content": "Lumayan juga, pesta teh ini. Kalau tahu seasyik ini, aku pasti sudah ikut dari dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840302,
						761840303
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 761840302,
					"content": "(Ayo duduk seperti ini sebentar lagi.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761840304
					]
				},
				{
					"id": 761840304,
					"content": "Baiklah, sampai jumpa lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Childe"
				},
				{
					"id": 761840303,
					"content": "Sudah waktunya beres-beres.",
