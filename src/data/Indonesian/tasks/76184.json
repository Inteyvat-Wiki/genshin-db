			"dialogs": [
				{
					"id": 761840101,
					"content": "Wah, ini benar-benar di luar dugaan. Aku tidak pernah sangka akan ada masa di mana kamu undang aku ke pesta tehmu, Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840102
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 761840102,
					"content": "Mungkin kalau kamu bersikap lebih sopan sedikit, aku akan mengundangmu lebih cepat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840103
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761840103,
					"content": "Aku setuju. Dan lebih baik kalau kamu jangan selalu mengajak salah satu dari kita untuk duel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840104
					],
					"speakerTitle": "The Knave"
				},
				{
					"id": 761840104,
					"content": "Ucapanmu sama persis dengan kakak-kakakku. Aku sudah pasrah deh. Dulu waktu guruku melatihku di alam liar, etiket bukan hal yang penting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840105
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 761840105,
					"content": "Sudahlah. Jarang-jarang kita bisa kumpul seperti ini. Mari kita santai dan nikmati momen ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840106
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761840106,
					"content": "Hmm? Apa ini hasil karyamu yang terbaru?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840107
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 761840107,
					"content": "Namanya Fagio, singkatan dari \"Facilitateur Automatisé Généraliste Interactif et Omnitâche\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840108
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761840108,
					"content": "Apa ini artinya Pulonia benar-benar tidak bisa diperbaiki lagi ...? Aku turut berduka, Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840109
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 761840109,
					"content": "Tidak apa-apa kok, aku—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840110
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761840110,
					"content": "Sayang sekali aku belum sempat melawannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840111
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 761840111,
					"content": "Kan, sudah ketebak ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840112
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761840112,
					"content": "Pulonia terlihat kuat, tapi Fagio ini terlihat agak ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840113
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 761840113,
					"content": "Kamu mau bilang dia kelihatan lemah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840114
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761840114,
					"content": "Uhm ... Haha, enggak, enggak. Cuma saja dia enggak terlihat sekuat Pulonia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840115
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 761840115,
					"content": "Hmph, Pulonia dibuat untuk pengukuran dan perhitungan. Aku sengaja memastikan kemampuan tempurnya tidak sampai mengorbankan kemampuan pemrosesannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840116
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761840116,
					"content": "Tapi Fagio enggak perlu memproses rumus yang kompleks. Semua kemampuan komputasinya dapat difokuskan ke modul tempurnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840117
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761840117,
					"content": "Jadi ... itu berarti dia sebenarnya lebih kuat dari Pulonia? Serius?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840118
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 761840118,
					"content": "Kamu enggak akan puas kalau enggak dikasih demonstrasinya, ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840119
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761840119,
					"content": "Kutegaskan dulu ya, aku enggak akan bayar biaya perbaikannya kalau dia sampai rusak gara-gara aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840120
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 761840120,
					"content": "Dan aku enggak akan bayarin biaya rumah sakitmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840121
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761840121,
					"content": "(*huff* ... Sudah kuduga ini bakal terjadi.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840122
					],
					"speakerTitle": "The Knave"
				},
				{
					"id": 761840122,
					"content": "*Nyam nyam*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"The Damselette\""
				}
			]
		},
