			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10150301,
					"content": "Gede juga ya! Paimon jadi percaya kalau ini bikinan Adeptus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150302,
					"content": "Tapi ... gimana cara pakainya? Mesti sekuat apa coba orangnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150303,
					"content": "Hmm. Sekarang tidak bisa digunakan, karena sudah rusak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150304
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150304,
					"content": "Yah, sudah rusak katanya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150305,
					"content": "Setelah ribuan tahun dipakai dan berada di alam terbuka, bahkan perangkat karya Adeptus pun bisa rusak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150306
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150306,
					"content": "Jadi kita harus ngapain? Ayo dong Tuan Zhongli, pakai kebijaksanaan manusia kelas atas tak terbatas punyamu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150307,
					"content": "Ah, perkataanmu seolah-olah aku ini cuma sekadar ... benalu kelas atas, yang fungsinya hanya untuk mengutarakan pernyataan dan fakta-fakta tidak penting semata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150308
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150308,
					"content": "Biar kupikir dulu ... Ah, ada suku cadang yang disiapkan ketika Guizhong Ballista pertama dibangun, untuk berjaga-jaga apa bila ia rusak ketika dipakai bertempur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150309
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150309,
					"content": "Seharusnya ada gudang persediaan militer di Tianheng Pass.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150310
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150310,
					"content": "Kalau suku cadangnya bisa didapatkan, kita bisa memperbaiki alatnya. Cukup pahami baik-baik cara kerja dasarnya saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150311
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150311,
					"content": "Terus ... memangnya Tuan Zhongli tahu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150312,
					"content": "Sedikit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150313
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150313,
					"content": "Kalau ada, <color=#00E1FFFF>suku cadang</color>, setidaknya alat ini bisa kuotak-atik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				}
			]
		},
		{
			"id": 101506,
			"completionStepIds": [
				101515
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
