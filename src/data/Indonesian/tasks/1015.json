					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150943,
					"content": "Cocogoat itu binatang model apa sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150941,
					"content": "Astaga, susah juga.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150942
					]
				},
				{
					"id": 10150930,
					"content": "Kita dikerjain ....",
