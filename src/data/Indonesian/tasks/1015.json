					"nextDialogs": [
						10150940,
						10150941
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150940,
					"content": "Intinya, semuanya tidak tahu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150942
					]
				},
				{
					"id": 10150942,
					"content": "Kalau begitu baiklah. Kita bisa mulai dari daerah sekitar <color=#00E1FFFF>Guizhong Ballista</color>. Mungkin di sana ada petunjuk.",
					"roleType": "TALK_ROLE_NPC",
