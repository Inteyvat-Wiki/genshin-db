					"nextDialogs": [
						10150939
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150939,
					"content": "Bentuknya, tidak tahu. Ada di mana, tidak tahu. Dari mana asalnya, tidak tahu.",
