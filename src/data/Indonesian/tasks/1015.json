			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10150601,
					"content": "Ya, suku cadang ini seharusnya bisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150602
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150602,
					"content": "Sebentar ya. Aku coba perbaiki alatnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150603
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150603,
					"content": "Selesai. Struktur Guizhong Ballista ternyata lebih rumit dari yang kubayangkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150604
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150604,
					"content": "Wih, mantap! Terus sekarang gimana nyalainnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150605,
					"content": "Sederhana saja. Tinggal begini ... lalu lihat, bahkan ada teropongnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150617
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150617,
					"content": "Sebelah sini ... kosong. Sebelah sana ... tidak ada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150606,
					"content": "Hei! Sedang apa kalian!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150607
					],
					"speakerTitle": "Freckle Huang"
				},
				{
					"id": 10150607,
					"content": "Senjata berat itu ... kalian perbaiki? Buat apa? Apa tujuan kalian!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150608
					],
					"speakerTitle": "Freckle Huang"
				},
				{
					"id": 10150608,
					"content": "Ini bukan senjata berat sembarangan. Ini Guizhong Ballista. Lalu tahu aturanlah sedikit, perkenalkan diri sebelum bertanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150609
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150609,
					"content": "Orang tua, kau buta ya? Kami ini Treasure Hoarder!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150610
					],
					"speakerTitle": "Freckle Huang"
				},
				{
					"id": 10150610,
					"content": "Orang bilang di daerah sini penuh harta karun, tapi di sini tidak leluasa, karena ada alat ini yang terus saja mengawasi. Bentuknya doang yang kayak senjata berat biasa, tapi lagaknya sudah seperti punya pikiran sendiri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150611
					],
					"speakerTitle": "Freckle Huang"
				},
				{
					"id": 10150611,
					"content": "Waktu terakhir kali ke sini, salah satu anggota kami hampir saja jadi sate ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150612
					],
					"speakerTitle": "Freckle Huang"
				},
				{
					"id": 10150612,
					"content": "Lalu beberapa dari kami coba mematikan alatnya, dan hebatnya, berhasil. Lalu kami cuma meleng sedikit DAN TIBA-TIBA SAJA SUDAH ADA YANG MEMBETULKANNYA LAGI!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150613
					],
					"speakerTitle": "Freckle Huang"
				},
				{
					"id": 10150613,
					"content": "Memang harus dikasih tahu ya. Habis ini, kalian bisa betulkan muka kalian masing-masing sampai puas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150614
					],
					"speakerTitle": "Freckle Huang"
				},
				{
					"id": 10150614,
					"content": "Ck. Merusak warisan Adeptus demi keuntungan pribadi. Memalukan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150615
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150615,
					"content": "Kalianlah yang harus diberi pelajaran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150616
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150616,
					"content": "#Betul itu! {NICKNAME}, hantam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 101507,
			"completionStepIds": [
				101507
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101507",
							"2"
						],
						"stepId": 101507,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qiqi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10150701,
					"content": "Maaf, kami gagal memenuhi kewajiban pihak kami sesuai kontrak. Kami tidak dapat menemukan Cocogoat yang diinginkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150702
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150702,
					"content": "Ah, kecewa. Tidak apa, cuma kecewa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150703
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150703,
					"content": "Uhh ... kasihan Qiqi. Kok Paimon jadi enggak enak ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150704,
						10150705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150704,
					"content": "Qiqi punya petunjuk lain tidak?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150706
					]
				},
				{
					"id": 10150706,
					"content": "Susu Cocogoat enak. Sangat. Lebih enak dari susu kambing. Cuma hewan Adeptus yang bisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150707
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150707,
					"content": "Maaf. Ingatan Qiqi jelek. Namanya susu apa, lupa. Qiqi tulis, tapi lupa di mana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150708
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150708,
					"content": "Ah, ini. Namanya \"coconut milk (santan)\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150709
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150709,
					"content": "Ehh!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150710,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150711
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150711,
					"content": "Maafkan aku, kalian berdua. Aku langsung menyetujui kesepakatan yang terasa setimpal, tanpa mempertimbangkannya lebih lanjut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150712
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150712,
					"content": "Santai saja Zhongli, ada kan pepatah Liyue yang bilang \"Tidak ada yang tetap. Semuanya ... tidak bisa diprediksi\". Intinya, siapa juga yang tahu bakal begini jadinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150713,
					"content": "Maaf. Qiqi ... salah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150714
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150714,
					"content": "#Waduh. {NICKNAME}, urusan menghancurkan dunianya anak kecil, Paimon serahkan sama kamu ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150715,
						10150716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150715,
					"content": "Baiklah, jadi santan itu asalnya dari ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150717
					]
				},
				{
					"id": 10150717,
					"content": "Oh. Tidak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150718
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150718,
					"content": "Qiqi syok tuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150719,
						10150720
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150719,
					"content": "Dia perlu waktu sebentar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150721
					]
				},
				{
					"id": 10150721,
					"content": "Haha, jadi hari ini ada sesuatu yang dipelajari ya? Terima kasih sudah menjaga Qiqi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150722
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 10150722,
					"content": "Maaf, dengan siapa ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150723
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150723,
					"content": "Ah, maafkan ketidaksopananku. Namaku Baizhu, bos Bubu Pharmacy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150724
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 10150724,
					"content": "Paimon kira bosnya Qiqi, tapi ternyata malah orang aneh yang pakai kalung ular obat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150725
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150725,
					"content": "Parah. Si maskot cebol ini bahkan lebih linglung daripada Qiqi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150726
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 10150726,
					"content": "AHHH! Si obat .. si ular bisa ngomong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150727,
						10150728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150727,
					"content": "Ularnya bisa ngomong!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150729
					]
				},
				{
					"id": 10150729,
					"content": "Hsss!  Aku lebih suka diam, tahu. Tapi kalau ada orang asing, bicara lebih baik daripada disangka bahan obat yang kabur dari laci! Aku ini ular tulen, hidup, bernapas, berdesisss!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150730
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 10150730,
					"content": "Hahaha, Changsheng aslinya jinak kok, biarkan saja dia. Lalu kalian bertiga ... selain kekacauan dengan Qiqi tadi, apa ada yang kalian perlukan dari sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150731
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 10150731,
					"content": "Apa di sini jual Dupa Abadi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150732
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150732,
					"content": "Dupa Abadi? Ada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150733
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 10150733,
					"content": "Fiuh, akhirnya! Selesai juga urusan ini—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150734
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150734,
					"content": "Tiga juta Mora, kualitas paling baik, dijamin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150735,
						10150737
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 10150735,
					"content": "TIGA JUTA!?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150736
					]
				},
				{
					"id": 10150736,
					"content": "Rampok saja Golden House sekalian! Oh, tapi tempat itu sudah diambil alih Qixing ... di sana pasti lebih ketat pengamanannya sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150739
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150739,
					"content": "Hmm, tiga juta. Angka yang biasa saja ketika terdengar, namun mungkin agak sulit juga untuk diperoleh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150740
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150740,
					"content": "Mahalnya enggak kira-kira! Kami kapan bisa kekumpul uang segitu banyaknya! kalau Tuan Zhongli apalagi, uangnya masih kurang ... kurang tiga juta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150741
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150741,
					"content": "Ah, benar seperti itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150742
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150742,
					"content": "Mukanya tebal amat bos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150743
					]
				},
				{
					"id": 10150743,
					"content": "Gimana ini? Mungkin ini saatnya kita balik dan merengek sama Childe ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150744
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150744,
					"content": "HAHAHAHAHAHAHAHAHA!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150745
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10150745,
					"content": "Cocogoat! Cocogo ... astaga, aku sampai sakit perut nih ... kalian kok bisa-bisanya sih percaya begitu saja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150746
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10150746,
					"content": "WOI! Bukannya kasihan, malah ketawa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150747
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150747,
					"content": "Ah, aku ketawa sampai nangis nih ... Ah, terima kasih ya, sudah lama tidak terbahak-bahak kayak tadi. Sebagai gantinya, biar urusan kalian ini aku bereskan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150748
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10150748,
					"content": "Oke, dokter Baizhu? Suatu kehormatan bertemu denganmu, aku Childe, salah satu dari Fatui Harbinger. Maafkan kelancanganku, tapi aku bisa lihat ke depannya banyak peluang untuk kerja sama ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150749
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10150749,
					"content": "Kalau Bubu Pharmacy perlu pasokan buat ... yah, katakanlah santan, pihak Fatui bisa bantu membuatkan jalur distribusi yang cepat dan andal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150750
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10150750,
					"content": "Aneh ... Aku tahu Fatui memang suka menginvasi bisnis dengan cara memberikan tawaran yang menggoda, tapi ... kenapa santan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150751
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 10150751,
					"content": "Santan. Qiqi mau. Dokter Baizhu, cepat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150752
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150752,
					"content": "Ah ... baiklah Qiqi, baiklah. Apa pun buat kamu. Te-terima kasih, Tuan Childe. Semoga ke depannya kita masih bisa kerja sama. Biar kuberi harga spesial buat Dupa Abadi-nya ... jadi 2,990,000 Mora ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150753
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 10150753,
					"content": "Lah, dari tiga juta jadi 2,99 juta, apa bedanya coba?!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150754
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150754,
					"content": "Hmm ... 2,990,000. Angka yang biasa saja ketika terdengar, namun telah dikurangi sepuluh ribu dari total sebelumnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150755
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150755,
					"content": "Baiklah, semuanya sudah selesai. Kita harus ke Yujing Terrace. Sampai jumpa lagi Tuan Childe, dokter Baizhu, Nona Qiqi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150756
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150756,
					"content": "Benar-benar kelewatan lucunya, hahaha sudah lama tak tertawa sampai segininya. Kalian memang menarik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150757
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10150757,
					"content": "Nah, kalian sudah mendengarkan dari tadi kan. Apa yang kulewatkan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150758
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10150758,
					"content": "Lapor, Tuan Childe. Mereka bilang Golden House telah diambil alih oleh para Qixing ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150759
					],
					"speakerTitle": "Ekaterina"
				},
				{
					"id": 10150759,
					"content": "Begitu ya. Ningguang dan para Qixing ... Apa lagi yang mungkin mereka sembunyikan di Golden House ... kalau bukan Exuvia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150760
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10150760,
					"content": "#Maaf ya,{NICKNAME}. Tapi aku sudah memperingatkanmu kan dulu? Seperti kata pepatah Liyue: \"Dinding punya telinga\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Childe"
				},
				{
					"id": 10150737,
					"content": "Rampok saja Golden House sekalian!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150738
					]
				},
				{
					"id": 10150738,
					"content": "Sayang sekali, tapi tempat itu sudah diambil alih Qixing ... di sana pasti lebih ketat pengamanannya sekarang .",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150739
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150728,
					"content": "Ini Liyue, yang beginian juga sudah tidak aneh lagi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150729
					]
				},
				{
					"id": 10150720,
					"content": "Semua anak kecil akan dewasa pada waktunya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150721
					]
				},
				{
					"id": 10150716,
					"content": "Buahnya pohon kelapa, alias ... kelapa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150717
					]
				},
				{
					"id": 10150705,
					"content": "Cocogoat-nya mau buat apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150706
					]
				}
			]
		},
		{
			"id": 101509,
			"completionStepIds": [
				101509
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101509",
							"2"
						],
						"stepId": 101509,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qiqi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10150901,
					"content": "Oh, ada orang ya! Cuma dia kecil, tingginya enggak sampe meja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150902,
						10150904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150902,
					"content": "Dia ... zombie???",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150903
					]
				},
				{
					"id": 10150903,
					"content": "Paimon pikir ... kamu benar deh, tuh ada jimat di jidatnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150908
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150908,
					"content": "Selamat datang di Bubu Pharmacy. Aku Qiqi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150909
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150909,
					"content": "Qiqi pernah mati. Lalu ditolong Adeptus. Qiqi sekarang zombie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150910,
						10150911
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150910,
					"content": "Ini namanya mengungkapkan fakta luar biasa dengan cara yang sangat biasa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150912
					]
				},
				{
					"id": 10150912,
					"content": "Orang Mondstadt mana kebayang yang beginian ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150913,
					"content": "Ah ... gadis kecil. Di sini jual Dupa Abadi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150914
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150914,
					"content": "Maaf. Ada resep?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150915
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150915,
					"content": "Resep ...? Membeli Dupa Abadi apakah perlu? Barang ini bukan untuk tujuan pengobatan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150916
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150916,
					"content": "Qiqi bisa kasih obat kalau ada resep. Ini perintah Qiqi. Dari Qiqi sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150917,
						10150918
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150917,
					"content": "Perintah?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150920
					]
				},
				{
					"id": 10150920,
					"content": "Zombie perlu perintah untuk bertindak. Dan untuk gadis kecil ini, perintah itu berasal dari dirinya sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150921
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150921,
					"content": "Qiqi sayang, kami tidak ada resep. Tapi kami ingin beli Dupa Abadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150922
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150922,
					"content": "Baiklah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150923
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150923,
					"content": "Loh? Kok bisa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150924
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150924,
					"content": "Tapi. Kalian bantu Qiqi. Adil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150925
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150925,
					"content": "Sejak kapan ada cerita tamu mau belanja harus bantu dulu pegawai tokonya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150926
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150926,
					"content": "Sudahlah. Anggap saja ini pertukaran dua pihak. Semua menang. Di Liyue, seni pertukaran itu bisa dimenangkan lewat adu kekuatan mental.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150927
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150927,
					"content": "Ke Mt. Tianheng. Cari Guizhong Ballista. Cari Cocogoat. Terima kasih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150928,
						10150930
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150928,
					"content": "Maksudnya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150929
					]
				},
				{
					"id": 10150929,
					"content": "Guizhong Ballista ... Sepertinya aku pernah dengar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150932
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150932,
					"content": "Guizhong Ballista adalah sejenis senjata berat yang dipasang Adeptus di Mt. Tianheng, dulu sekali. Alat mekanika kuno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150933
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150933,
					"content": "Penempatannya di Tianheng Pass bertujuan untuk melindungi Liyue dari ancaman monster besar. Senjata ini akan secara otomatis menembak monster besar yang terdeteksi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150934
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150934,
					"content": "Tuan Zhongli memang tahu Liyue luar dalam ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150935
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150935,
					"content": "Dan sepertinya pernyataanmu barusan itu salah. Ini pertama kalinya aku mendengar kata \"Cocogoat\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150936
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150936,
					"content": "Cocogoat hewan legenda. Separuh Adeptus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150937
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150937,
