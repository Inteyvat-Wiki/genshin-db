					"Grace"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200680101,
					"content": "Hmm, apa yang harus kulakukan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680102
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680102,
					"content": "Eh, apa yang terjadi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680103
					]
				},
				{
					"id": 200680103,
					"content": "Kamu, kamu datang tepat waktu. Timmie sudah memberi tahu apa yang kamu lakukan pada bebek itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680104
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680104,
					"content": "Kamu.. kamu... Huh, bagaimana aku bisa menyapamu, aku sudah mendengar apa yang kamu lakukan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680105
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680105,
					"content": "Keberanian dan kekuatanmu... kenapa bisa digunakan di tempat seperti ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680106,
						200680107,
						200680108
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680106,
					"content": "Sejujurnya, karena terlalu lapar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680109
					]
				},
				{
					"id": 200680109,
					"content": "Kamu... kalau kamu lapar, bekerjalah dan cari uang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680110
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680110,
					"content": "Dengan kemampuanmu, kamu pasti bisa mendapatkan pekerjaan di Adventurers' Guild...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680113
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680113,
					"content": "Huh, semuanya sudah terjadi, tidak ada gunanya membicarakannya lagi, sejak kejadian ini Timmie sangat sedih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680114
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680114,
					"content": "Aku dulu belajar resep dari... ayah Timmie. Makanan yang paling disukai Timmie.adalah Hash Brown dari Mondstadt yang berisi Philanemo Mushroom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680115
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680115,
					"content": "Kamu bantu aku mencari 3 Philanemo Mushroom, dengan memakan itu mungkin perasaan Timmie bisa lebih baik... dan sebagai permintaan maafmu padanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680116,
						200680117
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680116,
					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680118
					]
				},
				{
					"id": 200680118,
					"content": "Kalau begitu kembalinya dengan membawa jamur itu sesegera mungkin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680120
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680120,
					"content": "Philanemo Mushroom... aku ingat sepertinya ada beberapa di atap rumah di bagian selatan kota.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680121
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680121,
					"content": "Kalau begitu kembalinya dengan membawa jamur itu sesegera mungkin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680117,
					"content": "Tidak peduli berapa pun jamur, aku bisa menemukannya!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680119
					]
				},
				{
					"id": 200680119,
					"content": "Pakai 3 saja cukup. Kamu ambil begitu banyak, sebagai cadangan kalau nanti Timmie marah lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680120
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680107,
					"content": "Aku kehilangan akal...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680111
					]
				},
				{
					"id": 200680111,
					"content": "Kehilangan akal sampai memukul merpati dan bebek? Jadi kamu juga sedang \"kehilangan akal\" saat kamu mengalahkan musuh-musuh yang kuat itu ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680113
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680108,
					"content": "Kekuatan datang dari kebiasaan ini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680112
					]
				},
				{
					"id": 200680112,
					"content": "Kamu... kamu, aku... ah, sudahlah. Tampaknya kamu memang mampu melakukan banyak hal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680113
					],
					"speakerTitle": "Grace"
				}
			]
		},
