			"dialogs": [
				{
					"id": 200680301,
					"content": "... Makanlah, kalau sudah selesai makan, ayo cepat jalan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680302,
						200680303,
						200680304
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200680302,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680305
					]
				},
				{
					"id": 200680305,
					"content": "Kenapa kamu lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680308
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200680308,
					"content": "Sebenarnya apa yang ada di pikiranmu, masih ingin menyiksa merpati dan bebek?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680309,
						200680310
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200680309,
					"content": "Hash Brown ini untukmu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680311
					]
				},
				{
					"id": 200680311,
					"content": "Hash Brown? Hah, bagaimana kamu tahu cara membuat Hash Brown?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680312
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200680312,
					"content": "Aku tahu, kamu pasti pergi mencari ibu Grace...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680313
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200680313,
					"content": "Huh, kamu pikir cukup begitu saja minta maaf, tidak semudah itu! Aku tahu persis apa yang kamu lakukan pada merpati dan bebek itu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680314
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200680314,
					"content": "...tapi, ibu membiarkanmu mengantar Hash Brown ini, pasti tidak ingin aku marah terus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680315
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200680315,
					"content": "Dia masih harus menjaga Nora dan Glory, kalau aku begini semakin menyusahkannya dan terlalu kekanak-kanakan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680316
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200680316,
					"content": "Tapi, aku masih belum memaafkanmu! Aku hanya tidak ingin menyusahkan ibu lagi, apa kamu mengerti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680317
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200680317,
					"content": "Huh, lagi pula... aku juga hanya seorang anak kecil, janji yang hanya diucapkan dengan kata-kata ini, kamu akan melupakannya juga...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680318
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200680318,
					"content": "Tunggu ayahku kembali, aku akan menceritakan apa yang kamu lakukan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200680310,
					"content": "Tolong terima Hash Brown ini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680311
					]
				},
				{
					"id": 200680303,
					"content": "Timmie, itu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680306
					]
				},
				{
					"id": 200680306,
					"content": "Kenapa kamu lagi? Kapan kamu puas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680308
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200680304,
					"content": "A-apa yang terjadi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680307
					]
				},
				{
					"id": 200680307,
					"content": "Kamu masih ada hati bertanya padaku!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680308
					],
					"speakerTitle": "Timmie"
				}
			]
		},
