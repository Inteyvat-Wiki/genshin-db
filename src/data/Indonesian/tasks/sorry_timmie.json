			"dialogs": [
				{
					"id": 200680401,
					"content": "Ini sudah cukup, terima kasih, silakan tunggu sebentar ya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680402
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680402,
					"content": "Makanannya sudah jadi, kamu bisa memberikan [Harsh Brown Mondstadt] ini kepada Timmie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680403
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680403,
					"content": "Tolong kamu ke depannya tidak melakukan... hal yang tidak baik, dan tidak bisa dimaafkan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680404
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680404,
					"content": "Semoga kamu ingat perkataanku, jangan biarkan aku dan Timmie kecewa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680405
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680405,
					"content": "Tapi... hmm, kalau semua orang bisa mengingat perkataan, Suster Victoria tidak akan begitu sibuk...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				}
			]
		},
		{
