					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nasejuna",
					"Sorush",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732560401,
					"content": "Saksikan, saat-saat yang ditakdirkan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560402
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560402,
					"content": "....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732560403
					]
				},
				{
					"id": 732560403,
					"content": "Ini jelas-jelas cuma pintu mekanik biasa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732560404,
					"content": "*uhuk* Maksudnya, asalkan bisa membuka pintu mekanik ini, kita bisa masuk ke dalam reruntuhan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560405
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560405,
					"content": "Ini pertama kalinya aku masuk ke reruntuhan Dahri. Apa tidak boleh sedikit bersemangat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560406
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560406,
					"content": "Eh? Kirain kamu ahlinya menjelajah reruntuhan. Tadi ngomongnya sok iye gitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732560407,
					"content": "Hah! Ya, aku memang tidak bisa bilang sudah pernah turun langsung ke lapangan. Tapi \"Catatan Penyelidikan Rene\" milik pelajar sejarah kuno ini ditulis dengan sangat rapi! Rasanya nyaris seperti aku sendiri yang datang menjelajahi semuanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560408
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560408,
					"content": "\"Catatan Penyelidikan Rene\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732560409
					]
				},
				{
					"id": 732560409,
					"content": "Kalian tidak pernah mendengarnya? Aku pikir cuma orang sepertiku yang tinggal di padang pasir nan jauh di sana yang tidak pernah dengar nama pelajar hebat ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560410
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560410,
					"content": "Catatan ini isinya banyak tentang peninggalan orang Dahri. Menurut si penulis, dia telah menemukan pengetahuan yang \"melampaui kefanaan\" di dalam reruntuhan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560411
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560411,
					"content": "Makin dijelasin makin susah dipercaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732560412,
					"content": "Kesampingkan saja dulu. Asalkan ada catatan ini, masuk ke dalam reruntuhan orang Dahri itu mudah saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560413
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560413,
					"content": "Kalau tidak percaya, langsung cobalah! Misalnya ... buka alat yang ini ... Nah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560414
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560414,
					"content": "<color=#00E1FFFF>\"Putar roda gigi untuk mengungkapkan tiga jenis simbol. Hubungkan persegi panjang dengan bagian bawah segitiga tanpa mengubah segitiganya.\"</color> Lakukan sesuai instruksi, aman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nasejuna"
				}
			]
		},
