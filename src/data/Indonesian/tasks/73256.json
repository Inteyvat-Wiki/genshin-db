				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nasejuna",
					"Sorush"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732562301,
					"content": "Utusan Agung dan Yasnapati yang terhormat, sepertinya aku hanya bisa menemani sampai sini saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562302
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562302,
					"content": "Kenapa lagi kali ini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732562303
					]
				},
				{
					"id": 732562303,
					"content": "Menurut catatan, jalan di depan penuh bahaya yang tidak bisa dilewati oleh makhluk fana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562304
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562304,
					"content": "Setelah masuk, kita akan tiba di tempat bekas sarana pengujian mesin orang Dahri. Bahkan ada purwarupa mesin raksasa yang belum jadi di sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562305
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562305,
					"content": "Menurut catatan Dahri, tempat ini dialihfungsikan menjadi benteng untuk menghalau monster, walaupun akhirnya tidak sempat terpakai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562306
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562306,
					"content": "Aneh kan? Kenapa orang-orang Dahri, penyebab bencana pencemaran, menciptakan mesin untuk melawan monster?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562307
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562307,
					"content": "Yah, karena kita sudah menyalakan sistem kendali reruntuhan ini, mekanisme pertahanan yang ada di sarana pengujian pasti ikut menyala juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562308
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562308,
					"content": "Lagu Agung Khvarena ada di dalam Golem. Aku jelas tidak bisa apa-apa, tapi pasti mudah saja bagi kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562309
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562309,
					"content": "Izinkan aku tetap di sini dan menunggu, agar kita bisa lanjut mengumpulkan semua Lagu Agung Khvarena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562310
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562310,
					"content": "Kamu memang hanya manusia biasa. Permintaan yang wajar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562311
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732562311,
					"content": "Kalau begitu, aku undur diri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562312
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562312,
					"content": "Nasejuna kabur di saat-saat terakhir. Tapi Paimon senang kalian jadi enggak bisa berantem dulu untuk sementara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7325624,
			"completionStepIds": [
				7325624
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
