					"Sorush"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732562401,
					"content": "Ah, Utusan Agung dan Yasnapati, sungguh hebat. Mesin Dahri dan makhluk Dev pun tidak berdaya menghadapi kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562402
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562402,
					"content": "Lah? Sejak kapan Nasejuna ada di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732562403,
					"content": "Ha, aku menyaksikan pertempuran dari pinggir. Luar biasa sekali! Dan begitu lihat Lagu Agung sudah di tangan kalian, aku bergegas lari ke sini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562404
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562404,
					"content": "Kerja bagus! Dan selagi kita membahas ini, bolehkah jika aku saja yang memegang Lagu Agung Khvarena? Ah, supaya aku ... bisa semakin berguna dalam perjalanan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562405
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562405,
					"content": "Memangnya kamu dari tadi ada gunanya ya? Enggak, Zurvan bilang enggak boleh kasih Lagu Agung Khvarena ini ke sembarang orang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732562406,
					"content": "Jangan seperti itu. Aku sudah banyak sekali menghabiskan waktu untuk menelitinya! Izinkanlah aku memeriksanya sedikit, dijamin akan berguna ke depannya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562407
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562407,
					"content": "Misalnya, kita bisa cari tahu mengapa Lagu Agung Khvarena bisa tersembunyi dalam reruntuhan ini, dan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562408
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562408,
					"content": "Ini bukan waktunya mendongeng, Nasuraia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562409
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732562409,
					"content": "Iya! Kita masih harus lanjut cari Khvarena Agung yang berikutnya, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732562410,
					"content": "Nasejuna, kamu boleh lanjut dongengnya kalau semua Khvarena Agung sudah ketemu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732562411,
					"content": "Baiklah ... kalau begitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nasejuna"
				}
			]
		},
