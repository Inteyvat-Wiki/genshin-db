			},
			"dialogs": [
				{
					"id": 732562701,
					"content": "Sesuai yang tertulis di catatan ... Hmm? Sudah kembali?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562702
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562702,
					"content": "Kalau melihat raut wajah, kalian sepertinya berhasil menemukan semua balok energi yang kita perlukan ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562703
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562703,
					"content": "Aku sudah periksa semua inti energinya. Kondisinya masih sangat bagus. Kita tinggal pasangkan baloknya saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562704
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562704,
					"content": "Kuserahkan semuanya pada kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nasejuna"
				}
			]
