					"speakerTitle": "Sorush"
				},
				{
					"id": 732562005,
					"content": "Perubahan yang dibuat ternyata tidak sampai membongkar peralatan yang sudah ada. Penemuan ini sangat membantu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562006
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732562006,
					"content": "Baiklah, kehormatan untuk mengoperasikan meriam ini kuanugerahkan pada Yasnapati. Silakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sorush"
				}
			]
		},
		{
			"id": 7325623,
			"completionStepIds": [
				7325623
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7325623",
							"2"
						],
						"stepId": 7325623,
						"stateName": "QUEST_STATE_UNFINISHED"
