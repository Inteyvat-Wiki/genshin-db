			"dialogs": [
				{
					"id": 732561201,
					"content": "Sesuai dugaan. Masalahnya ada di alat penghubungnya, energi dari intinya tidak sampai kemari. Kita harus cari cara menyambungkannya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732561202
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732561202,
					"content": "Semua alat penghubung tersegel dalam kristal. Tapi karena reruntuhan ini tidak menggunakan pencemaran sebagai sumber energi, harusnya tidak menarik perhatian Khvarena ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732561203
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732561203,
					"content": "Penjelasan yang mungkin adalah, alat ini sengaja disegel oleh seseorang yang bisa memakai kekuatan Khvarena. Tapi kenapa? Apa yang disembunyikan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732561204
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732561204,
					"content": "Ha, kita bahas nanti lagi saja. Sekarang kita utamakan untuk membersihkan Kristal Abu yang menyegelnya, dengan kekuatan Khvarena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732561205
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732561205,
					"content": "Harusnya dekat sini ada Farrwick yang mengandung kekuatan Khvarena. Tentunya Utusan agung juga dapat merasakannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732561206
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732561206,
					"content": "Umm ... HA! Tentu saja bisa. Kamu meragukan kekuatan Bloomguard?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732561207
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732561207,
					"content": "Mana mungkin, aku tidak berani lancang! Mohon bimbingannya, Utusan Agung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732561208
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732561208,
					"content": "Tinggal cari Farrwick, hilangkan Kristal Abu, lalu gunakan Alat Pengaduk untuk menyambungkan alat-alatnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nasejuna"
				}
			]
