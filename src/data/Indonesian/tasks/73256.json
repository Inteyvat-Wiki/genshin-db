			"dialogs": [
				{
					"id": 732560601,
					"content": "Sepertinya kita sudah sampai di pusat reruntuhan. Sekarang, biarlah orang yang paling memahami reruntuhan Dahri, aku, menjelaskan semuanya kepada kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560602
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560602,
					"content": "Menurut catatan, tempat ini dulunya adalah sarana pengujian orang Dahri untuk melakukan penelitian dan percobaan. Lagu Agung Khvarena yang kita cari ada di bagian terdalamnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560603
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560603,
					"content": "Kalau mau ke sana, pertama kita harus ... Hmm ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560604
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560604,
					"content": "Kok bingung? Tadi katanya kamu \"orang yang paling memahami reruntuhan ini\". Itu ludah masih nempel tuh, di bibir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732560605,
					"content": "Karena struktur reruntuhan ini terlalu rumit. Aku yakin tidak ada yang bisa seratus persen mengerti cara kerja alat-alat misterius orang Dahri cuma dari baca instruksinya saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560606
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560606,
					"content": "Coba lihat ... Ah, ini dia. Posisi kita sekarang ada di ruang kendali pusat sarana pengujian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560607
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560607,
					"content": "Untuk sampai ke tempat Lagu Agung Khvarena, kita harus aktifkan dulu sistem kendali seluruh reruntuhan. Dan sistem hanya bisa aktif jika punya energi cukup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560608
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560608,
					"content": "Orang Dahri dikatakan mampu memanfaatkan kekuatan pencemaran untuk menghidupkan mesin dan mengendalikan monster, tapi kelihatannya reruntuhan ini berbeda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560609
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560609,
					"content": "Sebaliknya, mereka menggunakan semacam energi yang disebut Azosite, dan mengekstrak energi elemental murni yang dikondensasi ke dalam bentuk balok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560610
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560610,
					"content": "Artinya, asalkan ada balok energi, kita akan bisa mengisi daya ke intinya. Setelah itu, sisanya bisa diselesaikan dengan mudah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560611
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560611,
					"content": "Merepotkan. Jika saja semuanya dapat diselesaikan dengan pertarungan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560612
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732560612,
					"content": "Oke, yuk mulai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732560613
					]
				},
				{
					"id": 732560613,
					"content": "Ah, sudah tidak sabar lagi rupanya. Memang begitulah Yasnapati sang Utusan Agung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560614
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560614,
					"content": "Baiklah, urusan mencari balok energi kuserahkan pada kalian. Ini denah area sarana pengujian. Pasti akan berguna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560615
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560615,
					"content": "Masih ada beberapa hal yang perlu kuperiksa, jadi aku akan menunggu di sini. Utusan Agung beserta kalian, semuanya akan selesai dalam sekejap mata saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560616
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560616,
					"content": "Kalau ada kesulitan, periksa lagi saja denahnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nasejuna"
				}
			]
		},
