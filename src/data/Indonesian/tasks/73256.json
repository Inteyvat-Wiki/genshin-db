			},
			"dialogs": [
				{
					"id": 732561001,
					"content": "Inti energinya sudah diisi. Seharusnya kita bisa aktifkan sistem kendalinya sekarang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732561002
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732561002,
					"content": "Ha? Ini di luar dugaan. Apa ada masalah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732561003
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732561003,
					"content": "Sepertinya kita harus periksa ruang kendali tempat alat penghubungnya. Tidak apa, kita memang pasti lewat sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732561004
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732561004,
					"content": "Ah, begitu rupanya! Ya, pusat kendalinya ada di arah kalian datang tadi. Mari, kita ke sana sama-sama!",
					"roleType": "TALK_ROLE_NPC",
