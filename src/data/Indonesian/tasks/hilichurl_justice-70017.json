			"dialogs": [
				{
					"id": 700170101,
					"content": "...Yaya dala?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700170102
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 700170102,
					"content": "Mimi tomo, mimi mosi mita, Muhe mita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700170103
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700170103,
					"content": "Mita...? Gusha... Dada odomu Plata mimi, mimi mosi gusha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700170104
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 700170104,
					"content": "Mimi tomo, mimi plata odomu! Mimi mani ye!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700170105
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700170105,
					"content": "Mani...? Dada! Kundala zido mi, mi dada, mimi tomo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700170106
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 700170106,
					"content": "Ella sedang menghibur Hilichurl itu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700170107,
						700170108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700170107,
					"content": "Dia benar-benar orang yang punya rasa empati...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700170109
					]
				},
				{
					"id": 700170109,
					"content": "Katanya ... dia ditindas... oleh orang jahat. Kita harus membantunya membalaskan amarahnya. Itu saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700170110
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700170110,
					"content": "Dada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700170111
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 700170111,
					"content": "Wah, asyik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700170112
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700170112,
					"content": "Wah, asyik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700170113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700170113,
					"content": "Sepertinya yang tadi tidak perlu diterjemahkan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700170114
					]
				},
				{
					"id": 700170114,
					"content": "Baiklah, lokasinya sudah ditandai pada petamu — aku akan segera kembali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700170115
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700170115,
					"content": "Dada, Valo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 700170108,
					"content": "Tapi aku tidak mengerti apa yang mereka katakan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700170109
					]
				}
			]
