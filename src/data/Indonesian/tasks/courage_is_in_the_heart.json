				"points": []
			},
			"dialogs": [
				{
					"id": 730670401,
					"content": "Kamu Arashakun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670402,
					"content": "*hiks* Iya betul, aku Arashakun ... Jangan dekat-dekat! Pelan-pelan jalannya!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670403
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670403,
					"content": "Arashakun bersyukur ditolong kalian, tapi tolong jangan dekat-dekat ... *hiks*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670404
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670404,
					"content": "Arashakun risih kalau terlalu dekat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670405
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670405,
					"content": "Woi! Kami yang nolongin kamu loh, barusan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670406,
					"content": "Maaf! Maaf, Arashakun keterlaluan, Arashakun kurang ajar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670407
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670407,
					"content": "Tapi aku sudah terjebak lama di sini dan masih ... takut. *hiks* Maafin Arashakun ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670408
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670408,
					"content": "Cup-cup, sudah, enggak apa-apa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670409,
					"content": "Terima kasih. Boleh tahu nama kalian?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670410
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670410,
					"content": "Nama Paimon ya ... Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670411,
					"content": "#Aku {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670412
					]
				},
				{
					"id": 730670412,
					"content": "#Nara Emas {NICKNAME} dan Paimon ... tahu nama Arashakun dari mana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670413
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670413,
					"content": "Kami baca catatan di dalam rumah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670414
					]
				},
				{
					"id": 730670414,
					"content": "#Nara {NICKNAME} berambut emas baca catatan terus cari Arashakun? Dan bisa tolong juga? Hebat, Nara baik, Nara kuat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670415
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670415,
					"content": "*hiks* *hiks* ... Kalau \"keberanian\" Arashakun masih ada, tidak mungkin jadi tidak berdaya seperti tadi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670416
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670416,
					"content": "Iya, kami tadi sempat baca catatan kamu. Maksudnya \"keberanian\" kamu hilang gimana sih, Arashakun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670417,
					"content": "Ceritanya sudah lama, dari zaman dulu sekali ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670418
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670418,
					"content": "Arashakun tadinya seperti sekarang, tidak ada \"keberanian\". Suara ranting patah saja bisa bikin Arashakun terjaga semalaman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670419
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670419,
					"content": "Tapi Arashakun yang penakut masih punya satu teman Nara. Dia bukan Nara Varuna yang hebat perkasa, tapi dia baiknya sama!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670420
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670420,
					"content": "Arashakun si penakut ini tidak pernah dia hina. Dia pegang tangan Arashakun supaya tidak ketakutan. Teman baik seperti dia, Arashakun tidak bakal lupa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670421
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670421,
					"content": "Tapi suatu hari Raja Iblis dengan Topeng Berbulu menculik teman Nara ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670422
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670422,
					"content": "Raja Iblis dengan Topeng Berbulu ini siapa sih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670423,
					"content": "Raja Iblis dengan Topeng Berbulu itu mukanya buluan, pakai topeng, dan dia raja iblis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670424
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670424,
					"content": "Lah ... cuma dipanjangin doang namanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670425,
						730670427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670425,
					"content": "Paimon tahu tidak itu apaan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670426
					]
				},
				{
					"id": 730670426,
					"content": "Paimon bisa tahu dari mana coba ... aneh nanyanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670429
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670429,
					"content": "Pokoknya si Raja Iblis dengan Topeng Berbulu yang culik temannya Arashakun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670430,
					"content": "Raja Iblis dengan Topeng Berbulu licik. Ingat dia saja Arashakun langsung bergidik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670431
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670431,
					"content": "*hiks* Waktu teman Nara diculik, Arashakun memang takut banget dipukuli sama Raja Iblis dengan Topeng Berbulu, tapi lebih takut lagi kalau harus kehilangan teman Nara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670432
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670432,
					"content": "Jadi Arashakun susah payah, mati-matian mencoba! Pukul, tusuk, sikat, terusss sampai teman Nara berhasil tertolong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670433
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670433,
					"content": "Setelah itu teman Nara bikinin Jimat Keberanian buat Arashakun. Dia bilang \"Arashakun itu Aranara baik yang gagah berani, bukan penakut!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670434
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670434,
					"content": "Sejak itu Arashakun jadi punya \"keberanian\" ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670435
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670435,
					"content": "Lah, bukannya \"susah payah, mati-matian mencoba! Pukul, tusuk, sikat!\" saja sudah cukup bernyali ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670436
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670436,
					"content": "Salah, Arashakun jadi berani setelah dikasih \"keberanian\" sama teman Nara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670437
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670437,
					"content": "Tapi nolongin teman saja sudah berani banget loh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670438
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670438,
					"content": "Tidak, tidak, tidak. Waktu tolong teman Nara, Arashakun ketakutan sampai gemetaran seluruh kaki tangan. Tapi setelah punya \"keberanian\", Arashakun berhenti gemetar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670439
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670439,
					"content": "Duh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670440,
						730670441
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670440,
					"content": "Jimat sih cuma buat sugesti doang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670442
					]
				},
				{
					"id": 730670442,
					"content": "#*hiks* Nara {NICKNAME} bikin pusing! Arashakun cuma tahu \"keberanian\" ada saat aku pegang \"jimat\" ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670443
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670443,
					"content": "Sejak \"keberanian\" itu dicuri, Arashakun ke gua Raja Iblis dengan Topeng Berbulu untuk menemukannya kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670444
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670444,
					"content": "Tapi Arashakun malah dikepung Slime ... untungnya Raja Iblis dengan Topeng Berbulu tidak sadar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670445
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670445,
					"content": "#{NICKNAME}, masih ingat benda yang tadi dijatuhkan Hilichurl? Apa itu ya jimatnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670446
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670446,
					"content": "Arashakun, kayaknya \"keberanian\" kamu sudah ketemu nih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670447
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670447,
					"content": "#Benarkah? Apa \"keberanian\" Arashakun-nya sudah ketemu? Nara {NICKNAME}? Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670441,
					"content": "\"Keberanian\" itu sejak awal sudah ada dalam dirimu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670442
					]
				},
				{
					"id": 730670427,
					"content": "Jawaban Aranara ... tidak menjawab. Biasa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670428
					]
				},
				{
					"id": 730670428,
					"content": "Paimon bingung, jadi Raja Iblis dengan Topeng Berbulu ini apaan sih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670429
					],
					"speakerTitle": "Paimon"
				}
			]
		},
