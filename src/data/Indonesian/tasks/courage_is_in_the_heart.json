				"points": []
			},
			"dialogs": [
				{
					"id": 730670301,
					"content": "Jadi yang nulis ini semua si \"Arashakun\", kan? Aranara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670302,
					"content": "Tulisannya sebentar gede sebentar kecil. Yang gede sih mending ya, tapi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670303,
					"content": "Yang kecil bikin sakit mata, beneran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670304,
					"content": "Wah, si unyil Paimon susah baca huruf unyil?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670305
					]
				},
				{
					"id": 730670305,
					"content": "Ck, Paimon biasa baca yang ukurannya normal yah, tolong! Paimon enggak biasa baca yang unyilnya amit-amit gitu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670306,
					"content": "Terus si Arashakun ini kayaknya belum balik lagi ya sejak dia nulis halaman terbaru?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670307,
					"content": "Kita sekarang pergi cari di gua timur. Kalau di buku catatan, ditulis \"keberanian\" sudah hilang ... Memangnya \"keberanian\" bisa hilang ya? Penasaran deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
