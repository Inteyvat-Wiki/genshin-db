			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 730670201,
					"content": "(Beberapa halaman pertama tulisannya sangat kecil dan susah dibaca ....)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670202
					],
					"speakerTitle": "Catatan yang Tulisannya Tidak Konsisten"
				},
				{
					"id": 730670202,
					"content": "\"Huhuhu ... ternyata ada Nara yang rela berteman sama Arashakun. Nara baik! Tidak menghina Arashakun yang penakut, dan mengajari Arashakun cara nulis huruf Nara.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670203
					],
					"speakerTitle": "Catatan yang Tulisannya Tidak Konsisten"
				},
				{
					"id": 730670203,
					"content": "\"Nara baik menenangkan Arashakun yang ketakutan sama yang daun jatuh di kepala. Nara baik, selamanya teman!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670204
					],
					"speakerTitle": "Catatan yang Tulisannya Tidak Konsisten"
				},
				{
					"id": 730670204,
					"content": "(Halaman belakang tulisannya semakin kecil dan semakin tidak jelas.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670205
					],
					"speakerTitle": "Catatan yang Tulisannya Tidak Konsisten"
				},
				{
					"id": 730670205,
					"content": "\"Huhuhuhu ... Teman Nara diculik sama Raja Iblis dengan Topeng Berbulu! Tangannya panjang amat, ngeri ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670206
					],
					"speakerTitle": "Catatan yang Tulisannya Tidak Konsisten"
				},
				{
					"id": 730670206,
					"content": "\"Harus tolong Nara ... huhuhu ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670207
					],
					"speakerTitle": "Catatan yang Tulisannya Tidak Konsisten"
				},
				{
					"id": 730670207,
					"content": "(Halaman sisanya tulisannya sangat besar, dan sepertinya nulisnya ditekan keras-keras ....)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670208
					],
					"speakerTitle": "Catatan yang Tulisannya Tidak Konsisten"
				},
				{
					"id": 730670208,
					"content": "\"Raja Iblis dengan Topeng Berbulu sudah kalah! Teman Nara selamat, terus Arashakun dikasih 'keberanian' sama dia! Sekarang Arashakun sudah bukan penakut lagi!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670209
					],
					"speakerTitle": "Catatan yang Tulisannya Tidak Konsisten"
				},
				{
					"id": 730670209,
					"content": "\"Arashakun yang berani sekarang semangat melawan para monster topeng bulu. Nara-Nara sudah tidak usah takut lagi sama mereka!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670210
					],
					"speakerTitle": "Catatan yang Tulisannya Tidak Konsisten"
				},
				{
					"id": 730670210,
					"content": "(Tulisan di halaman-halaman yang terbaru mengecil lagi ukurannya.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670211
					],
					"speakerTitle": "Catatan yang Tulisannya Tidak Konsisten"
				},
				{
					"id": 730670211,
					"content": "\"Huhuhu ... Kenapa jadi begini? Arashakun sudah tidak punya 'keberanian' lagi. Hilang ... pasti dicuri sama Raja Iblis dengan Topeng Berbulu!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670212
					],
					"speakerTitle": "Catatan yang Tulisannya Tidak Konsisten"
				},
				{
					"id": 730670212,
					"content": "\"Raja Iblis dengan Topeng Berbulu, tangannya panjang, licik dan sangat menakutkan. Tapi Arashakun kehilangan \"keberanian\" dan tidak bisa berbuat apa-apa ... *hiks* Arashakun mau cari di <color=#00E1FFFF>terowongan di arah tenggara</color> ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Catatan yang Tulisannya Tidak Konsisten"
				}
			]
		},
