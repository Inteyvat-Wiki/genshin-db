					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730670601,
					"content": "Ini dia! Betul!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670602
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670602,
					"content": "Ini \"jimat keberanian\"! Bunganya sudah agak layu karena jauh dari Arashakun ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670603
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670603,
					"content": "Tapi tidak apa! Arashakun akan jaga baik-baik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670604
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670604,
					"content": "\"Arashakun itu Aranara baik yang gagah berani, bukan penakut!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670605
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670605,
					"content": "#Terima kasih banyak Nara {NICKNAME} dan Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670606
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670606,
					"content": "\"Keberanian\" Arashakun sudah kembali. Coba saja! Raja Iblis dengan Topeng Berbulu, tunggu aku! Kusikat kau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670607
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670607,
					"content": "(Waduh, Arashakun jadi beda banget sama tadi.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670608,
					"content": "#Raja Iblis dengan Topeng Berbulu sudah banyak berbuat jahat! Ikut aku, Nara {NICKNAME} dan Paimon! Kita hajar dia sama-sama!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670609
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670609,
					"content": "Arashakun yakin, hari ini dia akan dihentikan! Oleh kita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670610
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670610,
					"content": "#Ya sudah, {NICKNAME}, kita ikut yuk. Lihat apa sih sebenarnya Raja Iblis dengan Topeng Berbulu itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7306707,
