				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730670701,
					"content": "Yah, setelah banyak kemungkinan ternyata Raja Iblis dengan Topeng Berbulu itu Hilichurl doang ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670702,
					"content": "Hilichurl?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670703
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670703,
					"content": "Raja Iblis dengan Topeng Berbulu. Cuma Hilichurl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670704,
					"content": "Semua \"Hilicucu\" itu Raja Iblis dengan Topeng Berbulu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670705
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670705,
					"content": "Enggak gitu juga ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670706,
					"content": "Arashakun cukup tahu saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670707
					]
				},
				{
					"id": 730670707,
					"content": "Baiklah, Arashakun tahu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670708
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670708,
					"content": "#Arashakun akan pimpin, Nara {NICKNAME} dan Paimon, maju! Raja Iblis dengan Topeng Berbulu bukan tandingan kita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670709
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670709,
					"content": "Hari ini Arashakun akan tulis yang besar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670710
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670710,
					"content": "Besar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670711
					]
				},
				{
					"id": 730670711,
					"content": "Iya, tulis catatan pakai huruf besar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670712
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670712,
					"content": "Arashakun yang punya \"keberanian\" dan yang tidak punya \"keberanian\" itu beda jauh ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670713,
					"content": "Arashakun yang tidak punya \"keberanian\" itu lemah, tapi yang punya \"keberanian\" bisa segalanya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670714
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670714,
					"content": "\"Keberanian\" bukan cuma hadiah dari teman Nara. Juga adalah barang paling penting bagi Arashakun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670715
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670715,
					"content": "Ya sudah, jaga baik-baik, jangan sampai dicuri Hilichurl lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670716,
					"content": "Arashakun tahu! Arashakun tidak akan pernah membiarkan \"keberanian\" meninggalkanku lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arashakun"
				}
			]
		}
	]
