			"dialogs": [
				{
					"id": 150050101,
					"content": "Koholasaurus yang kalah langsung berpencar dan kabur.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150050102
					]
				},
				{
					"id": 150050102,
					"content": "Kalau lihat bajunya, kalian ini pasti pelajar dari Sumeru, ya kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050103,
					"content": "Benar, aku Karya, dan ini seniorku, Viramdra. Terima kasih banyak karena telah menyelamatkan kami. Hampir saja ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050104
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150050104,
					"content": "#Ah enggak perlu sungkan! Ngurus masalah ginian sih sudah jadi makanan sehari-hari buat kami. Nama Paimon ya Paimon, terus ini si {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050105,
					"content": "*huff* Ya tetap saja, sepertinya semua Koholasaurus sudah kabur deh ... Padahal kami harus tangkap satu ekor hidup-hidup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050106
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150050106,
					"content": "Hah? Tangkap satu ekor hidup-hidup?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050107,
					"content": "Benar. Kulihat kalian pro sekali dalam menghadapi mereka tadi. Bisa tidak jadikan aku sebagai umpan dan bantu kami buat tangkap satu ekor saja? Aku bayar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050108
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150050108,
					"content": "Eh, itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050109,
					"content": "Maaf. Viramdra terlalu fokus dengan penelitiannya, jadi harap maklum ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050110
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150050110,
					"content": "Oh, enggak apa-apa kok! Tapi ngapain kalian malah samperin sekelompok Koholasaurus liar gitu? Terus ngapain harus \"tangkap\" mereka segala?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050111,
					"content": "Jangan bilang kalian mau foto bareng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150050112
					]
				},
				{
					"id": 150050112,
					"content": "Paimon cukup yakin maksud mereka enggak gitu deh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050113,
					"content": "Aku yakin kita pasti terlihat bodoh sekali ... Sebenarnya kami lagi meneliti soal pulau misterius dari sebuah legenda. Katanya ada petunjuk yang sangat penting soal pulau tersebut di badan Koholasaurus, jadi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050114
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150050114,
					"content": "Mendekati mereka langsung tanpa bantuan pemandu dari Warga Mata Air itu benar-benar tindakan gegabah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050115
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150050115,
					"content": "Pulau misterius?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050116,
					"content": "Iya. Ada sebuah legenda suku Warga Mata Air yang menyebutkan soal pulau misterius, Viramdra percaya bahwa kunci dari penelitiannya bisa ditemukan di sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050117
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150050117,
					"content": "Ehem ... Jadi kalian tidak mau pertimbangkan permintaanku untuk tangkap satu ekor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050118
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150050118,
					"content": "Tapi yang barusan itu ... Kita enggak mungkin dong pakai orang buat jadi umpan hidup!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050119,
					"content": "Kalau begitu diskusi soal ini bakal buang waktu saja. Aku harus cari solusi lain ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050120
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150050120,
					"content": "Ehem ... Viramdra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050121
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150050121,
					"content": "Oh, benar juga ... Kalian telah menyelamatkan aku dan Karya barusan, aku harus bilang makasih ya. Terima kasih banyak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050122
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150050122,
					"content": "Agak kagok ya, tapi ya sudah deh Paimon maklumi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050123,
					"content": "Karya, ayo kita jalan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050124
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150050124,
					"content": "Ah iya, sekali lagi terima kasih ya. Maafkan aku ... Viramdra memang kurang dalam urusan sosialisasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050125
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150050125,
					"content": "Enggak masalah, dadah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050126,
					"content": "Jarang banget loh lihat ada duo petualang kayak mereka!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050127,
					"content": "Tapi Paimon sekarang malah jadi kepo soal pulau misterius yang kakak tadi omongin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050128,
					"content": "Paimon juga mau cari pulau itu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150050129
					]
				},
				{
					"id": 150050129,
					"content": "Iya! Siapa tahu ada banyak harta karun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050130,
					"content": "Selama ini kita kan sudah jelajahi banyak tempat menakjubkan waktu bertualang, jadi nemuin pulau misterius sih harusnya cetek lah buat kita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050131,
					"content": "Tapi kita enggak punya info apa-apa soal pulau itu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150050132
					]
				},
				{
					"id": 150050132,
					"content": "Ah, iya juga sih ... kakak tadi bilang pulau misterius itu berhubungan dengan legenda suku Warga Mata Air ... Jadi mungkin kita bisa tanya-tanya mereka dulu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050133,
					"content": "Waktunya enggak banyak. Ayo mulai petualangan kita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050134,
					"content": "Kita kan mau tanya-tanya nih, tapi ... mau tanya siapa duluan nih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050135,
					"content": "Gimana kalau langsung tanya kepala suku?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150050136
					]
				},
				{
					"id": 150050136,
					"content": "Hmm, boleh sih dicoba ... Kepala suku harusnya tahu sampai detail-detailnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
