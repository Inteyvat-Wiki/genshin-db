			"dialogs": [
				{
					"id": 150050201,
					"content": "Wow, pemandangannya bagus banget! Terus kita juga bisa lihat beberapa Koholasaurus di mana-mana! Hei, gimana kalau kita foto bareng mereka di alam liar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050202,
					"content": "Kalau mereka nanti gigit kita gimana?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150050203
					]
				},
				{
					"id": 150050203,
					"content": "Tapi ... mereka imut banget, masa sih bakal ngegigit ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050204,
					"content": "Hah? Ada apaan di sana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050205,
					"content": "TOLOOONG!!! SELAMATKAN KAMI!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050206
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150050206,
					"content": "Ah! Ada Koholasaurus liar yang lagi mau ngegigit orang tuh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050207,
						150050209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050207,
					"content": "Waktunya jadi pahlawan lagi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150050208
					]
				},
				{
					"id": 150050208,
					"content": "#Iya tuh ada 2 orang lagi kena masalah! {NICKNAME} yang legendaris dan bestie kepercayaannya, Paimon, enggak bakal diam saja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050209,
					"content": "Kayaknya soal foto-foto nanti dulu deh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150050210
					]
				},
				{
					"id": 150050210,
					"content": "Iya, itu nanti dulu deh! Kita enggak bisa diam doang kalau ada orang minta tolong gitu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
