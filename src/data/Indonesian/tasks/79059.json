			"dialogs": [
				{
					"id": 790590101,
					"content": "Ini adalah lokasi yang ditinggalkan untuk adegan singkat \"Perjalanan ke Timur\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790590102
					],
					"speakerTitle": "Catatan Studio"
				},
				{
					"id": 790590102,
					"content": "Konsep awalnya menceritakan kisah seorang pengembara bijak yang berniat untuk berangkat dari Fontaine dan pergi ke timur ke Kota Sumeru untuk mencari kebijaksanaan sejati di House of Daena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790590103
					],
					"speakerTitle": "Catatan Studio"
				},
				{
					"id": 790590103,
					"content": "Ini adalah adegan di mana dia menyelamatkan \"Master of Earthly Transformations\" agar tidak dihancurkan oleh batuan raksasa, dan memulai perjalanan bersama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790590104
					],
					"speakerTitle": "Catatan Studio"
				},
				{
					"id": 790590104,
					"content": "Ah, tapi Hydro Eidolon yang memainkan peran Pengembara dan juga Hydro Eidolon yang memainkan peran \"Master of Earthly Transformations\" entah pergi ke mana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790590105
					],
					"speakerTitle": "Catatan Studio"
				},
				{
					"id": 790590105,
					"content": "Kalau kita bisa <color=#00E1FFFF>menemukan mereka berdua</color> dan mengambil foto mereka saat latihan di dekat batu besar ....",
					"roleType": "TALK_ROLE_NPC",
