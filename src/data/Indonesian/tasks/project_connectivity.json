			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Daya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736900101,
					"content": "Halo! Aku Daya dari Kshahrewar. Apa kamu di sini mau ikut Gala Kebijaksanaan juga?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900102
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900102,
					"content": "Ini proyek baru yang dirilis Darshan kami, \"Proyek Penghubungan\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900103
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900103,
					"content": "Bagaimana? Mau coba memainkannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900104
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900104,
					"content": "Kalau tidak salah ingat, ciri khas Kshahrewar itu ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736900105
					]
				},
				{
					"id": 736900105,
					"content": "Darshan kami memang banyak meneliti mekanisme dan arsitektur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900107
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900107,
					"content": "Uh, sepertinya sudah kejauhan. Demi untuk bisa ikut Gala ini, banyak sekali murid kami yang bekerja sama ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900108
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900108,
					"content": "Akhirnya, mereka mengembangkan proyek baru ini, \"Proyek Penghubungan\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900109
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900109,
					"content": "Gampangnya sih, orang yang bermain harus menggunakan berbagai macam objek yang disediakan untuk membangun jalan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900110
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900110,
					"content": "Entah itu membangun jembatan, atau tangga ... Tujuan akhirnya adalah untuk membangun sebuah jalur yang bisa dilewati oleh manusia untuk mencapai titik akhirnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900111
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900111,
					"content": "Setelah pembangunan selesai, kami akan mengadakan pemeriksaan terakhir ... Yah anggaplah memeriksa hasil bangunan yang baru dibangun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900112
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900112,
					"content": "Pokoknya, kamu dianggap menang kalau bisa membangun sebuah jalan yang aman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900113,
						736900114
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900113,
					"content": "Kok kedengarannya ribet juga ya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736900115
					]
				},
				{
					"id": 736900115,
					"content": "Hahaha, tidak usah khawatir. Ini kan bukan melakukan pembangunan sungguhan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900116
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900116,
					"content": "Jadi meskipun ada kesalahan, atau jalannya roboh, tidak masalah. Bangun ulang saja. Kami juga tidak membatasi jumlah pembangunannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900117
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900117,
					"content": "Kembangkan imajinasimu, dan bangun sebuah jalan yang indah. Itu saja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900118,
						736900120
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900118,
					"content": "Oke, boleh dicoba deh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736900119
					]
				},
				{
					"id": 736900119,
					"content": "Oke, kalau begitu, coba lihat ke sini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900120,
					"content": "Maaf, aku masih ada urusan lain.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736900121
					]
				},
				{
					"id": 736900121,
					"content": "Begitu ya ... Tidak masalah. Stan kami tetap terbuka kok selama Gala ini berlangsung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900122
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900122,
					"content": "Kapan pun kamu mau coba main, langsung ke sini saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900114,
					"content": "Aku tidak punya bakat di bidang arsitektur ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736900115
					]
				}
			]
		}
	]
}