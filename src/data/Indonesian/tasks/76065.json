			},
			"dialogs": [
				{
					"id": 760650101,
					"content": "Ah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650102
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650102,
					"content": "Columbina ... kamu kok di sini?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650103
					]
				},
				{
					"id": 760650103,
					"content": "Mm, sekarang kamu juga ada di sini, jadi ... kita berdua ada di sini bersama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650104
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650104,
					"content": "Kamu bicara seolah-olah tahu aku akan datang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650105
					]
				},
				{
					"id": 760650105,
					"content": "Aku tidak tahu kapan, tapi kamu pasti akan datang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650106
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650106,
					"content": "Seperti Rembulan dan Teyvat yang selalu terhubung oleh gravitasi satu sama lain. Kamu pasti selalu bisa menemukan aku. Iya, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650107
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650107,
					"content": "Sini, duduk bareng yuk. Aku sudah sisakan tempat untukmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650108
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650108,
					"content": "Terakhir kali kita di pesawat luar angkasamu, melihat Teyvat. Kali ini, kita lihat langit berbintang saja yuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650109
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650109,
					"content": "Ninnin dan yang datang sebelum dia ditarik oleh hamparan bintang ini. Pasti ada daya tarik tersendiri di sana. Aku bisa merasakannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650110
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650110,
					"content": "Ninnin dan pesan yang dikirimkannya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650111
					]
				},
				{
					"id": 760650111,
					"content": "Jangan khawatir, dia tidak dalam bahaya kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650112
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650112,
					"content": "Dia sudah berjalan sangat jauh dengan aman, sampai sudah tidak bisa merasakan kekuatan yang kugunakan untuk mengawalnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650113
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650113,
					"content": "Tapi, aku penasaran ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650114
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650114,
					"content": "Penasaran soal apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650115
					]
				},
				{
					"id": 760650115,
					"content": "Mm, ada banyak. Misalnya, apa pesan dari seorang Penatap Bulan akan bisa diterima oleh orang lain?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650116
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650116,
					"content": "Orang yang menerima pesan itu, atau keberadaan lain ... kira-kira siapa ya mereka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650117
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650117,
					"content": "Apa yang akan mereka pikirkan? Apakah mereka akan sama seperti kita, memiliki cinta dan kebencian di dalam hati juga?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650118
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650118,
					"content": "Apa mereka akan sama seperti kita, tetap tertarik pada langit berbintang yang indah dan misterius di atas kepala kita meski dikelilingi Abyss?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650119
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650119,
					"content": "Apakah mereka juga seperti kita, ingin menemukan orang lain, lalu melambaikan tangan dan berkata \"Hai, kawan, senang berkenalan denganmu\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650120
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650120,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650121
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650121,
					"content": "Apa di kedalaman langit berbintang ini, masih ada peradaban yang belum ditelan kegelapan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650122
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650122,
					"content": "Kurasa ada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650123
					]
				},
				{
					"id": 760650123,
					"content": "Hmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650124
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650124,
					"content": "Pesawat luar angkasa kami pernah menerima sebuah pesan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650125
					]
				},
				{
					"id": 760650125,
					"content": "Pesan apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650126
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650126,
					"content": "Hampir semua isi pesannya yang penting sudah hilang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650127
					]
				},
				{
					"id": 760650127,
					"content": "Tapi ini pasti milik peradaban yang cerdas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650128
					]
				},
				{
					"id": 760650128,
					"content": "Apa ... mereka hilang ... karena mereka sudah berkelana terlalu jauh ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650129
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650129,
					"content": "Tapi, ini saja sudah cukup menyenangkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650130
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650130,
					"content": "#Oh iya, {NICKNAME} ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650131
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650131,
					"content": "Hmm?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650132
					]
				},
				{
					"id": 760650132,
					"content": "Kampung halamanmu yang asli juga ada di luar sana, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650133
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650133,
					"content": "Jika suatu hari kamu mau kembali ke tempat kamu memulai perjalanan dan membersihkan tempat itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650134
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650134,
					"content": "Aku akan membantu dengan senang hati, sama seperti kamu membantuku membersihkan bulan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650135
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650135,
					"content": "Kalau begitu aku tidak akan lupa mengundangmu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650136
					]
				},
				{
					"id": 760650136,
					"content": "Akan ada pesta lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650137
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650137,
					"content": "Yup, pesta lagi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650138
					]
				},
				{
					"id": 760650138,
					"content": "Kalau begitu ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650139
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650139,
					"content": "Namanya pesta \"Malam Kepulangan\" saja, bagaimana menurutmu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650140
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650140,
					"content": "Kalau siang hari gimana?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650141
					]
				},
				{
					"id": 760650141,
					"content": "Kalau begitu, bermain dari siang sampai malam. Ajak semua teman-teman baikmu ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650142
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650142,
					"content": "Sepertinya akan seru.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650143
					]
				},
				{
					"id": 760650143,
					"content": "Semoga malam itu datang dengan cuaca yang cerah, di tengah reuni para sahabat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Columbina"
				}
			]
		}
	]
}