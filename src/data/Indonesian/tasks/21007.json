				"objectNames": [
					"Yuancheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210070301,
					"content": "Apanya yang persaudaraan, yang mereka pedulikan hanyalah mengambil temuan terbaik untuk diri mereka sendiri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070302
					],
					"speakerTitle": "Yuancheng"
				},
				{
					"id": 210070302,
					"content": "Dan ayah jadi linglung di hari tuanya... entah benar-benar lupa, atau hanya senang pura-pura tidak tahu saja...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070303
					],
					"speakerTitle": "Yuancheng"
				},
				{
					"id": 210070303,
					"content": "Kurasa mereka belum menyadari bahwa harta karun tersebut ada di tambang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070304
					],
					"speakerTitle": "Yuancheng"
				},
				{
					"id": 210070304,
					"content": "Aku harus segera mendapatkannya... kemudian pergi dari sini sejauh mungkin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yuancheng"
				}
			]
		},
