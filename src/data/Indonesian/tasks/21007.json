			},
			"dialogs": [
				{
					"id": 210070501,
					"content": "Mereka telah pergi... semuanya telah pergi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070502
					],
					"speakerTitle": "Yuan Hong"
				},
				{
					"id": 210070502,
					"content": "Yuan Qing, Yuan Liang, Yuan Cheng... anak-anak yang bodoh. Kalian perhatikan lagi dengan seksama dan pikirkan lagi dengan baik-baik...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yuan Hong"
				}
			]
		},
		{
			"id": 2100706,
			"completionStepIds": [
				2100710
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
