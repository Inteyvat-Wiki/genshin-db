			},
			"dialogs": [
				{
					"id": 210070201,
					"content": "Sial! Sial! Apa yang kulakukan untuk mendapatkan ini semua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070202
					],
					"speakerTitle": "Yuan Qing"
				},
				{
					"id": 210070202,
					"content": "Susah payah berhasil menyelinap pergi saat mereka lengah biar aku bisa menjadi yang pertama untuk sampai ke tambang dan menemukan harta karun... Tapi dari mana semua monster ini berasal!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070203
					],
					"speakerTitle": "Yuan Qing"
				},
				{
					"id": 210070203,
					"content": "Sial! Sial...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yuan Qing"
				}
			]
		},
