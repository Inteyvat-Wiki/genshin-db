			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yuan Qing"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210070601,
					"content": "Hei, lihat! Mereka adalah orang-orang yang tadi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210070602,
					"content": "Pohon yang berdiri sendiri tidak memiliki hutan sebagai rumahnya... Haha, memang benar, aku tidak bisa melakukan apa pun sendirian...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070603
					],
					"speakerTitle": "Yuan Qing"
				},
				{
					"id": 210070603,
					"content": "Daun musim gugur merah yang indah, akan memisahkan diri dengan dahan pohon meskipun tidak ada angin menghembusnya... Kalau saja aku memercayai perkataan saudara dan ayahku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070604
					],
					"speakerTitle": "Yuancheng"
				},
				{
					"id": 210070604,
					"content": "Daun musim gugur jatuh dan diterbangkan angin... Demi harta karun, kehilangan segalanya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070605
					],
					"speakerTitle": "Yuanliang"
				},
				{
					"id": 210070605,
					"content": "Pohon harus memadukan akar dan bayangan mereka... Anak-anak, kita semua seharusnya adalah satu keluarga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070606
					],
					"speakerTitle": "Yuan Hong"
				},
				{
					"id": 210070606,
					"content": "Kalian serius berpikir aku akan menyembunyikan harta karun di tambang? *huff*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070607
					],
					"speakerTitle": "Yuan Hong"
				},
				{
					"id": 210070607,
					"content": "Tapi, aku mana punya harta karun... Apakah kalian masih ingat pohon yang kita tanam bersama sebagai sebuah keluarga ketika kalian masih muda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070608
					],
					"speakerTitle": "Yuan Hong"
				},
				{
					"id": 210070608,
					"content": "Aku datang ke sini setiap tahun untuk menguburkan sesuatu di dalamnya, dengan harapan saat kalian telah tumbuh dewasa, kita sekeluarga akan menggalinya bersama lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070609
					],
					"speakerTitle": "Yuan Hong"
				},
				{
					"id": 210070609,
					"content": "Ketika saatnya tiba, kita akan menggunakan barang-barang di dalamnya untuk membeli beberapa makanan lezat, dan sebotol anggur... merayakannya bersama, sebagai keluarga... berbicara tentang masa lalu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070610
					],
					"speakerTitle": "Yuan Hong"
				},
				{
					"id": 210070610,
					"content": "Oh anak-anak, anak-anakku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yuan Hong"
				}
			]
		}
	]
}