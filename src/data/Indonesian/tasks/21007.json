			},
			"dialogs": [
				{
					"id": 210070401,
					"content": "Hehehe... Harta karunnya akan menjadi milikku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070402
					],
					"speakerTitle": "Yuanliang"
				},
				{
					"id": 210070402,
					"content": "Saudara-saudaraku benar-benar bodoh, mereka melarikan diri setelah menemukan beberapa kalimat, hehehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070403
					],
					"speakerTitle": "Yuanliang"
				},
				{
					"id": 210070403,
					"content": "Hormati kehendak ayah? Huh! Hanya satu baris yang layak dibaca dalam kalimat tersebut yaitu tentang harta yang ada di tambang... Semuanya akan segera menjadi milikku! Hehehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yuanliang"
				}
			]
		},
