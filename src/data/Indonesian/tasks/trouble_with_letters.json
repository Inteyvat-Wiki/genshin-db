					"nextDialogs": [
						411260803
					]
				},
				{
					"id": 411260803,
					"content": "Surat dari Papa untukku? Ah, sepertinya aku tahu apa isinya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260804
					],
					"speakerTitle": "Little Liu"
				},
				{
					"id": 411260804,
					"content": "Dia pasti bilang kalau dia tidak bisa menemaniku karena pekerjaan, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260805
					],
					"speakerTitle": "Little Liu"
				},
				{
					"id": 411260805,
					"content": "Saat pak prajurit Millelith itu datang ke sini, kukira Papa datang bersamanya. Ternyata dia tidak datang juga...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260806
					],
					"speakerTitle": "Little Liu"
				},
				{
					"id": 411260806,
					"content": "Mungkin ini hal yang bagus... Kalau batu-batu ini berjatuhan saat Papa sedang di luar sana, Papa bisa celaka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260807,
						411260809
					],
					"speakerTitle": "Little Liu"
				},
				{
					"id": 411260807,
					"content": "Apakah kamu takut?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411260808
					]
				},
				{
					"id": 411260808,
					"content": "Emmm, sedikit. Tapi kita pasti akan baik-baik saja karena ada pak prajurit Millelith di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260811
					],
					"speakerTitle": "Little Liu"
				},
				{
					"id": 411260811,
					"content": "Oh iya! Bolehkah kamu menyampaikan surat ini ke Papa? Dia pasti khawatir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260812
					],
					"speakerTitle": "Little Liu"
				},
				{
					"id": 411260812,
					"content": "Ah, aneh sekali. Kenapa setiap kali Papa bilang mau pulang dan menemaniku, pasti ada masalah yang muncul...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Little Liu"
				},
				{
					"id": 411260809,
					"content": "Jangan pergi ke luar ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411260810
					]
				},
				{
					"id": 411260810,
					"content": "Aku tahu kok. Pak prajurit itu sudah memperingatkanku beratus-ratus kali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260811
					],
					"speakerTitle": "Little Liu"
				}
			]
