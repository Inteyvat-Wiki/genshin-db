			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jiayi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411260101,
					"content": "Aduh, bagaimana ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260102
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260102,
					"content": "Apa yang terjadi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411260103
					]
				},
				{
					"id": 411260103,
					"content": "Kamu pasti juga sudah melihat meteorit yang jatuh dari langit itu kan? Meskipun dalam kota masih aman, tetapi bagian luar kota sudah hancur berantakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260104
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260104,
					"content": "Apalagi banyak jalanan yang tertutup oleh batu meteorit itu, para monster juga terkena dampak dari meteorit dan menjadi lebih ganas. Mereka menyerang para pejalan kaki dan pedagang di mana-mana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260105
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260105,
					"content": "Bagian Urusan Sipil sudah mengutus semua prajurit Millelith yang ada, tapi Liyue terlalu besar. Kita hanya bisa menjaga beberapa jalur utama dan desa-desa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260106
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260106,
					"content": "Aku sudah mendaftar untuk menjaga Desa Qingce, tetapi entah kenapa... Aku masih disuruh bersiap siaga di sini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260107
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260107,
					"content": "Pengembara, apakah kamu bisa membantuku untuk memberikan surat ini ke gadis bernama Little Liu di Desa Qingce?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260108
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260108,
					"content": "Dia adalah anakku, aku berjanji akan pulang dan menemaninya beberapa hari. Tetapi karena banyak masalah darurat, aku belum bisa pulang sekarang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260109,
						411260111
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260109,
					"content": "Baiklah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411260110
					]
				},
				{
					"id": 411260110,
					"content": "Tolong bantuanmu ya. Ah, banyak sekali masalah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260115
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260115,
					"content": "Oh iya, kata orang-orang yang baru saja kembali dari sana, ada banyak monster yang berkumpul di sekitar Desa Qingce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260116
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260116,
					"content": "Ah... permisi. Melihat dari pakaianmu, kamu adalah seorang petualang, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260117
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260117,
					"content": "Saat kamu mengirimkan suratku, bolehkah kamu sekalian membereskan monster-monster yang ada di sekitar Desa Qingce?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260118
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260118,
					"content": "Kebanyakan pasukan Millelith hanya berjaga di jalan utama dan jalur penting. Akan gawat sekali kalau monster-monster itu sampai masuk ke Desa Qingce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260119,
						411260121
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260119,
					"content": "Baiklah...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411260120
					]
				},
				{
					"id": 411260120,
					"content": "Terima kasih, kuserahkan padamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260121,
					"content": "Ini termasuk tugas tambahan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411260122
					]
				},
				{
					"id": 411260122,
					"content": "Oh, jangan khawatir, aku pasti akan memberikanmu imbalan yang setimpal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260123
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260123,
					"content": "Mohon bantuanmu ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260111,
					"content": "Ini bukan salahmu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411260112
					]
				},
				{
					"id": 411260112,
					"content": "Aku tahu, tapi... Setiap kali aku ingin mengambil cuti, pasti ada saja masalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260113
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260113,
					"content": "Kebetulan sekali, apa nasibku memang sial...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260114
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260114,
					"content": "Kalau begitu kuserahkan padamu, tolong sampaikan suratku ke Little Liu di Desa Qingce ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260115
					],
					"speakerTitle": "Jiayi"
				}
			]
		},
