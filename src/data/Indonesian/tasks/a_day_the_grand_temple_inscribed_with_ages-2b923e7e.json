			"dialogs": [
				{
					"id": 760950101,
					"content": "#{NICKNAME}, Paimon ... terima kasih. Aku beruntung sekali bisa bertemu kalian di saat-saat terakhir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950102
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950102,
					"content": "Hehe. Malah Paimon rasa kamu terseret ke dalam masalah ini karena kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950103,
					"content": "Tunggu, \"akhir\"? Apa maksudmu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950104,
					"content": "Meskipun semuanya adalah petualangan yang cukup berbahaya, tapi aku juga melihat banyak hal yang luar biasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950105
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950105,
					"content": "Lumayan juga sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950106
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950106,
					"content": "Hei! Jangan hindarin pertanyaannya dong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950107,
					"content": "Masa sih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zeitlind"
				}
			]
		},
