			"dialogs": [
				{
					"id": 760950501,
					"content": "Sudah istirahat? Apa kamu sudah bicara dengan semua orang yang kamu mau ajak bicara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950502,
						760950504
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950502,
					"content": "Belum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760950503
					]
				},
				{
					"id": 760950503,
					"content": "Istirahatlah dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950506
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950506,
					"content": "Zeitlind, tenang dan dengarkan aku dulu. Aku tidak bermaksud untuk bersikap tidak sopan atau memberi harapan buta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950507
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950507,
					"content": "Kakakmu mungkin masih hidup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950508
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950508,
					"content": "Tapi aku sudah lihat batu nisannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950509
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950509,
					"content": "Ada fotonya di batu nisan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950510
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950510,
					"content": "Tapi, di bawah batu nisan itu juga mungkin kosong, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950511
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950511,
					"content": "Paimon sih pengennya itu beneran, tapi rasanya kelewat optimis ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950512,
					"content": "Dalam surat terakhir yang dia tulis untukku, dia bilang dia bertekad untuk ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950513
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950513,
					"content": "Kalimat perpisahannya bukan \"selamat tinggal\", kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950514
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950514,
					"content": "Dia bilang dia akan pergi ke tempat yang jauh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950515
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950515,
					"content": "Dia pernah bilang kalau cita-citanya adalah keliling dunia sebelum dia tua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950516
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950516,
					"content": "Hilda tidak berbicara secara kiasan. Dia meninggalkan sanatorium dan pergi keliling dunia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950517
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950517,
					"content": "Dia pernah bilang begitu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950518
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950518,
					"content": "Dia selalu terlihat ceria dan senang bergaul dengan semua orang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950519
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950519,
					"content": "Kalau begitu, dia pasti belum pernah memberitahumu kalau kami tidak punya anggota keluarga lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950520
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950520,
					"content": "Ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950521
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950521,
					"content": "Izinkan aku untuk menebak dengan cara yang paling objektif.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950522
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950522,
					"content": "Jika kepergiannya menyakiti tiga atau empat orang, maka beban itu mungkin akan melampaui kesedihannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950523
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950523,
					"content": "Tapi sekarang hanya tersisa aku sendiri. Dia tahu aku mengerti dan akan memaafkannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950524
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950524,
					"content": "Bukan begitu, kamu harusnya tidak berpikir seperti itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950525
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950525,
					"content": "Kamu tidak perlu merasa kasihan padaku. Waktu kecil ketika orang tua kami masih ada, hidup kami terasa sangat indah. Kenangan-kenangan itu sudah cukup untuk membimbing kami tumbuh dewasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950526
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950526,
					"content": "Tapi, tumbuh dewasa di dunia ini memang sangat sulit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950527
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950527,
					"content": "Sejak kecil aku memang lebih tertutup, dan berinteraksi dengan orang-orang di tempat kerja itu sangat melelahkan. Awalnya kukira kakakku yang pandai bergaul akan lebih mudah menjalani hidupnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950528
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950528,
					"content": "Namun, bahkan dia pun selalu terlihat lelah setelah tumbuh dewasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950529
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950529,
					"content": "Ugh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950530
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950530,
					"content": "Kalian berdua masih punya masa depan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950531
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950531,
					"content": "Oh, sepertinya dia juga belum pernah bercerita tentang tunangannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950532
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950532,
					"content": "Tunangannya hanyalah orang biasa yang ramah dan menarik. Terkadang aku pikir, kenapa sifat dia baik ya? Andai saja dia orang yang jahat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950533
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950533,
					"content": "Keluarganya punya penyakit keturunan yang aneh, yaitu penyakit berumur pendek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950534
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950534,
					"content": "Dia sering bercanda tentang itu, menyalahkan Archon Anemo karena membangun Mondstadt dengan baik, sehingga keluarga seperti mereka pun tidak pernah terlupakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950535
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950535,
					"content": "Suatu hari, dia bilang dia akan menyelamatkan dunia, lalu dia pun pergi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950536
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950536,
					"content": "Menyelamatkan dunia ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950537
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950537,
					"content": "Dunia kita masih terus berputar, mungkin saja dia benar-benar menyelamatkan dunia dari tempat yang tidak diperhatikan oleh orang-orang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950538
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950538,
					"content": "Kalian sering dengar kan, \"Sepanjang waktu ini, jika seseorang tidak bisa mencintai semua orang, lalu dicintai semua orang, dunia akan tenggelam dalam kesedihan\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950539
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950539,
					"content": "Menurutku masuk akal. Hidup yang singkat tidak pantas dicintai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950540
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950540,
					"content": "Dia ingin mengorbankan nyawanya untuk mencintai, tapi malah lebih menyakiti kakakku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950541
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950541,
					"content": "Saking parahnya, dia sampai dikirim ke sanatorium di pegunungan, tepat di bawah kaki kita sekarang ini. Sebuah tempat yang dipenuhi dengan kutukan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950542
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950542,
					"content": "Dia tidak pernah memberitahuku hal ini. Maafkan aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950543
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950543,
					"content": "Setelah mendengar ini semua, apakah kamu masih berpikir bahwa kakakku masih hidup?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950544
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950544,
					"content": "Masih, karena dia melakukan sesuatu di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950545
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950545,
					"content": "Karena ketakutanku, dia terpaksa harus terus hidup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950546
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950546,
					"content": "Aku sangat menghormatimu, Istoria. Tapi menurutku, mungkin kamu sudah melihat banyak penderitaan dalam sejarah yang panjang ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950547
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950547,
					"content": "Rasa sakit yang mampu menenggelamkan dunia ... bagi orang biasa seperti aku, sebagian kecil dari rasa sakit itu pun sudah cukup untuk mengubur hidupku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950548
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950548,
					"content": "Kamu tidak akan bisa memahamiku dan kakakku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950549
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950549,
					"content": "Jadi, bagaimana caranya agar aku bisa kembali ke atas? Aku hanyalah makhluk kecil yang menjalani hidup singkat, dan tidak pantas mendapatkan keabadian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950550
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950550,
					"content": "*huff*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950551
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950551,
					"content": "Tuan Istoria?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950552
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950552,
					"content": "Dulunya dunia ini benar-benar terisolasi dari dunia di atas. Tempat ini tidak ada jalan masuk atau keluar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950553
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950553,
					"content": "Namun setelah Nihilita jatuh, Dex sepertinya memperoleh kemampuan untuk membawa orang-orang dari dunia antara Pillar Hall dan permukaan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950554
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950554,
					"content": "Tapi, dia tidak bisa membawa orang yang terpilih untuk datang ke sini. Dia adalah bentuk paling awal dari Watcher, dan keterbatasan itu adalah bagian darinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950555
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950555,
					"content": "Hah? Maksudmu Dex itu sama kayak Nihilita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950556
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950556,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950557
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950557,
					"content": "Kalau kita mau kembali ke bawah, hanya dengan melepaskan semua ingatan yang kita miliki dan mendaki sampai ke puncak. Kalau dulu, kita akan bertemu dengan Nyonya. Sekarang, kita mungkin akan bertemu dengan Melanta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950558
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950558,
					"content": "Jadi aku tidak bisa pergi bersama kalian. Tapi setidaknya, izinkan aku mengantar kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950504,
					"content": "Iya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760950505
					]
				},
				{
					"id": 760950505,
					"content": "Baiklah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950506
					],
					"speakerTitle": "Istoria"
				}
			]
		},
