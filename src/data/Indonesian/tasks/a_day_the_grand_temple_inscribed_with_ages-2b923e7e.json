				]
			},
			"dialogs": [
				{
					"id": 760950301,
					"content": "Istoria, sekarang ketiga area ini sudah bebas, dan hampir semua orang juga sudah selamat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950302,
					"content": "Dan kita bahkan ketemu semua barang Zeitlind yang hilang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950303,
					"content": "Oh, terima kasih banyak! Harus kuakui, Nihilita ternyata punya selera yang bagus setelah dia membuka matanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950304
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950304,
					"content": "Sekarang giliranmu! Kasih tahu kami cara dan harga buat naik ke atas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950305,
					"content": "Kalau cuma bertualang atau habiskan sedikit Mora, Paimon enggak takut!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950306,
					"content": "Terus gimana cara kita antar Zeitlind ke bawah? Urusannya kan sudah beres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950307,
					"content": "Tidak masalah, tapi kalian istirahatlah dulu. Besok aku akan menjelaskan semuanya secara detail.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950308
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950308,
					"content": "Oke. Tapi ... di sini enggak ada tempat tidur, makanan pun enggak ada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950309,
					"content": "Di sini, kebutuhan seperti itu tidak ada. Apa kamu menyadarinya? Kamu sudah berada di sini begitu lama, tapi kamu tidak lapar dan mengantuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950310
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950310,
					"content": "Hah? Lalu Paimon harus ngapain dong selama istirahat seharian?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950311,
					"content": "Di sini ada banyak orang-orang hebat dari berbagai era, kurasa akan menarik kalau kalian ajak mereka berbincang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950312
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950312,
					"content": "#Oke, tapi Paimon tetep bakal tidur kapan pun Paimon mau. Capek atau enggak, Paimon tetap tidur di atas kepala {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950313,
					"content": "Zeitlind, setelah kamu beristirahat, aku ingin bahas hal yang kusebutkan sebelumnya, yang perlu aku pertimbangkan dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950314
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950314,
					"content": "Nanti kita berbincang sebentar ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950315
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950315,
					"content": "Oke.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950316
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950316,
					"content": "#{NICKNAME}, Paimon. Tolong temui aku setelah kalian sudah beristirahat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Istoria"
				}
			]
		},
