				"points": []
			},
			"dialogs": [
				{
					"id": 205040301,
					"content": "<color=#00E1FFFF>Anemo Sigil</color> dapat muncul di mana saja sekitar Mondstadt. Jika kamu merasa kurang, teruslah mencari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040302
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040302,
					"content": "Apa ini benar-benar hanya untuk dekorasi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205040303
					]
				},
				{
					"id": 205040303,
					"content": "Iya! Bagaimanapun juga ini adalah hadiah dari Archon Anemo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 205040304,
					"content": "Haha, baiklah, aku ketahuan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040305
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040305,
					"content": "Sebenarnya penjelasannya lebih rumit, tapi akan lebih mudah bagi orang untuk mengerti jika kita bilang untuk dekorasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040306
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040306,
					"content": "Tentu saja alasanku butuh <color=#00E1FFFF>Anemo Sigil</color> adalah karena mereka memiliki kegunaan yang tidak bisa dipenuhi oleh bahan yang lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040307,
						205040309
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040307,
					"content": "Biarkan aku melihatnya setelah selesai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205040308
					]
				},
				{
					"id": 205040308,
					"content": "Haha, tentu saja, aku yakin kamu pasti terkejut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040312
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040312,
					"content": "Datanglah lagi lain kali dan bawakan aku lebih banyak <color=#00E1FFFF>Anemo Sigil</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040313
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040313,
					"content": "Jika kamu menemukan harta karun yang langka, jangan lupa untuk menemuiku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040309,
					"content": "Hmm... misterius sekali ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205040310
					]
				},
				{
					"id": 205040310,
					"content": "Tapi sekarang aku jadi benar-benar penasaran...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 205040311,
					"content": "Haha, aku harus menjaga kerahasiaannya agar tetap membuat orang penasaran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040312
					],
					"speakerTitle": "Marjorie"
				}
			]
		}
	]
}