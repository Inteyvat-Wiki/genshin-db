			},
			"dialogs": [
				{
					"id": 790080101,
					"content": "Seharusnya sih ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790080102
					],
					"speakerTitle": "Periksa"
				},
				{
					"id": 790080102,
					"content": "Hmm? Sepertinya ada surat di sebelahnya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790080103
					],
					"speakerTitle": "Periksa"
				},
				{
					"id": 790080103,
					"content": "Kepada teman yang beruntung menemukan tempat ini,",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790080104
					],
					"speakerTitle": "Periksa"
				},
				{
					"id": 790080104,
					"content": "Halo, teman dari tempat jauh. Kalau kamu membaca surat ini, berarti kamu telah menemukan harpastum yang kusimpan di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790080105
					],
					"speakerTitle": "Periksa"
				},
				{
					"id": 790080105,
					"content": "Golden Apple Archipelago penuh dengan permainan yang berhubungan dengan harpastum. Aku dan teman-temanku menghabiskan musim panas yang indah di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790080106
					],
					"speakerTitle": "Periksa"
				},
				{
					"id": 790080106,
					"content": "Karena itu, kusimpan harpastum yang kubuat sendiri di sini, dengan harapan agar kamu yang menemukannya juga bisa menikmati kegembiraan yang sama sepertiku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790080107
					],
					"speakerTitle": "Periksa"
				},
				{
					"id": 790080107,
					"content": "Nikmati sinar matahari, angin laut, dan permainan musim panas sepuasnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790080108
					],
					"speakerTitle": "Periksa"
				},
				{
					"id": 790080108,
					"content": "—Barbara",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790080109
					],
					"speakerTitle": "Periksa"
				},
				{
					"id": 790080109,
					"content": "Bar-ba-ra! Sekarang kita jadi punya harpastum! Ayo main!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Periksa"
				}
			]
		},
