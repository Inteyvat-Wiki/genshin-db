			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Aberaku"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722480301,
					"content": "Datang lagi salah satu rohnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722480302,
					"content": "Namaku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480303
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480303,
					"content": "Aberaku, sang pencipta Helios!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480304
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480304,
					"content": "Bagaimana mungkin aku bisa terjebak oleh kata-kata dustamu, atau dikurung oleh boneka bayi!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480305
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480305,
					"content": "Aku ... Tidak, tunggu. Aku sudah dikurung selama bulan dan tahun yang tidak terhitung lagi, benar? Maka ini ... pasti adalah wujudku setelah kematian?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480306
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480306,
					"content": "Wujud setelah kematian? Maksudnya kamu sudah mati ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722480307,
					"content": "Jarang-jarang roh bisa sadar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722480308,
					"content": "Meskipun aku malu mengakuinya, tapi aku tidak tahu bagaimana aku meninggal ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480309
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480309,
					"content": "Yang kuingat hanyalah ... aku dikurung atas perintah seorang anak kecil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480310
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480310,
					"content": "Anak kecil?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722480311,
					"content": "Benar sekali. Tapi sampai hari ini, aku tidak memendam kebencian untuk anak itu, hanya rasa kasihan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480312
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480312,
					"content": "Bukan salahnya. Yang harusnya disalahkan adalah orang-orang yang mengendalikannya bagaikan boneka ... Lupakan saja. Beberapa hal lebih baik tidak diucapkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480313
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480313,
					"content": "Setelah itu, aku pun dikurung ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480314
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480314,
					"content": "Dikurung di ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480315
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480315,
					"content": "Di ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722480316,
					"content": "Tempat yang sangat tinggi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480317
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480317,
					"content": "Meskipun tinggi, tapi tempatnya sangat gelap, tanpa cahaya, dan sedingin es.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480318
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480318,
					"content": "Aneh ... Kenapa begitu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480319
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480319,
					"content": "Kenapa aku bisa merasa kalau tempat tinggi seharusnya membawakan kehangatan dan kenyamanan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480320
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480320,
					"content": "Kenapa ... Kenapa aku tidak bisa mengingatnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480321
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480321,
					"content": "Mungkin kamu lapar kali?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722480322,
					"content": "Kalau Paimon lagi lapar ya ... jangankan berpikir, bicara aja susah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480323,
						722480325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722480323,
					"content": "Kayaknya masalah dia beda deh ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722480324
					]
				},
				{
					"id": 722480324,
					"content": "Sudah pasti ah! Lihat saja, dia juga susah bicara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722480327,
					"content": "#Tapi, {NICKNAME}, coba cari deh, siapa tahu ada yang bisa dimakan di antara barang penyerahannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480328
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722480328,
					"content": "Tunggu! Itu dia! Barang penyerahannya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480329
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480329,
					"content": "Kenapa? Mau kamu makan ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480330
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722480330,
					"content": "Tidak, aku baru saja ingat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480331
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480331,
					"content": "Waktu aku meninggal di dalam penjara itu, pakaian dan tubuhku dikeramatkan di berbagai tempat karena kontribusiku dalam menciptakan Helios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480332
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480332,
					"content": "Tapi karena itu juga jiwaku jadi terpisah-pisah dan tidak bisa beristirahat dengan tenang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480333
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480333,
					"content": "Harusnya di sini adalah tempat peristirahatan mahkota suciku, tapi pasti benda itu sudah rusak sejak lama. Pasti itulah alasan mengapa pikiranku ... menjadi buntu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480334
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480334,
					"content": "Kalau seperti ini terus, kurasa wujudku sekarang juga tidak bisa bertahan lama ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480335
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480335,
					"content": "Tapi barang-barang seserahan ini bisa menggantikan sisa-sisa tubuh dan pakaianku, untuk mempertahankan sisa pikiranku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480336
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480336,
					"content": "Maka dari itu, tolong bawalah bersamamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480337
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480337,
					"content": "Tapi, akan ada banyak bahaya menghadang di perjalanan ke sana. Meskipun terdengar tidak sopan, bisakah kamu melewati ujian ini terlebih dahulu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480338
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480338,
					"content": "Ujian? Ujian apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480339
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722480339,
					"content": "Tolong kalahkan monster-monster di ini, kalahkanlah mereka yang mengurung jiwaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480340
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480340,
					"content": "Hal ini sangat berbahaya. Beri tahu aku jika kamu telah siap, wahai Pengembara, lalu akan kita mulai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480325,
					"content": "Wah, kebetulan kita punya makanan darura——",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722480326
					]
				},
				{
					"id": 722480326,
					"content": "Hei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480327
					],
					"speakerTitle": "Paimon"
				}
			]
		},
