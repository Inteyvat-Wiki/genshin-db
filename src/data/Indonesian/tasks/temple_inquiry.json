					"Aberaku",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722480201,
					"content": "Ah, andai saja Byakuyakoku memiliki pejuang tangguh sepertimu! Maka ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480202
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480202,
					"content": "*huff* Jika hal ini telah selesai, maka harapanku telah tercapai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480203
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480203,
					"content": "Bawalah barang-barang yang berisi kehendakku ini untuk dikeramatkan ... di tempat diriku dulu ditahan. Ini harus dilakukan, supaya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480204
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480204,
					"content": "Untuk apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722480205,
					"content": "Karena ... karena ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480206
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480206,
					"content": "Agh, sepertinya tidak ada gunanya bicara dengannya sekarang. Jiwanya sudah berantakan lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722480207,
					"content": "#{NICKNAME}, ayo kita bawa saja barang-barang itu dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722480208,
					"content": "Tapi di mana yang tempat tingginya? Tempat orang ini dikurung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7224803,
			"completionStepIds": [
				7224805
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7224805",
							"2"
						],
						"stepId": 7224805,
