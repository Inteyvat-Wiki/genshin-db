			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105020101,
					"content": "Sebentar lagi kita akan bertemu ahli waris itu, apakah kalian sudah siap? Jangan mempermalukan gurumu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020102,
						105020103
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020102,
					"content": "Aku kan tidak bisa meramal...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020104
					]
				},
				{
					"id": 105020104,
					"content": "Iya juga... eh, tidak! Meskipun kamu murid palsu, jangan sampai tidak tahu apa-apa juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020105
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020105,
					"content": "Meski ada peraturan yang tidak memperbolehkan kita mengajar orang luar, tapi... kalau kamu, tidak masalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020106
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020106,
					"content": "Teknik ramalanku adalah \"ramalan air\". Sesuai namanya, aku melihat langit berbintang melalui pantulan di atas air.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020107
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020107,
					"content": "Sini kutunjukkan, perhatikan baik-baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020108
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020108,
					"content": "Dilihat dari perbintangan saat ini, ahli warisnya adalah seorang Knight angin barat, muda... seorang wanita...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020109
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020109,
					"content": "Mendengar deskripsi ini... cocok dengan Lisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020110,
					"content": "Kita akan segera bertemu dengannya di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020111
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020111,
					"content": "Baiklah, harusnya informasi segini sudah cukup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020112,
						105020113
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020112,
					"content": "Su, sudah? Begitu saja?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020114
					]
				},
				{
					"id": 105020114,
					"content": "Sayang sekali, tampaknya ramalan yang mendasar pun tidak begitu jelas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020115
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020115,
					"content": "Sudahlah, aku akan menjelaskannya dengan lebih rinci lagi nanti. Dia sudah datang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020116
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020116,
					"content": "Wah, Kakak Honorary Knight dan Paimon! Kalian sudah kembali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020117
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020117,
					"content": "-Itu dia! Ahli pewaris yang maha kuasa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020118,
						105020119
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020118,
					"content": "...Kamu sedang bicara tentang Klee?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020120
					]
				},
				{
					"id": 105020120,
					"content": "Ahli waris...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020121
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020121,
					"content": "Benar, aku adalah peramal telah mengungkapkan rahasia lautan bintang! Kamu pun pasti sudah tahu kedatanganku ke sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020122
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020122,
					"content": "Lautan bintang? Apa itu? Apakah ada ikan di dalam lautan bintang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020123
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020123,
					"content": "Ikan...? Bukan, jangan pura-pura bodoh. Apakah kamu takut akan tantanganku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020124
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020124,
					"content": "Kakak, kamu sedang bicara apa! Aku tidak mengerti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020125,
						105020126
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020125,
					"content": "Kalau begini tidak akan ada habisnya!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020127
					]
				},
				{
					"id": 105020127,
					"content": "Tapi ramalanku tidak akan salah... jaga-jaga saja, apakah nama ibumu Alice?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020128
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020128,
					"content": "Iya. Oh! Kakak adalah teman ibu ya. Tapi, ibu sudah pergi ke tempat yang jauh sekarang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020129
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020129,
					"content": "Ini hasil ramalan. Tapi sebelum dia pergi, bukankah dia seharusnya mengajarkanmu tentang ilmu yang dia ketahui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020130
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020130,
					"content": "Ilmu, pengetahuan... tidak mengerti, ibu hanya mengajarkanku cara membuat bom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020131
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020131,
					"content": "Ternyata ibu Klee adalah teman dan juga musuh Guru Mona?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020132,
					"content": "Ya. Meski guruku sangat ahli dalam bidang astrologi, tetapi dia hanya ahli di satu bidang itu saja. Alice berbeda, dia ahli dalam segala ilmu gaib...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020133
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020133,
					"content": "Jadi... karena Klee sangat kecil, mendengar ilmu yang sangat mendalam seperti itu juga tidak mengerti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020134,
					"content": "Ya. Sepertinya dia hanya mewarisi darahnya, bukan pengetahuannya... benar-benar salah perhitungan. Kalau begitu tidak jadi bertanding deh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020135
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020135,
					"content": "Oh iya, sebelum Alice pergi, apakah dia memberi tahumu tentang \"Janji 50 Tahun\" dan sebuah kotak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020136
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020136,
					"content": "Oh, oh, aku tahu tentang ini! Ternyata kakak ingin datang mengambil kotak itu ya. Aku cari dulu, tunggu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020137
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020137,
					"content": "Bukan ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020138
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020138,
					"content": "ini juga bukan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020139
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020139,
					"content": "Bukan bukan, bukan ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020140
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020140,
					"content": "Ah! Aku ingat, aku menyembunyikan kotak itu dan harta baruku di <color=#00E1FFFF>Windrise</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020141,
						105020142
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020141,
					"content": "Jangan bilang bom lagi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020143
					]
				},
				{
					"id": 105020143,
					"content": "Kalian tunggu sebentar, aku segera kembali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020144
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020144,
					"content": "Jangan lari! Apakah kamu tidak ingin semua barang-barang di dalam tasmu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020145,
					"content": "Aku akan membantunya membereskan ini, kalian sebaiknya mengikuti dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020146
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020146,
					"content": "Ah, melihat dia terburu-buru begitu, aku khawatir akan terjadi sesuatu dengan kotak itu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020142,
					"content": "Kenapa lagi-lagi mengubur hal-hal penting di alam liar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020143
					]
				},
				{
					"id": 105020126,
					"content": "Jadi memang benar-benar salah...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020127
					]
				},
				{
					"id": 105020119,
					"content": "Pasti salah!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020120
					]
				},
				{
					"id": 105020113,
					"content": "Belum jelas sama sekali!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020114
					]
				},
				{
					"id": 105020103,
					"content": "Aku kan tidak mengerti astrologi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020104
					]
				}
			]
		},
		{
