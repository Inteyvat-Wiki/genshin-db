			"dialogs": [
				{
					"id": 4870501,
					"content": "Prince benar-benar peka ya. Sedikit hal saja bisa mengagetkannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870502,
					"content": "Kalau kamu bisa mendekatinya dengan berjongkok <color=#00E1FFFF>dari belakang</color>, langkah kakimu tidak akan begitu terdengar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870503,
					"content": "Tidak bisa terbang itu merepotkan ya, hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870504,
					"content": "Kalau kamu tidak tenang begitu, kenapa tidak pakai <color=#00E1FFFF>Fish</color> saja? Itu makanan kesukaan Prince kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870505
					],
					"speakerTitle": "Paimon"
				},
				{
