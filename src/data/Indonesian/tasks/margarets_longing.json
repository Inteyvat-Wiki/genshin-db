			"dialogs": [
				{
					"id": 4871001,
					"content": "Prince~! Anak baik, aku tahu kamu pasti akan pulang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Margaret"
				},
				{
					"id": 4871002,
					"content": "Hosh... hosh... astaga, akhirnya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4871003,
					"content": "Oh, Prince, tega sekali kamu meninggalkan aku seperti itu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Margaret"
				},
				{
					"id": 4871004,
					"content": "Sepertinya mereka perlu waktu sendiri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4871005,
					"content": "Dilihat dari penampilanmu, sepertinya Prince benar-benar membuatmu mengejarnya dengan penuh kesulitan ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 4871006,
					"content": "Hahaha... jangan berkecil hati, walaupun tidak menangkapnya tapi setidaknya berkat usahamu, dia kembali ke sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 4871007,
					"content": "Dan~ senar besi astral ada bersamanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 4871008,
					"content": "Baiklah untuk mengungkapkan rasa terima kasihku biarkan aku menggunakan senar ini untuk menggelar konser pribadi untukmu! ...Ah, Ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 4871009,
					"content": "Ah apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4871010,
					"content": "Achoo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 4871011,
					"content": "Uhuk... haha... maaf, ketika aku dekat dengan Prince tadi, alergi kucingku jadi kambuh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 4871012,
					"content": "Ah, jadi itu sebabnya kamu tidak mencari senarmu sendiri tadi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4871013,
					"content": "Hehe, ngomong-ngomong, terima kasih atas bantuannya, aku akan pergi sekarang— a-achoo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
