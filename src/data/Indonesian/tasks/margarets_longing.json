			"dialogs": [
				{
					"id": 4870101,
					"content": "...jadi kucing yang hilang itu milikmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870102
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870102,
					"content": "Venti! Kamu juga mau ikut bantu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870103,
					"content": "Bantu? Kurasa, yang memerlukan bantuan itu sebenarnya aku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870104
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870104,
					"content": "Eh? Tapi tadi Paimon lihat kamu ngobrol dengan Margaret mengenai Prince...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870105,
					"content": "Oh, jadi Prince adalah nama makhluk yang mencuri <color=#00E1FFFF>senar besi astral</color> milikku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870106
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870106,
					"content": "Walaupun aku senang melihat para makhluk di Mondstadt berlarian begitu bebas... tapi tetap saja hal itu tidak dapat diterima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870107
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870108,
					"content": "Kamu bicara seperti orang tua yang selalu memanjakan anaknya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4870109
					]
				},
				{
					"id": 4870107,
					"content": "Ahaha, Prince benar-benar nakal ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870108
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 4870109,
					"content": "Seperti Barbatos saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870110,
					"content": "Ahaha, ya, itu... Ehem! Benar-benar perumpamaan yang bagus. Baiklah ayo kita cari Prince.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870111
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870111,
					"content": "Aku masih ada pertunjukan malam ini, tanpa senar itu, aku akan mengecewakan para penonton.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870112
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870112,
					"content": "Memangnya kucing mau apa sih dengan senar lira itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870113,
					"content": "Semua kucing menyukai bola benang dan senar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870114
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 4870114,
					"content": "Hah?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870115,
					"content": "Senar lira yang dibuat dari besi astral mengandung elemen Anemo. Ini membuat senar tersebut menjadi sangat tahan banting, jadi biasa aku menggulungnya seperti bola agar mudah dibawa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870116
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870116,
					"content": "Itulah rahasia dari seorang penyair petualang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870117
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870117,
					"content": "Eh? Senar itu mengandung elemen Anemo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870118,
					"content": "#Bagus sekali! Akhirnya ada petunjuk! {NICKNAME}, sekarang waktunya untuk menggunakan <color=#00E1FFFF>Elemental Sight</color> lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870119,
					"content": "Seharusnya ada jejak elemental atau sejenisnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870120,
					"content": "Prince seharusnya ada di sekitar area pertokoan, dia adalah seekor kucing berwarna hitam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Margaret"
				},
				{
					"id": 4870121,
					"content": "Ah, benar juga. Bawalah <color=#00E1FFFF>Fish</color> ini, makanan favorit Prince ini mungkin ini bisa membantumu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Margaret"
				}
			]
		},
