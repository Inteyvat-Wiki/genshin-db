			"dialogs": [
				{
					"id": 745300401,
					"content": "Ah, kamu sudah kembali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300402,
						745300403
					],
					"speakerTitle": "Kachina"
				},
				{
					"id": 745300402,
					"content": "Kachina kelihatannya lagi senang ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745300404
					]
				},
				{
					"id": 745300404,
					"content": "Hehe, kali ini aku berhasil menambang dan ketemu bijih yang bagus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300405
					],
					"speakerTitle": "Kachina"
				},
				{
					"id": 745300405,
					"content": "Kalau dipoles dengan baik, mungkin bisa jadi permata besar yang berkilau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300406
					],
					"speakerTitle": "Kachina"
				},
				{
					"id": 745300406,
					"content": "Bagus dong!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745300407
					]
				},
				{
					"id": 745300407,
					"content": "Iya! Sebelumnya aku tidak dapat apa-apa, hampir saja pulang dengan tangan kosong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300408
					],
					"speakerTitle": "Kachina"
				},
				{
					"id": 745300408,
					"content": "Tapi aku pikir, aku harus bertahan sebentar lagi ... jadi aku bilang pada diriku sendiri, aku harus gali sedikit lagi, sedikit lagi saja ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300409
					],
					"speakerTitle": "Kachina"
				},
				{
					"id": 745300409,
					"content": "Tidak tahu aku sudah ulang kata-kata tadi berapa kali, tapi akhirnya ketemu ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300410
					],
					"speakerTitle": "Kachina"
				},
				{
					"id": 745300410,
					"content": "Saat keluar, aku baru sadar kalau matahari hampir terbenam ... sepertinya aku tidak sadar sudah menggali seharian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300411,
						745300412
					],
					"speakerTitle": "Kachina"
				},
				{
					"id": 745300411,
					"content": "Tapi Kachina memang paling ulet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745300413
					]
				},
				{
					"id": 745300413,
					"content": "Eh? Ya-Yang benar? Aku ... kurang terbiasa di depan Kamera ... jadi tidak yakin hasilnya bagus loh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300414
					],
					"speakerTitle": "Kachina"
				},
				{
					"id": 745300414,
					"content": "Tapi ... aku berusaha sebisaku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300415,
						745300416
					],
					"speakerTitle": "Kachina"
				},
				{
					"id": 745300415,
					"content": "Kamu sudah melakukan yang terbaik kok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745300417
					]
				},
				{
					"id": 745300417,
					"content": "Ya! Aku paham. Aku serahkan padamu saja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kachina"
				},
				{
					"id": 745300416,
					"content": "Kachina, sudah bagus seperti ini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745300417
					]
				},
				{
					"id": 745300412,
					"content": "Aku boleh foto kamu yang lagi \"bersinar-sinar\" ini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745300413
					]
				},
				{
					"id": 745300403,
					"content": "Ada hal bagus yang terjadi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745300404
					]
				}
			]
		}
