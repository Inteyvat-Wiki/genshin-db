			},
			"dialogs": [
				{
					"id": 721110101,
					"content": "Ada apa, anak muda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110102
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110102,
					"content": "Kami menemukan buktinya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110103
					]
				},
				{
					"id": 721110103,
					"content": "Bukti? Bukti apa? Aku tidak mengerti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110104
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110104,
					"content": "Soal kejadian-kejadian aneh di desa. Tidak usah pura-pura lagi deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110105,
					"content": "Omong kosong! Kejadian aneh macam apa yang bisa terjadi di desa kami? Baiklah, tunjukkan padaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110106
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110106,
					"content": "#({NICKNAME}, mulai saja dari yang kita temukan di dekat sumur. Paimon serahkan padamu!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110107,
					"content": "Benda ini dari sumur kering di halaman belakang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
