				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Konda Densuke"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721110701,
					"content": "Ini... ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110702
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110702,
					"content": "Tidak bisa kupercaya aku begitu ceroboh ketika aku merusak kereta barangnya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110703
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110703,
					"content": "Wow, akhirnya kamu mengakuinya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110704,
					"content": "Aku tidak punya pilihan karena kamu sudah menyelidikinya sejauh ini. Aku tidak bisa menyembunyikannya lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110705
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110705,
					"content": "Kalau begitu seharusnya kamu punya ide apa yang telah terjadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110706
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110706,
					"content": "Ide yang sangat bagus! Kakek Densuke, kok kamu bisa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110707,
					"content": "Mencuri kereta barang Shogunate? Di tengah peperangan, kamu hancurin kereta barangnya dengan pukulanmu, terus barang-barangnya jatuh ke sungai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110708,
					"content": "Berharap bisa menyelamatkan diri mereka sendiri, orang-orang Shogunate melempar kantong koin mereka ke dalam sumur untuk mengalihkan perhatianmu! Untuk mencegah uangnya diambil orang lain, kamu jadi mengunci sumurnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110709,
					"content": "Begitu kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110710,
					"content": "Ah? Salah, bukan begitu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110711
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110711,
					"content": "Benarkah? Paimon baru saja mau tanya tentang kuncimu dan untuk Mora yang ada di bawah sumur itu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110712,
					"content": "...menyerah pada Shogunate! Benar! Mereka pasti akan pergi ke Shogunate!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110713,
					"content": "Ah, jadi situasinya begini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110714
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110714,
					"content": "Semula ada sekelompok anak muda di desa yang menjadi lancang setelah minum alkohol dan merampok kereta barang Shogunate. Barang dan kantong ini adalah milik Shogunate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110715
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110715,
					"content": "Aku merasa aib desa tidak boleh diketahui orang luar, karena itu aku membantu mereka menyembunyikannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110716
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110716,
					"content": "Kalau begitu mengakui diri sendiri yang menggelapkan kantong koin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110717,
					"content": "Demi menyembunyikan kebenaran kan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110718
					]
				},
				{
					"id": 721110718,
					"content": "Benar. Semula aku mengira jika berbuat begitu, kalian tidak akan menyelidiki lebih lanjut...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110719
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110719,
					"content": "Jika hanya aku seorang... Selama tidak melibatkan orang lain...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110720
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110720,
					"content": "Kumohon, jangan laporkan hal ini pada Shogunate. Ini bukan tentang harga diriku. Aku khawatir seluruh desaku akan terpengaruh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110721,
						721110724
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110721,
					"content": "Aku tidak tertarik untuk melaporkan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110722
					]
				},
				{
					"id": 721110722,
					"content": "Benar, kita tidak datang untuk hal ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110723
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110723,
					"content": "Baguslah kalau begitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110727
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110727,
					"content": "Hatiku sungguh tidak tenang karena melakukan hal ini, karena itu aku mencatat semuanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110728
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110728,
					"content": "Catatan itu aku buang ke atas atap. Jika kamu ingin membacanya, silakan cari sendiri. Tapi, jangan rusak atap yang baru saja aku perbaiki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110729
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110729,
					"content": "Tentang sumur yang terkunci...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110730
					]
				},
				{
					"id": 721110730,
					"content": "Iya, aku yang mengunci sumurnya. Aku juga sudah mencatat letak kuncinya di dalam buku catatan, coba kamu lihat sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110731
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110731,
					"content": "Mengenai penghalang di Desa Konda, apa Kakek Densuke tau sesuatu tentang penghalang itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110732
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110732,
					"content": "Penghalang? Wah orang-orang masih tau ya tentang legenda kuno itu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110733
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110733,
					"content": "Dikatakan bahwa pada zaman dahulu kala, ada akar Thunder Sakura yang berada tepat di bawah kita, yaitu salah satu dari lima akar yang melindungi pulau Narukami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110734
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110734,
					"content": "Dan tugas untuk menjaga penghalang tersebut dipercayakan oleh Kitsune Saiguu kepada kita, keluarga Konda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110735
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110735,
					"content": "Tapi ini hal yang sudah terjadi lama sekali, aku juga tidak begitu ingat dengan jelas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110724,
					"content": "Aku hanya ingin menyelidiki kebenaran...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110725
					]
				},
				{
					"id": 721110725,
					"content": "Benar, kita tidak datang untuk hal ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110726
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110726,
					"content": "Menyelidiki kebenaran? Hehe... Anak muda zaman sekarang sungguh menarik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110727
					],
					"speakerTitle": "Konda Densuke"
				}
			]
		},
