					"nextDialogs": [
						721110303
					]
				},
				{
					"id": 721110303,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110306
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110306,
					"content": "Bagaimanapun juga kamu tidak punya bukti apa pun yang bisa menunjukkan keterkaitan kedua benda ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110307
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110307,
					"content": "Mereka saling berkaitan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110308,
					"content": "Tidak masuk akal! Bagaimana mereka bisa saling berkaitan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110309
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110309,
					"content": "Kecuali ada semacam kode rahasia di Mora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110310
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110310,
					"content": "Tidak ada apa-apa kok di Mora, tapi ada sesuatu pada yang lainnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110311,
					"content": "Kami menemukannya di dekat puing-puing kereta barang...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 721110304,
					"content": "Aku menemukannya di cabang-cabang pohon di pintu masuk desa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110305
					]
				},
				{
					"id": 721110305,
					"content": "Bagaimana mungkin... tidak ada gunanya kamu mengujiku seperti itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110306
					],
					"speakerTitle": "Konda Densuke"
				}
			]
