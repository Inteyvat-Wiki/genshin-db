					"content": "Anak muda, jangan coba-coba membodohiku dengan hal-hal sembarangan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110503
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110503,
					"content": "Benda ini jatuh waktu hujan malam itu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7211106,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
