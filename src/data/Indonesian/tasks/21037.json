			},
			"dialogs": [
				{
					"id": 210370301,
					"content": "Terima kasih ya, ini sudah cukup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370302,
						210370305
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370302,
					"content": "Kok kamu ... enggak kelihatan senang?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370303
					]
				},
				{
					"id": 210370303,
					"content": "Hahaha, maaf, maaf. Aku bukan sengaja atau apa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370304
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370304,
					"content": "Tapi rasanya masih sedikit tidak rela pergi dari Liyue, rumahku selama bertahun-tahun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370305,
					"content": "Kapan berangkat?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370306
					]
				},
				{
					"id": 210370306,
					"content": "Kalau persediaan barangnya sudah siap semua, kami akan langsung berangkat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370307
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370307,
					"content": "Oh iya, petualang yang mengantarku ke Chasm juga bakal ikut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370308
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370308,
					"content": "Dia dengar kalau aku mau pergi ke Fontaine, dia jadi tertarik dan langsung mau ikut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370309
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370309,
					"content": "Pedagang itu sih senang-senang saja, ada tambahan petualang yang bisa melindungi dia. Tapi jujur saja, aku tidak begitu pandai berkomunikasi dengan orang yang ... semangatnya kayak dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370310
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370310,
					"content": "Tidak kusangka tiba harinya aku pergi jauh dari kampung halaman ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				}
			]
		},
		{
