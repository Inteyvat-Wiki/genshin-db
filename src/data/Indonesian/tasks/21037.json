					"Sun Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210370101,
					"content": "Liyue ... oh Liyue, entah kapan aku akan kembali lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370102
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370102,
					"content": "Kamu kenapa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370103
					]
				},
				{
					"id": 210370103,
					"content": "Ah, Pengembara! Ternyata kamu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370104
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370104,
					"content": "Jadi begini, jadwal perjalananku ke Fontaine sudah keluar, beberapa hari lagi aku akan berangkat dengan pedagang itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370105
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370105,
					"content": "Dia masih ada urusan. Jadi aku memanfaatkan waktu ini untuk memastikan tidak ada yang ketinggalan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370106,
						210370107
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370106,
					"content": "Kamu tidak mau ke Jueyun Karst lagi untuk terakhir kali?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370108
					]
				},
				{
					"id": 210370108,
					"content": "Haha, kalau jalan-jalan dulu, nanti aku malah menyesal pergi dari Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370109
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370109,
					"content": "Aku lihat-lihat pemandangan kota saja dari sini. Aku sudah tinggal di sini lama sekali, dan aku tidak tahu kapan bisa kembali lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370110
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370110,
					"content": "Oh ya, Que'er dia ... Akhirnya dia tidak mau ikut, tapi aku sudah minta tolong Zhiruo untuk menjagainya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370111
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370111,
					"content": "Aku juga sudah memberikan sebagian tabunganku kepadanya. Dia lebih pintar dariku, jadi pasti bisa jaga diri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370112
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370112,
					"content": "Dan mungkin suatu hari nanti ... dia akan mengerti keputusanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370113
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370113,
					"content": "Oh ya, Pengembara, boleh minta tolong sekali lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370114
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370114,
					"content": "Boleh bantu aku mengambil sedikit tanah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370115,
						210370116
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370115,
					"content": "Bisa sih ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370117
					]
				},
				{
					"id": 210370117,
					"content": "Ketika mau meninggalkan kampung halaman, wajar kalau mau bawa kenang-kenangan, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370118
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370118,
					"content": "Kalau aku pergi sambil bawa tanah Liyue, bisa dibilang aku tidak sepenuhnya berpisah dari tempat ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370119
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370119,
					"content": "Kenapa tidak ambil sendiri?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370120
					]
				},
				{
					"id": 210370120,
					"content": "Hahaha ... Seperti kubilang tadi, kalau aku jalan-jalan lagi di sekitar sini, pasti jadi teringat banyak kenangan manis ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370121
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370121,
					"content": "Kalau sudah begitu, takutnya tekadku untuk pergi langsung buyar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370122
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370122,
					"content": "Jadi aku terpaksa minta tolong padamu. Pengembara, kutandai lokasinya di petamu ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370123
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370123,
					"content": "Apa ada yang spesial dari tempat itu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370124
					]
				},
				{
					"id": 210370124,
					"content": "Ehem, dulu aku sering latihan pedang dengan Que'er di sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370125
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370125,
					"content": "Intinya, aku harus minta tolong padamu. Mohon bantuannya, Pengembara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370116,
					"content": "Tapi buat apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370117
					]
				},
				{
					"id": 210370107,
					"content": "Kamu tidak mau jalan-jalan di sekitar untuk terakhir kali?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370108
					]
				}
			]
		},
