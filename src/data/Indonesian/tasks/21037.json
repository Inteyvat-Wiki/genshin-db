				"points": []
			},
			"dialogs": [
				{
					"id": 210370401,
					"content": "Zhiruo, dia pasti sengaja kan ya?! Dia ... dia cuma tidak mau hidup bersamaku! Huhuhu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370402
					],
					"speakerTitle": "Little Que'er"
				},
				{
					"id": 210370402,
					"content": "Que'er, kamu kan sudah lama sekali ikut dia. Dia pasti mengerti sekali isi hatimu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370403
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 210370403,
					"content": "Kali ini, dia sudah membulatkan tekad untuk pergi dari Liyue. Dia pasti punya alasannya sendiri, kenapa kamu tidak ikut saja sama dia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370404
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 210370404,
					"content": "Pokoknya aku tidak mau pergi dari Liyue! Apa salahnya tinggal di sini selamanya? Klan Guhua ... aku tidak peduli sama Klan Guhua!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370405
					],
					"speakerTitle": "Little Que'er"
				},
				{
					"id": 210370405,
					"content": "Lalu kenapa kamu tidak bilang begitu ke dia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370406
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 210370406,
					"content": "Aku ... *huff* Dia sudah bertekad untuk membangkitkan kembali Klan itu. Kalau aku bilang begitu, dia pasti langsung benci padaku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370407
					],
					"speakerTitle": "Little Que'er"
				},
				{
					"id": 210370407,
					"content": "Hmm, Que'er ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiruo"
				}
			]
		},
