			},
			"dialogs": [
				{
					"id": 756510101,
					"content": "#Eh, {NICKNAME}, belakangan ini Paimon ngerasa misi-misi yang kita ambil capeknya bukan main.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510102,
					"content": "Makanya, sebagai pemandu yang baik hati dan budiman, Paimon wajib ngebantuin kamu relaksasi. Jeng jeng! Ini di mana coba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510103,
						756510105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510103,
					"content": "\"Damoville Purveyor\". Tuh, namanya segede gaban.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510104
					]
				},
				{
					"id": 756510105,
					"content": "Ah. Markas hamba uang, kuburan kantong uang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510106
					]
				},
				{
					"id": 756510104,
					"content": "Halo, halo. Selamat datang di Damoville Purveyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510107
					],
					"speakerTitle": "Boucicaut"
				},
				{
					"id": 756510106,
					"content": "Astaga, pelanggan yang terhormat. Mohon jangan berkata seperti itu tentang usaha kami ... Damoville Purveyor menjamin kualitas dan harga yang terjangkau! Silakan, lihat-lihat dulu barang dan harganya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510107
					],
					"speakerTitle": "Boucicaut"
				},
				{
					"id": 756510107,
					"content": "Ini bukan toko biasa. Di sini, insan-insan kelelahan yang habis kerja banting tulang bisa nyantai ... dengan cara buang duit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510108,
					"content": "Betul, betul sekali! Kebetulan, kami sedang ada promo beli satu gratis satu untuk semua pengunjung!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510109
					],
					"speakerTitle": "Boucicaut"
				},
				{
					"id": 756510109,
					"content": "Kamu beli — aku rugi, tidak beli — kamu rugi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510110
					],
					"speakerTitle": "Boucicaut"
				},
				{
					"id": 756510110,
					"content": "Hehe, Paimon sempat lihat brosurnya Damoville Purveyor tadi. Masih ingat isinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510111,
					"content": "Beli satu dapat dua itu untung, mau dihitung kayak gimana juga untung!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510112,
					"content": "Lagian, Paimon ngerasa ada yang kurang gitu kalau belum buang duit di sini ... Intinya, hari ini kita beresin tuh yang kurangnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510113,
						756510114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510113,
					"content": "Paimon mau beli apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510115
					]
				},
				{
					"id": 756510114,
					"content": "Terus yang kurangnya mau ditambahin apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510115
					]
				},
				{
					"id": 756510115,
					"content": "Hehe, rahasia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510116,
					"content": "Oh, mau bayar sendiri rupanya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510117
					]
				},
				{
					"id": 756510117,
					"content": "Santai, Paimon ada duit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510118,
					"content": "#Bos, pesanannya sudah datang belum? Atas nama \"Paimon dan {NICKNAME}\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510119,
					"content": "Ada, ada. Sebentar ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510120
					],
					"speakerTitle": "Boucicaut"
				},
				{
					"id": 756510120,
					"content": "Boucicaut si penjaga toko mengambil sesuatu yang bungkusannya berlapis-lapis sampai di luar nalar. Di sebelahmu, Paimon merogoh koceknya dan mengeluarkan uang receh, ditaruhnya di meja sampai jadi setumpuk besar. Di wajahnya yang mini timbul semburat kesedihan karena harus berpisah dengan uang yang cukup banyak jumlahnya.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						756510121
					]
				},
				{
					"id": 756510121,
					"content": "Kalian berdua membuka paket bersama-sama. Isinya ternyata dua album foto.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 756510122,
					"content": "Hehe! Akhirnya. Paimon sudah nungguin ini lamaaa banget.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510123,
					"content": "Dari dulu kita sudah jepret banyak banget foto. Sekarang jadi ada tempat buat simpan semuanya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510124,
					"content": "Lah, sejak kapan Paimon bisa pakai Kamera.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510125
					]
				},
				{
					"id": 756510125,
					"content": "Hehe, kamu enggak lihat bukan berarti Paimon enggak pernah foto ya! Nih, buktinya. Paimon punya koleksi foto kamu pas lagi meleng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510126,
						756510127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510126,
					"content": "Wah? Jadi kepo nih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510128
					]
				},
				{
					"id": 756510127,
					"content": "Mau lihat! Mana?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510128
					]
				},
				{
					"id": 756510128,
					"content": "Nanti! Kalau albumnya sudah penuh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510129,
						756510130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510129,
					"content": "Pret.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510131
					]
				},
				{
					"id": 756510130,
					"content": "Kikir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510131
					]
				},
				{
					"id": 756510131,
					"content": "Haaark, cuih! Sudah ah. Nih, yang ini buat kamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510132,
					"content": "Lebih tipis, tapi muat banyak foto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510133,
					"content": "Kita sudah ke mana-mana, sering juga bantuin orang berfoto, eh tapi kitanya sendiri malah jarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510134,
					"content": "Paimon kira bagus juga kan kalau kita juga punya sesuatu buat jadi kenang-kenangan. Makanya Paimon beli album.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510135,
					"content": "Ini ceritanya hadiah nih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510136,
					"content": "Iya. Beli satu gratis satu, jadi kita dapat seorang satu. Paimon sudah pikirin masak-masak sejak dari pertama pesan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510137,
					"content": "Langsung dipakai loh ya, awas kalau enggak! Foto tempat-tempat yang pernah kita datengin dulu juga oke, sekalian nostalgia dikit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510138,
					"content": "Kamu mau coba pake Kamera-nya Paimon enggak? Belum pernah, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510139,
					"content": "Pesan dan beli ini dari toko kelontong tuh enggak gampang ya prosedurnya. Harus sering-sering dipakai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510140,
						756510141
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510140,
					"content": "Iya, iya. Sini aku coba.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510142
					]
				},
				{
					"id": 756510141,
					"content": "Makasih ya, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510142
					]
				},
				{
					"id": 756510142,
					"content": "Hehe, bagus deh kalau suka. Pemandu yang baik tuh memang harusnya kayak gini~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510143
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510143,
					"content": "Yuk, kita foto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}