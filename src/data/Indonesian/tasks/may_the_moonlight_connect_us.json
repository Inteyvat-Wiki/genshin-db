						760310105
					],
					"speakerTitle": "Chic Badger"
				},
				{
					"id": 760310105,
					"content": "Eh, jangan pergi dong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310106,
					"content": "Mmph!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310107
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760310107,
					"content": "Aww ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310108
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760310108,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310109
					],
					"speakerTitle": "Chic Badger"
				},
				{
					"id": 760310109,
					"content": "Tersandung? Tidak apa-apa, aku baik-baik saja. Ah? Kalian juga datang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310110
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760310110,
					"content": "Ternyata Dewi Bulan juga bisa merasa sakit kalau ketabrak ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310111,
					"content": "Selama kuuvahki yang mereka pancarkan tidak mengandung niat jahat, aku tidak apa-apa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310112
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760310112,
					"content": "Kenapa takut begitu? Ada kejadian apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310113
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760310113,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310114
					],
					"speakerTitle": "Chic Badger"
				},
				{
					"id": 760310114,
					"content": "Hmm, iya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310115
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760310115,
					"content": "Jadi kamu juga ngerti bahasa mereka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310116,
					"content": "Bulan bersinar tinggi di atas Nod-Krai. Semua hewan yang tumbuh di bawah cahaya kuuvahki bisa dianggap sebagai \"familiar Dewi Bulan.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310117
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760310117,
					"content": "Apa katanya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310118,
					"content": "Ada monster yang muncul di tempat tinggalnya. Dia awalnya mau melapor ke Lauma, tapi lalu dikejar monster sampai kemari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310119
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760310119,
					"content": "Pantas saja dia ketakutan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310120,
					"content": "Kami antar dia pulang?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760310121
					]
				},
				{
					"id": 760310121,
					"content": "Ya. Lauma pilihan yang lebih baik untuk urusan ini. Dia tahu harus berbuat apa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310122
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760310122,
					"content": "Oke, jalan lagi nih. Tapi ngumpet yang benar loh ya, soalnya kita mau ke Bani Bulan Embun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
