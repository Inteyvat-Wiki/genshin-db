			"dialogs": [
				{
					"id": 760310201,
					"content": "Benar. Kunegunda akan bawakan buah, dia perlu istirahat dua hari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310202
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760310202,
					"content": "Wah, Lauma lagi sibuk tuh. Tungguin deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310203,
					"content": "Aku menyadarinya bertahun-tahun yang lalu, bahwa Pelantun Rembulan adalah figur yang penting bagi Bani Bulan Embun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310204
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760310204,
					"content": "Kadang aku merasa bahwa tugas mereka mungkin bahkan lebih berat daripada dewa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310205
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760310205,
					"content": "Akhirnya dia beres juga. Samperin yu—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310206,
					"content": "Nona Lauma, ada beberapa pengerjaan pertahanan di sini yang perlu penanganan Anda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310207
					],
					"speakerTitle": "Vanamo"
				},
				{
					"id": 760310207,
					"content": "Tentunya. Sebentar, aku ke sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310208
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760310208,
					"content": "Astaga, dia sibuk banget sih! Kapan istirahatnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310209,
					"content": "Ikuti deh. Tapi hati-hati ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
