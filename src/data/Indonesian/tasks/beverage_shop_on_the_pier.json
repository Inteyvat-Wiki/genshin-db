			"trigger": {
				"objectNames": [
					"Quqing"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705220101,
					"content": "Selamat datang, mau minum apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220102
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220102,
					"content": "Emm ... kalau dilihat dari pakaian kalian, sepertinya kalian bukan orang sini ya? Aku tidak tahu apa rasa teh di sini bisa cocok tidak dengan lidah kalian ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220103
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220103,
					"content": "Kubuatkan kalian sepoci Yunlai White Tea deh. Kalau tidak cocok, nanti datang saja lagi. Saat itu aku pasti sudah bisa minta tolong orang beli minuman khas Weinlesefest di Mondstadt ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220104,
						705220105
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220104,
					"content": "Terima kasih, kami bukan tamu kok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220106
					]
				},
				{
					"id": 705220106,
					"content": "Betul! Kami ahlinya kerja serabutan! Paimon dengar kamu ajukan misi di Weinlesefest, minta orang yang mengerti buat bantu pesan minuman. Kami siap bantu loh~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705220107,
					"content": "Mau minuman yang seperti apa? Bilang saja, nanti biar kami yang pesan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705220108,
					"content": "Kalian rela jauh-jauh ke Liyue ... cuma demi pesanan klien? Kalian baik sekali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220109
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220109,
					"content": "Aku kira tidak akan ada orang yang mau terima misi yang merepotkan begini ... kalau begitu, tolong ya! Maaf merepotkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220110
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220110,
					"content": "Aku dengar dari pelaut yang pernah ke Mondstadt kalau minuman \"Mintberry\" khas <color=#00E1FFFF>Cat's Tail</color> rasanya enak sekali, melepas dahaga sekaligus bikin tenang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220111
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220111,
					"content": "Jadi aku mau pesan <color=#00E1FFFF>65 kotak Mintberry</color>, buat para klienku yang pelaut. Supaya suasana hati mereka baik dan kerjanya jadi lebih efisien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220112
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220112,
					"content": "Dulu pedagang Mondstadt selalu menyediakan minuman sesuai permintaanku. Dan sesuai tradisi Weinlesefest, kami juga sudah mengumpulkan Fairbrew Jelly. Silakan dibawa semua!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220113
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220113,
					"content": "Anggaran yang kusiapkan itu cuma hitungan kasar. Kalau ada kembalian kalian boleh ambil, anggap saja bonus. Yah, itu saja tidak cukup sih untuk mengungkapkan rasa terima kasihku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220114,
						705220115
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220114,
					"content": "Santai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220116
					]
				},
				{
					"id": 705220116,
					"content": "#Oke. Jadinya 65 kotak Mintberry, kan? Serahkan saja pesanannya sama Paimon dan {NICKNAME}! Tenang, kami ini ahlinya kerja serabutan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705220117,
					"content": "Kami pergi dulu! Sebentar juga balik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705220115,
					"content": "Tidak masalah kok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220116
					]
				},
				{
					"id": 705220105,
					"content": "Kami justru datang buat bantu pesan minuman.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220106
					]
				}
			]
		},
		{
			"id": 7052202,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
