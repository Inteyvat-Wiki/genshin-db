			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Quqing"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705220301,
					"content": "Nona Quqing, kami kembali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705220302,
					"content": "Kami sudah bikin pesanan! Besok bakal dimuat ke kapal terus dibawa ke sini secepatnya. Ini kuitansinya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705220303,
					"content": "Sudah beres lagi? Wah, kalian gesit sekali kerjanya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220304
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220304,
					"content": "A-Aku akan seduhkan teh pakai air terbaik untuk kalian ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220305,
						705220306
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220305,
					"content": "Jangan sungkan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220307
					]
				},
				{
					"id": 705220307,
					"content": "Yoyoi. Kami masih harus bantu pesanan yang lain nih. Enggak usah repot-repot ah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705220308,
					"content": "Semoga bisnisnya lancar ya! Lain kali kami bakal datang lagi, mau coba minuman enaknya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705220309,
					"content": "Ah, kalau begitu lain kali akan kusiapkan minuman kesukaan kalian!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220310
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220310,
					"content": "Sering-sering main ke sini ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220306,
					"content": "Kan kami sudah ambil upahnya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220307
					]
				}
			]
		},
		{
			"id": 7052204,
			"completionStepIds": [],
