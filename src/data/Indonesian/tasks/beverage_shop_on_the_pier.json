				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705220401,
					"content": "Terima kasih untuk pesanannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220402
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220402,
					"content": "Kalau sudah ada minuman khasnya, berarti para pelaut akan segera punya alternatif rasa minuman buat memuaskan dahaga mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220403,
						705220406,
						705220409
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220403,
					"content": "Rasa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220404
					]
				},
				{
					"id": 705220404,
					"content": "Kesukaan para pelaut kan tidak sama, ada yang suka teh tawar, ada yang suka jus yang manis-manis asem ... Lagian kalau minumnya itu-itu terus, lama kelamaan pasti bosan jadinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220405
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220405,
					"content": "Makanya aku selalu tambahkan minuman dengan rasa yang beda-beda di toko, supaya para pelaut itu bisa pilih sesuai keinginan mereka ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220406,
					"content": "Tentang toko ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220407
					]
				},
				{
					"id": 705220407,
					"content": "Aku buka toko di sini, karena para pelaut sudah banyak bantu aku. Belum lama kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220408
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220408,
					"content": "Tapi aku tidak pintar dagang. Masih sepi sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220409,
					"content": "Sampai jumpa lagi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220410
					]
				},
				{
					"id": 705220410,
					"content": "Sampai jumpa! Semoga perjalanan kalian lancar selalu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quqing"
				}
			]
		},
