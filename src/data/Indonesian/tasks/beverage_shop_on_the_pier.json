			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Diane"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705220201,
					"content": "Selamat datang di Cat's Tail! Mau pesan apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220202
					],
					"speakerTitle": "Diane"
				},
				{
					"id": 705220202,
					"content": "Halo Nona Diane. Kami ada penawaran bisnis!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705220203,
					"content": "Kamu menjelaskan perihal pesanannya ke Diane.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						705220204
					]
				},
				{
					"id": 705220204,
					"content": "Eh? Toko minuman di dermaga utara Liyue?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220205
					],
					"speakerTitle": "Diane"
				},
				{
					"id": 705220205,
					"content": "Para pelaut dari Pelabuhan Dornman pernah cerita tentang pemiliknya, dan kalau tidak salah Nona Margaret juga pernah belanja bahan dari dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220206
					],
					"speakerTitle": "Diane"
				},
				{
					"id": 705220206,
					"content": "Baru-baru ini, Nona Quqing jualan minuman segar ke para pelaut dan minta mereka sekalian promosi mata air Desa Qingce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220207
					],
					"speakerTitle": "Diane"
				},
				{
					"id": 705220207,
					"content": "Dia ambil air mahal dari Desa Qingce, terus dia jual ke yang minta. Dia sendiri cuma pasang harga yang cukup buat menutupi ongkos pekerjanya doang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220208
					],
					"speakerTitle": "Diane"
				},
				{
					"id": 705220208,
					"content": "Dengan dia sebagai perantara, orang di daerah lain bisa pakai air Desa Qingce untuk meracik anggur dengan rasa dan aroma yang berbeda. Para lansia yang tinggal di Desa Qingce juga dapat pemasukan yang lumayan. Sekali mendayung, dua pulau terlampaui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220209
					],
					"speakerTitle": "Diane"
				},
				{
					"id": 705220209,
					"content": "Gitu toh ceritanya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220210
					]
				},
				{
					"id": 705220210,
					"content": "Nona Quqing baik sekali ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705220211,
					"content": "Iya, mungkin Cat's Tail bisa menjalin kerja sama jangka panjang dengannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220212
					],
					"speakerTitle": "Diane"
				},
				{
					"id": 705220212,
					"content": "Ya sudah, balik ke topik awal. Kalian mau bayar berapa untuk semua Mintberry ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Diane"
				}
			]
		},
		{
			"id": 7052203,
