			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Félix Yogue"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705150201,
					"content": "Luar biasa! Cantik sekali! Pemahamanmu dan kemampuan eksekusimu benar-benar luar biasa. Aku tidak mengira akan sehebat ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150202
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150202,
					"content": "Hah, ada juga beberapa artikel konyol di \"The Steambird\" yang menggambarkanmu seperti ... seorang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150203,
						705150204
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150203,
					"content": "Seorang apa ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705150205
					]
				},
				{
					"id": 705150205,
					"content": "Heh ... Hehe ... Seorang ... pemberani yang ... suka meyakinkan orang dengan pedangnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150206
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150206,
					"content": "Konyol! Bodoh! Wartawan yang menulis artikel-artikel ini benar-benar ngawur! Jelas-jelas Anda tipe orang yang lihai, cerdas, rendah hati ... dan pemberani yang blak-blakan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150207
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150207,
					"content": "Tunggu saat aku punya waktu, aku pasti akan menulis surat untuk mematahkan omongan mereka!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150208
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150208,
					"content": "Oh ya, silakan terima mesin ini, kamu dapat menggunakannya kalau lagi bosan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150209
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150209,
					"content": "Sementara aku, aku harus mulai mengumpulkan biaya perjalanan ke Liyue ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150204,
					"content": "Langsung saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705150205
					]
				}
			]
		},
