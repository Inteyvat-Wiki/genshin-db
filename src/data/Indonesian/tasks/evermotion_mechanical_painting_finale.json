					"Félix Yogue"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705150101,
					"content": "Luar biasa! Enam buah komponen \"Lukisan Mekanik Abadi\" telah kembali! Selanjutnya, kita hanya perlu menyusunnya lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150102
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150102,
					"content": "Su-susun? Semuanya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705150103
					]
				},
				{
					"id": 705150103,
					"content": "Tentu saja! Enam bagian kecil dari komponen \"Lukisan Mekanik Abadi\" ini bisa disusun kembali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150104
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150104,
					"content": "Disusun lagi jadi satu \"Lukisan Mekanik Abadi\" yang saaangat besar dan indah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150105
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150105,
					"content": "Ayo, selanjutnya kita hanya perlu menyusunnya kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150106,
						705150107
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150106,
					"content": "Kita perlu melebur sesuatu tidak?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705150108
					]
				},
				{
					"id": 705150108,
					"content": "Tidak, sama sekali tidak, mesin milikku bukanlah logam sampah yang dihancurkan dan dilebur begitu saja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150109
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150109,
					"content": "Setiap komponen disambung dengan rapi, sama seperti ... hm ... seperti ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150110
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150110,
					"content": "Sudahlah, aku tidak pernah pandai analogi, inspirasi retorika aku telah dicuri oleh Xavier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150111
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150111,
					"content": "Kamu boleh mencoba sendiri, pasti akan sangat menyenangkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150107,
					"content": "Ada hal lain yang harus dikerjakan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705150108
					]
				}
			]
		},
		{
			"id": 7051502,
			"completionStepIds": [
				7051503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
