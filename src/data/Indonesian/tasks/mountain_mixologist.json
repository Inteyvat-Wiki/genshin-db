			"dialogs": [
				{
					"id": 705230201,
					"content": "Oh! Kalian balik lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230202
					],
					"speakerTitle": "Georg"
				},
				{
					"id": 705230202,
					"content": "Masih bantu klien luar pesan barang ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230203
					],
					"speakerTitle": "Georg"
				},
				{
					"id": 705230203,
					"content": "Yap. Sekarang kami perlu 100 kotak Fruits of the Festival. Yang pesan Guanchui, koki Desa Qingce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230204,
					"content": "Oke, Om Georg mau kasih harga berapa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230205,
						705230206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230205,
					"content": "Kenapa jadi kaya lagi saingan ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230207
					]
				},
				{
					"id": 705230207,
					"content": "Oh, siappp! Coba lihat kamu sejago apa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Georg"
				},
				{
					"id": 705230206,
					"content": "Om Georg, cobain nih jurusnya Paimon!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230207
					]
				}
			]
		},
		{
