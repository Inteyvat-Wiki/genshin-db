					"Guanchui"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705230301,
					"content": "Pak Guanchui, kami sudah kembali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230302,
					"content": "Kami sudah bikin pesanan buat 100 kotak Fruits of the Festival. Nih kuitansinya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230303,
					"content": "Luar biasa! Kalian berdua memang paling top!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230304
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230304,
					"content": "Fruits of the Festival ini akan kupelajari baik-baik. Mesti pakai formula racikan yang khusus buat dicampur ke teh, supaya rasanya keluar dan anak-anak jadi lebih semangat lagi kerjanya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230305
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230305,
					"content": "Itu kok mirip sama bikin minuman di bar, tapi pakai teh ... Memangnya bisa ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230306,
					"content": "Tenang saja, aku pernah jadi koki di tempat asing juga. Cara ini yang bisa menghasilkan keseimbangan terbaik antara biaya dan rasa. Aku sudah sering buat kok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230307
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230307,
					"content": "Jadi penasaran ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230308
					]
				},
				{
					"id": 705230308,
					"content": "Kalau kalian main ke Desa Qingce lagi, aku kasih coba hasilnya deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230309
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230309,
					"content": "#Boleh tuh! Nanti si {NICKNAME} bisa nyobain!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230310,
					"content": "Semangat ya, koki merangkap bartender!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230311
					]
				},
				{
					"id": 705230311,
					"content": "Terima kasih! Ke sini lagi ya kalau santai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Guanchui"
				}
			]
		},
		{
			"id": 7052304,
