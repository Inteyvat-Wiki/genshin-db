			},
			"dialogs": [
				{
					"id": 705230101,
					"content": "Oh, ada tamu dari luar? Selamat datang ke Desa Qingce!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230102,
						705230103
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230102,
					"content": "Halo ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230104
					]
				},
				{
					"id": 705230104,
					"content": "Paimon duluan! Ayo kenalan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230105,
					"content": "#Ini Pengembara serba bisa, namanya {NICKNAME}. Kalau Paimon itu partner perjalanan terbaiknya, terbaik yang pernah ada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230106,
					"content": "Kami lagi bantu pelanggan dari luar buat beli minuman khas Weinlesefest, terus lihat ada permintaan dari kamu. Jadi kami ke sini deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230107,
					"content": "Ah, ternyata kamu juga tidak suka basa-basi ya! Baiklah, langsung saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230109
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230109,
					"content": "Aku Koki Guanchui. Aku perlu <color=#00E1FFFF>100 kotak Fruits of the Festival</color> mau dibikin teh, biar anak-anak pada semangat kerjanya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230110
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230110,
					"content": "Oke, langsung gerak! Tolong uang pesanannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230111,
					"content": "Nih, sudah siap. Bawa Fairbew Jelly ini, dan kalau uangnya sisa, simpan saja buat kalian. Ongkos kerja keras!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230112
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230112,
					"content": "Oke, diambil ya! Berangkat~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230113,
					"content": "Siap! Aku tunggu kabar baiknya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230114,
						705230115
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230114,
					"content": "Cepat sekali ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230116
					]
				},
				{
					"id": 705230116,
					"content": "#Woi, ngapain bengong di sana. {NICKNAME}, buru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230117,
					"content": "Kalau masih mau ngobrol, nanti saja. Kerja dulu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230118,
					"content": "Makin cepat kerjaannya selesai, makin cepat kita bisa buka toko!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230119,
					"content": "Buka toko, hem hem hem~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230115,
					"content": "Paimon mulai ahli nih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230116
					]
				},
				{
					"id": 705230103,
					"content": "Maaf, kamu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230104
					]
				}
			]
		},
		{
			"id": 7052302,
