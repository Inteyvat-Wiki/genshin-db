				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705230401,
					"content": "Teh khusus yang diseduh pakai air pegunungan Desa Qingce, cocok sekali nih buat jadi minuman spesial Weinlesefest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230402
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230402,
					"content": "Maaf sudah merepotkan kalian berdua!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230403,
						705230407,
						705230415
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230403,
					"content": "Sekarang terserah kamu saja ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230404
					]
				},
				{
					"id": 705230404,
					"content": "Belum lama ini, aku dan teman-temanku kembali ke desa. Biasanya aku yang bertugas masak untuk semua anak-anak yang kerja di ladang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230405
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230405,
					"content": "Tapi sebagian besar masakan yang kubuat itu sederhana dan asal bikin kenyang saja. Agak kurang pantas rasanya kalau disajikan untuk tamu dari luar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230406
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230406,
					"content": "Desa Qingce ini tempat yang sangat tenang, tapi tidak kurang makanan enak. Jalan-jalan di sekitar saja, kamu pasti langsung paham.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230407,
					"content": "Tentang air buat seduh teh ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230408
					]
				},
				{
					"id": 705230408,
					"content": "Anak-anak yang banting tulang di ladang kalau sudah haus, hausnya minta ampun. Setengah hari bisa habis air teh satu teko raksasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230409
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230409,
					"content": "Ladang dan kedai teh jaraknya lumayan jauh. Repot kalau harus bolak-balik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230410
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230410,
					"content": "Paman Kai sudah tua, kasihan juga kalau harus antar teh ke anak-anak. Jadi biar aku saja yang urus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230411
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230411,
					"content": "Aku dan beberapa temanku pernah mengadu nasib di daerah lain, dan teh yang di teko raksasa itu rasanya terlalu hambar. Kadang-kadang, mereka ingin minuman yang lebih nendang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230412
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230412,
					"content": "Jadi aku tambah-tambah bahan ke dalam tehnya, supaya ada rasa lain. Biar anak-anak senang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230413
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230413,
					"content": "Teh yang kubuat tentu saja cuma buat kalangan sendiri. Paman Kai kan dagang, kita jangan ganggu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230414
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230414,
					"content": "Kalau sedang santai, kami suka ke tempatnya Paman Kai. Bantu-bantu lah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230415,
					"content": "Kami segera kembali.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230416
					]
				},
				{
					"id": 705230416,
					"content": "Oke! Aku tunggu kabar baiknya ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Guanchui"
				}
			]
		},
