			"dialogs": [
				{
					"id": 751380101,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}. Aman?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751380102,
					"content": "Nguk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380103
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751380103,
					"content": "#Untunglah! {NICKNAME} ... sulit dijelaskan, tapi dia mimpi ngelihat kamu barengan sama orang aneh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751380104,
					"content": "Kamu ketemu orang aneh enggak di Tonatiuh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751380105,
					"content": "Nguk! Fuwaaa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380106
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751380106,
					"content": "Eh? Ketemu apa enggak nih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751380107,
					"content": "Nguuuk ... FUWAAA!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380108
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751380108,
					"content": "Uhh, Paimon ENGGAK NGERTI SAMA SEKALI!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751380109,
					"content": "#Yang penting {REALNAME[ID(2)|SHOWHOST(true)]} baik-baik saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751380110
					]
				},
				{
					"id": 751380110,
					"content": "Iya sih. Tapi si Bona apa kabar? Mana dia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751380111,
					"content": "Uhh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380112
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751380112,
					"content": "Kalian kepisah? Atau memang si Bona itu cuma ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751380113,
					"content": "Mungkin Bona cuma karakter fiksi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751380114
					]
				},
				{
					"id": 751380114,
					"content": "Hmm ... mungkin sih. Orang biasa umurnya enggak bisa nyampe ratusan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751380115,
					"content": "Tapi setidaknya petualangannya berhasil kita selesaikan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751380116
					]
				},
				{
					"id": 751380116,
					"content": "Iya, benar. Dan kita sudah janji mau sebarin kisah ini kan. Setelah semua orang tahu kita berhasil nemuin Tonatiuh, Bona juga bakal ikutan tenar, ya kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751380117,
					"content": "Kalau gitu sekarang waktunya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751380118
					]
				},
				{
					"id": 751380118,
					"content": "Waktunya kita ke gunung api, temui \"orang itu\". dan ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751380119
					]
				},
				{
					"id": 751380119,
					"content": "Dapetin jawaban untuk semuanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751380120,
					"content": "Tapi ya, apa mungkin dia itu Sage Pencuri Api? Semua pesan yang kita lihat di jalan bikinan dia, Paimon sudah kepo habis nih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751380121,
					"content": "Katanya dia kan suka nyamar, jadi kalau ketemu langsung juga mungkin kita enggak bakal ngenalin orangnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751380122,
					"content": "Nguk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380123
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751380123,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} juga penasaran ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751380124,
					"content": "#Oke, token sudah berhasil dikumpulin semua. Waktunya kita ke gunung berapi bareng si {REALNAME[ID(2)|SHOWHOST(true)]}, dan patahin kutukannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751380125,
					"content": "Maaf ya Bona! Cakram Emas Ultimatum ini kami bawa dulu. Kami akan ceritain semuanya kalau sudah tahu cerita lengkapnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
