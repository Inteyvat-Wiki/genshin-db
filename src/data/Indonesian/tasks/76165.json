					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761650101,
					"content": "Hmm ... kayaknya ini batu nisan Ratnik deh. Punyanya mereka yang tadi kita lihat di ngarai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761650102,
					"content": "Gitu terus ya penampakannya. Antara ada dan tiada, kadang kelihatan, kadang enggak ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761650103,
					"content": "Paimon masih belum ngerti sih ini. Lain kali kita tanya-tanya deh, di Piramida! Mungkin di sana ada yang paham ceritanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7616502,
			"completionStepIds": [
				7616502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7616502",
							"2"
						],
						"stepId": 7616502,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Patolichev"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761650201,
					"content": "Oh, salam. Namaku Patolichev, petugas logistik Lightkeeper. Ada yang bisa dibantu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650202
					],
					"speakerTitle": "Patolichev"
				},
				{
					"id": 761650202,
					"content": "Kamu Patolichev dari Frostgale Steeds?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761650203
					]
				},
				{
					"id": 761650203,
					"content": "Frostgale Steeds ... ah, maksudnya penampakan aneh tadi ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761650204,
					"content": "Ya, aku dulu pernah jadi anggota Frostgale Steeds. Sudah lama sejak terakhir kali aku dengar nama itu ... dan tidak sangka bakal dengar dari mulut orang lain. Maaf, boleh tanya kamu tahu dari ... mana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650205,
						761650208
					],
					"speakerTitle": "Patolichev"
				},
				{
					"id": 761650205,
					"content": "Kami habis dari bawah Tebing Kipumaki.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761650206
					]
				},
				{
					"id": 761650206,
					"content": "Iya, dan Perburuan Liar yang bikin onar di sana sudah disikat habis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761650207,
					"content": "Kami bahkan lihat Ratnik dari Frostgale Steeds ... arwahnya masih gentayangan di sana ... masih bertarung lawan Perburuan Liar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761650210,
					"content": "Ternyata benar ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650211
					],
					"speakerTitle": "Patolichev"
				},
				{
					"id": 761650211,
					"content": "Kami lihat pakai mata kepala sendiri loh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761650212,
					"content": "Ah ... beberapa tahun terakhir ini banyak orang yang mengaku melihat penampakan rekan-rekanku yang gugur di Tebing Kipumaki. Makanya sampai sekarang aku masih sering ziarah ke sana ... sekalian membersihkan makam mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650213
					],
					"speakerTitle": "Patolichev"
				},
				{
					"id": 761650213,
					"content": "Tapi tidak sekali pun aku lihat penampakannya. Sudah lama sekali, aku ... aku selama ini mengira kalau orang cuma bohong ... untuk menghiburku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650214
					],
					"speakerTitle": "Patolichev"
				},
				{
					"id": 761650214,
					"content": "Tapi kalian sungguh-sungguh melihat ... kenapa kalau aku yang ke sana, mereka tidak muncul?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650215,
						761650217
					],
					"speakerTitle": "Patolichev"
				},
				{
					"id": 761650215,
					"content": "Mungkin ... belum waktunya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761650216
					]
				},
				{
					"id": 761650216,
					"content": "Ya ... tapi kalau memang mereka masih di sana, penampakan atau arwah pun sudah cukup bagiku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650219
					],
					"speakerTitle": "Patolichev"
				},
				{
					"id": 761650219,
					"content": "#Intinya, terima kasih, {M#Tuan}{F#Nona}. Terima kasih sudah bersedia memberitahu. Ini sangat penting bagiku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650220
					],
					"speakerTitle": "Patolichev"
				},
				{
					"id": 761650220,
					"content": "Berkat mereka, aku masih ada sampai hari ini. Dan ... aku sangat ingin bisa berdiri lagi bersama mereka, di bawah Tebing Kipumaki, bertempur bahu-membahu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650221
					],
					"speakerTitle": "Patolichev"
				},
				{
					"id": 761650221,
					"content": "Suatu hari nanti ... ya, suatu hari nanti. Aku akan dipertemukan kembali dengan mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Patolichev"
				},
				{
					"id": 761650217,
					"content": "Mungkin mereka tidak mau kamu mengenang ... kepedihannya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761650218
					]
				},
				{
					"id": 761650218,
					"content": "Pedih? Tidak ... hari-hari terakhir itu, berdiri bersama mereka, berjuang sampai akhir ... apa pedihnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650219
					],
					"speakerTitle": "Patolichev"
				},
				{
					"id": 761650208,
					"content": "Kami lihat Ratnik dari Frostgale Steeds ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761650209
					]
				},
				{
					"id": 761650209,
					"content": "Ya ... dan biar cuma penampakan, tapi adegannya masih pertarungan sengit lawan Perburuan Liar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650210
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}