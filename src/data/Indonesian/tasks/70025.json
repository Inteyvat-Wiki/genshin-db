			"dialogs": [
				{
					"id": 700250101,
					"content": "Halo, Pengembara! Aku sudah mendapat kabar tentang penyelesaian tugasmu, terima kasih banyak atas kontribusimu! Ini imbalan untukmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 700250102,
					"content": "Walaupun kamu tidak berhasil menangkap Unusual Hilichurl dan kita masih tidak mendapat alasan jelas atas gangguan yang terjadi akhir-akhir ini... tapi setidaknya kondisi di alam liar sudah lebih aman sekarang, terima kasih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250103
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 700250103,
					"content": "Oh iya, Ella Musk menunggumu di perpustakaan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				}
			]
		},
		{
			"id": 7002502,
			"completionStepIds": [
				7002502
