			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ella Musk",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700250201,
					"content": "Homu... mimi tomo... Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250202
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700250202,
					"content": "Halo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700250203
					]
				},
				{
					"id": 700250203,
					"content": "Ya ika!! ...O-Oh, ternyata kamu, fiuh... Astaga, aku kaget sekali. Lain kali tolong jangan menggangguku begitu ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250204
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700250204,
					"content": "Loh, kenapa jadi kita yang mengganggu, bukannya kamu yang memanggil kita ke sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700250212,
					"content": "Hmm...? Oh, ternyata kamu! Terima kasih atas bantuanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250205
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700250205,
					"content": "Jadi, apa bukunya akurat? Apa sudah terbukti berguna untuk berinteraksi dengan Hilichurl?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250206,
						700250207
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700250206,
					"content": "Sangat berguna, komunikasi jadi lebih mudah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700250208
					]
				},
				{
					"id": 700250208,
					"content": "Haha! Kemajuan kamusku sudah selangkah lebih maju lagi. Hal ini juga dapat kugunakan sebagai tambahan bukti untuk mendukung tesisku tentang kelangsungan hidup berdampingan yang harmonis antara manusia dan Hilichurl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250209
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700250209,
					"content": "Namun tetap saja, sayang sekali kamu tidak mendapat kesempatan untuk berinteraksi dengan Unusual Hilichurl...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250210
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700250210,
					"content": "Tetapi dari kumpulan bahasa yang telah aku kumpulkan sejauh ini, sepertinya dia datang ke sini hanya untuk mencari teman baru di tanah yang asing baginya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250213
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700250213,
					"content": "Sungguh disayangkan kamu tidak berkomunikasi dengannya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250214
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700250214,
					"content": "Ah, aku hampir lupa — ini untukmu, terima kasih atas bantuanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250215
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700250215,
					"content": "Kamu sudah banyak membantuku, dan aku minta maaf karena telah banyak merepotkanmu... Tapi aku harap kita masih bisa bekerja sama lagi di masa depan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250211
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700250211,
					"content": "...Tunggu, apa? Jadi dia bisa berkomunikasi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700250207,
					"content": "Iya, tapi aku lebih memilih caraku yang biasa untuk berinteraksi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700250208
					]
				}
			]
		}
	]
}