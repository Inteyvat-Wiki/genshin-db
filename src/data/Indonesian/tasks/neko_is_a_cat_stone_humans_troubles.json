				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Neko",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722130601,
					"content": "Miaw, miaw, miaw. Apa ada masalah? Tenang saja, diriku akan menyediakan \"ambalan\" yang cukup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130602,
						722130603
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130602,
					"content": "Yang benar itu \"imbalan\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130605
					]
				},
				{
					"id": 722130605,
					"content": "Uh, lupakan deh. Singkatnya, alat milik si manusia batu, Tuan Ooshima, rusak. Tapi kita sudah berikan bahan-bahan untuk memperbaikinya, jadi harusnya tidak masalah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722130606,
					"content": "Hmm? Masalah, katamu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130607,
						722130608
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130607,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130609
					]
				},
				{
					"id": 722130609,
					"content": "Baguslah kalau begitu. Diriku tidak sabar menanti batu itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130610
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130610,
					"content": "Hibiki pernah bilang kalau akan ada hal baik yang terjadi kalau batu berbentuk diriku itu dibuat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130611
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130611,
					"content": "Ah, diriku sudah tidak sabar! Kira-kira hal baik apa yang akan terjadi? Mungkin, Hibiki akan kembali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130608,
					"content": "Tidak, tidak ada masalah. Semuanya lancar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130609
					]
				},
				{
					"id": 722130603,
					"content": "Berapa banyak?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130604
					]
