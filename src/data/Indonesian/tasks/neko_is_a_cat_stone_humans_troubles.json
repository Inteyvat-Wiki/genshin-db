			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ooshima Junpei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722130301,
					"content": "Ah, tidak ada palu, tidak ada alat pahat, bagaimana mau mulai bekerja ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130302
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722130302,
					"content": "Apa ada masalah?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130303
					]
				},
				{
					"id": 722130303,
					"content": "Ah, ternyata kalian. Aduh ... aku ceroboh sekali. Aku tidak memeriksa semua alat kerjaku waktu datang ke sini, lalu waktu aku sedang serius bekerja, aku malah merusak palu dan alat pahatku ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130304
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722130304,
					"content": "Aku ingin pergi ke Pulau Narukami untuk beli yang baru, tapi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130305
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722130305,
					"content": "Bagaimana bilangnya ya ... tapi aku terbiasa jika sudah mulai memahat pasti akan kuselesaikan sampai tuntas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130306
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722130306,
					"content": "Alatku memang rusak, tapi aku masih bisa mengukur untuk tahu bagaimana cara membuatnya nanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130307
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722130307,
					"content": "Kalau sekarang aku pergi ke Pulau Narukami dan beli alat kerja yang baru ... Saat kembali nanti, aku pasti ingin sudah kehilangan \"rasa\" mengukirnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130308
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722130308,
					"content": "Lalu, tekstur batu ini juga terlalu keras. Kalau pakai alat biasa, pasti akan cepat patah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130309
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722130309,
					"content": "Hm... tidak ada cara lain lagi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130310
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722130310,
					"content": "Pengembara, bisakah membantuku mencari 3 Iron Chunk?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130311
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722130311,
					"content": "Aku harus memikirkan cara untuk membuat sendiri alat yang lebih cocok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130312,
						722130314
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722130312,
					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130313
					]
				},
				{
					"id": 722130313,
					"content": "Ah! Kalau begitu tolong ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722130314,
					"content": "Kamu mau menempanya sendiri?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130315
					]
				},
				{
					"id": 722130315,
					"content": "Ayolah, aku ini kan pernah kerja di Tatarasuna. Tentu saja aku tahu satu dua hal tentang menempa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130316
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722130316,
					"content": "Tapi, kurasa aku tidak bisa membuat tungku atau sejenisnya di kuil. Kurasa Nona Pendeta pasti tidak akan suka. Karena dia kucing kan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130317
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722130317,
					"content": "Jadi, tolong kalian bawakan dulu 3 Iron Chunk untukku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ooshima Junpei"
				}
			]
		},
