			"trigger": {
				"objectNames": [
					"Neko",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722130101,
					"content": "\"Ambalan\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130102
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130102,
					"content": "Bagaimana patungnya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130103
					]
				},
				{
					"id": 722130103,
					"content": "Manusia batu itu sangat terampil, miaw miaw miaw.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130104
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130104,
					"content": "Sudah selesai?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130105
					]
				},
				{
					"id": 722130105,
					"content": "Tidak, tapi baru sebentar saja, tiba-tiba dia sudah datang membawa batu yang sangat amat besar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130106
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130106,
					"content": "Lalu dia mulai mengetuk-ngetuknya, tok-tok-tok, sambil bergumam kata-kata seperti \"pos\" dan \"ambalan\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130107
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130107,
					"content": "Omong-omong soal itu, diriku ingin bertanya: apa itu \"pos\", dan apa itu \"ambalan\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130108
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130108,
					"content": "Mungkin maksudnya \"bos\" dan \"imbalan\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130109
					]
				},
				{
					"id": 722130109,
					"content": "Singkatnya, karena kamu memintanya melakukan sesuatu, dia ingin dapat sesuatu sebagai gantinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722130110,
					"content": "Ah, ternyata begitu? Jadi manusia peduli dengan hal seperti itu ... Baiklah, diriku akan mengizinkannya menggaruk telinga milikku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130111
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130111,
					"content": "Mu-mungkin tidak cukup...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722130112,
					"content": "Tidak cukup? Hmm, mungkin diriku harus memberinya suatu makanan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130113
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130113,
					"content": "Mungkin dia ingin Mora...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130114
					]
				},
				{
					"id": 722130114,
					"content": "Mora? Bukankah ini benda yang dimasukkan ke dalam Kotak Uang? Aneh. Ternyata manusia peduli dengan hal seperti ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130115
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130115,
					"content": "Uang bayaran itu sangat penting.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130116
					]
				},
				{
					"id": 722130116,
					"content": "Hmph. Diriku akan percaya kata-katamu karena sudah banyak membantuku. Diriku akan bicara dengan manusia batu itu saat kita kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130117
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130117,
					"content": "Tapi manusia batu itu sudah tidak mengetuk tok-tok-tok. Sekarang dia membawa tongkat kayu pendek, entah untuk tujuan apa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130118
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130118,
					"content": "Tongkat kayu? Bukannya memahat itu pakai palu, alat pahat, dan sejenisnya ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722130119,
					"content": "Mungkin alatnya rusak...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130120
					]
				},
				{
					"id": 722130120,
					"content": "#Kalau begitu {NICKNAME}, ayo kita cari Tuan Ooshima! Mungkin kita bisa bantu dia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
