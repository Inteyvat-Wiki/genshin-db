			"dialogs": [
				{
					"id": 220450301,
					"content": "Hmm? Apa yang sedang kamu lakukan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450302
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220450302,
					"content": "Mengambil foto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450303
					]
				},
				{
					"id": 220450303,
					"content": "...Dan benda apa itu? Kamu memang aneh sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450304
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220450304,
					"content": "Yah, tidak masalah. Silakan lanjutkan, tapi ingat, jangan sampai membuat kuilnya berantakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
		},
		{
			"id": 2204504,
			"completionStepIds": [
				2204504
			],
