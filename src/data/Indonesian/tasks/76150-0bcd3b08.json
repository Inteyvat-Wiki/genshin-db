			"dialogs": [
				{
					"id": 761500101,
					"content": "Uhuk, uhuk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500102
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 761500102,
					"content": "Kamu tidak apa-apa, kan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761500103
					]
				},
				{
					"id": 761500103,
					"content": "Tidak apa-apa kok, hanya mengalami mimpi buruk yang sangat panjang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500104
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 761500104,
					"content": "Sudahlah. Anggap saja aku tidak mengatakan apa-apa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500105
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 761500105,
					"content": "Aku sudah tidak tahan lagi. Kenapa hal seperti ini selalu terjadi padaku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500106
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 761500106,
					"content": "Kenapa selalu aku ... Ibu, Ayah ... dan sekarang kakakku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500107
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 761500107,
					"content": "Tidak apa-apa, aku di sini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761500108
					]
				},
				{
					"id": 761500108,
					"content": "Ya. Aku bukan marah padamu kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500109
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 761500109,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500110
					],
					"speakerTitle": "Dex"
				},
				{
					"id": 761500110,
					"content": "Dex berhasil memungut apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500111
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 761500111,
					"content": "Sebut saja \"Serpihan Mantra Maut\". Mungkin ini peluang kita untuk berpindah dari kematian menuju kehidupan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500112
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761500112,
					"content": "Ayo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761500113
					]
				},
				{
					"id": 761500113,
					"content": "Ya, ayo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500114
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 761500114,
					"content": "Zeitlind sudah ketemu, sekarang tinggal cari jalan keluar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500115
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761500115,
					"content": "Kamu yakin kita bisa keluar dari sini sendiri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500116
					],
					"speakerTitle": "Alara"
				},
				{
					"id": 761500116,
					"content": "Melanta dan Nihilita bebas bergerak di sini, dan mereka biasa bawa orang juga. Artinya, Dex juga harusnya sama, ya kan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500117
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761500117,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500118
					],
					"speakerTitle": "Dex"
				},
				{
					"id": 761500118,
					"content": "Oke, tiga Serpihan Mantra Maut sudah terkumpul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500119
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761500119,
					"content": "Yah, namanya sementara begitu saja dulu. Karena aku juga tidak tahu Dex mau pakai buat apa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500120
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761500120,
					"content": "Habis ini apa lagi, Dex?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500121
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761500121,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500122
					],
					"speakerTitle": "Dex"
				},
				{
					"id": 761500122,
					"content": "Kita ikuti arahannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Istoria"
				}
			]
		},
