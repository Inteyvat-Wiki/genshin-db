			"dialogs": [
				{
					"id": 221050101,
					"content": "Benar-benar merepotkan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050102
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221050102,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221050103
					]
				},
				{
					"id": 221050103,
					"content": "Aku selalu merasa ada yang aneh di sekitar penginapan ini, tapi rasanya itu sulit dijelaskan dengan kata-kata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050104
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221050104,
					"content": "Ditambah lagi, tamu-tamu di penginapan ini luar biasa waspada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050105
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221050105,
					"content": "Embusan angin yang pelan saja bisa membuat mereka merusak pintu atau jendela. Terkadang beberapa bagian lantai juga rusak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050106
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221050106,
					"content": "Walaupun mereka akan mengeluarkan uang untuk memperbaikinya, namun bagian yang sudah ditambal sangat tidak serasi dengan bagian lainnya. Jadi terlihat sangat jelek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050107
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221050107,
					"content": "Apa kamu bisa keluar untuk membantuku memeriksa area sekitar penginapan? Kalau ada yang aneh, tolong... ditangani. Aku harus melayani tamu di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050108,
						221050109
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221050108,
					"content": "Baiklah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221050110
					]
				},
				{
					"id": 221050110,
					"content": "Terima kasih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221050109,
					"content": "Tamu-tamu ini...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221050111
					]
				},
				{
					"id": 221050111,
					"content": "Tamu-tamu itu? Sebenarnya mereka tidak jahat! Mereka hanya terbiasa hidup di hutan belantara sehingga bersikap penuh waspada terhadap setiap hal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050112
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221050112,
					"content": "Tolong periksa sekeliling penginapan ini ya. Seharusnya tidak terjadi apa-apa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verr Goldet"
				}
			]
		},
