				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130030101,
					"content": "Ngomong-ngomong, jadi zona terkontaminasi itu ternyata kebocoran Ley Line yang ada jauh di dalam hutan. Tapi sekarang kondisinya sudah normal lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130030102,
					"content": "Ternyata begitu. Terima kasih atas kerja keras kalian ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030103
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 130030103,
					"content": "Setelah kelebihan energi Ley Line menghilang dari udara, kita seharusnya sudah bisa membuat pengumuman supaya penduduk dapat melanjutkan aktivitas normal mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030104
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 130030104,
					"content": "Ini adalah hadiah yang dijanjikan. Silakan menerimanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030105
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 130030105,
					"content": "Paimon membawamu ke tempat yang lebih sepi setelah meninggalkan Adventurers' Guild ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130030106
					]
				},
				{
					"id": 130030106,
					"content": "Apa Karkata ... bakal dikirim balik ke Akademiya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130030107,
					"content": "Meski sudah rusak, Paimon ngerasa sedih mikirin dia mau dibongkar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130030108,
					"content": "Aku juga sedikit sedih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130030109
					]
				},
				{
					"id": 130030109,
					"content": "Gimana kalau kita nemuin Tighnari besok dan minta dia buat jangan ngebongkar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130030110,
					"content": "Paimon sih pengennya pergi sekarang, tapi kan Tighnari bilangnya \"bicarakan sisanya besok\". Apa dia bakal marah kalau kita perginya sekarang, hah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130030111,
					"content": "Ya mungkin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130030112
					]
				},
				{
					"id": 130030112,
					"content": "Baiklah kalau gitu! Besok kita pergi nemuin Tighnari dan minta dia jangan bongkar Karkata!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1300303,
			"completionStepIds": [
				1300303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1300303",
							"2"
						],
						"stepId": 1300303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tighnari",
					"Karkata"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130030301,
					"content": "Tighnari——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130030302,
					"content": "Sst, pelan-pelan ngomongnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030303
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030303,
					"content": "Lilac Daphne, daphne dari genus Thymelaeaceae, memiliki efek penekanan rasa cemas yang kuat. Ia dapat digunakan sebagai bubuk anestesi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030304
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030304,
					"content": "Melihat dua set data uji, tampaknya memiliki efek yang besar terhadap racun ikan ... Fokus rekam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030305
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030305,
					"content": "*GEMURUH*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030306
					],
					"speakerTitle": "Karkata"
				},
				{
					"id": 130030306,
					"content": "Karkata?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130030307,
					"content": "*GEMURUH* *GEMURUH*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030308
					],
					"speakerTitle": "Karkata"
				},
				{
					"id": 130030308,
					"content": "Aku sudah menyuruh kalian pelan-pelan ngomongnya. Meskipun tanaman tidak takut keributan, tapi kalian masih membuat telingaku berdenging.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030309
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030309,
					"content": "Ka-Kamu enggak bongkar Karkata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130030310,
					"content": "Buat apa aku bongkar dia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030311
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030311,
					"content": "Tapi kamu bilang, \"Menurut aturan Akademiya\" ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130030312,
					"content": "Itu alasan kalian datang menggangguku pagi-pagi begini? Baiklah, mungkin aku juga tidak jelasin dengan baik tentang hal itu kemarin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030313
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030313,
					"content": "Yang aku maksud adalah, menurut aturan Akademiya, semua hasil penelitian harus dimusnahkan. Jadi kita tidak boleh biarkan Akademiya menemukan tempat itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030314
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030314,
					"content": "Jadi alasan sebenarnya kamu kemarin tetap di sana itu untuk ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130030315
					]
				},
				{
					"id": 130030315,
					"content": "Singkatnya, hal pertama yang kulakukan adalah memperbaiki Karkata. Selama aku studi di Akademiya, aku mengambil mata kuliah pilihan di Spantamad. Siapa tahu itu bisa berguna suatu saat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030316
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030316,
					"content": "Lalu kami mengubur Abattouy bersama-sama. Setelah menyusun bahan penelitian, sebagian darinya kusimpan sebagai kenang-kenangan, sebagian besar lainnya dibakar untuk menyembunyikan barang bukti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030317
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030317,
					"content": "Aku bukan bagian dari Akademiya, apa hubungannya aturan mereka denganku? Haha, sebaliknya, aku adalah Pelindung Hutan di Hutan Avidya. Aku bertanggung jawab atas semua makhluk hidup di hutan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030318
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030318,
					"content": "Setiap makhluk hidup yang lahir ke dunia ini memiliki tujuan yang unik, termasuk Karkata. Jika memang ada, maka tidak boleh sembarangan dibuang atau dimusnahkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030319
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030319,
					"content": "Hehe! Mantap deh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130030320,
					"content": "*gemuruh*?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030321
					],
					"speakerTitle": "Karkata"
				},
				{
					"id": 130030321,
					"content": "Bentar, barusan kamu bilang \"makhluk hidup.\" Jadi kamu sudah mengakui Karkata sebagai makhluk hidup sejati sekarang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130030322,
					"content": "Kemungkinan yang ada adalah segalanya. Sulit untuk menjelaskan upaya Karkata untuk \"memperbaiki\" Abattouy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030323
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030323,
					"content": "Abattouy hanya meninggalkan sebagian kecil dari penelitiannya. Siapa yang tahu berapa banyak perintah yang telah dia tetapkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030324
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030324,
					"content": "Mungkin konflik antara keseluruhan perintah itulah yang mengakibatkan perilaku aneh Karkata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030325
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030325,
					"content": "Dari perspektif yang lebih ketat, mustahil untuk menyimpulkan bahwa Karkata adalah bentuk kehidupan nyata, tetapi kemungkinan itu tetaplah ada — dan aku bersedia untuk percaya akan hal itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030326
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030326,
					"content": "*GEMURUH*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030327
					],
					"speakerTitle": "Karkata"
				},
				{
					"id": 130030327,
					"content": "Omong-omong, aku tidak tertarik untuk melanjutkan penelitian dengan subjek ini. Aku hanya membiarkannya berkeliaran di sini karena tempat ini relatif agak tersembunyi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030328
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030328,
					"content": "Tapi kelihatannya, bukanlah ide yang buruk untuk menjadikan dia sebagai asisten eksperimenku. Dia dapat mengelola semua rekaman eksperimen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030329
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030329,
					"content": "Bagaimana menurutmu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030330
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030330,
					"content": "*GEMURUH* *GEMURUH*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Karkata"
				}
			]
		},
