			"trigger": {
				"objectNames": [
					"Aranakin",
					"Aragaru",
					"Aranaga",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730590201,
					"content": "Aranaga, mereka datang, mereka datang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590202
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730590202,
					"content": "Ehm, datang, datang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590203
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730590203,
					"content": "#Datang. Selamat datang Nara {NICKNAME} dan Si Putih Melayang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590204
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730590204,
					"content": "Sampai, bulan. Sampai, saatnya menanam bunga. Apakah kalian sudah siap?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590205
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730590205,
					"content": "Aku sudah siap.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730590206
					]
				},
				{
					"id": 730590206,
					"content": "Ehm, Paimon juga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730590207,
					"content": "Kalau begitu ... Aranakin, Aragaru, ayo kita mulai upacaranya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590208
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730590208,
					"content": "\"Kembalilah, kembalilah, impian taman bunga, kenangan hutan ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590209
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730590209,
					"content": "\"Sambutlah , biarkan kami:\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590210
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730590210,
					"content": "\"Mimpi yang dalam, kegembiraan yang abadi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590211
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730590211,
					"content": "\"Rayakan, biarkan kami:\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590212
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730590212,
					"content": "\"Delima bernyanyi, apel bertepuk tangan!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590213
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730590213,
					"content": "Aranara menanam bunga kering. Keajaiban bunga mengulang kehidupan baru ketika lagu bergema di langit ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730590214
					]
				},
				{
					"id": 730590214,
					"content": "Wah ... tiga bunga ini kembali hidup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730590215,
					"content": "Ya, karena ... \"Mawtiyima\" kasihan. Jadi, dia harus membuat ingatannya kembali bersinar lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590216
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730590216,
					"content": "Ehm! Walaupun kami enggak ingat kalian lagi, ingatan akan ... Huh, menyerap masuk ke tengah-tengah pembuluh daun dan jaringan akar, dan berubah menjadi daun hijau, menjadi lingkaran tahun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590217
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730590217,
					"content": "Atau menjadi ulat gemuk yang akan dimakan oleh ulat lain. Cacing yang lainnya meninggalkan barang yang akan menyuburkan rumput dan akan membuat kita tumbuh dewasa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590218
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730590218,
					"content": "Tapi ... kalian masih enggak ingat kami, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730590219,
					"content": "Ehm ... karena, itu bukan punyamu dan aku, ingatan ... kenangan yang dulu pernah dilalui kita sudah dibagikan kepada semua rumput di dalam hutan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590220
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730590220,
					"content": "....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730590221
					]
				},
				{
					"id": 730590221,
					"content": "Tapi enggak masalah. Kita sudah jadi teman baru, kan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590222
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730590222,
					"content": "Iya! Teman baru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aragaru"
				}
			]
		},
