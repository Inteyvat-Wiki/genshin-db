					"nextDialogs": [
						230165103
					]
				},
				{
					"id": 230165103,
					"content": "Lumayan, semangat belajarnya memang jauh lebih tinggi daripada beberapa muridku yang lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165104
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230165104,
					"content": "Tapi sikapnya tidak seperti orang yang mau cari nafkah sebagai penempa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230165105,
					"content": "Selain aku, apa ada orang yang pernah menemui kamu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230165106
					]
				},
				{
					"id": 230165106,
					"content": "Ya ... ada perempuan yang sering cari aku dan membawa banyak barang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165107
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230165107,
					"content": "Aku dengar perempuan ini bernama Kaia ... atau siapalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165108
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230165108,
					"content": "Kenapa orang-orang yang kelihatannya tidak ada hubungannya dengan pekerjaan penempa malah terus berkumpul di tempatku ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
