			"dialogs": [
				{
					"id": 230160301,
					"content": "Lutong! Roda gigi ini siap untuk dibentuk lagi, cepat bantu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160302
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160302,
					"content": "Pengembara, kamu juga sudah kembali? Bagaimana, pasti Tuan Ahangar sudah memberitahumu sesuatu yang berguna, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160303
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160303,
					"content": "Cepat, cepat, beri tahu aku bagaimana caranya?",
					"roleType": "TALK_ROLE_NPC",
