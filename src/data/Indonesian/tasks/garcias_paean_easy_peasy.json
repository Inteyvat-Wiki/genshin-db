						230163902
					]
				},
				{
					"id": 230163902,
					"content": "Aha! Berhasil, gigi roda ini lumayan bagus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230163903
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230163903,
					"content": "Rongga antara gigi ... ketebalan ... ukuran ... aku harus ukur dulu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230163904
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230163904,
					"content": "Biarkan tuan Garcia mengukurnya dulu, pengembara, imbalan ini untukmu, simpan baik-baik ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230163905
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230163905,
					"content": "Kamu masih pesimis?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230163906
					]
				},
				{
					"id": 230163906,
					"content": "Iya, aku memang selalu begitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230163907
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230163907,
					"content": "Tuan Garcia dan aku telah ke sana kemari di depan gunung raksasa, tapi sekarang kami baru memindahkan sebuah batu kecil darinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230163908
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230163908,
					"content": "Tapi sebenarnya, kami tidak menemukan jalan untuk masuk ke dalam gunung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230163909
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230163909,
					"content": "Semoga Tuan Garcia bisa membawa kami ke jalan yang benar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230163910
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230163910,
					"content": "Atau aku harus mengatakan bahwa \"pada akhirnya semua pasti akan baik-baik saja\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				}
			]
