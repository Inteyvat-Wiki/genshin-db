			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Garcia",
					"Lutong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230160101,
					"content": "Tanganku ... argh! Kebal ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160102
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160102,
					"content": "Tuan, Anda harus membantu Nona Kaia menghitung, jangan sampai kelelahan ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160103
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230160103,
					"content": "Aku, aku tahu! Jangan mengungkit hal ini, Lutong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160104
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160104,
					"content": "Tentu saja, kalau Anda tidak bisa pergi, saya bisa menggantikan Anda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160105
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230160105,
					"content": "Tidak! Aku bisa pergi sendiri, aku cuma perlu ... perlu menghancurkan beberapa roda gigi lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160106
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160106,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160107
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160107,
					"content": "Baiklah, sudah tidak kuat, aku benar-benar sudah tidak sanggup ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160108
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160108,
					"content": "Apa yang sedang kamu lakukan ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160109
					]
				},
				{
					"id": 230160109,
					"content": "Oh kamu, Pengembara ... aduh ... tanganku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160110
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160110,
					"content": "Begini, karena Tuan Ahangar masih ada pekerjaan lain, jadi dia tidak bisa terus menerus membuatkan komponen yang aku inginkan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160111
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160111,
					"content": "Dan komponen yang dia buat pasti selalu sedikit berbeda dengan yang aku inginkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160112
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160112,
					"content": "Jadi, untuk memastikan kualitas dari komponen ini, aku belajar langsung kemampuan menempa dari Tuan Ahangar dan memutuskan untuk membuatnya sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160113
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160113,
					"content": "Untungnya aku punya pengalaman bekerja seperti ini saat di Fontaine ... tapi ada beberapa dari keterampilan yang diberi tahu Tuan Ahangar yang benar-benar tidak bisa aku ingat, aduh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160114
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160114,
					"content": "Pengembara, tolong bantu aku tanya beberapa keterampilan ke Tuan Ahangar, aku benar-benar perlu istirahat sebentar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160115,
						230160116
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160115,
					"content": "Kamu istirahatlah dulu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160121
					]
				},
				{
					"id": 230160121,
					"content": "Terima kasih sudah membantu, aduh ... tanganku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160116,
					"content": "Siapa Kaia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160117
					]
				},
				{
					"id": 230160117,
					"content": "Teman bisnis! Seorang yang ... hmm ... berbakat, kekayaannya berlimpah ... teman bisnis!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160118
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160118,
					"content": "Kami menandatangani kontrak manajemen keuangan jangka panjang! Makanya aku terus mencarinya, benar kan, Lutong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160119
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160119,
					"content": "Anda benar, Tuan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160120
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230160120,
					"content": "Intinya begini ... Pengembara, tolong cepat cari Tuan Ahangar secepatnya, aku menunggumu di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				}
			]
		},
		{
			"id": 2301602,
			"completionStepIds": [
				2301602
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2301602",
							"2"
						],
						"stepId": 2301602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ahangar"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230160201,
					"content": "Kan sudah dibilang tunggu sebentar. Eh ....? Kok kamu yang datang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160202,
						230160203
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160202,
					"content": "Aku datang ke sini untuk mewakilinya bertanya sesuatu padamu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160204
					]
				},
				{
					"id": 230160204,
					"content": "Dia benar-benar turun tangan sendiri ya ... dasar orang aneh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160205
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160205,
					"content": "Aku sudah jadi penempa selama bertahun-tahun, ini pertama kalinya aku ketemu orang yang punya begitu banyak permintaan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160206
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160206,
					"content": "Dia bahkan membawa penggaris untuk mengukur lapisan antara pipa besi dan jarak antara benang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160207
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160207,
					"content": "Aku sudah benar-benar tidak sabar dan suruh dia buat sendiri saja ... akhirnya, besoknya dia benar-benar ke sini dan memintaku mengajarinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160208
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160208,
					"content": "Aku sudah pasrah, terserah dia lah. Asal dia berani bayar bahannya, dia bebas pakai semua alat yang dia mau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160209
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160209,
					"content": "*huff* Aku benar-benar tidak tahu orang ini mau apa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160210,
						230160211
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160210,
					"content": "Dia sedang buat mesin hebat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160212
					]
				},
				{
					"id": 230160212,
					"content": "Baiklah ... toh sama saja barang aneh. Kalian datang untuk belajar menempa juga, kan? Aku juga tidak punya banyak yang bisa diajarkan sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160213
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160213,
					"content": "Tapi, aku perhatikan, roda gigi yang mau dibuat orang ini, pinggirannya sangat tajam dan tengahnya berlubang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160214
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160214,
					"content": "Roda gigi seperti ini sulit dibuat kalau cuma mengandalkan cetakan, dia harus proses ulang roda giginya sekali lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160215
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160215,
					"content": "Detailnya sudah pernah kuajarkan padanya dulu, kamu kasih tahu dia saja ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160216
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160216,
					"content": "Pertama, <color=#00E1FFFF>tambahkan bahan bakar agak banyak</color> pada saat memasukkannya ke tungku untuk kali kedua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160217
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160217,
					"content": "Lalu saat dikeluarkan, <color=#00E1FFFF>pukul dari arah dalam ke luar</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160218
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160218,
					"content": "Bagaimana? Sudah ingat, kan? Kalau sudah, ke sana saja dan beri tahu dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160219
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160219,
					"content": "Benar-benar aneh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160211,
					"content": "Dia sedang buat mesin aneh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160212
					]
				},
				{
					"id": 230160203,
					"content": "Tangannya keram karena menempa jadi dia perlu istirahat sebentar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160204
					]
				}
			]
		},
