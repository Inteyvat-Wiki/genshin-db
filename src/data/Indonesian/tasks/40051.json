			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tsumi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400510101,
					"content": "Tsumi, beres nih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400510102,
					"content": "Aku sudah lihat hasilnya. Ketiga menara berhasil kalian urus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510103
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400510103,
					"content": "Evakuasinya juga jadi lebih cepat karena keadaan lingkungan sekitar yang jadi lebih baik. Baiklah, hampir semua prajurit sudah aman ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510104
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400510104,
					"content": "Tapi sepertinya terjadi sesuatu yang di luar dugaanku. Ayo, ikut aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsumi"
				}
			]
		},
		{
			"id": 4005102,
			"completionStepIds": [
				4005102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4005102",
							"2"
						],
						"stepId": 4005102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tsumi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400510201,
					"content": "Kegelapannya merajalela di dalam Dainichi Mikoshi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400510202,
					"content": "Logikanya, seharusnya seluruh Enkanomiya sudah kembali normal sekarang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510203
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400510203,
					"content": "Tapi sayangnya, sekarang tempat ini malah jadi yang paling bahaya. Aku tidak tahu penyebabnya maupun cara menanggulanginya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510204
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400510204,
					"content": "Tapi aku tahu di mana biang keroknya berada. Dan aku harus minta tolong kalian sekali lagi untuk menghadapi dia dan buat dia mengaku apa rencananya sebenarnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510205
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400510205,
					"content": "Kok jadi gini sih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400510206,
					"content": "Aku perhatikan aliran kegelapannya dan menyadari ada yang aneh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510207
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400510207,
					"content": "Ada pusaran yang diam-diam menyedot kegelapan. Kurasa aliran ini disebabkan oleh kebutuhan dirinya akan energi Abyss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510208
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400510208,
					"content": "Dia sangat berbahaya. Bahkan para vishap saja bukan tandingannya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510209,
						400510210
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400510209,
					"content": "Jangan cemas. Aku sudah tunggu-tunggu kesempatan buat menghajarnya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400510211
					]
				},
				{
					"id": 400510211,
					"content": "Senang sekali mendengarnya. Terima kasih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510212
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400510212,
					"content": "Kalau aku tidak salah tebak, harusnya dia ada di sekitar area <color=#00E1FFFF>perpustakaan</color> sekarang ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400510210,
					"content": "Tenanglah. Orang itu memang suka dihajar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400510211
					]
				}
			]
		},
		{
			"id": 4005103,
			"completionStepIds": [
				4005103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4005103",
							"2"
						],
						"stepId": 4005103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"The Thing Calling Itself \"Enjou\""
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400510301,
					"content": "Oh, halo. Aku tadinya mau bilang ini \"kejutan yang menyenangkan\", tapi ... tidak ada yang aneh juga sih. Kamu menjelajah ke dalam kegelapan, bertempur sepanjang jalan hanya untuk bertemu denganku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510302
					],
					"speakerTitle": "The Thing Calling Itself \"Enjou\""
				},
				{
					"id": 400510302,
					"content": "Setahuku cuma kamu saja yang mampu begitu. Tapi, kenapa tiba-tiba bergabung dengan mereka? Itu yang mengejutkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510303
					],
					"speakerTitle": "The Thing Calling Itself \"Enjou\""
				},
				{
					"id": 400510303,
					"content": "Banyak bicara, mau ulur waktu lagi ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400510304,
					"content": "Wah, kalian belum tahu ya, ternyata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510305
					],
					"speakerTitle": "The Thing Calling Itself \"Enjou\""
				},
				{
					"id": 400510305,
					"content": "Dengar, aku tahu kalian kesal karena bertemu lagi denganku. Dan keadaan kalian yang masih penuh semangat setelah perjalanan panjang ke sini cukup mengganggu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510306
					],
					"speakerTitle": "The Thing Calling Itself \"Enjou\""
				},
				{
					"id": 400510306,
					"content": "Jadi lebih baik semangat itu kita salurkan dulu ke sedikit olahraga ringan, oke? Biar kamu tenang sedikit dan kita bisa bicara layaknya orang beradab.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "The Thing Calling Itself \"Enjou\""
				}
			]
		},
		{
			"id": 4005105,
			"completionStepIds": [
				4005105
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4005105",
							"2"
						],
						"stepId": 4005105,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"The Thing Calling Itself \"Enjou\""
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400510501,
					"content": "Sudah, sudah! Rasanya aku sudah seperti di ambang pintu maut!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510502
					],
					"speakerTitle": "The Thing Calling Itself \"Enjou\""
				},
				{
					"id": 400510502,
					"content": "Oh bagus, memang itu tujuanku!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400510503
					]
				},
				{
					"id": 400510503,
					"content": "Nona yang itu, yang matanya seperti ular, siapa namanya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510504
					],
					"speakerTitle": "The Thing Calling Itself \"Enjou\""
				},
				{
					"id": 400510504,
					"content": "Hah, kenapa kamu tahu dia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400510505,
					"content": "Namanya. Siapa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510506
					],
					"speakerTitle": "The Thing Calling Itself \"Enjou\""
				},
				{
					"id": 400510506,
					"content": "Tsumi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400510507,
					"content": "Ah. Para reptil itu sepertinya jago juga meniru wujud manusia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510508
					],
					"speakerTitle": "The Thing Calling Itself \"Enjou\""
				},
				{
					"id": 400510508,
					"content": "Reptil ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400510509
					]
				},
				{
					"id": 400510509,
					"content": "Masuk akal, kan? Bathysmal Vishap adalah makhluk yang cerdas dan cepat berevolusi. Sudah ada legenda tentang ini selama ribuan tahun loh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510510
					],
					"speakerTitle": "The Thing Calling Itself \"Enjou\""
				},
				{
					"id": 400510510,
					"content": "Para \"Orang Vishap\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510511
					],
					"speakerTitle": "The Thing Calling Itself \"Enjou\""
				},
				{
					"id": 400510511,
					"content": "\"Orang Vishap\"? Kok namanya kayak julukan buatan Paimon sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400510512,
					"content": "Yah, asalnya dari legenda Enkanomiya. Ketika para Bathysmal Vishap dikalahkan, mereka mulai berevolusi untuk bertahan hidup. Yah intinya, mereka meniru kaum pemenang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510513
					],
					"speakerTitle": "The Thing Calling Itself \"Enjou\""
				},
				{
					"id": 400510513,
					"content": "Di kemudian hari, bangkitlah sebagian dari mereka yang rupanya tidak dapat dibedakan dengan manusia, kecuali dari pupil matanya. Inilah mereka yang disebut \"Orang Vishap\". Lalu mereka mulai menyusup ke dalam masyarakat Enkanomiya dan mulai mengambil alih banyak posisi penting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510514
					],
					"speakerTitle": "The Thing Calling Itself \"Enjou\""
				},
				{
					"id": 400510514,
					"content": "Mirip siapa coba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510515
					],
					"speakerTitle": "The Thing Calling Itself \"Enjou\""
				},
				{
					"id": 400510515,
					"content": "Kami memang pernah dengar kalau mata Tsumi mirip mata ular ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400510516,
					"content": "Yep. Di tempat yang pencahayaannya bagus, pupil mata reptil akan terlihat jelas, berbentuk garis vertikal tipis. Itu saja sudah merupakan bukti keras bahwa dia sudah mengkhianatimu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510517
					],
					"speakerTitle": "The Thing Calling Itself \"Enjou\""
				},
				{
					"id": 400510517,
					"content": "Tapi dia sudah banyak nolong kami ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400510518,
					"content": "Dia cuma memanfaatkan kalian untuk balas dendam padaku. Soalnya aku sudah lebih dulu mengkhianati mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510519
					],
					"speakerTitle": "The Thing Calling Itself \"Enjou\""
				},
				{
					"id": 400510519,
					"content": "Aku bersekutu dengan para vishap. Aku janji untuk menenggelamkan seluruh Enkanomiya ke dalam kegelapan supaya mereka dapat masuk ke Dainichi Mikoshi dan menyelamatkan kaum mereka yang terperangkap di sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510520
					],
					"speakerTitle": "The Thing Calling Itself \"Enjou\""
				},
				{
					"id": 400510520,
					"content": "Sebagai gantinya, mereka mengizinkan Abyss Order melewati daerah kekuasaan mereka tanpa diganggu, dan mereka juga membantu aku memperbaiki ketiga menara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510521
					],
					"speakerTitle": "The Thing Calling Itself \"Enjou\""
				},
				{
					"id": 400510521,
					"content": "Tapi ketika itu mereka belum tahu bahwa kegelapan Abyss adalah racun mengerikan bagi para makhluk elemental.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510522
					],
					"speakerTitle": "The Thing Calling Itself \"Enjou\""
				},
				{
					"id": 400510522,
					"content": "Jadi mereka beranggapan bahwa kamu mengkhianati mereka, gitu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510523
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400510523,
					"content": "Yah, memangnya iya sih. Lagi pula, kan memalukan juga jadinya buat Abyss Order kalau kamu melepaskan kekuatan penuh Abyss dan mereka tidak terpengaruh sama sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510524
					],
					"speakerTitle": "The Thing Calling Itself \"Enjou\""
				},
				{
					"id": 400510524,
					"content": "Dasar penjahat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510525
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400510525,
					"content": "Yah, dan kita pun sampai di sini. Begitu urusannya dengan kalian selesai, dia akan menggunakan kekuatan Dainichi Mikoshi untuk menekan Sangacorallia, dan menciptakan kegelapan yang akan melindungi para vishap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510526
					],
					"speakerTitle": "The Thing Calling Itself \"Enjou\""
				},
				{
					"id": 400510526,
					"content": "Sekarang ini mungkin mereka sudah sedang menyelam untuk menyelamatkan kaum mereka yang dipenjara di bawah sana. Dan tidak lama lagi sumber Koral Bercabang Darah akan musnah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510527
					],
					"speakerTitle": "The Thing Calling Itself \"Enjou\""
				},
				{
					"id": 400510527,
					"content": "Para Bathysmal Vishap itu memang kasihan sekali, tapi kan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510528
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400510528,
					"content": "Kalau kalian masih ingin menyelamatkan Pulau Watatsumi, bergegaslah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510529
					],
					"speakerTitle": "The Thing Calling Itself \"Enjou\""
				},
				{
					"id": 400510529,
					"content": "Kalian bisa pakai alat yang dulu kutinggalkan untuk mengarahkan cahaya dan menghalau kegelapan di Dainichi Mikoshi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510530
					],
					"speakerTitle": "The Thing Calling Itself \"Enjou\""
				},
				{
					"id": 400510530,
					"content": "Kami enggak akan percaya sepatah kata pun yang keluar dari mulutmu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510531
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400510531,
					"content": "Aduh, kalian ini ya. Memangnya ada pilihan lain?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510532
					],
					"speakerTitle": "The Thing Calling Itself \"Enjou\""
				},
				{
					"id": 400510532,
					"content": "Perjalanan ke Enkanomiya kali ini sia-sia saja buatku. Tapi ya tidak apa, aku bukan orang penting juga kok di Abyss Order.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510533
					],
					"speakerTitle": "The Thing Calling Itself \"Enjou\""
				},
				{
					"id": 400510533,
					"content": "Aku beda dengan mereka yang sampai jungkir balik demi melayani Pemimpin kami. Aku cuma tertarik sama hal-hal yang tidak penting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510534
					],
					"speakerTitle": "The Thing Calling Itself \"Enjou\""
				},
				{
					"id": 400510534,
					"content": "Waduh, waktuku sudah mau habis. Tadinya, aku mau bilang \"sampai jumpa lagi\", tapi ... tidak usah deh. Nih, hadiah perpisahan buat kalian. Sesuatu yang kupungut di Dainichi Mikoshi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510535
					],
					"speakerTitle": "The Thing Calling Itself \"Enjou\""
				},
				{
					"id": 400510535,
					"content": "Ini kok mirip sama pecahan yang Kokomi kasih .... eh, sebentar, sekarang bukan waktunya buat itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510536
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400510536,
					"content": "Uh! Paimon kesal banget! Dia kabur lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510537
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400510537,
					"content": "Kita tidak boleh percaya begitu saja, biarpun kedengarannya masuk akal. Mending kita langsung tanya Tsumi saja soal semua ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4005111,
			"completionStepIds": [
				4005111
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4005111",
							"2"
						],
						"stepId": 4005111,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400511101,
					"content": "Paimon jadi kaget. Ternyata berhasil loh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511102,
					"content": "Kali ini dia enggak nipu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511103,
					"content": "Secara teknis, dia memang tidak pernah bohong sama kita sih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400511104
					]
				},
				{
					"id": 400511104,
					"content": "Yah, orang itu cara ngomongnya saja sudah berbelit-belit, jadi ngapain dia bohong kalau hasilnya sama saja bikin bingung! Terus kenapa Paimon rasa kalian berdua kayak sudah saling mengerti satu sama lain? Enggak boleh begitu ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511105,
					"content": "Sekarang kita sudah bisa masuk lagi ke Dainichi Mikoshi. Lihat ke sana yuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4005115,
			"completionStepIds": [
				4005115
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4005115",
							"2"
						],
						"stepId": 4005115,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tsumi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400511501,
					"content": "Itu Tsumi! Ngapain dia di depan Dainichi Mikoshi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511502,
					"content": "Karena kalian sudah kembali, aku penasaran. Apa misi penyelamatan kita berhasil?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511503
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400511503,
					"content": "Ada beberapa bayi vishap yang sudah diselamatkan sebelum kami sampai di sana. Tapi yang tua dan lemah masuk lagi ke air dan sembunyi setelah kami mengalahkan yang para elitenya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511504,
					"content": "Tsumi ... apa kamu benar-benar \"Orang Vishap\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511505,
					"content": "Aku tidak berniat menjelaskan apa pun. Biarpun komunikasi kita lancar, aku tahu bahwa berurusan dengan manusia akan berakhir dengan pengkhianatan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511506
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400511506,
					"content": "Perselisihan antara kedua kaum akan terus ada sampai selama-lamanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511507
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400511507,
					"content": "Sebelum aku pergi, aku akan menghancurkan cahaya ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511508
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400511508,
					"content": "Kamu pikir kamu bisa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400511509
					]
				},
				{
					"id": 400511509,
					"content": "Jangan mendekat, dan jangan berani coba-coba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511510
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400511510,
					"content": "Menara ini mendengarkan keinginanku. Aku hanya perlu memikirkannya saja, dan cahaya yang dia keluarkan akan berubah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511511
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400511511,
					"content": "Dan dia akan menghancurkan dirinya sendiri jika aku ingin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511512
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400511512,
					"content": "Sumber kesakitan bangsa vishap ini dapat dihancurkan semudah menjentikkan jari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511513
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400511513,
					"content": "Jadi kenapa ... kenapa aku tidak bisa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511514
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400511514,
					"content": "#Astaga, ini sih lebih parah daripada kehilangan sumber Koral Bercabang Darah! Kita mesti gimana nih, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511515,
						400511516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511515,
					"content": "Tsumi. Kamu tahu ini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400511517
					]
				},
				{
					"id": 400511517,
					"content": "Ini ... astaga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511518
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400511518,
					"content": "Tsumi ingat akan liontin yang dia punya. Dia menyatukan semua pecahannya.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400511519
					]
				},
				{
					"id": 400511519,
					"content": "Liontinnya jadi berbentuk ... tiga ular yang terbelit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511520,
					"content": "Liontin ini sudah ada padaku sejauh aku bisa mengingat. Kenapa dua pecahannya yang lain ada di kamu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511521
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400511521,
					"content": "Kurasa kamu sudah tahu jawabannya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400511522
					]
				},
				{
					"id": 400511522,
					"content": "Konyol, apa kamu mau bilang kalau aku ... aku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511523
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400511523,
					"content": "Paimon bingung nih. Pecahan yang satu punya Kokomi, lalu yang satunya ada di Dainichi Mikoshi, terus yang punya Tsumi memangnya sudah ada sama dia dari dulu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511524
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511524,
					"content": "Kamu bagian dari Pulau Watatsumi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400511525
					]
				},
				{
					"id": 400511525,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511526
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400511526,
					"content": "Aku tumbuh besar bersama para vishap. Barang kepunyaanku hanyalah liontin dan beberapa kotak buku. Aku belajar bahasa dan tulisan manusia dari sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511527
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400511527,
					"content": "Tapi tidak lama kemudian, tidak ada satu manusia pun yang tersisa di Enkanomiya. Kosong melompong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511528
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400511528,
					"content": "Baru-baru ini saja aku dapat kesempatan untuk berhubungan dengan para manusia, dan jadi tahu apa sebenarnya arti dari hal-hal yang kubaca di buku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511529
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400511529,
					"content": "Tsumi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511530
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511530,
					"content": "Ada pepatah dalam buku manusia yang baru saat ini bisa kupahami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511531
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400511531,
					"content": "\"Tempat manusia adalah di mana mereka dilahirkan, namun tempat makhluk-makhluk lain adalah di mana mereka mencari makan\". Aku vishap, aku bukan manusia. Aku akan pulang ke tempatku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511532
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400511532,
					"content": "Kurasa Dainichi Mikoshi bukanlah urusanku. Tapi kami akan kembali lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511534
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400511534,
					"content": "Tsumi sudah pergi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511535
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511535,
					"content": "Kenapa dia berubah pikiran ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511536
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511536,
					"content": "Mungkin Kokomi tahu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400511537
					]
				},
				{
					"id": 400511537,
					"content": "Betul juga. Kokomi pasti sudah memikirkan kemungkinan seperti ini. Itulah kenapa dia kasih pecahan liontinnya ke kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511538
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511538,
					"content": "Urusan kita di sini sudah beres. Kita lapor sama dia yuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511516,
					"content": "Tsumi, ini buat kamu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400511517
					]
				}
			]
		},
		{
			"id": 4005116,
			"completionStepIds": [
				4005116
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4005116",
							"2"
						],
						"stepId": 4005116,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sangonomiya Kokomi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400511601,
					"content": "Hei, Kokomi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511602,
					"content": "Ah, kalian sudah kembali. Para prajurit sudah melaporkan situasinya padaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511603
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 400511603,
					"content": "Kalian bekerja sama dengan seorang miko bernama Tsumi, dan berhasil menghalau kegelapan. Namun kemudian ada hal tidak terduga yang terjadi di Dainichi Mikoshi. Sampai sini benar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511604
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 400511604,
					"content": "Betul. Terus setelah itu semuanya jadi aneh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511605,
					"content": "Kamu menceritakan semua yang terjadi pada Kokomi.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400511606
					]
				},
				{
					"id": 400511606,
					"content": "Begitu ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511607
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 400511607,
					"content": "Uhh ... maaf ya Kokomi, Paimon jadi enggak enak, main kasih liontin kamu begitu saja ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511608,
					"content": "Tidak perlu minta maaf. Aku kan sudah bilang bahwa Pulau Watatsumi tidak lagi memerlukan benda itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511609
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 400511609,
					"content": "Liontin itu adalah benda peninggalan masa lalu, dari zaman ketika semuanya baru bermula, ketika Watatsumi Omikami merombak pemerintahan Enkanomiya. Ketiga liontin itu diberikan pada Dainichi Mikoshi, keturunan Sangonomiya, dan para Pengikut Watatsumi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511610
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 400511610,
					"content": "Tujuannya adalah agar rakyat jelata, pejabat dan para pengikut dewa dapat saling mempertanggung jawabkan tindakan mereka masing-masing. Tapi hari ini hanya garis keturunan rakyat jelata sajalah yang berkembang, sementara dua sisanya sudah meredup. Liontin itu pun sudah kehilangan maknanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511611
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 400511611,
					"content": "Pengikut Watatsumi ya ... ada prajurit yang mengira kalau Tsumi adalah salah satu dari mereka. Tapi pupil matanya yang vertikal membuktikan bahwa dia itu bangsa reptilia ... Dia membohongi semua orang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511612,
					"content": "Tidak bohong kok. Pengikut Watatsumi umumnya berwujud setengah ular, setengah manusia, bentuk yang menyatakan bahwa mereka adalah pelayan dewa ular. Seiring berjalannya waktu, wujud mereka jadi semakin serupa dengan manusia biasa ... kecuali matanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511613
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 400511613,
					"content": "Tapi mengenai Orang Vishap dan Manusia Reptil ... itu cuma fiksi belaka. Tidak satu pun bukti keberadaan kaum seperti itu, bahkan di dalam catatan rahasia Sangonomiya sekalipun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511614
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 400511614,
					"content": "Oh, jadi Tsumi bukan vishap dong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511615,
					"content": "Watatsumi Omikami mengerahkan segenap kekuatannya untuk menciptakan Pulau Watatsumi. Setelah hari itu, dia pun kian hari kian melemah. Tidak ada lagi Pengikut Watatsumi yang lahir setelah peristiwa tersebut. Tapi memang ada catatan mengenai Pengikut Watatsumi yang terakhir ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511616
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 400511616,
					"content": "Semua harapan bangsa kami dibebankan ke atas pundaknya. Dialah yang seharusnya jadi jembatan antara para vishap dan kami manusia. Tapi sewaktu dia masih bayi, para vishap menyergap dirinya dan miko yang mengasuhnya di perbatasan Enkanomiya. Keberadaannya pun tak diketahui lagi semenjak saat itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511617
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 400511617,
					"content": "Kebanyakan orang yakin bahwa dia tewas hari itu. Tapi ada sebagian yang percaya bahwa dia dibesarkan oleh para vishap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511618
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 400511618,
					"content": "Penduduk pulau ini berutang budi kepada para Pengikut Watatsumi. Kini, perebutan wilayah antara para vishap dan Watatsumi sudah tinggal sejarah. Kuharap dia bisa menemukan tempat yang sesuai untuk dirinya ... di mana pun itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511619
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 400511619,
					"content": "Wow ... sulit dipercaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511620,
					"content": "Nah, karena sekarang kita sudah tahu kisah di balik Koral Bercabang Darah, maka aku, sebagai Pemimpin Suci Sangonomiya, perlu memikirkan cara baru untuk mengatasi fenomena Tanah Suci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511621
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 400511621,
					"content": "Tapi berkat kalian, masalah itu sudah selesai dan masih cukup aman untuk saat ini. Pulau Watatsumi akan damai sejahtera selama puluhan tahun ke depan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511622
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 400511622,
					"content": "Aku berutang banyak pada kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sangonomiya Kokomi"
				}
			]
		},
		{
