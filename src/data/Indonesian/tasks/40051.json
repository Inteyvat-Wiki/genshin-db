			"dialogs": [
				{
					"id": 400511901,
					"content": "Setelah dihitung semua, kayaknya bayi-bayi vishap-nya sudah enggak ada di sini deh. Apa mereka sudah ada yang nolong ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511902,
					"content": "Kalau para Bathysmal Vishap benar-benar turun ke sini, artinya si orang itu ngomong jujur loh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511903,
					"content": "Jadi ... Tsumi itu sebenarnya Orang Vishap?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511904,
					"content": "Tapi kita masih belum ketemu dia loh ... dia ke mana sih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511905,
					"content": "*huff* Sudahlah. Kita naik lagi saja lah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
