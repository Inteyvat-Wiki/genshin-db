			"dialogs": [
				{
					"id": 400511701,
					"content": "Waduh, Tsumi hilang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511702,
					"content": "Masa kelewat sih, kan enggak mungkin ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511703,
					"content": "Kenapa akhirnya selalu saja begini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400511704
					]
				},
				{
					"id": 400511704,
					"content": "Jangan gitu ah. Jangan sedih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511705,
					"content": "Lihat sisi baiknya, hampir semua prajurit sudah berhasil dievakuasi. Kalau sampai ada vishap yang lewat sini pun, harusnya sih tidak akan ada yang terluka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511706,
					"content": "Sebenarnya Paimon kepikiran si orang itu saja sudah kepingin marah, tapi sekarang memang enggak ada pilihan lain. Coba kita kasih penerangan di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
