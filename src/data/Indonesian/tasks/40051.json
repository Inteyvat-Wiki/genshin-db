			"dialogs": [
				{
					"id": 400511101,
					"content": "Paimon jadi kaget. Ternyata berhasil loh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511102,
					"content": "Kali ini dia enggak nipu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511103,
					"content": "Secara teknis, dia memang tidak pernah bohong sama kita sih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400511104
					]
				},
				{
					"id": 400511104,
					"content": "Yah, orang itu cara ngomongnya saja sudah berbelit-belit, jadi ngapain dia bohong kalau hasilnya sama saja bikin bingung! Terus kenapa Paimon rasa kalian berdua kayak sudah saling mengerti satu sama lain? Enggak boleh begitu ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511105,
					"content": "Sekarang kita sudah bisa masuk lagi ke Dainichi Mikoshi. Lihat ke sana yuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
