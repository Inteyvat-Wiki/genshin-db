			"dialogs": [
				{
					"id": 3600101,
					"content": "Heh, terlalu mudah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3600102
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3600102,
					"content": "Tapi tak kusangka, kamu jago juga ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3600103
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3600103,
					"content": "Terima kasih bantuannya. Bagaimana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3600104,
						3600105
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3600104,
					"content": "Gampang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3600106
					]
				},
				{
					"id": 3600106,
					"content": "Tapi kenapa para Hilichurl bisa ada di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3600107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3600107,
					"content": "Mereka kan biasanya enggak bikin kemah di dekat kota.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3600108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3600108,
					"content": "Betul, biasanya mereka berkemah jauh di alam liar sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3600109
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3600109,
					"content": "Tapi karena naga Stormterror sering muncul belakangan ini, banyak kebun anggur kami yang rusak, dan jalur dagang juga ikut terpengaruh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3600110
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3600110,
					"content": "Begitu badai tiba, selalu ada orang yang luka. Para anggota Knights of Favonius sibuk sana sini, dan jadi susah membagi waktu untuk melindungi daerah sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3600111
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3600111,
					"content": "Dan akhirnya makhluk-makhluk menyebalkan itu jadi semakin mendekat ke kota?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3600112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3600112,
					"content": "Betul. Tapi dengan beresnya kemah barusan, situasinya harusnya jadi bisa lebih terkendali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3600113
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3600113,
					"content": "Nah, sekarang ikut aku ya! Seorang Knight yang bertanggung jawab harus memastikan kamu aman sampai di kota.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 3600105,
					"content": "Mereka lumayan juga.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3600106
					]
				}
			]
		}
	]
