				]
			},
			"dialogs": [
				{
					"id": 740490201,
					"content": "*hiks* Bungaku yang berharga, dirusak ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490202
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490202,
					"content": "Sayang banget deh ... Jadi bungamu enggak bisa tumbuh karena dirusak sama Breacher Primus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490203,
					"content": "Aku ... akan lindungi bunga ini mulai sekarang. Aku tidak akan pergi ke mana-mana lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490204
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490204,
					"content": "Cosanzeana, tenang dulu. Kita sama-sama pikirin caranya deh. Oh ya, kenapa Breacher Primus ngerusak taman bunga segala?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490205,
						740490206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490205,
					"content": "Waktu kamu bawa bunga sebelumnya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490207
					]
				},
				{
					"id": 740490207,
					"content": "Tidak pernah! Huh! Dasar jahat! Beraninya main belakang! Huh, sekarang aku marah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490208
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490208,
					"content": "Wah! Paimon enggak sangka deh Cosanzeana juga bisa marah. Kayaknya dia benar-benar peduli banget sama bunga-bunga ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490209,
					"content": "Tapi ... Kalau dipikir lagi sih, tadi waktu Cosanzeana mendekat, Breacher Primus-nya juga kabur ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490210,
					"content": "Mungkin yang menarik Breacher Primus malah bukan bunganya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490211
					]
				},
				{
					"id": 740490211,
					"content": "Iya sih, ada kemungkinan ini juga. Kita coba periksa di sekitar taman bunga yuk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490206,
					"content": "Apa Breacher Primus pernah incar kamu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490207
					]
				}
			]
		},
		{
			"id": 7404903,
