			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cosanzeana"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2454.509,
							245.636,
							4866.675
						],
						"pointId": 340300089
					}
				]
			},
			"dialogs": [
				{
					"id": 740490301,
					"content": "#{NICKNAME} hebat sekali! Sekali pukul — \"kapow\" — kamu ubah mekanisme jelek itu jadi komponen yang indah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490302
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490302,
					"content": "Kalau begini, taman bunganya tidak akan diganggu lagi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490303
					]
				},
				{
					"id": 740490303,
					"content": "Meski ada sebagian yang sudah rusak, tapi sisanya masih bagus kok kondisinya. Breacher Primus enggak bakal ganggu taman kamu lagi, jadi bunga kamu pasti bisa tumbuh kuat dan sehat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490304,
					"content": "Luar biasa ... Tapi, aku juga jadi belajar. Harus benar-benar menjaga bunga yang berharga ini dan hati-hati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490305
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490305,
					"content": "#{NICKNAME} dan Paimon ... kalian sudah mengantarkan bunga eksotis ini, juga membantuku untuk melindungi taman bunga ... Bagaimana caraku membalas semua ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490306
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490306,
					"content": "Enggak usah sungkan begitu deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490307,
					"content": "Oh, aku tahu! Aku memetik bunga ini dengan tanganku sendiri — mereka benar-benar berharga untukku! Kuberikan untukmu ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490308
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490308,
					"content": "#Wah! Em, kalau bunga ini memang berharga banget, mungkin kamu harus tanam di taman bunga deh, {NICKNAME} ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490309,
					"content": "Oh ya, bukannya ini Tidalga? Memangnya Tidalga itu bunga juga ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490310,
					"content": "Tidalga itu tumbuhan yang indah sekali. Tentu saja termasuk bunga. Ini yang biasa manusia sebut sebagai \"biologi\" — Agar bisa jadi ahli bunga yang hebat, aku juga sudah belajar sedikit, hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490311
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490311,
					"content": "Kok kayaknya ada yang enggak beres ya ... Hemmm, tapi Paimon juga enggak ngerti soal teori klasifikasi tumbuhan sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490312,
					"content": "Aku akan terus berusaha untuk jadi ahli bunga yang lebih hebat lagi. Kata mereka, ahli bunga yang hebat bahkan bisa ciptakan jenis bunga yang baru dan bisa dibawa ke Pameran Perkebunan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490313
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490313,
					"content": "Aku juga mau ciptakan jenis bunga yang baru, agar bisa dapat \"penghargaan\" di Pameran Perkebunan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490314
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490314,
					"content": "Semangat Cosanzeana sih luar biasa, tapi kayaknya masih ada banyak kesalahpahaman yang sulit diutarakan sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490315,
					"content": "Mau ikut Pameran Perkebunan, berarti jenis bunga yang diciptakan harus diberikan kepada orang lain untuk dinilai, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490316,
					"content": "Nilai estetika dan indra Cosanzeana tuh sudah beda banget sama kaum manusia ... Bunga yang dia ciptakan, bakal jadi aneh enggak ya kalau dilihat sama manusia ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490317,
					"content": "Paimon benar-benar peduli dengan karir Cosanzeana ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490318
					]
				},
				{
					"id": 740490318,
					"content": "Oh pasti dong! Paimon itu kan guru berkebunnya Cosanzeana . Kalau Cosanzeana bisa menang dan dapat penghargaan, Paimon juga pasti bangga dong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490319,
						740490323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490319,
					"content": "Jangan terlalu pikirkan penghargaannya, yang penting senang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490320
					]
				},
				{
					"id": 740490320,
					"content": "Benar juga sih! Kalau menurut Cosanzeana, bunga yang diciptakannya itu sudah cantik, itu sudah cukup. Komentar orang lain sih enggak usah terlalu dipeduliin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490321,
					"content": "Cukup jaga taman bunganya, rawat bunganya, terus kamu bisa tetap senang deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490322,
					"content": "Ya! Aku akan pastikan mereka tumbuh sehat dan kuat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490323,
					"content": "Setidaknya langkah pertama sudah berhasil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490324
					]
				},
				{
					"id": 740490324,
					"content": "Yup! Nanti bunga baru yang diciptakan Cosanzeana mungkin agak beda sedikit, tapi pasti tetap akan ada orang yang suka!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490325,
					"content": "#Cosanzeana, kalau sudah berhasil ciptakan jenis bunga yang baru, harus langsung kasih tahu Paimon dan {NICKNAME} ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490326,
					"content": "#Tidak masalah! Paimon dan {NICKNAME} kan sudah banyak bantu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cosanzeana"
				}
			]
		},
