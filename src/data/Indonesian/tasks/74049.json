			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Cosanzeana"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740490101,
					"content": "#Halo {NICKNAME} dan Paimon yang bawa bunga dari bangsa lain!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490102
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490102,
					"content": "Halo Cosanzeana, gimana pertumbuhan bunga yang kami bawa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490103,
					"content": "Umm ... Sudah seharian aku tidak lihat bunganya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490104
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490104,
					"content": "Eh? Bukannya Cosanzeana suka banget sama bunga yang kami bawain? Kok enggak dilihat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490105,
					"content": "Bunga itu memang susah didapatkan. Jadi aku benar-benar ingin merawatnya. Tapi begitu teringat mereka mungkin bisa layu di depan mataku, aku jadi tidak berani lihat lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490106
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490106,
					"content": "#Enggak mungkin deh, sampai segitunya? ... Kita lihat bareng deh yuk! Kalau ada masalah, Paimon sama {NICKNAME} bakal bantu kamu kok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490107,
					"content": "Kalau cuma takut saja kan tidak ada gunanya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490108
					]
				},
				{
					"id": 740490108,
					"content": "#Benar juga sih ... Yuk kita pergi sama-sama. Kalau ada bantuan Paimon dan {NICKNAME}, aku jadi percaya diri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cosanzeana"
				}
			]
		},
		{
			"id": 7404902,
			"completionStepIds": [
				7404905
			],
