			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ooshima Junpei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220440101,
					"content": "Pengembara, kamu ada di sini toh! Apa kamu datang untuk berdoa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440102
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440102,
					"content": "Bagaimana dengan ukiran kayumu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220440103
					]
				},
				{
					"id": 220440103,
					"content": "Oh, bisa dikatakan cukup oke sih. Walaupun aku masih harus memperbaiki dimensinya sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440104
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440104,
					"content": "Berdasarkan pemikiranku, ukiran-ukiran kayu ini pasti bakal pas di tangan manusia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440105
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440105,
					"content": "Dengan begitu, bisa dipegang dengan mudah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440106
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440106,
					"content": "Lalu, selain dari ukiran itu sendiri, sepertinya aku harus membuat beberapa dekorasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440107
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440107,
					"content": "Aku sudah lihat bahwa saat orang membuat ukiran-ukiran ini, mereka juga akan menambahkan aksesori di sampingnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440108
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440108,
					"content": "Sesuatu seperti bunga, hewan, atau alas dengan pola bunga, sesuatu seperti itu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440109
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440109,
					"content": "Aku juga mau menambahkan dekorasi seperti itu pada ukiran kayuku. Namun, karena masalah ukurannya, aku hanya bisa menambahkan satu ornamen saja pada ukiran kayuku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440110
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440110,
					"content": "Tapi aku berpikir kalau dekorasinya bisa dilepas, aku bisa memakai dekorasi apa pun yang diminta pelangganku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440111
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440111,
					"content": "Aku mungkin akan mulai dari dekorasi sederhana... Sesuatu seperti Naku Weed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440112
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440112,
					"content": "Jadi, Pengembara, bisakah kamu membantuku mengumpulkan 3 Naku Weed agar bisa kugunakan sebagai referensi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440113,
						220440114
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440113,
					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220440117
					]
				},
				{
					"id": 220440117,
					"content": "Maaf, Pengembara, tapi kuserahkan hal ini padamu. Kembalilah dan cari aku lagi saat kamu sudah mengumpulkan Naku Weed tersebut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440114,
					"content": "Kenapa harus 3?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220440115
					]
				},
				{
					"id": 220440115,
					"content": "Kalau aku bisa dapat 3, aku bisa melihatnya di 3 posisi berbeda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440116
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440116,
					"content": "Dengan begitu, aku jadi bisa mengukir Naku Weed terbaik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440117
					],
					"speakerTitle": "Ooshima Junpei"
				}
			]
		},
