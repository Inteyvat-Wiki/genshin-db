			"dialogs": [
				{
					"id": 220440301,
					"content": "Oh, bagus! Ini harusnya cukup. Terima kasih banyak, Pengembara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440302
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440302,
					"content": "Sekarang, waktunya untuk melakukan penyelidikan kecil. Bagaimana kita akan mengukir kayu supaya jadi berbentuk seperti Naku Weed...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440303
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440303,
					"content": "Kalau aku bisa membuat dekorasi ini dengan cukup baik dan punya variasi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440304
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440304,
					"content": "Mungkin kita juga bisa menjualnya secara terpisah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ooshima Junpei"
				}
			]
		}
