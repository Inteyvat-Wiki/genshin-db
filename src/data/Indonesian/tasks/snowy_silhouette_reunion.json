			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Reckless Pallad",
					"Joel",
					"Joserf",
					"Cyrus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708030101,
					"content": "Hah? Siapa ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030102,
						708030103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708030102,
					"content": "Apa dia ... Ayahnya Joel?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708030104
					]
				},
				{
					"id": 708030104,
					"content": "Oh, Pengembara, kamu di sini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030105
					],
					"speakerTitle": "Reckless Pallad"
				},
				{
					"id": 708030105,
					"content": "Izinkan aku untuk memperkenalkan Joserf. Dia ayah Joel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030106
					],
					"speakerTitle": "Reckless Pallad"
				},
				{
					"id": 708030106,
					"content": "Papa! Ini Pengembara yang aku ceritakan. Dia sudah banyak bantu aku, dan kali ini kami bahkan bikin orang-orangan salju sama-sama!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030107
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 708030107,
					"content": "Joel sudah sering bercerita tentang kamu. Terima kasih banyak ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030108,
						708030109
					],
					"speakerTitle": "Joserf"
				},
				{
					"id": 708030108,
					"content": "Aku senang kalian bisa berkumpul kembali ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708030110
					]
				},
				{
					"id": 708030110,
					"content": "Wow! Benar-benar kabar gembira nih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708030111,
					"content": "Boleh juga, Pallad, benar-benar hebat! Kamu melakukan kerja yang bagus kali ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030112
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708030112,
					"content": "\"Kali ini\"? Apa sebelumnya pernah terjadi sesuatu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708030113,
					"content": "Um ... Kamu ingat kan orang yang terakhir kali kutemukan di Dragonspine?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030114
					],
					"speakerTitle": "Reckless Pallad"
				},
				{
					"id": 708030114,
					"content": "Setelah kamu menemaniku ke atas gunung dan menolongku mengalahkan para monster, aku melanjutkan pencarian di area tersebut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030115
					],
					"speakerTitle": "Reckless Pallad"
				},
				{
					"id": 708030115,
					"content": "Saat aku mencari, aku tak sengaja tersandung dan berguling menuruni gunung ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030116
					],
					"speakerTitle": "Reckless Pallad"
				},
				{
					"id": 708030116,
					"content": "Kamu ... berguling ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708030117,
					"content": "Untungnya, saljunya sangat tebal di bawah sana. Jadi aku tidak terluka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030118
					],
					"speakerTitle": "Reckless Pallad"
				},
				{
					"id": 708030118,
					"content": "Dan aku sedang bersiap-siap untuk kembali saat aku mendengar ada suara di samping ... lalu tiba-tiba ada orang yang muncul entah dari mana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030119
					],
					"speakerTitle": "Reckless Pallad"
				},
				{
					"id": 708030119,
					"content": "Aku tidak sadar bahwa ini adalah orang yang sedang kucari. Faktanya, aku malah menyangka dia adalah sesama petualang dalam grupku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030120
					],
					"speakerTitle": "Reckless Pallad"
				},
				{
					"id": 708030120,
					"content": "Tapi setelah mengobrol beberapa patah kata, jelas sekali bahwa dia mengalami gangguan dengan ingatannya. Dia bahkan tidak tahu namanya sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030121
					],
					"speakerTitle": "Reckless Pallad"
				},
				{
					"id": 708030121,
					"content": "Temperaturnya begitu dingin, dan tidak ada waktu untuk mengurus banyak hal, jadi aku membujuknya untuk kembali denganku ke kemah dan mencari tahu segalanya setelah kami tiba di sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030122
					],
					"speakerTitle": "Reckless Pallad"
				},
				{
					"id": 708030122,
					"content": "Kami kembali ke kemah, dan bertemu Joel. Ketika Joel melihat siapa yang ada bersamaku, dia terdiam sejenak, lalu terlihat sangat terkejut, dan teriak: \"PAPA! PAPA!\". Dan ketika itu jugalah Joserf mengingat semuanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030123
					],
					"speakerTitle": "Reckless Pallad"
				},
				{
					"id": 708030123,
					"content": "Papa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030124
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 708030124,
					"content": "Papa sudah pulang, Joel. Papa sudah pulang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030125
					],
					"speakerTitle": "Joserf"
				},
				{
					"id": 708030125,
					"content": "Joserf, apa kamu tidak ingat apa-apa lagi selain itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708030126,
					"content": "The Boar Princess, memberi makan rubah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708030127,
					"content": "Maaf, aku tidak tahu. Mungkin kepalaku terbentur? Aku tidak yakin ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030128
					],
					"speakerTitle": "Joserf"
				},
				{
					"id": 708030128,
					"content": "Aku bangun dan melihat darah di mana-mana. Barang-barangku hilang, dan tidak ada petunjuk sama sekali tentang siapa aku dan di mana aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030129
					],
					"speakerTitle": "Joserf"
				},
				{
					"id": 708030129,
					"content": "Aku merangkak ke dalam sebuah gua, dan memulihkan diri. Setelah kakiku pulih, aku bertahan hidup dengan cara berburu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030130
					],
					"speakerTitle": "Joserf"
				},
				{
					"id": 708030130,
					"content": "Papa ... Aku cemas sekali sama Papa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030131
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 708030131,
					"content": "Sekarang sudah tidak apa-apa, Joel. Jangan nangis, Papa tidak akan ke mana-mana lagi. Papa akan tinggal bersama kamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030132
					],
					"speakerTitle": "Joserf"
				},
				{
					"id": 708030132,
					"content": "Jadi sekarang bagaimana rencanamu, Joserf?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708030133,
					"content": "Aku ... Aku ingin tinggal bersama keluargaku untuk beberapa saat dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030134
					],
					"speakerTitle": "Joserf"
				},
				{
					"id": 708030134,
					"content": "Untung kamu bisa kembali dengan aman dan selamat! Bisa dibilang ini akhir yang bagus, hahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030135
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708030135,
					"content": "Pallad, jalanmu masih panjang untuk mengasah kemampuan bertualangmu. Maksudku, kamu bisa sampai tersandung dan berguling dari gunung seperti itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030136
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708030136,
					"content": "Kamu harus kembali melakukan pelatihan bersamaku saat kita sudah kembali ke Guild!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030137
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708030137,
					"content": "Hah? Ta-Tapi Tuan Cyrus ... Sepertinya aku sudah menebus kesalahanku kali ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030138
					],
					"speakerTitle": "Reckless Pallad"
				},
				{
					"id": 708030138,
					"content": "Tidak ada tapi-tapian! Ayo kita kembali ke Guild!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030139
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708030139,
					"content": "Guild Master, tolonglah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Reckless Pallad"
				},
				{
					"id": 708030109,
					"content": "Aku senang kamu baik-baik saja ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708030110
					]
				},
				{
					"id": 708030103,
					"content": "Ini sih Joel versi besar ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708030104
					]
				}
			]
		}
	]
}