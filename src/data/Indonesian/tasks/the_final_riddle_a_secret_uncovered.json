				"points": []
			},
			"dialogs": [
				{
					"id": 400130201,
					"content": "Eh, ini kan... Tunggu, aku jadi bingung. Apa ini!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130202
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400130202,
					"content": "Seluruh pulau ini seperti sebuah kotak rahasia raksasa yang tersembunyi di bawah perisai energi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130203
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400130203,
					"content": "Sepertinya ada sesuatu di sana. Ayo coba kita lihat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130204
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 400130204,
					"content": "Iya, aku mau lihat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130205
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130205,
					"content": "Akhirnya kamu datang juga, wahai gadis merah yang jahat. Aku sudah menunggu terlalu lama — membosankan sekali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130206
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130206,
					"content": "Kamu berani melawanku, Dodo-King sang pemimpin Klan Dodo!? Kupuji keberanianmu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130207
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130207,
					"content": "Keberanianmu memang pantas kuacungi jempol, tapi sudah tidak artinya lagi, karena...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130208
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130208,
					"content": "Karena Dodo-King sebenarnya adalah aku, ibumu, Alice!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130209
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130209,
					"content": "Heh? Mama!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130210
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130210,
					"content": "Apa! Alice? Pengarang buku Panduan Wisata Teyvat!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400130211,
					"content": "Klee dan teman-teman Klee semuanya, halo! Apa kabar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130212
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130212,
					"content": "Bagaimana pengalaman kalian di sini? Seru? Cuaca cerah dan pantai biru, mmm~ Liburan yang sempurna bukan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130213
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130213,
					"content": "Tak perlu mencari tubuhku, sebenarnya aku tidak ada di sana. Alat yang sedang mengeluarkan suara untuk berbicara denganmu adalah ciptaanku sendiri, Fonograf Alice! Alat ini adalah wujud kasih sayang seorang ibu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130214
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130214,
					"content": "Oh? Kamu bercanda kan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130215
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400130215,
					"content": "Hei, aku tidak mengejutkan kalian semua, kan? Maaf ya, Klee-ku ini suka sekali mainan-mainan kecil. Sebagai ibunya, tentu saja aku ingin mendukungnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130216
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130216,
					"content": "Mainannya tidak kecil sama sekali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400130217,
					"content": "M-mama... Klee?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130218
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 400130218,
					"content": "Sayang sekali aku tidak bisa bertemu secara langsung, tapi aku akan tetap mengawasimu dari jauh, seperti biasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130219
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130219,
					"content": "Ternyata Alice! Ceroboh sekali aku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130220
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400130220,
					"content": "Tunggu, apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130221
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400130221,
					"content": "Kalian mungkin merasa semua ini aneh ya. Buat apa seorang ibu yang jauh dari rumah repot-repot menciptakan sebuah pulau ajaib?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130222
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130222,
					"content": "Ting tong! Benar sekali, aku juga sudah pernah datang ke pulau-pulau itu. Aku sangat menyukai reruntuhan kuno dan medannya yang unik. Jadi aku menyiapkan semuanya agar kalian bisa menikmati pulau-pulau itu juga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130223
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130223,
					"content": "Sepertinya mama Klee juga orang yang sangat bebas ya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400130224,
					"content": "Hehe, ada yang sedang membicarakanku di belakang ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130225
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130225,
					"content": "Eh? Ti-tidak kok! Dia masih bisa dengar ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400130226,
					"content": "Tidak perlu khawatir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130227
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400130227,
					"content": "Maksudnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400130228,
					"content": "Ibunya Klee, Alice, adalah seorang penyihir yang sangat misterius. Jangan terlalu khawatir, dia memang begitu orangnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130229
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 400130229,
					"content": "Kamu pasti penasaran dengan apa yang ada di balik surat-surat tersebut, kapal-kapal, pelampung dan juga perisai energi itu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130230
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130230,
					"content": "Mm-hmm~ Sebenarnya, aku juga berpikir melakukan hal seperti itu membutuhkan banyak usaha, tapi ini satu-satunya cara untuk mengundang semuanya ke sini, ya kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130231
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130231,
					"content": "Pulau-pulau ini mempunyai banyak cerita. Penduduk aslinya, bangkai kapal, mesin misterius... Banyak sekali kebetulan yang terjadi di tempat ini. Sayang sekali kalau aku tidak mengatur semua hal ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130232
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130232,
					"content": "Sekarang coba kutebak... Semua orang yang menerima surat harusnya sudah ada di sini. Kaeya, Diluc, Razor, Jean, Barbara...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130233
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130233,
					"content": "Lalu ada Albedo yang pintar dan dapat diandalkan, dan... Pengembara yang misterius bersama rekannya, Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130234
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130234,
					"content": "Kalian semua diundang olehku untuk menemani Klee. Terima kasih karena kalian semua sudah mau membuat kenangan musim panas yang tak terlupakan untuk putriku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130235
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130235,
					"content": "Semua yang ada di pulau ini adalah hadiah untuk kalian semua, sebagai tanda terima kasihku karena telah menemani Klee kecilku. Tapi saat kalian mendengar rekaman ini, aku sudah bertualang ke tempat yang jauh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130236
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130236,
					"content": "Kehidupan seorang petualang penuh dengan hal-hal menarik dan harus selalu bergerak cepat. Haha, tanyakan saja petualang di sebelahmu dan kamu akan tahu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130237
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130237,
					"content": "Jadi Alice sampai melakukan sejauh ini karena dia terlalu sibuk sehingga tidak bisa bersama Klee?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130238
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400130238,
					"content": "Tidak, Mama memang begitu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130239
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130239,
					"content": "Sekarang, jika kalian semua ingin mencoba menemukan arti tersembunyi di balik semua ini, harus kukatakan bahwa sebenarnya situasinya tidak begitu rumit seperti yang kalian pikir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130240
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130240,
					"content": "Alasan aku menyukai Mondstadt adalah karena kebebasan Mondstadt sesuai dengan yang diinginkan olehku dan putriku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130241
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130241,
					"content": "Harapanku sederhana: Aku ingin Klee tumbuh dewasa menjadi seseorang yang dipenuhi rasa ingin tahu dengan hati yang baik. Apa pun yang dia inginkan, dia bisa melakukan apa pun dan pergi ke manapun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130242
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130242,
					"content": "Jadi begitu. Yah, perlu kuakui ini memang gayanya Alice. Maaf, aku salah paham.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130243
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400130243,
					"content": "Sepertinya asik ya punya ibu yang seperti itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130244
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400130244,
					"content": "Benar! Mama adalah yang terbaik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130245
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130245,
					"content": "Mama, kita menangkap ikan, berlayar dengan perahu, pergi berenang, terus melakukan hal lain juga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130246
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130246,
					"content": "Semuanya begitu baik padaku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130247
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130247,
					"content": "Lain kali, Mama bisa datang dan main sama kami!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130248
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130248,
					"content": "Sepertinya ibu dan putrinya ini memang berjiwa bebas ya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130249
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400130249,
					"content": "Musim panas... Bicara soal musim panas, saat aku pergi ke pulau-pulau tersebut, kebetulan juga sedang musim panas. Duduk di pantai, mendengarkan suara ombak yang bergulung di kakiku, dan aku memikirkanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130250
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130250,
					"content": "Klee, kamu adalah anak musim panas, hadiah untukku dari lautan dan angin. Mama berterima kasih sekali atas kelahiranmu dan ingin memberikan sesuatu padamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130251
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130251,
					"content": "Jadi Mama mendekorasi pulau-pulau ini, merubahnya reruntuhan kuno menjadi taman musim panas, dan menggunakan nama Dodo-king untuk mengundangmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130252
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130252,
					"content": "Di dunia lain, ada banyak cerita tentang pulau-pulau ajaib yang dinamai dari apel emas. Pulau tersebut punya berbagai nama, melambangkan sesuatu yang begitu megah berasal dari imajinasi manusia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130253
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130253,
					"content": "Mama benar-benar menyukai cerita itu dan berharap kamu bisa menikmati keajaiban tersebut, jadi Mama berikan padamu air bagaikan safir, pasir bagaikan mutiara, dan surga yang fantastis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130254
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130254,
					"content": "Untukmu dan untuk mereka yang mencintaimu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130255
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130255,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130256
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400130256,
					"content": "Jadi hanya ada tiga kristal... Merah seperti kelopak bunga, biru muda seperti ombak lautan, kuning muda seperti daun musim gugur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130257
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400130257,
					"content": "Mungkin dari perspektif Alice, kepulauan ini adalah kristal alami keempat. Berlokasi di tengah-tengah laut dan diselimuti oleh alam. Benar-benar melambangkan \"Kristal Musim Panas.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130258
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400130258,
					"content": "Klee, sama seperti Mama, kamu adalah ras yang diberkati dengan umur yang panjang. Bagi kita, waktu bagaikan embusan angin: setiap momen datang dan akan berakhir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130259
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130259,
					"content": "Dengan hidup yang begitu lama, orang tua adalah koneksi pertama yang dimiliki oleh anak. Walaupun kita tidak ingin terpisah, akan ada masa saat kamu harus berjalan di jalanmu sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130260
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130260,
					"content": "Klee, Mama akan selalu mencintaimu, tapi jangan lupa ada banyak orang lain di sisimu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130261
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130261,
					"content": "Teman-teman yang menemanimu, guru-guru yang mengajarimu, orang-orang yang bersedia tinggal di pulau bersamamu walaupun tahu ini bukan pulau biasa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130262
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130262,
					"content": "Musim panas adalah untuk semua orang. Tidak peduli bagaimana hidup berubah, tidak begitu seberapa banyak kejadian yang terjadi tahun ini, musim panas tidak akan pernah menghilang, sama seperti cinta di antara orang-orang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130263
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130263,
					"content": "Mulai sekarang, tidak peduli ke mana pun kamu pergi, Mama harap kamu tidak akan pernah lupa berapa banyak orang di dunia ini yang begitu mencintaimu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130264
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130264,
					"content": "Oh, ya, kamu harus mendengarkan Albedo saat di rumah ya. Mama akan tetap pulang sekali-sekali untuk melihat kondisi kalian berdua. Sebenarnya, tiap kali ada waktu Mama selalu diam-diam kembali untuk melihat kondisi kalian dan semua orang. Hee-hee, tidak ada yang sadar ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130265
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130265,
					"content": "Bibi Alice, masih belum berubah juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130266
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 400130266,
					"content": "Apa menurutmu dari awal Albedo sudah tahu...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130267
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400130267,
					"content": "Eh? Waktunya sudah hampir tiba, jadi aku akan berhenti di sini. Oke, oke, aku sudah melakukan semua yang aku bisa untuk tempat ini, jadi kalian semua harus main sepuasnya ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130268
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130268,
					"content": "Semuanya, Klee-ku tersayang, sampai jumpa lagi ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130269
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130269,
					"content": "Dadah, Mama!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130270
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130270,
					"content": "Klee sepertinya senang sekali.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130271
					]
				},
				{
					"id": 400130271,
					"content": "Hehe... Jadi Dodo-King sebenarnya adalah Mama. Tidak tahu kenapa, tapi aku senang sekali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130272
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130272,
					"content": "Tidak masalah jika Mama yang meledakkan gerbang utama Mondstadt, atau Mama yang dikurung, atau Mama yang menulis surat aneh untuk Klee. Klee sayang sekali sama Mama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130273
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130273,
					"content": "Apa kamu akan kesepian tanpa ibumu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130274
					]
				},
				{
					"id": 400130274,
					"content": "Tidak tuh. Mama adalah penyihir terhebat, jadi dia bisa menemaniku tidak peduli dimana pun dia berada. Dia tidak pernah membiarkanku merasa kesepian!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130275
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130275,
					"content": "Aku sayanggggggg sekali sama Mama!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130276
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130276,
					"content": "Kak Honorary Knight sayang Klee tidak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130277
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130277,
					"content": "Yap.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130278
					]
				},
				{
					"id": 400130278,
					"content": "Aku juga sayang sekali padamu! Kamu harus banyak main denganku di sini, kalau tidak nanti Mama kecewa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130279
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130279,
					"content": "Aku masih punya banyak Jumpy Dumpties dan aku juga bawa Dodoco ke sini. Akan kubawa kamu berenang terus kita bisa meledakkan ikan-ikan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130280
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130280,
					"content": "Saat kami bersamamu, semuanya jadi menyenangkan, Klee!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130281
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400130281,
					"content": "Hei, ayolah~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130282
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130282,
					"content": "Ayo jangan buat Klee menunggu lagi. Ayo, kita pergi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4001303,
