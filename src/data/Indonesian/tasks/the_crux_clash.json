			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Rongshi",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20010601,
					"content": "Aku banjir keringat. Boleh juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010602
					],
					"speakerTitle": "Rongshi"
				},
				{
					"id": 20010602,
					"content": "Selamat, aku kalah dari yang paling hebat. Aku harus berlatih lebih keras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010603,
						20010604
					],
					"speakerTitle": "Rongshi"
				},
				{
					"id": 20010603,
					"content": "Kamu juga hebat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010605
					]
				},
				{
					"id": 20010605,
					"content": "Iya! Tadi sengit sekali, Paimon sampai tegang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20010606,
					"content": "Kalau kamu punya Vision, pasti bisa lebih hebat lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20010607,
					"content": "Waktu kecil, aku juga ingin punya Vision. Katanya pasti ada kemungkinan, asalkan cukup kuat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010608
					],
					"speakerTitle": "Rongshi"
				},
				{
					"id": 20010608,
					"content": "Sayangnya, sampai sekarang aku belum dapat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010609
					],
					"speakerTitle": "Rongshi"
				},
				{
					"id": 20010609,
					"content": "Lama-lama minatku pada Vision hilang. Lagi pula, lebih mantap mengandalkan tubuhmu sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010610
					],
					"speakerTitle": "Rongshi"
				},
				{
					"id": 20010610,
					"content": "Aku pernah menang melawan pemegang Vision. Kekuatan seperti itu hanyalah pemberian para dewa. Aku tidak iri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010611
					],
					"speakerTitle": "Rongshi"
				},
				{
					"id": 20010611,
					"content": "Eh? Tapi kamu tidak mengincar Vision tanpa pemilik itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20010612,
					"content": "Tidak, aku hanya ingin uji kemampuanku melawan petarung lain, supaya tahu siapa yang lebih kuat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010613
					],
					"speakerTitle": "Rongshi"
				},
				{
					"id": 20010613,
					"content": "Dari kekalahan, kita belajar mengenai kelemahan kita dan bagaimana cara mengatasinya. Hari ini aku sangat senang, karena jarang sekali bisa kalah seperti ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010614
					],
					"speakerTitle": "Rongshi"
				},
				{
					"id": 20010614,
					"content": "Wow... Kata-kata hebat dari orang hebat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20010615,
					"content": "Kalau ada kesempatan, kita bertanding lagi. Aku pasti sudah lebih kuat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010616
					],
					"speakerTitle": "Rongshi"
				},
				{
					"id": 20010616,
					"content": "Aku juga sama.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010617
					]
				},
				{
					"id": 20010617,
					"content": "Ngomong-ngomong, kamu tahu siapa yang lolos ke final? Apa dia lebih kuat dari kamu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20010618,
					"content": "Aku tidak tahu apa dia lebih kuat, tapi kudengar dia luar biasa \"lincah\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010619
					],
					"speakerTitle": "Rongshi"
				},
				{
					"id": 20010619,
					"content": "Jangan dianggap remeh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rongshi"
				},
				{
					"id": 20010604,
					"content": "Kamu punya potensi untuk jadi juara.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010605
					]
				}
			]
		},
