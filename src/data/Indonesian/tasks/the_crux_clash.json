			},
			"dialogs": [
				{
					"id": 20011101,
					"content": "Nah, karena sekarang tinggal kita berdua saja di sini, aku langsung saja ke intinya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011102
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011102,
					"content": "Kamu bisa memanipulasi kekuatan elemental, dan bukan hanya satu. Benar kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011103,
						20011104
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011103,
					"content": "Ah, jadi kamu sudah tahu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011105
					]
				},
				{
					"id": 20011105,
					"content": "Paimon sudah menduga kalau kamu merujuk ke suatu hal dari pertama kali kita ketemu. Kamu sudah tahu dari awal ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20011106,
					"content": "Betul. Jika peserta yang lain tahu kalau kamu bisa tentang kekuatan elemental milikmu, mereka bisa salah paham.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011107
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011107,
					"content": "Jika perkiraanku benar, kamu juga mempertimbangkan hal ini dan memutuskan untuk tidak menggunakan kekuatan elemental tanpa peduli sepanas apa pun pertandingannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011108
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011108,
					"content": "Iya, tapi bagaimana kamu bisa tahu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011109
					]
				},
				{
					"id": 20011109,
					"content": "Hehe, saat aku bicara tentang yang kulihat atau kudengar darimu, aku bukan mencoba untuk puitis. Aku mengatakannya secara harfiah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011110
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011110,
					"content": "Sejak kecil, aku memang dekat dengan alam. Aku bisa mendengar napas angin dan bisikan dedaunan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011111
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011111,
					"content": "Alamlah yang memberitahuku tentang kamu. Seperti itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011112
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011112,
					"content": "Kedengarannya tidak masuk akal, tapi anehnya Paimon percaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20011113,
					"content": "Kemampuan sederhana ini tidak ada apa-apanya dibanding perbuatanmu yang luar biasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011114
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011114,
					"content": "Aku tidak menyangka ada manusia yang bisa memanipulasi elemen tanpa Vision...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011115
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011115,
					"content": "Dan juga aromamu yang khas, misterius sekali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011116
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011116,
					"content": "Hei, berhenti menilai kami dari bau! Merinding nih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20011117,
					"content": "Bolehkah kamu memberitahuku bagaimana caranya kamu mendapatkan kemampuan elemental gabungan seperti itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011118,
						20011119
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011118,
					"content": "Aku juga tidak tahu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011120
					]
				},
				{
					"id": 20011120,
					"content": "Hmm, luar biasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011121
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011121,
					"content": "Kalau begitu izinkan aku bertanya, bagaimana caranya kamu belajar menyalurkan energi elemental dan bahkan menggunakannya dalam pertempuran?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011122,
						20011123
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011122,
					"content": "Semua berkat ilmu dari Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011124
					]
				},
				{
					"id": 20011124,
					"content": "#Ah itu bukan apa-apa. Paimon cuma bilang pada {NICKNAME} apa yang kepikiran saja kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20011125,
					"content": "#Perjalanan kami panjang, dan ada banyak hal yang terjadi. Entah bagaimana caranya, {NICKNAME} dengan sendirinya jadi bisa mengendalikan kekuatan elemental...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20011126,
					"content": "Sejujurnya, Paimon juga tidak paham kenapa bisa begitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20011127,
					"content": "Mungkin, hal yang melampaui nalar seperti ini memanglah intisari dari para dewa dan Vision yang mereka anugerahkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011128
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011128,
					"content": "Namun, aku tetap berharap dapat melihat caramu menggunakan kekuatan elemental, mungkin dengan begitu akan menyingkapkan sesuatu padaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011129
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011129,
					"content": "Tentu saja, aku juga akan memberitahumu semua yang sudah kupelajari. Agar semuanya adil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011130,
						20011131
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011130,
					"content": "Boleh saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011132
					]
				},
				{
					"id": 20011132,
					"content": "Baiklah, sekarang kita coba kemampuanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011131,
					"content": "Akhirnya, pertarungan sungguhan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011132
					]
				},
				{
					"id": 20011123,
					"content": "Semua berkat persahabatanku dengan Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011124
					]
				},
				{
					"id": 20011119,
					"content": "Yang kulakukan cuma menyentuh Patung The Seven.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011120
					]
				},
				{
					"id": 20011104,
					"content": "Pantas saja kamu tidak mau ngomong di arena.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011105
					]
				}
			]
		},
		{
