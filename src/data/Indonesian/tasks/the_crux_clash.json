				},
				{
					"id": 20012202,
					"content": "Gunakanlah kesempatan ini kalau memang kamu ingin menanyakan sesuatu kepadanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Beidou"
