			"dialogs": [
				{
					"id": 20011301,
					"content": "Hmm, kemampuan bertarungmu memang tidak perlu diragukan. Meskipun lawanmu di babak final sangat lincah, dia tidak akan bisa mengalahkanmu begitu saja.",
					"roleType": "TALK_ROLE_NPC",
