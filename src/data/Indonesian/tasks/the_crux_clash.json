			"dialogs": [
				{
					"id": 20012301,
					"content": "Kamu mengontrol kekuatan elemental tanpa menggunakan Vision, artinya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20012302
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20012302,
					"content": "Oh, tidak usah pedulikan aku, aku hanya bergumam sendiri. Ehem, aku pasti akan mengamati pertarunganmu dengan saksama.",
					"roleType": "TALK_ROLE_NPC",
