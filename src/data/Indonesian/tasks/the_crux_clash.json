					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20010901,
					"content": "Sungguh pertandingan yang luar biasa. Perlu diacungi jempol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010902
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010902,
					"content": "Aku bisa merasakan kalau kamu tidak terbiasa dengan pertandingan macam ini, kamu bisa saja kalah karenanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010903
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010903,
					"content": "Tapi kamu menyesuaikan diri dengan cepat dan berhasil mengalahkan lawanmu. Sungguh keahlian yang luar biasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010904,
						20010905
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010904,
					"content": "Mata yang tajam.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010906
					]
				},
				{
					"id": 20010906,
					"content": "Sebenarnya aku bukan \"melihat\" kemampuanmu, tapi mendengarkan — suara tanah yang kamu injak dan irama napasmu. Ini bukan apa-apa, Kapten Beidou juga membuat kesimpulan yang sama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010907
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010907,
					"content": "Ahaha, begitulah. Kalau aku hanya murni mengandalkan pengalamanku sebelumnya saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010908
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20010908,
					"content": "Kurasa, tidak menggunakan kekuatan elemental adalah sesuatu yang baru bagimu, ya kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010909,
						20010910
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20010909,
					"content": "Iya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010911
					]
				},
				{
					"id": 20010911,
					"content": "Kami mau tanya siapa lawan kami di babak final. Apa dia akan lebih kuat dari orang-orang yang kami hadapi di semi-final tadi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010912
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20010912,
					"content": "Belum tentu. Peserta yang lolos ke final bukan berarti lebih \"kuat\", mereka biasanya punya keunikan tersendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010913
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20010913,
					"content": "Orang yang akan kamu lawan, kelebihannya ada di kecepatan, dan ilmu yang tinggi. Jelas terlihat kalau dia sudah melewati banyak pertempuran semasa hidupnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010914
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20010914,
					"content": "Kenapa? Kamu tidak yakin? Takut tidak sanggup?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010915,
						20010916
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20010915,
					"content": "Lebih baik waspada daripada celaka.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010917
					]
				},
				{
					"id": 20010917,
					"content": "Kalau begitu, aku punya penawaran untukmu. Ayo kita ke tempat yang lebih sepi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010918
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010918,
					"content": "Aku belum memperkenalkan diriku dengan resmi. Di Inazuma, aku adalah seorang Ronin, samurai yang mengembara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010919
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010919,
					"content": "Sudah kelihatan dari baju kamu sih. Tapi, gaya bicaramu tidak seperti orang yang suka main pedang loh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010920
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20010920,
					"content": "Memang benar bahwa aku punya wawasan baik dalam sastra maupun bela diri. Tapi di jalan berliku seorang Ronin, tidak ada salahnya kan kalau punya keahlian lebih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010921
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010921,
					"content": "Bukan maksudku memamerkan kemampuan bela diriku, tapi aku sendiri sudah menyaksikan banyak petarung hebat dari berbagai penjuru. Sedikit banyak, aku cukup memahami kemampuan lawanmu itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010922
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010922,
					"content": "Dengan bakatmu, sedikit petunjuk dariku sudah cukup untuk mengalahkan lawanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010923
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010923,
					"content": "Sebentar! Kamu tidak merasa ini menyalahi aturan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010924
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20010924,
					"content": "Mengumpulkan informasi adalah bagian penting dari suatu pertandingan. Kamu harus kenal siapa lawanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010925
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010925,
					"content": "Lagi pula, peserta favorit kita ini sudah melewati banyak pertarungan sejak beranjak dari Mondstadt. Pencapaian demikian tentu perlu lebih dari sekadar keberanian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010926
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010926,
					"content": "Iya dong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010927
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20010927,
					"content": "Eh, sebentar, sebentar. Kami belum pernah bilang kalau kami pernah ke Mondstadt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010928
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20010928,
					"content": "Hehe, bukankah seseorang meninggalkan jejak ketika mengembara di alam liar? Demikian pula sebaliknya, alam liar pun meninggalkan jejaknya pada dirimu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010929
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010929,
					"content": "Namun, hanya sekian saja yang bisa disimpulkan dari jejak-jejak tersebut. Aku merasa bahwa masih banyak hal tentangmu yang belum jelas... Hal-hal yang membuatku penasaran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010930
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010930,
					"content": "Ikutlah denganku. Anggap saja hiburan setelah pertandingan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010916,
					"content": "Sangat penting bagi kami untuk bisa ke Inazuma.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010917
					]
				},
				{
					"id": 20010910,
					"content": "Yes, sedikit lagi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010911
					]
				},
				{
					"id": 20010905,
					"content": "Kamu jeli juga.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010906
					]
				}
			]
		},
