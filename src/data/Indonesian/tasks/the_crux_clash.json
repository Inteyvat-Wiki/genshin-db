	"talks": [
		{
			"id": 200103,
			"completionStepIds": [
				200103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200103",
							"2"
						],
						"stepId": 200103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Beidou",
					"Kaedehara Kazuha",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20010301,
					"content": "Hahaha, aku sudah tahu kalau aku tidak akan menyesal memperkenalkanmu sebagai peserta favorit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010302
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20010302,
					"content": "Apa komentarmu, Kazuha? Dia benar-benar mendominasi lawannya, dengan keren pula.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010303
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20010303,
					"content": "Mengagumkan. Tapi aku juga perhatikan bahwa favorit kita ini menahan diri seakan-akan menjaga agar lawannya tidak sampai terluka parah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010304
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010304,
					"content": "Aku sendiri sudah melewati ratusan pertarungan, besar maupun kecil. Dan aku bisa lihat kemampuannya dari pertarungan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010305
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20010305,
					"content": "Ayolah, aku tahu kosakatamu banyak — bisa kan kamu mengatakan sepatah dua patah kata untuk calon juara kita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010306
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20010306,
					"content": "Baiklah... Biar kupikirkan bagaimana menuangkan pujian dengan kata-kata...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010307
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010307,
					"content": "...Kamu bertarung dengan baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010308
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010308,
					"content": "Ah sudahlah. Kukira sisi penyairmu mau ikut bicara... Mungkin seharusnya aku tidak dengan serta-merta bertanya begitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010309
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20010309,
					"content": "Tahu tidak, banyak peserta datang kemari dan bilang kalau mereka kaget sekali waktu lihat sang pahlawan Liyue ikut turnamen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010310
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20010310,
					"content": "...Dan setelah kamu daftar, kami kedatangan banyak orang lain yang juga ikut daftar, termasuk banyak petarung papan atas di antaranya. Aku yakin banyak dari mereka yang datang ke sini untuk bertanding denganmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010311,
						20010312
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20010311,
					"content": "Aku tidak tahu kalau aku sedemikian tenar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010313
					]
				},
				{
					"id": 20010313,
					"content": "Haha, karena semua orang melihatmu sebagai kompetitor utama yang harus dikalahkan, kurasa aku juga sebaiknya mulai memperlakukanmu seperti itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010314
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20010314,
					"content": "Di satu sisi, kami tidak mau kamu buang-buang tenaga di babak awal hanya untuk melawan orang-orang yang kemampuannya jauh di bawahmu. Lalu kurasa kamu juga pasti sudah gatal ingin bertarung melawan seseorang yang kemampuannya sebanding denganmu kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010315
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20010315,
					"content": "Jadi, aku akan menempatkanmu langsung ke semi final!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010316
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20010316,
					"content": "Hah? Kita kan baru saja mulai babak kualifikasi... Apa sistem ini tidak ngaco jadinya kalau kita main lompat saja ke babak semi final?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20010317,
					"content": "Begitulah cara Kapten Beidou bertindak. Kamu tidak akan bisa memengaruhinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010318
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010318,
					"content": "Lagi pula, kemampuan setingkat kamu sudah pasti dapat sampai ke babak semi final.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010319
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010319,
					"content": "Paimon juga pikir gitu sih...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20010320,
					"content": "Baiklah, aku akan lihat pertandingan yang lainnya. Kalau ada lawan potensial untukmu di luar sana, aku penasaran siapa dan seperti apa orangnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010321
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20010321,
					"content": "Hari yang ditunggu telah tiba, kalian semua! Pertunjukan yang luar biasa ini akan segera dimulai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010322
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20010322,
					"content": "Hehe, Kapten sepertinya menaruh harapan yang tinggi terhadap turnamen ini. Aku sudah lama tidak melihatnya begitu antusias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010323
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010323,
					"content": "Lawanmu sudah melewati beberapa pertarungan untuk sampai ke semi final. Itu artinya dia sudah jadi seorang petarung yang paham medannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010324
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010324,
					"content": "Kamu mungkin lebih kuat darinya, tapi jangan sampai lengah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010325,
						20010326
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010325,
					"content": "Tidak akan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010327
					]
				},
				{
					"id": 20010327,
					"content": "Bagus. Tunjukkan padaku kalau kamu siap untuk menerjang badai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010328
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010328,
					"content": "Oke, cukup sampai situ dulu ngobrolnya. Para penonton sudah menunggu. Cari anggota kru yang mendaftarkanmu, dia akan mengantarmu masuk ke arena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20010326,
					"content": "Aku tidak lupa tujuanku ke sini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010327
					]
				},
				{
					"id": 20010312,
					"content": "Aku tidak paham kenapa mereka sampai segitunya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010313
					]
				}
			]
		},
		{
