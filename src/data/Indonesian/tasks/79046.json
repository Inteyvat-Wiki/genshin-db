			"dialogs": [
				{
					"id": 790460901,
					"content": "\"Tetesan Air\" sudah jadi batu yang enggak bisa gerak, apa masih bisa minum penawarnya? Terus, gimana caranya air minum air ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790460902,
					"content": "Jangan-jangan, ramuan ini buat dipakai di luar badan? Yuk kita coba!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7904610,
			"completionStepIds": [
				7904610
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7904610",
							"2"
						],
						"stepId": 7904610,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 790461001,
					"content": "Sialan, sama sekali enggak bisa menghindari tatapan sebanyak ini. Curang banget sih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461002,
					"content": "Rasanya benar-benar mau tendang mekanisme para hantu itu sampai rusak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461003,
					"content": "Tunggu, \"Tetesan Air\", kamu mau apa? Sebelah sana daerah tatapan para hantu, bahaya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461004
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461004,
					"content": "Makhluk berisik, kamu sudah gila ya? Atau kamu sudah pasrah, mau cepat bertemu dengan rekanmu di dunia lain?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461005
					],
					"speakerTitle": "Pemimpin Hantu yang Murka"
				},
				{
					"id": 790461005,
					"content": "Wah! Dia mau pakai badannya buat menghalangi tatapan ... duh kenapa harus pakai ngorbanin diri segala sih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461006
					],
					"speakerTitle": "Pemimpin Hantu yang Bahagia"
				},
				{
					"id": 790461006,
					"content": "Terjadi hal mengejutkan! Hydro Eidolon yang kesepian menghalangi di depan hantu. Tubuhnya perlahan berubah menjadi patung batu, menghalangi tatapan mematikan tersebut dengan tubuhnya sendiri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461007
					],
					"speakerTitle": "Narator dari Pengeras Suara"
				},
				{
					"id": 790461007,
					"content": "\"Tetesan Air\" ... otomatis berubah jadi batu ... semuanya demi supaya kita mendapatkan kuncinya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461008,
						790461009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461008,
					"content": "\"Tetesan Air\" masih bisa dipulihkan!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790461010
					]
				},
				{
					"id": 790461010,
					"content": "Benar! Selama enggak kelamaan dipelototin hantunya, seharusnya sih enggak masalah ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461011
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461011,
					"content": "Jangan-jangan \"Tetesan Air\" yang nemu cara ini? Pintar sekali, berani sekali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461012
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461012,
					"content": "#{NICKNAME}, ayo kita cepat cari kunci dan penawarnya, jangan bikin \"Tetesan Air\" menderita terlalu lama!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461009,
					"content": "Kita harus bergegas!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790461010
					]
				}
			]
		},
		{
			"id": 7904611,
			"completionStepIds": [
				7904612
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7904612",
							"2"
						],
						"stepId": 7904612,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 790461101,
					"content": "Narator terus menceritakan pemandangan ajaib di depan melalui pengeras suara—\\nDua orang bijak dengan pelan menuangkan ramuan di atas patung Hydro Eidolon, lalu fenomena yang menakjubkan pun terjadi ....\\nWaktu seolah berjalan mundur, dan Hydro Eidolon yang membatu kini kembali normal ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						790461102
					]
				},
				{
					"id": 790461102,
					"content": "*hiks* ... Ternyata seperti ini rasanya berubah jadi batu sepenuhnya ... sangat tidak nyaman, aku tidak boleh membiarkan para rekanku terus menanggung derita seperti ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461103
					],
					"speakerTitle": "Hydro Eidolon yang Kesepian"
				},
				{
					"id": 790461103,
					"content": "\"Tetesan Air\", kok kamu tiba-tiba langsung menerjang ke sana gitu sih, buat kaget Paimon saja! Untung kami langsung dapat penawarnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461104,
					"content": "Barusan para hantu itu terus mengeluarkan suara aneh, aku ketakutan, sama sekali tidak berani bicara ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461105
					],
					"speakerTitle": "Hydro Eidolon yang Kesepian"
				},
				{
					"id": 790461105,
					"content": "Selain itu, kalian adalah orang bijak. Aku rasa kalian sama sekali tidak perlu aku ingatkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461106
					],
					"speakerTitle": "Hydro Eidolon yang Kesepian"
				},
				{
					"id": 790461106,
					"content": "Bahkan kalau aku menjadi batu sepenuhnya, setelah mendapatkan penawar, kalian juga pasti pertama akan menyelamatkanku, sama seperti sebelumnya, tidak perlu cemas begitu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461107
					],
					"speakerTitle": "Hydro Eidolon yang Kesepian"
				},
				{
					"id": 790461107,
					"content": "Hah ... apa Paimon yang kelewat menghayati ya? Paimon khawatir banget sama Tetesan Air ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461108,
						790461109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461108,
					"content": "Menghayati juga hal bagus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790461110
					]
				},
				{
					"id": 790461110,
					"content": "Ih! Jelas-jelas Paimon kan pengunjung, malah terlalu menghayati peran, duh malu-maluin ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461111,
					"content": "Intinya ... kita sudah berhasil. Selanjutnya, kamu bawa penawar ini, pergi selamatkan teman-temanmu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461112,
					"content": "Terima kasih, terima kasih banyak! Aku ... sangat berterima kasih pada kalian!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461113
					],
					"speakerTitle": "Hydro Eidolon yang Kesepian"
				},
				{
					"id": 790461113,
					"content": "Aku dan para rekan pasti akan mengingat jasa kalian!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461114,
						790461115
					],
					"speakerTitle": "Hydro Eidolon yang Kesepian"
				},
				{
					"id": 790461114,
					"content": "Ah bukan apa-apa kok!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790461116
					]
				},
				{
					"id": 790461116,
					"content": "Mudah-mudahan para penjahat itu berhenti bikin onar ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461117,
					"content": "Ke depannya, waktu kalian main di hutan harus lebih hati-hati, jangan datang ke kastil ini lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461118,
					"content": "Selamat! Selamat! Strategi sempurna dari kalian dan keberanian Hydro Eidolon membentuk kerja sama yang sempurna, krisis kutukan hantu segera dibereskan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461119
					],
					"speakerTitle": "Narator dari Pengeras Suara"
				},
				{
					"id": 790461119,
					"content": "Kedatangan para orang bijak membuat para hantu tidak berani bertindak sembarangan lagi, Hydro Eidolon yang kesepian dan rekannya juga bisa bermain tanpa beban lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461120
					],
					"speakerTitle": "Narator dari Pengeras Suara"
				},
				{
					"id": 790461120,
					"content": "Hutan yang awalnya suram dan menyeramkan, perlahan mulai menunjukkan sisi tenang dan damainya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461121
					],
					"speakerTitle": "Narator dari Pengeras Suara"
				},
				{
					"id": 790461121,
					"content": "Drama \"Tatapan Membatu\" sudah selesai. Terima kasih telah menontonnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461122
					],
					"speakerTitle": "Narator dari Pengeras Suara"
				},
				{
					"id": 790461122,
					"content": "Oke, kita sudah selesaikan \"Tatapan Membatu\"! Rasanya cukup bagus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461123,
					"content": "Kalau cerita dan narasinya cocok, ternyata perasaan penonton juga bisa kebawa ya ... Daiya belajar dari mana sih teknik-teknik ginian?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461124,
					"content": "Kalau ada kesempatan bertemu sama Daiya, kita harus tanya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461115,
					"content": "Sama-sama!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790461116
					]
				},
				{
					"id": 790461109,
					"content": "Berarti Paimon keasyikan!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790461110
					]
				}
			]
		},
