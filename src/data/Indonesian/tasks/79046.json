			},
			"dialogs": [
				{
					"id": 790460101,
					"content": "Kru yang berakting sudah di posisi masing-masing, semua mekanisme berjalan lancar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460102
					],
					"speakerTitle": "Terompet Pengumuman Taman Bermain"
				},
				{
					"id": 790460102,
					"content": "\"Tatapan Membatu\" dari \"Fantasi Tiga Hari Daiya\" dimulai ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460103
					],
					"speakerTitle": "Terompet Pengumuman Taman Bermain"
				},
				{
					"id": 790460103,
					"content": "Di pinggir hutan yang dalam dan menakutkan, dua orang bijak, berwawasan dan pemberani menemukan sebuah Hydro Eidolon yang kesepian ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460104
					],
					"speakerTitle": "Narator dari Pengeras Suara"
				},
				{
					"id": 790460104,
					"content": "Siapa saja tolong aku ... aku tidak ingin meninggalkan rekanku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460105
					],
					"speakerTitle": "Hydro Eidolon yang Kesepian"
				},
				{
					"id": 790460105,
					"content": "\"Tetesan Air\"? \"Tetesan Air\" ternyata bisa ngomong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460106,
						790460107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790460106,
					"content": "Sebenarnya pengeras suara yang lagi bicara.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790460108
					]
				},
				{
					"id": 790460108,
					"content": "Ternyata gitu, \"Tetesan Air\" ini aktor utama dalam drama, terus mau kerja sama bareng kita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790460109,
					"content": "Untung saja, kedua orang bijak sudah mempelajari bahasa Hydro Eidolon, jadi mengerti teriakan minta tolong Hydro Eidolon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460110
					],
					"speakerTitle": "Narator dari Pengeras Suara"
				},
				{
					"id": 790460110,
					"content": "Ini jelas adalah takdir! Dalam pertemuan yang begitu mengharukan, mana mungkin tidak menolong Hydro Eidolon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460111
					],
					"speakerTitle": "Narator dari Pengeras Suara"
				},
				{
					"id": 790460111,
					"content": "Kita juga ada adegan baru? Kedengarannya cukup bagus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460112,
						790460113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790460112,
					"content": "Kita ikuti saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790460114
					]
				},
				{
					"id": 790460114,
					"content": "Kami ... ketika kami tersesat di dalam hutan, kami menemukan sebuah kastil, lalu tidak sengaja membangunkan hantu di dalam kastil ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460115
					],
					"speakerTitle": "Hydro Eidolon yang Kesepian"
				},
				{
					"id": 790460115,
					"content": "Dua pemimpin hantu memberi kami ... kutukan, asalkan ditatap oleh para hantu, maka kami akan menjadi batu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460116
					],
					"speakerTitle": "Hydro Eidolon yang Kesepian"
				},
				{
					"id": 790460116,
					"content": "Aku berhasil kabur, tapi rekan lainnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460117
					],
					"speakerTitle": "Hydro Eidolon yang Kesepian"
				},
				{
					"id": 790460117,
					"content": "*hiks* ... Mereka pasti sangat menderita ... apa ini salah kami?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460118
					],
					"speakerTitle": "Hydro Eidolon yang Kesepian"
				},
				{
					"id": 790460118,
					"content": "Ya enggak dong walaupun para hantu itu memang bandel, tapi enggak boleh nindas orang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790460119,
					"content": "Sialan ... mengubah \"Tetesan Air\" yang tersesat menjadi batu, itu sudah lebih parah daripada nindas! Para hantu itu jahat banget!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460120,
						790460121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790460120,
					"content": "Kita harus kasih mereka pelajaran yang tak terlupakan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790460122
					]
				},
				{
					"id": 790460122,
					"content": "Tidak bisa, kedua pemimpin hantu itu tidak pernah muncul, lalu kastil itu juga sangat besar, mau sehebat apa pun juga tidak akan mampu menemukan mereka ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460123
					],
					"speakerTitle": "Hydro Eidolon yang Kesepian"
				},
				{
					"id": 790460123,
					"content": "Tapi aku mendengar salah satu hantu mengatakan di peti harta dalam kedalaman kastil, terdapat Ramuan Kuno Penghancur Kutukan. Ramuan itu adalah satu-satunya harapan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460124
					],
					"speakerTitle": "Hydro Eidolon yang Kesepian"
				},
				{
					"id": 790460124,
					"content": "Peti harta itu dikunci di dalam sebuah kamar rahasia, kita harus menemukan kuncinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460125
					],
					"speakerTitle": "Hydro Eidolon yang Kesepian"
				},
				{
					"id": 790460125,
					"content": "Tapi, aku sudah terkena kutukan, kalau kembali ke kastil sendirian pasti akan diincar oleh hantu lain, lalu perlahan membatu, sampai tidak bisa bergerak selamanya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460126
					],
					"speakerTitle": "Hydro Eidolon yang Kesepian"
				},
				{
					"id": 790460126,
					"content": "Gampang! Kami yang antar kamu balik ke kastil buat cari kunci dan ambil ramuannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790460127,
					"content": "Asalkan kamu menghindari tatapan para ... hantu, kayaknya enggak akan ada masalah, kan? Kedengarannya enggak susah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790460128,
					"content": "Benar, kalian adalah ... orang bijak. Kalian pasti ada cara ... aku mohon pada kalian ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460129,
						790460130
					],
					"speakerTitle": "Hydro Eidolon yang Kesepian"
				},
				{
					"id": 790460129,
					"content": "Paimon cepat sekali menyesuaikan diri dengan karakter.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790460131
					]
				},
				{
					"id": 790460131,
					"content": "Hehe, kedengarannya cukup gampang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790460132,
					"content": "Meski enggak bisa menghajar dalang di balik ini, kamu bisa dengan mudah menghajar semua hantu yang ada, membantu \"Tetesan Air\" menyelamatkan rekannya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790460133,
					"content": "Tenang saja, \"Tetesan Air\", kita berangkat bareng, pergi cari ramuan itu, lalu kita patahin kutukan di badanmu terus kita selamatkan temanmu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790460130,
					"content": "Bisa menebak dengan jelas arah jalan cerita.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790460131
					]
				},
				{
					"id": 790460121,
					"content": "Kita bisa tolong rekanmu, kan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790460122
					]
				},
				{
					"id": 790460113,
					"content": "Rekanmu kenapa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790460114
					]
				},
				{
					"id": 790460107,
					"content": "Anggap saja dialog \"Tetesan Air\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790460108
					]
				}
			]
		},
