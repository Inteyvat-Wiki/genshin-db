			"dialogs": [
				{
					"id": 741380101,
					"content": "Eh, kalian sudah kembali! Kalian melewatkan sesuatu yang lucu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380102
					],
					"speakerTitle": "Kesean"
				},
				{
					"id": 741380102,
					"content": "Lucu? Apaan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741380103,
					"content": "Aku bawa ubur-ubur sambil menunggu inspeksi Tuan Augereau. Tapi pembeliku keburu datang sebelum dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380104
					],
					"speakerTitle": "Kesean"
				},
				{
					"id": 741380104,
					"content": "Katanya setelah melepas ubur-ubur pertama tempo hari, mereka jadi lebih enakan, bisnis juga ramai. Seperti diberkati langit karena berbuat kebaikan! Lalu mereka datang untuk membeli lagi buat dilepaskan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380105,
						741380106
					],
					"speakerTitle": "Kesean"
				},
				{
					"id": 741380105,
					"content": "Aku masih menangkapnya buat kamu loh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741380107
					]
				},
				{
					"id": 741380107,
					"content": "#Hmm ... {NICKNAME} nangkap, kamu jual, pembeli lepasin ... EH, ini cara kamu cari duit ya? Curang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741380108,
					"content": "HAH? Tidaklah! Mana mungkin! Aku tidak mau cari gara-gara ke Garde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380109
					],
					"speakerTitle": "Kesean"
				},
				{
					"id": 741380109,
					"content": "Ehem ... aku sudah sering bilang kalau melepas ubur-ubur ini rugi dan tidak ada untungnya. Tapi mereka tidak mau dengar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380110
					],
					"speakerTitle": "Kesean"
				},
				{
					"id": 741380110,
					"content": "Mereka percaya bahwa, keberuntungan menghampiri mereka karena sudah ... \"berbuat baik\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380111
					],
					"speakerTitle": "Kesean"
				},
				{
					"id": 741380111,
					"content": "Bahkan katanya, aku sial terus karena menangkap ubur-ubur. Ck, mikir apa sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380112
					],
					"speakerTitle": "Kesean"
				},
				{
					"id": 741380112,
					"content": "Waktu kami berdebat, Tuan Augereau datang dan langsung menangkap mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380113,
						741380114
					],
					"speakerTitle": "Kesean"
				},
				{
					"id": 741380113,
					"content": "Habis tuh keberuntungannya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741380115
					]
				},
				{
					"id": 741380115,
					"content": "Pada akhirnya, melepas ubur-ubur tanpa terlebih dahulu memahami kebiasaan dan ekologinya itu demi kebaikan ubur-uburnya, atau demi kepentingan mereka sendiri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380116
					],
					"speakerTitle": "Kesean"
				},
				{
					"id": 741380116,
					"content": "Garde menahan mereka ... \"keberuntungan\" itu akhirnya habis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741380117,
					"content": "Ha! Terima kasih juga buat kalian. Garde mencabut hukuman penjaraku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380118
					],
					"speakerTitle": "Kesean"
				},
				{
					"id": 741380118,
					"content": "Bersama kompensasi yang sudah dijanjikan, ini ada kenang-kenangan juga. Ambillah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380119
					],
					"speakerTitle": "Kesean"
				},
				{
					"id": 741380119,
					"content": "Kesean mengeluarkan bola kaca berisi ubur-ubur ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						741380120
					]
				},
				{
					"id": 741380120,
					"content": "Ehh? Ini ... Violetglow Jellyfish? Kok kecil banget, beda sama yang kami tangkap ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741380121,
					"content": "Ya, ini spesimen kecilnya. Aku pilih beberapa dari gudang kemarin, jumlahnya lebih banyak daripada nomornya, jadi aku kasih saja satu buat kenang-kenangan untuk kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380122
					],
					"speakerTitle": "Kesean"
				},
				{
					"id": 741380122,
					"content": "Sisanya akan aku kembang biakkan, sambil cari cara untuk mengintegrasikan ubur-ubur dengan lingkungan alam sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380123
					],
					"speakerTitle": "Kesean"
				},
				{
					"id": 741380123,
					"content": "Oh, aku juga mau pelihara sedikit Violetglow Jellyfish untuk mempelajari perilaku berkumpul dan bersinarnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380124,
						741380125
					],
					"speakerTitle": "Kesean"
				},
				{
					"id": 741380124,
					"content": "Yah, imut sih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741380126
					]
				},
				{
					"id": 741380126,
					"content": "WOI, tunggu dulu! Jangan dilepasin! Ingat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kesean"
				},
				{
					"id": 741380125,
					"content": "Tapi lebih imut kalau dia berenang, kan ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741380126
					]
				},
				{
					"id": 741380114,
					"content": "Hukum tabur tuai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741380115
					]
				},
				{
					"id": 741380106,
					"content": "Kok kamu masih jualan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741380107
					]
				}
			]
		}
	]
}