			"dialogs": [
				{
					"id": 4510501,
					"content": "... Kamu benar-benar ingin membantuku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510502
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510502,
					"content": "Serigala berburu berdasarkan insting, dan itu selalu berhasil. Tetapi... memasang perangkap juga terdengar menarik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510503
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510503,
					"content": "Pertama, kita pasang perangkapnya. Selanjutnya, kita siasati agar boar terperangkap – betul?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510504
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510504,
					"content": "Semoga tidak meledak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Razor"
				}
			]
		},
