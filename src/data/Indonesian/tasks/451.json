					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4510101,
					"content": "Ini adalah Wolvendom, orang-orang Mondstadt jarang sekali ada yang berani datang ke sini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510102,
					"content": "Meskipun tidak jauh dari kota, tapi lingkungan di sini tidak tersentuh. Tempat ini masih dikuasai oleh hukum alam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510103,
					"content": "Pokoknya di sana yang kuat makan yang lemah! Slime di sana juga katanya besar-besar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510104,
					"content": "Sebesar... itu, yang itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510105,
					"content": "... mereka datang! Bersiap bertarung!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 45103,
			"completionStepIds": [
				45104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"45104",
							"2"
						],
						"stepId": 45104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Razor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4510301,
					"content": "Te... terima kasih! Argh!! Serigala!! LARI!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510303,
					"content": "Jangan takut. Serigala adalah teman. Tapi... kamu siapa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510304
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510304,
					"content": "Kami bukan siapa-siapa! Hanya pengembara yang kebetulan lewat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510305,
					"content": "Kalian... wangi yang tidak biasa. Wangi kalian... *endus* seperti kukenal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510306
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510306,
					"content": "Kamu kenal wangi kami...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510307,
					"content": "Kamu tercium seperti Knights of Favonius. Aku punya teman di sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510308,
						4510309
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510308,
					"content": "Siapa namamu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4510310
					]
				},
				{
					"id": 4510310,
					"content": "Aku Razor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510311
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510311,
					"content": "Kamu juga anggota Knights of Favonius?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510312,
					"content": "Bukan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510314
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510314,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510315,
					"content": "Serigala-serigala itu...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4510316
					]
				},
				{
					"id": 4510316,
					"content": "Lupical, mereka, keluargaku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510317
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510317,
					"content": "Keluarga?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510318,
					"content": "Ya. Mereka merawatku. Kami hidup bersama... dan kami adalah keluarga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510319
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510319,
					"content": "Kurasa, aku memiliki banyak pertanyaan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510320,
					"content": "Mereka marah padaku. Karena aku menolong kalian, aku gagal menangkap boar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510321
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510321,
					"content": "#Begitu rupanya... Jangan khawatir! {NICKNAME} ahlinya berburu boar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510322,
					"content": "#{NICKNAME} lebih kuat dari kelihatannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510323,
					"content": "Ti... tidak perlu. Serigala pasti akan keburu lapar kalau harus menunggu pertolongan Knight dulu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510324
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510324,
					"content": "Jangan konyol! Tunggu di sini – kami tidak akan mengacaukannya, lihat saja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510309,
					"content": "Kamu anggota Knights of Favonius?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4510313
					]
				},
				{
					"id": 4510313,
					"content": "Aku Razor. Bukan Knight.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510314
					],
					"speakerTitle": "Razor"
				}
			]
		},
		{
