							11.813
						],
						"pointId": 4
					}
				]
			},
			"dialogs": [
				{
					"id": 150290101,
					"content": "Nah, kalau soal menenun gulungan ya, kamu sebenarnya enggak perlu susah-susah. Tapi kalau kita mau melestarikan ilmunya Huitzilin, kamu wajib ada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290102
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290102,
					"content": "Maksudnya gimana nih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290103,
					"content": "Sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290104
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290104,
					"content": "Wah, tempat apa nih ... kamu bikin gulungan juga ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290105,
					"content": "Gulungan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290106
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290106,
					"content": "Gulungan? Tadi katanya mau kasih lihat mahakarya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290107
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290107,
					"content": "Ya, benar sekali kawan. Ilmu yang mau aku kasih lihat itu berkaitan erat dengan gulungan tenun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290108
					],
					"speakerTitle": "Huitzilin"
				},
				{
					"id": 150290108,
					"content": "Ck, ya deh, iya. Apa? Bisa membalikkan situasi genting di perang? Atau bisa mencegah bencana alam?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290109
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290109,
					"content": "Kamu mau nantangin aku kan? Aku tahu betul kamu enggak kuat bertarung, jadi silakan deh. Kamu boleh menang debat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290110
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290110,
					"content": "*uhuk* Kawan lamaku ... ini nyawaku sudah di ambang pintu. Maaf, kali ini ... kita sudah tidak bisa bertanding lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290111
					],
					"speakerTitle": "Huitzilin"
				},
				{
					"id": 150290111,
					"content": "Hei ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290112
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290112,
					"content": "Tenang, aku percaya pada keyakinan suku kita. Kematian bukan akhir, melainkan permulaan kehidupan yang baru di Kerajaan Malam, tempat semua keberadaan berupa ingatan dan kenangan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290113
					],
					"speakerTitle": "Huitzilin"
				},
				{
					"id": 150290113,
					"content": "Nah, kamu tahu kenapa nenek moyang kita memilih gulungan tenun warna-warni untuk mencatat sejarah bangsa ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290114
					],
					"speakerTitle": "Huitzilin"
				},
				{
					"id": 150290114,
					"content": "Karena ... sejarah adalah ingatan manusia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290115
					],
					"speakerTitle": "Huitzilin"
				},
				{
					"id": 150290115,
					"content": "Kita beri gulungan warna oranye, tujuannya agar yang sudah meninggal masih bisa merasakan hangatnya sinar mentari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290116
					],
					"speakerTitle": "Huitzilin"
				},
				{
					"id": 150290116,
					"content": "Kita menghiasinya dengan biji Grainfruit, agar yang sudah meninggal masih bisa menikmati panen raya yang berlimpah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290117
					],
					"speakerTitle": "Huitzilin"
				},
				{
					"id": 150290117,
					"content": "Aku tahu lah ... tapi hal sepenting ini? Kenapa ke aku? Kenapa bukan ke murid-muridmu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290118
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290118,
					"content": "Hehe, sebagai teman nih ya ... jujur kali ini aku ingin egois sedikit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290119
					],
					"speakerTitle": "Huitzilin"
				},
				{
					"id": 150290119,
					"content": "*uhuk* Waktuku tinggal sebentar lagi, Citlali. Aku tidak tahu ... gimana caranya menjelaskan keputusan ini. Tapi aku yakin suatu hari nanti kamu pasti paham.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290120
					],
					"speakerTitle": "Huitzilin"
				},
				{
					"id": 150290120,
					"content": "Untuk sekarang ... mau kan, kamu kabulkan permintaan terakhirku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290121
					],
					"speakerTitle": "Huitzilin"
				},
				{
					"id": 150290121,
					"content": "Sekali ini saja ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290122
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290122,
					"content": "Aku sudah paham sekarang, Huitzilin. Tepat seperti perkiraanmu ... Cakar, tolong pindahin ini ke luar. Aku mau kasih warna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290123
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290123,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290124
					],
					"speakerTitle": "Tlapo"
				},
				{
					"id": 150290124,
					"content": "#{NICKNAME}, Paimon, sini ikut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Citlali"
				}
			]
		},
