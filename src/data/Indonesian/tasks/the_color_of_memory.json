			"dialogs": [
				{
					"id": 150295101,
					"content": "Kemenangan Natlan melawan Abyss! Sangat pas untuk gulungan sekelas ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150295102
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150295102,
					"content": "Kira-kira kapan Tetua Tlapo akan menunjuk orang baru lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150295103
					],
					"speakerTitle": "Aywastin"
				},
				{
					"id": 150295103,
					"content": "Soal Tetua Tlapo, katanya kemarin dia hilang loh! Ada apa, tahu tidak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150295104
					],
					"speakerTitle": "Besuci"
				},
				{
					"id": 150295104,
					"content": "Tetua Tlapo bekerja dengan cara yang misterius. Makna kepergiannya akan menjadi jelas seiring berjalannya waktu, tapi untuk saat ini, kita tak kuasa memahaminya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chogan"
				}
			]
		}
