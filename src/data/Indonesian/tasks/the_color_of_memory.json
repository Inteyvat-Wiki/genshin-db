			"dialogs": [
				{
					"id": 150290401,
					"content": "Ah, sudah selesai ya? Penyelidikan tentang Perang Tujuh Warna pasti membuahkan hasil yang baik. Semoga kalian berkenan membagikannya dengan kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290402
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150290402,
					"content": "Wah, gulungannya sudah selesai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290403
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150290403,
					"content": "Memang Tetua Tlapo tidak pernah salah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290404
					],
					"speakerTitle": "Aywastin"
				},
				{
					"id": 150290404,
					"content": "#Yah, kita memang sebaiknya jelasin sih ... {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290405,
					"content": "Kamu menjelaskan semua yang telah diketahui tentang warna khusus, sambil tetap merahasiakan kontribusi Citlali.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150290406
					]
				},
				{
					"id": 150290406,
					"content": "Jadi begitu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290407
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150290407,
					"content": "Kok enggak kaget?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290408,
					"content": "Karena masuk akal sekali! Sejarah adalah ingatan manusia. Kalau mau kita lukiskan, tentunya paling baik menggunakan warna yang diambil dari ingatan orang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290409
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150290409,
					"content": "Nah, sekarang tinggal urusan melestarikan ilmunya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290410
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150290410,
					"content": "Hmm ... kalau dari cerita tadi, sepertinya belajar ilmu ini mengharuskan kita menerima sebagian ingatan dari orang yang sudah bisa ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290411
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150290411,
					"content": "Kurang lebih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290412,
					"content": "#Kalau gitu aku mau coba ciptakan ulang ilmunya berdasarkan prinsip yang {NICKNAME} jelaskan tadi. Dengan bantuan para imam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290413
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150290413,
					"content": "#Karena ingatan adalah sesuatu yang berharga, untuk dibagikan dengan orang-orang terdekat. Ini pilihan, dan aku tidak mau memaksa {NICKNAME} melakukannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290414
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150290414,
					"content": "Tugasmu telah diselesaikan dengan baik. Mencari cara untuk melestarikan ilmu ini adalah tugas kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290415
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150290415,
					"content": "Baiklah, kalau gitu sekarang sudah jadi bagian kamu ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290416,
					"content": "Dan tolong sampaikan terima kasihku ke Nenek Itztli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290417
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150290417,
					"content": "Kami menginterogasi pedagang Fontaine yang dia bekuk, dan ternyata, dialah sumber perpecahan dan keraguan warga suku terhadap sejarah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290418
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150290418,
					"content": "Dia menyuruh orang menyebarkan informasi sesat tentang Perang Tujuh Warna, dan perselisihan yang terjadi di suku belakangan ini adalah ulahnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290419
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150290419,
					"content": "Pelanggaran yang dibuatnya sudah dicatat, dan beberapa hari lagi kami akan bekerja sama dengan pihak aparat Fontaine untuk menindaklanjuti kasusnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290420
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150290420,
					"content": "Jadi dia toh provokatornya! Ck, memang sih, lebih gampang menyelidiki kalau sudah ada keraguan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290421,
					"content": "Yang penting sudah beres semua lah yah! Lagian mana ada coba orang yang tiba-tiba jadi ragu sama sejarahnya sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290422,
					"content": "Makasih Biram. Kami pamit dulu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290423
					]
				},
				{
					"id": 150290423,
					"content": "Sampai jumpa lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Biram"
				}
			]
		},
