				]
			},
			"dialogs": [
				{
					"id": 150290201,
					"content": "Manusia ibarat burung yang terbang mengarungi ruang dan waktu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290203
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290203,
					"content": "(Paket Video)",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150290204
					]
				},
				{
					"id": 150290204,
					"content": "Aku tahu kamu mengerti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290205
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290205,
					"content": "Ini ... ini gulungan yang kita disuruh bikin, kan?! Citlali, kok bisa sih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290206,
					"content": "Ingat \"tuntunan roh suci\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290207
					]
				},
				{
					"id": 150290207,
					"content": "Sebentar, umur kamu sudah lebih dari dua ratus, terus kamu bisa bikin gulungan ini ... artinya, \"roh suci\" yang nuntun tuh sebenarnya KAMU, kan?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290208,
					"content": "Ah, bukannya aku sengaja mau urusan sama yang ditunjuk sih ya. Jadi setiap aku kasih gulungannya, aku pakai jurus ilusi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290209
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290209,
					"content": "Yah, bahwa akhirnya jadi dianggap \"tuntunan roh suci\" ... itu karena tidak ada seorang pun yang cukup hebat untuk membongkar ilusinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290210
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290210,
					"content": "Kenapa enggak ngomong saja sih?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290211
					]
				},
				{
					"id": 150290211,
					"content": "Selama bertahun-tahun, tugas ini kamu yang kerjain? Sendiri? Misal kamu enggak suka urusan sama orang pun, kenapa sih enggak diajarin ke siapa gitu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290212,
					"content": "#{NICKNAME}, kamu bisa lihat \"warna\" itu, ya kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290213
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290213,
					"content": "Bisa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290214
					]
				},
				{
					"id": 150290214,
					"content": "Esensi warna itu adalah ingatan. Artinya, menyelesaikan gulungan ini berarti mencari warna tersebut di dalam ingatanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290215
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290215,
					"content": "Mengajarkan ilmunya ke orang lain berarti membagi ingatanmu dengan mereka. Kamu harus meninggalkan jejak warna di dalam ingatan mereka, dan mereka juga harus melakukan hal yang sama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290216
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290216,
					"content": "Aku baru pastikan seperti itu cara kerjanya hari ini, tapi memang sudah dari dulu curiga sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290217
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290217,
					"content": "Yah, aku ... sejak Huitzilin meninggal, aku tidak pernah ingin bangun hubungan seperti itu dengan orang lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290218
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290218,
					"content": "Oh, gitu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290219,
					"content": "Ini permintaan terakhirnya, maka dari itu aku terpaksa menyanggupi. Aku siap memikul beban ini seumur hidup. Toh aku tidak akan pernah kekurangan waktu, ya kan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290220
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290220,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290221
					],
					"speakerTitle": "Tlapo"
				},
				{
					"id": 150290221,
					"content": "Tapi si Cakar selalu memilih orang baru untuk menenun gulungannya ... padahal dia tahu betul gimana pendapatku soal ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290222
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290222,
					"content": "Maksudnya dia enggak pernah nyerah nyariin teman buat kamu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290223
					]
				},
				{
					"id": 150290223,
					"content": "Aku tahu kok. Dan iya, kalau misal aku sampai berbagi ingatan dengan seseorang, maka orang itu dan aku pastilah sudah jadi teman. Tapi yah, belum pernah sampai sejauh itu sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290224
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290224,
					"content": "Tapi Cakar, kali ini kamu yang menang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290225
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290225,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290226
					],
					"speakerTitle": "Tlapo"
				},
				{
					"id": 150290226,
					"content": "Nih, ambil. Ini ... jawaban dari pembicaraan kita tempo hari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290227
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290227,
					"content": "Sebentar, ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290228,
					"content": "Kalau aku disuruh milih warna, maka ya inilah warnanya. Seperti saputangan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290229
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290229,
					"content": "Banyak orang hidup di dalam ingatanku, dan suatu hari nanti aku pun akan berakhir demikian. Ingatan yang tinggal di dalam benak seseorang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290230
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290230,
					"content": "Karena kamu juga punya masa hidup yang panjang, maka tentunya kamu yang paling layak untuk mengemban ingatan ini ... agar warnaku kekal abadi di dalam hati dan ingatanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290231
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290231,
					"content": "Berarti kali ini kita betulan sudah jadi teman ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290232
					]
				},
				{
					"id": 150290232,
					"content": "Tolong jaga saja baik-baik. Dan jangan lupakan warna ini jika aku sudah tiada kelak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290233
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290233,
					"content": "Wah, kenapa tiba-tiba jadi bahas kematian sih? Kita baru juga temenan beberapa detik loh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290234,
					"content": "Bukannya teman tuh memang harusnya gitu ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290235
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290235,
					"content": "#Oke deh, ini sudah masuk tahap komitmen loh ya ... Citlali, kalau {NICKNAME} juga harus ninggalin warna di hatimu, pasti warnanya emas dong. Betul?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290236,
					"content": "Yah, tandanya sih sudah ada. Ingat urusan baca pikiran yang aku enggak bisa beresin? Akhirnya aku tahu tuh kenapanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290237
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290237,
					"content": "Membagi indra itu sama saja mengizinkan komunikasi terjadi di antara dua kesadaran yang berbeda. Dan ingatan termasuk salah satu yang terhubung dalam prosesnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290238
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290238,
					"content": "Waktu itu aku belum sadar, tapi kita berdua sama-sama bisa melihat \"warna ingatan\". Artinya, waktu berbagi indra, ada hubungan yang terjalin di antara ingatan kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290239
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290239,
					"content": "Dan hubungan itulah yang menyebabkan mantraku jadi kacau ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290240
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290240,
					"content": "#Jadi ... kamu bisa baca pikiran si {NICKNAME} karena kalian sudah saling ninggalin jejak warna di dalam hati masing-masing?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290241
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290241,
					"content": "#Jadi itu sebabnya si {NICKNAME} bisa baca pikiran kamu juga! Soalnya komunikasi tuh dua arah, betul?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290242
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290242,
					"content": "Memang gitu, tapi cuma mereka yang belajar ilmu sihir saja yang bisa menjaga hubungan sampai setaraf itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290243
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290243,
					"content": "#Itulah kenapa aku masih bisa baca pikiran si {NICKNAME}, tapi dia sudah enggak bisa baca pikiranku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290244
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290244,
					"content": "Tenang, aku kan sudah paham cara kerjanya nih. Sekarang bisa kita matiin tuh koneksinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290245
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290245,
					"content": "Oh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290246
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290246,
					"content": "(Yang barusan tuh bohong. Baca pikiran tuh tergantung seberapa kuat hubungan antara ingatan kita berdua.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290247
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290247,
					"content": "(Jadi setelah semua peristiwa yang kita lalui tadi, aku yakin sekarang kamu jadi bisa baca pikiranku lagi.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290248
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290248,
					"content": "(!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290249
					]
				},
				{
					"id": 150290249,
					"content": "(Tuh, kan ....)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290250
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290250,
					"content": "(Jadi gimana cara berhentinya nih?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290251
					]
				},
				{
					"id": 150290251,
					"content": "(Karena hubungan ingatan kita sudah ada, jadi ya cara menghentikannya cuma satu, yakni kita saling melupakan.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290252
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290252,
					"content": "(....)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290253
					]
				},
				{
					"id": 150290253,
					"content": "(Haha, bercanda, bercanda ... aku ini dukun paling legendaris di suku. Sekarang sebabnya sudah ketahuan, ya jelas akibatnya bisa ditanggulangi lah!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290254
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290254,
					"content": "(Tapi butuh waktu ya. Jadi sabar dulu saja.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290255
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290255,
					"content": "(Lagian aku ini ibarat buku yang terbuka. Toh kamu enggak akan dengar yang malu-maluin juga ... kecuali kalau aku mabuk.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290256,
						150290259
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290256,
					"content": "(Oh, jadi bisa dimatiin nih? Sayang sekali ya ....)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290257
					]
				},
				{
					"id": 150290257,
					"content": "(Sayang sekali? Kalau kamu kangen kita bisa ngobrol pakai telepati gini, ya tinggal pakai lagi mantra pembagi indranya.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290258
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290258,
					"content": "(Tapi enggak janji ah. Ada hal-hal yang lebih baik kita simpan sendiri.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290261
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290261,
					"content": "Uhh ... eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290259,
					"content": "(Oh, jadi bisa dimatiin nih? Bagus lah.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290260
					]
				},
				{
					"id": 150290260,
					"content": "(Iya kan. Kadang ada hal yang lebih baik kita simpan sendiri.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290261
					],
					"speakerTitle": "Citlali"
				}
			]
		},
