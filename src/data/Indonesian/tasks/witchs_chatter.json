			"dialogs": [
				{
					"id": 766740101,
					"content": "Ya ampun, hasilnya benar-benar di luar dugaan .... Kalau ada yang tidak sengaja masuk, aku yakin mereka akan terpukau dengan kehebatan penyihir ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766740102,
						766740103
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766740102,
					"content": "Kalau ada yang tidak sengaja sampai ke sini ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766740104
					]
				},
				{
					"id": 766740104,
					"content": "Yah, semua itu tergantung seperti apa mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766740105
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766740105,
					"content": "Kalau tidak hati-hati, bimbingan bisa bikin orang jadi malas dan merasa berhak. Kalau ada orang yang mau berusaha dengan kemampuan sendiri seperti kamu, aku akan dengan senang hati membantunya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766740106
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766740106,
					"content": "Tapi kalau mereka tipe orang yang cuma berharap pada kekuatan penyihir, tanpa mau usaha sendiri ... Hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766740107
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766740107,
					"content": "A-Apa maksudnya \"hehe\"? Kamu beneran bakal ngubah mereka jadi patung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766740108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766740108,
					"content": "Tidak, bukan begitu. Tapi aku akan tuntun mereka keluar dari tempat ini ke Curatorium of Secrets terdekat. Aku yakin Nefer lebih tahu cara mengurus mereka dibanding aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766740109
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766740109,
					"content": "Mereka yang ingin menuai tanpa menabur tentu harus menanggung akibatnya, bukan begitu",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766740103,
					"content": "Apakah kamu akan membantu mereka mewujudkan harapannya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766740104
					]
				}
			]
		}
	]
