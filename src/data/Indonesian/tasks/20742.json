					"nextDialogs": [
						207420102
					]
				},
				{
					"id": 207420102,
					"content": "Ah! Dandelion! Semuanya sudah terbang menjauh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207420103
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207420103,
					"content": "Apa yang kamu lakukan? Aku susah payah menumbuhkannya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207420104
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207420104,
					"content": "Aku membantunya untuk menyebar jauh dan luas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207420105
					]
				},
				{
					"id": 207420105,
					"content": "Kita ada di kota! Mereka tidak akan terbang jauh karena kehalang tembok itu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207420106
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207420106,
					"content": "Dengan cara ini kan kita bisa menanam lebih banyak dandelion lagi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207420107
					]
				},
				{
					"id": 207420107,
					"content": "Kalau begitu kenapa kamu tidak sekalian mengambil Dandelion Seed dan menyebarkannya ke luar kota?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207420108
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207420108,
					"content": "Ugh, dandelionku! Aku susah payah menumbuhkannya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207420109
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207420109,
					"content": "Ka-Kalau kamu membutuhkan dandelion lagi, kan bisa mengumpulkannya dari luar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207420110
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207420110,
					"content": "Dandelion ini kan kamu yang mengumpulkannya juga. Butuh waktu lama untuk menumbuhkannya... dan lihatlah apa yang kamu lakukan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				}
			]
		},
