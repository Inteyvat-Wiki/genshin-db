			"dialogs": [
				{
					"id": 756750101,
					"content": "Hei! Ha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750102
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 756750102,
					"content": "Kepalaku sudah penuh dengan musik, ayo menari, menari!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750103
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 756750103,
					"content": "Bergoyang bergoyang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750104
					],
					"speakerTitle": "Sedile"
				},
				{
					"id": 756750104,
					"content": "Bahagia selalu—!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750105
					],
					"speakerTitle": "Manaia"
				},
				{
					"id": 756750105,
					"content": "Wuah wuah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750106
					],
					"speakerTitle": "Moo"
				},
				{
					"id": 756750106,
					"content": "Dan dapat penghasilan tambahan pula.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750107
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 756750107,
					"content": "Hah? Dasar bocah, kapan terjadinya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750108
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 756750108,
					"content": "Nusta lagi kerepotan, jadi aku meluangkan waktu untuk bantu muridnya bersihkan sarang monster.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750109
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 756750109,
					"content": "Di Natlan, bertarung sama menyenangkannya dengan menari. Aku suka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750110
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 756750110,
					"content": "Sudah merepotkanmu, Marine. Niatku memang ingin melatih pendatang baru, tapi ternyata mereka masih belum bisa menyelesaikan misi secara mandiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750111
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 756750111,
					"content": "Setelah aku kembali, akan kulatih mereka lebih keras!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750112
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 756750112,
					"content": "Tidak kok, mereka bertarung dengan bagus. Cuma saja tidak terduga, ternyata ada monster tujuh kali lipat dari perkiraan di sarangnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750113
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 756750113,
					"content": "Bunga Bersayap memberi banyak uang, bahkan uang untuk beli hadiah Aeval pun sudah terkumpul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750114
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 756750114,
					"content": "Tapi waktu liburanmu juga hampir habis, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750115
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 756750115,
					"content": "Setelah bermain beberapa hari lagi, aku bisa pesan tiket kapal dan mulai pikirkan perjalanan pulang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750116
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 756750116,
					"content": "Tidak perlu terburu-buru, masih bisa menari. Roxane kecil, Letellier, Chenee, dan Frejus belakangan ini juga berebut misi, aku tidak mau bersaing dengan mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750117
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 756750117,
					"content": "Kalau begitu teruslah menari, teruslah bersenang-senang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750118
					],
					"speakerTitle": "Sedile"
				},
				{
					"id": 756750118,
					"content": "Kalau capek menari, makan. Kalau kenyang, tidur. Jangan galau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750119
					],
					"speakerTitle": "Manaia"
				},
				{
					"id": 756750119,
					"content": "Eeeh——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750120
					],
					"speakerTitle": "Moo"
				},
				{
					"id": 756750120,
					"content": "Para Melusine dan Koholasaurus kecil berbaris, melompat-lompat menuju panggung.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						756750121
					]
				},
				{
					"id": 756750121,
					"content": "Lucu sekali mereka ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750122
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 756750122,
					"content": "Hehe, kamu juga menikmatinya, Nusta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750123,
						756750124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756750123,
					"content": "Senyummu terlihat lebih lega dan lepas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756750125
					]
				},
				{
					"id": 756750125,
					"content": "Sungguhan? Kalau begitu, setiap ada pesta beginian, aku pasti datang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750126
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 756750126,
					"content": "Biar para junior yang biasa manggil aku 'kak' atau bahkan 'tante' itu ... suatu hari nanti bakal sadar, kalau penampilan dan semangatku jauh lebih muda dari mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750127
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 756750127,
					"content": "Ke depannya, acara pesta harus menjadikan acara kali ini sebagai contoh, diadakan sesering mungkin! Jadi rutinitas setiap bulan pun jadi masuk akal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nusta"
				},
				{
					"id": 756750124,
					"content": "Rasanya seperti jadi jauh lebih muda.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756750125
					]
				}
			]
		}
	]
}