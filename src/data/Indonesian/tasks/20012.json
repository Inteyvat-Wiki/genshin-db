					"nextDialogs": [
						200120206
					]
				},
				{
					"id": 200120206,
					"content": "Terima kasih banyak, aku harap kedua anakku bisa menjadi orang baik sepertimu saat beranjak dewasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Myrana yang Panik"
				},
				{
					"id": 200120205,
					"content": "Maaf, aku masih ada urusan lain.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200120207
					]
				},
				{
					"id": 200120207,
					"content": "Ayolah, kumohon... Sebentar saja, aku janji ini tidak akan lama.",
