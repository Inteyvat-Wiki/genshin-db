			},
			"dialogs": [
				{
					"id": 751480201,
					"content": "Eh? Apaan itu tadi ... Qucusaurus? Eh? Jadi patungnya benar-benar diambil sama dia ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480202,
					"content": "Tunggu, tadi dia bawa patung itu langsung lompat ke dalam ... mulut gunung berapinya?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480203,
					"content": "Mulut gunung berapinya ada di sana ... Pemandangannya keren banget ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480204,
					"content": "Hmm ... Waktu tanya jalan dulu, aku ingat ada yang bilang kalau ada banyak Phlogiston gas yang terkumpul di mulut gunung berapi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480205,
					"content": "Benar juga ya! Ada <color=#00E1FFFF>cara untuk menembus Phlogiston gas</color>, kayak Qucusaurus tadi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480206,
					"content": "Tapi ini ... tinggi banget!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480207,
						751480210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480207,
					"content": "Enggak apa-apa, aku bakal peluk Paimon erat-erat kok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751480208
					]
				},
				{
					"id": 751480208,
					"content": "Groar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480209
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751480209,
					"content": "Eh, kamu juga mau ya? Serius ya ... Ya sudah, oke. Kalau gitu, kayaknya enggak terlalu nakutin lagi sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480214,
					"content": "Terus, bukan cuma tinggi loh, jangan lupa soal Phlogiston gasnya juga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480215,
					"content": "O-Oke, kalau sudah siap, kita langsung berangkat yuk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480210,
					"content": "Asal Paimon tarik aku waktu mau mendarat nanti ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751480211
					]
				},
				{
					"id": 751480211,
					"content": "Mana mungkin! Paimon enggak punya tenaga segede itu. Terus, pas mendarat? Susah banget pas-in waktunya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480212,
					"content": "Groar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480213
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751480213,
					"content": "Kamu ya! Jangan ikut-ikutan ... Duh. Gara-gara kalian ribut begini, Paimon batal deh groginya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480214
					],
					"speakerTitle": "Paimon"
				}
			]
		},
