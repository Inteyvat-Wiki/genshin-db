				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751480101,
					"content": "Oh, Yang Terpilih oleh Naga ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480102,
					"content": "Naiklah ke puncak mahkota berkobar, dan terjunlah ke dalam api Gunung Suci!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480103,
					"content": "Maju dan ungkapkanlah — hancurkan segel emas, singkapkan pancaran api sisa yang tak terhitung banyaknya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480104,
					"content": "Fuwaaa ... nguk ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480105
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751480105,
					"content": "Kenapa? Ada lihat yang aneh-aneh lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480106,
						751480107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480106,
					"content": "Kayaknya ... jadi lebih jelas sekarang ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751480108
					]
				},
				{
					"id": 751480108,
					"content": "Eh? Karena kita makin dekat ke gunung berapi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480109,
					"content": "Groar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480110
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751480110,
					"content": "Kayaknya iya deh, jadi orang yang terus ngomong sama kamu itu sama kayak gunung berapi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480111,
					"content": "Tapi karena kita bisa lihat semua itu waktu dekati gunung berapi, berarti kita enggak salah jalan ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480112,
					"content": "Groar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751480107,
					"content": "Kayaknya ... kita sudah makin dekat ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751480108
					]
				}
			]
		},
