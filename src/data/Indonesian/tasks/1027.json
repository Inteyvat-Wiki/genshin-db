				"points": []
			},
			"dialogs": [
				{
					"id": 10280601,
					"content": "Tidak pernah terbayang kita akan terjebak di tempat ini. Benar-benar deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280602
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280602,
					"content": "Setelah semua pelajaran yang kupelajari, aku hanya tahu bagaimana memasukkan orang ke dalam penjara. Tapi aku tidak tahu apa-apa tentang cara keluar dari dalamnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280603
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280603,
					"content": "Untung aku sudah menulis kontrak dengan ayahku untuk \"hidup bahagia\" ... Aku tidak boleh putus asa sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280604
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280604,
					"content": "Sisi positifnya ... Minimal aku sudah menjelajahi tempat baru, melihat bagian dunia yang baru dan bertemu dengan teman lama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280605
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280605,
					"content": "Hmm ... Ya, masih lumayan. Sepertinya, hmm ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yanfei"
				}
			]
		},
		{
