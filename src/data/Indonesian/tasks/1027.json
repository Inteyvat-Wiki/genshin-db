			"dialogs": [
				{
					"id": 10280701,
					"content": "Situasi saat ini mengerikan. Sepertinya tidak ada jalan keluar. Kita harus mempersiapkan diri untuk bertahan di sini sementara waktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280702
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 10280702,
					"content": "Untungnya persediaan kita masih cukup, dan anggota tim kita bisa tetap tenang meski sedang dalam kondisi krisis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280703
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 10280703,
					"content": "Jaga dirimu sendiri. Aku akan pikirkan selebihnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yelan"
