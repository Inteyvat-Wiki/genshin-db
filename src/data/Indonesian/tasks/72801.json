						728011305
					]
				},
				{
					"id": 728011305,
					"content": "Pokoknya, lepas landas dari sini sepertinya bagus... Jika ditulis di dalam \"Catatan Perjalanan\" pasti sangat menarik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011306
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728011306,
					"content": "Orang ini... ternyata masih mengikutiku, sungguh tidak ada habisnya.",
