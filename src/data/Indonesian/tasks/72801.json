					"nextDialogs": [
						728011307
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728011307,
					"content": "Biar aku usir dia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728011308
					]
				},
				{
					"id": 728011308,
					"content": "Sudahlah, tidak perlu pedulikan dia. Jika ada kamu, dia tidak berani berbuat macam-macam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011309
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728011309,
					"content": "Lagi pula saat menghadapi orang seperti ini... Jika kamu sungguh-sungguh meladeni dia, dia malah semakin mengganggu.",
