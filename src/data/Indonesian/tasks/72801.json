				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ramsay"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728010301,
					"content": "Kamu adalah... Pengembara? Kenapa mencariku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010302
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010302,
					"content": "Tentang \"Catatan Perjalanan\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728010303
					]
				},
				{
					"id": 728010303,
					"content": "Oh, maksudmu \"Catatan Perjalanan\" yang aku tulis untuk Midori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010304
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010304,
					"content": "Ini... belakangan ini aku tidak sempat menulisnya, anak itu pasti sudah tidak sabar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010305
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010305,
					"content": "Apakah \"Catatan Perjalanan\" itu sungguhan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728010306
					]
				},
				{
					"id": 728010306,
					"content": "Hahaha, menurutmu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010307,
						728010309
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010307,
					"content": "Rasanya tidak nyata...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728010308
					]
				},
				{
					"id": 728010308,
					"content": "Hahaha, wajar saja orang yang sudah berkelana ke berbagai tempat, dapat langsung mengerti dalam sekali lihat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010311
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010311,
					"content": "Benar, bisa dikatakan \"Catatan Perjalanan\" ini tidak nyata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010312
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010312,
					"content": "Walau sebagian tempat dan karakter berasal dari dunia nyata... tapi sebagian besar ceritanya berasal dari imajinasiku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010313
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010313,
					"content": "Tentu saja sebagian ceritanya bukan sepenuhnya imajinasi. Misalnya salah satu cerita yang kutulis di dalam \"Catatan Perjalanan\", tentang seseorang yang membuat balon super.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010314
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010314,
					"content": "Lalu dia mengumpulkan beberapa rekan dan berencana menggunakan balon untuk mengelilingi seluruh Teyvat dalam 80 hari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010315
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010315,
					"content": "Dan juga, balon ini tidak memerlukan \"Vision\" untuk digerakkan, yang dibutuhkan hanyalah pengetahuan teknis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010316
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010316,
					"content": "Sekelompok orang ini mengelilingi dunia dengan balon, bertemu banyak hal dan fenomena aneh di sepanjang perjalanan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010317
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010317,
					"content": "Aku awalnya sudah siap menulis buku ini untuk Midori, tapi karena... suatu alasan, sampai sekarang satu paragraf pun tidak sempat kutulis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010318
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010318,
					"content": "Apa alasannya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728010319
					]
				},
				{
					"id": 728010319,
					"content": "Kamu lihat orang di lorong itu? Namanya Heihachi, entah sejak kapan orang itu terus mengawasi aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010320
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010320,
					"content": "Aku awalnya ingin pergi mencari bahan cerita untuk \"Catatan Perjalanan\". Tapi orang itu selalu mengikuti aku, dan aku tidak tahu apa tujuannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010321
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010321,
					"content": "Karena takut orang itu berniat jahat kepadaku, aku jadi tidak berani pergi mencari bahan. \"Catatan Perjalanan\" ini pun jadi terbengkalai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010322
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010322,
					"content": "Tapi untungnya kamu datang. Pengembara, apakah kamu bisa menemaniku pergi survey? Jika kamu menemani, orang itu tidak akan berani melakukan apa-apa terhadapku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010323,
						728010325
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010323,
					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728010324
					]
				},
				{
					"id": 728010324,
					"content": "Kalau begitu mohon bantuanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010327
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010327,
					"content": "Ada yang bilang, \"Orang harus selalu waspada\". Kalau ada orang seperti ini mengawasi gerak-gerikku, apa pun niatnya, aku harus tetap berjaga-jaga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010328
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010328,
					"content": "Karena itu, tugas melindungi aku saat survey kuserahkan padamu, Pengembara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010329
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010329,
					"content": "Aku sebenarnya sudah memilih beberapa tempat untuk survey, mari kita segera pergi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010330
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010330,
					"content": "Lokasi pertama adalah pantai di dekat sini. Ayo kita berangkat sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010325,
					"content": "Kenapa begitu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728010326
					]
				},
				{
					"id": 728010326,
					"content": "Aku tidak tahu. Tapi... memiliki niat buruk pada orang lain sebenarnya tidak butuh alasan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010327
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010309,
					"content": "Aku berharap itu nyata.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728010310
					]
				},
				{
					"id": 728010310,
					"content": "Hahaha, aku juga berharap semua yang aku tulis bisa menjadi kenyataan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010311
					],
					"speakerTitle": "Ramsay"
				}
			]
		},
