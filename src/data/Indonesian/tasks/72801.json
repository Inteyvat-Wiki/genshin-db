			"dialogs": [
				{
					"id": 728010201,
					"content": "Tuan, ada urusan apa berkunjung ke Komore Teahouse hari ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010202
					],
					"speakerTitle": "Kozue"
				},
				{
					"id": 728010202,
					"content": "Tentang Ramsay...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728010203
					]
				},
				{
					"id": 728010203,
					"content": "Pedagang itu ya... Dia memang ada di dalam Teahouse, tapi belakangan ini dia tampak gelisah, entah ada masalah apa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010204
					],
					"speakerTitle": "Kozue"
				},
				{
					"id": 728010204,
					"content": "Jika kamu ingin mencarinya, masuk saja ke dalam untuk bertemu dengannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kozue"
				}
			]
		},
		{
			"id": 7280103,
			"completionStepIds": [
				7280103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
