			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ramsay"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728010501,
					"content": "Kualitas air di pantai ini sangat jernih, pasirnya juga sangat putih, sangat berbeda dengan lautan luar yang ganas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010502
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010502,
					"content": "Jika berlayar mulai dari sini... lepas landas, suasananya mungkin menarik...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010503
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010503,
					"content": "*uhuk* Pemandangan di sini indah, aku harus merekamnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010504
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010504,
					"content": "Pengembara, harap tunggu sebentar, aku harus memikirkan cara penulisannya sebentar. Kalian boleh berjalan-jalan dulu di sekitar dan menikmati pemandangan pantai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010505
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010505,
					"content": "...Tapi tolong jangan pergi terlalu jauh dariku. Orang bernama Heihachi itu sudah datang mengikuti, dia ada di samping.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ramsay"
				}
			]
		},
