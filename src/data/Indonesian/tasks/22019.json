			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220190201,
					"content": "Aku menemukannya. Ternyata benar, dia sedang mengubur hasil curiannya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190202,
						220190204
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220190202,
					"content": "Ayo bergerak!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190203
					]
				},
				{
					"id": 220190203,
					"content": "Tunggu dulu, Pengembara. Sekarang belum waktunya kita untuk bergerak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190206
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220190206,
					"content": "Tunggu sebentar lagi... Oke, sekarang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190207
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220190207,
					"content": "Hei, kamu! Sedang apa kamu!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190208
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220190208,
					"content": "Letakkan semua barangmu! Jangan bergerak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190209
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220190209,
					"content": "Ka-kalian... bagaimana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190210
					],
					"speakerTitle": "Ishikawa Hachirou"
				},
				{
					"id": 220190210,
					"content": "Sial... jangan diam saja! Serang! Bereskan mereka dan kita pergi dari sini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190211
					],
					"speakerTitle": "Ishikawa Hachirou"
				},
				{
					"id": 220190211,
					"content": "Treasure Hoarder... Berani sekali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190212
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220190212,
					"content": "Andou, Amano, kami datang bantu kalian!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190213
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220190213,
					"content": "Oke! Kuserahkan kepada kalian!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190214
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220190214,
					"content": "Pengembara, sekarang saatnya untuk kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190215
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220190215,
					"content": "Bertele-tele sekali...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190216
					]
				},
				{
					"id": 220190216,
					"content": "Semua ini sudah diatur Ketua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190217
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220190217,
					"content": "Sudah, ayo kita maju.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220190204,
					"content": "Sekarang?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190205
					]
				},
				{
					"id": 220190205,
					"content": "Tunggu sebentar. Sekarang belum waktunya kita untuk bergerak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190206
					],
					"speakerTitle": "Ryuuji"
				}
			]
		},
		{
			"id": 2201903,
			"completionStepIds": [
				2201905
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
