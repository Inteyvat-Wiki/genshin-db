					"Sango"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220190601,
					"content": "Kalian cepat pergi, tangkap dia dan sita barang curiannya sekaligus. Cepat, aku di sini tunggu kabar baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190602
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190602,
					"content": "Apa masih ada hal lain, Pengembara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190603,
						220190607
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190603,
					"content": "Sepertinya suasana hatimu tidak bagus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190604
					]
				},
				{
					"id": 220190604,
					"content": "Hanya kasus yang sepele, pelakunya juga tidak spesial, cara melakukannya juga tidak elegan, hanya sedikit pintar saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190605
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190605,
					"content": "Kalau aku memberi nilai untuk kasus ini... sepertinya aku akan memberikan nilai \"membosankan\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190606
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190606,
					"content": "Tapi tetap saja sebuah tindak kejahatan, baguslah kita berhasil menyelesaikannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190607,
					"content": "Kamu tidak ikut?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190608
					]
				},
				{
					"id": 220190608,
					"content": "Bagiku, kasus ini sudah selesai. Sisanya aku tidak campur tangan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190609
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190609,
					"content": "Tapi dengan tubuh dan fisikku, akan gawat kalau pelakunya sampai menahanku dan memanfaatkanku untuk memerasmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190610
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190610,
					"content": "Aku sangat memahami kemampuanku sendiri. Jadi, masalah menghadapi pelakunya akan kuserahkan padamu ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				}
			]
		}
	]
}