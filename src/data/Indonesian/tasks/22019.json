							"2201905",
							"2"
						],
						"stepId": 2201905,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220190301,
					"content": "Kali ini pelaku dan barangnya sudah kita amankan. Terima kasih Ryuuji, dan Pengembara, kamu sudah bekerja keras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190302
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220190302,
					"content": "Aku dan Amano akan bawa Treasure Hoarder ini ke Commission. Serahkan saja sisanya kepada kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190303
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220190303,
					"content": "Tapi, Sango hebat juga bisa mengatur penangkapan ini dengan tepat waktu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190304
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220190304,
					"content": "Sango, tidak heran. Kasus ini tidak ada apa-apanya bagi dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190305
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220190305,
					"content": "Baiklah, Ryuuji, kita kembali dulu ke Commission. Setelah urusan ini selesai, kami ucapkan terima kasih ke kantormu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190306
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220190306,
					"content": "Jangan sungkan-sungkan. Selamat jalan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190307
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220190307,
					"content": "Baiklah, Pengembara. Sebaiknya kita juga kembali melapor kepada Ketua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				}
			]
		},
		{
			"id": 2201904,
			"completionStepIds": [
				2201906
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201906",
							"2"
						],
						"stepId": 2201906,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sango"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220190401,
					"content": "...Andou dan Amano sudah membawa pelakunya ke Commission. Masalah ini selesai, Ketua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190402
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220190402,
					"content": "Baguslah. Selesai sudah urusannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190403
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190403,
					"content": "Pengembara, kamu juga sudah kembali. Kamu sudah bekerja keras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190404,
						220190405
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190404,
					"content": "Begini... saja?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190406
					]
				},
				{
					"id": 220190406,
					"content": "Karena pelakunya dibawa pergi Amano dan Andou, jadi wajar saja. Ambillah imbalan-imbalan ini, mungkin kamu akan sedikit lebih \"berasa\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190407,
						220190409
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190407,
					"content": "Bagaimana dengan imbalanmu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190408
					]
				},
				{
					"id": 220190408,
					"content": "Aku? Bagiku, bisa membantu orang-orang di Commission memecahkan kasus dan mengembalikan ketenangan di jalan ini sudah menjadi imbalan terbesar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190412
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190412,
					"content": "Jujur saja, kali ini aku memang tidak mendapatkan apa-apa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190413
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190413,
					"content": "Aku tidak melihat metode kejahatan baru, dan juga tidak mendengar konsep kejahatan baru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190414
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190414,
					"content": "Hanya kasus kriminal biasa yang tidak menarik. Untung aku tidak mengeluarkan banyak usaha untuk itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190415,
						220190417
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190415,
					"content": "Ketua Sango...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190416
					]
				},
				{
					"id": 220190416,
					"content": "Ada apa? Kamu baru pertama kali mengenal orang yang tertarik dengan \"kriminalitas\" seperti aku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190419
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190419,
					"content": "Tertarik dengan hal-hal kriminal adalah alasanku menjadi detektif.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190420
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190420,
					"content": "...Kamu mau berbuat kriminal?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190421
					]
				},
				{
					"id": 220190421,
					"content": "Iya. Aku sangat ingin berbuat \"kriminal\". Aku ingin melakukan sebuah aksi kriminal yang sempurna tanpa cacat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190422
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190422,
					"content": "Sayangnya, orang-orang yang melakukan kriminal selalu meninggalkan jejak. Asal ada jejak, cepat lambat kasus itu pasti terpecahkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190423,
						220190424,
						220190425
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190423,
					"content": "Bagaimana kalau kejahatan itu tidak dilakukan manusia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190426
					]
				},
				{
					"id": 220190426,
					"content": "Lihat tuh, tanpa sadar kamu mulai memikirkan tentang kriminal kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190427
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190427,
					"content": "Tidak ada yang salah kok, kamu kan hanya memikirkannya saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190428
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190428,
					"content": "Aku juga sering memikirkan bagaimana melakukan aksi kriminal, misalnya seperti metodenya, motifnya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190429
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190429,
					"content": "Untuk apa kamu memikirkannya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190430
					]
				},
				{
					"id": 220190430,
					"content": "Tentu saja agar dapat memecahkan kasus dengan baik. Kasus yang kuterima belakangan ini makin hari makin rumit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190431
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190431,
					"content": "Tapi tidak ada satu pun kasus-kasus itu yang bisa disebut kasus kriminal yang sempurna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190432
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190432,
					"content": "Memanganya kamu pernah ketemu kasus kejahatan sempurna?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190433
					]
				},
				{
					"id": 220190433,
					"content": "Pernah. Sampai sekarang aku masih belum menemukan pelakunya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190434
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190434,
					"content": "Tapi aku yakin pelaku pasti meninggalkan jejak. Aku hanya... belum menemukan jejaknya saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190435
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190435,
					"content": "Baiklah, imbalannya untukmu saja. Terima kasih atas bantuanmu, pengembara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190436
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190436,
					"content": "Jangan lupa datanglah berkunjung kalau ada waktu. Kalau tidak ada waktu, ya tidak apa-apa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190437
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190437,
					"content": "Naluriku mengatakan kalau kita masih ada kesempatan untuk bersama-sama memecahkan kasus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190424,
					"content": "Bagaimana kalau pelakunya tidak ada?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190426
					]
				},
				{
					"id": 220190425,
					"content": "Bagaimana menghapus semua jejaknya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190426
					]
				},
				{
					"id": 220190417,
					"content": "Inikah yang namanya detektif...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190418
					]
				},
				{
					"id": 220190418,
					"content": "Kita juga tidak bisa langsung menyimpulkannya seperti itu. Tapi kalau aku, aku memang sangat tertarik dengan kriminalitas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190419
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190409,
					"content": "Kamu tidak mau apa-apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190410
					]
				},
				{
					"id": 220190410,
					"content": "Aku sudah mendapatkan \"keadilan\". Selain itu, aku tidak butuh yang lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190411
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190411,
					"content": "...Perlukah aku mengatakannya seperti itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190412
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190405,
					"content": "Tidak terasa sudah beres...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190406
					]
				}
			]
		},
