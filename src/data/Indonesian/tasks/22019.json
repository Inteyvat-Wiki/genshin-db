			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sango"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220190101,
					"content": "...Kalau begitu, kuserahkan kepada kalian berdua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190102
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190102,
					"content": "Tenang, Nona Sango. Serahkan saja kepada kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190103
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220190103,
					"content": "Berani-beraninya dia mengelabui di depan mata kita. Nekat sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190104
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220190104,
					"content": "Pakai identitas macam itu pula...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190105
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220190105,
					"content": "Apa pun yang terjadi, aksinya akan berakhir hari ini juga. Ryuuji, kamu ingat tugas yang kuberikan padamu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190106
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190106,
					"content": "Ya, Ketua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190107
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220190107,
					"content": "Bagus... Pengembara, kamu juga sudah datang, bagus sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190108,
						220190109
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190108,
					"content": "Apa kita mau tangkap pelakunya sekarang?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190111
					]
				},
				{
					"id": 220190111,
					"content": "Buktinya sudah cukup. Aku juga sudah memiliki titik terang atas perbuatannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190112
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190112,
					"content": "Pengembara, tangkaplah dia bersama dengan Ryuuji, Amano, dan Andou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190113
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190113,
					"content": "Dia pasti tidak cuma seorang. Kalau ada kamu, kemungkinan kita untuk sukses akan lebih besar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190114,
						220190117
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190114,
					"content": "Apa yang harus kulakukan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190115
					]
				},
				{
					"id": 220190115,
					"content": "Cukup tunjukkan auramu yang tak terkalahkan itu dan buat si pelaku tak berkutik, jangan sampai dia berbuat hal-hal yang tidak diinginkan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190116
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190116,
					"content": "Tapi pencuri yang beraninya diam-diam seperti ini seharusnya juga tidak punya nyali untuk melakukan hal yang terlalu garang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190121
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190121,
					"content": "Kalau perhitunganku tidak salah, sekarang pelakunya pasti sudah berada di alam liar, dan sedang bersiap-siap mengubur hasil curiannya yang baru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190122
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190122,
					"content": "Kalian cepat pergi, tangkap dia dan sita barang curiannya sekaligus. Cepat, aku di sini tunggu kabar baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190117,
					"content": "Kamu tidak ikut?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190118
					]
				},
				{
					"id": 220190118,
					"content": "Bagiku, kasus ini sudah selesai. Sisanya aku tidak campur tangan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190119
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190119,
					"content": "Pengembara, gunakan auramu yang tak terkalahkan itu dan buat si pelaku tak berkutik, jangan sampai dia berbuat hal-hal yang tidak diinginkan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190120
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190120,
					"content": "Tapi pencuri yang beraninya diam-diam seperti ini seharusnya juga tidak punya nyali untuk melakukan hal yang terlalu garang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190121
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190109,
					"content": "Apa kasusnya sudah mau ditutup?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190110
					]
				},
				{
					"id": 220190110,
					"content": "Ya, hari ini, asal semuanya berjalan lancar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190111
					],
					"speakerTitle": "Sango"
				}
			]
		},
		{
			"id": 2201902,
			"completionStepIds": [
				2201903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
