			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 10090301,
					"content": "Tepung di mana-mana. Ck, kokinya jorok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10090302,
					"content": "Trus ada sisa daging di dalam kualinya. Paimon enggak tahu daging apa tapi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10090303,
					"content": "Mereka masak sesajian buat Adeptus di sini gitu ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10090304,
					"content": "Hmm, Paimon enggak kebayang sesajian apa yang terbuat dari tepung dan daging ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10090305,
					"content": "Eh? Si koki jorok ninggalin catatan. Bah, sudah keinjak-injak juga ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10090306,
					"content": "Yah, mungkin ada hubungannya sama masakan misterius ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 100904,
			"completionStepIds": [
				100904
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"100904",
