				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 10090401,
					"content": "Wah, rapih dan bersih banget. Yang masak di sini pasti orangnya resik ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10090402,
					"content": "Paimon yakin yang masak memang mau kasih sesajian buat Adeptus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10090403,
					"content": "Di sini ada Matsutake dan Raw Meat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10090404,
					"content": "Wah! Bahkan resepnya ada di sebelahnya. Koki yang satu ini benar-benar orang yang terorganisir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
