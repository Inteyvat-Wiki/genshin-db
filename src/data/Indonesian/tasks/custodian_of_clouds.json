			},
			"dialogs": [
				{
					"id": 10090201,
					"content": "Di sini ada bekas-bekas orang masak. Masak sesajian gitu ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10090202,
					"content": "Tuh, masih ada sisa bahan juga. Coba ... ada Snapdragon, Lotus Head, dan tofu. Bikin apa ya, dia? Ribet deh kayaknya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10090203,
					"content": "Eh, di sana ada ... catatan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10090204,
					"content": "Yup, ribet. Paimon enggak aneh sih mereka bikin catatan, soalnya yang ribet kan susah diingat. Coba baca yang benar,",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 100903,
			"completionStepIds": [
				100903
			],
