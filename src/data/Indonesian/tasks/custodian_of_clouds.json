			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cloud Retainer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10091401,
					"content": "Diriku terkesan. Jalur menuju ke kediaman ini tidak bisa dilewati oleh sembarangan makhluk fana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091402
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 10091402,
					"content": "Berdiri di hadapan kalian adalah Adeptus, Cloud Retainer. Katakanlah, apa tujuan kalian kemari?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091403,
						10091405
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 10091403,
					"content": "Wah, tempat ini buatan kamu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10091404
					]
				},
				{
					"id": 10091404,
					"content": "Benar. Dirikulah yang membangun kediaman ini, dan segala mekanisme yang ada di dalamnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091407
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 10091407,
					"content": "Bahkan, Guizhong dan Rex Lapis pun memuji akan kemahiranku dalam teknologi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091408
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 10091408,
					"content": "Tempat ini besar sekali! Dan banyak sekali mesinnya ... Kamu tinggal sendirian saja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091409,
					"content": "Dan untuk apa semua ini? Apa di sini tempat penelitian mesin pribadimu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091410,
					"content": "Persis dongeng ya, para Adeptus mengasingkan diri dari dunia fana sambil meneliti berbagai macam hal luar biasa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091411,
					"content": "Aku... hanya merasa berkomunikasi terlalu merepotkan, dan lebih memilih ketenangan dan kesunyian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091412
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 10091412,
					"content": "Dan ketenangan itu berhasil diriku peroleh ... sampai kalian tiba dengan membawa Sigil of Permission.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091413
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 10091413,
					"content": "Sekian. Segera katakan maksud kedatangan kalian! Biarkan tempat ini kembali tenang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091414
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 10091414,
					"content": "Rex Lapis ... Rex Lapis dibunuh!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091415
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 10091415,
					"content": "Ba... bagaimana mungkin! Kekejian yang teramat sangat ... berani-beraninya ...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091416
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 10091416,
					"content": "Tidak masuk akal. Biarlah Adeptus ini memastikan kebenarannya, dan bermusyawarah dengan para Adeptus lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091417
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 10091417,
					"content": "Atau lebih baik meratakan Pelabuhan Liyue terlebih dahulu, sebelum berkumpul dengan para Adeptus ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091418
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 10091418,
					"content": "Hah?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10091419
					]
				},
				{
					"id": 10091419,
					"content": "Tunggu, apa? Meratakan Liyue? Kamu serius mau hancurkan seluruh kota?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091420,
					"content": "Hanya dengan peringatan guntur dan petir, barulah hal serupa tidak akan terulang kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091421,
						10091423
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 10091421,
					"content": "Bukannya para Adeptus sudah disumpah untuk melindungi Liyue?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10091422
					]
				},
				{
					"id": 10091422,
					"content": "Benar. Sudah tiga puluh tujuh abad kami melindungi pelabuhan Liyue, di bawah kepemimpinan Rex Lapis. Namun kini para pelaku kejahatan merajalela. Perlu tindakan yang drastis untuk mengamankan situasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091425
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 10091425,
					"content": "Karena aku tidak ingin melihat lebih banyak lagi penderitaan, hal ini harus kulakukan, terlebih saat menghadapi saat-saat genting seperti ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091426
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 10091426,
					"content": "Astaga! Pikirin sesuatu! Dia mau meratakan Liyue, dan dia bukan cuma omong doang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091427,
					"content": "Kamu menerima sesajian dari kami. Berarti kita sudah terikat kontrak ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10091428
					]
				},
				{
					"id": 10091428,
					"content": "Paimon memang mau ngomong gitu, kami masak enak segitu banyak, dan semuanya buat kamu loh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091429
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091429,
					"content": "Kami ingin minta perlindungan atas Liyue, bukan memporak-porandakannya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091430,
					"content": "Atau paling tidak, bisa kan diobrolin dulu? Mungkin ada pendapat lain ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091431,
					"content": "\"Kontrak\"... kata yang kamu pilih ini terdengar sangat ironis, terutama setelah Dewa Kontrak baru saja terbunuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091432
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 10091432,
					"content": "Manusia fana di Pelabuhan Liyue memang pandai mengakali kontrak. Mereka juga pintar mengaburkan batas hitam dan putih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091433
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 10091433,
					"content": "Tapi... karena kalian datang kepadaku atas nama \"kontrak\", Adeptus ini tidak akan menyangkal kepatuhan janjinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091434
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 10091434,
					"content": "Terlebih kalian membawa Simbol Seribu Izin... Rex Lapis menanamkan di dalamnya kekuatan yang membantu manusia fana saat bertarung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091435
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 10091435,
					"content": "Kini kekuatan di dalamnya hampir sirna, dan sekarang sama saja seperti sebuah cinderamata...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091436
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 10091436,
					"content": "Tetapi, cinderamata ini tidak dapat membuktikan kredibilitasmu sendiri, aku juga akan memverifikasi apa yang baru saja kudengar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091437
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 10091437,
					"content": "Rupanya inilah alasan Moon Carver memanggil kami, pasti karena hal ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091438
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 10091438,
					"content": "Pergilah. Pertemuan kalian dengan Adeptus ini telah usai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 10091423,
					"content": "Bukannya kamu seharusnya melindungi manusia di sana?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10091424
					]
				},
				{
					"id": 10091424,
					"content": "Benar. Namun kematian Rex Lapis, jika itu benar, berarti Pelabuhan Liyue sedang dalam bahaya. Jika ancaman tidak segera dimusnahkan, bencana besar akan melanda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091425
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 10091405,
					"content": "Mekanisme di dalam sini buatan kamu semua?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10091406
					]
				},
				{
					"id": 10091406,
					"content": "Benar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091407
					],
					"speakerTitle": "Cloud Retainer"
				}
			]
		},
