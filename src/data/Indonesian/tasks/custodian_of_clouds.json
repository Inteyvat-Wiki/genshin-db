			"dialogs": [
				{
					"id": 10091501,
					"content": "Wah, kok ada meja segala? Sudah ditata rapi buat makan malam juga, sampai kendi arak saja ada ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091502,
					"content": "Kursinya juga terukir sesuatu, \"Cloud Retainer duduk di sini\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091510,
					"content": "Sebelah sini ada \"Guizhong\", lalu ada \"Rex\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091503,
					"content": "\"Rex\" maksudnya Rex Lapis kan? Tapi Paimon tidak tahu siapa \"Guizhong\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091504,
					"content": "Kalau \"Retainer\" ... Oh iya! Waktu Moon Carver menyebutkan nama teman-temannya, dia ada sebut \"Cloud Retainer\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091505,
					"content": "Kalau begitu, di sini pasti tempat Adeptus \"Cloud Retainer\" dan Adeptus lainnya pesta makan-makan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091506,
					"content": "Hehe, gimana kalau kita masak sesuatu buat Adeptus? Kita pasti bisa menarik perhatian Cloud Retainer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091507,
					"content": "Tapi, makanan enak apa yang ingin dimakan Adeptus ya? Paimon tidak kepikiran...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091508,
					"content": "Tapi para Adeptus dapat banyak persembahan dari orang-orang kan, mungkin kita bisa cari petunjuk di sekitar, cari tahu mereka suka makan apa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091509,
					"content": "Tapi menurutmu... apa mungkin Adeptus suka makan... Sticky Honey Roast...!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
