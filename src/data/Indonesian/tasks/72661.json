			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nantuck",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726610101,
					"content": "Hey, nelayan muda, senang bertemu denganmu. Ada masalah apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610102
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610102,
					"content": "Kemarilah, aku adalah pemandu nelayan berpengalaman. Ada masalah apa bilang saja padaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610103
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610103,
					"content": "Masuk akal juga jika Kujirai masih terobsesi dalam menemukan \"Lunar Leviathan\" karena permohonannya adalah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610104
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610104,
					"content": "*huff* Kalau dia tahu kebenaran tentang Lunar Leviathan, dia pasti akan kecewa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610105
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610105,
					"content": "Kebenaran apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726610106
					]
				},
				{
					"id": 726610106,
					"content": "Sebenarnya sejak kembali berlayar, aku menyelidiki Lunar Leviathan tanpa henti, dan akhirnya menemukan petunjuk di sebuah catatan kuno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610107
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610107,
					"content": "Berdasarkan petunjuk tersebut, aku melakukan penelitian lapangan dan akhirnya menemukan beberapa hal yang menakjubkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610108
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610108,
					"content": "Kutuliskan penemuan-penemuan itu ke dalam karyaku, dan tampaknya belakangan ini terjual cukup laris.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610109
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610109,
					"content": "Ini, kebetulan aku masih punya buku bonus yang ditinggalkan editor. Kalian lihat saja kebenaran Lunar Leviathan di dalamnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610110
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610110,
					"content": "Paimon juga mau lihat, biarkan Paimon lihat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726610111,
					"content": "\"Tentang Lunar Leviathan yang Sebenarnya adalah Penyu Raksasa\"... Panjang sekali judulnya... EHH?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726610112,
					"content": "Penyu raksasa? Lunar Leviathan itu penyu raksasa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726610113,
					"content": "Benar sekali. Lunar Leviathan memang seekor penyu besar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610114
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610114,
					"content": "Malam itu, yang kami lihat adalah penyu raksasa yang punggung belakangnya ditumbuhi tumbuhan bercahaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610115
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610115,
					"content": "Penyu itu sedang hamil dan sedang dalam perjalanan ke darat untuk bertelur. Dan seperti itulah kami menemukan jalan pulang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610116
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610116,
					"content": "Jadi, pulanglah dan beri tahu Kujirai hal ini. Bagaimanapun juga, kita harus menghadapi kenyataan dalam hidup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610117
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610117,
					"content": "Tapi, meski hal ini dapat dijelaskan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726610118
					]
				},
				{
					"id": 726610118,
					"content": "Dari ekspresimu, sepertinya kamu masih belum percaya ya? Tapi penelitianku ini ada buktinya loh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610119
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610119,
					"content": "Menurut catatan kuno, Lunar Leviathan adalah makhluk purba. Di mana pada saat itu, banyak makhluk masih hidup di daratan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610120
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610120,
					"content": "Nenek moyang mereka kini aktif di area Dragonspine, dan beberapa fosilnya bisa ditemukan di sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610121
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610121,
					"content": "Aku waktu itu menemukan beberapa fosil di <color=#00E1FFFF>sisi barat Wyrmrest Valley</color>. Kalau tidak percaya, kalian bisa coba mencarinya juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nantuck"
				}
			]
		},
