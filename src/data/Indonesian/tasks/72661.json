				"points": []
			},
			"dialogs": [
				{
					"id": 726610701,
					"content": "Eh, menurut kalian, batu jelek ini bernilai berapa ya? Kelihatannya langka sekali, bisa tersembunyi di dalam batu mineral.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610702
					],
					"speakerTitle": "Old-School Qi"
				},
				{
					"id": 726610702,
					"content": "Jangan bercanda deh. Apanya yang batu jelek? Kamu tidak sekolah ya? Nama benda ini fosil, FOSIL. Ngerti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610703
					],
					"speakerTitle": "Fleein' Lin"
				},
				{
					"id": 726610703,
					"content": "Nilainya tak ternilai deh. Satu butir batu saja sudah cukup untuk membeli setengah Pelabuhan Liyue. Kamu mending pulang dan baca lebih banyak buku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610704
					],
					"speakerTitle": "Fleein' Lin"
				},
				{
					"id": 726610704,
					"content": "Benarkah? Seberharga itu? Kalau ditambah dengan benda-benda di kemah ini, berarti kita \"kejatuhan durian busuk\" dong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610705
					],
					"speakerTitle": "Klutzy Bazi"
				},
				{
					"id": 726610705,
					"content": "Yang benar itu \"kejatuhan durian runtuh\"! Kamu mending baca buku lebih banyak sepulang dari sini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610706
					],
					"speakerTitle": "Fleein' Lin"
				},
				{
					"id": 726610706,
					"content": "Hei! Kamu yang di sana, cepat serahkan fosil itu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726610707,
					"content": "Hah? Siapa? Sial... kita ketahuan! Semuanya, serang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fleein' Lin"
				}
			]
		}
	]
