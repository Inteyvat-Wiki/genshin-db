			},
			"dialogs": [
				{
					"id": 726610501,
					"content": "Semuanya hanya limbah-limbah tambang, rasanya seperti ada orang mengambil sesuatu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726610502,
					"content": "Eh? Orang itu... Treasure Hoarder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726610503,
					"content": "Jangan-jangan mereka yang ambil benda dari sisa bebatuan tadi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726610504,
					"content": "Cepat! Ikuti mereka! Pasti ada kemah mereka di sekitar sini, dan benda dari sisa bebatuan tadi pasti ada di sana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726610505,
					"content": "Ayo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726610506
					]
				},
				{
					"id": 726610506,
					"content": "Kita harus menyelinap diam-diam. Jangan sampai ketahuan loh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7266106,
			"completionStepIds": [
				7266109
			],
