			"trigger": {
				"objectNames": [
					"Kujirai Momiji",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726610601,
					"content": "Kalian akhirnya kembali juga. Loh? Jiawei tidak ikut?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610602
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610602,
					"content": "Dia jatuh ke dalam kehangatan keluarga.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726610603
					]
				},
				{
					"id": 726610603,
					"content": "Hah? Dia sudah menikah? Haha! Ini benar-benar seperti hal yang akan dia lakukan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610604
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610604,
					"content": "Harapan dia memang ini... Baiklah, aku maafkan dia karena alasannya ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610605
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610605,
					"content": "Bagaimana dengan Nantuck? Apa kalian sudah menemukannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610606
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610606,
					"content": "Dia menulis buku yang sedang laris manis.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726610607
					]
				},
				{
					"id": 726610607,
					"content": "Hah? Tak disangka, dia benar-benar berhasil jadi penulis? Hebat juga dia. Dia nulis apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610608
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610608,
					"content": "Paimon tahu! Judul bukunya \"Tentang Lunar Leviathan yang Sebenarnya adalah Penyu Laut Raksasa\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726610609,
					"content": "Oh, panjang juga judulnya... Novel ringan ya? Bagus juga, aku juga mau coba beli deh... Loh? Sebentar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610610
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610610,
					"content": "Tentang Lunar Leviathan yang sebenarnya... Lunar Leviathan yang sebenarnya?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610611
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610611,
					"content": "Ya... Sebenarnya adalah penyu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726610612
					]
				},
				{
					"id": 726610612,
					"content": "Omong kosong apa ini? Kenapa bisa seekor penyu? Dia lupa ya, Lunar Leviathan yang pernah kita lihat dengan mata kepala sendiri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610613
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610613,
					"content": "Kami awalnya juga tidak percaya... Tapi kami kemudian menemukan fosil \"Lunar Leviathan\" di gunung bersalju... Nih, Paimon kasih buku dan fosilnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726610614,
					"content": "Tidak, aku tidak percaya... Ini bukan kenyataan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610615
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610615,
					"content": "Asal kalian tahu, keluarga Kujirai adalah keluarga nelayan dari turun temurun. Ayahku adalah nelayan yang terkenal di seantero Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610616
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610616,
					"content": "Dia sudah menghabiskan waktu puluhan tahun di lautan demi menangkap Lunar Leviathan. Dan ada satu kali dia hampir berhasil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610617
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610617,
					"content": "Meskipun akhirnya tidak berhasil, tapi ayahku belum menyerah. Bisa menangkap Lunar Leviathan yang legendaris adalah suatu kehormatan tertinggi untuk nelayan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610618
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610618,
					"content": "Tapi di pelayaran ayah selanjutnya... dia tidak pernah kembali lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610619
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610619,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610620
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610620,
					"content": "Jadi aku tidak akan memercayai hal ini semudah itu. Tolonglah aku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610621
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610621,
					"content": "Jadi apa rencanamu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726610622
					]
				},
				{
					"id": 726610622,
					"content": "Aku akan kembali mencari barang-barang peninggalan ayahku. Dia sudah mencari Lunar Leviathan sepanjang hidupnya dan meninggalkan banyak catatan informasi. Pasti ada solusinya di dalam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610623
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610623,
					"content": "Aku sudah siapkan latihan memancing untukmu. Tunggu saja kabar baikku, lagi pula aku juga masih perlu bantuanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kujirai Momiji"
				}
			]
		},
