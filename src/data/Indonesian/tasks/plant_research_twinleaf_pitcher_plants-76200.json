			"dialogs": [
				{
					"id": 762000801,
					"content": "Kucing bodoh!!! Kamu ke mana sih! Eh? Sudah ketemu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000802
					],
					"speakerTitle": "Marja"
				},
				{
					"id": 762000802,
					"content": "Ya, dia terperangkap di antara Twinleaf Pitcher Plant di sana. Tumbuhan sih, tapi karnivora, dan mereka bisa mencerna Moonglow Firefly dalam beberapa hari saja ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000803
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000803,
					"content": "Untung saja kita berhasil temukan dia tepat waktu. Sekarang dia sedikit lemah saja, tapi kalau telat sedikit lagi, entah apa yang akan terjadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000804
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000804,
					"content": "Huff ... Bahaya sekali ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000805
					],
					"speakerTitle": "Jukka"
				},
				{
					"id": 762000805,
					"content": "Hmm ... Ini semua salahmu karena suka keluyuran!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000806
					],
					"speakerTitle": "Marja"
				},
				{
					"id": 762000806,
					"content": "Yah, bukan salah kucingnya sih. Soalnya Twinleaf Pitcher Plant memang bisa memancarkan aroma spesial. Manusia tidak bisa mencium, tapi serangga dan hewan lain mungkin bisa tertarik dengan aromanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000807
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000807,
					"content": "Itulah cara mereka untuk menarik mangsa. Ada masih banyak Twinleaf Pitcher Plant di daerah sini, jadi tidak heran kalau hewan kecil bisa tertarik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000808
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000808,
					"content": "Oh, begitu ya ... Ngomong-ngomong, kalau ada banyak tumbuhan itu di sekitar sini, berarti tidak bagus dong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000809
					],
					"speakerTitle": "Marja"
				},
				{
					"id": 762000809,
					"content": "Benar sekali. Kalau dibiarkan, bisa-bisa jadi berbahaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000810
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000810,
					"content": "Oke. Kita akan bereskan sampai ke akar-akarnya. Jukka, ayo bantu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000811
					],
					"speakerTitle": "Marja"
				},
				{
					"id": 762000811,
					"content": "Rasakan ini, karena kalian sudah membuat kucing kami menderita! Kita harus balas dendam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000812
					],
					"speakerTitle": "Marja"
				},
				{
					"id": 762000812,
					"content": "Dengan bantuan dua pemburu harta karun, Twinleaf Pitcher Plant yang tumbuh abnormal itu pun akhirnya berhasil dibasmi ....",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						762000813
					]
				},
				{
					"id": 762000813,
					"content": "Huff ... akhirnya selesai juga. Waktunya balik ke Kota Nasha. Terima kasih banyak, nona, karena sudah bantu kami temukan kucing ini. Kalau tidak, entah berapa lama dia akan terjebak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000814
					],
					"speakerTitle": "Marja"
				},
				{
					"id": 762000814,
					"content": "Kalau dipikir-pikir lagi ya, kalau tadi Marja tidak teriak sekeras itu, mungkin kita bisa temukan dia lebih cepat?",
					"roleType": "TALK_ROLE_NPC",
