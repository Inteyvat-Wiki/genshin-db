					"speakerTitle": "Linnea"
				},
				{
					"id": 762000817,
					"content": "Yup, benar. Yang penting kucingnya selamat. Alam liar itu berbahaya, jadi kalian juga harus hati-hati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000818
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000818,
					"content": "Terima kasih. Kami pasti hati-hati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000819
					],
					"speakerTitle": "Jukka"
				},
				{
