			"dialogs": [
				{
					"id": 762000201,
					"content": "Permisi, apa kalian pernah lihat kucing oranye belang-belang di sekitar sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000202
					],
					"speakerTitle": "Jukka"
				},
				{
					"id": 762000202,
					"content": "Kucing oranye belang-belang? Hmm ... Kayaknya tidak deh, Lumi pernah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000203
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000203,
					"content": "Ya-ho?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000204
					],
					"speakerTitle": "Lumi"
				},
				{
					"id": 762000204,
					"content": "Sepertinya Lumi tidak melihatnya juga. Kucingmu hilang? Mungkin aku bisa bantu cari, aku lumayan tahu tempat ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000205
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000205,
					"content": "Hei, Jukka. Kita tidak punya uang lebih untuk sewa petualang. Lagian, itu cuma kucing biasa saja. Dia bebas mau ke mana pun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000206
					],
					"speakerTitle": "Marja"
				},
				{
					"id": 762000206,
					"content": "Jangan bilang gitu dong, Marja. Kalau dia dengar, bisa jadi sedih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000207
					],
					"speakerTitle": "Jukka"
				},
				{
					"id": 762000207,
					"content": "Memangnya dia ngerti bahasa kita? Kalau ngerti, tidak mungkin dia tidak menyahut setelah kita cari seharian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000208
					],
					"speakerTitle": "Marja"
				},
				{
					"id": 762000208,
					"content": "Tidak perlu bayar aku. Aku memang kebetulan mau kelilingi area di sekitar sini kok. Anggap saja jalan-jalan. Ayo, Lumi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000209
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000209,
					"content": "(Tadi tidak ada barang di sini. Kok sekarang jadi ada banyak Twinleaf Pitcher Plant yang tumbuh ....)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000210
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000210,
					"content": "(Mungkin ada hewan yang bawa benih Twinleaf Pitcher Plant ke sini, tapi tidak boleh dibiarkan begitu saja ....)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linnea"
				}
			]
		},
