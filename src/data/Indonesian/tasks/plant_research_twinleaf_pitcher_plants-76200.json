			"dialogs": [
				{
					"id": 762000501,
					"content": "Lumi, menurutmu dia di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000502
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000502,
					"content": "Ya-hoho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000503
					],
					"speakerTitle": "Lumi"
				},
				{
					"id": 762000503,
					"content": "Kucing itu pun akhirnya diselamatkan ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						762000504
					]
				},
				{
					"id": 762000504,
					"content": "Jadi kamu yang dicari-cari ya ... Sepertinya tidak ada luka luar. Tapi kalau terlambat sedikit lagi, entah apa yang terjadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000505
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000505,
					"content": "Pokoknya, bawa kamu kembali ke temanmu dulu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linnea"
				}
			]
