					"nextDialogs": [
						762000816
					],
					"speakerTitle": "Marja"
				},
				{
					"id": 762000816,
					"content": "(Meski dia selalu panggil dia \"kucing bodoh\", tapi sebenarnya dia peduli sekali dengan temannya, hehe.)",
