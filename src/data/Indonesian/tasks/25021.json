			"trigger": {
				"objectNames": [
					"Cazcal"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250212609,
					"content": "(Hora perlahan merasa lebih rileks. Dia meregangkan seluruh tubuh dan menyodorkan cakarnya. Waktunya gunting kuku.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212610
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250212610,
					"content": "Di bawah panduan Cazcal, kamu menggunting kuku Hora dengan hati-hati.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						250212601
					]
				},
				{
					"id": 250212601,
					"content": "Hahaha, tidak disangka kamu jago banget urusan ginian!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212602
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212602,
					"content": "Aum, aum, aummm~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212603
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250212603,
					"content": "Hora lagi berterima kasih sama kamu tuh. Kamu teliti sekali pas guntingin kukunya. Waktu dia gali tanah nanti, pasti jadi lebih cepat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212604
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212604,
					"content": "Ini untukmu, anggap saja tanda terima kasih. Oh ya, aku ingatkan kamu ya. Lain kali kalau mau merawat Surian yang lain, tidak boleh pakai cara yang kamu pelajari hari ini ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212605
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212605,
					"content": "Setiap Saurian itu kan punya temperamennya sendiri, jadi cara untuk merawatnya juga beda. Bahkan aku yang hari ini pun kadang masih meraba-raba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212606
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212606,
					"content": "Tapi tetap, aku sudah puas kok. Soalnya kami berdua masih harus bersama untuk waktu lama, kan ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212607
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212607,
					"content": "Hah? Hora ke mana? Jangan-jangan dia kabur lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212608
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212608,
					"content": "Hora! Horaaaaaa~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cazcal"
				}
			]
		},
