				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cazcal"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250210101,
					"content": "Hora, jangan mondar-mandir lagi ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210102
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210102,
					"content": "Gro-groar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210103
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250210103,
					"content": "Hari ini Hora jadi anak pintar ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210104
					]
				},
				{
					"id": 250210104,
					"content": "Yup. Untung ada kamu yang bantuin pakai Bola Mengambangnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210105
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210105,
					"content": "Kalau ada bola ini, aku jadi gampang kalau mau minta dia lakukan berbagai macam hal. Mandi, makan, tidur, latihan, semuanya jadi gampang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210106
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210106,
					"content": "Apalagi potong kuku! Haduh! Dulu ya, mau kejar dia saja sudah capek setengah mati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210107
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210107,
					"content": "Sekarang aku cuma perlu taruh bola ini di depannya, dia pasti langsung duduk tenang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210108
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210108,
					"content": "Groooar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210109
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250210109,
					"content": "Hora, masih ingat sama dia? Dia yang bantu bikin mainanmu loh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210110
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210110,
					"content": "Groar, grrroar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210111,
						250210112
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250210111,
					"content": "Yang pintar yaaa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210113
					]
				},
				{
					"id": 250210113,
					"content": "Wah! Hora masih ingat sama kamu! Dan kayaknya dia senang banget.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210114
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210114,
					"content": "Mau coba guntingin kuku dia? Sekalian lap-in tanduknya deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210115
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210115,
					"content": "Ini benar-benar penting buat Tepetlisaurus kecil, soalnya mereka itu kan harus gali tanah dan bebatuan, jadi cakar mereka harus selalu tajam. Yang rusak dan somplak juga harus dirapikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210116
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210116,
					"content": "Dengan begitu, dia baru bisa punya cakar yang sempurna waktu sudah tumbuh besar nanti ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210117
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210117,
					"content": "Nih, ambil, kita harus pakai kesempatan ini untuk sekalian bersihin seluruh tubuhnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210118,
						250210119
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210118,
					"content": "Gede banget keranjangnya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210120
					]
				},
				{
					"id": 250210120,
					"content": "Aum, aum~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210121
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250210121,
					"content": "*uhuk* Soalnya jarang bisa lihat Hora nurut gini. Begitu kebayang hari ini aku tidak perlu lari-lari sampai ke seluruh pelosok untuk mengejarnya, aku jadi senang sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210122
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210122,
					"content": "Melelahkan ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210123
					]
				},
				{
					"id": 250210123,
					"content": "Tidak kok! Kita mulai ya, aku akan pandu dari samping.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210124
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210124,
					"content": "Supaya Hora bisa rileks, pakai sikat besar untuk membersihkan bagian punggungnya dengan lembut ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210130
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210130,
					"content": "Terus pakai sikat halus untuk bersihkan tanduknya. Pakai tenaga ya, kalau tidak bakal susah bersihin kotoran yang ada di sela-selanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210125
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210125,
					"content": "Setelah itu, pakai handuk untuk lap seluruh badannya. Nanti dia bakal jadi rileks, dan dia akan menjulurkan cakarnya. Nah, setelah itu bisa langsung mengguntingnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210126,
						250210127
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210126,
					"content": "Buset detail juga ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210128
					]
				},
				{
					"id": 250210128,
					"content": "Tentu saja dong. Hora kan aku yang besarkan. Dari semua orang di suku ini ... salah, di seluruh Natlan ini tidak ada yang lebih kenal dia daripada aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210129
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210129,
					"content": "Ya sudah, coba ikuti petunjukku tadi untuk guntingin kuku Hora. Aku bakal di samping kok. Kalau ada yang tidak ngerti, tanya saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210127,
					"content": "Buset hafal betul ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210128
					]
				},
				{
					"id": 250210119,
					"content": "Kok tiba-tiba semangat sih?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210120
					]
				},
				{
					"id": 250210112,
					"content": "(Elus Hora.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210113
					]
				}
			]
		},
