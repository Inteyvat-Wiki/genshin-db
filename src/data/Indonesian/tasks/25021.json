			},
			"dialogs": [
				{
					"id": 250212709,
					"content": "(Hora sepertinya tidak bisa rileks, dia malah melihatmu dengan bingung.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212710
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212710,
					"content": "(Cazcal mengambil alih sebelum situasi memburuk. Setelah mencoba menata penampilannya sekali lagi, akhirnya cakar Hora berhasil digunting rapi ....)",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						250212701
					]
				},
				{
					"id": 250212701,
					"content": "Tidak masalah kok. Kadang aku juga salah menebak maunya Hora. Tapi yang penting dia sudah tahu kalau kamu itu temannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212702
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212702,
					"content": "GROAR!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212703
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250212703,
					"content": "Haha, apa kan kubilang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212704
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212704,
					"content": "Terima kasih ya untuk bantuannya. Ini untukmu. Anggap saja tanda terima kasih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212705
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212705,
					"content": "Pikiran Saurian memang sulit sekali ditebak. Aku sendiri baru bisa tahu apa maunya setelah melalui pendekatan yang cukup lama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212706
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212706,
					"content": "Aku sudah puas bisa seperti ini. Soalnya, kami kan harus bersama untuk waktu yang lama lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212707
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212707,
					"content": "Hah? Hora ke mana? Jangan-jangan dia kabur lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212708
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212708,
					"content": "Hora! Horaaaaaa~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cazcal"
				}
			]
		},
