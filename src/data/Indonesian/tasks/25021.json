	"talks": [
		{
			"id": 2502101,
			"completionStepIds": [
				2502101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2502101",
							"2"
						],
						"stepId": 2502101,
