					"Koki Mao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220140201,
					"content": "Eh? Ada apa, Pengembara? Kamu mau memesan masakan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140202
					],
					"speakerTitle": "Koki Mao"
				},
				{
					"id": 220140202,
					"content": "Kami ingin meminta sedikit bantuan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140203
					]
				},
				{
					"id": 220140203,
					"content": "Xudong pergi ke Inazuma untuk membuat masakan? Tekad dia benar-benar kuat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140204
					],
					"speakerTitle": "Koki Mao"
				},
				{
					"id": 220140204,
					"content": "Kamu kenal dia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140205
					]
				},
				{
					"id": 220140205,
					"content": "Bisa dibilang begitu. Kami berdua pernah duel masak. Yah, bisa dibilang kami... seimbang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140206
					],
					"speakerTitle": "Koki Mao"
				},
				{
					"id": 220140206,
					"content": "Dari dulu dia selalu bilang ingin mencari terobosan baru dan ingin berjalan-jalan ke seluruh dunia. Tidak disangka dia benar-benar melakukannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140207
					],
					"speakerTitle": "Koki Mao"
				},
				{
					"id": 220140207,
					"content": "Tapi sepertinya dia sedang kesulitan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140208,
						220140210
					],
					"speakerTitle": "Koki Mao"
				},
				{
					"id": 220140208,
					"content": "Apa kamu tahu bagaimana menyelesaikan masalahnya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140209
					]
				},
				{
					"id": 220140209,
					"content": "Aku tidak berani menjamin, tapi aku akan mencobanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140214
					],
					"speakerTitle": "Koki Mao"
				},
				{
					"id": 220140214,
					"content": "Sea Grass, Sea Ganoderma, dan apa ini... Sakura Bloom? Bahan makanan aneh apa ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140215
					],
					"speakerTitle": "Koki Mao"
				},
				{
					"id": 220140215,
					"content": "Tapi kalau Sea Grass dan Sea Ganoderma sih, aku bisa terpikirkan masakan yang bisa dibuat. Hanya saja aku perlu beberapa bahan tambahan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140216
					],
					"speakerTitle": "Koki Mao"
				},
				{
					"id": 220140216,
					"content": "Pengembara, apakah kamu bisa membantuku mencari Jueyun Chili dan Fowl?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140217,
						220140219
					],
					"speakerTitle": "Koki Mao"
				},
				{
					"id": 220140217,
					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140218
					]
				},
				{
					"id": 220140218,
					"content": "Tolong ya, setelah menemukan Jueyun Chili dan Fowl, tolong bawakan untukku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Koki Mao"
				},
				{
					"id": 220140219,
					"content": "Bahan makanan yang klasik...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140220
					]
				},
				{
					"id": 220140220,
					"content": "Hahaha, tentu dong! Bahan makanan ini paling bisa diandalkan. Setelah menemukannya, tolong segera bawa pulang untukku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140221
					],
					"speakerTitle": "Koki Mao"
				},
				{
					"id": 220140221,
					"content": "Tapi aku benar-benar tidak tahu bagaimana memasak Sakura Bloom... Entah bagaimana Koki Inazuma mengolah bahan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Koki Mao"
				},
				{
					"id": 220140210,
					"content": "Mungkin Xiangling tahu bagaimana menyelesaikan masalahnya...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140211
					]
				},
				{
					"id": 220140211,
					"content": "Xiangling ya... Anak itu memang selalu kreatif dalam memasak. Mungkin saja dia punya caranya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140212
					],
					"speakerTitle": "Koki Mao"
				},
				{
					"id": 220140212,
					"content": "Tapi dia sedang pergi mengumpulkan Bamboo Shoot di Qingce Village. Kalian akan menghabiskan waktu kalau mencarinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140213
					],
					"speakerTitle": "Koki Mao"
				},
				{
					"id": 220140213,
					"content": "Xudong pasti sudah tidak sabar lagi mendapat jawaban. Coba aku saja yang mencari solusi masalahnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140214
					],
					"speakerTitle": "Koki Mao"
				}
			]
		},
