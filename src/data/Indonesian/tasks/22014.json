				{
					"id": 220140801,
					"content": "Makanan ini... biar kucicipi dulu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140802
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140802,
					"content": "Rasanya benar-benar pas, dan kombinasi antara bahannya juga cocok sekali. Koki Mao memang tidak pernah mengecewakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140803
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140803,
					"content": "Tapi, aku merasa makanan ini kekurangan sesuatu perasaan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140804
					],
					"speakerTitle": "Xudong"
				},
				{
