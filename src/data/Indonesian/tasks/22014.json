			"dialogs": [
				{
					"id": 220140401,
					"content": "Seharusnya sudah cukup. Tunggu sebentar, aku coba lihat bagaimana mengolah bahan makanan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140402
					],
					"speakerTitle": "Koki Mao"
				},
				{
					"id": 220140402,
					"content": "Selesai deh. Ugh, tapi kurasa tidak berbeda jauh dengan masakan yang biasa kubuat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140403
					],
					"speakerTitle": "Koki Mao"
				},
				{
					"id": 220140403,
					"content": "Kalian bawakan saja untuk Xudong. Semoga masakan ini dapat membantunya...",
