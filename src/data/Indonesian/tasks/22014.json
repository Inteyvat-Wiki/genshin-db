				"points": []
			},
			"dialogs": [
				{
					"id": 220140601,
					"content": "Bamboo Shoot di sini lumayan. Aku gali dan bawa pulang ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140602
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140602,
					"content": "Loh kamu? Kenapa di sini? Kamu mau pesan makanan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140603,
						220140604
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140603,
					"content": "Aku ingin meminta bantuanmu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140607
					]
				},
				{
					"id": 220140607,
					"content": "Menggunakan cara Liyue untuk mengolah bahan makanan Inazuma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140608
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140608,
					"content": "Hehehe, kalian sudah bertanya kepada orang yang tepat. Aku pernah dengar di Inazuma ada cara masak menggoreng makanan yang dibaluti tepung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140609
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140609,
					"content": "Setiap makanan yang dibuat dengan cara ini akan disebut \"Tempura\", dan harus ditemani dengan saus yang unik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140610
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140610,
					"content": "Waktu membuat Tempura, aku sangat tertarik dengan sausnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140615
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140615,
					"content": "Banyak juga material yang bisa kucoba, seperti Whopperflower Nectar, atau Flaming Flower...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140611
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140611,
					"content": "Dan Slime Condensate juga kan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140612
					]
				},
				{
					"id": 220140612,
					"content": "Tidak kok, masakan ini tidak cocok dengan Slime Condensate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140616
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140616,
					"content": "Aku mau coba memasukkan bubuk dari sayap Electro Cicin, pasti akan menambahkan cita rasa makanannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140613
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140613,
					"content": "Kalau bilang begitu kamu pasti lupa, sini kucatatkan untukmu, nanti kamu berikan saja ke Xudong ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140614
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140614,
					"content": "Ah, betapa serunya kalau aku bisa ke Inazuma juga, di sana pasti ada banyak bahan-bahan makanan yang belum pernah kucoba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140604,
					"content": "Mirip sekali dengan reaksi Koki Mao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140605
					]
				},
				{
					"id": 220140605,
					"content": "Jadi kamu sudah ke restoran? Tapi sepertinya kamu bukan ke sini untuk makan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140606
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140606,
					"content": "Apa kamu punya masalah yang berhubungan dengan memasak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140607
					],
					"speakerTitle": "Xiangling"
				}
			]
		},
