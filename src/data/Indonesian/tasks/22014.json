					"nextDialogs": [
						220140805
					]
				},
				{
					"id": 220140805,
					"content": "Aku sendiri juga tidak yakin... Biar kupikir-pikir sendiri, setidaknya Koki Mao sudah memberikanku ide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140806
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140806,
					"content": "Terima kasih ya sudah jauh-jauh ke sini, terimalah ini sebagai rasa terima kasihku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140807
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140807,
					"content": "Bagaimana sih caranya membuat makanan yang kekinian...",
					"roleType": "TALK_ROLE_NPC",
