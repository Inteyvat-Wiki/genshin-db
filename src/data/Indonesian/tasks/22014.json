					"Xudong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220140101,
					"content": "Hai Pengembara, hehe, kita ketemu lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140102,
						220140104
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140102,
					"content": "Ada yang perlu kubantu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140103
					]
				},
				{
					"id": 220140103,
					"content": "Masih ingat kan janjiku waktu itu padamu untuk membuatkanmu masakan? Sekarang aku lagi menyiapkannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140106
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140106,
					"content": "Demi sebuah masakan yang lezat, aku sudah mencari bahan-bahan yang bagus dan segar ke mana-mana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140107
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140107,
					"content": "Sekarang bahan yang terkumpul sudah cukup dan aku tinggal memikirkan cara untuk memasaknya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140108
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140108,
					"content": "Ke mana Julie dan Parvaneh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140109
					]
				},
				{
					"id": 220140109,
					"content": "Parvaneh bilang dia mau lanjut mencari bahan-bahan lain. Dia ingin mencari bumbu super serba bisa,",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140110
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140110,
					"content": "Dia lalu menarik Julie pergi ke alam liar mencari bahan makanan. Mereka bilang mereka tidak akan pergi jauh dari kota, jangan cemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140111
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140111,
					"content": "Tapi aku ingin meminta bantuan kalian. Meskipun aku sudah mengumpulkan banyak bahan makanan segar dari Inazuma, tapi aku belum ada inspirasi yang spektakuler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140112
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140112,
					"content": "Kalian lihat. Sea Grass, Sea Ganoderma, dan ini, Sakura Bloom...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140113
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140113,
					"content": "Meskipun bahan-bahan ini sangat segar, tapi aku tidak tahu bagaimana mengolahnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140114
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140114,
					"content": "Aku awalnya berniat meminta bantuan koki dari Inazuma. Tapi kalau begitu, masakan yang dibuat pasti hanyalah masakan Inazuma yang biasa, bukan terobosan baru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140115
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140115,
					"content": "Jadi aku berniat memakai ide dari koki Liyue untuk mengolah bahan makanan Inazuma ini. Dengan begini mungkin aku bisa membuat masakan dengan terobosan baru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140116
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140116,
					"content": "Pengembara, apakah kamu bisa kembali ke Liyue dan meminta bimbingan dari Koki Mao di Wanmin Restaurant?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140117,
						220140119
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140117,
					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140118
					]
				},
				{
					"id": 220140118,
					"content": "Terima kasih banyak. Aku akan menunggumu di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140124
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140124,
					"content": "Semoga Koki Mao punya ide bagus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140119,
					"content": "Kamu mau rasa yang \"boom shaka-laka\" begitu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140120
					]
				},
				{
					"id": 220140120,
					"content": "Apa itu rasa \"boom shaka-laka\"? Maksudmu rasa enak yang mengagetkan pencicipnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140121
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140121,
					"content": "Bagus sekali kalau kamu bisa mendapat resep masakan dengan rasa seperti itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140122
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140122,
					"content": "Tapi aku tidak mengenal orang yang memiliki resep seperti ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140123
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140123,
					"content": "Yang pasti, tolong pergilah meminta bimbingan dari Koki Mao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140124
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140104,
					"content": "Kamu sedang menyiapkan masakan itu untukku?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140105
					]
				},
				{
					"id": 220140105,
					"content": "Hahaha, memangnya kamu tidak lihat kalau sekarang aku lagi menyiapkan masakannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140106
					],
					"speakerTitle": "Xudong"
				}
			]
		},
		{
			"id": 2201402,
