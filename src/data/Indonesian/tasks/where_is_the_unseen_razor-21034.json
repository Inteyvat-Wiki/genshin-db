			"dialogs": [
				{
					"id": 210340101,
					"content": "Hmph, sepertinya di sini tempatnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340102,
						210340103
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340102,
					"content": "Lan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340104
					]
				},
				{
					"id": 210340104,
					"content": "Pengembara, tidak kusangka akan bertemu denganmu di sini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340105
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340105,
					"content": "Kamu ingat gagang pedang yang kamu temukan waktu itu? Ternyata itu memang bagian dari Unseen Razor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340106
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340106,
					"content": "Lucunya lagi, aku tahu itu karena waktu kecil aku pernah diam-diam mengukir sesuatu di gagang itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340107
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340107,
					"content": "Aku juga ingat pernah bilang ke kakakku, kalau dia memutuskan untuk menggunakan pedang lain, dia harus memberikan Unseen Razor padaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340108
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340108,
					"content": "Heh, sepertinya kita berdua tidak ada yang menduga kondisinya akan seperti ini ... Tak kusangka aku menemukan Unseen Razor dengan cara seperti ini. Sepertinya ... pedangnya benar-benar hancur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340109
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340109,
					"content": "Oke. Karena kamu juga sudah di sini, cukup basa-basinya. Aku butuh bantuanmu lagi, Pengembara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340110
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340110,
					"content": "Seharusnya di sekitar sini ada dua kelompok monster yang berkeliaran. Mereka sudah mengumpulkan banyak senjata-senjata rusak di kemah mereka, aku juga tidak tahu apa tujuannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340111
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340111,
					"content": "Adventurers' Guild khawatir kalau monster-monster ini akan mengacau dan awalnya mereka mau memasang permintaan untuk membereskan monster-monsternya. Tapi setelah kuteliti lagi, kupikir ... bisa jadi ada potongan Unseen Razor di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340112
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340112,
					"content": "Pengembara, ayo kita masing-masing bereskan satu kemah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340113
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340113,
					"content": "Kemah yang di kiri dikuasai oleh para Hilichurl. Kalau satu Hilichurl saja sih jelas bukan masalah ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340114
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340114,
					"content": "Tapi mereka ada banyak. Kalau dilawan sekaligus, kurasa bahkan kamu sekali pun bisa kesusahan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340115
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340115,
					"content": "Kalau yang di kanan, isinya satu Stonehide Lawachurl. Kurasa tidak perlu kujelaskan lagi seperti apa bahayanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340116
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340116,
					"content": "Karena kali ini aku yang minta tolong, silakan pilih mau sikat yang mana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340103,
					"content": "Kok ada kamu sih?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340104
					]
				}
			]
		},
