					"content": "Bagaimana? Monster di tempatmu sudah beres semua?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340402
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340402,
					"content": "Monster di sini ... sudah dihajar semua?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340403
					]
				},
				{
					"id": 210340403,
					"content": "Ha? Tentunya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340404
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340404,
					"content": "Maksudku, aku ini ketua Adventurers' Guild Liyue. Menghadapi monster seperti ini sudah jadi makananku sehari-hari.",
