			"dialogs": [
				{
					"id": 210340801,
					"content": "Hmph, sepertinya di sini tempatnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340802,
						210340803
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340802,
					"content": "Lan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340804
					]
				},
				{
					"id": 210340804,
					"content": "Eh? Kebetulan sekali ketemu kamu di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340805
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340805,
					"content": "Betul sekali. Aku kebetulan menemukan ... misi yang \"pas\" di Adventurers' Guild.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340806
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340806,
					"content": "Situasinya masih sama. Kali ini aku perlu bantuanmu membereskan monster-monster.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340807
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340807,
					"content": "Kemah yang di kiri dikuasai oleh para Hilichurl. Kalau satu Hilichurl saja sih jelas bukan masalah ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340808
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340808,
					"content": "Tapi mereka ada banyak. Kalau dilawan sekaligus, kurasa bahkan kamu sekali pun bisa kesusahan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340809
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340809,
					"content": "Kalau yang di kanan, isinya satu Stonehide Lawachurl. Kurasa tidak perlu kujelaskan lagi seperti apa bahayanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340810
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340810,
					"content": "Karena kali ini aku yang minta tolong, silakan pilih mau sikat yang mana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				},
