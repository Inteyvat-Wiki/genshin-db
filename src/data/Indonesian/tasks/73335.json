			"dialogs": [
				{
					"id": 733350701,
					"content": "Hebat, Sorush! Area ini langsung subur lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733350702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733350702,
					"content": "Kekuatan Pari memang ajaib.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733350703
					]
				},
				{
					"id": 733350703,
					"content": "Kenapa kaget? Kekuatanku sudah lebih dari cukup untuk menyelamatkan Bunga Sunyata!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733350704
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733350704,
					"content": "Pencemaran kegelapan merajalela, dan Bunga Sunyata hanyalah satu dari sekian banyak korbannya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733350705
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733350705,
					"content": "Kolam bunga lainnya sepertinya tidak bisa selamat. Sefana pasti kelabakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733350706
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733350706,
					"content": "Sefana ini sepertinya Pari baik yang kerja keras merawat bunga-bunga ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733350707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733350707,
					"content": "#Kalau gitu kita bantu dia yuk? {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733350708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733350708,
					"content": "Baiklah, maka hal ini menjadi sampingan yang layak untuk mahakaryaku. Wahai Yasnapati, perhatikanlah Bunga Sunyata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733350709
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733350709,
					"content": "Nanti aku bilang deh kalau ada lagi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733350710
					]
				},
				{
					"id": 733350710,
					"content": "Ya, yuk selamatin bunga cantik ini bareng-bareng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
