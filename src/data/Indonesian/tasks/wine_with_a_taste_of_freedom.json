			"dialogs": [
				{
					"id": 223030101,
					"content": "Bisnis semakin hari semakin buruk saja...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030102
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030102,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223030103
					]
				},
				{
					"id": 223030103,
					"content": "Restoranku ini, semakin hari semakin sepi pengunjung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030104
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030104,
					"content": "Restoran yang sudah lama buka, terkadang ada baiknya, dan ada buruknya juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030105
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030105,
					"content": "Baiknya, restoran yang sudah lama buka lebih ternama, dan bisa menghasilkan uang dengan mudah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030106
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030106,
					"content": "Buruknya, orang-orang akan merasa bosan dengan menu-menu restoran. Kalau restorannya besar dan menunya banyak, hal ini tidak akan menjadi masalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030107
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030107,
					"content": "Tetapi restoranku hanya restoran kecil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030108
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030108,
					"content": "*fuh...* Pengunjung yang langganan mulai bosan dan semakin jarang ke restoranku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030109
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030109,
					"content": "Dengar-dengar bisnis anggur di Mondstadt berkembang pesat. \"Dandelion Wine\" yang mereka buat dari bunga dandelion sangat terkenal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030110
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030110,
					"content": "Walaupun aku tidak yakin apakah aku bisa membuat anggur dengan dandelion, tapi aku akan mencobanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030111
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030111,
					"content": "Apa kamu bisa membantuku mengambil sedikit dandelion di Mondstadt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030112,
						223030114
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030112,
					"content": "Baiklah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223030113
					]
				},
				{
					"id": 223030113,
					"content": "Tolong ya, aku akan memberi imbalan untuk jerih payahmu. Dan orang Liyue selalu menepati kata-katanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030114,
					"content": "Dandelion Wine?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223030115
					]
				},
				{
					"id": 223030115,
					"content": "Kenapa? Apa rasanya aneh? Kudengar Dandelion Wine sangat populer di Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030116
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030116,
					"content": "Tapi tidak mungkin laku kalau aku hanya meniru resepnya saja...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030117
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030117,
					"content": "Tolong bawakan <color=#00E1FFFF>Dandelion</color> untukku, aku akan mencoba menggunakan cara fermentasi Liyue untuk membuatnya menjadi anggur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Degui"
				}
			]
		},
