			"dialogs": [
				{
					"id": 223030301,
					"content": "Aku akan mencoba membuat anggur dengan cara fermentasi Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030302
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030302,
					"content": "Oh ya, ini imbalan untukmu. Terimalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030303
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030303,
					"content": "Aku tidak mungkin berhasil membuatnya hanya dalam sekali percobaan. Kalau Dandelionnya habis kupakai, aku masih harus meminta bantuanmu untuk mengambilkannya.",
					"roleType": "TALK_ROLE_NPC",
