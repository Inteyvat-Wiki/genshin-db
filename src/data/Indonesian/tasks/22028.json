			"dialogs": [
				{
					"id": 220280501,
					"content": "Ini tempatnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280502
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280502,
					"content": "Katanya dulu ada Doushin yang kasih banyak bangau kertas ke kuil ini, dan berdoa semoga semua orang di Hanamizaka aman sentosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280503
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280503,
					"content": "Enggak lama kemudian, ada kebakaran. Tapi rumah yang kena itu konstruksinya jelek sekali, jadi si api cepat padam dan enggak sempat merembet ke rumah-rumah yang lain ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280504
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280504,
					"content": "Semuanya yakin kalau itu berkat perlindungan dewa ... Karena itu, aku juga sudah bikin bangau kertas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280505
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280505,
					"content": "Oke, ngobrolnya sampai sini dulu! Mau kasih apa nih, kali ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280506
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280506,
					"content": "Kalau kasih bangau kertas kayak si Doushin, mungkin akan langsung dapat jawaban juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280507
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280507,
					"content": "Tapi, kuil ini kan dekat sama kedai teh. Gimana kalau kasih permen konpeito rasa matcha aja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280508
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280508,
					"content": "Terus, eh ... Aku juga suka banget permen konpeito rasa matcha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280509
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280509,
					"content": "Kak, bagaimana menurutmu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouta"
				}
			]
		},
