						220280909
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280909,
					"content": "Kalau aku juga ikutan kasih Iron Ore kayak orang yang tadi di cerita, mungkin doaku bakal dijawab juga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280910
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280910,
					"content": "Aku punya Iron Ore. Dikasih sama pandai besi. Kualitasnya kurang bagus sih, makanya dia mau kasih aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280911
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280911,
					"content": "Terus aku juga dapat Seagrass segar dari dekat sini. Kalau aku rebus terus taburin gula, rasanya pasti muaaantap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280912
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280912,
					"content": "Tapi aku enggak yakin dewa suka camilan kayak gini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280913
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280913,
					"content": "Kak, bagaimana menurutmu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280906,
					"content": "Orang lain mundur bukan berarti dia sendiri berhasil maju kan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280907
					],
					"speakerTitle": "Shouta"
				}
			]
