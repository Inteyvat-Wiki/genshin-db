			},
			"dialogs": [
				{
					"id": 220280101,
					"content": "Kak! Dengarkan aku, kak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280102
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280102,
					"content": "Sesudah kasih barang buat dewa kemarin, keinginanku benar-benar terkabulkan .... sebagian kecil aja sih! Tapi sedikit juga tetap jawaban, iya kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280103
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280103,
					"content": "Memangnya apa keinginanmu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220280104
					]
				},
				{
					"id": 220280104,
					"content": "Uhh ... Aku minta supaya pengarang manga yang lagi kubaca bisa lebih produktif. Setiap dua hari keluar bab baru, kan bagus tauh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280105
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280105,
					"content": "Terus, si pengarang beneran keluarin konten dua bab dalam satu terbitan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280106
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280106,
					"content": "Tapi terus ... dia bilang mau rehat dulu selama waktu tiga bab berikutnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280107,
						220280108
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280107,
					"content": "Seimbang sebagaimana seharusnya, gitu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220280109
					]
				},
				{
					"id": 220280109,
					"content": "Uh ... pokoknya, sekarang aku yakin dewa sudah mendengar permohonanku. Kalau belum terkabul, artinya masih kurang aja ngasihnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280110
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280110,
					"content": "Jadi hari ini aku mau kasih buat dewa di kuil yang lain! Supaya permohonanku 100% terkabul semuanya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280111
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280111,
					"content": "Aku sudah tanya papa mama. Ada dua kuil di dekat sini, satu di dekat Komore Teahouse, satu lagi di jalan ke luar kota.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280112
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280112,
					"content": "Kata Kakak mending ke yang mana dulu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280108,
					"content": "Kok malah jadi kurang satu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220280109
					]
				}
			]
		},
