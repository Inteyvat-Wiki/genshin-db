						220280902
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280902,
					"content": "Dulu pernah ada orang yang kasih Iron Ore, bahan mentah buat pedang. Dia berdoa supaya ilmu bela dirinya bisa meningkat pesat dalam waktu dekat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280903
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280903,
					"content": "Terus orang itu ikutan turnamen dan lawannya semua dikalahkan dengan mudahnya! Semua orang memuji-muji dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280904
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280904,
					"content": "Tapi orang itu malah bilang kalau semua lawan dia ... lagi enggak enak badan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280905,
						220280906
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280905,
					"content": "Berarti dewa ini punya cara pandang yang beda dari yang lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280907
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280907,
					"content": "Tapi semua yakin kalau itu campur tangan dewa. Makanya aku rasa doaku pasti dijawab kalau kita kasih ke kuil ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280908
					],
