			"dialogs": [
				{
					"id": 402270201,
					"content": "Kamu mengantar Aino dan Ineffa ke tempat acara.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						402270202
					]
				},
				{
					"id": 402270202,
					"content": "Hm ... Sepertinya ini tempat yang bagus untuk platform demo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270203
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 402270203,
					"content": "Robot baru ini kayaknya cukup menarik, Aino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402270204,
					"content": "Hehe. Mampir dan coba kapan pun kalian mau! Kalian pasti takjub deh, kujamin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270205
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 402270205,
					"content": "Terima kasih atas bantuannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270206
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402270206,
					"content": "Enggak masalah! Oh iya, buat pendaftarannya, yang mendaftar cuma kalian berdua saja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402270207,
					"content": "Hmm ... Aku yang ikutan, tapi Aino tidak perlu didaftarkan. Dia tidak suka tempat yang ramai. Begitu pameran dimulai, dia akan langsung kembali ke bengkel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270208
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402270208,
					"content": "Benar juga ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
