			"dialogs": [
				{
					"id": 402270101,
					"content": "Hm ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270102
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 402270102,
					"content": "Halo, kalian berdua!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402270103,
					"content": "#Halo {NICKNAME}, Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270104
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402270104,
					"content": "Kami lagi bantuin beberapa urusan Nefer di pameran, terus kami dengar Clink-Clank Krumkake Craftshop ikutan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402270105,
					"content": "Benar. Aino sedang melakukan perbaikan eror tahap akhir pada robot \"Garda Jedar-Jedor\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270106
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402270106,
					"content": "Oh, itu yang mau diikutin ke pameran?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402270107,
					"content": "Iya. Di bengkel, tikus tanah dan makhluk kecil lainnya sering mencuri-curi, jadi Aino mendesain robot pertahanan berdasarkan rupa mereka untuk melindungi tempat ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270108
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402270108,
					"content": "Setelah dilakukan pengujian lebih lanjut, robot-robot ini terbukti sangat efektif, sehingga dia memutuskan untuk melakukan beberapa peningkatan dan membawanya ke pameran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270109
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402270109,
					"content": "Tunggu, jadi Aino beneran bakal jual salah satu robotnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402270110,
					"content": "Tidak persis begitu. Selain daripada beberapa pesanan khusus saja, Aino biasanya jarang menjual produk jadinya. Dia hanya menjual gambar cetak biru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270111
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402270111,
					"content": "Ohhh ... Jadi, kalian sudah siap berangkat ke sana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402270112,
					"content": "Jahoda minta kita agak lebih cepat. Dia sudah ngejagain tempat yang bagus banget buat kalian, takutnya sekarang orang mulai tanya-tanya sama dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402270113,
					"content": "Aku sudah kasih tahu dia kalau aku harus menyelesaikan dulu perbaikan erornya! Buat apa buru-buru kalau tidak ada apa-apa yang mau dijual!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270114
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 402270114,
					"content": "Wah, Paimon enggak pernah lihat Aino seserius ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402270115,
					"content": "Keuangan bengkel sedang sekarat. Aino berharap pameran ini akan memperbaiki situasi keuangan kami, jadi dia sangat teliti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270116
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402270116,
					"content": "Memangnya uangnya habis ke mana? Buat ngerjain riset yang mahal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402270117,
					"content": "Bukan. Yang kurang adalah uang hidangan penutup. Sudah ada setidaknya 47 kasus pembelian hidangan penutup berlebihan yang menyebabkan kekurangan dana penelitian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270118
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402270118,
					"content": "Karena itu, aku memutuskan untuk memisahkan anggaran untuk riset dan untuk hidangan penutup. Aino dilarang untuk memindahkan dana dari satu anggaran ke anggaran lainnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270119
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402270119,
					"content": "Dan belum lama ini, dia sudah menghabiskan seluruh anggaran hidangan penutup bulan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270120,
						402270121
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402270120,
					"content": "Bisa jadi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402270122
					]
				},
				{
					"id": 402270122,
					"content": "Baiklah, selesai! Garda Jedar-Jedor, harumkan nama mama!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270123
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 402270123,
					"content": "Sepertinya kita sudah bisa berangkat sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402270121,
					"content": "Aino, dengar apa kata robot dong.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402270122
					]
				}
			]
		},
