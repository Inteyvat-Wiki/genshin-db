			"dialogs": [
				{
					"id": 761140301,
					"content": "(Eh? Ini ... kelihatannya belum terbakar semua ....)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140302
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140302,
					"content": "(Kudengar Tuan Derwent suka merawat petualang yang terluka ... Sepertinya ini baru saja terjadi.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140303
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140303,
					"content": "(Tapi kenapa dibakar?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jahoda"
				}
			]
		},
