			"dialogs": [
				{
					"id": 761140101,
					"content": "Jadi, orang yang kita selidiki kali ini adalah ... seorang petapa mencurigakan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140102
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140102,
					"content": "Bukannya semua petapa pada dasarnya memang mencurigakan? Orang waras mana sih yang mau tinggal di lereng gunung terpencil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140103
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140103,
					"content": "Orang tidak akan berubah tanpa sebab, terlepas dari apakah perubahan itu didorong oleh faktor internal maupun eksternal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140104
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761140104,
					"content": "Selain itu, hilangnya si pedagang juga menimbulkan pertanyaan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140105
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761140105,
					"content": "Hah? Tapi daerah itu sangat berbahaya, semua orang juga tahu. Bandit, monster ... pedagang yang lewat situ bisa jadi mangsa salah satunya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140106
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140106,
					"content": "Karena \"semua orang juga tahu\", berarti pedagang yang sering lewat sana tentu sudah siap dengan segala risikonya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140107
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761140107,
					"content": "Tapi kali ini pedagang yang sudah hafal betul bentang alam dan punya persiapan serta pengalaman mumpuni tiba-tiba lenyap. Wajar sekali bila timbul kecurigaan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140108
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761140108,
					"content": "Jahoda, tolong kunjungi si \"petapa mencurigakan\" ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140109
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761140109,
					"content": "Perjalannya panjang. Jangan menyimpang dari jalur utama ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140110
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761140110,
					"content": "Oh ... Tentu saja, Bos Nef! Serahkan padaku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jahoda"
				}
			]
		},
