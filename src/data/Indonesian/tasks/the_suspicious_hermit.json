			"dialogs": [
				{
					"id": 761140201,
					"content": "Halo ... ada orang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140202
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140202,
					"content": "Tuan Derwent? Ada di rumah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140203
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140203,
					"content": "Siapa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140204
					],
					"speakerTitle": "Derwent"
				},
				{
					"id": 761140204,
					"content": "Namaku Jahoda. Aku dari Curatorium of Secrets. Izin tanya tentang beberapa hal ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140205
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140205,
					"content": "Bicara saja dari situ. Aku sedang sakit dan tidak bisa bangun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140206
					],
					"speakerTitle": "Derwent"
				},
				{
					"id": 761140206,
					"content": "(Aneh ... anak-anak Geng Keong bilang Tuan Derwent yang ngajarin mereka baca. Katanya gaya bicaranya juga lembut sekali ....)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140207
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140207,
					"content": "(Suaranya serak, tapi enggak kedengaran kayak orang sakit. Kayak, memang sudah dari sananya gitu ....)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140208
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140208,
					"content": "Anda baik-baik saja? Kalau parah, aku bisa panggil dokter ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140209
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140209,
					"content": "Tidak usah. Sebentar juga sembuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140210
					],
					"speakerTitle": "Derwent"
				},
				{
					"id": 761140210,
					"content": "Baiklah. Kalau gitu, tolong ke Kota Nasha kalau sudah mendingan, Anda dicari teman-teman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140211
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140211,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140212
					],
					"speakerTitle": "Derwent"
				},
				{
					"id": 761140212,
					"content": "(Kok enggak dijawab? Aku dengar suara orang jalan, langkahnya berat ....)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140213
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140213,
					"content": "Anda jarang keluar ya akhir-akhir ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140214
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140214,
					"content": "Ya. Aku ... fokus bertapa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140215
					],
					"speakerTitle": "Derwent"
				},
				{
					"id": 761140215,
					"content": "Iya, banyak yang bilang belakangan ini Anda jadi beda ... katanya Anda jadi kelihatan kuat banget. Tidak kelihatan sama sekali karena mungkin dulu Anda selalu pakai jubah panjang ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140216
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140216,
					"content": "Dan masker untuk menghalangi kuuvahki ... lagi ngetren ya sekarang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140217
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140217,
					"content": "Ini ... supaya tidak kedengaran suara dari luar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140218
					],
					"speakerTitle": "Derwent"
				},
				{
					"id": 761140218,
					"content": "Biar bisa lebih fokus bertapa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140219
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140219,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140220
					],
					"speakerTitle": "Derwent"
				},
				{
					"id": 761140220,
					"content": "Ah, belum lama ini ada pedagang yang mengunjungi Anda. Boleh kasih tahu ke mana dia setelah dari sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140221
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140221,
					"content": "Entah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140222
					],
					"speakerTitle": "Derwent"
				},
				{
					"id": 761140222,
					"content": "A-Ah, baiklah. Maaf sudah mengganggu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140223
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140223,
					"content": "(Entah kenapa, tapi rasanya agak berbahaya kalau bertanya terus ....)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140224
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140224,
					"content": "(Tapi omongan orang benar. Ini kayaknya sudah beda orang.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140225
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140225,
					"content": "(Kalau cuma gini doang, Bos Nef bisa ngamuk. Mending lanjut selidiki di sekitar sini deh.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jahoda"
				}
			]
		},
