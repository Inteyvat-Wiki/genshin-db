			},
			"dialogs": [
				{
					"id": 736740101,
					"content": "Hei bocah, bukannya kamu yang membawaku kemari? Ayo terus lanjutkan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740102
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740102,
					"content": "Ah sudahlah, kamu diam saja di sini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740103,
						736740104
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740103,
					"content": "Apa yang kamu lakukan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740106
					]
				},
				{
					"id": 736740106,
					"content": "Ugh, aku sepertinya tertipu lagi ... biar aku jelaskan padamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740107
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740107,
					"content": "Percaya atau tidak, tetapi sebenarnya para Seelie tertarik padaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740108
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740108,
					"content": "Sebenarnya, di antara para Seelie yang menempel padaku itu, salah satu dari mereka ada yang sangat tertarik pada harta karun loh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740109
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740109,
					"content": "Aku juga tidak mungkin memberi nama kepada mereka, jadi aku hanya cukup memanggil mereka \"Treasure-Seeking Seelie\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740110
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740110,
					"content": "Mereka itu sangat pandai dalam mencari harta karun. Bahkan, aku mendapatkan banyak harta karun berkat mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740111
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740111,
					"content": "Sayangnya, terkadang mereka bisa mengabaikanku, apa mungkin mereka lelah mencari harta karun? Atau bisa saja karena aku membosankan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740112
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740112,
					"content": "Kalau memang begitu aku harus cari orang yang disukai Seelie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740113
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740113,
					"content": "Orang itu harus bertanggung jawab mencari harta karun bersama \"Treasure-Seeking Seelie\", sedangkan aku akan membantu menjual harta karun itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740114
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740114,
					"content": "Aku dengar banyak barang antik dari reruntuhan di Sumeru. Jadi aku datang untuk cari peruntungan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740115
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740115,
					"content": "Aku juga banyak menarik perhatian beberapa Seelie di sini, terus beberapa dari \"Treasure-Seeking Seelie\" membawaku ke sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740116
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740116,
					"content": "Sayangnya mereka mengabaikanku saat aku baru mulai menggali ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740117
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740117,
					"content": "Hah? Pergerakan apa ini? Jangan-jangan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740118
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740118,
					"content": "Pengembara, apakah kamu tertarik berburu harta karun bersama para Seelie?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740119,
						736740120
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740119,
					"content": "Aku?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740121
					]
				},
				{
					"id": 736740121,
					"content": "Itu tidak penting, kamu cukup mengikuti mereka, dan menggali di tempat mereka berhenti, gampang, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740122
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740122,
					"content": "Gimana? Kamu coba saja dulu ... Kalau kamu berhasil dapat harta karunnya, semuanya buat kamu deh. Aku cuma perlu Ancient Iron Coin saja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740123
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740123,
					"content": "Lagi pula, aku akan membayarmu dengan harga yang sesuai jika kamu bisa memberikanku Ancient Iron Coin itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740124,
						736740126
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740124,
					"content": "Aku akan coba ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740125
					]
				},
				{
					"id": 736740125,
					"content": "Nah gitu dong! Aku suka orang sepertimu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740130
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740130,
					"content": "Intinya sekarang kita rekan bisnis!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740131
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740131,
					"content": "Kamu ambil dulu buku catatan ini, aku sudah menulisnya, di sini ada catatan beberapa letak harta karun yang belum sempat aku gali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740132
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740132,
					"content": "Pengembara, aku mengandalkanmu! Ingatlah untuk kembali saat menemukan Ancient Iron Coin, dan segera berikan padaku ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740126,
					"content": "Oh iya, apa itu Ancient Iron Coin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740127
					]
				},
				{
					"id": 736740127,
					"content": "Singkatnya, itu adalah bagian dari barang kuno antik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740128
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740128,
					"content": "Jika aku bisa mendapatkan penawar yang baik, Ancient Iron Coin ini bisa aku tukar menjadi barang yang bernilai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740129
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740129,
					"content": "Tapi aku belum menemukan koneksi dari orang yang mau beli sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740130
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740120,
					"content": "Aku tidak bisa berkomunikasi dengan Seelie ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740121
					]
				},
				{
					"id": 736740104,
					"content": "Apa ini ... Seelie?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740105
					]
				},
				{
					"id": 736740105,
					"content": "Kamu bilang dia ini bocah kecil? Ugh ... sudahlah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740106
					],
					"speakerTitle": "Ulman"
				}
			]
		},
