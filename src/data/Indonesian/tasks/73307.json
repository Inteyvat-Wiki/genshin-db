			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zurvan",
					"Sorush"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733070401,
					"content": "Pari yang dahulu tersebar ke segala penjuru kini sudah kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070402
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070402,
					"content": "Kerja bagus. Pantas saja Sorush memilih kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070403
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070403,
					"content": "Ucapan barusan kuanggap pujian ya, Tetua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070404
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733070404,
					"content": "Hehe, Oasis Vourukasha sekarang sudah jauh lebih hidup ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733070405,
					"content": "Nanti kalau lubang raksasa itu sudah beres urusannya, semua yang ada di sini juga pasti bisa bener lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733070406,
					"content": "Ngomong-ngomong, Paimon kepo nih ... Kalau Pari lahirnya dari air, kenapa namanya enggak jadi \"Nyai\" atau \"Nyi\" atau semacamnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733070407,
					"content": "HEH! Jangan konyol ya, Pucat Terbang. Sembarangan kasih nama aneh-aneh!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070408
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733070408,
					"content": "Hehe, lahir dari air ... Aku jadi ingat sesuatu yang terjadi di zaman dahulu kala.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070409,
						733070410
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070409,
					"content": "Apa? Tentang \"Nyai\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733070411
					]
				},
				{
					"id": 733070411,
					"content": "Pada zaman dahulu kala, sekelompok Oceanid dari tanah lain datang kemari, melewati berbagai halangan dan rintangan yang menghadang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070412
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070412,
					"content": "Untuk sampai ke sini, mereka harus bertahan dari terik gurun pasir dan menghadapi monster yang merajalela. Bagi makhluk air, perjalanan itu ibarat siksaan lahir batin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070413
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070413,
					"content": "Mereka datang untuk mencari dewa yang telah mangkat. Namun sayang, yang mereka cari tidak ada di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070414
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070414,
					"content": "Setelah melihat Harvisptokhm, mereka lalu bubar dan pergi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070415
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070415,
					"content": "Setelahnya, legenda tentang Oceanid menyebar. Banyak orang asing mengikuti jejak perjalanan itu demi mengungkap rahasia mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070416
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070416,
					"content": "Seiring berjalannya waktu, apa yang pada mulanya hanya kabar burung berkembang menjadi perjalanan ziarah yang membawa makna pengorbanan diri untuk mencapai kepolosan yang murni tak bercela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070417
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070417,
					"content": "Bahkan setelah Oasis Vourakasha terkunci dari dunia luar, perjalanan ziarah seperti itu masih terus ada hingga beberapa waktu lamanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070418
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070418,
					"content": "Mungkin mereka merasa bahwa makna perjalanan itu sendiri lebih penting daripada tujuannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070419
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070419,
					"content": "Dan mungkin juga, perjuangan demi mencapai suatu tujuan lebih bermakna daripada mengorbankan diri satu kali untuk selamanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070420
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070420,
					"content": "Sindir saja terus! Kenapa masih dibahas sampai sekarang sih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733070410,
					"content": "Aduh, panjang nih kayaknya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733070411
					]
				}
			]
		},
