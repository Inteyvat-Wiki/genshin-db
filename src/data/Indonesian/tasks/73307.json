				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733070601,
					"content": "Hai, Sorush dan Yasnapati-nya ... Eh, ada Paimon juga ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070602
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070602,
					"content": "Hei! Apa maksudnya \"juga ya\"? Enggak sopan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733070603,
					"content": "Haha, maaf, maaf. Dilihat dari wajah kalian, sepertinya ada hal yang menarik ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070604
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070604,
					"content": "\"Menarik\" kayaknya kurang tepat deh buat menggambarkannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733070605,
					"content": "Kamu menceritakan pada Zurvan tentang Pohon Fravashi ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						733070606
					]
				},
				{
					"id": 733070606,
					"content": "Begitu ya. Nah, mulai dari mana ya ceritanya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070607
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070607,
					"content": "Yang barusan kalian jelaskan itu memang Pohon Fravashi, jelmaan Pari. Tapi yang bersemayam di dalamnya lebih tepat kalau disebut \"ingatan yang tidak lengkap\" daripada \"sisa-sisa Pari\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070608
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070608,
					"content": "Mirip dengan Plume of Purifying Light yang kalian dapatkan. Isinya adalah ingatan yang tidak bisa kembali ke tanah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070609,
						733070610
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070609,
					"content": "Tidak bisa kembali ke tanah ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733070613
					]
				},
				{
					"id": 733070613,
					"content": "Kami terlahir dari Oasis Vourukasha, dan ke sanalah kami akan kembali pada akhirnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070614
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070614,
					"content": "Dewa yang menjaga tempat ini ditolak oleh aliran waktu. Begitu pula halnya dengan kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070615
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070615,
					"content": "Tapi semuanya itu sesuai dengan kehendak kami. Kewajiban kami adalah menjaga agar pencemaran tidak mengikuti kami kembali ke dalam tanah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070616
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070616,
					"content": "Di Kolam Amrita, segala pencemaran akan disucikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070617
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070617,
					"content": "Serahkan Plume of Purifying Light ke Kolam Amrita, supaya Pari yang tersebar dapat kembali lagi ke Oasis Vourukasha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070618
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070618,
					"content": "Hehe, kali ini kami sudah berbuat baik ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070619
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733070619,
					"content": "Pucat Terbang. Begitu angkuhnya dirimu, sementara semuanya itu berkat kekuatanku yang ajaib!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070620
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733070620,
					"content": "Hehe, iya, iya, Sorush juga hebat kok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070621
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733070621,
					"content": "Pujian yang lumayan, namun tidak diperlukan. Sebab Yasnapati ada bersama kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070622
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733070622,
					"content": "Soal menjadi Yasnapati, aku anggap kamu sudah rela sepenuhnya ya. Berarti memang kamulah kandidat yang paling pas untuk menyelesaikan ritualnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070623
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070623,
					"content": "Pada zaman dahulu kala, bala tentara manusia yang berjalan bersama Pari akan mengadakan ritual penyucian bagi Pari yang tersebar di padang pasir untuk membawa mereka semua kembali ke Oasis Vourukasha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070624
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070624,
					"content": "Sejak saat itu, \"Yasnapati\" menjadi gelar bagi mereka yang berhasil menjalin ikatan khusus dengan Pari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070625
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070625,
					"content": "Lah? Beda banget deh sama yang Sorush bilang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070626
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733070626,
					"content": "Oh ya? Biarlah, suatu hari nanti juga dia pasti ada benarnya. Sebagai seorang Yasnapati, tanggung jawab untuk membantu Pari yang belum kembali kini ada di bahumu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070627
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070627,
					"content": "Kalau kalian menemukan Pohon Fravashi lagi, tolong bawa Plume of Purifying Light dari pohon itu ke Oasis Vourukasha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070628
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070628,
					"content": "Tenang, enggak dimintain tolong juga kami mau bantu kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733070610,
					"content": "Sama dengan yang diberikan ke Kolam Amrita ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733070611
					]
				},
				{
					"id": 733070611,
					"content": "Plume of Purifying Light berasal dari Khvarena Simurgh. Sedangkan Pari berasal dari perpaduan Khvarena dan Amrita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070612
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070612,
					"content": "Karena itulah kami juga disebut keturunan Khvarena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070613
					],
					"speakerTitle": "Zurvan"
				}
			]
