				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Venier"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 742230201,
					"content": "Seratus tiga puluh enam ... Baiklah. Empat puluh kali lagi! Baru istirahat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230202
					],
					"speakerTitle": "Venier"
				},
				{
					"id": 742230202,
					"content": "Perlu bantuan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742230203
					]
				},
				{
					"id": 742230203,
					"content": "Bantuan? Tidak, tidak perlu. Masa latihan dibantuin orang lain?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230204
					],
					"speakerTitle": "Venier"
				},
				{
					"id": 742230204,
					"content": "Hanya dengan tubuh yang kuat, aku baru bisa jadi seperti prawira ini, bisa bergabung menjadi prajurit hebat di Legion Athanatoi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230205
					],
					"speakerTitle": "Venier"
				},
				{
					"id": 742230205,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230206
					],
					"speakerTitle": "Venier"
				},
				{
					"id": 742230206,
					"content": "Ah, aku lupa perkenalkan diri. Dia pelatihku. Aku baru bisa naik pangkat kalau sudah lulus tesnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230207,
						742230210
					],
					"speakerTitle": "Venier"
				},
				{
					"id": 742230207,
					"content": "Ini kan cuma patung?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742230208
					]
				},
				{
					"id": 742230208,
					"content": "Apa maksudmu, warga yang budiman? Bukankah memang seperti ini rupa semua orang Remuria?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230209
					],
					"speakerTitle": "Venier"
				},
				{
					"id": 742230209,
					"content": "Gimana? Mau coba? Kalau pilar batu ini bisa kamu hancurkan, kamu kuanggap lulus tes awal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230213
					],
					"speakerTitle": "Venier"
				},
				{
					"id": 742230213,
					"content": "Jangan meremehkan! Aku yang sudah berlatih sedemikian rupa pun cuma dapat menghancurkan satu saja bila hanya dengan satu pukulan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venier"
				},
				{
					"id": 742230210,
					"content": "Tes? Tes apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742230211
					]
				},
				{
					"id": 742230211,
					"content": "Tes bertempur dong! Meskipun tubuh yang kekar dan abadi dimiliki, tapi kemampuan bertempur tetap harus dikuasai diri sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230212
					],
					"speakerTitle": "Venier"
				},
				{
					"id": 742230212,
					"content": "Gimana? Mau coba? Kalau pilar batu ini bisa kamu hancurkan, kamu kuanggap lulus tes awal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230213
					],
					"speakerTitle": "Venier"
				}
			]
		},
