			"dialogs": [
				{
					"id": 742230401,
					"content": "Eh? Bisa juga ya ternyata pakai cara itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230402
					],
					"speakerTitle": "Venier"
				},
				{
					"id": 742230402,
					"content": "Luar biasa sekali! Apa dulu kamu pernah jadi tentara Raja Dewa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230403
					],
					"speakerTitle": "Venier"
				},
				{
					"id": 742230403,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230404
					],
					"speakerTitle": "Venier"
				},
				{
					"id": 742230404,
					"content": "Perwira juga memuji penampilanmu loh! Berarti aku harus lebih semangat latihan lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venier"
				}
			]
		},
