			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750443801,
					"content": "(Sebuah karya yang ditulis oleh penulis drama di Fontaine, Jean Brooklyn. Buku setebal ini pasti bisa dipakai oleh orang-orang pendek buat ganjal kaki supaya jadi lebih tinggi.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"Sejarah Dunia Teyvat: Bag. I\""
				}
			]
		},
