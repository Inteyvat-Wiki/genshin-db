				{
					"id": 750442402,
					"content": "... Pengrajin Mahutzintl, Tlanalco, dan ... mereka yang bertanggung jawab atas pembuatan pompa air tersebut ... mereka melakukan pelanggaran dan menyebabkan keterlambatan ... Dia yang paling murah hati tidak menurunkan hukumannya ... hanya memberhentikannya selama 3 minggu ....",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442403
					]
				},
				{
					"id": 750442403,
					"content": "\"... <color=#00E1FFFF>Kunci batu</color> untuk mengaktifkan <color=#00E1FFFF>mekanisme pompa air</color> ... disimpan di ... tidak ada seorang pun yang boleh pakai tanpa izin ... sampai pengrajin yang ditugaskan ....\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": []
				}
			]
