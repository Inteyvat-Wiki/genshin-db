					],
					"speakerTitle": "Monetoo"
				},
				{
					"id": 750444602,
					"content": "Ah, jadi ini toh. Kita harus cari yang ada merahnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750444603,
					"content": "Tunggu ... kenapa hilang? Tadi jelas-jelas sudah kita masukin kan? Ada yang enggak aneh nih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750444604,
					"content": "Apa ada barang lain nih di dalam gucinya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750444605,
					"content": "(Ketuk gucinya)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
