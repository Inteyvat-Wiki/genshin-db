				},
				{
					"id": 750444402,
					"content": "Setelah diperiksa, aneh juga ya. Kenapa yang kosong cuma yang di depan si Monetoo ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750444403,
					"content": "Monetoo lain sudah dapat yang mereka cari, tapi yang satu ini enggak. Gitu kali ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750444404,
					"content": "#Kasihan ... {NICKNAME}, tolongin yuk. Biar dia bisa isi gucinya ... tapi dia butuh barang apa ya?",
