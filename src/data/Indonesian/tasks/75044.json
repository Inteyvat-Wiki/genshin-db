			},
			"dialogs": [
				{
					"id": 750443601,
					"content": "(Novel roman yang ditulis oleh Dorothy Leeckson. Di balik sampulnya yang sudah memudar, ada seorang wanita yang berbaring di ranjang dan dikelilingi oleh bunga-bunga.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750443602
					],
					"speakerTitle": "\"Bunga Lavender\""
				},
				{
					"id": 750443602,
					"content": "(Setelah membaca buku ini, kamu jadi merasa hangat dan puas, tapi tidak mendapatkan pencerahan yang begitu berguna.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750443603
					],
					"speakerTitle": "\"Bunga Lavender\""
				},
				{
					"id": 750443603,
					"content": "Jadi ... itu tukang kebun keluarganya atau saudara ipar dari sepupu sahabatnya? Aduh ... Kok Paimon jadi puyeng gini sih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7504437,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750443701,
					"content": "(Biografi Frank Drebin, Inspektur pasukan kepolisian khusus dari Marechaussee Phantom Fontaine yang sudah pensiun. Ya, benar. Beliau adalah seekor kucing putih yang sangat lincah.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750443702
					],
					"speakerTitle": "\"Detektif Snowpaw\""
				},
				{
					"id": 750443702,
					"content": "(Terdapat jejak kaki kucing besar di halaman judul buku ini, mungkin ini adalah kenang-kenangan yang ditinggalkan oleh Inspektur tersebut kepada bawahannya.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750443703
					],
					"speakerTitle": "\"Detektif Snowpaw\""
				},
				{
					"id": 750443703,
					"content": "Duh benar-benar deh ... Kalau gitu sih mendingan tulis buku tentang Paimon juga, judulnya ... Detektif Berambut Putih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7504438,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": []
			},
