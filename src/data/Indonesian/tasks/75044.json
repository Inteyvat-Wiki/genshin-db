			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750440701,
					"content": "Soaring Saurian buka seharian. Jika ingin bergabung dengan latihan khusus Matahga, langsung naik ke lantai atas saja dari Soaring Saurian. Harap diingat:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750440702
					],
					"speakerTitle": "Slogan yang Mencolok"
				},
				{
					"id": 750440702,
					"content": "Berlatih dengan serius adalah suatu kebanggaan, bermalas-malasan adalah suatu bentuk penghinaan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750440703
					],
					"speakerTitle": "Slogan yang Mencolok"
				},
				{
					"id": 750440703,
					"content": "Kalau hari ini tidak berusaha, silakan besok makan sampah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750440704
					],
					"speakerTitle": "Slogan yang Mencolok"
				},
				{
					"id": 750440704,
					"content": "Teruslah berusaha, agar menjadi penunggang Saurian yang luar biasa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Slogan yang Mencolok"
				}
			]
		},
		{
			"id": 7504408,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750440801,
					"content": "Isyarat yang benar: bunyikan trompet kiri dulu, baru yang kanan, lalu kiri lagi, dan terakhir kanan. Awas, kalau asal tiup tanggung sendiri akibatnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750440802
					],
					"speakerTitle": "Matahga! Ingat!!!"
				},
				{
					"id": 750440802,
					"content": "Kasih Saurian daging unggas, biar dia tidak bete dan kamu tidak dipatuk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750440803
					],
					"speakerTitle": "Matahga! Ingat!!!"
				},
				{
					"id": 750440803,
					"content": "(Kayaknya ini pengingat yang ditinggalkan seseorang bernama Matahga untuk dirinya sendiri. Bisa terasa emosinya yang meluap-luap dalam setiap katanya.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750440804
					],
					"speakerTitle": "Matahga! Ingat!!!"
				},
				{
					"id": 750440804,
					"content": "(Tapi nambahin tanda seru di setiap pengingat ... buat apa? Mending enggak usah sekalian, enggak ada bedanya.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Matahga! Ingat!!!"
				}
			]
		},
		{
			"id": 7504417,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7504401",
							"2"
						],
						"stepId": 7504401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750441701,
					"content": "\"Atas perintah sang Penjaga {RUBY#[D]Yajaw K'ahk'}Api Keramat, Tuan Agung Yang Berda{RUBY#[D]Ti'sakhuun}ulat Pa{RUBY#[D]Kalomte}duka Och-Kan, semua suku wajib menyumbang tenaga kerja untuk pembangunan fasilitas penyimpanan air ....\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750441702
					]
				},
				{
					"id": 750441702,
					"content": "\"Tidak ada paksaan jumlah, penyediaan dilakukan secara sukarela ... pendirian aliansi ... kami harap semua suku segera menanggapi ....\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7504418,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7504401",
							"2"
						],
						"stepId": 7504401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750441801,
					"content": "\"Atas perintah sang Penjaga {RUBY#[D]Yajaw K'ahk'}Api Keramat, Tuan Agung Yang Berda{RUBY#[D]Ti'sakhuun}ulat Pa{RUBY#[D]Kalomte}duka Och-Kan, tanah terkutuk telah resmi dijadikan tempat terlarang, tidak ada seorang pun anggota aliansi yang boleh masuk.\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750441802
					]
				},
				{
					"id": 750441802,
					"content": "\"Barang siapa berani memasuki tempat terlarang tanpa izin akan ditetapkan sebagai musuh aliansi. Demikianlah pernyataan ini dibuat bersama-sama oleh (...) Nanatzcayan, Meztli, Huitztlan, and Teteocan.\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7504419,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7504401",
							"2"
						],
						"stepId": 7504401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750441901,
					"content": "\"Kemuliaan bagi sang Penjaga {RUBY#[D]Yajaw K'ahk'}Api Keramat, Pangeran Per{RUBY#[D]Q'atal Tzij}damaian, Tuan Agung Yang Berda{RUBY#[D]Ti'sakhuun}ulat Och-Kan.\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750441902
					]
				},
				{
					"id": 750441902,
					"content": "\"Mengingat keseluruhan dari kemajuan proyek pembuangan air di area ini cukup lambat, maka untuk menjamin kemenangan para aliansi maka akan ada sedikit penyesuaian yang dibuat pada sistem rotasinya.\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750441903
					]
				},
				{
					"id": 750441903,
					"content": "\"Para pekerja akan dibagi menjadi 3 tim, setiap tim bekerja selama 16 jam, dan akan dirotasi selama 2 hari. Tim dengan performa yang luar biasa akan mendapatkan bijih-bijihan tambahan.\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750441904
					]
				},
				{
					"id": 750441904,
					"content": "\"Fajar kemenangan untuk <color=#00E1FFFF>menguras air</color> sudah dekat. Saat terowongan tersebut selesai dibangun, <color=#00E1FFFF>pompa air</color> dapat berfungsi secara normal. Ayo dorong lebih kuat!\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7504420,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7504401",
							"2"
						],
						"stepId": 7504401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750442001,
					"content": "\"Rekan-rekan, keluarga, dan saudara-saudariku yang sudah mendedikasikan dirinya bagi kemenangan aliansi ....\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442002
					]
				},
				{
					"id": 750442002,
					"content": "\"... Dia yang paling murah hati ... telah menempatkan beberapa mekanisme baru dari (...) untuk membantu transportasi, (...) dan <color=#00E1FFFF>pengambilan barang dari bawah air</color> ....\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442003
					]
				},
				{
					"id": 750442003,
					"content": "\"... Maju! Maju! Pokoknya maju terus ... Demi masa depan gemilang yang penuh kemenangan bagi aliansi, demi kejayaan dan kebebasan kami, demi tanah air yang merdeka dari tangan naga jahat ....\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442004
					]
				},
				{
					"id": 750442004,
					"content": "\"... Dilarang menyentuh <color=#00E1FFFF>tuas pengontrol</color> tanpa izin ... Terjatuh tanpa sengaja ... sudah menyebabkan kematian dari 3 orang pekerja ....\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7504421,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7504401",
							"2"
						],
						"stepId": 7504401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750442101,
					"content": "\"Di balik dinding batu di utara, ada jalan kecil menuju ke atas air terjun. Sepertinya bisa digunakan untuk <color=#00E1FFFF>gudang penyimpanan</color> ....\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442102
					]
				},
				{
					"id": 750442102,
					"content": "\"... Aku menandai beberapa tempat, supaya tidak lupa nantinya ....\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442103
					]
				},
				{
					"id": 750442103,
					"content": "\"... Luka Sayani semakin buruk. Sepertinya karena tingkat kelembapannya ... Aku sudah suruh dia istirahat, tapi dia malah tertawa ... Katanya itu malah bisa memperlambat kerja tim, nanti semua orang jadi tidak bisa mendapatkan suplai tambahan itu ....\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442104
					]
				},
				{
					"id": 750442104,
					"content": "\"... Saat malam tiba, saat yang lain tidak ada yang lihat, aku akan diam-diam bawa obor untuk membakar lukanya. Kalau tidak begitu, nanti lukanya bakal membusuk juga ....\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": []
				}
			]
		},
