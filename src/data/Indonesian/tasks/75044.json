			"dialogs": [
				{
					"id": 750444701,
					"content": "(Ada tulisan yang seperti ditulis anak-anak. Isinya:)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444702
					],
					"speakerTitle": "Catatan Anak Kecil"
				},
				{
					"id": 750444702,
					"content": "Mainan ini namanya \"Bing Bong Ding Dong\". Aturannya:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444703
					],
					"speakerTitle": "Catatan Anak Kecil"
				},
				{
					"id": 750444703,
					"content": "1. Kalau Monetoo Bing Bong enggak lagi ding-dong, naik ke atas patung Saurian supaya dia maju.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444704
					],
					"speakerTitle": "Catatan Anak Kecil"
				},
				{
					"id": 750444704,
					"content": "2. Turun dari patung Saurian-nya kalau si Monetoo Bing Bong sudah sampai hitungan \"Booong!\", atau kamu akan kalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444705
					],
					"speakerTitle": "Catatan Anak Kecil"
				},
				{
					"id": 750444705,
					"content": "3. Yang pertama sampai ke tempat Monetoo Bing Bong akan menang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444706
					],
					"speakerTitle": "Catatan Anak Kecil"
				},
				{
					"id": 750444706,
					"content": "Enggak usah bilang \"kok aturannya sama kayak main Lampu Merah Lampu Hijau?\"!!! Aturan itu penting, dan dibikin gitu buat diikutin. Kalau enggak ikutin ya enggak bisa menang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Catatan Anak Kecil"
				}
			]
		}
	]
