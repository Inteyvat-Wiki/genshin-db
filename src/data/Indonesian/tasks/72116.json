					"nextDialogs": [
						721160402
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160402,
					"content": "Berikutnya tinggal menunggu data Sensor Beacon terkumpul semua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160403
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160403,
					"content": "Setelah ada data, aku akan membuat sedikit penyesuaian pada alatnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160404
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160404,
					"content": "Begitu semua siap, kita akhiri sudah permasalahan ini.",
