			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xavier"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721160101,
					"content": "Waktunya belum tiba...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160102
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160102,
					"content": "Datanya sudah terkumpul kah?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721160103
					]
				},
				{
					"id": 721160103,
					"content": "Oh, kamu datang! Masih ada data yang belum terkumpul, kurasa harus tunggu sebentar lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160104
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160104,
					"content": "Aku menggunakan waktu ini untuk memikirkan struktur alat pemurnian darurat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160105,
						721160107
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160105,
					"content": "Alat apa lagi tuh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721160106
					]
				},
				{
					"id": 721160106,
					"content": "Ah, cuma trik kecil untuk kondisi darurat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160109
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160109,
					"content": "Menurut rencana, kita akan menghadapi para Fatui dan Tatarigami sekaligus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160110
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160110,
					"content": "Aku percaya kamu dapat mengatasi Fatui. Dan aku, tentu saja bertugas menangani energi Tatarigami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160111
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160111,
					"content": "Alat pemurnian darurat ini kubuat khusus untuk mengatasi Tatarigami. Tapi untuk membuat perangkat ini, aku perlu bantuanmu lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160112,
						721160113
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160112,
					"content": "Bantu bagaimana?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721160117
					]
				},
				{
					"id": 721160117,
					"content": "Aku perlu material khusus agar alat ini dapat berfungsi di dalam Mikage Furnace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160118
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160118,
					"content": "Crystal Marrow yang mengandung energi Tatarigami yang tidak aktif itu paling ideal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160119
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160119,
					"content": "Sebenarnya, rahasia Jade Steel yang terkenal itu adalah penggunaan metode khusus untuk menambahkan material ini saat menempa sehingga meningkatkan kekuatan logamnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160120
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160120,
					"content": "Tentu saja, metode khusus itu adalah rahasia perusahaan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160121
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160121,
					"content": "Seingatku ada tambang kristal di sekitar sini. Tolong cari tiga buah saja untukku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160122
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160122,
					"content": "Aku mengerti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721160123
					]
				},
				{
					"id": 721160123,
					"content": "Aku serahkan urusan ini padamu. Tiga Crystal Marrow, langsung bawa ke sini kalau sudah dapat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160113,
					"content": "Aku kira alatnya ada nama resminya...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721160114
					]
				},
				{
					"id": 721160114,
					"content": "Nama resminya ya itu, Alat Pemurnian Darurat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160115
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160115,
					"content": "Ah, apa maksudmu kode produk dan tanggal pembuatan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160116
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160116,
					"content": "Perangkat darurat tidak perlu hal seperti itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160117
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160107,
					"content": "Bagian dari \"Prosedur Tanggap Darurat\" juga?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721160108
					]
				},
				{
					"id": 721160108,
					"content": "Iya sih. Tapi trik ini biasanya tidak termasuk ke dalam layanan pelanggan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160109
					],
					"speakerTitle": "Xavier"
				}
			]
		},
