				{
					"id": 205160401,
					"content": "Bukankah anak ini selalu sakit? Jadi bagaimana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160402
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 205160402,
					"content": "Permisi, apakah kamu melihat seorang gadis kecil...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205160403
					]
				},
				{
					"id": 205160403,
					"content": "Hah... kamu pasti sedang mencari Anna ya, lihat ke atas — dia ada di tangan patung Archon Anemo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160404
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 205160404,
					"content": "Sejujurnya, aku sangat terkejut ketika dia berlari melewatiku. Maksudku, dia selalu sakit-sakitan selama ini, jadi dari mana dia mendapatkan energi sebanyak ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160405
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 205160405,
					"content": "Saat aku tertegun, tahu-tahu dia sudah sampai ke tangan patung Archon Anemo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160406
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 205160406,
					"content": "Kenapa kamu... tidak marah?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205160407
					]
				},
				{
					"id": 205160407,
					"content": "Marah? Ya, aku sedikit marah. Tapi anak itu selalu tersiksa oleh penyakitnya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160408
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 205160408,
					"content": "Sekarang melihatnya dalam keadaan yang sehat... Bagaimana mengatakannya ya, aku justru tidak bisa marah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160409
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 205160409,
					"content": "Tapi, angin di atas sangat kencang, kuharap dia tidak masuk angin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				}
			]
