				},
				{
					"id": 205160504,
					"content": "Aku pikir tidak ada yang bisa menemukanku di tempat ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160505
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205160505,
					"content": "Oh iya, pasti Suster Grace yang memberi tahumu ya, dia selalu ada di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160506
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205160506,
					"content": "Obat yang aku minum sebelumnya, semua juga dari dia yang mengantarkannya untukku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160507
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205160507,
					"content": "Suster Grace benar-benar orang yang baik... tapi aku tidak ingin selamanya tinggal di Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160508
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205160508,
					"content": "Baiklah, aku tahu kakakku sedang mencariku, aku akan segera kembali agar dia tidak khawatir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
