			"dialogs": [
				{
					"id": 205160101,
					"content": "Oh, kabur ke mana lagi bocah ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160102
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205160102,
					"content": "Anna lagi-lagi pergi bermain ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205160103
					]
				},
				{
					"id": 205160103,
					"content": "Kok ekspresimu seperti biasa saja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160104
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205160104,
					"content": "Anna menjadi semakin bandel, aku lengah sedikit dia langsung menyelinap pergi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160105
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205160105,
					"content": "Dia belum pulih sepenuhnya! Tolong bantu aku untuk segera menemukannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160106,
						205160108,
						205160111
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205160106,
					"content": "Baiklah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205160107
					]
				},
				{
					"id": 205160107,
					"content": "Mohon bantuanmu ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160115
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205160115,
					"content": "Oh iya, Anna terus memberitahuku sebelumnya bahwa dia ingin melihat patung Archon Anemo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160116
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205160116,
					"content": "Aku jadi ingat bahwa Suster Grace sering pergi ke sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160117
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205160117,
					"content": "Coba kamu tanyakan ke dia dulu, mungkin dia akan memperhatikan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205160108,
					"content": "Apakah kamu sudah mengeceknya di sekeliling?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205160109
					]
				},
				{
					"id": 205160109,
					"content": "Tentu saja, aku bahkan mencarinya sampai di luar kota!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160110
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205160110,
					"content": "Tapi tetap saja, tidak menemukannya, jadi kumohon temukanlah dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160115
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205160111,
					"content": "Anna suka makan apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205160112
					]
				},
				{
					"id": 205160112,
					"content": "Oh, dia suka makan... Hei! Sudah kubilang jangan memperlakukannya seperti kucing!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160113
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205160113,
					"content": "Selain itu, dia suka banyak sekali makanan, lebih dari yang bisa aku hitung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160114
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205160114,
					"content": "Baiklah, aku mengandalkanmu untuk segera mencarinya. Aku akan menunggumu di sini, aku sangat lelah, rasanya mau pingsan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160115
					],
					"speakerTitle": "Anthony"
				}
			]
		},
