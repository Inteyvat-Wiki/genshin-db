					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205160203
					]
				},
				{
					"id": 205160203,
					"content": "Wah! Mengagetkanku saja! Kamu muncul dari mana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160204
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205160204,
					"content": "Pasti kakakku sedang mencariku lagi. Haha, aku tahu dia tidak akan menemukanku di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160205
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205160205,
					"content": "Baiklah, baiklah, aku tahu. Aku akan kembali sebentar lagi. Aku tidak akan membuatnya khawatir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				}
			]
		},
