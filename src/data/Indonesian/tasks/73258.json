				{
					"id": 732580401,
					"content": "(Lanjutkan Membaca ....)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732580402
					]
				},
				{
					"id": 732580402,
					"content": "\"... kelihatan bagus ya kalau pakai mahkota bunga, dan seperti jadi terhubung dengan semua orang. Seolah dia jadi kayak Aranara juga.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732580403
					],
					"speakerTitle": "Catatan yang Tulisannya Jelek"
				},
				{
					"id": 732580403,
					"content": "#\"Sekarang Nara {NICKNAME} dan Paimon lagi istirahat. Aku masih tak paham, kenapa Nara harus istirahat? Kamu tidak bisa buat kenangan dengan teman-temanmu saat sedang istirahat ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732580404
					],
					"speakerTitle": "Catatan yang Tulisannya Jelek"
				},
				{
					"id": 732580404,
					"content": "#\"... Pergi menemui Ashvattha. Ashvattha akan menerima Nara {NICKNAME} dan Paimon. Kita semua adalah anak-anak hutan.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732580405
					],
					"speakerTitle": "Catatan yang Tulisannya Jelek"
				},
				{
					"id": 732580405,
					"content": "#\"Omong-omong, pasti ada banyak cerita petualangan tentang Nara {NICKNAME}, Paimon, dan semua orang di Aranyaka.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732580406
					],
					"speakerTitle": "Catatan yang Tulisannya Jelek"
				},
				{
					"id": 732580406,
					"content": "#\"Setelah Nara {NICKNAME} dan Paimon mendapatkan Bija dan membantu Narana, ayo kita panggil Arana dan bacakan ceritanya di Aranyaka!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Catatan yang Tulisannya Jelek"
				}
			]
