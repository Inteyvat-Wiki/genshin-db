					"Venti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3730201,
					"content": "Oh? Apa yang kalian sedang lakukan di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730202
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730202,
					"content": "Barusan aku sempat berpikir sih, jangan-jangan kalian akan mengikutiku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730203
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730203,
					"content": "Aku ingin tahu lebih banyak tentang Archon Anemo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3730204
					]
				},
				{
					"id": 3730204,
					"content": "Dewa Anemo, Barbatos? Dia sudah lama hilang dari Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730205
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730205,
					"content": "Archon Geo di Liyue dan Archon Electro di Inazuma masih ada, tetapi Mondstadt sudah lama tidak melihat Archon mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730206
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730206,
					"content": "Kenapa kalian ingin cari tahu tentang Archon Anemo? Apa ada hubungannya dengan Dvalin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730207
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730207,
					"content": "Oh, ahh ... itu karena dewa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3730208,
					"content": "Betul, seseorang memberitahuku masa lalu Dvalin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3730209
					]
				},
				{
					"id": 3730209,
					"content": "Oh? Memangnya bagaimana sekarang pandangan semua orang terhadap \"Stormterror\"? Aku jadi agak penasaran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730210
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730210,
					"content": "Ya walaupun begitu, kamu tidak perlu menjelaskannya buru-buru sih——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730211
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730211,
					"content": "Sudah lama aku tidak kembali, sepertinya ada beberapa pihak yang tidak senang dengan kedatanganku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
		{
			"id": 37304,
			"completionStepIds": [
				37304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"37304",
							"2"
						],
						"stepId": 37304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Venti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3730401,
					"content": "Sepertinya naga itu bukan satu-satunya yang terpengaruh oleh perubahan angin ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730402
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730402,
					"content": "Oh iya, kamu tadi bilang, ada yang memberitahumu tentang masa lalu naga itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730405,
					"content": "Oh ya? Sepertinya Lisa si pustakawan Mondstadt itu, pengetahuannya cukup luas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730406
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730406,
					"content": "Dia benar, pertikaian bisa sampai ke titik ini, itu karena kedua kubu sama-sama memilih untuk menggunakan kekerasan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730407
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730407,
					"content": "Tetapi kebenciannya, bukan terlahir karena orang-orang tidak memberi upeti kepada para Four Winds.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730408
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730408,
					"content": "Bukan juga terlahir dari dirinya sendiri, melainkan merupakan sebuah hasil dari degradasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730409
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730409,
					"content": "De ... gradasi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3730410,
					"content": "Darah hitam yang mengalir melalui jantungnya, sudah menyiksanya dalam waktu yang lama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730411
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730412,
					"content": "Abyss Mage?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3730413
					]
				},
				{
					"id": 3730414,
					"content": "Sepertinya aku pernah mendengarnya di Mondstadt ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3730415
					]
				},
				{
					"id": 3730411,
					"content": "Itulah yang membuatnya disesatkan oleh kebohongan Abyss Mage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730412,
						3730414
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730413,
					"content": "Mereka berasal dari Abyss Order, sebuah organisasi non-manusia yang membenci kaum manusia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730416
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730415,
					"content": "Benar. Mereka adalah Abyss Order, sebuah organisasi non-manusia yang membenci kaum manusia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730416
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730416,
					"content": "Aku tidak tahu dari manakah mereka berasal. Yang aku tahu, mereka memiliki kebencian yang mendalam terhadap dunia manusia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730417
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730417,
					"content": "Banyak Hilichurl di alam liar mematuhi perintah mereka, dan diperalat sebagai senjata mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730418
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730418,
					"content": "Sebelum datang ke sini, aku juga sama dengan Dvalin, dikutuk dan disia-siakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730419
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730419,
					"content": "Tapi, tempat di mana kita berdiri sekarang adalah \"Lambang pahlawan Mondstadt\", asal mula dari Mondstadt yang berdiri hari ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730420
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730420,
					"content": "Angin yang berembus dari sela-sela pepohonan terasa sangat nyaman, aku menyukai wangi khasnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730421
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730421,
					"content": "Berdiri bersamamu di bawah pohon besar ini, pengalamannya sama seperti waktu air mata tadi termurnikan. Rasanya seperti racun itu meninggalkan tubuhku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730422
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730423,
					"content": "Hmm ... rasanya sudah jauh lebih baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730424
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730424,
					"content": "Jadi ... gimana ceritanya kamu bisa kena racun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730425
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3730425,
					"content": "Ahh ... itu karena aku tadi mencoba berkomunikasi dengan Dvalin, tapi proses komunikasi itu ... terinterupsi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730426
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730427,
					"content": "Oh, ah ... itu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3730429
					]
				},
				{
					"id": 3730428,
					"content": "Apa itu gara-gara ... aku?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3730429
					]
				},
				{
					"id": 3730426,
					"content": "Alhasil, bukan hanya gagal membantu Dvalin mematahkan kutukannya, malah aku sendiri juga jadi terkena kutukannya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730427,
						3730428
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730429,
					"content": "Ya, itu karena kamu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730430
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730431,
					"content": "#Jadi sebagai kompensasinya ... {NICKNAME}, ikut aku ke Katedral!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730432
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730432,
					"content": "Katedral Mondstadt? Mau ngapain kita ke sana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730433
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3730433,
					"content": "Untuk mengambil ... sesuatu yang bernama \"Holy Lyre der Himmel\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		}
	]
}