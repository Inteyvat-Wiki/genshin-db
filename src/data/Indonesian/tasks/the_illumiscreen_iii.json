				"points": []
			},
			"dialogs": [
				{
					"id": 413590101,
					"content": "Ayo coba mainkan Illumiscreen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590102
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413590102,
					"content": "Apa kali ini kamu menyiapkan pola yang berbeda?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413590103
					]
				},
				{
					"id": 413590103,
					"content": "Tentu saja, bagaimana pun juga, kamu telah menyelesaikannya dua kali berturut-turut, tetapi kali ini aku benar-benar menyiapkan pola lentera yang paling sulit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590104
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413590104,
					"content": "Ini menggunakan prinsip yang sama, kamu menggabungkan ketiga gambar itu dan membuatnya menjadi sebuah gambar yang utuh. Yang menjadikannya sulit adalah karena kali ini mereka <color=#00E1FFFF>tersambung bersama</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590105
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413590105,
					"content": "Haha, ayo coba saja sendiri, kali ini polanya adalah <color=#00E1FFFF>Divine Crane</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590106
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413590106,
					"content": "Kalian boleh pergi mencari harta karunnya setelah berhasil menggabungkan gambarnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qian"
				}
			]
		},
		{
			"id": 4135902,
