					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590303
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413590303,
					"content": "Cepat lihat layar. Petunjuk dari harta karun itu tersembunyi di sana.",
