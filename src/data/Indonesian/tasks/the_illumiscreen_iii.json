			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qian"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413590201,
					"content": "Bagaimana? Sudah menemukan hartanya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590202
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413590202,
					"content": "Kami sudah menemukan semuanya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413590203
					]
				},
				{
					"id": 413590203,
					"content": "Wah, kamu benar-benar berhasil menyelesaikan ketiga gambar tersebut... Hebat sekali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590204
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413590204,
					"content": "Hehe, untuk petualang dengan kemampuan sehebat kalian, kami dari Adventurers' Guild sudah menyiapkan sebuah hadiah spesial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590205
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413590205,
					"content": "Apa kamu bisa melihat peti harta karun tersebut? Ayo ambil semuanya. Itu semua untukmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590206
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413590206,
					"content": "Kalau kuambil...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413590207
					]
				},
				{
					"id": 413590207,
					"content": "Orang setelah kalian tidak akan mendapatkannya. Sama seperti bertualang, siapa cepat dia yang dapat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590208
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413590208,
					"content": "Baiklah, Selamat Hari Lantern Rite. Selamat menikmati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qian"
				}
			]
		},
