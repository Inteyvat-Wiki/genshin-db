			"dialogs": [
				{
					"id": 760280301,
					"content": "#Huaaa, akhirnya {NICKNAME} ketemu juga! Pas dua yang nyala-nyala itu tabrakan, Paimon mental jauh banget karena ledakannya! Untungnya enggak sampai luka sih, cuma mental doang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760280302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760280302,
					"content": "Paimon terbang lamaaa banget buat balik lagi ke sini ... tapi yang penting kamu masih utuh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760280303,
						760280308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760280303,
					"content": "Sebetulnya aku terbang lumayan jauh juga sih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760280304
					]
				},
				{
					"id": 760280304,
					"content": "Oh ... Sebentar! \"Terbang\" gimana maksudnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760280305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760280305,
					"content": "Kamu menceritakan apa yang kamu lihat tadi ke Paimon.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						760280306
					]
				},
				{
					"id": 760280306,
					"content": "#Hmm, Paimon enggak tahu ada tempat kayak gitu di Teyvat ... {NICKNAME}, kamu yakin enggak salah lihat? Bukan halu doang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760280307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760280307,
					"content": "Tapi yang penting kamu masih utuh, selamat, sehat sentosa! Di sini aneh banget, mending kita buruan pergi deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760280312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760280312,
					"content": "Paimon enggak nyangka sih bakal sebahaya ini, mana enggak ada harta apa-apa pula setelahnya. Tapi kenapa yang gituan bisa ada di sini ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760280313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760280313,
					"content": "Kalau dua yang nyala-nyala itu bukan Seelie ... terus apa dong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760280308,
					"content": "Aku juga mental ... ke tempat yang aneh banget.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760280309
					]
				},
