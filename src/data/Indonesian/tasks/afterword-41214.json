			},
			"dialogs": [
				{
					"id": 412140101,
					"content": "Kami datang lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412140102,
					"content": "Pengembara, Paimon, selamat datang kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140103
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140103,
					"content": "Paimon sudah terbiasa menemui Albedo dengan cara ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140104,
						412140105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412140104,
					"content": "Aku sudah menyelesaikan permintaanmu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140106
					]
				},
				{
					"id": 412140106,
					"content": "Terima kasih banyak. Aku tahu pilihanku tidak akan salah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140107
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140107,
					"content": "Kamu memilihku untuk membantumu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140108
					]
				},
				{
					"id": 412140108,
					"content": "Ya, kamu sangat penting dalam penelitianku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140109
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140109,
					"content": "Hehehe, Paimon merasa bangga mendengarnya~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412140110,
					"content": "Aku tidak akan pernah melupakan kebaikanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140111
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140111,
					"content": "Kamu bisa mengambil pedang ini sekarang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140112
					]
				},
				{
					"id": 412140112,
					"content": "Seharusnya sudah cukup kuat, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412140113,
					"content": "Sudah cukup. Bagaimana perasaanmu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140114
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140114,
					"content": "Sama saja seperti dulu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140115
					]
				},
				{
					"id": 412140115,
					"content": "Bagus sekali. Tidak ada efek samping, tidak terpengaruh hawa jahat ataupun terkena racun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140116
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140116,
					"content": "Sepertinya... dugaanku benar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140117
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140117,
					"content": "Pria ini selalu memasang ekspresi seakan-akan tahu segalanya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412140118,
					"content": "Apakah kamu menyukai pedangnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140119,
						412140120
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140119,
					"content": "Itu senjata yang bagus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140121
					]
				},
				{
					"id": 412140121,
					"content": "Oh ya? Tapi bagaimana pun, kondisi pedang ini telah mencapai tahap yang kuinginkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140122
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140122,
					"content": "Kenapa kamu memegang pedangnya? Albedo, apa yang kamu lakukan? Ja-jangan gegabah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412140123,
					"content": "Aku mau mengeluarkan energi kehidupan yang telah dimurnikan itu dari dalam pedang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140124
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140124,
					"content": "Apakah energi ini bisa bertahan di luar pedang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412140125,
					"content": "Mungkin hal ini tidak mungkin dilakukan oleh beberapa orang, tapi aku bisa melakukannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140126
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140126,
					"content": "...selesai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140127
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140127,
					"content": "Wow, energi ini terlihat seperti bola cahaya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412140128,
					"content": "Ah! Kamu memasukkannya ke dalam botol misterius!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412140129,
					"content": "Walaupun pedang ini bukan senjata magis lagi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140130
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140130,
					"content": "Ambillah ini sebagai kenang-kenangan. Aku harap pedang ini bisa berguna dalam perjalananmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140131,
						412140132
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140131,
					"content": "Benarkah?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140133
					]
				},
				{
					"id": 412140133,
					"content": "Yang kuinginkan adalah hasil eksperimen yang berkaitan dengannya, dan aku sudah mendapatkan hasil eksperimen itu. Sudah seharusnya pedang ini diberikan kepada kamu yang tahu bagaimana menggunakannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140134
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140134,
					"content": "Terima kasih telah membantuku menyelesaikan penelitian, Pengembara. Sampai jumpa lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140135
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140135,
					"content": "Energi kehidupan naga yang beresonansi denganku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140136
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140136,
					"content": "Penyebabnya bukan karena naga, tapi melainkan karena aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140137
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140137,
					"content": "Guru... Rhinedottir... Inikah ciptaanmu, si naga raksasa Durin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140138
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140138,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140139
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140139,
					"content": "Apakah pertemuanku dengannya adalah hal yang baik?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140132,
					"content": "Kamu tidak memerlukannya lagi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140133
					]
				},
				{
					"id": 412140120,
					"content": "Itu senjata yang tidak bagus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140121
					]
				},
				{
					"id": 412140105,
					"content": "Sesuai janji, aku sudah melakukan apa yang kamu inginkan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140106
					]
				}
			]
		}
	]
}