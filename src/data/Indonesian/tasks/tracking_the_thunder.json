			},
			"dialogs": [
				{
					"id": 726530101,
					"content": "Pengembara, kamu sudah kembali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726530102
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726530102,
					"content": "Aku sudah melihat kristal yang kamu bawa waktu itu ke kapal. Mereka terlihat... \"muda\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726530103
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726530103,
					"content": "Maksudku, mereka berasal dari kristalisasi unsur yang masih baru... Sebagai perbandingan, ini adalah jejak yang sedikit lebih dalam di salju yang tertinggal baru-baru ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726530104
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726530104,
					"content": "Jadi kali ini, aku ingin kamu mencari jejak yang lebih dangkal lagi... dan ikuti mereka sampai ke sumbernya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726530105
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726530105,
					"content": "Saat kubilang \"jejak yang lebih dangkal\", maksudku adalah endapan elemen Electro yang telah mengembun sampai batas tertentu di dekat tanah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726530106
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726530106,
					"content": "Jika kita dapat memperoleh sampel yang cukup untuk perbandingan, kita harusnya bisa menggambar rute umumnya pada peta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726530107
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726530107,
					"content": "Jejak kaki yang lebih dangkal dan lebih dalam... peta rute... Paimon tidak mengerti apa maksudmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726530108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726530108,
					"content": "Cukup rumit ya...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726530109
					]
				},
				{
					"id": 726530109,
					"content": "Yah, mungkin analogiku memang kurang tepat, tapi sepertinya kamu akan mengerti saat sudah tiba di sana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726530110
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726530110,
					"content": "Baiklah, cukup ngobrolnya. Waktunya bergerak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Muzhen"
				}
			]
		}
	]
