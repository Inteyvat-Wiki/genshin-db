				],
				"points": []
			},
			"dialogs": [
				{
					"id": 745190401,
					"content": "Ah ... Honorary Knight! Kamu datang mau cari Master Jean? Atau ... ada sesuatu yang bisa kubantu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745190402,
						745190403
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 745190402,
					"content": "Aku hanya sedang jalan-jalan saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745190404
					]
				},
				{
					"id": 745190404,
					"content": "Aku sedang melakukan pembersihan rutin di area kantor Knights of Favonius. Sebagian besar debunya sudah bersih. Setelah ini aku akan mulai merapikan arsip-arsip lama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745190405
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 745190405,
					"content": "Dokumen-dokumen itu sudah menumpuk cukup lama. Aku pikir kalau bisa mengelompokkan dan mengarsipkan semuanya dengan rapi, orang-orang akan lebih mudah mencarinya nanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745190406
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 745190406,
					"content": "Selain itu, dengan merapikan catatan-catatan yang sebelumnya, aku juga bisa belajar banyak hal. Bagiku, ini juga salah satu bentuk latihan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745190407
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 745190407,
					"content": "Noelle memang sangat rajin dan bisa diandalkan ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745190408
					]
				},
				{
					"id": 745190408,
					"content": "Ini memang tugasku. Selain itu, senior dan semua anggota Knights of Favonius juga terus maju, aku juga mau secepatnya menyusul langkah kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745190409,
						745190410
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 745190409,
					"content": "Kalau begitu, untuk memperingati kerja kerasmu ini ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745190411
					]
				},
				{
					"id": 745190411,
					"content": "Eh? Aku? Aku ... tentu saja mau sekali! Tapi aku baru selesai bersih-bersih, masih ada debu di bajuku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745190412,
						745190413
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 745190412,
					"content": "Aku justru mau foto Noelle yang sedang kerja keras!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745190414
					]
				},
				{
					"id": 745190414,
					"content": "A-Aku masih belum bisa dipanggil begitu! Tapi, kalau mau foto ... aku akan merasa sangat terhormat, meskipun badanku masih penuh debu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745190415
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 745190415,
					"content": "Kalau begitu, silakan ambil saja fotonya kalau kalian rasa momennya tepat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Noelle"
				},
				{
					"id": 745190413,
					"content": "Ini adalah \"momen penting\" untuk seorang Knight Pelayan!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745190414
					]
				},
				{
					"id": 745190410,
					"content": "Biar aku ambil foto kamu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745190411
					]
				},
				{
					"id": 745190403,
					"content": "Kamu lagi sibuk apa, Noelle?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745190404
					]
				}
			]
		}
	]
