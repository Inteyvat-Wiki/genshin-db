			"dialogs": [
				{
					"id": 400740301,
					"content": "Benar-benar sebuah bangunan yang megah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740302
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400740302,
					"content": "Wow ... Aku belum pernah lihat hal seperti ini sebelumnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740303
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400740303,
					"content": "Hei Mona, alam fantasimu hebat banget!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740304
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400740304,
					"content": "Ya, meski tidak semegah Immernachtreich, tapi ya keren juga minimal, Nona Megistus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740305
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400740305,
					"content": "(Fuh, bagus. Untung bukan seperti ruangan jelek yang bisa jadi bulan-bulanan si perempuan lebay ini ... Kalau tidak, mau ditaruh di mana mukaku?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740306
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400740306,
					"content": "Ya, itulah kehebatan alam fantasi yang bisa kamu harapkan dari seorang astrolog jenius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740307
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400740307,
					"content": "Oke, ayo kita mulai eksplorasinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
