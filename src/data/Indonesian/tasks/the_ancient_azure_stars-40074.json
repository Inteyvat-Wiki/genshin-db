			},
			"dialogs": [
				{
					"id": 400740901,
					"content": "Lingkungan sekitar sudah berubah. Ini bukan pantai yang sama dengan pantai saat kita berangkat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740902
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400740902,
					"content": "Kelihatannya seperti pegunungan Mondstadt. Jangan-jangan kita dikirim ke Mondstadt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740903
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400740903,
					"content": "Tapi kita masih dikelilingi oleh laut yang tak berujung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740904
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400740904,
					"content": "Seharusnya ada kolam yang bisa kita akses di sekitar sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740905
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400740905,
					"content": "Lihat, ada di sini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740906
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400740906,
					"content": "Hah? Kok kita tidak bisa masuk?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740907
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400740907,
					"content": "Kayaknya ada yang ngambang di atas air ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740908
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400740908,
					"content": "Ini lukisan? Atau ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740909
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400740909,
					"content": "Sepertinya lukisan ini menunjukkan jalan ke sebuah tempat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740910
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400740910,
					"content": "Dikatakan bahwa Prinzessin akan membimbing pengikut setianya ke lokasi yang telah ditentukan oleh takdir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740911
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400740911,
					"content": "Kok jadi kamu lagi yang memimpin ... Ya sudahlah, siapa pun boleh-boleh saja. Ayo kita cari tempat ini dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
