			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Oz",
					"Mona",
					"Xinyan",
					"Fischl",
					"Kaedehara Kazuha"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400741201,
					"content": "Nona Megistus ... Ini sangat menyedihkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741202
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400741202,
					"content": "Ugh, tolong jangan bilang begitu. Aku jadi malu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741203
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741203,
					"content": "Di saat seperti ini, tindakan nyata lebih berharga daripada cuma kata-kata. Kamu butuh pelukan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741204
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400741204,
					"content": "Tidak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741205
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741205,
					"content": "Itu adalah sebagian dari pengalaman masa laluku, waktu awal-awal saat aku mulai berkecimpung di dunia astrologi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741206
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741206,
					"content": "Tapi sekarang aku sudah jadi seorang ahli. Dan kini pendirianku sudah tidak semudah itu lagi terpengaruh karena mendengarkan kritik dari orang lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741207
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741207,
					"content": "Siapa sangka, bahkan Megistus sang Penyihir Agung telah melalui masa-masa sulit dalam karirnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741208
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400741208,
					"content": "Pasti sulit untuk menjalani hidup dalam bayang-bayang kesalahpahaman ... Syukurlah, akhirnya kamu sanggup melepaskannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741209
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400741209,
					"content": "Sebenarnya, banyak dari mereka yang akhirnya menyerah dari astrologi karena tidak tahan dengan hal ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741210
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741210,
					"content": "Tapi aku seorang yang jenius. Jadi aku pasti bisa melakukan hal yang orang lain tidak bisa lakukan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741211
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741211,
					"content": "Benar-benar menginspirasi deh rasanya bisa dengar kamu ngomong begitu di tempat semegah ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741212,
						400741213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400741212,
					"content": "Mona, kamu memang panutan!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400741214
					]
				},
				{
					"id": 400741214,
					"content": "Bagus, bagus, memuji aku terus tidak dilarang kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741215
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741215,
					"content": "Uhm ... maaf mengganggu, tapi pintunya ke arah sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741216
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400741216,
					"content": "Baiklah, akan kuberi kalian kesempatan untuk memujiku lagi setelah masalahnya terselesaikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741213,
					"content": "Aku tahu Mona memang benar-benar jenius!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400741214
					]
				}
			]
		}
	]
}