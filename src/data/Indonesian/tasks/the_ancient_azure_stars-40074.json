			"dialogs": [
				{
					"id": 400741101,
					"content": "Semuanya, kumpul di sini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741102
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400741102,
					"content": "Kalian semua sudah bangun? Barusan Mona bilang kalau ada hal penting yang mau dia sampaikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741103
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400741103,
					"content": "Fajar pertama yang berkilauan setelah kembalinya Immernachtreich pasti bisa membangkitkan semangat terdalam seseorang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741104
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400741104,
					"content": "Maksud Nona adalah, dia sudah siap dengan tantangan berikutnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741105
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400741105,
					"content": "Iya, kami juga sudah istirahat cukup dan sudah siap!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400741106,
					"content": "Okelah. Kalau begitu aku akan langsung ke intinya ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741107
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741107,
					"content": "Aku baru saja menerawang kaca ramalannya, dan yang kulihat adalah ada sebuah alam fantasi baru yang terbentuk di pulau sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741108
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741108,
					"content": "Dan ... firasatku bilang kalau ini adalah fatamorganaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741109
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741109,
					"content": "Jadi kali ini giliran Mona ya. Mona kan sudah menemani kita semua ke semua alam fantasi-alam fantasi sebelumnya. Sekarang giliran kami yang berkunjung ke alam fantasi punyamu buat lihat-lihat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741110
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400741110,
					"content": "Ugh ... tidak ada pemandangan yang gimana-gimana kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741111
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741111,
					"content": "Nona Megistus, apakah kamu merasa malu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741112
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400741112,
					"content": "Tidak, tentunya bukan itu maksudku dong. Haha, aku tidak keberatan kalau kalian semua melihat alam fantasi punyaku yang buruk rupa dan akhirnya menilaiku secara berbeda gara-gara itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741113
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741113,
					"content": "Kamu bilang \"tidak\" tapi kok malah jadi seperti \"iya\" tapi kamu tidak mau mengakuinya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741114
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400741114,
					"content": "Astrolog biasanya dianggap hebat kayak gimana gitu, kan ... jadinya aku sempat khawatir kalau alam fantasi milikku ternyata tidak seperti itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741115
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741115,
					"content": "Tidak perlu khawatir. Sebagai Prinzessin, aku tidak bodoh sampai harus berprasangka soal bagaimana fantasimu itu muncul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741116
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400741116,
					"content": "Iya, aku juga sama. Bukannya aku tidak punya harapan apa-apa denganmu juga sih. Tapi menurutku, Mona ... kamu itu sudah sukses kok jadi orang yang mengesankan, dan kamu cukup jadi dirimu sendiri saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741117
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400741117,
					"content": "Aku rasa itu merupakan hal yang indah kalau orang sebaik Mona punya alam fantasi baik juga yang melambangkan hatinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741118
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400741118,
					"content": "Iya, lagian kita ke sana juga kan bukan cuma buat lihat-lihat. Ada tujuan lain juga, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741119,
						400741120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400741119,
					"content": "Ya. Bisa jadi ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400741121
					]
				},
				{
					"id": 400741121,
					"content": "Begitu ya? Baiklah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741122
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741122,
					"content": "Kalau kalian tidak berharap yang gimana-gimana sih aku juga tidak terlalu grogi. Baiklah, ayo kita berangkat kalau gitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741120,
					"content": "Kita bisa cari petunjuk buat menyelesaikan fenomena aneh ini di sana.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400741121
					]
				}
			]
		},
		{
			"id": 4007412,
			"completionStepIds": [
				4007412
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
