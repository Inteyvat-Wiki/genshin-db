			"trigger": {
				"objectNames": [
					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414210101,
					"content": "Halo, Pengembara. Bagaimana kabarmu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 414210102,
					"content": "Apa terjadi sesuatu yang aneh lagi, Katheryne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210103,
					"content": "Dibandingkan dengan peristiwa besar sebelumnya, kejadian ini bukan hal yang aneh. Hanya saja karena ini berkaitan dengan perekonomian Mondstadt, jadi cukup memusingkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210104,
						414210105
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 414210104,
					"content": "Kejadian apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414210106
					]
				},
				{
					"id": 414210106,
					"content": "Baru-baru ini, air di dekat Dawn Winery menjadi pahit tanpa sebab. Jika hal ini dibiarkan, industri anggur Mondstadt mungkin akan hancur hanya dalam beberapa tahun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210107
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 414210107,
					"content": "Untuk rincian masalahnya, silakan bicara pada Connor di Dawn Winery.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 414210105,
					"content": "Perekonomian Mondstadt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414210106
					]
				}
			]
		},
		{
			"id": 4142102,
			"completionStepIds": [
				4142102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
