			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 414210501,
					"content": "Lihat, ada yang jatuh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210502,
					"content": "Endora... tidak ada air... sekarat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210503
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210503,
					"content": "Endora... apa itu namamu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210504,
					"content": "Pahit... itu musuh. Itu akan membunuh... Endora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210505
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210505,
					"content": "Jadi, em, bagaimana caranya untuk menolongmu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210506,
					"content": "Harus pergi... ke air bersih. Pergi ke... mata air.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210507
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210507,
					"content": "Endora... butuh air untuk bergerak. Tidak ada air. Tidak bisa pergi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210508
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210508,
					"content": "Bagaimana caranya kita membawa dia ke sumber mata air?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210509,
					"content": "Ada sebuah botol air di sini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414210510
					]
				},
				{
					"id": 414210510,
					"content": "Tapi rasanya pahit juga, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210511,
					"content": "Endora... bisa bertahan. Tapi... tidak lama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210512
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210512,
					"content": "Hm, sepertinya kita tidak bisa buang waktu lagi. Ayo, kita pergi ke sumber mata air!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210513,
					"content": "Tapi menarik juga ya dia bisa bepergian sejauh ini dengan menumpang di belakang Hydro Slime. Hubungan mereka kurang lebih mirip dengan kita, ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4142106,
			"completionStepIds": [
				4142106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
