			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 414210601,
					"content": "Di sini... airnya manis. Endora menemukan... spesies yang sama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210602
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210602,
					"content": "Endora dan... spesies yang sama, membuat air layak untuk diminum. Yang pahit... akibat Rhodeia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210603
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210603,
					"content": "Spesies yang sama? Oh, benar juga, bukannya Springvale punya legenda tentang peri mata air ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210604,
					"content": "Tapi hal pertama yang harus kita lakukan adalah, kita harus segera membuang air pahit di botol dan menggantinya dengan air dari mata air.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4142107,
			"completionStepIds": [
				4142107
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4142107",
							"2"
						],
						"stepId": 4142107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Old Finch"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414210701,
					"content": "...Kamu siapa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210702
					],
					"speakerTitle": "Old Finch"
				},
				{
					"id": 414210702,
					"content": "Wahhh, tunggu, Endora, kamu tidak boleh pergi sendirian begitu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210703,
					"content": "Aku Endora. Aku peri mata air.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210704
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210704,
					"content": "Tunggu, benar juga! Orang ini salah satu yang percaya dengan keberadaan peri mata air.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210705,
					"content": "...Ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210706
					],
					"speakerTitle": "Old Finch"
				},
				{
					"id": 414210706,
					"content": "Kamu benar-benar seperti dia. Hanya saja terlihat lebih kecil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210707
					],
					"speakerTitle": "Old Finch"
				},
				{
					"id": 414210707,
					"content": "Endora... masih muda! Endora... masih belajar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210708
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210708,
					"content": "Tapi setidaknya kehadiranmu telah membuktikan bahwa dia itu nyata, dia bukanlah mimpi belaka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210709
					],
					"speakerTitle": "Old Finch"
				},
				{
					"id": 414210709,
					"content": "Dia masih ada di sini. Namanya... tidak tahu. Dia tidak mau menjawab Endora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210710
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210710,
					"content": "Endora... mau bicara dengannya. Bisa menyampaikan pesan. Kamu mau bicara apa padanya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210711
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210711,
					"content": "Maksudmu, dia selalu ada di sini? Dan kamu bisa membantuku menyampaikan pesanku padanya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210712
					],
					"speakerTitle": "Old Finch"
				},
				{
					"id": 414210712,
					"content": "Benar, benar.",
					"roleType": "TALK_ROLE_NPC",
