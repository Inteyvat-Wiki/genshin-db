					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414211006
					]
				},
				{
					"id": 414211006,
					"content": "Endora masih harus banyak belajar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414211007
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414211007,
					"content": "Emosi Rhodeia belakangan ini sangat buruk. Masalahnya mungkin selesai kalau kita bisa menemuinya langsung.",
