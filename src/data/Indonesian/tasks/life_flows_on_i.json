				},
				{
					"id": 414211003,
					"content": "Setelah bersatu dengan Purewater Creature, kosakata Endora bertambah. Sekarang Endora bisa menyampaikan pesan dari Springvale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414211004
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414211004,
					"content": "\"Hidup akan terus mengalir bagaikan air\", sedikit menyedihkan. Tidak mengerti puisi. Tidak mengerti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414211005
					],
					"speakerTitle": "Endora"
				},
				{
