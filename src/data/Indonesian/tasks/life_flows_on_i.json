				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Connor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414210201,
					"content": "Apa kamu orang yang diutus oleh Adventurers' Guild?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210202
					],
					"speakerTitle": "Connor"
				},
				{
					"id": 414210202,
					"content": "Benar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210203,
					"content": "Akhirnya aku bisa bernapas lega. Mengenai masalah ini... daripada mendengar penjelasanku, lebih baik kalian pergi merasakannya sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210204
					],
					"speakerTitle": "Connor"
				},
				{
					"id": 414210204,
					"content": "Air di botol ini diambil dari dekat sini. Air ini telah melalui semua proses pemurnian air dan benar-benar bersih. Silakan dicoba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210205
					],
					"speakerTitle": "Connor"
				},
				{
					"id": 414210205,
					"content": "Oh, oh, Paimon juga mau. Paimon mau coba!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210206,
					"content": "(mencicipi seteguk...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414210207
					]
				},
				{
					"id": 414210207,
					"content": "Ehhhh! Puahh! Ini pahit sekali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210208,
					"content": "Kepahitan ini tidak dapat dihilangkan melalui proses pemurnian tradisional, jadi masalahnya bukan berasal dari komposisi airnya. Aku curiga ini fenomena yang disebabkan oleh kekuatan elemental.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210209
					],
					"speakerTitle": "Connor"
				},
				{
					"id": 414210209,
					"content": "Karena itu, air ini sama sekali tidak bisa digunakan untuk membuat anggur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210210
					],
					"speakerTitle": "Connor"
				},
				{
					"id": 414210210,
					"content": "Ikan di sana pasti kesulitan untuk bertahan hidup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210211,
					"content": "Kami sudah mencoba memasak ikan yang mati karena air pahit itu. Semua terasa pahit saat sudah dimasak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210212
					],
					"speakerTitle": "Connor"
				},
				{
					"id": 414210212,
					"content": "Paimon... tidak menyangka bisa separah itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210213,
					"content": "Jadi intinya begitu. Jika kamu mencari petunjuk penyelidikan, naluriku mengatakan bahwa kamu harus pergi ke utara untuk menyelidikinya. Aku penasaran, apa air Bishui River di Liyue dan Desa Qingce juga terkena dampaknya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Connor"
				}
			]
		},
		{
			"id": 4142105,
			"completionStepIds": [
				4142105
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
