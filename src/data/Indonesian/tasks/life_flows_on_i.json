					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210713,
					"content": "...Ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210714
					],
					"speakerTitle": "Old Finch"
				},
				{
					"id": 414210714,
					"content": "Aku sudah tua. Aku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210715
					],
					"speakerTitle": "Old Finch"
				},
				{
					"id": 414210715,
					"content": "...Katakan padanya aku mengatakan halo.",
