					"nextDialogs": [
						414210802
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210802,
					"content": "Dia mengatakan... sesuatu yang aneh. Endora tak paham.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210803
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210803,
					"content": "Alir, aliran... hmm? Endora tak paham. Ditanya, tak menjawab.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210804
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210804,
					"content": "Kosakatanya sepertinya belum begitu banyak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414210805
					]
				},
				{
					"id": 414210805,
					"content": "Sepertinya peri mata air itu punya alasan sendiri jadi tidak mau bertemu dengan kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210806,
					"content": "Endora tidak mengerti... Peri mata air senang berbaur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210807
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210807,
					"content": "Dia... seorang diri, sendiri saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210808
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210808,
					"content": "Sepertinya karena makhluk lain tidak bisa berbaur begitu saja dengan kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210809,
					"content": "Oh? Memang kenapa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210810
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210810,
					"content": "Kalau tidak nanti mereka tenggelam di dalam tubuhmu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210811,
					"content": "Kalian sangat kesepian dong... Kami cinta semua... kami cinta semuanya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210812
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210812,
					"content": "Ah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210813
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210813,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210814
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210814,
					"content": "Tatapan Rhodeia... di dekat Stone Gate! Makhluk air kecil. Itu mata-matanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210815
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210815,
					"content": "Makhluk air? Tadi kita juga melihat beberapa Purewater Creature di sekitar sini, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210816,
						414210817
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210816,
					"content": "Sepertinya begitu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414210818
					]
				},
				{
					"id": 414210818,
					"content": "Kekuatan air yang kuat... berubah menjadi hewan. Sangat bahaya. Tapi menyatu dengan mereka... kami banyak belajar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210819
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210819,
					"content": "Bawa aku ke sana. Rhodeia merasa terganggu. Rhodeia... membuat airnya pahit. Endora akan belajar bicara. Menjelaskan padanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210820
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210820,
					"content": "Maksudmu, kamu bisa membantu kami?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414210821
					]
				},
				{
					"id": 414210821,
					"content": "Benar, benar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210822
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210822,
					"content": "#{NICKNAME}, Paimon rasa kita bisa mencobanya. Kita tidak ada petunjuk lain lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210817,
					"content": "Oh ya? Aku tak ingat tuh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414210818
					]
				}
			]
		},
