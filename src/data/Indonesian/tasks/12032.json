			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Raiden Shogun",
					"Yae Miko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120320101,
					"content": "Masih banyak tantangan yang menanti di Inazuma, tapi aku siap menghadapinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320102,
						120320107,
						120320112,
						120320117,
						120320122,
						120320128
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 120320102,
					"content": "Tentang tantangan ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120320103
					]
				},
				{
					"id": 120320103,
					"content": "Penghapusan Dekrit Sakoku menyebabkan segudang masalah yang kompleks. Bodoh sekali kalau beranggapan tidak akan ada dampak negatif yang terjadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320104
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 120320104,
					"content": "Contohnya, aku bisa lihat dunia luar pasti bakal jadi ancaman buat bisnis di Inazuma sini. Ada banyak masalah yang harus segera kuselesaikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320105
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 120320105,
					"content": "Ei, kamu terlalu hati-hati dalam memikirkan segala sesuatunya. Aku sih cuma memikirkan apakah aku bisa jual tiket masuk Kuil Agung Narukami atau tidak di masa depan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320106
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120320106,
					"content": "Miko, kamu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320101
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 120320107,
					"content": "Tentang tatapan para dewa ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120320108
					]
				},
				{
					"id": 120320108,
					"content": "Tatapan Makoto selalu tertuju pada rakyat Inazuma. Aku selalu beranggapan bahwa ... karena itu adalah tugasnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320109
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 120320109,
					"content": "Tapi sekarang aku melihat bahwa tatapannya itu penuh dengan kebahagiaan dan harapan. Itu bukan cuma kewajiban, tapi juga kebahagiaannya. Dia sangat mencintai rakyatnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320110
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 120320110,
					"content": "Jika rakyat di masa lalu layak mendapatkan tatapan dari para dewa, maka begitu pula rakyat masa depan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320111
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120320111,
					"content": "Benar. Aku tidak akan lagi mengabaikan hasrat dan impian mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320101
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 120320112,
					"content": "Tentang duel ratusan tahun ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120320113
					]
				},
				{
					"id": 120320113,
					"content": "Terus terang, itu adalah siksaan terus-menerus tanpa akhir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320114
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 120320114,
					"content": "Berhadapan dengan pertempuran tanpa akhir, aku harus selalu fokus setiap waktu. Jika konsentrasiku buyar walau hanya sekejap, pedang Shogun pasti akan langsung mencabut nyawaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320115
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 120320115,
					"content": "Bisa dibilang, kalau bukan karena pengalaman bertempurku pada masa lalu, kemampuanku pasti tidak akan cukup untuk menghadapi tantangan ini. Aku pasti akan kalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320116
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 120320116,
					"content": "Jadi, ada kerja kerasmu juga ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320101
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 120320117,
					"content": "Tentang kerusakan yang ada di Sacred Sakura ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120320118
					]
				},
				{
					"id": 120320118,
					"content": "Jangan khawatir, aku tidak lupa. Aku pasti akan mengingatkan Tenryou dan Yashiro Commission mengenai hal ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320119
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 120320119,
					"content": "Yang kukhawatirkan bukan cuma soal monster. Aku khawatir tentang hal lain yang keluar dari Sacred Sakura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320120
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 120320120,
					"content": "Oke itu masalah yang cukup serius ... Banyak hal lain yang disimpan di dalam Ley Line selain daripada ingatan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320121
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120320121,
					"content": "Karena kamu jelas tahu soal ini, mungkin kamu juga bisa bantu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320101
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 120320122,
					"content": "Yae Miko bilang dia menaruh—",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120320123
					]
				},
				{
					"id": 120320123,
					"content": "Ehem! Yae Miko tidak bilang apa-apa, dan si Pengembara ini berani sekali ya mengarang kata-kata mengatasnamakan Yae Miko saat dia sendiri sedang ada di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320124
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120320124,
					"content": "Beberapa ucapan sebaiknya jangan disampaikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320125
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120320125,
					"content": "Percayalah, kamu tidak akan mau tahu apa akibatnya kalau berani mengkhianatiku. Anggap saja semua yang kukatakan padamu itu adalah rahasia antara kita berdua. Paham?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320126
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120320126,
					"content": "Kalian sedang membicarakan apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320127
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 120320127,
					"content": "Tidak. Aku tiba-tiba ingin tahu goreng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320101
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120320128,
					"content": "Aku tidak punya pertanyaan lagi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		}
	]
}