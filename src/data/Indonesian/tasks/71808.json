				{
					"id": 718080202,
					"content": "Apa kamu baik-baik saja?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718080203
					]
				},
				{
					"id": 718080203,
					"content": "Apakah kamu datang untuk menyaksikan kebangkitan \"dia\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080204
					],
					"speakerTitle": "Jiu"
				},
				{
					"id": 718080204,
					"content": "Kamu datang terlalu cepat... Tapi tidak terhitung terlambat juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080205
					],
					"speakerTitle": "Jiu"
				},
				{
					"id": 718080205,
					"content": "Dia sedang bicara apa sih, Paimon tidak mengerti sama sekali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718080206,
					"content": "Eh, apa yang sedang kamu bicarakan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718080207
					]
				},
				{
					"id": 718080207,
					"content": "Haha, apa kamu tidak menyadarinya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080208
					],
					"speakerTitle": "Jiu"
				},
				{
					"id": 718080208,
					"content": "Menurutku, begitu juga tidak buruk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080209
					],
					"speakerTitle": "Jiu"
				},
				{
					"id": 718080209,
					"content": "Pulanglah, tunggu sampai \"orang itu\" pulih, kamu akan mengerti segalanya.",
