				},
				{
					"id": 718080302,
					"content": "Jadi, situasi di Mt. Nantianmen...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718080303
					]
				},
				{
					"id": 718080303,
					"content": "Gempa, monster, dan seorang anak kecil... Apakah dia seorang anak hilang?",
