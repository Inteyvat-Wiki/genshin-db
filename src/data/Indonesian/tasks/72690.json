			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fushizome"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726900101,
					"content": "Halo. Hari ini akhirnya tiba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900102
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726900102,
					"content": "Kalian sudah paham betul tentang komposisi pekarangan bunga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900103
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726900103,
					"content": "Sekarang waktunya menguji kemahiran seni merangkai bunga kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900104
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726900104,
					"content": "Eh? Kami sudah paham intinya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726900105,
					"content": "Terus \"ujian\" ya ... Artinya, yang satu ini bakalan lebih susah dari yang lain kan? Duh, Paimon jadi takut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726900106,
					"content": "Kami masih pemula di bidang ikebana.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726900107
					]
				},
				{
					"id": 726900107,
					"content": "Betul, teknik pengolahan bunga memang perlu dilatih untuk waktu yang lama. Tapi perencanaan dan pengaturan letak pekarangan bunga sepenuhnya mengandalkan kesadaran dan inspirasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900108
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726900108,
					"content": "Kalau bicara soal itu, kalian sudah membuktikan bahwa kalian punya bakat yang sangat baik. Kurasa kalian sudah tidak perlu lagi dilatih lewat \"tema bunga\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900109
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726900109,
					"content": "Mungkin lebih tepatnya, bayangan dalam benak kalian sudah terbentuk dengan begitu unik sebagai hasil dari semua perjalanan dan beragam pemandangan yang telah kalian alami selama ini. Dan jujur, ini sama sekali tidak terbayangkan olehku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900110
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726900110,
					"content": "Oh ... gitu yah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726900111,
					"content": "#Iya juga sih. {NICKNAME}, kita kan memang sudah pergi ke banyak tempat dan melihat segala macam hal. Ternyata hal itu juga bisa ngasih kita inspirasi ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726900112,
					"content": "Paimon penasaran, sudah segimana banyak memangnya inspirasi yang kita pakai buat belajar seni ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900113,
						726900114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726900113,
					"content": "Tenang, perjalanan kita masih lanjut.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726900115
					]
				},
				{
					"id": 726900115,
					"content": "Oh, iya juga sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726900116,
					"content": "Terima kasih ya Nona Fushizome! Kalau bukan kamu yang bimbing, mana kami tahu kalau kami punya bakat tersembunyi kayak gini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726900117,
					"content": "Haha, jangan terlalu sungkan begitu. Baiklah, mari kita berikan sentuhan akhir untuk perjalanan ini dengan pekarangan bunga yang paling indah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900118,
						726900122
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726900118,
					"content": "Baik, silakan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726900119
					]
				},
				{
					"id": 726900119,
					"content": "Tema kita hari ini adalah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900120
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726900120,
					"content": "\"Bak pelangi lengkung cabang-cabangnya, campuran warna-warni hiasi keindahannya\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900121
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726900121,
					"content": "Nah, aku menantikan karya terbaik kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726900122,
					"content": "Aku masih ada urusan ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726900123
					]
				},
				{
					"id": 726900123,
					"content": "Tidak apa. Ikebana perlu konsentrasi penuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900124
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726900124,
					"content": "Selesaikan dulu saja semua urusan yang ada. Nanti kalau sudah bisa fokus sepenuhnya, aku yakin hasil pekarangan bunga kalian juga akan sempurna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726900114,
					"content": "Kita tidak bakal kehabisan inspirasi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726900115
					]
				}
			]
		},
		{
			"id": 7269003,
