				"points": []
			},
			"dialogs": [
				{
					"id": 706590301,
					"content": "Heh. Oke, kamu sudah dengar cukup banyak dariku — jadi kamu sebaiknya mencobanya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590302,
						706590303
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706590302,
					"content": "Mainkan Jejak Sang Angin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 706590303,
					"content": "Pergi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706590304
					]
				},
				{
					"id": 706590304,
					"content": "Baiklah, jika kamu tertarik untuk mencobanya, cari saja aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gygax"
				}
			]
		}
	]
