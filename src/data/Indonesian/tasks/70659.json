			"trigger": {
				"objectNames": [
					"Gygax"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706590101,
					"content": "Hei, apa kamu mau mencoba permainan \"Jejak Sang Angin\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590102
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706590102,
					"content": "Apa itu Jejak Sang Angin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706590103
					]
				},
				{
					"id": 706590103,
					"content": "Jejak Sang Angin adalah sebuah permainan tentang sejarah Mondstadt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590104
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706590104,
					"content": "Kamu mungkin pernah dengar tentang aristokrat yang dulu hidup di kota Mondstadt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590105
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706590105,
					"content": "Mereka benar-benar kejam. Bahkan kata-kata saja tidak cukup untuk menggambarkan tindakan mereka yang membuat banyak orang menderita...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590106
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706590106,
					"content": "Untuk melawan para tiran, sekelompok warga yang berani akhirnya bergabung dan membentuk sebuah organisasi perlawanan rahasia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590107
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706590107,
					"content": "Para pahlawan pembela kebenaran dan keadilan ini pun bertindak. Mereka menjadi duri di sisi para aristokrat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590108
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706590108,
					"content": "Tapi para aristokrat juga melawan dengan melatih pasukan mereka untuk menekan para pemberontak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590109
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706590109,
					"content": "Lalu, para pemberontak bertarung dengan pasukan aristokrat di seluruh penjuru kota.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590110
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706590110,
					"content": "Jejak Sang Angin terinspirasi dari cerita sejarah Mondstadt yang luar biasa ini! Dulu ini cukup populer loh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590111
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706590111,
					"content": "Dulu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706590112
					]
				},
				{
					"id": 706590112,
					"content": "Iya. Orang-orang muda zaman sekarang sepertinya tidak tertarik dengan permainan ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590113
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706590113,
					"content": "Tapi aku tidak bisa membiarkan permainan Jejak Sang Angin hilang begitu saja. Jadi, aku merubah sedikit peraturannya untuk membuatnya lebih mudah dan menarik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590114
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706590114,
					"content": "Aku juga menambahkan peta baru di dalamnya. Kuharap dengan begini, aku bisa membujuk lebih banyak orang untuk bermain...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gygax"
				}
			]
		},
		{
			"id": 7065903,
