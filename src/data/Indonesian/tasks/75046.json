					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460807
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460807,
					"content": "Orang asing baik hati, apa kalian lihat Tatankasaurus kecil-kecil di sekitar sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460808
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460808,
					"content": "Tampangnya gimana ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750460809
					]
				},
				{
					"id": 750460809,
					"content": "Delapan Tatankasaurus kecil yang aku besarkan. Mereka sudah kuanggap anak sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460810
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460810,
					"content": "Dia salah satu Saurian tercantik di seluruh suku Berlimpah Jaya, bahkan pernah menang juara satu di lomba kecantikan daerah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460811
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460811,
					"content": "Delapan anak nakal ini mewarisi kecantikan ibunya, kulit putih dan merah muda, ada seberkas ungu di sudut tanduknya yang berbentuk kipas sempurna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460812
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460812,
					"content": "Kalau ketemu, tolong bantu bawa mereka kembali ke sini. Tolong ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460813
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460813,
					"content": "Saurian-saurian kecilku ... Aku janji tidak akan galak-galak lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460814
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460814,
					"content": "Ada nih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750460815
					]
				},
				{
					"id": 750460815,
					"content": "Terima kasih, orang baik. Untung mereka tidak apa-apa. Aku khawatir sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460816
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460816,
					"content": "Tapi masih ada yang belum ketemu. Kalau boleh, kalau boleh tolonggg bantu cari lagi sisanya. Dan antarkan kemari kalau ketemu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Urubamba"
				}
			]
		}
	]
}