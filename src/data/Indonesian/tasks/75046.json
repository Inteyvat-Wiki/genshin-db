					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460414,
					"content": "Sudah pulang semua.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750460415
					]
				},
				{
					"id": 750460415,
					"content": "Kamu yang bawa mereka pulang? Terima kasih banyak! Silakan ambil saja barang yang ada di dalam peti ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460416
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460416,
					"content": "Aku mau lihat mereka sekarang. Oh, anak-anak Saurian-ku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460417
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460417,
					"content": "Sekarang aku bisa fokus jadi pelatih lagi. Oh iya, cari aku ya kalau kamu tertarik ikut Tantangan Pejuang!",
					"roleType": "TALK_ROLE_NPC",
