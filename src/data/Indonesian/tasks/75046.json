			},
			"dialogs": [
				{
					"id": 750460101,
					"content": "Yuhuuu ... Anak-anak, ayo pulang! Yuhuuu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460102
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460102,
					"content": "Halo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750460103
					]
				},
				{
					"id": 750460103,
					"content": "Yuhuuuuuu ... *huff*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460104
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460104,
					"content": "Aduh ... Aduduh ... Gimana ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460105
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460105,
					"content": "Padahal cuma keluar beli jerami sebentar, tapi mereka malah entah ke mana semua ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460106
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460106,
					"content": "Mereka masih kecil! Gimana kalau ditindas Hilichurl di jalan ... atau tersesat ... atau terjebak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460107
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460107,
					"content": "Orang asing baik hati, apa kalian lihat Tatankasaurus kecil-kecil di sekitar sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460108
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460108,
					"content": "Tampangnya gimana ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750460109
					]
				},
				{
					"id": 750460109,
					"content": "Delapan Tatankasaurus kecil yang aku besarkan. Mereka sudah kuanggap anak sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460110
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460110,
					"content": "Dia salah satu Saurian tercantik di seluruh suku Berlimpah Jaya, bahkan pernah menang juara satu di lomba kecantikan daerah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460111
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460111,
					"content": "Delapan anak nakal ini mewarisi kecantikan ibunya, kulit putih dan merah muda, ada seberkas ungu di sudut tanduknya yang berbentuk kipas sempurna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460112
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460112,
					"content": "Kalau ketemu, tolong bantu bawa mereka kembali ke sini. Tolong ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460113
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460113,
					"content": "Saurian-saurian kecilku ... Aku janji tidak akan galak-galak lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460118
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460118,
					"content": "Nanti aku bantu lihat-lihat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750460119
					]
				},
				{
					"id": 750460119,
					"content": "Terima kasih, orang asing baik hati. Semoga kamu bisa cetak rekor baru dalam angkat beban dan tidak kram saat olahraga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Urubamba"
				}
			]
		},
