					"nextDialogs": [
						411311103
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411311103,
					"content": "Di waktu seperti ini, aku juga tidak bisa segera menemukan orang untuk menjadi pengawalku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411311104
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411311104,
					"content": "Tapi aku belum menyerah! Meskipun aku tidak bisa mendapatkan batu meteorit itu, aku tidak akan melewatkan kesempatan bisnis ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411311105
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411311105,
					"content": "Pengembara, aku tidak akan mengambil batu meteorit itu lagi, tetapi aku membutuhkan bantuanmu untuk hal yang lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411311106
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411311106,
					"content": "Kalau batu meteorit itu benar-benar hebat... Eh, bahaya. Sampai bisa membuat orang yang menyentuhnya langsung tertidur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411311107
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411311107,
					"content": "Kalau begitu, batu meteorit itu juga seharusnya mempunyai dampak ke lingkungan sekitarnya saat dia jatuh .",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411311108
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411311108,
					"content": "Pengembara, bolehkah kamu pergi ke daerah sekitar jatuhnya meteorit itu? Bantu aku ambilkan bunga-bunga atau rerumputan dari situ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411311109,
						411311111
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411311109,
					"content": "Baik, aku mengerti...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411311110
					]
				},
				{
					"id": 411311110,
					"content": "Mohon bantuannya ya. Aku tidak akan melewatkan kesempatan bisnis sebesar ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411311111,
					"content": "Memang benar-benar seorang pedagang sejati...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411311112
					]
				},
				{
					"id": 411311112,
					"content": "Hahaha, terima kasih atas pujiannya. Kutunggu hasilnya ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ivanovich"
				}
			]
