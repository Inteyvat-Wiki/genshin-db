					"nextDialogs": [
						411311303
					]
				},
				{
					"id": 411311303,
					"content": "Bagus sekali! Coba kulihat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411311304
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411311304,
					"content": "Wah, Sweet Flower segar, boleh juga. Sepertinya bunga ini menjadi sedikit abnormal setelah terkena efek dari meteorit itu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411311305,
					"content": "Bunga ini sepertinya bermasalah...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411311306
					]
				},
				{
					"id": 411311306,
					"content": "Bermasalah? Masalah apa maksudmu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411311307
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411311307,
					"content": "Kalian diserang saat sedang mengumpulkan bunga? Diserang oleh bunga?! Memangnya ada bunga yang bisa menyerang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411311308
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411311308,
					"content": "Aha! Pasti ini dampak dari batu meteorit itu. Hanya ini penjelasan kenapa bunga-bunga ini menjadi spesial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411311309
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411311309,
					"content": "Sepertinya tidak ada hubungannya...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411311310
					]
				},
				{
					"id": 411311310,
					"content": "Iya betul... Mana ada hubungannya bunga dengan meteorit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411311311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411311311,
					"content": "Tidak, tidak, tidak. Kalian harus memercayaiku. Pasti ada sesuatu yang istimewa di bunga ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411311312
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411311312,
					"content": "Tapi tidak ada yang spesial dengan bunga itu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411311313
					]
				},
				{
					"id": 411311313,
					"content": "Salah, sahabatku, kamu salah. Bunga ini sudah berada di dekat batu meteorit sedemikian lama, pasti ada sesuatu yang spesial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411311314
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411311314,
					"content": "Tapi kalau dilihat dan dicium baunya, sepertinya Sweet Flower ini tidak ada bedanya dengan Sweet Flower biasa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411311315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411311315,
					"content": "Hmmm, kalau itu... tidak perlu kalian pikirkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411311316
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411311316,
					"content": "Ini hadiah imbalanmu sesuai janjiku. Senang bekerja sama denganmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411311317
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411311317,
					"content": "Harus kuapakan Sweet Flower ini ya... Jadikan parfum? Pembatas buku? Atau bunga kering? Sepertinya semuanya bagus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
