			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ivanovich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411310301,
					"content": "Orang lain pasti juga memiliki ide yang sama...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310302
					]
				},
				{
					"id": 411310302,
					"content": "Ya, tentu saja. Maka dari itu kita harus bergerak cepat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310303
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310303,
					"content": "Pengembara, kalau kamu sudah setuju, ayo kita segera berangkat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310304
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310304,
					"content": "Setiap banyak waktu yang kita habiskan dengan berdebat, semakin banyak juga Mora yang hilang dari genggaman kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310305
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310305,
					"content": "Wah, kalau sudah begini sih... Sepertinya dia sudah tidak bisa dibujuk lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411310306,
					"content": "Mungkin kita bisa meyakinkan dia kalau bisnisnya pasti gagal... atau kalau batu meteorit itu berbahaya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4113104,
			"completionStepIds": [
