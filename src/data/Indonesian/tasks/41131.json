	"talks": [
		{
			"id": 4113101,
			"completionStepIds": [
				4113122
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4113101",
							"2"
						],
						"stepId": 4113101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ivanovich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411310101,
					"content": "Hmmm... boleh juga. Bisnis ini sepertinya bisa menghasilkan cukup banyak uang, tapi ada sedikit masalah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310102
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310102,
					"content": "Masalah apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310103
					]
				},
				{
					"id": 411310103,
					"content": "Eh? Oh, ternyata kamu, Pengembara! Kamu datang di saat yang tepat sekali. Apakah kamu tertarik dengan... dengan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310107
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310107,
					"content": "... sebuah bisnis yang ajaib, hebat, inovatif dan pasti membuatmu untung besar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310108
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310108,
					"content": "Aku hanya butuh sedikit bantuanmu. Kita berdua akan mendapatkan keuntungan yang sangat besar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310104,
						411310109
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310104,
					"content": "Penjagaan Northland Bank sangat ketat loh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310105
					]
				},
				{
					"id": 411310105,
					"content": "Ya, tentu saja, semua penjaga di sana adalah orang Snezhnaya sendiri, aku... Eh, bukan! Apa yang sedang kamu pikirkan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310106
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310106,
					"content": "Sepertinya pikiranmu sangat luas karena kamu telah mengunjungi banyak tempat di dunia ya. Daya imajinasimu sangat tinggi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310112
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310112,
					"content": "Terlebih lagi, ide bisnisku ini sangat realistis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310113
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310113,
					"content": "Apakah kamu sudah melihat batu-batu meteorit yang jatuh dari langit itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310114
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310114,
					"content": "Aku ingin mencari satu batu meteorit tersebut dan mengambil satu pecahan batu kecil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310115
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310115,
					"content": "Kemudian kita bisa meminta seorang penempa untuk membuatnya menjadi perhiasan dan pajangan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310116
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310116,
					"content": "Bayangkan saja benda-benda yang terbuat dari meteorit... Mau itu cincin, kalung, gelang atau anting, pasti akan terjual dengan harga tinggi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310117
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310117,
					"content": "Tugasmu sangatlah mudah, Pengembara. Kamu hanya perlu memastikan kalau aku tidak diganggu oleh monster.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310118
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310118,
					"content": "Bagaimana? Apakah kita berdua sudah sepakat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310119
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310119,
					"content": "Meteorit itu tidak boleh didekati.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310120
					]
				},
				{
					"id": 411310120,
					"content": "Apa? Kenapa begitu? Kita tidak boleh melewatkan kesempatan bisnis sebesar ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310109,
					"content": "Apa kamu menemukan sesuatu di kode hukum Liyue?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310110
					]
				},
				{
					"id": 411310110,
					"content": "Em, sejujurnya, kode hukum Liyue ditulis dengan sangat terperinci. Sulit sekali mencari celah di dalamnya, tapi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310111
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310111,
					"content": "*uhuk* Tidak, tidak! Hal yang kulakukan ini tidak ilegal kok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310106
					],
					"speakerTitle": "Ivanovich"
				}
			]
		},
