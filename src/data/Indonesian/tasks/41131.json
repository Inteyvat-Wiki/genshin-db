				"objectNames": [
					"Ivanovich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411310401,
					"content": "Kamu akan pingsan kalau memegang meteorit itu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310402
					]
				},
				{
					"id": 411310402,
					"content": "Hah? Oh, aku juga sudah dengar gosipnya. Hal itu memang bisa menjadi masalah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310403
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310403,
					"content": "Tapi aku yakin pasti ada sebuah alat untuk mengatasi masalah itu... ada kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310404
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310404,
					"content": "Heee, dia sepertinya mulai goyah. Sepertinya... dia sedang menimbang-nimbang untung rugi dari bisnis nya ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411310405,
					"content": "Begini saja kita membujuknya, katakan padanya kalau bisnisnya tidak akan bisa untung. Lalu... meteorit-meteorit itu juga super berbahaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
