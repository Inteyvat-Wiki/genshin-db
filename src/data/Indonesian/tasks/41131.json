				{
					"id": 411310201,
					"content": "Di sana ada banyak monster buas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310202
					]
				},
				{
					"id": 411310202,
					"content": "Justru karena itu aku membutuhkan bantuanmu, Pengembara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ivanovich"
				}
			]
		},
		{
