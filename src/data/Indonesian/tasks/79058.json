			"dialogs": [
				{
					"id": 790580101,
					"content": "Ini adalah lokasi yang ditinggalkan dari adegan singkat \"Pelarian Luar Biasa\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790580102
					],
					"speakerTitle": "Catatan Studio"
				},
				{
					"id": 790580102,
					"content": "Kisah ini awalnya menceritakan tentang Hydro Eidolon yang terperangkap di gua misterius, yang hanya bisa melarikan diri dengan menggunakan peralatan menggali yang tersembunyi di dalam buku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790580103
					],
					"speakerTitle": "Catatan Studio"
				},
				{
					"id": 790580103,
					"content": "Tapi idenya langsung ditolak oleh Nona Idyia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790580104
					],
					"speakerTitle": "Catatan Studio"
				},
				{
					"id": 790580104,
					"content": "Benar juga, Hydro Eidolon bisa keluar dari gua tanpa mengandalkan peralatan. Desain peralatan yang harus disembunyikan di dalam buku juga agak aneh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790580105
					],
					"speakerTitle": "Catatan Studio"
				},
				{
					"id": 790580105,
					"content": "Ta-tapi ini benar-benar ide bagus yang bisa populer. Andai saja aku bisa menunjukkan pemikiranku kepada Nona Idyia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790580106
					],
					"speakerTitle": "Catatan Studio"
				},
				{
					"id": 790580106,
					"content": "Tapi sepertinya kita harus mengambil kembali <color=#00E1FFFF>Buku yang dicuri oleh Hilichurl di sekitar</color> ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790580107
					],
					"speakerTitle": "Catatan Studio"
				},
				{
					"id": 790580107,
					"content": "- Sutradara",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Catatan Studio"
				}
			]
