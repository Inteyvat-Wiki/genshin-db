				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220150101,
					"content": "Sudah mau waktunya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150102
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150102,
					"content": "Ah, selamat datang, apakah Anda menemukan kesulitan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150103
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150103,
					"content": "Ah, ternyata begitu... Kalian... tidak mengalami kesulitan, hanya \"melihat-lihat\" saja ya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150104
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150104,
					"content": "Ini adalah Kantor Detektif Bantan Sango. Aku sendiri... adalah seorang detektif.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150105,
						220150108
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150105,
					"content": "Siapa kamu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150106
					]
				},
				{
					"id": 220150106,
					"content": "Namaku Sango, aku adalah Ketua Detektif di kantor ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150107
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150107,
					"content": "Meski jabatanku Ketua, tapi sebenarnya kantor ini hanya punya 2 anggota saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150113
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150113,
					"content": "Kenapa? Ini pertama kalinya kamu melihat kantor detektif seperti ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150108,
					"content": "Apa pekerjaan seorang detektif?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150109
					]
				},
				{
					"id": 220150109,
					"content": "Oh, pertanyaan bagus. Di mata orang biasa, seorang detektif mungkin terlihat sebagai pekerjaan yang unik dan misterius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150110
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150110,
					"content": "Tapi menurutku, menjadi detektif sebenarnya sama saja seperti pekerjaan lain yang \"dibayar untuk melakukan sesuatu\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150111
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150111,
					"content": "Meskipun kadang-kadang hal yang kita lakukan sedikit tidak biasa, dan orang yang meminta bantuan juga unik...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150112
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150112,
					"content": "Tapi bagaimanapun juga, inti dari pekerjaan kita adalah \"dibayar untuk melakukan sesuatu\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150113
					],
					"speakerTitle": "Sango"
				}
			]
		},
		{
			"id": 2201502,
			"completionStepIds": [
				2201504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
