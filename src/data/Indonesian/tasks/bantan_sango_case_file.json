			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220150205,
					"content": "Ternyata begitu, jadi kamu asisten yang dibilang Ketua ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150206
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150206,
					"content": "Kamu tahu aku akan datang?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150207
					]
				},
				{
					"id": 220150207,
					"content": "Hmm... Sebenarnya tidak sih. Tapi tadi Ketua bilang kalau akan ada orang yang datang membantu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150208
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150208,
					"content": "Hei, lagi apa kalian?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150209
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220150209,
					"content": "Apa itu... Treasure Hoarder? Kenapa mereka bisa dekat sekali dengan kota...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150210
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220150210,
					"content": "Ryuuji, kenapa kamu ada di sini? Lalu orang asing yang mencurigakan ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150211,
						220150213
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220150211,
					"content": "Maksudmu aku?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150212
					]
				},
				{
					"id": 220150212,
					"content": "Tentu saja, memangnya ada orang asing lainnya di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150215
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220150215,
					"content": "Sudah, jangan berprasangka seperti itu. Ryuuji, kamu sendiri sedang apa di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150216
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220150216,
					"content": "Aku mengikuti arahan dari Ketua untuk membuntuti seseorang yang mencurigakan di sini, tapi aku malah bertemu Treasure Hoarder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150217
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150217,
					"content": "Pengembara ini memang asisten yang diutus oleh Ketua, tadi dia membantuku mengusir segerombolan Treasure Hoarder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150218
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150218,
					"content": "Ternyata begitu... Tapi, kenapa bisa ada Treasure Hoarder ya di sekitar sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150219
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220150219,
					"content": "Ryuuji, tadi kamu bilang, kamu membuntuti orang mencurigakan... Eh! Jangan-jangan kamu mengikuti para Treasure Hoarder itu dari dalam kota ke sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150220
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220150220,
					"content": "Benar itu. Kemarin ini Ketua sedang mengurus kasus perampokan berantai. Jadi aku menyelidiki di sekitar kota berdasarkan informasi dari Ketua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150221
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150221,
					"content": "Lalu aku menemukan seseorang yang mencurigakan di dekat Hanamizaka. Tapi aku baru saja menanyakan beberapa pertanyaan, dia langsung pergi dengan panik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150222
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150222,
					"content": "Aku mengejarnya ke luar kota, setelah itu kalian tahu sendiri kelanjutannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150223
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150223,
					"content": "Eh... Ryuuji, kamu kenapa tiba-tiba jadi suka berbicara, dulu kamu bukannya pendiam sekali ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150224
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220150224,
					"content": "Kalau terus bekerja dengan Sango, kemampuan berbicaramu pasti akan terlatih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150225,
						220150228
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220150225,
					"content": "Untuk apa kalian semua datang ke sini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150226
					]
				},
				{
					"id": 220150226,
					"content": "Karena si Andou ini, dia bilang ada orang asing berambut pirang berkeliaran di kota, jadi aku datang untuk melihatnya sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150227
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220150227,
					"content": "Makanya aku datang mengikutimu, ternyata kamu adalah asisten Sango. Maaf ya, ternyata aku salah paham.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150232
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220150232,
					"content": "Ah... Tapi, Ryuuji, tadi katamu kamu bertemu dengan orang mencurigakan itu di dalam kota?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150233
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220150233,
					"content": "Benar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150234
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150234,
					"content": "Berani-beraninya mereka sampai masuk ke dalam kota...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150235
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220150235,
					"content": "Benar sekali. Kalau hanya kami... Kalau hanya kami...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150236,
						220150237
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150236,
					"content": "(Kenapa dia tiba-tiba kesulitan bicara...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150238
					]
				},
				{
					"id": 220150238,
					"content": "Eh... kalau hanya kami, kami hanya bisa melawan satu dua Treasure Hoarder. Kami perlu bantuan kalian kalau mau mengusir mereka semua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150239
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150239,
					"content": "Kalau kalian berdua masih mau mencari buktinya, kalian bisa mencari Ketua di dalam kota, dia akan menjelaskannya pada kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150240
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150240,
					"content": "Begitukah? Kalau begitu, Amano, ayo kita pergi cari Sango. Kalau di dalam kota benar-benar ada Treasure Hoarder yang mengacau, tidak bisa kita biarkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150241
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220150241,
					"content": "Ya... ya! Kalau begitu ayo kita cari Sango. Ryuuji, kalian juga segera kembali ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150242
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220150242,
					"content": "...Fyuh",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150243
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150243,
					"content": "Ayo kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150244
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150244,
					"content": "Kata-katamu tadi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150245
					]
				},
				{
					"id": 220150245,
					"content": "Itu perintah dari Ketua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150246
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150246,
					"content": "Masalahnya sudah beres, kita kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150237,
					"content": "(Kenapa dia seperti lupa mau bicara apa...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150238
					]
				},
				{
					"id": 220150228,
					"content": "Kalian juga datang karena membuntuti orang yang mencurigakan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150229
					]
				},
				{
					"id": 220150229,
					"content": "Bisa dibilang begitu sih, tapi orang mencurigakan yang kami buntuti itu... kamu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150230
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220150230,
					"content": "Karena si Andou ini, dia bilang ada orang asing berambut pirang berkeliaran di kota, jadi aku datang untuk melihatnya sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150231
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220150231,
					"content": "Makanya aku datang mengikutimu, ternyata kamu adalah asisten Sango. Maaf ya, ternyata aku salah paham.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150232
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220150213,
					"content": "Aku asisten Sango.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150214
					]
				},
				{
					"id": 220150214,
					"content": "Asistennya Sango? Malah jadi semakin mencurigakan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150215
					],
					"speakerTitle": "Andou"
				}
			]
		},
		{
