			},
			"dialogs": [
				{
					"id": 220150801,
					"content": "Melihatmu begini, sepertinya kamu tertarik dengan pekerjaan detektif ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150802,
						220150807
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150802,
					"content": "Apa aku bisa jadi detektif juga?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150803
					]
				},
				{
					"id": 220150803,
					"content": "Kamu mau jadi detektif? Detektif itu kerjanya susah loh, jangan tertipu novel-novel itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150804
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150804,
					"content": "Saat kita sedang mengerjakan sebuah kasus, tidak ada pengejaran yang heboh, dan tidak ada pertaruhan hidup dan mati...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150805
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150805,
					"content": "Dokumen-dokumen yang memenuhi satu rumah, jalanan gunung yang tertutup lumpur dan tersangka yang tidak mau membuka mulut... seperti inilah pekerjaan sehari-hari seorang detektif.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150806
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150806,
					"content": "Tapi mungkin kamu tidak mengerti ya kalau kujelaskan saja... Kebetulan aku punya satu kasus kecil, bagaimana kalau kamu merasakan sendiri kerja seorang detektif?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150815
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150815,
					"content": "Asistenku yang satu lagi, Ryuuji, tadi pergi melacak petunjuk di luar sana, tapi sampai sekarang masih belum kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150816
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150816,
					"content": "Sudah lama begini, harusnya dia sudah menemukan cukup petunjuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150817
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150817,
					"content": "Aku mau minta bantuanmu untuk pergi menjemput Ryuuji.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150818,
						220150821
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150818,
					"content": "Jangan-jangan dia dalam bahaya...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150819
					]
				},
				{
					"id": 220150819,
					"content": "Aku sudah memberi tahu dia semuanya. Kalaupun dia menghadapi sesuatu yang tidak terduga, harusnya dia bisa mengatasinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150820
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150820,
					"content": "Yang lebih kukhawatirkan adalah, apa dia bisa mencari barang yang kuminta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150826
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150826,
					"content": "Kalau begitu, masalah ini kuserahkan padamu ya, akan kusiapkan imbalan untukmu kok. Kamu juga sekalian... bisa merasakan jadi seorang detektif kan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150821,
					"content": "Jangan-jangan dia kecelakaan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150822
					]
				},
				{
					"id": 220150822,
					"content": "Harusnya tidak mungkin ada kecelakaan, aku sudah memberi tahu dia semuanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150823
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150823,
					"content": "Andai dia menghadapi sesuatu yang tak terduga pun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150824
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150824,
					"content": "Dengan kemampuannya itu, harusnya bisa dia atasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150825
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150825,
					"content": "Yang lebih kukhawatirkan adalah, apa dia bisa mencari barang yang kuminta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150826
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150807,
					"content": "Sepertinya merepotkan ya...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150808
					]
				},
				{
					"id": 220150808,
					"content": "Tentu saja. Tapi seorang detektif itu adalah \"ahli menyelesaikan hal merepotkan\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150809
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150809,
					"content": "Kejar-kejaran yang sangat heboh, pertaruhan antara hidup dan mati... ini semua hanya ada di novel saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150810
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150810,
					"content": "Dokumen-dokumen yang memenuhi satu rumah, jalanan gunung yang tertutup lumpur dan tersangka yang tidak mau membuka mulut... seperti inilah pekerjaan sehari-hari seorang detektif.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150811
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150811,
					"content": "Tapi ada satu hal yang benar di dalam novel-novel itu, yaitu setiap detektif punya asisten yang bermacam-macam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150812
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150812,
					"content": "Jadi kamu juga punya asisten?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150813
					]
				},
				{
					"id": 220150813,
					"content": "Tentu saja. Tapi asistenku sedang sibuk di luar sana. Jadi sekarang... aku butuh satu asisten lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150814
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150814,
					"content": "Kalau kamu bersedia, kamu mau membantuku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150815
					],
					"speakerTitle": "Sango"
				}
			]
