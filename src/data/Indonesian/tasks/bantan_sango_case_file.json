						220150502
					]
				},
				{
					"id": 220150502,
					"content": "Mondstadt... Oh, maksudmu Kota Mondstadt ya? Aku hanya pernah mendengar saja tentang kota itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150503
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150503,
					"content": "Ada dua hal yang paling terkenal di Mondstadt, yang pertama adalah anggur, dan satunya lagi adalah \"kebebasan\", benar kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150504
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150504,
					"content": "Hahaha, kedua hal ini benar-benar saling melengkapi... Kalau ada detektif di Mondstadt, bisnisnya pasti sukses besar.",
					"roleType": "TALK_ROLE_NPC",
