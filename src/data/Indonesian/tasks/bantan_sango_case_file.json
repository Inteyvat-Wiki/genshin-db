			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sango"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220150301,
					"content": "Kak Sango, apa yang kamu katakan tadi itu benar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150302
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220150302,
					"content": "Kasus pencurian berantai yang terjadi di kota, apa benar ulah para Treasure Hoarder sial itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150303
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220150303,
					"content": "Tentu saja benar. Tadi aku kan sudah memperlihatkan buktinya pada kalian. Menurut \"intuisi profesional\" kalian juga harusnya sudah ketahuan kan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150304
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150304,
					"content": "Berani-beraninya para Treasure Hoarder itu! Mereka meremehkan kita ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150305
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220150305,
					"content": "Amano! Ayo kita kembali dan laporkan hal ini pada para atasan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150306
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220150306,
					"content": "Kita harus memperketat patroli kita, jangan berikan kesempatan bagi mereka untuk mengacau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150307
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220150307,
					"content": "Kak Sango, barang-barang bukti ini boleh pinjamkan dulu ke kita? Kita mau menggunakannya untuk membujuk para atasan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150308
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220150308,
					"content": "Tidak masalah, bawa saja dulu. Masalah besar yang diakibatkan para Treasure Hoarder ini tidak bisa kita atasi sendiri, kita memang harus meminta bantuan dari para petinggi Commission.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150309
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150309,
					"content": "Tenang saja! Para Treasure Hoarder ini... tidak akan kita biarkan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150310
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220150310,
					"content": "Terima kasih ya. Sekarang ini... harusnya sudah hampir siap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150311,
						220150313
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150311,
					"content": "Siap?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150312
					]
				},
				{
					"id": 220150312,
					"content": "Benar. Kedua Doushin dari kantor polisi adalah \"asisten\" penting dalam menutup kasus ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150316
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150316,
					"content": "Setelah kedua Doushin meningkatkan patrolinya, Treasure Hoarder pasti akan waspada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150317
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150317,
					"content": "Ryuuji, seharusnya kamu sempat berinteraksi dengan para Treasure Hoarder itu di tempat yang kuberitahu itu kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150318
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150318,
					"content": "Benar, Ketua, aku dan Pengembara berhasil mengusir Treasure Hoarder itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150319
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150319,
					"content": "Hmm... Baiklah, seharusnya tindakan kalian itu sudah cukup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150320
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150320,
					"content": "Selanjutnya, kita hanya perlu menunggu kesempatan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150321
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150321,
					"content": "Terima kasih ya, Pengembara. Ini hadiah untukmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150322
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150322,
					"content": "Sepertinya aku tidak membantu apa-apa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150323
					]
				},
				{
					"id": 220150323,
					"content": "Jangan bilang begitu. Kamu berhasil menarik perhatian Andou sebagai pendatang asing, lalu Andou membawa Amano mengejarmu dan Ryuuji...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150324
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150324,
					"content": "Setelah itu, mereka melihat ancaman Treasure Hoarder dengan mata kepala mereka sendiri, kita jadi berhasil memperketat patroli di dalam kota.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150325
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150325,
					"content": "Semua ini bisa terjadi karena ada kamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150326
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150326,
					"content": "Lagi pula, daripada aku menyuruh mereka, lebih bagus kalau mereka melihat tindakan Treasure Hoarder itu sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150327
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150327,
					"content": "Yah pokoknya, terima saja barang ini. Siapa tahu aku masih butuh bantuanmu lagi nanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150313,
					"content": "Apa rencanamu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150314
					]
				},
				{
					"id": 220150314,
					"content": "Aku ini seorang detektif, tentu saja aku mau menyelesaikan kasus ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150315
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150315,
					"content": "Kedua Doushin dari kantor polisi adalah \"asisten\" penting dalam menutup kasus ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150316
					],
					"speakerTitle": "Sango"
				}
			]
		},
