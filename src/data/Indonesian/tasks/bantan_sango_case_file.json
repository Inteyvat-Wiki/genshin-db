					"nextDialogs": [
						220150702
					]
				},
				{
					"id": 220150702,
					"content": "Konsultan hukum? Ah... aku pernah dengar, katanya orang seperti ini sangat susah dihadapi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150703
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150703,
					"content": "Menurutku, orang seperti ini paling pandai membuat masalah mudah jadi rumit, masalah rumit akan dirumuskan, dan rumusan masalah akan dijadikan sebuah kontrak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150704
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150704,
