					"Rafiq"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230190101,
					"content": "Ternyata lebih boros kalau begini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190102
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190102,
					"content": "Apa yang sedang kamu katakan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230190103
					]
				},
				{
					"id": 230190103,
					"content": "Ah, halo, aku sedang meneliti tentang masalah desain sebuah kapal. Aku sedang ... menghadapi beberapa kendala.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190104
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190104,
					"content": "Intinya aku mau membuat kapal yang bisa menampung lebih banyak muatan tanpa menaikkan harga jualnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190105
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190105,
					"content": "Kalau beratnya naik, strukturnya akan lebih mudah rusak. Masalah keseimbangan juga akan muncul kalau beratnya tidak seimbang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190106
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190106,
					"content": "Cara terbaik mengatasi hal ini adalah menggunakan material yang lebih baik, tapi ... masalahnya kembali lagi ke biaya produksi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190107
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190107,
					"content": "*huff* Intinya aku tidak punya uang tapi mau membuat sebuah kapal yang bagus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190108
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190108,
					"content": "Jadi aku cuma bisa mengakali hal yang bisa diselesaikan uang dengan beberapa cara teknis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190109
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190109,
					"content": "Apa benar bisa begitu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230190110
					]
				},
				{
					"id": 230190110,
					"content": "Hahaha, mungkin kamu tidak percaya, tapi sebenarnya ada banyak orang yang juga melakukannya sepert ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190111
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190111,
					"content": "Lagi pula kapal yang kami buat tidak akan menghadapi bahaya seperti ombak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190112
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190112,
					"content": "Semua orang berusaha berhemat dan memperbaiki kapal yang rusak ... yang penting bisa dipakai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190113
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190113,
					"content": "Oleh karena itu, bisnis perbaikan kapal kami setiap harinya sangat ramai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190114
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190114,
					"content": "Pengembara, kalau kamu bersedia, tolong periksa kapal yang baru kembali itu, sepertinya kapal itu bermasalah karena sering mengangkut barang berat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190115
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190115,
					"content": "Kebetulan aku sedang meneliti tentang hal ini, siapa tahu bisa dapat inspirasi dengan melihat kapal itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190116,
						230190118
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190116,
					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230190117
					]
				},
				{
					"id": 230190117,
					"content": "Tolong ya! Aku harus segera memperbaiki kapal lain ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190118,
					"content": "Kenapa kamu tidak pergi sendiri?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230190119
					]
				},
				{
					"id": 230190119,
					"content": "Aku juga mau pergi sendiri, tapi aku disuruh perbaiki kapal yang sudah mau dipakai untuk menjaring ikan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190120
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190120,
					"content": "Jadi aku cuma bisa minta tolong padamu, Pengembara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rafiq"
				}
			]
		},
