					"nextDialogs": [
						230190403
					]
				},
				{
					"id": 230190403,
					"content": "Setelah menjelaskan kondisi kapal ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230190404
					]
				},
				{
					"id": 230190404,
					"content": "Ternyata begitu, ada masalah pada beberapa tempat yang tidak diperbaiki dengan benar demi menghemat uang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190405
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190405,
					"content": "Tapi perlu banyak uang untuk memperbaikinya, aku ingat pemilik kapal itu sepertinya uangnya kurang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190406
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190406,
					"content": "*huff* Sebaiknya aku diskusi dengannya, nyawa lebih penting dibandingkan uang ....",
