			"dialogs": [
				{
					"id": 3090201,
					"content": "Fiuh. Selesai juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090202,
					"content": "Nah, harusnya \"aliran Ley Line\" dan \"elemen bla bla bla\" yang tadi Lisa bilang sudah kembali normal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090203,
					"content": "Mau balik? Kita tengok para <color=#00E1FFFF>Knights of Favonius</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090204,
					"content": "Tapi kalau kamu mau lakukan hal yang lebih seru, Paimon ikut!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090205,
					"content": "Misalnya belanja ... atau jalan-jalan ke <color=#00E1FFFF>Patung The Seven</color> lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090206,
					"content": "Waktu ada di dalam kuil Four Winds, kita nemu benda yang mirip ... angin padat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090207,
					"content": "Orang Mondstadt menamakan benda itu \"Anemoculus\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090208,
					"content": "Dikasih nama kayak gitu, soalnya benda itu bisa dipasang ke mata patung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090209,
					"content": "Ada dongeng yang bilang kalau mata patung The Seven itu terbuat dari permata, yang lalu hilang karena dipatuk burung layang-layang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090210,
					"content": "Tapi Anemoculus memang aslinya enggak punya wujud fisik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090212,
					"content": "Para pemegang Vision mengumpulkan Anemoculus, lalu menyerahkan semuanya ke <color=#00E1FFFF>Patung The Seven</color> biar diberkati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090213,
					"content": "Kamu enggak punya Vision, tapi kamu bisa pakai kekuatan elemen. Aturan dunia ini enggak berlaku buat kamu ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090214,
					"content": "Kita coba dulu saja, lihat apa yang terjadi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090215,
					"content": "Patung yang di Windrise paling dekat dari sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090216,
					"content": "Paimon penasaran para dewa bakal kasih apa ke kamu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
