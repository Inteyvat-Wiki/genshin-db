						150480803
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150480803,
					"content": "Ayo tepuk tangan buat Bennett dan Asha! Kalian mantap banget!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150480804,
					"content": "Terutama di bagian akhir tadi! Ikatan kalian main peran besar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150480805,
					"content": "Kalian mengubah nasib buruk bersama.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150480806
					]
				},
				{
					"id": 150480806,
					"content": "Oke!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480807
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480807,
					"content": "#Aku perlu bilang terima kasih lagi padamu, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480808
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480808,
					"content": "Kalau kamu tidak percaya padaku dan bantu aku yakinkan staf, aku pasti tidak dapat kesempatan untuk selesaikan tantangan ini, apalagi bareng Asha ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480809
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480809,
					"content": "Tuan Bennett, pengujian keamanan terakhir sudah selesai. \"Asha, Lari\" sekarang resmi dibuka. Terima kasih banyak atas bantuan Anda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480810
					],
					"speakerTitle": "Gaun"
				},
				{
					"id": 150480810,
					"content": "Dengar tidak, Asha? Kita berhasil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480811
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480811,
					"content": "Aku akan mengingat nama Anda, Tuan Bennett, petualang yang berani dan baik hati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480812
					],
					"speakerTitle": "Gaun"
				},
				{
					"id": 150480812,
					"content": "Padahal petualangannya masih belum berakhir, tapi lama-lama aku makin tidak rela pergi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480813
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480813,
					"content": "Asha, aku pasti akan merindukanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480814
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480814,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480815
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150480815,
					"content": "Hehe, tidak kok ... seharusnya aku yang hibur kamu! Sebagai ketua tim petualang ini, sudah tanggung jawabku untuk jaga kamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480816
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480816,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480817
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150480817,
					"content": "Kayaknya aku terlalu semangat ... Mataku tiba-tiba panas, jadi susah bicara juga. Haha ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480818
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480818,
					"content": "Aku harus tanya Pak Guru Venti cara ungkapkan perasaan seperti ini. Dia kan penyair terbaik yang aku kenal ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480819
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480819,
					"content": "Paimon sih yakin si Pengamen itu bakal bilang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480820
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150480820,
					"content": "Ungkapkan saja yang ada di hatimu.",
