			},
			"dialogs": [
				{
					"id": 150480101,
					"content": "Kami tidak bisa membiarkan Anda menanggung risiko itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480102
					],
					"speakerTitle": "Gaun"
				},
				{
					"id": 150480102,
					"content": "Tapi bukan itu yang kamu bilang tadi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480103
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480103,
					"content": "Kami mohon maaf. Memang waktu kami terbatas, tapi keselamatan para pengunjung adalah yang utama. Kami harap Anda mengerti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480104
					],
					"speakerTitle": "Gaun"
				},
				{
					"id": 150480104,
					"content": "#Oh, {NICKNAME}! Kamu datang tepat waktu! Apa kamu bisa bantu aku bujuk bapak ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480105
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480105,
					"content": "Mereka perlu orang untuk uji coba. Aku berhasil buktikan pengalaman petualanganku, aku juga sudah tegaskan kalau aku bersedia menanggung semua risiko. Semuanya lancar-lancar saja tadi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480106
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480106,
					"content": "Tapi begitu dia dengar tentang semua kecelakaanku, aku langsung ditolak mentah-mentah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480107
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480107,
					"content": "Tuan, saya benar-benar menghargai semangat Anda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480108
					],
					"speakerTitle": "Gaun"
				},
				{
					"id": 150480108,
					"content": "Tapi jika Anda cenderung terjatuh ke dalam air saat menyeberangi jembatan kokoh, mungkin akan lebih baik jika Anda mencoba sesuatu yang lebih ... nyaman? Contohnya bersantai di kursi pantai di sana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480109
					],
					"speakerTitle": "Gaun"
				},
				{
					"id": 150480109,
					"content": "*huff* Tapi ... aku petualang yang memenuhi syarat uji coba ini! Aku cuma ... sedikit sial saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480110
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480110,
					"content": "Aku benar-benar ingin bantu. Percayalah, aku takkan mengecewakanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480111,
						150480112
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480111,
					"content": "Aku berani jamin, dia bisa diandalkan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150480113
					]
				},
				{
					"id": 150480113,
					"content": "Baiklah, jika pahlawan Natlan sendiri yang bilang begitu ... Bagaimana kalau rekan Asha Anda selesaikan uji coba ronde pertamanya dulu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480114
					],
					"speakerTitle": "Gaun"
				},
				{
					"id": 150480114,
					"content": "Anda bisa melihat dari samping dan pelajari rutenya. Jika semuanya berjalan lancar, Anda bisa ikut uji coba ronde kedua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480115
					],
					"speakerTitle": "Gaun"
				},
				{
					"id": 150480115,
					"content": "Asha gimana? Setuju?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480116
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480116,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480117
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150480117,
					"content": "Oke deh! kuserahkan padamu ya, partner!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480112,
					"content": "Aku percaya padanya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150480113
					]
				}
			]
		},
