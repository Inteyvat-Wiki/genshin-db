				{
					"id": 225011301,
					"content": "Hmm... Aku telah mempertimbangkan kata-katamu, tapi meteorit terlalu langka untuk dilewatkan. Aku akan tetap pergi untuk melihatnya.",
					"roleType": "TALK_ROLE_NPC",
