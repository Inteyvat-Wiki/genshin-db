					"nextDialogs": [
						225011308,
						225011310
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225011308,
					"content": "Baiklah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225011309
					]
				},
				{
					"id": 225011309,
					"content": "Bagus! Bagus sekali! Kalau begitu kuserahkan padamu ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225011310,
					"content": "Berjanjilah padaku kamu tidak akan menyentuh meteorit itu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225011311
					]
				},
				{
					"id": 225011311,
					"content": "Te-Tentu saja, aku janji. Menyentuh meteoritnya akan membuatku tertidur. Untuk apa aku membahayakan diriku sendiri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225011312
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225011312,
					"content": "Tapi, aku penasaran apa yang dimimpikan orang-orang yang tertidur setelah menyentuh meteorit itu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225011313
					],
					"speakerTitle": "Qingzhou"
				},
