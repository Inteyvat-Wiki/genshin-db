			"dialogs": [
				{
					"id": 225011201,
					"content": "Aku telah mempertimbangkan kata-katamu. Wajar jika kamu khawatir, lebih baik aku tidak mencari masalah dengan cara pergi melihat meteorit itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225011202
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225011202,
					"content": "Baguslah kalau begitu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225011203
					]
				},
				{
					"id": 225011203,
					"content": "Lagi pula, syair yang bagus belum tentu terkenal dengan kata-kata yang unik. Kita harus berpikir dengan pandangan yang lebih luas dan mendetail.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225011204
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225011204,
					"content": "Dalam syair, hal-hal kecil seperti bunga dan tanaman mungkin akan memberimu inspirasi, tapi ada begitu banyak syair tentang bunga di dunia ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225011205
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225011205,
					"content": "Hmm... Seperti kata pepatah, \"orang luar lebih dapat menilai dengan jelas\". Menurutmu, bunga apa yang cocok dijadikan inspirasi syairku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
				}
