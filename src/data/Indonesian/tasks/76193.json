			"dialogs": [
				{
					"id": 761930130,
					"content": "(Eh? Itu ... Itu Melusine?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930101
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761930101,
					"content": "Aaah! Melusine beneran! Ahhh! Melusine-nya lucu sekali, imut ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930102
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761930102,
					"content": "Hm? Kalian siapa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930103
					],
					"speakerTitle": "Mamere"
				},
				{
					"id": 761930103,
					"content": "Umm ... Aku boleh sentuh kamu? Aku selalu penasaran Melusine itu rasanya gimana ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930104
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761930104,
					"content": "Makhluk selucu dan sepintar ini ... Lembut? Berbulu? Empuk? Hehe, jangan takut. Aku cuma mau sentuh sedikit saja ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930105
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761930105,
					"content": "Eh, eh???",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930106
					],
					"speakerTitle": "Mamere"
				},
				{
					"id": 761930106,
					"content": "Harap tetap tenang, Nona. Dan jangan melakukan apa pun yang dapat melanggar hukum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930107
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761930107,
					"content": "Nona Mamere adalah penduduk Fontaine. Kontak fisik yang tidak diizinkan bisa menimbulkan kesalahpahaman dan bisa berujung pada tindak pidana, termasuk dipenjara lebih dari tiga tahun dan larangan masuk secara permanen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930108
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761930108,
					"content": "Aaa! Mesinnya bisa bergerak dan ngomong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930109
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761930109,
					"content": "Ehem, maafkan aku. Dia terlalu lucu ... Aku terbawa suasana ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930110
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761930110,
					"content": "Namaku Linnea, konsultan yang kerja di Adventurers' Guild. Uh, aku bukan orang aneh! Sungguh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930111
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761930111,
					"content": "Tidak tepat. Individu yang terlibat dalam tindakan yang aneh tidak akan mungkin menyebut dirinya sebagai \"orang aneh\". Ini adalah dasar logika, Nona Linnea yang terhormat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930112
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761930112,
					"content": "Ugh ...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930113
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761930113,
					"content": "Kamu tidak boleh sembarangan bilang orang lain aneh, Seymour!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930114
					],
					"speakerTitle": "Mamere"
				},
				{
					"id": 761930114,
					"content": "Nona peri kecil ini warnanya indah sekali. Dia tidak seperti Ay{RUBY#[D]Elynas}ah, tapi dia hangat dan indah. Jadi bukan orang aneh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930115
					],
					"speakerTitle": "Mamere"
				},
				{
					"id": 761930115,
					"content": "Tidak tepat. Selain warna ungu, biasanya warna itu tidak berhubungan dengan posisi seseorang. Ini adalah dasar logika, Nona Mamere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930116
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761930116,
					"content": "Aku bukan lagi ngomongin warna baju orang, Seymour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930117
					],
					"speakerTitle": "Mamere"
				},
				{
					"id": 761930117,
					"content": "Eh? Memangnya warna ungu kenapa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930118
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761930118,
					"content": "Umm, halo, Linnea. Namaku Mamere. Aku itu Pelukis Keliling dari Fontaine. Ini Seymour, teman baikku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930119
					],
					"speakerTitle": "Mamere"
				},
				{
					"id": 761930119,
					"content": "Aku tidak sangka bisa bertemu orang lain di sini. Kalian berdua juga sedang cari bahan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930120
					],
					"speakerTitle": "Mamere"
				},
				{
					"id": 761930120,
					"content": "Mencari bahan ya ... Hmm ... Coba kupikirkan. Aku rasa menambahkan koleksi ke dalam arsipku termasuk \"mencari bahan\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930121
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761930121,
					"content": "Linnea menceritakan tentang Frostfin Whale kepada Mamere ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						761930122
					]
				},
				{
					"id": 761930122,
					"content": "Dan, yah. Mungkin Maisie memang benar. Frostfin Whale memang membawa keberuntungan. Bahkan aku bisa bertemu dengan Melusine imut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930123
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761930123,
					"content": "Harap tetap tenang, Nona. Dan jangan melakukan apa pun yang dapat melanggar hukum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930124
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761930124,
					"content": "Ya, a-aku tahu ... Aku tidak akan sembarangan sentuh apa pun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930125
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761930125,
					"content": "Baiklah. Jadi kamu suka hewan, Linnea?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930126
					],
					"speakerTitle": "Mamere"
				},
				{
					"id": 761930126,
					"content": "Tentu saja. Duh ... Andai aku bisa berenang secepat Melusine ... Frostfin Whale itu kayaknya bahagia sekali, aku jadi ingin main sama mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930127
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761930127,
					"content": "Hmm ... Kalau begitu, aku akan berikan lukisan ini kepadamu, Linnea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930128
					],
					"speakerTitle": "Mamere"
				},
				{
					"id": 761930128,
					"content": "Lukisan ini tidak bisa membuatmu berenang lebih cepat, tapi kalau kamu gantung di kamarmu ... Mungkin kamu akan merasa seperti sedang bermain dengan Frostfin Whale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930129
					],
					"speakerTitle": "Mamere"
				},
				{
					"id": 761930129,
					"content": "Wahhh! Terima kasih! Lukisannya indah sekali. Waktu kembali ke Speranza, aku akan tunjukkan ke semua orang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linnea"
				}
			]
		}
	]
}