				{
					"id": 738020101,
					"content": "Ad astra abyssosque! Selamat datang di Adventurers' Guild.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738020102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 738020102,
					"content": "Halo, Nona Katheryne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738020103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 738020103,
					"content": "Halo, Katheryne.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738020104
					]
				},
				{
					"id": 738020104,
					"content": "Halo, sepertinya kondisi kalian berdua baik sekali hari ini. Apa kalian datang untuk mengambil misi harian? Atau menyelesaikan misi lain?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738020105
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 738020105,
					"content": "Ya ... Kenapa kalian terus melihatku? Apa ... ada hal yang mau ditanyakan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738020106,
						738020107
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 738020106,
					"content": "Tidak!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738020108
					]
				},
				{
					"id": 738020108,
					"content": "Oh begitu ... Kelihatanya kamu sudah punya banyak pengalaman menjelajah ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738020109
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 738020109,
					"content": "Bisa dibilang begitu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738020110
					]
				},
				{
					"id": 738020110,
					"content": "Kalau begitu, kamu juga pasti sudah terbiasa dengan cara kerja Adventurers' Guild, jadi aku tidak bakal buang-buang waktu lagi buat menjelaskan segala sesuatunya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738020111
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 738020111,
					"content": "Kalau kalian ada pertanyaan mengenai Guild, silakan tanya saja aku kapan pun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738020112
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 738020112,
					"content": "Tolong banyak-banyaklah berkontribusi untuk menyelesaikan komisi di Kota Sumeru ya. Campur tangan petualang kuat dan ulung sepertimu pasti bisa memberikan bantuan yang berarti untuk banyak orang di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738020113
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 738020113,
					"content": "Selamat bertualang, ad astra abyssosque!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 738020107,
					"content": "Ka-Kami hanya ingin ambil komisi ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738020108
					]
				}
			]
