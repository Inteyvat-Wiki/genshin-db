			"dialogs": [
				{
					"id": 742510201,
					"content": "Senang sekali bisa berbagi cerita masa lalu denganmu sambil menikmati air yang luar biasa ini, Nona Guillotin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510202,
						742510203
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510202,
					"content": "(Ayo duduk seperti ini sebentar lagi.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510204
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742510204,
					"content": "Baiklah. Ke mana pun kamu pergi selanjutnya, semoga perjalananmu lancar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510203,
					"content": "Sudah waktunya beres-beres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510204
					],
					"speakerTitle": "Marionette"
				}
			]
		}
	]
