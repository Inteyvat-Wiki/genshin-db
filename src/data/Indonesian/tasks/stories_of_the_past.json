				]
			},
			"dialogs": [
				{
					"id": 742510101,
					"content": "Terima kasih banyak atas undangannya, Nona Guillotin. Aku rasa, air murni ini disiapkan khusus untukku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510102
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510102,
					"content": "Tidak masalah, Tuan Neuvillette. Suatu kehormatan bagi Iudex Fontaine bisa meluangkan waktunya yang padat untuk menemaniku minum segelas ... air.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510103
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742510103,
					"content": "Apa Fatui punya urusan resmi yang ingin didiskusikan, Nona Guillotin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510104
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510104,
					"content": "Sama sekali bukan. Ini kunjungan pribadi. Tidak perlu terlalu formal. Aku cuma ingin tanyakan tentang kenalan lama denganmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510105
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742510105,
					"content": "Teman lama ... Ah, maksudmu, Alain Guillotin? Lord-Artificer yang hebat itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510106
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510106,
					"content": "Benar. Seperti apa orangnya? Kudengar dia bawahanmu saat masih muda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510107
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742510107,
					"content": "Hmm ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510108
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510108,
					"content": "Tuan Guillotin itu pemuda yang jujur dan rendah hati. Bahkan setelah dianugerahi gelar Kesatria Pelindung Putih, dia tidak pernah sombong sedikit pun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510109
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510109,
					"content": "Sebagian besar waktunya dihabiskan untuk belajar mesin. Dunia di luar gelembungnya sendiri tidak terlalu menarik baginya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510110
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510110,
					"content": "Huh ... Jadi dia seperti itu bahkan waktu masih muda? Aku penasaran, dia memang bijaksana melebihi usianya, atau cuma tidak tahu apa-apa soal dunia luar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510111
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742510111,
					"content": "Tapi ... dia berubah drastis setelah kehilangan keluarga dan teman-temannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510112
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510112,
					"content": "Menara Gestalt? Dan Elynas ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510113
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742510113,
					"content": "Benar. Waktu dia dan aku menandatangani perintah untuk menggeledah menara, dia terlihat ... tak berdaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510114
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510114,
					"content": "Semua itu terjadi karena keterasingan dan kerenggangan di masa lalu. Dia pasti juga merasa bersalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510115
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742510115,
					"content": "Hmm ... Dia jadi lebih pendiam setelah kejadian itu, interaksi kami pun jadi makin jarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510116
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510116,
					"content": "Dalam upacara penganugerahan gelarnya sebagai Lord-Artificer, pidatonya hanya satu kalimat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510117
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510117,
					"content": "\"Hidup tenang dan rendah hati adalah jalan yang lebih pasti menuju kebahagiaan, dibandingkan mengejar kesempurnaan tanpa batas dengan membabi buta.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510118
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510118,
					"content": "Heh ... Itulah cara dia menjalani hidup di tahun-tahun terakhirnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510119
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742510119,
					"content": "Sepertinya dia bukan cuma menyampaikan kepada orang banyak, dia berbicara dengan dirinya sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510120
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742510120,
					"content": "Lalu, bagaimana pendapatmu soal semua ini, Nona Guillotin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510121
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510121,
					"content": "Aku? Hmph. Aku tidak akan menilai pencerahannya atau cara hidupnya, sama seperti dia tidak pernah memberitahuku bagaimana aku harus menjalani hidupku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510122
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742510122,
					"content": "Tapi aku tidak berniat mengikuti jalannya atau meniru idealismenya. Aku itu diriku sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510123
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742510123,
					"content": "Hah ... terima kasih. Kamu sudah membantuku memahami dia lebih baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510124
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742510124,
					"content": "Sama-sama. Senang rasanya bisa berbagi cerita masa lalu dengan salah satu anggota keluarganya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neuvillette"
				}
			]
		},
