			"dialogs": [
				{
					"id": 700010401,
					"content": "Eh? Ada apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010402
					],
					"speakerTitle": "Warga yang Ceroboh"
				},
				{
					"id": 700010402,
					"content": "Ketika angin bertiup dan kelopak bunga berterbangan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010403
					]
				},
				{
					"id": 700010403,
					"content": "Angin? Bunga? Maksudmu Dandelion?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010404
					],
					"speakerTitle": "Warga yang Ceroboh"
				},
				{
					"id": 700010404,
					"content": "Ada apa dengan hal itu? Wajar saja kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010405
					],
					"speakerTitle": "Warga yang Ceroboh"
				},
				{
					"id": 700010405,
					"content": "Um, bukan apa-apa kok. Maaf ya mengganggu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700010406,
					"content": "Sepertinya cuma penduduk biasa. Ayo kita tanya orang lain saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7000105,
			"completionStepIds": [
				7000107
			],
