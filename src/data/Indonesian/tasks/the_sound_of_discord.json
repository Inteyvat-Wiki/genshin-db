					"Vile"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700010601,
					"content": "Bagaimana dengan perkembangan masalah Treasure Hoarder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010602
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 700010602,
					"content": "Semuanya sudah kuatasi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010603
					]
				},
				{
					"id": 700010603,
					"content": "Honorary Knight memang hebat. Bagus, cara kamu berbicara dengan Treasure Hoarder juga sangat cerdik... seperti yang diharapkan dari orang yang disukai \"pria itu\".",
