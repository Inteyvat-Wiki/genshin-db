			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vile"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700010201,
					"content": "Ah, Pengembara, kita ketemu lagi. Bagaimana, apakah kamu menyukai suasana di kota?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010202
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 700010202,
					"content": "Cukup bagus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010203
					]
				},
				{
					"id": 700010203,
					"content": "Baguslah kalau kamu menyukainya. Tapi... meskipun kurang cocok dengan suasana festival, bisakah kamu membantuku dengan sesuatu yang berhubungan dengan festival ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010204
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 700010204,
					"content": "Tidak, lebih tepatnya, \"pria itu\" yang membutuhkan bantuanmu dalam hal ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010205
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 700010205,
					"content": "Kupikir selama Festival Windblume orang-orang tidak akan memintamu melakukan sesuatu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010206
					]
				},
				{
					"id": 700010206,
					"content": "Ah, jangan khawatir. Permintaan ini tidak termasuk dalam batasan festival yang biasanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010207
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 700010207,
					"content": "Seperti yang sudah kamu perhatikan, Festival Windblume adalah saat-saat yang paling sibuk. Orang-orang datang dan pergi, begitu hiruk pikuk... Hampir semua orang benar-benar tenggelam dalam suasana festival. Para Knight juga terlalu sibuk menjaga ketertiban untuk memperhatikan hal lainnya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010208
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 700010208,
					"content": "Kerumunan orang-orang yang lengah dan para Knight yang super sibuk... saat-saat seperti ini tentunya adalah kesempatan besar bagi Treasure Hoarder untuk beraksi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010209
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 700010209,
					"content": "Menurut informasi dari pria itu, beberapa anggota Treasure Hoarder telah menyusup ke dalam kota, mereka berpura-pura menikmati festival di dekat toko-toko sambil siap-siap beraksi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010210
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 700010210,
					"content": "Kalau para Knight memulai pencarian besar-besaran sekarang, takutnya bukan hanya membuat Treasure Hoarder jadi sadar tapi juga jadi merusak suasana festival saat ini. Tapi bukan berarti kita akan membiarkan mereka beraksi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010211
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 700010211,
					"content": "Makanya kamu mencariku?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010212
					]
				},
				{
					"id": 700010212,
					"content": "Tentu saja. Pria itu juga secara khusus meminta bantuanmu untuk mengatasi masalah ini. Menurutnya kamu adalah orang terbaik untuk melakukannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010213
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 700010213,
					"content": "Oke, kita langsung bahas inti permasalahannya. Menurut Intel yang kukumpulkan, semua Treasure Hoarder yang menyusup ke dalam kota membawa sebuah <color=#00E1FFFF>kantong</color> dan menggunakan <color=#00E1FFFF>kode</color> untuk mengonfirmasi identitas sesama rekan mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010214
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 700010214,
					"content": "<color=#00E1FFFF>Ketika angin bertiup dan kelopak bunga berterbangan, itulah saatnya para pengamat harus waspada.</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010215,
						700010216
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 700010215,
					"content": "Sangat mudah untuk diingat...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010217
					]
				},
				{
					"id": 700010217,
					"content": "Mereka yang bisa melafalkan kode ini akan menjadi rekan sesamanya dan mendapatkan lokasi pangkalan mereka di luar sana dari mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010218
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 700010218,
					"content": "Setelah kamu mendapatkan Intel mereka, mohon gunakan kesempatan ini untuk menangani mereka semua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010219
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 700010219,
					"content": "Kenapa tidak serahkan saja masalah ini ke para Knight?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010220
					]
				},
				{
					"id": 700010220,
					"content": "Soalnya para Knight pasti sangat sibuk menjaga ketertiban selama festival.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010221
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 700010221,
					"content": "Pada saat-saat seperti ini, sudah sewajarnya jadi kewajiban penduduk untuk peduli dan... berbagi sedikit beban kerja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010222
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 700010222,
					"content": "Kalau begitu, kami serahkan padamu ya, Honorary Knight.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				},
				{
					"id": 700010216,
					"content": "Terdengar seperti gaya mereka.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010217
					]
				}
			]
		},
		{
