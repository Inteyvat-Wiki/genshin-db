				"objectNames": [
					"Warga yang Murung"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700010501,
					"content": "Aku penasaran masih ada kesempatan tidak ya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010502
					],
					"speakerTitle": "Warga yang Murung"
				},
				{
					"id": 700010502,
					"content": "Hmm? Apakah ada masalah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010503
					],
					"speakerTitle": "Warga yang Murung"
				},
				{
					"id": 700010503,
					"content": "Ketika angin bertiup dan kelopak bunga berterbangan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010504
					]
				},
				{
					"id": 700010504,
					"content": "Ya, tahun ini juga pasti seperti itu. Aku tahu, tahu kok, aku harus menikmatinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010505
					],
					"speakerTitle": "Warga yang Murung"
				},
				{
					"id": 700010505,
					"content": "Benar juga, kenapa aku harus sedih hanya karena ditolak? Festival ini belum berakhir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010506
					],
					"speakerTitle": "Warga yang Murung"
				},
				{
					"id": 700010506,
					"content": "Terima kasih atas doronganmu. Aku akan bersemangat kembali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010507
					],
					"speakerTitle": "Warga yang Murung"
				},
				{
					"id": 700010507,
					"content": "Sepertinya dia salah paham. Setidaknya dia bukan orang yang mencurigakan sih...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7000106,
			"completionStepIds": [
				7000111
			],
