			},
			"dialogs": [
				{
					"id": 700010301,
					"content": "Luar biasa, tempat ini begitu ramai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010302
					],
					"speakerTitle": "Warga yang Mencurigakan"
				},
				{
					"id": 700010302,
					"content": "Ketika angin bertiup dan kelopak bunga berterbangan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010303
					]
				},
				{
					"id": 700010303,
					"content": "Oh? Hmm... itulah saatnya para pengamat harus waspada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010304
					],
					"speakerTitle": "Warga yang Mencurigakan"
				},
				{
					"id": 700010304,
					"content": "Ah, jadi kamu adalah salah satu dari kami. Kamu datang di saat yang tepat. Aku sudah mengamati sekelompok pasangan yang ceroboh. Bagaimana kalau kita mengambil Mora untuk kita sendiri, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010305
					],
					"speakerTitle": "Warga yang Mencurigakan"
				},
				{
					"id": 700010305,
					"content": "Kamu alihkan perhatian mereka, aku akan beraksi mencopet dompet mereka. Setelah berhasil, ayo kita kembali ke Windrise untuk bertemu dengan yang lainnya. Entah bagaimana hasil panen mereka...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010306
					],
					"speakerTitle": "Warga yang Mencurigakan"
				},
				{
					"id": 700010306,
					"content": "Oh, sebelum itu, kamu harus pergi denganku dulu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010307
					]
				},
				{
					"id": 700010307,
					"content": "Eh!? Tunggu dulu, kamu bukan Treasure Hoarder. Siapa kamu?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010308
					],
					"speakerTitle": "Warga yang Mencurigakan"
				},
				{
					"id": 700010308,
					"content": "Cuma sekadar Knight yang ramah tamah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010309
					]
				},
				{
					"id": 700010309,
					"content": "Dia sudah ditangkap oleh Knight. Tapi Paimon penasaran, mereka kok cepat sekali bisa ada di sini ya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700010310,
					"content": "Yah, kurasa bukan hal yang terlalu penting. Tadi katanya ketemuan di Windrise kan? Ayo kita periksa ke sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
