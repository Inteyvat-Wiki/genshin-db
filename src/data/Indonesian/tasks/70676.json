			"dialogs": [
				{
					"id": 706760101,
					"content": "Paimon enggak nyangka ada ruangan begini di dalam perpustakaan. Jangan-jangan ini area terlarang yang dibilang Lisa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706760102,
					"content": "Hmm, kayaknya bukan deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706760103,
					"content": "Atau mungkin ini kayak ruang misterius yang di cerita-cerita dongeng? Yang biasanya dilarang masuk soalnya banyak rahasianya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706760104,
					"content": "Kalau memang dilarang masuk harusnya pintunya dikunci dong.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706760105
					]
				},
				{
					"id": 706760105,
					"content": "Iya juga, tadi kita masuknya gampang banget. Kuncinya juga enggak ada bekas kayak habis dicongkel atau apa gitu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706760106,
					"content": "Eh? Sebentar, pintunya kok jadi beda?! Woi, ini kita beneran masih di perpustakaan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760107,
						706760109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706760107,
					"content": "Mungkin ini di dasar Danau Cider?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706760108
					]
				},
				{
					"id": 706760108,
					"content": "Oh gitu ya, keren amat bisa bikin ginian di dasar danau ... Eh, ngawur kamu! Mustahil tahu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706760111,
					"content": "Hmm ... Sayangnya Lisa lagi liburan hari ini, jadi enggak bisa tanya. Tapi karena sudah di sini juga, bagaimana kalau kita sekalian lihat-lihat? Kayaknya aman-aman saja sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706760112,
					"content": "Tempat baru ada buat dijelajahin! Percaya deh sama nasihatnya pemandu veteran kayak Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706760113,
					"content": "#{NICKNAME} lihat! Ada boneka serigala yang gemes banget!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706760114,
					"content": "Bulunya lembut, Paimon jadi pengen peluk! Kira-kira siapa yang ninggalin di sini ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760115,
						706760117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706760115,
					"content": "Eh, mungkin dia empunya ruangan ini. Jangan enggak sopan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706760116
					]
				},
				{
					"id": 706760116,
					"content": "\"Pengembara yang bodoh, beraninya kamu menyusup ke dalam benteng kematian ini? KAMU AKAN DITELAN BULAT-BULAT! Awoo!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706760120,
					"content": "Biarin dulu saja lah di situ. Tempat ini gede banget, mending kita lanjut jelajahin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706760117,
					"content": "Mungkin dia satpamnya ruang misterius ini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706760118
					]
				},
				{
					"id": 706760118,
					"content": "Satpam apaan yang kerjanya cuma rebahan di sofa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706760119,
					"content": "\"Grook ... grook ... kalau enggak kelihatan, berarti enggak ada ... grooook ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706760109,
					"content": "Jangan-jangan ... kita masuk ke dunia lain.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706760110
					]
				},
				{
					"id": 706760110,
					"content": "DUNIA LAIN yang kayak mana coba?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760111
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
