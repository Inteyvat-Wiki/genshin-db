			"dialogs": [
				{
					"id": 750350101,
					"content": "Permisi ... Suhu Kulahaw?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350102,
					"content": "Betul, itu namaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350103
					],
					"speakerTitle": "Kulahaw"
				},
				{
					"id": 750350103,
					"content": "Hehe, jadi kamu Suhu Permata yang lagi cari inspirasi! Kami dapat rekomendasi dari Imix nih. Kamu dari tadi ngelihatin pohon terus, lagi cari inspirasi yah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350104,
					"content": "Tidak ... ah sudahlah lupakan saja. Sudah tidak penting lagi ... *huff* Ada yang bisa dibantu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350105
					],
					"speakerTitle": "Kulahaw"
				},
				{
					"id": 750350105,
					"content": "#Kami bawa batu akik yang bagus banget, minta diproses dong buat si {REALNAME[ID(2)|SHOWHOST(true)]}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350106,
					"content": "#Hehe, ayo cepat {REALNAME[ID(2)|SHOWHOST(true)]}, kasihin batunya ke suhu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350107,
					"content": "Nguuk! Nguuk ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350108
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750350108,
					"content": "Ehhh?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350109,
					"content": "#Kamu mendengar suara kepakan sayap ....\\nSaat kamu menyadarinya, batu permatanya sudah hilang dari genggaman {REALNAME[ID(2)|SHOWHOST(true)]}.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750350110
					]
				},
				{
					"id": 750350110,
					"content": "NGUUUK! FUWAAA~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350111
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750350111,
					"content": "Tu—Tunggu, ke mana batunya? Kok bisa hilang sih?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350112,
					"content": "Kayaknya diambil burung tadi ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750350113
					]
				},
				{
					"id": 750350113,
					"content": "HAH?! Burung di sini bisa rampok barang orang?! Kurang ajar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350114,
					"content": "FUWAAA! NGUUUK, NGUUK~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350115
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750350115,
					"content": "Sebenarnya, misalkan batunya tidak dicuri pun aku tetap tidak bisa membantu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350116
					],
					"speakerTitle": "Kulahaw"
				},
				{
					"id": 750350116,
					"content": "Karena semua peralatanku juga dicuri sama burung sialan itu! Tadi aku lagi mengamati mereka satu per satu, mau cari burung mana yang berani menyentuh peralatanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350117
					],
					"speakerTitle": "Kulahaw"
				},
				{
					"id": 750350117,
					"content": "#Ma—Masa sih bisa gitu?! Burung kurang ajar!!! Ayo {NICKNAME}, kita rebut balik batunya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350118,
					"content": "Nguk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350119
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750350119,
					"content": "Dan jangan lupa peralatanku juga ya—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kulahaw"
				}
			]
		},
