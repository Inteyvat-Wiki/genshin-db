			"dialogs": [
				{
					"id": 750350801,
					"content": "Wah wah wah. Alatku semua sudah kembali. Syukurlah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350802
					],
					"speakerTitle": "Kulahaw"
				},
				{
					"id": 750350802,
					"content": "Aku tadi tidak lihat dengan jelas. Benar-benar permata yang indah! Ada cakar burung berwarna kuning ... Bah! Mana boleh aku mengumpamakan seperti itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350803
					],
					"speakerTitle": "Kulahaw"
				},
				{
					"id": 750350803,
					"content": "Layaknya langit yang baru terang saat fajar, semburat pertama sinar sang surya ... yah, pokoknya gitu lah warnanya.",
