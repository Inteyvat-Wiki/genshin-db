						750351236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351236,
					"content": "#Paimon kok tetap ngerasa kalau dipegang begitu saja sama {REALNAME[ID(2)|SHOWHOST(true)]}, pasti cepat hilang deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351237
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351237,
					"content": "Mau coba cari Putra-Putri Gema? Mungkin mereka punya tukang permata yang bisa bantu kita bentuk permatanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351231,
					"content": "Jadi apa sih yang kamu simpan diam-diam, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750351232
					]
				},
				{
					"id": 750351232,
					"content": "#Paimon kan sudah bilang, itu rahasia. Jadi meski kita ini rekan terbaik sedunia, rahasia tetap rahasia. Tapi kalau buat ngasih {REALNAME[ID(2)|SHOWHOST(true)]} sih, lebih dari cukup ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351223,
					"content": "Batu ini bulatnya sempurna.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750351224
					]
				},
				{
					"id": 750351224,
					"content": "#Bulat dan bercahaya. Hehe. Meski Paimon dan {NICKNAME} sudah punya segudang pengalaman, tapi kami jarang lihat batu bulat sempurna kayak gini ya!",
					"roleType": "TALK_ROLE_NPC",
