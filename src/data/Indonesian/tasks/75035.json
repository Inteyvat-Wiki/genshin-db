					"nextDialogs": [
						750351233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351233,
					"content": "#Tadaaa! Ini permata yang super bersinar. Gimana, {REALNAME[ID(2)|SHOWHOST(true)]}, suka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
