				},
				{
					"id": 750351226,
					"content": "Hmm, kita ambil semua deh ya! Hehe. Paimon bakal selipin di tabungan rahasia Paimon. Siapa tahu suatu hari nanti bakal bisa berguna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351227,
					"content": "#Hmm, karena {REALNAME[ID(2)|SHOWHOST(true)]} sudah ngasih hadiah, kita harus ngasih hadiah balik dong ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351228,
					"content": "Paimon coba lihat ya ... Ada apa di tabungan rahasia Paimon ....",
