					"nextDialogs": [
						750351229,
						750351231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351229,
					"content": "Jarang sekali ya Paimon bisa ngasih-ngasih barang begini ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750351230
					]
				},
				{
					"id": 750351230,
					"content": "#Hei! {REALNAME[ID(2)|SHOWHOST(true)]} kan sudah habis-habisan untuk tunjukin keseriusannya. Terus kalau terlalu berat, Paimon juga enggak bisa terbang, kan! Jadi sebagian dibagi saja ke dia ....",
