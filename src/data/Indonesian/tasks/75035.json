					"nextDialogs": [
						750351215
					]
				},
				{
					"id": 750351215,
					"content": "Wah! Banyak banget barangnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351216,
					"content": "Paimon coba lihat ya! Ada ranting yang lurus banget, batu bulat, terus ada ... makanan dengan warna dan bau yang aneh, kayaknya sudah berhari-hari deh ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351217,
					"content": "#Ini semua kamu kumpulin dengan hati-hati ya? Mau kasih aku dan {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351218
					],
					"speakerTitle": "Paimon"
				},
