			"dialogs": [
				{
					"id": 750350301,
					"content": "Ah, halo. Suhu Kulahaw meninggalkan permata yang sudah selesai diproses itu di toko, dan dia minta aku sendiri yang mengantarkan barangnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350302
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 750350302,
					"content": "Eh? Suhu Kulahaw masih belum ada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350303,
					"content": "Benar, dia pergi keluar lagi buat cari inspirasi. Ngomong-ngomong, dia juga ada bawa satu set gembok kunci, katanya supaya peralatannya tidak dicuri lagi ... Aneh ... Masa sih betulan ada orang yang mau nyuri peralatan begitu buat dijual?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350304
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 750350304,
					"content": "Bukan orang! Tapi—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350305,
					"content": "(Jadi Imix masih belum tahu pencurinya adalah burung ... Mending jangan bikin Kulahaw tambah malu deh!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350306,
					"content": "Tapi ... memang sih ada yang mengira bisa curi kemampuannya kalau pegang peralatannya, haha ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350307,
					"content": "Ah sudahlah ... permatanya kami ambil ya! Bentuknya bagus banget, enggak heran dia jadi suhu permata!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350308,
					"content": "Nguk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350309
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750350309,
					"content": "#Kayaknya {REALNAME[ID(2)|SHOWHOST(true)]} juga suka tuh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350310,
					"content": "#Aku mewakili {REALNAME[ID(2)|SHOWHOST(true)]} mengucapkan terima kasih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750350311
					]
				},
				{
					"id": 750350311,
					"content": "Hei, bagus deh kalau Saurian kecil ini suka! Aku akan sampaikan rasa terima kasih kalian pada Suhu Kulahaw, lain kali datang lagi ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Imix"
				}
			]
		},
