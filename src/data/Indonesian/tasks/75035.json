			"dialogs": [
				{
					"id": 750350401,
					"content": "Selamat datang! Kalau mau potong batu permata, kamu datang ke tempat yang tepat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350402
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 750350402,
					"content": "Hei! Kami di sini punya permata dan memang mau diproses sih. Buat Tepetlisaurus kecil ini, jeng-jeng! Nih dia—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350403,
					"content": "Wow! Permata ini benar-benar berkualitas tinggi! Lihat saja ukurannya, juga warnanya yang transparan ... Kalau mau diproses, agak susah nih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350404
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 750350404,
					"content": "Wah, kayaknya sudah tahu nih lanjutannya. Jadi gimana, ada biaya tambahan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350405,
					"content": "Eh tidak! Memangnya menurutmu aku ini orang seperti apa?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350406
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 750350406,
					"content": "Toko kami memang berfokus pada pembuatan batu permata dan pemrosesannya. Kalau ketemu permata bagus, mendingan kami poles gratis, dan biarlah keindahan kualitasnya yang membawa nama kami menjadi sohor ke pelosok dunia, jadi kami tidak pernah mematok harga tinggi begitu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350407
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 750350407,
					"content": "Pengrajin mencari bahan baku paling berkualitas, tapi bahan baku berkualitas juga perlu pengrajin terbaik untuk mengerjakannya. Aku kenal seorang \"Suhu Permata\" yang hebat, dan aku yakin dia orang yang tepat untuk ngerjain ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350408
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 750350408,
					"content": "Wow, hebat banget! Ayo cepat, cepat, panggil si suhu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350409,
					"content": "Aha, tapi kalau mau ketemu dia biasanya harus bikin janji dulu. Kalau tidak, kemungkinan dia lagi keluar buat cari inspirasi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350410
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 750350410,
					"content": "Cari inspirasi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750350411
					]
				},
				{
					"id": 750350411,
					"content": "Iya! Suhu Kulahaw memang bukan pengrajin biasa, dan dia tidak memoles permata cuma berdasarkan blueprint-nya saja, tapi dia juga sering kali mencoba memahami dan memantau segala bentuk keindahan alam di dunia ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350412
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 750350412,
					"content": "Contohnya, belajar teknik memoles dari riak kecil di air danau, atau pola ukiran dari awan yang berubah-ubah ... ini namanya \"mengumpulkan inspirasi\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350413
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 750350413,
					"content": "Umm ... rumit juga ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350414,
					"content": "Tapi, kalau kalian lagi buru-buru, coba cari dia di tempat pengumpulan inspirasi. Aku tandai lokasinya untuk kalian ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Imix"
				}
			]
		},
