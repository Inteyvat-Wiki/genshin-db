				"points": []
			},
			"dialogs": [
				{
					"id": 726990101,
					"content": "Aku tidak tahu kemampuan seni pedangmu sehebat apa, tapi aku benar-benar menantikan duel ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990102
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726990102,
					"content": "Eh, kamu kok ada di sini ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726990103
					]
				},
				{
					"id": 726990103,
					"content": "Sebenarnya, waktu tadi bilang ada empat petarung yang ikut, aku juga termasuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990104
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726990104,
					"content": "Memang aku yang mengadakan acaranya, tapi pesertanya terlalu sedikit ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990105
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726990105,
					"content": "Lagi pula, aku terlahir untuk bertarung! Ada lawan yang hebat berdiri di depan mata, masa aku tidak menjajal kemampuannya?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990106
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726990106,
					"content": "Hehe, sudah lama sekali aku ingin melontarkan kalimat barusan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990107
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726990107,
					"content": "Ih, kata Paimon sih orang ini agak \"miring\" sedikit ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726990108,
					"content": "Tapi sebaiknya kita jangan meremehkan lawan dulu, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726990109
					]
				},
				{
					"id": 726990109,
					"content": "Bagus! Aku menghormati sikapmu yang tidak membeda-bedakan lawan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990110
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726990110,
					"content": "Sebelumnya, kalau saja aku tidak meremehkan si kontestan nomor empat, mungkin aku juga tidak akan kalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990111
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726990111,
					"content": "#Tapi aku yang hari ini beda dengan aku yang kemarin! Ayo, {NICKNAME}, kita mulai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990114,
						726990112
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726990114,
					"content": "Silakan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726990115
					]
				},
				{
					"id": 726990115,
					"content": "Silakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726990112,
					"content": "Aku siap-siap dulu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726990113
					]
				},
				{
					"id": 726990113,
					"content": "Baiklah. Silakan persiapkan dirimu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasuhiko Tarou"
				}
			]
		}
	]
