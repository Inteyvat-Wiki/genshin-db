						],
						"pointId": 90
					}
				]
			},
			"dialogs": [
				{
					"id": 751890301,
					"content": "\"Ayo jalan. Kita lihat di mana mereka sembunyikan izinnya ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890302
					],
					"speakerTitle": "Pelayan Naga Sumber"
				},
				{
					"id": 751890302,
					"content": "\"Mereka taruh di sana ... Mereka bahkan tidak repot-repot menyembunyikannya ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890303
					],
					"speakerTitle": "Pelayan Naga Sumber"
				},
				{
					"id": 751890303,
					"content": "\"Tapi sepertinya ini cuma wadah kosong ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890304
					],
					"speakerTitle": "Pelayan Naga Sumber"
				},
				{
					"id": 751890304,
					"content": "Wah, wah, kok banyak banget Rifthound-nya? Waduh, berarti izinnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890305,
					"content": "\"Pelindung di gerbang sudah hilang, jadi mereka bisa masuk.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890306
					],
					"speakerTitle": "Pelayan Naga Sumber"
				},
				{
					"id": 751890306,
					"content": "Te-terus gimana dong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890307,
					"content": "\"Tidak masalah. Cukup aktifkan perangkat pemurnian dan perbaikan Chamber of Deliberation.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890308
					],
					"speakerTitle": "Pelayan Naga Sumber"
				},
				{
					"id": 751890308,
					"content": "\"Di sana ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pelayan Naga Sumber"
				}
			]
		},
