			},
			"dialogs": [
				{
					"id": 751890401,
					"content": "Fiuh, akhirnya kita dapat izin masuk ke Jantung Gunung Suci!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890402,
					"content": "\"Tidak, seperti yang kukatakan sebelumnya, ini hanyalah wadah kosong dari 'izin'...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890403
					],
					"speakerTitle": "Pelayan Naga Sumber"
				},
				{
					"id": 751890403,
					"content": "\"Tanpa informasi apa pun tentang pemiliknya, benda yang terbuat dari sisik ini tidak bisa diubah menjadi 'izin'.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890404
					],
					"speakerTitle": "Pelayan Naga Sumber"
				},
				{
					"id": 751890404,
					"content": "\"Jika tidak, bukankah berarti benda ini bisa jadi kunci serbaguna yang bisa digunakan oleh siapa pun asalkan diri mereka adalah 'naga' ...?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890405
					],
					"speakerTitle": "Pelayan Naga Sumber"
				},
				{
					"id": 751890405,
					"content": "Cepat bawa naga yang benar ke sini!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751890406
					]
				},
				{
					"id": 751890406,
					"content": "#Naga seperti itu mau cari di mana ... Eh, sebentar! Kalau {REALNAME[ID(2)|SHOWHOST(true)]} gimana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890407,
					"content": "Nguk?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890408
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890408,
					"content": "\"Dia ... belum memiliki kekuatan seperti itu.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890409
					],
					"speakerTitle": "Pelayan Naga Sumber"
				},
				{
					"id": 751890409,
					"content": "Terus gimana dong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890410,
					"content": "\"Dahulu kala, setelah sang penguasa agung memasuki Jantung Gunung Suci, terdapat sejumlah orang yang memiliki wewenang, namun tidak mengaktifkan 'izin' ini.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890411
					],
					"speakerTitle": "Pelayan Naga Sumber"
				},
				{
					"id": 751890411,
					"content": "\"Mungkin saja, 'izin' ini ditaruh di sini justru untuk tujuan itu ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pelayan Naga Sumber"
				}
			]
		},
