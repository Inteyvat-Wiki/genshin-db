						751890703
					],
					"speakerTitle": "Pelayan Naga Sumber"
				},
				{
					"id": 751890703,
					"content": "Wah! Paimon enggak nyangka ada mekanisme begini di dalam sini ... Monster-monsternya langsung musnah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890704,
					"content": "\"Bagaimanapun juga, bangunan ini dibangun untuk bertahan selama ribuan tahun. Tidak hanya untuk melawan musuh, tapi bahkan bisa memperbaiki dirinya sendiri ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890705
					],
					"speakerTitle": "Pelayan Naga Sumber"
				},
				{
					"id": 751890705,
					"content": "Warnanya emas dan berkilau banget ... Paimon mau pegang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890706,
					"content": "Nguk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890707
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890707,
					"content": "\"Haha, sebaiknya jangan ... Dia tidak membedakan antara 'teman' atau 'musuh', dan membakar semua yang disentuhnya tanpa terkecuali.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890708
					],
					"speakerTitle": "Pelayan Naga Sumber"
				},
				{
					"id": 751890708,
					"content": "\"... Cara yang kasar sekali. Hmph, entah siapa yang merancangnya.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890709
					],
					"speakerTitle": "Pelayan Naga Sumber"
				},
				{
					"id": 751890709,
					"content": "Tapi kita bisa pakai untuk buka pelindung izinnya, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890710,
						751890712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890710,
					"content": "Boleh dicoba ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751890711
					]
				},
				{
					"id": 751890711,
					"content": "Nguk!",
