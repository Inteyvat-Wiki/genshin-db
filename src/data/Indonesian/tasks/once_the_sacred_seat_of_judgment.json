				]
			},
			"dialogs": [
				{
					"id": 751890501,
					"content": "\"Aku sudah tahu kalian akan datang, jadi aku datang lebih awal untuk menyambut kalian ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890502
					],
					"speakerTitle": "Pelayan Naga Sumber"
				},
				{
					"id": 751890502,
					"content": "Groar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890503
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890503,
					"content": "\"Meskipun aku tahu kamu cuma basa-basi, tapi aku tetap senang bertemu denganmu.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890504
					],
					"speakerTitle": "Pelayan Naga Sumber"
				},
				{
					"id": 751890504,
					"content": "Hmph, ternyata memang kamu ya! Jadi sekarang kamu pakai nama apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890505,
					"content": "\"Kali ini namaku adalah milik seorang juru tulis dari Chamber of Deliberation. Sejujurnya dia sendiri sangat jarang menyentuh pena sejak Pelayan Naga Sumber diciptakan.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890506
					],
					"speakerTitle": "Pelayan Naga Sumber"
				},
				{
					"id": 751890506,
					"content": "\"Kalian boleh memanggilku ... Awanyu.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890507
					],
					"speakerTitle": "Pelayan Naga Sumber"
				},
				{
					"id": 751890507,
					"content": "Oke deh, Awanyu. Jadi kali ini kamu mau bantuin kami dapat izin masuk ke Jantung Gunung Suci?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890508,
					"content": "\"Jika tidak, Astral Assemblage yang dipasang di Jantung Gunung Suci akan langsung menyerang siapa pun yang masuk tanpa izin ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890509
					],
					"speakerTitle": "Pelayan Naga Sumber"
				},
				{
					"id": 751890509,
					"content": "\"Aku sudah mengekstraksi catatan 'Awanyu'. Izin untuk memasuki Jantung Gunung Suci diletakkan di atas Chamber of Deliberation.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890510
					],
					"speakerTitle": "Pelayan Naga Sumber"
				},
				{
					"id": 751890510,
					"content": "\"Untuk itu, aku harus menginjakkan kaki di sini ... tempat berkumpulnya orang-orang bodoh yang mengira diri mereka paling pintar dan paling hebat.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890511
					],
					"speakerTitle": "Pelayan Naga Sumber"
				},
				{
					"id": 751890511,
					"content": "\"Markas para penipu yang mengaku berhak menghakimi kaumnya ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pelayan Naga Sumber"
				}
			]
