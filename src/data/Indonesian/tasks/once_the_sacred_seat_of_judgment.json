					"content": "Sepertinya kamu tidak suka tempat ini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751890202
					]
				},
				{
					"id": 751890202,
					"content": "\"Kalau kamu juga dianggap sebagai penjahat, aku yakin kamu juga tidak akan suka tempat ini.\"",
					"roleType": "TALK_ROLE_NPC",
