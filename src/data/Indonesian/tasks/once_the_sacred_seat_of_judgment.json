			},
			"dialogs": [
				{
					"id": 751890601,
					"content": "\"Cahaya ukiran di sana bisa mengaktifkan sisiknya. Itu izinnya ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890602
					],
					"speakerTitle": "Pelayan Naga Sumber"
				},
				{
					"id": 751890602,
					"content": "Nguk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890603
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890603,
					"content": "Kita bisa lihat seluruh Kota Suci dari sini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890604,
					"content": "\"Ya, sisa-sisa menyedihkan dari kemegahannya yang dulu ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890605
					],
					"speakerTitle": "Pelayan Naga Sumber"
				},
				{
					"id": 751890605,
					"content": "Waaa ... Nguk?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890606
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890606,
					"content": "\"Kamu ingin tahu hasil dari persidangan itu? Haha ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890607
					],
					"speakerTitle": "Pelayan Naga Sumber"
				},
				{
					"id": 751890607,
					"content": "\"Mereka yang menuntut hukuman suci tahu betul bahwa penguasa segala api hanya mati suri, tapi ketika sang raja yang jarang menampakkan dirinya tiba-tiba muncul ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890608
					],
					"speakerTitle": "Pelayan Naga Sumber"
				},
				{
					"id": 751890608,
					"content": "\"Ketiga Belas Penguasa dan Tiga Pangeran, yang sebelumnya tidak bisa berhenti berbicara, segera menarik kembali kata-kata mereka. Persidangannya pun berakhir tanpa kesimpulan ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890609
					],
					"speakerTitle": "Pelayan Naga Sumber"
				},
				{
					"id": 751890609,
					"content": "Ngukkkk ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890610
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890610,
					"content": "\"Lalu ... Tiga Pangeran tewas dalam perang melawan manusia, sedangkan sepuluh dari Ketiga Belas Penguasa menemui ajalnya saat Kota Suci Tollan runtuh. Hanya satu yang tersisa di Chichen Uctokah ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890611
					],
					"speakerTitle": "Pelayan Naga Sumber"
				},
				{
					"id": 751890611,
					"content": "\"Hanya satu penguasa yang hidup hingga saat ini ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890612
					],
					"speakerTitle": "Pelayan Naga Sumber"
				},
				{
					"id": 751890612,
					"content": "\"Walaupun aku ragu dia mengambil wujud yang diinginkannya ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890613
					],
					"speakerTitle": "Pelayan Naga Sumber"
				},
				{
					"id": 751890613,
					"content": "\"Baiklah ... mari kita terus masuki Jantung Gunung Suci. Semuanya terkubur di sana ... termasuk harapan akan akhir perjalanan.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890614
					],
					"speakerTitle": "Pelayan Naga Sumber"
				},
				{
					"id": 751890614,
					"content": "\"Tugasku akan segera berakhir ... Yang Terpilih oleh Naga, andai kamu dapat melihat tempat ini di masa-masa kejayaannya ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890615
					],
					"speakerTitle": "Pelayan Naga Sumber"
				},
				{
					"id": 751890615,
					"content": "\"Pergilah dan sentuh cahaya yang terukir di sisik api itu ... Dapatkan izin untuk mencapai Jantung Gunung Suci ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890616
					],
					"speakerTitle": "Pelayan Naga Sumber"
				},
				{
					"id": 751890616,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890617
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890617,
					"content": "Awanyu ... Hilang lagi! Paimon baru saja terbiasa manggil dia pakai nama itu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890618,
					"content": "Tapi setidaknya sekarang kita sudah punya izin untuk masuk ke Jantung Gunung Suci-nya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890619
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890619,
					"content": "Fuwaaa ... nguk ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890620
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890620,
					"content": "Cahaya di sini ... hilang ....",
