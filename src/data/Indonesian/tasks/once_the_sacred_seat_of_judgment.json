					"nextDialogs": [
						751890716
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890716,
					"content": "Intinya ... kita harus cari cara naikkan benda ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890712,
					"content": "Saran bagus, Paimon. Ini dunia terbalik ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751890713
					]
				},
				{
					"id": 751890713,
					"content": "Nguuk ... Fuwa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890714
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890714,
					"content": "\"Setuju. Aku juga sama sekali tidak menyangka utusan putih ini begitu hebat ... sungguh bijaksana. Benar-benar mengejutkan.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890715
					],
					"speakerTitle": "Pelayan Naga Sumber"
				},
				{
					"id": 751890715,
					"content": "Paimon enggak ngerti deh kenapa kalian kaget begitu ....",
