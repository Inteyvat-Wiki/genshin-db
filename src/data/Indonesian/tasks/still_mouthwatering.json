			"dialogs": [
				{
					"id": 740430201,
					"content": "Protes! Protes! Protes demi hak kerjaku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430202,
						740430204,
						740430206
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430202,
					"content": "Inti yang kamu cari ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430203
					]
				},
				{
					"id": 740430203,
					"content": "Eh? Coba kulihat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430204,
					"content": "Kenapa harus demo di sini ...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430205
					]
				},
				{
					"id": 740430205,
					"content": "Di mana kamu jatuh, ya harus berdiri lagi di tempat itu juga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430206,
					"content": "Kamu mau ngapain?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430207
					]
				},
				{
					"id": 740430207,
					"content": "Kamu benar-benar tidak punya pilihan. Ada orang yang mendirikan mesin-mesin aneh di beberapa tempat di atas tanah dan di dalam air. Cara mengenalinya mudah sekali kok, di sekitar mesin itu selalu ada cahaya aneh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430208
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430208,
					"content": "Tolong bereskan mesin-mesin itu dan berikan aku inti mesin yang ada di dalamnya. Totalnya ada <color=#00E1FFFF>7 buah</color>. Tolong ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Henri"
				}
			]
		},
