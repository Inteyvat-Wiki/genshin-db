			"dialogs": [
				{
					"id": 740430301,
					"content": "Oke, sudah kuterima total 7 buah Inti Misterius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430302
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430302,
					"content": "Sebenarnya kamu mau pakai buat apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430303
					]
				},
				{
					"id": 740430303,
					"content": "Mana kutahu? Bosku hanya bilang kalau dia butuh tujuh inti misterius dari mesin-mesin misterius itu. Bakal untung besar kalau bisa dapat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430304
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430304,
					"content": "Oh, begini saja! Hari ini aku dan Bos sudah janjian ketemu di sini untuk melaporkan kemajuan kerjaku. Nanti kalian tanya langsung saja ke dia? Toh aku perlu menunggu uang dari Bos dulu untuk bisa bayar kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430305
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430305,
					"content": "Kalau begitu apa boleh buat, ya sudah kita tunggu saja deh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740430306,
					"content": "Setelah menunggu beberapa saat ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740430307
					]
				},
				{
					"id": 740430307,
					"content": "Apa kabar Henri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430308
					],
					"speakerTitle": "\"Bos\""
				},
				{
					"id": 740430308,
					"content": "Sangat amat bagus, Bos! Ketujuh inti misterius yang Bos minta sudah ada di tanganku. Oh ya, biar kuperkenalkan juga partner kerjaku ... eh, nama kalian siapa ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430309
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430309,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430310
					]
				},
				{
					"id": 740430310,
					"content": "Errr ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430311
					],
					"speakerTitle": "\"Bos\""
				},
				{
					"id": 740430311,
					"content": "Eh, errr ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740430312,
					"content": "Eh? Kalian saling kenal? Kalau begitu bagus dong! Jadi begini, Bos ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430315
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430313,
					"content": "#\"Walah! Ternyata {NICKNAME}! Kenapa dia bisa ada di sini?!\"\\n\"Bos\" langsung ambil langkah seribu, tapi malah tertangkap oleh Hunter dan Turner yang muncul entah dari mana.\\n\\n",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740430314
					]
				},
				{
					"id": 740430315,
					"content": "Ampun! Aku minta ampun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430316
					],
					"speakerTitle": "\"Bos\""
				},
				{
					"id": 740430316,
					"content": "Wah, ternyata mereka berdua jago banget ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740430317,
					"content": "Jangan khawatir Bos, tidak mengancam nyawa kok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430318
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430318,
					"content": "Tentu saja, tentu saja nyawamu tidak terancam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430319
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 740430319,
					"content": "Untuk sementara ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430320
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 740430320,
					"content": "Se-Sementara ...?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430321
					],
					"speakerTitle": "\"Bos\""
				},
				{
					"id": 740430321,
					"content": "Tapi selanjutnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430322
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 740430322,
					"content": "Apakah kamu akan jadi ayam panggang atau hal lain di akhir ... Ya, semuanya bergantung pada sikapmu, bos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430323
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 740430323,
					"content": "Ahhh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430324
					],
					"speakerTitle": "\"Bos\""
				},
				{
					"id": 740430324,
					"content": "Kenapa kalian bisa ada di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740430325,
					"content": "Setelah pertemuan kita yang terakhir kali, kami memutuskan untuk mengawasi Henri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430326
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 740430326,
					"content": "Tunggu, kenapa mengawasi aku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430327
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430327,
					"content": "Tidak, kenapa kalian menjadikan aku target?! Jelas-jelas aku yang paling rajin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430328
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430328,
					"content": "Mesin yang kamu bongkar adalah perangkat yang digunakan oleh Institut Penelitian Fontaine untuk mengawasi dan mengoptimalisasi kualitas air.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430329
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 740430329,
					"content": "Huh? Bukannya mesin ini dipakai untuk membuat polusi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430330
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430330,
					"content": "Inti yang kamu bongkar berisikan mekanisme dan data hidrologi paling maju di Fontaine. Kami harap bisa ... berkenalan dengan rekan dagang kamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430331
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 740430331,
					"content": "Eh? Kenapa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430332,
						740430334
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430332,
					"content": "Henri! Kamu bohong!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430333
					]
				},
				{
					"id": 740430334,
					"content": "Gawat! Kita tertipu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430335
					]
				},
				{
					"id": 740430333,
					"content": "Tidak kok, kamu adalah penyelamatku. Bagaimana aku bisa bohong kepadamu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430335
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430335,
					"content": "Bos, kamu bohong kepadaku! Kamu ternyata menipuku untuk merusak benda yang penting begini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430336
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430336,
					"content": "A-Aku tidak sengaja ... Posisiku adalah yang paling rendah di ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430337
					],
					"speakerTitle": "\"Bos\""
				},
				{
					"id": 740430337,
					"content": "Apa? Bos, aku tidak dengar apa yang tadi kamu katakan. Aku rasa kamu tadi bilang \"aku tidak sengaja\" ... Bisa kamu ulangi lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430338
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 740430338,
					"content": "Ahhh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430339
					],
					"speakerTitle": "\"Bos\""
				},
				{
					"id": 740430339,
					"content": "Bos ini tampaknya lelah. Dia bahkan pingsan dengan mata terbuka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430340
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 740430340,
					"content": "Ehhh, ka-kami enggak sengaja juga loh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430341
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740430341,
					"content": "Kami memutuskan untuk tidak menanyakan hal ini lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430342
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 740430342,
					"content": "Eh? Benar enggak apa-apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430343
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740430343,
					"content": "Asalkan inti dan datanya tetap utuh, kami tidak peduli dengan mesinnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430344
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 740430344,
					"content": "Atasan juga bilang tidak masalah. Lagi pula, kami juga tidak mau terlalu mengganggu kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430345
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 740430345,
					"content": "Memang kenapa kalau menggangguku?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430346
					]
				},
				{
					"id": 740430346,
					"content": "Tidak apa-apa kok. Lihat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430347
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 740430347,
					"content": "Kita hanya sedang jalan-jalan saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430348
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 740430348,
					"content": "Lalu, kebetulan saja ketemu kamu, kan? Cuaca yang indah dan pertemuan yang indah juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430349
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 740430349,
					"content": "Tapi, akan selalu ada akhir di pertemuan yang indah. Kami ... harus permisi dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430350
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 740430350,
					"content": "Biarkan pertemuan yang indah ini tinggal dalam lubuk hatimu, atau ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430351
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 740430351,
					"content": "Sudah lupakan saja, itu akan lebih baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430352
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 740430352,
					"content": "Ehh ... Jadi sudah tidak ada masalah nih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430353
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430353,
					"content": "Kenapa? Memangnya kamu mau ada masalah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430354
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 740430354,
					"content": "Tidak, tidak! Haha, tentu saja tidak ada masalah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430355
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430355,
					"content": "*huff* Kukira ketemu orang yang baik hati yang bakal mengubah takdirku karena aku bekerja keras. Tampaknya, dunia ini banyak orang jahat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430356
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430356,
					"content": "Hei, Henri. Tolong bantu sebentar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430357
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 740430357,
					"content": "Huh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430358
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430358,
					"content": "Sungguh disayangkan, bos yang baik hati ini kehilangan akal sehatnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430359
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 740430359,
					"content": "Kami butuh seseorang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430360
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 740430360,
					"content": "yang bekerja dengan sungguh-sungguh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430361
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 740430361,
					"content": "dan bisa diandalkan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430362
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 740430362,
					"content": "Teman baik ... yang berharap mengubah takdirnya dengan bekerja keras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430363
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 740430363,
					"content": "Benar, seorang teman baik yang bisa membantu untuk membawa bos ini ke rumah persembunyian kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430364
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 740430364,
					"content": "Kami baru bisa bicara baik-baik dengan bos baik hati ini di sana ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430365
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 740430365,
					"content": "Tentu saja, kami juga akan menyampaikan rasa terima kasih kami ... melalui Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430366
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 740430366,
					"content": "Hmm? Iya! Aku juga mau ikutan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430367
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430367,
					"content": "Bagus! Terima kasih banyak! Dan juga terima kasih kepada, hmmm ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430368
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430368,
					"content": "#Namaku {NICKNAME}, dia Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430369
					]
				},
				{
					"id": 740430369,
					"content": "#Terima kasih kepada {NICKNAME} dan Paimon! Takdirku berubah setelah bertemu dengan kalian!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430370
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430370,
					"content": "Enggak usah sungkan! Kamu harus semangat ya, Henri! Jangan ketipu lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430371
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740430371,
					"content": "Ya, aku tidak akan ketipu lagi! Aku mau bekerja keras menjadi orang kaya! Lalu, menyewa orang bekerja untukku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430372
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430372,
					"content": "Hunter, Turner, dan Henri pun menggali keluar Fatui yang pingsan dan membawanya pergi.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740430373
					]
				},
				{
					"id": 740430373,
					"content": "Paimon harap Henri bisa jadi orang hoki ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430374
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740430374,
					"content": "Tunggu! Mana upah yang Henri bilang mau kasih kita?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}