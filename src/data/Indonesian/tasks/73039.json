			"dialogs": [
				{
					"id": 730390101,
					"content": "Festival Utsava adalah hari yang bahagia, dan mereka juga sudah introspeksi diri. Arapacati tidak seharusnya marah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390102
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730390102,
					"content": "Iya, Arapacati. Jangan marah-marah. Peristiwa bahagia harus dilalui dengan bahagia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390103
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730390103,
					"content": "Waktunya pamer hasil \"latihan masak\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390104
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730390104,
					"content": "Aku sudah siap dari tadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390105
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730390105,
					"content": "Hore! Makanan Festival Utsava! Paimon udah enggak sabar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390106,
						730390107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730390106,
					"content": "Hore! Makan-makan Festival Utsava!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730390108
					]
				},
				{
					"id": 730390108,
					"content": "Air terbaik Vanarana, bisa dibuat jadi sup terbaik juga. Nara pasti suka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390109
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730390109,
					"content": "#\"Rasa kebahagiaan\" ini khusus untuk Nara {NICKNAME} dan Paimon, jadi nanti Nara {NICKNAME} dan Paimon bisa \"membimbing\" para kakak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390110
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730390110,
					"content": "Ini satu-satunya cara untuk bikin masakan yang Nara suka. Tamu adalah raja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390111
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730390111,
					"content": "#Nara {NICKNAME}, boleh \"ajari\" mereka masak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730390107,
