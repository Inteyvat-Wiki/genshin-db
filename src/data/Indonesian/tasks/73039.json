				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Arapacati",
					"Arachatora",
					"Arasaka",
					"Arapas",
					"Araphala"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730391224,
					"content": "#Lebih baik minta bantuan {NICKNAME} saja, kalau enggak nanti hasilnya sama lagi, masaknya yang itu lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391201
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730391201,
					"content": "Mengikuti saran perbaikan dari Paimon, Aranara menyelesaikan masakan mereka sesuai instruksi.\\nSetelah itu, kamu menyantap makanannya bersama dengan Aranara ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730391202
					]
				},
				{
					"id": 730391202,
					"content": "Gimana? Enak enggak makanan Nara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730391203,
					"content": "#Memang Arapacati sih yang mengusulkan Nara {NICKNAME} mengajari masak ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391204
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730391204,
					"content": "Masakan Nara ... inikah \"rasa kebahagiaan\" Nara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391205
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730391205,
					"content": "Bahagianya mau kabur tuh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391206
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730391206,
					"content": "Air Vanarana adalah \"Air Minum Terbaik\" ... kok bisa hasilnya jadi seperti ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391207
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730391207,
					"content": "\"Unrivaled Fresh Fruit\" sih masih enak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391208
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730391208,
					"content": "Loh, kok gitu sih? Kalian enggak suka ya? Paimon suka banget nih, enak ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730391209,
					"content": "Kami tidak tahu \"tidak enak\" itu seperti apa, tapi rasa ini sangat ... \"mantap\", persis seperti lari dengan kecepatan penuh lalu menabrak pohon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391210
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730391210,
					"content": "Wih ... oke, anggap saja ini gara-gara beda budaya antara Nara sama Aranara ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730391211,
					"content": "#Kakak-kakak, bilang begitu tidak sopan. Kita harusnya bilang terima kasih sama Nara {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391212
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730391212,
					"content": "*hiks* ... Maaf ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391213
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730391213,
					"content": "Salah! Bilang \"terima kasih\" dong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391214
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730391214,
					"content": "#Terima kasih Nara {NICKNAME} ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391215
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730391215,
					"content": "#Tidak apa kok, yang penting Nara {NICKNAME} dan Paimon suka! Kalau teman Nara-ku gembira, kami juga gembira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391216
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730391216,
					"content": "#Tapi Nara {NICKNAME} beda sekali dengan Nara Varuna, yang terus bercerita tentang \"{M#kakak lelaki}{F#adik perempuan}\"nya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391217
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730391217,
					"content": "#Nara {NICKNAME} sangat pendiam, ya. Apa sedang tidak enak badan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391218
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730391218,
					"content": "#Emm ... {NICKNAME}, ngomong dong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391219,
						730391220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730391219,
					"content": "Terima kasih perhatiannya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730391222
					]
				},
				{
					"id": 730391222,
					"content": "#Oh ya? Aku senang. Sekali lagi, terima kasih. Kelopak ini dari Arapacati dan para kakak. Ini untukmu, Nara {NICKNAME} dan Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391223
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730391223,
					"content": "#Semoga Nara {NICKNAME} dan Paimon bisa dapat \"rasa kebahagiaan\" lebih banyak lagi di Vanarana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730391220,
					"content": "(Tetap diam)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730391221
					]
				},
				{
					"id": 730391221,
					"content": "#Arapacati jangan khawatir! {NICKNAME} baik-baik saja kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391222
					],
					"speakerTitle": "Paimon"
				}
			]
		},
