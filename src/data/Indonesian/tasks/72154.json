		{
			"id": 7215403,
			"completionStepIds": [
				7215403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7215403",
							"2"
						],
						"stepId": 7215403,
						"stateName": "QUEST_STATE_UNFINISHED"
