			},
			"dialogs": [
				{
					"id": 721540801,
					"content": "Sebenarnya mau syuting \"film\" apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540802
					]
				},
				{
					"id": 721540802,
					"content": "Oh! Pertanyaan bagus, sungguh pertanyaan yang bagus. Sejujurnya, belum terpikir juga olehku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540803
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540803,
					"content": "Bagiku, syuting \"film\" itu bisa tentang apa saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540804
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540804,
					"content": "Roman, misteri, laga, bahkan mitos fantasi yang tidak nyata sekalipun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540805
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540805,
					"content": "Tapi aku selalu merasa, \"film\" memiliki semacam daya tarik yang belum dapat kugali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540806
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540806,
					"content": "Namun, asalkan kita terus syuting \"film\", pasti suatu saat akan menemukan jawabannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				}
			]
		},
