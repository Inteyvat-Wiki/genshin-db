			"dialogs": [
				{
					"id": 721540401,
					"content": "\"Film pendekar\"... sebutan Tuan Xavier sungguh unik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540402,
						721540407
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540402,
					"content": "Bagaimana \"film\" ini menurutmu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540403
					]
				},
				{
					"id": 721540403,
					"content": "Para petinggi menganggap \"film\" ini bisa membantu menyebarkan popularitas samurai Shogunate",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540404
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540404,
					"content": "Mungkin aku agak bodoh menyangkut hal ini... Aku sungguh tidak ada perasaan apa pun terhadap hal ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540405
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540405,
					"content": "Lagi pula, dialog samurai di naskahnya terdengar putus asa, tak menampilkan harga diri samurai sama sekali",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540406
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540406,
					"content": "Kurang tahu kenapa para petinggi bisa setuju...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540407,
					"content": "Bagaimana dengan \"Mikage Furnace\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540408
					]
				},
				{
					"id": 721540408,
					"content": "Semenjak Tuan Hanbei \"naik jabatan\", penanggung jawab di sana digantikan oleh Yousuke.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540409
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540409,
					"content": "Dengan latar belakang seorang pengrajin, dia sangat bisa diandalkan dalam menangani banyak hal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540410
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540410,
					"content": "Di bawah tanggung jawabnya,\"Mikage Furnace\" harusnya tidak akan mendapat masalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Toranosuke"
				}
			]
		},
