			},
			"dialogs": [
				{
					"id": 721540301,
					"content": "Sempurna! Memang kamu adalah pahlawan di hatiku! Benar-benar sempurna sebagai aktor utama!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540302,
						721540304
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540302,
					"content": "A-apa maksudnya yang utama?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540303
					]
				},
				{
					"id": 721540303,
					"content": "Aktor utama, adalah aktor paling penting dalam sebuah \"film\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540306
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540306,
					"content": "Prajurit, apa kamu lihat jelas yang diperagakan Pengembara barusan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540307
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540307,
					"content": "Kurang lebih jelas. Saat mengayunkan pedang, aku harus menekankan \"postur\" bukan \"gerakan\", ya kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540308
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540308,
					"content": "Kalau soal \"postur\"... sebenarnya aku punya ide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540309
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540309,
					"content": "Oh? Baguslah, tolong sampaikan ke prajurit lain, kita coba sekali lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540310
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540310,
					"content": "Pengembara, terima kasih, terimalah ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540311
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540311,
					"content": "Apa tema \"film\" berikutnya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540312
					]
				},
				{
					"id": 721540312,
					"content": "Tema \"film\" berikutnya... Uh... sebenarnya aku masih ragu, banyak tema yang mau kucoba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540313
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540313,
					"content": "Misalnya berbagai tradisi di Kuil Agung Narukami, legenda musang dan rubah di Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540314
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540314,
					"content": "Inazuma adalah kepulauan, banyak sekali cerita yang bisa diangkat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540315
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540315,
					"content": "Tapi bagaimanapun, aku harus menyelesaikan \"Samurai Ketujuh\" dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540316
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540316,
					"content": "Kalau bisa membuat para petinggi puas, nanti saat membuat \"film\" di Inazuma, pasti akan dipermudah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540304,
					"content": "Mungkin lain kali aku ingin coba peran lain.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540305
					]
				},
				{
					"id": 721540305,
					"content": "Tidak masalah! setelah selesai merekam \"film\" ini, aku akan merencanakan \"film\" baru lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540306
					],
					"speakerTitle": "Xavier"
				}
			]
		},
