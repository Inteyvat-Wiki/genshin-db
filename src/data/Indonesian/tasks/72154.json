						721540602
					]
				},
				{
					"id": 721540602,
					"content": "Bagus, bravo! Kalau begitu, ayo kita mulai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540603
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540603,
					"content": "Aku perlu membuat sedikit perubahan pada Film Kamera ini dan memanggil para prajurit itu kembali...",
					"roleType": "TALK_ROLE_NPC",
