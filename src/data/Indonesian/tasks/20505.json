			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205050201,
					"content": "Kamu dapat mengutus orang dalam sebuah Ekspedisi kapan saja, dan mereka masih akan dapat bergabung dengan petualanganmu jika kamu membutuhkannya",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050202
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050202,
					"content": "Kamu dapat memilih durasi Ekspedisi. Setelah temanmu kembali, kamu bisa datang ke sini untuk mengonfirmasi hasilnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050203
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050203,
					"content": "Dengan meningkatnya Rank Adventure milikmu, semakin berbahaya juga ekspedisi yang tersedia untukmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050204
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050204,
					"content": "Lagi pula, dengan kekuatan besar maka muncul tanggung jawab yang besar pula!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 205050205,
					"content": "Ya tentunya, ini juga untuk keselamatan banyak orang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050206
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050206,
					"content": "Terima kasih atas bantuanmu, kuharap kamu dan teman-temanmu bisa banyak membantu ekspedisi kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				}
			]
		}
	]
}