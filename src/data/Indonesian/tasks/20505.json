					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205050101,
					"content": "Maaf karena mengganggumu lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050102,
						205050104
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050102,
					"content": "Tidak masalah, biasanya akulah yang dibantu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050103
					]
				},
				{
					"id": 205050103,
					"content": "Ah baguslah kalau begitu, baiklah biar kukatakan versi singkatnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050106
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050106,
					"content": "Terima kasih karena telah menyelesaikan misi tepat waktu, reputasi Guild meningkat karena ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050107
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050107,
					"content": "Dan karena ini pula, kami menerima banyak permintaan lebih dari sebelumnya sehingga para petualang menjadi sangat sibuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050108
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050108,
					"content": "Apa kamu mau kita merekrut anggota baru?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 205050109,
					"content": "Ah, tidak perlu, terima kasih atas tawarannya. Aku juga berharap banyak anggota baru yang ingin bergabung...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050110
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050110,
					"content": "Tapi mencari anggota baru sekarang ini tidak akan langsung menyelesaikan masalah kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050111
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050111,
					"content": "Jadi maksudku adalah, apa temanmu ada waktu untuk membantu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050112,
						205050114
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050112,
					"content": "Aku perlu berdiskusi dulu dengan mereka.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050113
					]
				},
				{
					"id": 205050113,
					"content": "Baiklah, terima kasih banyak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050117
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050117,
					"content": "Singkatnya, sekarang ini kami membutuhkan banyak orang untuk <color=#00E1FFFF>ekspedisi</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050118
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050118,
					"content": "Ekspedisi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050119
					]
				},
				{
					"id": 205050119,
					"content": "Kami megatur ekspedisi untuk memeriksa daerah di sekitar kota, seperti potensi bahaya, atau aktivitas mencurigakan di reruntuhan, dan sebagainya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050120
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050120,
					"content": "Karena ekspedisi bukan misi yang diminta oleh pihak ketiga, sehingga tidak ada batasan waktu untuk menyelesaikannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050121
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050121,
					"content": "Namun jika kita membiarkannya terlalu lama, aku khawatir masalah kecil akan menjadi besar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050122
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050122,
					"content": "Jadi itu termasuk hal penting...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050123,
						205050125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 205050123,
					"content": "Teman-teman seharusnya bisa mengerti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050124
					]
				},
				{
					"id": 205050124,
					"content": "Kamu hanya perlu membujuk mereka untuk membantu. Sisanya serahkan saja padaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050127
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050127,
					"content": "Baiklah, sekarang biar kujelaskan ekspedisi yang ada sekarang ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050128
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050128,
					"content": "Konfirmasi \"Ekspedisi\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 205050125,
					"content": "Bagaimana dengan hadiahnya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050126
					]
				},
				{
					"id": 205050126,
					"content": "Tenanglah, Guild tidak akan mengambil keuntungan apa pun dari ekspedisi. Semua hadiah akan diberikan untukmu dan teman-temanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050127
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050114,
					"content": "Kamu ingin aku membujuk semua temanku untuk bergabung ke dalam Guild?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050115
					]
				},
				{
					"id": 205050115,
					"content": "Tidak, tidak, kamu salah paham. Aku mengerti temanmu datang dari banyak kalangan berbeda, aku tidak bisa meminta mereka untuk bergabung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050116
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050116,
					"content": "Ini hanyalah sekadar permintaan tambahan dari Guild.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050117
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050104,
					"content": "Apa ada hadiah baru yang dapat diambil?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050105
					]
				},
				{
					"id": 205050105,
					"content": "Haha... benar sekali! Sepertinya kamu tertarik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050106
					],
					"speakerTitle": "Katheryne"
				}
			]
		},
		{
			"id": 2050502,
			"completionStepIds": [
				2050502
			],
