			"dialogs": [
				{
					"id": 220420301,
					"content": "Kamu sudah kembali. Apa kamu sudah memberi mereka makan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420302
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420302,
					"content": "Sudah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220420303
					]
				},
				{
					"id": 220420303,
					"content": "Bagus, bagus. Aku berterima kasih padamu. Tanpa bantuanmu, anak-anak itu pasti akan main terus ... lalu mereka akan kelaparan di luar sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420304
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420304,
					"content": "*huff* Mereka benar-benar segerombolan anak-anak bandel. Bagaimana mereka bisa menyambut orang-orang yang datang ke kuil kalau terus begini ....",
