			"dialogs": [
				{
					"id": 220420401,
					"content": "Kamu sudah kembali. Aneh sekali. Anak-anak itu tiba-tiba semuanya kembali, dan mereka terlihat ketakutan juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420402
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420402,
					"content": "Apa mereka ketemu monster di luar sana ya, itu loh yang suka bawa-bawa tongkat, tahu kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420403
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420403,
					"content": "Tapi, yang penting mereka kembali saja... Tunggu, kamu kenapa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420404
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420404,
					"content": "Uh, sebenarnya, aku...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220420405
					]
				},
				{
					"id": 220420405,
					"content": "... Kamu... manusia kurang ajar! Apa yang merasukimu sampai kamu berbuat begitu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420406
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420406,
					"content": "Kamu bisa main dengan mereka pakai cara yang biasa saja kan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420407
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420407,
					"content": "Meong! Tidak heran mereka begitu ketakutan... Kamu harus pergi dan menghibur mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420408
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420408,
					"content": "Benar-benar deh. Sepertinya memang berlebihan sekali ya jika meminta semua manusia untuk seperti Hibiki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
