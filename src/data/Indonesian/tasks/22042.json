			"dialogs": [
				{
					"id": 220420101,
					"content": "Benar-benar anak yang tidak mau dengar apa kata kucing...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420102
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420102,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220420103
					]
				},
				{
					"id": 220420103,
					"content": "Ah, kamu toh. Lihat, mereka masih kabur-kaburan. Semakin lama mereka semakin nakal saja ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420104,
						220420105
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420104,
					"content": "Apa kamu butuh bantuan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220420106
					]
				},
				{
					"id": 220420106,
					"content": "Karena kamu sudah menggantungkan bola besi di sekitar kuil, sekarang diriku percaya bahwa mereka akan bisa menemukan jalan pulang ke sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420107
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420107,
					"content": "Sepertinya tidak ada salahnya membiarkan mereka untuk sedikit liar di luar sana, asal jangan sampai mereka berbuat bodoh di depan para manusia dan menodai martabat kuil ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420108
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420108,
					"content": "Tapi kalau mereka sampai kelewatan dan kelaparan dari siang sampai malam ... Itu juga tidak baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420109
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420109,
					"content": "Baiklah, tolong bawa ikan-ikan ini kepada mereka agar mereka bisa makan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420110,
						220420113
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420110,
					"content": "Baiklah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220420111
					]
				},
				{
					"id": 220420111,
					"content": "Ayo berikan peta kita ke Neko untuk ditandai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220420112,
					"content": "Hmm, kamu peka juga rupanya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420115
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420115,
					"content": "Baiklah. Pergilah, dan cepatlah. Masih ada urusan kuil yang masih harus kukerjakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420113,
					"content": "Ini peta kami...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220420114
					]
				},
				{
					"id": 220420114,
					"content": "Hmm, kamu peka juga rupanya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420115
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420105,
					"content": "Kamu ingin kita mencari mereka?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220420106
					]
				}
			]
		},
