					}
				]
			},
			"dialogs": [
				{
					"id": 740300201,
					"content": "Pas sekali kalian datangnya. Bantu dong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300202,
						740300206
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300202,
					"content": "Bisa telepati? Ngeri ah!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300203
					]
				},
				{
					"id": 740300203,
					"content": "Galvaryet yang kirim kami ke sini ... Tapi kok kamu tahu sih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740300204,
					"content": "Soalnya cuma ada kalian di sini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300205
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300205,
					"content": "Benar juga sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740300210,
					"content": "Ngomong-ngomong, pekerjaannya tidak terlalu sulit sih. Jadi Terminal Penelitian di sini harus dioperasikan dua orang bersamaan. Kalau perintahnya sih sudah selesai aku masukkan. Jadi kalian cuma perlu tarik tuasnya saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300211
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300211,
					"content": "Oh ya aku hampir lupa. Perangkat penyimpanan energinya harusnya ada di sekitar. Tolong pasangkan dulu ya sebelum diaktifkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300212
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300212,
					"content": "Terus ... Aku mau konfirmasi dulu. Kalian bukan pembunuh mesin, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300213,
						740300214
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300213,
					"content": "Tergantung definisimu tentang pembunuh mesin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300215
					]
				},
				{
					"id": 740300215,
					"content": "Kok tanya begitu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740300216,
					"content": "Terakhir aku minta tolong ke Galvana. Baru meleng sedikit, Terminal Penelitiannya sudah hancur. Waktu aku tanya, dia malah bilang tidak tahu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300217
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300217,
					"content": "Aku baru tahu dari adiknya, kalau tidak ada mesin buatan yang bisa bertahan lebih dari setengah hari di hadapannya. Aku rasa sih Alain Guillotin pun juga bakalan angkat tangan deh kalau ketemu sama dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300218
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300218,
					"content": "Jadi biaya perbaikannya kemarin dikurangi dari imbalanku ... Kalau kalian sama kayak dia, kerja kerasku selama ini malah jadi sia-sia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300219
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300219,
					"content": "Oh, ada yang begituan ya? Kami sih dijamin enggak kayak dia kok. Tenang saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740300220,
					"content": "Kalau begitu, tolong ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300214,
					"content": "Kalau Terminal Penelitian-nya menyerangku sih, jelas akan disikat habis ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300215
					]
				},
				{
					"id": 740300206,
					"content": "Boleh, tapi bayar ya!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300207
					]
				},
				{
					"id": 740300207,
					"content": "Aku akan minta Galvaryet untuk membayar kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300208
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300208,
					"content": "Eh? Dia malah bilang mintanya sama kamu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740300209,
					"content": "Begitu ya? Ya sudah lah. Mengajukan pendanaan di sini lebih sulit daripada di Institut Penelitian Fontaine ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300210
					],
					"speakerTitle": "Clynes"
				}
			]
		},
		{
			"id": 7403003,
