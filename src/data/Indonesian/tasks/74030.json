			},
			"dialogs": [
				{
					"id": 740300101,
					"content": "Halo. Ada yang bisa dibantu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300102,
						740300105
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740300102,
					"content": "Tolong bantu kami, kak penyihir yang baik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300103
					]
				},
				{
					"id": 740300103,
					"content": "Kok kamu jadi ikut-ikutan bicara kayak Lanoire sih? Langsung ke intinya deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300104
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740300104,
					"content": "Kami butuh Kupon Khusus yang banyak banget! Kira-kira kamu bisa kasih kami kerjaan enggak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740300107,
					"content": "Kalian tidak ikutan permainan Estienne, kan? Kalian harus tahu kapan harus berhenti ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300108
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740300108,
					"content": "Tapi, kebetulan aku memang perlu bantuan kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300109
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740300109,
					"content": "Clynes sekarang sedang memperbaiki alat di Rift of Erosion. Kalian bantu dia deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300110
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740300110,
					"content": "Kalau soal imbalan, langsung minta sama dia saja. Dia pasti tidak keberatan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300111
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740300111,
					"content": "Ya sudah, serahkan saja pada kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740300105,
					"content": "Apa ada yang bisa kami bantu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300106
					]
				},
				{
					"id": 740300106,
					"content": "Kalau ada imbalan sih lebih bagus ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300107
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7403002,
