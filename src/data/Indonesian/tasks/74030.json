						],
						"pointId": 6254
					}
				]
			},
			"dialogs": [
				{
					"id": 740300401,
					"content": "Kalian kayaknya terlatih sekali. Kalau bukan di tempat kayak gini, kalian pasti sudah aku minta jadi asisten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300402
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300402,
					"content": "Heh, yang kayak gini sih kecil buat kami mah. Oh ya, itu mesin buat apaan sih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740300403,
					"content": "Jadi awalnya ada celah yang mengarah keluar di sini, jadi harus dijaga. Sekarang aku pakai mekanisme pengunci untuk menyegel jalannya, jadi bisa hemat tenaga manusia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300404
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300404,
					"content": "Teknik ini sih bukan hal baru ya di Institut Penelitian Fontaine. Tapi, yah, karena punya banyak waktu luang, jadi aku buat sedikit perubahan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300405
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300405,
					"content": "Yang kalian lihat sekarang belum versi yang sempurna. Versi yang sempurna sedang dipakai di Tambang Geode ... ehem ... Mulutku bocor lagi. Anggap saja kalian tidak dengar apa-apa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300406,
						740300408
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300406,
					"content": "Jadi ada jalan keluar dari Tambang Geode.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300407
					]
				},
				{
					"id": 740300407,
					"content": "Duh, benar sih. Kamu pintar sekali. Kalau lebih pintar lagi, seharusnya kalimat tadi cuma perlu diingat saja, tidak usah diucapkan keluar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300411
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300411,
					"content": "Ya sudah. Masalahnya sudah selesai. Galvana tidak perlu sering menjaga di sini lagi. Aku juga bisa istirahat sebentar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300412
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300412,
					"content": "Oh ya, hampir lupa. Ini imbalan kalian. Terima kasih ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300408,
					"content": "Memangnya versi sempurnanya lebih kuat?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300409
					]
				},
				{
					"id": 740300409,
					"content": "Tentu saja dong! Masih ada komponen tambahan ... eh, kamu ngapain sih banyak nanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300410
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300410,
					"content": "Kalau memang mau tahu lebih jelasnya, bisa coba sendiri kok. Tapi kalau sampai ketangkap, jangan ungkit-ungkit namaku ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300411
					],
					"speakerTitle": "Clynes"
				}
			]
		}
	]
}