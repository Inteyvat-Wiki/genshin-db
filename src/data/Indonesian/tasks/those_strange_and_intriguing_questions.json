			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4020401",
							"2"
						],
						"stepId": 4020401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fadaweh",
					"Atashye",
					"Darwish"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 402040101,
					"content": "Atashye, aku sudah sabar banget loh ya ... tapi laporan-laporan ini semuanya tidak berguna!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040102
					],
					"speakerTitle": "Fadaweh"
				},
				{
					"id": 402040102,
					"content": "Nih, baca sendiri! \"Mungkin\", \"barang kali\", \"sepertinya\" ... gimana cara hitung matematikanya kalau datanya semua TIDAK PASTI?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040103
					],
					"speakerTitle": "Fadaweh"
				},
				{
					"id": 402040103,
					"content": "I-Itu ... waktu! Waktunya kurang! Dan aku ini anak Kshahrewar. Gimana caranya aku tahu cara mengukur pengaruhnya terhadap makhluk hidup ... mi-mi-misalnya, ke Fungus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040104
					],
					"speakerTitle": "Atashye"
				},
				{
					"id": 402040104,
					"content": "Gi-Gimana caranya coba? Masa aku harus kasih tangan ke mulut Fungus, biar digigit sama dia? Buat apa? Bi-Biar bisa tulis \"Hmm, gigitannya kuat sekali, di luar dugaan\"?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040105
					],
					"speakerTitle": "Atashye"
				},
				{
					"id": 402040105,
					"content": "Darwish, kamu kan anak Darshan Amurta. Kasih tahu dia lah, tolong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040106
					],
					"speakerTitle": "Atashye"
				},
				{
					"id": 402040106,
					"content": "Haha, mau melibatkan aku? Yah, kita bisa mulai dari betapa parahnya pemahamanmu tentang biologi dasar. Kebanyakan Fungus tidak punya mulut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040107
					],
					"speakerTitle": "Darwish"
				},
				{
					"id": 402040107,
					"content": "Ha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040108
					],
					"speakerTitle": "Fadaweh"
				},
				{
					"id": 402040108,
					"content": "Tapi Fadaweh, di tahap ini aku juga tidak perlu hitungan matematika yang mutlak. Topik penelitian kita juga targetnya bukan para tua bangka di Akademiya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040109
					],
					"speakerTitle": "Darwish"
				},
				{
					"id": 402040109,
					"content": "Tujuan proyek ini adalah untuk mengajar anak-anak. Isinya harus menarik, sedikit bumbu imajinasi tuh bagus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040110
					],
					"speakerTitle": "Darwish"
				},
				{
					"id": 402040110,
					"content": "O-Oh ... gitu. Berarti ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040111
					],
					"speakerTitle": "Fadaweh"
				},
				{
					"id": 402040111,
					"content": "Hmph! Fadaweh, kamu ya, bisa-bisanya beda banget waktu ngomong ke Darwish dan ke aku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040112
					],
					"speakerTitle": "Atashye"
				},
				{
					"id": 402040112,
					"content": "Sudah, jangan debat. Aku sudah selesaikan semua bagianku, dan sudah bikin revisi kesimpulan Atashye juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040113
					],
					"speakerTitle": "Darwish"
				},
				{
					"id": 402040113,
					"content": "Datanya bisa disesuaikan setelah uji coba selesai. Memang itu juga tujuannya kita adain uji coba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040114
					],
					"speakerTitle": "Darwish"
				},
				{
					"id": 402040114,
					"content": "A-Ah, Darwish memang beda ... senior, berkepala dingin, dan bekerja rapi! Beda banget sama seseorang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040115
					],
					"speakerTitle": "Fadaweh"
				},
				{
					"id": 402040115,
					"content": "Ya, ya, ya ... aku tidak mau dengar siapa itu \"seseorang\"-nya",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040116
					],
					"speakerTitle": "Atashye"
				},
				{
					"id": 402040116,
					"content": "Kalian berdua, sudah? Persiapan terakhir nih, terakhir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040117
					],
					"speakerTitle": "Darwish"
				},
				{
					"id": 402040117,
					"content": "Si-Siap!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040118
					],
					"speakerTitle": "Fadaweh"
				},
				{
					"id": 402040118,
					"content": "Catnya sudah kering belum ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040119
					],
					"speakerTitle": "Atashye"
				},
				{
					"id": 402040119,
					"content": "Dan sekarang, kelinci percobaannya ... kalian berdua mau?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040120
					],
					"speakerTitle": "Darwish"
				},
				{
					"id": 402040120,
					"content": "Kalian dari tadi asyik saja nonton kami dari sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040121
					],
					"speakerTitle": "Darwish"
				},
				{
					"id": 402040121,
					"content": "Hah? Kami?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402040122,
					"content": "Iya, kalian. Kalau mau jadi kelinci percobaan, kalian boleh makan buah sepuasnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040123,
						402040125
					],
					"speakerTitle": "Darwish"
				},
				{
					"id": 402040123,
					"content": "Mau suruh kami jadi tukang icip buah?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402040124
					]
				},
				{
					"id": 402040124,
					"content": "Bukan sih ... hmm, gimana ya jelasinnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040130
					],
					"speakerTitle": "Darwish"
				},
				{
					"id": 402040130,
					"content": "Mulai dari pertanyaan ini dulu deh. Hmm ... \"Kira-kira siapa yang menang kalau Stretchy Pyro Fungus diadu sama Rishboland Tiger?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040131,
						402040134,
						402040137
					],
					"speakerTitle": "Darwish"
				},
				{
					"id": 402040131,
					"content": "Stretchy Pyro Fungus, soalnya bisa meluncur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402040132
					]
				},
				{
					"id": 402040132,
					"content": "Yakin? Lebih mungkin Rishboland Tiger dong ... cakarnya panjang, kuat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402040133,
					"content": "Pertanyaan macam apa ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040140
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402040140,
					"content": "Masih ada lagi. \"Lebih kuat Floating Anemo Fungus atau Anemo Slime?\", \"Lebih jago Eremite atau pejuang Saurian bangsa Natlan? Tambah lagi Kairagi ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040141
					],
					"speakerTitle": "Darwish"
				},
				{
					"id": 402040141,
					"content": "Seperti itulah pertanyaan yang terlontar dari mulut anak-anak ketika kami mengajar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040142
					],
					"speakerTitle": "Darwish"
				},
				{
					"id": 402040142,
					"content": "Anak kecil memang hobi banget ngebanding-bandingin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040143
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402040143,
					"content": "Tapi rasa penasaran yang besar itu justru fondasi awal pembelajaran! Karena mereka \"ingin tahu\" ... kami jadi buat ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040144
					],
					"speakerTitle": "Darwish"
				},
				{
					"id": 402040144,
					"content": "Kami membuat \"Primbon Petualangan Pamong Praja\", terinspirasi dari kisah dunia nyata! Anak-anak bisa membentuk regu petualang sendiri, untuk kemudian diadu satu sama lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040145
					],
					"speakerTitle": "Darwish"
				},
				{
					"id": 402040145,
					"content": "Atashye sedang meneliti pengaruh makanan dan lingkungan terhadap berbagai makhluk, sementara Fadaweh membantu membuat model \"simulasi perkembangan\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040146
					],
					"speakerTitle": "Darwish"
				},
				{
					"id": 402040146,
					"content": "Simulasi perkembangan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402040147
					]
				},
				{
					"id": 402040147,
					"content": "Ya! Kan salah jadinya kalau kita membiarkan anak-anak berinteraksi dengan Fungus dan Eremite di dunia nyata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040148
					],
					"speakerTitle": "Darwish"
				},
				{
					"id": 402040148,
					"content": "Bagaimana? Kalau ada waktu, ikutlah uji cobanya. Kalian membantu penelitian, sekaligus mendapat pengalaman akademis yang berharga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040149
					],
					"speakerTitle": "Darwish"
				},
				{
					"id": 402040149,
					"content": "#Kayaknya keren juga tuh, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040150
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402040150,
					"content": "Oke deh, \"Paimon si Paling Bijaksana\" memang perlu banget pengalaman akademis.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402040151
					]
				},
				{
					"id": 402040151,
					"content": "HEH! Ngejek Paimon terus. Paimon nih otaknya sudah encer dari sananya ya, dan sebentar lagi bakal jadi lebih encer! Ayo, penelitian! Siapa takut!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040152
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402040152,
					"content": "#Kami sangat senang kalau {NICKNAME} yang baik mau ikut serta. Dan tentunya, \"Paimon si Paling Pintar dan Bijaksana\" juga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040153
					],
					"speakerTitle": "Darwish"
				},
				{
					"id": 402040153,
					"content": "Tinggal bilang saja kalau mau coba. Nanti aku kasih tahu aturan mainnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Darwish"
				},
				{
					"id": 402040134,
					"content": "Rishboland Tiger lah!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402040135
					]
				},
				{
					"id": 402040135,
					"content": "Rishboland Tiger, tanpa debat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402040136,
					"content": "Pertanyaan macam apa ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040140
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402040137,
					"content": "Rishboland Tiger, soalnya bisa meluncur!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402040138
					]
				},
				{
					"id": 402040138,
					"content": "Rishboland Tiger dari mana bisa meluncur?! Celestia?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402040139,
					"content": "Siapa sih yang nanya topik ngaco kayak gini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040140
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402040125,
					"content": "Eh, kami cukup nonton yang lagi debat saja, makasih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402040126
					]
				},
				{
					"id": 402040126,
					"content": "WOI, kita jadi kayak orang kepo kurang kerjaan kalau kamu ngomongnya gitu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402040127,
					"content": "Kita dengar dulu, baru putusin. Gimana? Paimon penasaran sama buah ... sama PENELITIAN-nya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402040128,
					"content": "Ah, rasa penasaran tinggi begini, aku kira petualangan kalian juga pasti selalu lancar dan beruntung ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040129
					],
					"speakerTitle": "Darwish"
				},
				{
					"id": 402040129,
					"content": "Nah, aku jelaskan soal penelitiannya. Hmm, dari mana ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040130
					],
					"speakerTitle": "Darwish"
				}
			]
		},
