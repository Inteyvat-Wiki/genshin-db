					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402040202
					],
					"speakerTitle": "Darwish"
				},
				{
					"id": 402040202,
					"content": "Yuk.",
					"roleType": "TALK_ROLE_PLAYER",
