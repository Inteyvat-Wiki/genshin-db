	"talks": [
		{
			"id": 7604901,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7604901",
							"2"
						],
						"stepId": 7604901,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"\"The Damselette\""
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2130.918,
							108.955,
							11206.71
						],
						"pointId": 360300003
					}
				]
			},
			"dialogs": [
				{
					"id": 760490101,
					"content": "Hmm, terlalu tinggi setengah nada. Kita coba lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490102
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760490102,
					"content": "Halo Columbina~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490103,
					"content": "Kamu lagi ... ngajarin Kuuhenki main lira?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490104,
					"content": "Iya. Mereka senang sekali liranya diperbaiki, dan jadi nempel terus ke aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490105
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760490105,
					"content": "Aku kurang mahir main lira. Lebih suka dengar orang lain main.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490106
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760490106,
					"content": "Ohh, iya juga. Kalau kamu anggota band, kayaknya kamu paling pas jadi vokalisnya sih ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490107,
					"content": "Tapi kalau bicara alat musik ... si bestie nih termasuk jenius! Lira kek, gendang kek, dia bisa semua!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490108,
						760490109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490108,
					"content": "Ah, biasa saja kok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490110
					]
				},
				{
					"id": 760490110,
					"content": "Begitukah? Kalau begitu ... boleh tolong ajari mereka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490111,
						760490112
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760490111,
					"content": "Boleh-boleh saja sih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490113
					]
				},
				{
					"id": 760490113,
					"content": "Aku tadi minta mereka iringi lagu yang biasa aku nyanyikan. Mungkin kamu ingat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490114
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760490114,
					"content": "Atau ... terserah saja mau main apa. Kuuhenki jarang sekali mendengarkan musik dari daerah lain. Aku juga tertarik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490115
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760490115,
					"content": "(Hmm, main apa ya?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490202,
						760490801
					]
				},
				{
					"id": 760490202,
					"content": "Coba yang biasa dinyanyiin sama Columbina deh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490201
					]
				},
				{
					"id": 760490201,
					"content": "(Lagu apa nih bagusnya ....)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490603,
						760490701
					]
				},
				{
					"id": 760490603,
					"content": "Coba yang tenang, yang lembut ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490604
					]
				},
				{
					"id": 760490604,
					"content": "Bagus sekali. Kamu benar-benar sudah hafal laguku ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490605
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760490605,
					"content": "Hehe, soalnya kamu nyanyinya merdu banget. Setiap dengar suara kamu, kami juga suka diam nyimak dulu gitu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490606,
					"content": "Hmm, para Kuuhenki juga kelihatannya terpesona dengan pertunjukan barusan. Mungkin mereka sudah belajar sesuatu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490607
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760490607,
					"content": "Mungkin ke depannya, aku akan minta tolong lagi perihal ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490608
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760490608,
					"content": "Ulurkan tanganmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490609
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760490609,
					"content": "Hah? Jangan, buat apa?! Kami sukarela kok ngajarinnya, enggak usah bayar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490610,
					"content": "Hmm? Bayar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490611
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760490611,
					"content": "Aku cuma berpikir ... kalau terang bulan yang lembut sangat cocok sekali untuk mengiringi lagu yang begitu merdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760490701,
					"content": "Lagu ceria boleh lah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490702
					]
				},
				{
					"id": 760490702,
					"content": "Oh, sudah selesai? Padahal aku masih mau dengar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490703
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760490703,
					"content": "Seperti yang aku pernah cerita, hanya lagu pengantar tidur ini saja yang aku ingat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490704
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760490704,
					"content": "Maknanya masih belum tahu, tapi setelah mendengar kamu tadi, rasanya jawaban yang menungguku di bulan sana ... pasti sangat indah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490705
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760490705,
					"content": "Sini tanganmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490706
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760490706,
					"content": "Ampun ih, enggak usah kasih apa-apa juga kali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490707,
					"content": "Ah, bukan seperti itu maksudnya ... aku hanya ingin menghiasi lagumu dengan terang bulan yang lembut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760490801,
					"content": "Lagu dari daerah lain kali ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490802
					]
				},
				{
					"id": 760490802,
					"content": "Menarik ... aku sudah pernah dengar melodi seperti ini sebelumnya, tapi permainanmu barusan memberikan dimensi baru ke dalam lagunya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490803
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760490803,
					"content": "Ah, soalnya si bestie mainnya dari hati, yang dikeluarin tuh ikatan dia sama tempat asal lagunya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490804,
					"content": "Yang bikin penasarannya ... aku seperti bisa membayangkan bentang alam tempat tersebut hanya dari mendengarkan lagu tadi. Kira-kira aslinya jauh beda tidak ya dari yang dibayangkan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490805
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760490805,
					"content": "Makanya, kamu harus lihat sendiri! Kami siap jadi pemandu wisatanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490806,
					"content": "Mm, mungkin. Suatu hari nanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760490112,
					"content": "Tapi mau main lagu apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490113
					]
				},
				{
					"id": 760490109,
					"content": "Tapi memang suka ngulik sih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490110
					]
				}
			]
		},
