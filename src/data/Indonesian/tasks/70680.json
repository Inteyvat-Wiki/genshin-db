					{
						"sceneId": 48000,
						"position": [
							43.884,
							0.49,
							41.953
						],
						"pointId": 11
					}
				]
			},
			"dialogs": [
				{
					"id": 706800101,
					"content": "Tamu yang terhormat, silakan lewat sini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706800102
					],
					"speakerTitle": "Wolfy"
				},
				{
					"id": 706800102,
					"content": "Aku ada kabar baik. Memang ternyata persiapannya lebih makan waktu dari yang diperkirakan, tapi panggung baru kita akhirnya sudah siap!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706800103
					],
					"speakerTitle": "Wolfy"
				},
				{
					"id": 706800103,
					"content": "Mainkan pertunjukan paling spektakuler untuk para hadirin, dan kunci pintu menuju Dunia dalam lukisan akan diberikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706800104
					],
					"speakerTitle": "Wolfy"
				},
				{
					"id": 706800104,
					"content": "Eh, bentar dulu! Sebelumnya sudah buku cerita, sekarang dunia dalam lukisan? Tempat ini makin lama makin aneh saja deh rasanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706800105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706800105,
					"content": "Aku mengerti kok! Tapi seperti cerita yang aku baca di buku, kalau pesulap memberi tahu semua triknya ke penonton ya jadi tidak seru dong, tidak ada kejutan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706800106
					],
					"speakerTitle": "Wolfy"
				},
				{
					"id": 706800106,
					"content": "Makin bagus malah kalau makin tidak masuk akal. Ilmunya Nona Penyihir ibarat cinta: bukan untuk dipahami, namun dirasakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706800107
					],
					"speakerTitle": "Wolfy"
				},
				{
					"id": 706800107,
					"content": "Okelah kalau begitu, minimal ada penjelasannya yang agak bisa diterima. Nah, soal dunia dalam lukisan ini ... bedanya apa sama panggung lainnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706800108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706800108,
					"content": "Dunia dalam lukisan punya banyak aturan. Panggung ini akan menguji persahabatan dan kepercayaan ... cerita klasik lah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706800109
					],
					"speakerTitle": "Wolfy"
				},
				{
					"id": 706800109,
					"content": "Dan yang berhasil melewati ujiannya akan mendapat berkat dari Nona Penyihir ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706800110
					],
					"speakerTitle": "Wolfy"
				},
				{
					"id": 706800110,
					"content": "Asyik! Apaan nih berkatnya? Mantra keberuntungan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706800111,
						706800112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706800111,
					"content": "Jangan sembarangan minta-minta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706800113
					]
				},
				{
					"id": 706800113,
					"content": "Ah! Benar juga. Jangan gegabah, jangan minta-minta ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706800114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706800114,
					"content": "Kalian tidak perlu khawatir. Cat sudah disapukan ke atas kanvas, dan berkat Nona Penyihir pun sudah bukan rahasia lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706800115
					],
					"speakerTitle": "Wolfy"
				},
				{
					"id": 706800115,
					"content": "Kalau sudah siap, masuklah ke dunia dalam lukisan dan lihat saja sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706800116
					],
					"speakerTitle": "Wolfy"
				},
				{
					"id": 706800116,
					"content": "Begitu kalian berangkat, jalani petualangan ini seperti di dalam cerita: \"senandungkan nada keceriaan, tanggalkan segala kegalauan, dan melangkahlah dengan gagah berani\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wolfy"
				},
				{
					"id": 706800112,
					"content": "Kayaknya sih bukan. Lagian ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706800113
					]
				}
			]
		}
	]
}