				"points": []
			},
			"dialogs": [
				{
					"id": 710070101,
					"content": "Bagaimana dengan lukisanmu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710070102
					]
				},
				{
					"id": 710070102,
					"content": "Sejak kedua mata patung itu mulai bercahaya, aku terus berada di sampingnya untuk melukis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070103
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070103,
					"content": "Tapi, bagaimana ya mengatakannya... Aku selalu merasa belum bisa melukis lukisan yang indah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070104
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070104,
					"content": "Aku selalu merasa ada sesuatu yang kurang dengan lukisanku... apakah kamu bisa memahami?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070105
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070105,
					"content": "Seperti sebuah masakan, entah pakai bahan atau cara apa, semuanya akan terasa lezat, tapi... tapi selalu ada sesuatu yang kurang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070106
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070106,
					"content": "Ah, aku tidak tahu bagaimana mengungkapkannya, dan aku juga tidak mengerti perasaan ini, jadi aku hanya bisa terus menggambarkannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070107
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070107,
					"content": "Hahaha, aku tidak takut kamu menertawakanku, kepalaku sedikit pusing saat aku menggambarnya, aku ingin memejamkan mataku dan istirahat sejenak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070108
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070108,
					"content": "Tapi entah kenapa, saat aku memejamkan mataku, tiba-tiba aku kembali melihat mata yang bersinar dari dua patung itu... tepat di depan mataku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070109
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070109,
					"content": "Jadi aku kembali ke sini untuk beristirahat, di sini aku seharusnya tidak bisa melihat mata kedua patung itu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070110
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070110,
					"content": "Oh iya, terimalah lukisan ini. Aku rasa ini adalah lukisan terbaikku sejauh ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070111
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070111,
					"content": "Jangan hiraukan omonganku, aku pasti terlalu lelah, istirahat sebentar juga akan baikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070112
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070112,
					"content": "Tapi lukisanku ini, sebenarnya kurang apa ya? Rasanya ada yang kurang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vermeer"
				}
			]
		}
	]
}