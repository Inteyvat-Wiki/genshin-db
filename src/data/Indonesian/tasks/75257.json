			"dialogs": [
				{
					"id": 752570301,
					"content": "Hasil foto tadi bagus sekali. Sekarang giliran kakak dari Fatui. Kira-kira mau gaya foto seperti apa ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570302
					],
					"speakerTitle": "Yiztli"
				},
				{
					"id": 752570302,
					"content": "Tolong fotokan aku seperti penembak jitu hebat. Sekali lihat saja, orang langsung tahu aku selalu tepat sasaran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570303
					],
					"speakerTitle": "Wechtekah"
				},
				{
					"id": 752570303,
					"content": "Jadi aku tidak perlu pusing lagi dengan peringkat terbawah dalam lomba menembak tim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570304
					],
					"speakerTitle": "Wechtekah"
				},
				{
					"id": 752570304,
					"content": "Tidak masalah. Ayo mulai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yiztli"
				}
			]
		},
