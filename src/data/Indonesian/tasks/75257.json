			"dialogs": [
				{
					"id": 752570701,
					"content": "Aduh, akhirnya selesai juga. Untung saja ada bantuan kalian. Kalau tidak, aku pasti sudah dikomplain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570702
					],
					"speakerTitle": "Yiztli"
				},
				{
					"id": 752570702,
					"content": "Sama-sama, hehe. Kami petualang yang paling suka menolong.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752570703
					]
				},
				{
					"id": 752570703,
					"content": "Petualang ya? Kalau begitu, gimana kalau aku foto buat kalian? Biar semangat kalian yang suka menolong itu ikut diabadikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570704
					],
					"speakerTitle": "Yiztli"
				},
				{
					"id": 752570704,
					"content": "Ayo, senyum ya! Natlan paling asoi, di musim panas sepoi-sepoi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570705
					],
					"speakerTitle": "Yiztli"
				},
				{
					"id": 752570705,
					"content": "Terima kasih banyak, tolong terima ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yiztli"
				}
			]
		},
