				"objectNames": [
					"Yiztli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752570201,
					"content": "Kedengarannya menarik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752570202
					]
				},
				{
					"id": 752570202,
					"content": "Baguslah! Kalau begitu, siapa mau mulai duluan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570203
					],
					"speakerTitle": "Yiztli"
				},
				{
					"id": 752570203,
					"content": "Menurutku, biarkan para wanita duluan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570204
					],
					"speakerTitle": "Inti"
				},
				{
					"id": 752570204,
					"content": "Setuju.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570205
					],
					"speakerTitle": "Wechtekah"
				},
				{
					"id": 752570205,
					"content": "Waduh, sopan sekali anak ini. Aku memang pengen foto bareng anak muda seperti kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570206
					],
					"speakerTitle": "Xoma"
				},
				{
					"id": 752570206,
					"content": "Hah? Bo-Boleh juga sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570207
					],
					"speakerTitle": "Inti"
				},
				{
					"id": 752570207,
					"content": "Ehem, setuju.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570208
					],
					"speakerTitle": "Wechtekah"
				},
				{
					"id": 752570208,
					"content": "Hmm... Tunggu, belum cukup. Ayo tambah lagi 3 orang, seharusnya bisa, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570209
					],
					"speakerTitle": "Xoma"
				},
				{
					"id": 752570209,
					"content": "Umm ... lebih bagus lagi kalau ada kembang api. Waktu aku muda, aku paling suka suasana seperti itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570210
					],
					"speakerTitle": "Xoma"
				},
				{
					"id": 752570210,
					"content": "Tidak masalah. Ayo mulai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yiztli"
				}
			]
		},
