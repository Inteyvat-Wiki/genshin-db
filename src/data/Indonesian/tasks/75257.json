			"dialogs": [
				{
					"id": 752570101,
					"content": "Anak muda, tempat ini tidak kenapa-kenapa, kan? Lalu kenapa tidak dibuka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570102
					],
					"speakerTitle": "Xoma"
				},
				{
					"id": 752570102,
					"content": "Maaf ya, dekorator kami kebanyakan minum tadi malam dan hari ini tidak bisa masuk kerja. Besok datang lagi ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570103
					],
					"speakerTitle": "Yiztli"
				},
				{
					"id": 752570103,
					"content": "Aku sudah terlalu tua, kurasa besok aku tidak kuat lagi kalau jalan sejauh ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570104
					],
					"speakerTitle": "Xoma"
				},
				{
					"id": 752570104,
					"content": "Benar. Besok semua orang ada urusan lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570105
					],
					"speakerTitle": "Inti"
				},
				{
					"id": 752570105,
					"content": "Maaf ya. Ciri khas \"kios foto musim panas\" adalah bisa membangun latar belakang foto yang diinginkan oleh pelanggan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570106
					],
					"speakerTitle": "Yiztli"
				},
				{
					"id": 752570106,
					"content": "Sekarang tanpa dekorator, aku benar-benar tidak bisa lanjut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570107
					],
					"speakerTitle": "Yiztli"
				},
				{
					"id": 752570107,
					"content": "Perlu bantuan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752570108
					]
				},
				{
					"id": 752570108,
					"content": "Eh? Kalian berdua mau bantu ya? Aku benar-benar butuh bantuan. Kerjaannya tidak rumit, kalian cuma perlu siapkan latar belakang foto sesuai permintaan masing-masing pelanggan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yiztli"
				}
			]
		},
		{
			"id": 7525702,
			"completionStepIds": [
				7525701
			],
			"beginWay": "TALK_BEGIN_MANUAL",
