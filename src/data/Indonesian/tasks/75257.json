			"dialogs": [
				{
					"id": 752570801,
					"content": "Hasil foto tadi bagus sekali. Terakhir giliran pemuda yang gagah ini. Kira-kira mau gaya foto seperti apa ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570802
					],
					"speakerTitle": "Yiztli"
				},
				{
					"id": 752570802,
					"content": "Pengamatan yang bagus. Sejak lahir, aku selalu mengutamakan postur yang baik dan sikap anggun di atas segalanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570803
					],
					"speakerTitle": "Inti"
				},
				{
					"id": 752570803,
					"content": "Tanpa postur tubuh yang baik, seseorang takkan terlihat anggun. Tanpa pembawaan yang berkelas, takkan tampak terhormat. Kamu paham maksudku, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570804
					],
					"speakerTitle": "Inti"
				},
				{
					"id": 752570804,
					"content": "Hmm, aku pikir dulu ya ... Oke, ayo mulai!",
