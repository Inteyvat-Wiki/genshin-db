				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xiangling"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110000501,
					"content": "Wah, banyak sekali! Aku akan menggoreng sebagian, lalu menumis sebagiannya lagi dengan jamur-jamur, dan aku akan mencoba mencampur sebagian dengan Slime Condensate...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000502,
						110000504
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000502,
					"content": "Dia dalam sekejap tenggelam ke dalam dunianya sendiri...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000503
					]
				},
				{
					"id": 110000503,
					"content": "Kita dilupakannya begitu saja...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110000506,
					"content": "Ah, maaf, maaf! Aku terlalu senang sampai lupa diri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000507
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000507,
					"content": "Ini makanan enak yang kujanjikan tadi. Cobalah dan beri tahu aku bagaimana rasanya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000508
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000508,
					"content": "Jadi kami dijadikan sebagai penguji rasa sekarang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110000509,
					"content": "Oh, i-ini... Enak sekali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110000510,
					"content": "Bisakah kamu memberi tahu kami cara membuatnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110000511,
					"content": "Hehehe, tentu saja! Hanya saja aku belum menulis resepnya... Aku coba ingat-ingat ya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000512
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000512,
					"content": "Begini saja! Aku akan membuatnya lagi dan kalian ikuti saja. Aku yakin kalian pasti menguasainya dengan cepat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000513
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000513,
					"content": "Masakan ini kelihatannya rumit sekali untuk dipelajari. Ditambah lagi, kami tidak mempunyai wajan ataupun bumbu-bumbu masak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110000514,
					"content": "Aduh, coba dulu deh! Gampang sekali kok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000515
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000515,
					"content": "Wajan bisa diganti dengan lempengan batu. Untuk minyak, kita bisa menggunakan minyak dari boar yang baru saja tertangkap. Kumpulkan batu-batu dan tumpuk menjadi tungku, lalu gunakan ranting kayu dan rumput untuk dibakar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000516
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000516,
					"content": "Sweet Flower bisa menjadi pengganti gula. Kalau garam, aku menemukan banyak sekali garam kristal di sebuah gua. Jumlahnya cukup untuk dipakai beberapa hari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000517,
						110000518
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000517,
					"content": "Dia sepertinya sudah terbiasa melakukannya...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000519
					]
				},
				{
					"id": 110000519,
					"content": "Hehehe... Aku tidak bisa menahan diri untuk tidak mencoba memasak menu baru, dan aku juga tidak bisa membawa semua isi dapurku ke mana-mana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000520
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000520,
					"content": "Tunggu sebentar, aku akan menyiapkan bahan-bahannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000521
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000521,
					"content": "Hei! Kalian sedang apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000601
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 110000601,
					"content": "Di sini adalah habitat para boar, kalian tidak boleh berburu di sini! Bagaimana kalau mereka pergi dari sini?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000602
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 110000602,
					"content": "Kami sebagai pemburu tidak akan membunuh ayam untuk mendapat telur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000603
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 110000603,
					"content": "Oh, aku mengerti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000604
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000604,
					"content": "Daging yang paling bagus dan paling segar diolah dari celeng liar yang tumbuh di habitat alaminya! Kalau mereka semuanya lari ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000605
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000605,
					"content": "TIDAKKK...! Hal ini akan menyebabkan kerugian besar pada dunia makanan — eh bukan, pada dunia manusia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000606,
						110000607
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000606,
					"content": "Benar-benar cara pikir yang unik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000608
					]
				},
				{
					"id": 110000608,
					"content": "Maaf, aku tidak menyangka ulah kami dapat berdampak sebesar itu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000609
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000609,
					"content": "*fuh* Kalian harus meminta maaf kepada Draff.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000610
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 110000610,
					"content": "Sebagai pemimpin dari para pemburu, dia sangat menekankan pentingnya untuk mematuhi aturan dalam berburu. Dia sekarang sangat marah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000611,
						110000612
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 110000611,
					"content": "Bagaimana ini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000613
					]
				},
				{
					"id": 110000613,
					"content": "Akulah yang salah, aku akan meminta maaf kepadanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000614
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000614,
					"content": "Biarkan kami menemanimu ke sana.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000615
					]
				},
				{
