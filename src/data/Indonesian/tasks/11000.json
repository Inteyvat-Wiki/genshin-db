				"points": []
			},
			"dialogs": [
				{
					"id": 110000301,
					"content": "Ssstt! Kecilkan suaramu, aku sedang berburu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000302
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000302,
					"content": "Aku sering mendengar bahwa banyak bahan makanan yang bisa ditemukan di Mondstadt, dan ternyata semua itu benar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000303,
						110000304
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000303,
					"content": "Kamu pemburu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000305
					]
				},
				{
					"id": 110000305,
					"content": "Bukan, bukan. Aku adalah seorang koki yang bercita-cita untuk mencari bahan makanan yang langka di seluruh dunia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000306
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000306,
					"content": "Namaku Xiangling, aku berasal dari pelabuhan Liyue. Kalau kalian?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000307
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000307,
					"content": "#Namaku {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000308
					]
				},
				{
					"id": 110000308,
					"content": "Hai, namaku Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110000309,
					"content": "Paimon?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000310
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000310,
					"content": "Ada apa? Kenapa kamu melihatku seperti itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110000311,
					"content": "Makhluk yang aneh sekali. Apa dia bisa dimakan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000312,
						110000314
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000312,
					"content": "Dia adalah temanku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000313
					]
				},
				{
					"id": 110000313,
					"content": "Sayang sekali. Kalau dia temanmu, aku tidak bisa memakannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000316
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000316,
					"content": "Wah, hubungan kalian terlihat sangat dekat yah... Sebenarnya aku juga mempunyai teman baik bernama Guoba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000317
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000317,
					"content": "Kenapa namanya terdengar mirip dengan camilan khas Liyue ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110000318,
					"content": "Hahaha, karena camilan dan Guoba sama-sama memiliki tempat yang spesial di hatiku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000319
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000319,
					"content": "Oh ya, apa kalian bisa membantuku berburu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000320
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000320,
					"content": "Di sini ada banyak sekali mangsa-mangsa berkualitas yang cocok untuk dimasak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000321
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000321,
					"content": "Aku tidak bisa menangkapnya sendiri dan aku tidak ingin melewatkannya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000322
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000322,
					"content": "Kedengarannya merepotkan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110000323,
					"content": "Jangan begitu dong, aku akan berikan kalian makanan enak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000324
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000324,
					"content": "#Ma-makanan enak? Baiklah! {NICKNAME} adalah pemburu terbaik yang pernah ada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000325,
						110000326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110000325,
					"content": "Kamu sebenarnya memihak siapa sih?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000327
					]
				},
				{
					"id": 110000327,
					"content": "Hehehe, jangan marah dong! Temanmu juga sudah setuju, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000328
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000328,
					"content": "Cara apa pun bisa kamu pakai, yang penting daging mangsanya kamu bawa pulang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000329
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000329,
					"content": "Aku serahkan misi ini padamu ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000326,
					"content": "Kamu seharusnya bertanya padaku dulu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000327
					]
				},
				{
					"id": 110000314,
					"content": "Tentu saja bisa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000315
					]
				},
				{
					"id": 110000315,
					"content": "TIDAK! Paimon bukan makanan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110000304,
					"content": "Kamu petualang?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000305
					]
				}
			]
		},
