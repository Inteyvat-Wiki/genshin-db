				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220310101,
					"content": "Luruskan senjatamu, ratakan barisan... Hah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310102
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310102,
					"content": "Aku datang menemanimu latihan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220310103
					]
				},
				{
					"id": 220310103,
					"content": "Oh! Pengembara, kamu menerima misiku lagi? Terima kasih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310104
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310104,
					"content": "Aku senang sekali orang dengan kemampuan hebat sepertimu bersedia menemaniku latihan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310105,
						220310110
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310105,
					"content": "Teknikmu cukup banyak kemajuan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220310106
					]
				},
				{
					"id": 220310106,
					"content": "Haha... Jangan mengejekku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310107
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310107,
					"content": "Kudengar, salah satu tujuan dibuatnya senjata tombak adalah untuk digunakan oleh orang yang tidak begitu ahli bertarung sepertiku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310108
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310108,
					"content": "Bagaimanapun, senjata ini panjang dan tajam. Walaupun tidak memiliki teknik bertarung, asal bisa mengayunkan dan menusukkannya, kelihatannya sudah hebat sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310109
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310109,
					"content": "Tapi sebenarnya, kalau menurut teori ini... aku merasa tombak dengan ujung tiga yang runcing itu pasti lebih kuat lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310110,
					"content": "Bukannya kamu sudah mengambil kembali senjatamu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220310111
					]
				},
				{
					"id": 220310111,
					"content": "Walau sudah ambil kembali, tapi bukan berarti latihanku sampai di sini saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310112
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310112,
					"content": "Aku sudah pernah berhadapan dengan Kairagi, siapa tahu ke depannya aku akan berhadapan dengan musuh yang lebih kuat lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310113
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310113,
					"content": "Aku tidak akan membiarkan senjataku jatuh ke tangan musuh lagi, apalagi membiarkan kehormatan samurai diinjak-injak. Ini adalah jalan yang kupilih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asakura"
				}
			]
		},
		{
			"id": 2203102,
