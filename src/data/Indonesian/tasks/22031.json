			},
			"dialogs": [
				{
					"id": 220310401,
					"content": "*huff* *huff* Kekuatanmu memang jauh lebih kuat dibandingkan denganku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310402
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310402,
					"content": "Lain kali aku pelan sedikit...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220310403
					]
				},
				{
					"id": 220310403,
					"content": "Tidak! Tolong kerahkan seluruh kekuatanmu! Kalau tidak diasah, aku tidak akan bisa berkembang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310404
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310404,
					"content": "Kamu bisa sehebat ini pasti juga karena latihan yang tak terhitung jumlahnya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310405
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310405,
					"content": "Maafkan jika aku lancang, tapi aku benar-benar penasaran... Bagaimana cara latihanmu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310406,
						220310408
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310406,
					"content": "Ada seekor naga raksasa mengajariku cara terbang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220310407
					]
				},
				{
					"id": 220310407,
					"content": "Su-sulit dipercaya... Bisa-biasanya terbang bersama naga...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310410
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310410,
					"content": "Ah... tidak ada yang spesial.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220310411
					]
				},
				{
					"id": 220310411,
					"content": "Hahaha, benarkah? Kalau begitu kamu berbakat sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310412
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310412,
					"content": "Terima kasih sudah menemaniku latihan. Aku akan terus mengingat pertandingan kali ini. Ini imbalan dariku, terimalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310408,
					"content": "Ada segerombolan serigala mengasah ilmu bela diriku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220310409
					]
				},
				{
					"id": 220310409,
					"content": "Kedengerannya... luar biasa sekali. Jadi ingin lihat pertarunganmu dengan gerombolan serigala itu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310410
					],
					"speakerTitle": "Asakura"
				}
			]
		},
