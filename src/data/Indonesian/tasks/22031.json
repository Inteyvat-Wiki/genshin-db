				"points": []
			},
			"dialogs": [
				{
					"id": 220310301,
					"content": "Apa kamu kurang konsentrasi barusan? Langkahmu kurang teratur. Seranganmu juga kadang kuat kadang lemah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310302
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310302,
					"content": "Tidak bisa kalau begini. Tunggu kamu selesai siap-siap, mari kita coba sekali lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asakura"
				}
			]
		},
		{
			"id": 2203104,
