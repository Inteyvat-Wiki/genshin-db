			},
			"dialogs": [
				{
					"id": 706600101,
					"content": "Halo, petualang. Bagaimana perjalananmu belakangan ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600102,
						706600105
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 706600102,
					"content": "Yah, cukup lancar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706600103
					]
				},
				{
					"id": 706600103,
					"content": "Baguslah. Aku yakin suatu hari nanti kamu akan menjadi petualang yang sangat hebat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600104
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 706600104,
					"content": "Oh ya. Kalau kamu tertarik, kamu bisa pergi mengunjungi Gygax untuk bermain Jejak Sang Angin versi terbaru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600108
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 706600108,
					"content": "Apa ... ini ada hubungannya dengan Adventurers' Guild?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706600109
					]
				},
				{
					"id": 706600109,
					"content": "Sebenarnya ... Gygax mengajukan permintaan pada kami untuk mencari orang yang bisa membantunya menguji Jejak Sang Angin ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600110
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 706600110,
					"content": "Jadi, mungkin bisa dibilang dua hal ini saling berhubungan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600111
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 706600111,
					"content": "Pokoknya, coba saja kalau kamu tertarik. Menurut petualang lain yang pernah mencobanya, permainannya cukup seru ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 706600105,
					"content": "Apa ada misi baru?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706600106
					]
				},
				{
					"id": 706600106,
					"content": "Saat ini ... belum ada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600107
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 706600107,
					"content": "Tapi kalau kamu tertarik, kamu bisa pergi mengunjungi Gygax untuk bermain Jejak Sang Angin versi terbaru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600108
					],
					"speakerTitle": "Katheryne"
				}
			]
		},
