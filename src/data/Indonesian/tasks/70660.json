			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Gygax"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706600201,
					"content": "Hei, apa kamu mau mencoba permainan \"Jejak Sang Angin\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600202,
						706600217
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706600202,
					"content": "Apa itu Jejak Sang Angin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706600203
					]
				},
				{
					"id": 706600203,
					"content": "Jejak Sang Angin adalah sebuah permainan tentang sejarah Mondstadt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600204
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706600204,
					"content": "Kamu mungkin pernah dengar tentang aristokrat yang dulu hidup di kota Mondstadt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600205
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706600205,
					"content": "Mereka benar-benar kejam. Bahkan kata-kata saja tidak cukup untuk menggambarkan tindakan mereka yang membuat banyak orang menderita ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600206
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706600206,
					"content": "Untuk melawan para tiran, sekelompok warga yang berani akhirnya bergabung dan membentuk sebuah organisasi perlawanan rahasia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600207
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706600207,
					"content": "Para pahlawan pembela kebenaran dan keadilan ini pun bertindak. Mereka menjadi \"duri\" yang mengganggu para aristokrat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600208
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706600208,
					"content": "Tapi para aristokrat juga melawan dengan cara melatih pasukan mereka untuk menekan para pemberontak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600209
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706600209,
					"content": "Maka, para pemberontak harus bertarung dengan pasukan aristokrat di seluruh penjuru kota.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600210
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706600210,
					"content": "Jejak Sang Angin terinspirasi dari cerita sejarah Mondstadt yang luar biasa ini! Dulu ini cukup populer loh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600211
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706600211,
					"content": "Dulu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706600212
					]
				},
				{
					"id": 706600212,
					"content": "Iya. Sayangnya, anak muda zaman sekarang sepertinya tidak tertarik dengan permainan ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600213
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706600213,
					"content": "Tapi aku tidak bisa membiarkan permainan Jejak Sang Angin hilang begitu saja. Jadi, aku mengubah sedikit peraturannya untuk membuatnya lebih mudah dan menarik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600214
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706600214,
					"content": "Aku juga menambahkan peta baru di dalamnya. Kuharap dengan begini, aku bisa membujuk lebih banyak orang untuk bermain ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706600217,
					"content": "Tentang kondisi Jejak Sang Angin ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706600218
					]
				},
				{
					"id": 706600218,
					"content": "Aku sebelumnya meminta beberapa orang untuk menguji coba satu ronde permainan Jejak Sang Angin. Ada beberapa yang tekniknya sangat lihai dan membuatku terkesan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600219
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706600219,
					"content": "Tapi banyak juga yang mengatakan kalau permainannya sangat sulit. Yang jadi Pemberontak bilang kalau mereka sulit untuk kabur, yang jadi Pemburu mengeluh karena tidak bisa menemukan siapa pun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600220
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706600220,
					"content": "Beberapa bahkan mengeluh kalau mereka harus memahami peta dengan sangat familier, agar bisa bermain dengan baik. Jadi mereka memintaku membuat permainannya jadi lebih sederhana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600221
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706600221,
					"content": "*huff* Aku tidak tahu mana yang harus kudengar, jadi kuputuskan untuk mengundang kelompok lain untuk melakukan uji coba, lalu mendengar pendapat mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gygax"
				}
			]
		},
