				"points": []
			},
			"dialogs": [
				{
					"id": 3572301,
					"content": "Stormterror ... menyerang Mondstadt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572302
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3572302,
					"content": "#Kaeya, {NICKNAME}, pas sekali. Kita harus segera ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572303
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3572303,
					"content": "Sebentar Amber, kamu tidak kenalkan dulu kami?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572304
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3572304,
					"content": "Ah iya, maaf. Ini Cavalry Captain kami, Kaeya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572305
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3572305,
					"content": "#Mereka berdua adalah pengembara yang datang dari jauh, {NICKNAME} dan Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572306
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3572306,
					"content": "(Dari jauh? Itu saja?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572307
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3572307,
					"content": "Singkat cerita ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572308
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3572308,
					"content": "Begitu ya. Selamat datang di Mondstadt, tapi maaf ya, sepertinya waktu kedatangan kalian kurang tepat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572309
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3572309,
					"content": "Aku tahu bagaimana rasanya terpisah dari keluarga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572310
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3572310,
					"content": "Aku tidak tahu apa urusanmu dengan Archon Anemo ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572311
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3572311,
					"content": "Tapi semua orang boleh punya rahasia, betul kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572312
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3572312,
					"content": "Haha, santai saja! Aku tidak akan mengorek lebih jauh tentang kamu kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572313
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3572313,
					"content": "Pertama-tama, izinkan aku mewakili seluruh Knights of Favonius berterima kasih padamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572314,
						3572315
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3572314,
					"content": "Yah, kami mana bisa diam saja melihat orang dalam bahaya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3572318
					]
				},
				{
					"id": 3572318,
					"content": "Perjuanganmu melindungi kota kami dari naga tadi disaksikan oleh banyak orang loh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572319
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3572319,
					"content": "Grand Master ingin bertemu, dan secara resmi mengundang kalian berdua untuk datang ke <color=#00E1FFFF>markas kami</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3572315,
					"content": "Sama-sama. Aku dapat hadiah apa nih?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3572316
					]
				},
				{
					"id": 3572316,
					"content": "Hmm ... bagaimana kalau makanan khas Mondstadt, Sticky Honey Roast?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572317
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3572317,
					"content": "Tadi kayaknya aku dengar kalimat itu juga deh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3572318
					]
				}
			]
		}
	]
}