			"dialogs": [
				{
					"id": 220430301,
					"content": "Hmm, iya, ini seharusnya cukup. Maaf aku malah merepotkanmu setelah kamu jauh-jauh datang ke kuil ini... Tolong terimalah ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430302
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430302,
					"content": "Saat aku sudah ahli membuat ukiran kayu, aku juga akan mengirimkanmu karya terbaikku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430303
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430303,
					"content": "Hmm, pose seperti apa yang harus aku ukir untuk kepala pendeta kali ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ooshima Junpei"
