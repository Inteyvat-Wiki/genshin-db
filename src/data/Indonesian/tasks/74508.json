			},
			"dialogs": [
				{
					"id": 745080101,
					"content": "Setelah beberapa saat, kamu dan Paimon tiba di depan stan \"Festival Fungus Fantastis\" ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						745080102
					]
				},
				{
					"id": 745080102,
					"content": "Hehe! Fungus yang licin, kenyal, dan lembut memang luar biasa deh! Aku masih mau lanjut main!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080103
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 745080103,
					"content": "Kamu ...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745080104
					]
				},
				{
					"id": 745080104,
					"content": "Aku Enghiene, instruktur sebelum Turenna bergabung dengan Pasukan Patroli Khusus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080105
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 745080105,
					"content": "Aku tidak sama dengan Turenna, tidak sama ya! Aku tidak akan gentar karena kalian punya \"Kekuatan Tempur Level Dewa\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080106
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 745080106,
					"content": "Melusine yang sombong banget ini ... ternyata instruktur Turenna yang dulu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745080107,
					"content": "Jangan tegang, \"Komet Emas\" dan \"Bintang Kejora\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080108
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 745080108,
					"content": "Baru-baru ini, Nona Turenna dapat misi lain dan kembali ke markas Pasukan Patroli Khusus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080109
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 745080109,
					"content": "Nona Enghiene juga orang profesional yang diundang Nona Turenna untuk menggantikan dia menjaga keamanan di tempat acara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080110
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 745080110,
					"content": "Dia juga suka sekali dengan \"Festival Fungus Fantastis\", dia senang sekali waktu main denganku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080111
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 745080111,
					"content": "Betul. Aku suka permainan meja, juga suka Fungus bulat yang asli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080112
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 745080112,
					"content": "Licin, kenyal, dan lembut seperti Tidalga ... hehehe ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080113,
						745080114
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 745080113,
					"content": "Kok kamu jadi ngiler sih?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745080115
					]
				},
				{
					"id": 745080115,
					"content": "Tidak bakal kumakan kok! Masa peluk-peluk dan pegang-pegang mereka saja tidak boleh sih! Haniyyah saja tidak keberatan aku cubit Pyro Sukacita kok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080116
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 745080116,
					"content": "#Kalau gitu kamu cuma boleh cubit Pyro Sukacita! Cuma Paimon sama {NICKNAME} yang boleh peluk Topi Gendang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745080117,
					"content": "Ih, kok pelit amat sih! Aku mau dua-duanya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080118
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 745080118,
					"content": "Haniyyah pernah bilang kalau kalian ahli dalam permainan ini. Mau coba tanding sama aku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080119
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 745080119,
					"content": "Kalau aku menang, aku boleh cubit \"Topi Gendang\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080120
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 745080120,
					"content": "Idih, berani-beraninya remehin kami!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745080121,
					"content": "#{NICKNAME}, ayo kita main! Kita tunjukkan kekuatan pemain \"Festival Fungus Fantastis\" generasi pertama ke dia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080122,
						745080123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745080122,
					"content": "Jangan lupa, kita juga \"Pemenang Pertama Piala Nilotpala\"!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745080124
					]
				},
				{
					"id": 745080124,
					"content": "Tuh! Gelar sebanyak itu semua punya artinya ya! Mana mungkin kami mudah dikalahkan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745080123,
					"content": "Oh dan juga \"Bintang Kembar Cemerlang dan Gagah Berani\"!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745080124
					]
				},
				{
					"id": 745080114,
					"content": "Hei! Tidak boleh makan sobat Fungus ya!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745080115
					]
				}
			]
		}
	]
}