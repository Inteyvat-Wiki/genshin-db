			"dialogs": [
				{
					"id": 700500801,
					"content": "Barang-barang ini namanya \"lampion\", kan? Bentuknya seperti ikan ya, menarik sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500802
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500802,
					"content": "Gagang-gagang ini dipakai untuk mengangkat lampion? Hmm ... Struktur yang bisa dilepas ini, selama desainnya masih proporsional, ditambahkan satu dua ruas lagi juga tidak akan ketahuan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500803
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500803,
					"content": "Ruang kosong di dalamnya besar sekali, harusnya bisa dimasukkan beberapa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500804
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500804,
					"content": "Stop! Pikirkan di dalam hati saja!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500805
					]
				},
				{
					"id": 700500805,
					"content": "Eh? Oh! Hahaha. Begitu aku melihat barang menarik, aku pasti langsung mengucapkan apa yang ada di pikiranku tanpa sadar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500806
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500806,
					"content": "Kalau ada elemen semacam \"lampion\" ini, novelku pasti akan terasa lebih bervariasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500807
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500807,
					"content": "#{NICKNAME}, apa kamu bisa fotokan \"lampion ikan\" besar yang di samping ini? Aku mau simpan beberapa foto untuk referensi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500808,
						700500809
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500808,
					"content": "Saatnya mengasah teknik fotografiku lagi ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500810
					]
				},
				{
					"id": 700500810,
					"content": "Kalau begitu, urusan fotonya kuserahkan padamu ya ... Oh iya! Waktu kamu foto, pastikan lampionnya terlihat semua ya, ini penting sekali buatku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500811
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500811,
					"content": "... Mendesain sebuah trik dengan elemen \"ukuran\" ini sepertinya menarik. Hmm, tapi bagaimana mengatasi masalah beratnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500809,
					"content": "Serahkan saja padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500810
					]
				}
			]
		},
