			},
			"dialogs": [
				{
					"id": 700501201,
					"content": "Nona Guijarro! Kok bisa di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501202,
					"content": "Tidak, tidak. Masa petunjuknya ketemu semudah itu? Ya, siapa juga yang masih bisa berpikir jernih setelah diikat di sini semalaman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501203
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501203,
					"content": "Wah ... Dia benar-benar sudah hanyut dalam dunianya sendiri. Apa dia sudah dapat pencerahan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501204,
					"content": "Lebih kayak ketemu rintangan besar, sih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501205
					]
				},
				{
					"id": 700501205,
					"content": "#... {NICKNAME}, Paimon, pas sekali kalian datang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501206
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501206,
					"content": "Bisa tolong ikatkan aku ke balok kayu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501207
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501207,
					"content": "Pa-Paimon tidak salah dengar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501208,
					"content": "Tolong ikat kedua tanganku, lalu gantung aku di pohon dengan \"kedua tanganku tergantung\". Eh ... pohon atau kayu sama saja lah ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501209
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501209,
					"content": "Aku tidak mau jadi tersangka di novelmu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501210
					]
				},
				{
					"id": 700501210,
					"content": "Jangan khawatir, aku sudah tulis surat pertanggungjawaban. Semua kecelakaan yang terjadi selama periode ini akan menjadi tanggung jawabku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501211
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501211,
					"content": "Bukan cuma itu masalahnya. Kenapa kamu tiba-tiba minta diikat? Kamu kan enggak salah apa-apa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501212,
					"content": "Tapi karakter utama di novelku harus digantung di sini oleh para penduduk desa. Lalu ditinggal semalaman di alam liar untuk menunggu penghakiman dari Xuanwen Beast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501213
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501213,
					"content": "Setelah itu, karakter utama yang sejak awal sudah memperkirakan situasi ini berhasil bertahan hidup dengan berbagai cara. Dia pun berhasil melewati malam dengan aman dan akhirnya mengungkap kebenarannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501214
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501214,
					"content": "... Tapi, aku sama sekali tidak tahu bagaimana rasanya diikat semalaman. Entah itu nada bicaranya, cara berpikirnya, atau gerak-geriknya setelah diikat, aku sama sekali tidak tahu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501215
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501215,
					"content": "Jadi, aku mau minta tolong kalian mengikatku, biarkan aku di sini semalaman. Dengan begitu, aku jadi bisa merasakannya sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501216,
						700501217
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501216,
					"content": "Tidak boleh, ini terlalu berbahaya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501218
					]
				},
				{
					"id": 700501218,
					"content": "... Hmm. Masih ada cara lainnya, tapi hasilnya belum tentu bagus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501219
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501219,
					"content": "Cara lainnya adalah, aku berdiri semalaman di sini dengan pose \"kedua tangan terangkat\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501220
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501220,
					"content": "Mendingan ... jangan tulis novelnya sekalian deh. Kalau begini, terlalu gampang bikin orang salah paham.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501221,
					"content": "Karakter utama di novelmu kasihan banget deh ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501222
					]
				},
				{
					"id": 700501222,
					"content": "Tolonglah! Ini langkah paling penting, novelku sudah mau selesai! Kalau pakai cara ini, kalian kan tidak perlu melakukan tindak kejahatan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501223
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501223,
					"content": "Dari awal juga enggak perlu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501224,
					"content": "Dari awal juga enggak perlu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501225
					]
				},
				{
					"id": 700501225,
					"content": "Ah ... maksudku, kalian tidak perlu terlalu repot, cukup berjaga di sampingku saja. Supaya aku tidak diculik orang atau ... binatang buas waktu aku sedang cari inspirasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501226
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501226,
					"content": "Coba kupikirkan dulu ... Kalau dari suasana yang ingin kubuat di dalam novel, kita harus ke tempat yang paling tinggi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501227
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501227,
					"content": "Eh? Tunggu kami dong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501228,
					"content": "Kalian dan Guijarro mendaki bersama ke titik tertinggi di kebun tehnya ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						700501229
					]
				},
				{
					"id": 700501229,
					"content": "Huh ... A-Agak dingin ya ... Tapi rasanya benaran seperti masuk ke dalam cerita ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501230
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501230,
					"content": "Kamu benaran mau berdiri semalaman di sini sambil angkat tangan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501231,
					"content": "Benar sekali, tekadku sudah bulat. Saat menulis novel memang selalu harus ada pengorbanan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501232
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501232,
					"content": "Kalau begitu aku minta tolong kalian berjaga di sampingku, cuma semalam saja ... Semalam saja ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501217,
					"content": "Apa tidak ada cara yang lebih aman?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501218
					]
				}
			]
		},
