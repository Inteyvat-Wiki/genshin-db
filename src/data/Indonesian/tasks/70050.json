							1542.857
						],
						"pointId": 311400058
					}
				]
			},
			"dialogs": [
				{
					"id": 700500601,
					"content": "Bagaimana? Ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500602
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500602,
					"content": "Kaldron teh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500603
					]
				},
				{
					"id": 700500603,
					"content": "Betul ... dan ada ... sesuatu yang bikin tehnya jadi spesial. Apa pun itu, kalau disimpannya di tengah-tengah begini, pasti ini merupakan barang yang penting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500604
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500604,
					"content": "Hmm ... gimana kalau ternyata Xuanwen Beast bersembunyi di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500605,
						700500606
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500605,
					"content": "Kalau benar seperti itu, malah jadi novel fantasi dong.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500607
					]
				},
				{
					"id": 700500607,
					"content": "Kalau ditulis seperti itu, rasanya di dalam novelmu bisa tiba-tiba muncul tokoh seperti Adeptus deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700500608,
					"content": "Novel kriminal dengan tema semacam ini, rasanya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500609
					]
				},
				{
					"id": 700500609,
					"content": "Oh! Ekspresi kalian bagus sekali. Menurut kalian, kalau aku tulis novel kriminal dengan tema Xuanwen Beast, kasus kriminalnya malah jadi \"tidak masuk akal\", ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500610
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500610,
					"content": "Eh? Yah, ada sedikit perasaan begitu sih. Memangnya ada novel kriminal yang cerita berdasarkan tema kayak begini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700500611,
					"content": "Tunggu, jangan-jangan kamu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500612
					]
				},
				{
					"id": 700500612,
					"content": "#Hmm, cerdas sekali kamu {NICKNAME}. Kamu memang sehebat omongan orang-orang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500613
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500613,
					"content": "Tepat sekali, \"kasus kriminal yang sangat tidak masuk akal dan tidak mungkin terjadi\", inilah yang mau kutulis. Reaksi kalian dan Nona Hung Fan benar-benar menarik, aku akan menuliskannya ke dalam novel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500614
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500614,
					"content": "Sedangkan tentang Xuanwen Beast ... Dia adalah \"pelaku\" dalam ceritaku. Makhluk legenda yang terus memangsa orang jahat di desa, tapi sama sekali tidak ada yang pernah melihatnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500615
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500615,
					"content": "Di suatu festival, ada seorang penduduk desa yang ditemukan terbunuh di alam liar, kelihatannya seperti diserang binatang buas ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500616
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500616,
					"content": "Tapi pada hari kedua perayaan, sang tokoh bertemu lagi dengan korban yang harusnya sudah meninggal itu. Kemudian, jatuhlah satu korban lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500617
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500617,
					"content": "Eh? Terus? Terus?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700500618,
					"content": "Belum kepikiran sih selanjutnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500619
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500619,
					"content": "... Aku pergi saja deh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500620
					]
				},
				{
					"id": 700500620,
					"content": "Jangan dong, tunggu nanti selesai kutulis, pasti aku kirimkan dua buku untuk kalian. Sebenarnya aku masih punya satu hal lagi yang butuh bantuan kalian!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500621
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500621,
					"content": "Kan Nona Hung Fan bilang kalau aku sama sekali tidak boleh keluar desa sendirian? Aku akan menuruti kata-kata dia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500622
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500622,
					"content": "Tapi sekarang ini kan ada kalian, berarti aku sudah tidak \"sendirian\" lagi. Jadi aku boleh jalan-jalan ke luar desa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500623
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500623,
					"content": "Tentu saja, aku juga tidak akan pergi terlalu jauh! Kalian mau menemaniku, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500624,
						700500625
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500624,
					"content": "Baiklah, kami bantu. Demi bisa melihat akhir novel itu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500627
					]
				},
				{
					"id": 700500627,
					"content": "Kalau begitu, ayo kita jalan ke sana! Ada tempat yang benar-benar ingin kukunjungi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500625,
					"content": "Imbalannya harus sesuai aturan, ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500626
					]
				},
				{
					"id": 700500626,
					"content": "Tentu saja, kalian tidak usah khawatir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500627
