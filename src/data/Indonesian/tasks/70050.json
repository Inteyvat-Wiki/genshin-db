			},
			"dialogs": [
				{
					"id": 700501001,
					"content": "Eh? Guijarro ke mana? Barusan dia masih di sini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501002,
						700501003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501002,
					"content": "Mungkin dia ditangkap Xuanwen Beast.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501004
					]
				},
				{
					"id": 700501004,
					"content": "Jangan bilang begitu ah! Dia pasti lagi keliaran sambil mikirin alur cerita novelnya. Ayo kita cari di sekitar sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501005,
					"content": "Kebun teh di sebelah sana posisinya cukup tinggi, sepertinya kita bisa mulai dari sana.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501006
					]
				},
				{
					"id": 700501006,
					"content": "Cari dari tempat yang tinggi ya? Oke deh, yuk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501003,
					"content": "Apa novel yang dia tulis berubah jadi kenyataan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501004
					]
				}
			]
		},
