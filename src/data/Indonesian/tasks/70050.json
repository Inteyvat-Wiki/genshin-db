			"dialogs": [
				{
					"id": 700500501,
					"content": "Tuh kan, sudah kubilang cuma kucing biasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700500502,
					"content": "Ternyata ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500503
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500503,
					"content": "Meong? Meong ... meong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500504,
						700500506
					],
					"speakerTitle": "Kucing Kebingungan"
				},
				{
					"id": 700500504,
					"content": "Permisi, apa kamu kenal sama Xuanwen Beast?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500505
					]
				},
				{
					"id": 700500505,
					"content": "Meong ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500508
					],
					"speakerTitle": "Kucing Kebingungan"
				},
				{
					"id": 700500508,
					"content": "Kucing itu balik badan lalu pergi, sambil terlihat kesal.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						700500509
					]
				},
				{
					"id": 700500509,
					"content": "Tapi ... Menurut kalian, apa mungkin kucing ini Xuanwen Beast yang masih kecil? Dia mau sembunyi di Desa Qiaoying sampai dewasa, lalu akhirnya menghabiskan semua pohon tehnya sekaligus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500510
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500510,
					"content": "Nona Guijarro, kok kamu lagi ... Aku kan sudah pernah bilang, Xuanwen Beast mana mungkin jinak sih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500511
					],
					"speakerTitle": "Hung Fan"
				},
				{
					"id": 700500511,
					"content": "Wah, Nona Hung Fan! Kebetulan sekali, kenapa kamu bisa ada di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500512
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500512,
					"content": "Duh ... Tolong jangan bicarakan hal seperti \"kasus kriminal\" di sini, bagaimana kalau anak-anak kira benar-benar ada kasus yang terjadi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500513
					],
					"speakerTitle": "Hung Fan"
				},
				{
					"id": 700500513,
					"content": "Kalian berdua saling kenal?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500514
					]
				},
				{
					"id": 700500514,
					"content": "Iya. Waktu aku datang kemari, Nona ini yang membantuku memindahkan koper. Aku juga tahu banyak tentang legenda rakyat darinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500515
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500515,
					"content": "Aku sudah bilang berkali-kali, Xuanwen Beast tidak akan muncul di desa ini, tapi Nona Guijarro selalu tidak percaya. Dia malah bilang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500516
					],
					"speakerTitle": "Hung Fan"
				},
				{
					"id": 700500516,
					"content": "Meski tidak muncul, tetap ada banyak cara untuk cari inspirasi tentang hal itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500517
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500517,
					"content": "Mulai lagi, deh ... Duh, Nona Guijarro, aku sudah menyerah untuk membujukmu. Tapi setidaknya tolong jangan berkeliaran di luar desa ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500518
					],
					"speakerTitle": "Hung Fan"
				},
				{
					"id": 700500518,
					"content": "Xuanwen Beast ini binatang buas yang benar-benar ada. Kalau sampai ketemu ... Duh, pokoknya jangan keluar dari desa ini sendirian!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500519
					],
					"speakerTitle": "Hung Fan"
				},
				{
					"id": 700500519,
					"content": "Hung Fan pergi, terlihat lebih capek dan kesal daripada kucing tadi ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						700500520
					]
				},
				{
					"id": 700500520,
					"content": "Baiklah. Berhubung Nona Hung Fan bilang begitu, kita cuma bisa pergi dan cari inspirasi di tempat lain. Ayo ikuti aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500506,
					"content": "Maaf, kami salah kucing.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500507
					]
				},
				{
					"id": 700500507,
					"content": "Meong ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500508
					],
					"speakerTitle": "Kucing Kebingungan"
				}
			]
		},
		{
			"id": 7005006,
