			},
			"dialogs": [
				{
					"id": 705470101,
					"content": "Oh, Juru Selamat Kucing dan Pawang Kucing Sejati! Ternyata kalian datang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470102
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470102,
					"content": "Eh? Kamu barusan panggil kami apa ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470103,
						705470104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705470103,
					"content": "Kok kayaknya pernah dengar ya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705470105
					]
				},
				{
					"id": 705470105,
					"content": "Hmm ... Kayaknya, kita pernah bertemu sebelumnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705470106,
					"content": "Haha! Pawang Kucing Sejati masih ingat sama aku. Valerina sukses besar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470107
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470107,
					"content": "Nanti lagi kita nostalgianya. Sekarang, apa kamu mau coba permainan baru yang aku sponsori? Yang membuatku senang seminggu penuh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470108
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470108,
					"content": "Pesta Bom Dodoco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470109
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470109,
					"content": "A-Ada banyak Dodoco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470110,
						705470111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705470110,
					"content": "Dan semuanya terlihat sangat akrab.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705470112
					]
				},
				{
					"id": 705470112,
					"content": "Juru Selamat Kucing ... Ehem, maksudku, Honorary Knight yang bersinar terang! Yang terhormat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470113
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470113,
					"content": "Boneka Dodoco ini dibuat mirip dengan Anda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470114
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470114,
					"content": "#Be-Benar juga, warna-warna dan polanya semuanya gaya {NICKNAME} banget!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705470115,
					"content": "Dalam permainan, Sparky Dodoco, Flashy Dodoco, Knightly Dodoco, dan Witchy Dodoco harus bekerja sama untuk menggunakan bom dan mengalahkan musuh yang belum pernah dilihat sebelumnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470116
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470116,
					"content": "Aku cuma bertanggung jawab atas sponsor dan operasional permainan, tidak tahu detail pengembangannya, juga tidak tahu seperti apa wujud aslinya musuh-musuh ini di dunia nyata ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470117
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470117,
					"content": "Tapi aku percaya, kalau suatu hari nanti kita benar-benar bertemu, Dodoco yang luar biasa pasti bisa mengalahkan mereka!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470118
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470118,
					"content": "Tentu saja, monster apa pun enggak bakal bisa menghalangi Klee dan Dodoco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470119,
						705470120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705470119,
					"content": "Kalau begitu ayo coba!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705470121
					]
				},
				{
					"id": 705470121,
					"content": "Hehe, aku yakin kalian juga bisa mendapatkan kegembiraan darinya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470120,
					"content": "Permainan Dodoco baru!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705470121
					]
				},
				{
					"id": 705470111,
					"content": "Prototipenya terlihat jelas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705470112
					]
				},
				{
					"id": 705470104,
					"content": "Nama panggilan baru?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705470105
					]
				}
			]
		}
	]
