			"dialogs": [
				{
					"id": 760510301,
					"content": "Gini bisa lah ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510302,
					"content": "~~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510303
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760510303,
					"content": "Oh, dia langsung ngelukis tuh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510304,
					"content": "Ehem, para juri dan hadirin sekalian, siap-siap untuk terkejut! Kira-kira mahakarya seperti apa yang akan dipersembahkan oleh Kuuhenki kita yang berbakat hari i—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510305,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510306
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760510306,
					"content": "Hah? Sudah beres lagi?! Paimon belum beres ngomong loh, cepat amat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510307,
					"content": "Ya sudah, mari kita lihat ... Oh! Gambar Columbina lagi. Ketebak sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510308,
						760510309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510308,
					"content": "Cantik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760510310
					]
				},
				{
					"id": 760510310,
					"content": "Itu ... hutan? Di Nod-Krai? Banyak banget binatangnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510311,
					"content": "Sayangnya pemandangan seperti ini hanya ada pada zaman ketika aku belum meninggalkan Bani Bulan Embun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510312
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760510312,
					"content": "Wuah, Paimon sirik! Binatang kecil lucu imut gitu beneran suka ngelilingin kamu semua ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510313,
					"content": "Iya, semuanya tertarik sama kuuvahki. Merasa aman kalau meringkuk di dekatku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510314
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760510314,
					"content": "Keren banget! Bisa dielus-elus sampai puas, enggak bakal ada yang kabur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510315,
					"content": "Hm ... yang paling enak dielus sepertinya Chic Badger. Yang buntutnya besar dan berbulu itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510316
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760510316,
					"content": "Bulu di leher Rimehorn Deer juga lembut sekali. Enak kalau dijadikan bantal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510317
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760510317,
					"content": "Kalian lebih suka yang mana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510318
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760510318,
					"content": "Uh, kami enggak ada pengalaman, jadi enggak bisa komentar sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510319,
					"content": "Tapi kayaknya, kalau Paimon pasti lebih milih ngelus-ngelus buntut Chic Badger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510320,
					"content": "Chic Badger biasanya lebih penakut. Kalau mau elus, mereka harus merasa aman dulu sama kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510321
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760510321,
					"content": "Ah, tapi kalau aku jadi Paimon, aku akan lebih berhati-hati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510322
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760510322,
					"content": "Kenapa? Mereka ... suka gigit ya? Pa-Paimon janji bakalan lemah lembut, selembut-lembutnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510323,
					"content": "Bukan, maksudku hati-hati sama bahaya dari atas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510324
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760510324,
					"content": "Dari ... atas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510325,
					"content": "Iya, Longplume Ibis biasa memangsa binatang kecil seperti ini. Aku sampai harus beri peringatan keras agar mereka berhenti memburu Kuuhenki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510326
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760510326,
					"content": "Kenapa baru ngomong ini sekarang?! Untung saja Paimon belum digondol burung!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510327,
					"content": "Ah, kalau gitu lain kali aku akan tambah lagi satu peringatan untuk mereka. Kamu juga haram untuk diburu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510328
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760510328,
					"content": "Lain kali ...? Enggak bisa! Sekarang, sekarang juga! Paimon sudah sama sekali enggak berani terbang keluar sekarang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510329,
					"content": "Ah, kalau begitu aku akan beri tahukan pada mereka kalau Paimon adalah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510330,
						760510332,
						760510334
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760510330,
					"content": "Bestie terbaik sepanjang masa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760510331
					]
				},
				{
					"id": 760510331,
					"content": "Iya! Enggak boleh main culik bestie-nya orang lain!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510336
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510336,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510337
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760510337,
					"content": "Si kecil ini ... sangat penasaran tentang adegan Paimon dibawa pergi oleh Longplume Ibis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510338
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760510338,
					"content": "Jangan digambar ... plis jangan digambar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510332,
					"content": "Pemandu terbaik di seluruh Teyvat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760510333
					]
				},
				{
					"id": 760510333,
					"content": "Uh ... Paimon senang sih dibilang gitu, tapi ... burung mana ngerti pemandu tuh apaan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510336
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510334,
					"content": "Bisa dimakan, tapi dijamin seratus persen bikin diare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760510335
					]
				},
				{
					"id": 760510335,
					"content": "JANGAN! Jangan malah dibilang gitu dong!!! Kalau mereka kepepet terus nekat, apa jadinya Paimon?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510336
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510309,
					"content": "Baru lihat doang rasanya sudah senang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760510310
					]
				}
			]
		},
