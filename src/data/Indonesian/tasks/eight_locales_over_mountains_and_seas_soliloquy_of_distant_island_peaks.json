						726750402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750402,
					"content": "Keren! Airnya banyak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750403
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726750403,
					"content": "Besar! Besar dan mengapung di air!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750404
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726750404,
					"content": "Besar sekali, pasti berat. Kenapa tidak tenggelam?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750405
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726750405,
					"content": "Soalnya Kapal Alcor itu ... sebuah kapal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750406,
					"content": "Tapi, kapal lumpur selalu tenggelam. Ioroi yang bilang. Cerita kelinci, bake-danuki, dan kapal lumpur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750407
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726750407,
					"content": "Eh, ini ... Kapal Alcor punya Beidou itu bukan terbuat dari lumpur, jadi tidak bakalan tenggelam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750408,
					"content": "Kenapa kalau bukan lumpur, tidak tenggelam?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750409
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726750409,
					"content": "Kichiboushi makin hari makin pintar ngomong ya ... Tapi gimana kita bisa jawab pertanyaan kayak gitu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750410,
					"content": "#Hehe, {NICKNAME}, aku ada kuis buat kamu. Kenapa kapal bisa mengapung di air?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750411,
						726750414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750411,
					"content": "Karena kapal terbuat dari kayu. Elemen Dendro hebat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750412
					]
				},
				{
					"id": 726750412,
					"content": "Eh? Memangnya elemen Dendro pengaruh ke situ ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750413,
					"content": "Eh, tapi kalau gitu ... Kenapa tamengnya Hilichurl enggak bisa ngapung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750416,
					"content": "Hu-hmm, tidak paham.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750417
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726750417,
					"content": "Tenang, nanti kalau Kichiboushi sudah besar terus pintar kayak Paimon, pasti ngerti kok. Kenapa kapal bisa mengapung, kenapa ada hujan salju, kamu bakal jadi paham semuanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750418,
						726750420,
						726750421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750418,
					"content": "Kayak kamu ngerti saja, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750419
					]
				},
				{
					"id": 726750419,
					"content": "WOI!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750422,
					"content": "Terserahlah, yang penting Kapal Alcor-nya kelihatan dari sini. Foto dulu yuk, Kichiboushi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750423,
					"content": "Foto! Potret!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750424
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726750424,
					"content": "Iya, betul! Kichiboushi diam di sana ya, jangan lari-lari!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750420,
					"content": "Tidak mengerti juga tidak apa-apa kok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750422
					]
				},
				{
					"id": 726750421,
					"content": "Ada beberapa hal yang kalau kamu tidak mengerti juga tidak masalah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750422
					]
				},
				{
					"id": 726750414,
					"content": "Karena daya apungnya lebih besar dari daya tekannya, sehingga kapalnya bisa mengapung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750415
					]
				},
				{
					"id": 726750415,
					"content": "Oh, gitu toh! Oke, Paimon sudah paham sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750416
					],
					"speakerTitle": "Paimon"
				}
			]
		},
