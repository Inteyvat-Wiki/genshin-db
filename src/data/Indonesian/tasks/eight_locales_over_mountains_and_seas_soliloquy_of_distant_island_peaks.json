			"dialogs": [
				{
					"id": 726750601,
					"content": "Habis ini kita bawa Kichiboushi naik ke Kapal Alcor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750602,
					"content": "Jangan. Kalau kapal tenggelam ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750603
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726750603,
					"content": "Kapal yang satu ini tidak akan tenggelam.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750604
					]
				},
				{
					"id": 726750604,
					"content": "Kami naik kapal ini waktu pertama ke Inazuma.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750605
					]
				},
				{
					"id": 726750605,
					"content": "Betul! Terus setelah itu, baru kami bisa kenal sama Ioroi dan Kichiboushi. Enggak usah takut!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750606,
					"content": "Oh! Gitu ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750607
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726750607,
					"content": "Lagian Kapten Beidou itu orangnya bisa diandalkan, semua anggota Crux Fleet juga jago-jago. Kapal itu tempat paling aman di laut!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750608,
					"content": "Hmm! Sip!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"Kichiboushi\""
				}
			]
		},
