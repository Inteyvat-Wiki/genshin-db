				},
				{
					"id": 726750304,
					"content": "Kalian bilang begitu pun ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750306
					]
				},
				{
					"id": 726750306,
					"content": "Kalau dipikir lagi, biarpun sudah banyak banget Crystalfly yang kita tangkap sepanjang perjalanan ini, tapi Paimon memang enggak pernah perhatikan hal itu sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750307,
					"content": "Apa ini yang dinamakan \"kekecewaan saat sudah beranjak dewasa\"? Tahu kan, hal-hal yang saat kita dewasa terus kita tahu dan jadi kecewa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750308,
					"content": "Kelihatannya Paimon juga perlu dilatih nih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750309
					]
				},
				{
					"id": 726750309,
					"content": "Rambut Putih, semangat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750310
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726750310,
					"content": "Woi, ngapain semangatin aku! Jelas-jelas Kichiboushi kan yang lagi latihan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750311,
					"content": "Yah, agak kecewa juga sih tapi ... Kenapa Crystal Core-nya Geo Crystalfly warnanya bukan emas juga sih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750312,
					"content": "Iya. Crystalfly warna emas, kenapa barangnya tidak emas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750313,
						726750314
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726750313,
					"content": "Crystalfly memang sudah gitu dari sananya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750315
					]
				},
				{
					"id": 726750315,
					"content": "Yah ... sudahlah. Pokoknya, kita tetap jalan sesuai rencana. Sekarang kita lanjut bawa Kichiboushi ke Kapal Alcor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750314,
					"content": "Aku juga tidak tahu jawabannya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750315
					]
				},
				{
					"id": 726750305,
					"content": "Percuma saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750306
					]
				}
