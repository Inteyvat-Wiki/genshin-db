					"content": "Yang penting kamu senang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722641403
					]
				},
				{
					"id": 722641403,
					"content": "Rambut Kuning, kuat. Pung-pung, yang besar, yang bulat, langsung hilang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722641404
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722641404,
					"content": "Soalnya aku rajin latihan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722641405
					]
				},
				{
					"id": 722641405,
					"content": "Hmm! Mau jadi kuat, kayak Rambut Kuning.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722641406
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722641406,
					"content": "Latihan terus! Jadi kuat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722641407
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722641407,
					"content": "Kalau sudah jadi kuat, Kichiboushi mau apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722641408
					]
				},
				{
					"id": 722641408,
					"content": "Balas dendam ke Gyoubu Koban, ha-he-ho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722641409
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722641409,
					"content": "Supaya Ioroi bukan batu lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722641410
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722641410,
					"content": "Semangat ya. Jalur latihanmu biar kami yang urus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722641411
					]
				},
				{
					"id": 722641411,
					"content": "Hmm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722641412,
					"content": "Yang penting senang. Sampai jumpa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722641413
