			"dialogs": [
				{
					"id": 726750101,
					"content": "Beda sama Dragonspine. Tidak dingin. Tidak ada salju.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750102
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726750102,
					"content": "Tempat ini namanya Guyun Stone Forest! Legendanya, Rex Lapis mengalahkan si ... eh, siapa ya namanya ... itu si ular yang kepalanya ada banyak, siapa sih namanya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750103,
						726750104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750103,
					"content": "Overlord of the Vortex?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750105
					]
				},
				{
					"id": 726750105,
					"content": "Ya, itu! Osial, Overlord of the Vortex! Ketika itu dia kalah di sini, dihujani tombak batu dan dikurung di bawahnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750106,
					"content": "Waw!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750107
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726750107,
					"content": "Hehe, keren kan? Tapi kami juga pernah melawan dia loh! Waktu itu kami ada di atas Jade Chamber-nya Ningguang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750108,
					"content": "Crystalfly emas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750109
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726750109,
					"content": "Kok malah ngelihatin itu sih! Paimon kan lagi cerita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750110,
					"content": "Crystalfly di sini memang beda sih sama yang di Inazuma ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750111
					]
				},
				{
					"id": 726750111,
					"content": "Dia pasti belum pernah lihat Crystalfly yang warnanya bukan ungu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750112
					]
				},
				{
					"id": 726750112,
					"content": "#Eh ... iya juga sih. Bukan salah Kichiboushi juga sih. {NICKNAME}, ayo tangkap satu dan kasih lihat ke dia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750113,
						726750115,
						726750117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750113,
					"content": "Kenapa enggak kamu aja yang tangkap?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750114
					]
				},
				{
					"id": 726750114,
					"content": "Kan kamu yang lebih jago!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750118,
					"content": "Ditangkap juga dapatnya cuma Crystal Core.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750119
					]
				},
				{
					"id": 726750119,
					"content": "Keren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726750115,
					"content": "Yang bisa terbang kan kamu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750116
					]
				},
				{
					"id": 726750116,
					"content": "Iya tapi kan kamu yang lebih jago!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750118
					],
					"speakerTitle": "Paimon"
				},
				{
