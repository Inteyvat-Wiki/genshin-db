			"dialogs": [
				{
					"id": 726750801,
					"content": "Lihat! Pemandangannya mantap, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750802,
					"content": "Hmm, mantap!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750803
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726750803,
					"content": "Di sana gunungnya banyak. Tempat apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750804
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726750804,
					"content": "Eh? Sebelah sana itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750805,
						726750806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750805,
					"content": "Inazuma.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750807
					]
				},
				{
					"id": 726750807,
					"content": "Betul! Yang kelihatan di sana itu harusnya Mt. Yougou, dan di kaki gunungnya, ada Chinju Forest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750808
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750808,
					"content": "Jauh. Ioroi di seberang laut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750809
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726750809,
					"content": "Iya. Tapi, kami kan menemani kamu latihan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750810,
					"content": "Ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750811
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726750811,
					"content": "Habis ini ke mana lagi ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750812,
					"content": "Wah, ada enggak tempat yang kita sudah kenal, dan makanannya juga enak-enak ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750813,
						726750817
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750813,
					"content": "Paimon lapar yaaa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750814
					]
				},
				{
					"id": 726750814,
					"content": "Makanan yang enak-enak. Suka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750815
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726750815,
					"content": "#Lihat {NICKNAME}, Kichiboushi lebih ngerti. Keliling dunia buat wisata kuliner itu latihan juga loh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750816
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750816,
					"content": "Kalau kamu gitu aja enggak ngerti, kamu sebentar lagi juga bakal kalah dari Kichiboushi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750818
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750818,
					"content": "Haiya, manjat tiang kapal itu capek banget ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750819
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750819,
					"content": "Rambut Putih manjat? Kan bisa terbang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750820
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726750820,
					"content": "Jangan bahas yang enggak penting!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750821
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750821,
					"content": "Sudah, hari ini sampai sini dulu saja deh. Biar Paimon pikirin dulu habis ini mau ke mana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750822
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750822,
					"content": "Hmm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726750817,
					"content": "Yah, aku juga lapar sih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750818
					]
				},
				{
					"id": 726750806,
					"content": "Tempat tinggalmu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750807
					]
				}
			]
		}
	]
