			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Elsie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708280201,
					"content": "(Berikan \"Kidung Ay-Khanoum\".)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280202
					]
				},
				{
					"id": 708280202,
					"content": "Wah, cantik sekali bukunya! Oke, baca dulu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280203
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280203,
					"content": "\"Tiada takhta yang kakinya tak dihuni ular, tiada ada mawar yang tak berduri. Minumlah kepahitan sampai kepada tegukan terakhir, Ferigees, dan dengan matamu yang semanis madu itu, berjanjilah ... berjanjilah ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280204
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280204,
					"content": "Uh ... ini gimana lafalnya ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280205
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280205,
					"content": "Terlalu dalam! Lidahku langsung kusut. Sudahlah, bawa pulang dan baca pelan-pelan saja dulu deh. Makasih ya, petualang rambut pirang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Elsie"
				}
			]
		},
		{
			"id": 7082803,
			"completionStepIds": [
				7082803
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7082803",
							"2"
						],
						"stepId": 7082803,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_ITEM_NUM_GREATER",
