				"points": []
			},
			"dialogs": [
				{
					"id": 708280401,
					"content": "(Berikan \"Mimpi Rhonabouillet\".)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280402
					]
				},
				{
					"id": 708280402,
					"content": "Wah, kumpulan puisi Fontaine! Mana lihat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280403
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280403,
					"content": "Kembali ke masa lampau ... balai kerajaan Lochknight ... dan dia jatuh cinta pada pandangan pertama?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280404
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280404,
					"content": "Pfft! Kacau, kok konyol amat sih? Bisa balik ke masa lalu, terus yang kepikiran cuma mengemis cinta ke orang yang kalau masih hidup usianya bisa lebih tua dari nenek moyangmu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280405
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280405,
					"content": "Oh, iya juga ya. Ini kan puisi cinta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280406
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280406,
					"content": "Ha, aku paham sih. Jatuh cinta memang bikin tahi burung jadi serasa Sunsettia. Baiklah, aku beli ini deh, nanti mau dibaca baik-baik sampai meresap. Makasih banyak, petualang rambut pirang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Elsie"
				}
			]
		},
		{
			"id": 7082805,
			"completionStepIds": [
				7082805
			],
