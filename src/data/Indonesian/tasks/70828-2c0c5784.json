			"dialogs": [
				{
					"id": 708280701,
					"content": "(Berikan \"Bisikan Angin Hutan\".)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280702
					]
				},
				{
					"id": 708280702,
					"content": "Haha, Bisikan Angin Hutan? Astaga, aku ini penyair kawakan loh, masa iya tidak tahu yang satu itu. Aku sudah baca habis entah berapa kali. Ada yang lain tidak, yang aku belum tahu gitu.",
					"roleType": "TALK_ROLE_NPC",
