					"Elsie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708280501,
					"content": "Haha, makasih loh petualang rambut pirang! Kamu pahlawanku, terbaik lah pokoknya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280502
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280502,
					"content": "Banjir inspirasinya sudah mulai. Macam angin ribut di Stormterror's Lair, kabut racun di Lembah Chenyu, dan petir di Pulau Seirai ... semuanya seperti mau menyembur keluar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280503
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280503,
					"content": "Kok bahaya amat?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280504
					]
				},
				{
					"id": 708280504,
					"content": "Hehe, tunggu saja! Aku mau tulis semuanya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280505
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280505,
					"content": "Puisi murahan si Linus bukan tandingan mahakarya ini. Setelah selesai, kedai minum di seluruh Teyvat akan kenal namaku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Elsie"
				}
			]
		},
		{
