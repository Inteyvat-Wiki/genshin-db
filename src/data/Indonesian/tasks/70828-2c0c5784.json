				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Elsie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708280301,
					"content": "(Berikan \"Wahyu Kasih Ilahi\".)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280302
					]
				},
				{
					"id": 708280302,
					"content": "Oh, aku tahu yang satu ini. Kumpulan puisi dari Church of Favonius?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280303
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280303,
					"content": "Kita lihat ... \"Jiwanya membara laksana lautan api, nyalanya membakar angin di udara. Di antara bintang, rembulan, dan sang surya kencana, bahkan sinarku pun terbakar oleh kemilaunya yang terang benderang ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280304
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280304,
					"content": "Ini puisi apaan, kok agak meresahkan ya ... Church of Favonius gagal paham nih soal puisi. Mana ada bintang, bulan, dan matahari keluar bareng-bareng? Ngaco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280305
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280305,
					"content": "Beres! Aku sudah yakin lagi. Kalau puisinya cuma level segini, aku pasti bisa bikin yang lebih oke. Sini, aku beli saja. Makasih banyak, petualang rambut pirang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Elsie"
				}
			]
		},
		{
			"id": 7082804,
