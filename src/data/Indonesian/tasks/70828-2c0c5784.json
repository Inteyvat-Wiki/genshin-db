				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Elsie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708280101,
					"content": "Ah, permisi! Petualang berambut pirang! Tolong tunggu sebentar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280103,
						708280104
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280103,
					"content": "Perlu dibantu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280102
					]
				},
				{
					"id": 708280102,
					"content": "Oh, bukan, bukan gitu! Aku cuma mau tanya apa mungkin kamu punya kumpulan puisi cinta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280107
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280107,
					"content": "Jadi gini, sebenarnya aku ini penyair. Mungkin nomor dua di Mondstadt, setelah Barbatos tentunya! Serius, aku bukan bercanda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280108
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280108,
					"content": "Tapi si Linus ... dia tidak mau mengakui kalau aku lebih hebat! Kerjaannya nongol di sembarang tempat, setiap waktu, baca puisi di depanku! Mau dilihat gimana pun dia tuh sengaja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280109
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280109,
					"content": "Parahnya lagi, semua puisi yang dibaca sama dia isinya tentang cinta, romantisme ... sesuatu yang aku sama sekali belum pernah sentuh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280110
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280110,
					"content": "Makanya aku mau urus ini. Bikin puisi cinta yang super luar biasa, yang bakal terus diingat sama orang Mondstadt sampai selama-lamanya! Biar dia paham, apa yang disebut BAKAT!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280111
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280111,
					"content": "Dan karena aku ... mengabdikan keseharianku untuk mengembangkan seni yang agung ini, aku pribadi belum pernah merasakan apa itu jatuh cinta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280112
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280112,
					"content": "Jadi kalau misal kamu punya kumpulan puisi cinta, tolong jual ke aku! Cuma perlu baca-baca sedikit saja sih, habis itu dijamin banjir inspirasi. Wajar kok buat orang berbakat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280104,
					"content": "Mohon maaf, aku lagi banyak urusan. Permisi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280105
					]
				},
				{
					"id": 708280105,
					"content": "Bukan, bukan gitu! Aku bukan mau minta tolong. Gimana ceritanya orang berani berkelana, kalau setiap ada masalah selalu dimintai tolong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280106
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280106,
					"content": "Ehem. Cuma mau tanya apa mungkin kamu punya buku yang isinya kumpulan puisi cinta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280107
					],
					"speakerTitle": "Elsie"
				}
			]
		},
		{
			"id": 7082802,
			"completionStepIds": [
				7082802
			],
