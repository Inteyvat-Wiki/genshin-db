					],
					"speakerTitle": "Catatan yang Sudah Menguning"
				},
				{
					"id": 191737102,
					"content": "\"Waktu aku bekerja, aku terus berpikir kalau kamu pasti bisa melakukan yang lebih baik dariku.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191737103
					],
					"speakerTitle": "Catatan yang Sudah Menguning"
				},
				{
					"id": 191737103,
					"content": "\"Soalnya, kamu murid paling luar biasa yang pernah kutemui.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Catatan yang Sudah Menguning"
				}
