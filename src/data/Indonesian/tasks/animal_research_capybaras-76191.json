			"dialogs": [
				{
					"id": 761910201,
					"content": "Aku sudah peringatkan berkali-kali, pasang mata! Ini stok premium! Yang terus dipesan sama klien di Snezhnograd.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910202
					],
					"speakerTitle": "Alhoma"
				},
				{
					"id": 761910202,
					"content": "Kamu ... malah kasih lewat begitu saja? Serius? Kamu tiba-tiba jadi berhati baik? Lepaskan dia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910203
					],
					"speakerTitle": "Alhoma"
				},
				{
					"id": 761910203,
					"content": "Bos, dengar dulu dong. Ini bukan salahku, Hilichurl tadi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910204
					],
					"speakerTitle": "Yelo"
				},
				{
					"id": 761910204,
					"content": "Hilichurl? Kok jadi salahkan Hilichurl? Kalau kamu begini terus, reputasi kita akan hancur di tanganmu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910205
					],
					"speakerTitle": "Alhoma"
				},
				{
					"id": 761910205,
					"content": "Aku ... mana bisa menang dari mereka bos. Tidak bisa sama sekali. Satu biru, satu hijau ... Pukulan mereka lebih kuat dari Agent ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910206
					],
					"speakerTitle": "Yelo"
				},
				{
					"id": 761910206,
					"content": "(Kedua ini ... kayaknya penyelundup gelap deh.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910207
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761910207,
					"content": "Siapa itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910208
					],
					"speakerTitle": "Alhoma"
				},
				{
					"id": 761910208,
					"content": "Santai, Lumi! Belum giliranmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910209
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761910209,
					"content": "Apa ini? Hmm ... kayaknya langka nih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910210
					],
					"speakerTitle": "Alhoma"
				},
				{
					"id": 761910210,
					"content": "Kamu bisa urus gadis kecil itu ya? Aku rasa makhluk ini bisa buat ganti kerugian kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910211
					],
					"speakerTitle": "Alhoma"
				},
				{
					"id": 761910211,
					"content": "Siap, Bos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910212
					],
					"speakerTitle": "Yelo"
				},
				{
					"id": 761910212,
					"content": "Seriusan, sekarang kamu mengincar Lumi? Pantas orang-orang tidak percaya sama Treasure Hoarder lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910213
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761910213,
					"content": "\"Percaya\"? Sejak kapan kita bisa hidup dari rasa percaya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910214
					],
					"speakerTitle": "Yelo"
				},
				{
					"id": 761910214,
					"content": "Cukup, sikat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alhoma"
				}
			]
		},
