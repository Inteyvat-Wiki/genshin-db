			"dialogs": [
				{
					"id": 761910301,
					"content": "Hmm ... Benar-benar Capybara perak. Tidak dicat, bukan efek cahaya juga. Ini benar-benar langka ... Luar biasa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910302
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761910302,
					"content": "Aku sudah cari di seluruh Natlan, belum pernah ketemu satu pun yang begini. Ternyata semuanya di sini, disikat sama penyelundup ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910303
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761910303,
					"content": "Tapi sepertinya dia tidak terluka ... Hehe, Capybara perak beneran! Aku tidak sangka bisa lihat dengan mata kepalaku sendiri ... Aku mau coba pegang sebentar ah. Apa si perak ini beda dari jenis biasanya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910304
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761910304,
					"content": "Ah, panas banget!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910305
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761910305,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910306
					],
					"speakerTitle": "Capybara"
				},
				{
					"id": 761910306,
					"content": "Oh, maaf. Aku lupa kamu masih ada di dalam panci!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910307
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761910307,
					"content": "Apa mungkin karena kamu sudah terbiasa dengan Phlogiston Cair di Natlan, jadi kamu sudah kebal sama suhu ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910308
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761910308,
					"content": "Pokoknya, kamu ikut aku pulang ya sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910309
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761910309,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Capybara"
				}
			]
