					}
				]
			},
			"dialogs": [
				{
					"id": 401870401,
					"content": "#Harusnya waktu itu kamu pergi dengan {NICKNAME} ke perbatasan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870402
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 401870402,
					"content": "Aku paham kamu khawatir dengan si Pengembara. Tapi kenyataannya, aku tidak akan bisa banyak bantu juga. Malah kalau ada yang salah aku bisa jadi beban buat kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870403
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 401870403,
					"content": "Lagi pula, Ningguang tiba-tiba ganti rencana dan utus aku ke Chasm. Aku tidak bisa ada di dua tempat dalam satu waktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870404
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 401870404,
					"content": "Kalau kamu tidak puas dengan itu, kenapa tidak protes langsung ke Yujing Terrace?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870405
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 401870405,
					"content": "Hmph ... dan lapor soal Tianquan ke Tianquan sendiri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870406
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 401870406,
					"content": "Tidak, maksudku Yuheng. Dia tidak takut jika harus berdebat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870407
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 401870407,
					"content": "Sudahlah. Yang penting sekarang semuanya baik-baik saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870408
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 401870408,
					"content": "Heh. Wangshu Inn benar-benar tempat yang bagus ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870409
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 401870409,
					"content": "Tepatnya semua tempat di Liyue bagus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870410
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 401870410,
					"content": "Hahaha, kamu benar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870411
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 401870411,
					"content": "Bos, minta Dew-Dipped Shrimp seporsi lagi dong, sama saus pedasnya juga ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870412
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 401870412,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870413
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 401870413,
					"content": "Dan satu porsi Almond Tofu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yelan"
				}
			]
		},
