			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yun Jin"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2407.683,
							343.151,
							2388.574
						],
						"pointId": 10443
					},
					{
						"sceneId": 3,
						"position": [
							2407.146,
							343.151,
							2391.287
						],
						"pointId": 10444
					}
				]
			},
			"dialogs": [
				{
					"id": 401870301,
					"content": "Kalau kita ngomongin soal yang lebih kuat ... menurutku sih Pembaca Angin ya. Toh dia yang menemukan seni Ramalan Qimen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870302
					],
					"speakerTitle": "Chongyun"
				},
				{
					"id": 401870302,
					"content": "Iya! Menurutku juga gitu, apalagi dia leluhurku. Oh, lalu dia juga kan si walet perak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870303
					],
					"speakerTitle": "Lan Yan"
				},
				{
					"id": 401870303,
					"content": "Kalau begitu biar kunominasikan Dua Sage Lianshan. Biasanya yang hidup menyendiri dan tidak pernah menunjukkan kemampuannya justru merekalah yang terkuat. Setidaknya begitu yang biasa ada di buku. Gimana menurutmu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870304
					],
					"speakerTitle": "Gaming"
				},
				{
					"id": 401870304,
					"content": "Kalau ini novel bela diri sih aku setuju.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870305
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 401870305,
					"content": "Tapi sayangnya, setelah aku membaca \"Rembulan Hutan Bambu\", aku yakin bahwa gelar itu harusnya milik si Kuda Putih dari Tiga Dewa Tao Dou. Dia pasti punya rahasia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870306
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 401870306,
					"content": "Eh? Tidak ada yang mau pilih Pemancing Yunlai? Yuheng saja bilang seni pedangnya itu dari teknik mancing Pemancing Yunlai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870307
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870307,
					"content": "Iya sih ... tapi, mancing? Kok kayaknya kurang kuat di konteks ini ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870308
					],
					"speakerTitle": "Gaming"
				},
				{
					"id": 401870308,
					"content": "Hmm ... tapi kadang pemancing itu punya kekuatan hebat juga loh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870309
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 401870309,
					"content": "Hei, kalian semua salah! Yang terkuat jelas Si Tua Wuwang dan Kupu-Kupu Tunggal. Kalau tidak ada mereka, tidak akan ada Wangsheng Funeral Parlor sampai hari ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870310
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 401870310,
					"content": "Masuk akal juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870311
					],
					"speakerTitle": "Chongyun"
				},
				{
					"id": 401870311,
					"content": "Oh, semuanya sudah di sini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870312,
					"content": "#{NICKNAME}, Paimon, akhirnya kalian datang juga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870313
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 401870313,
					"content": "Ah! Hu Tao, topimu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870314,
					"content": "Kamu jeli juga, Paimon. Iya, aku tambahkan ranting plum lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870315
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 401870315,
					"content": "#Oho! Jadi sekarang kamu sama si {NICKNAME} kembaran ranting plum nih ceritanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870316,
					"content": "Ngomong-ngomong kalian semua lagi ngapain sih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870317,
					"content": "Kami lagi debat soal siapa yang terkuat dari Delapan Sosok Sakti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870318
					],
					"speakerTitle": "Lan Yan"
				},
				{
					"id": 401870318,
					"content": "Hahaha, ya kira-kira gitu. Ini debat terbuka sih. Cuma menebak-nebak saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870319
					],
					"speakerTitle": "Gaming"
				},
				{
					"id": 401870319,
					"content": "Iya. Kalau mau tahu pasti yang beginian sih harus pakai kacamata khusus seperti yang ada di novel-novel ringan, kita bisa lihat kekuatan mereka cuma dari sekali lihat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870320
					],
					"speakerTitle": "Chongyun"
				},
				{
					"id": 401870320,
					"content": "Haha, kamu ketularan Xingqiu ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870321
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870321,
					"content": "#Selamat datang, {NICKNAME}. Keluargaku bilang kamu dan Hu Tao yang menggelar upacara itu dan akhirnya bisa menyembuhkan penyakit kakek buyutku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870322
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 401870322,
					"content": "Aku benar-benar tidak tahu harus bagaimana berterima kasih atas kerja keras kalian itu. Di kemudian hari, entah kesulitan apa pun yang kalian temui, Feiyun Commerce Guild pasti akan selalu siap membantu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870323
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 401870323,
					"content": "Ini semua berkat kerja keras semua orang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870324
					]
				},
				{
					"id": 401870324,
					"content": "Iya, aku tahu. Ayah dan kakakku nanti akan langsung berterima kasih secara pribadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870325
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 401870325,
					"content": "Duh kenapa repot banget sih, Xingqiu? Langsung saja kamu akui di sini sama aku kalau yang terkuat di antara Delapan Sosok Sakti itu Kupu-Kupu Tunggal dan Si Tua Wuwang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870326
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 401870326,
					"content": "Sudah cukup debatnya! Semuanya sudah datang, jadi ayo makan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870327
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870327,
					"content": "Paimon, giliranmu! Waktunya kamu ngomong filosofi hidupmu sama semuanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870328
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870328,
					"content": "Eh ... O-Oke deh, err ... bentar ... Intinya, makanlah sepuas hatimu, dan jangan tinggalkan ... aduh apa sih lanjutannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870329,
					"content": "Jangan tinggalkan sumpit dalam penyesalan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870330
					]
				},
				{
					"id": 401870330,
					"content": "Ahh, iya, iya! Iya kayak gitu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870331
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870331,
					"content": "Wow, Paimon, masa kamu tidak hafal sama prinsip hidup sendiri! Tidak bagus tuh! Nanti hidupmu juga jadi tidak lancar. Ayo, kamu pasti bisa! Ayo sekali lagi, dari awal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870332
					],
					"speakerTitle": "Gaming"
				},
				{
					"id": 401870332,
					"content": "Makanlah sepuas hatimu! Jangan tinggalkan sumpit dalam penyesalan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870333
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870333,
					"content": "Nah gitu dong.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870334
					]
				},
				{
					"id": 401870334,
					"content": "Hehe, jadi sekarang sudah bisa makan nih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870335
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870335,
					"content": "Paimon, kamu lupa ya sama tamu spesial kita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870336
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870336,
					"content": "Oh, iya! Paimon ingat sekarang. Sebenarnya tadi Paimon sudah nebak, tapi duh ... masa harus diomongin sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870337
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870337,
					"content": "Hmm? Kok jadi enggak percaya diri gitu ... Kamu enggak tahu siapa ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870338
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 401870338,
					"content": "#Eh, tahu kok! Sudah jelas kan si ... um ... {NICKNAME} bantuin dong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870339
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870339,
					"content": "Yun Jin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870340
					]
				},
				{
					"id": 401870340,
					"content": "Benar! Yun Jin. Jadi kamu belum lupa ya sama apa yang dia bilang tempo hari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870341
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 401870341,
					"content": "Tuh lihat, dia sudah di atas panggung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870342
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 401870342,
					"content": "Woah! Bukannya itu pemimpin dari Grup Opera Yun-Han?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870343
					],
					"speakerTitle": "Lixing"
				},
				{
					"id": 401870343,
					"content": "Waduh! Tidak disangka bisa lihat dia di Dermaga Yilong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870344
					],
					"speakerTitle": "Jiewu"
				},
				{
					"id": 401870344,
					"content": "Halo, semuanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870345
					],
					"speakerTitle": "Yun Jin"
				},
				{
					"id": 401870345,
					"content": "Aku akan tampilkan \"Pemurnian Tao Dou\" sekali lagi, untuk semua teman-temanku yang tidak bisa mengikuti perayaan Lantern Rite waktu itu. Maaf karena aku tidak bisa menyiapkan panggung yang lebih indah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870346
					],
					"speakerTitle": "Yun Jin"
				},
				{
					"id": 401870346,
					"content": "Aww, baik amat! Dia mau tampil lagi demi semua orang yang waktu itu enggak bisa datang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870347
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870347,
					"content": "Ssh! Sudah mau mulai tuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870356
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 401870356,
					"content": "Ingat lagi pernyataan gila tentang Tao Dou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870348
					],
					"speakerTitle": "Yun Jin"
				},
				{
					"id": 401870348,
					"content": "Melalui nada tak merdu dan nasib yang pilu, sambutlah panggilanku, wahai jiwa-jiwa dari dua dunia yang tak bertemu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870349
					],
					"speakerTitle": "Yun Jin"
				},
				{
					"id": 401870349,
					"content": "Delusi apa yang kau miliki, dengan tulang dan darah membakar kerajaan ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870350
					],
					"speakerTitle": "Yun Jin"
				},
				{
					"id": 401870350,
					"content": "Bayangan perang 'kan memudar ditelan waktu, namun kisah penyelamatan tak pernah lalu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870351
					],
					"speakerTitle": "Yun Jin"
				},
				{
					"id": 401870351,
					"content": "Bila darah tertumpah dosa terutang, hukum hidup mati tak dapat kau tentang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870352
					],
					"speakerTitle": "Yun Jin"
				},
				{
					"id": 401870352,
					"content": "Jalan langit padanyalah kebenaran, hati dan pikiran sempit padanyalah kehancuran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870353
					],
					"speakerTitle": "Yun Jin"
				},
				{
					"id": 401870353,
					"content": "Sumpah terikrar 'tuk memberangus kejahatan, demi melawan Tao Dou, delapan sosok sakti pun menghunus pedangnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870354
					],
					"speakerTitle": "Yun Jin"
				},
				{
					"id": 401870354,
					"content": "Meski raga t'lah lelah dan jiwa terhanyut, tapi mimpi dan jalan 'kan terus berlanjut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870355
					],
					"speakerTitle": "Yun Jin"
				},
				{
					"id": 401870355,
					"content": "Burung walet 'kan pulang demi sarang baru, bak tangis dan ranting mengenang hari itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yun Jin"
				}
			]
		},
