						],
						"pointId": 10621
					}
				]
			},
			"dialogs": [
				{
					"id": 401870101,
					"content": "#Hei, {NICKNAME} dan Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870102
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870102,
					"content": "Oh, hei Xiangling! Ada apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870103,
					"content": "Ih, kok masih nanya! Kan kita mau kumpul-kumpul!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870104
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870104,
					"content": "Ah akhirnya, waktunya makan!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870105
					]
				},
				{
					"id": 401870105,
					"content": "Yup! Kamu sekarang ada waktu, kan? Kamu tidak boleh mangkir tanpa alasan yang jelas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870106
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870106,
					"content": "Kan bukan kita yang mangkir! Hu Tao, tuh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870107,
					"content": "Iya tuh ... Dia pikir mentang-mentang dia Direktur jadi bisa kabur begitu aja. Seolah kalau tidak ramai, dia jadi tidak mau datang gitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870108
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870108,
					"content": "Tapi tenang saja. Kami sudah sepakat kalau kali ini, dia tidak boleh bikin alasan lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870109
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870109,
					"content": "Oh? \"Kami\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870110,
					"content": "Hehe, Xingqiu dan aku! Dia bilang sudah lama mau traktir semuanya, tapi karena situasi kakek buyutnya lagi gawat, jadi tidak ada waktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870111
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870111,
					"content": "Tapi ajaibnya, di malam Lantern Rite, kakek buyutnya tiba-tiba terbangun! Xingqiu langsung kaget — dan akhirnya dia sekarang punya waktu buat keluar rumah. Jadi kita langsung ketemuan dan bikin rencana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870112
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870112,
					"content": "Wow! Jadi kakek buyutnya bakalan sembuh total?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870113,
					"content": "Iya! Dokter sudah periksa semuanya. Dia bakalan sembuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870114
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870114,
					"content": "Menurut Xingqiu, kakek buyutnya jadi makan lahap sekali sejak bangun, sudah kayak Paimon tuh ... Jadi sekarang keluarganya khawatir dia bakal kena masalah pencernaan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870115
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870115,
					"content": "Hmm ... Ya itu kabar baik sih, tapi kok kayaknya nama Paimon jadi jelek ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870116,
					"content": "Tenang, itu pujian kok! Nafsu makanmu itu menggambarkan pandangan positif dalam hidup: \"Makanlah sepuasnya, dan tinggalkan sumpitmu tanpa penyesalan\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870117
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870117,
					"content": "Kata-kata yang bagus, Xiangling! Justru moto itu yang Paimon pegang sampai sekarang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870118,
					"content": "Masa? Kok ini pertama kalinya aku dengar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870119
					]
				},
				{
					"id": 401870119,
					"content": "Iya! Kayak yang Xiangling bilang, makan sepuas hati dan jangan sampai meninggalkan sumpit dengan rasa penyesalan ... Ya kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870120,
					"content": "Haha, tenang saja Paimon. Simpan kata-kata itu buat makan malam nanti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870121
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870121,
					"content": "Hehe, enggak masalah! Tapi kita mau makan ke mana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870122,
					"content": "Nanti malam di Dermaga Yilong! Xingqiu dan yang lainnya masih di sana kok. Oh, terus Hu Tao bilang kita punya tamu spesial!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870123
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870123,
					"content": "Siapa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870124
					]
				},
				{
					"id": 401870124,
					"content": "Nanti juga bakal tahu sendiri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870125
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870125,
					"content": "Oooh! Paimon kayaknya tahu ... hehe, tapi Paimon enggak bakal ngomong dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870126,
					"content": "Aku juga kayaknya tahu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870127
					]
				},
				{
					"id": 401870127,
					"content": "Hah? Siapa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870128,
					"content": "Aku juga diam saja deh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870129
					]
				},
				{
					"id": 401870129,
					"content": "Hmph! Oke kita lihat malam ini siapa yang tebakannya tepat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4018703,
