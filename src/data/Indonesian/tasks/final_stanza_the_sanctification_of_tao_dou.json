				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-647.266,
							258.226,
							428.226
						],
						"pointId": 10623
					}
				]
			},
			"dialogs": [
				{
					"id": 401870501,
					"content": "Hei, krisisnya kan sudah teratasi. Kenapa murung begitu, Tianquan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870502
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 401870502,
					"content": "#Bencananya memang sudah teratasi berkat Direktur Hu dan {NICKNAME}. Tapi kita masih belum tahu apa penyebabnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870503
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 401870503,
					"content": "Kapten, aku tahu kamu punya banyak informasi. Jadi aku yakin kamu juga sadar kalau belakangan ini bangsa Natlan sedang mengalami gejolak Ley Line yang berhubungan dengan hidup dan mati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870504
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 401870504,
					"content": "Aku jadi berpikir jangan-jangan semua ini punya hubungan yang lebih erat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870505
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 401870505,
					"content": "Kalau memang begitu, berarti hal ini lebih besar lagi daripada sekadar Liyue dan Natlan, aku akan kirim surat ke rekan-rekan bisnisku, dan juga mengawasi kalau-kalau ada insiden yang sama di bangsa lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870506
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 401870506,
					"content": "Sekarang ini ... kita kesampingkan dulu saja kekhawatiran kita dan fokus dulu menikmati festival indah depan mata, kalau tidak kamu harus tunggu setahun lagi loh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870507
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 401870507,
					"content": "Hehe, iya. Kamu tidak perlu mengajariku soal keseimbangan antara hidup dan kerja — aku bukan Keqing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870508
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 401870508,
					"content": "Oh? Kalau gitu kenapa kamu masih pakai jepit rambut yang itu? Kan aku sudah bilang buat pakai bayaranku beli jepit rambut baru?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870509
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 401870509,
					"content": "Mana berani aku menyentuh Mora milik Kapten Beidou tanpa konfirmasi lagi. Bagaimana kalau ternyata kamu waktu itu cuma ngomong spontan saja? Nanti kamu bakal ngoceh terus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870510
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 401870510,
					"content": "Hahaha, harus aku pilihin buat kamu ya? Ya sudah, ayo deh. Yuk ke jalan-jalan di sepanjang jalan festival.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870511
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 401870511,
					"content": "Bagus ... Sejak kapan Kapten yang blak-blakan ini jadi peka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870512
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 401870512,
					"content": "Hahaha, sudah sudah. Jadi kamu mau apa tidak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870513
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 401870513,
					"content": "Kenapa tidak? Ayo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ningguang"
				}
			]
		},
