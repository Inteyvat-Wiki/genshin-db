				]
			},
			"dialogs": [
				{
					"id": 401870701,
					"content": "Anak muda dari Wangsheng Funeral Parlor itu cukup hebat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870702
					],
					"speakerTitle": "Xianyun"
				},
				{
					"id": 401870702,
					"content": "Diriku selalu penasaran mengapa Rex Lapis ingin bekerja sebagai konsultan untuknya. Tapi kini diriku mulai paham kebenaran di balik keputusannya tersebut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870703
					],
					"speakerTitle": "Xianyun"
				},
				{
					"id": 401870703,
					"content": "Diriku pun sependapat. Dan sungguh langka sekali untuk mendengar pujian tulus keluar dari mulutmu, Cloud Retainer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870704
					],
					"speakerTitle": "Moon Carver"
				},
				{
					"id": 401870704,
					"content": "\"Langka\"? Tolong jelaskan lebih lanjut arti perkataanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870705
					],
					"speakerTitle": "Xianyun"
				},
				{
					"id": 401870705,
					"content": "Kalau dulu, dirimu mungkin akan berkata begini: \"Walaupun anak muda itu memiliki bakat yang luar biasa, tapi itu tidak lebih daripada apa yang bisa dicapai oleh Shenhe atau Ganyu jika mereka ada di posisi yang sama.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870706
					],
					"speakerTitle": "Mountain Shaper"
				},
				{
					"id": 401870706,
					"content": "Hmph! Diriku tidak akan pernah mengesampingkan pencapaian orang lain hanya demi memuji anak sendiri. Anak muda dari Wangsheng itu memang telah menunjukkan tekad dan keyakinan yang kuat. Bukankah itu membuatnya layak mendapatkan beberapa patah kata pujian?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870707
					],
					"speakerTitle": "Xianyun"
				},
				{
					"id": 401870707,
					"content": "Hehehe, tentu saja layak. Dan dia bukanlah yang pertama. Diriku telah tinggal di Pelabuhan Liyue cukup lama, dan diriku mengakui bahwa Wangsheng Funeral Parlor telah menghasilkan generasi-generasi Direktur yang penuh bakat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870708
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 401870708,
					"content": "Streetward Rambler benar. Dewa Tao Dou bukanlah teman kita, namun juga bukan musuh. Andai dia tidak peduli dengan semua makhluk hidup, dan akhirnya bersedia mengorbankan diri untuk memurnikan dunia bawah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870709
					],
					"speakerTitle": "Moon Carver"
				},
				{
					"id": 401870709,
					"content": "Jangankan Delapan Sosok Sakti, bahkan Delapan Adeptus saja mungkin belum tentu bisa mengalahkannya. Saat dia berubah menjadi perbatasannya, dia mungkin juga tidak membayangkan bahwa makhluk fana bisa bertahan sejauh ini di masa depan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870710
					],
					"speakerTitle": "Moon Carver"
				},
				{
					"id": 401870710,
					"content": "Oh ya, diriku masih belum mengetahui siapa nama gadis muda dari Wangsheng Funeral Parlor tersebut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870711
					],
					"speakerTitle": "Mountain Shaper"
				},
				{
					"id": 401870711,
					"content": "Marga Direktur adalah Hu, dan namanya adalah Tao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870712
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 401870712,
					"content": "Hu ... Ah! \"Hu\" yang artinya kupu-kupu dalam bahasa kita, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870713
					],
					"speakerTitle": "Moon Carver"
				},
				{
					"id": 401870713,
					"content": "Tidak, \"Hu\" yang artinya \"pembuat onar\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870714
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 401870714,
					"content": "Kalau begitu \"Tao\" yang artinya \"nakal\" dalam bahasa kita, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870715
					],
					"speakerTitle": "Moon Carver"
				},
				{
					"id": 401870715,
					"content": "Tidak, tapi Tao yang sama seperti nama \"Tao Dou\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870716
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 401870716,
					"content": "AH. Jadi \"Hu\" artinya kupu-kupu, dan \"Tao\" diambil dari \"Tao Dou\". Benar-benar nama yang bagus. Cocok sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870717
					],
					"speakerTitle": "Mountain Shaper"
				},
				{
					"id": 401870717,
					"content": "Tidak, Hu yang artinya \"pembuat onar\", \"senang bermain-main\", dan \"doyan makan\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870718
					],
					"speakerTitle": "Xianyun"
				},
				{
					"id": 401870718,
					"content": "Yah, diriku hanya ingin mencairkan suasana. Kenapa Hu Tao boleh berbuat onar, tapi diriku tidak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870719
					],
					"speakerTitle": "Mountain Shaper"
				},
				{
					"id": 401870719,
					"content": "Hah! Petunjuknya justru ada di namanya. Jika dirimu ingin berganti nama dari Mountain Shaper menjadi Mischief Maker ya silakan saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870720
					],
					"speakerTitle": "Xianyun"
				},
				{
					"id": 401870720,
					"content": "Hehe, bagaimana jika kita minum teh dulu? Ini adalah \"Spirit Sprout\" yang dibawa oleh Rex Lapis dari Desa Qingce. Sayang sekali untuk dilewatkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870721
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 401870721,
					"content": "Semoga saja di tahun-tahun ke depan kita masih bisa minum teh bersama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870722
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 401870722,
					"content": "Iya, pasti bisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				}
			]
		}
	]
