			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Keqing",
					"Ganyu"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-576.45,
							254.38,
							465.98
						],
						"pointId": 10624
					}
				]
			},
			"dialogs": [
				{
					"id": 401870601,
					"content": "Masih kerja, Ganyu? Belakangan ini sibuk sekali ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870602
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 401870602,
					"content": "#Hah? Oh, Keqing ... Tidak apa-apa kok, sudah biasa. {NICKNAME} dan Direktur Hu lah bintang yang sebenarnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870603
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 401870603,
					"content": "Ini bukanlah alasan untuk mengesampingkan pencapaianmu sendiri juga. Walaupun tentu saja merekalah pahlawan terbesar kita ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870604
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 401870604,
					"content": "Tapi kita sendiri juga ada andil, dan kita sudah melakukan yang terbaik. Bagian Urusan Sipil merespons dengan sangat cepat, ya kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870605
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 401870605,
					"content": "Walaupun jika dilihat dari luar, insiden ini tidak sebanding dengan bencana Perang Archon, tapi ini juga sudah termasuk parah. Kalau sampai kemarin ini tidak ada solusi, aku tidak akan berani membayangkan akan bagaimana jadinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870606
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 401870606,
					"content": "Benar ... Sebenarnya, aku sendiri ada pertanyaan soal Metode Tujuh dan Delapan Gerbang yang kita gunakan. Bagaimana bisa aku belum pernah lihat catatan soal itu di Yuehai Pavilion sebelumnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870607
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 401870607,
					"content": "Oh, kamu mau tahu asal usul formasi sihir itu? Itu hanya karangan Ningguang sendiri saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870608
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 401870608,
					"content": "HAH?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870609
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 401870609,
					"content": "Haha. Aku bercanda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870610
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 401870610,
					"content": "Sebenarnya, ada sebuah surat yang berisi info penting tiba-tiba saja muncul di Yujing Terrace di saat kita sedang benar-benar membutuhkan. Bahkan Yelan sendiri saja tidak mampu melacak dari mana asalnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870611
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 401870611,
					"content": "Tunggu ... Jadi tiba-tiba saja info itu muncul? Lalu ... Apa Nona Ningguang tidak merasa itu terlalu berisiko ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870612
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 401870612,
					"content": "Yah, kelihatannya sih begitu. Tapi kalau dipikir lagi baik-baik, semuanya mulai terasa masuk akal ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870613
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 401870613,
					"content": "Berapa orang di Liyue yang tahu tentang krisis dan ilmu rahasia ini dan juga memiliki kemampuan untuk mengirim surat tanpa bisa dilacak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870614
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 401870614,
					"content": "Ah ... Jadi maksudnya ... dari Master dan teman-temannya ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870615
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 401870615,
					"content": "Ternyata begitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ganyu"
				}
			]
		},
		{
