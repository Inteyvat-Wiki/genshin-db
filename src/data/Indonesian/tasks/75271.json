			"dialogs": [
				{
					"id": 752710601,
					"content": "Yopoyi! Kamu datang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710602
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710602,
					"content": "Ziki? Kamu kan ini ... Pakaianmu kenapa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710603
					],
					"speakerTitle": "Yopoyi"
				},
				{
					"id": 752710603,
					"content": "Ini Manusia Nanas favoritmu. Aku menyewa kostumnya khusus untuk pertemuan ini. Keren, kan? Oh, dan balon-balon ini! Aku menyiapkannya khusus untukmu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710604
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710604,
					"content": "Sebenarnya ada sesuatu yang sudah lama mau kukatakan padamu ... Ayo kita pergi berkencan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710605
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710605,
					"content": "Kamu ... lagi sakit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710606
					],
					"speakerTitle": "Yopoyi"
				},
				{
					"id": 752710606,
					"content": "Tidak dong! Perempuan cantikku, Yopoyi, ayo, kita pergi kencan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710607
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710607,
					"content": "Kamu geger otak waktu pakai kostum ini atau kenapa? Ini ulang tahun pernikahan kita yang ketiga! Kita kan sudah MENIKAH!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710608
					],
					"speakerTitle": "Yopoyi"
				},
				{
					"id": 752710608,
					"content": "Aku tahu! Tapi ... kamu selalu bilang aku bukan laki-laki romantis, dan kita bahkan tidak pernah saling mengungkapkan perasaan kita dengan benar sebelum menikah ... Jadi meskipun terlambat, inilah ungkapan cintaku padamu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710609
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710609,
					"content": "Haha ... Ya memang begitu, kan? Ayo deh, ayo deh. Ayo kita kencan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710610
					],
					"speakerTitle": "Yopoyi"
				},
				{
					"id": 752710610,
					"content": "Serius?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710611
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710611,
					"content": "Ya, serius dong, dasar kamu orang yang konyol dan romantis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710612
					],
					"speakerTitle": "Yopoyi"
				},
				{
					"id": 752710612,
					"content": "Angin berembus kencang, dan sepasang kekasih itu pun saling berpelukan.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
