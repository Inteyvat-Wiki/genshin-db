				"points": []
			},
			"dialogs": [
				{
					"id": 752710301,
					"content": "Balon merah yang romantis ... Aku yakin keindahannya akan menggetarkan hati kekasihku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710302
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710302,
					"content": "Bukankah begitu, kawan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710303,
						752710304
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710303,
					"content": "Uhhh ... Aku tidak tahu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752710305
					]
				},
				{
					"id": 752710305,
					"content": "Bagaimanapun juga, terima kasih banyak, kawan. Tunggu sebentar dulu, aku ingin memperkenalkanmu pada Yopoyi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710306
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710306,
					"content": "Kalau lihat waktu sekarang, seharusnya sebentar lagi dia sampai. Kami sudah janjian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710304,
					"content": "Dia pasti tersentuh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752710305
					]
				}
			]
		},
