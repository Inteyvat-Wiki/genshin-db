			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Félix Yogue"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705140401,
					"content": "Benar ini dia! Benar! Hebat sekali, komponen milikku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140402
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140402,
					"content": "Komponen telah lengkap, selanjutnya menggabungkan komponen ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140403
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140403,
					"content": "Hm ... Honorary Knight, jika kamu tertarik, kamu juga dapat mencoba merakit komponen \"Lukisan Mekanik Abadi\" ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140404
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140404,
					"content": "Percaya padaku, ini menyenangkan sekali kok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Félix Yogue"
				}
			]
		},
