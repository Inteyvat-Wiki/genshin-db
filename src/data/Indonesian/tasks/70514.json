			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Félix Yogue",
					"Swan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705140101,
					"content": "Antusiasme Mondstadt di luar imajinasiku ... Memang pantas, bahkan Hilichurl-nya saja semangat sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140102
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140102,
					"content": "Bagaimanapun ... Tuan Yogue, tolong Anda jangan keluar sendiri lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140103
					],
					"speakerTitle": "Swan"
				},
				{
					"id": 705140103,
					"content": "Apa? Lalu bagaimana dengan mesin mekanikku? Hmm ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140104
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140104,
					"content": "Satu, dua, tiga ... delapan belas ... sembilan belas komponen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140105
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140105,
					"content": "Sudah ada petualang yang membantu Anda, Anda bisa menunggu di kota dengan tenang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140106
					],
					"speakerTitle": "Swan"
				},
				{
					"id": 705140106,
					"content": "Tapi tanpa mesin mekanik itu, inspirasiku ... duh kamu paham kan maksudku. Bagaimana jika inspirasiku datang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140107
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140107,
					"content": "Inspirasi berlalu dengan cepat, seperti ... seperti bersendawa setelah minum, dan bagaikan api lilin yang diterpa angin, begitu cepat berlalu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140108
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140108,
					"content": "Hm, metafora yang bagus, aku harus mengingatnya, Xavier pasti akan suka ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140109
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140109,
					"content": "Kamu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140110
					],
					"speakerTitle": "Swan"
				},
				{
					"id": 705140110,
					"content": "Eh? Honorary Knight ... Baguslah, ayo! Cepat ke sini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140111,
						705140112
					],
					"speakerTitle": "Swan"
				},
				{
					"id": 705140111,
					"content": "Kenapa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705140113
					]
				},
				{
					"id": 705140113,
					"content": "Aku perkenalkan terlebih dulu, beliau datang dari Court of Fontaine ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140114
					],
					"speakerTitle": "Swan"
				},
				{
					"id": 705140114,
					"content": "Klub Pemimpi! Kami menyebut diri sendiri begitu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140115
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140115,
					"content": "Tuan Yogue, beliau adalah Honorary Knight dari Mondstadt ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140116
					],
					"speakerTitle": "Swan"
				},
				{
					"id": 705140116,
					"content": "Aha! Yogue, Félix Yogue! Hormat kepada Honorary Knight! Aku sudah sering dengar tentang kehebatanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140117
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140117,
					"content": "Kamu kenal aku?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705140118
					]
				},
				{
					"id": 705140118,
					"content": "Tentu saja! Aku tentu saja mengenalmu, siapa yang tidak mengenalmu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140119
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140119,
					"content": "Pertempuranmu dengan Dvalin di Mondstadt sebelumnya, telah menjadi berita utama di \"The Steambird\" selama tiga minggu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140120
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140120,
					"content": "Haha, jika para reporter itu tahu aku sedang berbicara denganmu, mereka pasti akan sangat cemburu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140121,
						705140124
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140121,
					"content": "Apa itu \"The Steambird\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705140122
					]
				},
				{
					"id": 705140122,
					"content": "Kamu tidak tahu? \"The Steambird\" adalah ... hmm ... surat kabar ternama di Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140123
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140123,
					"content": "Dan kamu pernah membantu mereka mencapai puncak penjualannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140125
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140125,
					"content": "Berita utama?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705140126
					]
				},
				{
					"id": 705140126,
					"content": "Tentu saja, kamu telah membantu mereka mencapai puncak penjualan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140127
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140127,
					"content": "Judul halaman depan, edisi lengkap, wawancara ahli, dan juga ilustrasi gambar terbaik, hah! Kamu berhasil bikin hujan Mora buat mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140128
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140128,
					"content": "Hm ... Pengembara, Tuan Yogue, kalian ngobrol dulu, aku harus mengurus hal lain dulu, permisi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140129
					],
					"speakerTitle": "Swan"
				},
				{
					"id": 705140129,
					"content": "Swan lalu pergi ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						705140130
					]
				},
				{
					"id": 705140130,
					"content": "Baiklah, memang seperti yang kudengar, tampaknya Knights of Favonius selalu sibuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140131
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140131,
					"content": "Jadi, kenapa kamu datang ke Mondstadt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705140132
					]
				},
				{
					"id": 705140132,
					"content": "Aku? Sebenarnya, aku berencana melakukan perjalanan ke Teyvat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140133
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140133,
					"content": "Dan tujuan perjalananku, adalah untuk menjual \"Inti Kinetik\" yang aku buat ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140134
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140134,
					"content": "Sederhananya, ini adalah sebuah mekanisme jarum jam, selama jarum jam diputar dengan interval tertentu, dia dapat menyediakan energi kinetik untuk waktu yang lama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140135
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140135,
					"content": "Untuk mendemonstrasikan mesin mekanik ini, aku telah membuat sebuah mainan mekanik yang digerakkan oleh \"Inti Kinetik\", yang aku beri nama \"Lukisan Mekanik Abadi\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140136
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140136,
					"content": "Hm ... Tapi sayangnya, meski aku ingin menunjukkan mesin mekanik ini padamu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140137
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140137,
					"content": "Tapi mesin ini terlalu bagus, bahkan banyak monster yang tidak dapat tahan dengan pesonanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140138
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140138,
					"content": "Saat ini mereka pasti sedang mengoyak-ngoyak mesinku jadi beberapa bagian dengan brutal ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140139
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140139,
					"content": "Meski telah meminta bantuan dari Adventurers' Guild, para petualang belum memberikan kabar apa pun ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140140
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140140,
					"content": "Honorary Knight, jika kamu tertarik, mungkin bisa membantuku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140141
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140141,
					"content": "Percayalah, mesin milikku dan imbalannya tidak akan mengecewakanmu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140142
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140142,
					"content": "Serahkan saja padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705140143
					]
				},
				{
					"id": 705140143,
					"content": "Luar biasa, kamu sebaik yang diberitakan di surat kabar, petualang kuat, juga seseorang yang baik hati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140144
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140144,
					"content": "Sayang kita sedang berada di Mondstadt, jika di Fontaine, aku pasti akan membawa reporter dari \"The Steambird\" untuk memberikan wawancara eksklusif untukmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140145
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140145,
					"content": "Mereka pasti akan terkesan lagi dengan pesonamu, bersedia memberikan halaman terdepan untuk tiga minggu berikutnya, juga imbalan untukmu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140124,
					"content": "Judul halaman depan, edisi lengkap, wawancara ahli, dan juga ilustrasi gambar terbaik, hah! Kamu berhasil bikin hujan Mora buat mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140125
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140112,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705140113
					]
				}
			]
		},
		{
