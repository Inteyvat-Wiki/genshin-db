				"points": []
			},
			"dialogs": [
				{
					"id": 230400801,
					"content": "Pengembara! Untunglah! Tolong bantu Habachi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400802,
						230400803
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400802,
					"content": "Apa yang terjadi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400804
					]
				},
				{
					"id": 230400804,
					"content": "Haduh, tiba-tiba muncul Treasure Hoarder di luar desa, mereka mencegat orang-orang kami yang bawa barang! Semua penjaga yang bisa dimintai tolong sudah diperbantukan ke sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400805
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400805,
					"content": "Habachi bilang masih kurang, jadi dia ambil senjata dan langsung lari ke luar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400806
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400806,
					"content": "Katanya Treasure Hoarder kali ini jumlahnya banyak sekali. Habachi mana sanggup sendirian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400807
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400807,
					"content": "Pengembara, titiknya sudah aku tandai di petamu. Tolonglah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400808,
						230400810
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400808,
					"content": "Meluncur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400809
					]
				},
				{
					"id": 230400809,
					"content": "Mohon bantuannya, Pengembara. Semoga Habachi tidak kenapa-kenapa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400810,
					"content": "Dia pintar bertarung?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400811
					]
				},
				{
					"id": 230400811,
					"content": "Kalau satu atau dua berandalan doang, Habachi bisa lah urus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400812
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400812,
					"content": "Tapi kali ini beda, ini gerombolan Treasure Hoarder yang sudah berencana menyergap. Kalau bukan karena orang kami yang paling cepat larinya dari para pengantar barang tidak sampai ke sini dan lapor, kami mungkin belum tahu ada kejadian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400813
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400813,
					"content": "Aduh, andai Nona Candace ada di sini, Treasure Hoarder mana berani kurang ajar begini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400814
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400814,
					"content": "Mereka pasti sudah rencanakan semua, tunggu ketika dia tidak ada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400815
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400815,
					"content": "Pengembara, tolong ... tolong bantu Habachi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400803,
					"content": "Kok panik?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400804
					]
				}
			]
		},
