				"points": []
			},
			"dialogs": [
				{
					"id": 230400401,
					"content": "Gimana? Sudah diusir semua?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400402,
						230400403
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400402,
					"content": "Semua sudah beres.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400404
					]
				},
				{
					"id": 230400404,
					"content": "Terima kasih banyak! Akhirnya Habachi bisa makan dengan tenang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400405
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400405,
					"content": "Oh iya, ini. Terimalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400406
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400406,
					"content": "Eh ... Hari ini ada kiriman apa ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400403,
					"content": "Harusnya sih tidak akan nongol lagi dalam waktu dekat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400404
					]
				}
			]
		},
		{
			"id": 2304005,
			"completionStepIds": [
				2304005
