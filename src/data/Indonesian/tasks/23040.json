			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Najat"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230400201,
					"content": "Haih ... Red Vulture lagi! Belum habis belum puas ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400202
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400202,
					"content": "Apa yang terjadi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400203
					]
				},
				{
					"id": 230400203,
					"content": "Kamu ... Pengembara? Aku sudah dengar tentang kamu dari Ebeid.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400204
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400204,
					"content": "Hehe, jarang-jarang ada Pengembara yang datang ke desa ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400205
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400205,
					"content": "Oh, sudah ketemu Habachi? Dia orangnya memang sangat serius ... kalau ada cara bicaranya yang sedikit kelewatan, mohon maklum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400206
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400206,
					"content": "Dan lagi pula ... Ini tempat penyimpanan untuk segala macam barang kebutuhan, termasuk makanan, senjata, uang, dan barang berharga lainnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400207
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400207,
					"content": "Cuma sedikit anak muda yang masih tinggal di sini, dan mereka harus tangani segala macam, mulai dari melindungi desa sampai urusan sehari-hari penduduk. Karena itulah Habachi jadi satu-satunya orang yang bertanggung jawab menjaga gudang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400208
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400208,
					"content": "Aku tidak bisa bantu banyak. Cuma bisa catat dan bantu hitung barang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400209
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400209,
					"content": "Memangnya ada apa dengan Red Vulture?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400210
					]
				},
				{
					"id": 230400210,
					"content": "Aih, jangan diungkit lah. Belum lama ini kami dapat kiriman dendeng, yang lalu ikut disimpan di gudang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400211
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400211,
					"content": "Mungkin burung-burung itu terpancing baunya. Mereka jadi sering bertengger di bukit dekat gudang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400212
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400212,
					"content": "Dendeng yang di dalam sih aman, tapi begitu ada orang yang makan, dan kelihatan sama mereka ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400213
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400213,
					"content": "Para penjaga terlalu sibuk, tidak ada waktu untuk usir burung. Habachi juga sama sibuknya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400214
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400214,
					"content": "Pengembara, kalau lagi senggang ... boleh minta tolong bereskan mereka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400215,
						230400217
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400215,
					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400216
					]
				},
				{
					"id": 230400216,
					"content": "Tolong ya. Red Vulture itu ganas, jadi ingat jaga jarak. Saranku sih bawa busur dan panah saja, lebih aman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400217,
					"content": "Memangnya pernah ada kejadian? Ada korban?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400218
					]
				},
				{
					"id": 230400218,
					"content": "Oh, banyak. Barang yang lagi dalam perjalanan, daging yang lagi dikeringkan, makan siangnya Habachi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400219
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400219,
					"content": "Kalau Habachi makan saat bertugas, dia biasa simpan makanannya di pinggir. Meleng sedikit saja, ludes sudah makan siangnya disikat burung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400220
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400220,
					"content": "Dia tidak bisa meninggalkan posisinya karena masih tugas jaga. Kasihan, cuma bisa menghabiskan sisa makan siangnya yang sudah diacak-acak burung ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400221
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400221,
					"content": "Mohon bantuannya, Pengembara. Tolong usir semua burungnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Najat"
				}
			]
		},
