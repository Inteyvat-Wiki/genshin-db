			"dialogs": [
				{
					"id": 230401002,
					"content": "*huff* Terima kasih banyak, Pengembara. Kalau tidak ada kamu, barang-barang ini pasti raib semua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230401003,
						230401005
					],
					"speakerTitle": "Habachi"
				},
				{
					"id": 230401003,
					"content": "Jurusmu hebat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230401004
					]
				},
				{
					"id": 230401004,
					"content": "Hehe, kamu terlalu memuji. Jujur, aku tidak akan bisa menang kalau cuma sendirian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230401007
					],
					"speakerTitle": "Habachi"
				},
				{
					"id": 230401007,
					"content": "Hah, aku masih kurang kut. Kalau Nona Candace yang turun, Treasure Hoardernya pasti langsung tepar semua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230401008
					],
					"speakerTitle": "Habachi"
				},
				{
					"id": 230401008,
					"content": "Maaf, bukan waktunya ngomong beginian. Barangnya harus segera dibawa ke desa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230401009
					],
					"speakerTitle": "Habachi"
				},
				{
					"id": 230401009,
					"content": "Pengembara, di sini tidak aman, kamu juga cepatlah pulang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230401010
					],
					"speakerTitle": "Habachi"
				},
				{
					"id": 230401010,
					"content": "Tapi kali ini Treasure Hoarder tanggap sekali, sepertinya sudah pasang mata dan telinga di mana-mana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Habachi"
				},
				{
					"id": 230401005,
					"content": "Kamu sendirian?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230401006
					]
				},
				{
					"id": 230401006,
					"content": "Ada penjaga lain yang ikut, tapi mereka sudah pergi cari barang di tempat lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230401007
					],
					"speakerTitle": "Habachi"
				}
			]
		}
