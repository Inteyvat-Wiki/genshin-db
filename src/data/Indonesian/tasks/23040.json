					"Najat"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230400501,
					"content": "Aduh, kapan Habachi bisa istirahat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400502
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400502,
					"content": "Apa yang terjadi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400503
					]
				},
				{
					"id": 230400503,
					"content": "Pengembara, tepat sekali waktunya! Boleh minta tolong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400504
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400504,
					"content": "Kami dapat kiriman makanan kering dari luar. Habachi yang mau bawa barangnya ke sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400505
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400505,
					"content": "Tapi ada lagi yang datang karena mencium bau makanan dan langsung menyerbu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400506
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400506,
					"content": "Burungnya sudah diusir sama penjaga, tapi makanannya jadi berantakan, tersebar ke mana-mana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400507
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400507,
					"content": "Sudah ada yang pergi memberi tahu yang lain, tapi Habachi sekarang sibuk mengumpulkan sisa-sisanya yang masih bisa dimakan. Pengembara ... bisa bantu ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400508,
						230400510
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400508,
					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400509
					]
				},
				{
					"id": 230400509,
					"content": "Terima kasih ya. Maaf, aku masih menunggu kiriman yang lainnya datang, tidak bisa pergi sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400510,
					"content": "Habachi baik-baik saja?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400511
					]
				},
				{
					"id": 230400511,
					"content": "Aih, aku sudah bilang supaya dia duduk, istirahat dulu, tapi dia tidak mau. Katanya mau lanjut stok opnam setelah beres mengumpulkan makanan yang tercerai-berai. Dia kerja bagai kuda ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400512
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400512,
					"content": "Barangnya ada di dekat Lift Putih. Pengembara, tolong bawakan kemari ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Najat"
				}
			]
		},
