					"nextDialogs": [
						413320323
					]
				},
				{
					"id": 413320323,
					"content": "Akhirnya datang juga, aku sudah menunggu begitu lama... tapi pastinya repot juga ya bagimu masih harus pergi mengantar makanan pada hari festival begini.",
					"roleType": "TALK_ROLE_NPC",
