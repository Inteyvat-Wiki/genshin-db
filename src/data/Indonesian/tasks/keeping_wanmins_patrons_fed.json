					"Koki Mao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413321401,
					"content": "Apa makanannya sudah kamu antar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413321402
					],
					"speakerTitle": "Koki Mao"
				},
				{
					"id": 413321402,
					"content": "Sudah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413321403
					]
				},
				{
					"id": 413321403,
					"content": "Oke, lalu bagaimana dengan bantuan yang kuminta, apakah kamu sudah menanyakan Wrench Wang, Guahai dan Zhihua, mereka ingin makan apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413321404
					],
					"speakerTitle": "Koki Mao"
				},
				{
					"id": 413321404,
					"content": "Wrench Wang dan Li Hammer ingin makan Bamboo Shoot Soup.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413321405
					]
				},
				{
					"id": 413321405,
					"content": "Oh? Kedua orang ini punya selera yang sama, walaupun Bamboo Shoot Soup membutuhkan banyak waktu untuk membuatnya. Aku harus segera bersiap-siap untuk membuatnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413321407
					],
					"speakerTitle": "Koki Mao"
				},
				{
					"id": 413321407,
					"content": "Guahai ingin makan Squirrel Fish.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413321408
					]
				},
				{
					"id": 413321408,
					"content": "Tidak masalah, aku ahlinya dalam memasak makanan itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413321409
					],
					"speakerTitle": "Koki Mao"
				},
				{
					"id": 413321409,
					"content": "Zhihua ingin makan Lotus Flower Crisp.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413321410
					]
				},
				{
					"id": 413321410,
					"content": "Tak disangka, Zhihua suka makan makanan penutup yang kecil dan indah seperti itu, tetapi Lotus Flower Crisp tidak sulit untuk dibuat, jadi tidak masalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413321411
					],
					"speakerTitle": "Koki Mao"
				},
				{
					"id": 413321411,
					"content": "Terima kasih telah mendengar permintaanku dan membantuku, ini ada hadiah kecil untukmu, terimalah. Aku juga harus segera bersiap-siap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413321412
					],
					"speakerTitle": "Koki Mao"
				},
				{
					"id": 413321412,
					"content": "Apa kamu tidak mau menggantung Lentera Xiao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413321413
					]
				},
				{
					"id": 413321413,
					"content": "Huff, bagaimana mungkin bisa ada waktu, aku benar-benar sibuk, Xiangling baru saja kembali dan dia juga sudah pergi lagi mengantar makanan...",
					"roleType": "TALK_ROLE_NPC",
