					"Koki Mao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413320201,
					"content": "Hidangan lainnya datang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320202
					],
					"speakerTitle": "Koki Mao"
				},
				{
					"id": 413320202,
					"content": "Apa yang sedang kamu lakukan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413320203
					]
				},
				{
					"id": 413320203,
					"content": "Apa yang sedang aku lakukan? Eh, aku menjalankan bisnis di Wanmin Restaurant, hahaha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320204
					],
					"speakerTitle": "Koki Mao"
				},
				{
					"id": 413320204,
					"content": "Akhir-akhir ini semua orang sibuk sekali dan mereka semua pergi makan pada saat Lantern Rite. Bahkan pengembara dari tempat yang jauh pun datang berkunjung untuk ikut merayakan festival ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320205
					],
					"speakerTitle": "Koki Mao"
				},
				{
					"id": 413320205,
					"content": "Walaupun putriku Xiangling sudah pulang untuk membantu, kami masih kesulitan untuk mengatur semua ini. Dia sendiri saja tadi baru keluar untuk mengantarkan pesanan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320206
					],
					"speakerTitle": "Koki Mao"
				},
				{
					"id": 413320206,
					"content": "Di saat semua orang keluar untuk menggantung lentera festival, kami bahkan tidak sempat untuk membuat lentera satu pun karena terlalu sibuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320207
					],
					"speakerTitle": "Koki Mao"
				},
				{
					"id": 413320207,
					"content": "Jika kamu tidak keberatan, Pengembara, bisakah kamu membantu kami?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320208
					],
					"speakerTitle": "Koki Mao"
				},
				{
					"id": 413320208,
					"content": "Apa kamu mengenal Atsuko? Dia gadis yang datang dari Inazuma yang biasanya terlihat di dermaga bawah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320209
					],
					"speakerTitle": "Koki Mao"
				},
				{
					"id": 413320209,
					"content": "Kami sudah menyiapkan pesanannya, jadi bisakah kamu mengirimkan makanan ini untuknya? Aku sudah membuatkan porsi ekstra besar untuknya agar bisa merayakan festival ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320210
					],
					"speakerTitle": "Koki Mao"
				},
				{
					"id": 413320210,
					"content": "Lalu ada beberapa pekerja di dermaga bawah... <color=#00E1FFFF>Wrench Wang, Hammer Li, Guanhai, dan Zhihua</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320211
					],
					"speakerTitle": "Koki Mao"
				},
				{
					"id": 413320211,
					"content": "Mereka adalah pelanggan tetap di sini dan selalu menjaga agar bisnis kami selalu berjalan dengan lancar. Walaupun ini adalah waktu festival tapi mereka sepertinya masih sibuk dengan pekerjaan di dermaga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320212
					],
					"speakerTitle": "Koki Mao"
				},
				{
					"id": 413320212,
					"content": "Aku ingin menyiapkan beberapa makanan untuk diberikan kepada mereka, tapi takutnya aku terlalu sibuk sehingga tidak punya waktu untuk meninggalkan restoran ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320213
					],
					"speakerTitle": "Koki Mao"
				},
				{
					"id": 413320213,
					"content": "Jika kamu bersedia, Pengembara, tolong bantu aku untuk menanyakan kepada mereka makanan apa yang ingin mereka makan, aku akan memasak apa pun yang mereka inginkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320214
					],
					"speakerTitle": "Koki Mao"
				},
				{
					"id": 413320214,
					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413320215
					]
				},
				{
					"id": 413320215,
					"content": "Terima kasih banyak, Pengembara. Kembalilah ke sini dan beri tahu aku jika kamu sudah bertanya pada mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Koki Mao"
				}
			]
		},
