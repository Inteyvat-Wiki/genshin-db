			"dialogs": [
				{
					"id": 413320301,
					"content": "Kenapa pesanan dari Wanmin Restaurant belum tiba juga ya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320302
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 413320302,
					"content": "Ini pesananmu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413320303
					]
				},
				{
					"id": 413320303,
					"content": "Oh, terima kasih banyak! Kupikir masih lama sampai pesanannya tiba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320304
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 413320304,
					"content": "Dengan suasana Lantern Rite seperti ini, membuatku jadi rindu akan rumahku, tapi... sepertinya aku tidak bisa kembali dulu ke Inazuma dalam beberapa waktu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320305
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 413320305,
					"content": "Aku tidak tahu bagaimana situasi di Inazuma sekarang ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Atsuko"
				}
			]
