			"dialogs": [
				{
					"id": 200470301,
					"content": "Bagaimana? Apa kamu menemukan petunjuk?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470302
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470302,
					"content": "Aku menemukan ini...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200470303
					]
				},
				{
					"id": 200470303,
					"content": "...Jadi begitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470304
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470304,
					"content": "Pada dasarnya begitu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200470305
					]
				},
				{
					"id": 200470305,
					"content": "Ini semua petunjuk yang sangat berharga! Terima kasih banyak, ini terimalah tanda terima kasih dariku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470306
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470306,
					"content": "Nona Patchi! Ada perubahan dalam rencana kita...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Doolan"
				}
			]
		}
	]
