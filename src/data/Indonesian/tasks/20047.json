			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Doolan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200470101,
					"content": "Tidak ada yang namanya rencana SEMPURNA saat kamu bertualang! Bagaimana kamu bisa ada kemajuan jika terus seperti ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470102
					],
					"speakerTitle": "Patchi the Curious"
				},
				{
					"id": 200470102,
					"content": "Meski tidak ada rencana yang sempurna, tapi kita harus tetap bersiap-siap untuk segalanya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470103
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470103,
					"content": "Apa yang kalian perdebatkan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200470104
					]
				},
				{
					"id": 200470104,
					"content": "Ah, jadi kami berencana untuk menjelajahi <color=#00E1FFFF>Thousand Winds Temple</color>, tapi Nona Patchi tidak punya pengalaman bertualang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470105
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470105,
					"content": "Akhir-akhir ini di dalam kuil banyak monster, lalu masih ada pula Ruin Guard yang menjaga pintu masuk... Akan sangat berbahaya jika kita masuk dengan gegabah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470106
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470106,
					"content": "Aku berusaha menjaga keselamatan Nona Patchi, dan keselamatan kita semua juga tentunya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470107
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470107,
					"content": "Jadi aku berusaha membujuknya untuk membuat rencana yang baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470108
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470108,
					"content": "Tapi aku khawatir jika kita mulai dengan beberapa penyelidikan dasar di dekat kuil, Patchi akan menjadi terlalu bersemangat lalu pergi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470109
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470109,
					"content": "Jadi aku tetap di sini untuk mengawasinya, bisakah kamu membantuku dan menyelidiki daerah tersebut?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470110,
						200470113
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470110,
					"content": "Baiklah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200470111
					]
				},
				{
					"id": 200470111,
					"content": "Terima kasih, pastikan untuk menyelidiki dengan hati-hati. Setiap detil yang terlewatkan bisa memengaruhi hasil petualangan kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470112
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470112,
					"content": "Apa pun yang kamu temukan, tolong bawalah padaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470113,
					"content": "Biar aku saja yang mengawasi Patchi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200470114
					]
				},
				{
					"id": 200470114,
					"content": "Ti-tidak bisa! Ka-karena... Ada banyak hal dalam rencana kami yang masih harus kudiskusikan dengannya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470115
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470115,
					"content": "Cepatlah pergi dan cari petunjuk, kumohon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Doolan"
				}
			]
		},
