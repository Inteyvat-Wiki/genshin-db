					"nextDialogs": [
						732060403
					]
				},
				{
					"id": 732060403,
					"content": "Hmm? Tanya apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060404
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732060404,
					"content": "Menceritakan kesulitan Affan kepada Sabbah.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732060405
					]
				},
				{
					"id": 732060405,
					"content": "Begitu ya, jadi kalian ke sini mau minta bantuanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060406
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732060406,
					"content": "Aku merasa terhormat karena kalian ingat diriku dalam situasi begini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060407
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732060407,
					"content": "Tapi bagaimanapun, aku bukan peneliti yang mengkhususkan diri di dalam budidaya spesies. Pengalamanku juga terbatas, jadi tidak ada jaminan pasti bisa membantumu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060408
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732060408,
					"content": "Tapi akan kuusahakan dulu, apalagi tuan yang membudidayakan spesies mawar baru yang kamu ceritakan itu sepertinya menarik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060409
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732060409,
					"content": "Nanti aku akan pergi ke tempat pembibitan Tuan Affan kalau ada waktu. Kalau mau ke sana bilang ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabbah"
				}
			]
		},
		{
			"id": 7320606,
			"completionStepIds": [
				7320706
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320603",
							"3"
						],
						"stepId": 7320603,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_NOT_RECEIVE",
						"rawParams": [
							"7320701",
							"1"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Affan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732060601,
					"content": "Maaf, Paman Shafaqat, aku tidak bisa memenuhi harapan terakhirmu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060602,
						732060609
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060602,
					"content": "Siapa itu Shafaqat?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060603
					]
				},
				{
					"id": 732060603,
					"content": "Bukannya kalian dulu masih terus meributkan masalah si hantu tua? Nama asli hantu tua bukan itu, tidak ada nama asli orang yang seperti itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060604
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060604,
					"content": "Aku dengar dari pendahuluku, nama aslinya adalah Shafaqat. Dia meninggalkan Kota Sumeru waktu masih muda dan datang ke desa kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060605
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060605,
					"content": "Dia membangun rumah kecil dan tinggal sendirian sesudah dia datang. Sesudah itu dia tidak pernah lagi berpergian selama berpuluh-puluh tahun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060606
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060606,
					"content": "Aku belum pernah melihat tampangnya sewaktu dia masih muda. Ada yang bilang kalau waktu itu dia masih tidak terlalu benci anak kecil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060607
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060607,
					"content": "Di depan dan belakang rumahnya banyak ditanami bunga dan pepohonan. Anak-anak suka berlarian ke sana, meminta Ajilenakh Nut, dan mengobrol dengannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060608
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060608,
					"content": "Dia sudah tua waktu aku bertemu dengannya. Dia pun sudah dipanggil si hantu tua dan benci anak kecil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060621
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060621,
					"content": "Pasti masih ada cara lain.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060622
					]
				},
				{
					"id": 732060622,
					"content": "Apa ada cara lain?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060623
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060623,
					"content": "Paman Shafaqat ... orang tua itu sudah meninggal dengan tenang. Kalau dia masih hidup, aku bisa bertanya padanya tentang metode khusus apa yang bisa digunakan untuk membudidayakan mawar ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060624
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060624,
					"content": "Siapa yang masih bisa kutanyai sekarang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060625
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060625,
					"content": "Aku kenal seorang peneliti Amurta bernama Sabbah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060626
					]
				},
				{
					"id": 732060626,
					"content": "Oh, maksudmu gadis asing itu ya? Dia bisa bantu apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060627
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060627,
					"content": "Lagi pula dia dulu pernah lewat sini dan kabur sesudah kuusir. Apa dia masih bersedia membantu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060628
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060628,
					"content": "Biar kucoba.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060629
					]
				},
				{
					"id": 732060629,
					"content": "Kamu ini anak yang baik. Kalau tidak bisa bertemu dengan orang yang bisa membantu juga tidak apa-apa. Kamu sudah berniat melakukannya saja sudah cukup kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060609,
					"content": "Kenapa dia begitu tekun menanam bunga?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060610
					]
				},
				{
					"id": 732060610,
					"content": "Sewaktu-waktu ada orang asing yang terpaksa menetap di desa kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060611
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060611,
					"content": "Beberapa orang tidak terbiasa dengan kehidupan di sini yang terus memaksakan dirinya, dan akhirnya dia sendirian terus seumur hidupnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060612
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060612,
					"content": "Mungkin si tua itu ... ya Paman Shafaqat itu sendiri salah satunya. Semua orang sudah lama terbiasa seperti itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060613
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060613,
					"content": "Tapi tidak peduli berapa lama, aku tidak bersedia untuk terbiasa dengan hal ini. Sayang sekali dia harus berakhir begitu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060614
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060614,
					"content": "Kalian bakal senang melihat kebun bunganya, ada bunga dengan berbagai macam warna, juga pohon yang tinggi dan pendek ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060615
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060615,
					"content": "Orang yang merawat kebun kecil itu sudah meninggal. Yang ada di benak orang tentang dia hanyalah si hantu tua yang suka menangkap anak kecil yang bandel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060616
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060616,
					"content": "Aku dengan berat hati menerima hal ini. Dalam catatan yang ditinggalkannya, dia minta supaya mawar ini tumbuh di segala tempat. Aku cuma mau mewujudkan harapannya itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060617
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060617,
					"content": "Bagaimanapun juga aku sudah tidak peduli dengan omongan orang di umur segini. Hidupku tidak akan sia-sia kalau aku bisa melakukannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060618
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060618,
					"content": "Aku sudah membereskan rumahnya dan menyortir buku-buku yang dia tinggalkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060619
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060619,
					"content": "Kalau kamu tertarik, akan kuperlihatkan beberapa volume untukmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060620
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060620,
					"content": "Aku akan menaruhnya di <color=#00E1FFFF>depan rumah</color> saja biar dia bisa melihat secercah sinar matahari melalui catatan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060621
					],
					"speakerTitle": "Affan"
				}
			]
		},
		{
			"id": 7320701,
			"completionStepIds": [
				7320701
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320701",
							"2"
						],
						"stepId": 7320701,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Affan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732070101,
					"content": "Oh, kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070102
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070102,
					"content": "Ini orang yang mau membantu itu ya? Beberapa hari yang lalu aku sudah berkata kasar padanya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070103
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070103,
					"content": "Aku benar-benar ... *huff* sudah tua dan jadi sering bingung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070104
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070104,
					"content": "Bukankah saat ini kita sedang ngobrol santai? Sudah jangan dimasukkan ke hati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070105
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070105,
					"content": "Apa benihnya sudah bertunas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732070106
					]
				},
				{
					"id": 732070106,
					"content": "Aku dan Tuan Affan sudah melihatnya, sayang sekali masih belum bertunas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070107
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070107,
					"content": "Dari apa yang kuamati, terjadi pembatuan pada bagian luar bijinya. Ada dua kemungkinan yang bisa menyebabkan ini:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070108
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070108,
					"content": "Pertama, karena pelapukan alami dalam jangka waktu yang lama sehingga kehilangan aktivitas biologisnya dan berubah bentuk menjadi fosil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070109
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070109,
					"content": "Kondisi seperti ini tentu saja tidak memungkinkan terjadinya benih untuk bertunas. Tapi kemungkinan dari asumsi ini kecil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070110
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070110,
					"content": "Waktu untuk bisa berubah jadi fosil sangat lama, dan benih ini tidak memenuhi syarat itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070111
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070111,
					"content": "Kedua, spesies ini sendiri punya daya tarik alami terhadap Geo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070112
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070112,
					"content": "Elemen Geo banyak terkumpul saat fase benih dan jadilah membentuk satu lapis cangkang batu di bagian luarnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070113
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070113,
					"content": "Kalau asumsi ini benar, itulah dasar teorinya kenapa benih itu bisa disimpan dengan lama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070114
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070114,
					"content": "Pa-Paimon enggak begitu ngerti. Jadi maksudnya benih-benih itu berubah jadi batu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732070115,
					"content": "Jadi mereka itu batu, hah? Kalau begitu sih sudah tidak ada harapan dong. Mawar emas mana bisa tumbuh dari batu, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070116
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070116,
					"content": "Mawar emas? Apa itu mawar emas yang ada di dalam lagu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070117
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070117,
					"content": "Oh, kalian pasti masih belum tahu kan? Nyanyian Mawar yang tersebar di desa ini pada awalnya adalah ciptaan Paman Shafaqat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070118
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070118,
					"content": "Dia mengajarkan lagu ciptaannya itu kepada para pendahuluku, yang lalu diajarkan lagi kepada anak-anak mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070119
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070119,
					"content": "Ada orang dari generasiku yang tidak mengetahuinya. Kalau nanti semua orang di generasiku sudah tidak ada, pasti tidak ada orang yang mengingatnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070120
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070120,
					"content": "\"Mawar oh mawar, kabulkanlah permintaanku.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070121
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070121,
					"content": "\"Bunga mekar dari batu, Mawar Emas bernyanyi untukku.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070122
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070122,
					"content": "Betul ... kita bisa buat batunya berbunga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070123
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070123,
					"content": "Apa yang terpikirkan olehmu, Sabbah?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732070124
					]
				},
				{
					"id": 732070124,
					"content": "Seperti yang ditunjukkan di lagu itu, kalau lapisan cangkang batunya dipecahkan, tunas benih itu bisa keluar dari batu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070125
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070125,
					"content": "Saat menanam tanaman, biasanya dibutuhkan kondisi ideal untuk membangunkan benihnya supaya bisa memecah cangkangnya sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070126
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070126,
					"content": "Tapi karena cangkang luar biji spesies mawar ini terlalu keras, tunasnya jadi tidak bisa menembus cangkangnya sendiri. Jadi kita coba bantu mereka dari luar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070127
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070127,
					"content": "Tuan Affan, bagaimana menurutmu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070128
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070128,
					"content": "Apa kita bisa pakai cara kita untuk memecahkannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070129
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070129,
					"content": "Jelas dong, kita tidak bisa menghancurkan benih seutuhnya. Kita harus menemukan seseorang yang tangkas untuk melakukan hal ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070130
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070130,
					"content": "#{NICKNAME}, apa kamu bisa melakukannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070131,
						732070132
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070131,
					"content": "Lagi-lagi aku yang kena...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732070133
					]
				},
				{
					"id": 732070133,
					"content": "Prosesnya harus dilakukan dengan hati-hati. Pertama-tama pecahkan cangkangnya pakai <color=#00E1FFFF>benda tumpul</color>, lalu gunakan kekuatan <color=#00E1FFFF>Dendro</color> untuk \"membangunkan\" benihnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070132,
					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732070133
					]
				}
			]
		},
		{
			"id": 7320703,
			"completionStepIds": [
				7320703
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320703",
							"2"
						],
						"stepId": 7320703,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Affan",
					"Sabbah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732070321,
					"content": "Sesudah menunggu dengan tenang beberapa saat, tunasnya perlahan muncul ke permukaan tanah.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732070301
					]
				},
				{
					"id": 732070301,
					"content": "Caramu memang betul-betul efektif, Sabbah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732070302,
					"content": "Akhirnya bisa bertunas, akhirnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070303
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070303,
					"content": "Sepertinya harapan Tuan Shafaqat selama hidupnya sudah terpenuhi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070304
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070304,
					"content": "Tuan Affan, dulu Tuan pernah bilang kalau mawar jenis ini adalah hasil budidayanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070305
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070305,
					"content": "Dia bisa membudidayakan jenis spesies baru. Apa dia juga peneliti yang diasingkan ke sini sama sepertiku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070306
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070306,
					"content": "... Iya. Dia diasingkan di desa ini dan tinggal di rumah di belakang kami seumur hidupnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070307
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070307,
					"content": "Oh begitu ya. Memang sih, nasib orang yang diasingkan akan berakhir seperti ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070308
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070308,
					"content": "Ngomong-ngomong, membudidayakan jenis spesies baru cuma bisa dilakukan oleh seorang peneliti unggul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070309
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070309,
					"content": "Sangat disayangkan orang seperti dia menghilang di luar Akademiya tanpa meninggalkan nama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070310
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070310,
					"content": "Kamu memikirkan masa depanmu sendiri ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070311,
						732070314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732070311,
					"content": "Ayo semangat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732070312
					]
				},
				{
					"id": 732070312,
					"content": "Iya nak, jalanmu masih sangat panjang. Kamu juga bisa lakukan banyak hal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070313
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070313,
					"content": "Jangan terpaku dalam kesedihan. Aku tidak mau ada si hantu tua yang kedua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070317
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070317,
					"content": "Betul juga. Kenapa aku bisa sedih waktu sedang berbahagia ya? Ayo kita selesaikan urusan kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070318
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070318,
					"content": "Mawar emasnya baru bertunas saja sekarang dan belum keluar bunganya. Aku akan terus memantaunya sampai mereka mekar. Bagaimana dengan kalian?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070319
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070319,
					"content": "Aku juga.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732070320
					]
				},
				{
					"id": 732070320,
					"content": "Ayo berikan mereka waktu lagi untuk menyerap lebih banyak nutrisi. Kita berkumpul lagi nanti untuk melihat mereka mekar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070314,
					"content": "(Tidak tahu bagaimana cara menghibur Sabbah ....)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070315
					]
				},
				{
					"id": 732070315,
					"content": "Jangan sedih. Lihat, pada akhirnya dia masih bisa meninggalkan mawar emas untuk kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070316
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070316,
					"content": "Mereka adalah bukti kalau Paman Shafaqat pernah datang ke dunia ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070317
					],
					"speakerTitle": "Affan"
				}
			]
		},
