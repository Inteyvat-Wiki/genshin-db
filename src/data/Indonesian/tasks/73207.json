			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sabbah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732900201,
					"content": "Bunga yang selalu membuat kangen. Oleh-oleh buat kalian sudah kupersiapkan, ambillah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900202
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732900202,
					"content": "Ini benih yang tidak bisa tumbuh di sini. Kalau punya tanah di tempat lain, kamu bisa melihatnya bertumbuh di sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900203
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732900203,
					"content": "Lihat, sekali bicara aku bisa cerita panjang lebar seperti tanpa beban apa-apa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900204
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732900204,
					"content": "Aku tidak punya teman sebelum kamu datang. Sebetulnya kesepian juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900207
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732900207,
					"content": "Tidak banyak orang di desa yang hobi menanam bunga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900208
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732900208,
					"content": "Emm ... bicara seperti ini tidak tepat juga. Di sebelah utara desa sana ada kakek tua yang membuka lahan pembibitan untuk ditanami bunga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900209
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732900209,
					"content": "Aku pernah menjenguknya, orangnya agak aneh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900210
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732900210,
					"content": "Sudah jelas yang ditanamnya adalah \"batu\", tapi malah bilang kalau itu bunga yang dia tanam sendiri dan mengusirku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900211
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732900211,
					"content": "Hidup seorang diri agak kesepian ya? Aku bisa paham perasaan itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900212
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732900212,
					"content": "Kamu bisa membantuku dan mawar Sumeru-ku, mungkin kamu juga bisa membantunya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900213
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732900213,
					"content": "Kalau ada kesempatan, kamu dan Paimon juga bisa mengunjunginya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabbah"
				}
			]
		}
	]
