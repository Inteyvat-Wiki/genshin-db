					"Affan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732070501,
					"content": "\"Mawar oh mawar, kabulkanlah permintaanku.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070502
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070502,
					"content": "\"Bunga mekar dari batu, Mawar Emas bernyanyi untukku.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070503
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070503,
					"content": "\"Demikian bunyinya:\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070504
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070504,
					"content": "\"Aku tidak terikat di dataran mana pun, aku pergi ke mana pun lagu membawaku.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070505
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070505,
					"content": "\"Nyanyianlah yang menentang nasibku, dialah yang menundukkan takdirku.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070506
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070506,
					"content": "\"Melampaui diriku, melampaui waktu. Bahkan melampaui hidup yang terus layu.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070507
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070507,
					"content": "Paman Shafaqat yang mengajarkan kami lagu ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				}
			]
		},
