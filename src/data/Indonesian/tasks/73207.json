			"dialogs": [
				{
					"id": 732030602,
					"content": "Ini mawar Sumeru yang kupetik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030603
					]
				},
				{
					"id": 732030603,
					"content": "Bunga yang selalu membuat kangen. Oleh-oleh buat kalian sudah kupersiapkan, ambillah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030604
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030604,
					"content": "Ini benih yang tidak bisa tumbuh di sini. Kalau punya tanah di tempat lain, kamu bisa melihatnya bertumbuh di sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabbah"
				}
			]
		},
		{
			"id": 7320307,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
