				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732030701,
					"content": "Mau mengobrol denganku? Aku ingin ngobrol dengan seseorang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabbah"
				}
			]
		},
		{
			"id": 7320308,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
