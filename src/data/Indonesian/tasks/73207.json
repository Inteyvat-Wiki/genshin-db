			"dialogs": [
				{
					"id": 732030619,
					"content": "Bagaimana kehidupanmu di Desa Aaru?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030620
					]
				},
				{
					"id": 732030620,
					"content": "Lumayan. Ada makanan dan tempat tinggal. Sudah bagus kalau ada jaminan dasar untuk hidup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030621
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030621,
					"content": "Bagaimanapun juga, aku adalah orang yang diusir ke sini. Tentu aku tidak bisa berharap lebih untuk mendapatkan koleksi buku dan peralatan penelitian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030622
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030622,
					"content": "Lagi pula desa ini dari dulu sudah dipakai Akademiya untuk mengasingkan peneliti. Kondisi untuk bertahan hidup dan melakukan penelitian tidak bisa dibandingkan dengan Sumeru, jadi sudah pasti tidak akan ada suasana akademis di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030623
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030623,
					"content": "Aku bukan orang buangan yang pertama, tapi mungkin juga bukan yang terakhir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030624
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030624,
					"content": "Ya sudah kalau memang harus kemari, yang penting bisa terbiasa. Itu saja yang bisa kupikirkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030625
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030625,
