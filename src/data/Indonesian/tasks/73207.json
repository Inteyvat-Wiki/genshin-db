			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sabbah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732030605,
					"content": "Kamu dari bagian penelitian mana?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030606
					]
				},
				{
					"id": 732030606,
					"content": "Wah kalau diceritakan bisa tiga hari nih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030607
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030607,
					"content": "Aku dulunya adalah Amurta yang mengkhususkan diri di evolusi tanaman dan termasuk disiplin ilmu penelitian empiris.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030608
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030608,
					"content": "Artinya kalau tidak ada material baru akan sulit mendapatkan kesimpulan baru. Mudahnya begini: spesimen historis adalah dasar penelitian saat menguji tanaman dari masa lalu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030609
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030609,
					"content": "Tapi spesimen yang mudah dikoleksi banyak sekali dan sudah hampir semuanya selesai dikoleksi. Spesimen baru yang bisa diberikan Akademiya pun terbatas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030610
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030610,
					"content": "Kondisinya begitu, tapi tetap saja institut masih mau meminta hasilnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030611
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030611,
					"content": "Ada yang memakai hasil penelitian lampau lalu menyusunnya kembali lalu tinggal lapor. Menurutmu ini tidak benar, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030612
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030612,
					"content": "Sebetulnya bisa coba mencari material baru dari sudut pandang geografi sejarah. Dengan begini pasti akan ada penemuan baru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030613
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030613,
					"content": "Beberapa material literatur yang diabaikan Amurta bisa dipakai. Tapi kalau begitu akan masuk ke ruang lingkup Vahumana dan Haravatat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030614
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030614,
					"content": "Aku kan tidak punya ilmu dari keduanya itu. Prosedur pengajuan dari \"ilmu\" yang bersangkutan terlalu ribet. Kerja sama dengan peneliti dari lingkup terkait bahkan tambah sulit lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030615
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030615,
					"content": "Tapi aku yakin, kalau kami bisa berhasil bekerja sama antar disiplin ilmu, akan ada kemajuan yang inovatif dari masalah-masalah lampau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030616
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030616,
					"content": "Sayangnya usaha ini tidak bisa dilangsungkan. Sudut pandang diskusi dari orang nyentriknya Vahumana dan Haravatat terlalu ... emm ... membuat geleng-geleng kepala.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030617
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030617,
					"content": "Semua kata-kata dalam proposal yang kuajukan kepada mereka harus kupikirkan dengan teliti, kalau tidak mereka bisa salah paham.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030618
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030618,
					"content": "Aku bahkan sempat bertengkar dengan salah satu orang Haravatat sebelum diusir dari Akademiya. Tapi sekarang aku bahkan tidak bisa debat dengan mereka ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030625
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030625,
					"content": "Lihat, sekali bicara aku bisa cerita panjang lebar seperti tanpa beban apa-apa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030626
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030626,
					"content": "Aku tidak punya teman sebelum kamu datang. Sebetulnya kesepian juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030629
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030629,
					"content": "Tidak banyak orang di desa yang hobi menanam bunga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030630
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030630,
					"content": "Emm ... bicara seperti ini tidak tepat juga. Di sebelah utara desa sana ada kakek tua yang membuka lahan pembibitan untuk ditanami bunga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030631
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030631,
					"content": "Aku pernah menjenguknya, orangnya agak aneh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030632
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030632,
					"content": "Sudah jelas yang ditanamnya adalah \"batu\", tapi malah bilang kalau itu bunga yang dia tanam sendiri dan mengusirku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030633
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030633,
					"content": "Hidup seorang diri agak kesepian ya? Aku bisa paham perasaan itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030634
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030634,
					"content": "Kamu bisa membantuku dan mawar Sumeru-ku, mungkin kamu juga bisa membantunya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030635
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030635,
					"content": "Kalau ada kesempatan, kamu dan Paimon juga bisa mengunjunginya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabbah"
				}
			]
		},
