			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hiiragi Chisato"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20131001,
					"content": "Fiuh, kita bisa beristirahat sebentar di desa di depan. Bagaimana keadaanmu, Nona?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131002
					],
					"speakerTitle": "Shinnojou"
				},
				{
					"id": 20131002,
					"content": "Aku baik-baik saja. Kamu bisa berhenti di sini. Perjalanan ke Pulau Narukami ada tepat di sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131003
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20131003,
					"content": "Di suratku, aku meminta Kamaji menyediakan Surat Jalan khusus untukmu dari Tenryou Commission. Anggap saja bentuk terima kasih dariku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131004,
						20131005
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20131004,
					"content": "Terima kasih, Chisato.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20131006
					]
				},
				{
					"id": 20131006,
					"content": "Nona...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131007
					],
					"speakerTitle": "Shinnojou"
				},
				{
					"id": 20131007,
					"content": "Oh! Jadi ternyata begitu. Sudah kuduga ada yang aneh, tapi Shinnojou, kamu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131008
					],
					"speakerTitle": "Kenzaburou"
				},
				{
					"id": 20131008,
					"content": "Tidak, aku yakin Nona Hiiragi tidak pernah berniat buruk. Tapi siapa itu \"Kamaji\" yang Nona maksud?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131009
					],
					"speakerTitle": "Shinnojou"
				},
				{
					"id": 20131009,
					"content": "Bisa kukatakan kalau dia adalah... orang yang kucintai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131010
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20131010,
					"content": "Orang yang... Nona cintai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131011
					],
					"speakerTitle": "Shinnojou"
				},
				{
					"id": 20131011,
					"content": "Shinnojou... Jangan-jangan kamu...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131012
					],
					"speakerTitle": "Kenzaburou"
				},
				{
					"id": 20131012,
					"content": "Hah!? Ti-Tidak, aku eh... ehem! Aku hanya memastikan saja kok. Aku tidak akan berani bermimpi seperti itu, eh... ehem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131013
					],
					"speakerTitle": "Shinnojou"
				},
				{
					"id": 20131013,
					"content": "Kalian tidak perlu khawatir. Kumohon, lupakan saja semua ini. Kalau sampai ketahuan ayahku, aku sendiri yang akan bertanggung jawab.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131014
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20131014,
					"content": "Ya, tentu saja. Sesuai keinginanmu, Nona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131015
					],
					"speakerTitle": "Kenzaburou"
				},
				{
					"id": 20131015,
					"content": "Tapi, bagaimana kalau tindakanmu ini sampai ketahuan, Chisato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131016
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20131016,
					"content": "Tidak apa-apa, ayahku selalu memanjakan diriku. Separah-parahnya dia tidak akan memberiku makan setengah hari, atau hukuman sejenisnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131017
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20131017,
					"content": "Hee, Paimon tidak mengira orang seperti dia bisa sentimental juga...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131018
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20131018,
					"content": "Semoga perjalananmu aman. Aku yakin kita akan berjumpa lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131019
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20131019,
					"content": "Dadah Chisato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131020
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20131020,
					"content": "Hey, ayo! Berhenti menatapnya dan mulai jalan. Kita harus mengantar barang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131021
					],
					"speakerTitle": "Kenzaburou"
				},
				{
					"id": 20131021,
					"content": "Ah, ba-baik... *hiks*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shinnojou"
				},
				{
					"id": 20131005,
					"content": "Jaga dirimu ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20131006
					]
				}
			]
		},
