			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hiiragi Chisato",
					"Shinnojou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20130801,
					"content": "Mohon tunggu sebentar... Barang-barang ini akan dikirim ke... Pulau Watatsumi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130802
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130802,
					"content": "Ah, Nona! Sebuah kehormatan yang tak kuduga. Benar sekali, barang-barang ini adalah permintaan dari Komisaris Kanjou. Kita harus memastikan barang ini tiba di Pulau Watatsumi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130803
					],
					"speakerTitle": "Shinnojou"
				},
				{
					"id": 20130803,
					"content": "Apa ada yang salah, Nona Hiiragi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130804
					],
					"speakerTitle": "Kenzaburou"
				},
				{
					"id": 20130804,
					"content": "Tidak, silakan lanjutkan. Ayahku hanya sedikit khawatir dengan keamanan pengirimannya. Ayahku memerintahkan aku dan beberapa \"pendamping tambahan\" untuk menjamin pengiriman barang-barang ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130805
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130805,
					"content": "Nona, kamu tidak bermaksud untuk mendampingi pengiriman ini sendiri kan? Nona tidak perlu merepotkan diri untuk hal seperti ini, dan tentang \"pendamping tambahan\" ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130806,
						20130807
					],
					"speakerTitle": "Kenzaburou"
				},
				{
					"id": 20130806,
					"content": "Senang bekerja sama denganmu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130808
					]
				},
				{
					"id": 20130808,
					"content": "Mohon jangan menunda lagi. Kalau ingatanku tidak salah, ayahku menekankan kalau pengiriman ini harus tepat waktu. Aku yakin akan ada hukuman yang menunggu kalau sampai terlambat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130809
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130809,
					"content": "Ya, tentu saja, Nona. Ha-Hanya saja... Yah, kami tidak kenal dengan orang-orang ini——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130810
					],
					"speakerTitle": "Kenzaburou"
				},
				{
					"id": 20130810,
					"content": "Perlukah kuingatkan pada kalian apa akibatnya kalau sampai terjadi sesuatu padaku di perjalanan? Kurasa kalian semua tahu temperamen ayahku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130811
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130811,
					"content": "Apa kalian benar-benar yakin bisa menjaga keselamatanku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130812
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130812,
					"content": "Wah, Chisato benar-benar pandai bicara ya, mereka tidak bisa berkutik...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130813,
					"content": "A-Ah, baiklah, Nona. Kalau begitu... Su-Suatu kehormatan Nona bisa menemani kami. Keselamatan Nona adalah prioritas kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130814
					],
					"speakerTitle": "Shinnojou"
				},
				{
					"id": 20130814,
					"content": "Shinnojou! Kamu tidak benar-benar menyetujuinya kan!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130815
					],
					"speakerTitle": "Kenzaburou"
				},
				{
					"id": 20130815,
					"content": "Yah, ini permintaan dari Nona Hiiragi sendiri. Sudah jadi tugas kita untuk melayani dia sebisanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130816
					],
					"speakerTitle": "Shinnojou"
				},
				{
					"id": 20130816,
					"content": "Ya, tapi... bukan itu masalahnya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130817
					],
					"speakerTitle": "Kenzaburou"
				},
				{
					"id": 20130817,
					"content": "Baiklah, kalau sudah selesai, lebih baik kita segera berangkat. Berlama-lama di sini hanya akan memberikan waktu bagi para pencuri untuk bersiap-siap, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130818
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130818,
					"content": "Ba-Baik, Nona. Kalian dengar kan? Jangan buang-buang waktu lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kenzaburou"
				},
				{
					"id": 20130807,
					"content": "Kamu mempertanyakan kemampuanku?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130808
					]
				}
			]
		},
		{
			"id": 201310,
			"completionStepIds": [
				201310
			],
			"beginWay": "TALK_BEGIN_MANUAL",
