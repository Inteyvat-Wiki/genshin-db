				},
				{
					"id": 20131102,
					"content": "Kami datang untuk menemui, uh... ya itu, uh... Komisaris Kanjou!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20131103,
					"content": "Komisaris Kanjou jarang menyambut pendatang asing. Pergi sekarang, atau kami terpaksa——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131104
					],
					"speakerTitle": "Yokoyama"
				},
				{
					"id": 20131104,
					"content": "Ah... Tunggu, tunggu, tunggu...",
