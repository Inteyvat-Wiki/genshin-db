				"points": []
			},
			"dialogs": [
				{
					"id": 20130101,
					"content": "Berhenti! Tunjukkan Surat Jalanmu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130102
					],
					"speakerTitle": "Kobayashi"
				},
				{
					"id": 20130102,
					"content": "Maaf, tapi kita benar-benar harus pergi ke Pulau Narukami, keadaan darurat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130103,
					"content": "Kalau kamu tidak punya Surat Jalan, kamu harus berhenti di sini. Memang begitu aturannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130104
					],
					"speakerTitle": "Kobayashi"
				},
				{
					"id": 20130104,
					"content": "Huh... sesuai dugaan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130105,
					"content": "Pengembara, ayo pikirkan cara lain. Bagaimana cara kita keluar dari Ritou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130106,
						20130107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130106,
					"content": "Kalau Yashiro Commission pernah mendengar tentang kita...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130108
					]
				},
				{
					"id": 20130108,
					"content": "Maksudmu... kita mau pergi mencari Komisaris Kanjou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130109,
					"content": "...Yah tidak ada ruginya sih. Meskipun Paimon tidak suka dengan anak buahnya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130110,
					"content": "Siapa tahu... dia fans berat kita? Hehehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130107,
					"content": "Apa Kanjou Commission tahu tentang kita ya...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130108
					]
				}
			]
		},
		{
			"id": 201302,
			"completionStepIds": [
				201302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
