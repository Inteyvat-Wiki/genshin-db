					"nextDialogs": [
						20131105
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20131105,
					"content": "Oh! Komisaris!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131106
					],
					"speakerTitle": "Yokoyama"
				},
				{
					"id": 20131106,
					"content": "Mereka berdua adalah tamu terhomat yang datang dari jauh, tidak perlu menggunakan cara biasa itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131107
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20131107,
					"content": "Ayo masuk, mari lihat apa yang bisa kubantu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131108
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20131108,
					"content": "Huh! Dengar tidak!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131109
					],
					"speakerTitle": "Paimon"
				},
				{
