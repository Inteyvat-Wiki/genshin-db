			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hiiragi Shinsuke",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20130201,
					"content": "Namaku Hiiragi Shinsuke, Komisaris Kanjou Commission dan kepala Klan Hiiragi. Suatu kehormatan bisa bertemu dengan kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130202,
						20130203
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20130202,
					"content": "Suatu kehormatan juga bisa bertemu denganmu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130204
					]
				},
				{
					"id": 20130204,
					"content": "Senang bertemu denganmu, Tuan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130205,
					"content": "Jadi alasan kami datang ke sini adalah——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130206,
					"content": "Tenang, tenang, jangan terburu-buru begitu. Dua pengembara yang terkenal di seluruh penjuru dunia datang untuk menemuiku, tentu saja aku mau berbincang banyak denganmu! Kita jangan membicarakan bisnis saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130207
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20130207,
					"content": "Hehehe, jadi maksudmu, kita lumayan terkenal ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130208,
					"content": "Tentu saja. Memangnya ada berapa sih orang di dunia ini yang bisa mengalahkan Stormterror dan mengusir Overlord of the Vortex kembali ke laut?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130209
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20130209,
					"content": "Benar sekali! Paimon sangat setuju dengan kata-katamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130210,
					"content": "Dan... kudengar kalian juga menggagalkan rencana Fatui di Pelabuhan Liyue, bahkan mengalahkan salah satu harbinger mereka. Itu benar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130211
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20130211,
					"content": "Wuah! Kamu juga tahu tentang itu? Yap, itu benar kok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130212,
					"content": "Hmm... Seperti dugaanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130213
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20130213,
					"content": "Ada yang salah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130214,
					"content": "Hehe, tidak, tidak. Aku hanya terkagum-kagum dengan kalian berdua saja kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130215,
						20130216
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20130215,
					"content": "Kamu terlalu memuji.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130217
					]
				},
				{
					"id": 20130217,
					"content": "...Suatu kehormatan besar bagi Ritou untuk bisa dikunjungi kalian berdua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130218
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20130218,
					"content": "Aku juga pernah mendengar kalau kalian sering membantu orang lain. Aku jadi berpikir... apakah kalian mau memberikan bantuan kalian untuk Kanjou Commission?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130219
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20130219,
					"content": "#Tentu saja, tidak masalah! Apa pun yang kamu butuhkan, ya kan, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130220,
						20130221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130220,
					"content": "Waktunya menjalankan tugas lagi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130222
					]
				},
				{
					"id": 20130222,
					"content": "Hehehe, bagus sekali. Baiklah, kalau begitu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130223
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20130223,
					"content": "Kalian tahu Qingxin kan? Bunga yang tumbuh di atas pegunungan Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130224
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20130224,
					"content": "Yap, kita pernah memetiknya. Jadi, uh... kamu mau kita kembali ke Liyue?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130225,
					"content": "Ya. Tolong petikkan 300 Qingxin Segar untukku ya? Yang benar-benar masih segar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130226
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20130226,
					"content": "...Uh, apa Paimon tidak salah dengar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130227,
						20130228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130227,
					"content": "Mungkin kamu salah sebut jumlah?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130229
					]
				},
				{
					"id": 20130229,
					"content": "Hmm? Terlalu sulit ya? Hmm... baiklah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130230
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20130230,
					"content": "Bagaimana dengan ini: Kita ada beberapa surat yang perlu dikirimkan, mungkin kamu bisa membantu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130231
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20130231,
					"content": "Baiklah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130232,
					"content": "Totalnya ada 709 surat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130233
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20130233,
					"content": "Hei! Ada apa sih? Kenapa kamu tidak punya orang untuk mengantarkannya!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130234,
					"content": "Hehe, maaf ya, belakangan ini kita sedang sangat kekurangan orang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130235
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20130235,
					"content": "Penjelasan macam apa itu!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130236,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130237
					]
				},
				{
					"id": 20130237,
					"content": "Pengembara, bagaimana nih? Apa kita benar-benar mau membantu dia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130238,
						20130239
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130238,
					"content": "Biar kupikir-pikir dulu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130240
					]
				},
				{
					"id": 20130240,
					"content": "Aku suka semangatmu! Jangan biarkan aku menunggu terlalu lama ya, hehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20130239,
					"content": "Biar kulihat dulu situasinya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130240
					]
				},
				{
					"id": 20130228,
					"content": "Sudah tidak segar lagi kalau dipetik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130229
					]
				},
				{
					"id": 20130221,
					"content": "Ini keahlianku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130222
					]
				},
				{
					"id": 20130216,
					"content": "Mereka tetap berhasil pada akhirnya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130217
					]
				},
				{
					"id": 20130203,
					"content": "Halo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130204
					]
				}
			]
		},
