			"dialogs": [
				{
					"id": 760100201,
					"content": "Dua puluh lima ... Dua puluh enam ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100202
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100202,
					"content": "Eh, kamu lagi hitung apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760100203,
					"content": "Ssst ...! Pelan-pelan ... Ah, sudahlah, kali ini juga pasti tidak akan berhasil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100204
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100204,
					"content": "Adik kecil, hal kayak gini seharusnya cukup lihat sekali aja sudah paham kan? Tentu saja aku lagi hitung waktu buat mancing. Masa kamu kira aku pegang joran ini buat merapal sihir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100205,
						760100207
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100205,
					"content": "Kalau Bani Bulan Embun, mungkin saja bisa ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760100206
					]
				},
				{
					"id": 760100206,
					"content": "#Huff, {M#anak muda}{F#gadis muda}, kamu benar-benar menilaiku terlalu tinggi. Aku ini paling tidak cuma setengah dari Bani Bulan Embun, bahkan jadi pelayan suci pun tidak layak. Aku cuma orang biasa yang tidak bisa pakai kuuvahki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100210
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100210,
					"content": "Sudahlah, lupakan soal itu dulu. Ini pertama kalinya Paimon lihat ada orang yang memancing pakai hitung waktu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760100211,
					"content": "Aduh, yang penting itu teknik mancingnya, bukan seberapa lama kamu berdiri di tepi darat. Si Ilmari Tua itu justru tidak dapat ikan karena tidak bisa paham hal yang satu ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100212
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100212,
					"content": "Hmm? Kalau begitu, kalian berdua pasti Pemburu Harta Karun ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100213
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100213,
					"content": "Bukan, kami petualang ... Eh, jadi ada sesuatu yang perlu kami lakukan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760100214,
					"content": "Kurang lebih begitu, mau itu Pemburu Harta atau Petualang, yang penting bisa selesaikan tugasnya dengan bayaran. Kalau kalian lagi ada waktu, aku ingin minta tolong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100215
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100215,
					"content": "Kalian lihat, kemampuan memancingku jelas adalah yang terbaik di Pulau Hiisi. Bahkan dari semua generasi Pelantun Rembulan, tidak ada yang bisa mengalahkanku dalam hal memancing ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100216
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100216,
					"content": "Ah masa? Luar biasa ... Eh? Ya enggak hebat juga dong! Kan memancing bukan kerjaan utama Pelantun Rembulan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760100217,
					"content": "Tapi, aku yang sehebat ini, akhir-akhir ini malah tidak berhasil mancing satu ikan pun! Kenapa ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100218
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100218,
					"content": "Sudah jelas, masalahnya bukan di aku, tapi di lingkungannya. Sama seperti Mata Kratti yang terkutuk itu, pasti ada sesuatu di bawah air sini yang bikin kawanan ikan jadi terganggu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100219
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100219,
					"content": "Ke-Kesimpulan yang aneh banget ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760100220,
					"content": "Jadi, aku mau minta bantuan kalian untuk selidiki perairan di sekitar sini, dan cari tahu apa sebenarnya yang menghalangi ikan-ikan untuk memakan umpan. Tenang saja, akan kuberi bayaran yang sepadan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100221
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100221,
					"content": "Hm, karena ada bayarannya, kami bisa periksa di sekitar sini ... Tapi kami enggak jamin akan ketemu sesuatu yang aneh ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760100207,
					"content": "Mungkin lagi cari rekan terbaik ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760100208
					]
				},
				{
					"id": 760100208,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100209
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100209,
					"content": "Enggak semua orang bisa langsung dapat rekan terbaik dengan memancing ... Eh, tunggu, bukan itu intinya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100210
					],
					"speakerTitle": "Paimon"
				}
			]
		},
