			"trigger": {
				"objectNames": [
					"Patchi the Curious"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200410101,
					"content": "Tidak ada yang namanya rencana SEMPURNA saat kamu bertualang! Bagaimana kamu bisa ada kemajuan jika terus seperti ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410102
					],
					"speakerTitle": "Patchi the Curious"
				},
				{
					"id": 200410102,
					"content": "Meski tidak ada rencana yang sempurna, tapi kita harus tetap bersiap-siap untuk segalanya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410103
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200410103,
					"content": "Apa yang kalian perdebatkan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200410104
					]
				},
				{
					"id": 200410104,
					"content": "Aku adalah seorang peneliti reruntuhan kuno yang sedang dalam perjalanan menuju Thousand Winds Temple. Tapi aku tidak pandai dalam bertarung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410105
					],
					"speakerTitle": "Patchi the Curious"
				},
				{
					"id": 200410105,
					"content": "Tuan Doolan adalah seorang petualang, dan dia telah mengatur segalanya sendiri untuk menginvestigasi Thousand Winds Temple ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410106
					],
					"speakerTitle": "Patchi the Curious"
				},
				{
					"id": 200410106,
					"content": "A-aku tidak bermaksud untuk mengkritik Doolan, dan aku juga tahu bahwa Ruin Guard itu merepotkan... Tapi dia bilang akan membuat sebuah rencana yang sempurna dan terus mengadakan pertemuan untuk penyelidikan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410107
					],
					"speakerTitle": "Patchi the Curious"
				},
				{
					"id": 200410107,
					"content": "Penelitian... Investigasi... Revisi, lalu penelitian lagi... investigasi lagi... revisi lagi... Argh, aku sudah tidak tahan lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410108
					],
					"speakerTitle": "Patchi the Curious"
				},
				{
					"id": 200410108,
					"content": "Sekarang dia bilang dia baru saja menemukan petunjuk bahwa terdapat kemah monster di sebelah kuil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410109
					],
					"speakerTitle": "Patchi the Curious"
				},
				{
					"id": 200410109,
					"content": "Kumohon padamu, tolong singkirkan kemah monster itu! Walaupun kami tidak bisa masuk ke dalam kuil, tapi setidaknya dia akan diam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410110,
						200410111
					],
					"speakerTitle": "Patchi the Curious"
				},
				{
					"id": 200410110,
					"content": "Sepertinya aku tahu apa yang perlu kulakukan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 200410111,
					"content": "Aku akan datang ke pertemuan yang diadakan Doolan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200410112
					]
				},
				{
					"id": 200410112,
					"content": "Terima kasih banyak atas bantuanmu, tapi percayalah padaku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410113
					],
					"speakerTitle": "Patchi the Curious"
				},
				{
					"id": 200410113,
					"content": "...daripada hadir dalam pertemuannya, kamu pasti lebih rela bertempur dengan para monster itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Patchi the Curious"
				}
			]
		},
