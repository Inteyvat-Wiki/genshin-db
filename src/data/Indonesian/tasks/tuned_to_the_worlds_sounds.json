				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Juza"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700300101,
					"content": "Halo, Pengembara! Lama tak jumpa. Apa kabar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300102
					],
					"speakerTitle": "Juza"
				},
				{
					"id": 700300102,
					"content": "Kita pernah bertemu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300103
					]
				},
				{
					"id": 700300103,
					"content": "Oh, eh ... Kamu sudah lupa sama aku, ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300104
					],
					"speakerTitle": "Juza"
				},
				{
					"id": 700300104,
					"content": "Aku Juza, Chief Mate Kapal Alcor! Kamu numpang kapal kami untuk ke Inazuma, masa lupa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300105
					],
					"speakerTitle": "Juza"
				},
				{
					"id": 700300105,
					"content": "Haha, dia cuma jahil saja kok, Juza! Kami ingat kok sama kamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700300106,
					"content": "Ah ... Iyalah! Kita lagi bicara soal Kapal Alcor, dan aku ini kan Chief Mate di sana ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300107
					],
					"speakerTitle": "Juza"
				},
				{
					"id": 700300107,
					"content": "Iya, iya. Nah, ada perlu apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300108
					]
				},
				{
					"id": 700300108,
					"content": "Bukan aku sih. Anggota sementara kru kami, si Bocah Kaedehara itu yang butuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300109
					],
					"speakerTitle": "Juza"
				},
				{
					"id": 700300109,
					"content": "Kamu ingat dia kan? Dia ikut dengan kami waktu pulang dari Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300110
					],
					"speakerTitle": "Juza"
				},
				{
					"id": 700300110,
					"content": "Aku tidak tahu apa masalahnya, tapi dia kelihatan lesu sekali sepanjang perjalanan. Dia terus saja ajak yang lain ikut baca puisi dan sajak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300111
					],
					"speakerTitle": "Juza"
				},
				{
					"id": 700300111,
					"content": "Sayangnya, mulai dari Kapten Beidou sampai Little Yue, tidak ada seorang pun di kapal yang punya ... eh ... apa itu namanya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300112,
						700300114
					],
					"speakerTitle": "Juza"
				},
				{
					"id": 700300112,
					"content": "Selera!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300113
					]
				},
				{
					"id": 700300113,
					"content": "Iya! Tidak ada satu pun dari kami yang punya selera untuk hal-hal seperti itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300116
					],
					"speakerTitle": "Juza"
				},
				{
					"id": 700300116,
					"content": "Jadi, sesampainya di Liyue, dia turun dan langsung pergi ke alam. Kurasa dia sudah tak tahan dikelilingi pelaut tidak sekolah seperti kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300117
					],
					"speakerTitle": "Juza"
				},
				{
					"id": 700300117,
					"content": "Lalu tak lama setelahnya, kami dapat kabar darinya. Dia minta kami cari kabar tentang kamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300118
					],
					"speakerTitle": "Juza"
				},
				{
					"id": 700300118,
					"content": "Apa dia kena masalah?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300119
					]
				},
				{
					"id": 700300119,
					"content": "Dia tidak bilang. Dia cuma pesan, kalau kami sampai ketemu denganmu, tolong sampaikan kalau dia ingin bicara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300120
					],
					"speakerTitle": "Juza"
				},
				{
					"id": 700300120,
					"content": "Dari pesannya sih, kedengarannya tidak ada yang serius. Tapi, untuk apa minta tolong pada orang sekelas kamu kalau bukan sedang kena masalah besar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300121
					],
					"speakerTitle": "Juza"
				},
				{
					"id": 700300121,
					"content": "#Sebenarnya, kami sering banget urusin hal-hal sepele loh. Iya kan, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300122,
						700300123,
						700300124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700300122,
					"content": "Yep. Kasih makan merpati, misalnya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300125
					]
				},
				{
					"id": 700300125,
					"content": "Oh ya ... Aku tidak sangka sama sekali. Kamu mau juga kerja serabutan begitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300126
					],
					"speakerTitle": "Juza"
				},
				{
					"id": 700300126,
					"content": "Pantas saja Kapten baik sekali sama kamu. Dia lemah sama tipe orang yang jujur dan pekerja keras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300127
					],
					"speakerTitle": "Juza"
				},
				{
					"id": 700300127,
					"content": "Ehem! Jadi melantur ya. Nah, tolong cari tahu ada apa dengan si Bocah Kaedehara itu kalau kamu ada waktu senggang. Terakhir kudengar dia ada di utara Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300128
					],
					"speakerTitle": "Juza"
				},
				{
					"id": 700300128,
					"content": "Aku masih ada kerjaan di kapal. Sampai jumpa, hati-hati di jalan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Juza"
				},
				{
					"id": 700300123,
					"content": "Yap. Antar makanan lah, ini lah, itu lah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300125
					]
				},
				{
					"id": 700300124,
					"content": "Yoi. Bersih-bersih saja pernah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300125
					]
				},
				{
					"id": 700300114,
					"content": "Sifat unik bin aneh!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300115
					]
				},
				{
					"id": 700300115,
					"content": "Bukan! Maksudku selera! Tidak ada satu pun dari kami yang punya selera untuk hal-hal seperti itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300116
					],
					"speakerTitle": "Juza"
				}
			]
		},
		{
			"id": 7003002,
			"completionStepIds": [
				7003004
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7003004",
							"2"
						],
						"stepId": 7003004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaedehara Kazuha"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700300201,
					"content": "Petikan senar berbisik, melagukan riwayat jembatan tua. Terdengar suara Zither, mengalunkan kesendirian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300202
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 700300202,
					"content": "Hai, Bocah Kaedehara! Lagi apa di sini? Kami datang mau membantu loh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700300203,
					"content": "Oh? Kalian datang. Senang dapat bertemu kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300204
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 700300204,
					"content": "Julukan \"Bocah Kaedehara\" ini ... Kalau keluar dari mulut Paimon, kok rasanya jadi beda ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300205
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 700300205,
					"content": "Hehehe, Paimon belajar dari Chief Mate Juza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300206,
						700300207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700300206,
					"content": "Kamu kelihatan senang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300208
					]
				},
				{
					"id": 700300208,
					"content": "Haha, kenapa? Apa aku biasanya terlihat selalu murung dan berbeban berat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300209
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 700300209,
					"content": "Soalnya Juza bilang kamu cari kami! Kami enggak nyangka kamu malah lagi asyik sendiri baca puisi sambil lihat pemandangan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700300210,
					"content": "Peristiwa yang terjadi di Inazuma sudah berlalu, dan tak lagi membebaniku. Sekarang aku ada di Liyue, saatnya menggunakan kesempatan yang ada untuk mendalami bait dan syair alam ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300211
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 700300211,
					"content": "Soal urusan yang memerlukan bantuanmu, tadinya tidak ada. Tapi kamu terlambat, karena sekarang jadi ada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300212
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 700300212,
					"content": "Hah? Apa maksudnya ... Tadinya enggak ada, terus sekarang jadi ada ...? Apaan sih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700300213,
					"content": "Kamu makan tumbuhan liar aneh-aneh ya? Omonganmu enggak nyambung!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700300214,
					"content": "Sst ... Dengar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300215
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 700300215,
					"content": "Menurut kalian?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300216
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 700300216,
					"content": "Wow ... Paimon pikir sih kamu sama saja sama si penyair kenalan kami, yang suka ngamen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700300217,
					"content": "Oh, kalian kenal dengan penyair profesional? Kuharap suatu hari aku punya kesempatan untuk bertemu dengannya. Pengembara, bagaimana menurutmu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300218,
						700300219
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 700300218,
					"content": "Kurasa alat musikmu rusak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300220
					]
				},
				{
					"id": 700300220,
					"content": "Benar, bagus sekali. Intinya adalah, alat ini punya kemampuan khusus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300221
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 700300221,
					"content": "Aku menemukan Zither Kuno tanpa nama di sebuah gua bekas tempat tinggal seseorang, waktu menjelajahi pegunungan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300222
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 700300222,
					"content": "Ketika pertama kali menemukannya, alat ini tampak tua, namun masih utuh. Melihatnya demikian, aku mendapat inspirasi, dan seketika itu juga aku memetik senarnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300223
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 700300223,
					"content": "Betapa terkejutnya aku, karena ketika musik mengalun, pikiranku pun seketika melayang. Aku bahkan mendengar suara seseorang yang turut memetik senar bersamaku ... dan anehnya lagi, semua itu terasa akrab sekali ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300224
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 700300224,
					"content": "Sebentar, kita balik lagi ke omongan yang tadi dulu. Apa kamu yakin kamu enggak makan sesuatu? Yang bisa bikin kamu halusinasi gitu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700300225,
					"content": "Aku yakin tidak, karena begitu melodinya berakhir, pikiranku pun kembali jernih. Ketika itulah aku mulai memperhatikan sekelilingku dengan lebih saksama. Dan benar saja, tempat itu memang misterius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300226
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 700300226,
					"content": "Gua itu penuh dengan rumput liar, jadi kurasa pemiliknya sudah pergi sejak dulu. Tapi, meja dan kursinya bersih tak berdebu, bahkan ada aroma yang lembut dan harum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300227
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 700300227,
					"content": "Bahkan suara angin pun terdiam di tempat itu. Ajaib sekali. Aku hanya bisa menerka, mungkinkah di sana itu tempat Adeptus Liyue menyimpan harta mereka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300228
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 700300228,
					"content": "Wow! Jadi maksudnya Zither itu harta Adeptus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700300229,
					"content": "Haha, siapa tahu? Rasanya menakjubkan, apa pun itu. Setelah selesai, aku pikir pengalaman ini harus diceritakan kepada seorang teman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300230
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 700300230,
					"content": "Tapi di Liyue, temanku hanya kamu dan Kapten Beidou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300231
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 700300231,
					"content": "Aku tidak yakin kalau Kapten Beidou akan tertarik dengan hal seperti ini. Jadi aku undang kalian kemari untuk berbagi pengalaman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300232
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 700300232,
					"content": "Aku minta tolong pada Chief Mate Juza untuk mengabarimu. Namun sayangnya, Zither Kuno itu rusak sebelum kamu kemari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300233
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 700300233,
					"content": "Itu sepenuhnya salahku sendiri. Aku membawanya ke mana-mana dan sering sekali memainkannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300234
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 700300234,
					"content": "Oh ... Harta Adeptus juga bisa rusak juga ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300235
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700300235,
					"content": "Jika Keabadian itu tidak terjangkau bahkan oleh Archon Electro sekali pun ... Tentulah hal tersebut lebih jauh lagi bagi yang lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300236
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 700300236,
					"content": "#Waduh ... {NICKNAME}, kamu harus ekstra hati-hati ya sama Serenitea Pot kita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300237
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700300237,
					"content": "Untungnya, kerusakan kali ini dapat diperbaiki. Mungkin lebih tepat disebut hibernasi daripada rusak, energi yang ada di dalam Zither ini habis seiring berjalannya waktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300238
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 700300238,
					"content": "Yang kita perlukan adalah mencari bahan yang tepat dan membangunkan lagi Zither-nya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300239
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 700300239,
					"content": "Kalau aku tidak keliru, bahan tersebut adalah ... Glaze Lily.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300240
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 700300240,
					"content": "Kamu tahu dari mana?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300241
					]
				},
				{
					"id": 700300241,
					"content": "Seperti yang pernah kubilang dulu, angin membawa bisikan suara semua yang ada di dunia ini, dan aku bisa mendengar mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300242
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 700300242,
					"content": "Jadi, aku juga tahu sedikit riwayat Zither Kuno ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300243
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 700300243,
					"content": "Pergilah. Aku akan menunggu di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300244
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 700300244,
					"content": "Kamu adalah sang penyelamat Liyue. Hal seperti ini tentu mudah bagimu, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 700300219,
					"content": "Kelihatannya alat musik mahal ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300220
					]
				},
				{
					"id": 700300207,
					"content": "Kamu kelihatannya santai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300208
					]
				}
			]
		},
