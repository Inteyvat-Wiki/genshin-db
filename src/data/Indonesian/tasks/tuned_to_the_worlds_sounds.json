				"objectNames": [
					"Kaedehara Kazuha"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700300401,
					"content": "Bagus, ini cukup. Kalau kita peras sarinya dan membalurkannya ke badan Zither, dia akan terbangun dari tidurnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300402
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 700300402,
					"content": "Benar, perasaan ini. Zither-nya sudah bangun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300403
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 700300403,
					"content": "#Kemari, coba sendiri, {NICKNAME}. Silakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300404
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 700300404,
					"content": "Maksudnya silakan ....?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300405
					]
				},
				{
					"id": 700300405,
					"content": "Haha, bukankah seorang penyair harus berat bahasanya? Baiklah, maksudku barusan adalah ... zither ini untukmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300406
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 700300406,
					"content": "Aku kembali ke Liyue untuk mendengarkan bisikan daerah ini. Di tanah yang luas dan kuno, yang diawasi oleh Archon Geo, ada begitu banyak bisikan dan seruan yang terdengar ... Dengan begini aku sudah merasa cukup puas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300407
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 700300407,
					"content": "Tentunya, suatu hari nanti ketika kamu sudah tak menginginkannya lagi, aku akan datang kembali untuk mengambil Zither-nya. Tapi ... kuharap tidak akan pernah ada hari seperti itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300408
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 700300408,
					"content": "Baiklah, biar kulanjutkan perjalanan ini. Apa yang biasa orang Liyue ucapkan pada situasi seperti ini? Ah, iya:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300409
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 700300409,
					"content": "#\"Kita 'kan berjumpa lagi\", {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				}
			]
		}
	]
