			},
			"dialogs": [
				{
					"id": 700300301,
					"content": "Kamu sudah kembali, bahkan sebelum angin mengabariku. Menakjubkan ... bagaimana caramu melakukan itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300302
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 700300302,
					"content": "Hehe, mungkin dia punya cara sendiri yang enggak kepikiran sama kamu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700300303,
					"content": "Ahem. Apa segini cukup?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300304
					]
				},
				{
					"id": 700300304,
					"content": "Coba kulihat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				}
			]
		},
		{
			"id": 7003004,
			"completionStepIds": [
				7003007
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
