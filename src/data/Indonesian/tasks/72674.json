			},
			"dialogs": [
				{
					"id": 726740301,
					"content": "Hmm! Gimana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740302
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740302,
					"content": "Hmm! Ketemu Rambut Putih sama Rambut Kuning. Senang. Lavender Melon pung-pung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740303
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726740303,
					"content": "Lavender Melon pung-pung ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740304
					]
				},
				{
					"id": 726740304,
					"content": "Hmm? Tak kusangka, kamu bisa juga ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740305
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740305,
					"content": "Pung-pung!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740306
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726740306,
					"content": "Jadi, pung-pung Lavender Melon itu apa artinya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740307
					]
				},
				{
					"id": 726740307,
					"content": "Pung-pung ya pung-pung, Lavender Melon ya Lavender Melon lah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740308
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726740308,
					"content": "Kulihat komunikasi kalian tidak ada kendala sama sekali. Memang aku jago \"masak\" sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740309,
						726740311
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740309,
					"content": "Untuk sekarang masih belum ada kendala, gitu ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740310
					]
				},
				{
					"id": 726740310,
					"content": "Salah! Kendala super besar ini! Kami tetap enggak paham sebagian besar omongannya Kichiboushi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740312,
					"content": "Jadi begini ya, Ioroi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740313,
					"content": "Kamu memberi tahu Ioroi soal kendala komunikasi yang kalian alami.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						726740314
					]
				},
				{
					"id": 726740314,
					"content": "Oh, begitu. Jangan takut, jangan khawatir, kalian cuma belum terbiasa saja sama auranya Kichiboushi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740315
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740315,
					"content": "Perlahan-lahan juga pasti terbiasa! Semakin kalian terbiasa dengan auranya, semakin kalian ngerti omongannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740316
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740316,
					"content": "Perlahan-lahan itu mau sampai kapan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740317,
					"content": "Hmm ... berapa lama ya ... coba kuhitung dulu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740318
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740318,
					"content": "Eh! Bagaimanapun juga, jangan terburu-buru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740319
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740319,
					"content": "Tidak sabar, tidak bagus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740320
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726740320,
					"content": "Ioroi juga tidak tahu kapan ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740321
					]
				},
				{
					"id": 726740321,
					"content": "Hei! Aku ini raja bake-danuki, Ioroi! Yang sudah hidup sedemikian lamanya! Mana mungkin aku sama seperti manusia biasa yang suka menghitung hari!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740322
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740322,
					"content": "(Sebagian besar dari waktu hidupnya kan dihabiskan dengan disegel di dalam batu.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740323,
					"content": "Kenapa Ioroi bisa bicara dengan manusia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740324
					]
				},
				{
					"id": 726740324,
					"content": "Hmm, tidak sopan ya. Yang betul itu kok kalian yang manusia fana bisa-bisanya bicara dengan kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740325
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740325,
					"content": "Tak terhitung banyaknya saat-saat ketika aku, sang bake-danuki berumur panjang dan berkemampuan tinggi ini, berhubungan dengan manusia fana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740326
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740326,
					"content": "Dulu, dahulu sekali, aku sering berhubungan dengan kaum tengu, kitsune, oni, siluman, dan manusia. Kisah-kisah yang diceritakan oleh manusia selalu membicarakan manusia, namun ada sebagian yang sebetulnya menceritakan sejarah para bake-danuki yang menyamar jadi manusia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740327
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740327,
					"content": "Setengah dari setengah sisanya adalah kisah tentang manusia, setengah yang satunya lagi adalah tentang para tengu, kitsune, oni, dan siluman lainnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740328
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740328,
					"content": "Tapi, setengah dari kisah-kisah ini pun ada setengahnya lagi yang sebenarnya menceritakan tentang para bake-danuki yang menyamar jadi mereka. Lalu masih ada lagi, setengah dari seluruh hikayat tentang bake-danuki, menceritakan tentang diriku, Ioroi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740329
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740329,
					"content": "Jadi, huh, aku ini yang paling hebat ya, hmm. Bisa bicara dengan kalian sih, jelas bukan sesuatu yang perlu dibicarakan berlarut-larut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740330
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740330,
					"content": "Aku mengerti, 5/16 dari semua kisah yang ada, semuanya tentang kamu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740331
					]
				},
				{
					"id": 726740331,
					"content": "Hmm? \"5/16\" itu ... sesuatu yang bisa dimakan, ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740332
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740332,
					"content": "Kedengarannya enak. Mau makan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740333
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726740333,
					"content": "#Maksud {NICKNAME} itu bagian kisah Ioroi menurut penjelasan yang tadi Ioroi bilang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740334
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740334,
					"content": "Ioroi. Hebat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740335
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726740335,
					"content": "Huh. Tentu saja! Aku hebat, kamu harus banyak belajar dariku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740336
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740336,
					"content": "Eh? Kalau dipikir-pikir, lama-lama omongannya Kichiboushi semakin bisa dimengerti ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740337
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740337,
					"content": "Rambut Putih pintar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740338
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726740338,
					"content": "Memang sih itu pujian, tapi kok Paimon malah merasa kurang nyaman ya dipuji karena hal begitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740339
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740339,
					"content": "Baguslah. Anak ini kuserahkan pada kalian, bawa dia keliling dunia untuk berlatih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740340
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740340,
					"content": "Waktu aku masih jadi bocah tanuki dulu, aku juga berkelana sampai ke delapan belas tempat di Inazuma. Mencari benda peninggalan bake-danuki terkenal, Tsukumo. Tidak meninggalkan jalan tanuki, sampai bisa jadi hebat seperti sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740341
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740341,
					"content": "Wah! Karena itu Ioroi disegel dalam batu ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740342
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740342,
					"content": "Ha-he-ho, batu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740343
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726740343,
					"content": "Hmm? Kichiboushi, masa kamu juga ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740344
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740344,
					"content": "Kembali ke topik utama! Kami sebaiknya pergi ke tempat yang mana dulu nih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740345,
						726740347
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740345,
					"content": "Tempat yang tadi dibilang Ioroi ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740346
					]
				},
				{
					"id": 726740346,
					"content": "Ah! Ke Dragonspine ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740348
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740348,
					"content": "\"Tak ada gunung yang tak bisa didaki\". Paimon sudah tunggu kapan kalimat keren itu bisa keluar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740349
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740349,
					"content": "Tak ada gunung yang tak bisa didaki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740350
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726740350,
					"content": "Hu-hmm, kedengarannya dingin sekali tuh... Kichiboushi perutmu tidak boleh kena angin ya. Kalau masuk angin, gawat, nanti tidak bisa main gendang perut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740351
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740351,
					"content": "#Terus, makan yang benar. Di luar sana harus nurut sama {M#Om}{F#Tante} Rambut Kuning.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740352
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740352,
					"content": "#Oke! Ikut sama {M#Om}{F#Tante} Rambut Kuning.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740353,
						726740354,
						726740355
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726740353,
					"content": "Kami akan jaga Kichiboushi baik-baik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740356
					]
				},
				{
					"id": 726740356,
					"content": "Mulai sekarang kita saling jaga ya, Kichiboushi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740357
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740357,
					"content": "Hmm, jangan takut! Kichiboushi jaga kalian!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740358
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726740358,
					"content": "Kayaknya kita masih kurang nyambung deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740354,
					"content": "Serahkan saja pada kami.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740356
					]
				},
				{
					"id": 726740355,
					"content": "#Bukan {M#Om}{F#Tante}. Panggil kakak!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740356
					]
				},
				{
					"id": 726740347,
					"content": "Kenapa Dragonspine?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740348
					]
				},
				{
					"id": 726740311,
					"content": "Kendala super besar ini!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740312
					]
				}
			]
		},
