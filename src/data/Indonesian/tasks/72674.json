			"dialogs": [
				{
					"id": 726740201,
					"content": "Kichiboushi, lama tak jumpa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740202,
					"content": "Hmm! Rambut Putih. Rambut Kuning.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740203
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726740203,
					"content": "Rambut Kuning itu maksudnya aku?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740204
					]
				},
				{
					"id": 726740204,
					"content": "Woi! Siapa yang kamu panggil Rambut Putih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740205,
					"content": "Mm, kuat sekali. Bisa ngerti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740206
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726740206,
					"content": "#Namaku {NICKNAME}, dan yang kecil ini Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740207
					]
				},
				{
					"id": 726740207,
					"content": "Ingat baik-baik ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740208,
					"content": "Keprak-keprok Lavender Melon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740209
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726740209,
					"content": "Ha, Lavender Melon??? Terus apa maksudnya keprak-keprok?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740210,
					"content": "Ya setidaknya bisa komunikasi sih .... walau agak maksa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740211,
					"content": "Iya, terkesan maksa ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740212
					]
				},
				{
					"id": 726740212,
					"content": "#Yah sudahlah, {NICKNAME}. Pokoknya kita pamit dulu deh ke Ioroi. Kan mau bawa Kichiboushi jalan-jalan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740213,
					"content": "Ioroi! Yo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740214
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726740214,
					"content": "Yuhu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
