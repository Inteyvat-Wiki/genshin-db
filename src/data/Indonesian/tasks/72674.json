			"trigger": {
				"objectNames": [
					"Ioroi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726740101,
					"content": "Ioroi! Hai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740102,
					"content": "Wah! Ketahuan! Kalian kok ... Eh tunggu, bau ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740103
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740103,
					"content": "Oh, cuma kalian ya. Sudah lama tak jumpa, aku sampai lupa bau kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740104
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740104,
					"content": "Ioroi sih tidak ada bedanya sama sekali, masih takut manusia dan masih terkurung dalam batu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740105,
					"content": "Hmm! Apa maksud kalian, bocah-bocah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740106,
						726740107
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740106,
					"content": "Semoga segelmu cepat diangkat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740108
					]
				},
				{
					"id": 726740108,
					"content": "Segel buatan manusia payah! Asalkan aku berusaha sedikit ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740109
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740109,
					"content": "*uhuk*",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740110
					]
				},
				{
					"id": 726740110,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740111
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740111,
					"content": "#Huh. Mau bagaimana lagi, kalian juga cukup sering menjaga anak-anak. Para tanuki kecil bilang, ada {M#Om}{F#Tante} rambut kuning wangi yang sering temani mereka main, dan mereka senang sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740112,
						726740113,
						726740114
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740112,
					"content": "#{M#Om}{F#Tante} rambut kuning ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740115
					]
				},
				{
					"id": 726740115,
					"content": "Aku pikir semua manusia sama saja seperti dia yang menyegel kami para bake-danuki di sini. Sudah jahat, seram pula. Ternyata masih ada orang baik juga ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740116,
						726740117
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740116,
					"content": "Sebagian besar baik hati kok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740118
					]
				},
				{
					"id": 726740118,
					"content": "Iya, orang-orang yang pernah kami temui, baik-baik semuanya tuh. Lagian, Ioroi kan disegel gara-gara maling sisir keramat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740119,
					"content": "Hmph! Aku sudah kembalikan sisirnya! Kalau kalian ketemu dengan orang yang belajar sihir dari Reizenbou itu, suruh dia keluarkan aku dari batu ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740120
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740120,
					"content": "Sudah lama sekali aku duduk di sini, dan semuanya gara-gara si kitsune sialan itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740121
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740121,
					"content": "(Ioroi ngeluhnya kayak kakek-kakek saja ya.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740122,
					"content": "(Ya, dia memang sudah tua kan.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740123
					]
				},
				{
					"id": 726740123,
					"content": "Tangan dan kaki kalian berdua kan bukan terbuat dari batu, pasti sudah jalan-jalan ke banyak tempat ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740124
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740124,
					"content": "Iya dong! Kita kan datang dari seberang lautan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740125,
					"content": "Kamu menceritakan kisah Liyue dan Mondstadt ke Ioroi.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						726740126
					]
				},
				{
					"id": 726740126,
					"content": "Ternyata di luar sana ada banyak sekali tempat ya ... Luar biasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740127
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740127,
					"content": "Selama ini, cuma tanuki-tanuki kecil saja yang lapor dan cerita padaku. Jadi aku kurang tahu soal dunia luar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740128
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740128,
					"content": "Dulu waktu masih di Mt. Yougou, aku pernah menerawang ke utara di seberang lautan, dan melihat ada gunung yang tinggi sekali, mungkin lebih tinggi dari Mt. Yougou. Aku selalu penasaran tempat apa itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740129,
						726740131
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740129,
					"content": "Kalau di sebelah sana sih ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740130
					]
				},
				{
					"id": 726740130,
					"content": "Arah sana sih pasti Dragonspine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740132,
					"content": "Hu-hmm, gunung salju ya ... Dengar namanya saja perutku sudah terasa dingin. Aku heran kenapa orang itu ingin ke tempat seperti itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740133
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740133,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740134
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740134,
					"content": "Hehe. Dulu kan aku pernah bilang, kalian itu orang baik, jadi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740135
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740135,
					"content": "Paimon bisa rasakan basa-basi kayak mau minta tolong nih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740136,
					"content": "Hmm! Aku ini mendapat titah menjaga Chinju Forest, langsung dari Yang Mulia! Kalau aku tidak disegel di dalam batu ini, aku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740137,
						726740138
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740137,
					"content": "Perlu bantuan apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740143
					]
				},
				{
					"id": 726740143,
					"content": "Aku memang tidak bisa bergerak, tapi anak-anak bisa. Aku ingin minta tolong kalian bawa salah satu tanuki kecilku pergi \"latihan\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740144
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740144,
					"content": "Bawa Kichiboushi. Setelah terakhir kali kalian main sama dia, dia terus saja merengek ingin ketemu kalian lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740145,
						726740146
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740145,
					"content": "Bisa saja sih ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740147
					]
				},
				{
					"id": 726740147,
					"content": "Iya. Kami enggak ngerti kata-kata Kichiboushi. Kalau bertualang bersama pasti susah, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740148
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740148,
					"content": "Mana mungkin. Pada dasarnya bangsa tanuki paham bahasa manusia. Kalian saja yang tidak paham bahasa tanuki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740149
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740149,
					"content": "Hah? Jadi gitu ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740150
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740150,
					"content": "Tapi, kalau jadi teman seperjalanan ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740151
					]
				},
				{
					"id": 726740151,
					"content": "Aku lebih suka kalau bisa diajak ngobrol sih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740152
					]
				},
				{
					"id": 726740152,
					"content": "#Iya, kayak Paimon sama {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740153
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740153,
					"content": "Hmm, baiklah. Tempo hari ingat tidak ada yang pakai ilmu sihir bangsa kami, buat kasih kalian makan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740154
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740154,
					"content": "Jangan nilai aku dari tampangku yang seperti ini ya. Kalau cuma kasih \"makanan\" supaya kalian bisa mengerti bahasanya Kichiboushi, itu sih perkara sepele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740155
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740155,
					"content": "Asyik! Makanan!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740156
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740156,
					"content": "Makanannya enak tidak ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740157
					]
				},
				{
					"id": 726740157,
					"content": "Huh, jangan memandang rendah kemampuan memasakku ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740158
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740158,
					"content": "Sulit untuk menjelaskan bahan apa yang dipakai Ioroi, tapi ...\\nIntinya, kamu dan Paimon makan sesuatu yang \"kelihatannya sih makanan enak\", yang ditaruh di atas perut besar Ioroi.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						726740159
					]
				},
				{
					"id": 726740159,
					"content": "Enak banget nih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740160
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740160,
					"content": "Tentu saja. Aku ini kan Ioroi ... aku dulu pernah menyihir bola lumpur dan bulu tanuki jadi Sashimi Platter untuk menipu si Four Oni of Ogata!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740161
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740161,
					"content": "Ioroi memang hebat! Tapi kalau boleh tahu, yang barusan kamu kasih ke kami itu sebenarnya terbuat dari apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740162
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740162,
					"content": "Ada beberapa hal yang lebih baik kamu tidak usah tahu, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740163
					]
				},
				{
					"id": 726740163,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740164
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740164,
					"content": "Sudahlah, ayo kita langsung saja ajak ngobrol si Kichiboushi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740146,
					"content": "Tapi ada satu kendala ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740147
					]
				},
				{
					"id": 726740138,
					"content": "Hmmmmmm ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740139
					]
				},
				{
					"id": 726740139,
					"content": "#Ooh, Paimon paham maksud kamu, {NICKNAME}! Apa bakal ada harta karun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740140
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740140,
					"content": "Harta karun? Jelas ada lah. Aku ini pemimpin tertingginya lima ratus lima bake-danuki, mana ada harta karun Inazuma yang belum pernah kulihat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740141
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740141,
					"content": "Nah, apa yang bisa kami bantu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740142
					]
				},
				{
					"id": 726740142,
					"content": "Iya, kami jago dalam hal bantu orang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740143
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740131,
					"content": "Yang kelihatan dari arah sana itu gunung bersalju Dragonspine.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740132
					]
				},
				{
					"id": 726740117,
					"content": "Terima kasih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740118
					]
				},
				{
					"id": 726740113,
					"content": "Baunya enak ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740115
					]
				},
				{
					"id": 726740114,
					"content": "#Tolong ya, jangan panggil {M#Om}{F#Tante}. Panggil aku kakak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740115
					]
				},
				{
					"id": 726740107,
					"content": "Maksud Paimon, dia ingin kamu segera bebas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740108
					]
				}
			]
		},
		{
			"id": 7267402,
