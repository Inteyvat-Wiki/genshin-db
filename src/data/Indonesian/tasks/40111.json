			"dialogs": [
				{
					"id": 401115201,
					"content": "Jenderal Kujou, boleh bicara sebentar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115202
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 401115202,
					"content": "Boleh. Selamat atas kemenangannya, Sangonomiya Kokomi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115203
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 401115203,
					"content": "Aku ingin berterima kasih untuk saran yang Jenderal berikan sebelum pertandingan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115204
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 401115204,
					"content": "Tidak perlu. Siapa pun yang cukup pintar tentunya tahu kalau kemampuan dan siasat adalah penentu kemenangan. Tapi pertandinganmu tadi memang seru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115205
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 401115205,
					"content": "Sayang sekali Jenderal tidak ikut serta kali ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115206
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 401115206,
					"content": "Aku bukan tandinganmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115207
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 401115207,
					"content": "Jangan merendah. Jenderal Kujou tidak beda jauh denganku ... melatih kemampuan lewat permainan, terus memikirkan siasat balasan, bertanding melawan orang lain dengan dalih \"pertemanan\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115208
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 401115208,
					"content": "Tidak salah juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115209
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 401115209,
					"content": "Kalau begitu, mari kita duel satu kali sebelum kamu meninggalkan Pulau Narukami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115210
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 401115210,
					"content": "Dengan senang hati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sangonomiya Kokomi"
				}
			]
