			"dialogs": [
				{
					"id": 401113101,
					"content": "Ngomong-ngomong, Kapten Beidou bisa main Genius Invokation TCG tidak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113102
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 401113102,
					"content": "Bisa. Malah dia salah satu yang paling hebat di Crux Fleet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113103
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 401113103,
					"content": "Boleh titip salam tidak, Abang Kazuha? Aku nge-fans banget sama Kapten Beidou. Pengin banget kenal dan berteman sama dia, tapi sampai hari ini belum dapat kesempatan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113104
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 401113104,
					"content": "Tentunya. Tapi Direktur, tolong jangan terlalu keras ketika menang darinya nanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				}
			]
		},
		{
			"id": 4011132,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
