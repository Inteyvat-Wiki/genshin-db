				"points": []
			},
			"dialogs": [
				{
					"id": 401111101,
					"content": "Menang! Aku menang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111102,
						401111106
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 401111102,
					"content": "Selamat, Timmie!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401111103
					]
				},
				{
					"id": 401111103,
					"content": "Terima kasih. Aku sudah enggak sabar mau cerita sama mama ... Dia pasti senang, ya kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111104
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 401111104,
					"content": "Mama yang suruh aku ikutan turnamen! Hadiah ini buat mama, hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111105
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 401111105,
					"content": "Coba kalau papa juga bisa lihat aku sekarang ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timmie"
				},
				{
					"id": 401111106,
					"content": "Sampai jumpa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401111107
					]
				},
				{
					"id": 401111107,
					"content": "Dadah! Duh, Genius Invokation TCG memang seru abis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timmie"
				}
			]
		},
		{
			"id": 4011112,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
