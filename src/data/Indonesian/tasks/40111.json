			},
			"dialogs": [
				{
					"id": 401113201,
					"content": "Bahkan lomba Genius Invokation TCG tidak resmi saja perputarannya bagus ya. Banyak pemain serius yang ikut, baik ke turnamen resmi atu pun ke yang tidak resmi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113202
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 401113202,
					"content": "Aku sendiri ... bolehlah sesekali mencoba permainan yang lagi populer. Tapi tetap catur nomor satu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113203
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 401113203,
					"content": "Tapi intinya, dari begitu banyak permainan yang berbeda-beda, ada satu hal yang tetap sama: tujuannya adalah untuk kumpul-kumpul bersama teman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ningguang"
				}
			]
		},
