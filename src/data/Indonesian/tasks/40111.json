				"points": []
			},
			"dialogs": [
				{
					"id": 401111501,
					"content": "\"Bakat Muda di Kota Danau! Jenius Cilik Menang Dari Kapten Kavaleri\" ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111502
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401111502,
					"content": "Judul ini aman buat para Knight, tapi kurang faktor \"wow\" ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111503
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401111503,
					"content": "\"Kalah Dalam Lima Ronde! Ahli Siasat Knights of Favonius Kalah Adu Siasat Lawan Bocah Penunggu Jembatan\" ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111504
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401111504,
					"content": "\"Harapan Juara Sang Kapten Pasukan Kuda Diinjak-injak Oleh Kuda Hitam Turnamen\" ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111505
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401111505,
					"content": "Aduh, apa mending yang pertama saja kali ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Charlotte"
				}
			]
		},
