			"dialogs": [
				{
					"id": 401115101,
					"content": "Fiuh, duelnya si Nona Rubah dan Nona Soto Mie asli bikin tegang! Keringat segede-gede bola bercucuran dari jidat Tuan Besar ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115102
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401115102,
					"content": "Iya iya, seantero Ritou juga tahu semangat bos membara, tapi anggota yang lain sudah nungguin kita. Pulang yuk, sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115103
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401115103,
					"content": "Eh ... biarin saja mereka tunggu! Tuan Besar ini mau main sama sohibnya tersayang, satu duel terakhir! Jangan nolak dong ya, sobatku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115104,
						401115107
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401115104,
					"content": "Oke deh, ayo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401115105
					]
				},
				{
					"id": 401115105,
					"content": "YES, gitu baru namanya sahabat! Aku tahu kamu tidak bakal tolak duel. Sesama pemain kartu sejati tentu saling memahami!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115106
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401115106,
					"content": "Kalian ... Ah, sudahlah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401115107,
					"content": "Lain kali ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401115108
					]
				},
				{
					"id": 401115108,
					"content": "Ya sudah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115109
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401115109,
					"content": "Tidak apa, bukan salah kamu. Cepat pergi sana, kalau enggak mau lihat Oni besar nangis bombay!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				}
			]
		},
