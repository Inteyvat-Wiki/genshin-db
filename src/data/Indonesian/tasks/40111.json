				"objectNames": [
					"Kaeya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401111301,
					"content": "Halo, halo. Ada yang mau diobrolin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111302,
						401111306,
						401111310
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401111302,
					"content": "Tentang Genius Invokation TCG ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401111303
					]
				},
				{
					"id": 401111303,
					"content": "Sekarang permainan ini jadi populer banget, sudah jadi bagian dari kehidupan sehari-hari. Mau di mana pun juga selalu ada orang main.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111304
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401111304,
					"content": "Bahkan sampai ada yang rela berhenti minum, biar pikirannya tetap jernih waktu main kartu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111305
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401111305,
					"content": "Hehe, Diona pasti senang dengarnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111306,
						401111310
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401111306,
					"content": "Knights of Favonius apa kabar nih?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401111307
					]
				},
				{
					"id": 401111307,
					"content": "Tenang, semua sehat dan baik-baik kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111308
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401111308,
					"content": "Aku bahkan berhasil ajak Master Jean main, tapi baru setengah jalan dia sudah ada yang cari. Akhirnya sudahan deh duelnya. Duh, kerjaan memang nomor satu ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111309
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401111309,
					"content": "Tapi dengan suksesnya turnamen kali ini, semua yang hadir juga senang sekali, kan lumayan. Berkurang satu hal yang harus dia khawatirkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111302,
						401111310
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401111310,
					"content": "Kita ngobrol lagi nanti yah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401111311
					]
				},
				{
					"id": 401111311,
					"content": "Oke, sekalian main Genius Invokation TCG ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				}
			]
		},
