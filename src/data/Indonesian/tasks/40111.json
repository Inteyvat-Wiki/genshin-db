			"dialogs": [
				{
					"id": 401113301,
					"content": "Halo, namaku Charlotte, wartawan dari The Steambird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113302
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401113302,
					"content": "Boleh minta waktunya untuk wawancara sebentar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113303
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401113303,
					"content": "*huff* Baik, silakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113304
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 401113304,
					"content": "Anda memulai kompetisi ini dengan sangat bagus, mengalahkan banyak lawan hingga akhirnya masuk babak final, tapi harus menelan pil pahit ketika menghadapi Direktur Hu Tao dari Wangsheng Funeral Parlor. Padahal hanya sedikit lagi saja untuk menggapai kemenangan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113305
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401113305,
					"content": "Apakah ada sepatah dua patah kata yang ingin disampaikan mengenai pertandingan final tadi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113306
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401113306,
					"content": "Ehhh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113307
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 401113307,
					"content": "Nona wartawan ingin jawaban yang aman buat media, atau mau tahu pendapatku yang sebenarnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113308
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 401113308,
					"content": "Tentu saja pendapat sebenarnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113309
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401113309,
					"content": "*huff*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113310
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 401113310,
					"content": "Yah, aku selalu bilang kalau main kartu itu tujuh bagian kemampuan, dan tiga bagian beruntung. Tapi kalau dadu lawanmu enam-enamnya keluar elemen yang sama, mau sakti seperti Adeptus juga percuma saja, tidak bisa berkutik. Apa lagi petualang biasa macam aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qian"
				}
			]
		},
