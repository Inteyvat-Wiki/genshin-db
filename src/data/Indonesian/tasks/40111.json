				{
					"id": 401115301,
					"content": "Aku dengar kamu ada sebut \"Kitsune Youkai\" tadi. Boleh tanya tentang itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115302
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401115302,
					"content": "Tolong ceritakan dengan detail. Siapa tahu ada yang layak masuk berita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115303
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401115303,
					"content": "Oh! Jangan deh, aku takut salah ngomong. Lagian, aku bukan Youkai yang paling layak untuk jawab pertanyaan begitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115304
					],
					"speakerTitle": "Kirara"
				},
				{
					"id": 401115304,
					"content": "Baiklah, tapi mungkin boleh ceritakan kenapa Kitsune suka tahu goreng?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115305
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401115305,
					"content": "Aduh, ditanya gitu malah bikin lapar nih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115306
					],
					"speakerTitle": "Kirara"
				},
				{
					"id": 401115306,
					"content": "Mending aku traktir kamu Kitsune Ramen khas Inazuma deh! Sambil makan, sambil cerita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kirara"
				}
