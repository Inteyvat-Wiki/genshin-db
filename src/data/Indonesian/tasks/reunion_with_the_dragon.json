					"content": "Diluc ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3840420,
					"content": "Meskipun dia benci Knights of Favonius, tapi dia tetap melindungi Mondstadt dengan caranya sendiri ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3840421,
					"content": "Ohh? Kenapa suara Paimon tiba-tiba jadi lembut?",
					"roleType": "TALK_ROLE_NPC",
