					"nextDialogs": [
						3840417
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3840417,
					"content": "Apa!? Kapan ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3840418,
					"content": "Kalau kalian ingin melacak keberadaan mereka, aku akan menghubungi intelku. Aku punya ide lain untuk menyelesaikan masalah ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840419
					],
					"speakerTitle": "Diluc"
				},
				{
