					"nextDialogs": [
						3840205
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3840205,
					"content": "Apa pun hasilnya, akhirnya semuanya akan menjadi lebih baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840206
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3840206,
					"content": "Belakangan ini Mondstadt benar-benar sudah mengalami banyak hal ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840207
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3840207,
					"content": "Hah! Pada akhirnya solusi masalah kita sederhana, yaitu seorang pengembara dan sebuah lagu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840208
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3840208,
					"content": "Yah, kurasa Knights of Favonius juga sedikit berguna ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840209
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3840209,
					"content": "Oke, cukup, Tuan Diluc ... Semuanya, tolong mundur sedikit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840210
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3840210,
					"content": "Aku, penyair terbaik yang merantau di dunia manusia, akan mulai tampil dengan Holy Lyre.",
