						3840423
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3840423,
					"content": "Tunggu kabar dariku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840424
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3840424,
					"content": "Aku akan menunjukkan kepada Abyss Order, apa akibatnya jika mengganggu kedamaian Mondstadt ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840425
