			"dialogs": [
				{
					"id": 710160301,
					"content": "Tentang Harta Tanpa Nama...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710160302
					]
				},
				{
					"id": 710160302,
					"content": "Kalau aku tidak salah ingat, benda yang terakhir kali kamu bawa itu seharusnya berjumlah 3 bagian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160303
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160303,
					"content": "Kalau ketiga bagian tersebut digabungkan, barulah menjadi utuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160304
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160304,
					"content": "Kalau kamu bisa menyatukan semua komponen itu, aku bersedia membeli benda tersebut dengan harga yang mahal darimu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160305
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160305,
					"content": "Tetapi ini adalah benda kuno, kalau ingin mencari bagian lain dan menyatukannya... kurasa ini sangatlah sulit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linlang"
				}
			]
		},
