			"dialogs": [
				{
					"id": 710160401,
					"content": "Baiklah, akan kucoba.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710160402
					]
				},
				{
					"id": 710160402,
					"content": "Oke, bawa lagi saja benda itu kepadaku kalau kamu sudah menemukan semuanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linlang"
