						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Linlang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710160201,
					"content": "Tentang Harta Tanpa Nama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160202
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160202,
					"content": "Benda yang kamu dapatkan... kelihatannya berharga, dilihat dari pola motifnya aku yakin ini benda kuno. Tunggu sebentar, biar kulihat dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160203
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160203,
					"content": "Meski ada cacat di beberapa tempat, tapi kalau kamu ingin menjualnya dengan cepat, aku bisa membelinya darimu. Harganya adil, tapi tidak bisa terlalu tinggi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160204
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160204,
					"content": "Aku baru saja melihat benda ini. Ini memang motif dari Liyue, ditambah lagi ukiran ini sebenarnya adalah anekdot yang berhubungan dengan \"Azhdaha\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160205
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160205,
					"content": "Menurut legenda, Azhdaha adalah naga ajaib yang lahir dari inti elemen Geo Liyue, bahkan Rex Lapis pun kesulitan mengalahkannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160206
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160206,
					"content": "Untuk menaklukkannya, Rex Lapis pertama-tama memanggil tiga Adeptus dan menyuruh mereka bekerja sama untuk membuat gua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160207
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160207,
					"content": "Kemudian, Rex Lapis sendiri harus bertarung melawan makhluk itu dan membawanya ke dalam sebuah gua. Kemudian dia memerintahkan para Adeptus untuk menutup jalan keluar, mengurung Azhdaha di dalam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160208
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160208,
					"content": "Dan ukiran yang terdapat pada benda ini adalah ukiran yang mengisahkan tentang pertarungan besar tersebut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160209
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160209,
					"content": "Maka menurut dugaanku, benda ini minimal memiliki tiga bagian. Ketiga bagian ini digabungkan, barulah menjadi sebuah benda yang utuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160210,
						710160212
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160210,
					"content": "Bagaimana kamu bisa tahu cerita ini...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710160211
					]
				},
				{
					"id": 710160211,
					"content": "Jual beli benda seperti ini kan sudah menjadi bidangku, sudah seharusnya aku tahu sedikit lebih banyak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160215
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160215,
					"content": "Eh, sepertinya ini agak keluar konteks. Maksudku sederhana... benda ini totalnya ada 3 bagian, karena itu kalau dijual terpisah... harganya tidak akan tinggi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160216
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160216,
					"content": "Tapi kalau ketiga bagian tersebut dapat disatukan, harganya pasti akan sangat bagus. Tapi memang... ingin menyatukan ketiga bagian tersebut sepertinya lebih sulit lagi mengingat umur benda ini sudah sangat tua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160212,
					"content": "Liyue begitu misterius...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710160213
					]
				},
				{
					"id": 710160213,
					"content": "Aku pribadi tidak begitu jelas, tapi dulu ada satu orang tua yang pernah mengatakan padaku bahwa Liyue ini sangat luas dan sejarahnya sangatlah panjang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160214
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160214,
					"content": "Menemukan barang antik apa pun di Liyue sama sekali bukan hal yang mengherankan. Jika dibandingkan dengan sejarah Liyue yang sangat panjang ini, pengetahuan kita terhadap benda-benda seperti itu hanyalah seperti butiran pasir di pantai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160215
					],
					"speakerTitle": "Linlang"
				}
			]
		},
