			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Linlang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710160501,
					"content": "Aku sudah menemukan ketiga bagian benda tersebut.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710160502
					]
				},
				{
					"id": 710160502,
					"content": "Kamu benar-benar berhasil mengumpulkan semuanya? Coba aku lihat... Ternyata benar, kalau ketiga motif ini disatukan, mereka menggambarkan kisah \"Azhdaha\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160503
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160503,
					"content": "Kelihatannya, bangau ini adalah \"Mountain Shaper\", rusa ini... sepertinya \"Moon Carver\", tapi yang satu ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160504
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160504,
					"content": "Eh? Ukiran terakhir di bagian atas ini sepertinya... sengaja dirusak oleh orang sampai detailnya sudah tidak terlihat sama sekali. Siapa sebenarnya ketiga Adeptus ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160505
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160505,
					"content": "Sudahlah, lagi pula hal-hal ini sudah di luar batas pengetahuanku. Bagaimanapun, \"harta karun\" ini sekarang sudah utuh, aku akan membelinya darimu dengan harga yang mahal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160506
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160506,
					"content": "Apa keputusanmu, apakah kamu mau menyimpan \"harta karun\" ini sendiri, atau menjualnya kepadaku dan kubeli dengan harga yang sangat bagus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160507
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160507,
					"content": "Akan kujual kepadamu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710160508
					]
				},
				{
					"id": 710160508,
					"content": "Baiklah kalau begitu, kamu bisa menyerahkannya sekarang kepadaku... ini ambil uangnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160509
					],
					"speakerTitle": "Linlang"
				},
