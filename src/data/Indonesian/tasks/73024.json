			"dialogs": [
				{
					"id": 730240101,
					"content": "Wah, kamu benar-benar sangat membantu! Terima kasih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240102
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240102,
					"content": "Seperti yang kamu lihat, aku adalah Pelindung Hutan di sini. Namaku adalah Rana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240103,
						730240105
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240103,
					"content": "#Aku {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240104
					]
				},
				{
					"id": 730240104,
					"content": "Namaku Paimon! Kami datang dari bangsa lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730240107,
					"content": "Begitu ya. Ya ... dari cara kalian berpakaian, memang tidak terlihat seperti penduduk hutan ... Juga bukan datang dari gurun emas. Kemampuan bernapas kalian terlihat bagus, sangat cocok beraktivitas di Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240108
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240108,
					"content": "Oh? Kalau Rana itu Pelindung Hutan, berarti ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240109,
						730240123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730240109,
					"content": "Kamu kenal Tighnari?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240110
					]
				},
				{
					"id": 730240110,
					"content": "#Oh! {NICKNAME} kenal dengan Tighnari juga?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240111
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240111,
					"content": "Meskipun Tighnari kelihatannya susah didekati, tapi sebenarnya dia orang yang baik. Dia menjagaku dengan baik sewaktu aku dalam pelatihan. Selain itu, telinganya juga sangat cantik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240112
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240112,
					"content": "Iya benar! Sebenarnya Paimon juga mau pegang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240113,
						730240116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730240113,
					"content": "Sebenarnya aku juga ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240114
					]
				},
				{
					"id": 730240114,
					"content": "Ya ... kalau Paimon terbang diam-diam, bisa pegang tidak ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730240115,
					"content": "Hahaha, Tighnari pasti akan marah kalau kamu pegang tanpa minta izin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240118
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240118,
					"content": "Benar, kan? Terlihat sangat berkilau, entah seperti apa teksturnya. Anak-anak yang dia asuh juga sangat tertarik dengan ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240119
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240119,
					"content": "Eh? Maksud Rana ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730240120,
					"content": "Apakah itu Collei?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240121
					]
				},
				{
					"id": 730240121,
					"content": "#Eh, {NICKNAME} juga kenal dengan Collei?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240122
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240122,
					"content": "Kondisi tubuh Collei kurang baik. Meski begitu dia bekerja begitu keras untuk menjaga hutan, dan memusnahkan Withering. Semua orang sangat khawatir dengan kondisinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240141
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240141,
					"content": "Ehem! Bagaimanapun juga tugas kami sebagai Pelindung Hutan adalah untuk melindungi hutan, membantu pengembara dan memberikan panduan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240142
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240142,
					"content": "#Seperti yang {NICKNAME} dan Paimon lihat, belakangan ... kondisi hutan terlihat kurang ideal, bukan? \"Fungus\" dan binatang buasnya semakin ganas, lalu ada Withering juga ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240143
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240143,
					"content": "Lebih baik kalian aku antar saja? Ruteku berikutnya akan melewati Desa Vimara. Dari situ sudah mudah untuk pergi ke Pelabuhan Ormos atau Kota Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240144,
						730240146
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240144,
					"content": "Boleh, ayo kita berangkat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240145
					]
				},
				{
					"id": 730240145,
					"content": "Oke, kalian berdua pasti aman bersamaku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240146,
					"content": "Baiklah, tapi ada hal lain yang harus aku urus dulu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240147
					]
				},
				{
					"id": 730240147,
					"content": "Aku mengerti, kalau begitu aku akan menunggumu di sini. Berhati-hatilah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240116,
					"content": "Paimon pasti bisa terbang diam-diam dan menyentuhnya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240117
					]
				},
				{
					"id": 730240117,
					"content": "Hei! Kalau begitu Tighnari bakal marah, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730240123,
					"content": "Kamu seharusnya kenal Collei, kan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240124
					]
				},
				{
					"id": 730240124,
					"content": "#Eh, {NICKNAME} juga pernah bertemu dengan anak itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240125
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240125,
					"content": "Kondisi tubuh Collei kurang baik. Meski begitu dia bekerja begitu keras untuk menjaga hutan, dan memusnahkan Withering. Semua orang sangat khawatir dengan kondisinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240126
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240126,
					"content": "Tapi dia bersama senior yang telinganya cantik itu, jadi harusnya tidak akan kenapa-kenapa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240127
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240127,
					"content": "Eh? Telinga ... Jangan-jangan maksudmu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240128,
						730240138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730240128,
					"content": "Tighnari ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240129
					]
				},
