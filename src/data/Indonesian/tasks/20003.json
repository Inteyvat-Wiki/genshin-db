			"dialogs": [
				{
					"id": 200030501,
					"content": "Mona, apa kamu di rumah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200030502,
					"content": "Mona, sudah waktunya untuk bayar uang sewa!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200030503
					]
				},
				{
					"id": 200030503,
					"content": "Eh ... Mona sepertinya benar-benar tidak di rumah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200030504,
					"content": "Aneh. Bukannya dia selalu mengurung diri di dalam rumah? Apa dia sedang keluar karena ada urusan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200030505,
					"content": "Atau mungkin, dia tidak bisa membuka pintu ... pingsan karena kelaparan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030506,
						200030507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200030506,
					"content": "Aku ragu sih ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200030508
					]
				},
				{
					"id": 200030508,
					"content": "Sa-Sampai sebegitunya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200030509,
					"content": "Tapi, kita harus cari Mona di mana ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200030507,
					"content": "Dia pernah bilang kalau dia menemukan cara untuk menghasilkan uang, kan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200030508
