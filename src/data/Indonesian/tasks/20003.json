			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Goth"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200030301,
					"content": "Terima kasih banyak. Harusnya sudah cukup. Sekarang aku harus mengantarnya ke tukang kayu ... Oh iya, aku masih harus menagih uang sewa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030302
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200030302,
					"content": "*huff* Andai saja si As-Astromona, atau siapa itu, dia kali ini ada di rumah tidak ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030303
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200030303,
					"content": "Namanya Astrologis Mona Megistus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200030304
					]
				},
				{
					"id": 200030304,
					"content": "Iya! Itu dia namanya. Ugh, panjang sekali namanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030305
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200030305,
					"content": "Mona belum membayar uang sewanya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200030306,
					"content": "Siapa lagi? Semua penyewaku sudah membayar uang sewa. Hanya dia yang belum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030307
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200030307,
					"content": "Aku sudah datang berkali-kali, tapi dia selalu tidak ada di rumah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030308
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200030308,
					"content": "Jadi, Pengembara, bisakah kamu turun dan mendesak dia untuk membayar uang sewa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Goth"
				}
			]
		},
