				"objectNames": [
					"Goth"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200030101,
					"content": "*huff* Kurasa aku sudah datang sia-sia ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030102
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200030102,
					"content": "Duh, si tua bangka ini akan mati kelelahan ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030103
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200030103,
					"content": "Ada sesuatu yang mendesak?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200030104
					]
				},
				{
					"id": 200030104,
					"content": "Oh, Pengembara? Ini ... Tidak sampai mendesak juga sih, tapi aku benar-benar kewalahan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030105
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200030105,
					"content": "Kamu tahu kan, soal Fatui-Fatui yang memesan hotelku sepenuhnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030106
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200030106,
					"content": "Dan aku sebagai pemilik Goth Grand Hotel harus mengurus mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030107
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200030107,
					"content": "Aku mengatur suplai bahan makanan, perbaikan-perbaikan, dan hal tetek bengek lainnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030108
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200030108,
					"content": "Belakangan ini ada beberapa kamar hotel yang meja kursinya rusak. Aku harus segera memanggil orang untuk mengantar bahan kayu yang cocok ke tukang kayu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030109
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200030109,
					"content": "Lalu ada masalah karena biaya sewa beberapa rumah belum dibayar ... dan masalah si bocah Marvin yang selalu keluyuran entah ke mana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030110
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200030110,
					"content": "*huff* Aku tidak tahu aku bisa bertahan sampai kapan ... kapan sih bocah itu bisa bersikap dewasa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030111,
						200030112
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200030111,
					"content": "Aku akan membantumu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200030113
					]
				},
				{
					"id": 200030113,
					"content": "Kamu mau membantu? Ah, luar biasa! *huff* Coba saja si Marvin punya sedikit saja pemikiran sepertimu, aku mungkin tidak akan seletih sekarang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030114
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200030114,
					"content": "Kalau begitu, bisakah kamu mengambilkan beberapa Fir Wood dan Birch Wood? Aku harus segera mengirimkan kayu-kayu itu ke tukang kayu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Goth"
				},
				{
					"id": 200030112,
					"content": "Kamu istirahat saja dulu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200030113
					]
				}
			]
		},
