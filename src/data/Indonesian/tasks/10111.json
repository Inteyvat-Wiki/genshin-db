					"content": "Jangan lupa ya, Jack ada di <color=#00E1FFFF>\"Temple of the Lion\"</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ellin"
