					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Stanley",
					"Jack"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101110401,
					"content": "*Huff* *huff*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110402
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101110402,
					"content": "Aku tadi berpikir aku hampir mati!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110403
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110403,
					"content": "Memang, tipis sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110404
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110404,
					"content": "Oh iya, apakah kamu petualang Jack?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110405
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110405,
					"content": "Iya, kamu siapa...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110406
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110406,
					"content": "Aku ke sini untuk mencarimu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101110407,
					"content": "Ellin titip pesan kepada kami untuk mengatakannya padamu bahwa hari ini dia tidak bisa datang untuk merencanakan perjalanannya bersamamu, mungkin lain kali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110408
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110408,
					"content": "Oh, ternyata begitu. Maaf merepotkanmu sampai jauh-jauh datang ke sini... dan juga menyelamatkanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110409
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110409,
					"content": "Hah! Bukan masalah besar, aku, Stanley, dapat menghadapinya sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110410
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101110410,
					"content": "Oh, kamu Stanley, petualang legendaris itu? Terkenal di seluruh Mondstadt, dan pernah menginjak Mare Jivari!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101110411,
					"content": "Betul, itu aku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110412
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101110412,
					"content": "Haha, suatu kehormatan bisa bertemu denganmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110413
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110413,
					"content": "Kalau begitu, apa rencana selanjutnya? Maju, atau mundur?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110414,
						101110417
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110414,
					"content": "Stanley, bagaimana menurutmu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110415
					]
				},
				{
					"id": 101110415,
					"content": "Hehehe, ya... Kurasa kalian aman sekarang, karena kalian bersama petualang terkenal dan legenda Mondstadt — Stanley!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110416
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101110416,
					"content": "Untuk apa kita mundur?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110419
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101110419,
					"content": "Baiklah, semua setuju. Ayo kita maju.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110417,
					"content": "Jack, menurutmu bagaimana?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110418
					]
				},
				{
					"id": 101110418,
					"content": "Menurutku kita sebaiknya lanjut. Dengan Stanley, kita tidak akan menemui masalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110419
					],
					"speakerTitle": "Jack"
				}
			]
		},
		{
			"id": 1011106,
			"completionStepIds": [
				1011106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1011106",
							"2"
						],
						"stepId": 1011106,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Venti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101110601,
					"content": "Pengembara, aku sepertinya menemukan sesuatu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110602
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110602,
					"content": "Apakah kamu bisa membuka detektornya lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110603
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110603,
					"content": "Eh? Stanley memiliki seorang teman imajinasi!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101110604,
					"content": "Sepertinya teman imajinasinya adalah seorang Knight yang kuat... dengan tubuh yang dipenuhi bekas luka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110605,
						101110608
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110605,
					"content": "Cocok dengan deskripsi Stanley tentang dirinya sendiri.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110606
					]
				},
				{
					"id": 101110606,
					"content": "Teman imajinasi dia adalah diri dia sendiri yang dia idolakan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110607
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110607,
					"content": "Menarik. Tapi, apakah benar begitu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110611
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110611,
					"content": "Kalau begitu, aku pamit dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110612
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101110612,
					"content": "Selamat tinggal Stanley!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110613
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110613,
					"content": "Apakah kalian berdua masih punya waktu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110614
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110614,
					"content": "Kenapa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110615
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110615,
					"content": "Beberapa hari lalu, Stanley mabuk dan memberitahuku satu rahasia - rahasia yang dia tidak pernah beri tahu siapa pun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110616
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110616,
					"content": "Senjata yang dia gunakan dalam petualangan dia selama ini, ternyata adalah senjata yang pernah digunakan oleh pahlawan terhebat Mondstadt, Vennessa, <color=#00E1FFFF>\"Sword of Brilliant Valor\"</color> dan <color=#00E1FFFF>\"Shield of Magnificent Honor\"</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110617
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110617,
					"content": "Aku tidak tahu apakah kalian memercayaiku atau tidak, tapi... ternyata pedang dan perisainya masih terletak di Mondstadt, di <color=#00E1FFFF>Dadaupa Gorge</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110618
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110618,
					"content": "Karena kalian begitu hebat, apakah kalian ingin menemaniku mencari kedua senjata legendaris itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110619,
						101110621
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110619,
					"content": "Stanley ternyata memiliki senjata kuat seperti itu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110620
					]
				},
				{
					"id": 101110620,
					"content": "Tentu saja! Dia adalah Stanley!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110623
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110623,
					"content": "Kalau aku bisa mendapatkan sesuatu yang mengagumkan untuk meyakinkan keluargaku, mungkin mereka akan merestui keinginanku menjadi seorang petualang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110624
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110624,
					"content": "Sekarang, aku hanya seorang pemula, keahlianku juga terbatas, dan orang tuaku juga tidak menyetujui impianku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110625
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110625,
					"content": "Jadi, tolonglah, bantu aku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110626
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110626,
					"content": "Aku tidak berani meminta tolong ke Stanley karena alasanku sangat egois... tapi aku janji aku akan mengembalikannya setelah selesai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110627
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110627,
					"content": "Kasihan sekali... ayo kita bantu dia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110628,
						101110629
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101110628,
					"content": "Baiklah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110630
					]
				},
				{
					"id": 101110630,
					"content": "Venti, apakah kamu akan ikut?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110631
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101110631,
					"content": "Hm... bagaimana ya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110632
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110632,
					"content": "Oh, satu lagi, aku punya satu botol anggur langka yang aku dapat dari orang beberapa tahun lalu. Bantu aku dan botol itu akan menjadi milikmu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110633
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110633,
					"content": "<color=#00E1FFFF>Dadaupa Gorge</color>, bukan? Ayo cepat, jangan menghabiskan waktu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110629,
					"content": "Susah menolaknya setelah mendegar cerita itu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110630
					]
				},
				{
					"id": 101110621,
					"content": "Kenapa dia membiarkan senjata seperti itu terlantar di luar sana?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110622
					]
				},
				{
					"id": 101110622,
					"content": "Orang hebat selalu memiliki keunikan sendiri kan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110623
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110608,
					"content": "Aku sudah menduga ada yang aneh dengan ceritanya...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110609
					]
				},
				{
					"id": 101110609,
					"content": "Oh? Menurutmu juga begitu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110610
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110610,
					"content": "Sepertinya dia tidak menceritakan seluruh kisahnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110611
					],
					"speakerTitle": "Venti"
				}
			]
		}
	]
}