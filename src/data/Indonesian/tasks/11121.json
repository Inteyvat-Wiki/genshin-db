						"rawParams": [
							"1112102",
							"2"
						],
						"stepId": 1112102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kun Jun"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111210201,
					"content": "Kun Jun, apa yang kamu temukan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210202,
					"content": "Aha, pas sekali kalian datang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210203
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210203,
					"content": "Apa kamu menemukan sesuatu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210204
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210204,
					"content": "Ada sebongkah bijih di sini, mungkin di dalamnya ada petunjuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210205
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210205,
					"content": "Bijih batu? Apa hubungannya dengan orang hilang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210206,
					"content": "Ayo kita cari tahu. Akan kucoba. Tunggu sebentar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210207
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210207,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210208
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210208,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210209
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210209,
					"content": "Sepertinya dia konsentrasi sekali. Sedang apa ya dia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210210,
					"content": "Aku melihat... empat laki-laki... mengikuti seseorang keluar dari tambang... kelihatannya seperti seorang anak kecil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210211
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210211,
					"content": "Seorang anak kecil? Kenapa bisa ada anak kecil di tambang!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210212,
					"content": "Aku juga tidak yakin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210213
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210213,
					"content": "Lagi pula, bagaimana caramu \"melihat\"nya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210214,
					"content": "Oh! Maksudku bukan \"melihat\" seperti pada umumnya... To—Tolong jangan sebarkan hal yang akan kuberi tahu kepada kalian ya. Ini sedikit aneh... Aku tidak pernah berani menceritakannya kepada orang lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210215
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210215,
					"content": "Aku bisa... melihat ingatan milik batu-batu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210216
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210216,
					"content": "Eh—!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210217,
					"content": "\"Melihat\"? Jadi bukan... menilai atau menebak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210218
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210218,
					"content": "Maksudmu kamu bisa memegang sebuah batu dan —— bum! Terjadi begitu saja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210219,
					"content": "Sejak dulu aku memang merasa bahwa bebatuan memiliki \"ingatan\". Kadang ingatan ini mengandung kejadian yang terjadi di dekatnya. Aku hanya perlu menyentuhnya dan berkonsentrasi, dan ingatan itu akan muncul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210220
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210220,
					"content": "Keren sekali! Jadi kamu bisa mencari tahu tentang semua yang ada di sekitar sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210221,
					"content": "Tergantung batunya. Sebagian batu memiliki ingatan yang lebih hebat. Lainnya, seperti Iron Ore dan White Iron Ore tidak begitu. Ingatan batu-batu itu kurang jelas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210222
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210222,
					"content": "Cor Lapis dan batu kristal memiliki memori yang lebih kuat. Batu-batu ini mengingat lebih banyak kejadian dengan lebih detail.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210223
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210223,
					"content": "Melihat ingatan bebatuan... sangat menarik. Benar-benar kemampuan yang langka. Paman Dai tidak salah untuk meminta bantuanmu, Tuan Kun Jun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210224
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210224,
					"content": "Haha, aku senang bisa membantu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210225
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210225,
					"content": "Dari apa yang kulihat, sepertinya mereka mengikuti jalur ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210226
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210226,
					"content": "Jalur ini akan membawa kita ke utara, menjauhi tambang ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210227
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210227,
					"content": "Utara... petunjuk baru untuk Paman Dai! Ayo kita catat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1112103,
			"completionStepIds": [
				1112103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
