			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Uncle Dai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111210101,
					"content": "Wuah, tambang ini besar sekali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210102,
					"content": "Ini tempat insiden tersebut terjadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210103
					],
					"speakerTitle": "Uncle Dai"
				},
				{
					"id": 111210103,
					"content": "Enam hari lalu, beberapa dari kami meninggalkan tambang untuk mengurus hal lain. Saat kita kembali, empat orang yang kita tinggalkan di sini sudah menghilang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210104
					],
					"speakerTitle": "Uncle Dai"
				},
				{
					"id": 111210104,
					"content": "Aku memimpin sebuah tim untuk mencari seluruh tambang, tapi tidak menemukan apa pun. Jadi aku memutuskan untuk meminta bantuan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210105
					],
					"speakerTitle": "Uncle Dai"
				},
				{
					"id": 111210105,
					"content": "Jadi ada empat penambang yang hilang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210106
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210106,
					"content": "Betul. Awalnya kami datang bersepuluh. Kami kehilangan Long, Bold Cen, Brave Cen, dan Mao. Semuanya adalah rekan kerjaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210107
					],
					"speakerTitle": "Uncle Dai"
				},
				{
					"id": 111210107,
					"content": "Pekerja di bidang ini biasanya laki-laki muda yang masih kuat. Mungkinkah mereka berempat pergi ke tambang lain?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210108
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210108,
					"content": "Rasanya tidak. Tidak ada tempat beristirahat di dekat sini, dan kita juga tidak melihat tambang lain di perjalanan kemari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210109
					],
					"speakerTitle": "Uncle Dai"
				},
				{
					"id": 111210109,
					"content": "Hmm... tambang ini besar sekali. Apakah kamu benar-benar sudah mencari ke seluruh pelosoknya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210110
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210110,
					"content": "Bawah tanah, atas tanah... semuanya sudah kami telusuri. Kita sudah mencoba melakukan semuanya, kecuali menggali lebih dalam. Mana mungkin empat anak muda bisa menghilang ke dalam bebatuan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210111
					],
					"speakerTitle": "Uncle Dai"
				},
				{
					"id": 111210111,
					"content": "Kita perlu menjelajahinya sendiri sebelum mengambil kesimpulan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210112
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210112,
					"content": "Baiklah, aku akan menunggu di sini, silakan menjelajah sesuka hati. Kalau kalian menemukan petunjuk, segera beri tahu aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Uncle Dai"
				}
			]
		},
		{
			"id": 1112102,
			"completionStepIds": [
				1112102
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
