						],
						"stepId": 1112104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 111210401,
					"content": "Di sini! Apa ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210402,
					"content": "Setumpuk baju dan celana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210403,
					"content": "Barang sehari-hari saja, sepertinya milik Paman Dai dan anak buahnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210404
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210404,
					"content": "Satu, dua, tiga, empat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210405,
					"content": "Hmm... sepertinya pas. Sepuluh baju, sepuluh celana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210406,
					"content": "Ini baju ganti kan? Lihat, sama persis dengan baju Paman Dai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210407,
					"content": "Empat orang itu sudah hilang selama 6 hari tanpa mengganti baju.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210408
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210408,
					"content": "Di sini juga ada beberapa sapu tangan dan sabun... Oh, dan beberapa peralatan kerja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210409,
					"content": "Barang-barang untuk mencuci muka sebelum kerja subuh... peralatan menambang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210410
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210410,
					"content": "Jadi... mereka tidak membawa pergi barang apa pun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210411,
					"content": "Hmm, iya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210412,
						111210413
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210412,
					"content": "Mungkin karena tidak butuh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111210414
					]
				},
				{
					"id": 111210414,
					"content": "Sepertinya tidak mungkin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210415
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210415,
					"content": "Ada empat beliung yang hilang. Sepertinya mereka pergi dengan membawa alat mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210416
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210416,
					"content": "Mereka sempat mengambil alat kerja mereka, tapi tidak mengambil barang sehari-hari? Aneh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210417
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210417,
					"content": "Hmm... untuk apa ya seseorang pergi dengan peralatan kerja mereka, tapi meninggalkan barang-barang pribadi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210418,
					"content": "Satu: Mereka pergi bekerja di dekat sini jadi tidak perlu memindahkan barang-barang mereka. Tapi karena mereka belum kembali sampai sekarang, sepertinya dugaan ini salah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210419
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210419,
					"content": "Atau, dua: Mereka dipaksa pergi dan tidak sempat memikirkan barang-barang mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210420
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210420,
					"content": "Oh...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210421,
					"content": "Maksudmu... mereka diculik?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111210422
					]
				},
				{
					"id": 111210422,
					"content": "Mungkin saja. Tapi kita butuh lebih banyak petunjuk sebelum mengambil kesimpulan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210423
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210423,
					"content": "Kalau mereka tidak pergi atas keinginan sendiri, mungkin mereka dipaksa pergi... Ayo kita catat dan beri tahu Paman Dai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210413,
					"content": "Mungkin saja mereka lupa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111210414
					]
				}
			]
		},
		{
			"id": 1112107,
			"completionStepIds": [
				1112107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112107",
							"2"
						],
						"stepId": 1112107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Uncle Dai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111210701,
					"content": "Kalian sudah kembali! Bagaimana hasil penyelidikan kalian?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210702
					],
					"speakerTitle": "Uncle Dai"
				},
				{
					"id": 111210702,
					"content": "Kami menemukan tiga petunjuk di sekitar sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210703
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210703,
					"content": "Pertama, ada empat alat gali yang hilang, tapi barang sehari-harinya masih lengkap. Ini menunjukkan kalau pekerjamu tidak pergi atas kemauan sendiri, melainkan dipaksa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210704
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210704,
					"content": "Dipaksa?! Tapi... siapa orang yang mau menculik penambang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210705
					],
					"speakerTitle": "Uncle Dai"
				},
				{
					"id": 111210705,
					"content": "Iya, siapa yang mau menculik penambang. Kedua, ternyata ada lima penambang di dalam. Salah satu dari mereka pergi untuk beristirahat. Saat dia bangun, semua rekan kerjanya sudah menghilang tanpa jejak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210706
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210706,
					"content": "Semua yang tetap bekerja hilang. Yang keluar lebih dulu masih aman. Sepertinya kejadiannya terjadi di dalam area tambang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210707
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210707,
					"content": "Setelah kamu bilang begitu, aku ingat Bravo mengatakan kalau dia ingin istirahat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210708
					],
					"speakerTitle": "Uncle Dai"
				},
				{
					"id": 111210708,
					"content": "Tapi bagaimana mungkin bisa seseorang masuk ke dalam tambang dan membawa mereka semua pergi!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210709
					],
					"speakerTitle": "Uncle Dai"
				},
				{
					"id": 111210709,
					"content": "Ini membawaku ke poin ketigaku. Tuan Kun Jun menggunakan... keahliannya... untuk menyimpulkan bahwa ada seorang anak kecil yang membawa pekerjamu pergi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210710
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210710,
					"content": "Anak kecil!? Tapi tidak ada daerah pemukiman di sekitar sini! Tidak mungkin bisa ada anak kecil di area tambang ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210711
					],
					"speakerTitle": "Uncle Dai"
				},
				{
					"id": 111210711,
					"content": "Mungkin terdengar mustahil, tapi itu kesimpulan dari kami. Pekerjamu pergi mengikuti seorang anak kecil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210712,
					"content": "Me—mereka pergi ke mana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210713
					],
					"speakerTitle": "Uncle Dai"
				},
				{
					"id": 111210713,
					"content": "Sepertinya mereka mengikuti jalan ke arah utara, menjauhi tambang ini dan menuju reruntuhan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210714
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210714,
					"content": "Utara! Baiklah, aku akan mengumpulkan orang dan menuju ke sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210715
					],
					"speakerTitle": "Uncle Dai"
				},
				{
					"id": 111210715,
					"content": "Apa kamu perlu bantuan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111210716
					]
				},
				{
					"id": 111210716,
					"content": "Kalian sudah sangat membantu penyelidikan ini, tapi biarkan kami yang membereskannya. Kalau kita segera berangkat sekarang, mungkin kita bisa menyusul mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210717
					],
					"speakerTitle": "Uncle Dai"
				},
				{
					"id": 111210717,
					"content": "Tenang dulu. Insiden ini terjadi enam hari lalu. Meskipun mereka berjalan kaki, harusnya mereka sudah berjalan jauh sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210718
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210718,
					"content": "*huff* Kamu benar... rencana baru. Aku akan memimpin tim pencarian ke daerah pemukiman di arah sana dan bertanya-tanya di sekitar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210719
					],
					"speakerTitle": "Uncle Dai"
				},
				{
					"id": 111210719,
					"content": "Hanya ada sedikit tempat pemukiman untuk bermalam. Kami akan bertanya-tanya dan melihat apa kami bisa mendapatkan sesuatu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210720
					],
					"speakerTitle": "Uncle Dai"
				},
				{
					"id": 111210720,
					"content": "Sementara itu, kalian bisa terus mencari petunjuk. Kalau kita tidak bertemu, ayo bertemu di Wangshu Inn besok malam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210721
					],
					"speakerTitle": "Uncle Dai"
				},
				{
					"id": 111210721,
					"content": "Setuju.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210722
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210722,
					"content": "Oke, aku dan orang-orangku akan segera berangkat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210723
					],
					"speakerTitle": "Uncle Dai"
				},
				{
					"id": 111210723,
					"content": "Jadi... mereka akan bertanya-tanya pada orang di sekitar pemukiman, sedangkan kita lanjut menyelidiki daerah ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210724
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210724,
					"content": "Benar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210725
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210725,
					"content": "Tapi... kan sudah tidak ada petunjuk lagi di tambang... Bukannya lebih baik kita pergi ke utara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210726
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210726,
					"content": "Tunggu... Sepertinya ada satu orang yang kurang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210727
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210727,
					"content": "Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210728,
					"content": "Oh ya, mana Kun Jun? Paimon rasa dia masih sibuk menyelidiki. Ayo kita cari dia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1112108,
			"completionStepIds": [
				1112108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112108",
							"2"
						],
						"stepId": 1112108,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kun Jun"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111210801,
					"content": "Kun Jun! Apa lagi yang kamu cari? Semua petunjuknya kan sudah kita temukan! Ayo pergi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210802,
					"content": "Oh, maaf, aku sedang mencari sesuatu untuk diriku sendiri. Aku mencari sebuah batu berharga yang dikenal sebagai Dragonfall.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210803
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210803,
					"content": "Dragonfall?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210804,
						111210805
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210804,
					"content": "Tidak pernah dengar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111210806
					]
				},
				{
					"id": 111210806,
					"content": "Dragonfall sering digunakan untuk menempa. Untuk apa kamu mencarinya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210807
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210807,
					"content": "Aku... tidak tahu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210808
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210808,
					"content": "Ma—maaf, aku lupa kenapa aku mencarinya... Belakangan ini aku merasa... pikun sekali. Selain nama dan alamatku sendiri, aku kesulitan mengingat hal lainnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210809
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210809,
					"content": "Sebenarnya, selama ini aku merasa... sangat gugup. Rasanya seperti aku melupakan sesuatu yang penting. Benar-benar perasaan yang tidak enak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210810
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210810,
					"content": "Oh, Paimon tahu rasanya! Rasanya seperti melupakan sesuatu tapi tidak tahu apa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210811,
					"content": "Uh... Aku bahkan tidak tahu harus mulai dari mana, selama ini aku terus berkeliling tanpa tujuan. Hari itu saat aku membeli barang di pasar, aku tidak sengaja mendengar suatu pembicaraan. Mereka membicarakan Dragonfall.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210812
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210812,
					"content": "Kedengarannya sangat familier, sepertinya hal yang kulupakan ada hubungannya dengan batu ini... Jadi aku memutuskan untuk mencarinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210813
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210813,
					"content": "Mungkin kalau aku bisa menemukan beberapa, aku bisa mengingat apa yang harus kulakukan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210814
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210814,
					"content": "Ternyata begitu... Baiklah, kalau sempat, aku akan membantumu mencarinya di perjalanan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210815
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210815,
					"content": "Benarkah? Oh, terima kasih banyak Tuan Zhongli! Kamu baik sekali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210816
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210816,
					"content": "Jangan dipikirkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210817
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210817,
					"content": "Apa kita sebaiknya berangkat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210818
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210818,
					"content": "Mengarah ke utara dari The Chasm, kita akan sampai ke Lingju Pass. Kalau mereka memang melewati jalan ini, harusnya kita bisa menemukan jejaknya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210819
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210819,
					"content": "Baguslah! Ayo kita coba!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210805,
					"content": "Bukan sesuatu yang bisa kupahami.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111210806
					]
				}
			]
