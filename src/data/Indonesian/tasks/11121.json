				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bravo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111210301,
					"content": "Permisi Tuan, apakah kamu salah satu pekerja di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210302
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210302,
					"content": "Ah! Benar, benar! Kamu pasti datang untuk menyelidiki orang yang hilang. Tolong temukan mereka!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210303
					],
					"speakerTitle": "Bravo"
				},
				{
					"id": 111210303,
					"content": "Aku... tidak tahu apa yang terjadi. Cuacanya mendung waktu itu, dan mandor kami pergi dengan beberapa orang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210304
					],
					"speakerTitle": "Bravo"
				},
				{
					"id": 111210304,
					"content": "Aku tinggal di dalam bersama empat orang lainnya. Setelah itu aku ingin beristirahat... sebentar saja kok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210305
					],
					"speakerTitle": "Bravo"
				},
				{
					"id": 111210305,
					"content": "Aku ketiduran di tenda paling dalam. Saat aku bangun, mereka semua hilang! Padahal aku baru saja ngobrol dengan mereka... lalu mereka hilang begitu saja...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210306
					],
					"speakerTitle": "Bravo"
				},
				{
					"id": 111210306,
					"content": "Jangan-jangan... selanjutnya aku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210307
					],
					"speakerTitle": "Bravo"
				},
				{
					"id": 111210307,
					"content": "Jadi orang-orang yang sedang bekerja tiba-tiba menghilang, dan seseorang selamat karena tertidur di tenda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210308
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210308,
					"content": "Mungkin terjadi kecelakaan di area kerja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210309
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210309,
					"content": "Ah! Seram sekali pikiranmu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210310,
					"content": "Kecelakaan di tempat kerja... Ayo kita catat dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1112104,
			"completionStepIds": [
				1112104
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112104",
