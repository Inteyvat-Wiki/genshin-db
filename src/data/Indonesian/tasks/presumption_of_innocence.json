					"nextDialogs": [
						200230303
					]
				},
				{
					"id": 200230303,
					"content": "Dia sudah minum banyak sekali hari ini. Lihat, ini adalah tagihannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230304
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 200230304,
					"content": "Jika terus begini, kami harus memanggil Eury.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230305
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 200230305,
					"content": "Mau pinjam? Bukannya tidak boleh, tapi apa yang ingin kamu lakukan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Charles"
