						200230902
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230902,
					"content": "Nimrod sudah berhenti minum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200230903
					]
				},
				{
					"id": 200230903,
					"content": "Berhenti minum-minum? Benarkah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230904
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230904,
					"content": "Sayangnya, tidak ada bukti...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200230905
					]
				},
				{
					"id": 200230905,
					"content": "Tidak masalah, asalkan kamu tidak menemukan bukti dia minum-minum, aku jadi lebih yakin kalau dia memang benar-benar bertobat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230906
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230906,
					"content": "Bila tidak ada bukti, aku selalu percaya kalau setiap orang tidak bersalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230907
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230907,
					"content": "Tapi selalu saja ada segunung bukti untuk membuktikan bahwa mereka berdosa... Lucu sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230908
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230908,
					"content": "Terimalah ini sebagai tanda terima kasihku. Aku harap aku tidak akan pernah melihat kalian datang untuk mengaku dosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Victoria"
