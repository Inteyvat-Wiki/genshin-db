			"dialogs": [
				{
					"id": 200230201,
					"content": "Hahaha, inilah yang aku nantikan setiap hari...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230202
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200230202,
					"content": "Bukannya kamu bilang mau berhenti minum?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200230203
					]
				},
				{
					"id": 200230203,
					"content": "Aah?! Kamu membuatku kaget... Aku pikir istriku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230204
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200230204,
					"content": "Minum sedikit tidak apa-apa lah~ Aku sudah bekerja sangat keras seharian ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230205
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200230205,
					"content": "Baiklah, baiklah, aku hanya minum sedikit saja lalu pulang. Eury juga mungkin sudah selesai berbelanja sekarang ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nimrod"
				}
			]
		},
