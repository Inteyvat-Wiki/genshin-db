			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Victoria"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200230101,
					"content": "Apa dia benar-benar akan bertobat kali ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230102
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230102,
					"content": "Bertobat dari apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200230103
					]
				},
				{
					"id": 200230103,
					"content": "Setiap hari, banyak orang datang ke sini untuk mengakui dosa mereka dan meminta pengampunan dari para dewa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230104
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230104,
					"content": "Tapi jika kamu hanya bicara namun tidak melakukannya, bukankah semuanya menjadi sia-sia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230105
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230105,
					"content": "Sebagai contoh, lihat saja Nimrod. Dia datang ke sini berkali-kali untuk mengakui dosanya karena terlalu banyak minum alkohol, tapi dia tidak pernah berubah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230106
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230106,
					"content": "Jika kamu ada waktu, tolong bantu aku untuk melihat kondisinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230107,
						200230110
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230107,
					"content": "Baiklah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200230108
					]
				},
				{
					"id": 200230108,
					"content": "Oh ya, jika dia minum lagi, tolong bawa beberapa buktinya ke sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230109
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230109,
					"content": "Terkadang, seseorang yang telah melakukan kesalahan berkali-kali membutuhkan sedikit pelajaran agar bisa diingat oleh mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230110,
					"content": "Minum alkohol itu sebuah dosa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200230111
					]
				},
				{
					"id": 200230111,
					"content": "Minum alkohol bukan dosa, tapi akan menjadi dosa jika kamu membuat orang lain menderita karena kebiasaanmu meminum alkohol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230112
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230112,
					"content": "Jika semua orang berperilaku tidak bermoral seperti dia, suatu hari Mondstadt akan jatuh dalam situasi yang menyedihkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230113
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230113,
					"content": "Jadi kita harus menghancurkan setiap benih dosa yang muncul. Baiklah, cepatlah lihat kondisi Nimrod sekarang ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Victoria"
				}
			]
		},
