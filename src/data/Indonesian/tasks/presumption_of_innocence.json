					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230404
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230404,
					"content": "Orang-orang akan lupa pada apa yang terjadi di masa lalu, kecuali jika ada pelajaran membuatnya benar-benar menderita...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230405
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230405,
					"content": "Baiklah, terimalah ini sebagai tanda terima kasihku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230406
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230406,
					"content": "Sedangkan untuk masalah Nimrod... Aku akan memikirkannya baik-baik.",
