			"dialogs": [
				{
					"id": 750670101,
					"content": "Makhluk-makhluk ini memang kuat sekali ... bisa dibilang mereka ini bukan manusia. Halo, para pejuang pemberani ... Aku Quenin dari tim petualang. Tugasku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750670102
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750670102,
					"content": "Tugasku ... adalah membasmi para monster ini. Iya, aku memang pejuang dari tim petualang. Berhati-hatilah, pejuang pemberani ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750670103
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750670103,
					"content": "Para monster ini ... mereka benar-benar licik. Mereka bahkan bisa menyamar menjadi sosok yang berbeda-beda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750670104
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750670104,
					"content": "Tiap malam sebelum aku tertidur aku bisa dengar ... suara mereka yang bersembunyi di reruntuhan kuno ini. Itulah sebabnya ... aku tidak bisa tidur di kemah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750670105
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750670105,
					"content": "Tempat ini dipenuhi oleh monster-monster tersebut. Kamu juga ... berhati-hatilah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quenin"
				}
			]
		},
