			"dialogs": [
				{
					"id": 30230401,
					"content": "Beberapa hari terakhir ini adalah pekerjaan tersulit yang pernah aku terima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230402
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30230402,
					"content": "Dan tidak ada sedikit pun Mora yang kudapatkan ... Tidak bisa kupercaya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230403
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30230403,
					"content": "Lihat sisi positifnya dong, Dehya! Mungkin habis ini kita bakal dapat hadiah yang geeede banget!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30230404,
					"content": "Benar juga. Hei, kalau kamu besok pagi bangun terus tiba-tiba ada uang yang tidak bisa habis dipakai, mau kamu apain?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230405
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30230405,
					"content": "Paimon mau beli camilan enak yang super duper banyak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30230406,
					"content": "Segitu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230407
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30230407,
					"content": "Ummm ... terus ... beli minuman lezat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30230408,
					"content": "Hahaha, imut sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230409
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30230409,
					"content": "Untuk fantasi indah ini ... Kalau ada peluang terjadi, aku akan berusaha sebaiknya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230410
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30230410,
					"content": "Semoga semua yang kita lakukan dari sekarang bisa mengubah dunia ini menjadi lebih baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dehya"
