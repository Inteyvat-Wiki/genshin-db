				"points": []
			},
			"dialogs": [
				{
					"id": 30230201,
					"content": "Jangan buru-buru. Ini masalah besar, perencanaan dan persiapan untuk apa yang sedang menanti kita pasti akan memakan beberapa waktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230202
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30230202,
					"content": "Jangan buru-buru. Kita harus pastikan rencananya seefektif mungkin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230203
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30230203,
					"content": "Dia mulai baca lagi! Woi! Kamu dengar gak sih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30230204,
					"content": "Mau aku pinjamkan buku biar kamu punya bahan bacaan juga?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230205
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30230205,
					"content": "Enggak perlu, terima kasih! Bukumu bukan selera Paimon ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30230206,
					"content": "Aku cuma bercanda saja kok. Aku tahu buku milikku jauh terlalu sulit untukmu, dan aku memang tidak berencana untuk pinjamkan kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230207
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30230207,
					"content": "Ah ...! Menyebalkan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
