			"dialogs": [
				{
					"id": 30230301,
					"content": "Kalau ada yang bisa aku lakukan, silakan beri tahu aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230302
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 30230302,
					"content": "Meski aku tidak bisa meninggalkan Desa Aaru, aku jadi merasa ... perasaanku berkecamuk saat melihat tatapan mata kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230303
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 30230303,
					"content": "Aku tidak pernah merasa sesemangat ini waktu bertarung sendirian dulu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230304
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 30230304,
					"content": "Aku rasa, ini adalah kekuatan dari persahabatan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Candace"
				}
			]
		},
