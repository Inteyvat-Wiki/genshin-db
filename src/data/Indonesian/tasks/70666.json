			"dialogs": [
				{
					"id": 706660201,
					"content": "Meong! (Kamu benar-benar hebat! Selamat, kamu sudah menyelesaikan Ujian Tantangan Ascension! Kamu sekarang adalah Pemain Tingkat Tinggi!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706660202
					],
					"speakerTitle": "Prince"
				},
				{
					"id": 706660202,
					"content": "Meong! (Cuma perlu satu kali main saja sudah bisa jadi Pemain Tingkat Tinggi? Yah, karena kebanyakan orang cuma bermain santai saja, mereka tidak terlalu anggap serius ....)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706660203
					],
					"speakerTitle": "Prince"
				},
				{
					"id": 706660203,
					"content": "(Yang berarti, tidak banyak orang yang serius soal permainan ini. Tapi meskipun hanya untuk bersenang-senang saja, tetap perlu dedikasi yang tinggi juga.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706660204
					],
					"speakerTitle": "Prince"
				},
				{
					"id": 706660204,
					"content": "Meong! (Ah, iya! Karena sekarang kamu sudah kuakui, kamu juga boleh menantang mereka-mereka yang ada di dalam Tavern. Hmm ... seharusnya mereka akan menyambutmu.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706660205
					],
					"speakerTitle": "Prince"
				},
				{
					"id": 706660205,
					"content": "Mereka-mereka?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706660206
					]
				},
				{
					"id": 706660206,
					"content": "Meong. (Benar. Tentu saja, mereka itu kucing di dalam Tavern, sama kayak aku. Tapi jangan pernah anggap remeh mereka.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706660207
					],
					"speakerTitle": "Prince"
				},
				{
					"id": 706660207,
					"content": "Meong~ (Kalau waktunya sudah tiba, Shuyun akan ambilkan kartu untuk mereka. Baiklah. Sebagai bagian tradisi, ada satu lagi yang harus aku katakan!)",
					"roleType": "TALK_ROLE_NPC",
