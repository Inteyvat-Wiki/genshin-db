			"trigger": {
				"objectNames": [
					"Xinyan",
					"Blazing Heart"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400700401,
					"content": "Apa kamu tahu cara mengeruk gunung-gunung di pulau itu? Pulau itu sudah kehilangan tumbuhan dan airnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700402
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400700402,
					"content": "Aku kenal orang yang bisa membantu untuk masalah ini. Rekanku, Frozen Soul, tinggal di lantai atas, coba cari dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Blazing Heart"
				}
			]
		},
		{
			"id": 4007005,
			"completionStepIds": [
				4007005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007005",
							"2"
						],
						"stepId": 4007005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Frozen Soul",
					"Xinyan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400700501,
					"content": "Kalian siapa? Kenapa datang mencariku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700502
					],
					"speakerTitle": "Frozen Soul"
				},
				{
					"id": 400700502,
					"content": "Halo, senang bertemu denganmu. Kami ingin pinjam kekuatanmu untuk mengeruk gunung-gunung di pulau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700503
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400700503,
					"content": "Gunung? Hmm ... Jadi kalian juga mau jadi musisi hebat ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700504
					],
					"speakerTitle": "Frozen Soul"
				},
				{
					"id": 400700504,
					"content": "Oh? Jadi begitu ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400700505,
					"content": "Betul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700506
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400700506,
					"content": "Kalau begitu, kita sejalan. Meski kekuatanku mungkin tidak seberapa, tapi aku merasa wajib membagikan kekuatanku kepada kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700507
					],
					"speakerTitle": "Frozen Soul"
				},
				{
					"id": 400700507,
					"content": "Ambil kelopakku dan tanamkan di ujung persimpangan melodi dan gunung yang terkubur akan muncul kembali bersamaan dengan suara melodi ini. Selama ada musik, kehidupan akan mengalir ke setiap jengkal dunia ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700508
					],
					"speakerTitle": "Frozen Soul"
				},
				{
					"id": 400700508,
					"content": "... Terima kasih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinyan"
				}
			]
		},
		{
			"id": 4007010,
			"completionStepIds": [
				4007010
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007010",
							"2"
						],
						"stepId": 4007010,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xinyan",
					"Mona",
					"Kaedehara Kazuha"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400701001,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701002
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701002,
					"content": "Akhirnya saatnya sudah tiba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701003
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701003,
					"content": "Semuanya, aku pernah berharap untuk bisa mengadakan konser dengan orang yang tidak pernah terduga oleh semua orang. Dan hari ini, aku sudah menemukan jawabannya di pulau ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701004
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701004,
					"content": "Entah bagaimana penampilan dan nama orang yang pernah membuat pulau ini menjadi alat musik raksasa bertahun-tahun lalu, tapi satu hal yang pasti, dia adalah salah satu musisi terbesar dari Teyvat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701005
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701005,
					"content": "Aku tidak pernah menyangka bahwa aku akan bisa melihat alat musik seperti ini. Dan yang lebih tak terduga lagi, kita bisa memainkannya saat air pasang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701006
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701006,
					"content": "Kamu bakal main musik rock 'n' roll?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400701007
					]
				},
				{
					"id": 400701007,
					"content": "Tidak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701008
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701008,
					"content": "Musik adalah hadiah untuk sebuah jiwa, jadi ... Aku akan mainkan musik yang lebih cocok untuk dimainkan bersama penduduk lokal di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701009
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701009,
					"content": "Aku tidak akan main musik rock 'n' roll hari ini. Tapi, aku akan tunjukkan sesuatu yang baru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701010
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701010,
					"content": "Huff.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701011
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701011,
					"content": "Bagaimana? Lumayan, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701012
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701012,
					"content": "Luar biasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701013
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701013,
					"content": "Aku tidak pernah dengar konser seperti ini sebelumnya, menarik sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701014
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400701014,
					"content": "Dan elegan banget loh! Paimon enggak tahu gimana jabarinnya ... Tapi, intinya unik banget deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701015,
						400701016
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400701015,
					"content": "Pertunjukan yang menakjubkan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400701017
					]
				},
				{
					"id": 400701017,
					"content": "Hehe, terima kasih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701018
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701018,
					"content": "Dan sekarang bisa kukatakan bahwa harapanku sudah terwujud.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701019
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701019,
					"content": "Ada lagi yang mau kamu lakukan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701020
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701020,
					"content": "Tidak ada lagi. Malam ini aku harusnya bisa tidur nyenyak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701021
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701021,
					"content": "Oh ya, apa kalian semua punya waktu kosong? Aku punya ide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701022
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400701022,
					"content": "Aku ingin pergi lagi ke kemah Fatui dan memeriksa kondisi di sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701023
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400701023,
					"content": "Oh? Jadi ternyata kalian juga sudah menemukan kemah Fatui ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701024
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701024,
					"content": "Tunggu, kamu juga sudah tahu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701025
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400701025,
					"content": "Tentu saja, aku ini jenius astrologi. Dan bukannya aku sudah bilang kalau kaca ramalanku sudah agak pulih? Aku bisa merasakan apa yang terjadi di sini melalui ramalanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701026
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701026,
					"content": "Eh, di sini juga ada Fatui itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701027
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701027,
					"content": "Benar. Saat berpisah dengan Fischl hari ini, aku juga sudah kasih tahu ke Fischl, kalau dia bertemu dengan Fatui, dia harus sembunyi supaya aman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701028
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701028,
					"content": "Ternyata begitu, kalau begitu kami juga akan jujur saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701029
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400701029,
					"content": "Kamu memberi tahu semua orang tentang kemah Fatui dan mesin yang terlihat aneh yang kamu temukan saat tiba ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400701030
					]
				},
				{
					"id": 400701030,
					"content": "Sebuah perangkat aneh, terus ada Fatui yang linglung ... Maksud kalian, ini ada hubungannya dengan alam fantasi yang terjadi belakangan ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701031
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701031,
					"content": "Tidak bisa kupastikan. Tapi aku rasa, kedua hal ini seharusnya kurang lebih berhubungan meski mungkin cuma sedikit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701032
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400701032,
					"content": "Masuk akal, kalau begitu ayo periksa kemahnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701016,
					"content": "Pertunjukan yang cetar membahana.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400701017
					]
				}
			]
		},
		{
			"id": 4007016,
			"completionStepIds": [
				4007016
