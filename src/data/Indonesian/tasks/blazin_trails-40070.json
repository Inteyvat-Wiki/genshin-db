				"points": []
			},
			"dialogs": [
				{
					"id": 400701901,
					"content": "Kami telah menanam kelopaknya, apa kamu bisa merasakan sesuatu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701902
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701902,
					"content": "Ya ... Ada. Mataharinya cerah, lautnya bercahaya indah seperti permata, ombak lautnya menghantam pasir putih, butiran pasir mengalirnya ke laut dan didorong kembali ke tepian oleh ombak ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701903
					],
					"speakerTitle": "Frozen Soul"
				},
				{
					"id": 400701903,
					"content": "Ada burung laut di bebatuan, mematuk ringan, menyanyikan nada yang berirama ♪ dum dum dum ♪ ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701904
					],
					"speakerTitle": "Frozen Soul"
				},
				{
					"id": 400701904,
					"content": "Itulah musik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701905
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701905,
					"content": "Memang benar, musik. Pulau ini sudah dibuat jadi alat musik besar-besaran. Karena kamu seorang musisi, kamu harus bisa mencari tahu apa arti tersembunyi di baliknya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701906
					],
					"speakerTitle": "Frozen Soul"
				},
				{
					"id": 400701906,
					"content": "Bermain musik menggunakan angin laut, ombak, dan pasang surut, hal paling romantis yang bisa ada di dunia ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701907
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701907,
					"content": "Ayo, semuanya. Saatnya kalian mendengarkan konserku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinyan"
				}
			]
		}
	]
