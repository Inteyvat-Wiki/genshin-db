			},
			"dialogs": [
				{
					"id": 400701801,
					"content": "Kita sudah melakukan semua yang kita bisa, tapi gimana kita menangani dua gunung terakhir itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400701802,
					"content": "Coba pikirkan lagi, pasti ada yang bisa kita lakukan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701803
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701803,
					"content": "Aku baru mengamati baik-baik, kebanyakan gunung di pulau ini memiliki jalur air dan tanaman, sistem inilah yang menghubungkan jalur air dan tanamannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701804
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701804,
					"content": "Tapi sekarang gunungnya sudah runtuh, jadi tanaman dan jalur air tidak dapat terhubung lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701805
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701805,
					"content": "Kalau kita dapat menghubungkannya untuk membentuk alat musik raksasa yang dijelaskan dalam catatan Albedo, kita dapat menggunakan pulau itu sebagai unit musik untuk bermain musik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701806
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400701806,
					"content": "Ya, jadi untuk mencapai tujuanku, aku harus melakukannya ... Aku akan berkonsultasi dengan bunga, seharusnya bunga tahu caranya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinyan"
				}
			]
		},
		{
			"id": 4007019,
			"completionStepIds": [
				4007019
			],
