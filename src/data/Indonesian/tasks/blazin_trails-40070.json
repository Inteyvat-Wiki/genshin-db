				"points": []
			},
			"dialogs": [
				{
					"id": 400701601,
					"content": "Kok aneh ya di perjalanan kita ke sini, cuma ada monster biasa, terus enggak ada Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400701602,
					"content": "Aneh, jejak perkemahan dan perangkat masih ada di sini, tapi tidak ada siapa pun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701603
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701603,
					"content": "(Mesin ini pasti ada hubungannya dengan alam fantasi itu. Memang sudah rusak, tapi mungkin memang mesin ini sendiri penyebabnya.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400701604
					]
				},
				{
					"id": 400701604,
					"content": "(Jika perangkat ini bisa membuat orang berhalusinasi, lalu kenapa mereka menghilang? Atau ada rahasia lainnya?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400701605
					]
				},
				{
					"id": 400701605,
					"content": "(Kita tidak bisa menemukan siapa pun, karena mereka menghilang, atau mereka sedang bersembunyi?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400701606
					]
				},
				{
					"id": 400701606,
					"content": "Ya sudah, ayo coba kita lakukan ramalan dan cari tahu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701607
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701607,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701608
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701608,
					"content": "Hmmm? Ini ... sejenis aliran kekuatan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701609
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701609,
					"content": "Maaf teman-teman, sepertinya aku tidak bisa melacak jejak Fatui, air ramalanku jadi keruh lagi, tapi aku dapat merasakan suatu kekuatan yang sedang berkumpul dan membentuk sebuah wujud.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701610
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701610,
					"content": "Tujuannya adalah ... pulau kecil di sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701611
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701611,
					"content": "Kali ini berkaitan dengan alam fantasi siapa ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701612
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701612,
					"content": "Hmmm ... Ayo kita ke sana dan cari tahu, mungkin akan ada petunjuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
