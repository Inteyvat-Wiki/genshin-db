			"dialogs": [
				{
					"id": 400701701,
					"content": "Sudah sampai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701702
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400701702,
					"content": "Eh? Fischl?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701703
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701703,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701704
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400701704,
					"content": "Benar dia! Fischl ...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400701705,
					"content": "Huft, akhirnya datang juga, pengikut kecilku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701706
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400701706,
					"content": "Oh, lama tidak berjumpa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701707
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400701707,
					"content": "Belum selama itu, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701708
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701708,
					"content": "Ah ... Mein Fräulein dan aku merasakan sebuah aura, lalu kami langsung ke sini untuk menunggu kedatangan kalian. Tidak disangka, kalian ... datang lebih cepat dari yang dibayangkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701709
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400701709,
					"content": "Oz kok kayak yang gugup ya? Atau cuma perasaan Paimon saja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400701710,
					"content": "Immernachtreich segera tiba, aku masih harus menyiapkan upacara pengudusan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701711
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400701711,
					"content": "Mein Fräulein, apa Anda yakin Anda ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701712
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400701712,
					"content": "Oz, aku bisa sendiri. Kalau kamu takut dengan kegelapan malam yang mengganggu, maka mundurlah ke tempat yang terang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701713
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400701713,
					"content": "Mein Fräulein, bagaimana mungkin Anda berkata seperti ini! Saya adalah pengawal Anda, mata Anda, tidak mungkin saya meninggalkan Anda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701714
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400701714,
					"content": "... Jangan terus menatapku! Pokoknya, aku tidak punya waktu untuk menjelaskan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701715
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400701715,
					"content": "Mein Fräulein, Anda ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701716
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400701716,
					"content": "Saya mohon maaf, suasana hati Mein Fräulein sedang jelek, tolong jangan disimpan di hati. Saya juga minta izin untuk undur diri dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701717
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400701717,
					"content": "Haha, ternyata perasaan hatimu belum membaik meski sudah lama meninggalkan tim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701718
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701718,
					"content": "Waktu aku melihat Fischl, aku rasa alam fantasi yang terbentuk di area ini pasti berhubungan dengannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701719
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701719,
					"content": "Hmmm ... Saat mendekati alam fantasi yang berhubungan denganku, aku sedikit banyak bisa merasakan aura yang familier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701720
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400701720,
					"content": "Aku juga. Meski memang tidak masuk akal, aku rasa sesuatu yang menarik akan segera terjadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701721
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701721,
					"content": "Ya ... Fischl dan Oz bisa merasakan sesuatu, berarti firasat ini akan menjadi kenyataan ... Fischl mungkin jadi cemas karena tidak ingin menghadapi alam fantasinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701722
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701722,
					"content": "Kenapa ya ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701723
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400701723,
					"content": "Mungkin, ada beberapa hal tersembunyi dalam alam fantasinya yang ingin dia rahasiakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701724
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701724,
					"content": "Semuanya, ayo kita istirahat dulu sampai alam fantasinya muncul. Lalu kita akan bisa tahu jawaban dari semua ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
