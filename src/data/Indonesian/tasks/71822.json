					"Soraya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718220101,
					"content": "Mt. Tianheng... Skybracer... hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220102
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220102,
					"content": "Apa yang kamu pikirkan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718220103
					]
				},
				{
					"id": 718220103,
					"content": "Ah, aku sedang meneliti sejarah dan legenda dari Lantern Rite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220104
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220104,
					"content": "Aku dengar bahwa Lentera Mingxiao tahun ini mengambil model seorang Adeptus yang bernama Skybracer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220105
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220105,
					"content": "Dari legenda yang berhasil kukumpulkan, Adeptus ini juga bertempur bersama Rex Lapis untuk waktu yang lama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220106
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220106,
					"content": "Namun waktu tepatnya dan juga musuh yang mereka hadapi itu berbeda-beda dari satu sumber dengan sumber lain...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220107
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220107,
					"content": "Tapi semua sumber menunjukkan bahwa Skybracer sudah meninggal, dan juga disebutkan bahwa Adeptus ini dulu pernah menahan Mt. Tianheng dengan tanduknya sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220108
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220108,
					"content": "Jadi, aku datang ke Mt. Tianheng untuk melihatnya sendiri, kupikir jika aku beruntung mungkin aku bisa menemukan sesuatu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220109
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220109,
					"content": "Namun ternyata banyak monster di Mt. Tianheng. Setelah memastikan lokasi situs untuk penyelidikanku, aku menemukan bahwa banyak sekali monster di sini sehingga sangat tidak mungkin untuk dilewati...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220110
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220110,
					"content": "Pengembara, jika kamu bersedia, maukah kamu menolongku untuk menginvestigasi dan mengambil beberapa sampel tanah di sana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220111
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220111,
					"content": "Sampel... tanah?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718220112
					]
				},
				{
					"id": 718220112,
					"content": "Ah ... itu istilah yang kami pakai di Akademiya, maksudnya adalah mengambil tanah yang ada di area tersebut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220113
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220113,
					"content": "Legenda lokal mengatakan bahwa Skybracer menahan Mt. Tianheng dengan tanduknya sendiri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220114
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220114,
					"content": "Dari sisi akademis, sangat masuk akal jika tanah di sini sepertinya punya komposisi yang berbeda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220115
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220115,
					"content": "Jadi tolonglah, bantulah aku dengan pergi ke sana dan ambil beberapa sampel tanah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				}
			]
		},
		{
			"id": 7182202,
