					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Soraya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718220301,
					"content": "Apa kamu membawa sampelnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220302
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220302,
					"content": "Aku sudah kembali.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718220303
					]
				},
				{
					"id": 718220303,
					"content": "Wow, terima kasih banyak, coba kulihat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220304
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220304,
					"content": "...Hmm, sepertinya tidak ada yang aneh dengan tanah di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220305
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220305,
					"content": "Memangnya kamu berharap menemukan apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718220306
					]
				},
				{
					"id": 718220306,
					"content": "Legenda mengatakan bahwa Skybracer menggunakan tanduknya yang kuat untuk melindungi Pelabuhan Liyue dengan menahan agar Mt. Tianheng tidak longsor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220307
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220307,
					"content": "Aku kira mungkin aku bisa mendapatkan beberapa serpihan dari tanduk tersebut...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220308
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220308,
					"content": "Seperti yang kukira, legenda memang hanya sekadar legenda... Atau mungkin karena waktu sudah berlalu begitu lama sejak pertarungan sengit tersebut sehingga semua jejaknya sudah hilang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220309
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220309,
					"content": "Tapi bagaimana pun juga, mengambil sampel tanah di sini, hasilnya tidak buruk juga...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220310
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220310,
					"content": "Pengembara, apa kamu bisa menemaniku sebentar? Aku mau naik ke sana, seharusnya tidak terlalu jauh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220311,
						718220312
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220311,
					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718220313
					]
				},
				{
					"id": 718220313,
					"content": "Kali ini... Aku ingin pergi ke tempat yang tinggi untuk melihat Mt. Tianheng dari atas ke bawah dan mengamati medan gunung ini dari atas sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220314
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220314,
					"content": "Legenda mengatakan bahwa Rex Lapis dan beberapa Adeptus turut serta dalam pertarungan tersebut, dan hampir menyebabkan Mt. Tianheng longsor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220315
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220315,
					"content": "Jika pertarungan tersebut memang benar-benar sesengit itu, mungkin kita bisa menyimpulkan beberapa hal dari mengamati medannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220312,
					"content": "Apa yang selama ini kamu cari?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718220313
					]
				}
			]
		},
		{
