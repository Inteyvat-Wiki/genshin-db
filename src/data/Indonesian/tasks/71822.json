				"objectNames": [
					"Soraya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718220601,
					"content": "Akhirnya sampai juga di sini... jalanannya cukup sulit, dan ada begitu banyak monster...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220602
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220602,
					"content": "Sepertinya di sini juga tidak ada yang spesial...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220603
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220603,
					"content": "Eh? Ada sesuatu di pohon ini... oh, ini Lentera Xiao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220604
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220604,
					"content": "Kenapa ada Lentera Xiao di sini? Apa ada seseorang yang datang ke sini untuk memberi penghormatan kepada Adeptus yang telah gugur?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220605
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220605,
					"content": "Ada sesuatu yang tertulis di sini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220606
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220606,
					"content": "\"Semoga seluruh dunia selalu damai.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220607,
						718220608
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220607,
					"content": "Benar-benar harapan yang luar biasa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718220609
					]
				},
				{
					"id": 718220609,
					"content": "Benar. Tapi permohonan ini... bagaimana mengatakannya ya... benar-benar luar biasa. Ini sepertinya bukan sebuah permohonan, bukan juga sebuah penghormatan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220610
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220610,
					"content": "Lebih seperti kepada permohonan dari salah satu Adeptus yang ada di dalam legenda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220611
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220611,
					"content": "Aku jadi penasaran, siapa yang menuliskan harapan seperti ini di Lentera Xiao? Aneh sekali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220612
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220612,
					"content": "Bagaimana pun juga, sepertinya setidaknya ada seseorang yang ingat untuk menaruh Lentera Xiao di sini. Para Adeptus pasti akan sangat senang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220613
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220613,
					"content": "Terima kasih karena telah menemaniku sampai ke sini. Aku ingin berada di sini dulu untuk meneliti lebih lanjut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220614
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220614,
					"content": "Ah, benar juga. Ini untukmu. Anggap saja ini tanda terima kasihku padamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220615
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220615,
					"content": "*huff* Liyue mempunyai banyak sekali legenda, namun penelitianku belum ada kemajuan sama sekali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220608,
					"content": "Sepertinya orang ini bukan ke sini untuk memberi penghormatan ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718220609
					]
				}
			]
		}
	]
}