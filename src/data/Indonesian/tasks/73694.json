				"points": []
			},
			"dialogs": [
				{
					"id": 736940101,
					"content": "Ugh, kenapa pada kelihatan capek ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736940102
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736940102,
					"content": "Kamu ngadain acara di sini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736940103
					]
				},
				{
					"id": 736940103,
					"content": "Kamu ... Pengembara, kan? Haha! Aku sudah lama mau bertemu denganmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736940104
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736940104,
					"content": "Betul. Kali ini Vahumana mengadakan permainan bertema arkeologi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736940105
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736940105,
					"content": "Kami punya banyak peneliti yang mempelajari sejarah di Darshan kami. Jadi pekerjaan arkeologi, terutama yang harus dilakukan langsung di lapangan, sering kali tidak bisa dihindari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736940106
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736940106,
					"content": "Sebentar, sebentar, jangan khawatir. Kami tidak akan membuatmu melakukannya sendiri. Acara ini cuma simulasi dari kegiatan arkeologi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736940107
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736940107,
					"content": "Kami sudah mengubur berbagai replika benda bersejarah di sekitar Kota Sumeru, di lokasi yang sementara ini kami beri nama \"Situs Arkeologi\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736940108
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736940108,
					"content": "Mereka yang berpartisipasi cuma perlu bawa detektor buatan kami ke situsnya dan gali replika yang terkubur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736940109
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736940109,
					"content": "Untunglah murid Darshan lain mau membuat wadah dan detektornya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736940110
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736940110,
					"content": "Bagaimana, Pengembara? Tertarik tidak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736940111,
						736940112
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736940111,
					"content": "Kedengarannya tidak susah-susah amat ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736940113
					]
				},
				{
					"id": 736940113,
					"content": "Hahaha, bagus! Nih, silakan ambil detektornya. Aku tandai Situs Arkeologi di buku <color=#00E1FFFF>Panduan Arkeologi</color> punyamu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736940114
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736940114,
					"content": "Oke, itu saja. Kalau begitu, selamat menikmati keseruan arkeologi, Pengembara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736940115
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736940115,
					"content": "Kalau kamu sudah menemukan semua replika reliknya, jangan lupa kembali ke sini untuk mengambil hadiahnya, ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736940116
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736940116,
					"content": "Ikuti detektor dan temukan replikanya. Kami sudah bagi replika menurut jenisnya ke situs-situs yang berbeda mengikuti elemennya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736940117
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736940117,
					"content": "Tapi ... detektor ini aslinya untuk survei elemen. Memang sudah kami modifikasi, tapi pasti masih akan terpengaruh elemen tertentu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736940118
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736940118,
					"content": "Intinya, gali semua replika, dan hadiah menarik sudah menanti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736940112,
					"content": "Boleh coba deh ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736940113
					]
				}
			]
		}
	]
}