			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Soraya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210042201,
					"content": "Mungkin ini hanya hipotesis belaka, tapi aku yakin bahwa empat reruntuhan berhubungan dengan makna sebenarnya dari masing-masing Empat Perintah Guizhong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042202
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042202,
					"content": "Tepat dengan peran reruntuhan yang sebenarnya, yah, itu persoalan lain lagi. Tapi... aku tidak memiliki energi sebanyak itu untuk menguji setiap hipotesisku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042203
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042203,
					"content": "Tetapi kalau aku terus memikirkannya, sepertinya juga tidak akan ada ide apa pun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				}
			]
		},
