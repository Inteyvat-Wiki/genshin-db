			"dialogs": [
				{
					"id": 210040901,
					"content": "Sampai jumpa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210040902
					]
				},
				{
					"id": 210040902,
					"content": "Sudah mau pergi? Kalau ada cerita yang menarik, jangan lupa pulang dan ceritakan padaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				}
			]
		},
		{
			"id": 2100420,
			"completionStepIds": [
				2100420
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2100420",
							"2"
						],
						"stepId": 2100420,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Soraya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210042001,
					"content": "Bahkan dewa pun, juga tidak bisa menghindari takdir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042002
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042002,
					"content": "Aku menemukan empat petunjuk di empat reruntuhan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210042003
					]
				},
				{
					"id": 210042003,
					"content": "Empat reruntuhan, empat petunjuk... Pas sekali dengan Empat Perintah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042004
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042004,
					"content": "Masing-masing petunjuk ini menguraikan makna dari Empat Perintah Guizhong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042005
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042005,
					"content": "Untuk menafsirkannya dengan benar, teks asli Empat Perintah Guizhong adalah kuncinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042006
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042006,
					"content": "Mungkin kelima paragraf ini harus digabung — tapi bagaimana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042007
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042007,
					"content": "\"Titik Pertemuan...\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210042008
					]
				},
				{
					"id": 210042008,
					"content": "Hmm... Mungkinkah \"titik pertemuan\" berarti bahwa... keempat hal ini semuanya saling berkaitan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042009
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042009,
					"content": "Tunggu — aku ingat, Empat Perintah Guizhong ini semuanya bisa ditemukan di dalam reruntuhan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042010
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042010,
					"content": "Hmm... Aku memiliki sebuah spekulasi. Mungkin empat <color=#00E1FFFF>reruntuhan</color> ini berhubungan dengan makna sebenarnya dari Empat Perintah Guizhong ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042011
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042011,
					"content": "Bagaimana tepatnya, aku juga tidak tahu, aku harus memikirkannya lagi. Mungkin kamu bisa bantu berpikir juga — atau lebih baik, pergi dan selidiki langsung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042012
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042012,
					"content": "Aku hanya seorang pelajar lemah, aku kelelahan setelah beberapa detik berlari... Andai aku memiliki stamina sepertimu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042013
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042013,
					"content": "Baiklah, aku akan berpikir kembali. Kalau kamu kepikiran sesuatu, atau kalau kamu menemukan sesuatu, segera beri tahu aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				}
			]
		},
		{
			"id": 2100422,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
