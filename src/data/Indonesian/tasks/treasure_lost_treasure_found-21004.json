			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Soraya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210040101,
					"content": "Empat perintah Guizhong... Apa yang sebenarnya ingin disampaikan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040102,
						210040104
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040102,
					"content": "Aku sudah siap.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210040103
					]
				},
				{
					"id": 210040103,
					"content": "Hahaha, semangat sekali kamu! Baiklah, mari kita mulai menafsirkan Empat Perintah Guizhong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040106
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040106,
					"content": "\"Mengajari dengan kebijaksanaan, mengadili dengan kebajikan, memperkuat diri, dan mempersatukan hati. Keempat prinsip inilah yang membentuk Guili Assembly.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040107
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040107,
					"content": "Kalau dilihat, itu adalah bagian dari perintahnya. Nasihat yang penting dalam kehidupan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040108
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040108,
					"content": "Tetapi kalimat ini mengandung petunjuk rahasia menuju harta karun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040109
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040109,
					"content": "... Apa boleh buat. Sepertinya kita harus beralih ke cara yang paling bodoh dan mendasar yang kita, para terpelajar, tahu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040110
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040110,
					"content": "Pertama-tama, kita sudah mengetahui bahwa ketujuh bait kalimat ini menunjuk pada tempat-tempat di reruntuhan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040111
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040111,
					"content": "Meskipun sekarang kita tidak tahu harus memulai dari mana, bagaimana kalau kita terus menelusuri reruntuhan lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040112,
						210040116,
						210040122
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040112,
					"content": "Harus mencari ke mana...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210040113
					]
				},
				{
					"id": 210040113,
					"content": "Hmm... Untuk sekarang ini, kita batasi area pencarian di area Guili Plains saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040114
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040114,
					"content": "Tapi kalian tahu sendiri aku sebagai seorang pelajar, pasti tidak sanggup mengikuti kecepatan berlari kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040115
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040115,
					"content": "Maka dari itu, misi pencarian reruntuhan ini kuserahkan pada kalian! Bila kalian berhasil menemukan petunjuk, silakan kembali ke sini dan beri tahu aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040129
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040129,
					"content": "Ngomong-ngomong, aku pernah menemukan piring batu giok dengan ukiran huruf-huruf di atasnya, sepertinya aku menemukannya di dalam reruntuhan dekat sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040130
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040130,
					"content": "Tapi saat itu aku hanya melakukan penelitian seorang diri dan aku tidak menganalisanya lebih lanjut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040131
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040131,
					"content": "Kalau dipikir-pikir, bisa jadi piring batu giok itu berhubungan dengan Empat Perintah Guizhong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040132
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040132,
					"content": "Begini saja, aku akan menandai lokasinya di petamu, siapa tahu kamu bisa menemukan suatu petunjuk di sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040116,
					"content": "... Kita harus menelusuri SEMUA reruntuhan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210040117
					]
				},
				{
					"id": 210040117,
					"content": "Tentu saja tidak, kalau kita mau menelusuri semua reruntuhan di daerah Liyue, tidak akan cukup dengan 2 orang saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040118
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040118,
					"content": "Karena harta karun itu berhubungan dengan Guili Assembly dari Guili Plains, kita bisa memperkecil area pencarian kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040119
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040119,
					"content": "Untuk sekarang ini, kita batasi area pencarian di area Guili Plains saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040120
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040120,
					"content": "Ah, benar juga, kalian tahu sendiri aku sebagai seorang pelajar, pasti tidak sanggup mengikuti kecepatan berlari kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040121
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040121,
					"content": "Maka dari itu, misi pencarian reruntuhan ini kuserahkan pada kalian! Bila kalian berhasil menemukan petunjuk, silakan kembali ke sini dan beri tahu aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040129
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040122,
					"content": "Tunggu kedatanganku, reruntuhan Liyue!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210040123
					]
				},
				{
					"id": 210040123,
					"content": "Tunggu dulu! Tenang dulu, Liyue begitu luas, mau sampai kapan kamu cari semua reruntuhan itu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040124
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040124,
					"content": "Kamu selalu berapi-api saat mendengar kata harta karun... Apa yang sebaiknya kukatakan kepadamu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040125
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040125,
					"content": "Karena harta karun itu berhubungan dengan Guili Assembly dari Guili Plains, kita bisa memperkecil area pencarian kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040126
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040126,
					"content": "Untuk sekarang ini, kita batasi area pencarian di area Guili Plains saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040127
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040127,
					"content": "Hei! Tunggu sampai aku selesai berbicara! Ingat untuk menelusuri reruntuhan-reruntuhan itu dengan sangat teliti. Bila kamu menemukan petunjuk apa pun, segera bawa kepadaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040128
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040128,
					"content": "Ingat ya, kamu cukup mencari di area Guili Plains saja, jangan pergi terlalu jauh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040129
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040104,
					"content": "Ayo kita cari harta kartun itu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210040105
					]
				},
				{
					"id": 210040105,
					"content": "Begitu mendengar harta karun, kamu langsung berapi-api... Baiklah, mari kita mulai menafsirkan Empat Perintah Guizhong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040106
					],
					"speakerTitle": "Soraya"
				}
			]
		},
