		{
			"id": 2100450,
			"completionStepIds": [
				2100450
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2100450",
							"2"
						],
						"stepId": 2100450,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Soraya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210045001,
					"content": "Bagaimana pencariannya? Apakah sudah menemukan harta karun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045003
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045003,
					"content": "Sudah, dan memang benar mereka ada di tempat \"titik pertemuan\" itu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210045004
					]
				},
				{
					"id": 210045004,
					"content": "Benarkah... ternyata benar seperti yang ada dalam Empat Perintah Guizhong. Harta karun terletak di \"titik pertemuan dari keempat ini...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045005
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045005,
					"content": "Siapa pun yang merancang teka-teki ini pasti sangat menghormati Guizhong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045006
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045006,
					"content": "Sekalipun Guili Assembly telah hancur, mereka menggunakan cara ini untuk menurunkan Empat Perintah Guizhong ke generasi selanjutnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045007
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045007,
					"content": "Dan untuk Guizhong sendiri, yang menetapkan perintah itu - dia pasti dihormati oleh rakyatnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045008
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045008,
					"content": "Jelas, dia berharap agar rakyatnya menjadi bijak, untuk menjaga diri mereka tetap bermoral, menjadi kuat dan sehat, serta bersatu melindungi rumah mereka — Guili Assembly...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045009,
						210045016,
						210045021
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045009,
					"content": "Tapi dia gagal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210045010
					]
				},
				{
					"id": 210045010,
					"content": "Gagal? Sepertinya yang kamu katakan itu benar, karena pada akhirnya dia mati... dan saat Guili Assembly hancur, rakyatnya tidak memiliki lagi tempat yang dinamakan rumah bagi mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045011
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045011,
					"content": "Tapi, hari ini Empat Perintah Guizhong kembali melihat cahaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045012
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045012,
					"content": "Ini adalah kata-kata yang ditulis oleh Guizhong sendiri untuk melayani, baik sebagai perintah dan berkah bagi rakyatnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045013
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045013,
					"content": "Menggunakan Empat Perintah Guizhong ini, dia pernah memimpin rakyatnya untuk terus maju dan mengambil alih tanah ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045014
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045014,
					"content": "Dia mungkin sudah tiada, tapi keyakinannya, yang dia perjuangkan — tidak akan pernah hilang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045015
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045015,
					"content": "Siapa pun yang sangat menghormatinya tentu sangat pintar. Mereka menggunakan daya pikat harta karun untuk memastikan Empat Perintah Guizhong akan diturunkan ke generasi selanjutnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045028
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045028,
					"content": "Tapi, aku juga tidak tahu apa yang ada di dalam hatinya, harta karun sebenarnya adalah logam langka dan batu mulia, atau Empat Perintah Guizhong itu sendiri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045029
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045029,
					"content": "Haha, setidaknya untukku jelas perintah itu adalah harta karun yang sebenarnya. Tidak bisa dibandingkan dengan kotak penuh emas dan batu permata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045030
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045030,
					"content": "... Tapi, kalau kamu menyuruh seseorang memilihnya, berapa banyak yang akan memilih daftar perintah daripada harta kekayaan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045016,
					"content": "Sepertinya dia adalah dewa yang berhati lembut.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210045017
					]
				},
				{
					"id": 210045017,
					"content": "Aku tidak yakin apakah \"kelembutan hati\" adalah sifat dari dewa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045018
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045018,
					"content": "Tapi mungkin dulu pernah ada. Mungkin sudah lama sekali, di antara para dewa yang memimpin orang-orang di dunia, ada yang berhati lembut dari awal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045019
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045019,
					"content": "Mereka yang melindungi orang-orangnya... berjalan bersama mereka... dan berjuang bersama memasuki dunia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045020
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045020,
					"content": "... Tetapi para dewa yang lembutlah, yang pada akhirnya tidak mampu untuk melindungi rakyat mereka. Lihatlah Guizhong — butuh adanya perburuan harta karun yang rumit hanya untuk mewariskan empat perintah yang dulu merupakan kunci kehidupan seluruh peradaban.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045029
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045021,
					"content": "Aku berharap bisa bertemu dengannya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210045022
					]
				},
				{
					"id": 210045022,
					"content": "Kamu ingin bertemu dengan dewa? Kamu benar-benar mengejutkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045023
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045023,
					"content": "Tapi aku penasaran, apa yang akan kamu katakan kalau kamu benar-benar bertemu dengannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045024
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045024,
					"content": "\"... Semangat, Guizhong, Anda telah melakukan yang terbaik\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045025
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045025,
					"content": "Kalau aku... aku akan mengucapkan Empat Perintah Guizhong dengan sempurna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045026
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045026,
					"content": "Kemudian aku akan memberi tahunya bahwa visi dan keyakinannya masih tetap hidup, dan orang-orang di tanah ini masih mengingat hal-hal yang diajarkan oleh leluhur mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045027
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045027,
					"content": "Aku pikir untuk seseorang seperti Guizhong, yang kehilangan segalanya... mungkin ini akan menjadi satu-satunya hal yang dapat memberinya semangat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				}
			]
		},
