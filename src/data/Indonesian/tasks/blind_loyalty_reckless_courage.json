			"trigger": {
				"objectNames": [
					"Kujou Sara",
					"Yae Miko",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20180201,
					"content": "Lady Guuji, aku datang sesuai perjanjian. Tenang, aku datang sendirian. Tak ada seorang pun yang tahu tentang perjalananku ke sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180202
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180202,
					"content": "Aku tahu kamu akan tepat janji. Kurasa ... beberapa hari ini kamu pasti kepikiran terus, kan? Apa kamu tetap bisa tidur?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180203
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180203,
					"content": "A-Aku ... Anda salah, aku tidak akan pernah meragukan kepala Klan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180204
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180204,
					"content": "Jadi, mana buktinya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180205
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180205,
					"content": "Ini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180206
					]
				},
				{
					"id": 20180206,
					"content": "Ah, bagus. Hari ini semua orang tepat janji.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180207
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180207,
					"content": "Kamu enggak bakalan percaya apa yang harus kami alami demi ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180208,
					"content": "Berikan pada Sara, biar dia menilainya sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180209
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180209,
					"content": "Apa ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180210
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180210,
					"content": "Kulihat dokumen ini punya segel resmi dari kepala Klan Kujou. Dan ini tidak terlihat palsu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180211
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180211,
					"content": "Aku tidak mengerti ... Tidak ada kata tentara pemberontak, Sangonomiya, masalah di garis depan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180212
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180212,
					"content": "Apa semua prajurit yang tewas di garis depan dan penderitaan yang dialami rakyat tidak layak untuk dilaporkan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180213
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180213,
					"content": "Benar-benar sebuah pengabaian yang keji terhadap kehidupan manusia ... Kenapa mereka harus menyembunyikannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180214
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180214,
					"content": "Tentu saja demi kelancaran pelaksanaan Dekrit Perburuan Vision. Kalau hal-hal yang kamu sebut tadi ada di laporan, nanti Shogun bisa saja mempertimbangkan ulang dekritnya, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180215
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180215,
					"content": "Jadi selama ini Tenryou Commission ... berusaha sekuat tenaga untuk membohongi Shogun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180216
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180216,
					"content": "Betul. Coba kamu pikir lagi ... siapa yang paling diuntungkan dengan adanya Dekrit Perburuan Vision?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180217
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180217,
					"content": "Aku juga masih punya surat rahasia ini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180218
					]
				},
				{
					"id": 20180218,
					"content": "Ini bukti korespondensi antara Tenryou Commission dan Fatui, yang setengah mati disembunyikan sama kepala Klan Kujou juga dari Shogun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180219,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180220
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180220,
					"content": "Bagaimana? Sekarang apa yang ingin kamu lihat dan apa yang tidak ingin kamu lihat, keduanya ada di depanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180221
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180221,
					"content": "Apa kamu ... mencoba menutup mata terhadap bukti-bukti ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180222
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180222,
					"content": "Jadi semua yang sudah kulakukan selama ini ... semuanya ... Bisa-bisanya mereka ... Argh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180223
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180223,
					"content": "Pengkhianatan seperti ini tidak dapat diampuni ... Takayuki, kamu bertanggung jawab untuk menjelaskan semua ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180224
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180224,
					"content": "Kujou Sara kelihatannya marah sekali, huh. Sepertinya pemberontakan Tenryou kita bakal berhasil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180225,
						20180226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180225,
					"content": "Sekarang tentara Shogunate tidak punya pemimpin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180227
					]
				},
				{
					"id": 20180227,
					"content": "Ya, ayo ikuti dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180228,
					"content": "Pengembara, sebentar. Masih ada yang harus kita bicarakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180229
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180229,
					"content": "Huh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180230,
					"content": "Kamu pertama kali masuk ke Plane of Euthymia waktu ada di depan patung Omnipresent God, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180231
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180231,
					"content": "Betul.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180232
					]
				},
				{
					"id": 20180232,
					"content": "Kamu harus cari cara untuk mereka ulang kejadian hari itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180233
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180233,
					"content": "Di depan patung Omnipresent God, buat Raiden Shogun \"membuka pintu hatinya\". Dengan demikian, kamu punya peluang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180234
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180234,
					"content": "Aku akan lakukan yang terbaik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180235
					]
				},
				{
					"id": 20180235,
					"content": "Bawalah ini sebagai hadiah perpisahan dariku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180236
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180236,
					"content": "Apa ini ....?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180237
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180237,
					"content": "Omamori Kuil Agung Narukami selalu manjur. Dan yang satu ini spesial untukmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180238,
						20180239
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180238,
					"content": "Terima kasih ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180240
					]
				},
				{
					"id": 20180240,
					"content": "Hehe, kalau kamu sedang dalam bahaya, keluarkan saja omamori-nya dan lihatlah apa yang akan terjadi. Doamu mungkin akan terkabulkan dan semua masalahmu akan hilang dalam sekejap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180241
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180241,
					"content": "Atau, kalau kamu terpikirkan akan aku sepanjang perjalananmu, kamu boleh keluarkan omamori itu. Siapa tahu aku bakal tiba-tiba muncul di depanmu juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180242
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180242,
					"content": "Nona Rubah, tolong dong, ini bukan waktunya menjahili Pengembara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180243
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180243,
					"content": "Hehehe ... Maaf. Kalau begitu, orang-orang bodoh itu kuserahkan pada kalian ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180239,
					"content": "Akan kusimpan baik-baik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180240
					]
				},
				{
					"id": 20180226,
					"content": "Kalau kita ikuti dia, siapa tahu kita bisa ketemu Raiden Shogun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180227
					]
				}
			]
		},
		{
