			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kujou Sara"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20180301,
					"content": "Kalian mengikutiku? Nyali kalian besar juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180302
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180302,
					"content": "Karena kalian adalah saksi, kupikir aku sanggup melindungi kalian dari penangkapan — minimal sampai aku mendapatkan penjelasan dari Takayuki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180303
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180303,
					"content": "Tapi ... kalau tuduhan kalian terbukti salah, jangankan pergi, kalian bahkan akan dikenakan pasal berlapis. Paham?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180304,
						20180305
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180304,
					"content": "Aku sudah sangat paham.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180306
					]
				},
				{
					"id": 20180306,
					"content": "Hmph, bagus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180305,
					"content": "Tunjukkan jalannya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180306
					]
				}
			]
		},
		{
			"id": 201804,
			"completionStepIds": [
				201804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201804",
							"2"
						],
						"stepId": 201804,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kujou Takayuki",
					"Kujou Sara",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20180403,
					"content": "Berhenti! Apa-apaan ini Sara, kamu sudah gila ya?! Lancang sekali melanggar aturanku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180404
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180404,
					"content": "Tu-tuan, aku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180405
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180405,
					"content": "Tanya cepat, jangan terintimidasi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180406,
					"content": "Ah ... Tuan Besar Takayuki, aku sudah melihat dokumen laporan dan korespondensi Anda dengan pihak Fatui ... Mohon jelaskan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180407
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180407,
					"content": "Jadi surat dan dokumen yang hilang itu, kamu yang ambil? Heh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180408
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180408,
					"content": "Apa benar jika aku menafsirkan ucapan Anda barusan sebagai ... pengakuan bahwa dokumen itu asli tulisan tangan Anda dan bukan pemalsuan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180409
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180409,
					"content": "Mohon beri tahu aku apakah ... Tenryou Commission ... sungguh-sungguh telah mengkhianati Shogunate!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180410
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180410,
					"content": "Hmph ... Aku memang berhubungan dengan para Fatui, dan dokumen-dokumen resmi tersebut memang buatanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180411
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180411,
					"content": "Heh, kok dia langsung ngaku gitu aja ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180412,
					"content": "Cukup dengan membantu penerapan dan pelaksanaan Dekrit Perburuan Vision, aku akan dapat keuntungan yang dijanjikan oleh diplomat Snezhnaya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180413
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180413,
					"content": "Sudah sejak dahulu begitu banyak orang yang mendambakan status Klan Kujou, dan sebaliknya juga banyak Klan lain yang ingin menjatuhkan kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180414
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180414,
					"content": "Karena itu, saat aku punya kesempatan untuk mendapatkan dukungan kuat dari negara lain, sekaligus melemahkan musuh-musuh Klan dengan Dekrit Perburuan Vision di saat yang bersamaan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180415
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180415,
					"content": "Aku yakin ini rancangan yang bagus, dan kupikir aku tidak perlu untuk memberitahumu terlebih dulu, Sara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180416
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180416,
					"content": "Tapi ... bukankah kamu menyembah Shogun? Bagaimana bisa kamu akhirnya mengkhianatinya dan bertingkah seolah hal itu bukanlah apa-apa!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180417
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180417,
					"content": "Pengkhianatan? Bagaimana bisa kamu menyebut hal ini sebagai tindakan pengkhianatan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180418
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180418,
					"content": "Para Fatui mengira mereka berhasil memanfaatkanku, tapi sebenarnya akulah yang berhasil memanfaatkan mereka. Lagi pula, apa juga yang bisa mereka dapatkan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180419
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180419,
					"content": "Ketika petir menyambar di Inazuma, mereka akan tersungkur dan gemetar, mereka akan lumpuh oleh rasa takut dan gentar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180420
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180420,
					"content": "Lagi pula...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180421
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180421,
					"content": "Tidak ada yang bisa menandingi kekuatan tertinggi Raiden Shogun beserta Musou no Hitotachi miliknya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180422,
						20180423
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180422,
					"content": "Niatnya bukan untuk mengkhianati Raiden Shogun ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180424
					]
				},
				{
					"id": 20180424,
					"content": "Iya ... yang dia junjung tinggi itu bukan Raiden Shogun, tapi Musou no Hitotachi miliknya saja. Kelihatannya dia benar-benar tergila-gila dengan itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180425
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180425,
					"content": "Tapi Tuan ... lalu bagaimanakah dengan sumpah kesetiaanmu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180426
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180426,
					"content": "Sejak diadopsi oleh Klan Kujou, kamu sendiri yang mengajariku betapa pentingnya kesetiaan seorang pelayan terhadap majikannya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180427
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180427,
					"content": "Tapi jelas bagiku sekarang bahwa kalian ingin kesetiaanku hanya untuk Klan Kujou semata, sehingga kalian takut kalau aku akan berkhianat suatu hari nanti, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180428
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180428,
					"content": "Semua ilmu dan kebijaksanaan yang kamu ajarkan, rupanya cuma alat untuk menutupi kebobrokan dan keegoisanmu sendiri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180429
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180429,
					"content": "Egois katamu? Kulakukan semua ini demi keabadian Klan Kujou. Dan aku pun percaya kalau Yang Mulia Shogun, bahkan kepala Klan yang terdahulu ... pasti mengerti tujuanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180430
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180430,
					"content": "Paimon sebenarnya malas ngomong sih, tapi mereka memang terlalu percaya diri. Kalau dia pikir Fatui itu lawan yang seimbang buat Klan Kujou, Paimon tebak dia bakal dapat kejutan yang enggak main-main ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180431,
						20180432
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180431,
					"content": "Percuma berdebat dengan orang semacam dia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180433
					]
				},
				{
					"id": 20180433,
					"content": "Dulu aku pernah meragukan Dekrit Perburuan Vision. Aku bertanya pada diriku sendiri, apakah ini adalah hal benar yang harus kulakukan sekalipun itu melanggar prinsip keyakinanku sendiri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180434
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180434,
					"content": "Tapi aku memilih untuk taat pada Shogun. Selama dia yang memimpin, siapakah yang berhak untuk menentukan mana yang benar atau yang salah padahal kita saja belum sampai ke garis akhir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180435
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180435,
					"content": "Tapi kini aku sadar bahwa jalan keabadian tidak akan pernah berakhir, sementara jalan ini ... dari awal sudah dicemari oleh keegoisan kalian yang menjijikkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180436
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180436,
					"content": "Jadi, aku akan melaporkan semua ini pada Shogun. Setidaknya minta penjelasan untuk semua yang sudah kulakukan selama ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180437
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180437,
					"content": "Dasar bodoh, melakukan hal yang tidak perlu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180438
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180438,
					"content": "Pergi saja kalau itu maumu, saat ini posisi Klan Kujou sudah tak mungkin tergoyahkan, situasi tidak akan berubah hanya karena kamu seorang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180439
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180439,
					"content": "Saat ini Shogun ada di <color=#00E1FFFF>Tenshukaku</color>, sedang menerima seorang diplomat Snezhnaya, Harbinger yang kalian kenal dengan nama \"Signora\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180440
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180440,
					"content": "Signora!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180441
					]
				},
				{
					"id": 20180441,
					"content": "Jadi Signora yang jadi dalang di balik semua kekacauan ini? Ugh, dia lagi dia lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180442
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180442,
					"content": "Waktu di Ritou, kayaknya Nona Hiiragi pernah bilang kalau Kanjou Commission pernah menerima tamu seorang wanita yang arogan ... Harusnya kita sudah bisa nebak dari waktu itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180443
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180443,
					"content": "Diplomat Snezhnaya? Baiklah! Kalau dia mengira bisa pergi dari Inazuma dengan mudah, dia tampaknya harus berubah pikiran!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180444
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180444,
					"content": "Sara tergesa-gesa sekali ... apa menurutmu dia akan langsung pergi ke Tenshukaku sekarang juga?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180445
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180445,
					"content": "Dan kita juga masih punya urusan yang harus diselesaikan dengan Signora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180446
					]
				},
				{
					"id": 20180446,
					"content": "Setuju banget!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180447
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180447,
					"content": "Kalau gitu ayo jalan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180448
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180448,
					"content": "Kita ke <color=#00E1FFFF>Tenshukaku</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180432,
					"content": "Coba kita tunggu keputusan Sara.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180433
					]
				},
				{
					"id": 20180423,
					"content": "Kamu terlalu mengagungkan kekuatan Raiden Shogun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180424
					]
				}
			]
		},
