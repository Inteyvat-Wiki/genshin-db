			"dialogs": [
				{
					"id": 3550701,
					"content": "Hampir saja! Sedikit lagi bisa hilang Paimon ketiup angin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3550702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3550702,
					"content": "Untung saja Paimon pegangan ke rambut kamu! Makasih~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3550703,
						3550704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3550703,
					"content": "Untung rambutku tidak ketarik sampai lepas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3550705
					]
				},
				{
					"id": 3550705,
					"content": "Barusan itu apa sih? Paimon kira kita bakal dimakan sama tuh naga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3550706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3550706,
					"content": "Pasti ada hubungan sama si orang aneh yang ngomong sama naga itu tadi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3550707,
						3550709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3550707,
					"content": "Naga benar-benar ada di dunia ini, luar biasa ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3550708
					]
				},
				{
					"id": 3550708,
					"content": "Iya, Paimon ngerti kok kamu takut apa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3550711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3550711,
					"content": "Eh? Apa tuh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3550712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3550712,
					"content": "Ada yang merah-merah bersinar di atas batu sebelah sana ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3550713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3550713,
					"content": "Kita lihat dari dekat yuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3550709,
					"content": "Apa ngomong sama naga itu lazim terjadi di sini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3550710
					]
				},
				{
					"id": 3550710,
					"content": "Ya enggak lah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3550711
					],
					"speakerTitle": "Paimon"
				},
				{
