			},
			"dialogs": [
				{
					"id": 201040101,
					"content": "Bagaimana ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040102
					],
					"speakerTitle": "Moco"
				},
				{
					"id": 201040102,
					"content": "Adelinde benar-benar akan marah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040103
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 201040103,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201040104
					]
				},
				{
					"id": 201040104,
					"content": "Adelinde meminta kami untuk membereskan area di sekitar Dawn Winery...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040105
					],
					"speakerTitle": "Moco"
				},
				{
					"id": 201040105,
					"content": "Sebagian besar tempatnya cukup bersih, tetapi masih ada banyak tumpukan jerami di sekitar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040106
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 201040106,
					"content": "Connor yang menyimpannya di sini karena dia membutuhkannya untuk sesuatu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040107
					],
					"speakerTitle": "Moco"
				},
				{
					"id": 201040107,
					"content": "Jerami-jerami itu diikat cukup kuat, jadi setidaknya tidak akan tertiup angin. Tapi tetap saja, banyak daun jatuh di antara jerami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040108
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 201040108,
					"content": "Kita sudah bekerja sangat keras, tapi kita masih tidak bisa menyingkirkan semua daun-daun itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040109
					],
					"speakerTitle": "Moco"
				},
				{
					"id": 201040109,
					"content": "Kalau seperti ini terus, kepala pelayan Adelinde pasti akan marah... Apa yang harus kita lakukan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040110,
						201040112
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 201040110,
					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201040111
					]
				},
				{
					"id": 201040111,
					"content": "Serius? Kamu benar-benar keren! Terima kasih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Moco"
				},
				{
					"id": 201040112,
					"content": "Apakah daun-daunnya sulit dibersihkan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201040113
					]
				},
				{
					"id": 201040113,
					"content": "Daun-daun itu sudah bercampur dengan jerami. Kita harus memilahnya satu per satu, dan itu sangat menghabiskan waktu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040114
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 201040114,
					"content": "Kalau ada ide yang lebih baik, tolong beri tahu kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hillie"
				}
			]
		},
