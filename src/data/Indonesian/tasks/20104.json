			"dialogs": [
				{
					"id": 201040201,
					"content": "Bagaimana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040202
					],
					"speakerTitle": "Moco"
				},
				{
					"id": 201040202,
					"content": "Apakah kamu sudah membersihkan semuanya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040203
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 201040203,
					"content": "Sudah selesai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201040204
					]
				},
				{
					"id": 201040204,
					"content": "Hebat sekali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040205
					],
					"speakerTitle": "Moco"
				},
				{
					"id": 201040205,
					"content": "Pengembara, kamu benar-benar yang terbaik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040206
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 201040206,
					"content": "Terima kasih! Dengan begini Adelinde tidak akan marah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040207
					],
					"speakerTitle": "Moco"
				},
				{
					"id": 201040207,
					"content": "Terimalah ini sebagai tanda terima kasih kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040208
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 201040208,
					"content": "Oh iya, masih ada tempat yang harus kami bersihkan. Terima kasih sekali lagi dan sampai jumpa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Moco"
				}
			]
		},
