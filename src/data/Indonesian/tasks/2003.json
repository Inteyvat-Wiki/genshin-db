					"nextDialogs": [
						20030504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030504,
					"content": "Kalau begitu... melihat dari pakaianmu... kalian pasti pendatang dari luar yang menyusup ke sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030505
					],
					"speakerTitle": "Kozue"
				},
				{
					"id": 20030505,
					"content": "Memangnya baju kami terlihat— oh! Eh... Maksud Paimon tadi—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030506,
					"content": "Ini Surat Undangan kami.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030507
					]
				},
				{
					"id": 20030507,
					"content": "Hmm, segel dari Yashiro Commission... ini pasti dari Tuan Thoma. Sepertinya kamu memang bukan orang biasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030508
					],
					"speakerTitle": "Kozue"
				},
				{
					"id": 20030508,
					"content": "Kalau begitu, selamat datang di Komore Teahouse, surga yang nyaman dan aman bagi Yashiro Commission.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030509
