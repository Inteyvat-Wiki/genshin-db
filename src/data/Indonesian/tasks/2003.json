			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Thoma"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20030101,
					"content": "Oke, sudah sampai nih. Mana Thoma?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030102,
					"content": "Ah, Paimon tidak lihat dia sama sekali. Apa dia lupa mau ketemuan sama kita ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030103,
					"content": "Siapa yang lupa? Justru aku kira kalian yang lupa denganku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030104
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030104,
					"content": "A-a-apa!? A-anjingnya bisa bicara?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030105,
					"content": "Hahaha, tenang, jangan kaget begitu. Ini pertama kalinya kalian melihatku dalam wujud ini ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030106,
						20030107
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030106,
					"content": "Kamu... anjing?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030108
					]
				},
				{
					"id": 20030108,
					"content": "Ah, jadi kamu tidak pernah lihat hal semacam ini waktu di Liyue?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030109
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030109,
					"content": "Kalau kamu bilang gitu, rasanya ini jadi gak aneh ya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030110,
						20030111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030110,
					"content": "Masih ada yang aneh... di mananya ya...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030112
					]
				},
				{
					"id": 20030112,
					"content": "Hahaha... Oke, oke, cukup main-mainnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030113
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030113,
					"content": "Hei! Sedikit lagi kamu punya panggilan baru, tahu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030114,
					"content": "Kalian juga sih lama amat datangnya. Ke sini lama, waktu di Ritou juga lama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030115
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030115,
					"content": "Jadi aku kepikiran buat menyapa kalian pakai cara ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030116
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030116,
					"content": "Nah, sekarang serius. Aku minta maaf soal \"tes\" kecil barusan. Walaupun memang perlu sih...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030117
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030117,
					"content": "Itu membantu kami memutuskan perlu atau tidak kami membawamu ke hadapan Nona Kamisato, dan apa kamu punya keberanian atau tidak untuk menghadapi petir bersama kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030118
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030118,
					"content": "Jangan berpikir kalau Paimon bakal maafin kamu hanya karena kamu sekarang jadi serius ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030119,
					"content": "Haha... Maaf deh, apa aku berlebihan? Maaf ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030120,
						20030121
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030120,
					"content": "Jadi, bagaimana hasil dari \"tes\" kami?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030122
					]
				},
				{
					"id": 20030122,
					"content": "Dari awal kamu sudah menempatkan dirimu pada \"aturan\" yang ada, ya kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030123
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030123,
					"content": "Jadi normalnya, ini berdasarkan dari tekad dan resolusimu yang teguh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030124
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030124,
					"content": "Dulu sekali, kami punya teman yang kurang lebih sama... tapi saat petir menyambar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030125,
						20030126
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030125,
					"content": "Maksudmu teman Kazuha...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030127
					]
				},
				{
					"id": 20030127,
					"content": "Ah, jadi kamu sudah dengar ceritanya, hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030128
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030128,
					"content": "Cahayanya masih menyala terang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030129
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030129,
					"content": "Apa kami boleh bertemu Shirasagi Himegimi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030130
					]
				},
				{
					"id": 20030130,
					"content": "Iya, tentu saja. Aku akan membawamu ke kediaman Kamisato, tempat di mana Yashiro Commission berada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030131
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030131,
					"content": "Tapi sebelumnya, ada satu tempat lain yang aku harap kalian tidak keberatan untuk menemaniku pergi ke sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030132
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030132,
					"content": "Oh? Ke mana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030133,
					"content": "Aku ingin kamu menemaniku ke Patung Omnipresent God. Patung itu masih dibangun, tapi kamu sudah bisa melihatnya dari lokasi mana pun di Pulau Narukami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030126,
					"content": "Maksudmu dia gugur pada saat duel untuk memperebutkan takhta...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030127
					]
				},
				{
					"id": 20030121,
					"content": "\"Keberanian untuk menghadapi petir\"...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030122
					]
				},
				{
					"id": 20030111,
					"content": "Memang aslinya anjing kan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030112
					]
				},
				{
					"id": 20030107,
					"content": "Ke mana Thoma yang manusia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030108
					]
				}
			]
		},
		{
			"id": 200302,
			"completionStepIds": [
				200302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
