						],
						"stepId": 200302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Thoma"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20030201,
					"content": "Duh area ini suram banget. Orang-orang jarang ke sini ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030202,
					"content": "Hah, apa mata Paimon tidak salah ya, atau memang ada sesuatu yang tertanam di patung itu...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030203,
					"content": "Vision.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030204
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030204,
					"content": "Vision! Maksudmu semua Vision yang didapat dari Dekrit Perburuan Vision semua ditanam di patung ini!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030206,
					"content": "Kenapa Shogun memberi titah Dekrit Perburuan Vision?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030207
					]
				},
				{
					"id": 20030205,
					"content": "Jadi kamu sudah dengar tentang Dekrit Perburuan Vision.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030206
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030207,
					"content": "Sebelum aku mencoba untuk menjelaskan, mungkin seharusnya aku mengingatkanmu dulu kalau Mondstadt adalah Kota Kebebasan, dan Liyue adalah Kota Kontrak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030208
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030208,
					"content": "Sedangkan Inazuma... dikenal sebagai Bangsa Keabadian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030209
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030209,
					"content": "Sang Raiden Shogun adalah penguasa terkuat bangsa ini dan juga dewa di Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030210
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030210,
					"content": "\"Keabadian\" yang dimaksud... adalah keinginannya yang tak tergoyahkan dan tak berujung untuk memerintah Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030211
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030211,
					"content": "Karenanya, dia mengandalkan Tri-Commission untuk mengatur berbagai urusan bangsa ini, dan Dekrit Sakoku untuk membatasi pergerakan rakyat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030212
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030212,
					"content": "Sang Shogun ingin menjaga Inazuma dalam keadaan diam, membiarkan aliran waktu mengalir dari satu ujung ke ujung lainnya tanpa terganggu sama sekali, sepanjang waktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030213
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030213,
					"content": "Sepertinya setiap dewa punya keinginannya masing-masing...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030214,
					"content": "Tentu saja, ini hanya pemahamanku saja yang terbatas. Untuk alasan di balik Dekrit Perburuan Vision...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030215
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030215,
					"content": "Mungkin Shogun percaya kalau Vision memberikan kekuatan pada orang untuk berubah, dan keabadian miliknya tidak mengizinkan perubahan seperti itu untuk ada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030216
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030216,
					"content": "Apa pun alasannya, faktanya adalah Raiden Shogun telah mengurus Tenryou Commission untuk menjelajahi seluruh Inazuma untuk berburu Vision dan menanamkannya pada patung ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030217
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030217,
					"content": "...dan Patung Omnipresent God ini dapat dilihat sebagai simbol keabadian Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030218
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030218,
					"content": "Tapi jika begitu, apa kamu tidak menganggap kalau Raiden Shogun itu... egois?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030219,
					"content": "Haha, hanya pendatang sepertimu yang berani bicara begitu tentang Raiden Shogun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030220
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030220,
					"content": "Tapi... aku setuju. Dekrit Perburuan Vision adalah sesuatu yang tidak seharusnya ada, dan Nona Kamisato sudah berkomitmen untuk melawannya sejak hal tersebut diumumkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030221
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030235,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030223,
					"content": "Suara... apa itu barusan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030224
					]
				},
				{
					"id": 20030221,
					"content": "#Loh, {NICKNAME}, kamu kenapa? Kayaknya kamu lagi pikirkan hal lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030222,
					"content": "Suara? Suara apa? Aku tidak dengar apa-apa... apa ada sesuatu yang terjadi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030223
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030225,
					"content": "Aku bisa dengar suara... aspirasi orang-orang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030226
					]
				},
				{
					"id": 20030224,
					"content": "Iya, kamu sentuh patungnya, lalu... lalu apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030226,
					"content": "\"Aspirasi\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030227
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030227,
					"content": "Hmm... Sepertinya kata-kata itu benar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030228
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030228,
					"content": "Apa kamu sudah dengar sebelumnya? Bahwa kalau ambisi seseorang mencapai kekuatan tertentu, para dewa akan melihatnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030229
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030229,
					"content": "Dari situlah Vision muncul... Dengan kata lain, Vision seseorang melambangkan ambisinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030230
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030230,
					"content": "Jadi, kalau yang kamu katakan itu benar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030231
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030232,
					"content": "Jadi Vision melambangkan ambisi, bukan kekuatan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030233
					]
				},
				{
					"id": 20030231,
					"content": "...maka ambisi orang-orang ini lebih kuat dari bayanganku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030232
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030233,
					"content": "Baiklah. Waktunya melanjutkan tur kita di Pulau Narukami: kediaman Kamisato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030234
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030234,
					"content": "Fyuh, akhirnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
