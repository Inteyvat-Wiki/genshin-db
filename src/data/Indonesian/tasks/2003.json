			"trigger": {
				"objectNames": [
					"Kamisato Ayaka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20030401,
					"content": "Jadi ini tempat orang kaya di Inazuma tinggal? Paimon padahal menyangka bakal lebih... mewah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030402,
						20030403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030402,
					"content": "Susah kalau mau menandingi Jade Chamber sih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030404
					]
				},
				{
					"id": 20030404,
					"content": "Selamat datang, di kediaman Kamisato, tamu yang terhormat. Nona Kamisato senang karena akhirnya dapat bertemu denganmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030405
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030405,
					"content": "Apa ini Shirasagi Himegimi yang kamu sebut-sebut itu? Jadi, eh, di mana dia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030406,
					"content": "Ehem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030407
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030407,
					"content": "Oh... di balik layar ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030408,
					"content": "Iya, haha, sebagai putri dari Yashiro Commission, beginilah cara Nona Kamisato dalam menerima tamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030409
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030409,
					"content": "Anggaplah ini tradisi terhormat di Yashiro Commission. Maaf jika ini seperti kejutan dadakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030410,
						20030411
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030410,
					"content": "Sepertinya aku paham.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030412
					]
				},
				{
					"id": 20030412,
					"content": "Masuk akal, dia kan orang yang penting banget.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030413,
					"content": "Maafkan atas sikapku yang kurang sopan karena menyambutmu dengan cara seperti ini... apalagi setelah perjalananmu yang panjang dan melelahkan di atas laut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030414
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030414,
					"content": "Aku sudah menunggu dan sangat mengantisipasi kedatanganmu, dan Thoma sudah menjamin bahwa kamu memang mempunyai kekuatan untuk mengubah aliran waktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030415
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030415,
					"content": "Saat ini di Inazuma, atas nama Dekrit Perburuan Vision, aspirasi rakyat benar-benar bagaikan terinjak-injak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030416
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030416,
					"content": "Walaupun dengan adanya Yashiro Commission yang melayani Shogun, orang-orang tersebut mempunyai ikatan paling dekat dengan kami, karena adanya kontrak yang diperlukan dengan mereka untuk menjalankan tugas kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030417
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030417,
					"content": "Kekuatan Commission naik dan turun berdasarkan kepercayaan rakyatnya. Jadi, berdiam diri pada situasi seperti ini sama saja seperti berdiam diri pada nasib kita sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030418
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030418,
					"content": "Pengembara, tolong pinjamkan kekuatanmu, dan kita bisa—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030419,
						20030420
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030419,
					"content": "Aku hanya ada di sini untuk menemui Raiden Shogun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030421
					]
				},
				{
					"id": 20030421,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030422
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030422,
					"content": "Lihat sendiri kan Nona, seperti yang kubilang... percuma saja...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030423
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030423,
					"content": "Aku akan pergi sekarang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030424
					]
				},
				{
					"id": 20030424,
					"content": "Tidak, tolong... tunggu! Tolong... Jangan pergi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030425
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030425,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030426
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030426,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030427
					]
				},
				{
					"id": 20030427,
					"content": "Aku akan memperkenalkanmu pada Raiden Shogun, dengan satu syarat... Kamu harus mengabulkan tiga permohonan kecilku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030428
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030428,
					"content": "Apa permohonanmu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030429
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030429,
					"content": "Ini berhubungan dengan tiga orang yang kehilangan Visionnya... Mungkin saat kamu bertemu dengan mereka, kamu akan mengerti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030430
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030430,
					"content": "Seorang prajurit yang menjaga sebuah desa, seorang mantan samurai yang membantu menjalankan Dekrit Perburuan Vision, dan seorang pendekar pedang yang bertekad untuk menjadi yang terbaik di dunia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030431,
					"content": "Benar. Tolong lakukan semua yang kamu bisa untuk membantu mereka. Aku akan menunggu kepulanganmu di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030432,
						20030433
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030432,
					"content": "Akan kulakukan seperti yang kamu minta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030434
					]
				},
				{
					"id": 20030434,
					"content": "Hehe... Kalau begitu, terima kasih banyak ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030435
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030435,
					"content": "Berjuanglah, anak muda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030433,
					"content": "Jadi ini perintahnya...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030434
					]
				},
				{
					"id": 20030420,
					"content": "Aku datang bukan untuk memulai pemberontakan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030421
					]
				},
				{
					"id": 20030411,
					"content": "(Ini agak anti klimaks sekali...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030412
