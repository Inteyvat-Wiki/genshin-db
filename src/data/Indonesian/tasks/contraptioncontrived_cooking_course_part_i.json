				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cloud Retainer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715000101,
					"content": "Umm... Mungkin jalan ini lebih baik...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000102
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 715000102,
					"content": "Pengembara, kebetulan kamu datang di saat yang tepat. Diriku baru saja selesai menyetel mesin ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000103,
						715000105
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 715000103,
					"content": "Jadi ini Supreme Cuisine Machine?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715000104
					]
				},
				{
					"id": 715000104,
					"content": "Betul. Mesin ini dirancang dan diatur oleh Adeptus ini sendiri, dan mempunyai kegunaan serba bisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000107
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 715000107,
					"content": "Untuk memasak dengan mesin ini, diriku ini membaca buku kuno yang tak terhitung jumlahnya. Perlu dicatat bahwa dalam hal \"memasak\", ada beberapa hal yang paling penting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000108
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 715000108,
					"content": "Pertama, pencarian bahan. Dalam memasak, bahan sangat penting. Untuk mengumpulkan bahan-bahan langka, tidak sedikit para koki bekerja keras dan mencarinya sampai ke segala penjuru...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000109
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 715000109,
					"content": "Mesin milik diriku ini sanggup menyelesaikan masalah pertama tersebut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000110
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 715000110,
					"content": "Cukup aktifkan mesin ini, maka secara otomatis akan menemukan bahan masakan yang paling cocok di sekitar dan menandainya dengan jejak aroma di sepanjang jalan, jadi koki cuma perlu mengikuti jejak aromanya saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000111
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 715000111,
					"content": "Tidak bisa mesinnya yang ambil bahannya sendiri?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715000112
					]
				},
				{
					"id": 715000112,
					"content": "*ehem* Soal ini... waktu penelitian Adeptus ini terlalu singkat, dan untuk sementara tidak dapat memecahkan masalah bagaimana agar mesin bisa bergerak menemukan jalannya secara otomatis di jalan pegunungan yang terjal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000113
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 715000113,
					"content": "Kedua, tentang memasak. Adeptus ini telah meletakkan banyak alat-alat canggih yang tak terhitung jumlahnya ke dalam mesin ini. Cukup dengan memasukkan bahan-bahannya maka mesin ini akan mengolah bahannya secara otomatis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000114
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 715000114,
					"content": "Bagaimana mekanismenya bisa tahu apa yang harus dilakukan dengan bahan-bahannya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715000115
					]
				},
				{
					"id": 715000115,
					"content": "Soal ini... tentu saja perlu mengatur parameter dengan hati-hati sesuai dengan resep yang sesuai, dan mengatur metode masak yang diperlukan untuk setiap bahan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000116
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 715000116,
					"content": "Misteri ini sulit untuk dijelaskan dalam beberapa kata, Adeptus ini tidak akan menjabarkannya, cukup asal kalian mengerti saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000117
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 715000117,
					"content": "Selain itu, dikombinasikan dengan pengalaman Adeptus ini, tugas yang paling mengganggu koki selama memasak adalah — membersihkan peralatan masak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000118
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 715000118,
					"content": "Kalau tidak, setelah pesta, masih harus membersihkan sisa makanan di panci, benar-benar mengerikan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000119,
						715000122
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 715000119,
					"content": "Mesin ini dijual?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715000120
					]
				},
				{
					"id": 715000120,
					"content": "Hahaha, takutnya kamu tidak akan sanggup membeli mekanisme misterius Adeptus ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000121
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 715000121,
					"content": "Selain itu, mesin ini hanya dapat diaktifkan dengan kekuatan Adeptus ini, percuma saja kalau kamu beli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000125
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 715000125,
					"content": "Yah, cukup sampai di sini obrolannya. Adeptus ini akan merangkai mesinnya sambil mempelajari resep masakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000126
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 715000126,
					"content": "Resep-resep ini juga sudah dikembangkan oleh diriku, sehingga sesuai dengan percobaan yang akan dilakukan oleh Supreme Cuisine Machine ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000127
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 715000127,
					"content": "Adeptus ini mengundangmu datang kali ini karena butuh bantuanmu untuk mengumpulkan beberapa bahan dan memasak hidangan sesuai dengan resep ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000128
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 715000128,
					"content": "Hidangan pertama, Adeptus ini menamainya Oncidium Tofu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000129
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 715000129,
					"content": "Untuk membuat hidangan ini, kamu harus memotong tahu menjadi pipih... sekalian bisa untuk menguji teknik memotong dari mesin ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000130
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 715000130,
					"content": "Untuk bahannya... dibutuhkan Tofu, Ham, Bamboo Shoot, dan Fowl. Diriku sudah meminta Ganyu untuk menyiapkan bahannya, dan seharusnya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000131
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 715000131,
					"content": "Eh? Mana Bamboo Shoot-nya? Jelas-jelas sebelumnya ada di sini, apa karena diriku ini terlalu keasyikan menempatkan mesin sehingga ada orang yang mencurinya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000132
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 715000132,
					"content": "...Hmph. Tidak masalah. Ini kesempatan baik untuk menunjukkan padamu fasilitas menemukan bahan makanan dari Supreme Cuisine Machine ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000133
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 715000133,
					"content": "Supreme Cuisine Machine ... menyala!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000134
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 715000134,
					"content": "Pengembara, mesinnya sudah diaktifkan. Ikuti saja jejak aromanya dan ambilkanlah Bamboo Shoot untuk diriku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 715000122,
					"content": "Kenapa kamu membuat mesin ini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715000123
					]
				},
				{
					"id": 715000123,
					"content": "Tujuan diriku? Tentu saja untuk mengetahui lebih dalam mengenai teknik dan mesin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000124
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 715000124,
					"content": "Di sisi lain, dengan adanya mesin ini, Adeptus ini dapat memasak dengan lebih praktis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000125
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 715000105,
					"content": "Apa kegunaan dari mesin ini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715000106
					]
				},
				{
					"id": 715000106,
					"content": "Hmph, sungguh tidak sabaran. Sabarlah, biarkan diriku menjelaskannya padamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000107
					],
					"speakerTitle": "Cloud Retainer"
				}
			]
		},
