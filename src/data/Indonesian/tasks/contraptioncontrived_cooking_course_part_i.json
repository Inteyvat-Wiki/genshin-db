		},
		{
			"id": 7150003,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7150005",
							"2"
						],
						"stepId": 7150005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cloud Retainer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715000303,
					"content": "Sisanya serahkan saja ke mesin ini, tapi Pengembara, aku masih perlu bantuanmu untuk mengontrol suhu panasnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000304
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 715000304,
					"content": "Bisakah mesin ini mengatur apinya sendiri?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715000305
					]
				},
				{
					"id": 715000305,
					"content": "Diriku pernah mencoba memasang api internal berkali-kali ke dalamnya, dan ingin mencoba membuat mesin bisa mengontrol panas sendiri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000306
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 715000306,
					"content": "Tapi api yang dibutuhkan Supreme Cuisine Machine bukanlah api biasa. Diriku harus menggunakan api adeptus dan mengontrolnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000307
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 715000307,
					"content": "Kalau api adeptus sekuat ini dipasang ke dalamnya, beberapa bagian kecil pada mesin mungkin akan terbakar hingga berubah wujud dan merusak mesin. Demi keuntungan kecil dan menyebabkan kerugian besar, hal ini tidak bijak sama sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000308
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 715000308,
					"content": "Solusi terbaik saat ini adalah menggunakan api adeptus di bagian luar mesin. Karena itulah, diriku membutuhkan seorang asisten untuk mengontrol panas apinya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000309
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 715000309,
					"content": "Masalah ini sangat penting, Pengembara. Urusan mengendalikan panasnya kuserahkan padamu ya. Kalau kamu sudah siap beri tahu saja diriku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cloud Retainer"
				}
			]
		},
		{
			"id": 7150004,
			"completionStepIds": [
				7150007
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7150007",
							"2"
						],
						"stepId": 7150007,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cloud Retainer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715000401,
					"content": "Menurut diriku pengaturan suhunya kurang memuaskan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000402
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
