				"points": []
			},
			"dialogs": [
				{
					"id": 191010101,
					"content": "Hmm.. Minuman di Cat's Tail lumayan juga...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010102
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010102,
					"content": "Cat's Tail?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191010103
					]
				},
				{
					"id": 191010103,
					"content": "Eh? Ah, rupanya kamu seorang pengembara. Kamu tidak tahu Cat's Tail?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010104
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010104,
					"content": "Kalau melihat ekspresimu, sepertinya kamu benar-benar tidak tahu ya... Ah, sayang sekali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010105
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010105,
					"content": "Cat's Tail Tavern sangat terkenal dengan racikan minumannya... Kamu pasti belum pernah minum minuman seperti racikan mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010106
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010106,
					"content": "Dan seperti namanya, ada banyak kucing-kucing lucu di Cat's Tail.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010107
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010107,
					"content": "Kamu rasanya seperti lupa waktu kalau sudah menikmati koktail lezat sambil dikelilingi kucing-kucing yang lucu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010108,
						191010109
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010108,
					"content": "Apakah Cat's Tail masih buka sekarang?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191010110
					]
				},
				{
					"id": 191010110,
					"content": "Eh, tapi sepertinya kamu belum cukup umur ya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010111
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010111,
					"content": "Ah, tapi harusnya tidak masalah! Di sana ada Diona, bartender paling hebat di seluruh Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010112
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010112,
					"content": "Seharusnya mudah bagi dia untuk menyiapkan minuman tak beralkohol untukmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010113
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010113,
					"content": "Apalagi, Diona benar-benar imut... seperti kucing kecil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010114
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010114,
					"content": "*Hik* Gawat... tadi aku mengatakannya keras-keras ya? Uh, tolong jangan beri tahu Diona ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010115
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010115,
					"content": "Yah pokoknya kalau kamu mau coba datang ke Cat's Tail, pintu masuknya ada di belakang sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010116
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010116,
					"content": "Aku akan... *hik* pergi ke sana untuk istirahat, sepertinya aku belum bisa minum sampai ronde 5... Aku sudah minum terlalu banyak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						0
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010109,
					"content": "Aku jadi ingin coba...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191010110
					]
				}
			]
		}
	]
}