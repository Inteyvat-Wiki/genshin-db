			"dialogs": [
				{
					"id": 740090301,
					"content": "Biar aku jelaskan dulu ... Semua ini cuma salah paham saja ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090302
					],
					"speakerTitle": "Virgil"
				},
				{
					"id": 740090302,
					"content": "Tuan Sonny ... kami melakukan bisnis ini karena untungnya besar, dan karena para atasan tidak setuju, kami ... kami pikir kami bisa mencari untung dan memberikan semua keuntungan kami ke organisasi. Itu maksud dari perbuatan kami!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090303
					],
					"speakerTitle": "Virgil"
				},
				{
					"id": 740090303,
					"content": "Ugh, dia cuekin Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090304,
					"content": "Aku benar-benar tidak bermaksud buruk pada organisasi ... Oh iya, aku juga dibohongi oleh orang-orang jahat itu, makanya aku melakukan hal yang begitu bodoh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090305
					],
					"speakerTitle": "Virgil"
				},
				{
					"id": 740090305,
					"content": "#Luar biasa, sangat luar biasa. {NICKNAME}, kamu benar-benar kuat seperti yang diceritakan. Kamu setuju tidak, Luca terkasih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090306
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090306,
					"content": "Kuat banget. Benar-benar hebat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090307
					],
					"speakerTitle": "Luca"
				},
				{
					"id": 740090307,
					"content": "Tuan Sonny ... Tuan Luca ... Kumohon ingatlah tentang waktu yang kita habiskan bersama ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090308
					],
					"speakerTitle": "Virgil"
				},
				{
					"id": 740090308,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090309
					],
					"speakerTitle": "Luca"
				},
				{
					"id": 740090309,
					"content": "Ahhh! Kumohon, tidakkkkk ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090310
					],
					"speakerTitle": "Virgil"
				},
				{
					"id": 740090310,
					"content": "Luca, tamu kita masih di sini. Jangan melakukan hal tidak sopan yang bisa membuat mereka tidak senang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090311
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090311,
					"content": "Aku mengerti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090312
					],
					"speakerTitle": "Luca"
				},
				{
					"id": 740090312,
					"content": "Huh! Uda tahu kamu salah belum, Virgil?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090313,
					"content": "Ahh, ini salahku, semuanya salahku ... Kumohon ampuni aku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090314
					],
					"speakerTitle": "Virgil"
				},
				{
					"id": 740090314,
					"content": "Oke, paling enggak kamu akui kamu bikin salah. Jangan ulangi lagi ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090315,
					"content": "#Virgil terkasih tidak akan melakukan hal seperti itu lagi. Paimon, {NICKNAME}, aku janji kepada kalian atas nama Sonny, Sarung Tangan Putih, dan juga atas nama ayah dan anakku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090316,
						740090317
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090316,
					"content": "Paimon, ayo pergi ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090320
					]
				},
				{
					"id": 740090320,
					"content": "Hore! Terima kasih ya Sonny dan Luca. Paimon rasa masih ada banyak orang baik di Fontaine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090321,
					"content": "#Sampai jumpa, Paimon terkasih dan {M#tuan yang terhormat}{F#nona yang manis}. Kuharap akan tiba hari di mana kita bekerja sama lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090322
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090322,
					"content": "Ahhhh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Virgil"
				},
				{
					"id": 740090317,
					"content": "Apa rencana kalian sekarang?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090318
					]
				},
				{
					"id": 740090318,
					"content": "#Hidup di dunia akan sangat membosankan kalau kamu tahu terlalu banyak. Benar tidak, {M#tuan yang terhormat}{F#nona yang manis}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090319
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090319,
					"content": "Tapi kalau kamu mau tahu, kami akan ... bicara serius dan lama dengannya. Kami tidak akan menghabiskan waktu kalian lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090320
					],
					"speakerTitle": "Sonny"
				}
			]
