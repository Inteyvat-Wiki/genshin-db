					"nextDialogs": [
						740090203
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090203,
					"content": "Si Virgil kenapa masih belum kembali ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090204
					],
					"speakerTitle": "Orang yang Terlihat Mencurigakan"
				},
				{
					"id": 740090204,
					"content": "Kalau dia cuma mau bikin kita menunggu, aku tidak bisa lagi ... menahan diri untuk minum pengiriman Sinthe ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090205
					],
					"speakerTitle": "Orang yang Terlihat Berbahaya"
				},
				{
					"id": 740090205,
					"content": "Jangan sembarangan! Barang itu kita dapatkan dengan susah payah. Virgil tidak akan mengampunimu kalau kamu ambil tanpa izin darinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090206
					],
					"speakerTitle": "Orang yang Terlihat Agak Mencurigakan"
				},
				{
					"id": 740090206,
					"content": "Sayang sekali. Tampaknya teman baik kita, Virgil, belum kembali ke markas. Tapi, kita masih bisa ngobrol sama orang-orang ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090207
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090207,
					"content": "Hmm, kayaknya ... orang-orang ini enggak minat buat ngobrol ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090208,
					"content": "Hmm, tapi kurasa mereka bakal berubah pikiran. Bagaimana menurutmu, Luca terkasih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090209
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090209,
					"content": "Tidak masalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090210
					],
					"speakerTitle": "Luca"
				},
				{
					"id": 740090210,
					"content": "Hei! Kamu yakin enggak masalah? Paimon rasa mereka bakal pukul kamu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090211,
					"content": "Ya ampun! Paimon perhatian banget deh. Kasian banget sih kalau sampai dipukul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090212
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090212,
					"content": "Tentu saja, mereka yang dipukul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sonny"
				}
			]
