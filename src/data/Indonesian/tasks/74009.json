			"dialogs": [
				{
					"id": 740090101,
					"content": "Wah, kebetulan sekali. Benar tidak, Luca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090102
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090102,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090103
					],
					"speakerTitle": "Luca"
				},
				{
					"id": 740090103,
					"content": "Siapa kalian?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090104,
					"content": "Aduh, tidak sopan sekali aku. Namaku Sonny, teman-teman terkadang memanggilku \"Sarung Tangan Putih\". Ini temanku, Si Nelayan Luca, dia lumayan terkenal di antara kelompok orang tertentu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090105
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090105,
					"content": "Oh, halo! Paimon adalah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090106,
					"content": "#Aku tahu kok. Kamu adalah Paimon dan {M#tuan}{F#nona} berambut pirang ini adalah {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090107
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090107,
					"content": "Eh? Kamu tahu kami?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090108,
					"content": "#Tentu saja dong! Sebelum hari ini, aku hanya kenal kamu dan {NICKNAME} dari satu sisi saja seperti aku kenal Monsieur Neuvillette.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090109
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090109,
					"content": "Dengan ketenaran dan pencapaian kalian, wajar saja berita tentang kalian menyebar dengan cepat begitu kalian tiba di Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090110
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090110,
					"content": "Kami setenar itu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090111
					]
				},
				{
					"id": 740090111,
					"content": "Aduh, kamu rendah hati sekali. Begini deh, kemunculan kalian di Fontaine, bagi sebagian orang, sudah seperti bom yang muncul di panggung Opera Epiclese.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090112
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090112,
					"content": "Tentu saja ini adalah hal yang positif! Benar tidak, Luca terkasih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090113
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090113,
					"content": "Hmm, Paimon harus lihat dari sisi mana biar kelihatan positif ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090114,
					"content": "Hmm, aku tidak pandai bicara. Bagaimana menurutmu, Luca terkasih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090115
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090115,
					"content": "Pertunjukan sulap Lyney dan Lynette. Pertunjukan bom dan melarikan diri. Pasti heboh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090116
					],
					"speakerTitle": "Luca"
				},
				{
					"id": 740090116,
					"content": "Tepat sekali! Tuh kan, aku tidak pernah terpikir untuk bicara seperti itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090117
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090117,
					"content": "Be-Begitu toh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090118,
					"content": "Tapi, kenapa kamu dipanggil \"Sarung Tangan Putih\"? Kamu kan enggak pakai sarung tangan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090119,
					"content": "Hmm, ini pertanyaan yang sulit dijawab. Bagaimana aku menjelaskannya ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090120
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090120,
					"content": "Bayangkan kalau kamu pakai sarung tangan putih. Kalau saat ini kamu pegang barang yang kotor, maka sarung tangannya akan ternodai. Benar tidak? Tugasku adalah mencari barang yang kotor, lalu membereskannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090121
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090121,
					"content": "Ohh ... jadi kamu tuh kayak tukang bersih-bersih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090122,
					"content": "Benar, Paimon terkasih! Aku tidak bisa merangkum pekerjaanku sesingkat itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090123
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090123,
					"content": "Jadi, jalanan di Court of Fontaine begini bersih karena orang-orang kayak kamu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090124,
					"content": "Hahaha, kata-katamu bagus banget deh! Kamu bisa menganggapnya begitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090125
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090125,
					"content": "Iya ... Tapi kenapa tukang bersih-bersih bawa pisau?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090126,
					"content": "Anggap saja alat kecil ini cuma dipakai saat membersihkan sampah yang susah dibersihkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090127
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090127,
					"content": "Oke, Paimon ngerti! Kalau gitu, Luca dipanggil \"si nelayan\" karena jago nangkap ikan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090128,
					"content": "Tidak sepenuhnya benar sih. Kamu lihat di Fontaine ada begitu banyak jenis ikan, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090129
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090129,
					"content": "Dan Luca sangat ahli dalam mengajarkan orang untuk hidup berdampingan dengan bermacam ikan. Benar kan yang kubilang, Luca terkasih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090130
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090130,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090131
					],
					"speakerTitle": "Luca"
				},
				{
					"id": 740090131,
					"content": "Eh? Paimon enggak paham ... Kalau gitu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090132,
					"content": "Aduh Paimon, kamu pintar bertanya deh. Pertanyaanmu bahkan berbobot. Aku benar-benar berharap bisa mengobrol lebih lama dan menjawab pertanyaanmu dengan baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090133,
						740090135
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090133,
					"content": "Paimon, sudah jangan tanya lagi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090134
					]
				},
				{
					"id": 740090134,
					"content": "Eh? Oke deh ... Sonny dan Luca, kalian ada urusan apa enggak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090136,
					"content": "Begini, kami sangat tertarik sama menyelam. Dasar air Fontaine penuh dengan kekayaan tak ternilai, baik itu dari alam atau ditinggalkan oleh leluhur kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090137
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090137,
					"content": "Dengar-dengar kamu bertemu seseorang di sini dan pergi menyelam bersama dia. Kamu begitu kuat sampai tidak perlu pakai alat selam. Benar kan, Luca terkasih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090138
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090138,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090139
					],
					"speakerTitle": "Luca"
				},
				{
					"id": 740090139,
					"content": "Kalian mau tanya soal Virgil ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090140
					]
				},
				{
					"id": 740090140,
					"content": "Benar, kami mau tanya tentang Virgil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090141
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090141,
					"content": "Dasar Virgil jahat! Ihhhh, bikin Paimon marah saja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090142
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090142,
					"content": "Kamu dan Paimon menjelaskan pengalaman kalian kepada \"Sarung Tangan Putih\" Sonny dan \"Si Nelayan\" Luca.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740090143
					]
				},
				{
					"id": 740090143,
					"content": "Ternyata begitu. Terima kasih banyak ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090144
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090144,
					"content": "Enggak usah sungkan! Huh, Paimon enggak akan lupa sama orang jahat itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090145,
					"content": "Kami sangat berterima kasih kalian sudah menjelaskan pertemuan kalian dengan Virgil. Tapi aku makin lega karena tahu kalian berdua bukan temannya. Kalau tidak ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090146
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090146,
					"content": "Begini deh: Kalau kalian adalah temannya, maka hubungan di antara kita akan sedikit canggung. Benar tidak, Luca terkasih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090147
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090147,
					"content": "Ya mungkin ... bakal agak canggung sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090148
					],
					"speakerTitle": "Luca"
				},
				{
					"id": 740090148,
					"content": "Aku rasa juga begitu. Terima kasih banyak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090149
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090149,
					"content": "Kamu lagi ngomong apa sih ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090150
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090150,
					"content": "Mereka musuhnya Virgil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090151
					]
				},
				{
					"id": 740090151,
					"content": "Apa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090152
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090152,
					"content": "#{M#Tuan yang terhormat}{F#Nona yang manis}, kata-katamu bikin hatiku sakit. Aku punya banyak teman, bukan musuh, dan Virgil adalah salah satu temanku. Tapi, Virgil terkasih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090153
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090153,
					"content": "#Kurasa sudah saatnya bicara baik-baik dengannya. Kamu mengerti maksudku kan, {NICKNAME} terkasih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090154
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090154,
					"content": "Tentu saja, kami juga harus tanya pendapat kamu dan Paimon. Kalau tidak, nanti tidak sopan kepada kalian, ya kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090155
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090155,
					"content": "Paimon enggak ngerti ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090156,
						740090158
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090156,
					"content": "Dia adalah \"Sarung Tangan Putih\". Kamu cukup tahu ini saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090157
					]
				},
				{
					"id": 740090157,
					"content": "Oh ... gitu ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090160
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090160,
					"content": "Kami sudah menemukan markas Virgil dan teman-temannya. Bagaimana kalau kita ketemu di sana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090161,
						740090165
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090161,
					"content": "Kenapa kami juga pergi ...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090162
					]
				},
				{
					"id": 740090162,
					"content": "#{M#Tuan yang terhormat}{F#Nona yang manis}! Virgil sudah membuat kalian kena masalah. Kami tidak mungkin ... bicara dengan dia tanpa kasih tahu rencana kami kepada kalian berdua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090163
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090163,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090164
					],
					"speakerTitle": "Luca"
				},
				{
					"id": 740090164,
					"content": "Lihat, Luca juga setuju kan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090166
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090166,
					"content": "Huh, Paimon juga mau ngomong sama Virgil! Dia harus minta maaf ke kita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090167
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090167,
					"content": "Hahaha, kamu terlalu baik hati. Kita nanti ketemu di tempat tujuan ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090165,
					"content": "Baik, ayo pergi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090166
					]
				},
				{
					"id": 740090158,
					"content": "Paimon enggak paham hal-hal ini juga enggak apa-apa kok ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090159
					]
				},
				{
					"id": 740090159,
					"content": "#Hidup di dunia akan sangat membosankan kalau kamu tahu terlalu banyak. Benar tidak, {M#tuan yang terhormat}{F#nona yang manis}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090160
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090135,
					"content": "Apa kalian ada urusan sampai cari kami?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090136
					]
				}
