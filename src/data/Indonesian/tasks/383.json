					"nextDialogs": [
						3830208
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3830208,
					"content": "Ini benar-benar sulit dipercaya kalau tidak lihat dengan mata kepala sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830209
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3830209,
					"content": "Menarik. Prosesnya serupa dengan proses penyaringan anggur, terasa ... menyegarkan.",
