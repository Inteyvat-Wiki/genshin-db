			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aigouy"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740911701,
					"content": "Ngapain habiskan waktumu lakukan kerjaan pemeliharaan itu kalau ada orang lain yang bisa bantuin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911702,
						740911706
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740911702,
					"content": "Tentang dermaga ini ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740911703
					]
				},
				{
					"id": 740911703,
					"content": "Ada banyak sekali jalur pipa di Benteng Meropide, jadi tentu saja harus ada yang mengurusnya, kan? Nah itu kerjaan kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911704
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740911704,
					"content": "Biasanya sih cuma perbaikan biasa, atau tambalin ini itu. Lagi pula kalau ada masalah besar, memangnya aku bisa apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911705
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740911705,
					"content": "Aku cuma lakuin yang aku mampu. Seperti bantu orang antar surat ke kota kalau lagi senggang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740911706,
					"content": "Terima kasih untuk waktumu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740911707
					]
				},
				{
					"id": 740911707,
					"content": "Oh, waktuku banyak kok. Aku tidak sibuk sedikit pun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aigouy"
				}
			]
		}
	]
}