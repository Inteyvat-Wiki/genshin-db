			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Aigouy"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740910101,
					"content": "Anak itu, dia tidak tertangkap Hilichurl terus direbus sama mereka kan ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910102,
						740910103
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740910102,
					"content": "Anak yang mana?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740910105
					]
				},
				{
					"id": 740910105,
					"content": "Tuh, kamu lihat tidak Hilichurl yang kemah dekat air di sana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910106
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740910106,
					"content": "Kok rasanya kayak tiba-tiba muncul gitu. Mereka kerja terus-terusan tanpa kenal lelah. *huff* Sama seperti Balent, dasar anak bodoh itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910107
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740910107,
					"content": "Kalau dari yang kulihat sih, dia beruntung, jadi mungkin sekarang dia tidak ada di dalam panci. Mungkin dia lagi ngobrol santai sama para Hilichurl itu. Bisa jadi, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910108
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740910108,
					"content": "Hah? Jadi maksudmu seseorang yang kamu kenal dibawa sama para Hilichurl ke sana? Kok kamu enggak khawatir sama sekali? Kalau memang kejadiannya gitu, kita harus cepat selamatin dia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740910109,
					"content": "Selamatin dia? Kenapa? Aku sudah bilang ke dia tidak perlu memaksakan diri melakukan pekerjaan bahaya begitu. Laporkan saja ke Estienne terus biar dia cari orang buat urus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910110
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740910110,
					"content": "Aku sudah baik-baik ajari dia, terus apa balasannya? Dia malah nuduh aku tidak serius dan mengabaikan tanggung jawab.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910111
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740910111,
					"content": "Karena dia sendiri tidak menganggap pengalaman dan kebijaksanaan yang lebih tua dengan lebih serius, jadi ya itu semua pilihannya sendiri. Toh anak muda sudah biasa dihajar dan babak belur. Bagaimana caranya mereka tumbuh dewasa jika tidak belajar beberapa hal dulu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910112,
						740910113
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740910112,
					"content": "Susah menilai kalau tidak mendengar kisah dari dua belah pihak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740910114
					]
				},
				{
					"id": 740910114,
					"content": "Iya betul, ayo selamatin dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740910115,
					"content": "Di sana bahaya! Gimana kalau kalian anak muda terluka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910116
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740910116,
					"content": "#Santai! {NICKNAME} kuat banget kok! Kakek tunggu saja di sini! Kami bakal langsung balik kok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740910113,
					"content": "Dia bisa saja dalam bahaya, kalau kamu mati juga tidak bisa tambah dewasa dong.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740910114
					]
				},
				{
					"id": 740910103,
					"content": "Sup apaan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740910104
					]
				},
				{
					"id": 740910104,
					"content": "Bukan itu poinnya!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910105
					],
					"speakerTitle": "Paimon"
				}
			]
		},
