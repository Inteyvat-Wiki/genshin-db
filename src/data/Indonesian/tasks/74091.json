						740911303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740911303,
					"content": "Aku ... sepertinya ... baik-baik saja ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911304
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740911304,
					"content": "Dari tampilanmu sih enggak oke banget.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740911305
					]
				},
				{
					"id": 740911305,
					"content": "Ayo cepat kembali ke dermaga sama kami!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
