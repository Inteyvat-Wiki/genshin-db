					"Balent"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740911001,
					"content": "Kami sudah balik nih! Iya betulan loh ada masalah kecil, tapi enggak usah khawatir! Sudah kami beresin pakai instruksi yang kamu kasih barusan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740911002,
					"content": "Terima kasih banyak atas bantuanmu. Kalau kamu tidak memperbaikinya tepat waktu, hal tersebut berpotensi menimbulkan risiko keamanan, nanti begitu sadar, sudah terlambat untuk kita memperbaikinya, malah jadi bencana yang lebih besar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911003
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740911003,
					"content": "Itulah kenapa aku tidak begitu setuju dengan pandangan Monsieur Aigouy, walaupun aku tahu dia juga perhatian sekali padaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911004
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740911009,
					"content": "Yah pokoknya, terima kasih karena sudah menyelamatkanku, dan membantuku dengan penyelidikannya. Nih, ambil ini sebagai tanda terima kasih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911010
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740911010,
					"content": "Maaf karena merepotkanmu dan menahan perjalananmu. Kuharap kalian berdua selalu selamat di perjalanan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Balent"
				}
			]
		},
