			"dialogs": [
				{
					"id": 220010101,
					"content": "Little Meng, hari ini giliranku menjadi kapten kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010102
					],
					"speakerTitle": "Little Fei"
				},
				{
					"id": 220010102,
					"content": "Little Lulu, aku sudah menjadi kapten selama berhari-hari. Sekarang kita seharusnya membiarkan Little Fei mendapat giliran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010103
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 220010103,
					"content": "Tapi Little Meng, kamu adalah kapten yang terbaik! Aku ingin kamu terus menjadi kapten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010104
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 220010104,
					"content": "Kalian sedang apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010105
					]
				},
				{
					"id": 220010105,
					"content": "Kakak, kami sedang akan memainkan sebuah permainan. Mereka awalnya menjanjikanku untuk menjadi kapten kali ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010106
					],
					"speakerTitle": "Little Fei"
				},
				{
					"id": 220010106,
					"content": "Tapi Little Lulu mengatakan kalau permainan akan lebih seru kalau Little Meng yang menjadi kaptennya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010107
					],
					"speakerTitle": "Little Fei"
				},
				{
					"id": 220010107,
					"content": "Duh... Little Lulu selalu begitu. Tapi kalau memang dia merasa begitu, maka apa boleh buat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010108
					],
					"speakerTitle": "Little Fei"
				},
				{
					"id": 220010108,
					"content": "Apakah kakak punya waktu untuk bermain? Kakak bisa menjadi bajak laut!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010109,
						220010111
					],
					"speakerTitle": "Little Fei"
				},
				{
					"id": 220010109,
					"content": "Baiklah...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010110
					]
				},
				{
					"id": 220010110,
					"content": "Lagi-lagi aku menjadi pelayan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010113
					],
					"speakerTitle": "Little Fei"
				},
				{
					"id": 220010113,
					"content": "Seperti biasa, kakak kemarilah kalau sudah siap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Little Fei"
				},
				{
					"id": 220010111,
					"content": "Aku ingin menjadi orang baik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010112
					]
				},
				{
					"id": 220010112,
					"content": "Ah, aku benar-benar mau menjadi kaptennya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010113
					],
					"speakerTitle": "Little Fei"
				}
			]
		},
