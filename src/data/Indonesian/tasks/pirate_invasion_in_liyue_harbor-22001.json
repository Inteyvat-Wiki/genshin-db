			"dialogs": [
				{
					"id": 220010301,
					"content": "Di sini kak! Kapten ada di sini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010302
					],
					"speakerTitle": "Little Fei"
				},
				{
					"id": 220010302,
					"content": "Kenapa kamu membawa bajak laut ke sini?! Kamu seharusnya membawanya menjauh sehingga aku dan Little Lulu punya waktu untuk melarikan diri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010303
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 220010303,
					"content": "Kenapa kamu dan Little Lulu boleh kabur, sedangkan aku harus tetap di sini untuk menghadang bajak laut?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010304
					],
					"speakerTitle": "Little Fei"
				},
				{
					"id": 220010304,
					"content": "Aku punya ide yang lebih bagus, aku serahkan bajak laut kepadamu, lalu aku yang bawa Little Lulu melarikan diri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010305
					],
					"speakerTitle": "Little Fei"
				},
				{
					"id": 220010305,
					"content": "Kamu... Kakak Beidou pernah mengatakan kalau kita tidak boleh mengkhianati teman kita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010306
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 220010306,
					"content": "Oh? Apa kakak Beidou pernah berkata kapten seharusnya melarikan diri bersama orang kesayangannya saat ada masalah menghadang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010307
					],
					"speakerTitle": "Little Fei"
				},
				{
					"id": 220010307,
					"content": "Kamu... Aku tidak akan berbagi Lotus Head denganmu lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010308
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 220010308,
					"content": "BAIK! Aku juga tidak butuh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010309
					],
					"speakerTitle": "Little Fei"
				},
				{
					"id": 220010309,
					"content": "Kenapa kalian malah bertengkar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220010310,
					"content": "Jangan khawatir kak, aku ada cara untuk mengatasinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010311
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 220010311,
					"content": "Lotus Head adalah makanan kesukaan mereka. Makanan enak akan menenangkan amarah mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010312
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 220010312,
					"content": "Apa kamu bisa membantuku mencari Lotus Head?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010313,
						220010315
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 220010313,
					"content": "Baik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010314
					]
				},
				{
					"id": 220010314,
					"content": "Terima kasih, cepat pergi cepat kembali ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 220010315,
					"content": "Sepertinya makanan kesukaan mereka bukan Lotus Head...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010316
					]
				},
				{
					"id": 220010316,
					"content": "Oh ya? Kalau begitu, apa makanan kesukaan mereka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010317
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 220010317,
					"content": "Pokoknya, carilah beberapa Lotus Head. Kita tidak bisa membiarkan mereka terus bertengkar seperti ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Little Lulu"
				}
			]
