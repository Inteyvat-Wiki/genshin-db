			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Venti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3750101,
					"content": "Ah, sesuai dugaan, kamu juga tidak berhasil ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750102
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750102,
					"content": "Se ... sesuai dugaan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3750103,
					"content": "#Aku hanya penasaran saja, berapa besar pengaruh {NICKNAME} – sang bintang baru dari Knights of Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750104
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750104,
					"content": "Lihat, seorang petarung terbaik harus menggunakan pedang terbaik juga, dan lihatlah kita ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750105
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750105,
					"content": "Cerita ini, cocok untuk dibuat menjadi lagu, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750106
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750106,
					"content": "Sebenarnya apa yang mau kamu bilang? Kami kurang hebatkah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3750107,
					"content": "Bu, bukan itu maksudku. Ini adalah perumpamaanku tentang ketidakmampuan Mondstadt untuk melihat sesosok pejuang yang bahkan sudah berdiri di depan matanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750108
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750108,
					"content": "Baiklah kalau begitu. Sepertinya kita tidak bisa mendapatkannya dengan cara baik-baik, terpaksa kita harus mencurinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750109
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750110,
					"content": "....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3750111
					]
				},
				{
					"id": 3750109,
					"content": "Hari ini mari kita junjung asas-asas kebebasan! Kalian punya ide bagaimana kita harus mencurinya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750110
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750112,
					"content": "Aku tidak ingin mencuri!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3750113
					]
				},
				{
					"id": 3750111,
					"content": "Ayo, suarakan pendapatmu sekarang. Itulah gunanya kehendak bebas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750112
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750113,
					"content": "Hahaha ayolah, jangan kalah sebelum bertanding.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750114
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750114,
					"content": "Kukatakan sejujurnya, kamu lebih cocok melakukan ini daripadaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750115
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750115,
					"content": "Karena selain menyanyi, aku tidak punya bakat lain lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750116
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750116,
					"content": "Lagi pula, tidak ada yang bisa kuandalkan di Mondstadt kalau mereka menganiayaku karena mendapatiku mencuri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750117
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750117,
					"content": "Ya memangnya kamu mau mengandalkan siapa juga kalau jelas-jelas sudah tertangkap basah saat mencuri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3750118,
					"content": "#Tapi lain halnya denganmu, {NICKNAME}. Kamu bukan saja berjasa besar di Mondstadt, tetapi juga bintang baru Knights of Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750119
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750119,
					"content": "Kalau kamu sampai tertangkap, kamu bisa bernegosiasi dengan mudahnya supaya dibebaskan dari masalah itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750120
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750140,
					"content": "Penjaga-penjaga di sini, sepertinya mereka sedang tidak berjaga malam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750141,
					"content": "Kalau kita berhasil memanfaatkan kesempatan ini, seharusnya langkah-langkah selanjutnya tidaklah sulit ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750120,
					"content": "Jangan bahas-bahas terus kalau kita tertangkap dong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3750122,
					"content": "Tunggu ... tadi kamu bilang, kamu adalah Barbatos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3750123
					]
				},
				{
					"id": 3750121,
					"content": "#Hahaha, {NICKNAME} ... bagaimana menurutmu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750122
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750123,
					"content": "Ah iya, sepertinya tadi aku sempat bilang begitu ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750124
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750125,
					"content": "Kalau kamu memang dewa, kami tidak bisa meninggalkanmu begitu saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3750126
					]
				},
				{
					"id": 3750124,
					"content": "Lalu maksudmu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750125
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750126,
					"content": "Kenapa keputusanmu harus bergantung pada apakah aku seorang dewa atau bukan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750127
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750128,
					"content": "Ya tapi kalau kamu bukan dewa pun, aku tetap akan menolong Dvalin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3750129
					]
				},
				{
					"id": 3750127,
					"content": "#Paimon bakal jelasin tentang latar belakang dan kisah {NICKNAME} kalau waktu yang kita punya pas ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3750130,
					"content": "Aku akan mengambilkan Holy Lyre itu untukmu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 3750131,
					"content": "Karena aku tidak ingin lagi menyaksikan perpisahan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 3750129,
					"content": "Hah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750130,
						3750131
					],
					"speakerTitle": "Venti"
				}
			]
		},
