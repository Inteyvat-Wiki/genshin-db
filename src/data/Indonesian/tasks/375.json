			"dialogs": [
				{
					"id": 3750202,
					"content": "Hah, bosan sekali! Setiap hari harus berdiri di sini <color=#00E1FFFF>sepanjang hari</color> untuk menjaga pintu masuk ini.\\nHei! Jangan bergerak! Kamu tidak boleh masuk ke sana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750203
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 3750203,
					"content": "Sepertinya menyelinap di <color=#00E1FFFF>malam hari</color> lebih mudah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
