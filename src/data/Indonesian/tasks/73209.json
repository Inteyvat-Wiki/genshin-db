			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Affan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732090601,
					"content": "Asalkan beberapa tanaman ini bisa tumbuh sehat, kita nantinya bisa membudidayakan mawar emas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090602
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732090602,
					"content": "Tapi sebelum itu, aku harus lihat dulu mawar-mawar emas ini bermekaran supaya aku bisa tenang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				}
			]
		},
		{
			"id": 7320907,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320908",
							"2"
						],
						"stepId": 7320908,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Affan",
					"Sabbah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732090701,
					"content": "Aku hampir putus asa, tapi tanpa disangka-sangka bisa tumbuh juga akhirnya. Selama kita hidup, ternyata keajaiban mungkin saja bisa tetap terjadi ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090702
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732090702,
					"content": "Nona kecil, apa kamu masih sedih soal Paman Shafaqat? Jangan khawatir. Orang yang masih hidup harus melanjutkan angan-angan mereka yang telah tiada. Dengan begitulah, kita tidak akan membuat mereka kecewa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090703
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732090703,
					"content": "Tuan Affan ... Aku sudah tidak muda lagi. Teman-teman sebayaku, anak-anak mereka mungkin sudah cukup besar untuk pergi membeli rempah-rempah ke toko.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090704
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090704,
					"content": "Tapi aku setuju. Berhubung kita masih hidup, sebaiknya kita melanjutkan hidup ini dengan bahagia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabbah"
				}
			]
		}
	]
}