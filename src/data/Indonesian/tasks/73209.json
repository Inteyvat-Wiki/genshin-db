					"Affan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732090426,
					"content": "\"Mawar oh mawar, kabulkanlah permintaanku.\"",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732090427
					]
				},
				{
					"id": 732090427,
					"content": "\"Bunga mekar dari batu, Mawar Emas bernyanyi untukku.\"",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732090401
					]
				},
				{
					"id": 732090401,
					"content": "Ternyata mawar emas memang indah ya. Perasaan Paimon jadi lebih enak sesudah lihat mereka bermekaran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732090402,
					"content": "Usaha keras beberapa hari ini enggak sia-sia. Paimon senang banget!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090403,
						732090404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732090403,
					"content": "Permohonan kita akhirnya terkabul juga.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732090405
					]
				},
				{
					"id": 732090405,
					"content": "Akhirnya ada sesuatu yang berhasil kulakukan. Paman Shafaqat, harapanmu sudah kupenuhi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090406
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732090406,
					"content": "Sayang dia tidak melihatnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090407
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090407,
					"content": "Jangan berkata seperti itu, Sabbah. Apa kamu masih ingat penggalan terakhir dari lagu itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090408
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732090408,
					"content": "\"Aku tidak terikat di dataran mana pun, aku pergi ke mana pun lagu membawaku.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090409
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732090409,
					"content": "\"Nyanyianlah yang menentang nasibku, dialah yang menundukkan takdirku.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090410
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732090410,
					"content": "\"Melampaui diriku, melampaui waktu. Bahkan melampaui hidup yang terus layu.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090411
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732090411,
					"content": "Jiwa Paman Shafaqat bersama dengan mawar emas dan lagu yang ditulisnya sendiri akan tetap bersama kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090412
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732090412,
					"content": "Iya betul. Dia orang yang berhasil melawan waktu dan takdir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090413
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090413,
					"content": "Terima kasih sudah membuatku tahu tentang dirinya. Bagiku ini sangatlah penting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090414
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090414,
					"content": "Dia diasingkan lebih dulu daripada aku. Melihat jejak hidupnya, aku merasa seolah-olah sedang melintasi ruang dan waktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090415
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090415,
					"content": "Yang kulihat tidak hanya Tuan Shafaqat, tapi juga diriku sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090416
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090416,
					"content": "Walaupun tidak banyak yang bisa kukatakan tentangnya, tapi aku bisa hidup dengan membawa angan-angannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090417
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090417,
					"content": "Kalau aku membawa sebagian darinya untuk terus hidup, pada akhirnya aku akan bisa menyelamatkan diriku sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090418,
						732090419
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090418,
					"content": "Semoga kamu bahagia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732090420
					]
				},
				{
					"id": 732090420,
					"content": "Aku rasa hidupku di sini sudah tidak buruk lagi. Senang rasanya bisa bertemu dengan kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090421
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090421,
					"content": "Meskipun mawar bisa membawa kebahagiaan, tapi kita harus berusaha menanam lebih banyak lagi bunga mawarnya, Tuan Affan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090422
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090422,
					"content": "Hahaha! Oke, janji ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090423
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732090423,
					"content": "Iya, aku akan berusaha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090419,
					"content": "Jangan bersedih begitu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732090420
					]
				},
				{
					"id": 732090404,
					"content": "Hasilnya tidak mengkhianati semua usaha kita.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732090405
					]
				}
			]
		},
