			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Sabbah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732090101,
					"content": "Eh kalian, kami dan mawar-mawar ini sudah menunggu kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090102
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732090102,
					"content": "Sabbah juga datang lebih awal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732090103,
					"content": "Akhir-akhir ini aku sering ke sini. Catatan yang ditinggalkan Tuan Shafaqat juga sudah berkali-kali kubaca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090104
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090104,
					"content": "Dulu aku selalu merasa sangat kesepian waktu tinggal di Desa Aaru. Tapi sekarang tidak lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090105
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090105,
					"content": "Setidaknya aku tidak benar-benar seorang diri. Masih ada mawar-mawar ini, kenangan bersama kalian, dan juga Tuan Affan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090106
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090106,
					"content": "Masih ada angan-angan indah yang ada di hidupku ini. Aku tidak lagi merasa kesepian kalau bisa berpikir seperti ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090107
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090107,
					"content": "Sudah kudiskusikan dengan Tuan Affan kalau aku akan membantunya menjaga mawar emas ini mulai sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090108
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090108,
					"content": "Akan kubuat supaya mereka bermekaran dan memenuhi pembibitan ini. Untuk sekarang, biarkan beberapa berbunga dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090109
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090109,
					"content": "Apa kamu ingat bagaimana aku membuat mawar Sumeru bermekaran? Ayo kita pakai cara yang sama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090110
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090110,
					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732090111
					]
				},
				{
					"id": 732090111,
					"content": "Oke, selanjutnya terserah kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabbah"
				}
			]
		},
		{
