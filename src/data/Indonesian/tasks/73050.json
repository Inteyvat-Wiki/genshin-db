			"dialogs": [
				{
					"id": 730500201,
					"content": "#Nara {NICKNAME} dan Paimon! Penjahat yang bikin Vana sakit tidak bakal datang lagi. Tenang deh sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500202
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730500202,
					"content": "#Terima kasih ya Nara {NICKNAME} dan Paimon atas bantuannya, Ararycan jadi bisa melindungi Vana lagi ... nih, Ararycan kasih bunga lagi buat kalian!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500203
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730500203,
					"content": "Terima bunganya ya, teman-teman Ararycan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ararycan"
				}
			]
