			"dialogs": [
				{
					"id": 730500301,
					"content": "Festival Utsava ... kok rasanya tidak asing ya ... Eh? Si putih terbang ... dan Nara Emas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500302
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730500302,
					"content": "Itu teman Nara-ku, dan temannya teman Nara-ku. Selamat bersenang-senang di Festival Utsava.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500303
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730500303,
					"content": "Temannya teman juga teman! Nara Emas dan si putih terbang semuanya teman Aragaru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aragaru"
