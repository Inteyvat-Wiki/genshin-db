			"dialogs": [
				{
					"id": 710370301,
					"content": "Ah, kalian sudah kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370302
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370302,
					"content": "Paman He meninggalkan beberapa petunjuk.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370303
					]
				},
				{
					"id": 710370303,
					"content": "Oh? Jadi dia benar-benar meninggalkan sesuatu ya! Ayo cepat kasih tahu aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370306
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370306,
					"content": "Kamu memberi tahu Jinwu semua informasi yang barusan kamu dapatkan.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710370304
					]
				},
				{
					"id": 710370304,
					"content": "Umm ... Magma Hitam ... Lumenstone ... dan jamur?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370305
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370305,
					"content": "Hmm ... aneh, aku sepertinya pernah lihat benda ini sebelumnya. Kita jangan berlama-lama di sini deh, yuk kembali ke kemah dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinwu"
				}
			]
		},
		{
			"id": 7103704,
			"completionStepIds": [
				7103711
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
