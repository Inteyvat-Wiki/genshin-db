			"dialogs": [
				{
					"id": 710370501,
					"content": "#Ah, {NICKNAME} sudah datang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370502,
						710370510
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370502,
					"content": "Jinwu titip pesan ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370503
					]
				},
				{
					"id": 710370503,
					"content": "Pasti dia mau ngomong soal keselamatan lagi, kan? Ugh ... aku sudah bosan dengarnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370504
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370504,
					"content": "Aku juga kan tumbuh di daerah sekitar penambangan, bagaimana mungkin aku tidak tahu bahayanya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370505
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370505,
					"content": "Kalaupun ada hal-hal yang belum diketahui, para senior juga kan biasanya selalu suka menggunakan pengalamannya untuk menilai apakah itu berbahaya atau tidak ... dan kemudian hasilnya itu bisa jadi bukti apakah pengalamannya berguna atau tidak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370506
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370506,
					"content": "Aku bosan dengar kesombongan mereka ... Sebagai seorang petualang yang lebih senior dariku, kamu paham maksudku, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370507
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370507,
					"content": "Kalau Kak Iris berhasil membuatmu urung mendaki Dragonspine cuma dengan bicara soal protokol keamanan, pasti akan banyak sekali petualangan luar biasa yang jadi terlewatkan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370508
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370508,
					"content": "Oke — tidak usah debat denganku, aku juga tidak mau debat tentang urusan sepele begini. Ayo kita ganti topik saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370509
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370509,
					"content": "Jadi seperti yang terlihat, aku sedang menjelajahi medan di sini untuk memetakannya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370512
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370512,
					"content": "Hanya saja ... Saat aku menjelajahi tambang di area sebelumnya, jalan di depan terhalang oleh beberapa hal aneh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370513
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370513,
					"content": "Bagian Urusan Sipil dan Adventurers' Guild pasti bakal senang kalau bisa dapat sampel atau dapat foto petanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370514
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370514,
					"content": "Sayang sekali ... Kameraku tidak sengaja rusak ketika aku sedang menambang, jadi aku hanya bisa mengandalkanmu saja, hehe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370515
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370515,
					"content": "Ada lokasi lain ... nah, di sini dan di sini, ada jejak dari Treasure Hoarder ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370516
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370516,
					"content": "Apa ... Paimon sama sekali enggak ngerti di sini di sana itu di mana sih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710370517,
					"content": "Kamu cuma gambar garis dan beberapa tanda silang saja ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370518
					]
				},
				{
					"id": 710370518,
					"content": "Haha, maaf, maaf ... Aku sudah biasa begini jadi aku lupa bahwa tidak semua orang memiliki intuisi sebagai seorang kartografer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370519
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370519,
					"content": "Tapi tak apa-apa, biar aku pandu kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370520
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370520,
					"content": "Kita bisa ke beberapa lokasi ini dulu, jadi pilih saja mana pun yang kamu suka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370521,
						710370522
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370521,
					"content": "Kalau begitu, yuk berangkat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 710370522,
					"content": "Kita harus tetap hati-hati di jalan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370523
					]
				},
				{
					"id": 710370523,
					"content": "Terima kasih atas perhatiannya! Aku paham kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370510,
					"content": "Kamu lagi apa di sini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370511
					]
				},
				{
					"id": 710370511,
					"content": "Eh ... Kan tadi aku sudah bilang, aku di sini sedang menjelajahi medan di sekitar untuk menggambar petanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370512
					],
					"speakerTitle": "Zhiqiong"
				}
			]
		},
