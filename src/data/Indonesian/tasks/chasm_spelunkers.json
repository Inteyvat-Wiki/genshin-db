						710370902
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370902,
					"content": "Tapi untuk saat ini, aku harus menunggu regu transportasi di atas untuk menurunkan semua alat-alat, untuk sementara kalian bebas menjelajah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinwu"
				}
			]
		},
		{
