			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhiqiong",
					"Jinwu",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710370101,
					"content": "Fiuh, hawanya tak asing ya! Sudah lama rasanya sejak terakhir kali aku menginjakkan kaki di tambang ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370102
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370102,
					"content": "Jangan sampai ceroboh, Qiong. Aku mencium bau yang asing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370103
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370103,
					"content": "Maksudnya, kita tidak bisa main loncat begitu saja kan. Mungkin kita cuma jadi bingung saja gara-gara melihat derek yang berayun-ayun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370104
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370104,
					"content": "Kamu ... Kamu menghabiskan terlalu banyak waktu di atas sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370105
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370105,
					"content": "Kok Paimon tidak bisa mencium bau apa pun sih, kalian para penambang punya penciuman yang tajam ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710370106,
					"content": "Haha, kalau penciumanmu kurang, kamu bisa mati di sini. Tapi sekarang masih aman sih, tuh burung pipit saja masih ramai berkicau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370107
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370107,
					"content": "Lihat, kristalnya sampai ke daerah sini ... terakhir kali padahal belum sampai sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370108
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370108,
					"content": "Wow, iya benar! Ayo kita lihat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370109
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370109,
					"content": "Huh ... kamu mencuri kata-kata Paimon ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7103702,
			"completionStepIds": [
				7103704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103704",
							"2"
						],
						"stepId": 7103704,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jinwu",
					"Zhiqiong",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710370201,
					"content": "Ternyata Lumenspar bisa muncul di lokasi yang begitu dekat ke permukaan. Aku selama ini mengira kalau benda ini tidak akan ada di lokasi yang lebih rentan secara struktural.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370202
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370202,
					"content": "Mereka adalah fragmen dari \"benda\" di bawah tanah yang bermigrasi di sepanjang Ley Line dan berakhir di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370203
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370203,
					"content": "Hei! Jangan ngawur. Mereka aslinya adalah bebatuan dari area lokal sini, dan mereka jadi begini karena mereka telah mengalami semacam transformasi dan membentuk jadi sebuah kristal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370204
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370204,
					"content": "Para Qixing mempercayakan kami untuk menganalisanya ... Sebagian besar bahan masih merupakan mineral lokal di dalam jurang berbatu, tapi ... karena dipengaruhi oleh kekuatan eksternal, berubah menjadi kristal aneh begini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370205
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370205,
					"content": "#Lihat sebelah sana! Kristal itu mirip sama Adjuvant yang kamu punya {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710370231,
					"content": "#{NICKNAME}, keluarin Lumenstone Adjuvant-nya coba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710370232,
					"content": "Benar. Adjuvant terbuat dari bahan yang sama dengan kristal ini. Karena itulah formasi ini akan bereaksi satu sama lain secara alami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370206,
						710370207
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370206,
					"content": "Aneh sekali ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370208
					]
				},
				{
					"id": 710370208,
					"content": "Hah, masa kamu cuma bisa bilang gitu sih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710370209,
					"content": "Sudah, kalian berdua jangan bertengkar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370210
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370210,
					"content": "Siapa yang berantem ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370211
					]
				},
				{
					"id": 710370211,
					"content": "#{NICKNAME} dan Paimon enggak bertengkar kok ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710370212,
					"content": "Maksudku, aku tidak peduli kalian bertengkar atau tidak. Zhiqiong dan aku akan mendirikan kemah sementara di depan. Jadi tolong jangan berpencar terlalu jauh ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370213
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370213,
					"content": "Kristal yang baru saja kita temukan sangat berguna untuk penjelajahan dan pencarian berikutnya, dan kalau kamu menemukan sesuatu lagi, tolong langsung kasih tahu aku ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370214
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370214,
					"content": "Kemampuanku masih belum berkarat, aku bisa menghaluskan dan membentuk kristal ini untukmu, ini pasti berguna untuk perjalananmu selanjutnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370215
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370215,
					"content": "Lalu ... jangan bertengkar lagi ya, oke?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370216
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370216,
					"content": "Iya, iya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710370217,
					"content": "Iya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370218
					]
				},
				{
					"id": 710370218,
					"content": "Bagus, nanti aku kasih kalian permen. Omong-omong, kalau kamu menemukan sesuatu yang aneh di sekitar, langsung kasih tahu aku ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370219
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370219,
					"content": "Oh ya, kamu ingat tidak waktu terakhir kali Kak Jinwu cerita soal Paman He ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370220
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370220,
					"content": "#Aku tidak lupa kok. Sekarang karena di sini ada {NICKNAME}, tolong bantu aku lagi ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370221
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370221,
					"content": "Paman He adalah penambang senior kami, dulu waktu Millelith mengevakuasi para penambang, dia adalah salah satu dari orang yang hilang ... Pendengarannya tidak bagus, jadi mungkin dia tidak dengar peringatannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370222
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370222,
					"content": "Uang pensiun dari Huishan Hall dan Shenglu Hall jumlahnya cukup besar, keluarganya juga sudah mengurus persiapan pemakamannya dari dulu ... Aku bukan orang yang terlalu percaya pada hal-hal yang sifatnya supernatural, tapi aku punya firasat kalau dia ada di bawah sana dan masih hidup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370223
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370223,
					"content": "Dia adalah penambang senior. Dia tahu banyak soal bagaimana menghindari bencana di dalam penambangan, bagaimana melarikan diri, bagaimana menunggu bala bantuan tiba, dan sebagainya ... Dia tahu segalanya. Dia bahkan mengajariku banyak hal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370224
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370224,
					"content": "Jadi aku percaya walau setelah sekian lama, dia pasti masih hidup ... aku tidak akan menyerah untuk mencarinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370225
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370225,
					"content": "Aku akan mengarahkanmu ke beberapa tempat. Itu adalah tempat di mana Paman He dulu bekerja sebelum para penambang dievakuasi ... Mungkin kita bisa menemukan beberapa petunjuk di sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370226
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370226,
					"content": "Aku masuk duluan ya buat menyelidiki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370233
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370233,
					"content": "Oh ya, jangan lupa permen kamu nih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370227,
						710370229
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370227,
					"content": "Loh kamu bukannya mau pergi bareng kita?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370228
					]
				},
				{
					"id": 710370228,
					"content": "Dia juga masih harus bikin peta buat kita. Struktur Chasm itu kompleks sekali, kalau tanpa peta pasti tak mungkin deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370229,
					"content": "Hati-hati.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370230
					]
				},
				{
					"id": 710370230,
					"content": "Jangan khawatir, aku bukan amatiran kok. Tidak perlu khawatirkan aku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370207,
					"content": "Menakjubkan ya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370208
					]
				}
			]
		},
