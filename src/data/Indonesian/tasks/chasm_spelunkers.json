				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710370401,
					"content": "Eh harusnya di sini ... aneh, Zhiqiong pergi ke mana sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370402
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370402,
					"content": "Hei! Zhiqiong! Zhiqiong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370403
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370403,
					"content": "*huff* Bocah itu pasti pergi ke dalam tambang untuk menggambar peta lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370404,
						710370405
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370404,
					"content": "Kenapa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370407
					]
				},
				{
					"id": 710370407,
					"content": "Dia gambar peta ini setelah kamu pergi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370408
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370408,
					"content": "Dia pasti sudah turun menjelajah lebih dalam. Tolong kasih tahu kalau di depan itu bahaya, dia jangan pergi seenaknya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370409
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370409,
					"content": "Kalau sampai ada apa-apa, dan kita semua kena, Kak Jinwu tidak akan tinggal diam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370410
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370410,
					"content": "Wuih ... galak ya dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710370411,
					"content": "Iya, galak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370412
					]
				},
				{
					"id": 710370412,
					"content": "Baiklah. Kurangi ngobrolnya, dan lebih banyak beraksi. Kalian jangan diam saja. Cepat bantu aku mendirikan kemah, atau pergi ke depan untuk periksa jalan-jalannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370413
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370413,
					"content": "Maaf saja ya kalau aku bukan orang yang terlalu banyak basa-basi. Aku cuma ingin bisa berguna saja buat semuanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370414
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370414,
					"content": "Oh iya, kalau di jalan kamu menemukan Lumenstone mentah tolong berikan padaku ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370415
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370415,
					"content": "Aku akan cari cara untuk mengolahnya menjadi Adjuvant yang lebih efektif. Menurut pengalamanku, benda ini akan sangat berguna di bawah sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370405,
					"content": "Apa Zhiqiong dalam bahaya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370406
					]
				},
				{
					"id": 710370406,
					"content": "Sekarang sih belum, tapi kalau dia terus-terusan pergi ke sana kemari tanpa bilang dulu padaku, dia nanti bisa saja berada dalam bahaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370407
					],
					"speakerTitle": "Jinwu"
				}
			]
		},
