			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nermin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230410201,
					"content": "Ugh ... lagi-lagi daunnya digigit lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410202
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410202,
					"content": "Apa yang terjadi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410203
					]
				},
				{
					"id": 230410203,
					"content": "Pengembara, lihat deh! Kucing kecilnya datang dan gigit bunganya lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410204
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410204,
					"content": "Coba lihat daun ini, ini ... terus yang ini! Semuanya digigit besar sekali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410205,
						230410208
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410205,
					"content": "Anak kucing, lapar, ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410206
					]
				},
				{
					"id": 230410206,
					"content": "Raef juga bilang begitu, dia selalu bawa makanan ke mana-mana untuk dikasih makan kucing ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410207
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410207,
					"content": "Tapi besoknya, tetap masih ada juga kucing gigit bunganya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410210
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410210,
					"content": "Sekarang kucing kecil cuma gigit daun, tapi aku takut suatu hari nanti dia akan mulai gigit tangkai bunga ... Kalau benar, gawat dong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410211
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410211,
					"content": "Tapi, aku tidak tega usir dia jauh-jauh. Lagi pula, di luar sana semua padang pasir. Selain desa ini, dia tidak punya tempat lain lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410212
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410212,
					"content": "Pengembara, apa kamu bisa bantu aku kasih dia makan lagi? Semoga setelah kenyang, dia tidak gigit-gigit daun lagi. Daun kan juga tidak enak ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410213,
						230410214
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410213,
					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410216
					]
				},
				{
					"id": 230410216,
					"content": "Kalau begitu, tolong ya, Pengembara. Aku akan menandai di petamu tempat si kucing biasa istirahat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410217
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410217,
					"content": "Aku akan jaga di sebelah pot bunga ini supaya tidak ada anak kucing lain yang gigit bunganya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410214,
					"content": "Aku suka sekali bermain dengan kucing.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410215
					]
				},
				{
					"id": 230410215,
					"content": "Baguslah kalau begitu! Setiap kali aku lihat cakar si kucing kecil ini, aku selalu takut dia tiba-tiba loncat ke atas dan mencakarku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410216
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410208,
					"content": "Kucing kecil ... iseng-iseng gigit ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410209
					]
				},
				{
					"id": 230410209,
					"content": "Aku tidak paham lagi deh si kucing ini suka main apa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410210
					],
					"speakerTitle": "Nermin"
				}
			]
		},
