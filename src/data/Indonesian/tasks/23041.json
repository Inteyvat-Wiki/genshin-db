					"Nermin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230410101,
					"content": "Fiuh ... Oke, tanahnya sudah digemburkan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410102
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410102,
					"content": "Kamu masih merawat bunga itu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410103
					]
				},
				{
					"id": 230410103,
					"content": "Iya. Nenek Kulsoom mengajariku banyak hal tentang merawat bunga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410104
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410104,
					"content": "Menggemburkan tanah, merapikan daun, membasmi hama dengan berbagai cara ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410105
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410105,
					"content": "Dan tidak boleh terlalu banyak siram air. Akarnya bisa mati kalau terendam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410106
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410106,
					"content": "Padahal tadinya aku kira harus disiram terus setiap hari ... supaya tanahnya tidak kering.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410107
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410107,
					"content": "Bagus sih, aku jadi tidak usah repot-repot menimba air setiap hari. Sumurnya jauh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410108
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410108,
					"content": "Pengembara, aku harus rapikan daun. Boleh tolong ambilkan air?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410109
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410109,
					"content": "Aku sudah bilang kepada Kazan, dia juga sudah setuju untuk mengambil air untuk siram tanaman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410110,
						230410111
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410110,
					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410114
					]
				},
				{
					"id": 230410114,
					"content": "Pot airnya ada di sana. Hati-hati ya waktu ambil air, jangan sampai ada terlalu banyak lumpur dan pasir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410111,
					"content": "Semua ini nenek Kulsoom yang bilang kepadamu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410112
					]
				},
				{
					"id": 230410112,
					"content": "Hm ... kurang lebih seperti itu, Nenek Kulsoom kan tahu banyak hal. Aku sering minta saran dari dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410113
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410113,
					"content": "Kalau begitu aku serahkan padamu, Pengembara. Tolong bawakan satu pot air ke sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410114
					],
					"speakerTitle": "Nermin"
				}
			]
		},
