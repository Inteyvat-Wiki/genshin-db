			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nermin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230410301,
					"content": "Pengembara, kamu datang di waktu yang tepat. Cepat sini cicip Minty Bean Soup buatanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410303
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410303,
					"content": "Bahan-bahan ini ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410304
					]
				},
				{
					"id": 230410304,
					"content": "Ada yang aku mintai tolong belinya, tapi untuk Mint-nya sih ... aku tanam sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410305
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410305,
					"content": "Raef kan ada kirimkan sepaket peralatan berkebun dan pupuk, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410306
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410306,
					"content": "Kalau cuma tanam satu pot bunga, aku rasa sih boros sekali ya ... Jadi, aku meminta tolong Azalai untuk bantu belikan beberapa biji Mint.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410307
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410307,
					"content": "Setelah tanam bibit Mint, aku merawat tanaman itu sama kayak aku merawat pot bunganya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410308
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410308,
					"content": "Setelah dirawat cukup lama, daun Mint akhirnya tumbuh besar dan baik ... dan akhirnya mekar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410309
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410309,
					"content": "Jadi aku petik sedikit untuk dibuat Minty Bean Soup. Bagaimana? Rasanya enak, kan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410310
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410310,
					"content": "Nah ... karena kamu sudah minum Minty Bean Soup buatanku, berarti kamu sudah utang sama aku. Sekarang, aku perlu bantuan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410311,
						230410312
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410311,
					"content": "Loh, kok? Habis saja belum ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410313
					]
				},
				{
					"id": 230410313,
					"content": "Jangan dong! Aku bercanda saja, pasti akan aku berikan imbalan yang setimpal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410314
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410314,
					"content": "Aku cuma mau minta kamu bantu aku petikkan tiga Zaytun Peach, Raef suka sekali makan buah itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410315
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410315,
					"content": "Aku ingin tambahkan ke dalam Minty Bean Soup, terus diberikan untuk Raef.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410316
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410316,
					"content": "Aku sekarang sudah bisa buat Minty Bean Soup, cuma perlu cari orang bantu aku ambilkan Zaytun Peach saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410317,
						230410319
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410317,
					"content": "Aku tahu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410318
					]
				},
				{
					"id": 230410318,
					"content": "Terima kasih ya, nanti setelah kamu kembali, aku akan kasih kamu satu mangkuk Minty Bean Soup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410321
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410321,
					"content": "Kalau begitu, tolong ya, Pengembara. Setelah dapat Zaytun Peach, bawakan kepadaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410319,
					"content": "Memangnya dia bisa minum waktu lagi bekerja?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410320
					]
				},
				{
					"id": 230410320,
					"content": "Cuma minum sedikit saja deh, pekerjaannya kan tidak terlalu sibuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410321
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410312,
					"content": "Ini aku kembalikan!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410313
					]
				}
			]
