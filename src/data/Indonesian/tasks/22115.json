			"trigger": {
				"objectNames": [
					"Nenek Ruoxin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221150101,
					"content": "*uhuk* Little Chang... kenapa masih belum pulang juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150102
					],
					"speakerTitle": "Nenek Ruoxin"
				},
				{
					"id": 221150102,
					"content": "Siapa Little Chang?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150103
					]
				},
				{
					"id": 221150103,
					"content": "Little Chang, yang biasa kalian sebut sebagai Chang the Ninth.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150104
					],
					"speakerTitle": "Nenek Ruoxin"
				},
				{
					"id": 221150104,
					"content": "*uhuk* Aku terbiasa memanggilnya Little Chang, sejak dulu selalu memanggilnya begitu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150105
					],
					"speakerTitle": "Nenek Ruoxin"
				},
				{
					"id": 221150105,
					"content": "Kemarin malam, dia bilang akan pergi melakukan penelitian untuk novelnya, aku tidak berpikir macam-macam, aku hanya bilang padanya jangan pulang terlalu malam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150106
					],
					"speakerTitle": "Nenek Ruoxin"
				},
				{
					"id": 221150106,
					"content": "Tapi, sampai sekarang dia masih belum pulang juga. Aku sungguh khawatir sesuatu terjadi padanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150107
					],
					"speakerTitle": "Nenek Ruoxin"
				},
				{
					"id": 221150107,
					"content": "Tapi aku sudah tua begini, tidak bisa pergi untuk mencarinya. Dapatkah kalian berdua membantuku untuk mencari Little Chang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150108,
						221150110
					],
					"speakerTitle": "Nenek Ruoxin"
				},
				{
					"id": 221150108,
					"content": "Serahkan pada kami!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150109
					]
				},
				{
					"id": 221150109,
					"content": "Bagus sekali, terima kasih banyak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nenek Ruoxin"
				},
				{
					"id": 221150110,
					"content": "Apa kamu tahu dia pergi ke mana?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150111
					]
				},
				{
					"id": 221150111,
					"content": "*huff* Dia pasti pergi ke Wuwang Hill, arah utara dari sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150112
					],
					"speakerTitle": "Nenek Ruoxin"
				},
				{
					"id": 221150112,
					"content": "Tolong pergi dan temukan dia. Dia sudah pergi begitu lama, semoga saja tidak terjadi sesuatu padanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nenek Ruoxin"
				}
			]
		},
		{
			"id": 2211502,
