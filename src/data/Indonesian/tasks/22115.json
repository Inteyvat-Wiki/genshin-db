					"Chang the Ninth"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221150501,
					"content": "*huff* Bagaimana aku bisa menulis novel yang bagus ya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150502
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 221150502,
					"content": "Apa kamu menjatuhkan ini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150503
					]
				},
				{
					"id": 221150503,
					"content": "Apa? Oh... benar itu milikku. Tapi aku tidak suka apa yang kutulis, jadi kubuang saja ke sungai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150504
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 221150504,
					"content": "Kalian membawanya kembali... tapi tulisan-tulisan ini sudah tidak begitu jelas sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150505
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 221150505,
					"content": "Kamu menulis apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150506
					]
				},
				{
					"id": 221150506,
					"content": "Oh, ini cerita tentang seorang gadis yang kukenal waktu kecil. Ini merupakan konsep awal tapi tidak begitu bagus. Ah, gadis itu... kamu tidak tahu seperti apa dia ketika kami masih kecil. Dia terus-menerus mendesakku untuk membacakan cerita untuknya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150507
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 221150507,
					"content": "Sayangnya, aku tidak punya banyak waktu untuk menulis pada waktu itu. Aku menulis awal cerita itu untuknya lalu berjanji pada diriku sendiri bahwa aku akan menulis sisanya saat ada waktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150508
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 221150508,
					"content": "Tapi suatu hari dia menghilang, aku tidak bisa menemukannya di mana-mana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150509
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 221150509,
					"content": "Huh, pasti karena keluarganya, aku yakin sekali. Mereka tidak pernah menyukaiku dan mereka tidak mau dia berurusan denganku. Jadi diam-diam mereka pergi dari Desa Qingce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150510
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 221150510,
					"content": "Lihat saja nanti, begitu aku menjadi terkenal, mereka tidak akan pernah melihatku dengan cara yang sama lagi! Begitu aku menyelesaikan cerita yang kutuliskan untuknya, ini pasti akan terjual di seluruh dunia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150511
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 221150511,
					"content": "Dengan begitu, mereka akan melihatku di mana pun mereka berada di dunia ini! Mereka akan lihat bahwa aku bukan Chang the Ninth yang dulu lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150512
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 221150512,
					"content": "Lalu... aku pasti akan bertemu dengannya lagi... tapi pertama-tama, aku harus mulai menulis dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150513
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 221150513,
					"content": "... Maaf, aku malah berceloteh yang tidak-tidak. *huff* Aku juga masih memikirkan bagaimana cara menulis novel yang bagus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chang the Ninth"
				}
			]
		},
