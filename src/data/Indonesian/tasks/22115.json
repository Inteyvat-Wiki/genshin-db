					"Chang the Ninth"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221150201,
					"content": "Huh... sekelompok monster ini benar-benar menjengkelkan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150202
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 221150202,
					"content": "Aku datang hanya untuk mendapatkan inspirasi untuk novelku... bukannya mendapatkannya, aku malah terjebak dengan para monster ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150203
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 221150203,
					"content": "Terima kasih banyak, jika bukan karena kalian, aku tidak tahu lagi harus bagaimana untuk bisa keluar dari sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150204
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 221150204,
					"content": "Nenek Ruoxin khawatir sekali padamu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150205
					]
				},
				{
					"id": 221150205,
					"content": "Mengkhawatirkanku? Tidak perlu khawatir, aku sudah dewasa dan tahu cara menjaga diri. Sebenarnya aku bisa saja menghadapi mereka, hanya saja itu cukup melelahkan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150206
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 221150206,
					"content": "Tapi, terima kasih atas bantuan kalian... aku harus segera kembali, kalau tidak nenek pasti akan terus-menerus mengomel padaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chang the Ninth"
				}
			]
		},
		{
			"id": 2211503,
			"completionStepIds": [
				2211505
			],
