			},
			"dialogs": [
				{
					"id": 221150301,
					"content": "Lalu dia malah pergi begitu saja... hmm, sebaiknya kita juga pulang saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 221150302,
					"content": "Eh? Sepertinya ada sesuatu di lantai... Apakah Chang the Ninth tanpa sengaja menjatuhkannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 221150303,
					"content": "Hm... ayo kita lihat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
