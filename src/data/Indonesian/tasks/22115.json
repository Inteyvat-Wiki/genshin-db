			"dialogs": [
				{
					"id": 221150601,
					"content": "Oh, Little Chang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150602
					],
					"speakerTitle": "Nenek Ruoxin"
				},
				{
					"id": 221150602,
					"content": "Little Chang sudah pulang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150603
					]
				},
				{
					"id": 221150603,
					"content": "Oh, aku sudah bertemu dengannya, sungguh terima kasih banyak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150604
					],
					"speakerTitle": "Nenek Ruoxin"
				},
				{
					"id": 221150604,
					"content": "Dia sejak kecil selalu begini, suka membuat masalah di mana-mana. Selalu mengatakan bahwa dia sudah dewasa, ah sebenarnya dia tidak pernah tumbuh dewasa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150605
					],
					"speakerTitle": "Nenek Ruoxin"
				},
				{
					"id": 221150605,
					"content": "Baiklah, jangan khawatir, ini urusannya Little Chang sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150606
					],
					"speakerTitle": "Nenek Ruoxin"
				},
				{
					"id": 221150606,
					"content": "Terima kasih banyak, kalian telah membawanya kembali. Tolong terimalah ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150607
					],
					"speakerTitle": "Nenek Ruoxin"
				},
				{
					"id": 221150607,
					"content": "Kalian masih punya urusan sendiri, jadi aku tidak akan menahan kalian lebih lama lagi. Tapi tolong jangan seperti Little Chang, dia begitu fokus akan pandangan orang tentang dirinya sehingga dia tidak pernah sempat melihat dirinya sendiri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150608
					],
					"speakerTitle": "Nenek Ruoxin"
				},
				{
					"id": 221150608,
					"content": "Ah... manusia bukanlah Adeptus... dan apalah arti kehidupan fana selain penderitaan singkat yang terjadi sebelum kematian?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nenek Ruoxin"
				}
			]
		},
