			},
			"dialogs": [
				{
					"id": 401730301,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730302
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730302,
					"content": "(Berengsek, dia kabur! Aduh, parah ... kenapa aku harus sok-sokan segala sih? Duh, ini sih jadi kelihatan bodoh sekali ....)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730303
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730303,
					"content": "(Kokuchuu ini mahir betul melarikan diri. Tapi tidak boleh bilang gitu. Cari alasan lain, cari alasan lain ....)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730304
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730304,
					"content": "Citlali! Gimana, sudah ketangkep?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730305,
					"content": "Cuma ada Nenek di sini ... artinya, gagal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730306
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730306,
					"content": "Aku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730307
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730307,
					"content": "Aku ... lepasin dia. Untuk sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730308
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730308,
					"content": "Tapi dia sudah ditandai! Jadi kalau balik lagi, aku bisa lacak semua gerakannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730309
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730309,
					"content": "Oh, jadi Nenek cuma pura-pura pergi dari gua ... padahal sudah bikin jebakan lain di dalam sambil nunggu dia balik lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730310
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730310,
					"content": "Ah, persis kayak pas nangkep Ororon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730311,
					"content": "Tapi tahu dari mana si Kokuchuu bakal nongol di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730312,
					"content": "Karena umpannya aku taruh di sini. Peta Mare Jivari dan pecahan busur dua-duanya ada di meja tuh. Firasatku bilang dua itu yang sebenarnya dia incar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730313
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730313,
					"content": "Dan betul kan, jebakanku langsung terpicu tak lama setelah kita pergi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730314
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730314,
					"content": "Jadi kamu BENERAN pasang jebakan di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730315,
					"content": "Ya iyalah. Cuma khusus untuk kalian, jebakannya enggak akan berefek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730316
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730316,
					"content": "Tuh kan, apa kataku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730317
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730317,
					"content": "Jadi Pak Kokuchuu memang manfaatin aku ya ... selama ini, dia cuma ingin tahu lokasi Mare Jivari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730318
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730318,
					"content": "Betul. Aku penasaran sama pecahan yang dia tinggal begitu saja. Kenapa dibiarin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730319
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730319,
					"content": "Begitu aku mendapatkan lokasi Mare Jivari, semuanya jadi jelas. Itu cuma umpan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730320
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730320,
					"content": "Dia memang ingin agar roh Leyla tersesat supaya ditolong sama orang suku. Lalu ketika kita menolong Leyla, kita secara tidak sadar juga membantu dia ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730321
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730321,
					"content": "Oh, jadi dia juga mancing! Rencananya supaya ada cenayang betulan yang kepancing, lalu menerawang ke pecahannya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730322,
					"content": "Iya, dan ada yang melahap umpan itu bulat-bulat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730323
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730323,
					"content": "Maaf, aku yang kena umpan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730324
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730324,
					"content": "Tapi Nenek juga kena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730325
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730325,
					"content": "Eh, kurang ajar! Aku cuma terlibat gara-gara kamu, bocah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730326
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730326,
					"content": "Intinya kita bergerak di telapak tangan Kokuchuu. Tujuannya tercapai tanpa risiko sama sekali untuknya. Licik juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730327
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730327,
					"content": "Setuju banget! Kebayang tuh kalau dia nyamperin Citlali langsung. Pasti langsung ketahuan niatnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730328
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730328,
					"content": "Tapi ya ... Citlali, kenapa dia dibiarin lepas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730329,
					"content": "Uhhh ... karena aku enggak bisa pakai kekuatan penuh di sini. Dia orangnya licin, kalau aku tahan dia di sini secara paksa, kan takut ada konsekuensi yang tidak diinginkan juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730330
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730330,
					"content": "Salah aku lagi ya karena milih tempat ini? Maaf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730331
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730331,
					"content": "Aku cari tempat yang kekuatan spiritualnya cukup tinggi waktu pertama mau tolong Leyla, makanya jadi pilih tempat persembunyian si pertapa sinting ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730332
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730332,
					"content": "Pertapa sinting?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730333
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730333,
					"content": "Iya, dia tidur di balik tembok itu. Nanti jadi timbul masalah beda lagi kalau dia sampai bangun, makanya aku tidak pakai kekuatan penuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730334
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730334,
					"content": "Tapi kabar baiknya, aku berhasil mengamankan peta dan pecahannya sebelum dia kabur. Aku menahan diri itu betul, tapi bukan berarti dia boleh seenaknya menginjak-nginjak aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730335
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730335,
					"content": "Keren! Jadi dia pergi dengan tangan hampa, HA!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730336
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730336,
					"content": "Yah, kurang lebih ... kabar buruknya, dia sempat lihat petanya sebelum kabur. Lokasi terakhir Mare Jivari memang bukan rahasia sih, tapi tetap saja ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730337
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730337,
					"content": "Iya, agak meresahkan juga kalau dipikirin. Rencana busuk apa yang ada di otaknya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730338
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730338,
					"content": "Tenang, aku akan terus lacak dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730339
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730339,
					"content": "#Oh, kalau Leyla mau, aku berniat kasihin peta dan pecahan ini ke {NICKNAME} sebagai hadiah. Mungkin bisa berguna ketika dia melanjutkan perjalanan ke depannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730340
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730340,
					"content": "#Oh, jelas tidak keberatan! {NICKNAME} sangat layak dikasih itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730341
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730341,
					"content": "Yakin? Murah hati banget nih hadiahnya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401730342
					]
				},
				{
					"id": 401730342,
					"content": "Ehh, tidak ada satu pun dari kami yang tertarik sama itu kok. Dan kalau memang benar barang-barang ini bisa menuntun kamu ke Mare Jivari ... petualang mana sih yang mau melewatkan kesempatan seperti itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730343
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730343,
					"content": "Nenek Itztli peka kok soal beginian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730344
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730344,
					"content": "Ah, Nenek Itztli ... mau tanya dong, apa sekarang ini aku masih termasuk bodoh rohani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730345
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730345,
					"content": "Pertanyaan konyol macam apa sih? Kamu tadi bisa lihat ilusiku, benar? Ya, memang sih karena aku sengaja bikin ilusinya tidak sempurna, tapi ya, orang yang bodoh rohani tidak mungkin bisa lihat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730346
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730346,
					"content": "Ororon, ajarin dia kalau kamu senggang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730347
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730347,
					"content": "Leyla, belajarlah yang giat. Kita lihat sejauh apa kamu bisa berkembang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730348
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730348,
					"content": "Luar biasa ... hidup memang penuh kejutan. Asalkan kita terus maju, siapa tahu di depan ketemu sekantong pupuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730349
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730349,
					"content": "Aku turut bahagia, Leyla. Kita usahakan yang terbaik, siapa tahu suatu hari nanti kita bisa tumbuh jadi kol yang gendut-gendut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ororon"
				}
			]
		},
