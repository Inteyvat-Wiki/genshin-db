			"dialogs": [
				{
					"id": 401730101,
					"content": "Halo lagi, semua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730102
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730102,
					"content": "Citlali datang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730103,
					"content": "Aku sudah pinjam pedang upacara dari kepala suku, kekuatannya diperlukan untuk situasi seperti ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730104
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730104,
					"content": "Kalian belum lupa hari ini kita ngapain, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730105
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730105,
					"content": "Ya ingat lah, kita mau bangunin si Leyla! Terus ... tanya sebenarnya dia mau ngapain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730106,
					"content": "Dan aku sudah menyiapkan alat-alat yang dibutuhkan untuk upacaranya sesuai perintah Nenek. Semua hal di daftar sudah dicoret, jadi harusnya ini lancar ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730107
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730107,
					"content": "Kerja bagus, nak. Oke, kita langsung saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730108
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730108,
					"content": "Citlali memanggil pedang upacara \"Calamity of Eshu\" di depan tubuh Leyla.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401730109
					]
				},
				{
					"id": 401730109,
					"content": "Persembahan dari kepulan asap batiniah, yakni bintang di malam yang kelam, beserta untaian mimpi dalam pusaran angin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730110
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730110,
					"content": "Kemuliaan bagi dia Yang Berkuasa Atas Kematian. Pudarlah, pudarlah, pudarlah. Tiga kali diucap, tiga kali diulang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730111
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730111,
					"content": "Wah ... itu mantra? Kenapa tiba-tiba jadi dingin gini? Apa yang terjadi?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730112,
					"content": "Kecilkan suaramu. Jangan ganggu nenek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730113
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730113,
					"content": "Kamilah putra-putri sang raja pandita, yang bersumpah demi perjanjian kuno untuk mengoyakkan tirai buana malam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730114
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730114,
					"content": "Namaku Citlali, dengarkanlah perintahku. Akulah sang gembala di hari penghakiman, akulah Ah K'ulbatil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730115
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730115,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730116
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730116,
					"content": "Lihat! Roh Leyla sudah kembali. Dia menghampiri tubuhnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730117
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730117,
					"content": "Aku menusuk tirai malam dengan batu pemantik, usirlah semua jiwa yang tidak berdiam di Kerajaan Malam.\\n",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730118
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730118,
					"content": "Leyla! Patuhi perintahku, kembalilah ke dunia yang disinari terik mentari! Kembalilah ke jalanmu yang seharusnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730119
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730119,
					"content": "Be-Berhasil kah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730120,
					"content": "Ah ... eh? Di mana ini? Siapa ....?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730121
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730121,
					"content": "AAAH! Ne-Nenek Itztli! EH, Imam Besar Citlali! Mohon belas kasihan! Mohon belas kasihan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730122
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730122,
					"content": "Oh, merasa bersalah ya? Jadi kamu tahu apa yang telah kamu perbuat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730123
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730123,
					"content": "Tahu tidak? SEDIKIT lagi kamu tidak akan bisa pulang untuk selamanya. Atau kamu pikir hidup lebih seru ... kalau dijalani sebagai onggokan daging tak bernyawa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730124
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730124,
					"content": "A-Ampun! Mohon ampun ... aku salah, dan aku siap terima akibatnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730125
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730125,
					"content": "Oh, yakin? Kalau gitu sana, pamit sama orang tuamu. Kasih tahu mereka:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730126
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730126,
					"content": "\"Selamat tinggal Ibu dan Ayah. Ternyata hidup sebagai onggokan daging tak bernyawa seru sekali, sampai aku memutuskan untuk minta Nenek Itztli mengutukku jadi batu. Setelah itu, aku akan jadi penjaga rumahnya untuk seratus tahun ke depan!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730127
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730127,
					"content": "Tunggu, jangan! Jangan, aku mohon! Aku bersumpah tidak akan macam-macam gini lagi, janji! Sumpah! Terima kasih banyak Imam Besar Citlali yang hebat, terima kasih sudah mau menyelamatkan aku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730128
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730128,
					"content": "Hehe, jangan terima kasih sama aku. Terima kasih sana ke cucuku, kalau dia tidak merasa ada yang janggal, aku juga tidak akan peduli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730129
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730129,
					"content": "Jangan jadi tidak enak, Leyla. Terus omongan nenek tadi lupakan saja, dia galak luarnya padahal hatinya lembut. Kami senang kamu baik-baik saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730130
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730130,
					"content": "Lagian kamu ditipu orang lain juga kan? Si Kokuchuu itu. Dia dalangnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730131
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730131,
					"content": "Bukan ... Pak Kokuchuu tidak salah apa-apa. Aku yang minta tolong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730132
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730132,
					"content": "Hah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730133,
					"content": "Yah, dia memang kasih saran untuk coba pakai barang pusaka yang punya kekuatan spiritual tinggi sebagai mediumnya. Tapi aku sendiri yang memutuskan. Tidak ada paksaan sama sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730134
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730134,
					"content": "Maaf ya. Ini semua salahku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730135
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730135,
					"content": "Ha. Jago juga cuci otaknya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730136
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730136,
					"content": "Um ... jadi, benar barangnya Kokuchuu yang kasih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730137,
					"content": "Benar. Katanya itu harta karun yang berhubungan dengan Mare Jivari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730138
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730138,
					"content": "Nah, betul kan. Dia cuma manfaatin kamu! Dia bujuk kamu supaya mau menerawang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730139,
					"content": "Tapi aku kan orang yang \"bodoh rohani\" ... satu mantra saja tidak bisa, apa gunanya buat dia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730140
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730140,
					"content": "Orang kayak aku tidak bisa merasakan roh meski sudah seumur hidup meditasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730141
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730141,
					"content": "Tapi Pak Kokuchuu bilang kalau aku \"dipaksa\" pakai mantra, sambil menenggelamkan diri di zat yang kekuatan spiritualnya tinggi, aku mungkin bisa melihat sekelebat. Cuma itu satu-satunya pilihan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730142
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730142,
					"content": "Tapi orang bodoh rohani memaksa pakai mantra ... itu sih sama saja kamu dipaksa lari maraton padahal tidak punya kaki! Kalau bukan karena Citlali, kamu sudah hilang selamanya tahu enggak sih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730143
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730143,
					"content": "Iya, aku tahu ... maaf. Soalnya ... semua orang di suku ini begitu berbakat, sementara aku ... orang yang bodoh rohani. Aku cuma ingin membaur ... tidak mau lagi jadi yang beda sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730144
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730144,
					"content": "Aku paham perasaanmu, Leyla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730145
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730145,
					"content": "Ada benih yang tumbuh jadi kol subur tanpa hambatan, ada juga benih yang sudah berjuang mati-matian pun tetap gagal bertunas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730146
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730146,
					"content": "Kenapa bisa seperti itu? Entahlah. Mungkin memang hidup pada dasarnya seperti itu kan, penuh dengan hal yang tidak bisa kita ubah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730147
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730147,
					"content": "Aku tahu bicara begini tidak mengubah keadaan, tapi semoga kamu bisa merasa lebih baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730148
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730148,
					"content": "Cukup dulu ngobrolnya. Kamu perlu diperiksa Matla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Citlali"
				}
			]
		},
