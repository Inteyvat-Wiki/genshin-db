			"dialogs": [
				{
					"id": 728040406,
					"content": "Melihat napasmu yang masih stabil, para Kairagi itu memang bukan tandinganmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040407
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040407,
					"content": "Sepertinya kamu juga menang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040408
					]
				},
				{
					"id": 728040408,
					"content": "Benar, tapi sayangnya... Terakhir orang itu berpura-pura lalu kabur setelah ditikam olehku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040409
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040409,
					"content": "Tapi lukanya sangat parah. Aku rasa, dalam beberapa tahun ini dia tidak akan berbuat onar lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040410
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040410,
					"content": "Yang paling penting, aku sendiri telah mengalahkan dia dan juga merebut kembali senjataku, aku benar-benar telah membalas penghinaan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040411
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040411,
					"content": "Selamat, Asakura.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040412
					]
				},
				{
					"id": 728040412,
					"content": "Aku sungguh berterima kasih, tapi aku belum dapat bersantai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040413
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040413,
					"content": "Penyebab semua ini adalah karena kemampuan bela diriku yang kurang baik, aku akan berlatih lebih keras, meningkatkan kemampuanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040414
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040414,
					"content": "Karenanya... aku harap kamu akan sering datang dan berlatih denganku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040415
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040415,
					"content": "Oh ya, terimalah ini. Walau tidak banyak... tapi ini sebagai tanda terima kasihku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040416
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040416,
					"content": "Sekali lagi aku berterima kasih padamu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asakura"
				}
			]
		}
	]
