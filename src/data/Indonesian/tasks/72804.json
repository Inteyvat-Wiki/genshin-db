			},
			"dialogs": [
				{
					"id": 728040301,
					"content": "Kamu? Hahaha, bukankah kamu bocah yang dulu? Kenapa? Datang membawakan hadiah lagi untukku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040302
					],
					"speakerTitle": "Pemimpin \"Kairagi\""
				},
				{
					"id": 728040302,
					"content": "Aku datang untuk mengambil kembali senjataku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040303
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040303,
					"content": "Ya... boleh juga, kamu cukup berani. Tapi berani menerobos ke sini hanya dengan bantuan 1 orang sepertinya kamu meremehkanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040304
					],
					"speakerTitle": "Pemimpin \"Kairagi\""
				},
				{
					"id": 728040304,
					"content": "Tapi, melihat keberanianmu, aku akan memberimu kesempatan. Ayo maju! Kita bermain-main di samping.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040305
					],
					"speakerTitle": "Pemimpin \"Kairagi\""
				},
				{
					"id": 728040305,
					"content": "Tapi... Anak buahku tidak boleh menganggur. Bukankah kamu membawa bantuan? Biarkan dia menemani mereka bermain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040306,
						728040307
					],
					"speakerTitle": "Pemimpin \"Kairagi\""
				},
				{
					"id": 728040306,
					"content": "Dengan senang hati.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040308
					]
				},
				{
					"id": 728040308,
					"content": "Hahaha, sombong sekali. Anak-anak, siksa baik-baik orang bodoh ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040309
					],
					"speakerTitle": "Pemimpin \"Kairagi\""
				},
				{
					"id": 728040309,
					"content": "Kamu, kita pergi ke samping.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040310
					],
					"speakerTitle": "Pemimpin \"Kairagi\""
				},
				{
					"id": 728040310,
					"content": "Kalau begitu kuserahkan padamu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040311
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040311,
					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040312
					]
				},
				{
					"id": 728040312,
					"content": "Terima kasih banyak. Aku akan segera menghabisi dia, lalu kembali membantumu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040313
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040313,
					"content": "Sombong sekali perkataanmu, jika ingin menghabisiku, coba saja sendiri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pemimpin \"Kairagi\""
				},
				{
					"id": 728040307,
					"content": "Takutnya aku tidak puas bermain.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040308
					]
				}
			]
		},
