			},
			"dialogs": [
				{
					"id": 728040206,
					"content": "Aduh! Tuan besar yang baik, mohon ampun! Dari mana kamu menemukan bantuan ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040207
					],
					"speakerTitle": "\"Kairagi\""
				},
				{
					"id": 728040207,
					"content": "Penjahat! Sekarang kembalikan senjata itu padaku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040208
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040208,
					"content": "Kamu, ternyata kamu masih mengingat senjata itu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040209
					],
					"speakerTitle": "\"Kairagi\""
				},
				{
					"id": 728040209,
					"content": "Aku hanya ingin mengambil kembali senjataku, beri tahu aku di mana, aku akan melepaskanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040210
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040210,
					"content": "Ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040211,
						728040212
					],
					"speakerTitle": "\"Kairagi\""
				},
				{
					"id": 728040211,
					"content": "Jangan buang waktu dengannya lagi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040213
					]
				},
				{
					"id": 728040213,
					"content": "Aduh! Mohon ampun, Tuan! Kenapa kasar sekali, aku tidak bilang tidak mau mengatakannya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040214
					],
					"speakerTitle": "\"Kairagi\""
				},
				{
					"id": 728040214,
					"content": "Se-senjata itu, disimpan oleh pemimpin kita. Jika kamu ingin mengambilnya, cari saja dia di dalam kemah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040215
					],
					"speakerTitle": "\"Kairagi\""
				},
				{
					"id": 728040215,
					"content": "*hmph* Sepertinya kamu tahu sesuatu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040216
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040216,
					"content": "Jadi dua orang di sana, dan yang ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040217
					],
					"speakerTitle": "\"Kairagi\""
				},
				{
					"id": 728040217,
					"content": "Enyah!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040218
					]
				},
				{
					"id": 728040218,
					"content": "Siap, Nona!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040219
					],
					"speakerTitle": "\"Kairagi\""
				},
				{
					"id": 728040219,
					"content": "Kemampuannya biasa saja, tapi pandai melarikan diri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040220
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040220,
					"content": "Tidak ragu-ragu mengkhianati teman sendiri...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040221
					]
				},
				{
					"id": 728040221,
					"content": "Kairagi adalah sekelompok orang yang berkumpul demi keuntungan, tidak ada kesetiaan atau pun kepercayaan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040222
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040222,
					"content": "Saat menemui masalah, reaksi pertama adalah menjilat lawan dan kabur, ini hal yang biasa terjadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040223
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040223,
					"content": "Tapi, ini juga karena ada dirimu yang memberi tekanan padanya. Jika tidak, dia tidak akan menyerah semudah itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040224
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040224,
					"content": "Tapi berikutnya, kita harus langsung menuju kemah utama Kairagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040225
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040225,
					"content": "Sesuai dengan rencana sebelumnya, aku akan langsung menghabisi pemimpin mereka, sisanya aku serahkan padamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040226,
						728040227
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040226,
					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040228
					]
				},
				{
					"id": 728040228,
					"content": "Kalau begitu mohon bantuannya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040227,
					"content": "Aku sendiri bisa mengalahkan 10 orang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040228
					]
				},
				{
					"id": 728040212,
					"content": "Lebih baik kita cari orang berikutnya...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040213
					]
				}
			]
		},
