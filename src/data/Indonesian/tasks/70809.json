			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lohen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708090501,
					"content": "Oh? Mana lihat coba. Hmm, konsepnya cukup bagus, aku beri nilai enam dari sepuluh untuk kreativitasnya. Kalau dari sisi praktisnya ... dapat nilai empat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090502
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 708090502,
					"content": "I-Ini rencana tindak kejahatan ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708090503,
					"content": "Haha, lucunya, aku berangkat dari markas karena dengar kabar soal orang yang lagi susun \"rencana\" aneh-aneh di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090504
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 708090504,
					"content": "Tapi setelah baca ini, rasanya aku paham sih kenapa bisa ada berita kayak gitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090505
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 708090505,
					"content": "Ini aku sita deh, buat jaga-jaga. Nanti kalau senggang, kalian mainlah ke markas. Siapa tahu bakal ada tontonan menarik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lohen"
				}
			]
		}
	]
}