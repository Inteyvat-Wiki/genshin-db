					}
				]
			},
			"dialogs": [
				{
					"id": 708090301,
					"content": "(Di dalam sarangnya ada banyak sobekan kertas berserakan. Sepertinya ada tulisannya, sudah patah-patah, namun masih bisa terlihat ....)",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						708090302
					]
				},
				{
					"id": 708090302,
					"content": "Sengaja disobekin buat dibikin sarang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708090303,
					"content": "Ada tulisannya tuh. Mau coba disusun sampai kebaca isinya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708090304,
					"content": "Mau enggak mau mesti susun sendiri ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708090305
					]
				},
				{
					"id": 708090305,
					"content": "Eh, masa kamu enggak kepo sama sekali sih? Siapa tahu ini peta harta karun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708090306,
					"content": "Sambil ditemani Paimon yang nyerocos terus di sebelahmu, sobekan kertas di sarang akhirnya berhasil disusun.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						708090307
					]
				},
				{
					"id": 708090307,
					"content": "Saatnya sudah tiba! Ini ... ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708090308,
					"content": "HAH? Ini rencana busuk apa lagi? Ada yang mau bikin jahat ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090309,
						708090311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708090309,
					"content": "Penjahat sebodoh apa yang rencananya berantakan gara-gara burung?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708090310
					]
				},
				{
					"id": 708090310,
					"content": "Wo-Woi, banyak loh kejadian kayak gini di novel! Rencana yang harusnya anti gagal, tapi terus jadi berantakan gara-gara sesuatu yang sama sekali enggak diantisipasi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708090313,
					"content": "Kita ke tempat minum sekitar sini deh. Siapa tahu ada berita apa soal orang yang lagi nyusun rencana busuk ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708090311,
					"content": "Mending cari aman lah ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708090312
					]
				},
				{
					"id": 708090312,
					"content": "Iya kan! Gimana ... gimana kalau memang ada yang punya rencana jahat? Kan enggak bagus juga kalau dibiarin dan keburu jadi perkara sampai enggak bisa diurus lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090313
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7080904,
