				"objectNames": [
					"Uchida Kotaro"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708090401,
					"content": "Ini ... ini metode kejahatanku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090402
					],
					"speakerTitle": "Uchida Kotaro"
				},
				{
					"id": 708090402,
					"content": "#{NICKNAME}! Dia langsung ngaku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708090403,
					"content": "Bukan, bukan gitu! Tolong jangan salah paham, ini cuma ide cerita buat novel baruku. Aku nulis ini dalam kondisi agak mabuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090404
					],
					"speakerTitle": "Uchida Kotaro"
				},
				{
					"id": 708090404,
					"content": "Pas bangun, di mejaku tidak ada apa-apa. Kirain cuma mimpi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090405
					],
					"speakerTitle": "Uchida Kotaro"
				},
				{
					"id": 708090405,
					"content": "Makasih loh sudah nemuin ini. Akhirnya novelku bisa dilanjutkan. Nanti kalau sudah terbit, kalian dapat edisi spesial yang ada tanda tangannya deh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Uchida Kotaro"
				}
			]
		},
		{
			"id": 7080905,
			"completionStepIds": [
				7080906
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
