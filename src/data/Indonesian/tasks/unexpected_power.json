			"dialogs": [
				{
					"id": 3532801,
					"content": "Ooh! Barusan kamu ngerasain \"elemen\" dunia ini ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3532802,
					"content": "Padahal kamu cuma pegang patungnya doang, tapi bisa langsung dapat kekuatan Anemo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3532803,
					"content": "Di dunia ini ada banyak orang yang ingin punya kekuatan, tapi enggak ada yang dapatnya segampang kamu ih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532804,
						3532807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3532804,
					"content": "Sepertinya aku tahu kenapa. Soalnya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3532805
					]
				},
				{
					"id": 3532805,
					"content": "Aha! Soalnya kamu memang bukan asli dari dunia ini kan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3532809,
					"content": "Dari sini terus saja ke barat, dan kita akan sampai ke Mondstadt, Kota Kebebasan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532817
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3532817,
					"content": "Mondstadt disebut juga Kota Angin, karena warganya memuja dewa Anemo~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3532810,
					"content": "Jadi, karena kamu dapat kekuatan dari dewa Anemo, mungkin kamu bisa dapat petunjuk di sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3532811,
					"content": "#Di sana ada banyak penyair. Siapa tahu salah satunya ada yang tahu tentang {M#adik}{F#kakak}mu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3532812,
					"content": "Sip, ayo gerak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3532813,
					"content": "Kekuatan elemen di dunia ini menjawab doamu. Paimon pikir sih itu pertanda baik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3532807,
					"content": "Wah, sesat nih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3532808
					]
				},
				{
					"id": 3532808,
					"content": "\"Sesat\"? Baru dapat kekuatan dari dewa kok malah ngomong gitu, gak sopan woi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532809
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
