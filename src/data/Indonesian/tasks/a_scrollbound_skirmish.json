			"dialogs": [
				{
					"id": 755100101,
					"content": "Meskipun Pejuang Bertopeng tidak bisa terbang bebas seperti si Penengah, dia tinggal menerjang saja kalau ingin menang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100102
					],
					"speakerTitle": "Pinecone Kecil"
				},
				{
					"id": 755100102,
					"content": "Bodoh! Bisa lari lurus dan cepat itu tidak usah diperhitungkan! Kalau tidak bisa belok, atau tidak ada sasaran yang kena ... APA GUNANYA?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100103
					],
					"speakerTitle": "Figur Flammabomb Wood"
				},
				{
					"id": 755100103,
					"content": "Sudah, sudah. Boleh dong diskusinya ingat adab dan tata krama?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100104
					],
					"speakerTitle": "Vigee"
				},
				{
					"id": 755100104,
					"content": "Enggak kok ... Kami lagi ngobrolin pejuang-pejuang yang keren dan kuat! Makanya jadi membara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100105
					],
					"speakerTitle": "Figur Flammabomb Wood"
				},
				{
					"id": 755100105,
					"content": "Kak Vigee tenang saja! Perang juga mesti pakai akal sehat dan bukti kalau mau menang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100106
					],
					"speakerTitle": "Pinecone Kecil"
				},
				{
					"id": 755100106,
					"content": "Wah, strategi baru kepikir nih. Lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100107
					],
					"speakerTitle": "Figur Flammabomb Wood"
				},
				{
					"id": 755100107,
					"content": "Lagi! Lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100108,
						755100109
					],
					"speakerTitle": "Pinecone Kecil"
				},
				{
					"id": 755100108,
					"content": "Seru amat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755100110
					]
				},
				{
					"id": 755100110,
					"content": "Halo, pelanggan baru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100111
					],
					"speakerTitle": "Vigee"
				},
				{
					"id": 755100111,
					"content": "Pengembara ya? Dari bajunya sih iya. Kita sama, hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100112
					],
					"speakerTitle": "Vigee"
				},
				{
					"id": 755100112,
					"content": "Mau coba main \"gulungan interaktif\" yang aku buat bersama anak-anak ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100113,
						755100114
					],
					"speakerTitle": "Vigee"
				},
				{
					"id": 755100113,
					"content": "Gulungan interaktif?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755100115
					]
				},
				{
					"id": 755100115,
					"content": "Gampangnya, ini kombinasi dari drama kertas Liyue, komik Inazuma, dan teknologi film Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100116
					],
					"speakerTitle": "Vigee"
				},
				{
					"id": 755100116,
					"content": "Terinspirasi dari pahlawan lokal, konsepnya sih \"tantangan antar dunia\", biar ceritanya enggak bosenin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100117
					],
					"speakerTitle": "Vigee"
				},
				{
					"id": 755100117,
					"content": "Coba saja dulu! Siapa tahu suka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100118
					],
					"speakerTitle": "Vigee"
				},
				{
					"id": 755100118,
					"content": "Boleh, mau dong.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755100119
					]
				},
				{
					"id": 755100119,
					"content": "Nah! Oke, selamat bermain!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
