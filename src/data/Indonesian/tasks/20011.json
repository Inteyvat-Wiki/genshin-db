			"dialogs": [
				{
					"id": 200110301,
					"content": "Dengan begini aku bisa pergi... Terima kasih, Pengembara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110302
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200110302,
					"content": "Penyakit Anna tidak pernah sembuh sepenuhnya. Tapi karena kita tidak punya banyak uang, aku sering datang ke sini mengumpulkan tanaman obat herbal untuknya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110303
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200110303,
					"content": "Aku berhasil mengumpulkan tanaman obat herbal yang kucari. Tapi kemudian mereka mulai menyerangku, untunglah kamu datang tepat waktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110304
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200110304,
					"content": "Terimalah ini. Aku sering menyeduhnya menjadi teh untuk Anna, batuknya menjadi lebih baik setelah meminumnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110305
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200110305,
					"content": "Sepertinya kamu juga senang bertualang, jaga dirimu baik-baik ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				}
			]
		}
