			"dialogs": [
				{
					"id": 200110201,
					"content": "Terima kasih, Pengembara...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110202
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200110202,
					"content": "Tapi penghalang jalan masih di sini, aku tidak bisa lewat,",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110203
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200110203,
					"content": "Hahaha... Aku pasti bisa melakukannya sendiri jika aku tidak bertemu dengan para Hilichurl tadi. Sekarang seluruh tubuhku kesakitan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110204
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200110204,
					"content": "Tapi untungnya tanaman obat herbal yang kukumpulkan untuk Anna tidak rusak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110205
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200110205,
					"content": "Maaf, ini memang merepotkan, tapi dapatkah kamu membantuku menyingkirkan penghalang jalan ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110206,
						200110207
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200110206,
					"content": "Tentu saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200110208
					]
				},
				{
					"id": 200110208,
					"content": "Terima kasih, aku ingin beristirahat sejenak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200110207,
					"content": "Maaf, aku masih ada urusan lain.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200110209
					]
				},
				{
					"id": 200110209,
					"content": "Anna menungguku di rumah... Kumohon, tolong bantu aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				}
			]
		},
