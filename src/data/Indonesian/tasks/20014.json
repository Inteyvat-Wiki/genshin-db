				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anthony",
					"Anna"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200140101,
					"content": "Anna, tolong pertimbangkan lagi baik-baik. Kita harus benar-benar mengambil sudut pandang jangka panjang untuk hal ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140102
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200140102,
					"content": "Sudah deh! Jangan cemaskan aku lagi! Aku akan baik-baik saja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140103,
						200140104
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140103,
					"content": "Apa kabar, Anna?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200140105
					]
				},
				{
					"id": 200140105,
					"content": "Pengembara! Kamu datang tepat waktu! Tolong bantu aku. Anna mau menjadi petualang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140106
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200140106,
					"content": "Memangnya kenapa aku tidak boleh jadi petualang? Aku sehat-sehat saja dan Paman Cyrus bilang, aku sangat cerdik dan cocok melakukan pekerjaan ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140107
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140107,
					"content": "Kamu kan baru saja sembuh?! Bagaimana kalau kamu jatuh sakit lagi? Dan lagi, orang tua kita tidak akan setuju!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140108
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200140108,
					"content": "Aku sudah bicarakan ini dengan Ayah dan Ibu. Mereka bilang, mereka akan mengizinkanku kalau aku bisa melewati ujian seleksi Adventurers' Guild.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140109
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140109,
					"content": "A-Apa!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140110,
						200140111
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200140110,
					"content": "Tenanglah, Nak ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200140112
					]
				},
				{
					"id": 200140112,
					"content": "Paman Cyrus baru saja selesai menyusun jadwal latihan beberapa hari lalu. Aku sudah berlatih beberapa hari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140113
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140113,
					"content": "Tapi isi jadwal itu semuanya tentang tugas pengamatan, mencari makanan untuk suasana darurat, cara bertahan hidup di luar, dan lain sebagainya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140114
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140114,
					"content": "Padahal kudengar juga kalau petualang sering bertempur dengan monster di alam liar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140115
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140115,
					"content": "Aku sebenarnya mau mempelajari hal itu juga, tapi aku belum menemukan orang yang bisa mengajariku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140116
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140116,
					"content": "Dan seperti yang kamu lihat sekarang, kakakku malah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140117
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140117,
					"content": "Aku tidak akan mengajarimu! Monster-monster itu sangat berbahaya! Kalaupun kamu mau pergi, kamu harus ditemani oleh petualang berpengalaman!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140118
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200140118,
					"content": "Aku sudah meminta bantuan Jack! Dia bilang dia mau membantuku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140119
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140119,
					"content": "Yang benar saja. Aku tahu si Jack itu. Dia bahkan tidak bisa menjaga dirinya sendiri, mana mungkin dia bisa menjaga kamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140120
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200140120,
					"content": "Aku sulit menemukan petualang yang berpengalaman di Guild, sementara aku juga tidak punya cukup uang untuk memasang permintaan misi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140121,
						200140122
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140121,
					"content": "Hmm. Aku saja yang temani kamu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200140123
					]
				},
				{
					"id": 200140123,
					"content": "Eh? Kamu mau membantuku? Senangnyaaa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140124
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140124,
					"content": "Kalau begitu, kakak sekarang sudah bisa tenang, kan?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140125
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140125,
					"content": "Ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140126
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200140126,
					"content": "*huff* Baiklah. Aku tahu seberapa kuat Honorary Knight kita ini. Kalau ada dia di sisimu, aku setidaknya bisa sedikit lega ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140127
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200140127,
					"content": "Tapi kamu masih harus tetap berhati-hati di luar ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140128
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200140128,
					"content": "Kamu ingat kan, yang kubilang tadi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140129
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200140129,
					"content": "Iya, iya, aku sudah ingat. Kamu sudah bilang ribuan kali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140130
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140130,
					"content": "Oke Pengembara, ayo kita berangkat sekarang! Aku sudah meminta Jack mengecek kemah yang kita tuju.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140122,
					"content": "Aku cukup yakin dengan kemampuanku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200140123
					]
				},
				{
					"id": 200140111,
					"content": "Kalau begitu, bagaimana dengan latihanmu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200140112
					]
				},
				{
					"id": 200140104,
					"content": "Kalian sedang mengobrol tentang apa, Anthony?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200140105
					]
				}
			]
		},
