			"dialogs": [
				{
					"id": 200140201,
					"content": "Wah, kamu mengalahkan semuanya tanpa menjatuhkan satu helai rambut pun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140202
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140202,
					"content": "Persis seperti yang buku panduan tulis — kamu bisa menggunakan segala macam cara untuk mengalahkan monster ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140203
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140203,
					"content": "Tapi, jujur saja, mereka masih membuatku takut saat jaraknya sedekat tadi. Untung saja ada kamu di sini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140204
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140204,
					"content": "Kamu masih perlu banyak latihan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200140205
					]
				},
				{
					"id": 200140205,
					"content": "Ya, aku tahu. Jalan untuk menjadi petualang tidaklah mudah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140206
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140206,
					"content": "Terima kasih, Pengembara! Aku akan pulang ke kota sekarang. Kakakku pasti sudah cemas setengah mati ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140207
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140207,
					"content": "Mulai sekarang, aku harus berlatih lebih keras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				}
			]
		},
