			"dialogs": [
				{
					"id": 220410101,
					"content": "Oh kamu tiba tepat waktu. Diriku baru saja mengkhawatirkan sesuatu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410102
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220410102,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220410103
					]
				},
				{
					"id": 220410103,
					"content": "Apa kamu ingat anak yang bernama Konbumaru?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410104
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220410104,
					"content": "Bocah itu pergi bermain di sekitar sini, tapi belum juga kembali. Diriku ini khawatir sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410105
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220410105,
					"content": "Tolong, bantu diriku untuk mencari Konbumaru dan bawa dia kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410106,
						220410108
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220410106,
					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220410107
					]
				},
				{
					"id": 220410107,
					"content": "Bagus. Ingat, kamu harus menemukan Konbumaru dan bawa dia kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				},
				{
					"id": 220410108,
					"content": "Apa cuma dia saja yang kabur?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220410109
					]
				},
				{
					"id": 220410109,
					"content": "Iya ... Mungkin dia kesal karena diriku sempat memarahinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410110
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220410110,
					"content": "Ah, kenapa sih anak itu tidak mau mendengar kata kucing...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410111
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220410111,
					"content": "Bagaimanapun, tolong temukan Konbumaru dan bawa dia kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
		},
