			"dialogs": [
				{
					"id": 220410301,
					"content": "Bagaimana? Apa kamu sudah menemukan Konbumaru?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410302
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220410302,
					"content": "Sudah ketemu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220410303
					]
				},
				{
					"id": 220410303,
					"content": "Tunggu, apa? Dia kabur lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410304,
						220410305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220410304,
					"content": "Aku akan membawanya lagi kembali!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220410306
					]
				},
				{
					"id": 220410306,
					"content": "Tidak, jangan mengejarnya lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410307
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220410307,
					"content": "Anak itu masih marah kepada diriku ... Biarkan diriku saja nanti yang akan memberi pelajaran kepadanya secara pribadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410308
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220410308,
					"content": "Ah, padahal dia sudah cukup umur untuk menjadi kucing dewasa. Kenapa masih keras kepala sekali sih? Apa yang harus kita lakukan jika dia mengagetkan para manusia yang datang ke kuil?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410309
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220410309,
					"content": "Benar. Ini untukmu sebagai rasa terima kasih atas bantuanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410310
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220410310,
					"content": "*huff* Kenapa anak ini tidak bisa mendengar apa kata kucing seperti Meshi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				},
				{
					"id": 220410305,
					"content": "Yah, aku tidak...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220410306
					]
				}
			]
		}
