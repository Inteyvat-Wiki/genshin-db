			"dialogs": [
				{
					"id": 762080101,
					"content": "Loh? Kayaknya ada semacam tirai transparan yang muncul di sekitar sini ... Itu dari batang pohon itu ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762080102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762080102,
					"content": "Kayaknya pohonnya lagi ngeluarin getah, terus Paimon lihat tempat ini jadi kayak batu amber gitu ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762080103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762080103,
					"content": "Berarti kita ini kayak serangga kecil yang terjebak di dalamnya ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762080104
					]
				},
				{
					"id": 762080104,
					"content": "Batu amber yang isinya kita berdua, pasti bakal jadi barang paling mahal kalau dilelang dong ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762080105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762080105,
					"content": "Kalau begitu harta karun yang jadi penutup acaranya apa dong?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762080106
					]
				},
				{
					"id": 762080106,
					"content": "Ya jelas pohon ini dong, soalnya kan dia yang buat batu amber-nya. Sayang sih, kayaknya enggak bisa dibawa pulang ....",
