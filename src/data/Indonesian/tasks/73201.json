			},
			"dialogs": [
				{
					"id": 732010101,
					"content": "Ini adalah papan pesan milik Kafe Puspa. Karena satu dan lain hal, sekarang aku yang mengurus tugas-tugas manajerial kafe. Kalau ada yang ingin disampaikan, silakan tinggalkan pesan di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pesan"
				}
			]
		},
		{
			"id": 7320102,
			"completionStepIds": [
				7320102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320102",
							"2"
						],
						"stepId": 7320102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732010201,
					"content": "\"Kisah legenda Antara akan dilanjutkan minggu ini!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010202
					],
					"speakerTitle": "Papan Pesan"
				},
				{
					"id": 732010202,
					"content": "\"Akan dibawakan oleh pendongeng langganan Kafe Puspa: Maddah! Jangan sampai kelewat ya!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010203
					],
					"speakerTitle": "Papan Pesan"
				},
				{
					"id": 732010203,
					"content": "Tuan Maddah ... Kami akan memberi Anda secangkir kopi gratis kalau Anda berhenti promosi di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pesan"
				}
			]
		},
		{
			"id": 7320103,
			"completionStepIds": [
				7320103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320103",
							"2"
						],
						"stepId": 7320103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732010301,
					"content": "\"Hehe, Gata, hehe.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010302
					],
					"speakerTitle": "Papan Pesan"
				},
				{
					"id": 732010302,
					"content": "Gata sepertinya sangat suka pada Anda, Nona Nilou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pesan"
				}
			]
		},
		{
			"id": 7320104,
			"completionStepIds": [
				7320104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320104",
							"2"
						],
						"stepId": 7320104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732010401,
					"content": "\"Puspa Card Club sedang merekrut anggota untuk 'Genius Invokation TCG'!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010402
					],
					"speakerTitle": "Papan Pesan"
				},
				{
					"id": 732010402,
					"content": "\"Kalau mau berdiskusi tentang pengaturan dan teknik dek kartu, temui aku di meja kartu!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010403
					],
					"speakerTitle": "Papan Pesan"
				},
				{
					"id": 732010403,
					"content": "Tuan Nayab, setidaknya pesan secangkir kopi kalau mau bermain kartu di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pesan"
				}
			]
		},
		{
			"id": 7320105,
			"completionStepIds": [
				7320105
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320105",
							"2"
						],
						"stepId": 7320105,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732010501,
					"content": "\"Belum lama ini terjadi beberapa kasus penyelundupan Kapsul Pengetahuan.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010502
					],
					"speakerTitle": "Papan Pesan"
				},
				{
					"id": 732010502,
					"content": "\"Pengingat khusus Matra: Silakan daftar lewat jalur yang biasa dan legal jika ingin mendapatkan ilmu pengetahuan yang kamu cari.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010503
					],
					"speakerTitle": "Papan Pesan"
				},
				{
					"id": 732010503,
					"content": "\"Ilmu terlarang yang didapatkan lewat jalur ilegal akan berakibat pencabutan hak belajar di Akademiya. Harap waspada.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pesan"
				}
			]
		},
		{
			"id": 7320106,
			"completionStepIds": [
				7320106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320106",
							"2"
						],
						"stepId": 7320106,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732010601,
					"content": "\"Suasana di sini lebih bersahabat daripada di Tavern untuk pelajar yang sedang mempersiapkan diri untuk ujian seperti diriku.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010602
					],
					"speakerTitle": "Papan Pesan"
				},
				{
					"id": 732010602,
					"content": "\"Selain ada kopi yang bisa membangkitkan semangat, aku juga bisa bertanya-tanya pada beberapa senior di sini.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010603
					],
					"speakerTitle": "Papan Pesan"
				},
				{
					"id": 732010603,
					"content": "\"Bahkan pemiliknya pun bilang kalau aku akan diterima di Akademiya tahun ini!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010604
					],
					"speakerTitle": "Papan Pesan"
				},
				{
					"id": 732010604,
					"content": "Semoga keinginan Anda bisa tercapai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pesan"
				}
			]
		},
		{
			"id": 7320107,
			"completionStepIds": [
				7320107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320107",
							"2"
						],
						"stepId": 7320107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732010701,
					"content": "\"Semuanya, berhati-hatilah! Temanku bertemu Rishboland Raja di tengah malam di hutan sebelah barat laut! Untungnya dia tidak apa-apa, tidak terluka. Lebih baik jangan pergi ke luar di malam hari!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pesan"
				}
			]
		},
		{
			"id": 7320108,
			"completionStepIds": [
				7320108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320108",
							"2"
						],
						"stepId": 7320108,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732010801,
					"content": "\"Peneliti besar Pursina lewat hasil penelitian terbarunya menunjukkan bahwa minum kopi dapat meningkatkan kemampuan kognitif seseorang.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010802
					],
					"speakerTitle": "Papan Pesan"
				},
				{
					"id": 732010802,
					"content": "\"Kalau mau diterima di Akademiya, kunjungilah kedai kopi ini sering-sering.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010803
					],
					"speakerTitle": "Papan Pesan"
				},
				{
					"id": 732010803,
					"content": "Aku sangat berterima kasih kamu sudah mengiklankan kedai kami, tapi kopi hanya akan memberimu sedikit energi ... Lagi pula, Mahamata akan mengambil tindakan terhadap pernyataan yang tidak mendasar seperti ini, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pesan"
				}
			]
		},
		{
			"id": 7320109,
			"completionStepIds": [
				7320109
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320109",
							"2"
						],
						"stepId": 7320109,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732010901,
					"content": "\"Ingatlah apa yang kuajarkan ini sewaktu bermain kartu di kedai kopi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010902
					],
					"speakerTitle": "Papan Pesan"
				},
				{
					"id": 732010902,
					"content": "\"Waktu bermain Genius Invokation TCG, aku tidak seharusnya membuat kartu yang tidak ada untuk menipu teman mainku.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010903
					],
					"speakerTitle": "Papan Pesan"
				},
				{
					"id": 732010903,
					"content": "\"Tuan Jackal sudah membimbingku supaya aku sadar akan kesalahanku. Aku datang ke sini untuk mengaku.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010904
					],
					"speakerTitle": "Papan Pesan"
				},
				{
					"id": 732010904,
					"content": "\"Kebanyakan orang bahkan tidak sadar kesalahan mereka. Tapi ... siapa Tuan Jackal yang kamu bilang tadi?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pesan"
				}
			]
		},
		{
			"id": 7320110,
			"completionStepIds": [
				7320110
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320110",
							"2"
						],
						"stepId": 7320110,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732011001,
					"content": "\"Aku dengar banyak bandit yang bermunculan di gurun pasir sana, banyak pedagang juga tidak mau lewat sana lagi. Bisa jadi harga kurma akan melonjak naik.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011002
					],
					"speakerTitle": "Papan Pesan"
				},
				{
					"id": 732011002,
					"content": "\"Baguslah! Aku akan langsung jual semua jamurku untuk mendapatkan kurma! Haha! Mungkin inilah keberanian dan visi misi yang diturunkan oleh Klan Alkindi!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011003
					],
					"speakerTitle": "Papan Pesan"
				},
				{
					"id": 732011003,
					"content": "Walaupun kuharap hartamu akan berlipat ganda, tapi tokoku ini tidak bertanggung jawab kalau sampai timbul kerugian apa pun dari informasi yang ada di papan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pesan"
				}
			]
		},
		{
			"id": 7320111,
			"completionStepIds": [
				7320111
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320111",
