					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732011101,
					"content": "\"Sesudah pensiun dari 'Corps of Thirty', aku datang ke sini tiap hari untuk ngopi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011102
					],
					"speakerTitle": "Papan Pesan"
				},
				{
					"id": 732011102,
					"content": "\"Wakil manajer membuatkan kopi yang sama untukku tiap hari, pendongengnya juga menceritakan kisah yang sama.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011103
					],
					"speakerTitle": "Papan Pesan"
				},
				{
					"id": 732011103,
					"content": "\"Mungkin saja pengulangan seperti itu adalah esensi hidup di Sumeru.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pesan"
				}
			]
		},
		{
			"id": 7320112,
			"completionStepIds": [
				7320112
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320112",
							"2"
						],
						"stepId": 7320112,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732011201,
					"content": "\"Kisah yang diceritakan Tuan Maddah bisa jadi kuno, tapi dia cukup terampil dalam menguasai irama ceritanya.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011202
					],
					"speakerTitle": "Papan Pesan"
				},
				{
					"id": 732011202,
					"content": "\"Tapi semua orang sudah terbiasa mendapatkan informasi dari Akasha sekarang, jadi mereka sudah terbiasa mengabaikan 'keistimewaan' teknik dan 'kematangan' artistik.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011203
					],
					"speakerTitle": "Papan Pesan"
				},
				{
					"id": 732011203,
					"content": "\"Aku tidak setuju dengan apa yang kamu sampaikan. Semua bentuk seni itu ada zamannya. Begitu 'nilai manfaat'-nya habis tereksploitasi, tidak ada lagi alasan untuk mempertahankan keberadaannya.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011204
					],
					"speakerTitle": "Papan Pesan"
				},
				{
					"id": 732011204,
					"content": "\"Sama seperti buah yang sudah terlalu matang, akan jatuh ke tanah dan memberikan nutrisi untuk tanaman baru.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011205
					],
					"speakerTitle": "Papan Pesan"
				},
				{
					"id": 732011205,
					"content": "\"Itulah kenapa aku selalu membenci orang yang materialis sepertimu. Seni itu hasil dari waktu senggang yang berharga. Mana boleh disamakan dengan produksi dan eksploitasi dari barang-barang konsumsi komersial!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011206
					],
					"speakerTitle": "Papan Pesan"
				},
				{
					"id": 732011206,
					"content": "\"Orang yang bersantai itu seperti orang yang sedang berjalan di atas bumi yang bulat, mereka itu tidak ada. Kenapa tidak pakai saja otakmu dan pikirkan sejenak? Apa aktivitas produksi bisa ada tanpa pertukaran komersial?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011207
					],
					"speakerTitle": "Papan Pesan"
				},
				{
					"id": 732011207,
					"content": "\"Pertengkaran keduanya selalu sengit di atas kertas ... Tapi tagihan Tuan Kaveh untuk bulan ini sudah harus dibayarkan. Apa masih harus dicatat pada rekening Tuan Alhaitham seperti biasanya?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011208
					],
					"speakerTitle": "Papan Pesan"
				},
				{
					"id": 732011208,
					"content": "\"Tidak, aku mau pemuda manja ini mengalami sendiri jahatnya dunia bisnis.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011209
					],
					"speakerTitle": "Papan Pesan"
				},
				{
					"id": 732011209,
					"content": "\"Nona wakil manajer, tolong catat tagihan orang ini di rekening Tuan Sangemah Bay. Toh seni tidak bisa dibuat tanpa kopi!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pesan"
				}
			]
		},
		{
			"id": 7320113,
			"completionStepIds": [
				7320113
			],
