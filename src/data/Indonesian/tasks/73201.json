			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732011301,
					"content": "\"Bertahun-tahun sudah berlalu, tempat ini masih saja sangat ramai! Tiap kali aku ke kedai kopi ini, aku selalu teringat siang hari yang kuhabiskan dengan berdebat bersamanya tentang penafsiran satu karakter.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011302
					],
					"speakerTitle": "Papan Pesan"
				},
				{
					"id": 732011302,
					"content": "Kedai kami tidak akan seramai ini tanpa Anda. Datanglah sering-sering kemari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Papan Pesan"
