					"nextDialogs": [
						727210107
					],
					"speakerTitle": "Taroumaru"
				},
				{
					"id": 727210107,
					"content": "Guk, guk, guk! Guk, guk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727210108,
						727210109
					],
					"speakerTitle": "Taroumaru"
				},
				{
					"id": 727210108,
					"content": "Gonggongan Taroumaru semakin kencang ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727210110
					]
				},
				{
					"id": 727210110,
					"content": "#Taroumaru, ini adalah duel yang sesungguh-sungguhnya. Hadiah bakal dikasih buat yang lebih hebat ilmu bela dirinya, entah itu kamu, ataupun {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727210111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727210111,
					"content": "Tapi kalau kami menang ... kami bisa belikan camilan enak buat kamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727210112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727210112,
					"content": "Guk, guk, guk! Guk, guk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727210115,
						727210113
					],
					"speakerTitle": "Taroumaru"
				},
				{
					"id": 727210115,
					"content": "Aku tidak paham, tapi ayo majulah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727210116
					]
				},
				{
					"id": 727210116,
					"content": "Guk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taroumaru"
				},
				{
					"id": 727210113,
					"content": "Aku tidak paham sih, tapi beri aku sedikit waktu buat siap-siap dulu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727210114
