				{
					"id": 727210102,
					"content": "Eh? Taroumaru?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727210104
					]
				},
				{
					"id": 727210104,
					"content": "Hah, memang tadi Yasuhiko Tarou bilang sih kalau petarung keempat ikutan karena dia lagi butuh Mora. Jadi Taroumaru juga mengincar hadiahnya ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727210105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727210105,
					"content": "Maaf ya, Taroumaru, tapi Paimon juga enggak akan ngalah sih kalau sudah urusan sama Mora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727210106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727210106,
					"content": "Guk?",
