			"dialogs": [
				{
					"id": 747120101,
					"content": "#{NICKNAME}, Paimon. Kabar baik. Semuanya sudah siap!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120102
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747120102,
					"content": "Operasi Anti-Ikan Barbar sukses besar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120103
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747120103,
					"content": "Begitu para penyelam sudah membersihkan semua puing bawah laut dan pasien kita sudah lebih tenang, kita bisa mengembalikan mereka ke alam liar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120104
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747120104,
					"content": "Terima kasih banyak untuk kerja kerasmu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747120105
					]
				},
				{
					"id": 747120105,
					"content": "Hehe, ini berkat kerja keras kita semua, Sigewinne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747120106,
					"content": "Aku sudah menulis laporan insiden dan mengirimkannya ke Palais Mermonia. Seorang spesialis di bidang ini seharusnya sedang menyusun peraturan terkait dan akan segera memberi tahu lembaga yang bersangkutan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120107
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747120107,
					"content": "Aku juga dengar ada beberapa wartawan dan setidaknya satu sutradara sangat tertarik dengan masalah ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120108
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747120108,
					"content": "Siapa tahu, mungkin suatu hari nanti kita akan melihat film tentang betapa pentingnya melindungi lingkungan perairan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120109
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747120109,
					"content": "Keren banget kalau ada! Pasti ada aja orang yang keras kepala atau enggak peduli meskipun sudah kamu omelin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747120110,
					"content": "Mereka perlu melihat sesuatu yang bisa bikin mereka takut! Misalnya bilang kalau lingkungannya benar-benar rusak ... ikan-ikannya bakal mutasi jadi monster super kuat dan ngancurin semuanya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747120111,
					"content": "Biar semua orang yang suka buang sampah sembarangan ke laut mimpi buruk setiap hari, pasti jadi pelajaran bagus tuh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747120112,
					"content": "Ide bagus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sigewinne"
				}
			]
		}
	]
