				},
				{
					"id": 191823902,
					"content": "(Tapi makin ke sini, makin banyak artikel yang memuji Sutradara Merieux. Berpandangan ke depan, dan termasuk hebat pada zamannya.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191823903
					],
					"speakerTitle": "Catatan Penyelidikan"
				},
				{
					"id": 191823903,
					"content": "(Artikelnya ditulis oleh orang-orang dari berbagai kalangan dan latar belakang. Corentin dan Amaury, dua nama ini yang paling banyak muncul.)",
					"roleType": "TALK_ROLE_NPC",
