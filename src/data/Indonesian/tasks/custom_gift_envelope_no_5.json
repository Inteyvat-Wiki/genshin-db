					"nextDialogs": [
						715370104
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 715370104,
					"content": "Katanya saat Lantern Rite, warga setempat suka bikin kartu begini untuk diberikan bersama hadiah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715370105
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 715370105,
					"content": "Aku ingin coba ikutan tradisinya, bikin Kartu Ucapan sendiri. Tapi bentuknya ... duh ....",
