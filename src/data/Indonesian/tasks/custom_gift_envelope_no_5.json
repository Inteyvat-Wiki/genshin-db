					"nextDialogs": [
						715370103
					]
				},
				{
					"id": 715370103,
					"content": "Iya! Akhirnya aku bisa liburan ke sini, jadi ingin bawa oleh-oleh buat rekan-rekan di Knights of Favonius.",
