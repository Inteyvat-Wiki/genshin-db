					"nextDialogs": [
						715370106
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 715370106,
					"content": "Aku mau hasilnya cantik-cantik dan bagus! Boleh ajari sedikit, Honorary Knight?",
