				"points": []
			},
			"dialogs": [
				{
					"id": 710820101,
					"content": "Ah, kamu kena tipu pak tua itu lagi ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820102
					],
					"speakerTitle": "Menyebut Dirinya Sendiri \"Tang Wuchou\""
				},
				{
					"id": 710820102,
					"content": "Kan aku sudah bilang ... berburu harta karun sama dia itu begini nih: <color=#00E1FFFF>semakin bagus barangnya, di sekelilingnya akan semakin banyak bahan peledaknya</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820103
					],
					"speakerTitle": "Menyebut Dirinya Sendiri \"Tang Wuchou\""
				},
				{
					"id": 710820103,
					"content": "Kali ini aku sudah ingat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Menyebut Dirinya Sendiri \"Tang Wuchou\""
				}
			]
		},
		{
			"id": 7108202,
			"completionStepIds": [
				7108202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7108202",
							"2"
						],
						"stepId": 7108202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Menyebut Dirinya Sendiri \"Tang Wuchou\"",
					"Paman He",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710820201,
					"content": "Dasar kamu ya, bekas antek Treasure Hoarder ... Huh, ini semua karena aku tidak ada tenaga akibat sudah lama tidak makan jamur ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820202
					],
					"speakerTitle": "Paman He"
				},
				{
					"id": 710820202,
					"content": "Kalau tidak kamu pasti sudah kuhajar sampai babak belur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820203
					],
					"speakerTitle": "Paman He"
				},
				{
					"id": 710820203,
					"content": "Dasar rampok! Beraninya kamu sebut kalau Glaze ... maksudnya Qingxin! Beraninya kamu menyebutnya jamur terus ... kamu makan begitu saja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820204
					],
					"speakerTitle": "Menyebut Dirinya Sendiri \"Tang Wuchou\""
				},
				{
					"id": 710820204,
					"content": "*uhuk uhuk* Memang kamu ada hak apa sampai melakukan hal itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820205
					],
					"speakerTitle": "Menyebut Dirinya Sendiri \"Tang Wuchou\""
				},
				{
					"id": 710820205,
					"content": "Uh, kenapa kalian berdua berantem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710820206,
					"content": "Aku, aku lagi cari daging jamur, iya benar daging jamur. Tapi mereka larang aku turun, jadi aku ke sini buat cari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820207
					],
					"speakerTitle": "Paman He"
				},
				{
					"id": 710820207,
					"content": "Dan setelah terus mencari, aku akhirnya menemukan bahwa di sini pernah ada jamur loh! Terus saat aku sedang mencari jamur-jamur itu, tiba-tiba dia menyerangku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820208
					],
					"speakerTitle": "Paman He"
				},
				{
					"id": 710820208,
					"content": "#Dia berani menginjak tempat latihan Klan Guhua sembarangan. Selain aku, dan {NICKNAME} sang pahlawan pembela kebenaran ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820209
					],
					"speakerTitle": "Menyebut Dirinya Sendiri \"Tang Wuchou\""
				},
				{
					"id": 710820209,
					"content": "Jangan lupa sang pahlawan, Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710820210,
					"content": "Ya, dan sang pahlawan Paimon! Selain kami bertiga, tidak ada yang boleh masuk ke sini!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820211
					],
					"speakerTitle": "Menyebut Dirinya Sendiri \"Tang Wuchou\""
				},
				{
					"id": 710820211,
					"content": "Sisa-sisa Treasure Hoarder!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820212
					],
					"speakerTitle": "Paman He"
				},
				{
					"id": 710820212,
					"content": "Maling!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820213
					],
					"speakerTitle": "Menyebut Dirinya Sendiri \"Tang Wuchou\""
				},
				{
					"id": 710820213,
					"content": "Sudah, sudah! Paman He, Tang Wuchou sudah bukan Treasure Hoarder lagi, dia sudah jadi orang baik sekarang. Terus yang dia tanam itu kembang, bukan jamur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710820214,
					"content": "Hmm? Ada apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820215
					],
					"speakerTitle": "Paman He"
				},
				{
					"id": 710820215,
					"content": "Lihat deh, ini kan Qingxin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710820216,
					"content": "Ah! Benar, ini Qingxin! Duh sepertinya aku masih agak pusing ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820217
					],
					"speakerTitle": "Paman He"
				},
				{
					"id": 710820217,
					"content": "Tang Wuchou, kamu bukannya mau bikin kebun bunga Glaze Lily atau bunga apa lah katamu waktu itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710820218,
					"content": "Pastinya ini akan jadi pemandangan paling indah, ya kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820219
					],
					"speakerTitle": "Menyebut Dirinya Sendiri \"Tang Wuchou\""
				},
				{
					"id": 710820219,
					"content": "Apa pun masalahnya, jangan berantem lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710820220,
					"content": "*huff* Tidak ada jamur. Aku pergi saja, dadah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820221
					],
					"speakerTitle": "Paman He"
				},
				{
					"id": 710820221,
					"content": "Sekarang karena orang tua yang merepotkan itu sudah pergi. Akhirnya aku bisa menanam beberapa bunga ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Menyebut Dirinya Sendiri \"Tang Wuchou\""
				}
			]
		}
	]
}