					"nextDialogs": [
						225000404
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000404,
					"content": "Kamu kumpulkan 3 daun Mint, lalu bawa ke Crafting Bench untuk membuat ekstrak minyak esensialnya. Kamu masih ingat cara membuatnya kan?",
					"roleType": "TALK_ROLE_NPC",
