						225000302
					]
				},
				{
					"id": 225000302,
					"content": "Wow, kamu sangat tidak sabar... Baiklah, aku akan memprioritaskan parfum Lulu demi persahabatan kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
