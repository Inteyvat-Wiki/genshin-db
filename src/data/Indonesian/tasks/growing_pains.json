			"dialogs": [
				{
					"id": 225000201,
					"content": "Ah, kamu lagi. Apa yang kamu inginkan kali ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000202
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000202,
					"content": "Mau ambil sesuatu untuk Little Lulu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000203
					]
				},
				{
					"id": 225000203,
					"content": "Little Lulu? ... Oh ya, benar. Dia memintaku untuk membuatkan parfum untuknya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000204
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000204,
					"content": "Tapi, kalian datang di saat yang tidak tepat... Entah kenapa sejak kalian datang mencariku, tiba-tiba banyak orang yang memesan parfum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000205
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000205,
					"content": "Ada begitu banyak pesanan, membuatku kewalahan mengerjakannya seorang diri, dan aku juga masih harus menjaga toko.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000206
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000206,
					"content": "Selain itu, Lulu hanyalah seorang anak kecil. Kurang pantas memberinya jenis parfum yang sama dengan yang digunakan oleh wanita dewasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000207
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000207,
					"content": "Jadi aku memeras otak untuk memikirkan cara membuat parfum yang lebih cocok untuk anak-anak. Sekarang aku sudah menemukan formula yang cocok, tetapi aku belum sempat membuatnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000208
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000208,
					"content": "Kalau benar-benar tidak bisa menunggunya, bukannya tidak mungkin mempercepat pembuatannya, tapi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000209
					],
					"speakerTitle": "Ying'er"
				}
			]
		},
