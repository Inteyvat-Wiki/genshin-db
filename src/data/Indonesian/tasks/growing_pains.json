			"dialogs": [
				{
					"id": 225000101,
					"content": "Kapan makanannya selesai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000102
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 225000102,
					"content": "Hari ini tidak main?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000103
					]
				},
				{
					"id": 225000103,
					"content": "Oh, halo! Tidak, sepertinya belakangan ini bukan waktu yang tepat untuk bermain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000104
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 225000104,
					"content": "Perasaan hati Little Meng sedang jelek dan dia memilih untuk menyendiri, Little Fei juga sering menghilang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000105
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 225000105,
					"content": "Aku bertanya pada Little Meng apa yang terjadi, tapi dia tidak mau bicara denganku. Mereka berdua aneh belakangan ini, dan aku tidak tahu apa yang membuat mereka menjadi seperti itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000106,
						225000110
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 225000106,
					"content": "Sudah dewasa memang seperti itu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000107
					]
				},
				{
					"id": 225000107,
					"content": "Tunggu, kalau sudah dewasa, jadi tidak bahagia? Lalu kenapa Little Meng dan Little Fei begitu ingin menjadi dewasa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000108
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 225000108,
					"content": "Kalau seperti itu, lebih baik aku tidak menjadi dewasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000109
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 225000109,
					"content": "Ya sudah, jangan membahas ini dulu. Sebenarnya aku membutuhkan bantuanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000112
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 225000112,
					"content": "Bisakah kamu membantuku mengambil sesuatu dari tempat Ying'er untukku? Aku sudah berbicara dengannya, dia seharusnya sudah menyiapkannya sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000113,
						225000115
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 225000113,
					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000114
					]
				},
				{
					"id": 225000114,
					"content": "Hore! Terima kasih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 225000115,
					"content": "Tempat Ying'er, eh...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000116
					]
				},
				{
					"id": 225000116,
					"content": "Aku tidak tahu apa yang ada di pikiranmu, tapi bukan itu. Aku hanya meminta Ying'er untuk membuat sesuatu untukku. Dan dia mengatakan akan melakukannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000117
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 225000117,
					"content": "Tolonglah bantu aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 225000110,
					"content": "Apakah kamu juga tidak bahagia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000111
					]
				},
				{
					"id": 225000111,
					"content": "Aku? Tidak, aku baik-baik saja. Tapi... aku tetap membutuhkan bantuanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000112
					],
					"speakerTitle": "Little Lulu"
				}
			]
		},
