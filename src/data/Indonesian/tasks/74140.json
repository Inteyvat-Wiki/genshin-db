			"dialogs": [
				{
					"id": 741401101,
					"content": "Hei, kita ketemu lagi! Eh, kali ini Paimon juga ikutan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401102
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401102,
					"content": "Eh, dulu waktu kita \"meditasi\" bareng di sini, Paimon juga ikut loh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741401103,
					"content": "Begitu ya? Aku tidak ingat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401104
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401104,
					"content": "Tapi bagaimanapun juga aku bisa menemukan lokasi \"Cermin Misterius\" dan tempat di mana bunga-bunga akan mekar berkat bantuanmu. Selain itu pemahamanku tentang tempat ini juga makin luas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401105
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401105,
					"content": "Hmm ... Cara ngomong Canotila masih saja bikin orang bingung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741401106,
					"content": "Guk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401107
					]
				},
				{
					"id": 741401107,
					"content": "Eh? Tapi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401108
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401108,
					"content": "Guk?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401109
					]
				},
				{
					"id": 741401109,
					"content": "Iya, iya, aku ngerti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401110
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401110,
					"content": "(Hmm ... Dia lagi ngomong sama anjingnya? Jangan-jangan Melusine ngerti bahasa anjing?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741401111,
					"content": "(Luar biasa.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741401112
					]
				},
				{
					"id": 741401112,
					"content": "Apa boleh buat. Kalau begitu sampai ketemu lain kali deh! Huh, meski kamu bilang begitu, aku bakal tetap datang untuk main bareng lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401113
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401113,
					"content": "#Kalau gitu, ayo kita jalan, Kak {NICKNAME}, Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Canotila"
				}
			]
		},
		{
			"id": 7414013,
			"completionStepIds": [
				7414013
