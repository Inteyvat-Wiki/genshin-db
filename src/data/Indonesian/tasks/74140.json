							4711.404
						],
						"pointId": 6283
					}
				]
			},
			"dialogs": [
				{
					"id": 741401301,
					"content": "Waduh, kita balik lagi ke sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401302
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401302,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741401303,
					"content": "Sebenarnya aku merasa bersalah bilang ini. Apalagi semua orang sudah baik sekali sama aku, termasuk kalian. Tapi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401304
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401304,
					"content": "Kalian tidak merasa kalau dunia nyata itu membosankan sekali? Bukankah dunia dalam buku ini jauh lebih indah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401305,
						741401307,
						741401309
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401305,
					"content": "Aku juga merasa begitu sih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741401306
					]
				},
				{
					"id": 741401306,
					"content": "Eh? Kamu juga merasa begitu ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741401311,
					"content": "Menurutku dunia dalam \"Kitab Kebenaran\" jauh lebih indah. Di sana ada banyak sekali kelopak bunga yang diselimuti embun, terus aku akhirnya berteman sama anjing kecil juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401312
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401312,
					"content": "Anjing .... Ngomong-ngomong, Canotila, kamu ngerti bahasa anjing?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741401313,
					"content": "Hm? Ya, tidak bisa lah. Tapi, si anjing kecil dalam \"Kitab Kebenaran\" itu istimewa. Atau mungkin ... aku yang istimewa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401314
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401314,
					"content": "Tapi, memang sih aku terus meditasi dan main ke dunia dalam buku. Suatu hari aku mendadak mengerti gonggongannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401315
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401315,
					"content": "Soal kami ngomong apa ... Dia bujuk aku pergi dan jangan balik lagi ke dunianya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401316
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401316,
					"content": "Tapi ... aku masih mau lihat bunga matahari yang bermekaran ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401317
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401317,
					"content": "....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741401318
					]
				},
				{
					"id": 741401318,
					"content": "O-oh gitu ... Canotila, kamu jaga diri ya! Kami pergi dulu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741401307,
					"content": "Aku tidak merasa begitu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741401308
					]
				},
				{
					"id": 741401308,
					"content": "Oh ya ...? Mungkin kamu benar, akunya saja yang tidak normal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401311
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401309,
					"content": "Menurutku sama saja sih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741401310
					]
				},
				{
					"id": 741401310,
					"content": "#Kayaknya Kak {NICKNAME} yang paling kuat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401311
					],
					"speakerTitle": "Canotila"
				}
			]
		}
	]
}