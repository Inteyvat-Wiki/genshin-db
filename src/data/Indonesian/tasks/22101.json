					"nextDialogs": [
						221010303
					]
				},
				{
					"id": 221010303,
					"content": "Bagus sekali. Terima kasih banyak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010304
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010304,
					"content": "Ini imbalannya, simpanlah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010305
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010305,
					"content": "Akhir-akhir ini, jujur saja... Jika aku tidak belajar bela diri sejak kecil, aku tidak akan berani bekerja di penginapan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
