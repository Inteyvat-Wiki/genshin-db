			"dialogs": [
				{
					"id": 221010201,
					"content": "Bagaimana? Apakah monster-monsternya sudah dibereskan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010202
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010202,
					"content": "Masih belum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221010203
					]
				},
				{
					"id": 221010203,
					"content": "Baiklah, tidak perlu terburu-buru, mereka cenderung menjaga jarak sehingga tidak menimbulkan ancaman besar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010204
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010204,
					"content": "Kalaupun ada beberapa monster bernyali besar berani masuk, aku masih sanggup mengusir mereka pergi. Para tamu tidak perlu khawatir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010205
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010205,
					"content": "Hahaha. Tidak ada yang mau membuka penginapan di tempat terpencil ini kecuali mereka menguasai sedikit seni bela diri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				}
			]
		},
