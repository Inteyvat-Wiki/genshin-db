			"dialogs": [
				{
					"id": 221010101,
					"content": "*huff* Masalah datang silih berganti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010102
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010102,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221010103
					]
				},
				{
					"id": 221010103,
					"content": "*huff* Membuka penginapan di sini tidaklah mudah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010104
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010104,
					"content": "Tidak tahu apakah ini hanya perasaanku saja... Tapi rasanya jumlah mereka semakin hari semakin banyak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010105
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010105,
					"content": "Walaupun mereka tidak akan mendekati penginapan, tetapi para tamu pasti akan keluar masuk. Para Millelith yang patroli juga tidak bisa berjaga sepanjang waktu di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010106
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010106,
					"content": "Kalau kamu ada waktu, apa kamu bisa membantuku membasmi monster-monster di sekitar penginapan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010107,
						221010108
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010107,
					"content": "Baiklah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221010109
					]
				},
				{
					"id": 221010109,
					"content": "Hahaha. Kamu sungguh terus terang sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010113
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010113,
					"content": "Ngomong-ngomong, aku jadi tidak enak hati merepotkanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010114
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010114,
					"content": "Tapi tenang saja, setelah selesai, aku akan memberikanmu imbalan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010115
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010115,
					"content": "Semoga beruntung, terima kasih ya~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010108,
					"content": "Penginapan ini...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221010110
					]
				},
				{
					"id": 221010110,
					"content": "Ya, kita seharusnya tahu masalah apa yang akan kita temui saat memilih lokasi ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010111
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010111,
					"content": "Tapi, kalau tidak ada penginapan ini, para pengembara yang lewat harus tinggal di mana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010112
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010112,
					"content": "Walaupun ini pekerjaan yang melelahkan, tapi kami dibutuhkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010113
					],
					"speakerTitle": "Huai'an"
				}
			]
		},
