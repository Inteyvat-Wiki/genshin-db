			"dialogs": [
				{
					"id": 760520501,
					"content": "*glek* *glek*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520502
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760520502,
					"content": "Wuah, langsung dihabisin! Dia doyan nih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520503,
					"content": "Hmm ... tidak ada rasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520504
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760520504,
					"content": "E-Enggak ada rasa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520505,
					"content": "Ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520506,
						760520507
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760520506,
					"content": "Soalnya kamu minumnya kecepetan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520508
					]
				},
				{
					"id": 760520508,
					"content": "Oh, terima kasih, tapi tidak usah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520509
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760520509,
					"content": "Dulu aku pernah gagal memahami mengapa orang-orang begitu gembira ketika musim panen tiba. Lalu pada suatu hari, aku menyentuh satu buah matang yang masih menempel di carangnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520510
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760520510,
					"content": "Aku merasakan daya hidup yang besar bahkan dari tekstur kulitnya. Perwujudan dari cahaya matahari, air, tanah, dan udara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520511
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760520511,
					"content": "Setiap gigitannya memberikan rasa manis yang menyegarkan tubuh dan jiwa seperti busa putih yang sejuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520512
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760520512,
					"content": "Dan pada saat itulah, aku jadi memahami daya tarik aroma yang tidak bisa dibendung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520513
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760520513,
					"content": "Ooh, bahasannya menarik juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520514,
					"content": "Lalu, kita melengkapi siklus alam dengan cara mengambil daya hidup tersebut untuk diri kita sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520515
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760520515,
					"content": "Uhh, kok arahnya jadi agak ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520516,
					"content": "Itulah kenapa aku lebih suka buah segar. Agar aku tahu apa yang kuambil dari dunia ini, tepat sebelum aku mengambilnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520517
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760520517,
					"content": "Dan agar aku ... ingat untuk mengembalikannya pada dunia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760520507,
					"content": "Mau dibikinin satu lagi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520508
					]
				}
			]
		},
