			"dialogs": [
				{
					"id": 760850601,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850602
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760850602,
					"content": "Yang ini enak sekali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850603
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760850603,
					"content": "Ini minuman favoritku sejauh ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850604
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760850604,
					"content": "Wah! Akhirnya, ada minuman yang Columbina suka! Paimon senang banget dengernya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760850605,
					"content": "Ehm, maaf?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850606
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760850606,
					"content": "Oke, mari kita rangkum. Enggak ada rasa pahit yang mencolok, jangan langsung tambahin jus buah, dan susu boleh, tapi lebih enak kalau enggak pakai ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760850607,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850608
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760850608,
					"content": "Jadi ini resep minuman yang \"lebih ringan\" ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760850609
					]
				},
				{
					"id": 760850609,
					"content": "Bagus deh kalau sudah paham polanya! Lain kali kita bisa bikin minuman sesuai selera kamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760850610,
					"content": "Lain kali?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850611
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760850611,
					"content": "Tentu saja, kita kan teman! Kapan pun kamu haus, bilang saja ke kami!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760850612,
					"content": "Tunggu dulu, jangan-jangan itu alasan kamu enggak habisin minumannya? Jangan bilang kamu simpan semua minumannya karena kamu pikir ini bakal jadi gelas terakhir yang bisa kamu minum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760850613,
					"content": "Emmm ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850614
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760850614,
					"content": "Tidak apa-apa kok, tenang saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760850615
					]
				},
				{
					"id": 760850615,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850616
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760850616,
					"content": "Terima kasih sudah mentraktirku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"The Damselette\""
				}
			]
