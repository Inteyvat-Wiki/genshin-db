			"dialogs": [
				{
					"id": 705510301,
					"content": "Ini dia — \"Lumidouce Twilight\" versi baru yang terinspirasi dari Emilie dan sudah disempurnakan. Aku belum memikirkan nama untuknya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510302
					]
				},
				{
					"id": 705510302,
					"content": "Warnanya lebih dingin dan lebih menyegarkan, wanginya juga sesuai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510303
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510303,
					"content": "Kelopak dan dedaunan yang hancur ini dari Windwheel Aster?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510304,
						705510305
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510304,
					"content": "Yup, kamu sudah hapal!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510306
					]
				},
				{
					"id": 705510306,
					"content": "Rasanya pasti enak, aku coba dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510307
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510307,
					"content": "Mm ... Dalam bahasa bunga, Windwheel Aster melambangkan: angin terlihat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510308
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510308,
					"content": "Minumanmu bukan cuma menangkap bentuk mereka, tapi juga wangi yang dimilikinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510309
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510309,
					"content": "Aku rasa kamu boleh panggil minuman ini: Windborne Bouquet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510310
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510310,
					"content": "Angin dan awan Mondstadt berputar di dalam cangkir, meninggalkan semerbak aroma harum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510311,
						705510312
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510311,
					"content": "Nama yang sempurna dari ahli parfum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510313
					]
				},
				{
					"id": 705510313,
					"content": "Oh ya? Mungkin itu cuma bagian dari pekerjaanku saja. Syukurlah kalau kamu suka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510314
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510314,
					"content": "Sekarang, saatnya untuk menikmati karya hebat ini pelan-pelan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510315
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510315,
					"content": "#Terima kasih banyak, {NICKNAME}. Perjalanan ke Mondstadt ini sangat berharga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510316
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510316,
					"content": "Ini adalah koktail paling berkesan yang pernah kucoba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510317
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510317,
					"content": "Begitu aku kembali ke Fontaine, aku mau hadirkan kembali momen ini, sebagai wewangian dan parfum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510318,
						705510319
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510318,
					"content": "Aku tersanjung sekali!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510320
					]
				},
				{
					"id": 705510320,
					"content": "Begitu aku sudah sempurnakan resepnya, aku harap kamu bisa jadi pelanggan pertama yang mencoba produknya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510321
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510321,
					"content": "Sampai jumpa, kuharap kita bisa berjumpa lagi di Court of Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510319,
					"content": "Kabar bagus!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510320
					]
				},
				{
					"id": 705510312,
					"content": "Elegan dan penuh gaya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510313
					]
				},
				{
					"id": 705510305,
					"content": "Yup, itu simbol bunga Mondstadt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510306
					]
				}
			]
