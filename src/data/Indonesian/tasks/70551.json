						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Emilie"
				],
				"points": [
					{
						"sceneId": 51206,
						"position": [
							2192.554,
							230.089,
							-777.292
						],
						"pointId": 1
					},
					{
						"sceneId": 51206,
						"position": [
							2195.024,
							230.219,
							-779.316
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 705510201,
					"content": "Mau coba ini, Nona Emilie?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510202
					]
				},
				{
					"id": 705510202,
					"content": "Gerakanmu benar-benar indah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510203
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510203,
					"content": "Hmm ... Rasanya mirip sekali dengan Lumidouce Twilight versi lokal. Benar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510204,
						705510205
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510204,
					"content": "Yep.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510206
					]
				},
				{
					"id": 705510206,
					"content": "Cita rasa yang lembut dan elegan, dengan lapisan yang berbeda, dipadukan dengan sedikit aroma khas Mondstadt, menyajikan rasa yang menggoda, sekaligus menghindari aroma yang mungkin tidak harmonis ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510207
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510207,
					"content": "Tapi sebenarnya kamu tidak perlu hati-hati seperti ini. Aku punya toleransi rasa yang tinggi kok di luar batasan rasa biasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510208,
						705510209
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510208,
					"content": "Jadi yang ini terlalu tradisional ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510210
					]
				},
				{
					"id": 705510210,
					"content": "Minumanmu enak, tapi kalau kamu bisa buatkan aku minuman yang lebih ... mendalam, yang bisa menunjukkan pemahaman unikmu tentang tempat ini dan bisa memperkuat kesanku tentang Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510211
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510211,
					"content": "Kalau kamu tidak terlalu terburu-buru, mungkin bisa dapat inspirasi dari ngobrol ringan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510212
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510212,
					"content": "Kamu baru beli bunga ini tadi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510213
					]
				},
				{
					"id": 705510213,
					"content": "Ini bagian dari hadiahku dari pemilik toko bunga, ini bahan yang diperlukan untuk membuat parfum. Berkat bahan ini, aku bisa selesaikan komisiku di The Cat's Tail.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510214
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510214,
					"content": "Aku sudah pelajari bunga Cecilia Mondstadt lama sekali. Bahkan, wangi Cecilia di sebagian daerah sudah identik dengan ko Mondstadt itu sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510215
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510215,
					"content": "Tapi ini kasus khusus. Ada kucing yang tidak terbiasa dengan wangi Cecilia, jadi kami harus ekstra hati-hati dengan kesukaan mereka ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510216,
						705510217
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510216,
					"content": "Jadi aroma apa yang dipakai kali ini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510218
					]
				},
				{
					"id": 705510218,
					"content": "Windwheel Aster.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510219
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510219,
					"content": "Banyak bagian tanaman Windwheel Aster dapat digiling jadi bubuk untuk diambil sarinya. Terus aku campur aroma kelopak dan daunnya, hasilnya aroma manis yang memabukkan seperti madu, tapi tetap mempertahankan aroma segar yang terkandung dalam batang dan daun bunganya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510220
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510220,
					"content": "Aku baru saja berikan ke The Cat's Tail untuk ujicoba kecil, sepertinya kucing-kucing di sana suka, pelanggannya juga merasa menenangkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510221
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510221,
					"content": "Mengekstraksi wewangian istimewa dari bahan biasa yang sering diabaikan ... itu yang benar-benar membawa kebahagiaan untukku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510222
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510222,
					"content": "Cuacanya indah hari ini ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510223
					]
				},
				{
					"id": 705510223,
					"content": "(Jadi begini rasanya ngobrol sama orang yang pintar mengobrol ....)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510224
					]
				},
				{
					"id": 705510224,
					"content": "Memang benar! Baru tadi, aku melihat banyak awan cerah melayang, lembut kayak bantal ... Udaranya juga tidak terlalu lembap, anginnya juga lembut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510225
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510225,
					"content": "Dalam kondisi begini, biasa penciuman orang-orang menjadi lebih tajam, tapi tidak terlalu sensitif.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510226
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510226,
					"content": "Kalau wewangian dicampur dengan baik, biasanya akan bisa menyatu dengan lingkungan dan meninggalkan kesan kuat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510227,
						705510228
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510227,
					"content": "Aku baru sadar wewangian itu sangat dipengaruhi cuaca ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510229
					]
				},
				{
					"id": 705510229,
					"content": "Hal yang sama untuk racikan minuman. Asalkan dasar yang dipilih punya kekuatan pas, rasa-rasa lain yang dicampur akan tercampur secara harmonis ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510230
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510230,
					"content": "Kalau dicampur dengan tepat, semua bahan akan menjadi satu untuk menciptakan simfoni terindah untuk indra perasamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510231,
						705510232
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510231,
					"content": "Begitu ya ... Jadi kombinasi rasa itu kuncinya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510233
					]
				},
				{
					"id": 705510233,
					"content": "Yup, benar. Tapi setelah dipikir-pikir, rasa yang terpisah-pisah secara jelas tidak terlalu cocok dengan seleraku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510234
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510234,
					"content": "Jadi kamu biasanya minum apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510235
					]
				},
				{
					"id": 705510235,
					"content": "Biasanya, hmm ... Setelah makan, temanku dari Maison Gardiennage biasanya traktir aku minum sedikit. Aku biasanya minum teh buah sih, jadi aku bisa langsung kembali kerja setelah kumpul-kumpul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510236
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510236,
					"content": "Kalau sebelum liburan dan lagi semangat semua, aku kadang pesan minuman buah bersoda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510237
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510237,
					"content": "Pernah ada petugas yang namanya Turenna, dia undang traktir aku minum anggur Corte tua. Tapi sejak dimutasi ke Pasukan Patroli Khusus, kami belum pernah minum lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510238,
						705510239
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510238,
					"content": "Oh, jadi kamu kadang-kadang minum alkohol juga?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510240
					]
				},
				{
					"id": 705510240,
					"content": "Dari sudut pandang sains sih, alkohol adalah larutan yang sering dipakai. Aku sekarang sudah mulai terbiasa sama baunya sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510241
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510241,
					"content": "Lagian, kalau aku lagi mabuk tipis, pikiranku sedikit berubah, dan proses pembuatan parfumku juga sedikit berubah ... Terlepas dari hasilnya, ini kan percobaan baru ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510242
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510242,
					"content": "Jadi aku tidak keberatan kalau harus minum sedikit alkohol, tapi aku tidak suka yang terlalu kuat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510243
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510243,
					"content": "Jadi gimana parfummu akhir-akhir ini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510244
					]
				},
				{
					"id": 705510244,
					"content": "Ya, terima kasih karena sudah bertanya. Lumayan lancar sih, meski perjalanan ke Mondstadt kali ini membawa sedikit ... perubahan tak terduga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510245
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510245,
					"content": "Waktu aku pertama sampai, aku mengandalkan salinan buku \"Gambaran Umum Zat Aromatik dan Indra Manusia\" untuk memilih aroma-aroma bahan lokal Mondstadt yang menjanjikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510246
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510246,
					"content": "Ternyata, wewangian ujicoba yang memakai Valberry sebagai aksen utamanya jadi terlalu manis untuk Tavern. Jadi pelanggan terlalu \"rileks\" sampai-sampai mereka jadi hampir mabuk. Si bartender yang telinganya cantik itu malah langsung ketiduran di bar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510247,
						705510248
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510247,
					"content": "Aku tidak pernah tahu Valberry punya efek kayak gitu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510249
					]
				},
				{
					"id": 705510249,
					"content": "Berarti sifat manis itu tidak selalu \"lebih banyak lebih baik\". Mempertahankan rasio yang seimbang itu berguna untuk tubuh dan pikiran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510250
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510250,
					"content": "Bahkan dalam kehidupan sehari-hari, aku biasa menghindari buah beri yang terlalu manis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510251
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510251,
					"content": "Pada akhirnya, aku menghapus Valberry dari daftar bahan dan berganti ke Windwheel Aster. Lumayan sukses sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510252
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510252,
					"content": "Aku rasa aku tahu bagaimana cara meracik minuman barumu. Tunggu sebentar ya, aku ganti resepnya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510253
					]
				},
				{
					"id": 705510253,
					"content": "Hmm? Dari percakapan singkat saja kamu bisa dapat ide baru untuk racikan minuman?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510254
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510254,
					"content": "Mungkin kamu memang punya bakat alami untuk pekerjaan kreatif seperti ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510248,
					"content": "Kalau begitu parfum Valberry dikeluarkan dari daftar ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510249
					]
				},
				{
					"id": 705510239,
					"content": "Aku sempat khawatir kalau kamu akan merasa terlalu kuat ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510240
					]
				},
				{
					"id": 705510232,
					"content": "Kamu lebih suka rasa yang menyatu secara harmonis.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510233
					]
				},
				{
					"id": 705510228,
					"content": "Baru pertama dengar, luar biasa ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510229
					]
				},
				{
					"id": 705510217,
					"content": "Jadi bunga apa yang dipakai?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510218
					]
				},
				{
					"id": 705510209,
					"content": "Mau yang lebih mutakhir?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510210
					]
				},
				{
					"id": 705510205,
					"content": "Seratus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510206
					]
				}
			]
		},
