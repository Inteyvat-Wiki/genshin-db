					}
				]
			},
			"dialogs": [
				{
					"id": 705510101,
					"content": "#Selamat siang, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510102
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510102,
					"content": "Aku tidak menyangka bisa mendapat kehormatan menyaksikan bakat \"meracik\"-mu di Mondstadt sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510103,
						705510104
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510103,
					"content": "Datang berwisata?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510105
					]
				},
				{
					"id": 705510105,
					"content": "Keduanya sih sebenarnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510106
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510106,
					"content": "Seorang wanita yang mengaku sebagai penyihir memintaku untuk mengelola toko bunganya. Pada saat yang hampir bersamaan, Cat's Tail menugaskanku untuk menciptakan wewangian baru untuk kedainya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510107
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510107,
					"content": "Mengakhiri jadwal yang sibuk hari ini dengan minuman yang kamu racik sendiri benar-benar sebuah hadiah yang indah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510108,
						705510109
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510108,
					"content": "Kalau begitu aku bakal keluarkan semua kemampuanku!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510110
					]
				},
				{
					"id": 705510110,
					"content": "Aku percaya pilihanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510111
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510111,
					"content": "(Emilie itu lebih sensitif terhadap aroma dibandingkan yang lain. Kalau aku mencampur rasa tidak seimbang, dia pasti jadi tidak nyaman ....)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510112
					]
				},
				{
					"id": 705510112,
					"content": "(Pokoknya, aku harus pakai bahan yang aromanya saling mengimbangi, tambahkan sedikit rasa Fontaine juga.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510113
					]
				},
				{
					"id": 705510113,
					"content": "(Mari kita coba versi Mondstadt dari \"Lumidouce Twilight\".)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 705510109,
					"content": "Aku akan racikkan minuman kejutan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510110
					]
				},
				{
					"id": 705510104,
					"content": "Lagi bisnis?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510105
					]
				}
			]
		},
		{
			"id": 7055102,
			"completionStepIds": [
				7055106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
