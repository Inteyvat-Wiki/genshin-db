			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lauma"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 765010101,
					"content": "#Ah, {NICKNAME} dan Paimon. Burung-burung di hutan baru saja membicarakan kedatangan kalian. Ada hal penting apa yang membawa kalian datang kemari hari ini? Atau ... kalian perlu petunjuk dariku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010102,
						765010103
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 765010102,
					"content": "Kami lagi jalan-jalan saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010104
					]
				},
				{
					"id": 765010104,
					"content": "Tempat ini disinari oleh cahaya bulan. Semua yang ada di sini, baik itu tumbuhan ataupun makhluk hidup, tidak sama dengan dunia luar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010105
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 765010105,
					"content": "Tempat ini cocok sekali untuk menyimpan foto-foto indah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010106
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 765010106,
					"content": "Silakan berjalan-jalan sesuka hati. Kalau kalian ada pertanyaan, silakan tanyakan padaku kapan saja. Aku akan berusaha menjawabnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010107,
						765010108
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 765010107,
					"content": "Suasana di sini sangat tenang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010109
					]
				},
				{
					"id": 765010109,
					"content": "Ya, tempat ini adalah tempat meditasiku, tempat di mana aku bisa berbisik dan berkomunikasi dengan semua makhluk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010110
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 765010110,
					"content": "Hati ini menjadi damai hanya dengan berdiri di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010111
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 765010111,
					"content": "Wow, kedengarannya puitis banget!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010112,
						765010113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765010112,
					"content": "Aku punya satu permintaan kecil ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010114
					]
				},
				{
					"id": 765010114,
					"content": "Iya. Nona Lauma kayak jodoh banget sama latarnya! Jadi kayak lukisan yang cantiiik banget. Kalau difoto, wuih! Dijamin keren habis!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765010115,
					"content": "Mengambil ... fotoku? Ini pengalaman yang baru. Kalau menurut kalian momen tenang ini dan sosokku layak untuk diabadikan dalam bingkai, aku akan dengan senang hati mengabulkan permintaan kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010116
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 765010116,
					"content": "Suatu kehormatan bisa menjadi kenangan indah dalam perjalanan kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010117
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 765010117,
					"content": "Jadi, aku harus bagaimana? Harus lihat ke arah tertentu, atau mempertahankan postur alami?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010118,
						765010119
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 765010118,
					"content": "Biasa saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010120
					]
				},
				{
					"id": 765010120,
					"content": "Baik, selanjutnya kuserahkan padamu. Semoga inspirasi menghampirimu, meski hanya sekelibat saja ia singgah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lauma"
				},
				{
					"id": 765010119,
					"content": "Aku akan berusaha menangkap momen yang paling menyentuh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010120
					]
				},
				{
					"id": 765010113,
					"content": "Kami ingin mengambil fotomu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010114
					]
				},
				{
					"id": 765010108,
					"content": "Kamu biasanya ada di sekitar sini, Lauma?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010109
					]
				},
				{
					"id": 765010103,
					"content": "Sambil cari inspirasi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010104
					]
				}
			]
		},
