			"dialogs": [
				{
					"id": 401251101,
					"content": "Anda tidak berencana untuk membawa kerangnya, Nona Sangonomiya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251102
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401251102,
					"content": "Tidak, kurasa lebih baik ditinggal di sini saja bersama Nona Idyia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251103
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 401251103,
					"content": "Pulau Watatsumi punya harta karun baru sekarang, dan pelan tapi pasti, orang-orang melihat kemajuan dalam mengejar aspirasinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251104
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 401251104,
					"content": "Lebih berguna jika berada di sini, dia bisa melindungi domain ini, dan mimpi semua orang yang bertualang melewatinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sangonomiya Kokomi"
				}
			]
		},
		{
			"id": 4012512,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
