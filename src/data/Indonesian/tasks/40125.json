				"points": []
			},
			"dialogs": [
				{
					"id": 401251201,
					"content": "Kalau kita mulai dari Desa Aaru, terus ambil jalan memutar sedikit ... Kita bisa lewat Caravan Ribat dan Pardis Dhyai di jalan ke Kota Sumeru ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251202
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 401251202,
					"content": "Jadi begitu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251203
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401251203,
					"content": "Kamu mau belanja oleh-oleh di jalan? Kamu cukup fokus beli oleh-olehnya saja, aku akan bawakan barangnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251204
					],
					"speakerTitle": "Lessig"
				},
				{
					"id": 401251204,
					"content": "Jangan khawatir soal beratnya, aku bisa bawa kok! Selama tidak terlalu besar, jadi bisa muat masuk ke dalam tas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251205
					],
					"speakerTitle": "Lessig"
				},
				{
					"id": 401251205,
					"content": "Tenang dulu, menurutmu kita bakal beli buat berapa orang ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251206
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401251206,
					"content": "Mama, Kak Albedo, Master Jean, Razor ... Kak Diona, Kak Mona, Kak Fischl juga ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251207
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401251207,
					"content": "Lihatin apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251208
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401251208,
					"content": "Bukan, bukan apa-apa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251209
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 401251209,
					"content": "Klee, mau beli oleh-oleh apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251210
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 401251210,
					"content": "Mau ... mau permen Sunsettia! Terus topi Fungus juga ... terus, terus ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251211
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401251211,
					"content": "Buku cerita yang banyak! Buat semua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251212
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401251212,
					"content": "Tapi belum tahu kasih apa buat Mama ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251213
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401251213,
					"content": "Santai, lihat-lihat saja dulu. Nanti kami bantuin milih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251214
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401251214,
					"content": "Oke! Makasih ya kakak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Klee"
				}
			]
		}
	]
