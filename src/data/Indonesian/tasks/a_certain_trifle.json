			"trigger": {
				"objectNames": [
					"Iaune"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740350101,
					"content": "Ah ... Pengembara. Senang bertemu denganmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350102,
						740350103
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350102,
					"content": "Bagaimana kabarnya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350104
					]
				},
				{
					"id": 740350104,
					"content": "Kantong matamu tebal banget, terus kayaknya ngomongnya enggak bersemangat banget. Istirahat dulu deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740350105,
					"content": "A-Aku tidak boleh istirahat. Semalam aku sudah bergadang semalaman untuk tulis draf, tapi hasilnya tidak bagus. Sekarang aku harus tulis ulang semua lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350106
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350106,
					"content": "Kalau kamu ke sini ada perlu denganku, tolong tunggu sebentar ya ... Kamu bisa duduk dulu di dekat Tuan Roialte, dan siapa tahu juga bisa sambil minum kopi dulu di situ ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350107
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350107,
					"content": "A-Aku harus lanjut menulis lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350108
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350108,
					"content": "Ah! Tidak! Pakai \"Kepada kolegaku yang terkasih\" sepertinya kurang formal ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350103,
					"content": "Kelihatannya tidak terlalu baik ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350104
					]
				}
			]
		},
		{
			"id": 7403502,
			"completionStepIds": [
				7403504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
