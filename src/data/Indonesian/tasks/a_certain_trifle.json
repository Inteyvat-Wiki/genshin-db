					}
				]
			},
			"dialogs": [
				{
					"id": 740350401,
					"content": "Halo, Tuan Iaune, ada yang bisa dibantu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350402
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350402,
					"content": "Halo juga, Nona Cornelia. Apa kita punya tombol cadangan untuk mesin ketik?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350403
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350403,
					"content": "Apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350404
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350404,
					"content": "Ada satu tombol yang hilang dari mesin ketikku. Aku mau memohon penggantian tombol ini. Kalau tidak ada cadangannya, bantu ajukan pengembalian pembelian juga tidak apa-apa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350405
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350405,
					"content": "Pengembalian pembelian untuk tombol mesin ketik ... Seharusnya sih, tidak masalah ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350406
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350406,
					"content": "Tanda tangan di sini saja ya. Tuliskan saja \"Mengajukan pengembalian pembelian untuk tombol mesin ketik karena mesin ketiknya rusak\", lalu tanda tangan dan tuliskan nama kantormu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350407
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350407,
					"content": "Baik, aku bisa dapatkan tombol mesin ketiknya hari ini juga, kan? Aku benar-benar tidak punya waktu lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350408
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350408,
					"content": "Tuan Iaune, apa Anda pernah mengajukan pengembalian pembelian barang umum sebelumnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350409
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350409,
					"content": "Pengembalian pembelian barang-barang umum benar-benar tidak seperti yang Anda bayangkan — langsung dicairkan begitu ada permohonan. Kita harus mengumpulkan semua dokumen pengajuan pengembalian setiap bulan dulu, baru mengirimkannya ke Maison Cardinalice untuk disetujui pada akhir bulan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350410
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350410,
					"content": "Persetujuan ini terkait dengan pembayaran gaji seluruh Maison Gestion. Kalau jumlah yang diajukan terlalu besar, Maison Cardinalice mungkin masih harus serahkan langsung kepada Monsieur Neuvillette sendiri untuk ditinjau oleh beliau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350427
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350427,
					"content": "Setelah semua proses peninjauan selesai dan ditandatangani, dananya baru akan dikirimkan secara resmi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350411
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350411,
					"content": "Kalau Monsieur Neuvillette sendiri punya pertanyaan tentang jumlah yang diajukan, maka orang yang bersangkutan harus menyerahkan sebuah laporan tertulis lagi ... Kami sedang persiapkan untuk mengirimkan laporan gelombang pertama beberapa hari ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350412
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350412,
					"content": "Jadi maksudmu, kalau aku lagi sial, bahkan mengajukan pengembalian untuk beli tombol saja harus langsung disetujui sama Monsieur Neuvillette???",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350413
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350413,
					"content": "Peraturannya memang seperti itu, Tuan Iaune. Dan total pengembalian untuk bulan ini cukup besar. Jadi bukan tidak mungkin kalau Monsieur Neuvillette yang akan turun langsung untuk meninjaunya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350414
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350414,
					"content": "Monsieur Neuvillette ... Bukannya dia \"Hakim Agung\" yang itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740350415,
					"content": "Ya. Tapi ini kan cuma tombol mesin ketik. Kalau harus langsung dia yang tanda tangan langsung ... Aneh deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350416,
						740350417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740350416,
					"content": "Tidak ada cara lain?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350418
					]
				},
				{
					"id": 740350418,
					"content": "Aku juga pikir begitu. Cuma satu tombol mesin ketik saja loh. Tidak usah sampai mengganggu Monsieur Neuvillette lah! Serius!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350419
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350419,
					"content": "Kalau cara lain ada sih. Yah, Anda boleh beli tombolnya sendiri, lalu kami bisa sediakan catatan resmi untuk utangmu di transaksi rekening umum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350420
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350420,
					"content": "Setelah semua proses pengembalian dana selesai dan dana sudah dikirimkan, biaya yang bersangkutan akan langsung dikirimkan dari rekening umum kepada Anda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350421
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350421,
					"content": "Luar biasa! Ya sudah! Begitu saja! Satu tombol juga tidak berapa saja kok harganya. Aku bisa bayar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350422
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350422,
					"content": "Kalau begitu, silakan tanda tangan di sini, Anda masih tetap harus tulis \"Mengajukan pengembalian pembelian untuk tombol mesin ketik karena mesin ketiknya rusak\" ... Anda berencana beli gantinya di tempat Nona Estelle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350423
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350423,
					"content": "Ya, apa ada masalah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350424
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350424,
					"content": "Nanti aku akan berikan catatan ini kepada Tuan Roialte untuk ditanda tangani, lalu dibawakan kepada Nona Estelle untuk mencocokkan jumlah tagihannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350425
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350425,
					"content": "Anda tidak perlu khawatir soal masalah ini lagi. Cepat beli tombol mesin ketiknya. Aku akan bereskan masalah yang lainnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350426
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350426,
					"content": "Terima kasih banyak! Anda baik sekali, Nona Cornelia! Aku akan pergi dan beli tombolnya sekarang. Ayo, Pengembara, waktunya berangkat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350417,
					"content": "Kita cari cara lain deh!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350427
					]
				}
			]
		},
