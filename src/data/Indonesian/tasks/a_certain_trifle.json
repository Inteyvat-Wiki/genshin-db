			"dialogs": [
				{
					"id": 740350601,
					"content": "Iaune, kenapa kamu sampai ngos-ngosan begitu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350602
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740350602,
					"content": "Estelle! Cepat, cepat kasih aku tuts mesin ketik! Harusnya kamu punya, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350603
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350603,
					"content": "Pasti ada dong! Tapi kan mesin ketik ada banyak sekali tombolnya. Coba lihat sendiri kamu butuh yang mana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350604
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740350604,
					"content": "Iaune mulai mencari tombol mesin ketik yang dia butuhkan secepat kilat ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740350605
					]
				},
				{
					"id": 740350605,
					"content": "Yang ini! Yang ini! Ini uangnya! Terima kasih, Estelle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350606
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350606,
					"content": "Terakhir kali kamu bilang mau naik perahu bareng aku ... Iaune! HEI! Iaune!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Estelle"
				}
			]
		},
