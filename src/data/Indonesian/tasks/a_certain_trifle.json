							-0.955
						],
						"pointId": 32
					}
				]
			},
			"dialogs": [
				{
					"id": 740350201,
					"content": "Pengembara, senang sekali kamu bisa datang berkunjung lagi. Mau segelas kopi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350202,
						740350203
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350202,
					"content": "Oh ya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350204
					]
				},
				{
					"id": 740350204,
					"content": "Yup! Paimon juga baru mau tanya. Tapi ... orang itu ngomongnya keras banget suaranya. Paimon enggak berani ganti topik ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350243
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740350243,
					"content": "Aku pikir bakal diusir keluar ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350205
					]
				},
				{
					"id": 740350205,
					"content": "Kenapa? Hahaha. Tidak usah khawatir. Penjaga depan saja sudah mengizinkan kalian masuk. Mana mungkin kami main hakim sendiri dan mengusir kalian?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350206
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350206,
					"content": "Ini juga adalah bentuk nyata dari delegasi hak dan tanggung jawab. Halo, Pengembara. Aku Semaine, senang bertemu denganmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350207,
						740350208
					],
					"speakerTitle": "Semaine"
				},
				{
					"id": 740350207,
					"content": "Halo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350209
					]
				},
				{
					"id": 740350209,
					"content": "Semaine dulu pernah bekerja jadi asisten sekretaris di pengadilan ... Karena ada ... berbagai kejadian, dia akhirnya dipindahkan kembali ke Maison Gestion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350210
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350210,
					"content": "Ada banyak masalah yang tidak bisa kami selesaikan dari dulu, akhirnya dia bisa temukan penyelesaiannya dengan pemikirannya yang logis dan akurat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350211
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350211,
					"content": "Pujiannya berlebihan sekali. Aku cuma menggunakan pengalaman pekerjaanku yang sebelumnya, dan menggunakan nilai berbagai masalah untuk mengukur masalah lain yang berhubungan dengannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350212
					],
					"speakerTitle": "Semaine"
				},
				{
					"id": 740350212,
					"content": "Meski pada kenyataannya, ada banyak sekali masalah yang tidak bisa diukur secara tepat. Tapi semua hubungan manusia dan filosofi-filosofi penyelesaian masalah Tuan Roialte juga banyak membantuku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350213
					],
					"speakerTitle": "Semaine"
				},
				{
					"id": 740350213,
					"content": "Maksudnya ... apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350214
					]
				},
				{
					"id": 740350214,
					"content": "Singkatnya, waktu sedang berurusan dengan pekerjaan, Tuan Semaine itu sangat pintar dalam menyeimbangkan berbagai aspek, sehingga setiap orang bisa merasa penting, sama seperti menyeimbangkan timbangan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350215
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350215,
					"content": "Dan kalau memang tidak bisa diseimbangkan, aku juga bisa sediakan \"beban dalam bentuk kata-kata\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350216,
						740350217
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350216,
					"content": "Iaune sepertinya pekerja keras ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350218
					]
				},
				{
					"id": 740350218,
					"content": "Ya! Kayaknya dia bentar lagi mau pingsan deh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740350219,
					"content": "Ini adalah jalan yang harus dilalui semua orang. Kalau aku bantu Iaune untuk tulis dokumennya, dia tidak akan ingat pelajaran kali ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350220
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350220,
					"content": "Dia selalu punya berbagai macam impian yang tidak realistis terhadap Maison Gestion. Tapi, idealisme itu kan milik anak muda, bukan milik pekerja di Maison Gestion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350221
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350221,
					"content": "Aku cuma tidak bisa tulis dokumen saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350222
					],
					"speakerTitle": "Semaine"
				},
				{
					"id": 740350222,
					"content": "Kamu terang-terangan juga ya ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350223
					]
				},
				{
					"id": 740350223,
					"content": "Ya sudah, jadi sebenarnya ada perlu apa kalian datang ke sini? Coba katakan, siapa tahu aku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350224
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350224,
					"content": "Iaune tiba-tiba berlari dalam kepanikan ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740350225
					]
				},
				{
					"id": 740350225,
					"content": "Sial! Tuan Roialte, apa masih ada tombol cadangan untuk mesin ketik?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350226
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350226,
					"content": "Waktu aku sedang mengetik tadi, tiba-tiba ada satu tombol yang entah kapan hilangnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350227
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350227,
					"content": "Apa sudah coba cari di sekitar? Mungkin terjatuh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350228
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350228,
					"content": "Atau mungkin ada di dalam buku, atau ada di bawah dokumen ... Sudah cari di sana semua?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350229
					],
					"speakerTitle": "Semaine"
				},
				{
					"id": 740350229,
					"content": "Mungkin ada di tempat pen, atau terselip di lengan bajumu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350230
					]
				},
				{
					"id": 740350230,
					"content": "Atau di rambutmu, atau di dalam gelas teh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740350231,
					"content": "Aku sudah cari di mana-mana! Bahkan kantong baju dan sol sepatu juga! Ya memang tidak ada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350232
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350232,
					"content": "Ya sudah. Kalau begitu, tanyakan saja kepada Nona Cornelia. Kalau memang ada cadangannya, pasti ada di tempatnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350233
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350233,
					"content": "Kalau begitu, aku beli sendiri saja deh. Cari Estelle untuk pesan satu tombol harusnya juga tidak akan makan waktu lama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350234
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350234,
					"content": "Iaune-ku yang terkasih, kenapa kamu harus habiskan uangmu sendiri? Ini semua kan barang milik Maison Gestion. Sesuai prosedurnya, kamu perlu mencari Nona Cornelia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350235
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350235,
					"content": "Harganya tidak seberapa saja kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350236
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350236,
					"content": "Ini bukan masalah harga. Ini adalah masalah hak dan tanggung jawab.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350237
					],
					"speakerTitle": "Semaine"
				},
				{
					"id": 740350237,
					"content": "Memperbaiki barang-barang umum di Maison Gestion memang sudah seharusnya dibayar dengan kas umum milik Maison Gestion!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350238
					],
					"speakerTitle": "Semaine"
				},
				{
					"id": 740350238,
					"content": "Kalau kamu pakai uang pribadimu untuk membayarnya dan tidak mengajukan penggantian kembali, waktu keuangan diaudit akhir tahun, asal-usul uang ini akan jadi tidak jelas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350239
					],
					"speakerTitle": "Semaine"
				},
				{
					"id": 740350239,
					"content": "Ya sudah, ya sudah! Aku cari Nona Cornelia sekarang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350240,
						740350241
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350240,
					"content": "Mau beli barang pun serepot ini ya ampun ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350242
					]
				},
				{
					"id": 740350242,
					"content": "Ini adalah hal yang wajar di sini. Ayo kita pergi cari Nona Cornelia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350241,
					"content": "Mau bayar saja kayak begini ...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350242
					]
				},
				{
					"id": 740350217,
					"content": "Apa kalian bisa bantu dia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350218
					]
				},
				{
					"id": 740350208,
					"content": "Kamu ...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350209
					]
				},
				{
					"id": 740350203,
					"content": "Kenapa sebelumnya kalian tidak terkejut waktu bertemu denganku?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350204
					]
				}
