			"dialogs": [
				{
					"id": 740350301,
					"content": "Tombol untuk mesin ketik ... Eh, Semaine, memangnya yang seperti itu bisa diajukan pengembalian?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350302
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350302,
					"content": "Aku juga tidak jelas sih. Kalau mesin ketiknya bisa diajukan pengembalian sih ... berarti tombol mesin ketik juga bisa deh seharusnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Semaine"
				}
			]
		},
		{
			"id": 7403504,
