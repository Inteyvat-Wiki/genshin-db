			"dialogs": [
				{
					"id": 760840101,
					"content": "Ah, kalian sudah datang? Para Kuuhenki sedang bermain lira lagi. Bisa tolong mainkan lagu untuk mereka seperti waktu itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760840102
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760840102,
					"content": "Kebetulan aku juga sedang ingin mendengarkan sesuatu yang berbeda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760840103
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760840103,
					"content": "(Hmmm, bagusnya main lagu apa ya ....)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
