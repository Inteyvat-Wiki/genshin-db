							4014.979
						],
						"pointId": 6369
					}
				]
			},
			"dialogs": [
				{
					"id": 740410601,
					"content": "Hmm, coba kulihat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410602
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740410602,
					"content": "Kalau bisa menyatukan data-data yang dikumpulkan sebelumnya, harusnya bisa dapat hasil yang bagus ... Pemulihan pengamatan hidrologi sudah dekat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410603
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740410603,
					"content": "Oh, baguslah kalau gitu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740410604,
					"content": "Eh? Kok kayaknya kurang sebagian data ... Apa cuma perasaanku saja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410605
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740410605,
					"content": "Kok kamu enggak yakin gitu sih! Bukannya data ini tanggung jawabmu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740410606,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410607
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740410607,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740410608,
					"content": "...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740410609
					]
				},
				{
					"id": 740410609,
					"content": "Hmm, maaf, aku salah ruangan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410610
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740410610,
					"content": "Komandan Fatui kabur dengan kecepatan yang sama sekali tak disangka-sangka, seolah dia terbang ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740410611
					]
				},
				{
					"id": 740410611,
					"content": "Be-bentar, yang lewat barusan itu apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410612,
						740410613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740410612,
					"content": "Cepat banget, lebih cepat daripada vishap ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740410614
					]
				},
				{
					"id": 740410614,
					"content": "Enggak, enggak. Sekarang bukan waktunya mikirin hal ini! Orang itu Fatui kan! Kenapa dia muncul di sini sih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740410615,
					"content": "#{NICKNAME}, cepat kita kejar. Kita tanya dia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740410613,
					"content": "Cepat amat ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740410614
					]
				}
			]
		},
		{
			"id": 7404113,
