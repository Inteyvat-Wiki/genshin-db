			},
			"dialogs": [
				{
					"id": 740410101,
					"content": "Broglie, kami sudah dapat data dari dua pos pengamatan yang kamu bilang itu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740410102,
					"content": "Benarkah?! Bagus! Ayo cepat tunjukkan padaku—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410103,
						740410104
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740410103,
					"content": "Nih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740410107
					]
				},
				{
					"id": 740410107,
					"content": "Kamu memberikan pita kertas yang kamu kumpulkan tadi kepada Broglie ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740410108
					]
				},
				{
					"id": 740410108,
					"content": "Aaaah, benar, ini dia, ini dia! Kalian berdua memang malaikat yang dikirim langit untuk menyelamatkanku dari jurang penderitaan supaya aku bisa menjalani kembali kehidupan yang santai dan bahagia—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410109
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740410109,
					"content": "Kamu kan enggak perlu lebai sampai kayak gitu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740410110,
					"content": "#Intinya, kita tidak boleh tunda lagi, {M#Tuan}{F#Nona} yang baik hati. Aku akan pergi cari manajer untuk minta kunci Stasiun Proses Pusat. Tunggu sebentar ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410111
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740410111,
					"content": "Duh, ya ampun ... tolong cepat dikit ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740410112,
					"content": "Tak lama kemudian, Broglie kembali dengan semangat ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740410113
					]
				},
				{
					"id": 740410113,
					"content": "#{M#Tuan}{F#Nona}, aku sudah dapat kuncinya! Selanjutnya, kita cuma perlu ke stasiun proses pusat untuk menyusun data-data ini, pos pengamatan hidrologi pun bisa dibuka kembali dengan lancar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410114,
						740410115
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740410114,
					"content": "Oh ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740410116
					]
				},
				{
					"id": 740410116,
					"content": "Mempertimbangkan situasi di \"Stasiun Pate de Fruit\" dan \"Station Crepes Suzette\", mungkin orang-orang dari Snezhnaya itu juga ada di Stasiun Proses Pusat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410117
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740410117,
					"content": "Jadi ... tolong kalian berdua temani aku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410118
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740410118,
					"content": "Kamu jangan lupa kasih kami imbalan ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740410115,
					"content": "Apa kami juga perlu ikut pergi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740410116
					]
				},
				{
					"id": 740410104,
					"content": "Mana imbalan kami?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740410105
					]
				},
				{
					"id": 740410105,
					"content": "Ini ... Anda tidak perlu khawatir. Selama manajer setuju untuk membuka kembali penelitian hidrologi yang lama, aku pasti tidak akan melupakan jasa Anda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410106
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740410106,
					"content": "Hehe, baguslah kalau gitu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410107
					],
					"speakerTitle": "Paimon"
				}
			]
		},
