						],
						"pointId": 6370
					}
				]
			},
			"dialogs": [
				{
					"id": 740411301,
					"content": "Jangan pukul aku lagi! Aku menyerah! Aku menyerah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411302
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411302,
					"content": "Ka-kalian datang ke sini demi pitanya, kan? Aku kasih semuanya ke kalian! Jangan pukul aku lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411303
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411303,
					"content": "Komandan Fatui pun menyerahkan semua data penelitian ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740411304
					]
				},
				{
					"id": 740411304,
					"content": "Gimana, Broglie? Ini sudah semuanya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411305,
					"content": "Hm ... mungkin? Ya, benar, harusnya sudah semuanya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411306
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411306,
					"content": "Ah, sudahlah, anggap aja aku enggak tanya deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411307,
					"content": "Apa tujuan kalian?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740411308
					]
				},
				{
					"id": 740411308,
					"content": "Iya, kasih tahu yang jujur! Sebenarnya buat apa kalian menduduki pos-pos pengamatan ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411309,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411310
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411310,
					"content": "Bu ... buat bermalas-malasan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411311
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411311,
					"content": "...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411312,
					"content": "Namaku Malinovskyi, kapten Tim Investigasi Mandiri ke-34.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411313
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411313,
					"content": "Awalnya, waktu kami baru ditugaskan ke Fontaine, semua orang senang sekali, tidak ada tugas yang susah juga ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411315
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411315,
					"content": "Hm ... Jadi, apa hubungannya sama kamu menduduki pos pengamatan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411316,
					"content": "Siapa sangka, karena perubahan hubungan beberapa bulan lalu, Snezhnaya kirim orang bernama Shumilov untuk menjadi wakil baruku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411317
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411317,
					"content": "Shumilov? Ah, kapten yang kemarin kita ketemu di Stasiun Crepes Suzette ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411318,
					"content": "Betul! Aku betulan tidak tahan dengan orang itu! Tapi, aku tidak bisa menyingkirkannya. Aku cuma bisa cari alasan untuk menjalankan misi di luar biar bisa kabur darinya—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411319
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411319,
					"content": "Bentar-bentar. Paimon jadi bingung ... Orang bernama Shumilov itu wakilmu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411320,
					"content": "Iya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411321
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411321,
					"content": "Kalau gitu, bukannya dia bawahanmu? Kenapa atasan harus dengar perintah bawahan sih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411322,
					"content": "Si orang sialan itu, jelas-jelas dia bawahanku, tapi dia selalu terlihat serius dan menyuruh orang lain untuk bekerja keras!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411323
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411323,
					"content": "Semua yang dia bilang tidak bisa kubantah — Aku tidak bisa bilang di depan orang lain kalau semua orang sebenarnya sama sekali tidak mau kerja, kan?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411324
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411324,
					"content": "Kebetulan aku lihat ada menara aneh di dekat sini. Jadi, aku langsung bilang kalau kami mau ke sini untuk investigasi, lalu memalsukan surat dari Maison Gestion ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411325
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411325,
					"content": "Huh, ternyata memang kalian yang palsuin! Setelah dipikir-pikir, gimana mungkin Maison Gestion bakal nyerahin pos pengamatan hidrologi pada kalian!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411326,
					"content": "Broglie, masih ada yang mau kamu tanyakan sama dia enggak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411327,
					"content": "Hmm ... ternyata begitu. Anda menduduki pos pengamatan kami cuma buat bermalas-malasan ... Bukan, cuma ingin mendapatkan ketenangan sejenak di tengah hiruk pikuk dunia ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411328
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411328,
					"content": "Jadi? Gimana rasanya menurut Anda istirahat di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411329
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411329,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411330
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411330,
					"content": "Hmm ... nyaman banget? Pemandangan sekitar juga sangat indah. Setelah tidur siang, aku merasa suasana hatiku juga jadi senang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411331
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411331,
					"content": "Ya, kan? Terutama setelah bangun dan menyadari Anda tidak harus melakukan pekerjaan yang mendesak. Tidak ada orang menjengkelkan yang mengawasi Anda dan Anda bisa menikmati sinar matahari sore dan angin sepoi-sepoi dengan tenang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411332
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411332,
					"content": "Ini ibarat seperti terbangun dari satu mimpi dan masuk ke mimpi lain di mana Anda tidak perlu mencemaskan apa pun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411333
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411333,
					"content": "Heh, begitulah hidup! Tapi, sayangnya, Anda belum pernah mencicipi teh edisi terbatas yang dijual Vassari Passage, kan? Kalau punya kesempatan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411334
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411334,
					"content": "Tunggu, tunggu. Kenapa kalian tiba-tiba ngomongin topik enggak jelas sih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411335
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411335,
					"content": "Oke, mending kamu nurut saja dan ikut kami! Sekarang waktunya buat mengakui kejahatanmu di hadapan Institut Penelitian Fontaine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411336
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411336,
					"content": "Aduh—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411337
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411337,
					"content": "To-tolong tunggu sebentar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411338
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411338,
					"content": "#{M#Kedua Penyelamat}{F#Kedua Nona Penyelamat}! Pada kenyataannya, Tuan ini tidak menyebabkan kerusakan apa pun pada penelitian hidrologi kami, ya, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411339
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411339,
					"content": "Dilihat dari hasilnya secara objektif, Tuan ini bahkan membantu kita mengumpulkan sejumlah data ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411340
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411340,
					"content": "Selain itu, dia cuma tidak mau kerja, cuma mau menikmati hidup santai dan bahagia saja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411341
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411341,
					"content": "I-iya benar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411342
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411342,
					"content": "Enggak, walau kalian berdua ngomongnya sepercaya diri ini, ini bukan sesuatu yang patut dibanggakan lah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411343
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411343,
					"content": "#Aku mohon, {M#Tuan}{F#Nona} yang baik hati! Demi kepentingan ilmiah, mohon Anda bisa bermurah hati dan lepaskan dia sekali ini saja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411344,
						740411345
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411344,
					"content": "Walau kayaknya tidak ada hubungannya dengan kepentingan ilmiah ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740411346
					]
				},
				{
					"id": 740411346,
					"content": "Te-terima kasih, Tuan dan juga kalian berdua! Aku bersumpah aku tidak akan melakukan hal seperti ini lagi! Mulai sekarang, aku pasti akan berusaha keras dan bermalas-malasan dengan kemampuanku sendiri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411347
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411347,
					"content": "Benar! Yang terpenting adalah tekad yang seperti itu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411348
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411348,
					"content": "Jangan membangkitkan semangat juang yang aneh di tempat kayak gini dong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411349
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411349,
					"content": "Komandan Fatui pergi dengan rasa bersyukur ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740411350
					]
				},
				{
					"id": 740411350,
					"content": "Oke! Karena masalahnya sudah diselesaikan dengan sangat memuaskan, aku juga harus pulang untuk menyusun data-data ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411351
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411351,
					"content": "Terima kasih banyak pada kalian berdua! Aku mohon terimalah ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411352
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411352,
					"content": "Be ... Benar-benar sudah diselesaikan dengan sangat memuaskan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411353
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411353,
