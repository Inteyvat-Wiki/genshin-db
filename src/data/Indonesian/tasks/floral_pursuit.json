			"dialogs": [
				{
					"id": 705280401,
					"content": "*huff* Memangnya Guild sempat ya kerja sebanyak ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280402
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280402,
					"content": "Ah, Pengembara! Maaf aku baru sadar kamu datang. Sekarang aku sedang kepikiran urusan Guild nih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280403
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280403,
					"content": "Kamu pasti datang ke Mondstadt untuk mengikuti Festival Windblume ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280404
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280404,
					"content": "Kamu datang tepat waktu! Adventurers' Guild baru mengeluarkan sebuah permainan baru. Santai, seru, dan yang jelas kalian akan mendapatkan hadiah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280405
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280405,
					"content": "Bagaimana? Tertarik mencoba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280406
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280406,
					"content": "Oke, biar kujelaskan permainan ini padamu. Orang yang mendesain permainan ini memberinya nama \"Catur Bunga\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280407
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280407,
					"content": "Dia bilang dia terinspirasi dari kelopak bunga yang berjatuhan dan tertiup oleh angin semilir ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280408
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280408,
					"content": "Dan permainan ini bertujuan untuk meniru ... nuansa romantis angin semilir yang mengejar bunga-bunga itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280409,
						705280410
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280409,
					"content": "Uh, ceritanya ... bagus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705280411
					]
				},
				{
					"id": 705280411,
					"content": "Yah, penciptanya seorang penyair sih, jadi lumayan ... kreatif.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280412
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280412,
					"content": "Tapi gampangnya, waktu kamu main catur ini kamu harus mengumpulkan sebanyak mungkin Balon Bloom di papan caturnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280413
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280413,
					"content": "Kamu harus melewati segala rintangan yang ada ... lalu kami juga menyiapkan beberapa alat yang bisa kalian gunakan untuk membantumu menyelesaikan permainannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280414
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280414,
					"content": "Si pembuatnya bahkan menulis panduan lengkap buat permainan ini, nanti kukasih lihat ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280415
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280415,
					"content": "Kamu boleh langsung mencobanya kalau tertarik. Ingat, hanya dengan berpartisipasi saja kamu dijamin mendapatkan hadiahnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280410,
					"content": "Ce-Ceritanya rumit juga ya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705280411
					]
				}
			]
		}
	]
}