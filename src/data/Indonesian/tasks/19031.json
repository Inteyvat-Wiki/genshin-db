			"dialogs": [
				{
					"id": 1903102101,
					"content": "Berjalan seorang diri di sini berbahaya, bukan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102102
					],
					"speakerTitle": "Fu San'er"
				},
				{
					"id": 1903102102,
					"content": "Kamu tidak akan tahu siapa... atau \"apa\" yang akan kamu temui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102103,
						1903102104
					],
					"speakerTitle": "Fu San'er"
				},
				{
					"id": 1903102103,
					"content": "....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903102105
					]
				},
				{
					"id": 1903102105,
					"content": "Hmm, ternyata kamu cukup tenang juga. Ada satu pepatah, \"Selama kamu berjalan di tepi sungai, cepat atau lambat sepatumu pasti akan basah juga.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102106
					],
					"speakerTitle": "Fu San'er"
				},
				{
					"id": 1903102106,
					"content": "Kamu pasti akan bertemu sesuatu di tempat aneh dan menakutkan seperti ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102107
					],
					"speakerTitle": "Fu San'er"
				},
				{
					"id": 1903102107,
					"content": "Dan apa yang kamu temui di sini bisa menjadi mimpi buruk yang menghantuimu seumur hidup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102108,
						1903102109
					],
					"speakerTitle": "Fu San'er"
				},
				{
					"id": 1903102108,
					"content": "Oh, benarkah?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903102110
					]
				},
				{
					"id": 1903102110,
					"content": "Eh? Bagaimana kamu bisa begitu tenang? Biasanya orang sudah lari ketakutan sebelum aku selesai bicara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102111,
						1903102114
					],
					"speakerTitle": "Fu San'er"
				},
				{
					"id": 1903102111,
					"content": "Kamu terlihat seperti orang biasa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903102112
					]
				},
				{
					"id": 1903102112,
					"content": "Ya... tapi cara yang lebih pintar untuk memerankan hantu adalah dengan menciptakan suasana menyeramkan yang membuat orang takut secara psikologis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102113
					],
					"speakerTitle": "Fu San'er"
				},
				{
					"id": 1903102113,
					"content": "Dalam arti, penampilanku tidaklah penting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102117
					],
					"speakerTitle": "Fu San'er"
				},
				{
					"id": 1903102117,
					"content": "*huff* Selain itu, aku tidak akan bisa menakuti orang sepertimu yang memang tidak takut hantu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102118
					],
					"speakerTitle": "Fu San'er"
				},
				{
					"id": 1903102118,
					"content": "Kedengarannya kamu hanya mencari alasan untuk bermalas-malasan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903102119
					]
				},
				{
					"id": 1903102119,
					"content": "Hei, jangan fitnah ya! Sudahlah, lebih baik aku cari orang lain yang bisa ditakut-takuti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102120
					],
					"speakerTitle": "Fu San'er"
				},
				{
					"id": 1903102120,
					"content": "Sebaiknya kamu kembali dan cari temanmu. Mungkin saja dia sedang ketakutan sendirian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fu San'er"
				},
				{
					"id": 1903102114,
					"content": "Kamu tidak punya kostum atau sejenisnya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903102115
					]
				},
				{
					"id": 1903102115,
					"content": "Ya, punya, tapi terlalu panas untuk dipakai... lagi pula cara yang lebih pintar untuk memerankan hantu adalah dengan menciptakan suasana menyeramkan yang membuat orang takut secara psikologis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102116
					],
					"speakerTitle": "Fu San'er"
				},
				{
					"id": 1903102116,
					"content": "Dalam arti, penampilanku tidaklah penting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102117
					],
					"speakerTitle": "Fu San'er"
				},
				{
					"id": 1903102109,
					"content": "Maaf, aku kurang paham maksudmu... Apa yang kamu lakukan di sini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903102110
					]
				},
				{
					"id": 1903102104,
					"content": "Halo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903102105
					]
				}
			]
		}
	]
