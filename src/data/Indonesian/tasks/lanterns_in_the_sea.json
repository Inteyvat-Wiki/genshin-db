				"points": []
			},
			"dialogs": [
				{
					"id": 400050201,
					"content": "Kalian berdua dari Treasure Hoarder? Kupikir aku sudah menyebutkan dengan jelas di dalam suratku bahwa kalian akan melakukan hal yang sama denganku dan memakai topeng, kostum, dan sebagainya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050202
					],
					"speakerTitle": "???"
				},
				{
					"id": 400050202,
					"content": "Tapi satu dari kalian malah berpakaian biasa. Perlu kuakui, aku mengagumi keberanianmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050203
					],
					"speakerTitle": "???"
				},
				{
					"id": 400050203,
					"content": "Hmph! Kamu mau tahu? Kami tidak perlu pergi diam-diam ke mana-mana dengan menyamar seperti itu! Karena kami tidak sepertimu, kami akan pernah melakukan sesuatu yang begitu memalukan sehingga kami harus mengenakan topeng saat melakukan sesuatu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050204,
					"content": "Serius?! Padahal aku sedang melakukan pidato dan segala macamnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050205,
						400050206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050205,
					"content": "Dia memang sudah bilang sih untuk melakukan penyamaran...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400050207
					]
				},
				{
					"id": 400050207,
					"content": "Tunggu dulu... Kalian bukan dari Treasure Hoarder! Siapa kalian?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "???"
				},
				{
					"id": 400050206,
					"content": "Dia sebenarnya terlihat keren...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400050207
					]
				}
			]
		},
		{
			"id": 4000504,
