						400050502
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400050502,
					"content": "Baiklah. Sekarang kenapa kamu memanggilku dengan paksa ke sini, ke tempat di mana kita bisa melihat Lentera Mingxiao dengan jelas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050503,
						400050504
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400050503,
					"content": "Tentu saja untuk melihat Lentera Mingxiao.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400050505
					]
				},
				{
					"id": 400050505,
					"content": "Jelas-jelas kamu adalah salah satu pahlawan dari festival ini... Kenapa kamu tidak mau terlibat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050506,
					"content": "Aku tidak bisa dekat dengan kerumunan orang. Kerumunan orang yang riang dan bahagia... Aku tidak bisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050507
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400050507,
					"content": "Aku sudah terlalu lama menghabiskan waktu dengan menderita dan membantai musuh. Hanya itu yang kutahu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050508
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400050508,
					"content": "Aku tidak akan bicara lebih banyak lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050509
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400050509,
					"content": "Sampai jumpa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050510
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400050510,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050511
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400050511,
					"content": "Tapi, jika kamu menemui masalah yang berhubungan dengan alam gaib saat di Liyue, kamu bisa mencariku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050512
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400050512,
					"content": "Entah kamu atau penduduk Liyue. Aku mendengar semuanya menangis minta tolong, memohon perdamaian, dan berharap keinginannya terbawa oleh lentera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050513
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400050513,
					"content": "Kalau begitu, selamat tahun baru.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400050514
					]
				},
				{
					"id": 400050514,
					"content": "Selamat tahun baru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050504,
					"content": "Tentu saja untuk merayakan Lantern Rite.",
					"roleType": "TALK_ROLE_PLAYER",
