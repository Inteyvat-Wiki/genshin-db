			"dialogs": [
				{
					"id": 400050401,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050402,
					"content": "Baik! Aku menyerah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050403
					],
					"speakerTitle": "???"
				},
				{
					"id": 400050403,
					"content": "Menyerah sekarang, atau rasakan kekuatan Paimonial... Eh? Kamu menyerah begitu saja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050404,
					"content": "Se-sebenarnya... aku hanyalah pencuri amatir yang mengagumi Treasure Hoarder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050405
					],
					"speakerTitle": "???"
				},
				{
					"id": 400050405,
					"content": "Pencuri amatir?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050406,
					"content": "Jadi untuk amatiran sepertiku, yang kebanyakan bekerja sendirian... Treasure Hoarder seperti pahlawan bagiku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050407
					],
					"speakerTitle": "???"
				},
				{
					"id": 400050407,
					"content": "Tu-tunggu dulu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050408,
					"content": "Jadi kupikir aku akan mencoba dan menyiapkan peluang yang menguntungkan, lalu menyerahkan janji kesetiaanku pada mereka...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050409
					],
					"speakerTitle": "???"
				},
				{
					"id": 400050409,
					"content": "Tunggu dulu! Ini tidak masuk akal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050410,
					"content": "Paimon sudah menduga hal-hal seperti pembakaran berantai dan seseorang yang lebih... kejam! Terlihat jahat! Tapi... kami malah menemukan kamu?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050411,
					"content": "...Pembakaran berantai? Kalian bicara apa sih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050412
					],
					"speakerTitle": "???"
				},
				{
					"id": 400050412,
					"content": "Jangan berpura-pura! Paimon pernah melihatmu berkeliaran di sekitar tumpukan bahan yang gampang terbakar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050413,
					"content": "Oh... Oh ya, ya, aku tahu apa yang kamu bicarakan. Tapi saat itu aku hanya memeriksa situasi saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050414
					],
					"speakerTitle": "???"
				},
				{
					"id": 400050414,
					"content": "Rencanaku yang sebenarnya tidak ada hubungannya sama sekali dengan bahan-bahan pembuatan lentera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050415
					],
					"speakerTitle": "???"
				},
				{
					"id": 400050415,
					"content": "Kamu serius?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050416,
					"content": "Aku hanya ingin mencuri Plaustrite terbesar dalam dua puluh tahun ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050417
					],
					"speakerTitle": "???"
				},
				{
					"id": 400050417,
					"content": "Rencanaku adalah menunggu hingga malam tiba lalu memotong beberapa tali pengikatnya, lalu Plaustrite itu akan terbang ke arah laut...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050418
					],
					"speakerTitle": "???"
				},
				{
					"id": 400050418,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050419,
					"content": "Lalu aku akan mencari cara untuk menariknya turun di pesisir laut. Tertutup oleh lautan awan. Sempurna sekali kan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050420
					],
					"speakerTitle": "???"
				},
				{
					"id": 400050420,
					"content": "Untuk sebuah rencana sempurna, sepertinya masih banyak kekurangannya deh... Contohnya, bagaimana kamu mau menurunkan Plaustrite besar itu kalau sudah melayang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050421,
					"content": "Aku juga sedang memikirkan hal itu. Itulah sebabnya aku belum bertindak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050422
					],
					"speakerTitle": "???"
				},
				{
					"id": 400050422,
					"content": "Orang ini benar-benar bodoh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050423,
					"content": "#Baiklah, {NICKNAME}, ayo beri dia pelajaran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050424,
					"content": "Ayo kita temui orang Yaksha itu dan laporkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
