			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Flins"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 765030101,
					"content": "#{NICKNAME} dan Paimon? Tidak kusangka bisa bertemu kalian di antah berantah seperti ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030102
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 765030102,
					"content": "Kalian sedang mengikuti suatu petunjuk? Atau tidak sengaja tersesat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030103,
						765030104
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 765030103,
					"content": "Kami lagi jalan-jalan saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765030105
					]
				},
				{
					"id": 765030105,
					"content": "Ternyata begitu. Dilihat dari dek kapal rusak ini, Biro Desain Eksperimental Kuuvahki terlihat ... megah, seperti monster raksasa yang sedang menyembunyikan diri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030106
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 765030106,
					"content": "Ya, bahkan dilihat dari kejauhan saja sudah terasa menyeramkan. Entah ada berapa banyak rahasia yang tersembunyi di dalamnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765030107,
					"content": "Ya, benda ini akan memberikan banyak inspirasi untukmu yang suka mencari bahan-bahan unik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030108
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 765030108,
					"content": "Bagaimanapun, perbatasan antara cahaya dan kegelapan adalah sumber cerita yang menarik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030109
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 765030109,
					"content": "Hehe, Flins berdiri di situ sambil bawa lentera biru ... sudah mirip banget sama adegan di buku cerita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765030110,
					"content": "Jadi, hari ini kamu enggak menjaga ... umm ... tempat itu? Kamu lagi libur? Atau lagi patroli?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765030111,
					"content": "Bisa dibilang dua-duanya. Mengawasi kemungkinan terjadinya bencana yang muncul dari bayangan adalah tugas utama para Ratnik. Di mana pun kami berada, kami selalu waspada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030112
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 765030112,
					"content": "Tapi sejauh ini, suasana di sini masih cukup stabil. Kalian tidak perlu terlalu gugup, tenang dan fokus saja pada karya kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030113,
						765030114
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 765030113,
					"content": "Mumpung ada kesempatan ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765030115
					]
				},
				{
					"id": 765030115,
					"content": "Dengan aku sebagai objeknya? Ini agak di luar dugaan. Sejujurnya, aku tidak terbiasa berdiri di depan Kamera. Menjadi yang diperhatikan daripada yang memerhatikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030116
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 765030116,
					"content": "Kalian pasti bisa mengerti. Aku lebih terbiasa dengan batu nisan yang sunyi dan bisikan orang yang sudah mati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030117
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 765030117,
					"content": "Tapi, menolak permintaan tulus dari seorang teman, rasanya sungguh tidak pantas. Pelanggaran terhadap tata krama dan sopan santun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030118
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 765030118,
					"content": "Silakan, rekam saja momen yang menurut kalian layak untuk diabadikan. Aku akan dengan senang hati menambahkan inspirasi kecil untuk karya seni kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flins"
				},
				{
					"id": 765030114,
					"content": "Boleh foto-foto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765030115
					]
				},
				{
					"id": 765030104,
					"content": "Sambil cari inspirasi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765030105
					]
				}
			]
		},
