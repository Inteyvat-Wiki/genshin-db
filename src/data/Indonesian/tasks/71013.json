				},
				{
					"id": 710131403,
					"content": "<color=#00E1FFFF>Kalau kamu tertarik, aku telah mengubur beberapa harta yang kumiliki di samping kolam. Ambillah dengan restuku.</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710131404
					],
					"speakerTitle": "Harta Karun Reruntuhan"
				},
				{
					"id": 710131404,
					"content": "Tapi mohon jangan pernah lupakan ketiga pertanyaan tersebut. Aku harap suatu hari nanti, kamu akan menemukan jawabannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Harta Karun Reruntuhan"
				}
			]
		},
		{
