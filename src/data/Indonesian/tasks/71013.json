			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710130101,
					"content": "Aku dan temanku berlatih seni bela diri sejak kecil. Kami bertekad untuk memerangi kekuatan jahat dan melindungi semua yang suci di dunia ini. Tetapi ini bukanlah tugas yang mudah tanpa bantuan <color=#00E1FFFF>Vision</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710130102
					],
					"speakerTitle": "Harta Karun Reruntuhan"
				},
				{
					"id": 710130102,
					"content": "Kami berdua mencari perlindungan di sini dan terus berlatih serta mencari <color=#00E1FFFF>Vision</color> yang kita inginkan. Kami membangun monumen ini sebagai bukti upaya kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710130103
					],
					"speakerTitle": "Harta Karun Reruntuhan"
				}
			]
		},
		{
			"id": 7101302,
			"completionStepIds": [
				7101302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7101302",
