			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710131501,
					"content": "<color=#00E1FFFF>Vision</color>... mereka datang dari alam lain. Orang-orang berkata bahwa mereka adalah hadiah ilahi, tapi tidak ada yang bisa menebak siapa yang menerimanya dan kenapa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710131502
					],
					"speakerTitle": "Harta Karun Reruntuhan"
				},
				{
					"id": 710131502,
					"content": "Teks-teks kuno menyatakan bahwa kekuatan ilahi memandang ke alam fana dengan belas kasihan dan memberikan <color=#00E1FFFF>Vision</color> kepada yang layak untuk membantu mereka berperang melawan kejahatan dan melindungi dunia. Tapi aku... aku tidak lagi membara dengan keinginan untuk membasmi monster. Aku hanya ingin berkomunikasi dengan mereka. Untuk mengerti mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710131503
					],
					"speakerTitle": "Harta Karun Reruntuhan"
				},
				{
					"id": 710131503,
					"content": "Kalau tidak mau <color=#00E1FFFF>Vision</color> juga tidak apa-apa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Harta Karun Reruntuhan"
				}
			]
		},
