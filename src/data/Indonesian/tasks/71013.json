					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710130201,
					"content": "Aku cukup beruntung untuk menerima <color=#00E1FFFF>Visionku</color>. Tapi masih ada keraguan di pikiranku: Apakah manusia biasa benar-benar memiliki kekuatan untuk suatu hari nanti membersihkan dunia ini dari monster? Dan kalau begitu, apa bedanya manusia dari monster tersebut? Bukankah mereka juga sama seperti kita, mereka berbicara, membangun, dan merasakan cinta dan kebencian, kesenangan dan kesedihan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710130202
					],
					"speakerTitle": "Harta Karun Reruntuhan"
				},
				{
					"id": 710130202,
					"content": "Dengan ini aku menuliskan keraguan terbesar pikiranku ke monumen ini. Wahai pembaca di masa depan yang nan jauh, apakah kamu akan menjadi orang pertama yang menyelesaikan teka-teki ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Harta Karun Reruntuhan"
				}
			]
		},
