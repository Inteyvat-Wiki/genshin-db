				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ningguang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110090101,
					"content": "Hari ini aku mengumpulkan semuanya di sini untuk mengumumkan sebuah hal penting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090102
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090102,
					"content": "Mungkin sebagian dari kalian sudah dengar tentang ini. Bahwa aku, berencana untuk membangun kembali Jade Chamber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090103
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090103,
					"content": "Membangun kembali Jade Chamber? Itu proyek yang besar sekali ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090104
					],
					"speakerTitle": "Hongfei"
				},
				{
					"id": 110090104,
					"content": "Jadi kabar itu benar. Pantas saja akhir-akhir ini harga bahan bangunan jadi meroket.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090105
					],
					"speakerTitle": "Changgui"
				},
				{
					"id": 110090105,
					"content": "Jade Chamber sangat berarti bagi Nona Ningguang. Bisa terlibat dalam proyek ini merupakan sebuah kesempatan besar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090106
					],
					"speakerTitle": "Zhicheng"
				},
				{
					"id": 110090106,
					"content": "Nona Ningguang, apa ada yang bisa kami bantu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090107
					],
					"speakerTitle": "Hongfei"
				},
				{
					"id": 110090107,
					"content": "Bersabarlah. Setelah berita ini tersebar beberapa hari lalu, sudah banyak orang yang menghubungiku dan menyatakan bahwa mereka tertarik untuk bergabung dalam proyek ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090108
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090108,
					"content": "Namun demikian, hari ini memang ada beberapa hal yang ingin kupercayakan pada kalian semua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090109
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090109,
					"content": "Lokasi pembangunan telah dipilih, dan sebagian besar bahan sudah dirakit. Namun masih ada tiga barang utama yang belum berhasil diperoleh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090110
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090110,
					"content": "Barang-barang tersebut adalah: Sunset Vermillionite, Wonder Core, dan Adepti Sigil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090111
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090111,
					"content": "Um ... Maaf, Nona Ningguang. Saya sudah tak asing lagi dengan Plaustrite, tapi saya tidak pernah dengar tentang kedua barang lainnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090112
					],
					"speakerTitle": "Changgui"
				},
				{
					"id": 110090112,
					"content": "Hanya potongan Plaustrite yang cukup besar, atau lebih tepatnya, Vermillionite, yang diberikan nama \"Sunset\". Batu inilah yang bisa membuat Jade Chamber melayang. Sedangkan Wonder Core adalah komponen utama struktur mekanisme Jade Chamber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090113
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090113,
					"content": "Adepti Sigil berfungsi sebagai sarana untuk mengintegrasikan perangkat mekanis dengan ilmu Adeptus. Benda itu sama pentingnya dengan inti mekanisme Jade Chamber itu sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090114
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090114,
					"content": "Walaupun ketiganya adalah barang langka, tapi aku yakin bahwa dengan koneksi dan kapabilitas yang kalian miliki, mendapatkan semuanya hanya masalah waktu saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090115
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090115,
					"content": "Aku selalu memegang teguh prinsip \"Waktu adalah uang\". Efisiensi adalah segalanya. Aku akan membayar mahal untuk barang-barang yang kalian temukan, dan lagi, 3 orang pertama yang berhasil mengumpulkan semuanya akan mendapat kesempatan mengajukan satu pertanyaan kepadaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090116
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090116,
					"content": "Kalian boleh tanya apa saja, dan aku akan menjawab dengan terus terang. Aku percaya bahwa kompensasi seperti ini cukup memuaskan bagi kalian semua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090117
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090117,
					"content": "Barang-barang ini semuanya susah dicari, tapi kalau bisa tanya soal rencana pengembangan Pelabuhan Liyue tahun depan langsung dari orang dalam, itu artinya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090118
					],
					"speakerTitle": "Changgui"
				},
				{
					"id": 110090118,
					"content": "Itu artinya kesempatan ini cuma akan datang sekali seumur hidup. Informasi dari Nona Ningguang tidak bisa dibandingkan dengan apa pun. Siapa yang punya info seperti itu akan menguasai pasar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090119
					],
					"speakerTitle": "Zhicheng"
				},
				{
					"id": 110090119,
					"content": "Haha, kebetulan sekali! Aku tidak perlu beberkan apa-apa, tapi aku baru dapat kabar tentang Plaustrite beberapa hari yang lalu. Jadi permisi dulu ya semuanya, aku ada urusan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090120
					],
					"speakerTitle": "Hongfei"
				},
				{
					"id": 110090120,
					"content": "Ah, sial ... Kita juga harus cepat, atau kesempatan berharga akan lepas begitu saja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090121
					],
					"speakerTitle": "Changgui"
				},
				{
					"id": 110090121,
					"content": "Ningguang mau bangun ulang Jade Chamber?! Hebat banget ... Kita harus ikut terlibat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090122,
					"content": "Jadi kalian sudah dengar pengumumanku, ya? Bagaimana? Tertarik?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090123
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090123,
					"content": "Aku benar-benar boleh tanya apa saja sama kamu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090124
					]
				},
				{
					"id": 110090124,
					"content": "Ya, selama pertanyaan itu masih ada di ranah pengetahuanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090125
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090125,
					"content": "#(Mungkin aku bisa cari info lebih banyak soal {F#kakakku}{M#adikku} ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090126
					]
				},
				{
					"id": 110090126,
					"content": "Yang benar? Ooh, kalau gitu Paimon bakal tanya kamu gimana caranya berbisnis!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090127,
					"content": "Jadi kita enggak bakal pernah kekurangan Mora lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090128,
					"content": "Hehe, tentu saja. Tapi sejauh apa informasi yang kubagi denganmu, semua tergantung dari kinerjamu juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090129
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090129,
					"content": "Pembangunan Jade Chamber perlu tempat yang luas. Bekas tambang yang ada di luar Golden House telah dipilih sebagai lokasi pembangunan. Setelah barang-barangnya terkumpul semua, langsung saja bawa ke sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090130
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090130,
					"content": "Aku masih ada urusan lain, kalau tidak pasti aku sendiri yang akan mengantarmu ke sana. Setelah sampai, kamu langsung saja cari sekretarisku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090131
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090131,
					"content": "Ingat, kamu berpacu dengan waktu. Kesempatan langka ada di hadapanmu ... Jangan biarkan siapa pun merebutnya dari genggamanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090132
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090132,
					"content": "Ningguang kayaknya sibuk banget ya ... Ayo, kita juga gerak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090133,
					"content": "#Kita harus tinggalkan dulu Yujing Terrace ... Loh? Lihat, {NICKNAME}, kayaknya ada yang mencurigakan di sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090134,
					"content": "Nona, kamu tampak seperti wanita muda yang terpandang dan terhormat. Aku bisa lihat bahwa kamu pasti bisa memenangkan sayembara yang diadakan oleh Nona Ningguang ini dengan mudah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090135
					],
					"speakerTitle": "Scar Liu"
				},
				{
					"id": 110090135,
					"content": "Kebetulan kami juga punya sedikit informasi tentang bahan-bahan yang mungkin menarik untukmu. Mari kita pindah ke tempat yang lebih sepi, lalu kita bisa langsung bicara soal bisnis ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090136
					],
					"speakerTitle": "Scar Liu"
				},
				{
					"id": 110090136,
					"content": "Aku tidak perlu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090137
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090137,
					"content": "Hei, jangan begitu dong. Hei, ayolah, jangan pergi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090138
					],
					"speakerTitle": "Scar Liu"
				},
				{
					"id": 110090138,
					"content": "Jangan cuma berdiri saja, cepat kejar dia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090139
					],
					"speakerTitle": "Scar Liu"
				},
				{
					"id": 110090139,
					"content": "Ba-Baik bos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qiang the Brave"
				}
			]
		},
		{
			"id": 1100902,
			"completionStepIds": [
				1100902
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1100902",
							"2"
						],
						"stepId": 1100902,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Shenhe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110090201,
					"content": "Hehe. Bagaimana, Nona? Kamu tidak bisa lari lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090202
					],
					"speakerTitle": "Scar Liu"
				},
				{
					"id": 110090202,
					"content": "Jangan khawatir. Kami bukan orang jahat. Kamu keluar uang, kami beri kamu info. Semua menang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090203
					],
					"speakerTitle": "Scar Liu"
				},
				{
					"id": 110090203,
					"content": "Bos, firasatku jelek nih. Lihat dia, rambut putihnya, dan energi yang terpancar dari dirinya ... Ada sesuatu yang beda dari dia ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090204
					],
					"speakerTitle": "Qiang the Brave"
				},
				{
					"id": 110090204,
					"content": "Terus kenapa? Dia orang kaya! Utang judi kita mau dibayar pakai apa kalau kita biarkan kantong uang ini pergi begitu saja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090205
					],
					"speakerTitle": "Scar Liu"
				},
				{
					"id": 110090205,
					"content": "Tidak artinya tidak. Aku tidak perlu informasi darimu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090206
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090206,
					"content": "Kalau masih belum paham, biar kukatakan sekali lagi, untuk terakhir kalinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090207
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090207,
					"content": "*huff* ... Ayolah, Nona. Kamu kelihatannya cukup pintar. Aku tidak perlu jelaskan lagi kan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090208
					],
					"speakerTitle": "Scar Liu"
				},
				{
					"id": 110090208,
					"content": "Ini bukan masalah kamu perlu informasinya atau tidak, oke? Ini soal kamu menyerahkan uangmu pada kami dan aku janji tidak akan ada yang terluka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090209
					],
					"speakerTitle": "Scar Liu"
				},
				{
					"id": 110090209,
					"content": "Aku—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090210
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090210,
					"content": "Tidak usah banyak alasan! Aku tahu kamu punya uang. Aku melihatmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090211
					],
					"speakerTitle": "Scar Liu"
				},
				{
					"id": 110090211,
					"content": "Ya, aku melihatmu jalan ke Liuli Pavilion, pesan makanan semeja penuh, tapi cuma cicip sedikit saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090212
					],
					"speakerTitle": "Scar Liu"
				},
				{
					"id": 110090212,
					"content": "Lalu ke Xinyue Kiosk, dan ke Wanmin Restaurant juga. Sama semua, kamu pesan semua makanan mahal, tapi cuma cicip sedikit, lalu pergi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090213
					],
					"speakerTitle": "Scar Liu"
				},
				{
					"id": 110090213,
					"content": "Mana mungkin kamu buang-buang uang begitu kalau kamu bukan dari keluarga yang kaya raya? Orang kaya macam dirimu, tidak apa-apa kan kalau bagi sedikit uang pada kami?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090214
					],
					"speakerTitle": "Scar Liu"
				},
				{
					"id": 110090214,
					"content": "Master sudah peringatkan aku agar tidak melukai siapa pun di Pelabuhan Liyue ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090215
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090215,
					"content": "Tapi begini keadaannya. Mungkin ... Yah, mungkin ini sudah \"takdir\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090216
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090216,
					"content": "Bos, ada yang tidak beres ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090217
					],
					"speakerTitle": "Qiang the Brave"
				},
				{
					"id": 110090217,
					"content": "Kamu takut apa sih? Kita cuma jual informasi, bukan melanggar hukum. Kalau dia melukai kita, malah lebih bagus. Kita bisa tuntut dia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090218,
						110090219
					],
					"speakerTitle": "Scar Liu"
				},
				{
					"id": 110090218,
					"content": "Itu mereka.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090220
					]
				},
				{
					"id": 110090220,
					"content": "Oh? Lagi-lagi kamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090221
					],
					"speakerTitle": "Zheng"
				},
				{
					"id": 110090221,
					"content": "Millelith? Ma-Mau apa Millelith ke sini? Kamu ya yang panggil? Huh! Kamu jangan ikut campur ya! Aku pasti—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090222
					],
					"speakerTitle": "Scar Liu"
				},
				{
					"id": 110090222,
					"content": "Diam! Berani-beraninya mengancam warga sipil! Ikut dengan kami!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090223
					],
					"speakerTitle": "Zheng"
				},
				{
					"id": 110090223,
					"content": "Hehe ... Jangan marah, Tuan. Biar kujelaskan dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090224
					],
					"speakerTitle": "Scar Liu"
				},
				{
					"id": 110090224,
					"content": "Para preman yang mengepung gadis berambut putih itu ditangkap oleh para Millelith.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						110090225
					]
				},
				{
					"id": 110090225,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090226,
						110090227
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090226,
					"content": "Kamu tidak apa-apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090228
					]
				},
				{
					"id": 110090228,
					"content": "Shenhe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090229
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090229,
					"content": "Shenhe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090230,
					"content": "Namaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090231
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090231,
					"content": "#Ooh, jadi namamu Shenhe! Nama Paimon ya ... Paimon, dan ini teman seperjalananku, si {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090232,
					"content": "Aku sudah pernah dengar tentang kalian berdua. Terima kasih karena sudah menangani situasi tadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090233
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090233,
					"content": "Sebetulnya aku sendiri juga bisa mengatasinya. Kurasa membenturkan kepala orang tadi ke tanah beberapa kali sudah cukup untuk membuatnya menyerah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090234
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090234,
					"content": "Astaga! Ka—Kamu enggak boleh gitu! Kasar amat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090235
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090235,
					"content": "Ini Pelabuhan Liyue. Ada hukum yang berlaku buat situasi kayak tadi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090236,
					"content": "Hukum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090237
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090237,
					"content": "Shenhe tidak tahu soal hukum?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090238
					]
				},
				{
					"id": 110090238,
					"content": "Tidak. Tidak tahu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090239
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090239,
					"content": "Masa sih!? Terus gimana caranya kamu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090241
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090241,
					"content": "Eh ... Suara apa itu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090242
					]
				},
				{
					"id": 110090242,
					"content": "Itu suara perutku. Aku belum makan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090243
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090243,
					"content": "Dia jujur banget ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090244
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090244,
					"content": "Tunggu, oh benar juga — tadi mereka bilang kamu pergi ke semua restoran, pesan ini itu tapi cuma cicip sedikit doang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090245
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090245,
					"content": "Ya pasti kamu masih lapar lah! Jadi ... kamu lagi pengen makan apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090246
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090246,
					"content": "Qingxin, Glaze Lily, Violetgrass. Biasanya aku makan itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090247
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090247,
					"content": "Tapi itu semua kan tanaman obat ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090248
					]
				},
				{
					"id": 110090248,
					"content": "Tanaman obat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090249
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090249,
					"content": "Aduh susah ya jelasinnya ... Ya sudah, Bubu Pharmacy enggak jauh dari sini. Yuk kita bawa Shenhe ke sana buat makan tanaman obat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090250
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090250,
					"content": "Lagian, kamu enggak bakal bisa ngapa-ngapain kalau perut kosong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090227,
					"content": "Jangan takut, semuanya baik-baik saja sekarang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090228
					]
				},
				{
					"id": 110090219,
					"content": "Mereka mau paksa orang berbisnis.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090220
					]
				}
			]
		},
		{
			"id": 1100903,
			"completionStepIds": [
				1100903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1100903",
							"2"
						],
						"stepId": 1100903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Herbalis Gui"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110090301,
					"content": "Kalian mau beli obat? Boleh lihat dulu resepnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090302
					],
					"speakerTitle": "Herbalis Gui"
				},
				{
					"id": 110090302,
					"content": "Qingxin, Glaze Lily, dan Violetgrass. Masing-masing seperempat kilo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090303
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090303,
					"content": "Resep macam apa ini? Kok mirip pesanan makan siang ya ... Baiklah, cuma ini yang kami punya sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090304
					],
					"speakerTitle": "Herbalis Gui"
				},
				{
					"id": 110090304,
					"content": "Terima kasih banyak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090305
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090305,
					"content": "Dia ... betulan makan semuanya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090306,
					"content": "Shenhe langsung melahap semua tanaman obatnya, dan membuat semua orang terkejut.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						110090307
					]
				},
				{
					"id": 110090307,
					"content": "Aku sudah kenyang. Terima kasih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090308,
						110090309
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090308,
					"content": "Rasanya gimana ...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090310
					]
				},
				{
					"id": 110090310,
					"content": "Tidak enak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090311
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090311,
					"content": "Memang masih ada rasa manisnya, tapi setelah makan cukup banyak, yang tersisa hanya rasa pahit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090312
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090312,
					"content": "Lah, terus kenapa malah makan ini dan enggak sentuh makanan yang di restoran?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090313,
					"content": "Kalau Paimon punya banyak Mora, Paimon bakalan pergi ke restoran paling enak di kota, terus pesan makanan semeja penuh, dan makan semuanya sekaligus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090314,
					"content": "Karena aku tidak yakin apakah aku akan tetap tinggal di sini untuk jangka panjang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090315
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090315,
					"content": "Makanan dunia fana memang sangat enak. Tetapi jika aku kembali ke pegunungan, rasa rindu terhadap makanan yang ada di sini hanya akan menjadi penghalang bagi kelanjutan perkembangan spiritualku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090316
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090316,
					"content": "Mencicipi setiap makanan untuk mengapresiasi rasanya. Itu sudah cukup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090317
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090317,
					"content": "#\"Kembali ke pegunungan\" ... betul kan. {NICKNAME}! Paimon sudah duga kalau dia itu Adeptus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090318,
					"content": "Sudah cukup bicara tentang diriku. Apa rencanamu sekarang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090319
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090319,
					"content": "Oh iya juga! Paimon hampir lupa. Kami mau ikutan sayembara membangun ulang Jade Chamber!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090320,
					"content": "Dan ... dan sekarang mungkin kita sudah ketinggalan banget karena ketahan begitu lama ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090321,
					"content": "Begitu ya. Aku memang dengar soal sayembara saat aku lewat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090322
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090322,
					"content": "Hehe ... Iya, kalau menang, kamu boleh tanya apa saja ke Ningguang loh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090323,
					"content": "Apa kamu juga datang ke sini buat ikutan sayembara, Shenhe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090324,
					"content": "Aku datang ke sini untuk membangun ulang Jade Chamber. Tapi aku tidak ada niat untuk ikut sayembara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090325
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090325,
					"content": "Namun, kamu telah berlaku baik kepadaku, dan sekarang aku ingin membantumu sebagai balasannya. Jangan khawatir. Aku melakukannya tanpa pamrih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090326
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090326,
					"content": "Wow! Padahal sebenarnya tidak usah loh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090327,
					"content": "Tapi kalau ada Adeptus yang bantu, semuanya bakal jadi lebih gampang kan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090328,
						110090329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090328,
					"content": "Oke. Kita kerja sama.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090330
					]
				},
				{
					"id": 110090330,
					"content": "Kalau begitu jangan menunda. Aku sudah punya rencana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090331
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090331,
					"content": "Mantap! Paimon yakin ini rencana paling hebat yang pernah ada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090332
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090332,
					"content": "Aku tidak tahu bagaimana, atau sampai sejauh mana, rencana ini bisa dianggap \"hebat\". Tapi, aku yakin rencana ini efektif.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090333
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090333,
					"content": "Kita hanya perlu menyingkirkan semua orang unggul dari kita. Dengan demikian, hanya kita sajalah yang tersisa sebagai pemenang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090334
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090334,
					"content": "Tidak! Enggak boleh kayak gitu! Sama sekali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090335
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090335,
					"content": "Oh ya? Tapi aku dengar bahwa sayembara dan lomba pada intinya adalah tentang konflik dan mengungguli pihak lain ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090336
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090336,
					"content": "Tapi kami mau menang dengan cara yang adil dan jujur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090337
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090337,
					"content": "Sunset Vermillionite, Wonder Core, dan Adepti Sigil ... Ayo kita mulai dari yang pertama dulu. Jadi, untuk Plaustrite—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090338
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090338,
					"content": "Aku tadi bertanya-tanya siapa yang sedang ribut di depan tokoku. Ternyata kalian ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090339
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 110090339,
					"content": "Baizhu! Kamu lagi apa di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090340
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090340,
					"content": "Nona Ningguang ingin membeli obat luka luar dalam jumlah yang besar. Toko kami sudah hampir kehabisan, jadi aku keluar untuk mengumpulkan tanaman obat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090341
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 110090341,
					"content": "Loh? Kenapa Nona Ningguang tiba-tiba perlu obat luka luar sebanyak itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090342
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090342,
					"content": "Kurang tahu ya. Kudengar dia sedang membangun ulang Jade Chamber, mungkin ini untuk pertolongan pertama di tempat pembangunan? Aku memang tidak bertanya, karena aku seharusnya tidak ikut campur urusan orang lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090343
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 110090343,
					"content": "Oh, dan dia juga meminjam Qiqi ... yang artinya Bubu Pharmacy sedang kekurangan orang sekarang. Mungkin kalian berminat untuk kerja sambilan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090344
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 110090344,
					"content": "Tidak, tidak, kami masih ada urusan lain ... Oh ya, mumpung kamu ada di sini, kamu kan kayaknya tahu tentang banyak hal ya. Apa kamu pernah dengar tentang \"Sunset Vermillionite\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090345
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090345,
					"content": "Ah, itu jenis Plaustrite yang dulu dipakai di Jade Chamber, iya kan? Benda itu disebut beberapa kali di buku \"Seven Mountain Treatises.\" Saat diaktifkan, Sunset Vermillionite akan melayang naik sampai ke atas awan. Benda itu memang amat sangat langka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090346
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 110090346,
					"content": "Menurut catatan, hampir semua Sunset Vermillionite yang ada sudah ditambang, dan sudah jadi kepunyaan orang. Tapi Feiyun Commerce Guild tahu lebih banyak tentang ini daripada aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090347
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 110090347,
					"content": "Oke deh! Yuk tanya ke Feiyun Commerce Guild.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090348
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090348,
					"content": "Makasih ya, Baizhu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090349
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090349,
					"content": "Sama-sama. Semoga berhasil, dan kalau ada hal lain lagi yang kalian perlu dari aku, datang saja ke Bubu Pharmacy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 110090329,
					"content": "Selamat datang ke tim kami.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090330
					]
				},
				{
					"id": 110090309,
					"content": "Enak gitu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090310
					]
				}
			]
		},
