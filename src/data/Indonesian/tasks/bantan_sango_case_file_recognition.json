					"Sango"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400340102,
					"content": "Ah, sesuai dugaan, kamu ada di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340103
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400340103,
					"content": "Ryuuji sekarang sedang menyelidiki Pulau Yashiori, mengikuti firasatku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340104
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400340104,
					"content": "Biar kutandai lokasi pada petamu. Kalau kamu cepat, masih sempat untuk menyusulnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340105
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400340105,
					"content": "Kenapa kita buru-buru? Bukannya Ryuuji bakal ketemu kita di sini dan pergi bareng kita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340106,
					"content": "Tentu saja karena penyelidikan ini akan segera mencapai akhirnya. Ayo cepatlah. Kita akan segera melihat kebenarannya sebentar lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340107
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400340107,
					"content": "#Ooh, sekarang setelah kamu bilang begitu, Paimon jadi ikut semangat nih! Ayo, {NICKNAME}, kita berangkat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4003402,
			"completionStepIds": [
				4003402
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003402",
							"2"
						],
						"stepId": 4003402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400340201,
					"content": "Ryuuji! Kami datang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340202,
					"content": "Ah, ternyata kalian berdua. Sango mengirimku ke sini untuk melakukan penyelidikan awal, dia bilang kamu akan menyusul. Dan dia benar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340203
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340203,
					"content": "Iya, dia bilang kamu ada di sini! Jadi bagaimana situasinya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340204,
					"content": "Di sini tidak ada apa-apa kecuali beberapa kandang untuk hewan kecil. Di mana orang-orangnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340205,
					"content": "Mereka baru saja pergi. Mereka itu para Treasure Hoarder. Sango bilang mereka berencana untuk menjual para anjing dan melatihnya untuk menjadi anjing pencuri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340206,
						400340208
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340206,
					"content": "Seperti para musang pencuri itu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340207
					]
				},
				{
					"id": 400340207,
					"content": "Benar. Masalahnya para musang adalah makhluk licik yang sulit dilatih. Jadi melatih mereka itu sebuah kegagalan. Kali ini, mereka mau mencobanya lagi dengan makhluk yang lebih setia seperti \"anjing\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340210
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340210,
					"content": "Sebelumnya, kita juga menangani beberapa komisi terkait Treasure Hoarder. Sekarang setelah kupikirkan, Sango juga benar tentang hal itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340211
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340211,
					"content": "Sama seperti orang meninggalkan jejak kaki, begitu juga para organisasi meninggalkan jejak unik mereka. Walaupun memang ada beberapa hewan lain yang hilang dan ditangkap selama prosesnya, tapi semua jejak tersebut akhirnya menunjuk kembali ke para Treasure Hoarder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340212
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340212,
					"content": "Setelah memikirkan metode yang dilakukan sebelumnya untuk menyelesaikan kasus ini, penyelidikanku menuntunku ke sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340213
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340213,
					"content": "Namun tetap saja, tanpa ada satupun penjaga ... bisa dikatakan pelaku kita ini cukup ceroboh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340214
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340214,
					"content": "#Mereka agak baik juga ya! Oke, Paimon yakin setelah beberapa hari bertempur, kamu pasti lelah juga kan, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340215,
						400340216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340215,
					"content": "Yah, karena tidak ada siapa-siapa ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340217
					]
				},
				{
					"id": 400340217,
					"content": "Iya, Paimon juga mikir begitu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340216,
					"content": "Sepertinya kita bisa langsung ambil para hewan itu diam-diam.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340217
					]
				},
				{
					"id": 400340208,
					"content": "Oh, seperti Paimon ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340209
					]
				},
				{
					"id": 400340209,
					"content": "Hei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340210
					],
					"speakerTitle": "Paimon"
				}
			]
		},
