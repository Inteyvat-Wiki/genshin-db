			"dialogs": [
				{
					"id": 400340601,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340602
					],
					"speakerTitle": "Kageroumaru"
				},
				{
					"id": 400340602,
					"content": "Guk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340603
					],
					"speakerTitle": "Kageroumaru"
				},
				{
					"id": 400340603,
					"content": "A-Apa ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340604,
						400340606,
						400340608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340604,
					"content": "Si Guguk Bertopi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340605
					]
				},
				{
					"id": 400340605,
					"content": "Eh? Tidak, ayolah, nama panggilan macam apa itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340609,
					"content": "Yah, sudahlah apa pun itu. Sepertinya dia tidak punya niat untuk menyerang kita ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340610
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340610,
					"content": "Guk guk—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340611
					],
					"speakerTitle": "Kageroumaru"
				},
				{
					"id": 400340611,
					"content": "Daaan dia pergi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340612,
					"content": "Dia berkali-kali menoleh pada kita. Apa dia ingin agar kita mengikutinya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340613
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340613,
					"content": "Ayo susul dia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340614
					]
				},
				{
					"id": 400340614,
					"content": "Iya. Mungkin kebenarannya ada di depan sana ... Mungkin semuanya sesuai dugaan Sango ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340606,
					"content": "\"Si Guguk Pisau\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340607
					]
				},
				{
					"id": 400340607,
					"content": "Tidak, tidak. Harusnya \"Si Guguk Bertopi\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340609
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340608,
					"content": "Bayangan Hitam.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340609
					]
				}
			]
		},
		{
			"id": 4003409,
			"completionStepIds": [
				4003409
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003409",
							"2"
						],
						"stepId": 4003409,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400340901,
					"content": "#Oke, sudah selesai. Tapi, aneh juga ya. Kageroumaru terlihat ramah, terus tahu-tahu kita malah bertempur! Untung ada {NICKNAME} ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340902,
					"content": "#Sebenarnya, kenapa Kageroumaru mengikutimu, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340903,
					"content": "Guk, guk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340904
					],
					"speakerTitle": "Kageroumaru"
				},
				{
					"id": 400340904,
					"content": "Suara gonggongan ini ... apa dia senang?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340905
					]
				},
				{
					"id": 400340905,
					"content": "Gimana kita bisa tahu? Paimon enggak ngerti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340906
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340906,
					"content": "#Kalau aku tidak salah tebak, Kageroumaru sekarang sudah menjadi ninken milik {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340907
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340907,
					"content": "Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340908
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340908,
					"content": "Eh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340909
					]
				},
				{
					"id": 400340909,
					"content": "Yah, aku tidak ahli sih masalah kontrak dengan ninken. Namun, katanya sih seorang ninja harus mengalahkan ninken untuk bisa mendapatkan pengakuan darinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340910
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340910,
					"content": "Ninja menginginkan rekan yang kuat, dan begitu juga ninken. Hanya dengan saling mengakui maka kontrak bisa dibuat. Sepertinya itu juga yang terjadi di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340911
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340911,
					"content": "#Tapi {NICKNAME} bukan ninja! Lalu juga ... uh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340912
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340912,
					"content": "Um ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340913,
					"content": "Ada apa, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340914
					]
				},
				{
					"id": 400340914,
					"content": "#{NICKNAME}, kamu harus janji sama Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340915
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340915,
					"content": "Janji apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340916
					]
				},
				{
					"id": 400340916,
					"content": "Kamu harus janji dulu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340917
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340917,
					"content": "Uh, oke, aku janji.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340918
					]
				},
				{
					"id": 400340918,
					"content": "Walaupun kamu sekarang melakukan kontrak dengan Kageroumaru, tapi jangan pernah lupa bahwa Paimon adalah partner perjalanan terbaik yang pernah ada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340919
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340919,
					"content": "Aku janji untuk tidak pernah lupa bahwa Paimon adalah partner perjalanan terbaik yang pernah ada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340920
					]
				},
				{
					"id": 400340920,
					"content": "Hore!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340921,
						400340922
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340921,
					"content": "Ya, memang kamu lebih bisa diandalkan sih ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340923
					]
				},
				{
					"id": 400340923,
					"content": "Yap! Kita adalah teman baik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340924
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340924,
					"content": "Ehem. Senang sekali melihat kalian berdua begitu akrab ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340925
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340925,
					"content": "Tapi mari kita kembali ke topik pembicaraan ... Jika Kageroumaru benar-benar sangat kuat, lalu kenapa orang sebelumnya meninggalkan sepucuk surat dan meminta seseorang untuk merawatnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340926
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340926,
					"content": "#Ooh, ooh, Paimon tahu! Ryuuji, kamu tahu kalau {NICKNAME} kuat sekali, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340927
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340927,
					"content": "Jauh lebih kuat daripada orang normal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340928
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340928,
					"content": "#Iya kan? Tapi, kalau suatu hari Paimon harus meninggalkan {NICKNAME}, Paimon pasti akan tetap khawatir. Ini tidak ada hubungannya dengan apakah {NICKNAME} kuat atau tidak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340929
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340929,
					"content": "Pfft, itu tidak akan pernah terjadi! Paimon cuma mengarang sebuah analogi saja. Kita sih tidak akan pernah berpisah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340930
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340930,
					"content": "Paimon ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340931
					]
				},
				{
					"id": 400340931,
					"content": "Alasanmu cukup masuk akal, Paimon. Dalam hal ini, kita hanya memiliki satu pertanyaan terakhir. Mengapa anjing ini menculik hewan kecil dari penduduk desa dan kemudian melindungi mereka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340932
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340932,
					"content": "Oh, em ... Sebenarnya, pertanyaan ini cukup sulit juga sih bagi Paimon ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340933
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340933,
					"content": "#Sayang sekali Kageroumaru tidak bisa bicara. Jika tidak, {NICKNAME} kan bisa langsung tanya dia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340934
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340934,
					"content": "Kusarankan sebaiknya kita cari Sango.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340935
					]
				},
				{
					"id": 400340935,
					"content": "Ooh, benar! Waktunya bagi otak kelompok kita untuk menunjukkan kemampuannya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340936
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340936,
					"content": "Setuju. Izinkan aku untuk mengembalikan hewan-hewan ini dulu, lalu kita akan bertemu lagi nanti di kantor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340922,
					"content": "Daripada seekor kucing atau anjing.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340923
					]
				}
			]
		},
		{
			"id": 4003410,
			"completionStepIds": [
				4003410
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003410",
							"2"
						],
						"stepId": 4003410,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sango"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400341001,
					"content": "Kami sudah kembali, Sango. Jadi ceritanya begini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341002
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400341002,
					"content": "Ah, jadi begitu. Sepertinya aku tahu kenapa Kageroumaru melindungi para hewan kecil tersebut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341003
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400341003,
					"content": "Dia pasti mencoba untuk membuat hewan lain menjadi lebih kuat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341004
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400341004,
					"content": "Dia pasti lemah saat kecil, lalu menjadi kuat seiring berjalannya waktu. Sehingga itu menjadi alasan baginya untuk membantu hewan lain menjadi lebih kuat melalui latihan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341005
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400341005,
					"content": "Namun pada akhirnya, Kageroumaru menemukanmu, seseorang yang mau melindungi yang lemah, sehingga dia menganggapmu sebagai tuannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341006
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400341006,
					"content": "Ini juga lahir dari rasa simpatinya terhadap yang lemah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341007
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400341007,
					"content": "Itu deduksiku dari petunjuk yang kita punya saat ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341008
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400341008,
					"content": "Dan untuk kejadian yang sebenarnya, aku cukup yakin dugaanku sudah benar. Namun karena Kageroumaru tidak bisa bicara, kita jadi tidak bisa tahu pasti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341009
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400341009,
					"content": "Oh, cukup masuk akal. Seperti yang diharapkan dari \"otak\" kelompok kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341010
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400341010,
					"content": "Guk, guk, guk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341011
					],
					"speakerTitle": "Kageroumaru"
				},
				{
					"id": 400341011,
					"content": "Ehe, kamu setuju sama Sango, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341012
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400341012,
					"content": "Haha. Terima kasih atas pujiannya, tapi kamu tetap tidak akan dapat diskon apa-apa walaupun kamu mengirim komisi untukku. Namun, kita tetap bisa anggap kasus ini selesai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341013
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400341013,
					"content": "Terima kasih banyak atas bantuan kalian berdua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341014
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400341014,
					"content": "Ah, benar. Aku hampir lupa. Bagaimana pendapatmu setelah menggunakan Ubiquity Net?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341015,
						400341016
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400341015,
					"content": "Cukup praktis.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400341017
					]
				},
				{
					"id": 400341017,
					"content": "Baiklah, aku mengerti. Aku akan menyampaikan saranmu pada temanku. Terima kasih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341018
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400341018,
					"content": "#Tidak masalah! Silakan datang kembali pada kami jika kamu mempunyai masalah. {NICKNAME} pasti akan langsung menangani kasusnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341019
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400341019,
					"content": "Kamu memang benar-benar hebat, Pengembara. Tapi tidak perlu basa-basi lagi. Sentimentalitas adalah musuh kebenaran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				},
				{
					"id": 400341016,
					"content": "Percayalah, aku benar-benar takut kalau jaringnya bakal robek ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400341017
					]
				}
			]
		},
		{
			"id": 4003411,
			"completionStepIds": [
				4003411
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003411",
							"2"
						],
						"stepId": 4003411,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kageroumaru"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400341101,
					"content": "Fiuh, akhirnya kita berhasil nyusul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400341102,
					"content": "Eh? Sepertinya ... ada surat di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341103
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400341103,
					"content": "Ayo kita baca. Ini kan petunjuk terakhir kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341104
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400341104,
					"content": "Hehehe, benar! Biar Paimon lihat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400341105,
					"content": "\"Kepada siapa pun ...\" Bla bla ... Aduh, ini sudah terlalu rusak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400341106,
					"content": "Mungkin \"Kepada siapa pun yang membaca surat ini.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341107
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400341107,
					"content": "Hm, ya mungkin begitu. Lalu ... \"Profesi Klan kami adalah melatih ninken, dan sampai sekarang kami sudah menyediakan banyak rekan yang bisa diandalkan bagi para ninja.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400341108,
					"content": "\"... Sepertinya aku tidak bisa kembali dari ekspedisiku yang terakhir ini. Aku tidak menyesal, tapi jika ada yang masih kukhawatirkan, itu adalah Kageroumaru.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400341109,
					"content": "\"Waktu kecil dia sangat lemah, sehingga dia terlewatkan saat para ninja datang untuk membuat kontrak dengan ninken. Namun itu bukan halangan bagiku. Sebagai seorang pelatih, satu ekor anjing pun tidak akan kutelantarkan.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400341110,
					"content": "\"Hari demi hari berlalu, dan seiring berlalunya waktu, Kageroumaru bertambah kuat. Sayangnya, dia tidak mau membuat kontrak dengan ninja mana pun.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400341111,
					"content": "\"Perang masih belum terjadi, tapi surat-surat yang ada di Kantor Polisi menjadi lebih gawat. Aku tidak bisa lagi menghabiskan waktu bersamanya — waktunya untuk pergi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400341112,
					"content": "\"Aku hanya bisa meninggalkan surat ini. Jika suatu hari ada orang yang menemukannya, tolong bantu aku untuk merawat Kageroumaru.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400341113,
					"content": "\"Dia punya luka di wajahnya yang didapatnya saat masih kecil, dan tingkahnya berbeda dari para anjing lainnya.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400341114,
					"content": "Jadi \"Kageroumaru\" yang disebutkan di surat itu adalah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341115
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400341115,
					"content": "Sepertinya anjing yang membawa kita ke sini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400341116
					]
				},
				{
					"id": 400341116,
					"content": "Dia benar-benar unik! Tunggu, masih ada sesuatu di sini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400341117,
					"content": "\"Aku mengerti ini adalah sebuah permintaan yang lancang, tapi aku tidak punya pilihan lain. Lalu, jika dia ingin membuat kontrak di masa depan dan bisa datang ke sini dengan orang yang dipilihnya, maka metode kontraknya adalah sebagai berikut ...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341118
					],
					"speakerTitle": "Paimon"
				},
