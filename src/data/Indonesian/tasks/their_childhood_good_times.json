			"dialogs": [
				{
					"id": 240060201,
					"content": "Masih ketahuan juga ya, ternyata Kak Pengembara masih lebih jago dari kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060202
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060202,
					"content": "Kami pergi ke tempat kumpul ya, semoga Kakak enggak langsung ketangkap deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060203
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060203,
					"content": "Kenapa kamu berharap begitu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060204
					]
				},
				{
					"id": 240060204,
					"content": "Soalnya Kakak bilang kalau lagi main petak umpet, dia bisa dapat banyak inspirasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060205
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060205,
					"content": "Kalau inspirasinya terlalu banyak, dia harus duduk di lantai buat mengingat semuanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060206
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060206,
					"content": "Lalu aku sama Lovi pikir, berarti inspirasi ini berharga banget ya? Kami enggak boleh ganggu Kakak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060207
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060207,
					"content": "Itulah alasannya pas kami main petak umpet sama dia, kalau dianya sudah mau ketangkap, kami sengaja kasih waktu sampai dia beres mikir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060208
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060208,
					"content": "Tapi ... kalau giliran Kakak yang nyari, kami jadi harus tunggu lama sekali deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verut"
				}
			]
		},
