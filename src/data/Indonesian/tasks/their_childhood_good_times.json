				"points": []
			},
			"dialogs": [
				{
					"id": 240060101,
					"content": "Kali ini giliranku yang nyari, aku pasti bisa tangkap Lovi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060102
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060102,
					"content": "Jangan terlalu percaya diri! Kan ada beberapa tempat yang tidak bisa kamu panjat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060103
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240060103,
					"content": "I-Itu sih karena sepatuku tidak pas buat manjat! Kalau aku ganti sepatu, pasti bisa kutangkap kamu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060104
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060104,
					"content": "Kalau gitu kita semua lepas sepatu saja, begini jadi lebih adil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060105
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240060105,
					"content": "Sudah, sudah! Jangan ada yang lari-lari sambil lepas sepatu. Di sini ada banyak barang berserakan, kalau kalian sampai luka gimana?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060106
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240060106,
					"content": "I-Iya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060107
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240060107,
					"content": "Ba-Baik ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060108
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060108,
					"content": "Eh, Kak ... tadi waktu Kakak tangkap aku, kenapa Kakak kayak bingung gitu? Bahkan Kakak enggak bereaksi waktu aku lari di depan Kakak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060109
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060109,
					"content": "Eh? Benarkah? Aku bahkan enggak sadar loh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060110
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240060110,
					"content": "Iya, tadi aku sampai lari satu keliling, tapi Kakak kayak enggak lihat aku sama sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060111
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240060111,
					"content": "Tapi ... eh? Loh kok Kakak ada di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060112,
						240060115
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240060112,
					"content": "Lovi kok ada di sini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060113
					]
				},
				{
					"id": 240060113,
					"content": "Baru-baru ini Papa bilang dia mau pergi dinas kerja, Mama juga bilang mau kerja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060114
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240060114,
					"content": "Kebetulan Kak Aurele lagi datang kembalikan buku, jadi Papa minta tolong Kak Aurele buat jaga aku. Jadi aku datang ke sini buat main sama mereka deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060118
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240060118,
					"content": "Ya sudah, ayo kita lanjut main. Kali ini siapa yang mau cari?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060119,
						240060120
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240060119,
					"content": "Kukira kamu enggak suka main petak umpet?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060121
					]
				},
				{
					"id": 240060121,
					"content": "Oh, karena ... belakangan ini aku lagi nulis komentar, jadi aku lagi mikirin sebuah masalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060122
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240060122,
					"content": "Lalu aku merasa kalau olahraga itu bisa membuat pikiran lebih jernih, jadi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060123
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240060123,
					"content": "Tapi Kakak sering linglung sendiri, kadang bisa berdiri di tempat sambil bicara dengan diri sendiri. Dipanggil pun enggak ada reaksi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060124
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240060124,
					"content": "Kak Pengembara ikut kami main yuk? Kak Pengembara pasti lebih jago main petak umpet daripada Kakak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060125,
						240060126
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060125,
					"content": "Boleh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060127
					]
				},
				{
					"id": 240060127,
					"content": "Hehe, harus dong. Aku sama Lovi ini sudah jadi master petak umpet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060128
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060128,
					"content": "Kalau gitu kita mulai ya. Lovi, yuk kita cari tempat sembunyi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060129
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060129,
					"content": "Lovi dan Verut lari secepat angin, sementara Aurele pergi perlahan-lahan sambil berpikir ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 240060126,
					"content": "Aku akan main serius ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060127
					]
				},
				{
					"id": 240060120,
					"content": "Kok tiba-tiba kamu jadi mau main petak umpet?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060121
					]
				},
				{
					"id": 240060115,
					"content": "Kalian masih main petak umpet ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060116
					]
				},
				{
					"id": 240060116,
					"content": "Iya, soalnya kebetulan Paman Delerue mau pergi dinas, Bibi Dumay juga mau pergi kerja. Jadi mereka minta tolong padaku buat jaga Lovi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060117
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240060117,
					"content": "Jadi aku bawa Lovi ke sini buat main sama-sama. Semoga roknya jangan sampai terlalu kotor ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060118
					],
					"speakerTitle": "Aurele"
				}
			]
		},
