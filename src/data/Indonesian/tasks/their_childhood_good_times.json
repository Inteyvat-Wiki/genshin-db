						240060605
					]
				},
				{
					"id": 240060605,
					"content": "Asal dia enggak sampai kayak Papa-ku yang minum kopi sampai banyak banget, harusnya sih dia sehat-sehat saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060606
					],
					"speakerTitle": "Lovi"
				},
				{
