			"dialogs": [
				{
					"id": 240060601,
					"content": "Tidak bisa, tidak bisa ... argumen yang ini kurang kuat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060602
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240060602,
					"content": "Lagi-lagi Kak Aurele sibuk sendiri deh ... Kak Pengembara, terima kasih sudah temani kami main ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060603,
						240060604
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240060603,
					"content": "Dia ... enggak apa-apa, kan?",
					"roleType": "TALK_ROLE_PLAYER",
