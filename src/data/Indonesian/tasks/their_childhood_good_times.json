				},
				{
					"id": 240060402,
					"content": "Eh?! Di sini pun masih bisa ketahuan? Kak Pengembara ini sebenarnya sudah main petak umpet berapa ratus kali sih ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060403
