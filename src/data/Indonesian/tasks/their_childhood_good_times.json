					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060304
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240060304,
					"content": "Hmmm, apa sudut pandang ini sudah benar? Tidak juga, eh ... benar tidak ya?",
