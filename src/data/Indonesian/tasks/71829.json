			]
		},
		{
			"id": 7182903,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182902",
							"2"
						],
						"stepId": 7182902,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jiangxue"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718290301,
					"content": "Wah? Tumben sekali ada tamu. Biasanya hanya ada aku dan si koki duduk berhadapan sambil diam seribu bahasa. Hari ini ada kamu, mungkin suasanya akan lebih hidup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290302
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290302,
					"content": "Tapi kulihat muka si koki hari ini kusut sekali, sepertinya ada sesuatu yang mengganggunya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiangxue"
				}
			]
		},
		{
			"id": 7182904,
			"completionStepIds": [
				7182903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182903",
							"2"
						],
						"stepId": 7182903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jiangxue",
					"Yanxiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718290401,
					"content": "Bakso Shizitou ini enak. Dagingnya meleleh di mulut, kuah kaldunya gurih dan harum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290402
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290402,
					"content": "Eh? Ternyata ada daging kepiting di dalam baksonya. Pantas saja jauh lebih segar daripada biasanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290403
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290403,
					"content": "Pengembara, ayo kemari dan coba. Begini caranya, pertama pakailah sumpit untuk mencungkil baksonya, lalu celupkan ke dalam kuah kaldu. Terakhir, kita kunyah bersama dengan nasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290404,
						718290405,
						718290407
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290404,
					"content": "Jangan repot-repot...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290409
					]
				},
				{
					"id": 718290409,
					"content": "Kalian berdua makanlah sampai kenyang. Nanti kalau aku sudah tak kerja di sini lagi, kalian mau makan masakanku juga tidak bisa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290410
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718290410,
					"content": "Tidak kerja di sini lagi... Apa maksud omonganmu itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290411
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290411,
					"content": "Ah, apakah karena aku terlalu sering makan dan minum gratisan di sini sampai membuat muak penjaga penginapan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290412
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290412,
					"content": "Tapi tidak juga. Aku banyak menangkap ikan dan memberikannya ke penginapan, seharusnya cukup untuk pengganti uang makan. Penjaga penginapan juga bukan orang yang pelit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290413
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290413,
					"content": "Kamu mabuk ya, ikan-ikan yang kamu pancing itu mana cukup? Lagi pula, akhirnya kamu sendiri juga yang makan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290414
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718290414,
					"content": "Kalau begitu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290415
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290415,
					"content": "Sudahlah... Biar kuberi tahu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290416
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718290416,
					"content": "Penyajian yang cantik, rasa yang enak, porsi cukup besar, memperlihatkan keahlian koki, dan khas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290417
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290417,
					"content": "Hahaha, penjaga penginapan ingin kamu menciptakan suatu masakan yang belum pernah ada di dunia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290418
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290418,
					"content": "Kalau mau tertawa, tertawalah. Nanti saat aku sudah tidak di sini, kita lihat ada siapa lagi yang rela memberimu makan gratis!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290419
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718290419,
					"content": "Baiklah, baiklah. Aku hanya penasaran kenapa hari ini muka koki kita tampak cemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290420
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290420,
					"content": "Bukan begitu, aku hanya tidak tahu kenapa penjaga penginapan tiba-tiba banyak maunya dan menekanku begini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290421
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718290421,
					"content": "Jangan panik. Meskipun tidak bisa masak, aku tahu satu resep hidangan yang ajaib.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290422
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290422,
					"content": "Ini cerita ketika dulu aku mengembara di bangsa asing dan beruntung mendapat kesempatan dari sebuah keluarga saudagar kaya raya untuk mencicipi hidangan yang bernama \"Chicken Tofu Pudding\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290423
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290423,
					"content": "Hidangan ini dikenal sebagai \"daging yang tak nampak\", lembut seperti tahu, tetapi berasa gurih dan lezat layaknya daging. Sungguh layak disebut ajaib.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290424
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290424,
					"content": "Selesai makan, aku menjadi penasaran dan akhirnya menanyakan resepnya. Namun sayang sekali aku bukanlah orang yang mahir memasak, sehingga sekarang resep itu hanya menjadi sebuah catatan kaki di ingatanku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290425,
						718290428
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290425,
					"content": "Bagaimana ceritanya sampai kamu sampai diajari resep sehebat itu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290426
					]
				},
				{
					"id": 718290426,
					"content": "Hmm... singkatnya, aku membantu keluarga itu menyelesaikan suatu keperluan, dan mereka menjamuku sebagai ungkapan rasa terima kasih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290427
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290427,
					"content": "Koki yang menciptakan masakan ini cukup percaya diri dan yakin bahwa di dunia ini hanya ada segelintir orang yang mampu membuatnya, sehingga dia merasa tidak masalah memberikan resepnya padaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290429
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290429,
					"content": "Begitulah, hidangan ini memang memiliki tingkat kesulitan yang tinggi. Koki itu mengatakan bahwa terampil dalam memasak saja tidak cukup, siapa pun yang mau membuatnya harus menguasai ilmu pedang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290430
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290430,
					"content": "Hei, masakan macam apa ini sampai harus tahu ilmu pedang segala? Kalau cuma memotong daging saja, teknik pisauku pun sudah cukup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290431
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718290431,
					"content": "Kalau mengandalkan teknik pisaumu itu untuk mencincang, aku khawatir kalau papan talenannya sudah terbelah dua bahkan sebelum dagingnya dipotong halus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290432
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290432,
					"content": "Koki itu bilang, kunci masakan ini terletak pada daging cincangnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290433
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290433,
					"content": "Kendalimu atas pisau harus sempurna. Pertama, ambil urat menggunakan ujung pisau, lalu cincang daging sampai halus, kemudian pukul daging dengan punggung pisau sampai lembut...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290434
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290434,
					"content": "Stop, tunggu dulu... Kalau begitu, percuma saja daritadi kamu jelaskan resepnya, karena aku bukan seorang ahli pedang, dan kamu pun bukan seorang ahli memasak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290435
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718290435,
					"content": "Kalau begitu, di mana kita bisa menemukan jagoan pedang yang juga bisa memasak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290436
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718290436,
					"content": "Hmm... Jauh di cakrawala, dekat di depan mata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290437,
						718290439
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290437,
					"content": "Maksudmu... Aku?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290438
					]
				},
				{
					"id": 718290438,
					"content": "Benar. Bukankah pengembara bisa memasak dan juga mahir berpedang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290441
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290441,
					"content": "Bagaimana kalau kita minta Pengembara yang mencoba membuat hidangan unik itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290442
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290442,
					"content": "Tapi, penjaga penginapan kan meminta Yanxiao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290443
					]
				},
				{
					"id": 718290443,
					"content": "Betul, penjaga penginapan meminta koki untuk menciptakan menu baru. Selama ada menu baru, ia tidak akan mempermasalahkan siapa yang membuatnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290444
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290444,
					"content": "Bagaimana menurutmu, koki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290445
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290445,
					"content": "Ba...iklah! Aku setuju, aku setuju!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290446
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718290446,
					"content": "\"Chicken Tofu Pudding\" ini... perlu bahan apa saja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290447
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718290447,
					"content": "Bahannya umum saja, hanya membutuhkan Fowl, Ham, Bird Egg, dan Snapdragon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290448
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290448,
					"content": "Fowl dan Ham masih ada stok di dapur, tapi seingatku Bird Egg dan Snapdragon sudah habis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290449
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718290449,
					"content": "Ah, kalau tahu begini aku tak akan masak sup telur Matsutake...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290450
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718290450,
					"content": "Pengembara, bisakah kamu membawakanku masing-masing satu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290451
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718290451,
					"content": "Kalau sudah dapat, ayo kita sama-sama membuat \"Chicken Tofu Pudding\" ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290452
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718290452,
					"content": "Tentu saja aku tidak akan lupa membalas budi baikmu. Kali ini tolong ya, Pengembara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718290439,
					"content": "Aku memang bisa masak sih...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290440
					]
				},
				{
					"id": 718290440,
					"content": "Dan juga mahir berpedang. Aku pernah mengamatimu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290441
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290428,
					"content": "Pasti sulit sekali...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290429
					]
				},
				{
					"id": 718290405,
					"content": "Kamu jago sekali...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290406
					]
				},
				{
					"id": 718290406,
					"content": "Hahaha, kalau sering makan enak, sebodoh-bodohnya orang lama kelamaan akan jadi paham dengan sendirinya. Kemarilah, kuajari cara menikmati ikan rebus ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290409
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290407,
					"content": "Kamu tidak mau makan bersama?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290408
					]
				},
				{
					"id": 718290408,
					"content": "Aku? Tidak usah, aku sudah kenyang makan omelan penjaga penginapan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290409
