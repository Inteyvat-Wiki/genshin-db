				"points": []
			},
			"dialogs": [
				{
					"id": 718291401,
					"content": "Biar kucicipi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291402
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718291402,
					"content": "Wah... Rasanya gurih sekali, tapi ketika dimakan teksturnya lembut seperti tahu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291403
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718291403,
					"content": "Penampilannya cantik, teknik memasaknya juga terlihat dengan jelas, dan julukan \"masakan ajaib\" pun kurasa tidak terlalu berlebihan. Aku yakin akan ada banyak orang yang suka dengan makanan ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291404
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718291404,
					"content": "Bagus! Bagus sekali! Penjaga penginapan pasti suka masakan ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291405
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718291405,
					"content": "Tak pernah kubayangkan kalau tukang makan gratisan sepertimu punya daya ingat yang sangat hebat sampai bisa hafal resep seperti ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291406
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718291406,
					"content": "Hehe, sejujurnya kisah ini cukup menggelikan. Awalnya, aku menyangka ada teknik pedang yang tersembunyi di dalam resep ini. Aku bahkan mempelajarinya siang dan malam...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291407
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718291407,
					"content": "Kalau melihat ke belakang, dulu aku sungguh seorang yang gila pedang. Hanya sebuah resep masakan, kalau dipikir-pikir mana mungkin menyembunyikan teknik pedang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291408
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718291408,
					"content": "Sebenarnya dulu untuk apa kamu berlatih pedang?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718291409
					]
				},
				{
					"id": 718291409,
					"content": "Untuk menemukan seseorang dan menuntut keadilan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291410
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718291410,
					"content": "Hah! Itu hal yang hebat! Tapi aku lebih kagum lagi ternyata kamu bisa membicarakan hal besar itu dengan rendah hati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291411
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718291411,
					"content": "Haha, setelah berhasil menuntut keadilan, aku pun tiba di tempat ini. Beruntung sekali, penjaga penginapan mau menerima aku yang pengangguran ini dan membiarkanku tinggal di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291412
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718291412,
					"content": "Sekarang aku sudah tidak ingin suatu apa pun, tidak mampu lagi mengayunkan pedang, dan tidak punya keahlian lain sama sekali... Hahaha, kurasa tidak buruk juga menghabiskan sisa hidupku di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291413
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718291413,
					"content": "Ah, biar kutuliskan resep ini agar kamu bisa membuatnya sendiri sewaktu-waktu. Mungkin akan sedikit repot, tapi rasanya sungguh enak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291414,
						718291415
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718291414,
					"content": "Terima kasih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718291417
					]
				},
				{
					"id": 718291417,
					"content": "Hah, sekarang biar kusimpan dulu masakan ini di pinggir, nanti kuhidangkan saat penjaga penginapan datang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291418
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718291418,
					"content": "Lalu... kemarilah, tukang numpang makan, jangan pergi dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291419
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718291419,
					"content": "Kamu mau apa? Aku sudah tidak punya resep yang lain lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291420
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718291420,
					"content": "Tadi kan kamu bilang tidak punya keahlian selain bermain pedang? Kemarilah, biar aku mengajarimu cara memotong daging.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291421
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718291421,
					"content": "Memotong daging? Aku khawatir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291422
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718291422,
					"content": "Sudahlah, ayo cepat. Belajar memotong daging lalu belajar masak. Bisa masak beberapa macam hidangan saja sudah cukup untuk dihitung sebagai keahlian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291423
					],
