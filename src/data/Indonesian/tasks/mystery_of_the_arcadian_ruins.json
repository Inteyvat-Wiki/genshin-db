			"dialogs": [
				{
					"id": 4620401,
					"content": "Coba lihat, apa isinya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620402,
					"content": "\"Dia sama sekali tidak mencintai lelaki itu. Cinta yang berembus di musim semi, semuanya hanyalah sandiwara. Waktu dia kedinginan seorang diri, hatinya yang sesungguhnya terlihat.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620407,
					"content": "Lihat, ternyata ada peta yang lain juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620403,
					"content": "Hah? Teka-teki lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620404,
					"content": "Ah, pusing sekali... rasanya Paimon sudah kehabisan ide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620405,
					"content": "Tampaknya kamu bahkan belum mulai berpikir...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620406
					]
				},
				{
					"id": 4620406,
					"content": "Hei! Pokoknya sekarang kamu yang berpikir, kalau bingung, cari Kaeya saja~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
