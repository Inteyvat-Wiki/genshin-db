			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaeya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4620701,
					"content": "\"Cintanya hanyalah sandiwara, gairah yang mengalir bagaikan mata air di musim semi hanyalah tipu muslihat. Saat dalam dinginnya kesendirian, hatinya yang sesungguhnya tersirat.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620702
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620702,
					"content": "Kamu tahu apa maksudnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620703,
					"content": "Bukankah ini cuplikan dari beberapa halaman di novel cinta yang baru kamu temukan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620704
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620704,
					"content": "Oh, jadi ini bukan petunjuk ya~ Pantas saja Paimon tidak mengerti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620705,
					"content": "Hahaha... aku hanya bercanda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620706
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620706,
					"content": "Hmph... Kaeya! Serius sedikit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620707,
					"content": "Haha, teka-teki ini sulit dipecahkan... Mata air musim semi, apa maksudnya adalah Springvale?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620708
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620717,
					"content": "Mungkin waktu ada orang yang mandi di mata air?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 4620724,
					"content": "Waktu tinggi permukaan air berubah?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 4620708,
					"content": "\"Gairah yang mengalir bagaikan mata air di musim semi...\" Jadi, kapan gairah mengalir di mata air?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620709
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620718,
					"content": "Perbuatan tidak senonoh semacam ini... kurasa tidak seharusnya ditemukan di Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620719,
					"content": "Jangan bilang kalau itu hobimu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620720,
					"content": "Oh, maaf. Tidak seharusnya aku mencampuri kegemaran orang lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620721,
					"content": "Hei, kamu kira kami orang macam apa??",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620723,
					"content": "Hmm... Mungkin waktu ketinggian air di mata air berubah?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 4620722,
					"content": "Haha. Intinya, kalau \"gairah\" yang mengalir bukan dari mata air, berarti datang dari orang yang mandi di sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620725,
					"content": "Mungkin juga! Seperti... waktu ada air terjun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620726,
					"content": "Kalau begitu, mungkin jawabannya ada di balik air terjun di belakang gunung Springvale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620727,
					"content": "Hanya mata air yang memberkati Mondstadt itu yang cocok mengungkapkan \"gairah\" yang dijelaskan di sini .",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620709,
					"content": "Dan yang dimaksud dengan \"jantung air terjun\" pasti jurang yang ada di sebelah kiri air terjun itu. Aku melihatnya waktu sedang patroli di sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620710
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620710,
					"content": "Dan bagian terakhir, \"dinginnya kesendirian,\" mungkin berhubungan dengan Cryo, yang bisa dikendalikan dengan Vision.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620711
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620712,
					"content": "Terima kasih atas bantuanmu, Kaeya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620713
					]
				},
				{
					"id": 4620711,
					"content": "Sebaiknya <color=#00E1FFFF>kamu pergi bersama seseorang yang memiliki kekuatan Cryo bersamamu</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620712
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620713,
					"content": "Ah, bukan apa-apa. Kalau menjawab teka-teki saja tidak bisa, bagaimana Knight bisa memecahkan kasus kriminal di kota?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620714
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620714,
					"content": "Silakan lanjutkan tugasmu saja, Kaeya. Sekarang kami akan segera pergi ke Springvale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620715
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620715,
					"content": "Hah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620716
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620716,
					"content": "Uhm maksudku, kamu pergi PECAHKAN kasus kriminalmu~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
