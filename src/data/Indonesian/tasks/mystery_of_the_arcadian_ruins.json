			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vile"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4620301,
					"content": "Aduh... kenapa hal seperti ini terjadi padaku, tidak seharusnya aku menolong <color=#00E1FFFF>dia</color>...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620302
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 4620302,
					"content": "Dia...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620303,
					"content": "Ah, terima kasih sudah menolongku! Kalian jauh lebih bisa diandalkan dibanding orang-orang Favonius!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620304
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 4620304,
					"content": "#Ah, bukan apa-apa. Sebagai pengembara, {NICKNAME} harus berhadapan dengan tantangan-tantangan seperti ini setiap saat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620305,
					"content": "Pengembara? Aku sudah mendengar cerita tentangmu. Aku tak menyangka kalau aku akan diselamatkan oleh <color=#00E1FFFF>orang yang memang rencananya kutemui di sini</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620306
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 4620306,
					"content": "Ah! Rupanya kamu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620307,
					"content": "Haha, awalnya aku tidak tahu bagaimana cara membalas budi, tapi sekarang, bagaimana kalau kuberikan intel yang kupunya dengan cuma-cuma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620308
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 4620308,
					"content": "Sebenarnya hal terpenting di perdagangan intel adalah, mempunyai teman sebanyak mungkin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620309,
						4620311
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 4620309,
					"content": "Benarkah?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620310
					]
				},
				{
					"id": 4620310,
					"content": "Tentu saja, kamu sudah menyelamatkan nyawaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620312
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 4620312,
					"content": "ASYIK!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620313,
					"content": "Tapi... berarti yang untung Kaeya dong? Dia tidak perlu membayar apa-apa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620314,
					"content": "Kalau begitu, dengarkan, intel tentang Arcadia Ruins...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620315
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 4620315,
					"content": "\"Tiga raksasa bertangan enam, berdiam di kota tengah danau. Dua menjaga patung, satu menjaga harta.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620316
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 4620316,
					"content": "...Oke! Lalu, apa artinya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620325,
					"content": "Lalu, intel ini disertai dengan sebuah peta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620317
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 4620317,
					"content": "Eh... jadi ini, peta harta karun?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620318,
					"content": "Jadi, petunjuknya adalah sebuah teka-teki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620319,
					"content": "#Tapi, ini pasti sangat mudah bagi {NICKNAME}. Karena itu, Paimon serahkan padamu, ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620320,
						4620321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620320,
					"content": "Tentu saja!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620322
					]
				},
				{
					"id": 4620322,
					"content": "Kalau kamu tidak bisa memecahkannya, kamu bisa tanya Kaeya, sepertinya dia juga tampak pintar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620326,
					"content": "Baiklah, aku akan tinggalkan informasi ini padamu, jadi kamu bisa lihat kapan saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620327
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 4620327,
					"content": "Hehe, terima kasih Nona Val!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620323,
					"content": "\"Tiga raksasa bertangan enam berdiam di kota tengah danau. Dua menjaga patung, satu menjaga harta.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620324,
					"content": "... apa ya maksudnya? Kalau kamu tidak ingin bertanya kepada Kaeya, berarti kamu harus berpikir baik-baik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620321,
					"content": "... ya, mudah-mudahan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620322
					]
				},
				{
					"id": 4620311,
					"content": "Terima kasih, teman.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620312
					]
				}
			]
		},
