			"dialogs": [
				{
					"id": 721320101,
					"content": "Terima kasih atas usahamu, meski pulau itu masih sangat berbahaya, tapi berkat kamu, para pengungsi ini jadi punya harapan untuk pulang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320102
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721320102,
					"content": "Meski sekarang hujan sudah berhenti, kurasa perang memperebutkan pulau ini akan semakin tegang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320103
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721320103,
					"content": "Meski situasi di pulau ini memang tidak bisa diapa-apakan lagi, setidaknya yang kita lakukan lebih baik dari mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320104
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721320104,
					"content": "Baiklah, terimalah hadiah yang kujanjikan sebelumnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320105
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721320105,
					"content": "Ini adalah tombak terkenal yang dulu dipakai oleh para Pejabat Pulau Yashiori. Tapi aku juga tidak tahu seberapa berguna gambar ini untukmu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320107
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721320107,
					"content": "Tapi kalau kamu memberikannya pada penempa ahli, mereka harusnya bisa menciptakan kembali kehebatan yang pernah dipegang Tuan Kitain...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320108
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721320108,
					"content": "*huff* Apa daya, era para pahlawan datang dan pergi, dan para Kitain, yang sudah membasmi begitu banyak iblis, tidak akan bisa kembali lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320109
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721320109,
					"content": "Tapi sepertinya kita sudah selangkah lebih dekat untuk menyamai jasa-jasa Tuan Kitain, semua ini berkatmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320110
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721320110,
					"content": "Setelah ini aku akan pergi meminta bantuan temanku, seorang prajurit Shogunate. Sampai jumpa lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaji"
				}
			]
		},
