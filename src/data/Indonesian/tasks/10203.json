			"dialogs": [
				{
					"id": 102030101,
					"content": "Hah... Klee sebenarnya bukan seorang anak biasa, dia memiliki jabatan sebagai Spark Knight.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030102
