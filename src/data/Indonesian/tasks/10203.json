					"nextDialogs": [
						102030105
					]
				},
				{
					"id": 102030105,
					"content": "Benar, Paimon merasa kurang adil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102030106,
					"content": "Meskipun begitu... Namanya cukup sesuai sih dengan fungsi harta karun Klee.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102030107,
					"content": "Benar, dia banyak membuat masalah untuk Knights of Favonius, tapi kami masih sangat peduli padanya.",
