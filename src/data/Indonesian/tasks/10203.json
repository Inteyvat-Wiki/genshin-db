					"nextDialogs": [
						102030109
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 102030109,
					"content": "Singkatnya, seiring berjalannya waktu, kamu akan lebih banyak mengetahui tentang dirinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030110
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 102030110,
