			"dialogs": [
				{
					"id": 761420301,
					"content": "Chernov, situ oke?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420302
					],
					"speakerTitle": "???"
				},
				{
					"id": 761420302,
					"content": "Masih kuat angkat pedang ... Kapten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420303
					],
					"speakerTitle": "Chernov"
				},
				{
					"id": 761420303,
					"content": "Shonokovych, Filaev ... kalian baik-baik saja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420304
					],
					"speakerTitle": "???"
				},
				{
					"id": 761420304,
					"content": "Ugh ... kaki patah, tapi masih bernapas. Tadi dihitung tidak? Berapa banyak yang jatuh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420305
					],
					"speakerTitle": "Shonokovych"
				},
				{
					"id": 761420305,
					"content": "Be-Berapa banyak sih monsternya? Kita ... kita akan mati di sini ya, Kapten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420306
					],
					"speakerTitle": "Filaev"
				},
				{
					"id": 761420306,
					"content": "Ngomong apa pula kau, nak? Kita pasti bisa keluar dengan selamat! Jangan takut, si pengintai pasti sudah sampai ke kota untuk lapor ke Pak Tua. Bala bantuan sebentar lagi datang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420307
					],
					"speakerTitle": "???"
				},
				{
					"id": 761420307,
					"content": "Datang lagi! Perburuan Liar ini memang tidak paham konsep kasih napas dulu ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420308
					],
					"speakerTitle": "???"
				},
				{
					"id": 761420308,
					"content": "Baiklah, angkat senjata, siapkan lentera! Serangan baru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "???"
				}
			]
