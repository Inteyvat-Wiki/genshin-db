			"dialogs": [
				{
					"id": 761420401,
					"content": "Jangan takut, Patoli dan aku akan mengeluarkan kamu dari sini. Sekarang kumpulkan keberanian, berdiri, dan pegang senjatamu dengan benar selayaknya Lightkeeper!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420402
					],
					"speakerTitle": "???"
				},
				{
					"id": 761420402,
					"content": "Aku ... aku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420403
					],
					"speakerTitle": "Filaev"
				},
				{
					"id": 761420403,
					"content": "Rencana? Ada rencana apa memangnya, Patoli? Kalau ini sudah di ujung tanduk, maka aku akan berjuang sampai tetes darah penghabisan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420404
					],
					"speakerTitle": "???"
				},
				{
					"id": 761420404,
					"content": "Kalian memang terbaik ... apa pun yang terjadi setelah ini, suatu kehormatan bisa berjuang bersama kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420405
					],
					"speakerTitle": "???"
				},
				{
					"id": 761420405,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420406
					],
					"speakerTitle": "Filaev"
				},
				{
					"id": 761420406,
					"content": "Ini kehormatan bagi kami, Kapten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420407
					],
					"speakerTitle": "Filaev"
				},
				{
					"id": 761420407,
					"content": "Ayo, siapkan garis pertahanan! Kasih tahu makhluk-makhluk keparat ini seperti apa murka \"Frostgale Steeds\"!",
