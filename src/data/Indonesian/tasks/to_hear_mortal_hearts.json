				"points": []
			},
			"dialogs": [
				{
					"id": 120180301,
					"content": "Wow, tempat ini tersembunyi sekali ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120180302,
					"content": "Aku tidak tahu alasan seseorang mau membangun sebuah tempat di pegunungan sedalam ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180303,
						120180304
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180303,
					"content": "Mungkin untuk kabur kalau ada bencana.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120180305
					]
				},
				{
					"id": 120180305,
					"content": "Aku bisa merasakan sesuatu yang tidak seharusnya ada di sini ... Aku merasakan adanya bahaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180306
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180306,
					"content": "Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120180307,
					"content": "Kita harus hati-hati. Klan Kujou bisa-bisa sedang terancam bahaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180304,
					"content": "Mungkin agar tidak diketahui orang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120180305
					]
				}
			]
		},
		{
			"id": 1201805,
			"completionStepIds": [
				1201805
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201805",
							"2"
						],
						"stepId": 1201805,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kujou Kamaji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120180506,
					"content": "Yang Mulia Shogun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180507
					],
					"speakerTitle": "Takatsukasa Susumu"
				},
				{
					"id": 120180507,
					"content": "Ya-Yang Mulia Shogun, kenapa Anda ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180508
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120180508,
					"content": "Keturunan Klan Takatsukasa. Jelaskan apa yang terjadi di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180509
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180509,
					"content": "Oh, kami sedang mendiskusikan masalah kecil yang muncul di Tenryou Commission belakangan ini. Yang Mulia Shogun tidak perlu khawatir ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180510
					],
					"speakerTitle": "Takatsukasa Susumu"
				},
				{
					"id": 120180510,
					"content": "Dan masalah kecil ini harus dibahas di tempat yang terpencil dan perlu ronin serta kairagi untuk menjaga?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180511
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180511,
					"content": "Yah, itu karena belakangan ini situasi sedang kacau. Benar-benar hanya untuk alasan keamanan saja ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180512
					],
					"speakerTitle": "Takatsukasa Susumu"
				},
				{
					"id": 120180512,
					"content": "Tutup mulutmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180513
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180513,
					"content": "Keturunan Klan Kujou. Bicaralah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180514
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180514,
					"content": "Baiklah. Aku datang ke sini untuk bernegosiasi, tapi ternyata mereka ingin mendapatkan pengakuan tertulis dari Klan Kujou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180515
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120180515,
					"content": "Pengakuan tertulis?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180516
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180516,
					"content": "Ya. Pernyataan yang mengakui semua tindak kriminal Klan Kujou sejak diberlakukannya Dekrit Perburuan Vision, termasuk masalah-masalah terkini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180517
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120180517,
					"content": "Pernyataan sesuai fakta, tentunya. Tidak ada yang dibuat-buat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180518
					],
					"speakerTitle": "Takatsukasa Susumu"
				},
				{
					"id": 120180518,
					"content": "Aku tidak menyangkal hal itu. Tapi pengakuan tertulis itu juga menekankan pencapaian Klan Takatsukasa, menyatakan kalau mereka selalu setia dan bertahan menghadapi krisis yang terjadi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180519
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120180519,
					"content": "Semua itu bohong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180520
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120180520,
					"content": "Kata siapa? Fi-Fitnah ... ! Kamu menjilat ludahmu sendiri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180521
					],
					"speakerTitle": "Takatsukasa Susumu"
				},
				{
					"id": 120180521,
					"content": "Aku hanya menyebutkan fakta. Aku yakin Yang Mulia Shogun dapat menilai kebenarannya. Klan Takatsukasa hanya ingin namanya terlihat bagus, agar mereka bisa menggantikan Klan Kujou!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180522
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120180522,
					"content": "Kalau tidak, apa alasanmu menambahkan pernyataan palsu di pengakuan tertulis ini dan membuat nama klanmu terlihat bagus? Dan memaksaku menandatanganinya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180523
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120180523,
					"content": "Apa maksudmu? Tidak ada yang memaksamu, kita kan hanya sedang bernegosiasi! Kenapa nada bicaramu jadi begitu?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180524
					],
					"speakerTitle": "Takatsukasa Susumu"
				},
				{
					"id": 120180524,
					"content": "Aku sudah memahami situasinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180525
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180525,
					"content": "Jangan dengarkan omong kosongnya. Aku yakin Anda tahu tentang semua kelalaian Klan Kujou. Anda pasti lebih tahu dari orang lain, tidak ada kata-kata mereka yang bisa dipercaya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180526
					],
					"speakerTitle": "Takatsukasa Susumu"
				},
				{
					"id": 120180526,
					"content": "Hmph. Aku tidak peduli dengan perselisihan kalian. Keturunan Klan Takatsukasa, kamu ingin menjadi Komisaris Tenryou yang baru. Apakah aku benar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180527
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180527,
					"content": "Uh, ah ... ya, tentu saja! Sudah menjadi harapan semua orang di Tenryou Commission untuk mengabdikan hidup kami melayani Yang Mulia Shogun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180528
					],
					"speakerTitle": "Takatsukasa Susumu"
				},
				{
					"id": 120180528,
					"content": "Berarti masalah ini tidak rumit. Akulah yang berhak mengangkat Komisaris Tenryou. Prosedurnya sederhana: Siapa pun yang bisa duel denganku dan menang, akan kuangkat jadi Komisaris baru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180529
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180529,
					"content": "Uh, maaf ... du-duel dengan Yang Mulia Shogun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180530
					],
					"speakerTitle": "Takatsukasa Susumu"
				},
				{
					"id": 120180530,
					"content": "Komisaris Tenryou yang pertama menunjukkan tekadnya dengan pedang di tangannya. Itulah kenapa jabatan Komisaris selalu diwariskan dalam Klan Kujou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180531
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180531,
					"content": "Jika kamu ingin mengajukan kandidat baru, silakan. Tentu saja berarti harus ada duel baru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180532
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180532,
					"content": "Aku, uh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180533
					],
					"speakerTitle": "Takatsukasa Susumu"
				},
				{
					"id": 120180533,
					"content": "Apa kamu tidak tahu cara memegang pedang ...? Atau kamu meragukan kekuatanmu karena umurmu yang menua dan kondisi fisikmu yang menurun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180534
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180534,
					"content": "Kamu berani bicara soal mengabdikan hidupmu, tapi sekarang kamu tidak berani menghadapi pedangku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180535
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180535,
					"content": "Uhhh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180536
					],
					"speakerTitle": "Takatsukasa Susumu"
				},
				{
					"id": 120180536,
					"content": "Lupakan saja. Apa ada di antara kalian yang ingin maju? Siapa pun yang bisa mengalahkanku, akan kutunjuk sebagai Komisaris Tenryou yang baru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180537
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180537,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180538
					],
					"speakerTitle": "Takatsukasa Clan Retainer"
				},
				{
					"id": 120180538,
					"content": "Tidak ada seorang pun yang berani menghadapiku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180539
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180539,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180540
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180540,
					"content": "Aku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180541
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120180541,
					"content": "Biar aku yang melawanmu, Yang Mulia Shogun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180542
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120180542,
					"content": "Eeeeeeeeh!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180543
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120180543,
					"content": "Keturunan Klan Kujou. Sayang sekali, meskipun kamu menang, kesalahan yang dilakukan Klan Kujou tetap tidak akan dihapus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180544
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180544,
					"content": "Aku tahu itu. Aku juga tidak mungkin menang melawanmu. Aku juga mengerti kalau kesalahan yang ayahku perbuat akan mengakhiri riwayat Klan Kujou di Tenryou Commission ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180545
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120180545,
					"content": "Bahkan saat aku menjalankan Dekrit Perburuan Vision, aku sudah meragukan keputusan ayahku. Aku tahu bahwa yang kulakukan itu salah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180546
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120180546,
					"content": "Tapi itu saja yang kulakukan. Aku meragukan, aku berpikir. Aku tahu persis situasinya, tapi aku tidak bertindak dan tidak menyelamatkan satu orang pun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180547
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120180547,
					"content": "Aku menerima kejatuhan Klan Kujou sebagai hukuman. Aku bahkan tidak akan bilang bahwa aku gagal mencegahnya ... karena untuk dapat gagal, aku harus mencoba terlebih dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180548
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120180548,
					"content": "Kalau aku bicara jujur ... dengan kemampuanmu yang seperti ini, kamu tidak akan bisa melakukan apa pun juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180549
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180549,
					"content": "Ya ... aku lemah. Ayah tidak peduli padaku, kakak tidak bisa menolongku, dan bahkan aku butuh Ippei untuk mengajariku ... Memang begitu sejak dulu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180550
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120180550,
					"content": "Tapi saat ini, di detik-detik akhir Klan Kujou, akulah yang mewakili klanku, seperti ayahku dulu! Sekarang giliranku untuk menjalankan tugasnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180551
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120180551,
					"content": "Seperti yang Shogun katakan, leluhurku menunjukkan tekadnya dengan pedang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180552
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120180552,
					"content": "Maka biarkan aku, Kujou Kamaji, mengakhiri kisah Klan Kujou sama seperti caranya bermula!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180553
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120180553,
					"content": "Ini kesempatan terakhirku untuk mengambil tindakan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180554
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120180554,
					"content": "Jelas-jelas ini tidak ada gunanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180555
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180555,
					"content": "Tapi kuterima tantanganmu. Majulah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ei"
				}
			]
		},
		{
			"id": 1201807,
			"completionStepIds": [
				1201807
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201807",
							"2"
						],
						"stepId": 1201807,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120180701,
					"content": "Kujou Kamaji terluka. Keturunan Klan Takatsukasa, rawat dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180702
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180702,
					"content": "Kalian mungkin tidak berani menantangku, tapi kurasa kalian bisa mengurus hal kecil seperti ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180703
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180703,
					"content": "Baiklah, tentu saja. Ampuni aku ... Mohon ampuni kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180704
					],
					"speakerTitle": "Takatsukasa Susumu"
				},
				{
					"id": 120180704,
					"content": "Aku sudah dengar kabar bahwa Klan Kujou sudah tidak mampu melakukan tugasnya di Tenryou Commission. Mencari penerus Komisaris Tenryou benar-benar sebuah hal yang mendesak ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180705
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180705,
					"content": "Tapi setelah duel ini, aku memutuskan untuk menunda hukuman Klan Kujou untuk sementara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180706
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180706,
					"content": "Dan kuharap Klan Takatsukasa bisa terus mendukung Klan Kujou seperti sebelumnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180707
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180707,
					"content": "Sesuai kehendak Anda. Kami tidak akan mempertanyakan perintah Yang Mulia Shogun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180708
					],
					"speakerTitle": "Takatsukasa Susumu"
				},
				{
					"id": 120180708,
					"content": "Satu lagi. Jika kalian menyangka bahwa kalian masih dapat menggunakan taktik para Fatui untuk memberikan informasi palsu padaku dan berharap aku membuat keputusan yang salah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180709
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180709,
					"content": "Maka kalian akan melihatku datang lagi seperti hari ini, tapi pedangku tidak akan memberi ampun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180710
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180710,
					"content": "Mengerti! Terima kasih, Yang Mulia Shogun atas kebijaksanaan dan belas kasihan Anda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180711
					],
					"speakerTitle": "Takatsukasa Susumu"
				},
				{
					"id": 120180711,
					"content": "Baiklah, sudah cukup. Aku akan meminta Okuzumeshuu untuk melanjutkan penyelidikannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180712
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180712,
					"content": "Ikut denganku. Ayo kita cari tempat yang sepi. Ada sesuatu yang harus kubicarakan denganmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ei"
				}
			]
		},
		{
			"id": 1201810,
			"completionStepIds": [
				1201810
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201810",
							"2"
						],
						"stepId": 1201810,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120181001,
					"content": "Saat menyelesaikan masalah, kamu sama saja dengan Shogun. Tegas sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120181002,
					"content": "Begitukah? Menurutku aku masih lebih baik. Kalau yang datang Shogun ... dia akan memenggal Kujou Kamaji tanpa berpikir dua kali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181003,
						120181004
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120181003,
					"content": "Dia beruntung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120181005
					]
				},
				{
					"id": 120181005,
					"content": "Kurasa juga begitu. Kelihatan dari matanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181006
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120181006,
					"content": "Klan Kujou sudah berubah banyak sekali sejak masa kejayaannya hingga jatuh seperti saat ini. Kamaji bukan pewaris yang sempurna, tapi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181007
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120181007,
					"content": "Dia menunjukkan padaku bahwa di tengah segala perubahan ini, tetap ada sesuatu yang konstan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181008
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120181008,
					"content": "Ini juga berkat kalian, membawaku jalan-jalan, bahkan mengambil fotoku. Kalian yang membuatku sadar akan hal ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181009
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120181009,
					"content": "Jadi bagaimana nasib Klan Kujou sekarang? Apa mereka akan tetap memimpin Tenryou Commission?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181010
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120181010,
					"content": "Tidak. Meskipun pewaris mereka berpotensi, kesalahan masa lalu mereka tidak bisa dihapus begitu saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181011
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120181011,
					"content": "Tapi ... aku akan memberi mereka lebih banyak waktu. Bagaimanapun juga, bukan hanya mereka yang melakukan kesalahan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181012
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120181012,
					"content": "Shogun tidak pernah membuat kesalahan —— dia tidak bisa membuat kesalahan. Tapi aku, Ei, ingin mengucapkan permintaan maafku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181013
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120181013,
					"content": "Ke depannya, masih banyak hal yang harus kuluruskan. Tapi setidaknya jalannya sudah terlihat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181014
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120181014,
					"content": "Apa kamu akan memimpin Inazuma secara langsung?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120181015
					]
				},
				{
					"id": 120181015,
					"content": "Kurasa aku akan tetap membiarkan Shogun menjalankan tugas itu. Ancaman terbesar bagi keabadian tetaplah \"erosi\" yang datang seiring waktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181016
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120181016,
					"content": "Aku sudah pernah bilang bahwa Shogun dilengkapi sistem yang kuat untuk melindunginya dari modifikasi. Itu kulakukan karena aku mengantisipasi kalau aku sendiri juga bisa berubah seiring waktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181017
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120181017,
					"content": "Tapi aku sudah membulatkan tekadku. Aku akan melakukan apa yang seharusnya, tidak peduli sesulit apa pun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181018
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120181018,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181019
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120181019,
					"content": "Semua ini sungguh pengalaman yang sangat berkesan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181020
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120181020,
					"content": "Pasti! Kamu membereskan masalah Tenryou Commission dan para penduduk kota juga sudah melihat Shogun yang bahagia dan sehat. Semua gosip jelek itu pasti akan segera hilang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181021
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120181021,
					"content": "Kalau kamu senang jalan-jalan sama kita, kapan-kapan ikut lagi ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181022,
						120181023
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120181022,
					"content": "Lain kali aku akan bawa hadiah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120181024
					]
				},
				{
					"id": 120181024,
					"content": "Tidak perlu, tidak ada tempat untuk hal seperti itu dalam hidupku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181025
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120181025,
					"content": "Lalu, jangan berbicara seakan-akan aku perlu ditemani kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181026
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120181026,
					"content": "Baiklah, aku sudah siap untuk kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181027
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120181027,
					"content": "Aku masih perlu menyendiri, tapi tidak akan lama lagi. Sementara itu, aku minta kalian para manusia untuk mengurus hal-hal kecil lainnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181028
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120181028,
					"content": "Oke, sampai ketemu lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181029
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120181029,
					"content": "Begitu banyak hal yang tak terduga terjadi, tapi untung semuanya berakhir dengan baik ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181030
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120181030,
					"content": "Sekarang kita tinggal kembalikan Izin Kunjung-nya ke Yae Miko.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120181023,
					"content": "Lain kali, kita akan bawa mainan antik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120181024
					]
				},
				{
					"id": 120181004,
					"content": "Mungkin itu juga yang dia kira.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120181005
					]
				}
			]
		},
		{
			"id": 1201812,
			"completionStepIds": [
				1201812
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201812",
							"2"
						],
						"stepId": 1201812,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yae Miko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120181201,
					"content": "Miko, kami sudah kembali! Perjalanannya seru loh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120181202,
					"content": "Benarkah? Kalau begitu kalian harus menceritakan semuanya padaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181203
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120181203,
					"content": "Hehe, menarik sekali. Yang Mulia Shogun pergi ke pusat kota dan dia jadi seperti gadis desa yang belum pernah ke kota. Menakjubkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181204
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120181204,
					"content": "Sayang sekali aku tidak lihat langsung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181205,
						120181206
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120181205,
					"content": "Sepertinya cuma kamu saja yang berani bilang begitu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120181207
					]
				},
				{
					"id": 120181207,
					"content": "Tidak apa kok, dia tidak bakal keberatan. Tidak bakal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181208
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120181208,
					"content": "Jadi, dari cerita kalian, sepertinya dia mulai paham \"Keabadian\" itu harusnya berwujud seperti apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181209
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120181209,
					"content": "Itu hasil terpenting dari perjalanan kali ini. Jujur aku tidak menyangka akan ada kemajuan sebesar ini waktu kupinjamkan Izin Kunjung ini ke kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181210
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120181210,
					"content": "Yap. Sepertinya dia tidak akan memaksa semuanya untuk tetap sama dengan sebelumnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120181211,
					"content": "Kalau mau bicara bagusnya, bahkan dewa juga bisa berandai-andai. Kalau bicara jeleknya, bahkan The Seven juga tidak berdaya saat menghadapi sesuatu yang lebih kuat dari mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181212,
						120181213
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120181212,
					"content": "Hati manusia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120181214
					]
				},
				{
					"id": 120181214,
					"content": "Hehe. Coba tebak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181215
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120181215,
					"content": "Tapi kedengarannya perjalanan kalian menyenangkan, kalian bahkan melihat Ei yang lebih santai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
