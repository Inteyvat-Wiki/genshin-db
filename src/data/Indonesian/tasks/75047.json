				"objectNames": [
					"Kusi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750470401,
					"content": "Nah, berat badanku sudah terkendali, tapi ... hmm? Kenapa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750470402,
						750470405,
						750470409
					],
					"speakerTitle": "Kusi"
				},
				{
					"id": 750470402,
					"content": "Maaf, kamu siapa ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750470403
					]
				},
				{
					"id": 750470403,
					"content": "Ah, aku yang biasa jaga di sini. Sekarang lagi libur sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750470404
					],
					"speakerTitle": "Kusi"
				},
				{
					"id": 750470404,
					"content": "Jadi kalau ada urusan, silakan ke orang sebelah saja. Namanya Yukom!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kusi"
				},
				{
					"id": 750470405,
					"content": "Lagi mikirin apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750470406
					]
				},
				{
					"id": 750470406,
					"content": "Aih, masalah berat badan sih. Naiknya lumayan drastis, jadi ya lagi mikir mau tambah buah-buahan sehat ke menu makanan, bukan cuma Grainfruit doang kayak biasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750470407
					],
					"speakerTitle": "Kusi"
				},
				{
					"id": 750470407,
					"content": "Tapi entah gimana caranya, si Oul ini meniru kelakuanku ... dia makan rumput terus. Boleh saja sih, karena Saurian itu omnivora, tapi aku khawatir dia makan rumput sebanyak ada nutrisinya apa enggak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750470408
					],
					"speakerTitle": "Kusi"
				},
				{
					"id": 750470408,
					"content": "Ya sudahlah, nanti dikasih tahu saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kusi"
				},
				{
					"id": 750470409,
					"content": "Tidak apa-apa sih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750470410
					]
				},
				{
					"id": 750470410,
					"content": "Baiklah kalau begitu. Hati-hati di jalan ya, orang asing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kusi"
				}
			]
		}
	]
