			"dialogs": [
				{
					"id": 750470301,
					"content": "Ngantuk ... mau bobo ... tapi harus berdiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750470302
					],
					"speakerTitle": "Huruk"
				},
				{
					"id": 750470302,
					"content": "Kenapa manusia ... hobi banget berdiri di sini seharian?",
					"roleType": "TALK_ROLE_NPC",
