			},
			"dialogs": [
				{
					"id": 747000101,
					"content": "Hehe, Paimon senang banget ngisi akuarium ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747000102,
					"content": "Karena Sandrone enggak keberatan, kita harus tangkap lebih banyak ikan dan buat tempat ini lebih cantik lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747000103,
					"content": "Hei, kalian. Bisa ke sini sebentar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000104
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747000104,
					"content": "Hah? Kenapa ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747000105,
					"content": "Ini, untukmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000106
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747000106,
					"content": "... Apa ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747000107,
					"content": "Ini perangkat pergerakan bawah air yang sedang kukerjakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000108
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747000108,
					"content": "Hah?! Wah! Kamu baik banget, Sandrone!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747000109,
					"content": "Cuma alat mekanik sederhana kok. Aku melihat cara kalian menangkap ikan dan ... gimana ya ... kuno sekali ... Jujur saja, mataku sakit lihatnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000110
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747000110,
					"content": "Se-Separah itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747000111,
					"content": "Tidak efisien, tidak terampil, dan sama sekali tidak elegan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000112
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747000112,
					"content": "Maaf kami buat kamu trauma jadi seperti ini ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747000113
					]
				},
				{
					"id": 747000113,
					"content": "Tidak perlu minta maaf. Setiap orang punya caranya sendiri waktu melakukan sesuatu. Tapi karena kalian berencana untuk terus menambah koleksi akuarium, lebih baik kalian pakai alat ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000114
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747000114,
					"content": "Perairan Fontaine bukan cuma dihuni ikan-ikan hias yang tak berbahaya. Ada banyak predator yang bisa menyakiti kalian. Alat ini akan membantu kalian memancing, bisa membantu kalian melarikan diri juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000115,
						747000116
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747000115,
					"content": "Terima kasih banyak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747000117
					]
				},
				{
					"id": 747000117,
					"content": "Baiklah. Kalau mau berenang, pergi sekarang. Jangan lupa kasih tahu aku pendapatmu soal perangkat itu. Aku bisa sesuaikan lagi kalau kalian punya masukan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747000116,
					"content": "Aku pasti akan pakai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747000117
					]
				}
			]
		}
	]
