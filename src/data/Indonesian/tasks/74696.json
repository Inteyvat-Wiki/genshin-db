					}
				]
			},
			"dialogs": [
				{
					"id": 746960101,
					"content": "Apa kamu sudah mulai ingat, Qiqi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960102
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960102,
					"content": "Oh ... Uhm ... Maaf ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960103
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960103,
					"content": "Tidak perlu minta maaf. Perjalanan kita sampai ke Palais Mermonia masih panjang. Ayo terus berjalan. Kuyakin kamu akan segera ingat di mana rumahmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960104
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960104,
					"content": "Lihat, itu Qiqi! Dia bareng Melusine. Paimon enggak nyangka sih rombongannya mereka gini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746960105,
					"content": "#Ah! {NICKNAME} dan ... Pai ... Paimon ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960106
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960106,
					"content": "Halo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746960107
					]
				},
				{
					"id": 746960107,
					"content": "Kamu kenal Qiqi? Kabar bagus! Aku bertemu dengannya saat menyelidiki di dekat Lumidouce Harbor ... Dari ukuran tubuhnya, aku pikir dia anak manusia ... Dia itu anak kecil manusia, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960108
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960108,
					"content": "Aku ... aku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960109
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960109,
					"content": "Teman baik kami!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746960110
					]
				},
				{
					"id": 746960110,
					"content": "Iya, iya! Kita udah lama kenal. Kita teman baik banget deh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746960111,
					"content": "Hehe! Respon yang cepat! Kalau Qiqi bilang dia itu zombi, Melusine tadi bisa kaget setengah mati!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746960112,
					"content": "Ya ... Sahabat ... terbaik ... Benar sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960113
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960113,
					"content": "Nah, ini benar-benar kebetulan yang bagus sekali. Jujur, ini pertama kalinya aku benar-benar tidak tahu harus bagaimana ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960114
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960114,
					"content": "Sepertinya kamu sudah tahu soal masalah ingatannya? Dia hampir tidak bisa mengingat apa pun selain namanya sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960115
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960115,
					"content": "Qiqi kadang-kadang emang gitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746960116,
					"content": "Anak yang malang. Aku ingin membawanya ke Marechaussee Phantom dan membiarkannya tinggal di sana untuk sementara, tapi kuharap dia bisa mendapatkan kembali beberapa ingatannya di perjalanan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960117
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960117,
					"content": "Karena kalian adalah teman baik, aku rasa kalian tahu dia tinggal di mana? Akan jauh lebih praktis jika aku bisa langsung mengantarnya pulang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960118
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960118,
					"content": "Kami tahu ... Tapi tempatnya, ehm, jauh banget dari sini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746960119,
					"content": "Rumahnya ... jauh ...? Aku mengikuti Seelie sampai ke Lumidouce Harbor ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960120
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960120,
					"content": "Hah? Kamu ingat sesuatu? Apa yang terjadi sebelum itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960121
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960121,
					"content": "Sebelum ... itu ... dokter Baizhu mengajak Qiqi ikut saat dia berkeliling di Yi ... Em, Yi-apa-apa begitu ... Qiqi pergi mengumpulkan obat, lalu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960122
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960122,
					"content": "Ooh! Yilong Wharf ya? Baizhu ngajak kamu ke sana? Detektif Paimon kayaknya tau deh apa yang terjadi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746960123,
					"content": "Baizhu ngajak Qiqi ngunjungin pasien di Yilong Wharf. Qiqi nyasar waktu lagi ngumpulin tanaman obat, lalu Qiqi ngelihat Seelie, lalu ngikutin terus sampai ke Lumidouce Harbor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746960124,
					"content": "#Hehe, untung saja Paimon sama {NICKNAME} pernah baca \"Robben Melawan Chesterton\"! Logika gampang gini sih enggak di luar nurul buat kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746960125,
					"content": "Kamu tahu kan kalau buku itu fiksi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746960126
					]
				},
				{
					"id": 746960126,
					"content": "Aha! Hm, benar juga! Aku akan langsung bawa Qiqi kembali ke Yilong Wharf. Dokter Baizhu itu wali Qiqi, kan? Dia pasti khawatir setengah mati!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960127,
						746960128
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960127,
					"content": "Tunggu ... Orang-orang yang ada di ramalan Barbeloth ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746960129
					]
				},
				{
					"id": 746960129,
					"content": "Oh, benar juga! Paimon hampir lupa soal itu. Barbeloth, kamu di sana? Kamu bisa dengar kami?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746960130,
					"content": "Tidak perlu berteriak. Aku dari tadi di sini. Aku hanya tidak ingin mengganggu percakapan kalian. Mendengarkan adalah keterampilan seorang peramal yang baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960131
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960131,
					"content": "Petunjuk dari Seelie ini juga bisa dianggap sebagai petunjuk dari takdir. Hehehe ... Karena kamu sudah di sini, Qiqi, bagaimana kalau kubacakan ramalanmu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960132
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960132,
					"content": "Ra ... malan ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960133
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960133,
					"content": "Aduh, Barbie, dengarkan aku dulu. Kamu benar-benar kurang jago bicara dengan anak-anak, tahu tidak? Kamu bikin gadis malang ini takut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960134
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960134,
					"content": "Sini biar aku saja. Perhatikan baik-baik ya, begini cara memberikan kejutan kecil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960135
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960135,
					"content": "Ehem, halo Qiqi, anggota dari Hexenzirkel Cilik. Aku ini mama dari temanmu Klee, namaku Tante Alice, penyihir terhebat di dunia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960136
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960136,
					"content": "Senang bertemu denganmu, Tante Alice ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960137
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960137,
					"content": "Aduh, anak yang manis dan sopan. Nah, teman Tante—seorang penyihir hebat juga—mau mengadakan pesta ramalan kejutan yang luar biasa untukmu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960138
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960138,
					"content": "Pesta ... ramalan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960139
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960139,
					"content": "Benar sekali! Coba lihat kartu-kartu di hadapanmu. Cantik, kan? Kamu suka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960140
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960140,
					"content": "Aku ... suka ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960141
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960141,
					"content": "Bagus deh! Sekarang, bisakah kamu pilih satu untukku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960142
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960142,
					"content": "Uhm ... yang ini boleh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960143
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960143,
					"content": "Tentu saja boleh. Dan karena kamu bersikap sangat baik, kartu itu boleh kamu simpan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960144
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960144,
					"content": "... Te-Terima kasih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960145
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960145,
					"content": "Baiklah, Barbie, waktu istirahat sudah selesai. Ayo bantu Qiqi membaca ramalannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960146
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960146,
					"content": "Tidak perlu mengguncangku sampai bangun. Aku sudah mendengarkan dari tadi kok ... Ah, kartu Pengorbanan dengan posisi tegak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960147
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960147,
					"content": "Sangat sedikit orang yang bisa mendapatkan kartu ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960148
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960148,
					"content": "Itu artinya kamu sangat spesial, Qiqi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960149
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960149,
					"content": "Simbol ini melambangkan \"melampaui batas\" dan \"penantian\", serta lepas dari kehidupan sehari-hari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960150
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960150,
					"content": "Ada belenggu yang mengikatmu, tetapi kamu sendiri tidak ingin membebaskan diri darinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960151
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960151,
					"content": "Belenggu ... Maksudnya ... perintah untukku ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960152
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960152,
					"content": "Setidaknya di permukaan, pemahamanmu yang seperti itu tidak salah kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960153
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960153,
					"content": "Soal masa depanmu, kamu hanya perlu menunggu saja. Tentu saja, bukan berarti kamu kekurangan waktu ... Tapi ... Oh, aneh sekali, sangat aneh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960154
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960154,
					"content": "Tunggu sebentar! Kamu bicara banyak banget sekaligus, kasih dia waktu mencerna dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960155
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960155,
					"content": "Biarkan Qiqi menikmati hadiah kecilnya dulu. Kamu harus lebih sabar dengan anak-anak, beri mereka lebih banyak waktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960156
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960156,
					"content": "Menurutmu bagaimana, Qiqi? Kamu suka sama kejutannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960157
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960157,
					"content": "Kartu ini cantik sekali ... Terima kasih, Tante Alice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960158
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960158,
					"content": "Aww, anak baik. Kamu hebat bisa ingat nama Tante. Tante masih mau mengobrol denganmu, tapi sekarang sudah waktunya kamu pulang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960159
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960159,
					"content": "Kalau Tante Barbie masih mau jelasin yang lainnya, nanti dia bisa ramalkan semua penyihir cilik yang datang di pertemuan Hexenzirkel Cilik berikutnya! Asyik, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960160
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960160,
					"content": "... Kamu bisa tidak, tanya dulu sebelum menambah kerjaanku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960161
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960161,
					"content": "Kalau begitu sudah diputuskan! Sampai jumpa lain kali, Qiqi, dan kalian semua jadi saksinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960162
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960162,
					"content": "Dadah ... Tante Alice ... dan teman-teman terbaik ... Tante Alice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960163
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960163,
					"content": "Fiuh ... Semuanya sudah selesai sekarang? Apa kedua suara itu berasal dari boneka ini? Mainan apa ini? Imutnya, aku bisa dapat dari mana—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960164
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960164,
					"content": "Ugh! Ayo jangan bahas ke mana-mana dulu. Qiqi, ayo sekarang kita cari Dokter Baizhu-mu itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960165
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960165,
					"content": "#... Mmhmm, sudah waktunya ... Qiqi harus pulang. Sampai jumpa ... lain kali, {NICKNAME} ... dan Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960166,
						746960167
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960166,
					"content": "Hati-hati di jalan ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746960168
					]
				},
				{
					"id": 746960168,
					"content": "Kartu ... Hadiah ... Hmm ... Cantik ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960167,
					"content": "Semoga selamat sampai di rumah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746960168
					]
				},
				{
					"id": 746960128,
					"content": "Bukankah Qiqi juga termasuk salah satunya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746960129
					]
				}
			]
