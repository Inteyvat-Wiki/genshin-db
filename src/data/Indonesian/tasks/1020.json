			},
			"dialogs": [
				{
					"id": 10200601,
					"content": "Berhenti! Suara apa itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200602
					],
					"speakerTitle": "Huaqing"
				},
				{
					"id": 10200602,
					"content": "Nona Keqing, dua orang aneh ini tiba-tiba muncul. Sepertinya mereka berniat jahat terhadap Guizhong Ballista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200603
					],
					"speakerTitle": "Huaqing"
				},
				{
					"id": 10200603,
					"content": "Ka-Kamu! Siapa yang kamu sebut \"aneh\"?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200604,
					"content": "Kami hanya mencari jalan menuju Jade Chamber.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200605
					]
				},
				{
					"id": 10200605,
					"content": "Hmm? Kalian ingin pergi ke Jade Chamber? Siapa kalian?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200606
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200606,
					"content": "Kami adalah tamu undangan, datang ke sini untuk mencari Liyue Qixing! Siapa kamu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200607,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200608
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200608,
					"content": "Kebetulan sekali, aku adalah salah satu dari Liyue Qixing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200609
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200609,
					"content": "???",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200610,
					"content": "Aku adalah Keqing, Yuheng dari Qixing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200611
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200611,
					"content": "Aku tahu tentangmu, Pengembara. Kamu adalah tamu Ningguang kan? Tak kusangka akan bertemu denganmu di pegunungan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200612
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200612,
					"content": "Wow... Paimon juga tidak menyangka bisa bertemu orang super kaya di antah berantah begini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200613,
					"content": "Guizhong Ballista di Tianheng Pass sudah lama rusak, namun tiba-tiba diperbaiki seperti semula hanya dalam satu malam. Aku datang ke sini untuk menyelidikinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200614
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200614,
					"content": "Prajurit Millelith ini hanya bertanggung jawab menjaga tempat ini, bukan untuk menangkap siapa pun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200615
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200615,
					"content": "Oh, jadi ini semua cuma salah paham? Paimon tidak kepikiran...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200616
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200616,
					"content": "Ini bukanlah hal yang sulit, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200617
					]
				},
				{
					"id": 10200617,
					"content": "Bagaimanapun, manusia yang dapat memperbaiki mesin Adeptus adalah sebuah keajaiban, bahkan untuk Qixing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200618
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200618,
					"content": "Hehehe, itu karena...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200619,
						10200620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200619,
					"content": "(Sst, Paimon, jangan memperumit masalah!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200621
					]
				},
				{
					"id": 10200621,
					"content": "Eh? Oh, iya. Apakah Nona Yuheng tahu kenapa Nona Tianquan mengundang kami ke Jade Chamber?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200622
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200622,
					"content": "Panggil saja Keqing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200623
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200623,
					"content": "Kurasa tujuan Ningguang mengundangmu adalah untuk meminta penyelamat Mondstadt mengambil sikap yang lebih netral... atau setidaknya, tidak sepenuhnya berpihak pada Adeptus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200624
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200624,
					"content": "Kami tidak memihak siapa pun. Kami sudah berbicara dengan Adeptus, mereka juga akan melindungi Liyue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200625
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200625,
					"content": "Maksudnya \"melindungi\" tentunya karena kesombongan mereka yang sok suci, bukan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200626
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200626,
					"content": "Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200627
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200627,
					"content": "Karena bagi mereka, kalian adalah manusia lemah yang membutuhkan perlindungan mereka. Mereka merasa kalian tidak mungkin memiliki \"kemampuan untuk membunuh seorang dewa.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200628
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200628,
					"content": "Wajar saja, mereka juga akan menganggap keputusan Ningguang menutup area, menginterogasi orang-orang, dan mengejar pembunuh sebagai tindakan yang tidak berguna. Bahkan mereka mungkin berpikir ada sesuatu dengan maksud terselubung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200629
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200629,
					"content": "Dengan kata lain, mereka hanya merendahkan manusia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200630
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200630,
					"content": "Perkataanmu ada benarnya juga...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200631
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200631,
					"content": "Tapi, ini pertama kalinya Paimon melihat seseorang di Liyue yang tidak menghargai dewa atau Adeptus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200632
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200632,
					"content": "Hah... Haruskah aku menghargai kesombongan terhadap manusia dan pikiran dangkal mereka terhadap waktu sehingga mereka pun tidak sanggup menghadapi kami para Qixing?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200633
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200633,
					"content": "Sudahlah. Aku seharusnya tidak berbicara tentang hal ini. Ini hanyalah sebuah keraguanku saja, dan tidak ada hubungannya dengan Ningguang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200634
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200634,
					"content": "Bagaimanapun juga, aku akan mengakui bahwa tindakan Adeptus kali ini cukup dapat dikendalikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200635
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200635,
					"content": "Kematian Rex Lapis memang adalah sesuatu yang luar biasa. Tapi kalau berpikir mereka akan memanggil para Adeptus untuk turun dan menangani hal ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200636
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200636,
					"content": "Cukup mengejutkan melihat betapa beradabnya mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200637,
						10200638
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200637,
					"content": "Jadi, adakah kesempatan untuk membicarakannya bersama mereka?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200639
					]
				},
				{
					"id": 10200639,
					"content": "Untuk Ningguang... Wanita itu akan mendiskusikan segala sesuatu yang dia bisa. Tapi aku ragu kita bisa melakukannya dalam hal ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200640
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200640,
					"content": "\"Masa Adeptus telah lama berlalu. Jika Liyue Qixing saja tidak ingin menghadapi kebenaran, maka masa depan apa yang ada untuk Liyue?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200641
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200641,
					"content": "Fiuh... Benar-benar pernyataan yang berani...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200642
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200642,
					"content": "*huff* Aku akan berhenti di sini. Sejujurnya, aku tidak berniat untuk bicara terlalu banyak. Tapi kamu adalah pendengar yang baik, Pengembara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200643
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200643,
					"content": "Kalian harus segera pergi ke Jade Chamber. Jangan sampai terlambat. Jadwal Ningguang akan sangat padat sampai akhir tahun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200644
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200644,
					"content": "Para pedagang di Liyue menganggap bahwa naik menuju Jade Chamber adalah sebuah penghargaan tertinggi. Setiap orang akan membawa hadiah yang mewah saat berkunjung, hanya untuk menyenangkan hati Ningguang dan mendapatkan manfaatnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200645
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200645,
					"content": "Manfaat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200646,
						10200647
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200646,
					"content": "Paimon, bukan itu intinya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200648
					]
				},
				{
					"id": 10200648,
					"content": "Tapi... tapi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200649
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200649,
					"content": "Tunggu, itu benar! Hadiah sambutan adalah bagian penting dari warisan Liyue. Jadi, kami tidak mencoba menjilat. Kami hanya... menghormati budaya Liyue!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200650
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200650,
					"content": "Ah, lihat Paimon yang perhatian ini...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200651
					]
				},
				{
					"id": 10200651,
					"content": "Baiklah, baiklah. Kamu bisa memutuskan sendiri hadiah sambutanmu. Biarkan aku memberi tahumu cara menuju ke Jade Chamber terlebih dahulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200652
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200652,
					"content": "Kalian sebenarnya tidak harus datang ke Mt. Tianheng. Kembalilah ke Pelabuhan Liyue, dan temukan \"pemandu\" di Yuehai Pavilion, dan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200653
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200653,
					"content": "Baiklah kalau begitu, semoga kita bisa bertemu lagi, Pengembara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200654
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200654,
					"content": "Yah, sang Yuheng mungkin tidak menghormati dewa, tapi menurut Paimon, dia orang yang cukup keren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200655,
						10200656
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200655,
					"content": "Dia juga memberikan kesan yang baik padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200657
					]
				},
				{
					"id": 10200657,
					"content": "Jadi... apa yang harus kita berikan kepada Ningguang saat melihatnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200658
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200658,
					"content": "Fokusmu benar-benar sudah berubah ya, Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200659
					]
				},
				{
					"id": 10200659,
					"content": "Oh iya! Paimon memimpikan camilan yang luar biasa tadi malam - <color=#00E1FFFF>Slime Lapis Gula</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200660
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200660,
					"content": "Paimon merasa bahwa itu akan cocok sekali untuk orang super kaya seperti Ningguang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200661
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200661,
					"content": "Kenapa kita tidak memberikan itu sebagai hadiah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200662,
						10200664
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200662,
					"content": "Jadi, apakah kamu punya resepnya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200663
					]
				},
				{
					"id": 10200663,
					"content": "Tidak! Tapi Paimon yakin kita hanya perlu melakukannya dengan boom shaka-laka!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200666
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200666,
					"content": "Ayo cepat kumpulkan bahan-bahannya. Waktu tidak menunggu siapa pun, begitu juga dengan kekayaan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200664,
					"content": "Lalu... bagaimana cara kita membuat benda yang ada di dalam mimpimu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200665
					]
				},
				{
					"id": 10200665,
					"content": "Tentu saja dengan boom shaka-laka!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200666
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200656,
					"content": "Aku setuju dengan beberapa cara pandangnya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200657
					]
				},
				{
					"id": 10200647,
					"content": "Paimon, serius sedikit.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200648
					]
				},
				{
					"id": 10200638,
					"content": "Ningguang akan memilih untuk bernegosiasi, benar kan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200639
					]
				},
				{
					"id": 10200620,
					"content": "(Kita hanya berperan kecil dalam hal itu...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200621
					]
				}
			]
		},
		{
			"id": 102007,
			"completionStepIds": [
				102007
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"102007",
							"2"
						],
						"stepId": 102007,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10200701,
					"content": "Eh? Hanya bisa terbang sampai sini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200702,
					"content": "Ah, jika arus angin itu lebih kuat, kita bisa mencapai puncak dalam sekali jalan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200703,
					"content": "Sebaiknya kita kembali ke Pelabuhan Liyue dan bertanya pada Millelith...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200704
					]
				},
				{
					"id": 10200704,
					"content": "Eh? Kenapa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200705,
					"content": "Jalan menuju ke atas seharusnya tidak rahasia, jika tidak...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200706
					]
				},
				{
					"id": 10200706,
					"content": "Jika tidak? ...Oh, Paimon mengerti! Jika rahasia, Ganyu tidak akan membiarkan kita mencoba menemukannya sendiri, ya kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200707,
					"content": "Baiklah, ayo ikuti rencanamu, lalu kita bisa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200708,
					"content": "Oh! Tunggu sebentar. Lihat ke bawah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200709,
					"content": "Sepertinya kita sudah dekat dengan <color=#00E1FFFF>Guizhong Ballista</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200710,
					"content": "Jika begitu... Hmmm... Paimon punya ide baru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200711,
					"content": "Kenapa kita tidak meluncurkanmu ke Jade Chamber menggunakan Guizhong Ballista?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200712,
						10200714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200712,
					"content": "Tidak, terima kasih. Aku tidak ingin mati.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200713
					]
				},
				{
					"id": 10200713,
					"content": "Oh... benar. Cara ini sepertinya sedikit tidak aman...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200716,
					"content": "Tapi seingatku Guizhong Ballista memiliki jangkauan yang jauh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200717
					]
				},
				{
					"id": 10200717,
					"content": "Oh, itu benar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200718,
					"content": "Jika begitu, sebenarnya kita bisa menggunakan Guizhong Ballista untuk melihat apakah ada jalan lain di dekat sini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200714,
					"content": "Apakah kamu membenciku?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200715
					]
				},
				{
					"id": 10200715,
					"content": "Uhh... Tidak. Paimon hanya lupa memikirkan tentang keselamatan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200716
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}