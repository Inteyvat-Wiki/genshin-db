			"dialogs": [
				{
					"id": 10200101,
					"content": "Lihat, di atas sana! Itu adalah Jade Chamber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200102,
						10200103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200102,
					"content": "Tinggi sekali.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200104
					]
				},
				{
					"id": 10200104,
					"content": "Hmm... Ugh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200105,
					"content": "Ah, tidak bisa begini... Paimon seharusnya menjadi pemandumu, tapi Paimon tidak tahu bagaimana naik ke Jade Chamber...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200106,
						10200107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200106,
					"content": "Kamu baru sadar sekarang...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200108
					]
				},
				{
					"id": 10200108,
					"content": "Ehh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200109,
					"content": "Tapi kita kan mau ke Jade Chamber, jadi pasti bisa menemukan lokasinya di peta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200110,
					"content": "Ayo kita cek sekeliling. Pasti ada jalan menuju ke atas di sekitar sini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200107,
					"content": "Seharusnya kita bertanya kepada utusan bernama Ganyu itu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200108
					]
				},
				{
					"id": 10200103,
					"content": "Bagaimana cara naiknya ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200104
					]
				}
			]
		},
		{
