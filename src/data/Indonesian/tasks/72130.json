			"dialogs": [
				{
					"id": 721300101,
					"content": "Lentera dari batu dengan bentuk yang aneh seperti memancarkan energi yang mengganggu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721300102
					],
					"speakerTitle": "Amati"
				},
				{
					"id": 721300102,
					"content": "Lentera batu ini aneh banget... memancarkan semacam aura yang familier gitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721300103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721300103,
					"content": "Eh, kayaknya ada tulisan tangan orang di lentera itu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721300104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721300104,
					"content": "\"Prajurit penjaga, apabila ada pertanyaan terkait jimat penangkal ini, silakan tanya Tuan Kaji di Musoujin Gorge.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721300105
					],
					"speakerTitle": "Amati"
				},
				{
					"id": 721300105,
					"content": "Tulisan ini terlihat masih baru, tapi juga ada bekas terhapus air hujan. Terdapat beberapa tulisan kecil di bawahnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721300106
					],
					"speakerTitle": "Amati"
				},
				{
					"id": 721300106,
					"content": "\"Tolong jangan percaya catatan orang asing. Kita tidak boleh buang waktu. Ini adalah trik pemberontak untuk memperlambat gerakan kita.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721300107
					],
					"speakerTitle": "Amati"
				},
				{
					"id": 721300107,
					"content": "\"Siapa saja yang meninggalkan tim tanpa izin akan mendapatkan sanksi yang berat!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721300108
					],
					"speakerTitle": "Amati"
				},
				{
					"id": 721300108,
					"content": "Sepertinya Kaji sangat peduli dengan lentera dari batu. Apa kita pergi saja ke Musoujin Gorge dan tanya ke dia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
