			"dialogs": [
				{
					"id": 401540101,
					"content": "Kamu terus menjalankan toko ramuan tersebut. Dan berkat kerja kerasmu, angka penjualan bahkan melebihi ekspektasi ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401540102
					]
				},
				{
					"id": 401540102,
					"content": "Wow, tidak kusangka kalian bisa menaikkan pendapatan sampai sebanyak ini dalam waktu singkat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540103
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540103,
					"content": "Kamu jenius bisnis ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540104,
						401540107
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540104,
					"content": "Ini semua berkat bantuanmu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401540105
					]
				},
				{
					"id": 401540105,
					"content": "Hehe, selalu merendah seperti biasanya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540106
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540106,
					"content": "Tapi dengan hasil yang luar biasa begini, kamu sudah boleh bangga loh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540109
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540109,
					"content": "Kalau kamu mau bantu aku terus di sini, aku pasti bisa tingkatkan jatah liburanku sampai 2 kali lipat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540110
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540110,
					"content": "Berkat kerja kerasmu selama ini, kami sekarang sudah mengumpulkan data penjualan yang cukup untuk penelitian kami. Terima kasih banyak ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540111
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540111,
					"content": "Tentunya, kalau kamu tertarik buat terus jalanin tokonya, aku akan sangat senang sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540112
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540112,
					"content": "Yah gimanapun juga, aku harusnya sudah bisa buat laporan ke Jean sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540113
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540113,
					"content": "#{NICKNAME}, Paimon, sudah lama sekali ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540114
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540114,
					"content": "Jean!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401540115,
					"content": "Oh, kamu di sini toh! Aku baru saja ngobrol bisnis dengan si manis, dan kebetulan mau ke markas buat lapor ke kamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540116
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540116,
					"content": "Tidak perlu. Aku sudah bicara dengan beberapa kesatria, jadi sepertinya aku sudah tahu garis besarnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540117
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540117,
					"content": "#Sepertinya kamu merepotkan {NICKNAME} lagi ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540118
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540118,
					"content": "Hehe, kerja sama yang cerdas dan kompeten sangat diperlukan untuk mencapai terobosan dalam pekerjaan penting seperti ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540119
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540119,
					"content": "Lihat saja kesuksesan toko ini! Kalau aku sendiri sih mana mungkin sampai begini ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540120
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540120,
					"content": "Ya memang harus kuakui, kesuksesanmu ini luar biasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540121
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540121,
					"content": "Aku memang awalnya ingin datang buat lihat keadaan kalian setelah urusanku selesai, tapi aku tidak ada waktu ... Yah setidaknya, aku ingin berterima kasih pada kalian secara langsung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540122,
						401540123
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540122,
					"content": "Terima kasih juga atas dukungannya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401540124
					]
				},
				{
					"id": 401540124,
					"content": "Dengan adanya anggota sekaliber kalian, aku jadi tenang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540125
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540125,
					"content": "Hehe, nanti kalau urusan ini sudah salah, aku boleh liburan ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540126
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540126,
					"content": "Akhir-akhir ini rambutku sampai rontok karena stres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540127
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540127,
					"content": "Iya. Ini semua berkat kerja kerasmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540128
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540128,
					"content": "Melihatmu menghabiskan banyak waktu di perpustakaan terus begitu, aku memang sudah khawatir kalau kamu bosan. Jadi kupikir aku mau menjadikan ini sebagai kesempatan buat memanfaatkan talentamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540129
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540129,
					"content": "Mungkin aku memberimu terlalu banyak kerjaan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540130
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540130,
					"content": "#Yah tidak juga sih. Toh aku tidak sendiri. Aku juga dapat banyak bantuan dari pada kesatria dan {NICKNAME} benar-benar membantu sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540131
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540131,
					"content": "Lagian, seru juga bisa sekali-sekali kembali ke penelitian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540132
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540132,
					"content": "Aku senang mendengarnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540133
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540133,
					"content": "#Terima kasih lagi atas semua bantuanmu ya, {NICKNAME}. Silakan terima ini sebagai imbalannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540134
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540134,
					"content": "Ah, ngomong-ngomong soal imbalan, aku juga menyiapkan sedikit hadiah untukmu. Nih, semoga kamu suka ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540123,
					"content": "Ini kerja sama tim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401540124
					]
				},
				{
					"id": 401540107,
					"content": "Yah aku sih cuma ikuti arusnya saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401540108
					]
				},
				{
					"id": 401540108,
					"content": "Hm, kemampuan belajarmu memang luar biasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540109
					],
					"speakerTitle": "Lisa"
				}
			]
		}
	]
}