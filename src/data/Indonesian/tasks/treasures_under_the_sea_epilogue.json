			"dialogs": [
				{
					"id": 746740101,
					"content": "Iron Coin ... Iron Coin-nya ... bagus, bagus sekali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746740102
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 746740102,
					"content": "#Dengan Ancient Iron Coin sebanyak ini, aku pasti bisa dapat cuan sedikit. Makasih banyak ya, {NICKNAME} dan Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746740103
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 746740103,
					"content": "Selanjutnya, kamu mau ngapain?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746740104
					]
				},
				{
					"id": 746740104,
					"content": "Tentu saja ... pikirkan cara gimana menukarkan Iron Coin ini jadi Mora atau sesuatu yang lebih cocok digunakan sehari-hari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746740105
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 746740105,
					"content": "Jujur ya, aku benar-benar tidak mau berurusan lagi dengan perantara yang kemarin. Mereka selalu ambil cuan yang besar sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746740106
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 746740106,
					"content": "Selain itu, uangnya baru sampai di tanganku itu lama sekali. Entah ngapain saja dia ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746740107
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 746740107,
					"content": "Tapi ... saat ini aku masih belum bisa temukan orang yang bisa diandalkan dan bisa diajak kerja sama selain dia. Haduh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746740108
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 746740108,
					"content": "Sudahlah, tidak perlu dibahas lagi! Ini buat kalian berdua. Anggap saja bonus tambahan dari kerja sama jangka panjang kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746740109
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 746740109,
					"content": "Setelah bisnis di Fontaine selesai, aku harus pikirkan langkah berikutnya. Aku tidak bisa terus bepergian seperti ini, kan? Ini terlalu melelahkan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ulman"
				}
			]
		}
	]
