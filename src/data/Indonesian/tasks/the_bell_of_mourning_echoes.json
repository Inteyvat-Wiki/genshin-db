					"Sukhovykh"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760010101,
					"content": "Permisi! Mau nanya dong ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760010102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760010102,
					"content": "Kalian menunjukkan barangnya ke kedua Ratnik, lalu menceritakan tentang pertempuran bersama orang misterius berseragam Lightkeeper yang membantu kalian menghalau Perburuan Liar ....",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760010103
					]
				},
				{
					"id": 760010103,
					"content": "Mungkin itu ... Sigurd? Dia ... sampai sekarang masih belum tenang ya. Kalau saja aku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760010104
					],
					"speakerTitle": "Lushne"
				},
				{
					"id": 760010104,
					"content": "Sudah, Lushne. Itu bukan tanggung jawabmu. Selama Perburuan Liar masih ada, dia tidak akan berhenti berjuang ... sedangkan kita, fokus dan laksanakan tugas semaksimal mungkin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760010105
					],
					"speakerTitle": "Sukhovykh"
				},
				{
					"id": 760010105,
					"content": "Jadiii .... si Sigurd itu tadinya Lightkeeper juga ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760010106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760010106,
					"content": "Iya, dia Starshyna yang kuat sekali. Waktu Perburuan Liar menyerang Nod-Krai, dia berjuang dengan gagah berani sampai titik darah penghabisan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760010107
					],
					"speakerTitle": "Sukhovykh"
				},
				{
					"id": 760010107,
					"content": "Katanya bahkan binatang buas tanpa akal budi pun akan bergidik ketakutan ketika mendengar suara lonceng itu ... Kok bisa-bisanya barang peninggalan dia sampai ke tangan kalian berdua ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760010108
					],
					"speakerTitle": "Sukhovykh"
				},
				{
					"id": 760010108,
					"content": "Kalau boleh, tolong bawa benda itu ke makamnya. Lokasinya di reruntuhan medan perang sebelah timur di Pulau Lempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760010109
					],
					"speakerTitle": "Sukhovykh"
				},
				{
					"id": 760010109,
					"content": "Siap.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760010110
					]
				},
				{
					"id": 760010110,
					"content": "Terima kasih. Semoga arwahnya bisa segera beristirahat dengan tenang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sukhovykh"
				}
			]
		},
