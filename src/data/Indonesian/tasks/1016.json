			"dialogs": [
				{
					"id": 10160301,
					"content": "Ningguang ... Ganyu ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160302
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10160302,
					"content": "Di mana posisi mereka, di tengah gelombang gelap yang menerjang ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
