			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhongli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10161001,
					"content": "Daaan Ganyu si utusan pun hilang begitu saja setelah pesannya disampaikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10161002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10161002,
					"content": "Tapi kita diundang sama Liyue Qixing. Paimon masih syok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10161003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10161003,
					"content": "#{NICKNAME}! Kita mau ketemu sama orang yang uangnya lebih banyak daripada yang bisa Paimon bayangin ... Ingat, sopan santun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10161004,
						10161005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10161004,
					"content": "Aku selalu sopan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10161006
					]
				},
				{
					"id": 10161006,
					"content": "Haha, memang tak banyak yang beruntung dapat diundang ke Jade Chamber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10161007
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10161007,
					"content": "Pergilah. Tapi jangan lupa dengan Rite of Parting. Setelah kalian selesai, temui aku di Dihua Marsh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10161008
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10161008,
					"content": "Jangan khawatir, kami ingat kok! Dihua Marsh kan? Sampai ketemu di sana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10161005,
					"content": "Paimon mau ngapain lagi ini, haduh ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10161006
					]
				}
			]
		}
	]
}