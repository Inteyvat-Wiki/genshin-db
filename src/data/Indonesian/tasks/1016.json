					"Zhongli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10160101,
					"content": "Ah, kalian tiba. Tidak perlu memesan, aku sudah urus semua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160102
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10160102,
					"content": "Third-Round Knockout bukan tempat minum sembarangan, tidak seperti kedai-kedai anggur di Mondstadt. Di sini pemiliknya tidak akan terima kalau kamu pesan jus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160103
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10160103,
					"content": "Berarti kali ini sudah boleh pesan alkohol, begitu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10160104
					]
				},
				{
					"id": 10160104,
					"content": "Aku sudah pesankan kalian es tapai ketan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160105
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10160105,
					"content": "Ck. Sudah kuduga ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10160106
					]
				},
				{
					"id": 10160106,
					"content": "Tamu-tamuku yang terhomat, jika kalian sudah siap, aku akan melanjutkan kisah tentang Jade Chamber milik Nona Ningguang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160107
					],
					"speakerTitle": "Iron Tongue Tian"
				},
				{
					"id": 10160107,
					"content": "Wow, di sini ada pendongeng! Suasananya enak sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10160108,
					"content": "Selain arak bagus suasana seperti inilah yang membuat tempat ini begitu digemari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160109
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10160109,
					"content": "\"Suasana\" yang kumaksud berbeda dengan \"suasana\" yang digunakan buku Panduan Wisata Teyvat untuk menilai sebuah restoran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160110
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10160110,
					"content": "Seperti yang kalian ketahui, jauh di atas pelabuhan Liyue, terdapat sebuah paviliun yang melayang, bagaikan sebuah istana di tengah kabut ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160111
					],
					"speakerTitle": "Iron Tongue Tian"
				},
				{
					"id": 10160111,
					"content": "Apa artinya mata yang melihat segalanya? Inilah jawabannya, teman-temanku. Karya besar Nona Ningguang yang menghubungkan bumi dan langit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160112
					],
					"speakerTitle": "Iron Tongue Tian"
				},
				{
					"id": 10160112,
					"content": "Bayangkan. Cuaca sedang cerah, dan kamu memandang dunia di bawah dari istana di atas awan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160113
					],
					"speakerTitle": "Iron Tongue Tian"
				},
				{
					"id": 10160113,
					"content": "Begitu indahnya! Pemandangan pelabuhan Liyue yang membentang jauh dan luas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160201
					],
					"speakerTitle": "Iron Tongue Tian"
				},
				{
					"id": 10160201,
					"content": "Sobekan kertas belaka, namun berisi pemikiran Nona Ningguang, pertimbangannya dalam mengambil tindakan ... demikianlah harganya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160202
					],
					"speakerTitle": "Iron Tongue Tian"
				},
				{
					"id": 10160202,
					"content": "Hanya dengan memahami satu atau dua lembar saja pasti akan memperluas wawasanmu, dan kamu pun menjadi lebih unggul daripada rekan-rekanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160203
					],
					"speakerTitle": "Iron Tongue Tian"
				},
				{
					"id": 10160203,
					"content": "Tianquan Ningguang ... Nama ini sering sekali kita dengar ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10160204,
					"content": "Orang Liyue senang ngomongin dia, orang Fatui semua benci sama dia, Exuvia kemungkinan dia juga yang sembunyiin, dan kita pernah ketemu dia di Rite of Descension.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10160205,
					"content": "Paimon jadi penasaran, orang seperti apa ya dia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10160207,
					"content": "Akhirnya, aku menemukanmu, orang yang kembali dari Jueyun Karst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160208
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160208,
					"content": "Siapa?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10160209,
					"content": "Paimon, kita harus pergi ...!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10160210
					]
				},
				{
					"id": 10160210,
					"content": "Tunggu! Aku bukan Millelith, dan aku bukan mau tangkap kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160211
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160211,
					"content": "Aku utusan dari Liyue Qixing. Namaku Ganyu, sekretaris Yuehai Pavilion, dan aku memang sengaja ingin ketemu kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160212,
						10160213
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160212,
					"content": "Utusan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10160214
					]
				},
				{
					"id": 10160214,
					"content": "Yah, jabatan resmiku adalah sekretaris korporat Qixing. Saat ini aku bertindak sebagai utusan khusus Nona Ningguang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160215
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160215,
					"content": "Astaga, berani ngomongin Ningguang, orangnya ... maksudnya sekretarisnya datang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10160216,
					"content": "Maaf, wahai kamu yang kembali dari Jueyun Karst ... Aku sedang bekerja, dan tidak bisa menyambut kalian dengan sepenuhnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160217
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160217,
					"content": "Tapi aku membawa surat dari Nona Ningguang. Dengan kapasitasnya sebagai Tianquan, beliau mengundang kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160218
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160218,
					"content": "Ke istananya yang ada di langit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160219
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160219,
					"content": "Undangan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10160220,
					"content": "Betul. Nona Ningguang berkata begini:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160221
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160221,
					"content": "\"Undang dia datang ke tempat ini\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160222
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160222,
					"content": "\"Aku ingin bertemu dengannya\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160223
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160223,
					"content": "\"Ke Jade Chamber, tempat kita akan menguraikan benang kusut misteri yang sedang kita alami kini\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160213,
					"content": "Sekretaris?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10160214
					]
				}
			]
		},
