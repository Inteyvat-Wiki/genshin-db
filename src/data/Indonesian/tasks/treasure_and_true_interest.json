			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Adan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190780401,
					"content": "Halo, bisa dibantu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780402,
						190780403
					],
					"speakerTitle": "Adan"
				},
				{
					"id": 190780402,
					"content": "Kamu kenal sama Alkami?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190780404
					]
				},
				{
					"id": 190780404,
					"content": "Oh, Alkami? Si orang kaya yang belakangan ini lagi naik daun ya? Dulu dia pernah beli mebel, berani bayar mahal tuh orang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780405
					],
					"speakerTitle": "Adan"
				},
				{
					"id": 190780405,
					"content": "Aku dengar dia kaya raya waktu jadi arsitek terkenal. Sekarang dia buka tempat les agar orang-orang bisa mengikuti jejaknya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780406
					],
					"speakerTitle": "Adan"
				},
				{
					"id": 190780406,
					"content": "Kalau uang lesnya tidak muaaahal sekali begitu, aku pasti sudah daftarkan anakku. Jadi arsitek sepertinya sangat menjanjikan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Adan"
				},
				{
					"id": 190780403,
					"content": "Mau tanya-tanya soal Alkami.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190780404
					]
				}
			]
		},
		{
			"id": 1907808,
			"completionStepIds": [
				1907808
