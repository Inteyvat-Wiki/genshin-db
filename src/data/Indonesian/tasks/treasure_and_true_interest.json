			},
			"dialogs": [
				{
					"id": 190785001,
					"content": "Pak Kaveh kayaknya marah sekali ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190785002
					],
					"speakerTitle": "Uzayr"
				},
				{
					"id": 190785002,
					"content": "Biarin deh. Mungkin dia cuma takut kita bakal makan semua proyeknya setelah lulus nanti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190785003
					],
					"speakerTitle": "Waiz"
				},
				{
					"id": 190785003,
					"content": "Ta-Tapi harusnya tidak mungkin deh. Pak Kaveh itu kan terkenal sekali ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190785004
					],
					"speakerTitle": "Tanisha"
				},
				{
					"id": 190785004,
					"content": "Siapa tahu? Papa bilang semakin terkenal seseorang, semakin sombong juga tabiatnya. Orang rendah hati kayak Pak Alkami justru jarang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Waiz"
				}
			]
		},
