			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aabid",
					"Adil"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190780801,
					"content": "Sudah tahu belum? Alkami rekrut Kaveh jadi pengajar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780802
					],
					"speakerTitle": "Aabid"
				},
				{
					"id": 190780802,
					"content": "Heh, pasti makin banyak yang mau les di sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780803
					],
					"speakerTitle": "Adil"
				},
				{
					"id": 190780803,
					"content": "Bikin sirik ya? Padahal Alkami juga enggak pintar-pintar amat waktu masih jadi arsitek. Kalau cuma lihat kemampuan doang, tidak akan ada yang mau belajar sama dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780804
					],
					"speakerTitle": "Aabid"
				},
				{
					"id": 190780804,
					"content": "Iya, tapi promosinya itu efektif sekali. Akademiya cuma terima orang yang lulus ujian saringan mereka. Cuma segelintir orang yang bisa beruntung belajar arsitektur di Kshahrewar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780805
					],
					"speakerTitle": "Adil"
				},
				{
					"id": 190780805,
					"content": "Orang-orang yang tidak lulus ujian, yang langsung ingin terjun ke bidangnya ... jelas tempat les pilihannya. Bayar sedikit, beres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780806
					],
					"speakerTitle": "Adil"
				},
				{
					"id": 190780806,
					"content": "Wih, otak bisnisnya jalan juga ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aabid"
				}
			]
		},
		{
			"id": 1907850,
