				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nahida",
					"#{REALNAME[ID(1)|HOSTONLY(true)]}"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30320101,
					"content": "Selamat datang kembali, Pengembara, Paimon, dan The Balladeer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320102
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320102,
					"content": "Wew. Paimon ngerasa kita baru saja melalui perjalanan yang panjang banget ... Paimon jadi capek deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320103,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320104
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320104,
					"content": "Apa kamu tidak puas dengan nama itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320105
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320105,
					"content": "Yah, aku cuma sedang berpikir, mungkin aku perlu ganti nama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320106
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320106,
					"content": "Kamu tidak mau pakai nama \"The Balladeer\" lagi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320107
					]
				},
				{
					"id": 30320107,
					"content": "Setelah tahu tentang semua hal yang dilakukan \"Doctor\", mana mungkin aku terus pakai nama yang berhubungan dengannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320108
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320108,
					"content": "Aku tidak akan kembali ke Fatui, dan aku tidak bisa kembali lagi meski aku mau. Pasti sudah ada banyak orang yang terpengaruh karena masalah kali ini, dan mereka mungkin tidak ingat siapa Fatui Harbinger ke-6.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320109
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320109,
					"content": "Berarti kamu akan keluar dari organisasi itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320110,
					"content": "Mungkin sejenis mundur taktis ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320111
					]
				},
				{
					"id": 30320111,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320112
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320112,
					"content": "Seperti yang kamu bilang, Lesser Lord Kusanali. Semuanya sepertinya sia-sia, tapi bukan berarti ini tidak bermakna. Setidaknya aku bisa buat banyak orang lupa denganku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320113
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320113,
					"content": "Tapi tidak berarti masa lalumu hilang begitu saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320114
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320114,
					"content": "Tentu saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320115
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320115,
					"content": "Dan tujuan utamamu, yang kamu raih dengan mengorbankan segalanya ... tidak berhasil kamu capai. Semoga kamu bisa melihat dan mengerti ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320116
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320116,
					"content": "Tidak mudah untuk mengubah dunia, masa lalu, dan ... takdir orang-orang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320117
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320117,
					"content": "Jawaban yang kamu cari adalah kehancuran total ... Benar-benar gila. Meskipun \"The Balladeer\" sudah tidak eksis lagi, dunia tetap tidak akan tunduk pada keinginanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320118
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320118,
					"content": "Ya. Haha, lucu sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320119
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320119,
					"content": "Apa kamu menyesal melakukan semua ini ... setelah tahu imbalannya sekecil ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320120,
					"content": "Meski aku tidak bernilai, tidak ada satu hal pun di dunia ini yang patut disesali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320121
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320121,
					"content": "Lesser Lord Kusanali, kamu sengaja tinggalkan informasi itu di Irminsul, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320122
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320122,
					"content": "Aku sudah berusaha keras untuk memastikan kalau kamu mendapatkan informasi itu secara alami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320123
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320123,
					"content": "Kenapa kamu mau susah-susah seperti itu? Apa kamu ingin aku bergabung denganmu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320124
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320124,
					"content": "Kalau mau jujur, masa lalumu sudah membuatmu menjadi aset yang berguna terhadap Sumeru dan aku. Menarikmu ke sisiku memang bagian dari rencanaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320125
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320125,
					"content": "Tapi sebelum itu, aku harus beri tahu kamu dulu tentang masa lalumu. Kalau aku cuma mau memanfaatkanmu, berarti aku tidak berbeda dengan The Doctor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320126
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320126,
					"content": "Kamu pintar juga ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320127
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320127,
					"content": "Anggap saja ini kebajikan yang aku miliki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320128
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320128,
					"content": "Menjadi berguna bagi orang lain itu sangat bernilai. Meski sebagai orang yang berdosa, aku sekarang punya nilai untuk dipakai orang lain lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320129
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320129,
					"content": "Nahida tidak anggap kamu seperti itu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320130
					]
				},
				{
					"id": 30320130,
					"content": "Oh ya, aku hampir lupa. Kalian ada di sisi \"kebenaran\", berbeda denganku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320131
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320131,
					"content": "Maaf, aku melihat segala sesuatu dari sudut pandang yang sedikit berbeda. Tapi aku tidak akan anggap ini sebagai rencana. Dengan kebijaksanaanmu, kamu ditakdirkan untuk mendapatkan orang yang lebih baik untuk membantumu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320132
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320132,
					"content": "Aku senang kamu bisa berpikir seperti itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320133
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320133,
					"content": "Pengembara, aku akan terus melakukan penelitian dan menggali rahasia yang terkubur di dalam Irminsul di masa depan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320134
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320134,
					"content": "Termasuk bagaimana awal perjalanan saudaramu bisa tercatat di dalam Irminsul. Apa yang sebenarnya terjadi setelah dan sesudahnya? Aku juga mau tahu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320135
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320135,
					"content": "Kalau begitu, kuserahkan kepadamu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320136
					]
				},
				{
					"id": 30320136,
					"content": "Baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320137
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320137,
					"content": "Pengembara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320138
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320138,
					"content": "Ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320139
					]
				},
				{
					"id": 30320139,
					"content": "Kenapa kamu pergi ke Inazuma setelah aku melompat ke dalam pusaran informasi di Irminsul?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320140
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320140,
					"content": "Karena aku ingin tahu apa yang kamu ubah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320141
					]
				},
				{
					"id": 30320141,
					"content": "Jadi begitu cara kamu mengetahui perubahan takdir orang-orang itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320142
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320142,
					"content": "Bagaimanapun juga, kamu sudah tolong aku. Aku akan berusaha untuk membalas kebaikan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320143,
						30320144
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320143,
					"content": "Aku tidak mengharapkan pembalasan dari tindakanku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320145
					]
				},
				{
					"id": 30320145,
					"content": "\"Meminjam\" dan \"mengembalikan\" itu satu-satunya hubungan di antara individu manusia. Kita akan impas cepat atau lambat. Tidak usah khawatir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320146
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320146,
					"content": "Itu tidak benar. Hubungan antara manusia tidak bisa dianggap sesepele itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320147
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320147,
					"content": "Kamu pasti sudah sadar kalau orang-orang yang muncul di dalam hidupmu tidak serta-merta menghilang seperti uap air. Tidak pernah ada kata \"impas\" dalam hubungan manusia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320148
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320148,
					"content": "Ada hal-hal yang tidak bisa diselamatkan atau diubah. Makanya ada emosi di dalam dunia manusia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320149
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320149,
					"content": "Semua yang kamu rasakan itu nyata, dan tidak semua yang kamu utangi itu bisa dibayar impas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320150
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320150,
					"content": "Menjadi manusia adalah ketidak sempurnaan. Kamu bisa memilih ingin menjadi manusia atau tidak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320151
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320151,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320152
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320152,
					"content": "Tidak ada manusia yang tidak punya hati, kan? Lagi pula, aku tidak mau jadi manusia lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320153
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320153,
					"content": "Meski tanpa hati, kamu tetap bisa merasakan sakit. Kamu hanya sedang menolak perasaanmu saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320154
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320154,
					"content": "Masa lalu tidak akan bisa diubah, tapi kamu bisa melanjutkan hidupmu. Kalau masa depanmu cukup panjang, suatu hari, \"masa lalu\"mu cuma akan menjadi bagian kecil dalam kehidupanmu saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320155
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320155,
					"content": "Sepertinya kamu sudah melakukan pengaturan untukku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320156
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320156,
					"content": "Aku harap kamu bisa bekerja sama dengan Nahida.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320157
					]
				},
				{
					"id": 30320157,
					"content": "Semuanya jadi makin ribet deh. Yah, pokoknya yang paling penting buat kamu sekarang itu ikut Nahida. Kalau enggak, semua usaha kami bakal sia-sia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320158
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320158,
					"content": "Kalau begitu, biar aku bantu kalian dari kejauhan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320159
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320159,
					"content": "Aku senang kamu sudah menerima tawaran kami. Bagaimana kalau kamu beri nama baru untuk dirimu sendiri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320160
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320160,
					"content": "Oh! Oh! Oh! Paimon sudah enggak sabar kasih julukan yang jelek buat kamu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320161
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320161,
					"content": "Kenapa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320162
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320162,
					"content": "Karena ... Paimon tetap saja enggak terlalu suka sama kamu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320163
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320163,
					"content": "Hmph! Kalau begitu lebih baik kita jarang bertemu di masa depan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320164
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320164,
					"content": "\"Nama adalah hadiah pertama dalam kehidupan\". Meski kalau kamu tidak menyebutnya kuat-kuat. Aku tahu apa yang sedang kamu pikirkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320165
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320165,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320166
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320166,
					"content": "Pengembara dan Paimon sudah banyak membantumu kali ini. Kalau kamu masih tetap tidak bisa tentukan nama barumu, kamu boleh coba tanya mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320167
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320167,
					"content": "Eh? Kamu mau kami yang bantu tentukan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320168
					]
				},
				{
					"id": 30320168,
					"content": "Enggak, enggak. Paimon cuma bisa kasih nama julukan. Paimon enggak tahu cara kasih nama beneran ... Paimon serahin ke kamu saja deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320144,
					"content": "Tolong jangan buat aku merasa sedang memerasmu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320145
					]
				}
			]
		},
		{
			"id": 303203,
			"completionStepIds": [
				303203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"303203",
							"2"
						],
						"stepId": 303203,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sawada",
					"Aqaba",
					"#{REALNAME[ID(1)|HOSTONLY(true)]}"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30320301,
					"content": "Aku sudah putuskan! Akhir cerita ini bisa difokuskan ke Mikoshi Nagamasa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320302
					],
					"speakerTitle": "Sawada"
				},
				{
					"id": 30320302,
					"content": "Jadi maksudmu orang-orang lain di cerita itu lenyap?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320303
					],
					"speakerTitle": "Aqaba"
				},
				{
					"id": 30320303,
					"content": "Ya. Aku dengar Mikoshi Nagamasa meninggal di usia tua. Cocok dijadikan narator epilog.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320304
					],
					"speakerTitle": "Sawada"
				},
				{
					"id": 30320304,
					"content": "\"Suasana aneh telah menghilang, tetapi dalam beberapa dekade mendatang, kejadian ini akan terus melekat di benak Mikoshi Nagamasa.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320305
					],
					"speakerTitle": "Sawada"
				},
				{
					"id": 30320305,
					"content": "\"Di masa tuanya, dia bermimpi. Pada malam ketika pedang spektakuler Daitatara Nagamasa ditempa, orang-orang bersorak, melukis, menari, dan minum.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320306
					],
					"speakerTitle": "Sawada"
				},
				{
					"id": 30320306,
					"content": "\"Kegembiraan mereka melebur di dalam api tungku dan berubah menjadi awan merah, mengelilingi matahari terbit terakhir yang dilihat Mikoshi Nagamasa dalam hidupnya.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320307
					],
					"speakerTitle": "Sawada"
				},
				{
					"id": 30320307,
					"content": "\"Ada jalan yang panjang di depan, tapi aku tetap terdiam waktu berangkat.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320308
					],
					"speakerTitle": "Sawada"
				},
				{
					"id": 30320308,
					"content": "Hmph ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				}
			]
		},
		{
			"id": 303204,
			"completionStepIds": [
				303204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"303204",
							"2"
						],
						"stepId": 303204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nahida",
					"#{REALNAME[ID(1)|HOSTONLY(true)]}"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30320401,
					"content": "Sekarang kamu sudah punya nama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320402
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320402,
					"content": "Bagaimana soal julukan? Apa sudah dipikirkan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320403
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320403,
					"content": "Uh ... um ... Paimon lagi mikir deh! Jangan kejar-kejar Paimon terus dong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320404,
					"content": "Santai saja. Kita tidak perlu bertemu kalau kamu masih belum bisa tentukan julukanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320405
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320405,
					"content": "Apa rencanamu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320406
					]
				},
				{
					"id": 30320406,
					"content": "Orang-orang yang memanipulasi aku dan membuatku menderita akan menerima akibatnya cepat atau lambat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320407
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320407,
					"content": "Maksudmu, Fatui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320408,
					"content": "Minimalnya, The Doctor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320409
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320409,
					"content": "Sudut pandangmu sudah berubah. Aku percaya jalan di masa depanmu juga akan ikut berubah, tapi tidak akan langsung ... Kamu perlu waktu untuk menyesuaikan diri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320410
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320410,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320411
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320411,
					"content": "Masih ada satu hal lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320412
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320412,
					"content": "Masih ada beberapa keturunan Raiden Gokaden di Inazuma. Sebagian dari mereka tahu ... Yah, atau mungkin mereka harus tahu tentang hubungan antara Raiden Gokaden dan diriku",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320413
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320413,
					"content": "Aku tidak berencana untuk meninggalkan Sumeru sementara ini. Tapi kalau kamu bertemu dengan mereka di Inazuma, kamu boleh ceritakan ke mereka kalau akulah orang di balik kejatuhan Raiden Gokaden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320414
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320414,
					"content": "Meski kejadian itu sudah terhapus dari dunia ini, mereka berhak tahu kebenarannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320415
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320415,
					"content": "Ternyata begitu ... Itu pilihanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320416
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320416,
					"content": "Eh? Tapi kalau begitu kan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320417,
					"content": "Tidak apa-apa. Kalau mereka mau, mereka boleh menghunuskan pedang ke dadaku. Mungkin memang sudah seharusnya begitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320418,
						30320422
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320418,
					"content": "....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320419
					]
				},
				{
					"id": 30320419,
					"content": "Tatapan seperti apa itu? Kamu tidak perlu berekspresi seperti itu. Aku tahu apa yang sedang aku lakukan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320420
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320420,
					"content": "Hari itu pasti tiba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320421
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320421,
					"content": "Baiklah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320425
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320425,
					"content": "Selamat tinggal, dewa bijak, dan kalian berdua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320426
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320426,
					"content": "Bubar deh dia ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320427,
					"content": "Yang terjadi baru saja itu sama seperti pengalaman satu kehidupan dalam sekejap mata baginya. Dia perlu waktu untuk menenangkan diri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320428
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320428,
					"content": "Yah, benar juga sih. Meski dia tetap orang yang sama, dia tidak seganas yang dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320429
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320429,
					"content": "Jalannya lika-liku. Tapi bagaimanapun juga, semua sudah berakhir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320430
					]
				},
				{
					"id": 30320430,
					"content": "Jadi sekarang kita sudah boleh makan-makan dong? Paimon sudah lapar banget!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320431,
					"content": "Terima kasih ya. Sekarang kalian sudah boleh cari tempat yang santai untuk beristirahat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320422,
					"content": "Aku mengerti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320423
					]
				},
				{
					"id": 30320423,
					"content": "Cepat sekali setujunya. Lumayan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320424
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320424,
					"content": "Ya sudah, sampai di sini saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320425
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				}
			]
		},
		{
			"id": 303205,
			"completionStepIds": [
				303205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"303205",
							"2"
						],
						"stepId": 303205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Amane",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30320501,
					"content": "Huff! Akhirnya waktu istirahat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320502,
					"content": "Begitu santai, Paimon tiba-tiba jadi ngerasa lapar dan capek deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320503,
						30320504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320503,
					"content": "Paimon, istirahat saja dulu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320505
					]
				},
				{
					"id": 30320505,
					"content": "Wow! Mantap tuh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320506,
					"content": "Eh? Vas itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320507,
					"content": "Ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320508
					]
				},
				{
					"id": 30320508,
					"content": "Apa ada yang pecahin pas bersihin kamarnya? Tapi Paimon sih enggak ingat ada yang bersih-bersih kamar deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320509,
					"content": "(Malam waktu kita tinggal di sini, Paimon senggol mejanya karena terkejut karena masalah The Balladeer dan memecahkan vasnya.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320510
					]
				},
				{
					"id": 30320510,
					"content": "(Tapi The Balladeer menghapus keberadaannya. Dia merubah dunia, kan? Tapi kenapa vas ini masih tetap pecah ...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320511
					]
				},
				{
					"id": 30320511,
					"content": "Sepertinya kamu kebingungan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320512
					],
					"speakerTitle": "Amane"
				},
				{
					"id": 30320512,
					"content": "Siapa kamu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320513
					]
				},
				{
					"id": 30320513,
					"content": "Aku mengerti apa yang membuatmu bingung. Semua orang yang mengetahui ini pasti akan menjadi bingung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320514
					],
					"speakerTitle": "Amane"
				},
				{
					"id": 30320514,
					"content": "Eh? Apa ada orang yang ngomong di telinga kita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320515,
					"content": "Tapi sayangnya, takdir Teyvat tidak bisa diubah semudah itu. Ada kemungkinan kecil kalau dewa bisa merubahnya, tapi bagi manusia fana ... sulit dikatakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320516
					],
					"speakerTitle": "Amane"
				},
				{
					"id": 30320516,
					"content": "Saat hewan kecil menabrak pohon, batang pohon mungkin akan bergetar. Tapi pohon yang bergetar bukan berarti berpindah, sama halnya dengan takdir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320517
					],
					"speakerTitle": "Amane"
				},
				{
					"id": 30320517,
					"content": "Sama seperti vas yang jatuh ke tanah itu. Entah dipecahkan oleh kucing, atau burung, akan tetap pecah, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320518
					],
					"speakerTitle": "Amane"
				},
				{
					"id": 30320518,
					"content": "Ka-kamu siapa? Kok kamu tahu semua ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320519,
					"content": "Sejarah tidak akan bisa diubah semudah itu, tapi hati manusia bisa. Percayalah kepada matamu sendiri. Apa yang kamu lihat itu nyata. Apa yang tidak terlihat itu adalah ilusi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320520
					],
					"speakerTitle": "Amane"
				},
				{
					"id": 30320520,
					"content": "....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320521
					]
				},
				{
					"id": 30320521,
					"content": "Suaranya ... menghilang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320522
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320522,
					"content": "Siapa sih tadi? Tiba-tiba keluar suara terus ngomong hal yang aneh kayak gitu. Maksudnya apa dah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320523
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320523,
					"content": "(Percaya dengan mataku? Maksudnya ... Aku harus percaya dengan ingatanku?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320524
					]
				},
				{
					"id": 30320524,
					"content": "Yah ... Vas yang pecah itu masih ada di atas tanah. Paimon bakal minta orang untuk bersihin deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320525
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320525,
					"content": "Tapi kok taruh gitu saja kayaknya enggak pas. Tunggu dulu, Paimon sebentar lagi balik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320526
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320526,
					"content": "(...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320527
					]
				},
				{
					"id": 30320527,
					"content": "(Kira-kira apa ya yang masih menungguku di masa depan?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 30320504,
					"content": "Aku traktir makan enak deh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320505
					]
				}
			]
