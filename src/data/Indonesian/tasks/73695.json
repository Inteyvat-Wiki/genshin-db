					"Daneh"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736950201,
					"content": "Oh? Kamu sudah menemukan semua replikanya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950202
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736950202,
					"content": "Luar biasa! Kamu punya bakat dalam bidang arkeologi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950203
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736950203,
					"content": "Kalau begitu, ambillah hadiah ini. Terima kasih sudah mengikuti acara Darshan kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950204
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736950204,
					"content": "Aku harap kamu menikmati serunya arkeologi dari acara ini, Pengembara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950205
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736950205,
					"content": "Walaupun pekerjaan arkeologi dalam kehidupan sehari-hari itu sebenarnya membosankan dan sulit ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950206
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736950206,
					"content": "Tapi begitu kamu menemukan relik penting, semua keringat darah yang sudah dikeluarkan juga terasa sepadan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950207,
						736950208
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736950207,
					"content": "Bagaimana kalau kamu tidak menemukan apa-apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736950209
					]
				},
				{
					"id": 736950209,
					"content": "Kalau aku tidak menemukan apa pun, ya ini yang mereka bilang \"pekerjaan sia-sia\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950210
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736950210,
					"content": "Sejujurnya yang seperti ini jauh lebih sering terjadi. Jarang-jarang kami bisa menemukan barang penting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950211
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736950211,
					"content": "Tapi dalam pekerjaan arkeologi, kamu harus terbiasa dengan situasi seperti ini dan tetap optimis. Kalau tidak, kamu tidak akan bisa bertahan lama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736950208,
					"content": "Pasti ada saat-saat kamu tidak menemukan apa pun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736950209
					]
				}
			]
		},
