			"dialogs": [
				{
					"id": 750290101,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290102,
						750290103
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290102,
					"content": "Halo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290104
					]
				},
				{
					"id": 750290104,
					"content": "HAHAHAHAHAHA!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290105
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290105,
					"content": "WAH! Paimon hampir jantungan loh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750290106,
					"content": "Kalian datang ke sini untuk latihan khusus juga ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290107
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290107,
					"content": "Ternyata benar, entah itu manusia atau Saurian, pejuang yang ambisius pasti akan saling menarik satu sama lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290108
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290108,
					"content": "Jangan buang-buang waktu lagi. Kita mulai latihan khususnya sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290109,
						750290110
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290109,
					"content": "Jadi di sini ada juga ya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290111
					]
				},
				{
					"id": 750290111,
					"content": "Kami bahkan belum ngomong sepatah kata pun loh. Kok tiba-tiba sudah disuruh ikutan latihan khusus sih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750290112,
					"content": "Tapi dari caramu ngomong ... Jangan-jangan kamu seorang Pelatih Unggulan ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750290113,
					"content": "Tidak semua orang bisa jadi Pelatih Unggulan. Aku juga tidak sehebat itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290114
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290114,
					"content": "Tapi kalian berdua sudah jauh-jauh terbang dari bawah ke sini, ternyata bukan buat ikut latihan khusus pejuang dari aku, Matahga?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290115,
						750290116
					],
					"speakerTitle": "Matahga",
					"speakerSubtitle": "Pejuang Cadangan Suku Bunga Bersayap"
				},
				{
					"id": 750290115,
					"content": "Kami cuma numpang lewat saja kok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290117
					]
				},
				{
					"id": 750290117,
					"content": "Jelas-jelas kalian punya kemampuan untuk menunggangi Saurian, tapi tidak serius belajar. Sia-sia sekali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290118
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290118,
					"content": "Aku pikir kalian itu pejuang yang sevisi semisi denganku ... Sayang sekali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290119
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290119,
					"content": "Aku salah menilai! Memalukan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290120
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290120,
					"content": "Memang Natlan ini bangsa yang penuh pejuang ya. Apa memang semua orang di Natlan ini menggebu-gebu ya? Bahkan anak kecil saja bisa sesemangat ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290121,
						750290122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750290121,
					"content": "Anak kecil? Jelas-jelas ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290123
					]
				},
				{
					"id": 750290123,
					"content": "Salah besar! Kalau sudah pasti mau jadi pemberani, tidak boleh malas-malasan dong! Tidak bersemangat, tidak berani, tidak punya cita-cita, orang kayak begini mana mungkin bisa sukses!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290124
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290124,
					"content": "Terus ya, aku tahun ini umur dua belas! Dari umur saja sudah lewat satu digit, jadi seharusnya bukan anak-anak lagi! Tapi, aku akan memaafkan kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290125
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290125,
					"content": "Ya memang, tinggiku memang susah bertambah meski aku sudah minum susu. Tapi tekadku? Jangan main-main! Tidak ada yang bisa mematahkannya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290126
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290126,
					"content": "Lagian, aku kan sedang bertumbuh. Kalian juga tidak termasuk tinggi-tinggi banget, kan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290127
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290127,
					"content": "Pidato yang ... luar biasa sekali ... Hei! Tapi kok jadinya malah bawa-bawa kami?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750290128,
					"content": "Heh! Memang harus diakui kalau kekuatan fisik seseorang itu dipengaruhi oleh bentuk tubuhnya, tapi seorang pemberani mana boleh diukur dari fisik tubuhnya saja?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290129
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290129,
					"content": "Yang paling penting adalah semangat di dalamnya, makanya, asal punya tekad yang kuat, percayalah dengan impian besar milik dirimu sendiri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290130
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290130,
					"content": "Ini kan prinsip sederhana, harusnya petualang paling pemula pun bisa mengerti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290131
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290131,
					"content": "Yang dia bilang ... masuk akal sih ... Tapi kok Paimon ngerasa ... dia lagi marahin Paimon ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290132,
						750290133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750290132,
					"content": "Nah iya tuh ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290134
					]
				},
				{
					"id": 750290134,
					"content": "Aku cuma sedang menjelaskan pentingnya ambisi, untuk orang yang suka bermalas-malasan kayak kalian! Kalau malas-malasan terus, mana bisa jadi pahlawan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290135
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290135,
					"content": "Sebagai seorang pemberani ... Bukan, sebagai seorang manusia, kalau tidak ada cita-cita yang membanggakan dan keringat yang menetes di tempat pelatihan, itu berarti kalian gagal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290136
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290136,
					"content": "Kalau kalian tidak bisa terbang ke angkasa dengan gaya bebas seperti pahlawan, tidak bisa mendapat pengakuan dari Pelatih Unggulan, itu berarti kalian gagal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290137
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290137,
					"content": "Jadi, kalian harus latihan keras! Mengerti?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290138
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290138,
					"content": "Si-Siap!!! Gimana nih? Suaranya kencang banget nih. Memang masuk akal sih, Paimon enggak bisa ngejawab dia sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750290139,
					"content": "Bagus! Kalau kalian sudah bersiap, carilah aku untuk latihan khusus. tujuannya adalah: Gunakan seluruh kekuatanmu untuk menunggangi Saurian dengan kecepatan maksimum di jalurnya dan cetak skor tertinggi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290140
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290140,
					"content": "Selama latihan aku akan amati dan kasih nilai di setiap pos. Hasil akhirnya akan dibagi jadi empat tingkat sesuai dengan skornya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290141
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290141,
					"content": "Terbang secepat mungkin! Bahkan kalau tidak sanggup sampai tingkat tertinggi, setidaknya sampai kedua tertinggi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290142
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290142,
					"content": "Waktunya untuk membakar tekadmu, kejar bayanganku. Maju! Maju! Maju!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290143
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290143,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290144
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290144,
					"content": "Pemberani, aku menunggu jawabanmu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290145,
						750290150
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290145,
					"content": "Siap, mengerti!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290146
					]
				},
				{
					"id": 750290146,
					"content": "LEBIH KERAS LAGI!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290147
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290147,
					"content": "SI-AP!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290148
					]
				},
				{
					"id": 750290148,
					"content": "Di sini, para pahlawan yang bertekad akan menggunakan tempat latihanku untuk mewujudkan tekadnya. Mereka mengerahkan seluruh semangatnya untuk terus menantang dunia ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290149
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290149,
					"content": "Cari aku lagi kalau kamu sudah siap untuk latihan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290150,
					"content": "SIAP! Tapi aku tidak mau latihan!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290151
					]
				},
				{
					"id": 750290151,
					"content": "APA? Kamu masih tetap tidak mau bertobat dari kemalasanmu itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290152
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290152,
					"content": "Benar-benar kondisi yang menyedihkan. Tapi tidak apa-apa! Suatu hari, kamu pasti tidak akan tahan dengan kemalasanmu sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290153
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290153,
					"content": "Kabur dan melarikan diri untuk selamanya, maka tidak akan ada yang menjadi milikmu. Hanya mereka yang berjuang keras untuk mendapatkan apa yang mereka inginkan yang bisa berdiri tegak dan tertawa bangga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290154
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290154,
					"content": "Heh! Ingat kata-kataku! Sampai saatnya nanti, datanglah lagi ke sini untuk melatih diri. Tidak pernah ada kata terlambat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290133,
					"content": "Kok jadi ngegas ya kamu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290134
					]
				},
				{
					"id": 750290122,
					"content": "Lumayan ekstrem ya, dik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290123
					]
				},
				{
					"id": 750290116,
					"content": "Jangan meremehkan rasa penasaran seorang petualang ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290117
					]
				},
				{
					"id": 750290110,
					"content": "Apa maksudnya latihan khusus?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290111
					]
				},
				{
					"id": 750290103,
					"content": "Halo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290104
					]
				}
			]
		},
		{
			"id": 7502902,
			"completionStepIds": [
				7502904
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7502904",
							"2"
						],
						"stepId": 7502904,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Matahga"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750290201,
					"content": "Bagus, luar biasa! Kamu sudah melampauiku! Benar-benar luar biasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290202
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290202,
					"content": "Aku sudah latihan khusus sendiri di sini, tujuannya biar aku bisa menciptakan rekor baru. Tapi sayangnya sampai hari ini aku sendiri tidak bisa melakukannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290203
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290203,
					"content": "Tapi kamu bisa! Ini berarti sudah waktunya aku melihat dunia luar! Pasti ada banyak pemberani yang lebih hebat dari aku di luar sana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290204
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290204,
					"content": "Kalau aku bisa berkomunikasi dan bertanding dengan mereka, kemampuanku pasti akan meningkat. Suatu hari nanti, aku pasti akan bisa diakui oleh ayah dan kakak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290205
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290205,
					"content": "Kalau Acomitl sih, biarin saja lah. Dia sama sekali tidak punya cita-cita. Orang kayak gitu jadi saudaraku? Memalukan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290206
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290206,
					"content": "Acomitl ...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290207
					]
				},
				{
					"id": 750290207,
					"content": "Eh, tidak apa-apa kok. Sudah cukup ngobrol-ngobrolnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290208
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290208,
					"content": "Pemberani. Lain kali harus keras sama diri sendiri ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290209
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290209,
					"content": "Kalau kamu ingin menjadi legenda, teruslah melangkah maju! Maju! Maju! ini adalah kata-kata mutiara yang aku hadiahkan kepadamu sebelum kita berpisah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Matahga"
				}
			]
		},
		{
			"id": 7502905,
			"completionStepIds": [
				7502904,
				7502906
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7502906",
							"2"
						],
						"stepId": 7502906,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Matahga"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750290501,
					"content": "Pemberani! Bagaimana latihannya di jalur ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290502,
						750290504
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290502,
					"content": "Ada kemajuan kok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290503
					]
				},
				{
					"id": 750290503,
					"content": "Lemah! Kalau tidak ada kemajuan, ya berarti mundur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290506
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290506,
					"content": "Ugh ... Gimana ya? Kayaknya di kamus Matahga itu, selain kata \"maju ke depan\", \"berusaha\", sudah tidak ada kata lain lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750290507,
					"content": "Memang benar! Kamusku memang lebih tipis dari kamus orang lain, karena selain berusaha dan giat, tidak ada lagi yang bisa aku akui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290508
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290508,
					"content": "Kalian perlu latihan, aku juga. Kalau latihan bekerja sama dengan Saurian saja masih belum cukup untuk membuatku jadi pemberani yang sempurna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290509
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290509,
					"content": "Aku harus mencari panggung yang lebih luas lagi untuk mengasah kemampuanku sendiri. Dengan kata lain, aku akan pergi dari sini sebentar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290510
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290510,
					"content": "Tenang saja. Jalur di sini akan aku pertahankan kok. Tapi rumah kabin ini bakal aku bongkar dan aku bawa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290511,
						750290513
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290511,
					"content": "Kamu mau ke mana?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290512
					]
				},
				{
					"id": 750290512,
					"content": "Hmm ... Lihat ayahku, dan kakakku deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290515
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290515,
					"content": "Eh? Matahga kayaknya enggak terlalu pede deh sekarang, beda sama sebelumnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750290516,
					"content": "Memangnya kenapa? Mencintai dan menghormati orang lain kan kebajikan yang harus dimiliki seorang pemberani juga! Jangan kayak katak dalam tempurung dong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290517
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290517,
					"content": "Ayahku itu Pelatih Unggulan yang paling profesional di Bunga Bersayap, kakakku itu penunggang Saurian yang paling hebat! Aku bangga bisa jadi keluarga mereka!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290518
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290518,
					"content": "Hei, Paimon enggak bermaksud jadiin mereka bahan bercandaan loh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750290519,
					"content": "Iya tahu, semoga semuanya lancar ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290520
					]
				},
				{
					"id": 750290520,
					"content": "Kamu juga, Pemberani! Kali ini, kata-kata mutiara yang mau aku hadiahkan adalah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290521
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290521,
					"content": "Aku pikir-pikir dulu ya ... Jangan pernah menyerah! Jadilah pahlawan, sebesar apa pun harga yang harus dibayar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290513,
					"content": "Gimana rencana latihannya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290514
					]
				},
				{
					"id": 750290514,
					"content": "Hmm ... Mungkin aku akan tanya pendapat mereka berdua dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290515
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290504,
					"content": "Akhir-akhir ini sibuk nih, belum sempat latihan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290505
					]
				},
				{
					"id": 750290505,
					"content": "Dasar pemalas! Kamu sedang menghabiskan waktu untuk melewati kehidupanmu yang tak berguna itu ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290506
					],
					"speakerTitle": "Matahga"
				}
			]
		},
		{
