				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750291301,
					"content": "Soaring Saurian buka seharian. Jika ingin bergabung dengan latihan khusus Matahga, langsung naik ke lantai atas saja dari Soaring Saurian. Harap diingat: Berlatih dengan serius adalah suatu kebanggaan, bermalas-malasan adalah suatu bentuk hinaan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750291302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750291302,
					"content": "Kalau hari ini tidak berusaha, silakan besok makan sampah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750291303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750291303,
					"content": "Teruslah berusaha, agar menjadi penunggang Saurian yang luar biasa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7502914,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"7500001",
							"1"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750291401,
					"content": "Perintahnya adalah: <color=#00E1FFFF>bunyikan trompet kiri dulu, baru yang kanan, yang terakhir yang kiri</color>. Urutannya jangan salah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750291402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750291402,
					"content": "(Kayaknya ini pengingat yang ditinggalkan seseorang bernama Matahga untuk dirinya sendiri. Bisa terasa emosinya yang meluap-luap dalam setiap katanya.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750291403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750291403,
					"content": "(Tapi nambahin tanda seru di setiap pengingat ... buat apa? Mending enggak usah sekalian, enggak ada bedanya.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}