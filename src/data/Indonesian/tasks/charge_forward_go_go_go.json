				"points": []
			},
			"dialogs": [
				{
					"id": 750290601,
					"content": "Kamu lumayan juga, kalau serius, pasti bisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290602
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290602,
					"content": "Hei. Kamu kira aku akan serius ngomong seperti ini? Tidak ada kata-kata \"lumayan\" atau \"bisa lah\" dalam kamus seorang pemberani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290603
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290603,
					"content": "Hanya ada kata \"terbaik\". Kalau tidak bisa mencapai standar ini, berarti semuanya gagal! Gagal dan gagal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290604
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290604,
					"content": "Selama kamu masih punya keberanian, datang saja lagi! Terus latihan sampai kamu bisa melampauiku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Matahga"
				}
			]
		},
		{
			"id": 7502907,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
