			"dialogs": [
				{
					"id": 190030601,
					"content": "Ada apa, anakku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030602
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030602,
					"content": "Tentang waktu libur Barbara...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030603
					]
				},
				{
					"id": 190030603,
					"content": "Oh ya, Suster Barbara baru saja mengajukan cuti setengah hari. Katanya dia sudah ada rencana dengan seorang teman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030604
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030604,
					"content": "Perlu kuakui, tidak biasanya Suster Barbara meminta izin cuti setengah hari hanya untuk menemui seorang teman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030605
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030605,
					"content": "Tapi sudahlah, ngomong-ngomong, apa yang ingin kamu tanyakan padaku, Nak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030606
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030606,
					"content": "Tentang \"Fantastic Summer-Serendipity Coral Sparkling Tea\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030607
					]
				},
				{
					"id": 190030607,
					"content": "Oh? Maksudmu, Suster Barbara berniat menemanimu membeli... minuman spesial ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030608
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030608,
					"content": "Jadi kamu adalah teman yang dia maksud itu ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030609
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030609,
					"content": "Yah, karena kamu adalah Honorary Knight, sepertinya tidak masalah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030610
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030610,
					"content": "Baiklah, aku mengerti. Tolong jaga Suster Barbara ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030611
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030611,
					"content": "Kenapa Barbara harus selalu melaporkan jadwalnya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030612
					]
				},
				{
					"id": 190030612,
					"content": "Yah kamu sendiri tahu kan, karena beberapa alasan, Suster Barbara cukup populer di Mondstadt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030613
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030613,
					"content": "Meskipun warga di sini mungkin hanya bertindak karena niat baik mereka, tapi jumlah mereka terlalu banyak, dan Suster Barbara tidak mungkin dapat menangani semuanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030614
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030614,
					"content": "Jika mereka muncul saat dia sedang bekerja di gereja, kita bisa datang dan turun tangan untuk menanganinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030615
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030615,
					"content": "Tetapi jika ada penggemar yang mendekatinya pada waktu istirahat, maka hanya dia sendiri yang bisa menanganinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030616
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030616,
					"content": "Dan belum lagi, dia terlalu... baik hati. Dia akan selalu berusaha memenuhi permintaan warga Mondstadt, bahkan ketika hal itu membebankannya dan membuatnya lebih lelah daripada jam kerjanya yang sebenarnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030617
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030617,
					"content": "Jadi karena itu, kami pikir kami akan meminta Suster Barbara untuk selalu memberi tahu kami di mana dia berada, kalau-kalau kami perlu datang dan menyelamatkannya dari keramaian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030618
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030618,
					"content": "Kuharap Suster Barbara berhenti untuk memaksakan dirinya sendiri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						0
					],
					"speakerTitle": "Victoria"
				}
			]
		},
