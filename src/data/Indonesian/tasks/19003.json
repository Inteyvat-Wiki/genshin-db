			"trigger": {
				"objectNames": [
					"Victoria"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190030301,
					"content": "Oh kamu datang lagi, jika kamu mencari Suster Barbara, dia masih belum kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030302,
						190030303
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030302,
					"content": "Kami menemukan Barbara di Wolvendom.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030304
					]
				},
				{
					"id": 190030304,
					"content": "Oh jadi begitu. Terpujilah Barbatos karena Barbara baik-baik saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030305
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030305,
					"content": "Tapi sepertinya dia tidak akan kembali dalam waktu dekat. Mungkin aku harus menyerahkan tanggung jawabnya di Katedral kepada orang lain...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030306
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030306,
					"content": "Aku akan membantumu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030307
					]
				},
				{
					"id": 190030307,
					"content": "Oh kamu baik sekali, tapi aku sungguh tidak mau merepotkanmu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030308
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030308,
					"content": "Biar kupikirkan... Oh ya, kamu bisa bantu bersih-bersih sedikit di sekitar Katedral.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030309
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030309,
					"content": "Orang-orang cenderung membawa debu saat masuk ke dalam Katedral, jadi lantainya sering kotor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030310
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030310,
					"content": "Masalah bersih-bersih dan sejenisnya selalu menjadi tanggung jawab Suster Barbara, jadi saat dia pergi, semuanya mulai kotor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030311
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030311,
					"content": "Barbara bertanggung jawab membersihkan tempat besar ini sendirian?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030312
					]
				},
				{
					"id": 190030312,
					"content": "Benar, Suster Barbara selalu bilang bahwa dia bisa menanganinya sendiri dan tidak perlu meminta bantuan orang lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030313
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030313,
					"content": "Tapi dia sering terlihat letih sekali setiap kali habis bersih-bersih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030314
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030314,
					"content": "Sejujurnya, aku sedikit kaget kamu bersedia membantu, atau lebih tepatnya... aku kaget Suster Barbara membiarkanmu membantunya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030315
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030315,
					"content": "Tapi bagaimanapun, ini akan membantu meringankan bebannya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030316
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030316,
					"content": "Baiklah, kalau begitu kuserahkan urusan bersih-bersih ini padamu, Honorary Knight.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						0
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030303,
					"content": "Barbara sedang berada di Dawn Winery untuk mengecek kondisi Tunner.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030304
					]
				}
			]
		},
