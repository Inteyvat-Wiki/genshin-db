			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhangshun"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223070101,
					"content": "Bagaimana ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070102
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223070102,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223070103
					]
				},
				{
					"id": 223070103,
					"content": "Aku adalah mantan pelaut Crux Fleet, aku mengalami kecelakaan dan terluka...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070104
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223070104,
					"content": "Setelah keluar dari Crux Fleet, aku menggadaikan beberapa lembar peta harta karun kepada seorang pengusaha bernama Bolai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070105
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223070105,
					"content": "Dia berjanji akan memberiku bagian bila menemukan harta karun. Tapi sampai sekarang tidak ada kabar terdengar darinya. Aku rasa sampai sekarang dia belum mencoba untuk mencarinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070106
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223070106,
					"content": "Aku tidak bisa terus menunggu seperti ini. Apa kamu mau membantuku mencari harta karun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070107,
						223070109,
						223070116
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223070107,
					"content": "Baiklah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223070108
					]
				},
				{
					"id": 223070108,
					"content": "Mohon bantuanmu ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070120
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223070120,
					"content": "Kamu sebaiknya pergi menemui <color=#00E1FFFF>Bolai</color> untuk mengambil <color=#00E1FFFF>Peta Harta Karun</color>. Lalu carilah <color=#00E1FFFF>harta karun</color> dan <color=#00E1FFFF>bawa padanya</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070121
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223070121,
					"content": "Aku sudah memberi tahu dia untuk menyimpan bagianku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223070109,
					"content": "Kenapa kamu keluar dari Crux Fleet?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223070110
					]
				},
				{
					"id": 223070110,
					"content": "Aku tahu kondisi tubuhku sendiri dan cederaku bisa kambuh sewaktu-waktu. Aku tidak ingin merepotkan rekan-rekanku, karena itu aku memutuskan untuk keluar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070111
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223070111,
					"content": "Setelah keluar, aku menggunakan sedikit tabunganku untuk membuka usaha kecil di sini. Tapi membuka usaha ternyata tidak semudah yang kukira. Barang-barang jualanku sudah hampir habis terjual...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070112
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223070112,
					"content": "Aku awalnya masih punya beberapa lembar peta harta karun. Peta-peta ini adalah hasil jerih payahku sewaktu masih menjadi pelaut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070113
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223070113,
					"content": "Dengan tubuh yang sudah lemah ini, mana mungkin aku mampu menempuh perjalanan jauh untuk mencari harta karun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070114
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223070114,
					"content": "Jadi aku menggadaikan peta-peta itu kepada Bolai untuk mendapat sedikit uang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070115
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223070115,
					"content": "Tapi sepertinya dia juga tidak bisa mencari harta karunnya sendirian. Dia hanyalah seorang pengusaha biasa... makanya aku butuh bantuanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070107,
						223070116
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223070116,
					"content": "Benarkah ada harta karun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223070117
					]
				},
				{
					"id": 223070117,
					"content": "Hahaha... mungkin jumlahnya tidak banyak... Peta-peta itu hanyalah hasil yang dibagikan kepada para pelaut Crux Fleet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070118
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223070118,
					"content": "Kalau benar-benar ada harta karun melimpah, rekan-rekanku pasti sudah melacaknya dan membawa pulang harta karun itu ke kapal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070119
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223070119,
					"content": "Walaupun jumlahnya tidak banyak, tapi setidaknya masih bernilai. Paling tidak bisa dibagi untuk tiga orang... Tolong carikan ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070120
					],
					"speakerTitle": "Zhangshun"
				}
			]
		},
