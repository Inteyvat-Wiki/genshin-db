			"dialogs": [
				{
					"id": 750360801,
					"content": "Ayo, benih kecil~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360802,
					"content": "Ayo keluarlah, bunga kecil~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360803,
					"content": "Hah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360804,
					"content": "Wah ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750360805
					]
				},
				{
					"id": 750360805,
					"content": "#Ah, {NICKNAME}, energi Phlogiston-nya sudah hilang. Mungkin sudah dihisap sama benihnya, tapi ... kok enggak ada reaksi apa-apa ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360806,
					"content": "Nguk?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360807,
						750360811
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750360807,
					"content": "Mungkin memang benihnya butuh waktu untuk tumbuh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750360808
					]
				},
				{
					"id": 750360808,
					"content": "Oh ya? Hmm, kalau Paimon pikir lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360809,
					"content": "Benih Dandelion bakal langsung terbang begitu ditiup angin, Wolfhook bakal nempel di tubuh serigala, terus kebawa ke tempat jauh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360810,
					"content": "Benih tuh hebat juga ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360815
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360815,
					"content": "Kalau gitu, kita tinggalin dulu deh — nanti kita balik lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360816
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360816,
					"content": "Nguk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750360811,
					"content": "Mungkin benihnya ketakutan ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750360812
					]
				},
				{
					"id": 750360812,
					"content": "O-Oh ya? Hmm, ya, mungkin Paimon kurang sabar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360813,
					"content": "#Benihnya digali sama {REALNAME[ID(2)|SHOWHOST(true)]}, terus nutrisinya dicuri sama serangga terbang, terus bahkan diganggu sama monster-monster ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360814
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360814,
					"content": "Hal-hal gituan buat benih itu pasti kayak badai yang ngeri banget ya — wajar dia ketakutan, enggak berani gerak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360815
					],
					"speakerTitle": "Paimon"
				}
			]
		},
