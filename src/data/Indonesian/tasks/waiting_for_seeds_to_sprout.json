			"dialogs": [
				{
					"id": 750360201,
					"content": "#Ada apa, {REALNAME[ID(2)|SHOWHOST(true)]}? Kamu tadi gali-gali di sana. Ada nemu barang bagus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360202,
					"content": "Ada harta karun berharga?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360203,
					"content": "Nguk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360204
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750360204,
					"content": "Hmm, coba Paimon lihat ... Ini kayaknya benih deh ... Enggak disangka bakal nemu ginian di tempat yang sudah lama ditinggalin gini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360205,
					"content": "Rrrawr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360206
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750360206,
					"content": "Tapi intinya ini enggak kelihatan kayak barang mahal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360207,
					"content": "Fuwah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360208,
						750360209
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750360208,
					"content": "Benih juga bisa saja mengandung beberapa kemungkinan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750360210
					]
				},
				{
					"id": 750360210,
					"content": "Di sini sudah enggak ada yang nempatin dari dulu deh. Tanahnya juga keras ... yakin bijinya masih hidup?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360211,
					"content": "Nguu ... uk?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360212
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750360212,
					"content": "Kamu kecewa? Yah, susah ngomong sih — beberapa benih memang enggak bisa tumbuh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360213,
					"content": "Tapi kita bisa tanam lagi terus lihat dulu. Mungkin memang masih belum waktunya tumbuh. Mungkin lubangnya harus digali lebih dalam atau mungkin nutrisinya enggak cukup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360214,
					"content": "Jadi kalau kita tanam dengan baik mungkin bisa tumbuh! Hehe, kira-kira bakal tumbuh kayak gimana ya? Grainfruit raksasa? Atau ... Cacahuatl yang kuat banget!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360215,
					"content": "Nguk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360216
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750360216,
					"content": "Atau mungkin bakal keluar Whopperflower ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750360217
					]
				},
				{
					"id": 750360217,
					"content": "Hei! Kok kamu ngerusak suasana gitu sih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360218,
					"content": "Oke, jadi kira-kira nutrisi apa yang tepat buat tanaman Natlan? Hmm, yah pokoknya kita tanam dulu saja deh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360209,
					"content": "Mungkin bisa tumbuh jadi sesuatu yang hebat!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750360210
					]
				}
			]
		},
