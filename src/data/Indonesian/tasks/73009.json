			"dialogs": [
				{
					"id": 730090801,
					"content": "Apa masih ada yang perlu dilakukan lagi untuk mempersiapkan Festival Utsava?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730090802
					]
				},
				{
					"id": 730090802,
					"content": "Oh ya, Arakavi harusnya ada di pusat Vanarana. Aku rasa dia juga perlu bantuan untuk persiapan Festival Utsava ini.",
					"roleType": "TALK_ROLE_NPC",
