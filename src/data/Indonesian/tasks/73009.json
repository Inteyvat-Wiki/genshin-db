				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730091301,
					"content": "Terima kasih banyak karena sudah menyiapkan Festival Utsava.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091302
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730091302,
					"content": "Sayang sekali aku tidak bisa ikut petualanganmu seperti Arama dan yang lainnya, aku juga tidak bisa bantu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091303
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730091303,
					"content": "Tapi, kalau kamu capek waktu bertualang, datang saja ke Vanarana. Kamu akan selalu disambut di dalam mimpi ini.",
					"roleType": "TALK_ROLE_NPC",
