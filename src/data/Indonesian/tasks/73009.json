					"nextDialogs": [
						730091102
					]
				},
				{
					"id": 730091102,
					"content": "Buku itu pernah menjadi milik Nara Varuna. Dia juga Nara yang berwarna emas, baik hati, berani, dan jujur, persis sepertimu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091103
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730091103,
					"content": "#Aku masih ingat Aranara saat itu sangat merindukan dirinya dan sangat menyukai cerita-ceritanya. Tapi aku percaya, dengan adanya Nara {NICKNAME} di sini ....",
