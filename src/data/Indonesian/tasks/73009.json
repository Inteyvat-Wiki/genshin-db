			"dialogs": [
				{
					"id": 730091001,
					"content": "Tentang \"Buah Vasoma\" ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730091002
					]
				},
				{
					"id": 730091002,
					"content": "Itu adalah buah yang penuh dengan kekuatan. Ia tumbuh dengan menyerap kenangan dan mimpi dari daratan, dan baru bisa menghasilkan buah melalui bantuan Aranara dan Nara.",
					"roleType": "TALK_ROLE_NPC",
