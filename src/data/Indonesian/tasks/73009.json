			},
			"dialogs": [
				{
					"id": 730090101,
					"content": "Arana akan menjaganya. Karena dia adalah teman yang terpenting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090102
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730090102,
					"content": "#Nara {NICKNAME}, tolong pergi ke \"Vanarana\" dan nyanyikan \"Irama dari Mimpi yang Besar\". Lalu minta bantuan mereka mempersiapkan \"Bija\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090103,
						730090104
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730090103,
					"content": "Aku tidak paham ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730090106
					]
				},
				{
					"id": 730090106,
					"content": "Seperti awan yang akan mengerti cara menurunkan hujan, dan hujan paham untuk jatuh ke bumi. Benih mengerti untuk tumbuh menjadi pohon besar dan menghasilkan buah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arana"
				},
				{
					"id": 730090104,
					"content": "I—Iya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730090105
					]
				},
				{
					"id": 730090105,
					"content": "#Nara {NICKNAME}, sepertinya tidak mengerti, tapi tidak apa-apa. Kalau waktunya sudah tiba, Nara {NICKNAME} akan tahu apa yang harus dilakukan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090106
					],
					"speakerTitle": "Arana"
				}
			]
		},
		{
