			"dialogs": [
				{
					"id": 710190201,
					"content": "Alangkah baiknya kalau benar-benar bisa menemukan sesuatu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710190202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710190202,
					"content": "Tetapi bukannya \"bebatuan buatan\" umumnya dibuat di pekarangan rumah atau taman... Untuk apa ditaruh di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710190203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710190203,
					"content": "He? Ada benda aneh yang ditaruh di atas bebatuan buatan ini, seperti menandakan sesuatu... Benar-benar membuat orang penasaran...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710190204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710190204,
					"content": "Yah, pokoknya kita sedang mengembara... nanti kalau kita di Liyue, coba kita perhatikan gunung yang bentuknya mirip dengan bebatuan buatan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710190205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710190205,
