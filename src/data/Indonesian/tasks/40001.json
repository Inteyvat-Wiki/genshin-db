				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400010201,
					"content": "Akhirnya tiba juga di <color=#00E1FFFF>Liyue</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010202,
					"content": "Permisi, anak muda, jika aku boleh bertanya. Berapa harga dari benda yang terbang di dekatmu itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010203,
						400010205
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 400010203,
					"content": "Paimon bukan untuk dijual!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400010204
					]
				},
				{
					"id": 400010204,
					"content": "Paimon bukan untuk dijual!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010209,
					"content": "Hahahaha, sebenarnya keuanganku sedang sulit sekarang ini. Jadi berapa pun juga, mungkin aku juga tidak sanggup membelinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010210
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 400010210,
					"content": "Lagi pula aku hanyalah pedagang kecil, aku tidak berkecimpung dalam harta karun yang langka atau eksotis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010211
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 400010211,
					"content": "...semakin kamu bicara, rasanya kamu terdengar semakin mencurigakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010212,
					"content": "Oh, sepertinya suasana hatimu sedang tidak baik ya? Ini, mungkin permen ini bisa membuatmu merasa lebih baik?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010213
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 400010213,
					"content": "#{NICKNAME}, sepertinya orang ini bisa dipercaya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010214,
					"content": "Jadi, aku berasumsi bahwa kalian datang ke Liyue, pasti ingin melihat Lantern Rite kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010215
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 400010215,
					"content": "Lentera Mingxiao tahun ini seharusnya adalah suatu hal yang paling ditunggu. Plaustrite yang akan membuat lenteranya terbang ke angkasa adalah yang terbesar dalam dua puluh tahun terakhir ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010216
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 400010216,
					"content": "Besar sekali sampai-sampai kamu beranggapan bahwa apa mungkin kota yang mengambang di angkasa itu benar-benar ada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010217
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 400010217,
					"content": "Mungkin saja itu juga karena ditopang oleh Plaustrite yang besar sekali seperti itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010218
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 400010218,
					"content": "Kedengarannya hebat sekali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010219,
					"content": "Hahahaha, semoga kita bertemu lagi. Selamat datang di Liyue - aku tidak bicara tentang seluruh <color=#00E1FFFF>Pelabuhan Liyue</color>, tapi setidaknya aku akan selalu menyambutmu di tokoku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bolai"
				},
				{
					"id": 400010205,
					"content": "Kamu tidak akan bisa membelinya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400010206
					]
				},
				{
					"id": 400010206,
					"content": "Ini terdengar aneh sekali deh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010207,
					"content": "Tapi Paimon penasaran, berapa harga yang bisa kamu pikirkan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010208,
					"content": "Ugh, lupakan saja. Anggap saja maksudmu Paimon lebih berharga daripada barang yang bisa dibeli oleh Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010209
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4000103,
			"completionStepIds": [
				4000103
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4000103",
							"2"
						],
						"stepId": 4000103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jiangzhou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400010301,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010302,
					"content": "Kalau batunya tidak diikat, bisa-bisa batunya bakal melayang ke sana kemari ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010303,
					"content": "Itu adalah Plaustrite yang digunakan untuk membuat Lentera Mingxiao. Seluruh Xiao Market dibangun mengelilinginya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010304
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 400010304,
					"content": "Ah, siapa kamu...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010305,
					"content": "Aku Jiangzhou. Belakangan ini aku selalu mengamati kemajuan konstruksi dari Lentera Mingxiao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010306
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 400010306,
					"content": "Kamu terlihat seperti pendatang baru — apa ini kali pertamamu merayakan Lantern Rite?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010307
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 400010307,
					"content": "Benar... bagaimana kamu bisa tahu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010308,
					"content": "Karena aku ingat persis kalau di Festival Lantern Rite tahun lalu tidak ada seseorang yang datang dengan maskotnya yang melayang-layang seperti ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010309
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 400010309,
					"content": "Biar kuperkenalkan dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010310
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 400010310,
					"content": "Jadi Lentera Mingxiao adalah...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400010311
					]
				},
				{
					"id": 400010311,
					"content": "Kamu akan melihat banyak orang menerbangkan lentera sepanjang festival berlangsung, lentera itu dinamakan Lentera Xiao. Tapi ada juga lentera yang besar, dibuat bersama-sama oleh semua orang yang ada di Pelabuhan Liyue, nama lentera itu adalah Lentera Mingxiao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010312
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 400010312,
					"content": "Hampir semua pebisnis di Liyue memiliki stan di Xiao Market yang ada tiap tahun - walaupun stan tersebut sangat populer, mereka justru tidak mencari keuntungan di momen festival ini. Pasar itu hadir dengan tujuan untuk mengumpulkan dana dan bahan yang dibutuhkan untuk pembuatan Lentera Mingxiao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010313
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 400010313,
					"content": "Jika kalian mau, kalian juga bisa ikut membantu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010314
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 400010314,
					"content": "Eh, terus kita bakal dapat apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010315,
					"content": "Lentera Mingxiao akan menghargai hasil kerja kerasmu. Pada bulan purnama pertama pada tahun baru, saat kita mengucapkan selamat tinggal kepada yang lama dan selamat datang kepada yang baru, maka harapanmu akan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010316
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 400010316,
					"content": "Itu bagus, tapi apa tidak ada yang lebih... praktis lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010317,
					"content": "*huff* Haruskah kamu terus terang begitu? Ya, kita perlu menjaga kaki kita tetap tertanam kuat di tanah yang kokoh, tetapi bukankah kita juga harus memandang ke atas menatap bintang-bintang? Dalam hidup ini, kamu tidak boleh kehilangan mimpimu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010318
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 400010318,
					"content": "Tapi intinya, siapa pun yang membantu Lentera Mingxiao pasti akan mendapatkan sesuatu dari <color=#00E1FFFF>Xiao Market</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010319
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 400010319,
					"content": "Jadi kalau bicara terus terang intinya... ada banyak makanan yang bisa didapatkan di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010320,
					"content": "#{NICKNAME}, ayo kita ikutan! Kita harus tanya orang-orang di sekitar <color=#00E1FFFF>Xiao Market</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4000106,
			"completionStepIds": [
				4000106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4000106",
							"2"
						],
						"stepId": 4000106,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Madame Ping"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400010601,
					"content": "Lentera Mingxiao tahun ini didedikasikan untuk Skybracer, orang yang suka pamer seperti dia pasti senang menerimanya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010602,
						400010611
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 400010602,
					"content": "Mengenai Skybracer...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400010603
					]
				},
				{
					"id": 400010603,
					"content": "Lentera Mingxiao yang sedang dibuat tahun ini benar-benar akan menyerupai Skybracer ketika sudah selesai dibuat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010604
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 400010604,
					"content": "Aku harap mereka akan membuat tanduknya cukup besar, karena itu adalah kebanggaannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010605
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 400010605,
					"content": "Dikatakan bahwa tanduk tersebut terbentuk dari esensi kekuatan Rex Lapis, yang membuatnya menjadi bahan paling keras di seluruh Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010606
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 400010606,
					"content": "Lalu pertempuran hebat itu terjadi... serangan hebat yang membuat gunung di ambang kehancuran. Agar tidak berdampak pada orang-orang di kaki gunung, dia meminta rekannya untuk memotong tanduknya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010607
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 400010607,
					"content": "Dia menggunakan tanduknya yang berdarah untuk menahan gunung agar tidak hancur. Dan dia terus bertarung sampai kehabisan darah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010608
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 400010608,
					"content": "Berkat dirinya, Mt. Tianheng masih berdiri kokoh sampai hari ini, dan darah yang mengalir pada pertempuran tersebut menjadi Bishui River.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010609
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 400010609,
					"content": "Hah... Entah apa kamu percaya atau tidak pada cerita ini, aku cukup senang kamu bersedia mendengarkan ceritaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010610
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 400010610,
					"content": "Lantern Rite ada karena orang akhirnya memilih untuk hadir bersama sebagai teman daripada hidup dalam kesendirian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 400010611,
					"content": "Sampai jumpa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400010612
					]
				},
				{
					"id": 400010612,
					"content": "Sampai jumpa. Semoga api kebajikan tetap menyala dan tidak pernah padam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Madame Ping"
				}
			]
