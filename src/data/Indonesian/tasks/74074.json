			"dialogs": [
				{
					"id": 740740101,
					"content": "Bukan, daripada memikirkan itu, bukannya lebih baik memperhatikan seseorang yang terbaring di depan matamu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740102
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740740102,
					"content": "Eh?! Wuah! Sebenarnya ada apa sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740740103,
					"content": "Maaf, Nona. Aku sudah memprioritaskan mencari tablet batunya tadi. Sekarang biarkan aku memindai ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740104
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740740104,
					"content": "Sungguh maaf sekali, Nona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740105
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740740105,
					"content": "Apa?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740740106,
					"content": "Meskipun dia masih hidup, tapi aura kehidupannya sudah mengalir dari tubuhnya melalui lubang. Aku tahu teknik ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740107
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740740107,
					"content": "Adududuh, Paimon enggak berani lihat ah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740740108,
					"content": "Ayo kita cari orang buat bantu! Masa kita diamin begitu saja?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740740109,
					"content": "Kalian membawa orang-orang yang hilang kesadaran ini ke Pelabuhan Lumidouce.\\nOrang-orang di Pelabuhan Lumidouce segera berangkat dan membawanya untuk disembuhkan.\\nSetelah suasananya mereda, kamu pun kembali ke tempat semula dengan semuanya.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740740110
					]
				},
				{
					"id": 740740110,
					"content": "Oke, coba kita lihat tablet batunya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740740111,
					"content": "\"Di sinilah letak kuadran harapan, kuil harapan, ruang harapan ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740112
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740740112,
					"content": "\"Selalu bertentangan\" ... \"Terlahir dalam sekejap, menemanimu dalam istirahat abadi, tak pernah terpisahkan\" ... \"Buah yang ternoda dosa\" ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740113
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740740113,
					"content": "Teka-teki lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740114
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740740114,
					"content": "Ngapain ngelakuin hal yang bikin ngeri kayak gini di sini ... Memangnya ada hubungannya sama teka-teki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740740115,
					"content": "Karena penduduk Fontaine adalah \"orang berdosa\", merekalah kehidupan yang \"ternoda oleh akibat dosa\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740116
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740740116,
					"content": "Jadi jawabannya adalah \"kehidupan\". Sudah kuduga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740117
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740740117,
					"content": "Kamu yakin jawabannya ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740118
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740740118,
					"content": "Aku sudah sangat hafal dengan sistem simbol bahasa Asosiasi Narzissenkreuz. Tidak mengherankan sih, ya inilah jawabannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740119
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740740119,
					"content": "Okelah, ayo kita berpacu dengan waktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Caterpillar"
				}
			]
		},
