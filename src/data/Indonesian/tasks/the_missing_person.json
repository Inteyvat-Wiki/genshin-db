				"objectNames": [
					"Sango"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190361601,
					"content": "Masih belum jalan? Berubah pikiran ya? Baguslah. Ingat omonganku baik-baik, urusan dengan si Heizou itu tidak ada untungnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361602
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361602,
					"content": "Aku jadi penasaran, kalian sebenarnya ada masalah apa sih?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361603
					]
				},
				{
					"id": 190361603,
					"content": "Gini deh. Intinya aku tidak akan keberatan sama sekali kalau dia menghilang untuk selamanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361604
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361604,
					"content": "(Mengangguk sambil tersenyum sopan.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361605
					]
				},
				{
					"id": 190361605,
					"content": "EH, jangan ngelihat aku kayak gitu. Wajar kan kalau aku tidak suka dengan seseorang, semua orang bebas mau tidak suka sama siapa juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361606
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361606,
					"content": "Sudahlah, lebih baik kamu segera pergi. Sebelum si Shikanoin itu bikin gara-gara lain lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361607
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361607,
					"content": "Terus kalau misalnya kalian menemukan tanda-tanda akhir hayatnya ... langsung kasih tahu aku. Itu baru namanya kabar gembira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				}
			]
		},
		{
			"id": 1903617,
