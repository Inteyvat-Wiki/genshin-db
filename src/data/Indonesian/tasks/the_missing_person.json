					"Shibata"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190361701,
					"content": "Ah, Anda ... Anda Kapten Swordfish II! Saya Shibata, saya yang bertugas menjaga tempat ini. Boleh tahu ada perlu apa Kapten kemari?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361702
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 190361702,
					"content": "Aku mau cari tahu tentang seseorang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361703
					]
				},
				{
					"id": 190361703,
					"content": "Kamu menjelaskan misi mencari Heizou ke Shibata.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						190361704
					]
				},
				{
					"id": 190361704,
					"content": "Oh, jadi si kakak detektif itu namanya Shikanoin Heizou? Iya, saya tahu dia. Dulu dia sering jalan-jalan di sekitar sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361705
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 190361705,
					"content": "Yang Mulia minta saya mengawasi dia, takutnya dia mau bikin masalah di sini. Tapi lama-kelamaan saya sadar tindak-tanduknya lebih mirip orang yang sedang liburan di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361706
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 190361706,
					"content": "Belakangan ini ada yang lihat dia di sebelah timur Kuil Sangonomiya. Silakan langsung menuju ke sana kalau Kapten ingin periksa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shibata"
				}
			]
		},
