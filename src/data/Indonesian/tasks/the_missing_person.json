			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ryuuji",
					"Sango"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190361401,
					"content": "Kalau Pengembara itu juga sibuk, aku harus gimana ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361402
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361402,
					"content": "Ya urusanmu lah. Kamu sendiri yang mau ikut-ikutan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361403
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361403,
					"content": "Tapi kamu beruntung. Penolongmu telah datang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361404
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361404,
					"content": "Eh? Pengembara! Terima kasih sudah datang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361405
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361405,
					"content": "Tenang, aku tidak sibuk kok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361406
					]
				},
				{
					"id": 190361406,
					"content": "Kayak kamu pernah sibuk saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361407
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361407,
					"content": "Ketua!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361408
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361408,
					"content": "Kalau dibandingkan dengan Pengembara, Ketua jauh lebih nganggur loh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361409
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361409,
					"content": "Enak saja, aku orang sibuk. Sibuk berdiri di sini ... sepanjang hari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361410
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361410,
					"content": "Biarpun misi ini ketua tidak mau terima, tapi alasan yang barusan itu payah banget loh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361411
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361411,
					"content": "Misi yang kalian tidak mau terima?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361412
					]
				},
				{
					"id": 190361412,
					"content": "Betul, itu alasanku memanggil dirimu. Biar kujelaskan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361413
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361413,
					"content": "Ada anggota penting Tenryou Commission yang hilang. Tidak ada yang tahu dia ke mana dan sedang apa sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361414
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361414,
					"content": "Tenryou Commission minta kami diam-diam lacak keberadaan orang ini. Karena satu dan lain hal, mereka akan repot kalau harus melakukan pencarian orang hilang terang-terangan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361415
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361415,
					"content": "Orang yang hilang itu namanya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361416
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361416,
					"content": "Kujou Sara. Yup, yang hilang itu sang Jenderal besar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361417
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361417,
					"content": "Duh, tolong lah. Kalau sang Jenderal betulan hilang, Tenryou Commission pasti sudah jungkir balikkan Inazuma buat cari dia. Terus masa sih misi sepenting itu cuma minta tolong sama kita doang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361418
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361418,
					"content": "Pengembara, abaikan saja ucapan Ketua Sango barusan. Yang hilang itu orang bernama Shikanoin Heizou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361419
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361419,
					"content": "Dia detektif khusus Kantor Polisi. Pangkatnya baru Doushin, tapi dia hebat dan bakatnya diakui oleh Kantor Polisi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361420
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361420,
					"content": "Heh, jadi mereka pikir orang itu lebih jago dari aku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361421
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361421,
					"content": "Ketua, kalau tidak mau bantu ya tidak apa, tapi tolong jangan bikin urusannya jadi lebih susah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361422
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361422,
					"content": "Maaf Pengembara, misinya memang aku terima ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361423
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361423,
					"content": "Tapi kamu lihat sendiri, kan. Ketua Sango ... sama sekali tidak mau terlibat dalam misi ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361424,
						190361425
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361424,
					"content": "Karena upahnya minim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361426
					]
				},
				{
					"id": 190361426,
					"content": "Bukan! Salah besar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361427
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361427,
					"content": "Alasannya adalah, karena aku tidak mau ada urusan apa-apa dengan bocah sial itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361428
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361428,
					"content": "Kalau ada kabar yang lebih membahagiakan dari \"Shikanoin menghilang\", maka itu adalah \"Shikanoin sudah menghilang selama 100 tahun\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361429
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361429,
					"content": "EHEM! Intinya, hubungan Ketua Sango dan Detektif Heizou kurang ... bersahabat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361430
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361430,
					"content": "Aku paham ... mereka saingan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361431
					]
				},
				{
					"id": 190361431,
					"content": "Eh ... sebenarnya lebih parah dari itu sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361432
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361432,
					"content": "Ketua Sango bilang kalau Detektif Heizou itu batu sandungan yang mengahalanginya menuju \"Kuil Kebenaran\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361433
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361433,
					"content": "Batu sandungan sial yang bisa mengonggong dan tidak pernah tutup mulut!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361434
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361434,
					"content": "*huff* Meski sifat Detektif Heizou memang agak, eh ... nyentrik? Dia orangnya baik. Sungguh, aku belajar banyak dari dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361435
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361435,
					"content": "Jadi aku tidak bisa diam saja, meskipun Ketua Sango tidak mengizinkan aku turun. Setidaknya, misi ini bisa aku percayakan pada orang yang punya kemampuan dan bisa dipercaya ... seperti kamu, Pengembara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361436,
						190361437
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361436,
					"content": "Paham, aku cuma untuk diperbantukan saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361438
					]
				},
				{
					"id": 190361438,
					"content": "Hah? Bukan, bukan begitu! Aku ... Aku akan bayar kamu sesuai jumlah yang dijanjikan oleh Tenryou Commission, bahkan aku kasih ekstra juga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361439
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361439,
					"content": "Jadi kumohon terimalah misi ini, Pengembara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361440
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361440,
					"content": "Kalau Detektif Heizou benar-benar dalam masalah, aku yakin dia akan lebih aman kalau ada kamu di sisinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361441,
						190361445
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361441,
					"content": "Kamu akrab dengannya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361442
					]
				},
				{
					"id": 190361442,
					"content": "Hubungan kami sebenarnya sangat akrab. Ketua Sango saja yang selalu suruh aku jaga jarak dan pura-pura tidak kenal sama dia kalau sedang di tempat umum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361443
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361443,
					"content": "Jadi kalau ditanya, aku cuma akan jawab bahwa aku pernah ketemu Tuan Shikanoin satu-dua kali. Kalau insiden hari ini tidak terjadi, aku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361444
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361444,
					"content": "Ehem. Sudahlah, tidak usah dibahas. Jadi bagaimana, mau bantu cari dia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361449
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361449,
					"content": "Baiklah, aku langsung ke sana.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361450
					]
				},
				{
					"id": 190361450,
					"content": "Yah, itu saja info yang kami punya. Ini, tolong bawa surat misi dari Kantor Polisi. Kalau Detektif Heizou sudah ketemu, langsung ke sana dan lapor sama mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361445,
					"content": "Boleh. Tapi aku perlu lebih banyak info.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361446
					]
				},
				{
					"id": 190361446,
					"content": "Bagus! Kami sudah tahu bahwa sebelum Detektif Heizou hilang, dia menunjukkan ketertarikan dengan Pulau Watatsumi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361447
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361447,
					"content": "Waktu perang berlangsung, dia pernah dapat misi ke Pulau Watatsumi. Setelah perang usai, dia sering berkunjung ke sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361448
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361448,
					"content": "Aku dengar hubunganmu dengan Sangonomiya sangat baik. Mungkin kamu bisa mulai dari sana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361449
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361437,
					"content": "Begitu ya, intinya kamu jadi calo kasus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361438
					]
				},
				{
					"id": 190361425,
					"content": "Karena petunjuknya sedikit?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361426
					]
				}
			]
		},
		{
			"id": 1903615,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1903606",
							"2"
						],
						"stepId": 1903606,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190361501,
					"content": "Pengembara, jangan ditunda lagi. Duh, semoga Detektif Heizou baik-baik saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361502
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361502,
					"content": "Tolong ceritakan lebih banyak mengenai Shikanoin Heizou.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361503
					]
				},
				{
					"id": 190361503,
					"content": "Detektif Heizou? Dia orang yang penuh semangat! Dia cerewet, aktif, energik, dan kelihatannya tidak pernah berdiam diri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361504
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361504,
					"content": "Ketua Sango sering membandingkan dia dengan lalat. Mungkin karena ... Detektif Heizou bisa langsung tahu apel mana yang busuk di dalam keranjang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361505
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361505,
					"content": "Kalau begitu, berarti Detektif Heizou bukan sekadar lalat biasa, dia pasti lalat edisi super!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361506
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361506,
					"content": "Bahkan kalau hidung, mata dan telinganya ditutup, dia tetap bisa tahu apel mana yang sudah busuk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361507
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361507,
					"content": "Ajaib, dia seperti punya indra keenam. Atau mungkin intuisinya saja yang bagus? Atau jangan-jangan dia ditolong oleh para dewa? Yah, semacam itulah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361508,
						190361510
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361508,
					"content": "Aku sudah paham, tolong jangan pakai perumpamaan lalat lagi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361509
					]
				},
				{
					"id": 190361509,
					"content": "Yah, Ketua Sango memang sering bilang aku jadi terkesan bodoh kalau buka mulut. Mungkin dia benar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361510,
					"content": "Pakai lalat untuk jadi perumpamaan itu jijik juga, tapi boleh lah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361511
					]
				},
				{
					"id": 190361511,
					"content": "Ehem ... kita ngobrol lagi lain kali ya. Ketua Sango sudah lihat ke sini terus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				}
			]
		},
		{
			"id": 1903616,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
