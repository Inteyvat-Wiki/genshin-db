			"dialogs": [
				{
					"id": 110040301,
					"content": "♪Cryo Regisvine, Cryo Regisvine, enak untuk dimasak~ Cryo Regisvine~♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040302
