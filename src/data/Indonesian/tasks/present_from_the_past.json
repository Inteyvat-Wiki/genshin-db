					"content": "Cryo Regisvine~♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040303,
						110040305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110040303,
					"content": "Jangan ikut-ikutan!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110040304
					]
				},
				{
					"id": 110040304,
					"content": "Kenapa kamu begitu serius? Hal apa lagi yang lebih membahagiakan dari menemukan bahan makanan langka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040307
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110040307,
					"content": "Tunggu, sepertinya ada sesuatu di sini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040308
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110040308,
					"content": "Ini pasti boar liar yang dikatakan pemburu itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110040309,
					"content": "Paimon belum pernah melihat pola ini sebelumnya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110040310,
					"content": "Aku sepertinya pernah melihat pola ini! Hmm... Ya, pola ini ada di \"Historia Naturalis Liyue\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040311
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110040311,
					"content": "Aku tidak mungkin salah! Boar ini adalah spesies yang sudah punah 300 tahun yang lalu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040312
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110040312,
					"content": "Hah? Bagaimana bisa dia masih hidup sampai sekarang?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040313,
						110040315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110040313,
					"content": "Mungkin karena dibekukan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110040314
					]
				},
				{
					"id": 110040314,
					"content": "Masuk akal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110040317,
					"content": "Di dalam buku mengatakan bahwa daging spesies boar ini sangat lezat, karena itulah banyak yang memburunya hingga punah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040318
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110040318,
					"content": "Cryo Regisvine dan boar langka, keduanya adalah harta karun yang berharga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040319
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110040319,
					"content": "Kali ini kemenangan sudah di tangan kita.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110040320
					]
				},
				{
					"id": 110040320,
					"content": "Ya, ayo kita kembali ke Springvale!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110040315,
					"content": "Karena berumur panjang?",
