			"dialogs": [
				{
					"id": 760580101,
					"content": "Aku belum pernah melihat Weasel Thief seputih ini sebelumnya, jangan-jangan dia sedang sakit ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580102
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 760580102,
					"content": "Lihat saja dia melompat-lompat dengan lincah, tadi juga mencoba merebut makanan dari Kak Jurva, sama sekali tidak terlihat seperti sakit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580103
					],
					"speakerTitle": "Mikko"
				},
				{
					"id": 760580103,
					"content": "Mungkin ini jenis yang langka? Linnea mungkin saja tahu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580104
					],
					"speakerTitle": "Jurva"
				},
				{
					"id": 760580104,
					"content": "Wah! Ini dia pencuri Mora yang menguras habis tabunganku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760580105,
					"content": "Weasel Thief itu mencoba kabur, tapi dengan sigap dihentikan oleh ketiga anak itu. Setelah meronta-ronta sebentar, dia menyerah dan menggunakan kesempatan itu untuk menceritakan pengalamannya sebelumnya ....",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760580106
					]
				},
				{
					"id": 760580106,
					"content": "Ternyata dia memang pelaku berulang, kita harus memberinya pelajaran, kalau berbuat salah harus dihukum, benar kan begitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580107
					],
					"speakerTitle": "Mikko"
				},
				{
					"id": 760580107,
					"content": "Tapi ... dia hanya seekor hewan kecil, dia tidak mengerti hal-hal seperti itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580108,
						760580109
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 760580108,
					"content": "Yang penting kembalikan Mora milik Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760580110
					]
				},
				{
					"id": 760580110,
					"content": "Lebih baik kita cari dulu uangnya Paimon. Dia juga tidak bisa belanja, harusnya masih utuh di sana semua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580111
					],
					"speakerTitle": "Jurva"
				},
				{
					"id": 760580111,
					"content": "Baguslah! Hehe, tabunganku jadi bertambah lagi nih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760580112,
					"content": "Kalau bisa dipelihara, saat Helka kembali nanti, aku bisa menunjukkan Weasel Thief yang langka ini kepadanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580113
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 760580113,
					"content": "Eh? Tapi dia tidak bisa bekerja ... Mencuri barang bukan pekerjaan, kalau tidak bekerja, untuk apa diberi makan dan minum gratis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580114
					],
					"speakerTitle": "Mikko"
				},
				{
					"id": 760580114,
					"content": "Baiklah, apa yang harus kita lakukan padanya ... Nanti kita diskusikan dengan Katya saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jurva"
				},
				{
					"id": 760580109,
					"content": "Hewan kecil juga perlu tahu betapa kejamnya dunia ini ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760580110
					]
				}
			]
		}
	]
