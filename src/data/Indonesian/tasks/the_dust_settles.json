			"dialogs": [
				{
					"id": 761150301,
					"content": "Sesuai perkiraan. Cuma sosok payah yang tidak bisa dan tidak berniat berhenti mengulangi kesalahan. Aku kecewa sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150302
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150302,
					"content": "Padahal kelakuannya sudah baik selama bertahun-tahun ... tapi akhirnya, tetap saja ya. Apa ini berarti orang jahat selamanya tetap jahat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150303,
						761150304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761150303,
					"content": "Lebih susah berbuat baik, memang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761150305
					]
				},
				{
					"id": 761150305,
					"content": "Tapi dia punya pilihan. Bahkan barusan pun, dia bisa saja memilih untuk mengakui kesalahan. Tapi tidak, dia malah memilih kekerasan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150306
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150306,
					"content": "Setiap langkah adalah kesalahan, dan dia pun semakin mendekati akhir riwayatnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150307
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150307,
					"content": "#Sudahlah. Pekerjaan selesai. {NICKNAME}, kamu bawa bukti buronan berhasil dibekuk ke Leszek, sesuai prosedur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150308
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150308,
					"content": "#Senang banget deh kalau ada Bos sama {NICKNAME}! Kalian atur, aku libur~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150309
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761150309,
					"content": "Hehe, dan sekarang liburannya sudah selesai. Waktunya kamu urus pekerjaan berikutnya, Jahoda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150310
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150310,
					"content": "Ehhh?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761150304,
					"content": "Dia cuma salah memilih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761150305
					]
				}
			]
		}
	]
