			},
			"dialogs": [
				{
					"id": 761150101,
					"content": "Eh? Nefer dan Jahoda! Kok kalian di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761150102,
					"content": "Ya kerja lah, apa lagi! Akhirnya dapat petunjuk soal buronan yang minim banget infonya itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150103
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761150103,
					"content": "Jahoda menceritakan tentang Hark si \"Rahang Retak\" dan informasi yang didapatkan Curatorium of Secrets sebelumnya ....",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						761150104
					]
				},
				{
					"id": 761150104,
					"content": "Mulai dari kesimpulannya dulu. Si petapa yang asli, Derwent, sudah wafat. Dan sekarang, orang yang menempati gubuknya adalah buronan kita, Hark si \"Rahang Retak\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150105
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150105,
					"content": "Sisa-sisa halaman buku harian yang ditemukan oleh Jahoda bisa dijadikan bukti. Derwent tahu siapa dia, tapi tetap menerimanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150106
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150106,
					"content": "Tak heran, Hark kembali ke cara lamanya, lalu mencuri identitas Derwent setelah menghabisinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150107
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150107,
					"content": "Waktu aku menyelidiki ke sana, dia sama sekali enggak mau mukanya kelihatan. Tapi orang yang di dalam gubuk itu sudah pasti bukan Tuan Derwent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150108
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761150108,
					"content": "Kalau dia \"jadi\" petapa, dia ngapain yang aneh-aneh pun enggak bakal dicurigain. Topeng itu bukan buat bertapa, tapi buat nutupin bekas luka di dagunya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150109
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761150109,
					"content": "Dan pedagang yang hilang itu juga, kemungkinan besar sudah kehilangan nyawanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150110
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150110,
					"content": "Jahat ... jahat banget! Kok bisa ya ada orang kayak gitu? Air susu dibalas air tuba ... Paimon paling benci!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761150111,
					"content": "Tapi aku rasa Hark bukan pelaku pencurian Cincin Peripatetik. Motifnya tidak ada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150112
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150112,
					"content": "Dia sudah berperilaku baik selama sepuluh tahun. Apa nilai barang yang dicurinya sebanding dengan jerih payahnya selama itu? Menurutku tidak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150113
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150113,
					"content": "Jadi, mari kita sedikit berspekulasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150114
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150114,
					"content": "Kita tahu bahwa setelah kejadian itu, dia kembali ke bangkai kapal Atlas dan menyerang para pemburu harta di sana. Ketika terjebak dalam posisi terjepit, orang cenderung kembali ke titik awal tempat segalanya bermula.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150115
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150115,
					"content": "Waktu dia masih juru mudi Atlas, ketenaran dan kekayaan adalah miliknya. Tapi, bagaimana nasibnya setelah bergabung ke Cincin Peripatetik?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150116
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150116,
					"content": "Bahkan setelah sepuluh tahun menjalani hidup sebagai warga teladan, orang langsung mencurigainya begitu ada barang hilang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150117
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150117,
					"content": "Dan yang lebih membuatnya geram, Juhani, yang sama-sama mantan bajak laut meski kurang terkenal, sama sekali tidak dicurigai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150118
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150118,
					"content": "Dia pun langsung menuduh Juhani. Tapi tidak ada yang percaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150119
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150119,
					"content": "Dibutakan oleh kekecewaan dan kemarahan, dia melakukan kesalahan pertamanya. Kejadian inilah titik balik hidupnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150120
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150120,
					"content": "Apa pun yang terjadi di gubuk si petapa, mungkin situasinya juga sama ... karena percikan kecil pun bisa meledak menjadi konfrontasi yang berakibat fatal bagi orang seperti itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150121
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150121,
					"content": "#{NICKNAME}，kita enggak boleh biarin orang bahaya kayak gitu bebas berkeliaran!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150122,
						761150123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761150122,
					"content": "Biar aku yang beresin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761150124
					]
				},
				{
					"id": 761150124,
					"content": "#Karena {NICKNAME} sudah bersedia, Jahoda bisa istirahat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150125
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150125,
					"content": "Aku juga sudah bantu banyak lho! Boleh dong kasih libur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150126
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761150126,
					"content": "Kita akan tahu apa asumsi tadi benar atau tidak setelah bertemu dengan orangnya langsung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150123,
					"content": "Ada hadiah atau tidak, tetap harus diberesin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761150124
					]
				}
			]
		},
