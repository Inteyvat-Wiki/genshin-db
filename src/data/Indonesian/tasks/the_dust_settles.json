			"dialogs": [
				{
					"id": 761150201,
					"content": "Aku tidak pernah cari masalah dengan kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150202
					],
					"speakerTitle": "Derwent"
				},
				{
					"id": 761150202,
					"content": "Kelihatannya kamu sudah tahu kenapa kami ke sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150203
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150203,
					"content": "Semua itu sudah berlalu. Aku cuma ingin hidup tenang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150204
					],
					"speakerTitle": "Derwent"
				},
				{
					"id": 761150204,
					"content": "Dengan mencuri identitas orang lain? Awalnya Juhani, tapi tidak berhasil. Sekarang Derwent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150205
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150205,
					"content": "Tapi sandiwara yang buruk tidak akan bertahan lama. Mulai sekarang, tidak akan ada lagi korban jatuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150206
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150206,
					"content": "Juhani? Aku, mencuri identitas-NYA?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150207
					],
					"speakerTitle": "Derwent"
				},
				{
					"id": 761150207,
					"content": "Apanya yang dicuri kalau memang sejak awal itu bukan miliknya! Semua yang dia punya, dia dapatkan karena penampilan dan gaya bicaranya yang lebih \"sopan\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150208
					],
					"speakerTitle": "Derwent"
				},
				{
					"id": 761150208,
					"content": "Kami tadinya sama! Semua yang dia ambil, itu sebenarnya milikku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150209
					],
					"speakerTitle": "Derwent"
				},
				{
					"id": 761150209,
					"content": "Lalu Tuan Derwent dan si pedagang yang hilang? Apa salah mereka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150210
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761150210,
					"content": "Mereka ... mereka menanyakan hal yang seharusnya tidak ditanyakan! Sama seperti kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150211
					],
					"speakerTitle": "Derwent"
				},
				{
					"id": 761150211,
					"content": "Matilah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Derwent"
				}
			]
		},
