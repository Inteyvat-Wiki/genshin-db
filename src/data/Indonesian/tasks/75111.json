					"Chanca"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751111501,
					"content": "Hah? Iya, ini memang pesananku sih. Tidak disangka bakal ketemu masalah begini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751111502
					],
					"speakerTitle": "Chanca"
				},
				{
					"id": 751111502,
					"content": "Ya sudahlah. Aku tulis surat lagi saja. Toh tidak buru-buru juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751111503
					],
					"speakerTitle": "Chanca"
				},
				{
					"id": 751111503,
					"content": "Makasih ya sudah bawakan suratnya balik. Ayo sini minum dulu, kamu keringatan banget.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chanca"
				}
			]
		},
		{
			"id": 7511116,
