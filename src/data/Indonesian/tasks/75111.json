			"dialogs": [
				{
					"id": 751110501,
					"content": "Kalau tidak salah ini suratnya Nona Tirda deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110502
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 751110502,
					"content": "Dia mau kirim balik ke sukunya? Tapi sekarang sudah rusak begini ... terpaksa kita kembalikan dulu deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110503
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 751110503,
					"content": "Aku masih urus paket kilat di toko, jadi ... apa kamu bisa bantu aku antarkan ini ke Nona Tirda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110504
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 751110504,
					"content": "Dia biasa suka nyanyi di Golden Dusk. Jadi kamu bisa menemuinya di sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Michica"
				}
			]
