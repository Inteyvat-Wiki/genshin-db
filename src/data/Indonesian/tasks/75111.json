				},
				{
					"id": 751111702,
					"content": "Aku akan tulis surat yang baru lagi. Terus aku akan akan minta orang antarkan ke suku Bunga Bersayap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751111703
					],
					"speakerTitle": "Tirda"
				},
				{
					"id": 751111703,
					"content": "Kuharap yang ini bisa terkirim tanpa ada masalah.",
