				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751110401,
					"content": "Muhuru's Gemporium ... Imix? Agh, ini bukannya tagihan yang dia kirim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110402
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 751110402,
					"content": "Kalau barang ini hilang waktu transit, dia pasti bakal kena ocehan Nona Cheven.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110403
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 751110403,
					"content": "Aku masih urus paket kilat di toko, jadi ... apa kamu bisa bantu aku antarkan ini ke Imix?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110404
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 751110404,
					"content": "Muhuru's Gemporium ada di daerahnya Putra-Putri Gema — gampang ditemukan kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Michica"
				}
			]
		},
