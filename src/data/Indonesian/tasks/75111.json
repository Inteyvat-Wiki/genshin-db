				"points": []
			},
			"dialogs": [
				{
					"id": 751111601,
					"content": "Iya, ini memang punyaku — ini paket yang kukirim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751111602
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 751111602,
					"content": "Aduh, untung saja. Kupikir aku salah tulis alamat pas ngirim ... Kalau memang benar begitu, habis sudah riwayatku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751111603
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 751111603,
					"content": "Makasih banyak ya! Nih, ambillah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751111604
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 751111604,
					"content": "Terus, um ... Bisa tidak kamu jangan bilang-bilang ke Nona Cheven soal ini? Kumohon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Imix"
				}
			]
		},
