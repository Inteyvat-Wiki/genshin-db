				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Michica"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751110301,
					"content": "Ini ... sepertinya ini tulisan Chanca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110302
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 751110302,
					"content": "Kalau aku boleh tebak, ini pasti pesanan lain lagi. Paketnya sudah rusak — tidak akan bisa dikirim deh. Suratnya harus kita kembalikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110303
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 751110303,
					"content": "Aku masih urus paket kilat di toko, jadi ... apa kamu bisa bantu aku antarkan ini ke Chanca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110304
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 751110304,
					"content": "Harusnya dia ada di Weary Inn dekat Stadion Api Keramat. Pasti kelihatan kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Michica"
				}
			]
		},
		{
			"id": 7511104,
			"completionStepIds": [
				7511104
			],
