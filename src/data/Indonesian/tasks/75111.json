			"dialogs": [
				{
					"id": 751110101,
					"content": "Aku barusan pungut ini ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751110102
					]
				},
				{
					"id": 751110102,
					"content": "Hah? Jangan-jangan ada orang bodoh yang memangnya kehilangan benda ini? Coba sini aku mau lihat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Michica"
				}
			]
		},
		{
			"id": 7511102,
			"completionStepIds": [
