			},
			"dialogs": [
				{
					"id": 751111401,
					"content": "Oh iya, ini memang punyaku. Orang dari Putra-Putri Gema mau beli cat, tapi tidak bilang mau warna apa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751111402
					],
					"speakerTitle": "Acat"
				},
				{
					"id": 751111402,
					"content": "Makanya aku kirim dia paket dengan beberapa sampel cat — jadi dia bisa milih sebelum datang lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751111403
					],
					"speakerTitle": "Acat"
				},
				{
					"id": 751111403,
					"content": "Aku bakal segera kirimkan lagi — mending kirim lagi deh daripada nanti dia datang lagi ke sini terus mintanya yang aneh-aneh tidak masuk akal ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751111404
					],
					"speakerTitle": "Acat"
				},
				{
					"id": 751111404,
					"content": "Oh iya. Nih buatmu. Makasih ya sudah bantu aku bawakan paket ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Acat"
				}
			]
		},
