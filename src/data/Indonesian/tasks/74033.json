					"Caterpillar",
					"Mitul"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							4596.75,
							-46.38,
							4590.743
						],
						"pointId": 4614
					},
					{
						"sceneId": 3,
						"position": [
							4595.909,
							-46.38,
							4592.177
						],
						"pointId": 5582
					},
					{
						"sceneId": 3,
						"position": [
							4595.084,
							-46.38,
							4591.131
						],
						"pointId": 5768
					}
				]
			},
			"dialogs": [
				{
					"id": 740330401,
					"content": "Mitul, kamu tidak apa-apa? Tidak terperangkap terlalu lama, kan?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330402
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740330402,
					"content": "Penyelamatku! Akhirnya kalian datang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330403
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330403,
					"content": "Koblenz mana? Dia tidak sama kalian?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330404
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330404,
					"content": "Dia yang minta bantuanku, dia bilang kamu terperangkap di sini. Tapi belum selesai bicara, ada penjaga yang datang, jadi dia kabur duluan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330405
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740330405,
					"content": "Memang tidak bisa diandalkan! Dia pasti takut karena merasa bersalah, makanya dia langsung kabur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330406
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330406,
					"content": "Coba deh, berbisnis itu bukannya harus berani dulu baru bisa untung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330407
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330407,
					"content": "Bukan cuma lambat, dia itu plin-plan loh ... Coba bayangin deh ... jangankan Pure Water, Fonta saja sudah tersedia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330408
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330408,
					"content": "Kalau Fonta saja sudah ada, gimana kita bisa bertahan hidup?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330409
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330409,
					"content": "Oh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740330410,
					"content": "Eh? Kalian suka Fonta juga?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330411,
						740330413
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330411,
					"content": "Memangnya kamu tidak suka?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740330412
					]
				},
				{
					"id": 740330412,
					"content": "Tentu suka! Harus diakui sih ... memang lawan yang sulit ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330415
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330415,
					"content": "Ya sudah, aku mau buat perhitungan sama si Koblenz itu dulu. Dia sudah bayar imbalanmu belum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330416
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330416,
					"content": "Belum sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330417
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740330417,
					"content": "Kadang aku benar-benar ingin cemplungin dia ke gentong besar biar dia bisa introspeksi deh. Ya sudah, silakan terima Kupon Khusus ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330418
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330418,
					"content": "#Silakan diterima, {NICKNAME} dan Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330419
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740330419,
					"content": "Eh? Semuanya kasih ke kami?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740330420,
					"content": "Tentu saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330421
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740330421,
					"content": "Ya sudah. Kami terima ya berarti. Nanti kalau sempat kita juga mau ke Rag and Bone Shop, lihat-lihat ada apa yang bisa dibeli di sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740330422,
					"content": "Oh iya, aku juga mau minta maaf karena sudah merepotkan kalian. Sebagai tanda terima kasih, mau coba minuman kami? Aku punya minuman kesehatan yang segar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330423
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330423,
					"content": "Minuman kesehatan ... yang segar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740330424,
					"content": "Iya! Lebih sehat dari Pure Water malah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330425,
						740330428
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330425,
					"content": "Coba satu deh!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740330426
					]
				},
				{
					"id": 740330426,
					"content": "(Hei, bukannya Caterpillar suruh jangan diterima?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740330427,
					"content": "#Ets! Tadi {NICKNAME} salah ngomong! Sebelum ke sini, kami sudah ... umm ... minum banyak banget!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740330431,
					"content": "Sayang banget sih! Paimon rasa pasti enak-enak semua! Lain kali deh ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330432
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740330432,
					"content": "Sayang sekali ya ... Ya sudah, lain kali kalau ada kesempatan, datang saja cari aku, pasti akan aku traktir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330433
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330433,
					"content": "Aku pergi dulu. Masih harus cari Koblenz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330434
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330434,
					"content": "Aku juga masih ada urusan lain, jadi harus pergi dulu. Masalah Kupon Khusus, kalian tidak perlu terlalu khawatir. <color=#00E1FFFF>Kalau ada petunjuk, aku akan tulis di atas papan tulis</color>. Nanti kita baru berkumpul lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330435
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740330435,
					"content": "Dadah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740330428,
					"content": "Aku Fonta saja deh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740330429
					]
				},
				{
					"id": 740330429,
					"content": "Ada sih ... tapi ... kamu meremehkan minuman kesehatanku ini ya? Aku kasih tahu ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330430
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330430,
					"content": "#Bukan itu maksud {NICKNAME}! Kami cuma ... sudah minum banyak sebelum datang ke sini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740330413,
					"content": "Biasa saja sih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740330414
					]
				},
				{
					"id": 740330414,
					"content": "Oh? Pelanggan yang satu ini punya cita rasa yang berbeda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330415
					],
					"speakerTitle": "Mitul"
				}
			]
		}
	]
}