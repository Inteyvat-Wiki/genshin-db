			"dialogs": [
				{
					"id": 740330101,
					"content": "Setelah Tambang Geode disegel, tidak ada lagi yang datang ke sini. Perangkat mesin di sini juga tidak cocok dipakai di luar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330102
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740330102,
					"content": "Dan kali ini benar-benar terjadi. Ada orang yang memutar Katup Konveyor-nya dan memerangkap rekannya di dalam ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330103
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740330103,
					"content": "Ya sudah, kita sekarang coba putar Katup Konveyor untuk buka jalan ke <color=#00E1FFFF>Gudang Penyimpanan No. 1</color>. Kalau nanti mereka mau traktir minum sesuatu, lebih baik ditolak secara halus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330104
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740330104,
					"content": "Memangnya siapa yang mau traktir minum? Terus kenapa ditolak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740330105,
					"content": "Nanti kamu juga tahu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Caterpillar"
				}
			]
		},
		{
