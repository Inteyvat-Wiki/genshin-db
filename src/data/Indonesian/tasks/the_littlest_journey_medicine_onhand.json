			},
			"dialogs": [
				{
					"id": 210280201,
					"content": "Selamat datang, kamu mau mencari obat herbal ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280202
					],
					"speakerTitle": "Herbalis Gui"
				},
				{
					"id": 210280202,
					"content": "Eh, Little Meng? Apa yang bisa kubantu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280203
					],
					"speakerTitle": "Herbalis Gui"
				},
				{
					"id": 210280203,
					"content": "Oh iya aku ingat. Kamu datang untuk menanyakan obat-obat itu ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280204
					],
					"speakerTitle": "Herbalis Gui"
				},
				{
					"id": 210280204,
					"content": "Jangan khawatir, obat-obatnya sudah mau siap. Nanti akan langsung kukirimkan beberapa ke ayahmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280205
					],
					"speakerTitle": "Herbalis Gui"
				},
				{
					"id": 210280205,
					"content": "Tapi obat yang dipesan ayahmu banyak sekali, sampai menghabiskan stok tanaman obat. Jadi beberapa obat-obatannya butuh waktu lebih lama untuk dipersiapkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280206
					],
					"speakerTitle": "Herbalis Gui"
				},
				{
					"id": 210280206,
					"content": "Biar kulihat ... Hmmm, yang stoknya sudah mau habis adalah Mint, jadi kita sudah tidak bisa memproduksi obat untuk sengatan panas lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280207
					],
					"speakerTitle": "Herbalis Gui"
				},
				{
					"id": 210280207,
					"content": "Bagaimanapun, kami kan tetap harus mengerjakan pesanan milik orang lain juga, bukan hanya untuk ayahmu saja ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280208
					],
					"speakerTitle": "Herbalis Gui"
				},
				{
					"id": 210280208,
					"content": "Kalau begitu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280209,
						210280211
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210280209,
					"content": "Sepertinya ini saatku unjuk gigi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280210
					]
				},
				{
					"id": 210280210,
					"content": "#Hehe, terima kasih ya, kak {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280213
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210280213,
					"content": "Hanya kamu yang bisa kumintai tolong untuk obat-obatannya! Aku harus tinggal di sini dan memeriksa obat lainnya, seperti perintah Papa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280214
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210280214,
					"content": "Haha, kamu memang anak baik ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280215
					],
					"speakerTitle": "Herbalis Gui"
				},
				{
					"id": 210280215,
					"content": "Baiklah, ayo ikut aku. Akan kujelaskan pesanan obat yang ini padamu secara rinci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280216
					],
					"speakerTitle": "Herbalis Gui"
				},
				{
					"id": 210280216,
					"content": "Wuah, ada ... banyak ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280217
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210280217,
					"content": "Kamu lihat dulu yang ini, nanti akan kubawakan yang lainnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280218
					],
					"speakerTitle": "Herbalis Gui"
				},
				{
					"id": 210280218,
					"content": "Eh? Masih ada lagi?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210280211,
					"content": "Yang penting jangan lupa bayarannya ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280212
					]
				},
				{
					"id": 210280212,
					"content": "#Hehe, tidak masalah! Terima kasih, kak {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280213
					],
					"speakerTitle": "Little Meng"
				}
			]
