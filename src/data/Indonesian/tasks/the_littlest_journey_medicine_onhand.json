					"Little Meng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210280101,
					"content": "Eh kakak, kebetulan sekali kamu datang! Ada hal yang ingin kutanyakan padamu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280102,
						210280103
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210280102,
					"content": "Ada masalah apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280105
					]
				},
				{
					"id": 210280105,
					"content": "Papa bilang kalau perjalanan ke Sumeru bakal panjang. Aku perlu siapkan beberapa obat-obatan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280106
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210280106,
					"content": "Obat untuk sakit kepala, mencegah diare, mencegah panas yang terik, lalu obat untuk pening sehabis mabuk dan pencernaan, dan masiiih banyak lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280107
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210280107,
					"content": "Kenapa perlu siapkan obat untuk pening sehabis mabuk ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210280108,
					"content": "Obat itu kadang diperlukan saat melakukan negosiasi bisnis.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280109
					]
				},
				{
					"id": 210280109,
					"content": "Eh? Apa hubungannya berbisnis sama obat untuk pening sehabis mabuk? Memangnya semakin banyak minum, bisnis bisa semakin lancar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210280110,
					"content": "Ya pokoknya, papa menyuruhku pergi ke Bubu Pharmacy dan menanyakan apa obat-obatan itu sudah siap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280111
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210280111,
					"content": "Bisakah kakak temani aku? Aku ada beberapa hal yang perlu kakak bantu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280112,
						210280113
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210280112,
					"content": "Ayo pergi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280115
					]
				},
				{
					"id": 210280115,
					"content": "Ayo kita pergi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210280113,
					"content": "Memangnya ada hal apa yang perlu kubantu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280114
					]
				},
				{
					"id": 210280114,
					"content": "Kita bicarakan saja nanti waktu sudah sampai sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280115
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210280103,
					"content": "Bagaimana persiapan untuk jalan-jalannya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280104
					]
				},
				{
					"id": 210280104,
					"content": "Sebagian besar sih disiapkan sama papa dan paman ... Tapi papa juga ada berikan aku beberapa tugas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280105
					],
					"speakerTitle": "Little Meng"
				}
			]
		},
