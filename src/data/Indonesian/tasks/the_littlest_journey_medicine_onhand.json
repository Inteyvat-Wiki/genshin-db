						210280402
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210280402,
					"content": "Baiklah, harusnya sudah cukup untuk membuat obatnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280403
					],
					"speakerTitle": "Herbalis Gui"
				},
				{
					"id": 210280403,
					"content": "Untuk obat sengatan panasnya, akan kumasukkan ke kumpulan obat berikutnya dan kukirimkan padamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280404
					],
					"speakerTitle": "Herbalis Gui"
				},
				{
					"id": 210280404,
					"content": "Terima kasih ya, Kakak Gui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280405
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210280405,
					"content": "Dan ini untukmu, Pengembara. Terima kasih bantuannya ya! Yuk, kita pulang sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280406
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210280406,
					"content": "Hehe, Papa pasti senang mendengar kabar bagus ini, aku yakin ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280407
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210280407,
					"content": "Little Meng, tunggu sebentar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280408
					],
					"speakerTitle": "Herbalis Gui"
				},
				{
					"id": 210280408,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280409
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210280409,
					"content": "Bukannya kamu harus memeriksa obat-obatannya? Pesanan yang di belakang belum kamu cek loh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280410
					],
					"speakerTitle": "Herbalis Gui"
				},
				{
					"id": 210280410,
					"content": "Eh ... EH? Tapi tadi aku sudah memeriksa selama itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280411
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210280411,
					"content": "Masih ada banyak, Little Meng. Ayo kita lanjut memeriksa lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280412
					],
					"speakerTitle": "Herbalis Gui"
				},
				{
					"id": 210280412,
					"content": "Wah ... Oke ....",
