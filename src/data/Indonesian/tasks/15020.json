			"dialogs": [
				{
					"id": 150200501,
					"content": "Sudah siap? Ini gampang sih buat seorang Chasca. Tapi tolong tetap berhati-hati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200502,
						150200504
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150200502,
					"content": "Aku sih yakin aman.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150200503
					]
				},
				{
					"id": 150200503,
					"content": "Baik. Kepakkan sayapmu dan terbanglah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inkanak"
				},
				{
