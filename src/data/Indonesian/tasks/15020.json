			"dialogs": [
				{
					"id": 150200801,
					"content": "#Hm? Chasca? {NICKNAME}? Wah, kejutan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200802
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150200802,
					"content": "Tetua Allpa? Hah? Jadi ... mana nih Qucusaurus galaknya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150200803,
					"content": "Sudah terbang. Dia mundur begitu tahu ada bala bantuan datang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200804
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150200804,
					"content": "Jadi kenapa dia nyerang orang? Mengincar makanan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200805
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200805,
					"content": "Bukan. Barang yang dibawa bukan makanan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200806
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150200806,
					"content": "Ah! Syukurlah! Sayap Phlogiston-nya masih utuh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200807
					],
					"speakerTitle": "Pedagang Muda"
				},
				{
					"id": 150200807,
					"content": "Sayap Phlogiston?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200808
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200808,
					"content": "Ah, terima kasih atas bantuannya. Sayap Phlogiston ini barang kami yang paling berharga. Kalau sampai rusak, waduh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200809
					],
					"speakerTitle": "Isidore"
				},
				{
					"id": 150200809,
					"content": "Tunggu, kalian pedagang yang mau kerja sama dengan kami, kan? Warmi sudah cerita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200810
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150200810,
					"content": "Ya, betul! Jadi ... Anda Tetua Allpa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200811
					],
					"speakerTitle": "Isidore"
				},
				{
					"id": 150200811,
					"content": "Betul. Kalian pasti lelah sekali sehabis perjalanan jauh, dan pasti agak syok juga setelah mengalami yang barusan. Urusan bisnis kita bicarakan setelah kalian istirahat saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200812
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150200812,
					"content": "Tapi Tetua Allpa, soal serangan Qucusaurus-nya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200813
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200813,
					"content": "Ah, tamu-tamu kita tidak terluka, barangnya juga masih utuh ... yah, sementara kita anggap saja Qucusaurus-nya lagi mau datang bulan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200814
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150200814,
					"content": "Ini daerah kekuasaan mereka, jadi kejadian barusan memang tidak terhindarkan, masih dalam batas wajar. Aku kira kita tidak usah selidiki lebih lanjut lah ... Yang lebih penting, gimana persiapan untuk ujian ulang? Arenanya sudah siap?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200815,
						150200816
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150200815,
					"content": "Sesuai jadwal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150200817
					]
				},
				{
					"id": 150200817,
					"content": "Hah? Ujian ... terbang? Wah, kebetulan sekali! Ini bisa jadi ajang yang paling sesuai untuk uji coba Sayap Phlogiston! Itu barang bagus loh, Anda pasti terheran-heran sama kemampuannya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200818
					],
					"speakerTitle": "Isidore"
				},
				{
					"id": 150200818,
					"content": "Oh ya? Wah, aku jadi penasaran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200819
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150200819,
					"content": "Hehe, lupakan dulu lah soal serangan Qucusaurus ... kita bahas bisnis dulu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200820
					],
					"speakerTitle": "Isidore"
				},
				{
					"id": 150200820,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200821
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200821,
					"content": "Gitu doang? Kok rasanya lebih lancar dari perkiraan ya? Ya sudahlah, kita juga jalan saja ... Eh? Chasca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200822
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150200822,
					"content": "Lihatin apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150200823
					]
				},
				{
					"id": 150200823,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200824
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200824,
					"content": "Bulu berdarah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200825
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200825,
					"content": "Insiden tersebut terlupakan, dan suku Bunga Bersayap kembali damai tenteram.\\nBeberapa hari berlalu tanpa peristiwa, hanya persiapan ujian terbang ulang saja yang terus digenjot pengerjaannya ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 150200816,
					"content": "Ujiannya bisa segera diadakan lagi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150200817
					]
				}
			]
		},
