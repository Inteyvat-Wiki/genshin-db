			"dialogs": [
				{
					"id": 150201001,
					"content": "Ah, kalian mau bantu? Makasih banyak! Ini kalau sendirian mustahil kelar soalnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150201002
					],
					"speakerTitle": "Penyelidik Bernyali Besar"
				},
				{
					"id": 150201002,
					"content": "Di sini mampetnya harus dibuka pakai bom khusus, tapi bawa bahan peledak sambil manjat lereng curam begitu sih mengundang bencana namanya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150201003
					],
					"speakerTitle": "Penyelidik Bernyali Besar"
				},
				{
					"id": 150201003,
					"content": "Kalau bomnya jatuh, atau orangnya terpeleset, dalam sekejap jadi serpihan tuh. Rencananya sih aku mau pakai bawa bom nya ke sisi seberang, lalu diterbangkan pakai balon udara ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150201004
					],
					"speakerTitle": "Penyelidik Bernyali Besar"
				},
				{
					"id": 150201004,
					"content": "Tinggal perlu orang untuk <color=#00E1FFFF>menyerang balonnya pada saat yang tepat, supaya si bom jatuh tepat di atas pancoran</color> ... beres deh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150201005
					],
					"speakerTitle": "Penyelidik Bernyali Besar"
				},
				{
					"id": 150201005,
					"content": "Gimana? Sederhana kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150201006
					],
					"speakerTitle": "Penyelidik Bernyali Besar"
				},
				{
					"id": 150201006,
					"content": "Kayaknya aku bisa deh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150201007
					]
				},
				{
					"id": 150201007,
					"content": "Balon yang di atas sana punya kamu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150201008
					]
				},
				{
					"id": 150201008,
					"content": "Hah? Oh, yang itu ya ... bukan, dan entah punya siapa. Tidak tahu juga kenapa bisa dinaikin sampai setinggi itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150201009
					],
					"speakerTitle": "Penyelidik Bernyali Besar"
				},
				{
					"id": 150201009,
					"content": "Aku juga ingin terbang ke sana lihat mereka pakai setelan kayak gimana ... ah, sudahlah. Mending fokus siapin arenanya saja, lebih penting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150201010
					],
					"speakerTitle": "Penyelidik Bernyali Besar"
				},
				{
					"id": 150201010,
					"content": "Aku mau jalan sekarang. Kasih tahu kalau kalian sudah siap ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Penyelidik Bernyali Besar"
				}
