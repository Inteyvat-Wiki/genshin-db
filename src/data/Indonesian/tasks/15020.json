			"dialogs": [
				{
					"id": 150200101,
					"content": "Oh, halo Chasca. Tetua Allpa yang suruh kamu ke sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200102
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150200102,
					"content": "Iya, dia kebetulan lagi ada urusan lain. Gimana keadaan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200103
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200103,
					"content": "Hmm, yah, setelah inspeksi ulang, kami menemukan banyak hambatan di arena. Sepertinya akibat gangguan Ley Line yang terjadi karena serangan berulang Abyss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200104
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150200104,
					"content": "Teorinya sih, kita cuma perlu bersihkan hambatan tersebut supaya Phlogiston gas bisa mengisi arena. Tapi praktiknya sulit, karena satu dan lain hal ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200105
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150200105,
					"content": "Kalian mau lihat sendiri? Silakan kalau mau tanya kondisi ke yang jaga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inkanak"
				}
			]
		},
