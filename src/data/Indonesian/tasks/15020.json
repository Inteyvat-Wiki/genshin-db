					"content": "Aneh ... kenapa banyak sekali Phlogiston padat di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200702
					],
					"speakerTitle": "Penyelidik yang Curiga"
				},
				{
					"id": 150200702,
					"content": "Masa dari Putra-Putri Gema sih? Apa mungkin terbawa ke sini gara-gara gangguan Ley Line? <color=#00E1FFFF>Dan ada tanda aneh juga di tebing ....</color>",
					"roleType": "TALK_ROLE_NPC",
