			"dialogs": [
				{
					"id": 150200401,
					"content": "Wah, kalian cepat sekali beres-beresnya ... luar biasa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200402
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150200402,
					"content": "Nah, sekarang tinggal tunggu sampai Phlogiston gasnya keisi lagi. Setelah itu, ujian ulang bisa digelar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200403
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150200403,
					"content": "Hmm ... Inkanak, aku mau coba terbang dulu boleh? Sekalian pastiin ini sudah aman semua. Bisa tolong diatur?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200404
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200404,
					"content": "Hah? Tapi ... arenanya baru siap, mungkin masih ada bahaya lain yang kita belum tahu loh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200405
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150200405,
					"content": "Justru karena itu harus dicoba dulu. Anggap saja inspeksi susulan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200406
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200406,
					"content": "Hmm, iya sih ... kalau yang terbangnya sejago kamu, ya bahayanya juga bisa diminimalisir lah ... misalkan ada yang kelewat pun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200407
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150200407,
					"content": "Kondisi di sini sepertinya kurang stabil, tapi kita hanya bisa tahu pasti dengan cara langsung percobaan terbang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200408
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200408,
					"content": "Baiklah, aku siapkan dulu ya. Bilang kalau sudah siap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inkanak"
				}
			]
		},
