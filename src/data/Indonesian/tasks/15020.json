			"dialogs": [
				{
					"id": 150200601,
					"content": "Keren banget! Paimon sampai lupa ngedip!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150200602,
					"content": "Jadi, masih ada masalah di arenanya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150200603
					]
				},
				{
					"id": 150200603,
					"content": "Hmm ... tidak ada yang parah. Berapa hari lagi juga kita bisa mulai ujiannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200604
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200604,
					"content": "Tolong, tolong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200605
					],
					"speakerTitle": "Isidore"
				},
				{
					"id": 150200605,
					"content": "Kamu orang Bunga Bersayap, betul kan? Tolong bantu kami!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200606
					],
					"speakerTitle": "Isidore"
				},
				{
					"id": 150200606,
					"content": "Tarik napas dulu. Ada situasi apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200607
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200607,
					"content": "Ka-Kami diserang ... sama Qucusaurus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200608
					],
					"speakerTitle": "Isidore"
				},
				{
					"id": 150200608,
					"content": "Rekan-rekan masih tidak bisa bergerak dari posisi, barang-barang juga di sana semua ... tolong, tolong bantu kami!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200609
					],
					"speakerTitle": "Isidore"
				},
				{
					"id": 150200609,
					"content": "Hah? Memangnya Qucusaurus seganas itu ya? Bisa tiba-tiba nyerang orang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200610
					],
					"speakerTitle": "Paimon"
				},
				{
