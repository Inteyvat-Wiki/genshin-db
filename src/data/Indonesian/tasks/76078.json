			"dialogs": [
				{
					"id": 760780401,
					"content": "Berdasarkan pengalamanku sebelumnya, retakan ini seharusnya hilang dengan sendirinya setelah monster di sekitar sini dikalahkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780402
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760780402,
					"content": "Tapi kenapa aura Perburuan Liar masih tidak bisa hilang dari sini ... ini benar-benar aneh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780403
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760780403,
					"content": "Apa mungkin ada tempat yang tidak aku perhatikan, tapi juga sudah tercemar oleh Perburuan Liar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illuga"
				}
			]
