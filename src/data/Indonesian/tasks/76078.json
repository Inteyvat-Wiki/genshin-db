			},
			"dialogs": [
				{
					"id": 760780501,
					"content": "Di sini juga ada Lentera Sumpah, sepertinya ini peninggalan dari seorang seniorku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780502
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760780502,
					"content": "Masih ada sisa kotoran Perburuan Liar di lentera itu ... sepertinya sudah bisa ditebak apa yang sebenarnya terjadi di sini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780503
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760780503,
					"content": "Sejak hari aku mengangkat Lentera Sumpah, hidup kita telah terikat dengan nyala api di dalam lentera, sampai ... saat kita menyelesaikan misi yang telah ditakdirkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780504
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760780504,
					"content": "Hormat kepada Anda, pemberani yang telah berjuang hingga saat terakhir demi kedamaian dan ketentraman Nod-Krai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780505
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760780505,
					"content": "Kalau begitu, biar saya yang menjaga Lantern Anda. Jangan khawatir, akan kusimpankan mahkota para pahlawan untuk Anda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780506
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760780506,
					"content": "Aku akan membawanya kembali ke markas pusat, menyalakannya lagi, lalu memberikannya kepada orang yang pantas mewarisi tekad Anda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780507
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760780507,
					"content": "Illuga membersihkan lentera itu dengan hati-hati, lalu menyimpannya dengan penuh rasa hormat.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						760780508
					]
				},
				{
					"id": 760780508,
					"content": "Dengan begini, Perburuan Liar di sini sudah bersih, dan arwah seniorku juga sudah menemukan tempat peristirahatannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illuga"
				}
			]
		}
