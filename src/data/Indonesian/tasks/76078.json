					}
				]
			},
			"dialogs": [
				{
					"id": 760780201,
					"content": "Oh, lentera. Semua Lightkeeper pasti membawanya, karena fungsinya penting sekali untuk menghalau Perburuan Liar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780202
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760780202,
					"content": "Lenteranya tertinggal, dan ada sisa-sisa hawa Perburuan Liar. Tapi pemiliknya sudah tidak terlihat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780203
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760780203,
					"content": "Ah, membingungkan, tapi tidak sulit untuk menarik kesimpulan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780204
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760780204,
					"content": "Pengorbanan Lightkeeper kadang seperti bisikan lembut yang tidak terdengar gaungnya. Mendapati rekanku wafat dengan cara seperti ini ... sangat menyedihkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780205
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760780205,
					"content": "Almarhum rekanku yang tak bernama, izinkan aku mengangkat lentera yang engkau tinggalkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780206
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760780206,
					"content": "Badannya akan dibersihkan, dan terangnya akan kembali dinyalakan. Dia akan berlabuh kepada Lightkeeper lain yang telah disumpah untuk melindungi Nod-Krai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780207
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760780207,
					"content": "Flins membersihkan lentera itu lalu membawanya.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						760780208
					]
				},
				{
					"id": 760780208,
					"content": "Lentera ini adalah penyebab hawa Perburuan Liar masih tersisa di tempat ini. Aku akan amankan, sampai seseorang dari markas besar datang untuk mengambilnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780209
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760780209,
					"content": "Tunggu, ada sesuatu di bawah lenteranya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780210
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760780210,
					"content": "Ini pasti peninggalan dari almarhum rekanku pemilik lentera ini. Sebaiknya ikut diamankan bersama lenteranya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flins"
				}
			]
		},
