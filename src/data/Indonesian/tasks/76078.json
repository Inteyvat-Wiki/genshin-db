			"dialogs": [
				{
					"id": 760780101,
					"content": "Biasanya, kalau semua monster di Perburuan Liar sudah diberantas, hawa-hawanya juga ikut lenyap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780102
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760780102,
					"content": "Tapi yang ini tetap ada ... tidak wajar, namun bukan belum pernah terjadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780103
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760780103,
					"content": "Kita periksa daerah sini. Mungkin masih ada sisa-sisa pencemaran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flins"
				}
			]
		},
		{
			"id": 7607802,
