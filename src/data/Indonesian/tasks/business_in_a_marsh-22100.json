			"dialogs": [
				{
					"id": 221000101,
					"content": "Aduh, bagaimana ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000102
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000102,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221000103
					]
				},
				{
					"id": 221000103,
					"content": "*huff* Membuka penginapan di sini tidaklah mudah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000104
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000104,
					"content": "Dihua Marsh mempunyai banyak Silvergrass. Tempat di mana harta karun berada, monster juga akan semakin banyak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000105
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000105,
					"content": "Untungnya Millelith sudah menyingkirkan banyak monster di sekitar sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000106
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000106,
					"content": "Tapi entah kenapa, mereka tampaknya muncul lagi baru-baru ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000107
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000107,
					"content": "Meskipun mereka tidak berani datang ke penginapan, tetapi melihat mereka setiap hari, jangankan tamu, bahkan aku pun merasa sangat merusak mata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000108
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000108,
					"content": "Kalau kamu ada waktu, apa kamu bisa membantuku membasmi monster-monster di sekitar penginapan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000109,
						221000110
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000109,
					"content": "Baiklah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221000111
					]
				},
				{
					"id": 221000111,
					"content": "Hahaha. Kamu sungguh terus terang sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000114
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000114,
					"content": "Ngomong-ngomong, aku sebenarnya merasa tidak enak hati meminta bantuan tamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000115
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000115,
					"content": "Tenang saja, setelah selesai, aku akan memberikanmu imbalan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000116
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000116,
					"content": "Semoga beruntung, terima kasih ya~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000110,
					"content": "Hanya merusak mata, bukan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221000112
					]
				},
				{
					"id": 221000112,
					"content": "Terus terang saja, kehadiran mereka adalah masalah terbesar yang mereka sebabkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000113
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000113,
					"content": "Beberapa orang tertentu, seperti tuan muda yang sangat suka kebersihan itu, bila dia merasa terganggu, maka berarti seluruh Dihua Marsh juga terganggu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000114
					],
					"speakerTitle": "Huai'an"
				}
			]
		},
