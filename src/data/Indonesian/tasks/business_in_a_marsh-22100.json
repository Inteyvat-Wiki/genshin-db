				{
					"id": 221000201,
					"content": "Bagaimana? Apakah monster-monsternya sudah dibereskan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000202
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000202,
					"content": "Masih belum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221000203
					]
				},
				{
					"id": 221000203,
					"content": "Baiklah, tidak perlu terburu-buru, mereka cenderung menjaga jarak sehingga tidak menimbulkan ancaman besar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000204
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000204,
					"content": "Tapi bila ada monster yang masuk dan menganggu ketenangan tuan muda itu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000205
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000205,
					"content": "Mungkin saja semua orang di Dihua Marsh akan panik, dan takutnya penginapan ini tidak bisa dibuka selama beberapa hari...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				}
			]
		},
