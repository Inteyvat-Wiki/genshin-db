					"nextDialogs": [
						221000303
					]
				},
				{
					"id": 221000303,
					"content": "Bagus sekali. Terima kasih banyak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000304
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000304,
					"content": "Ini imbalannya, sesuai janjiku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000305
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000305,
					"content": "Akhirnya aku bisa tenang juga sekarang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000306
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000306,
					"content": "Siapa tuan muda itu? Hmm... lebih baik kamu tanya ke bos secara langsung.",
