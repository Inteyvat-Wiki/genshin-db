				"points": []
			},
			"dialogs": [
				{
					"id": 220500501,
					"content": "Ayo kita beristirahat di sini, diriku merasa lelah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500502
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500502,
					"content": "Tapi benar-benar sama seperti apa kata Hibiki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500503
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500503,
					"content": "Pulau yang berbeda benar-benar memiliki perbedaan yang besar. Dan ternyata sebuah kuil bisa dibangun di tempat setinggi itu. Manusia tidak takut ketinggian ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500504
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500504,
					"content": "Kuil Asase milikku tetap lebih bagus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500505
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500505,
					"content": "Tapi diriku tidak habis pikir, di mana Hibiki sebenarnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500506
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500506,
					"content": "Kamu masih mau mencarinya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500507
					]
				},
				{
					"id": 220500507,
					"content": "Diriku lelah. Kita bicarakan nanti saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500508
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500508,
					"content": "Masih ada \"nanti\"!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220500509,
					"content": "Tentu saja. Hibiki pernah bercerita tentang banyak tempat kepadaku. Cerita di pinggir laut, cerita di tempat dengan banyak pohon, lalu cerita tentang \"Nona Kitsune\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500510
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500510,
					"content": "Semua cerita ini masih kuingat dengan sangat jelas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500511
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500511,
					"content": "Tapi hal yang terpenting sekarang adalah pulang. Bagaimanapun, Kuil Asase harus tetap punya Kepala Pendeta-nya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500512
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500512,
					"content": "Pokoknya, kalian ikut diriku pulang dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
		},
