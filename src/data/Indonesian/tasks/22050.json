			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Neko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220500201,
					"content": "\"Kuil Agung Narukami\"... di sinikah tempatnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500202
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500202,
					"content": "Ada banyak sekali gerbang merahnya. Manusia suka gerbang berwarna merah ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500203
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500203,
					"content": "Ini namanya \"Gerbang Torii\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500204
					]
				},
				{
					"id": 220500204,
					"content": "Kan di Kuil Asase juga ada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220500205,
					"content": "Oh, diriku mengerti sekarang. Jadi, namanya \"gerbang torii\" ya. Berarti ini adalah tempat tinggal burung (tori), kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500206
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500206,
					"content": "Semakin banyak gerbang torii, semakin banyak burung juga dong? Burung memang identik dengan hal yang baik sih. Ternyata manusia pintar juga ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500207
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500207,
					"content": "Apa kamu lihat Hibiki ada di mana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500208
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500208,
					"content": "Sama sekali tidak ada jejak siapa pun...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500209
					]
				},
				{
					"id": 220500209,
					"content": "Kayaknya di sekitar sini enggak ada orang sama sekali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220500210,
					"content": "Kenapa kita enggak naik saja ke Kuil Agung Narukami dan tanya langsung sama miko di sana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220500211,
					"content": "\"Hibiki\" kan seorang miko juga... Barangkali mereka tahu sesuatu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 2205003,
			"completionStepIds": [
				2205003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2205003",
							"2"
						],
						"stepId": 2205003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Neko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220500301,
					"content": "Miaw, miaw, kuil ini besar sekali, dan ada banyak manusia juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500302
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500302,
					"content": "Wow! Kotak uang dan raknya juga mewah sekali, tidak heran banyak sekali orang yang datang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500303
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500303,
					"content": "Kalian harus belajar dari sini. Nantinya, Kuil Asase juga akan jadi seperti ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500304,
						220500305
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500304,
					"content": "Sepertinya ... bukan itu masalahnya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500306
					]
				},
				{
					"id": 220500306,
					"content": "Tapi, diriku tetap tidak menemukan Hibiki di mana-mana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500307
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500307,
					"content": "Pokoknya, coba kita tanya orang dulu tentang Hibiki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220500305,
					"content": "Tunggu, kenapa harus aku yang belajar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500306
					]
				}
			]
		},
		{
			"id": 2205004,
			"completionStepIds": [
				2205004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2205004",
							"2"
						],
						"stepId": 2205004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Inagi Hotomi",
					"Neko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220500401,
					"content": "Halo, pengembara yang datang dari jauh. Selamat datang di Kuil Agung Narukami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500402
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500402,
					"content": "Kalau ada masalah atau ingin membuat permohonan, kamu bisa mengambil slip keberuntungan di sini. Archon Electro memberkatimu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500403
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500403,
					"content": "Kami bukan datang untuk mengambil slip keberuntungan sih, tapi mau bertanya sesuatu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220500404,
					"content": "Bertanya padaku? Oh ... silakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500405
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500405,
					"content": "Oke, jadi begini situasinya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500406
					]
				},
				{
					"id": 220500406,
					"content": "Hibiki dari Kuil Asase? Jangan-jangan maksudmu Asase Hibiki ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500407
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500407,
					"content": "Benar! Hibiki adalah Asase Hibiki! Manusia! Apa kamu kenal Hibiki? Kamu tahu dia ada di mana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500408
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500408,
					"content": "Hmmm ... Eh!? Kucing ini kok bisa bicara? Apa aku salah dengar ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500409
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500409,
					"content": "Manusia suka sekali heboh karena hal kecil .... Memangnya aneh kalau diriku bisa bicara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500410
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500410,
					"content": "Apa kamu kenal Hibiki? Kamu tahu dia ada di mana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500411
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500411,
					"content": "Rasanya aneh sekali ditanya oleh seekor kucing ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500412
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500412,
					"content": "Tapi kalau kamu ingin tahu tentang Asase Hibiki, kalian datang ke tempat yang salah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500413
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500413,
					"content": "Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220500414,
					"content": "Salah ... tempat?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500415
					]
				},
				{
					"id": 220500415,
					"content": "Aku pernah melihat namanya di teks-teks kuno yang disimpan di dalam kuil. Dia adalah pewaris terakhir Kuil Asase ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500416
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500416,
					"content": "Sekitar empat atau lima ratus tahun lalu, dituliskan bahwa \"The Yougou Three\", yaitu Asase Hibiki, Kamuna Harunosuke, dan Mikoshi Nagamasa pergi ke Mt. Yougou untuk berguru pada Yougou Tengu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500417
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500417,
					"content": "Pada masa itu jugalah Asase menjalani pelatihan di kuil kami dan menjadi teman dengan Kitsune Saiguu. Tapi pada akhirnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500418
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500418,
					"content": "Mereka bertiga berpisah karena suatu \"bencana\" yang kurang tertulis jelas. Dikatakan juga kalau Kamuna Harunosuke pergi menyeberangi laut untuk pergi ke Liyue karena dia ingin mempelajari \"jalan sang Adeptus\" yang lebih kuat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500419
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500419,
					"content": "Mikoshi Nagamasa kembali ke Kota Inazuma untuk mengabdi pada Shogunate. Sedangkan Asase Hibiki ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500420,
						220500421
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500420,
					"content": "Dia kembali ke Pulau Seirai ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500422
					]
				},
				{
					"id": 220500422,
					"content": "Ya, itu benar. Tapi karena tidak banyak informasi sejarah tentang ini, jadi rinciannya juga tidak begitu jelas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500423
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500423,
					"content": "Tunggu dulu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500424
					]
				},
				{
					"id": 220500424,
					"content": "Hmm ... dia bilang empat sampai lima ratus tahun lalu. Itu berarti, Hibiki berasal dari zaman dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500425
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220500425,
					"content": "Jadi Neko adalah kucing yang sudah berumur 400 atau 500 tahun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500426
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220500426,
					"content": "Miaw? Diriku tidak yakin. Apa maksudnya \"berumur 400 atau 500 tahun\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500427
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500427,
					"content": "Diriku bukan manusia. Tidak banyak yang perlu diriku pedulikan. Diriku hanya tahu tentang terbitnya matahari, lalu bulan. Kalau suasana hati diriku buruk, obat paling mujur adalah tidur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500428
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500428,
					"content": "Paimon iri deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500429,
						220500431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220500429,
					"content": "Paimon, kamu kan sama saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500430
					]
				},
				{
					"id": 220500430,
					"content": "#Hei! Tidak sopan, Paimon kan mengkhawatirkanmu setiap hari, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500433
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220500433,
					"content": "Kalian membicarakan banyak hal yang diriku tidak mengerti. Jadi, Hibiki ada di mana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500434
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500434,
					"content": "Aku mengatakan ini dengan penuh hormat, tapi Asase Hibiki sudah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500435
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500435,
					"content": "Hibiki tidak ada di sini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500436
					]
				},
				{
					"id": 220500436,
					"content": "Ya, benar. Hibiki pasti sudah pergi ke tempat lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500437
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220500437,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500438
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500438,
					"content": "Sepertinya benar begitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500439
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500439,
					"content": "Apa boleh buat. Hibiki memang seperti anak kecil, berlari ke sana kemari sesuka hati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500440
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500440,
					"content": "Bagaimanapun juga, terima kasih ya Nona Miko!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500441
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220500441,
					"content": "Kalau begitu kami permisi dulu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500442
					]
				},
				{
					"id": 220500442,
					"content": "Hati-hati di jalan ya. Aku siap membantu kalian kalau kalian membutuhkanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500431,
					"content": "Memangnya kucing bisa hidup selama itu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500432
					]
				},
				{
					"id": 220500432,
					"content": "Harusnya sih tidak ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
