			"dialogs": [
				{
					"id": 220500701,
					"content": "Apa kamu masih ada urusan lain?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500702,
						220500705,
						220500710
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500702,
					"content": "Tentang Mikoshi ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500703
					]
				},
				{
					"id": 220500703,
					"content": "Legenda mengatakan bahwa Mikoshi Nagasama terus bekerja untuk Shogunate, dan menurut berita yang beredar, dia sangat adil dan jujur ... bahkan sampai menjadi terlalu keras kepala.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500704
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500704,
					"content": "Garis keturunannya terus mengalir sampai detik ini. Sebagian besar penduduk kota yang bermarga Mikoshi adalah keturunannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500705,
					"content": "Tentang Kamuna ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500706
					]
				},
				{
					"id": 220500706,
					"content": "Tidak ada banyak catatan tentang dia. Dia kembali ke Inazuma setelah merantau di Liyue untuk mempelajari ilmu Adeptus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500707
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500707,
					"content": "Kemudian, dia menciptakan \"Onmyoudou\" dan \"Shiki Taishou\"-nya sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500708
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500708,
					"content": "Menurut catatan, demi membawa kedamaian Inazuma, dia pernah menggunakan teknik ini untuk menyegel Ioroi — Bake-Danuki yang membuat masalah di mana-mana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500709
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500709,
					"content": "Tapi tak lama kemudian, kabar tentangnya pelan-pelan menghilang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500710,
					"content": "Sampai jumpa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500711
					]
				},
				{
					"id": 220500711,
					"content": "Jagalah diri dengan baik. Aku siap membantu kapan pun kamu butuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inagi Hotomi"
				}
			]
		}
