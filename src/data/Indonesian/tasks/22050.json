				"objectNames": [
					"Neko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220500601,
					"content": "Fuhh... Akhirnya kita sampai juga. Kalau terlalu lama ada di kuil itu, bisa-bisa buluku jadi keriting semua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500602
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500602,
					"content": "Terima kasih banyak atas pertolongan kalian ya. Kalian memang manusia yang bisa diandalkan, dan tidak banyak yang seperti kalian, miaw.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500603
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500603,
					"content": "Sekarang diriku akan melanjutkan untuk bersih-bersih kuil. Nanti kalau Hibiki sudah kembali, diriku akan memperkenalkannya pada kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500604
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500604,
					"content": "Miaw, miaw ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500605
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500605,
					"content": "Hibiki, kapan kamu akan kembali ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
		},
		{
