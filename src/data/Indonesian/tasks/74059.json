			"dialogs": [
				{
					"id": 740590201,
					"content": "#Kak {NICKNAME}, Paimon! Lama tidak bertemu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590202
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740590202,
					"content": "Apa kalian mau cari batu aneh yang waktu itu lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590203
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740590203,
					"content": "Uh, iya sih. Tapi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740590204,
					"content": "Kamu berikan prototipe jamnya ke Puca dan memberitahunya rencana Chesil untuk membuat jam dengan bijih aneh itu.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740590205
					]
				},
				{
					"id": 740590205,
					"content": "He-Hebat! Ternyata batunya bisa dibuat jadi barang seperti ini?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590206
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740590206,
					"content": "Eh? Cuma mekanisme yang di dalam saja yang pakai batu itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740590207,
					"content": "Ini pertama kalinya aku lihat jam yang bisa kedengaran detikannya bahkan di dalam air!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590208
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740590208,
					"content": "Oh, Chesil bilang mau dibuat dengan struktur tiram ... Eh, atau kerang ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740590209,
					"content": "Hehe, dengar suara jamnya bikin aku senang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590210
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740590210,
					"content": "Aku tidak pernah bayangkan kalau batu biasa seperti ini pun bisa berguna ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590211
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740590211,
					"content": "Dulu aku selalu pikir cuma permata langka yang bisa dijadikan karya hebat. Tidak sangka batu biasa seperti ini juga bisa dibuat jadi barang yang luar biasa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590212
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740590212,
					"content": "Semua benda punya nilai dan kegunaannya sendiri.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740590213
					]
				},
				{
					"id": 740590213,
					"content": "Mm-hmm, aku jadi merasa lebih percaya diri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590214
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740590214,
					"content": "Puca menaruh jamnya dengan hati-hati di tempat yang bagus.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740590215
					]
				},
				{
					"id": 740590215,
					"content": "Oke, jadi kamu cuma perlu siapin bijihnya dan jual ke Chesil saat dia perlu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740590216,
					"content": "Dengan begitu nanti kamu bahkan bisa buka pabrik permatamu sendiri! Seperti kakakmu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740590217,
					"content": "Puca sudah ngumpulin banyak sekali jenis batu yang berbeda, mungkin kamu bisa ketemu kegunaannya masing-masing!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740590218,
					"content": "Iya! Aku akan siapin! Terima kasih banyak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590219
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740590219,
					"content": "Kalau kamu perlu batu apa pun, cari aku, ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590220
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740590220,
					"content": "Hehe, enggak perlu terima kasih kok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
