			"dialogs": [
				{
					"id": 740590101,
					"content": "Ah, kalian berdua, yang jual permata itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590102
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590102,
					"content": "Iya! Terakhir pas ketemu kamu bilang mau buat jadi perhiasan cantik, kan? Gimana jadinya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740590103,
					"content": "Paimon enggak sabar lihat hasilnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740590104,
					"content": "Soal itu ... Kurasa kalian akan kecewa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590105
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590105,
					"content": "Hah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740590106,
					"content": "Memang benar aku bermaksud buat perhiasan bertatahkan permata, tapi bijihnya terlalu keras untuk dipoles tangan dengan akurat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590107
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590107,
					"content": "Dan bukan cuma itu saja. Siapa sangka setelah dipotong dan dipoles, kecerahan bijihnya malah hilang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590108
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590108,
					"content": "Singkatnya, mereka tidak cocok digunakan untuk barang kerajinan apa pun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590109
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590109,
					"content": "Oh ... Paimon enggak sangka bisa jadi seperti ini. Kami pikir batu ini bisa berguna ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740590110,
					"content": "Berguna ... ya setidaknya bukan sama sekali tidak berguna ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590126
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590126,
					"content": "Sambil berbicara, Chesil meletakkan jam mekanik di atas konter.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740590111
					]
				},
				{
					"id": 740590111,
					"content": "Coba lihat jam mekanik yang baru dibuat ini, terbuat dari bijih itu loh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590112
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590112,
					"content": "Sebenarnya aku sudah salahkan diriku sendiri karena penilaianku yang salah, jadi kupikir aku buang saja semua bijihnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590113
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590113,
					"content": "Tapi ada pengrajin jam yang kebetulan melihat beberapa bijih yang gagal kita proses. Karena daya tahan bijihnya tinggi sekali, mereka bawa beberapa untuk dijadikan komponen penggerak dalam jam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590114
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590114,
					"content": "Aku tidak pernah terpikir, karena kekerasan dan ketahanannya pada aus yang tinggi, bijih ini dianggap sebagai bahan yang jauh lebih unggul dari yang biasanya digunakan sebagai komponen penggerak dalam jam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590115
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590115,
					"content": "Tapi kalau mereka akan digunakan untuk buat jam, pasokannya juga harus lebih stabil ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590116,
						740590117
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590116,
					"content": "Tidak usah khawatir soal itu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740590118
					]
				},
				{
					"id": 740590118,
					"content": "Kamu beritahu Chesil soal Puca dan tambang bijih.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740590119
					]
				},
				{
					"id": 740590119,
					"content": "Ternyata begitu, kebetulan yang luar biasa sekali! Prototipe jam ini dibuat dengan struktur tahan air berbentuk cangkang kerang. Dengan kata lain, prototipe ini memang dimaksudkan untuk para Melusine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590120
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590120,
					"content": "Kalau begitu, apa kamu bisa bawa prototipe ini ke Nona Puca dan jelaskan situasi ini padanya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590121
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590121,
					"content": "Lagi pula aku tidak punya pengalaman berbisnis dengan Melusine ... Kalau Nona Puca bisa sediakan pasokan yang stabil, kita mungkin bisa bangun jalur produksi yang baru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590122
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590122,
					"content": "Nantinya aku juga akan kunjungi dia sendiri! Sepertinya bagus juga kalau desain jamnya mencerminkan gaya Melusine ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590123
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590123,
					"content": "Hehe, kalau berhasil, Puca bisa untung juga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740590124,
					"content": "Ooh, ini bisa jadi kesempatan untuk Puca buka pabrik permatanya sendiri! Yuk kita ngobrol sama dia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740590125,
					"content": "Kuserahkan pada kalian ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590117,
					"content": "Kalau kamu hubungi Puca langsung ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740590118
					]
				}
			]
		},
