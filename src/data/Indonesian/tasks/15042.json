			"dialogs": [
				{
					"id": 150421701,
					"content": "Mantap, Mualani!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150421702,
					"content": "Fiuh, yang tadi itu MANTAP! Gimana kawan? Menyala enggak barusan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421703
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421703,
					"content": "Menyala banget kakak! Keren, kamu memang pantas jadi enam pahlawan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421704
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150421704,
					"content": "Waktu kamu kerja tadi, Paimon ceritain semua sepak terjang kamu! Luar biasa, aku kagum banget sama semua yang kamu capai dan lakukan. Serius, aku sampai semangat banget! Menyala lah pokoknya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421705
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150421705,
					"content": "Haha, makasih loh! Aku senang banget dipuji sama kamu. Ini kondisi sudah menyala gila, rasanya bisa langsung bikin pesta pemandian air panas di sini, saat ini juga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421706
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421706,
					"content": "Ah, para karyawan Teluk Gelombang datang tuh! Pastinya mereka juga senang akhirnya bisa istirahat setelah kerja capek kayak gitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421707
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421707,
					"content": "Salah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421708
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421708,
					"content": "Salah ...? Salah di mananya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421709
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421709,
					"content": "Mualani! Nona Mualani, pahlawan kami! Boleh minta tanda tangan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421710
					],
					"speakerTitle": "Tuksina"
				},
				{
					"id": 150421710,
					"content": "Aku juga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421711
					],
					"speakerTitle": "Gaun"
				},
				{
					"id": 150421711,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421712
					],
					"speakerTitle": "Iktomisaurus Chick"
				},
				{
					"id": 150421712,
					"content": "Kedok terbongkar deh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421713
					]
				},
				{
					"id": 150421713,
					"content": "Cepat, kita foto dulu sebelum diserbu orang-orang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421714
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421714,
					"content": "Senyum yang lebar, gayanya pede saja! Bayangin indahnya laut dan warna keberuntungan masing-masing ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421715
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421715,
					"content": "Tiga, dua, satu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421716
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421716,
					"content": "Koholasaurus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150421717,
					"content": "....",
