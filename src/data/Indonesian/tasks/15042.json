					"content": "Sekarang bagaimana rasanya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421402,
						150421404,
						150421406
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421402,
					"content": "Santai banget sih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421403
					]
				},
				{
					"id": 150421403,
					"content": "Heh. Kamu memang berani, tapi menurutku performamu sudah mantap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421408
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421408,
					"content": "Mungkin aku bisa memberikan beberapa saran kepada staf supaya mereka bisa meningkatkannya di kemudian hari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421409
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421409,
					"content": "Bagaimanapun juga ... Mereka seharusnya membiarkan dua kontestan bertanding untuk melihat siapa yang menang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421404,
					"content": "Mataku ... Semuanya kabur ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421405
					]
				},
				{
					"id": 150421405,
					"content": "Haha, tetap fokus memang butuh banyak energi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421408
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421406,
					"content": "Asyik sih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421407
					]
				},
				{
					"id": 150421407,
					"content": "Oh ya? Kalau begitu sepertinya kita sepemikiran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421408
					],
					"speakerTitle": "Chasca"
				}
			]
		},
