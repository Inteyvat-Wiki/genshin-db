			"dialogs": [
				{
					"id": 150421501,
					"content": "Oke, hitung orang. Satu, dua, tiga, empat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421502
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421502,
					"content": "Lah, kok nambah satu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421503
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421503,
					"content": "Salam! Kalian mau mencoba tantangan utama Teluk Gelombang ya? Mohon maaf, ada sedikit gangguan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421504
					],
					"speakerTitle": "Tuksina"
				},
				{
					"id": 150421504,
					"content": "Kalau mau berfoto bersama untuk dimasukkan ke album, aku bisa bantu. Langsung saja ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421505
					],
					"speakerTitle": "Tuksina"
				},
				{
					"id": 150421505,
					"content": "Eh, enggak bisa gitu dong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421506
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421506,
					"content": "Foto kan cuma buat mengabadikan kenang-kenangan. Supaya pas dilihat nanti, kita ingat sama peristiwa dan perasaan senang pas difoto! Kalau enggak ada kegiatannya, ya ngapain foto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421507
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421507,
					"content": "Jangan lupa, fotonya tuh bisa ditukar hadiah ... tapi selain itu Paimon setuju sih. Datang, foto, terus cabut. Enggak afdol ah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150421508,
					"content": "Aku mengerti, dan aku mohon maaf yang sebesar-besarnya. Tolong bersabarlah sebentar, kami usahakan agar kendalanya dapat diatasi sesegera mungkin ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421509
					],
					"speakerTitle": "Tuksina"
				},
				{
					"id": 150421509,
					"content": "Harus tunggu berapa lama?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150421510,
					"content": "Ah, untuk itu, sulit diperkirakan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421511
					],
					"speakerTitle": "Tuksina"
				},
				{
					"id": 150421511,
					"content": "Eh? Kenapa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150421512,
					"content": "Ada yang bisa dibantu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421513
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421513,
					"content": "Um ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421514
					],
					"speakerTitle": "Tuksina"
				},
				{
					"id": 150421514,
					"content": "Aku lihat tidak banyak orang yang bertugas menjaga wahana lain di Teluk Gelombang. Dan para rekan Saurian juga kelihatannya sangat lelah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421515
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421515,
					"content": "Apa karena wahana utama bermasalah, sehingga semua karyawan yang bertugas diperbantukan untuk perbaikan wahana tersebut?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421516
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421516,
					"content": "Tenang, aku tahu ada kendala yang tidak bisa diberitahukan kepada pengunjung. Aku bukan ingin menyusahkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421517
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421517,
					"content": "Sebaliknya, rekan-rekanku di sini sangat berkompeten dan akan dengan senang hati membantu bila diperlukan. Selain itu, mereka juga baru menyelesaikan uji coba Pesiar Senja dan Asha, Lari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421518
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421518,
					"content": "Kalau boleh beri tahukan apa kendalanya, aku kira kami bisa membantu mempercepat penyelesaiannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421519
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421519,
					"content": "Wah, dia beneran jago ngomong loh kalo sudah di posisi kayak gini. Julukan \"penengah\" itu bukan asal sebut doang rupanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150421520,
					"content": "Chasca ... kenapa kamu bisa tahu kami habis ngapain tadi? Jangan-jangan kamu diam-diam mantau kami dari pucuk pohon tinggi atau apa ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421521
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421521,
					"content": "Apa perlu dibahas sekarang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421522
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421522,
					"content": "Intinya ... kami paling kompeten nih kalau disuruh bantu-bantu! Jadi kalau ada masalah, kami dengan senang hati turun tangan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421523
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150421523,
					"content": "Aku cukup terkejut mendengar Anda mengetahui kondisi rekan Saurian kami di sini. Mohon maaf, mungkin tidak sepatutnya aku menyembunyikan ini dari kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421524
					],
					"speakerTitle": "Tuksina"
				},
				{
					"id": 150421524,
					"content": "Jadi begini situasinya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421525
					],
					"speakerTitle": "Tuksina"
				},
				{
					"id": 150421525,
					"content": "Dalam tahap uji coba, kami mendapati bahwa pewarnaan \"Perosotan Super Gemerlap\" masih perlu diperbaiki. SANGAT perlu. Karena proses pengerjaan pengecatan harus dilakukan via Jalur Spiritual, maka pekerjaan ini boleh dibilang cukup menantang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421526
					],
					"speakerTitle": "Tuksina"
				},
				{
					"id": 150421526,
					"content": "Untuk menghindari penundaan pembukaan resor, kami terpaksa menghentikan operasi. Saat ini, kami sedang mengusahakan yang terbaik untuk mencapai kondisi operasional secepat mungkin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421527
					],
					"speakerTitle": "Tuksina"
				},
				{
					"id": 150421527,
					"content": "Haha, bisa banget tuh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421528
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421528,
					"content": "Kasih tahu di mana catnya, biar aku yang beresin! Sekejap juga beres!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421529
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421529,
					"content": "Hah? Tapi ... bagaimana bisa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421530
					],
					"speakerTitle": "Tuksina"
				},
				{
					"id": 150421530,
					"content": "Kamu mungkin belum pernah bertemu dengan orang ini sebelumnya ya. Namanya Mualani, \"Umo{RUBY#[S]Persatuan}ja\" Mualani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421531
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421531,
					"content": "Mualani ... AH, MUALANI? YANG ITU?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421532
					],
					"speakerTitle": "Tuksina"
				},
				{
					"id": 150421532,
					"content": "Mualani, salah satu dari enam pahlawan?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tuksina"
				}
			]
		},
