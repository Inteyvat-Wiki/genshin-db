				"points": []
			},
			"dialogs": [
				{
					"id": 150421301,
					"content": "Mata yang jeli. Aku tidak menyangka kamu bisa melihatku sampai sejauh ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421302
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421302,
					"content": "Kelihatannya kamu juga tertarik dengan fasilitas di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421303,
						150421305
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421303,
					"content": "Ya, apa fasilitasnya menyenangkan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421304
					]
				},
				{
					"id": 150421304,
					"content": "Menurutku fasilitasnya cukup bagus, tapi \"menyenangkan\" itu subjektif. Pendapatku tidak akan berpengaruh, kamu harus mencobanya sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421307
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421307,
					"content": "Lihat lintasan di sana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421308
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421308,
					"content": "Gunakan peluru cat untuk mewarnai bola-bola yang berjejer di lintasan. Setelah semuanya sama warna, bola-bola itu akan menghilang seiring suara \"bum\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421309
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421309,
					"content": "Maksudku, orang lain akan berdiri di dekat situ dengan senjata mereka sendiri. Mereka akan menunggu untuk melepaskan bola-bola berwarna itu begitu waktunya tepat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421310,
						150421311
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421310,
					"content": "Keren banget ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421312
					]
				},
				{
					"id": 150421312,
					"content": "Mencobanya sendiri lebih baik daripada hanya mendengarkan penjelasanku. Gunakan saja senjata di sana itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421313
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421313,
					"content": "Coba sekarang aku lihat kamu memainkannya. Semoga berhasil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421311,
					"content": "Aku hampir percaya omonganmu barusan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421312
					]
				},
				{
					"id": 150421305,
					"content": "Memangnya rumit ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421306
					]
				},
				{
					"id": 150421306,
					"content": "Tenang, mudah saja. Sesuai dengan nama tempat ini. Kalau kamu coba sih nanti pasti tidak akan ada sesuatu yang \"rumit\" atau \"sulit\" di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421307
					],
					"speakerTitle": "Chasca"
				}
			]
		},
