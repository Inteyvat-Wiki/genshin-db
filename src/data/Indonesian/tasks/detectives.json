			"dialogs": [
				{
					"id": 191851201,
					"content": "Aha, sesuai dugaan. Sinthe imitasinya dibuat di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851202
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 191851202,
					"content": "[Medis] (Bantu Chevreuse memeriksa obat ....)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191851203
					]
				},
				{
					"id": 191851203,
					"content": "Botol dan toples ini ... isinya semua Sinthe imitasi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191851204
					]
				},
				{
					"id": 191851204,
					"content": "Sepertinya dia menyimpan barang selain Sinthe imitasi di sini. Bahan mentahnya ada semua, dan ada juga zat kimia pembersih dalam jumlah banyak, lalu ada obat-obatan yang aku tidak kenal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851205
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 191851205,
					"content": "Zat pembersih ini sepertinya untuk menghapus jejak bahan ... misalnya baunya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851206
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 191851206,
					"content": "Pasukan Patroli Khusus sudah mencari tahu informasi terkait Sinthe Imitasi. Menurut catatan, sulit sekali bagi orang biasa untuk mendeteksi bekas-bekasnya. Aku yakin Pierre juga begitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851207
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 191851207,
					"content": "Untuk membersihkan semua jejak ini perlu waktu dan kemampuan yang tidak sembarangan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851208
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 191851208,
					"content": "Tapi obat-obatan lainnya untuk apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chevreuse"
				}
			]
