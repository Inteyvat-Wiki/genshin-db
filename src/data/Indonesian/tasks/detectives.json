			"dialogs": [
				{
					"id": 191851001,
					"content": "Waktu Marechaussee Phantom menggeledah rumah Pierre, tidak ada tanda-tanda tong kayu ini, betul?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851002
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 191851002,
					"content": "Pasti dipindah. Tapi kalau dibawa semua sampai sini kan terlalu menarik perhatian ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191851003
					]
				},
				{
					"id": 191851003,
					"content": "Betul. Itu bukan gayanya ... tapi lalu gimana caranya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851004
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 191851004,
					"content": "(Periksa tong kayunya ....)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191851005
					]
				},
				{
					"id": 191851005,
					"content": "(Tongnya ada bekas rusak oleh air. Bekas air yang sudah kering ada di mulut tong ....)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851006
					],
					"speakerTitle": "Periksa"
				},
				{
					"id": 191851006,
					"content": "(Noda bekas air ini ada polanya. Entah kenapa, adanya cuma di sebelah bawah tong.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851007
					],
					"speakerTitle": "Periksa"
				},
				{
					"id": 191851007,
					"content": "(Tutupnya tidak rapat, ada celah di pinggir-pinggirnya. Tapi sepertinya di dalam tidak ada bekas air.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851008
					],
					"speakerTitle": "Periksa"
				},
				{
					"id": 191851008,
					"content": "Cuma bagian bawahnya saja yang ada bekas terendam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lynette"
				}
			]
		},
