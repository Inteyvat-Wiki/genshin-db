						191854104
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 191854104,
					"content": "Kita menyelidiki dengan sangat cepat, mungkin ada satu atau dua hal yang terlewatkan. Aku akan masuk mode detektif dan memikirkan ulang semua yang kita ketahui dari awal, siapa tahu dapat sesuatu yang baru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191854105
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 191854105,
					"content": "Apa masih ada hal aneh, atau hal yang belum terungkap yang mesti kita pertimbangkan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lynette"
