			"dialogs": [
				{
					"id": 191851101,
					"content": "Bahan kantongnya ... langka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851102
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 191851102,
					"content": "[Pengetahuan] (Bantu Lyney memeriksa bahan ....)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191851103
					]
				},
				{
					"id": 191851103,
					"content": "Mirip enggak sih sama bahan buat bikin Kantong Ajaib?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191851104
					]
				},
				{
					"id": 191851104,
					"content": "Sama persis. Serat Romaritime Flower. Tapi, ada yang beda di komposisi tas-tas ini. Kalau diperhatikan lebih saksama, ini bukan cuma tahan air, tapi juga anti korosi dan anti bocor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851105
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 191851105,
					"content": "Bahkan talinya juga didesain agar tas ini bisa tertutup rapat dan kedap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851106
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 191851106,
					"content": "Aku lihat tadi ada tas yang bahannya sama, tapi ukurannya lebih kecil. Kalau dari bentuknya sih kayaknya tidak sekuat yang ini ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851107
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 191851107,
					"content": "Jadi ... kayak kantong kecil yang kedap rapat itu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191851108
					]
				},
				{
					"id": 191851108,
					"content": "Mirip sekali. Umumnya sih anjing pelacak bisa mencium Sinthe imitasi dengan mudah, tapi kalau disimpannya di wadah rapat seperti itu ... pasti lolos dari hidung mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851109
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 191851109,
