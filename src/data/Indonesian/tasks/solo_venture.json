				{
					"id": 708160301,
					"content": "Apakah kamu berhasil menemukannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708160302
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 708160302,
					"content": "Sudah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708160303
					]
				},
				{
					"id": 708160303,
					"content": "Syukurlah. Aku selalu menggunakan peta ini, jadi aku telah membuat banyak tanda di atasnya. Kehilangan ini akan sangat menyusahkanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708160304
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 708160304,
					"content": "Dan jika aku benar-benar kehilangan Panduan Petualang milikku, aku juga tidak tahu bagaimana aku bisa meminta Katheryne membuatkanku yang baru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708160305
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 708160305,
					"content": "Maksudku ini sama saja dengan sebuah lelucon, seorang petualang kehilangan Panduan Petualang selama petualangan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708160306
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 708160306,
					"content": "Terima kasih, aku akan menyimpan semua ini dengan baik-baik. Terimalah imbalan ini sebagai tanda terima kasihku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				}
