						],
						"pointId": 5698
					}
				]
			},
			"dialogs": [
				{
					"id": 741180301,
					"content": "... Oke di sini harusnya tidak masalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180302
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180302,
					"content": "Biar aku mulai dari awal. Sejak kamu membantu kami memodifikasi Mesin Berhitung di Sumeru, kinerja mesin ini meningkat drastis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180303
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180303,
					"content": "Tuan Garcia sangat bersemangat dan ingin terus meningkatkannya. Tapi seperti yang dia katakan, ada batasan pada struktur mekanisme tradisional ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180304
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180304,
					"content": "Performa mesin ini sudah tidak bisa ditingkatkan lagi, jadi kami ingin kembali ke Fontaine untuk mencari ide dan inspirasi lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180305
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180305,
					"content": "Tapi, saat kita kembali ke Fontaine. Seseorang yang aneh tiba-tiba menghampiri Tuan Garcia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180306
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180306,
					"content": "Orang ini bilang dia bisa menyediakan dana penelitian untuk Tuan Garcia, atau bahkan membantunya mencari partner peneliti lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180307
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180307,
					"content": "Tapi sebaliknya, Tuan Garcia harus berbagi semua ide dan data desain Mesin Berhitung dengan dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180308,
						741180309
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180308,
					"content": "Garcia pasti tidak akan menerimanya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180310
					]
				},
				{
					"id": 741180310,
					"content": "Iya! Kamu buka mulut cuma demi minta hasil penelitian orang lain, jelas-jelas rampok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741180311,
					"content": "Benar. Jadi Tuan Garcia menolak orang ini dengan tegas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180312
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180312,
					"content": "Tapi setelah itu, sepertinya ada orang yang terus mengikutiku dan Tuan Garcia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180313
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180313,
					"content": "Selain itu, ada juga yang masuk ke kamar kami saat kami pergi dan mencari sesuatu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180314
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180314,
					"content": "Meskipun orang itu benar-benar hebat sekali dalam menutup jejaknya, tapi Tuan Garcia tetap menemukan jejaknya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180315
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180315,
					"content": "Ngeri amat ... Kamu enggak mau kasih ke dia, jadi dia sekarang mau paksa ambil?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741180316,
					"content": "Sebenarnya, setelah kami menemukan ruangan itu dibobol orang, kami memutuskan untuk segera mengumpulkan uang dan pergi dari sini lalu kembali ke Desa Petrichor secepatnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180317
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180317,
					"content": "Setelah sampai di sana, kami akan menghubungi beberapa orang lainnya di Klub Pemimpi untuk menyelesaikan masalah ini bersama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180318
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180318,
					"content": "Selain itu, Petrichor juga termasuk ... Hehe, sebut saja itu markas besar Tuan Garcia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180319
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180319,
					"content": "Baginya, tidak ada tempat yang lebih aman dari Petrichor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180320
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180320,
					"content": "Awalnya hari ini adalah hari keberangkatan kami. Kami bahkan sudah bersiap-siap untuk pergi ke Desa Petrichor, jadi kami ingin meminta bantuanmu untuk menjadi pengawal kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180321
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180321,
					"content": "Aku tidak menyangka bisa bertemu dengan Nona Kaia di sini ... Demi keamanan, aku hanya bisa meminta Tuan Garcia membawa Nona Kaia kembali ke kota.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180322,
						741180323
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180322,
					"content": "Lalu apa yang bisa kulakukan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180324
					]
				},
				{
					"id": 741180324,
					"content": "Sepertinya kita harus menunda waktu keberangkatan kita. Sekarang, tolong segera pergi ke sisi Tuan Garcia. Seperti yang kukatakan sebelumnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180325
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180325,
					"content": "Dengan teman sepertimu, mungkin kita tidak perlu mengalami masalah yang tidak perlu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180326,
						741180327
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180326,
					"content": "Aku akan segera ke sana.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180330
					]
				},
				{
					"id": 741180330,
					"content": "Tuan Garcia akan menceritakan semuanya pada Nona Kaia. Lalu selanjutnya ... Biarkan Nona Kaia sendiri yang memutuskan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180331
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180331,
					"content": "Pokoknya, ayo kita cepat kembali ke kota.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180327,
					"content": "Apa mereka benar-benar dalam bahaya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180328
					]
				},
				{
					"id": 741180328,
					"content": "Tidak. Tuan Garcia masih ada di Court of Fontaine. Ada banyak mekanisme penjaga yang berpatroli di sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180329
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180329,
					"content": "Jika mereka ingin menggunakan kekerasan, maka Maison Gardiennage akan menyelesaikannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180330
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180323,
					"content": "Apa yang bisa kubantu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180324
					]
				},
				{
					"id": 741180309,
					"content": "Kedengarannya orang ini bukan orang baik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180310
					]
				}
			]
		},
