			},
			"dialogs": [
				{
					"id": 741180101,
					"content": "Tuan, mungkin kita harus pergi ke Desa Petrichor dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180102
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180102,
					"content": "Meskipun Tuan Xavier dan Felix tidak di sana, namun Tuan Mécantre dan Babisse harusnya masih ada di desa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180103
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180103,
					"content": "Mungkin mereka bisa memberimu beberapa saran atau inspirasi. Bahkan dalam kondisi terburuk, Anda juga punya dua orang yang bisa membantu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180104
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180104,
					"content": "Tidak, Lutong yang terkasih, tidak ... Penelitian Mécantre dan Babisse sekarang bersinar layaknya api yang membara, terus membakar bagaikan api liar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180105
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180105,
					"content": "Di surat terakhir mereka, mereka menyebutkan ada orang pintar dari Institut Penelitian Fontaine yang tiba di Petrichor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180106
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180106,
					"content": "Tuan Bossuet ini punya banyak pengetahuan dan pemahaman, dan dia telah membantu mereka menyelesaikan banyak masalah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180107
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180107,
					"content": "Sementara aku .... *huff*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180108,
						741180109
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180108,
					"content": "Garcia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180110
					]
				},
				{
					"id": 741180110,
					"content": "#Oh, ternyata {NICKNAME}. Kebetulan sekali, tidak kusangka bisa bertemu kamu di Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180111
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180111,
					"content": "Meskipun ... waktunya ... cukup kebetulan sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180112
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180112,
					"content": "#Benar, kebetulan sekali ... tapi aku senang bisa bertemu denganmu, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180113
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180113,
					"content": "Wah, dia kelihatannya capek banget, matanya juga sudah kayak panda tuh ... Kayak orang yang beneran sudah enggak ada energi lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741180114,
					"content": "Garcia, ada apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180115
					]
				},
				{
					"id": 741180115,
					"content": "Kami ... eh, penelitian Tuan menemui beberapa masalah yang tak terduga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180116
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180116,
					"content": "Tapi ceritanya panjang ... Kami sedang berencana untuk pergi ke Opera Epiclese untuk menagih tagihan mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180117
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180117,
					"content": "Setelah pekerjaan selesai, kita bisa cari tempat yang tenang untuk ngobrol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180118
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180118,
					"content": "Kalian punya pekerjaan lain?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180119
					]
				},
				{
					"id": 741180119,
					"content": "Ini bukan pekerjaan. Aku hanya ditugaskan untuk membantu perhitungan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180120
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180120,
					"content": "Opera Epiclese baru-baru ini menampung banyak kelompok, perlu diadakan pembukuan menyeluruh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180121
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180121,
					"content": "Jadi, demi mengumpulkan biaya untuk kembali ke Desa Petrichor, kami ... aku, mewakili Tuan Garcia, menerima misi ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180122
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180122,
					"content": "Ah! Ini seperti bakar sehelai rambut pakai tungku. Hitungan kelas anak sekolah dasar begini, tanpa mesin hitung juga bisa kelar nanti sore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180123
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180123,
					"content": "Jadi ini adalah cara terbaik untuk mengumpulkan dana. Ayo kita berangkat, Tuan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180124
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180124,
					"content": "#Oh ya, {NICKNAME}, bolehkah aku meminta tolong padamu untuk ikut dengan kami?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180125
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180125,
					"content": "Dengan teman sepertimu, mungkin kita tidak perlu mengalami masalah yang tidak perlu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180126
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180126,
					"content": "Kami akan memberimu imbalan yang sesuai, jangan khawatir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180127,
						741180128
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180127,
					"content": "Oke.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180129
					]
				},
				{
					"id": 741180129,
					"content": "Kalau aku jadi kamu, aku tidak akan percaya diri begitu ... hehe. Pokoknya, kita berangkat dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180128,
					"content": "Tidak akan ada apa-apa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180129
					]
				},
				{
					"id": 741180109,
					"content": "Kamu balik ke Fontaine?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180110
					]
				}
			]
		},
