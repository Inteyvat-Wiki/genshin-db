			"dialogs": [
				{
					"id": 741180601,
					"content": "Terima kasih, Garde Menthe. Begitu kamu datang, dia langsung kabur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180602
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180602,
					"content": "Aku hanya melakukan kewajibanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180603
					],
					"speakerTitle": "Menthe"
				},
				{
					"id": 741180603,
					"content": "Tuan, kita harus segera pergi dan kembali ke Petrichor. Secepatnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180604
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180604,
					"content": "Kurasa mereka sudah mulai hilang kesabaran ... dan takutnya bakal bertindak gegabah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180605
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180605,
					"content": "Aku akan lapor ke atasan. Harus tunggu beberapa hari sampai ada jawaban.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180606
					],
					"speakerTitle": "Menthe"
				},
				{
					"id": 741180606,
					"content": "Idealnya, kami akan atur agar ada petugas yang mengawal kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180607
					],
					"speakerTitle": "Menthe"
				},
				{
					"id": 741180607,
					"content": "Tapi sumber dayanya terbatas, dan semua urusan dalam kota juga tanggung jawab kami ... Mungkin pengawalan bisa sampai setengah jalan saja sebelum tiba di Petrichor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180608
					],
					"speakerTitle": "Menthe"
				},
				{
					"id": 741180608,
					"content": "Dan sebelum kalian pergi, tolong pindah dulu ke tempat aman. Diskusinya mungkin akan ... makan waktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180609,
						741180610
					],
					"speakerTitle": "Menthe"
				},
				{
					"id": 741180609,
					"content": "Soal kawal-mengawal biar aku saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180611
					]
				},
				{
					"id": 741180611,
					"content": "Terima kasih banyak. Kalau ada kamu, mereka tidak akan berani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180612
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180612,
					"content": "Tapi bukannya Kaia juga kerja bareng grup teater ya? Kalau kalian ke Petrichor, dia ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741180613,
					"content": "Aku ikut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180614
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180614,
					"content": "APA?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180615
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180615,
					"content": "Nona, aku mohon dengan sepenuh hati, tolong jangan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180616
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180616,
					"content": "Lutong sayang, simpan saja napasmu. Aku tidak jauh beda dengan bosmu. Tidak bisa dibujuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180617
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180617,
					"content": "Ta-Tapi kita kan tidak tahu bahaya seperti apa yang menanti di depan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180618
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180618,
					"content": "Justru itu aku harus ikut! Kamu mau meninggalkan aku lagi, hanya menyisakan apa-apa selain partitur musik tanpa awal dan tanpa akhir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180619
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180619,
					"content": "Pemimpin kami juga sangat berminat dengan musik yang dihasilkan dari angka-angkamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180620
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180620,
					"content": "Dia pasti setuju aku ikut denganmu. Nah, sudah dibicarakan ya. Sekarang ke mana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180621
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180621,
					"content": "Persis kayak di Sumeru dulu ... Nona Kaia yang pegang kendali penuh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180622
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741180622,
					"content": "Garcia keok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180623
					]
				},
				{
					"id": 741180623,
					"content": "Mungkin, Tuan Garcia memang tidak ingin menang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180624
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180624,
					"content": "*uhuk* Lutong! Ayo cepat, kita harus cari tempat singgah. Sebaiknya yang banyak orangnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180625
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180625,
					"content": "Tempat yang banyak orangnya ya ... mungkin kita bisa pergi ke ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180626
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180626,
					"content": "Ke hotel tempat grup kami menginap saja, gimana? Di sana sibuk, dan semua sudah saling kenal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180627
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180627,
					"content": "Kalau ada orang asing mau menyusup, pasti langsung ketahuan. Dan pemimpin kami juga ingin tahu lebih jauh soal Mesin Angka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180628
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180628,
					"content": "Uh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180629
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180629,
					"content": "Baiklah, setuju ya! Oke, semua masalah selesai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180630
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180630,
					"content": "Semua masalah selesai apanya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180631
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180631,
					"content": "#Baiklah, begitu saja ya. Ini {NICKNAME}, silakan. Anggap saja bayar di muka atas jasa pengawalan sampai tempat tujuan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180632
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180632,
					"content": "Aku tidak tahu kapan bisa berangkat ... Tapi aku mengandalkanmu saat waktunya tiba ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180633
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180633,
					"content": "Kenapa rasanya masalahnya malah tambah banyak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180610,
					"content": "Aku jaga mereka.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180611
					]
				}
			]
		},
