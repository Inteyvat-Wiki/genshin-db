			"dialogs": [
				{
					"id": 741185001,
					"content": "#Siap melayanimu, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185002,
						741185008,
						741185014
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741185002,
					"content": "Apa rencana kalian selanjutnya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741185003
					]
				},
				{
					"id": 741185003,
					"content": "Sepertinya kita harus cari tahu identitas mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185004
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741185004,
					"content": "Meskipun kita sudah laporkan kasus ini, tapi Garde juga tidak bisa berbuat banyak kalau tidak ada petunjuk apa pun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185005
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741185005,
					"content": "Ditambah lagi, Court of Fontaine begitu besar, Garde juga tidak bisa mengawasi kita di segala penjuru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185006
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741185006,
					"content": "Sekarang ... Nona Kaia juga ikut terlibat. Masalahnya jadi lebih rumit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185007
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741185007,
					"content": "Semoga Tuan Garcia bisa membujuk Nona Kaia untuk segera meninggalkan Fontaine. Dengan begitu, kita masih bisa bertindak sesuai rencana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741185008,
					"content": "Apa penelitian Garcia buntu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741185009
					]
				},
				{
					"id": 741185009,
					"content": "\"Buntu\" berarti tidak bisa dikembangkan lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185010
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741185010,
					"content": "Tapi di bidang aplikasi, \"Mesin Berhitung\" ini bisa sangat berguna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185011
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741185011,
					"content": "Hanya saja, Tuan Garcia tidak terlalu peduli dengan kegunaan sederhananya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185012
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741185012,
					"content": "Kurasa ini salah satu alasan kenapa dia sengsara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185013
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741185013,
					"content": "Tapi di sisi lain, ini juga mungkin alasan dia bisa berperan jadi peneliti yang frustrasi dengan sangat baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741185014,
					"content": "Sampai jumpa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741185015
					]
				},
				{
					"id": 741185015,
					"content": "Kuserahkan padamu ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				}
			]
		},
