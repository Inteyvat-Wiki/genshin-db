					"nextDialogs": [
						741180406
					]
				},
				{
					"id": 741180406,
					"content": "Melapor ke Garde adalah pilihan yang baik ... Kebetulan ada seorang petugas di sebelahku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180407
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180407,
					"content": "Kami sudah melaporkan kasus ini ke Garde Menthe sebelumnya. Dia juga sudah paham situasinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180408
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180408,
					"content": "Aku yakin dia akan bantu. Apalagi di sini ada petugas Garde juga, orang-orang itu tidak akan berani macam-macam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180409
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180409,
					"content": "#{NICKNAME}, tolong jelaskan situasinya ke Garde Menthe. Aku mau cari Tuan Garcia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180410
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180410,
					"content": "Oke, ayo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				},
				{
