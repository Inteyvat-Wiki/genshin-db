				"points": []
			},
			"dialogs": [
				{
					"id": 722710102,
					"content": "Ada harta berharga yang ingin kujual.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722710103
					]
				},
				{
					"id": 722710103,
					"content": "Oh, ada barang langka apa lagi yang kamu temukan? Coba kulihat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710104
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710104,
					"content": "Kamu menceritakan tentang Dragonbone Orb kepada Linlang.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722710105
					]
				},
				{
					"id": 722710105,
					"content": "Kalau apa yang kamu lihat itu benar, maka benda itu adalah peninggalan yang luar biasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710106
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710106,
					"content": "Tapi dari pemeriksaan sepintas, aku tidak bisa menemukan sesuatu yang spesial darinya. Mungkin perlu penggunaan masa panjang agar bisa merasakannya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710107
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710107,
					"content": "Dari pengamatanku, efek ajaib yang kamu dengar sepertinya terlalu dibesar-besarkan. Atau mungkin itu hanyalah bualan orang-orang yang kalah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710108
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710108,
					"content": "Jangan terlalu diambil hati. Aku hanya mengatakan apa yang ada di pikiranku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710122
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710122,
					"content": "Ini sih sudah jadi hal biasa dalam bidang pekerjaan kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710109
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710109,
					"content": "Dan juga, kamu sepertinya tidak menyimpannya di tempat tertutup. Permukaan luarnya tampak sudah ada yang aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710110
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710110,
					"content": "Kalau begini, harganya perlu dikurangi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710123
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710123,
					"content": "Kubayar 80.000 Mora, mau tidak? Selain itu, kuberi bonus 5 porsi Bountiful Year.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710111
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710111,
					"content": "Kurasa harganya sudah pas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710112,
						722710116,
						722710119
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710112,
					"content": "Apa yang kamu lakukan padanya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722710113
					]
				},
				{
					"id": 722710113,
					"content": "Sejujurnya, menurutku sejarah di baliknya lebih berharga daripada kapabilitasnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710114
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710114,
					"content": "Biar kutebak, ini mungkin hal yang menarik bagi para pendongeng dan rombongan opera kami, atau mungkin bagi pria dan wanita di Yujing Terrace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710115
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710115,
					"content": "Itu akan menjadi barang pameran peninggalan kuno yang sangat berharga bahkan jika aku hanya sekadar memasangnya di konter toko.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710111
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710116,
					"content": "Harga yang wajar. Sepakat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722710117
					]
				},
				{
					"id": 722710117,
					"content": "Oh, cepat juga kamu memutuskan. Baiklah, ini Mora-mu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710118
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710118,
					"content": "Kalau kamu menemukan harta karun lainnya, kami akan selalu menyambutmu di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710119,
					"content": "Aku akan mempertimbangkannya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722710120
					]
				},
				{
					"id": 722710120,
					"content": "Tidak masalah. Lagi pula kamu harus selalu memeriksa barangnya — maksudku, harganya — saat kamu akan menjual benda berharga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710121
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710121,
					"content": "Kamu bisa datang lagi kalau sudah memutuskannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linlang"
				}
			]
		},
