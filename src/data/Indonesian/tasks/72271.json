				{
					"id": 722710201,
					"content": "Tentang Dragonbone Orb ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722710202
					]
				},
				{
					"id": 722710202,
					"content": "Oh, apa kamu sudah mempertimbangkannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710203
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710203,
					"content": "Kami akan membelinya seharga 80.000 Mora dan 5 porsi Bountiful Year.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710204,
						722710207
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710204,
					"content": "Aku jual ke kamu deh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722710205
					]
				},
				{
					"id": 722710205,
					"content": "Terima kasih. Ini Mora-mu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710206
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710206,
					"content": "Kalau kamu menemukan harta karun lainnya, kami akan selalu menyambutmu di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710207,
					"content": "Coba kupertimbangkan lagi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722710208
					]
				},
				{
					"id": 722710208,
					"content": "Tidak masalah. Lagi pula kamu harus selalu memeriksa harganya saat kamu akan menjual benda berharga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710209
					],
					"speakerTitle": "Linlang"
				},
