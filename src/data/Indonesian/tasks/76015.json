						760150209
					],
					"speakerTitle": "Arwah Berisik"
				},
				{
					"id": 760150209,
					"content": "\"Semakin hangat bagai ciuman yang pertama~\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150210
					]
				},
				{
					"id": 760150210,
					"content": "\"Detak jantungku seakan ikut irama~\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150211
					],
					"speakerTitle": "Arwah Berisik"
				},
				{
					"id": 760150211,
					"content": "\"Karena terlena oleh pesona alunan kopi dangdut~\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150212
					]
				},
				{
					"id": 760150212,
					"content": "Haha, bagus, bagus, gitu baru betul! Cepat tanggap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150213
					],
					"speakerTitle": "Arwah Berisik"
				},
				{
					"id": 760150213,
					"content": "Namaku ███, sekarang kita sudah saling kenal. Kamu boleh duduk di situ, aku tidak pelit kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150214
					],
					"speakerTitle": "Arwah Berisik"
				},
				{
					"id": 760150214,
					"content": "Kamu Ratnik juga, kan? Minumnya biar aku saja yang bayar. Siapa tahu kita ketemu lagi pas latihan nanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150215,
						760150216
					],
					"speakerTitle": "Arwah Berisik"
				},
				{
					"id": 760150215,
					"content": "Terima kasih, tapi aku tidak bisa minum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150217
					]
				},
				{
					"id": 760150217,
					"content": "Aku masih harus patroli malam ini, pamit dulu ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arwah Berisik"
				},
				{
					"id": 760150216,
					"content": "Salam kenal, namaku Flins.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150217
					]
				},
				{
					"id": 760150205,
					"content": "Gimana kalau aku mau duduk di sini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150206
					]
				}
			]
		},
