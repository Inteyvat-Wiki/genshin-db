			"trigger": {
				"objectNames": [
					"Arwah Berisik"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760150101,
					"content": "Siapa kamu? Ini tempatku, semua orang di kedai juga tahu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150102
					],
					"speakerTitle": "Arwah Berisik"
				},
				{
					"id": 760150102,
					"content": "Datang ke pulau untuk melapor, atau apa? Jangan seenaknya merebut tempat orang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150103
					],
					"speakerTitle": "Arwah Berisik"
				},
				{
					"id": 760150103,
					"content": "Mana birku? Kenapa belum datang?! Cepat, habis ini aku masih harus patroli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150104,
						760150105
					],
					"speakerTitle": "Arwah Berisik"
				},
				{
					"id": 760150104,
					"content": "Kedai? Bir?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150106
					]
				},
				{
					"id": 760150106,
					"content": "Kalau mau, silakan! Tapi minum dan nyanyi bareng dulu. Setelah jadi teman, bebas mau duduk di mana juga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150107
					],
					"speakerTitle": "Arwah Berisik"
				},
				{
					"id": 760150107,
					"content": "Bisa nyanyinya, kan? Oke, sip! Bersahut-sahutan ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150108
					],
					"speakerTitle": "Arwah Berisik"
				},
				{
					"id": 760150108,
					"content": "\"Api asmara yang dahulu pernah membara~\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150109,
						760150110,
						760150111
					],
					"speakerTitle": "Arwah Berisik"
				},
				{
					"id": 760150109,
					"content": "....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150112
					]
				},
				{
					"id": 760150112,
					"content": "Ngaco, ngaco! Yang benar dong, semua orang di Nod-Krai tahu lagu ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150113
					],
					"speakerTitle": "Arwah Berisik"
				},
				{
					"id": 760150113,
					"content": "Kalau tidak bisa nyanyi dan bersenang-senang, kamu tidak bisa membaur! Gimana nasibnya prajurit tanpa rekan seperjuangan pas Perburuan Liar menyerang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150114
					],
					"speakerTitle": "Arwah Berisik"
				},
				{
					"id": 760150114,
					"content": "Sana, belajar nyanyi dulu baru balik lagi. OOOI, tambah lagi birnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arwah Berisik"
				},
				{
					"id": 760150110,
					"content": "\"Paimon anaknya tukang lawak, joget sambil terbahak-bahak~\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150112
					]
				},
				{
					"id": 760150111,
					"content": "\"Hantu-hantu kumpul di meja, joget sampai ketawa-tawa~\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150112
					]
				},
				{
					"id": 760150105,
					"content": "Ikut duduk sebentar, boleh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150106
					]
				}
			]
		},
