			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bahar"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736960101,
					"content": "Halo, Pengembara. Kalau dilihat dari penampilanmu ... Kamu pasti ke sini untuk mengikuti Gala Kebijaksanaan, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960102
					],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960102,
					"content": "Kalau kamu tertarik, apa kamu mau mencoba acara yang diadakan Haravatat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960103
					],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960103,
					"content": "Seingatku bidang yang dipelajari Haravatat adalah ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736960104
					]
				},
				{
					"id": 736960104,
					"content": "Ringkasnya ... \"bahasa\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960105
					],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960105,
					"content": "Itulah yang kami pelajari di Haravatat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960106
					],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960106,
					"content": "Bagaimana? Kedengarannya sesuai dengan suasana Gala yang meriah dan santai, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960107
					],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960107,
					"content": "Para anggota Darshan juga banyak yang berpendapat begitu. Orang-orang sedang menikmati Gala dengan gembira. Sepertinya sulit untuk mengajak mereka bermain teka-teki, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960108
					],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960108,
					"content": "Lagi pula, permainan teka-teki seperti ini sangat sulit untuk menarik minat para pengunjung untuk berpartisipasi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960109
					],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960109,
					"content": "Setelah melewati diskusi bersahabat ... selama berhari-hari, kami akhirnya menciptakan sebuah permainan sederhana yang disebut sebagai \"Penjajakan Kebenaran\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960110
					],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960110,
					"content": "Permainan ini tidak memerlukan peralatan apa pun, cuma perlu pikiran yang tenang dan jernih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960111
					],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960111,
					"content": "Saat permainan dimulai, aku akan menceritakan sebuah cerita. Cerita ini mungkin terdengar tidak lengkap dan bahkan mungkin sedikit tidak masuk akal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960112
					],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960112,
					"content": "Lalu kamu boleh bertanya padaku, dan aku akan menjawab dengan tiga jenis jawaban, yaitu <color=#00E1FFFF>\"Iya\"</color>, <color=#00E1FFFF>\"Tidak\"</color>, dan <color=#00E1FFFF>\"Tidak berhubungan\"</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960113
					],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960113,
					"content": "Yang harus kamu lakukan adalah menggunakan pertanyaanmu untuk menemukan \"kebenaran\" dari cerita ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960114
					],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960114,
					"content": "Tapi santai saja. Kebenaran di balik cerita ini tidak serumit itu, kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960115
					],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960115,
					"content": "Bagaimana? Kalau kamu tertarik, kita bisa langsung mulai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960116,
						736960118
					],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960116,
					"content": "Kalau begitu ayo mulai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736960117
					]
				},
				{
					"id": 736960117,
					"content": "Bagus! Kalau begitu, dengarkan baik-baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960118,
					"content": "Aku masih ada urusan lain.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736960119
					]
				},
				{
					"id": 736960119,
					"content": "Tidak masalah. Aku akan berada di sini, jadi kamu boleh kembali kapan pun kamu mau mencobanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bahar"
				}
			]
		}
	]
}