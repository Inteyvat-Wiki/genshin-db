			"dialogs": [
				{
					"id": 120170401,
					"content": "Jadi foto adalah sebuah representasi visual ... sebuah proyeksi, seperti bayangan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170402
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170402,
