					"Ei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120170501,
					"content": "Selesai! Lihat deh, ini fotomu yang kita ambil tadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170502,
					"content": "Wow ... hebat sekali. Apa ini semacam sihir? Ini terlihat seperti ... salinan tubuhku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170503
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170503,
					"content": "Tapi dia kelihatannya tidak bisa bergerak atau bicara ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170504,
						120170505
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170504,
					"content": "Ini hanya rekaman gambar saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170506
					]
				},
				{
					"id": 120170506,
					"content": "Kukira hasilnya akan jelek karena aku terlalu kaku. Tapi ternyata hasilnya lebih alami dari dugaanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170507
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170507,
					"content": "Hasil posenya sama persis, pemandangan di belakang juga sama ... Aku sama sekali tidak bisa menebak cara kerjanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170508
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170508,
					"content": "Justru itu yang membuatnya spesial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170509,
					"content": "Tunggu dulu, aku masih kurang paham. Apa kamu bisa menjelaskannya sekali lagi ... ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170510
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170510,
					"content": "Jadi yang ada di foto ini ... bukan diriku, kamu yakin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170511
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170511,
					"content": "Kalau dia bukan aku, tapi kenapa mirip sekali? Dan kalau dia itu diriku ... lalu siapa aku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170512
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170512,
					"content": "#Uh ... oke, Paimon menyerah. Giliranmu, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170513,
					"content": "Ini sedikit mirip sepertimu dan Shogun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170514
					]
				},
				{
					"id": 120170514,
					"content": "Eh, betul juga. Apa menurutmu Shogun sama denganmu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170515,
					"content": "Tentu saja. Aku tidak punya rencana menyerahkan kendali Inazuma ke tangan orang lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170516
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170516,
					"content": "Kalau begitu, dirimu yang ada di sini, siapa dong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170517,
					"content": "Ya aku tetap aku. Tidak diragukan lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170518
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170518,
					"content": "Jadi keberadaanmu tidak hanya satu saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170519
					]
				},
				{
					"id": 120170519,
					"content": "Keberadaanku, hmm ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170520
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170520,
					"content": "Sepertinya aku mengerti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170521
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170521,
					"content": "Aku adalah aku. Diriku hanya satu, tapi bisa muncul dalam berbagai bentuk. Tidak penting aku muncul dalam bentuk apa pun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170522
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170522,
					"content": "Sebagai contoh, Shogun adalah salah satu dari perwujudanku. Apakah dia adalah diriku atau bukan tidak bisa ditentukan dari bagian manapun dari tubuhnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170523
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170523,
					"content": "Kalau begitu, berarti foto ini juga salah satu wujudmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170524
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170524,
					"content": "Hmm. Jadi bahkan aku, yang mengejar Keabadian, terus mengubah-ubah wujudku sendiri ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170525
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170525,
					"content": "Kalau benar begitu, mana boleh aku meminta Inazuma dan semua penduduknya untuk tidak berubah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170526,
						120170527
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170526,
					"content": "Inazuma akan selalu jadi Inazuma.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170528
					]
				},
				{
					"id": 120170528,
					"content": "Semua hal yang kutemukan di perjalanan bersamamu ini benar-benar di luar wawasanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170529
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170529,
					"content": "Ah, kamu jadi melihat banyak sisi bodohku hari ini. Mungkin kamu tidak tahu, tapi semua ini benar-benar berlawanan dengan pemahamanku tentang banyak hal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170530
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170530,
					"content": "Dari apa yang kulihat hari ini, aku harus menerima kalau Inazuma adalah tempat yang berbeda dari ingatanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170531
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170531,
					"content": "Tapi tidak bisa dibilang kalau Inazuma yang sekarang bukanlah Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170532
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170532,
					"content": "Betul.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170533
					]
				},
				{
					"id": 120170533,
					"content": "Dekrit Perburuan Vision dan Patung Omnipresent God adalah caraku untuk mencapai Keabadian. Tapi kalau aku benar-benar mendekati Keabadian itu, semua hal ini tidak akan pernah terjadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170534
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170534,
					"content": "Hmm ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170535
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170535,
					"content": "Mungkin ... mungkin aku menggenggam semuanya terlalu erat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170536
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170536,
					"content": "Paimon rasa Ei sudah menemukan jawabannya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170537
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170537,
					"content": "Itu berarti kita sukses jadi pemandu wisata!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170538
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170538,
					"content": "Tuan Muda Kamaji! Tuan Muda Kamaji!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170539
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170539,
					"content": "Hmm? Kenapa berisik sekali di bawah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170540
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170540,
					"content": "Sepertinya itu suara Ippei. Ada apa ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170541
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170541,
					"content": "Ippei? Apa dia seseorang dari Tenryou Commission?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170542
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170542,
					"content": "Yap. Ayo kita cari tahu ada apa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170527,
					"content": "Manusia akan selalu jadi manusia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170528
					]
				},
				{
					"id": 120170505,
					"content": "Ini bukan dirimu yang asli.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170506
					]
				}
			]
		},
		{
			"id": 1201707,
			"completionStepIds": [
				1201707
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201707",
							"2"
						],
						"stepId": 1201707,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ippei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120170701,
					"content": "Hei, Ippei, ada apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170702,
					"content": "Ah, ternyata kamu. Aku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170703
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170703,
					"content": "Eh? Ya-Yang Mulia Shogun!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170704
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170704,
					"content": "Anda pasti ingin bertemu dengan Tuan Muda Kujou Kamaji ya? Maafkan saya, tapi dia sedang tidak di tempat. Tapi jika Anda bersedia, bolehkah saya menyampaikan pesan Anda untuknya ... ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170705
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170705,
					"content": "Tidak apa, aku bukan datang untuk menemuinya. Tadi kami mendengar suaramu, jadi kami datang untuk mencari tahu ada masalah apa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170706
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170706,
					"content": "Kamu sedang mencari Tuan Muda-mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170707
					]
				},
				{
					"id": 120170707,
					"content": "Benar. Tuan Muda masih belum pulang dari negosiasinya, aku jadi khawatir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170708
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170708,
					"content": "Tapi dia memang suka jalan-jalan santai dan pulang larut malam sih. Sangat memungkinkan kalau dia menemukan tempat yang dia sukai sampai lupa waktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170709
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170709,
					"content": "Tapi entah kenapa, hari ini aku lebih khawatir dari biasanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170710
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170710,
					"content": "Kujou Kamaji ... Seorang keturunan Klan Kujou, benar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170711
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170711,
					"content": "Benar sekali. Mohon maaf, karena kepala klan sedang tidak sehat dan Tuan Muda Masahito jarang di rumah, jadi Tuan Muda Kamaji-lah yang bertugas mewakili Klan Kujou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170712
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170712,
					"content": "Kudengar Tenryou Commission sedang kurang stabil sekarang. Apa ada hubungannya dengan Kujou Kamaji?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170713
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170713,
					"content": "Mohon ampuni kami, Yang Mulia Shogun. Klan Kujou telah melalaikan tanggung jawabnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170714
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170714,
					"content": "Reputasi Klan Kujou sudah hancur dan kendalinya di Tenryou Commission pun berkurang. Selain itu Anda, em ... ehem, Anda belum memutuskan tentang masa depan Commission ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170715
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170715,
					"content": "Jadi Tuan Muda Kamaji memutuskan untuk bernegosiasi dengan Klan Takatsukasa dan meminta mereka mengambil alih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170716
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170716,
					"content": "Mereka pasti membahas hal penting seperti itu di markas mereka, kan? Kenapa kamu mencari di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170717,
					"content": "Sebenarnya, mereka mengadakannya di tempat lain. Sejujurnya saya juga bingung apa alasannya, tetapi saya rasa tidak sepantasnya mempertanyakan para atasan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170718
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170718,
					"content": "Tempat pertemuannya adalah di gunung dekat Kuil Agung Narukami. Sepengetahuanku Klan Takatsukasa punya semacam markas di sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170719
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170719,
					"content": "Takatsukasa ... nama yang akrab di telinga. Bukankah mereka yang melayani Klan Kujou dengan setia selama bertahun-tahun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170720
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170720,
					"content": "Benar, benar. Itulah kenapa Tuan Muda Kamaji memutuskan untuk berdiskusi dengan mereka. Saya tahu mereka harus membicarakan banyak hal, tapi seharusnya tidak sampai selama ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170721
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170721,
					"content": "Saya sudah mencari ke seluruh kota. Kalau dia benar-benar belum kembali, berarti ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170722,
						120170723
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170722,
					"content": "Mungkin urusan mereka belum selesai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170724
					]
				},
				{
					"id": 120170724,
					"content": "Ya, saya juga sempat berpikir begitu ... tapi dengan jabatan saya, saya tidak diperbolehkan masuk ke wilayah Klan Takatsukasa seenaknya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170725
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170725,
					"content": "Kami bisa bantu memeriksanya ke sana.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170726
					]
				},
				{
					"id": 120170726,
					"content": "Tidak, tidak perlu. Sepertinya saya hanya terlalu khawatir saja. Lagi pula kalau mereka belum selesai, mereka hanya akan menganggapku mengganggu diskusi mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170727
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170727,
					"content": "Saya memang cuma seorang pelayan, tapi saya dan Tuan Muda Kamaji tumbuh besar bersama ... Jangan sampai terjadi sesuatu padanya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170728
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170728,
					"content": "Saya tidak sepintar Tuan Muda, dan tidak bisa menanggung bebannya. Tapi jangan sampai terjadi sesuatu padanya karena saya lalai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170729
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170729,
					"content": "Hmmm. Jadi bagaimana menurutmu, Yang Mulia Shogun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170730
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170730,
					"content": "Kita pergi ke sana untuk memeriksanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170731
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170731,
					"content": "Jika ada aku di sana, mereka tidak akan menyalahkanmu karena mengganggu negosiasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170732
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170732,
					"content": "Selain itu, masalah ini muncul karena aku belum membuat keputusan. Kalau bermula dari diriku, biar aku juga yang menyelesaikannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170733,
						120170734
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170733,
					"content": "Ini baru namanya komitmen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170735
					]
				},
				{
					"id": 120170735,
					"content": "Terima kasih banyak, Yang Mulia! Sementara itu saya akan terus mencari di tempat lain!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170736
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170736,
					"content": "Biar saya tandai lokasi kemah mereka. Semoga semuanya lancar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170734,
					"content": "Mantap, keren.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170735
					]
				},
				{
					"id": 120170723,
					"content": "Mungkin terjadi sesuatu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170724
					]
				}
			]
		},
