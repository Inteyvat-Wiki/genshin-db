					"Ei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120170201,
					"content": "Jadi, uh ... sekarang kita harus bagaimana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170202
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170202,
					"content": "Kami saja yang potret. Kamu tidak usah repot-repot, cukup berdiri di sana dan berpose saja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170203,
					"content": "Sederhananya, foto akan menyimpan gambarmu pada saat itu juga, bisa jadi suvenir yang bagus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170204,
					"content": "Oke, jadi apa maksudnya \"berpose\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170205
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170205,
					"content": "Foto adalah sebuah representasi visual.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170206
					]
				},
				{
					"id": 120170206,
					"content": "Ah, begitu. Jadi dengan kata lain, aku hanya perlu melakukan sesuatu yang enak dipandang saja, begitu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170207
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170207,
					"content": "Semakin dipikirkan, rasanya semakin memalukan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170208
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170208,
					"content": "Baiknya berpose seperti apa ya? Tolong bantu aku. Harus terlihat bagus tapi tidak heboh. Aku sama sekali tidak pandai melakukan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170209,
						120170211,
						120170213
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170209,
					"content": "Coba pose yang anggun dan berkelas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170210
					]
				},
				{
					"id": 120170210,
					"content": "Oke ... Akan kucoba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170215,
						120170216
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170215,
					"content": "Begitu boleh juga.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170218
					]
				},
				{
					"id": 120170218,
					"content": "Oke, kita mulai ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170219
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170219,
					"content": "Ayo cari sudut yang bagus untuk memotretnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170216,
					"content": "Mungkin coba pose lain.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170217
					]
				},
				{
					"id": 120170217,
					"content": "Baiklah, kamu saja yang putuskan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170208
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170211,
					"content": "Coba pose yang tegas dan serius.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170212
					]
				},
				{
					"id": 120170212,
					"content": "Sepertinya kurang cocok dengan gayaku. Apa begini cukup?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170215,
						120170216
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170213,
					"content": "Coba sesuatu yang rileks dan santai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170214
					]
				},
				{
					"id": 120170214,
					"content": "Santai ya ... begini? Rasanya cukup alami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170215,
						120170216
					],
					"speakerTitle": "Ei"
				}
			]
		},
