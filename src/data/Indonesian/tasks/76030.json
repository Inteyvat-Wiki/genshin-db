			"dialogs": [
				{
					"id": 760300301,
					"content": "Cukup nih. Sudah lumayan banyak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300302,
					"content": "Ayo balik. Kasihan lukisannya nunggu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300303,
					"content": "*hiks*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300304
					],
					"speakerTitle": "Rijeka"
				},
				{
					"id": 760300304,
					"content": "Aaah! Cepat sembunyi! Ada yang datang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300305,
					"content": "*hiks* Aku ada di mana ... Mama, aku mau pulang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300306
					],
					"speakerTitle": "Rijeka"
				},
				{
					"id": 760300306,
					"content": "Kayaknya dia salah satu anggota Bani Bulan Embun. Dia nyasar kah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300307,
					"content": "Biar kutolong dia ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760300308
					]
				},
				{
					"id": 760300308,
					"content": "Kamu benar-benar mau menolongnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300309
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760300309,
					"content": "Maksudnya gimana sih? Jelas-jelas dia butuh ditolongin kan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300310,
					"content": "Benar, tapi setahuku Bani Bulan Embun sangat waspada terhadap orang asing. Hari sudah malam, dan di kepalamu tidak ada tanduk. Kalau dia sampai ketakutan dan kabur ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300311
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760300311,
					"content": "Bi-Bisa juga sih, tapi kan enggak bisa ditinggalin juga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300312,
					"content": "Hmmm, ikuti aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300313
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760300313,
					"content": "Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
