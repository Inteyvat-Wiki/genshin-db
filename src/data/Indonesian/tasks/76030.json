			"dialogs": [
				{
					"id": 760300501,
					"content": "*hiks* Eh? Ini ... apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300502
					],
					"speakerTitle": "Rijeka"
				},
				{
					"id": 760300502,
					"content": "Cantik sekali ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300503
					],
					"speakerTitle": "Rijeka"
				},
				{
					"id": 760300503,
					"content": "Harusnya sudah aman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300504
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760300504,
					"content": "Oke deh, jalur batu tadi harusnya bakal bawa dia balik ke Enklave Bulan Embun ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300505,
					"content": "(Columbina bilang kalau dia tidak mau dianggap dewa, tapi dia tetap membantu orang yang dalam kesulitan ....)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760300506
					]
				},
				{
					"id": 760300506,
					"content": "Ah, tapi lukisannya jadi gimana ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300507,
					"content": "Tidak apa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300508
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760300508,
					"content": "Lukisan yang hilang bisa diselesaikan kapan pun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300509
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760300509,
					"content": "Aku suka melihat orang-orang menemukan jalan untuk pulang ke rumah mereka.",
					"roleType": "TALK_ROLE_NPC",
