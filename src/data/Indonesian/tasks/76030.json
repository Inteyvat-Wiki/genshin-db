			"dialogs": [
				{
					"id": 760300101,
					"content": "Hmmm. Suasananya agak beda ya. Kamu ngehias ladang bunganya, Columbina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300102,
					"content": "Bukan aku. Mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300103
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760300103,
					"content": "Mereka ... Kuuhenki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300104,
					"content": "Batu-batu ini akan memancarkan cahaya temaram ketika menyerap kuuvahki. Kuuhenki suka sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300105
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760300105,
					"content": "Terus ... mereka jadiin kelereng? Buat dimainin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300106,
					"content": "Tidak juga. Kemarilah dan lihat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300107
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760300107,
					"content": "Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300108,
					"content": "Ooh! Kalau dari atas, jadi kayak lukisan ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300109,
					"content": "Tapi kurang sepotong tuh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760300110
					]
				},
				{
					"id": 760300110,
					"content": "Iya, tidak cukup. Aku mau cari lagi beberapa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300111
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760300111,
					"content": "Oh? Mau keluar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300112,
					"content": "Aku tahu tempat yang cocok. Disinari bulan, dan banyak batu seperti itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300113
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760300113,
					"content": "Mau ditemani?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760300114
					]
				},
				{
					"id": 760300114,
					"content": "Dengan senang hati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300115
					],
					"speakerTitle": "\"The Damselette\""
				},
				{
					"id": 760300115,
					"content": "Oke, ambil agak banyakan deh. Penasaran hasil akhirnya kayak gimana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
