				{
					"id": 718020401,
					"content": "Kamu masih belum mendapatkan denahnya? Dia di Dwelling in the Clouds...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020402
					],
					"speakerTitle": "Kunjungi tempat tinggal Adeptus"
				},
				{
					"id": 718020402,
					"content": "Hah, bagaimana dia tahu kita belum mendapatkan denahnya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020403
					],
					"speakerTitle": "Paimon"
				},
				{
