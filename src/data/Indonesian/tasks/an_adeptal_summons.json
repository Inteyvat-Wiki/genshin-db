					"nextDialogs": [
						718021021
					]
				},
				{
					"id": 718021021,
					"content": "Yah, kalau begitu habis dapat cetak biru, langsung masuk ke dalam kediaman dan lihat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021022
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718021022,
					"content": "Heh, Paimon penasaran juga sih dia tinggalin mesin kayak gimana di dalam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718021020,
					"content": "Aku lebih khawatir soal cetak birunya sih ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718021021
					]
				},
				{
					"id": 718021017,
					"content": "Mulai ngulang-ngulang kata terakhir tuh ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718021018
					]
				},
				{
					"id": 718021007,
