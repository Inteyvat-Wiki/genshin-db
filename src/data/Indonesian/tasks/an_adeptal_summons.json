			"dialogs": [
				{
					"id": 718021301,
					"content": "Eh ... Apaan nih, di atas meja ada ... satu kotak. Terus enggak ada apa-apa lagi di sampingnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
