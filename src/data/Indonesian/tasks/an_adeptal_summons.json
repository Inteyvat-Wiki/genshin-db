			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 718020301,
					"content": "Segera beri tahu aku ada masalah apa! Masih banyak sekali masalah yang harus kuurus, jangan buang-buang waktuku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020302
					],
					"speakerTitle": "Kunjungi tempat tinggal Adeptus"
				},
				{
					"id": 718020302,
					"content": "Hanya ingin melihat keadaanmu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718020303
					]
				},
				{
					"id": 718020303,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020304
					],
					"speakerTitle": "Kunjungi tempat tinggal Adeptus"
				},
				{
					"id": 718020304,
					"content": "Kamu ini aneh sekali... Kamu benar-benar hanya ingin menanyakan keadaanku? Bukan karena butuh sesuatu dariku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020305
					],
					"speakerTitle": "Kunjungi tempat tinggal Adeptus"
				},
				{
					"id": 718020305,
					"content": "Cukup! Terserah kalian saja, aku tidak tertarik untuk mencoba memahami pemikiran manusia biasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020306
					],
					"speakerTitle": "Kunjungi tempat tinggal Adeptus"
				},
				{
					"id": 718020306,
					"content": "Kalau kalian tidak ada kerjaan sekarang... Maukah membantuku sedikit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020307
					],
					"speakerTitle": "Kunjungi tempat tinggal Adeptus"
				},
				{
					"id": 718020307,
					"content": "Dulu sekali, aku mencoba mempelajari ilmu mekanik dan berhasil membuat Dwelling in the Clouds yang mengapung di langit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020308
					],
					"speakerTitle": "Kunjungi tempat tinggal Adeptus"
				},
				{
					"id": 718020308,
					"content": "Dwelling in the Clouds ini terbuat dari material Plaustrite dan dikombinasikan dengan berbagai teknologi canggih. Teknologi yang menurutku paling hebat adalah...Lupakan saja, kalian juga tidak akan mengerti bila kujelaskan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020309
					],
					"speakerTitle": "Kunjungi tempat tinggal Adeptus"
				},
				{
					"id": 718020309,
					"content": "Setelah aku selesai membangun Dwelling in the Clouds, aku meninggalkan denahnya di sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020310
					],
					"speakerTitle": "Kunjungi tempat tinggal Adeptus"
				},
				{
					"id": 718020310,
					"content": "Aku juga menyegelnya, dan berpikir kalau seseorang ditakdirkan untuk mendapatkannya, mereka akan mendapatkannya. Tapi sudah begitu lama, belum ada yang menyentuhnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020311
					],
					"speakerTitle": "Kunjungi tempat tinggal Adeptus"
				},
				{
					"id": 718020311,
					"content": "Aku juga malas menaruh denah ini di sana, bagaimana kalau kalian pergi ke Dwelling in the Clouds dan ambil denah yang ada di sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020312,
						718020314
					],
					"speakerTitle": "Kunjungi tempat tinggal Adeptus"
				},
				{
					"id": 718020312,
					"content": "Baiklah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718020313
					]
				},
				{
					"id": 718020313,
					"content": "Antusiasme yang luar biasa, kalau begitu cepatlah pergi. Pergilah ke gua setelah kamu menemukannya, karena di situlah aku akan menunggumu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kunjungi tempat tinggal Adeptus"
				},
				{
					"id": 718020314,
					"content": "Apa yang akan kamu lakukan dengan denah itu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718020315
					]
				},
				{
					"id": 718020315,
					"content": "Aku punya alasanku sendiri, dan kamu tidak akan mengerti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020316
					],
					"speakerTitle": "Kunjungi tempat tinggal Adeptus"
				},
				{
					"id": 718020316,
					"content": "Cepatlah pergi. Segera bawa ke gua setelah kamu mendapatkannya, karena di situlah aku akan menunggumu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kunjungi tempat tinggal Adeptus"
				}
			]
		},
