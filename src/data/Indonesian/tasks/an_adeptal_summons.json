					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718021302,
					"content": "Meja Adeptus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718021304
					]
				},
				{
					"id": 718021304,
					"content": "Kalau sudah tiba di sini, diriku sudah tahu niat hatimu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021305
					],
					"speakerTitle": "Cloud Retainer ...?"
				},
				{
					"id": 718021305,
					"content": "Ngomong lagi dia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718021306,
					"content": "Tuliskan keinginanmu, masukkan ke dalam kotak, diriku akan membuat keputusan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021307
					],
					"speakerTitle": "Cloud Retainer ...?"
				},
				{
					"id": 718021307,
					"content": "Menghadapi kesulitan dan bahaya, tekad tak tergoyahkan, keteguhan hati tetap kokoh, hal yang langka sekali. Ambillah pusaka ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021308
					],
					"speakerTitle": "Cloud Retainer ...?"
				},
				{
					"id": 718021308,
					"content": "Wow! Hehe! Paimon tahu kamu pasti enggak mungkin suruh kita pulang dengan tangan kosong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718021309,
					"content": "Tapi, suaranya bilang \"Tuliskan keinginanmu, masukkan ke dalam kotak\" ... Jadi mau tulisin harapan kita ke kotak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021310,
						718021311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718021310,
					"content": "Jangan sembarangan tulis harapan ke Adeptus ya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718021312
					]
				},
				{
					"id": 718021312,
					"content": "Yah, benar juga sih. Kalau kita kenapa-kenapa, ya langsung saja cari si ... Nona Xianyun saja buat diskusi. Hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718021313,
					"content": "Kalau gitu, kita taruh cetak birunya ke dalam kotak, terus kita pergi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718021314,
					"content": "Tapi di sekitar sini sih kosong ya. Harusnya dia yang ambil semua barangnya ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718021315,
					"content": "Sebenarnya mesin ini diciptakan buat apa ya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718021316
					]
				},
				{
					"id": 718021316,
					"content": "Paimon enggak tahu juga sih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718021317,
					"content": "Waktu ketemu dia lain kali, langsung tanyain saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718021311,
					"content": "Soalnya tulis harapan ke orang yang dikenal, kok kayaknya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718021312
					]
				},
