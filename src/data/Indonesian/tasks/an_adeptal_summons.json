			"dialogs": [
				{
					"id": 718021001,
					"content": "Mencari Adeptus ke Jueyun, bukan main-main. Tapi kalian tetap berkunjung ke sini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021002
					],
					"speakerTitle": "Kunjungi tempat tinggal Adeptus",
					"speakerSubtitle": "Suara yang Agak Beda?"
				},
				{
					"id": 718021002,
					"content": "Eh? Bu-Bukannya dia sudah ke Pelabuhan Liyue? Masak sih diam-diam balik ke sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718021003,
					"content": "Suaranya ... kayak aneh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718021004
					]
				},
				{
					"id": 718021004,
					"content": "Uh, Adeptus, kami sih cuma khawatir ada yang nyolong barang di tempatmu ya. Sama sekali enggak ada niat ngeganggu kamu kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718021005,
					"content": "Diriku punya tugas untuk kalian. Jika kalian bisa menyelesaikannya, diriku akan mengizinkan kalian masuk ke kediamanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021006,
						718021007
					],
					"speakerTitle": "Kunjungi tempat tinggal Adeptus",
					"speakerSubtitle": "Suara yang Agak Beda?"
				},
				{
					"id": 718021006,
					"content": "Kayaknya dia ngomong sendiri deh sekarang ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718021008
					]
				},
				{
					"id": 718021008,
					"content": "Eh? Jadi maksudnya yang ngomong sama kita ini bukan Cloud Retainer? Tapi mesin yang dia tinggalkan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718021009,
					"content": "Dulu sekali, diriku mencoba mempelajari ilmu mekanik dan berhasil membuat Dwelling in the Clouds yang mengapung di langit",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021010
					],
					"speakerTitle": "Kunjungi tempat tinggal Adeptus",
					"speakerSubtitle": "Suara yang Agak Beda?"
				},
				{
					"id": 718021010,
					"content": "Dan saat Dwelling in the Clouds-nya selesai, mengingat betapa sulitnya bertemu dengan seorang Adeptus, diriku meninggalkan satu cetak biru di atasnya untuk diambil oleh orang yang ditakdirkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021011
					],
					"speakerTitle": "Kunjungi tempat tinggal Adeptus",
					"speakerSubtitle": "Suara yang Agak Beda?"
				},
				{
					"id": 718021011,
					"content": "Ambillah cetak birunya, lalu masuk ke dalam kediaman diriku untuk membahas lebih lanjut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021012
					],
					"speakerTitle": "Kunjungi tempat tinggal Adeptus",
					"speakerSubtitle": "Suara yang Agak Beda?"
				},
				{
					"id": 718021012,
					"content": "Err ... Bu Adeptus?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718021013
					]
				},
				{
					"id": 718021013,
					"content": "Cloud Retainer? Err ... Nona Xianyun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021014
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718021014,
					"content": "Ambil cetak birunya untuk menyelesaikan tugas ini, lalu masuk ke kediaman diriku untuk melanjutkannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021015
					],
					"speakerTitle": "Kunjungi tempat tinggal Adeptus",
					"speakerSubtitle": "Suara yang Agak Beda?"
				},
				{
					"id": 718021015,
					"content": "Dia sama sekali enggak peduliin kita deh, ngomong sendiri saja dia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021016,
						718021017
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718021016,
					"content": "Pasti mesin deh.",
