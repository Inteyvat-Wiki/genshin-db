			},
			"dialogs": [
				{
					"id": 718020201,
					"content": "Benar, ini benar adalah denah untuk Dwelling in the Clouds yang kubuat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020202
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 718020202,
					"content": "Kamu belum mengatakan apa yang akan kamu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718020203
					]
				},
				{
					"id": 718020203,
					"content": "Kenapa kamu masih bertanya? *huff* Baiklah, melihat usahamu untukku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020204
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 718020204,
					"content": "Aku dengar, manusia biasa di Liyue juga membangun Jade Chamber yang berada di atas Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020205
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 718020205,
					"content": "Aku juga mendengar orang mengatakan bahwa manusia biasa menilai semuanya dari ukuran, dan Jade Chamber ini tidak ada tandingannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020206
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 718020206,
					"content": "Hmm, hanya sebatas inilah wawasan manusia biasa, tidak mampu memahami kehebatan kaum Adeptus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020207
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 718020207,
					"content": "Jade Chamber? Jade Chamber tidak ada apa-apanya dibandingkan mesin ciptaanku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020208
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 718020208,
					"content": "Kamu... tidak mengaku kalah?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718020209
					]
				},
				{
					"id": 718020209,
					"content": "Tidak mengaku kalah? Omong kosong apa itu, aku hanya kasihan pada manusia biasa yang tidak mampu memahami kehebatan kaum Adeptus, mereka begitu mudah kagum akan hal-hal yang biasa saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020210
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 718020210,
					"content": "Aku hanya khawatir manusia-manusia ini akan mengarah ke jalan yang salah bila keadaan terus seperti ini. Sudah menjadi tugasku untuk mengarahkan mereka ke jalan yang benar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020211
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 718020211,
					"content": "Baiklah, masalah ini sudah selesai, cepatlah kalian pergi dari sini dan jangan ganggu aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cloud Retainer"
				}
			]
		},
		{
			"id": 7180203,
			"completionStepIds": [
				7180207
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
