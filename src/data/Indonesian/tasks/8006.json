			"dialogs": [
				{
					"id": 80062201,
					"content": "Sepertinya ... Sudah tidak ada lagi kehidupan yang tersisa di dalam diri para Hilichurl ini. Tidak berapa lama lagi, mereka akan menjadi satu dengan kegelapan.",
					"roleType": "TALK_ROLE_NPC",
