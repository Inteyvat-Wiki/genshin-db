						80062103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80062103,
					"content": "Hmm ... walaupun mereka tidak perlu makan lagi, Paimon yakin mereka pasti kangen sama rasa makanan.",
					"roleType": "TALK_ROLE_NPC",
