					"nextDialogs": [
						80062002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80062002,
					"content": "Tapi Dain jelas-jelas bilang kalau Hilichurl takut pada cahaya di akhir hidup mereka ....?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80062003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80062003,
					"content": "Hmm, apa jangan-jangan mereka cuma mau sekali lagi, buat yang terakhir kalinya, merasakan hangatnya cahaya? Eh, ini cuma perkiraan saja loh ya, mungkin juga ada alasan lain!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
