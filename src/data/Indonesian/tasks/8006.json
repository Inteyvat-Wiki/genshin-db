						80060802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80060802,
					"content": "Kita tidak ada waktu untuk merayakan hal ini. Tampaknya perangkat Abyss Order sudah diaktifkan, tapi kita masih sempat untuk menghancurkannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060803
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060803,
					"content": "Oke! Ayo!",
					"roleType": "TALK_ROLE_NPC",
