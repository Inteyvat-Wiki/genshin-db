			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 80060501,
					"content": "Gimana bisa ada bunga di tempat yang dalam begini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80060502,
					"content": "Apa ada seseorang yang bawa bunga ini untuk para Hilichurl yang sudah mati?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060503,
						80060504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80060503,
					"content": "Aku tahu bunga ini ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060505
					]
				},
				{
					"id": 80060505,
					"content": "Hei, sekarang kamu ngomong gitu, Paimon rasanya juga kenal bunga ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80060506,
					"content": "Ini adalah bunga nasional Khaenri'ah, namanya \"Inteyvat\". Dia pernah mekar di setiap sudut Khaenri'ah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060507
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060507,
					"content": "Waktu mekar bunga ini hanya dua minggu. Kalau dipetik dan dibawa keluar dari tanah Khaenri'ah, kelopak bunganya tidak akan bertumbuh lagi dan berubah menjadi sangat keras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060508
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060508,
					"content": "Saat dibawa pulang kembali ke tanah asalnya, kelopak bunga akan kembali melembut dan akhirnya menghilang dalam debu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060509
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060509,
					"content": "Itulah mengapa Inteyvat adalah simbol pengembara yang jauh dari rumahnya, melambangkan kelembutan akan kampung halamannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060510
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060510,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_Twins2Male|INFO_FEMALE_PRONOUN_Twins2Female]}",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060511
					]
				},
				{
					"id": 80060511,
					"content": "AH! Jadi bunga ini muncul di sini, pasti dibawa sama ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80060512,
					"content": "Yang Mulia ... jadi Anda sudah menyetujuinya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060513
					],
					"speakerTitle": "Abyss Herald"
				},
				{
					"id": 80060513,
					"content": "Dia terlalu fokus dalam berperang melawan \"Prinsip Langit\" hingga melupakan misi aslinya, kebangkitan tanah air.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80060514
					]
				},
				{
					"id": 80060514,
					"content": "Aku harusnya tidak bimbang.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80060515
					]
				},
				{
					"id": 80060515,
					"content": "Perangkat sudah selesai dipasang, kami menunggu perintah Anda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060516
					],
					"speakerTitle": "Abyss Herald"
				},
				{
					"id": 80060516,
					"content": "Berapa tingkat kemungkinan suksesnya?",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80060517
					]
				},
				{
					"id": 80060517,
					"content": "Secara teori ... sekitar—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060518
					],
					"speakerTitle": "Abyss Herald"
				},
				{
					"id": 80060518,
					"content": "Lupakan, meskipun peluangnya hanya satu persen itu sudah cukup ....",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80060519
					]
				},
				{
					"id": 80060519,
					"content": "Sudah begitu lama kita berdiam di Abyss.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80060520
					]
				},
				{
					"id": 80060520,
					"content": "Bagi mereka, lebih baik segera kembali ke siklus alam hidup dan mati secepat mungkin daripada terus hidup seperti sekarang, tanpa martabat sama sekali.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80060521
					]
				},
				{
					"id": 80060521,
					"content": "Jangan biarkan mereka terus membayar ... dosa-dosa tersebut.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80060522
					]
				},
				{
					"id": 80060522,
					"content": "Keputusan Anda adalah berkat bagi Abyss Order.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060523
					],
					"speakerTitle": "Abyss Herald"
				},
				{
					"id": 80060523,
					"content": "#{F#Aether}{M#Lumine} ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060524
					]
				},
				{
					"id": 80060524,
					"content": "Kamu lihat sesuatu, kan? Apa kamu bisa beri tahu aku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060525
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060525,
					"content": "Iya, kamu bengong lama banget loh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060526
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80060526,
					"content": "Kamu memberi tahu Dainsleif apa yang baru saja kamu lihat ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						80060527
					]
				},
				{
					"id": 80060527,
					"content": "Hmm. Yah, orang-orang selalu bilang anak kembar mempunyai koneksi yang spesial ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060528
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060528,
					"content": "Sepertinya mereka mencoba memurnikan kutukan dengan beberapa perangkat, mungkin perangkat yang sama yang pernah kita lihat sebelumnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060529
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060529,
					"content": "Dan ... kamu bilang dia juga menyebutkan \"memulihkan tanah air\", benar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060530,
						80060531
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060530,
					"content": "Benar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060532
					]
				},
				{
					"id": 80060532,
					"content": "Tidak heran. Dia masih keras kepala seperti biasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060533
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060533,
					"content": "Tampaknya Abyss Order berencana menggunakan tempat ini untuk memurnikan kutukan Hilichurl dan membangkitkan kembali mereka seperti dulu ... lalu, mereka akan menjadi dasar untuk memulihkan kembali Khaenri'ah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060534
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060534,
					"content": "Lagi pula, tidak akan ada \"negara\" tanpa \"rakyat\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060535,
						80060536
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060535,
					"content": "Bagaimana menurutmu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060537
					]
				},
				{
					"id": 80060537,
					"content": "Huh, dasar bodoh. Peluang berhasil satu persen saja tidak ada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060538
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060538,
					"content": "Aku sudah pernah bilang, tidak ada yang mengenal kutukan ini lebih baik daripada aku yang sudah hidup dengan kutukan ini selama 500 tahun ... tidak ada penebusan apa pun. Kutukan ini tidak dapat diubah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060539
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060539,
					"content": "Kalau kamu menghapus kutukan secara paksa, kamu tidak akan mendapatkan apa pun selain rasa sakit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060540
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060540,
					"content": "Jadi, tetaplah sadar dan ingatkan diri sendiri. Mereka itu sudah bukan manusia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060541
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060541,
					"content": "Berpegang teguh dalam pemikiran seperti ini dan menanamkan emosi di dalamnya hanya akan membuatmu tenggelam semakin dalam ... sampai kamu berakhir seperti mereka, tenggelam dalam kemunafikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060542
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060542,
					"content": "Sebaiknya fokus saja pada sesuatu yang layak untuk diselamatkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060543
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060543,
					"content": "Kenapa aku harus percaya padamu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060544
					]
				},
				{
					"id": 80060544,
					"content": "Mm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060545
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060545,
					"content": "Haha ... benar juga. Aku hanyalah orang yang kamu sewa untuk menjalankan sebuah tugas. Sedangkan dia adalah saudara kandungmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060546
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060546,
					"content": "Wajar kalau kamu memilih untuk percaya padanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060547
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060547,
					"content": "Apa pun pilihanmu tidak akan memengaruhi diriku. Menghentikan Abyss Order adalah jalan yang telah kupilih. Kalau kita tidak memiliki tujuan yang sama, maka mungkin inilah saatnya kita—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060548
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060548,
					"content": "Aku memilih untuk percaya padamu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060549,
						80060550
					]
				},
				{
					"id": 80060549,
					"content": "Tapi bukan berarti aku percaya sepenuhnya padamu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060551
					]
				},
				{
					"id": 80060551,
					"content": "Begitu ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060552,
						80060553
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060552,
					"content": "Satu persen kemungkinan mendapatkan penebusan ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060554,
						80060555
					]
				},
				{
					"id": 80060554,
					"content": "Tidak ada orang yang berhak untuk ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060556,
						80060557
					]
				},
				{
					"id": 80060556,
					"content": "Terutama di saat para Hilichurl itu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060558
					]
				},
				{
					"id": 80060558,
					"content": "Kelihatannya, tiga pertanyaan yang kuajukan di awal tidak di sia-sia. Kamu telah menemukan caramu sendiri untuk melihat dunia ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060559
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060559,
					"content": "Setelah kamu mengungkapkan pikiranmu yang sebenarnya, aku juga tidak ingin terus menyembunyikan pikiranku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060560
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060560,
					"content": "Saat ini, selain menghentikan Abyss Order, aku juga punya tujuan yang lebih penting ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060561
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060561,
					"content": "Aku tidak boleh membiarkan Abyss Order menginjak-injak kehendak Halfdan dan kesatria lainnya. Aku tidak boleh membiarkan ini terus menerus berlanjut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060562,
						80060563
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060562,
					"content": "Aku paham.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060564
					]
				},
				{
					"id": 80060564,
					"content": "Abyss Order dapat muncul kapan saja, kita harus tetap waspada dan bergerak maju.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060563,
					"content": "Mari kita tetap bekerja sama.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060564
					]
				},
				{
					"id": 80060557,
					"content": "Mereka sudah membuat keputusan untuk takdir mereka sendiri.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060558
					]
				},
				{
					"id": 80060555,
					"content": "Membuat keputusan semacam ini atas nama makhluk hidup lain.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060556,
						80060557
					]
				},
				{
					"id": 80060553,
					"content": "Dibandingkan 99% kemungkinan akan menderita dan mati.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060554,
						80060555
					]
				},
				{
					"id": 80060550,
					"content": "#Hanya saja aku tidak setuju dengan metode yang dilakukan oleh {F#kakakku}{M#adikku}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060551
					]
				},
				{
					"id": 80060536,
					"content": "Apa ada peluang untuk mewujudkannya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060537
					]
				},
				{
					"id": 80060531,
					"content": "Dia bilang itu adalah misinya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060532
					]
				},
				{
					"id": 80060504,
					"content": "Aku pernah lihat bunga ini sebelumnya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060505
					]
				}
			]
		},
		{
			"id": 800606,
