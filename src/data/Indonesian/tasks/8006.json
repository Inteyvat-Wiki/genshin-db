			"dialogs": [
				{
					"id": 80060601,
					"content": "Kita bisa lihat kota yang terbalik dari sini juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80060602,
					"content": "Tunggu ... Hati-hati!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060603
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060603,
					"content": "AAAAAAH!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80060604,
					"content": "A-Ada apa! Apa itu cahaya dari ruangan di tengah itu? Aduh, silau banget!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80060605,
					"content": "Mutasinya masih berlanjut ... apa Abyss Order sudah bergerak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060606
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060606,
					"content": "#Dainsleif ... Kamu masih saja suka ikut campur, dan sekali lagi kamu malah bekerja sama dengan saudara kandung {M#Putri}{F#Pangeran} ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060607
					],
					"speakerTitle": "Abyss Herald"
				},
				{
					"id": 80060607,
					"content": "Sungguh disesalkan, aku tidak ada waktu untuk mengendalikan jalur keluarmu dari jaringan kami ... dan kamu jadi ada di sini. Huh, ini adalah kesalahan yang fatal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060608
					],
					"speakerTitle": "Abyss Herald"
				},
				{
					"id": 80060608,
					"content": "Huh! Aku kaget juga kamu berani bicara begitu padaku. Kamu cuma seorang pengecut yang terus menerus lari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060609
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060609,
					"content": "#Kehendak {M#Putri}{F#Pangeran} harus dipenuhi, aku akan membereskan semua rintangan ... bagaimanapun caranya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060610
					],
					"speakerTitle": "Abyss Herald"
				},
				{
					"id": 80060610,
					"content": "Kali ini ... kutukan yang menyiksa penduduk harus dibersihkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060611
					],
					"speakerTitle": "Abyss Herald"
				},
				{
					"id": 80060611,
					"content": "Justru kalian yang menyiksa mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060612
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060612,
					"content": "Tidak ada yang tersisa di tubuh para Hilichurl itu selain kutukan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060613
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060613,
					"content": "Kalau begitu, kemarilah. Aku tidak akan kabur, Dainsleif.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060614
					],
					"speakerTitle": "Abyss Herald"
				},
				{
					"id": 80060614,
					"content": "Apa pantas menggunakan hidupmu untuk mengulur waktu demi tujuan yang konyol ini? Tapi karena kamu bersikeras, aku akan memenuhi keinginanmu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				}
			]
		},
