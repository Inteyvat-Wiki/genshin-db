			},
			"dialogs": [
				{
					"id": 80060401,
					"content": "Ada beberapa kemah Hilichurl yang sederhana ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80060402,
					"content": "Di sini juga ada Hilichurl yang sudah dalam kondisi parah. Beberapa dari mereka kelihatannya sudah ... mencapai napas terakhirnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80060403,
					"content": "Apa ini yang mau Halfdan perlihatkan ke kita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80060404,
					"content": "Entah benar atau tidak, semua yang ada di sini layak untuk diselidiki dengan detail. Kita harus selidiki area ini dan jangan sampai ada yang terlewat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				}
			]
		},
		{
			"id": 800605,
			"completionStepIds": [
				800605,
				800609,
				800610,
				800611
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
