			},
			"dialogs": [
				{
					"id": 200170101,
					"content": "Jangan, jangan pukul aku! Tidak...eh? Pengembara, mana mereka? Apa kamu sudah mengusirnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170102
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 200170102,
					"content": "Untunglah! Terima kasih banyak... Apa mereka benar-benar sudah pergi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170103
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 200170103,
					"content": "Hah... terima kasih banyak, tapi setelah adanya masalah tadi, aku jadi tidak bisa mengikuti rombongan karavan lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170104
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 200170104,
					"content": "Apalagi, gerobakku rusak. Aku harus memperbaikinya dan pergi ke kota sebelum buah-buah ini membusuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170105
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 200170105,
					"content": "Kamu tidak tahu ya, jika banyak buah membusuk di dalam gerobak, baunya sulit untuk dihilangkan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170106
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 200170106,
					"content": "Aku harus mengambil persediaan lagi, dan aku sudah bisa mencium beberapa buah yang sepertinya sekarang sudah mulai membusuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170107
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 200170107,
					"content": "Bisakah kamu membatuku memeriksa sekeliling dan mencari bahan untuk memperbaiki gerobakku? <color=#00E1FFFF>Papan Kayu Kokoh</color> saja seharusnya sudah cukup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Farrah"
				}
			]
		},
		{
			"id": 2001702,
			"completionStepIds": [],
