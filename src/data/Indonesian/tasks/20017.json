			"dialogs": [
				{
					"id": 200170401,
					"content": "Sungguh terima kasih banyak, Pengembara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170402
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 200170402,
					"content": "Namun, sepertinya mereka tidak ingin pergi, sebaiknya aku cepat-cepat pergi dari sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170403
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 200170403,
					"content": "Tadi hampir saja aku berhasil memperbaikinya, tapi mereka merusaknya lagi. Memang sepertinya tidak mungkin untuk memperbaiki seutuhnya. Ah sudahlah, mungkin aku bisa menggunakan tali, eh, ke mana talinya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170404
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 200170404,
					"content": "Celaka, pasti monster-monster tadi membuang talinya entah ke mana. Pengembara, tolong bantu aku mencari <color=#00E1FFFF>tali</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Farrah"
				}
			]
		},
