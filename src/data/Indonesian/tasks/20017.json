			"dialogs": [
				{
					"id": 200170301,
					"content": "Ini cukup, aku akan mencuci tangan dulu lalu segera memperbaiki gerobak ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170302
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 200170302,
					"content": "Eh? Me-mereka datang lagi, Pengembara! Mereka datang lagi!",
