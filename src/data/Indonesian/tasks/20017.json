			"dialogs": [
				{
					"id": 200170201,
					"content": "Seharusnya ada beberapa <color=#00E1FFFF>Papan Kayu Kokoh</color> di dalam hutan, tolonglah! Jika dibiarkan lebih lama lagi, semuanya akan membusuk!",
					"roleType": "TALK_ROLE_NPC",
