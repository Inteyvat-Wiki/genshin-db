					"nextDialogs": [
						221120303
					]
				},
				{
					"id": 221120303,
					"content": "Coba aku lihat... Ya, jumlahnya sudah cukup. Terima kasih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120304
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120304,
					"content": "Aku akan segera bekerja. Tangga ini harus diperbaiki secepat mungkin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
