					"nextDialogs": [
						221120203
					]
				},
				{
					"id": 221120203,
					"content": "Wooden Plank terletak di luar, seharusnya mereka mudah ditemukan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120204
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120204,
					"content": "Pergi dan carilah Wooden Plank untukku. Aku akan menunggu di sini agar tidak ada yang terluka saat menaiki tangga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
