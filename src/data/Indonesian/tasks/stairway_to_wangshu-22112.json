			"dialogs": [
				{
					"id": 221120501,
					"content": "Dengan begini, tangga ini sudah bisa dinaiki tanpa perlu takut ada orang yang terjatuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120502
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120502,
					"content": "Tapi sepertinya kurang cocok...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221120503
					]
				},
				{
					"id": 221120503,
					"content": "Kurang cocok? Mau bagaimana lagi? Aku bukan tukang kayu profesional.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120504
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120504,
					"content": "Tunggu... Ini baru satu yang diperbaiki. Masih ada lubang lain yang perlu diperbaiki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120505
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120505,
					"content": "Perbaikan hari ini cukup sampai di sini saja. Penginapan masih buka dan aku harus kembali melayani para tamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120506
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120506,
					"content": "Walaupun tangga perlu diperbaiki, tapi usaha juga tetap harus dijalankan... Terima kasih atas bantuanmu. Ambillah ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				}
			]
