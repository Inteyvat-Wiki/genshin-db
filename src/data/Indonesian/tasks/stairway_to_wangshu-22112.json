					"Huai'an"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221120101,
					"content": "Sepertinya perlu diperbaiki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120102
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120102,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221120103
					]
				},
				{
					"id": 221120103,
					"content": "Oh, ternyata kamu. Lihatlah, tangga ini rusak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120104
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120104,
					"content": "Lihatlah bagian tangga yang rusak ini. Seseorang pasti akan terjatuh bila menaikinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120105
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120105,
					"content": "Kenapa bisa rusak? Beberapa waktu yang lalu ada sekelompok monster mencoba untuk masuk. Akulah yang keluar untuk mengatasi mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120106
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120106,
					"content": "Aku seharusnya menarik kembali tinjuku... Aku meninju seekor monster besar hingga terlontar ke arah tangga. Akibatnya, tangga ini pun rusak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120107
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120107,
					"content": "Aku berniat ingin memperbaikinya, tapi aku belum menemukan waktu untuk melakukannya. Tamu di penginapan semakin hari semakin banyak. Karena itu, tangga ini harus segera diperbaiki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120108
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120108,
					"content": "Ini bukanlah pekerjaan yang sulit. Aku dapat memperbaikinya sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120109
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120109,
					"content": "Kalau kamu ada waktu, apa kamu bisa membantuku mengambil beberapa Wooden Plank untukku? Aku akan menunggu di sini agar tidak ada yang terluka saat menaiki tangga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120110,
						221120113
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120110,
					"content": "Baiklah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221120111
					]
				},
				{
					"id": 221120111,
					"content": "Bagus. Aku sebenarnya sudah membeli Wooden Plank. Kutempatkan mereka di area luar penginapan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120112
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120112,
					"content": "Carilah dan bawakan beberapa potong untukku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120113,
					"content": "Apakah tangganya akan rusak lagi setelah diperbaiki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221120114
					]
				},
				{
					"id": 221120114,
					"content": "Itu tidak akan terjadi. Aku sudah tua dan aku yakin aku bisa menahan diri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120115
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120115,
					"content": "Tidak peduli apa pun yang terjadi, tangga ini harus diperbaiki dahulu. Aku sudah membeli Wooden Plank. Kutempatkan mereka di area luar penginapan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120116
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120116,
					"content": "Carilah dan bawakan beberapa potong untukku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				}
			]
		},
