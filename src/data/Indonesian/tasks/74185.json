			"dialogs": [
				{
					"id": 741850101,
					"content": "Este, kami sudah balik nih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850102,
					"content": "Oh, kalian ... eh? Siapa ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850103
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741850103,
					"content": "#HA? Masa sudah lupa lagi sih! {NICKNAME} dan Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850104,
					"content": "#{NICKNAME} dan Paimon ... aku pernah dengar nama ini, tapi di dalam mimpi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850105
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741850105,
					"content": "Loh, tapi tempo hari kan Om Este jelas-jelas lagi sadar! Terus waktu di bawah sana kan juga ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850106,
					"content": "Aku ... mimpi orang sekota ini berubah jadi patung batu, dan menyisakan aku sendiri yang tidak berdaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850107
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741850107,
					"content": "Sampai akhirnya datang dua pahlawan gagah berani yang menyelamatkan semua orang ... apa itu bukan mimpi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850108,
						741850109
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741850108,
					"content": "Mungkin ya, mungkin tidak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741850110
					]
				},
				{
					"id": 741850110,
					"content": "Ya. Semua orang sudah balik normal lagi kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850111,
					"content": "Tapi sepertinya semua orang mimpi yang aneh. Ada apa sebenarnya? Apa kita semua kena hipnotis?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850112
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741850112,
					"content": "Duh, kalau mau dijelasin bisa enggak habis-habis nih ceritanya ... sudah, lupain saja dulu soal hipnotis!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850113,
					"content": "Oh? Bicara hipnotis, kalian juga bawa kucing rupanya! Kelihatannya dia anak pintar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850114,
						741850116
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741850114,
					"content": "Lebih pintar dari kelihatannya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741850115
					]
				},
				{
					"id": 741850115,
					"content": "Dan dia ini teman kami! Sayangnya, dia enggak bisa ikut kami bertualang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850118,
					"content": "Kebetulan yang luar biasa sekali ya. Klub kami punya tempat kosong untuk kucing. Bekas kucingnya si peneliti hipnotis itu dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850119
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741850119,
					"content": "Kalau kalian bersedia, tinggalkan saja dia di sini. Biar kami yang pelihara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850120
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741850120,
					"content": "Aku tidak tahu kenapa, tapi kok rasanya kita memang sudah ditakdirkan bersama. Pokoknya aku akan pelihara dia baik-baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850121
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741850121,
					"content": "Kandang kucingnya ada di sisi lain gedung. Jalan saja ke sana, nanti juga kelihatan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Este"
				},
				{
					"id": 741850116,
					"content": "Dia rekan kami.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741850117
					]
				},
				{
					"id": 741850117,
					"content": "Betul, tapi dia enggak bisa ikut kami bertualang terus ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850109,
					"content": "Tapi itu tidak penting.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741850110
					]
				}
			]
		},
