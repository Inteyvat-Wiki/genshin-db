			"dialogs": [
				{
					"id": 401930201,
					"content": "Kamu mengalah karena terus dipaksa Itto dan akhirnya kalian semua pergi ke Aisa Bathhouse sekali lagi ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401930202
					]
				},
				{
					"id": 401930202,
					"content": "Hahaha! Ini pasti yang paling panas nih! Ayo kita adu siapa yang bisa bertahan paling lama!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930203
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401930203,
					"content": "Hehe, kalau kamu semangat begitu, aku mana bisa tolak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930204
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 401930204,
					"content": "Hei ... Ini bukan sauna ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930205
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401930205,
					"content": "Ahh ... hangatnya .... *grook fyuhh*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930206
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 401930206,
					"content": "Hei, jangan ketiduran di kolam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401930207,
					"content": "Uh ... Buluku berat deh. Jadi pusing ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930208
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 401930208,
					"content": "Hahaha! Gorou, kalau panas segini saja enggak kuat mending keluar dari ... kolam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930209
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401930209,
					"content": "Hei! Jangan berisik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930210
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 401930210,
					"content": "Di sisi lain ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401930211
					]
				},
				{
					"id": 401930211,
					"content": "Itto semangat sekali ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930212
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401930212,
					"content": "Hei bro, kalau lagi tanding jangan sampai pecah konsentrasinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930213
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 401930213,
					"content": "#Wow! Kompetisinya jadi makin seru nih! Bagaimana, {NICKNAME}? Gimana menurutmu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930214
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 401930214,
					"content": "Hm ... Pelan-pelan saja, aku mau mempertahankan keunggulanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930215
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 401930215,
					"content": "Atau, kamu bisa saja jadi agresif ... sekali-sekali ambil risiko juga ide bagus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930216,
						401930217
					],
					"speakerTitle": "Shikanoin Heizou"
				},
				{
					"id": 401930216,
					"content": "(Pelan tapi pasti)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401930218
					]
				},
				{
					"id": 401930218,
					"content": "#Oh? Pintar juga, {NICKNAME}! Kekalahanku memang sudah ditakdirkan ya ... Aku menyerah! Nah, berdasarkan urutan undian sebelumnya, pemain selanjutnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930219
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401930219,
					"content": "Ayaka! Nah kalian, selamat bersenang-senang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930220
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401930220,
					"content": "#Oh, uh ... Oke! Mohon bantuannya ya, {NICKNAME} ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930221
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 401930221,
					"content": "(Ayato pasti sengaja mengalah supaya Ayaka punya waktu lebih buat main ... Dia itu memang banyak akal ya ....)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 401930217,
					"content": "(AGRESIF!!!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401930218
					]
				}
