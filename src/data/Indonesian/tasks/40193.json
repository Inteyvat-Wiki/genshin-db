			"dialogs": [
				{
					"id": 401930101,
					"content": "Ah, bro! Aku dengar kalian ke Aisa Bathhouse semalam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930102
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401930102,
					"content": "Aku kumpulin dulu para anggotanya terus nanti kita mau pesta! Kalian ikut, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930103
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401930103,
					"content": "Tapi, kami baru dari sana loh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401930104,
					"content": "Eh, yah ... Tapi pasti ada kurang beberapa orang, kan? Kayak Shinobu ... Gorou ... terus juga ... Ayato ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930105
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401930105,
					"content": "Jadi intinya Bos dengar soal jalan-jalannya, terus sekarang dia mau ikutan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930106
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401930106,
					"content": "Ih enggak ya! Pokoknya kalau sudah beres langsung cari aku, kita BAKALAN! BERENDAM! BARENG! TITIK!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				}
			]
