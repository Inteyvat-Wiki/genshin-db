					"nextDialogs": [
						401930303
					],
					"speakerTitle": "Aikawa Susumu"
				},
				{
					"id": 401930303,
					"content": "Kabar bagus tuh! Mungkin bulan ini kita bisa melebihi Yae Publishing House ....",
