			},
			"dialogs": [
				{
					"id": 200310401,
					"content": "#Hei, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310402
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310402,
					"content": "Aku dengar kamu telah menyelesaikan <color=#00E1FFFF>misi</color>. Klien memintaku menyampaikan rasa terima kasihnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310403,
						200310406
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310403,
					"content": "Misi apa? Aku tidak ingat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310404
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310404,
					"content": "Kamu menolong seseorang saat dalam perjalanan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310405
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310405,
					"content": "Sebenarnya banyak dari mereka yang kamu temui sebelumnya telah meminta Guild untuk membantu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310408
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310408,
					"content": "Biar kujelaskan padamu sistem Guild kami dengan lebih terperinci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310409
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310409,
					"content": "Guild menerima banyak permintaan dari berbagai tempat setiap hari dan bertanggung jawab untuk mendistribusikan misi tersebut kepada para petualang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310410
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310410,
					"content": "Ini juga merupakan sumber utama untuk mendapatkan hadiah bagi para petualang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310411
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310411,
					"content": "Mengenai hadiah, harus kukatakan bahwa Guild juga menyiapkan hadiah kejutan untukmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310406,
					"content": "Aku hanya kebetulan melihatnya di jalan dan membantu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310407
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310407,
					"content": "Itulah sebabnya kamu adalah petualang baru favorit kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310408
					],
					"speakerTitle": "Katheryne"
				}
			]
		},
