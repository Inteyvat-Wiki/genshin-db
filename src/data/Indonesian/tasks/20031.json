							"1"
						]
					},
					{
						"type": "QUEST_COND_DAILY_TASK_REWARD_RECEIVED",
						"rawParams": [
							"1"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200310501,
					"content": "Oh, tidak perlu sungkan begitu. Tapi boleh juga sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200310502,
					"content": "Ini tanda terima kasih dari Adventurers' Guild.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310503
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310503,
					"content": "Kami menerima banyak misi setiap hari, dan jika bukan karena usaha dari para petualang, kami tidak mungkin bisa menyelesaikan semua itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310504
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310504,
					"content": "Setelah kamu menyelesaikan sejumlah misi setiap hari, kamu bisa mendapatkan hadiah tambahan dariku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310505
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310505,
					"content": "Panduan Petualang akan mencatat jumlah misi yang telah kamu selesaikan setiap harinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310506
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310506,
					"content": "Pastikan kamu mengambil hadiah harianmu setelah menyelesaikan sejumlah misi. Karena jumlahnya terbatas, kamu akan kehilangan hadiah itu jika tidak segera mengambilnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310507,
						200310509
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310507,
					"content": "Aku mengerti, terima kasih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310508
					]
				},
				{
					"id": 200310508,
					"content": "Tak masalah, terima kasih kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310512
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310512,
					"content": "Oh iya, jika kamu membantu petualang lain untuk menyelesaikan misi, maka kamu juga akan berhak mendapatkan hadiah harian tersebut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310513
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310513,
					"content": "Jadi jangan ragu untuk membantu sesama petualang! Ad astra abyssosque!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310509,
					"content": "Hanya satu hadiah setiap harinya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310510
					]
				},
				{
					"id": 200310510,
					"content": "Dengan kondisi seperti sekarang ini... iya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310511
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310511,
					"content": "Tapi tenanglah, kami selalu mendesak markas besar untuk memberikan kompensasi yang layak dan memadai bagi para petualang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310512
					],
					"speakerTitle": "Katheryne"
				}
			]
		},
