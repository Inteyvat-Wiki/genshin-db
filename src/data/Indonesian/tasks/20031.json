			},
			"dialogs": [
				{
					"id": 200310101,
					"content": "Kita bertemu lagi, petualang pemberani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310102,
					"content": "Bagaimana, apa petualanganmu berjalan dengan lancar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310103,
						200310105
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310103,
					"content": "Ya, lancar-lancar saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310104
					]
				},
				{
					"id": 200310104,
					"content": "Bagus sekali, ingatlah untuk terus bersemangat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310107
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310107,
					"content": "Sepertinya kamu sudah mempunyai banyak pengalaman. Sekarang saatnya memperkenalkanmu pada pekerjaan penting di Guild.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310108
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310108,
					"content": "Guild menerima banyak permintaan dari berbagai tempat setiap harinya dan bertanggung jawab untuk mendistribusikan <color=#00E1FFFF>misi</color> tersebut kepada para petualang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310109
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310109,
					"content": "Ini juga merupakan sumber utama untuk mendapatkan hadiah bagi para petualang kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310110
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310110,
					"content": "Misi seperti apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200310111,
					"content": "Berbagai macam misi ada di sini, dari membantu orang sampai membasmi monster. Beberapa misi mungkin sepele tapi beberapa misi bisa sangat berbahaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310112
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310112,
					"content": "Tapi bagaimanapun juga, kamu harus melihatnya sendiri baru kamu mengerti maksudku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310113
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310113,
					"content": "Berikut adalah rincian misi hari ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310114
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310114,
					"content": "Silakan melapor kembali padaku setelah menyelesaikan misi. Akan ada hadiah menarik menantimu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310115,
						200310117
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310115,
					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310116
					]
				},
				{
					"id": 200310116,
					"content": "#Bagus sekali {NICKNAME}, aku tahu kamu bisa diandalkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310119
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310119,
					"content": "#Aku akan menunggumu kembali, {NICKNAME}. Ad astra abyssosque!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310117,
					"content": "Seberapa menarik?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310118
					]
				},
				{
					"id": 200310118,
					"content": "Bersabarlah, kamu akan tahu saat melihatnya sendiri, kamu pasti tidak akan kecewa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310119
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310105,
					"content": "Agak melelahkan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310106
					]
				},
				{
					"id": 200310106,
					"content": "Semua orang selalu begitu pada awalnya. Persiapan yang matang sebelum memulai sebuah petualangan akan sangat membantu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310107
					],
					"speakerTitle": "Katheryne"
				}
			]
		},
