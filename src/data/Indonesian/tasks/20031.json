			},
			"dialogs": [
				{
					"id": 200310201,
					"content": "#Bagus sekali, {NICKNAME}! Benar-benar luar biasa bagi orang yang baru pertama kali melakukannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310202
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310202,
					"content": "Bahkan klienku sendiri memintaku untuk berterima kasih padamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310203
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310203,
					"content": "Oke, ini hadiah yang kujanjikan untukmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				}
			]
		},
