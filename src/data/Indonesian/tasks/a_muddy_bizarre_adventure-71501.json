			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hosseini"
				],
				"points": [
					{
						"sceneId": 6,
						"position": [
							1007.447,
							1015.942,
							879.091
						],
						"pointId": 600100139
					},
					{
						"sceneId": 6,
						"position": [
							1006.518,
							1015.976,
							880.314
						],
						"pointId": 600100246
					}
				]
			},
			"dialogs": [
				{
					"id": 715010201,
					"content": "Aku tidak sangka kalau lingkungan di sini begitu unik. Kalau keadaannya begini, sistem energi Pursina's Spike ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010202
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010202,
					"content": "#Hmm? {NICKNAME} dan Paimon, lama tidak jumpa, ada urusan apa kalian datang ke Chasm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010203
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010203,
					"content": "Oh betul juga, aku pernah dengar Khedive bilang kamu sudah banyak bantu regu penjelajahan Chasm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010204
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010204,
					"content": "Namun, situasi di Chasm sekarang jauh lebih parah dan bahaya dibanding sebelumnya. Tempat ini bukan tempat ideal buat jalan-jalan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010205
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010205,
					"content": "Kamu ...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715010206
					]
				},
				{
					"id": 715010206,
					"content": "Lah, kita kan ketemu belum lama ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010207
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010207,
					"content": "Iya sih, setiap kali ketemu aku sering repotin kamu, tapi tidak perlu sampai pura-pura tidak kenal gitu dong ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010208
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010208,
					"content": "Sudahlah, aku perkenalkan diriku sekali lagi, aku Hosseini, peneliti dari Sumeru Akademiya, yang sebelumnya meneliti Cakram Pengetahuan, yang pernah sampai ke Inazuma hanya demi bahan referensi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010209
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010209,
					"content": "Namun dana penelitianku sudah habis, dan sekarang mau tidak mau harus pulang ke Sumeru ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010210
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010210,
					"content": "Oh, kayaknya Paimon ingat deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 715010211,
					"content": "Kamu ingat aku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010212
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010212,
					"content": "Kamu si Orang Cakram!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 715010213,
					"content": "Kapan aku pernah perkenalkan diri kayak gitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010214
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010214,
					"content": "Sudahlah, intinya aku menerima permintaan dari sesama pelajar Akademiya yang bernama Khedive. Aku punya utang budi padanya karena urusan dana penelitian dulu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010215
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010215,
					"content": "Jadi, aku ada di Chasm buat bantu dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010216
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010216,
					"content": "Semoga penjelasan barusan sudah cukup jelas. Nah, kalian sendiri kenapa bisa ada di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010217,
						715010218
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010217,
					"content": "Kami ambil misi dari Khedive.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715010219
					]
				},
				{
					"id": 715010219,
					"content": "Ohh, jadi ternyata kalian ya yang dikirim! Aku sudah cemas waktu Khedive bilang dia mau kirim orang buat bantu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010220
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010220,
					"content": "Untungnya kalian yang datang. Aku bisa lega.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010221
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010221,
					"content": "Perlu kuakui, kalau aku sendirian saja mencoba mengatasi masalah lumpur hitam Chasm ini, akan banyak makan waktu dan tenaga. Tapi kalau kamu yang turun tangan ... kemungkinan berhasilnya jadi lebih tinggi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010222
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010222,
					"content": "Kami harus ngapain nih?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715010223
					]
				},
				{
					"id": 715010223,
					"content": "Kamu sudah tahu tentang Pursina's Spike kan? Itu alat yang bisa melepaskan energi untuk mengganggu arus Ley Line.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010224
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010224,
					"content": "Menurut hipotesa, kalau kita simpan Pursina's Spike di titik-titik tempat lumpur hitam itu keluar, kita bisa memengaruhi aliran Ley Line dan membersihkan lumpurnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010225
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010225,
					"content": "Memangnya Ley Line sama lumpur hitam ada hubungannya ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 715010226,
					"content": "Lumpurnya muncul jika ada ketidakwajaran pada aliran Ley Line, jadi sangat mungkin kalau keduanya saling berhubungan. Begitu sih hasil diskusiku dengan Khedive.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010227
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010227,
					"content": "Jadi kita bisa pakai Pursina's Spike untuk mengacaukan, atau bahkan menutup bukaan Ley Line. Dan lumpur hitamnya pun akan berhenti keluar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010228
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010228,
					"content": "Begitu ya ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715010229
					]
				},
				{
					"id": 715010229,
