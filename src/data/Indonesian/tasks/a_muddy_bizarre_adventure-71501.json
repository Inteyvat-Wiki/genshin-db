				]
			},
			"dialogs": [
				{
					"id": 715010101,
					"content": "Hmmm ... Dua hari ini situasinya jadi makin parah, regu penjelajahan juga jadi terhambat pergerakannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 715010102,
					"content": "Siapa yang bisa diminta mengurus misi ini ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010103,
						715010104
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 715010103,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715010105
					]
				},
				{
					"id": 715010105,
					"content": "#Ah, {NICKNAME} dan Paimon, kalian datang tepat waktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010106
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 715010106,
					"content": "Tepat waktu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 715010107,
					"content": "Kayaknya ada masalah nih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 715010108,
					"content": "Karena alasan yang belum diketahui, akhir-akhir ini ada zat hitam aneh mirip lumpur mengalir keluar dari gua dan tambang di Chasm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010109
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 715010109,
					"content": "Kejadiannya tiba-tiba, regu penjelajahan juga belum menemukan cara yang tepat untuk mengatasinya. Penyelidikan di sana sudah mulai dan berhenti berkali-berkali. Khedive pun akhirnya minta bala bantuan ke Adventurers' Guild ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010110
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 715010110,
					"content": "Ah? Lumpur hitam? Bukannya itu yang ada di bawah Chasm ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 715010111,
					"content": "Benar, itu lumpur hitam yang kumaksud, aku tidak tahu kenapa benda itu bisa sampai ke area tambang. Pekerjaan regu penjelajahan jadi terhambat, bahkan kegiatan sehari-hari mereka juga mulai terpengaruh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010112
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 715010112,
					"content": "Lagi pula, hampir semua sumber daya dan material diangkut lewat terowongan tambang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010113
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 715010113,
					"content": "Situasi ini sudah berapa lama?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715010114
					]
				},
				{
					"id": 715010114,
					"content": "Sudah lumayan lama. Khedive bilang ada peneliti dari Sumeru yang bisa bantu, tapi ternyata malah dianya sendiri yang butuh bantuan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010115
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 715010115,
					"content": "Aku dibuat cukup pusing karena masalah ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010116
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 715010116,
					"content": "Khedive! Kalau misinya dari dia, duitnya pasti oke tuh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 715010117,
					"content": "Belum ada sukarelawan yang mau ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 715010118,
					"content": "Sayangnya belum. Kurasa karena lumpur hitam itu kan sangat berbahaya. Sebenarnya cukup banyak orang yang datang karena tergiur bayarannya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010119
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 715010119,
					"content": "Tapi begitu dengar kata \"Chasm\", mereka langsung mundur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010120
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 715010120,
					"content": "Sebagian besar petualang juga tidak terlalu paham jalur-jalur akses di Chasm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010121
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 715010121,
					"content": "Yang bisa terima misi ini cuma orang yang tidak takut bahaya dan sangat hafal Chasm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010122
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 715010122,
					"content": "Dan waktu aku lagi bingung soal ini ... kalian lewat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010123
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 715010123,
					"content": "#Oh gitu, {NICKNAME}, kayaknya ini beneran darurat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010124,
						715010125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 715010124,
					"content": "Baiklah, ayo ke sana ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715010126
					]
				},
				{
					"id": 715010126,
					"content": "Yuk, sekarang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 715010127,
					"content": "Ah, ngomong-ngomong ... Khedive bilang kamu langsung cari si peneliti asal Sumeru itu saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010128
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 715010128,
					"content": "Dia bilang begini: \"Kalau ada orang yang bersedia membantu, bilang ke mereka buat langsung pergi ke kemah di Chasm. Orang itu pasti sudah ada di sana, sedang sibuk bersiap-siap seperti biasa.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010129
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 715010129,
					"content": "Baik, kami meluncur dulu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715010130
					]
				},
				{
					"id": 715010130,
					"content": "Terima kasih. Keamanan Chasm kuserahkan ke tangan kalian!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 715010125,
					"content": "Yah, bantu Khedive masih boleh lah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715010126
					]
				},
				{
					"id": 715010104,
					"content": "Apa yang terjadi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715010105
					]
				}
			]
		},
		{
			"id": 7150102,
