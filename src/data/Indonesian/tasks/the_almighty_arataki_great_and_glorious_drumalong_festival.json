				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726840301,
					"content": "Ada yang bisa kubantu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840302
					],
					"speakerTitle": "Kimura"
				},
				{
					"id": 726840302,
					"content": "Katanya mau ada festival ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840303
					]
				},
				{
					"id": 726840303,
					"content": "Apa? Festival? Aku belum dengar tuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840304
					],
					"speakerTitle": "Kimura"
				},
				{
					"id": 726840304,
					"content": "Apa boleh jelaskan lebih spesifik? Festival apa ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840305
					],
					"speakerTitle": "Kimura"
				},
				{
					"id": 726840305,
					"content": "Namanya Festival Drum Arataki ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840306
					]
				},
				{
					"id": 726840306,
					"content": "Arataki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840307,
						726840308
					],
					"speakerTitle": "Kimura"
				},
				{
					"id": 726840307,
					"content": "Eh, Festival Drum Arataki yang Paling Hebat ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840309
					]
				},
				{
					"id": 726840309,
					"content": "Festival Drum Arataki yang Paling Hebat dan Paling Keren, diadakan sama Geng Arataki yang sama hebatnya dan sama kerennya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726840310,
					"content": "Ah! Geng Arataki yang bikin onar waktu Festival Irodori tempo hari, betul kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840311
					],
					"speakerTitle": "Kimura"
				},
				{
					"id": 726840311,
					"content": "Ternyata maksud kalian itu festival yang tidak berizin, tidak profesional, dan tidak resmi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840312
					],
					"speakerTitle": "Kimura"
				},
				{
					"id": 726840312,
					"content": "Apa? Bukan, bukan, kamu salah paham. Maksud Paimon itu \"Festival Drum Arataki yang Paling Hebat dan Paling Keren\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726840313,
					"content": "Ok, sudah, jangan sebut lagi namanya. Aku paham, intinya aku kasih tahu ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840314
					],
					"speakerTitle": "Kimura"
				},
				{
					"id": 726840314,
					"content": "Beberapa hari lalu kami memang melihat anggota Geng Arataki sedang meletakkan benda-benda yang merusak pemandangan di sana sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840315
					],
					"speakerTitle": "Kimura"
				},
				{
					"id": 726840315,
					"content": "Ketuanya juga koar-koar mau bikin festival besar, yang bisa menyaingi Festival Irodori. Yang itu kan yang kalian maksud?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840316
					],
					"speakerTitle": "Kimura"
				},
				{
					"id": 726840316,
					"content": "Setelah ditanyai, ternyata mereka tidak punya izin keramaian, izin sewa ruang publik, dan ... tidak daftar dan buat berita acara dulu ke Kantor Polisi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840317
					],
					"speakerTitle": "Kimura"
				},
				{
					"id": 726840317,
					"content": "Jadi benar kan, \"festival\" yang satu ini tidak berizin, tidak profesional, dan tidak resmi. Menurut aturan, kami harus hentikan kegiatan mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840318
					],
					"speakerTitle": "Kimura"
				},
				{
					"id": 726840318,
					"content": "Lah? Dihentikan? Terus ... Paimon tebak deh, semuanya ditangkap dong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726840319,
					"content": "Tidak kok. Karena yang terlibat tidak punya pengalaman mengadakan kegiatan sebelumnya, dan karena mereka ternyata sudah menyiapkan prosedur keamanan, jadi kami lepas saja dengan peringatan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840320
					],
					"speakerTitle": "Kimura"
				},
				{
					"id": 726840320,
					"content": "Prosedur keamanan? Wah, lumayan jauh juga mikirnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726840321,
					"content": "Yah, kalau kalian mau cari mereka, coba saja ke Pulau Amakane.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840322
					],
					"speakerTitle": "Kimura"
				},
				{
					"id": 726840322,
					"content": "Yashiro Commission mengkhususkan pulau itu untuk dijadikan tempat mengadakan segala macam festival, besar mau pun kecil. Sengaja diatur seperti itu agar warga lebih berinisiatif mengadakan acara kebudayaan. Proses pengajuan di sana lebih sederhana dan lebih murah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840323
					],
					"speakerTitle": "Kimura"
				},
				{
					"id": 726840323,
					"content": "Kami juga sudah kasih tahu Geng Arataki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840324
					],
					"speakerTitle": "Kimura"
				},
				{
					"id": 726840324,
					"content": "Kalau mereka tetap ingin bikin acara, ya di sana saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840325
					],
					"speakerTitle": "Kimura"
				},
				{
					"id": 726840325,
					"content": "#Hmm ... {NICKNAME}, kok kayaknya jadi enggak meyakinkan ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726840326,
					"content": "Tapi, karena sudah terlanjur di sini ... apa kita sekalian ke Amakane Island saja dulu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726840308,
					"content": "Itu, Festival Drum Arataki yang Paling Hebat ... dan Paling Keren.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840309
					]
				}
			]
		},
