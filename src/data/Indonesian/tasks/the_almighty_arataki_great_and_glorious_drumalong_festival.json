			},
			"dialogs": [
				{
					"id": 726840501,
					"content": "Ada perlu apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840502
					],
					"speakerTitle": "Hirohiko"
				},
				{
					"id": 726840502,
					"content": "Kami cari Geng Arataki.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840503
					]
				},
				{
					"id": 726840503,
					"content": "Ohh, aku tahu, kalian ke sini buat ikutan Festival Arataki bla-bla-bla apalah itu juga, iya kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840504
					],
					"speakerTitle": "Hirohiko"
				},
				{
					"id": 726840504,
					"content": "\"Juga\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840505
					]
				},
				{
					"id": 726840505,
					"content": "Iya, Nona Kujou Sara dari Tenryou Commission, dan Nona Yoimiya dari Naganohara Fireworks sudah ada di sini duluan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840506
					],
					"speakerTitle": "Hirohiko"
				},
				{
					"id": 726840506,
					"content": "Nona Yoimiya ke sini untuk antar kembang api, lalu kebetulan lihat mereka lagi siap-siap. Akhirnya dia jadi penasaran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840507
					],
					"speakerTitle": "Hirohiko"
				},
				{
					"id": 726840507,
					"content": "Kalau Nona Kujou sih ... Aku kurang tahu ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840508
					],
					"speakerTitle": "Hirohiko"
				},
				{
					"id": 726840508,
					"content": "#Wah, ternyata ada yang lebih duluan daripada kita nih, {NICKNAME}! Pertanda bagus tuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726840509,
					"content": "Jadi Geng Arataki ada di mana sekarang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726840510,
					"content": "Sayangnya, karena untuk saat ini tidak ada tempat acara resmi yang kosong ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840511
					],
					"speakerTitle": "Hirohiko"
				},
				{
					"id": 726840511,
					"content": "Kami terpaksa minta mereka pindah ke pantai kecil di sebelah barat laut pulau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840512
					],
					"speakerTitle": "Hirohiko"
				},
				{
					"id": 726840512,
					"content": "Kalau saja mereka lebih cepat daftar, kami bisa kasih mereka tempat yang lebih layak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840513
					],
					"speakerTitle": "Hirohiko"
				},
				{
					"id": 726840513,
					"content": "Ke arah barat laut saja, nanti juga ketemu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hirohiko"
				}
			]
		},
		{
			"id": 7268406,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
