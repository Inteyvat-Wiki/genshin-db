			"dialogs": [
				{
					"id": 726847201,
					"content": "Aku Mamoru, Duta Suasana Festival Drum Arataki. Ada yang bisa dibantu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847202
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 726847202,
					"content": "Eh? Kamu tanya apa kerjaanku di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847203
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 726847203,
					"content": "Ah, sebagai Duta Suasana, aku bertanggung jawab menciptakan suasana yang meriah dan memberikan perasaan \"asyik gila, seru banget-nget-nget\" ke semua pengunjung yang hadir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847204
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 726847204,
					"content": "Kamu ... merasa begitu tidak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847205,
						726847206
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 726847205,
					"content": "Mana ada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726847207
					]
				},
				{
					"id": 726847207,
					"content": "Ah ... Ja-Jangan gitu dong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847208
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 726847208,
					"content": "Aku jadi sedih. Rasanya kayak kena tinju di ulu hati! Kalau kamu merasa begitu, berarti aku gagal dong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847209
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 726847209,
					"content": "Kamu kan temannya bos, ayo dong kasih semangat! Plisss, keluarkan kata-kata mautnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847210
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 726847210,
					"content": "Kata-kata maut apaan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726847211
					]
				},
				{
					"id": 726847211,
					"content": "Itu ... \"Asyik gila, seru banget-nget-nget-nget\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847212,
						726847215
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 726847212,
					"content": "Asyik gila, seru banget-nget-nget.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726847213
					]
				},
				{
					"id": 726847213,
					"content": "Mantap! YES!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847214
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 726847214,
					"content": "Gitu dong! Aku sudah tunggu kalimat itu dari tadi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847218
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 726847218,
					"content": "Ayo kawan! Setel musik, meriahkan dansa dan tarian, kita PESTAAA!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 726847215,
					"content": "Asyik gila ... seru ... Aduh, tidak bisa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726847216
					]
				},
				{
					"id": 726847216,
					"content": "Uhh ... ya sudahlah. Pokoknya aku tidak boleh nyerah, semua anggota yang lain kerja keras di bagiannya masing-masing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847217
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 726847217,
					"content": "Ditinju di ulu hati pun tetap bangkit lagi! Begitulah ajarannya bos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847218
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 726847206,
					"content": "Jauh banget.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726847207
					]
				}
			]
		}
