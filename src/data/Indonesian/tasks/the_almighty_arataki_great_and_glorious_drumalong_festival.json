			"dialogs": [
				{
					"id": 726840654,
					"content": "Katanya Kujou Sara juga ada di sini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840655
					]
				},
				{
					"id": 726840655,
					"content": "Oh, si Tengu sialan itu ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840656
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840656,
					"content": "Yah, aku terpaksa kasih dia undangan juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840657
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840657,
					"content": "Tapi memang tengu sial itu tidak tahu diuntung. Percaya tidak, dia jauh-jauh ke sini cuma buat pasang papan pengumuman yang isinya \"memperingatkan pengunjung agar berhati-hati\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840658
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840658,
					"content": "Terus dia juga ancam kami supaya tidak utak-utik itu pengumuman. Ini bisa kena pasal penindasan terhadap geng ya, tolong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840659
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840659,
					"content": "Suatu hari nanti, si tengu bodoh itu akan kubuat takluk, kalah memalukan dan terang-terangan, pas siang bolong, di tengah jalan! Awas saja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840631
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840631,
					"content": "Nah, sobatku, ada pertanyaan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				}
			]
		},
