				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arataki Itto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726840632,
					"content": "Ada apa saja nih di festival ini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840633
					]
				},
				{
					"id": 726840633,
					"content": "Hahahaha! Barang-barang yang super keren dong, tentunya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840634
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840634,
					"content": "Lihat lereng di sana? Itu Bukit Sorak Sorai. Naik ke puncak, terus nyanyi teriak ke laut sampai puas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840635
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840635,
					"content": "Dan api unggun ini mantap banget buat manggang Lavender Melon. Mau yang biasa kek, atau yang terbang dan nyebelin juga, semua bisaaa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840636
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840636,
					"content": "Kotak-kotak ini juga, cukup lega buat main kartu Genius Invokation TCG atau adu kumbang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840637
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840637,
					"content": "Wuidih, dia benerang ngegas pol ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840638
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726840638,
					"content": "Dan acara puncaknya, tentu saja pertunjukan drum. Nih, lihat dan tercenganglah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840639
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840639,
					"content": "Nah, ini antara kita saja ya, drum ini harta karun yang didapatkan lewat jalur super rahasia. Katanya benda ini bekas punya seorang onmyouji terkenal, harganya 8 juta Mora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840640
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840640,
					"content": "Untungnya karena aku ganteng dan berjodoh sama penjualnya — ini kata dia loh — dia kasih aku diskon spesial, harganya jadi 800 ribu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840641
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840641,
					"content": "Dari 8 juta jadi cuma 800 ribu? Kata Paimon sih kamu ketipu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840642
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726840642,
					"content": "Betul, hahaha! Trik paling kuno itu, mana mungkin aku kena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840643
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840643,
					"content": "Aku lihat ujungnya ada yang retak. Alarm \"barang cacat\" Tuan Besar ini pun langsung bunyi! Kita berjodoh, katanya ... Yang benar saja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840644
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840644,
					"content": "Tuan Besar ini terus tawar, dan akhirnya harganya turun sampai 80 ribu! Hahahaha! Untung besar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840645
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840645,
					"content": "Untung apanya. Itu sih si penjualnya kerampokan namanya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840646
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726840646,
					"content": "Tapi lumayan, kamu bisa ada duit 80 ribu Mora buat beli drum itu. Si Bapak Gembala Sapi sudah hebat ya sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840647
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726840647,
					"content": "Duit 80 ribu doang masa enggak ada! Kamu kira Tuan Besar ini semiskin apa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840648
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840648,
					"content": "Aku nyumbang 20 ribu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840649
					],
					"speakerTitle": "Genta"
				},
				{
					"id": 726840649,
					"content": "Aku juga ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840650
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 726840650,
					"content": "Lah? Bos, kenapa cuma aku yang dipajakin 30 ribu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840651
					],
					"speakerTitle": "Akira"
				},
				{
					"id": 726840651,
					"content": "Sebentar, 20 ribu tambah 20 ribu tambah 30 ribu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840652
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726840652,
					"content": "Dasar Gembala Sapi curang! Kamu majekin anak buahmu dan enggak bayar seperak pun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840653
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726840653,
					"content": "Eh, belajar matematika lagi sana! Aku juga bayar ya, sisa 10 ribunya kamu kira dari mana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840665
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840665,
					"content": "Oke, sampai sini dulu ngobrolnya. Sudah sore, harus ke Shinobu lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840666
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840666,
					"content": "Festivalnya baru mulai, harus ajak lebih banyak orang lagi biar makin seru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840667
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840667,
					"content": "Tolong simpan baik-baik drum ya? Kalau mau coba main drum, langsung saja ke Genta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840668
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840668,
					"content": "Aku duluan ya, sobat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				}
			]
		},
