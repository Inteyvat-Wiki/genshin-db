				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Genta"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726840701,
					"content": "Aku Genta, Duta Penyambut Festival Drum Arataki. Sudah siap main drum sampai puas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840702
					],
					"speakerTitle": "Genta"
				},
				{
					"id": 726840702,
					"content": "Oh ya, aku hampir lupa, bos sepertinya lupa bilang sesuatu tentang drum ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840703
					],
					"speakerTitle": "Genta"
				},
				{
					"id": 726840703,
					"content": "Kami semua tidak ada yang mengerti musik, jadi tolong bantu setel dulu ya, takutnya sumbang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840704
					],
					"speakerTitle": "Genta"
				},
				{
					"id": 726840704,
					"content": "Biar lebih enak suaranya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840705
					],
					"speakerTitle": "Genta"
				},
				{
					"id": 726840705,
					"content": "Nah, coba nih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Genta"
				}
			]
		},
		{
			"id": 7268430,
			"completionStepIds": [
				7268406
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7268406",
							"2"
						],
						"stepId": 7268406,
						"stateName": "QUEST_STATE_UNFINISHED"
