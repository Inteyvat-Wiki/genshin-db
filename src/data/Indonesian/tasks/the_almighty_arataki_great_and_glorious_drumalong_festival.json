			"dialogs": [
				{
					"id": 726847101,
					"content": "Aku Akira, Duta Kritik dan Saran Festival Drum Arataki. Ada masukan buat kami?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847102,
						726847103,
						726847104
					],
					"speakerTitle": "Akira"
				},
				{
					"id": 726847102,
					"content": "Sudah lumayan keren loh ini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726847105
					]
				},
				{
					"id": 726847105,
					"content": "Oke, terima kasih untuk masukannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847106
					],
					"speakerTitle": "Akira"
				},
				{
					"id": 726847106,
					"content": "Eh? Ada pertanyaan lain? Tapi aku tidak tahu mau jawab apa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847107
					],
					"speakerTitle": "Akira"
				},
				{
					"id": 726847107,
					"content": "Ah ... Bos cuma suruh aku bilang \"Boleh minta saran dan masukan?\" sama \"Terima kasih untuk masukannya\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847108
					],
					"speakerTitle": "Akira"
				},
				{
					"id": 726847108,
					"content": "Kalau pengunjung tanya kapan masukan mereka akan ditindak lanjuti, aku cuma disuruh bilang: \"Kami akan segera mengurusnya.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847109
					],
					"speakerTitle": "Akira"
				},
				{
					"id": 726847109,
					"content": "Dia bilang semua orang di acara lain juga sama. Aku yakin dia bicara begitu berdasarkan pengalaman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847110
					],
					"speakerTitle": "Akira"
				},
				{
					"id": 726847110,
					"content": "Tapi Kak Shinobu bilang jawaban kayak gitu jatuhnya kurang tulus, jadi dia suruh aku pegang catatan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847111
					],
					"speakerTitle": "Akira"
				},
				{
					"id": 726847111,
					"content": "Lihat, masukan dari kamu barusan sudah aku tulis di sini. Nanti akan aku kasih ke Shinobu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akira"
				},
				{
					"id": 726847103,
					"content": "Masih biasa saja sih acaranya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726847105
					]
				},
				{
					"id": 726847104,
					"content": "Kurang meriah ah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726847105
					]
				}
			]
		},
