			"dialogs": [
				{
					"id": 726840660,
					"content": "Yoimiya juga ke sini ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840661
					]
				},
				{
					"id": 726840661,
					"content": "Oh, bosnya Naganohara Fireworks?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840662
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840662,
					"content": "Ngobrol sama Nona yang satu itu seru banget. Dia tahu tentang festival ini karena kebetulan lagi nganter kembang api ke Pulau Amakane.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840663
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840663,
					"content": "Dia suka sekali idenya, dan dia ikut mendoakan biar acaranya sukses. Dia bahkan janji lain kali mau ikut sumbang kembang api.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840664
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840664,
					"content": "Geng Arataki harus bisa jaga hubungan baik sama Naganohara Fireworks nih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840631
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840631,
					"content": "Nah, sobatku, ada pertanyaan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
