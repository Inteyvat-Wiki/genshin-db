			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arataki Itto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726840601,
					"content": "HAHAHAHAHA! Halo sahabat-sahabatku yang tersayang! Akhirnya sampai juga kalian!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840602
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840602,
					"content": "Aku barusan lagi mikir kapan kalian bakal sampai, EH, tahu-tahu nongol ... Hahaha, Tuan Besar ini senang sekali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840603
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840603,
					"content": "Lihat, gimana menurut kalian? Tempatnya keren kan? Lokasi panas nih, favorit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840604
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840604,
					"content": "Dikelilingi laut, udaranya bersih, tidak ada polusi suara, dan pemandangannya juga ... WUIH.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840605
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 726840605,
					"content": "Terletak di belakang Pulau Amakane, kita punya akses eksklusif ke peralatan festival dan kebudayaan kelas satu nih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840606
					],
					"speakerTitle": "Akira"
				},
				{
					"id": 726840606,
					"content": "Lalu menuju ke sini juga gampang, mau lewat jalur darat atau laut, jalan kaki atau naik perahu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840607,
						726840608
					],
					"speakerTitle": "Genta"
				},
				{
					"id": 726840607,
					"content": "Iya, bagus ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840609
					]
				},
				{
					"id": 726840609,
					"content": "Pertama kali lihat tempat ini, Tuan Besar ini langsung suka!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840610
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840610,
					"content": "Pemandangannya mengalihkan duniaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840611
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840611,
					"content": "BOS! Bijaksana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840612
					],
					"speakerTitle": "Genta"
				},
				{
					"id": 726840612,
					"content": "Jelas-jelas kalian di sini karena diusir Tenryou Commission.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726840613,
					"content": "EHEM, langsung bicara yang penting saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840614
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840614,
					"content": "Tuan Besar ini undang kalian ke sini supaya bisa ikutan Festival Drum Arataki yang Paling Hebat dan Paling Keren! Sebuah festival yang SANGAT penting, perlu aku pertegas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840615
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840615,
					"content": "Bos bikin festival ini pertama buat promosi, biar orang-orang tertarik gabung ke Geng Arataki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840616
					],
					"speakerTitle": "Genta"
				},
				{
					"id": 726840616,
					"content": "Kedua, buat merayakan kelulusan Kak Shinobu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840617
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 726840617,
					"content": "Ketiga dan terakhir, sekalian buat acara kekompakan tim yang batal karena kurang dana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840618
					],
					"speakerTitle": "Akira"
				},
				{
					"id": 726840618,
					"content": "Beli satu dapat tiga ya, widih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840619
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726840619,
					"content": "Akira, yang terakhir itu tidak perlu disebut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840620
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840620,
					"content": "Shinobu-nya mana?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840621
					]
				},
				{
					"id": 726840621,
					"content": "Ini kan festival ya, artinya ini acara yang harus dipromosikan besar-besaran, biar ramai. Shinobu sekarang lagi nyebar brosur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840622
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840622,
					"content": "Lah! Kok gitu sih, tadi katanya Shinobu bintang utama festivalnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840623
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726840623,
					"content": "Kenapa malah dia yang kerja, terus kalian yang enggak jelas ngapain di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840624
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726840624,
					"content": "Heh, Tuan Besar ini juga kerja keras ya! Tugasku, eh ... meladeni tamu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840625
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840625,
					"content": "Bos baru datang kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840626
					],
					"speakerTitle": "Genta"
				},
				{
					"id": 726840626,
					"content": "Dia ada firasat kalau kalian akan segera muncul, jadi dia langsung pulang, khusus buat nyambut kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840627
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 726840627,
					"content": "Sebelumnya, dia ikut Kak Shinobu promosi dan undang orang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840628
					],
					"speakerTitle": "Akira"
				},
				{
					"id": 726840628,
					"content": "Biasa saja, dinas, dinas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840629
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840629,
					"content": "Hebat, si Gembala Sapi pemalas ini ternyata bisa kerja ya. Paimon kaget, kaget banget.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840630
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726840630,
					"content": "Si Lavender Melon unyil ini ya, bisanya cuma ngasih julukan bocah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840631
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840631,
					"content": "Nah, sobatku, ada pertanyaan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840608,
					"content": "Iya, kalian memang juaranya mikir positif.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840609
					]
				}
			]
		},
		{
			"id": 7268407,
			"completionStepIds": [
				7268407
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
