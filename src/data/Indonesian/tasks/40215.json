			"dialogs": [
				{
					"id": 766530401,
					"content": "Akhirnya datang juga, kesempatan yang langka ini, kamu tidak mungkin lupa, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530402
					],
					"speakerTitle": "Gaudenty"
				},
				{
					"id": 766530402,
					"content": "Konfirmasi lagi, pesananmu yang mana ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530403
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530403,
					"content": "... Aku Gaudenty, perwakilan dari Biro Desain Eksperimental Kuuvahki, seharusnya kamu sudah ingat, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530404
					],
					"speakerTitle": "Gaudenty"
				},
				{
					"id": 766530404,
					"content": "Bawel ... Cepat jelaskan konten pesanan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530405
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530405,
					"content": "Kamu ... Biar kujelaskan lagi, baru-baru ini ada sekumpulan robot pengintai yang lepas kendali dan terbang keluar dari Biro Desain Eksperimental Kuuvahki. Misiku adalah mengumpulkan mereka kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530406
					],
					"speakerTitle": "Gaudenty"
				},
				{
					"id": 766530406,
					"content": "Namun robot pengintai ini terbang sangat tinggi, aku sendirian akan sulit menanganinya, jadi aku menawarkan kesempatan kerja ini padamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530407
					],
					"speakerTitle": "Gaudenty"
				},
				{
					"id": 766530407,
					"content": "Sejujurnya, kamu bisa mengambilnya kembali atau langsung menghancurkannya. Tujuan kami hanyalah mencegah robot pengintai jatuh ke tangan orang luar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530408
					],
					"speakerTitle": "Gaudenty"
				},
				{
					"id": 766530408,
					"content": "Oh, aku ingat pesanan ini. Robot pengintai itu terbang terlalu tinggi untuk dijangkau orang biasa, tapi aku telah menguasai cara untuk membangun Jalur Bulan secara artifisial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530409
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530409,
					"content": "#Aku ingat {NICKNAME} dapat meminta bantuan Kuuhenki? Kalau begitu, kita dapat mencoba menggunakan Jalur Bulan ini untuk terbang ke langit, dan menembak jatuh semua robot pengintai itu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530410
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530410,
					"content": "#Ya, serahkan saja pada {NICKNAME}, pasti enggak masalah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530411,
						766530412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766530411,
					"content": "Gampang kok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766530413
					]
				},
				{
					"id": 766530413,
					"content": "Oh ya, aku tidak berencana membayar dengan Mora. Untuk imbalannya, aku akan menggunakan komponen dari robot pengintai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530414
					],
					"speakerTitle": "Gaudenty"
				},
				{
					"id": 766530414,
					"content": "Ini sudah dijelaskan saat mengirimkan pesanan, kamu jangan sampai berubah pikiran ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530415
					],
					"speakerTitle": "Gaudenty"
				},
				{
					"id": 766530415,
					"content": "Bayar dengan komponen? Kamu bukannya barusan bilang enggak mau robot pengintai itu jatuh ke tangan orang luar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766530416,
					"content": "Itu sebabnya aku katakan ini adalah peluang kerja yang langka. Semua masalah pasti ada solusinya, melihat kalian yang sudah bekerja keras, aku tidak keberatan menutup sebelah mata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530417
					],
					"speakerTitle": "Gaudenty"
				},
				{
					"id": 766530417,
					"content": "Aneh banget, kayaknya enggak mau bayar aja ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766530418,
					"content": "Ada atau tidak Mora tidak masalah, komponen dari robot pengintai itu sangat penting, akan aku gunakan dalam proyek penelitianku berikutnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530419
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530419,
					"content": "Baiklah, Aino sudah ngomong begitu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766530412,
					"content": "Sedikit menantang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766530413
					]
				}
			]
		}
	]
