			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cloud Retainer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705000101,
					"content": "Pemandangan pohon-pohon yang menjulang di hamparan salju. Sungguh tempat yang sunyi dan tenang. Hidangan ketiga sungguh cocok untuk suasana seperti ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000102
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705000102,
					"content": "Hidangan apa lagi yang ingin kamu buat?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705000103
					]
				},
				{
					"id": 705000103,
					"content": "Ugh, aku ingin menanyakan sesuatu. Apa kamu tahu suatu teknik masak bernama \"tumis\"? Cara memasak ini tidak sengaja kutemukan saat membolak-balik resep.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000104
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705000104,
					"content": "Aku sangat tertarik, dan sengaja menggunakan teknik masak itu sebagai fokus hidangan. Jadi kubuat sebuah resep baru bernama \"Braised Meat\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000105
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705000105,
					"content": "Bagi Supreme Cuisine Machine, masakan ini tidaklah sulit... Tapi yang terpenting dalam hidangan ini adalah daging, jadi daging yang digunakan harus benar-benar daging berkualitas terbaik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000106
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705000106,
					"content": "Karena itulah, aku mengaktifkan mesin dan mencari bahan makanan hingga ke tempat ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000107
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705000107,
					"content": "Tempat ini berangin dan bersalju, sulit sekali mengerjakan sesuatu di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000108
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705000108,
					"content": "Pengembara, aku tahu pengetahuanmu sangat luas dan kamu sangat ahli dalam bertualang. Gunung salju pasti bukanlah masalah besar untukmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000109
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705000109,
					"content": "Tolonglah diriku sekali lagi dan carikan beberapa bahan makanan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000110,
						705000116
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705000110,
					"content": "Aku juga mau resep ketiga.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705000111
					]
				},
				{
					"id": 705000111,
					"content": "Aku tidak akan melupakan bagianmu, tenang saja. Kalau begitu kuserahkan padamu ya, aku akan menunggumu di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000112
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705000112,
					"content": "Duh, kenapa mesinnya tiba-tiba berhenti ya? Apa karena area sekitar terlalu dingin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000113
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705000113,
					"content": "Coba kubuka sekali lagi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000114
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705000114,
					"content": "Supreme Cuisine Machine ... menyala!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000115
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705000115,
					"content": "Harusnya sudah bisa. Pengembara, cepat ikuti jejak hawa ini dan bawa bahan makanannya ke hadapanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705000116,
					"content": "Kamu kedinginan sampai tidak bisa terbang?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705000117
					]
				},
				{
					"id": 705000117,
					"content": "Jangan bercanda deh! Kemampuanku begitu hebat, bisa-bisanya kamu meremehkanku! Diriku hanya, hanya harus memperbaiki mesin di sini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000118
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705000118,
					"content": "Kamu lebih baik cepat pergi dan cepat kembali. Jangan biarkan diriku menunggu lama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000112
					],
					"speakerTitle": "Cloud Retainer"
				}
			]
		},
