					"Cloud Retainer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705000701,
					"content": "Hmm... harum sekali aromanya. Memang tak salah diriku mengharapkanmu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000702,
						705000703
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705000702,
					"content": "Kamu yang hebat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705000704
					]
				},
				{
					"id": 705000704,
					"content": "Setuju. Setelah memasak tiga hidangan ini, diriku sudah memastikan kalau Supreme Cuisine Machine ini dapat diandalkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000705
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705000705,
					"content": "Kalau kita bisa menyelesaikan masalah pengaturan temperatur dan memasukkan bahan-bahannya, alat ini bisa jadi \"alat masak otomatis\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000706
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705000706,
					"content": "Oh ya, terimalah resep Braised Meat ini. Tapi jelas ada yang beda — resep ini memakai Raw Meat biasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000707
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705000707,
					"content": "Kupikir akan merepotkan bagimu jika harus pergi ke tempat dingin begini setiap kali kamu ingin memakan hidangan ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000708
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705000708,
					"content": "Untuk masak sehari-hari, kamu bisa menggunakan daging biasa saja.",
					"roleType": "TALK_ROLE_NPC",
