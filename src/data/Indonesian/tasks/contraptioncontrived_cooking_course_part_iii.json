				"points": []
			},
			"dialogs": [
				{
					"id": 705000501,
					"content": "Ini... daging apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000502
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705000502,
					"content": "Chilled Meat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705000503
					]
				},
				{
					"id": 705000503,
					"content": "Chilled Meat. Nama yang cocok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000504
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705000504,
					"content": "Uh, kualitasnya lumayan. Tapi dari kondisi dagingnya, sepertinya perlu dicairkan dengan api kecil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000505
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705000505,
					"content": "Untungnya Supreme Cuisine Machine yang kuciptakan bisa mencairkan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000506,
						705000512
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705000506,
					"content": "Mesin ini sepertinya bisa melakukan apa pun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705000507
					]
				},
				{
					"id": 705000507,
					"content": "Bagaimana mungkin itu terjadi? Ya tentu saja ada kekurangannya. Mesin ini tidak ada pengambilan bahan otomatis, pengontrolan panas otomatis, dan sebagainya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000508
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705000508,
					"content": "Mesin ini masih perlu banyak perbaikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000509
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705000509,
					"content": "Baiklah, cukup bicaranya. Karena semua bahannya sudah cukup, diriku akan segera mengaktifkan mesinnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000510
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705000510,
					"content": "Kuserahkan padamu untuk mengatur apinya, Pengembara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000511
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705000511,
					"content": "Beri tahu diriku kalau kamu sudah siap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705000512,
					"content": "Memang Adeptus benar-benar hebat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705000513
					]
				},
				{
					"id": 705000513,
					"content": "Daripada memuji kekuatan Adeptus, aku lebih senang kalau kamu memuji kehebatan Supreme Cuisine Machine ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000509
					],
					"speakerTitle": "Cloud Retainer"
				}
			]
		},
