					"nextDialogs": [
						400020502
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020502,
					"content": "Terima kasih banyak! Ini imbalanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020503
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020503,
					"content": "Tidak ada kerja kerasmu yang disia-siakan. Setiap usaha akan memberi warna pada Lantern Rite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020504
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020504,
					"content": "Betul juga, karena kamu akan ada di Liyue selama festival berlangsung, pastikan kamu menyaksikan Lentera Mingxiao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020505
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020505,
					"content": "Saat pekerjaan berlangsung, lokasi konstruksi di pelabuhan akan menjadi semakin indah untuk dilihat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020506
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020506,
					"content": "#Kedengerannya menarik, {NICKNAME}, gimana kalau kita juga pergi lihat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
