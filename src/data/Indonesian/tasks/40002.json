					"nextDialogs": [
						400021002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400021002,
					"content": "Pasti ada hal yang tidak baik kalau ada orang mencurigakan muncul dan berkeliaran di tempat yang sangat bahaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400021003,
					"content": "Kalau dia merusak persediaan perlengkapan lentera...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021401
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400021401,
					"content": "Ini masalah yang cukup penting! Ayo kita pergi ke Bagian Urusan Sipil di Liyue dan laporkan ke mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400021406,
					"content": "Paimon, kenapa kamu menanggapi ini dengan begitu serius?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400021407
					]
				},
				{
					"id": 400021407,
					"content": "Ka-karena... semua orang di Liyue sudah bekerja keras untuk ini! Tidak ada yang boleh merusaknya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400021408,
					"content": "... Apa alasan sebenarnya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400021409
					]
				},
				{
					"id": 400021409,
					"content": "Karena... di dekat pelabihan ada tempat Zhongyuan Chop Suey! Makan sekali dan kamu pasti akan ketagihan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400021410,
					"content": "Kampanye makanan itu benar-benar efektif...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400021411
					]
				},
				{
					"id": 400021411,
					"content": "Hehehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
