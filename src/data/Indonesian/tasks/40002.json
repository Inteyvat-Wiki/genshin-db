				{
					"id": 400021501,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021502
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 400021502,
					"content": "Kami di sini untuk melaporkan orang yang mencurigakan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400021503
					]
				},
				{
					"id": 400021503,
					"content": "Benar, kami tadi lihat ada orang yang mencurigakan di sekitar persediaan bahan-bahan pembangunan Lentera Mingxiao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400021504,
					"content": "Kita tidak boleh membiarkan ini memengaruhi Zhongyuan Chop Suey!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400021505,
					"content": "Oh ya, kalau begitu ini benar-benar masalah serius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021506
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 400021506,
					"content": "Tepat seperti yang Paimon pikirkan! Makanan di Pelabuhan Liyue adalah jantung dan jiwa dari kota yang-",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400021507,
					"content": "Sepertinya kita punya pandangan berbeda mengenai apa yang disebut dengan masalah serius. Tapi kamu tidak salah, teman kecil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021508
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 400021508,
					"content": "Aku sudah mendengar situasinya darimu dan aku akan melaporkannya pada atasanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021509
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 400021509,
					"content": "Terima kasih atas informasinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021510
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 400021510,
					"content": "Pastikan kalian memperhatikannya ya! Ini masalah penting loh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
