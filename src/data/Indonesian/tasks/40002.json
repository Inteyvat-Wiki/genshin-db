			"dialogs": [
				{
					"id": 400020201,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020202
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020202,
					"content": "Hari ini, aku ada hal yang ingin didiskusikan denganmu. Kali ini bukan tentang donasi, tapi lebih kepada transaksi jual beli, apa kamu tertarik?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020203
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020203,
					"content": "Eh? Masih lebih baik daripada kerja gratis seperti barusan. Oke, Paimon tertarik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400020204,
					"content": "Haha, kalau begitu tolong ya, jadi sebenarnya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020205
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020205,
					"content": "Aku membutuhkan dua jenis Plaustrite untuk digunakan dalam festival.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020206
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020206,
					"content": "Yang satunya adalah Azurite, biasanya ditemukan di bagian utara Mt. Tianheng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020207
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020207,
					"content": "Ketika Azurite tersangkut di akar tumbuhan biasa, terkadang Azurite menghasilkan Bloatty Floatty, yang memiliki biji mengambang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020208
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020208,
					"content": "Yang satunya lagi dinamakan Vermillionite, yang katanya sungguh berbahaya bagi kebanyakan orang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020209
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020209,
					"content": "Di Guili Plains, Ruin Hunter kuno yang sudah kehilangan kekuatannya untuk terbang menggunakan Vermillionite untuk membuatnya tetap melayang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020210
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020210,
					"content": "Baiklah! Jadi Azurite dan Vermillionite, ya kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400020211,
					"content": "(Sebenarnya, mereka hanyalah variasi Plaustrite berwarna merah dan biru... pedagang permata menamainya dengan begitu indah hanya untuk memukau para pelanggan...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020212
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020212,
					"content": "Betul, tolong bawakan padaku segera ya. Semoga berhasil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huixin"
				}
			]
		},
