			},
			"dialogs": [
				{
					"id": 745270401,
					"content": "#Ah, ternyata kamu, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270402,
						745270403
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 745270402,
					"content": "Escoffier, lama tidak bertemu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745270404
					]
				},
				{
					"id": 745270404,
					"content": "Hari ini aku tidak masak, cuma mencicipi saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270405
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 745270405,
					"content": "Savanna mau mencoba menu baru, dia minta aku untuk mencicipinya. Tapi makanan ini ... sudah diulang sampai lima kali ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270406
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 745270406,
					"content": "Antara waktu masaknya yang kurang beberapa detik dan memengaruhi tekstur bahan, atau perbandingan bumbunya yang terlalu banyak sampai rasa rempahnya malah mendominasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270407
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 745270407,
					"content": "Kamu masih saja ketat seperti biasa ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745270408
					]
				},
				{
					"id": 745270408,
					"content": "Tentu dong! Memasak itu ilmu sains, rasanya tidak akan berubah hanya karena dia temanku. Justru karena aku harus tanggung jawab pada dia dan pelanggan lain, jadi harus lebih ketat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270409,
						745270410
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 745270409,
					"content": "Aku punya satu permintaan kecil ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745270411
					]
				},
				{
					"id": 745270411,
					"content": "... Di saat seperti ini? Kalau foto ini untuk dipamerkan ke publik, mungkin boleh cari waktu lain saja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270412
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 745270412,
					"content": "Kita perlu memilih latar dengan baik, mengatur cahaya dan sudut dengan teliti agar bisa dapat hasil yang bagus ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270413,
						745270414
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 745270413,
					"content": "Aku cuma mau mengambil foto kenangan teman-temanku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745270415
					]
				},
				{
					"id": 745270415,
					"content": "... Baiklah. Kita juga masih punya waktu sampai dia mengulang yang keenam kalinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270416
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 745270416,
					"content": "Coba lihat mana yang lebih bagus, lensa barumu atau menu barunya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 745270414,
					"content": "Sekaligus bisa uji coba lensa baru.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745270415
					]
				},
				{
					"id": 745270410,
					"content": "Aku boleh ambil foto kamu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745270411
					]
				},
				{
					"id": 745270403,
					"content": "Lagi ngembangin resep baru?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745270404
					]
				}
			]
		}
	]
