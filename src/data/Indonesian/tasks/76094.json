					"Vacarao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760940201,
					"content": "Keren! Tuh kan, petualang pasti bisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940202
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940202,
					"content": "Slothsheep tidak bisa hidup tanpa kuuvahki, tapi selama orang itu masih di Nod-Krai, si pedagang bisa merasa nyaman dan aman di dekatnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940203
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940203,
					"content": "Aku permisi dulu. Ini, tanda terima kasih kami ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vacarao"
				}
			]
		},
