			"dialogs": [
				{
					"id": 760940501,
					"content": "Ah, ini \"rekan\" pedagang asing yang terjebak di gua, ternyata kamu yang menyelamatkan dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940502
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940502,
					"content": "Meskipun kita semua tahu, Slothsheep ikuti kamu hanya untuk menyebarkan benih yang dibawanya ke tempat yang jauh, tapi tuan itu tidak mau mendengar penjelasan apa pun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940503
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940503,
					"content": "Aku lagi khawatir masalah ini, tapi untungnya ketemu petualang baik hati sepertimu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940504
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940504,
					"content": "Terima ini sebagai hadiah kecil dariku, makasih atas bantuannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vacarao"
				}
			]
		}
