			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vacarao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760940101,
					"content": "Gimana caranya kita keluarkan dia? Aduh, pusing kali, sumpah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940102
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940102,
					"content": "Ada yang bisa dibantu, mungkin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760940103
					]
				},
				{
					"id": 760940103,
					"content": "Hm? Ah! Petualang budiman lewat. Waktunya pas sekali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940104
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940104,
					"content": "Ini masalahnya. Dulunya di sini ada terowongan yang tembus ke utara, tapi baru-baru ini runtuh gara-gara ada anomali kuuvahki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940105
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940105,
					"content": "Untungnya tidak ada korban luka, tapi ada pedagang keliling dari seberang lautan yang bilang \"rekan\"-nya terjebak di dalam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940106
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940106,
					"content": "Seekor Slothsheep lokal yang dia ajak berteman setelah ketemu. Kalau sudah diam di sini cukup lama, kamu juga bakal sadar kalau Slothsheep biasanya mengikuti orang cuma untuk menyebarkan benih-benih yang mereka bawa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940107
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940107,
					"content": "Tapi dijelaskan kayak gimana pun, pedagang itu tidak mau dengar. Dan dia bersikeras ingin menolong si Slothsheep.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940108
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940108,
					"content": "Supaya jalan ke bagian dalam tersambung lagi, kita mesti pakai Intricate Bloom. Masalahnya aku tidak bisa pakai sihir Bani Bulan Embun, dan tidak punya alat kuuvahki yang cukup mumpuni untuk melakukan itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940109
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940109,
					"content": "Untungnya kamu lewat. Petualang pasti bisa dong keluarkan Slothsheep itu dari dalam sana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940110
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940110,
					"content": "Aku mewakili si pedagang mengucapkan terima kasih yang sebesar-besarnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vacarao"
				}
			]
		},
		{
			"id": 7609402,
