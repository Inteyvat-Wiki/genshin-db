					}
				]
			},
			"dialogs": [
				{
					"id": 747160101,
					"content": "Luar biasa ... Hampir semua sampah yang besar sudah terkumpul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160102
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747160102,
					"content": "Maaf sudah merepotkan kalian berdua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160103
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747160103,
					"content": "Enggak usah minta maaf lah, Freminet! Menurut Paimon sih, kita enggak lagi \"bekerja\", tapi lagi dapatin barang-barang keren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160104,
						747160105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747160104,
					"content": "Kami sudah membantu memulihkan lingkungan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160106
					]
				},
				{
					"id": 747160106,
					"content": "Terima kasih ... Berkat kalian, semua ini menjadi sangat menyenangkan dan memuaskan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160107
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747160107,
					"content": "Sama-sama! Kita kan sama-sama kerja keras! Daaan, Paimon rasa kamu beneran udah banyak kemajuan, Freminet. Kamu banyak bantu kita mau di bawah air atau di darat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747160108,
					"content": "Enggak perlu malu begitu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160109
					]
				},
				{
					"id": 747160109,
					"content": "O-Oke.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160110
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747160110,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160111
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747160111,
					"content": "Maaf, aku benar-benar tidak tahu harus bilang apa di saat seperti ini, selain \"terima kasih\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160112
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747160112,
					"content": "Mungkin ... aku masih perlu lebih banyak latihan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160113
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747160113,
					"content": "Santai saja, enggak usah terburu-buru. Terus latihan pakai ritmemu sendiri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160114,
						747160115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747160114,
					"content": "Kalau ada kesempatan lagi, kita kerja sama lagi ya di lain waktu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160116
					]
				},
				{
					"id": 747160116,
					"content": "Oke, setuju.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160117
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747160117,
					"content": "... Sekarang bersih-bersihnya sudah selesai, jadi aku berencana kembali ke bawah air dan menghabiskan waktu sendirian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160118
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747160118,
					"content": "Tapi anehnya, setelah bicara denganmu ... bahkan langit pun terasa tenang. Aku hanya ingin ... berbagi perasaan ini denganmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160119
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747160119,
					"content": "Ah ... aku sebaiknya kembali ke Lyney dan yang lainnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160120
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747160120,
					"content": "Aku akan serahkan data survei bawah laut sisanya padamu. Semoga kamu menemukan apa yang kamu cari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160121
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747160121,
					"content": "Hei, suaramu terdengar sampai dek atas. Ada kabar baik?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160122
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747160122,
					"content": "Iya! Semua sampah yang bikin ikan-ikan kesal sudah hampir beres semua. Dan ... kami juga menemukan sisa komponen piano lainnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747160123,
					"content": "Oh ya? Coba kulihat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160124
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747160124,
					"content": "... Wah, benar. Dengan komponen ini, akhirnya aku bisa memperbaiki pianonya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160125
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747160125,
					"content": "Mungkin enggak akan persis seperti aslinya, tapi seharusnya bisa buat main musik yang indah lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160126
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747160126,
					"content": "Kamu kayaknya senang banget ya, Sandrone!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747160127,
					"content": "E-Emangnya iya? Terserah deh, aku mau perbaikin sekarang juga. Seharusnya enggak akan lama. Sementara itu, aku mau minta tolong kamu mempercantik tempat ini sedikit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160128
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747160128,
					"content": "Alat musik yang luar biasa seperti ini pantas mendapatkan panggung yang layak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160129
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747160129,
					"content": "Dia beneran seneng banget deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747160130,
					"content": "Wooow! Pianonya cakep banget!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160131,
						747160132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747160131,
					"content": "Elegan sekali!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160133
					]
				},
				{
					"id": 747160133,
					"content": "Hmph, tentu saja, karena aku yang memperbaikinya! Aku juga sudah perkuat sambungan mekanisnya dan mempercantik bagian luarnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160134
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747160134,
					"content": "Hasil kerja kalian juga lumayan. Panggung ini benar-benar layak untuk piano ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160135
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747160135,
					"content": "Hehe, enggak susah kok! Ya udah, cukup ngobrolnya. Kamu enggak mau mainin lagu buat kita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747160136,
					"content": "Heh? Sekarang banget?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160137
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747160137,
					"content": "Kalau enggak, kapan lagi? Buat apa benerin pianonya kalau enggak mau dimainin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747160138,
					"content": "Bagaimana kalau ... kita tunda dulu pertunjukan hari ini! Masih banyak waktu buatku memainkannya untukmu nanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160139,
						747160140
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747160139,
					"content": "Lupa bawa partitur musiknya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160141
					]
				},
				{
					"id": 747160141,
					"content": "Hmph, enak saja! A-Aku cuma mau duduk tenang dulu sama pianonya dan mengenang masa lalu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160142
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747160142,
					"content": "Jangan pikir sedikit ejekan murahan saja bisa buat aku terprovokasi. Hmph, latihan dulu, penampilan masalah belakangan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747160140,
					"content": "Malu-malu nih ye?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160141
					]
				},
				{
					"id": 747160132,
					"content": "Cantik sekali!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160133
					]
				},
				{
					"id": 747160115,
					"content": "Kalau kamu butuh bantuan, langsung saja bilang sama kami.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160116
					]
				},
				{
					"id": 747160105,
					"content": "Dan kami menemukan banyak sekali harta karun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160106
					]
				}
			]
		}
	]
}