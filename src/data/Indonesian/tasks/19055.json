			"dialogs": [
				{
					"id": 190551601,
					"content": "#{NICKNAME}, maaf karena sudah tidak jujur sama kamu ... Aku terpaksa, sungguh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551602
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 190551602,
					"content": "Aku mengerti kok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190551603
					]
				},
				{
					"id": 190551603,
					"content": "Ngomong-ngomong, Kokomi tahu soal ini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190551604
					]
				},
				{
					"id": 190551604,
					"content": "Yang Mulia ya ... aku cuma bisa bilang kalau perang sudah membawa berbagai hal buruk yang akhirnya memaksa kita belajar banyak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551605
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 190551605,
					"content": "Jawaban yang tidak menjawab.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 190551606,
					"content": "Itu, eh ... Kalian tidak penasaran tentang siapa yang mengajukan undang-undang baru? Pasti bukan dari Kanjou Commission, soalnya tidak ada untungnya buat mereka, dan kami juga tidak ada relasi di sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551607
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 190551607,
					"content": "Iya ya. Kayak kebantu sama campur tangan para dewa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 190551608,
					"content": "Haha, dewa ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551609
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 190551609,
					"content": "Belum lama ini aku dan Yang Mulia diundang untuk menghadiri Festival Irodori di Pulau Narukami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551610
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 190551610,
					"content": "Aku menunggu di pasar festival, sementara Yang Mulia ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gorou"
				}
			]
		},
