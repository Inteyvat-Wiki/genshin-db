					"nextDialogs": [
						190551802
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 190551802,
					"content": "Dia ke Kanjou Commission dan menemui Yae Miko ... untuk membahas tentang buku. Tapi ada agenda lain juga. Pertemuan itu tidak diumumkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551803
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 190551803,
					"content": "Sepulang dari sana, kami mulai mencoba menggenjot kegiatan komersil. Dan tak lama kemudian, ada yang mengajukan undang-undang baru di Pulau Narukami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551804
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 190551804,
