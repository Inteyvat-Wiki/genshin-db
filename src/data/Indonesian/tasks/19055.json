				"points": []
			},
			"dialogs": [
				{
					"id": 190551001,
					"content": "Info dari kamu memang top. Waktu sampai tadi para Nobushi masih pada tidur, hahaha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551002
					],
					"speakerTitle": "Tokuda"
				},
				{
					"id": 190551002,
					"content": "Kami tangkap semuanya, lalu barang-barangnya kami bawa ke sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551003
					],
					"speakerTitle": "Tokuda"
				},
				{
					"id": 190551003,
					"content": "Mana lihat. Hmm ... semuanya lengkap, kerja bagus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551004
					],
					"speakerTitle": "Todoroki"
				},
				{
					"id": 190551004,
					"content": "Sudah seharusnya. Berkat rombongan dagangmu, harga biji-bijian di desa jadi lebih murah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551005
					],
					"speakerTitle": "Tokuda"
				},
				{
					"id": 190551005,
					"content": "Betul itu. Dan siapa sangka luka yang kami derita ketika perang ternyata berbuntut panjang untuk tubuh kami. Untungnya kamu kasih kami obat mujarab.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551006
					],
					"speakerTitle": "Masashi"
				},
				{
					"id": 190551006,
					"content": "Semuanya membaik berkat pertolongan atasan kita. Nah, bagaimana dengan persediaan di desa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551007
					],
					"speakerTitle": "Todoroki"
				},
				{
					"id": 190551007,
					"content": "Pastikan lagi malam ini, besok pagi aku harus ke Kuil Sangonomiya, terima instruksi dari Jenderal Gorou, lalu berangkat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551008
					],
					"speakerTitle": "Todoroki"
				},
				{
					"id": 190551008,
					"content": "Tenang, kami sudah bikin daftar. Sini, ikut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Masashi"
				}
			]
		},
