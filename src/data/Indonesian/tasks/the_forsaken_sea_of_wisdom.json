			"dialogs": [
				{
					"id": 751750101,
					"content": "Setelah membenamkan diri ke dalam Phlogiston cair, beberapa gambar muncul dalam benakmu seperti kenangan yang hangat.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750102
					]
				},
				{
					"id": 751750102,
					"content": "Di tepi kolam api, bayangan putih perak dan bayangan yang diselimuti abu berbicara ....",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750103
					]
				},
				{
					"id": 751750103,
					"content": "\"Eksperimen verifikasi tahap kedua telah berakhir. Yang mampu memurnikan dan mengembangkan segala sesuatu, aku berikan nama 'Huitzilopochtli', atau 'Sapuan Api Langit' ....\"",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750104
					]
				},
				{
					"id": 751750104,
					"content": "\"Tapi sudahlah, sebentar lagi nama tidak akan ada artinya lagi di tempat ini.\"",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750105
					]
				},
				{
					"id": 751750105,
					"content": "\"Astral Assemblage harus diaktifkan dan terus dihubungkan untuk melawan korosi. Mereka akan menangkal pengaruh Abyss dengan menghancurkan diri sebelum terdistorsi sepenuhnya ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751750106
					],
					"speakerTitle": "Masuk ke kolam"
				},
				{
					"id": 751750106,
					"content": "Tapi bagaimana caranya menentukan target korosi dengan akurat? Sampel yang bisa dikendalikan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751750107
					],
					"speakerTitle": "Masuk ke kolam"
				},
				{
					"id": 751750107,
					"content": "Bereksperimen pada diri sendiri? Kamu sudah gila ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751750108
					],
					"speakerTitle": "Masuk ke kolam"
				},
				{
					"id": 751750108,
					"content": "\"Ini bukan hal buruk. Dengan begini, tubuh rusak ini masih bisa berguna.\"",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750109
					]
				},
				{
					"id": 751750109,
					"content": "Jadi, ada kemungkinan kamu tidak akan hidup setelah sistem ini diaktifkan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751750110
					],
					"speakerTitle": "Masuk ke kolam"
				},
				{
					"id": 751750110,
					"content": "Apa Abyss sudah merusak otakmu? Atau ... atau kamu ingin orang-orangmu jadi korban api pemakamanmu?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751750111
					],
					"speakerTitle": "Masuk ke kolam"
				},
				{
					"id": 751750111,
					"content": "\"Kamu tidak percaya dengan kaummu sendiri? Semua penguasa sudah menyetujuinya, kecuali kamu.\"",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750112
					]
				},
				{
					"id": 751750112,
					"content": "Mereka cuma menuruti rencanamu tanpa memahami makna sebenarnya di baliknya ... Aku tidak setuju.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751750113
					],
					"speakerTitle": "Masuk ke kolam"
				},
				{
					"id": 751750113,
					"content": "\"Itu tidak penting. Kehancuran ... juga menandakan kelahiran kembali. Ini keputusanku.\"",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750114
					]
				},
				{
					"id": 751750114,
					"content": "\"Hah ... Sayangnya aku hanya bisa terjaga untuk waktu yang singkat setiap hari. Intinya aku akan menyalakannya setelah semuanya sudah siap.\"",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750115
					]
				},
				{
					"id": 751750115,
					"content": "Apa tidak ada jalan lain? Aku akan mencoba mencari cara lain ... Kamu tidak mengorbankan dunia ini ke dalam lautan api hanya demi dendam pribadi, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751750116
					],
					"speakerTitle": "Masuk ke kolam"
				},
				{
					"id": 751750116,
					"content": "\"Mungkin saja. Aku akan melakukan apa pun untuk menghalangi bayangan mereka mencemari dunia ini.\"",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750117
					]
				},
				{
					"id": 751750117,
					"content": "\"Heh, jalan lain ya ... Apa kamu yakin bisa mendapatkan yang kamu inginkan dari 'manusia' itu? Tanganmu sudah terlalu kotor ....\"",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750118
					]
				},
				{
					"id": 751750118,
					"content": "\"Aku pernah mencoba membuatmu mengerti ... tapi sama seperti mereka yang mencari kebijaksanaan dari kolam api, mengetahui dan menerima sesuatu adalah dua hal yang berbeda.\"",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750119
					]
				},
				{
					"id": 751750119,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751750120
					],
					"speakerTitle": "Masuk ke kolam"
				},
				{
					"id": 751750120,
					"content": "\"Kalau kamu pikir aku cuma ingin 'menghancurkan' ... dan kamu ingin membangun sebuah dunia ... Hentikanlah aku. Bunuh aku, buktikan dirimu padaku!\"",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750121
					]
				},
				{
					"id": 751750121,
					"content": "\"Tapi ketahuilah, Kukulkan. Ini bukan ramalan, tapi hanya nasihat dari seseorang yang sudah pernah menempuh jalan ini. Suatu hari nanti ....\"",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750122
					]
				},
				{
					"id": 751750122,
					"content": "\"Kamu akan menempuh jalan yang sama denganku.\"",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		}
	]
}