				"objectNames": [
					"Araminali"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731000101,
					"content": "#Apa Nara {NICKNAME} mau buka \"peti harta karunnya\"? Tapi ... masih ada banyak Aranara yang butuh bantuan di Vana sana. Kalau saja Nara Emas bisa membantu para Aranara ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000102
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000102,
					"content": "Akan Araminali siapkan \"peti\" yang terisi penuh! \"Harta karun\" yang dikirimkan balik oleh Aranimba akan ikut dimasukkan ke dalam \"peti\" sampai penuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araminali"
				}
			]
		},
		{
			"id": 7310002,
			"completionStepIds": [
				7310014
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
