				"objectNames": [
					"Araminali"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731000201,
					"content": "#Araminali tahu kalau Nara Emas adalah Nara baik yang pernah membantu Aranara. Jadi, \"peti harta karun\" Araminali ini untuk Nara {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araminali"
				}
			]
		},
		{
			"id": 7310003,
