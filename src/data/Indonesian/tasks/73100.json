			"dialogs": [
				{
					"id": 731000701,
					"content": "#Araminali sudah kenyang. \"Peti harta karun\" masih lapar. Lapar itu tidak baik. Nara {NICKNAME} dan Paimon sudah jalan di banyak tempat, pastinya sangat lapar. Nara {NICKNAME} dan Paimon makanlah banyak jamur supaya bertenaga.",
					"roleType": "TALK_ROLE_NPC",
