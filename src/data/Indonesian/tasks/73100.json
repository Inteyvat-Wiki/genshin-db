					"content": "#Araminali belum siap! \"Peti harta karun\"-nya belum penuh. Nara {NICKNAME} dan Paimon bisa \"menganggur\" dulu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000602
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000602,
					"content": "#Hmm, bukan itu maksudku. Nara {NICKNAME} dan Paimon bisa \"bebas keluyuran\" dulu. Siapa tahu bakal ketemu Aranara yang butuh bantuan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araminali"
				}
			]
		},
