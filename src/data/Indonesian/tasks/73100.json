			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Araminali"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731000301,
					"content": "#Araminali dengar kalau Nara {NICKNAME} \"unjuk gigi\" di Vana ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000302
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000302,
					"content": "#\"Harta karun\"-nya sudah dimasukkan ke dalam \"peti\". Nara {NICKNAME} bisa membuka \"peti harta karun\"-nya, \"jangan sungkan-sungkan\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araminali"
				}
			]
		},
		{
			"id": 7310004,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7310014",
							"3"
						],
						"stepId": 7310014,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_GREATER",
						"rawParams": [
							"73100",
							"32"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Araminali"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731000401,
					"content": "#Nara {NICKNAME}, dan Paimon, ayo buruan! \"Peti harta karun\" Araminali-nya sudah siap dari tadi. Araminali sudah lama menunggu loh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000402
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000402,
					"content": "Sahabat Aranara, \"peti harta karun\"-nya sudah penuh. Waktunya dibuka!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araminali"
				}
			]
		},
		{
			"id": 7310005,
			"completionStepIds": [
				7310015
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7310015",
							"2"
						],
						"stepId": 7310015,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Araminali",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731000501,
					"content": "#Para Aranara memberitahu Araminali kalau Nara {NICKNAME} dan Paimon sudah banyak berbuat kebaikan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000502
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000502,
					"content": "Araminali dari awal sudah tahu. Kata-kata pujian itu mengalir sepanjang cabang pohon di hutan, mengarungi aliran air kecil, mengikuti desiran angin sepoi-sepoi yang bertiup memasuki \"sarang kebahagiaan\" Araminali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000503
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000503,
					"content": "#Jadi kali ini Araminali menjejali \"peti\" sampai penuh dan menunggu sampai Nara {NICKNAME} membukanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000504
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000504,
					"content": "#Benda berkilauan yang dibawa ke sini oleh Aranimba juga dijejalkan ke dalam \"peti\". Barangkali {NICKNAME} akan menyukainya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000505
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000505,
					"content": "Apakah Aranimba sudah kembali?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731000506
					]
				},
				{
					"id": 731000506,
					"content": "Emm, Aranimba tidak seperti pohon besar yang berakar dalam. Dia adalah Aranara yang tidak bisa diam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000507
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000507,
					"content": "Eh, apa Araminali enggak kesepian di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731000508,
					"content": "\"Kesepian\" itu apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000509
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000509,
					"content": "Emm ... itu, kalau kamu lagi sendirian, kamu enggak mau ada yang nemenin di sisimu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731000510,
					"content": "Ada banyak Aranara di Vanarana, jadi Araminali tidak \"kesepian\" sama sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000511
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000511,
					"content": "Namun, Arayama dan Aranimba sudah tidak lagi berada di Vanarana. Dulu, ketiga Aranara ini sudah biasa bersama-sama, dan mereka selalu bergembira tak peduli apa yang mereka lakukan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000512
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000512,
					"content": "Ararakalari Arayama sangat kuat. Nara yang lemah tidak akan bisa menghancurkannya. Aranimba sangat pandai melukis, berbagai macam benda, sangatlah indah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000513
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000513,
					"content": "Tapi sekarang cuma ada Araminali dan \"peti harta karun\"-nya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000514
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000514,
					"content": "Araminali ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731000515,
					"content": "Tidak apa-apa. Araminali punya banyak \"peti harta karun\", meskipun tidak mengerti kenapa Nara sangat suka membuka peti ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000516
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000516,
					"content": "Tapi Araminali adalah pemilik \"peti harta karun\"-nya. Nara yang suka peti harta karun juga suka Araminali, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000517
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000517,
					"content": "Tapi, Araminali tidak punya \"harta karun\" lagi. Emm ... \"peti\"-nya akan dikosongkan sementara waktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000518
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000518,
					"content": "#Meskipun \"peti harta karun\" Araminalinya bakal kosong, Nara {NICKNAME} tetap jadi sahabat Aranara ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araminali"
				}
			]
		},
