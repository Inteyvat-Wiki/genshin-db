			"dialogs": [
				{
					"id": 3770201,
					"content": "Kalian sudah datang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770202
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3770202,
					"content": "#Eh? Kamu ... {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770203,
						3770204
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3770203,
					"content": "Jean?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3770205
					]
				},
				{
					"id": 3770205,
					"content": "Jadi, kesatu ... yang kuhubungi, bukan hanya satu orang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770206
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3770206,
					"content": "Kedua ... dia datang ke sini sebagai \"Jean\", dan bukan sebagai Grand Master.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770207
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3770207,
					"content": "Orang ini tidak akan pernah kamu temui, sekalipun kamu adalah Honorary Knight.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770208
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3770208,
					"content": "Ini di luar dugaanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770209
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3770209,
					"content": "Aku dengar berita tentang Holy Lyre, tapi aku tidak pernah menyangka kalau ternyata kamu yang melakukannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770210
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3770210,
					"content": "Jadi, benarkah suara dari Holy Lyre dapat memurnikan Stormterror dan mengembalikannya ke kondisi semula?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770211
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3770211,
					"content": "#Benar sekali! {NICKNAME} terus berada di barisan terdepan dan selalu berusaha menyelesaikan masalah Stormterror ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770212
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3770212,
					"content": "Memang pantas disebut bintang baru Knights of Favonius!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770213
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3770213,
					"content": "Kok rasanya malah kayak bangga melanggar hukum ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3770214,
					"content": "Aku paham kalau penjelasan aneh semacam ini memang sulit untuk dipercaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770215
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3770215,
					"content": "Tapi, mari kita dengar sekali lagi lagu dari sang penyair untuk meyakinkan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770216
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3770216,
					"content": "Aku percaya kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770217
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3770217,
					"content": "Grand Master kita yang keras kepa ... eh, apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770218
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3770218,
					"content": "Aku sama sekali tidak terpikirkan apa alasan dari pengkhianatan Dvalin, mengingat dulunya dia merupakan satu dari The Four Winds.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770219
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3770219,
					"content": "Tetapi, kalau dia terkena racun di pertarungan di Mondstadt bertahun-tahun lalu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770220
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3770220,
					"content": "Dan terkena kutukan dari Abyss Mage ketika dia terbangun, kita tidak bisa menyalahkan dia sepenuhnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770221
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3770221,
					"content": "Tetapi, sebagai Grand Master, aku jelas tidak bisa mengatakan hal ini secara terang-terangan kepada masyarakat umum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770222
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3770222,
					"content": "Karena tekanan diplomatik dari Fatui, Knights of Favonius sulit untuk menyelesaikan masalah Stormterror secara damai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770223
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3770223,
					"content": "Rakyat akan kehilangan kepercayaan terhadap Knights of Favonius. Aku hanya bisa melakukan hal ini secara diam-diam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770224
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3770224,
					"content": "Hmm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770225
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3770225,
					"content": "Itulah salah satu alasan kenapa aku tidak suka cara kerja Knights of Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770226
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3770226,
					"content": "Hal yang mengejutkanku adalah kamu bisa memercayai seorang pendatang begitu saja ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770227
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3770227,
					"content": "Tetapi bahkan <color=#00E1FFFF>senior</color> yang biasanya skeptis dan penuh kecurigaan, juga memercayai dia, bukan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770228
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3770228,
					"content": "Sudah kubilang, jangan sebut aku senior ... Sudahlah, lagi pula kita juga tidak terlalu sering bekerja sama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770229,
						3770230
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3770229,
					"content": "Senior?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3770231
					]
				},
				{
					"id": 3770231,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770232
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3770232,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770233
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3770233,
					"content": "Wow! Uhm ... situasinya jadi serba canggung ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3770234,
					"content": "Aku punya gambaran kasar tentang keberadaan Holy Lyre der Himmel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770235
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3770235,
					"content": "(Bagus! Sepertinya dia sangat berbakat dalam mengalihkan topik ....)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770236
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3770236,
					"content": "Akar dari konflik antara Mondstadt dan Snezhnaya sepertinya ada di konflik antara tujuh bangsa dan Archon yang mereka puja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770237
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3770237,
					"content": "Fatui pengikut Archon Cryo sepertinya mengincar kekuatan Archon Anemo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770238
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3770238,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770239,
						3770240
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3770239,
					"content": "Jadi mereka akan mengambil alih tugas pertahanan Mondstadt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3770241
					]
				},
				{
					"id": 3770241,
					"content": "Benar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770242
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3770242,
					"content": "Kalau Knights of Favonius secara terbuka mencegah percobaan pembunuhan terhadap Dvalin, maka ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770243
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3770243,
					"content": "Holy Lyre, adalah satu-satunya cara untuk mendapatkan kekuatan Archon Anemo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770244
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3770244,
					"content": "Jumlah anggota Fatui yang datang ke Mondstadt benar-benar sedikit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770245
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3770245,
					"content": "Aku berhasil mendapatkan beberapa informasi dari mereka ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770246
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3770246,
					"content": "Dari informasi yang didapat Diluc, Fatui tidak menyimpan Holy Lyre di dalam Goth Grand Hotel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770247
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3770247,
					"content": "Kurasa mereka tidak akan menyimpan barang curian di tempat yang mudah ditemukan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770248
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3770248,
					"content": "Paimon ngerti deh. Kalau mereka membuat keributan besar, bisa jadi masalah diplomatik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770249
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3770249,
					"content": "Huh ... begitulah hubungan diplomatik antara ketujuh bangsa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770250
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3770250,
					"content": "Pengembara, kamu sudah siap?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3770240,
					"content": "Jadi mereka ingin membunuh Dvalin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3770241
					]
				},
				{
					"id": 3770230,
					"content": "(Pura-pura tidak mendengar).",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3770231
					]
				},
				{
					"id": 3770204,
					"content": "Kenapa Grand Master ada di sini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3770205
					]
				}
			]
		},
