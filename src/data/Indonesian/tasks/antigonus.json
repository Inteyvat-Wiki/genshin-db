			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Antei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722370301,
					"content": "Kalian berdua ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370302
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370302,
					"content": "Kamu Antei ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722370303,
					"content": "Benar, itu namaku. Aku ... merasa sedikit aneh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370304
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370304,
					"content": "Aku ingat mengejar orang-orang itu ... merobek sebuah inti dan melemparkannya ke sebuah kemah. Setelah itu aku sempoyongan karena lukaku lumayan parah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370305
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370305,
					"content": "Lalu aku terbangun dan melihat kalian ... tapi sekarang aku merasa baik-baik saja. Apakah sebentar lagi aku akan mati atau ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370306
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370306,
					"content": "....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722370307
					]
				},
				{
					"id": 722370307,
					"content": "Tidak, ini tidak penting sekarang. Apakah kalian datang untuk menangkapku lagi? Aku sudah membuktikan kalau aku tidak bersalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370308
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370308,
					"content": "Orang-orang dari Khaenri'ah itu yang mencuri bukunya dari perpustakaan. Memang aku yang ditugaskan jadi pengawal mereka, tapi mana mungkin aku bersekongkol dengan mereka!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370309
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370309,
					"content": "Aku melacak tim diplomatik mereka sampai ke sini dan memukuli mereka semua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370310
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370310,
					"content": "Tapi aku menghabiskan banyak waktu saat menghadapi sejenis makhluk mesin raksasa yang mereka bawa. Akhirnya aku berhasil mencabut inti mesinnya, tapi aku juga terluka parah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370311
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370311,
					"content": "Mesin yang rusak itu jatuh menimpa buku yang hilang itu. Sudah tidak ada cara untuk mengambilnya sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370312
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370312,
					"content": "Wow, Jibashiri dari Byakuyakoku kuat juga ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722370313,
					"content": "Tunggu, bukannya kalian Jibashiri, atau calon Jibashiri juga? *huff* Ah sudahlah. Awalnya Jibashiri adalah pahlawan yang melawan Bathysmal Vishap. Setelah beberapa lama baru mereka jadi penegak hukum, para hakim alam bawah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370314
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370314,
					"content": "Inti mesin itu ada di kemah. Pergi saja ke sana dan lihat sendiri kalau tidak percaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Antei"
				}
			]
		},
		{
			"id": 7223704,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
