			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Antei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722370401,
					"content": "Aku pernah dengar seorang utusan Pulau Narukami yang berbicara tentang makhluk bernama \"burung\". Makhluk ini bersayap dan bisa terbang di langit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370402
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370402,
					"content": "Menakjubkan sekali ya, kamu bisa membayangkannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370403
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370403,
					"content": "Ada orang yang percaya kalau makhluk ini adalah. utusan daripada dewa yang memegang nasib manusia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370404
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370404,
					"content": "Dan jika seorang yang dikucilkan meninggal di alam liar sana, makhluk ini akan datang dan memakan jasad orang tersebut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370405
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370405,
					"content": "Hewan ini benar-benar membuatku terpukau. Kalau aku bisa hidup sampai keesokan hari, aku pasti akan memelihara seekor burung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Antei"
				}
			]
		},
		{
			"id": 7223705,
			"completionStepIds": [
				7223708
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7223708",
							"2"
						],
						"stepId": 7223708,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Antei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722370501,
					"content": "Apa kamu sudah dapat bukunya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370502
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370502,
					"content": "Dapat. Kamu ternyata memang tidak bersalah, Antei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722370503,
					"content": "Dari yang kamu katakan tadi, kamu bukan Jibashiri ... Sayang sekali. Kalau tidak kamu bisa langsung menyatakan aku tidak bersalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370504
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370504,
					"content": "Aku jadi bisa langsung membuktikan bahwa aku tidak bersalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370505
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370505,
					"content": "Sekali lagi, aku merasa sangat bersemangat, tapi aku yakin aku kelelahan karena kehilangan terlalu banyak darah barusan. Aku tidak bisa mengabaikan pemikiran bahwa aku akan mati sebentar lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370506
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370506,
					"content": "Duh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722370507,
					"content": "*huff* Hai orang asing, aku punya pertanyaan. Apakah dituduh secara tidak benar oleh Byakuyakoku adalah sebuah dosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370508
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370508,
					"content": "....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722370509
					]
				},
				{
					"id": 722370509,
					"content": "Jika aku, seseorang yang pikirannya tak bisa tenang ini ditinggalkan di sini oleh Tokoyo Ookami sebagai Sinshade. Apakah ini sebuah kesalahan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370510
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370510,
					"content": "Apakah aku bersalah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370511
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370511,
					"content": "Tidak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722370512
					]
				},
				{
					"id": 722370512,
					"content": "#Hati-hati {NICKNAME}. Kalau dia sadar tentang ... Itu loh, nanti dia hilang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722370513,
					"content": "Kamu hanyalah bayangan yang tertinggal dari Antei.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722370514
					]
				},
				{
					"id": 722370514,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370515
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370515,
					"content": "Kamu tidak bersalah, dan akan kupastikan semua orang tahu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722370516
					]
				},
				{
					"id": 722370516,
					"content": "Haha. Begitukah? Jadi aku hanya sebuah bayangan, yang ditinggalkan setelah kematianku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370517
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370517,
					"content": "Dan ... aku tidak bersalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370518,
					"content": "Bayangan Antei mulai melafalkan kalimat-kalimat yang terputus-putus.\\n\"Hukum langit apa yang telah kulanggar ... Mengapa mereka yang kurang beruntung bergantung pada para dewa?\\nApa perbuatanku berarti, karena olehnya namaku menjadi penuh dosa?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Antei"
				}
			]
		}
	]
}