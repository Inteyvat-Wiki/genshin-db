					"nextDialogs": [
						411440302
					]
				},
				{
					"id": 411440302,
					"content": "Ada apa, apakah kamu mau membantuku mengantar makanan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411440303
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 411440303,
					"content": "Kebetulan sekali kalian datang, ada seorang tamu bernama Ling'guan yang memesan Matsutake Meat Roll dariku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411440304
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 411440304,
					"content": "Dia ingin aku mengirimkan pesanannya ke suatu tempat di bagian barat laut Dihua Marsh. Dia sudah membayar lunas pesanannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411440305
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 411440305,
					"content": "Bagaimana? Kalau kamu ada waktu luang, mungkin kamu bisa membantuku mengantarnya, aku pasti akan memberikan imbalan yang setimpal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yanxiao"
				}
			]
