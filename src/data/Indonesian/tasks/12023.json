			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hirai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120230501,
					"content": "Pulau Watatsumi akhirnya damai juga, dan itu semua berkat Yang Mulia Sangonomiya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230502
					],
					"speakerTitle": "Hirai"
				},
				{
					"id": 120230502,
					"content": "Ada hal baru apa yang terjadi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230503
					]
				},
				{
					"id": 120230503,
					"content": "Belakangan ini ya? Hmm, coba kupikir-pikir ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230504
					],
					"speakerTitle": "Hirai"
				},
				{
					"id": 120230504,
					"content": "Ya, hal terbesar untuk kami adalah, kami akhirnya bisa melaut lagi untuk menangkap ikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230505
					],
					"speakerTitle": "Hirai"
				},
				{
					"id": 120230505,
					"content": "Selama masa peperangan, lautan ini penuh dengan kapal perang. Kami hanya bisa menangkap ikan-ikan kecil dan udang di dekat pantai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230506
					],
					"speakerTitle": "Hirai"
				},
				{
					"id": 120230506,
					"content": "Kalau hasil tangkapan kami tidak bagus, kami akan kelaparan. Anak-anak kecil yang malang akan menangis sepanjang hari dan malam, tapi aku juga tidak bisa berbuat apa-apa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230507
					],
					"speakerTitle": "Hirai"
				},
				{
					"id": 120230507,
					"content": "Kami akan tidur dengan perut keroncongan dan membolak-balik badan sepanjang malam karena tidak bisa tidur, kami berusaha untuk bertahan hingga pagi. Setidaknya kondisi sekarang sudah membaik ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230508
					],
					"speakerTitle": "Hirai"
				},
				{
					"id": 120230508,
					"content": "Aku pernah mendengar tentangmu, kamu Kapten Swordfish II kan? Terima kasih banyak untuk bantuanmu. Ini, ambillah ikan ini. Baru saja ditangkap, jadi ... uh, sedikit amis. Tapi tidak masalah kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230509
					],
					"speakerTitle": "Hirai"
				},
				{
					"id": 120230509,
					"content": "Oh, tidak, tidak, tidak ... Ka-kami tidak ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230510,
					"content": "Oh, ayolah! Ambillah! Tanpa kalian, kami mungkin masih harus tidur sambil menahan lapar. Yang Mulia selalu mengajarkan kami untuk membalas budi dan bersyukur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230511
					],
					"speakerTitle": "Hirai"
				},
				{
					"id": 120230511,
					"content": "#Baik, terima kasih ya. {NICKNAME}, ayo kita coba tanya yang lain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
