			},
			"dialogs": [
				{
					"id": 120230601,
					"content": "Silakan, buah dan sayuran segarnya! Cocok untuk mengurangi rasa enek sehabis makan daging panggang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230602
					],
					"speakerTitle": "Kabasawa"
				},
				{
					"id": 120230602,
					"content": "Ada hal baru apa yang terjadi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230603
					]
				},
				{
					"id": 120230603,
					"content": "Maksudmu persekongkolan Tenryou Commission dan Fatui? Aku pernah dengar soal itu, tapi tidak tahu infonya secara detail.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230604
					],
					"speakerTitle": "Kabasawa"
				},
				{
					"id": 120230604,
					"content": "Tapi aku juga merasa para prajurit tampak lebih bersemangat. Kamu lihat pria di sana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230605
					],
					"speakerTitle": "Kabasawa"
				},
				{
					"id": 120230605,
					"content": "Belakangan ini dia bersikap aneh — selalu berteriak dan mengayunkan tombak ke mana-mana waktu dia tidak ada kerjaan. Dia membuatku takut berkali-kali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230606
					],
					"speakerTitle": "Kabasawa"
				},
				{
					"id": 120230606,
					"content": "Ugh, sungguh sebuah keajaiban, karena pertempuran akhirnya berakhir juga. Aku benar-benar berharap tidak ada lagi masalah-masalah yang tercipta dan memperburuk keadaan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230607
					],
					"speakerTitle": "Kabasawa"
				},
				{
					"id": 120230607,
					"content": "Maaf, yang kutahu hanya ini saja. Kalau kamu tertarik, kamu bisa menanyakan langsung padanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230608
					],
					"speakerTitle": "Kabasawa"
				},
				{
					"id": 120230608,
					"content": "#Akhirnya ada petunjuk juga. Ayo kita lihat apa yang dilakukan pria itu, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
