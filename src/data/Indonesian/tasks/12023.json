			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kouzen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120230201,
					"content": "Ihhh ... orang ini bau alkohol ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230202,
					"content": "Hmm? Tunggu, tunggu, jangan bilang ... Kapten Swordfish II! Benar kan?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230203
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230203,
					"content": "Akhirnya kamu kembali. Kukira kamu sudah mencampakkan grup kami dan kabur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230204
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230204,
					"content": "Oh tentu tidak! Kita tidak pernah lari dari pertarungan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230205,
					"content": "Hmph, benarkah? Belakangan semua orang selalu berbicara tentang kedamaian dan ketenangan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230206
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230206,
					"content": "Apa kamu masih ingat hal yang paling penting bagi pasukan pemberontak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230207
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230207,
					"content": "Semangat bertarung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230208
					]
				},
				{
					"id": 120230208,
					"content": "Benar sekali. Jadi aku akan mengujimu untuk mengetahui apakah kamu masih pantas menjadi petarung di pasukan pemberontak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230209
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230209,
					"content": "Akan kujawab semua pertanyaanmu, kalau kamu bisa mengalahkanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230210
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230210,
					"content": "Ugh, orang ini ya ... Memangnya susah ya bicara seperti orang normal ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230211,
					"content": "#Bagaimana? Kita terima tantangannya, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230212,
						120230213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230212,
					"content": "Tentu, toh kita tidak akan kalah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230214
					]
				},
				{
					"id": 120230214,
					"content": "Hmph ... Kita lihat saja nanti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230213,
					"content": "Beri tahu aku semua hal yang kamu tahu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230214
					]
				}
			]
		},
