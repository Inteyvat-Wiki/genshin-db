			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kouzen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120230301,
					"content": "Kamu kuat sekali ... Tidak heran Yang Mulia Sangonomiya memilihmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230302
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230302,
					"content": "Kamu benar-benar punya semangat bertarung ... Mungkin, kamu bisa memahami kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230303
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230303,
					"content": "Kapten ... Apakah kamu mau menjadi rekan kami?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230304
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230304,
					"content": "Tapi jelaskan dulu sebenarnya apa yang terjadi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230305
					]
				},
				{
					"id": 120230305,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230306
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230306,
					"content": "Kami hanya mengarangnya. Cerita tentang Tenryou Commission yang bekerja sama dengan Fatui ... Itu tidak terjadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230307
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230307,
					"content": "HAH!? Tapi Kokomi khawatir sekali loh! Jadi semua itu cuma karangan kalian saja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230308,
					"content": "Apa yang kamu pikirkan sih? Karangan kalian bisa membuat kalian perang dengan Tenryou Commission lagi, tahu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230309,
					"content": "Ya. Justru itulah yang kami harapkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230310
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230310,
					"content": "Pembicaraan Damai? *huff* Semua orang setuju dengan hal ini. Karena itulah masa depan Pulau Watatsumi terancam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230311
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230311,
					"content": "Memangnya apa yang menjamin kalau Tenryou Commission tidak akan menusuk kita dari belakang? Dan apa yang menjamin Raiden Shogun tidak akan mengeluarkan Dekrit Perburuan Vision lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230312
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230312,
					"content": "Kita ini pasukan pemberontak! Yang paling penting adalah semangat bertarung kita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230313
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230313,
					"content": "Kita tidak bisa memercayai Tenryou Commission atau Raiden Shogun. Tapi kita pasti bisa memercayai diri kita sendiri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230314
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230314,
					"content": "Kamu pasti setuju juga, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230315
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230315,
					"content": "Kata-katanya masuk akal sih, tapi Paimon merasa ada yang salah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230316,
					"content": "Intinya ... kamu hanya ingin terus bertarung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230317
					]
				},
				{
					"id": 120230317,
					"content": "Iya! Semua yang kamu bilang barusan itu hanya dugaanmu saja, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230318,
					"content": "Yang benar saja, masa kamu mau sengaja menyebarkan gosip dan merusak kedamaian yang semua orang dapatkan dengan susah payah, cuma karena sesuatu yang belum pasti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230319,
					"content": "Jaga nada bicaramu, jangan bertingkah seolah-olah kamu lebih hebat dariku! Memangnya kamu tahu apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230320
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230320,
					"content": "Demi mencapai kemenangan, kami menggunakan seluruh semangat bertarung kami. Kamu mengerti? Kami mengerahkan seluruhnya. Lalu tiba-tiba sekarang mereka bilang kalau semuanya sudah tidak diperlukan lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230321
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230321,
					"content": "Aku harus meletakkan senjataku dan mulai hidup seperti orang biasa, bagaimana caranya? Bagaimana bisa ... setiap kali aku menutup mataku, aku melihat wajah rekan-rekanku yang gugur di peperangan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230322
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230322,
					"content": "Setiap kali aku melihat mereka dalam benakku, wajah mereka menjadi pengingat kalau aku tidak bisa memaafkan Tenryou Commission dan Dekrit Perburuan Vision!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230323
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230323,
					"content": "Kurasa kalian memang bukan salah satu dari kami ... Yah, terserahlah. Laporkan saja pada Sangonomiya kalau kalian mau. Tapi kalian sudah terlambat untuk mencegah kami ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230324
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230324,
					"content": "Terlambat? Apa maksud kamu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230325,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230326
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230326,
					"content": "Ahh, dia tidak mau jawab ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230327,
					"content": "#Bagaimana nih, {NICKNAME}? Ini sih gawat namanya! Kita harus kasih tahu Kokomi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1202304,
			"completionStepIds": [
				1202306,
				1202307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1202306",
							"2"
						],
						"stepId": 1202306,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sangonomiya Kokomi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120230401,
					"content": "Jadi begini ceritanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230402,
					"content": "Persekongkolan Tenryou Commission sama Fatui itu omong kosong! Semuanya cuma karangan mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230403,
					"content": "Mereka mau merusak Pembicaraan Damai agar perang dapat dilanjutkan. Terus mereka juga bilang kalau apa pun yang kita lakukan percuma saja, semua sudah terlambat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230404,
					"content": "Ternyata begitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230405,
						120230406
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230405,
					"content": "Kamu kenapa, Kokomi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230407
					]
				},
				{
					"id": 120230407,
					"content": "Aku baik-baik saja. Jangan cemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230408
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230408,
					"content": "Ini salahku. Kalau saja aku bisa memahami perasaan mereka lebih awal, kejadian tidak akan berubah seperti sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230409
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230409,
					"content": "Aku rasa aku mengerti kenapa Kouzen mengatakan bahwa semuanya sudah terlambat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230410
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230410,
					"content": "Meski Pembicaraan Damai baru dilaksanakan besok, tapi kedua belah pihak sudah mengirim masing-masing pengawal ke lokasinya. Mereka bertanggung jawab untuk memastikan lokasi tersebut aman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230411
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230411,
					"content": "Aku curiga kalau salah satu mata-mata pendukung Kouzen sudah menyusup di antara para pengawal, dan bermaksud menyalakan kembali api permusuhan selama negosiasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230412
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230412,
					"content": "Wah, gawat sekali. Bagaimana kalau kita ke sana dan membereskan mereka sekarang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230413,
					"content": "Tidak akan berhasil. Kalau kita membawa pengawal baru ke lokasi negosiasi, tindakan itu akan meningkatkan kewaspadaan dua belah pihak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230414
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230414,
					"content": "Tindakan itu pasti dapat mendorong para pasukan pro-perang untuk mengambil tindakan. Mereka akan menyerang pengawal Tenryou Commission dan kita akan berada dalam bahaya karena peperangan akan pecah lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230415
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230415,
					"content": "Belum lagi, kita tidak tahu berapa banyak prajurit Pulau Watatsumi yang terlibat dalam rencana ini. Kalau kita mengubah pengawalnya dengan tergesa-gesa, kita menghadapi masalah di mana kita tidak tahu siapa yang harus dipercaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230416
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230416,
					"content": "Kedengarannya situasinya benar-benar rumit. Jadi, tidak ada lagi yang bisa kita lakukan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230417,
					"content": "Jangan khawatir. Apa yang harus terjadi, terjadilah. Hmmm, sekarang waktunya aku untuk menyusun rencana balasan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230418
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230418,
					"content": "Prajurit-prajurit itu memang sudah melewati batas, tapi aku tidak bisa menyalahkan mereka begitu saja. Apa pun yang terjadi, aku akan mencari solusi yang tidak membahayakan nyawa mereka ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230419
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230419,
					"content": "Mari bertemu lagi di sini besok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230406,
					"content": "Kamu baik-baik saja?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230407
					]
				}
			]
		},
		{
			"id": 1202305,
			"completionStepIds": [
				1202308
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
