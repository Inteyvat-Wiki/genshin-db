			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sangonomiya Kokomi",
					"Denjirou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120230101,
					"content": "Sepertinya persiapan acaranya sudah beres. Tapi aku masih harus berpidato singkat sebelum acara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230102
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230102,
					"content": "Oh ... Kira-kira butuh berapa energi tuh? Masih cukup?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230103,
					"content": "Tenang, masih banyak kok. Terima kasih ya kalian berdua, energiku jadi lebih cepat pulih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230104
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230104,
					"content": "Bagus deh! Kami akan menyemangatimu juga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230105,
					"content": "Selamat datang semuanya. Hari ini adalah hari di mana kita merayakan kemenangan kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230106
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230106,
					"content": "Baru-baru ini, perang kita dengan Pasukan Shogun telah berakhir. Akhirnya kita berhasil membuat Dekrit Perburuan Vision dihapuskan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230107
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230107,
					"content": "Tidak ada satu pun dari kita yang bisa mengetahui masa depan Inazuma. Tapi besok, aku akan bertemu dengan Tenryou Commission untuk melaksanakan Pembicaraan Damai. Pegang kata-kataku, aku akan selalu berjuang untuk kedamaian Pulau Watatsumi, sekarang dan selama-lamanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230108
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230108,
					"content": "Terima kasih sedalam-dalamnya untuk perjuangan kalian selama ini. Karena usaha kalian semualah kita baru bisa memenangkan peperangan yang berat ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230109
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230109,
					"content": "Pesta hari ini diadakan sebagai penghormatan untuk setiap orang yang berkumpul di sini hari ini. Kuharap kalian semua bisa bersantai sejenak dan menikmati kemenangan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230110
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230110,
					"content": "Woooooh!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230111
					],
					"speakerTitle": "Denjirou"
				},
				{
					"id": 120230111,
					"content": "Sepertinya malam ini berjalan tanpa halangan. Aku senang sekali semua bisa berjalan lancar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230112
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230112,
					"content": "#Orang-orang biasanya lebih terbuka saat mereka sedang senang. {NICKNAME}, apakah aku bisa meminta tolong padamu untuk mencari informasi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230113
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230113,
					"content": "Aku masih belum mendapatkan petunjuk tentang potensi kerja sama antara Tenryou Commission dan Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230114
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230114,
					"content": "Aku khawatir akan terjadi sesuatu dalam Pembicaraan Damai besok ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230115
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230115,
					"content": "Oke, tentu saja. Kita coba tanya-tanya di sekitar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
