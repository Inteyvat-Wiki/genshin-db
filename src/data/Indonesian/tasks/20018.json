				"points": []
			},
			"dialogs": [
				{
					"id": 200180101,
					"content": "Terima kasih, Pengembara, ah... sudah kuduga bahwa aku pasti akan mengacaukan pekerjaanku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180102
					],
					"speakerTitle": "Terrified Magar"
				},
				{
					"id": 200180102,
					"content": "Aku bahkan tidak bisa membawa gerobak anggur dari satu tempat ke tempat lain tanpa ada masalah... Sebenarnya apa yang bisa kulakukan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180103
					],
					"speakerTitle": "Terrified Magar"
				},
				{
					"id": 200180103,
					"content": "Jika terus seperti ini aku pasti dipecat dari Dawn Winery. Tuan Connor sepertinya sudah lama merasa kinerjaku tidak baik. Ugh, Tuan Elzer mungkin sudah menyiapkan surat pemecatanku, ah selesai sudah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180104
					],
					"speakerTitle": "Terrified Magar"
				},
				{
					"id": 200180104,
					"content": "Eh... tenanglah dulu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200180105
					]
				},
				{
					"id": 200180105,
					"content": "Ah... walaupun pekerjaanku sepertinya sudah tidak ada harapan lagi, tapi aku tetap harus mengantarkan gerobak ini sampai tujuan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180106
					],
					"speakerTitle": "Terrified Magar"
				},
				{
					"id": 200180106,
					"content": "Gerobak juga rusak... Pengembara, bisakah membantuku mencari bahan untuk memperbaikinya? Sebuah <color=#00E1FFFF>Papan Kayu Kokoh</color> saja sudah cukup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Terrified Magar"
				}
			]
		},
