				},
				{
					"id": 200180404,
					"content": "Ah sudahlah, asalkan bisa sampai ke kota, akan kupikirkan langkah selanjutnya di sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180405
					],
					"speakerTitle": "Terrified Magar"
				},
				{
					"id": 200180405,
					"content": "Aku ingat ada tali di gerobak... Pasti diambil oleh mereka tadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180406
					],
					"speakerTitle": "Terrified Magar"
				},
				{
					"id": 200180406,
					"content": "Pengembara, tolong bantu aku mencari seikat <color=#00E1FFFF>tali</color> di dalam hutan sebelah sana.",
