					"nextDialogs": [
						200180403
					],
					"speakerTitle": "Terrified Magar"
				},
				{
					"id": 200180403,
					"content": "Di bagian sini rusak, bagian sana juga rusak... Bahkan jika kuperbaiki, saat bergerak pasti akan hancur.",
