			},
			"dialogs": [
				{
					"id": 700030501,
					"content": "Benar kan ada kucing, tapi kok kucingnya ke sini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700030502,
					"content": "Meong... meong...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030503,
						700030504
					],
					"speakerTitle": "Anak Kucing yang Tersesat"
				},
				{
					"id": 700030503,
					"content": "Meong, meong, meong?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030505
					]
				},
				{
					"id": 700030505,
					"content": "Meong, meong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030506
					],
					"speakerTitle": "Anak Kucing yang Tersesat"
				},
				{
					"id": 700030506,
					"content": "Umm, menurut Paimon kucingnya tidak paham deh apa yang baru saja kamu katakan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700030507,
					"content": "Kita turun dulu saja. Mungkin Aramis tahu siapa pemiliknya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700030504,
					"content": "Kamu tersesat ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030505
					]
				}
			]
		},
		{
			"id": 7000306,
			"completionStepIds": [
				7000308
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
