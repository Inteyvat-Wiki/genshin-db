			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aramis"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700030601,
					"content": "Maaf, sepertinya aku belum pernah melihatnya. Kalau pernah pastinya aku ingat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030602
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 700030602,
					"content": "Oh, baiklah... si kecil kesayanganku sangat menyukai bunga. Kupikir mungkin dia mengejar kelopak bunga yang terbang sampai ke sini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030603
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700030603,
					"content": "Ada yang mencari kucing?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030604
					]
				},
				{
					"id": 700030604,
					"content": "Meong... meong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030605
					],
					"speakerTitle": "Anak Kucing yang Tersesat"
				},
				{
					"id": 700030605,
					"content": "Suara ini... Butterfly? Oh, benar-benar kamu! Lari ke mana saja kamu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030606
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700030606,
					"content": "Dia berlari hingga ke atas tembok kota.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030607
					]
				},
				{
					"id": 700030607,
					"content": "Sudah kuduga... Terima kasih banyak. Butterfly selalu suka mengejar kelopak bunga hingga ke mana-mana, terutama di saat seperti ini, di mana kelopak bunga bertebaran di seluruh kota.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030608
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700030608,
					"content": "Sekali lagi, terima kasih ya. Lain kali kamu berkunjung ke Cat's Tail akan kutraktir minum deh, tentu saja minuman non-alkohol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030609,
						700030610
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700030609,
					"content": "Oh, lagi-lagi seperti ini...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030611
					]
				},
				{
					"id": 700030611,
					"content": "Haha... terima kasih. Sampai jumpa, dan selamat Festival Windblume ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030612
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700030612,
					"content": "Tak kusangka kucing pun akan tertarik dengan kelopak bunga. Sungguh festival yang menyibukkan... syukur kamu menemukan kucing itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030613
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 700030613,
					"content": "Kalau aku yang diminta naik ke sana untuk menyelamatkannya, takutnya lututku tidak akan kuat deh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030614
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 700030614,
					"content": "Terima kasih dan maaf sudah merepotkanmu. Terimalah ini sebagai upah hasil kerjamu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aramis"
				},
				{
					"id": 700030610,
					"content": "Simpan untuk lain kesempatan saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030611
					]
				}
			]
		}
	]
