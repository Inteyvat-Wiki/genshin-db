					"Aramis"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700030101,
					"content": "Oh, apa yang harus kulakukan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030102
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 700030102,
					"content": "Apakah kamu memerlukan bantuan dengan sesuatu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030103
					]
				},
				{
					"id": 700030103,
					"content": "Kapan saja Festival Windblume berlangsung, orang-orang akan selalu menaruh segala jenis bunga di depan patung Archon. Begitu ada angin bertiup, semua kelopak bunga yang bertebaran akan terbang ke seluruh kota.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030104
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 700030104,
					"content": "Kami harus bersusah payah untuk membersihkan bunga-bunga yang layu ini. Tapi aku bisanya membersihkan kelopak bunga dan daun-daun yang berguguran di alun-alun, sementara yang tertiup ke atas atap rumah dan tembok kota tidak bisa kubersihkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030105
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 700030105,
					"content": "Terutama dengan lututku yang seperti ini, sepertinya aku sudah benar-benar tidak kuat lagi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030106
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 700030106,
					"content": "Aku bisa membantumu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030107
					]
				},
				{
					"id": 700030107,
					"content": "Kamu mau membantuku? Bagus sekali! Bunga-bunga layu itu sangat mencolok. Sekali kamu sampai ke atas, kamu pasti bisa melihatnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aramis"
				}
			]
		},
