					"Baron Bigfoot"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400831601,
					"content": "Aku bisa lihat kalau kalian memang serius dengan hal ini. Bagus, ini saatnya mengerahkan seluruh hasil latihanku selama bertahun-tahun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831602
					],
					"speakerTitle": "Baron Bigfoot"
				},
				{
					"id": 400831602,
					"content": "Bersiaplah, lawan kalian adalah tim Semuanya Fungus Cryo milikku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Baron Bigfoot"
				}
			]
		},
		{
			"id": 4008317,
