			"dialogs": [
				{
					"id": 400831801,
					"content": "Mustahil ... timku berhasil dikalahkan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831802
					],
					"speakerTitle": "Baron Bigfoot"
				},
				{
					"id": 400831802,
					"content": "Fiuh, yang barusan itu menangnya enggak gampang. Topi Gendang, kamu dan teman-temanmu luar biasa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
