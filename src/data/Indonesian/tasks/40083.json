			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dori"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400830901,
					"content": "Menurut catatan Layla, seharusnya di sini tempat kita ketemuan sama si Pedagang Serba Bisa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400830902,
					"content": "Kalau dari wajah kalian, sepertinya kalian lagi cari Pedagang Serba Bisa, betul kan? Silakan, silakan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830903
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 400830903,
					"content": "Iya betul! Kok tahu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400830904,
					"content": "Eh, Dori?? Ohhh, jadi kamu toh Pedagang Serba Bisa yang dimaksud Layla?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400830905,
					"content": "Kok kaget? Semua yang dagang dan belanja di Grand Bazaar tahu kalau barang-barang jualan Lord Sangemah Bay itu paling lengkap dan paling luar biasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830906
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 400830906,
					"content": "\"Serba Bisa\", \"Juara\", \"Berkuasa\" ... Ini semua, dan masih banyak lagi sebetulnya, adalah julukanku. Tidak ada pedagang lain yang boleh dijuluki begitu, mimpi saja tidak boleh, kecuali ... mereka berani bayar jutaan Mora untuk ongkos izin penggunaan nama!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830907
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 400830907,
					"content": "Heh, harusnya Paimon sudah tahu dari awal ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830908
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400830908,
					"content": "Kembali ke urusan utamanya. Aku kaget Layla minta kalian ke sini untuk mewakilinya ... Artinya dia lagi sibuk bersenang-senang di turnamen pawang penjinak ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830909
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 400830909,
					"content": "Kelihatannya kalian cukup akrab ya! Kamu tahu banyak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830910
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400830910,
					"content": "Hehe, bukan soal akrab tidak akrab. Layla itu pelanggan lama, dia pernah belanja beberapa barang dariku ... bukan barang-barang yang paling mahal juga sih, tapi tetap saja mahal ... untuk ukuran seorang murid.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830911
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 400830911,
					"content": "Jadi tentu saja aku harus tahu sepak terjangnya, termasuk tahu juga kalau dia sedang ikutan sebuah turnamen yang sangat mencurigakan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830912,
						400830913
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 400830912,
					"content": "Jadi kamu tahu sesuatu tentang hal yang sedang berlangsung ini ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830914
					]
				},
				{
					"id": 400830914,
					"content": "Mm-hmm. Ada yang salah dari semua ini. Dan kebetulan aku ada barang yang terlalu ... panas. Aku ingin jual secepatnya, tapi tidak ada yang minat. Buat kalian saja lah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830915
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 400830915,
					"content": "Emmm, ini ... onderdil dan catatan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830916
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400830916,
					"content": "Katanya sih ini benda dan dokumen yang mau dimusnahkan sama penyelenggara turnamen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830917
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 400830917,
					"content": "Tapi mereka ceroboh. Akan selalu ada orang yang berani korek-korek segala macam demi kesempatan untuk jadi kaya. Dan akhirnya, barang-barang ini sampai ke tanganku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830918
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 400830918,
					"content": "Kalau Paimon lihat sih, ini mirip sama resep Floral Jelly. Dan onderdil-onderdil ini kayaknya berasal dari Wisdom Orb ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830919
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400830919,
					"content": "Mungkin ini bekas eksperimen? Bekas uji coba? Mending kita pegang dulu, terus kasih ke Miko nanti. Mungkin dia bisa tahu sesuatu kalau lihat ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830920,
						400830921
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400830920,
					"content": "Berarti kita boleh berasumsi ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830922
					]
				},
				{
					"id": 400830922,
					"content": "Iya, sepertinya kecurigaan kita enggak salah. Tapi Paimon masih mau main sama si Topi Gendang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830923
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400830923,
					"content": "Aku tidak tahu kalian lagi ngomongin apa, tapi sepertinya barang-barang bisa berguna buat kalian. Baiklah, aku kasih harga spesial deh ... 60 juta Mora saja! Terima kasih banyak~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830924
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 400830924,
					"content": "WOI! Dasar kamu, si kecil licik ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830925
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400830925,
					"content": "Hehe, aku bercanda kok. Tidak ada yang peduli sama barang-barang ini selain kalian dan para Matra. Gini deh, berhubung kita ada bisnis lain hari ini, barang-barang ini aku jadikan bonus saja buat kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830926
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 400830926,
					"content": "Coba lihat daftarnya Layla. Aku mau tahu dia perlu apa. Kalau barangnya sudah ada, nanti aku suruh orang antar biar kalian tidak usah bolak-balik kayak setrikaan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830927
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 400830927,
					"content": "Fiuh, gitu dong! Paimon sudah takut usaha kali ini sia-sia semua ... Harga kayak gitu, kami menang juara satu saja enggak bakal bisa bayar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830928
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400830928,
					"content": "Nih, daftarnya Layla.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830929
					]
				},
				{
					"id": 400830929,
					"content": "Hmm ... tepung campur bubuk Matsutake, selai tua, jus Zaytun Peach ... Fungus dietnya beneran pakai ini? Si Layla tahu dari mana juga sih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dori"
				},
				{
					"id": 400830921,
					"content": "Kalau ada yang tidak beres soal Kautilya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830922
					]
				},
				{
					"id": 400830913,
					"content": "Ada info buat kami?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830914
					]
				}
			]
		},
		{
			"id": 4008313,
