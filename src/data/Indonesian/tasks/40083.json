			},
			"dialogs": [
				{
					"id": 400831501,
					"content": "Pengembara, Paimon. Hari ini ternyata tiba lebih awal dari yang kuperkirakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831502
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 400831502,
					"content": "Maaf, tapi karierku sebagai penulis sedang dipertaruhkan di sini, termasuk reputasiku di mata Lady Yae ... Aku tidak akan membiarkan kalian membantaiku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831503
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 400831503,
					"content": "Maju!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400831504
					]
				},
				{
					"id": 400831504,
					"content": "Jangan kepedean dulu, Nona Souka! Kami juga enggak bakal ngalah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
