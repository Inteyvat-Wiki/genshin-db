				"points": []
			},
			"dialogs": [
				{
					"id": 400831301,
					"content": "#{NICKNAME}, Paimon. Kalian berhasil maju ke babak berikutnya ya? Selamat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831302
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400831302,
					"content": "Hai Layla! Kamu hari ini lebih segeran ya! Terus si Putar-Puter juga kelihatan senang banget. Kayaknya babak terakhir barusan kalian juga menang ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400831303,
					"content": "Aku menang tipis ... Untung tempo hari sempat latihan sama Nona Yae.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831304
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400831304,
					"content": "Pedagang Serba Bisa sudah kirim kan semua pesananku. Terima kasih ya! Aku dan Putar-Puter mau istirahat dulu deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831305
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400831305,
					"content": "*huff* Capek sekali rasanya. Jangan keras-keras deh suaranya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831306
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400831306,
					"content": "Ngomong-ngomong soal Nona Yae ... dia ke mana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400831307,
					"content": "Tadi dia buru-buru pergi sama Nona Souka. Mungkin ada keperluan mendadak. Dan sepertinya mereka diantar sama orang Corps of Thirty ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831308
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400831308,
					"content": "Waktu aku kembali ke arena, mereka sudah jauh. Dan rasanya tidak sopan kalau aku kejar mereka cuma buat tanya-tanya ada apa dan mau ke mana ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831309,
						400831310
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400831309,
					"content": "Mungkin ada kerjaan lain?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400831311
					]
				},
				{
					"id": 400831311,
					"content": "Mungkin. Belakangan ini Miko banyak menghabiskan waktu di turnamen ini, jadi Paimon kira wajar kalau dia ketinggalan banyak kerjaan sebagai pemimpin redaksi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400831312,
					"content": "Terus dia kan pernah bilang mau cari inspirasi sekalian menikmati liburan. Tentara bayaran itu mungkin pemandunya, kita enggak perlu cemas berlebihan deh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400831313,
					"content": "Iya, habis ini babak perempat final pula. Bagiku, ini babak penentuan ... Aku tegang sekali, tapi ayo kita sama-sama berusaha sekuat tenaga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831314
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400831314,
					"content": "Ya! Kita sudah berusaha mati-matian untuk sampai ke sini. Semangat terus, Layla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831315,
						400831316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400831315,
					"content": "Kita juga tidak boleh lengah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400831317
					]
				},
				{
					"id": 400831317,
					"content": "Betul, harus waspada! Oke, kita foto dulu barang-barang dari Dori terus satuin sama foto-foto yang tadi pagi. Nanti kita kasih lihat Miko kalau pas dia ada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400831316,
					"content": "Pertandingan dan penyelidikan, dua-duanya harus tetap jalan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400831317
					]
				},
				{
					"id": 400831310,
					"content": "Yae Publishing House selalu sibuk kan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400831311
					]
				}
			]
		},
		{
			"id": 4008314,
			"completionStepIds": [
				4008307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4008307",
							"2"
						],
						"stepId": 4008307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400831401,
					"content": "Ini kelihatan kayak Floral Jelly biasa deh. Tapi kok asal ditaruh saja di tempat terbuka yang kelihatan sama orang? Terus masih ada resep juga di atas meja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831402,
						400831403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400831402,
					"content": "Tapi biarpun misal mereka nambahin \"bahan khusus\" ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400831404
					]
				},
				{
					"id": 400831404,
					"content": "Hmm, kita juga enggak bisa main ambil dan selidiki seenaknya kan, itu sih maling namanya. Terus kita bakal didiskualifikasi, atau bahkan mungkin ditangkap sama Corps of Thirty.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400831405,
					"content": "Oh, tapi ... kita kan punya Kamera! Kita foto saja Floral Jelly sama resepnya, gimana? Minimal kita ngerekam semua informasi yang penting-pentingnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400831403,
					"content": "Para kontestan juga tidak bakalan curiga.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400831404
					]
				}
			]
		},
		{
			"id": 4008315,
			"completionStepIds": [
				4008302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
