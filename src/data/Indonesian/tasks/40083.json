				"objectNames": [
					"Haniyyah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400831901,
					"content": "Kamu menemukan Floral Jelly dan resepnya, lalu memotretnya untuk dijadikan bukti ....",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400831902
					]
				},
				{
					"id": 400831902,
					"content": "Beres! Tinggal kasih ke ahlinya buat dianalisis. Tapi kita kehabisan waktu ini, ayo cepat kita pergi belanja pesanannya Layla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400831903,
					"content": "Ha-Haniyyah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400831904,
					"content": "Kalian tidak main-main rupanya. Datang pagi-pagi sekali hanya untuk memperkuat Fungus kalian. Pantas saja kalian bisa maju terus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831905
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 400831905,
					"content": "Haniyyah, kita perlu bicara! Soal rencanamu yang kamu bilang ke kami waktu itu, rasanya sudah kelewat batas ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831906
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400831906,
					"content": "Simpan saja kotbah kalian. Kalau kalian pikir aku salah, langkahi dulu aku. Setelahnya, silakan beberkan padaku alasan mutlaknya kenapa pandangan kalianlah yang benar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831907
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 400831907,
					"content": "Dia sama sekali enggak mau dengerin kita loh ... Kenapa jadi gini sih? Padahal awalnya Paimon kira kita bisa akur sama dia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831908,
						400831909
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400831908,
					"content": "Ayo, kita kehabisan waktu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400831910
					]
				},
				{
					"id": 400831910,
					"content": "Ya sudah deh, baiklah ... Ayo Topi Gendang, kita enggak ada waktu buat bermuram durja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400831909,
					"content": "Satu-satunya jalan untuk membujuknya adalah mengikuti aturan mainnya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400831910
					]
				}
			]
		}
