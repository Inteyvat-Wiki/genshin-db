					"Souka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400831701,
					"content": "Aku ... kalah. Sulit dipercaya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831702
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 400831702,
					"content": "Memang manusia fana seperti aku ini tidak ada apa-apanya di hadapan para \"Tamu Kehormatan Tenshukaku\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831703
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 400831703,
					"content": "Astaga, apa kita kelewatan gitu ya? Nona Souka kayaknya kena mental nih ... Miko bilang kita enggak usah ngalah, tapi dia pasti ngamuk deh kalau lihat penulisnya jadi ngenes gitu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400831704,
					"content": "Paimon jadi takut. Sudah deh, kita minta maaf yuk ke Miko! Topi Gendang, buru pasang tampang memelas yang paling merana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4008318,
