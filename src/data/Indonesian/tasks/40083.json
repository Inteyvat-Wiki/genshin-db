			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yae Miko",
					"Layla"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400830501,
					"content": "Maaf Miko! Salahin si Topi Gendang, kami enggak nyangka Nona Souka bakal kalah secepat itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830502,
						400830503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400830502,
					"content": "Paimon, pawang penjinaknya aku loh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830504
					]
				},
				{
					"id": 400830504,
					"content": "Oh? Terus gimana reaksinya? Apa dia kelihatan putus asa lalu bilang \"ini di atas kemampuan manusia fana\" atau semacamnya? Terus dia rebah ke tanah dan mulai meratap meraung-raung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830505
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400830505,
					"content": "Iya betul ... semuanya betul. Kamu sohib banget sama dia ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400830506,
					"content": "Bagus ini. Souka akan meracik pengalaman ini jadi bahan cerita yang berharga. Dia akan bisa menggambarkan perjalanan tokoh utama dan segala halangan yang dihadapinya dengan lebih meyakinkan. Para pembaca juga akan merasa lebih akrab dengan perjuangannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830507
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400830507,
					"content": "Lalu untuk penjahatnya ... mendominasi, kejam tapi pintar sekali, dan yang terpenting, menang. Inspirasinya adalah kalian, jadi tolong ya, jangan sampai kalah sama pecundang kelas dua, hmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830508,
						400830509
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400830508,
					"content": "Astaga, aku jadi penjahat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830510
					]
				},
				{
					"id": 400830510,
					"content": "Jangan ngomongin yang enggak jelas deh! Miko, tolong, tolooong kasih tahu Nona Souka nulisnya jangan jahat-jahat amat ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400830511,
					"content": "#{NICKNAME}, Paimon, Nona Yae ... *uhuk*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830512
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400830512,
					"content": "Layla, tenang, tenang, jangan pingsan lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400830513,
					"content": "Aman kok, aman. Aku sudah nulis ke Amurta, dan mereka kelihatannya berminat. Balasan yang berisi data yang aku perlukan datang dalam waktu sekian jam saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830514
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400830514,
					"content": "Aku sudah coba bikin bermacam-macam camilan buat si Putar-Puter berdasarkan info yang mereka kasih, tapi ... kelihatannya dia tidak suka satu pun. Mungkin aku pakai bahan yang salah ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830515
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400830515,
					"content": "Jadi aku bikin daftar baru yang lebih bagus, sekalian masukin jenis bahan yang mungkin disukai si Topi Gendang. Aku tidak tidur sampai subuh, dan hasilnya hari ini lebih capek dari biasanya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830516
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400830516,
					"content": "Kok kamu bisa dapat hasilnya cepat gitu? Itu sih cepat banget memang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400830517,
					"content": "(Kurang tidur memang bisa bikin lelah sih, tapi seharusnya juga tidak sampai ngos-ngosan begitu.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830518
					]
				},
				{
					"id": 400830518,
					"content": "Dek Layla, gimana? Berhasil kasih pelajaran ke musuhmu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830519
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400830519,
					"content": "Iya! Semua berkat latihan dari Nona Yae. Putar-Puter sekarang jadi lebih nurut, terus reaksinya juga jadi cepat sekali. Aku sejujurnya agak iri ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830520
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400830520,
					"content": "Tapi musuhnya juga lebih kuat sekarang, aku tidak boleh lengah. Putar-Puter masih perlu dilatih kalau aku ingin maju terus sampai perempat final.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830521
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400830521,
					"content": "Masalahnya ... aku ada rencana mengunjungi si Pedagang Serba Bisa jam tujuh pagi besok buat belanja bahan-bahan yang kubutuhkan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830522
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400830522,
					"content": "Oh, itu tidak masalah. Aku akan ikut sesi latihanmu, belanjanya kita serahkan ke bocah-bocah ini saja. Mereka tukangnya kerja serabutan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830523
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400830523,
					"content": "Kedengarannya kalian sudah sering sekali membantu Nona Yae ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830524,
						400830525
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400830524,
					"content": "Iya, buat Guuji Yae apa yang enggak sih?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830526
					]
				},
				{
					"id": 400830526,
					"content": "AHH, iya! Plis jangan jadiin kami penjahat yang nyebelin dan nyeremin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830527
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400830527,
					"content": "Jangan takut, Dek Layla. Mereka cuma merasa bersalah karena sudah mengalahkan Souka, itu saja. Sana kamu beli minum dulu, istirahat dan atur napas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830528
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400830528,
					"content": "Terima kasih banyak loh! Kalian memang terbaik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830529
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400830529,
					"content": "Ini alamat tempat aku janjian ketemu dengan si Pedagang Serba Bisa, dan ini daftar belanjaannya. Makasih ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830530
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400830530,
					"content": "Tenang, kami ikhlas kok! Kamu juga sudah bantu cariin apa saja kesukaannya si Topi Gendang kan. Anggap saja ini balas budi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830531
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400830531,
					"content": "Soal \"faktor tidak stabil\" yang belum sempat dibahas tempo hari ... Salah satunya material penguatan untuk Fungus, kita bisa mulai dari situ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830532,
						400830533
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400830532,
					"content": "Floral Jelly?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830534
					]
				},
				{
					"id": 400830534,
					"content": "Ah, ini potongan cerita paling menarik di dalam novel: investigasi rahasia. Aku yakin kalian juga penasaran, sebenarnya dari mana datangnya kemampuan mistis Wisdom Orb dan Floral Jelly?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830535
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400830535,
					"content": "Lagi pula kalau kita gagal menyingkapkan apa sebenarnya yang ada di balik turnamen ini, dan membiarkan Haniyyah begitu saja ... Entah bagaimana kekacauan yang akan timbul nantinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830536
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400830536,
					"content": "Aduh ... Kenapa jadi ribet gini, Paimon mulai bingung deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830537
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400830537,
					"content": "Kusarankan kalian bergerak sebelum fajar tiba, mumpung orang-orang masih pada lelah dan beristirahat. Mungkin kalian akan menemukan petunjuk penting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830538
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400830538,
					"content": "Kamu mau lakukan seperti yang Miko suruh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830539,
						400830540
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400830539,
					"content": "Yah, itu kan tujuan awalnya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830541
					]
				},
				{
					"id": 400830541,
					"content": "Iya sih. Oke, kita tunggu sampai besok pagi lalu periksa ke Tempat Penguatan Fungus ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830542
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400830542,
					"content": "Jangan takut, Topi Gendang. Kami enggak curiga kok sama kamu. Kami cuma ingin semua orang yang ikutan kompetisi ini aman sentosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400830540,
					"content": "Demi kehidupan yang harmonis dengan sobat jamur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830541
					]
				},
				{
					"id": 400830533,
					"content": "Miko tahu sesuatu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830534
					]
				},
				{
					"id": 400830525,
					"content": "Soalnya kalau tidak mau ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830526
					]
				},
				{
					"id": 400830509,
					"content": "Tapi si Paimon hidupnya numpang ke penjahat. Artinya, dia lebih jahat!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830510
					]
				},
				{
					"id": 400830503,
					"content": "Harusnya aku yang bertanggung jawab.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830504
					]
				}
			]
		},
		{
