				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Giovanni"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 742220801,
					"content": "Ternyata ... benar! Ini tiang sinyal yang dipakai kaum barbar! Berarti mereka ada kirim sinyal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220802,
						742220803
					],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220802,
					"content": "Yakin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220804
					]
				},
				{
					"id": 742220804,
					"content": "*huff* Sulit dipercaya, benar-benar ada mata-mata mereka yang sudah sampai ke sini. Sepertinya kekhawatiran Tribunus Mettius benar-benar jadi kenyataan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220805
					],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220805,
					"content": "Begitu aku laporkan ini kepadanya, tugasku selesai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220806
					],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220806,
					"content": "Terima kasih, warga yang budiman. Kalau bukan karena bantuanmu, mungkin pertahanan kami sudah hancur duluan sebelum mereka datang menyerang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220807
					],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220807,
					"content": "Aku pasti akan membahas kontribusimu saat melaporkan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220803,
					"content": "Tadi kan kamu bilangnya pedang kayu??",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220804
					]
				}
			]
		}
	]
}