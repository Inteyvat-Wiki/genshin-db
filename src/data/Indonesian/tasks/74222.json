				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Moce"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 742220101,
					"content": "Warga yang budiman, waspadalah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220102,
						742220106,
						742220109,
						742220116
					],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220102,
					"content": "Lagi ngapain sih?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220103
					]
				},
				{
					"id": 742220103,
					"content": "Aku? Seperti yang kamu lihat, aku sedang bereskan ancaman barbar. Akhir-akhir ini serangan barbar makin mendekat. Barangkali ada mata-mata yang menyusup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220104
					],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220104,
					"content": "Ini bukan masalah sepele! Darurat waspada harus digalakkan sampai bala bantuan datang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220105
					],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220105,
					"content": "Kalau ada keperluan lain, silakan laporkan ke ajudanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220106,
					"content": "Anak kecil, keliaran sendirian di sini ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220107
					]
				},
				{
					"id": 742220107,
					"content": "Hmm? Anak kecil katamu? Dari mana asalnya? Apa ada prajurit yang melanggar larangan membawa keluarga ke kemah lagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220108
					],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220108,
					"content": "Ck, Dominus Cassiodor terlalu lembek ke anak baru. Kalau ini terjadi tiga puluh tahun yang lalu, pasti yang bersangkutan sudah kena cambuk Tribunus ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220109,
					"content": "Belakangan ada apa tidak yang mencurigakan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220110
					]
				},
				{
					"id": 742220110,
					"content": "Belum ada. Tapi orang barbar itu kelakuannya seperti binatang. Culas, cerdik, menyerang ketika kita lengah. Efek kejut adalah senjata terkuatnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220111
					],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220111,
					"content": "Mereka masuk kota dengan cara licik demi mencari tahu rahasia kita. Lengah setitik saja, musibah akan melanda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220112
					],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220112,
					"content": "Tiga puluh tahun silam, aku ikut Dominus Boethius menaklukkan wilayah utara. Ketika itu mereka cuma suku primitif yang tidak paham apa-apa. Kenapa sekarang jadi pintar gini sih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220113
					],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220113,
					"content": "Tiga puluh tahun yang lalu ... orang tuamu saja belum lahir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220114
					]
				},
				{
					"id": 742220114,
					"content": "Hmm? Mohon maaf, pendengaranku sudah berkurang seiring bertambahnya usia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220115
					],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220115,
					"content": "Waktu memang kejam. Ketika berangkat menaklukkan Bituria dulu, suara gong orang barbar dari bermil-mil jauhnya saja bisa kedengaran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220116,
					"content": "Dadah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220117
					]
				},
				{
					"id": 742220117,
					"content": "Semoga selamat sampai tujuan, warga yang budiman. Ingat, segara melapor bila ada yang mencurigakan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Moce"
				}
			]
		},
		{
			"id": 7422202,
			"completionStepIds": [
				7422202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7422202",
							"2"
						],
						"stepId": 7422202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Giovanni"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 742220201,
					"content": "Aih, perang ini kapan sih selesainya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220202
					],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220202,
					"content": "Kamu ngapain di atas sini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220203
					]
				},
				{
					"id": 742220203,
					"content": "Eh? Tentunya aku sedang mengamati bila ada gerakan kaum barbar yang misterius. Akhir-akhir ini ... Tunggu dulu! Wahai warga yang budiman, kenapa kamu bisa ada di atas sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220204
					],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220204,
					"content": "Lah itu pertanyaanku dong!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220205
					]
				},
				{
					"id": 742220205,
					"content": "*huff* Ya sudahlah, tidak penting. Tribunus Mettius bilang serangan kaum barbar makin mendekat, mungkin akan ada mata-mata yang menyelinap. Jadi harus ekstra hati-hati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220206
					],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220206,
					"content": "Tapi serius deh, kami ini kan kota kecil, ngapain mereka ke sini? Apa lagi sampai kirim mata-mata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220207
					],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220207,
					"content": "Sekecil apa pun, tetap mangsa, kan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220208
					]
				},
				{
					"id": 742220208,
					"content": "Ah, ucapan yang masuk akal. Berarti aku harus tetap bersemangat. Tapi dari cara bicaramu, sepertinya kamu pengalaman sekali ya dalam bidang ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220209
					],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220209,
					"content": "Kalau begitu, apa aku boleh minta tolong kamu untuk periksa di sekitar? Kalau benar ada pergerakan kaum barbar, pasti ada petunjuk yang ditinggalkan, misalnya pedang kayu, atau lainnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220210
					],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220210,
					"content": "Eh? Seperti anak-anak main pedang-pedangan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220211
					]
				},
				{
					"id": 742220211,
					"content": "Yah, soalnya kan mereka kaum barbar! Memangnya aneh kalau mereka buat pedang dari kayu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220212
					],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220212,
					"content": "Pokoknya, tolong ya! Kalau ada pergerakan apa pun, laporkan kepadaku. Ini juga salah satu tanggung jawabmu sebagai penduduk Remuria!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Giovanni"
				}
			]
		},
