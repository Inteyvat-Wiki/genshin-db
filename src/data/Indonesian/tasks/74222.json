			"dialogs": [
				{
					"id": 742220701,
					"content": "Warga yang budiman, menemukan sesuatu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220702,
						742220703
					],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220702,
					"content": "Ada nih ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 742220703,
					"content": "Tidak ada apa-apa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220704
					]
				},
				{
					"id": 742220704,
					"content": "Selalu utamakan keselamatan! Langsung laporkan kepadaku apa pun yang terjadi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Giovanni"
				}
			]
		},
		{
			"id": 7422208,
			"completionStepIds": [
				7422208,
				7422209
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7422208",
