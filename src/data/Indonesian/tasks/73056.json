					"nextDialogs": [
						730560505
					]
				},
				{
					"id": 730560505,
					"content": "Apa maksudmu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560508,
					"content": "Hmm ... seharusnya sudah cukup yang kamu petik, terima kasih sudah membantuku. Sepertinya kita sudah tidak ada urusan lagi di sini, ayo kita pergi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560509
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560509,
					"content": "Haha, baguslah ... sampel-sampel ini akan sangat menolong penelitian kita akan rahasia dan kelemahan \"Withering\" ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560510
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560510,
					"content": "Terima kasih ya, kita kembali lewat jalan ini ... aku mau memberikan sesuatu untuk kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560511
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560511,
					"content": "Yeah, hadiah ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560512,
					"content": "Hehe, anggap saja hadiah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560506,
					"content": "Oke!",
