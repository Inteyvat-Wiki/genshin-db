			"dialogs": [
				{
					"id": 730560201,
					"content": "Tempat yang perlu aku periksa, utamanya ada 3 lokasi. Haha, Aku seharusnya masih belum melupakan total ingatan 30 tahun lalu ... jadi, aku masih bisa memberikan kalian petunjuk di manakah tempatnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560202
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560202,
					"content": "Tapi omong-omong, terima kasih kalian sudah bersedia menemani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560203
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560203,
					"content": "Jangan sungkan begitu, Tuan Khayyam! Ini kan sudah jadi kewajiban \"Javan\"!",
