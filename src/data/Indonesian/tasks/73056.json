			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Khayyam",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730560101,
					"content": "Haha, menarik ... menarik banget. Hutan sudah membaik, hutannya sudah membaik ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560102
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560102,
					"content": "Halo! Kakek, kamu tersesat ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560103,
					"content": "Hmm ... hmm? Frost ...? Ah, kalian memanggilku? Haha, tersesat ya? Tidak, tidak ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560104
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560104,
					"content": "Halo anak-anak. Aku Giyath Khayyam, seorang Dastur dari Amurta, haha ... panggil aku Khayyam saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560105
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560105,
					"content": "Ugh, halo, tuan Khayyam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560106,
					"content": "Tidak, ikuti aku ya, turunkan ujung lidah dan lengkungkan ke tengah ... Kha — lalu buka mulutmu ... yya. Terakhir, tutup bibirmu dan ucapkan mmm —",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560107
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560107,
					"content": "Eh ... Kha — yya — mmm —",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560108,
					"content": "Benar! Bagus! Coba sekali lagi, anak rambut emas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560109,
						730560111
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560109,
					"content": "Kha — yya — mmm —",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560110
					]
				},
				{
					"id": 730560110,
					"content": "Haha, bagus! Kamu lebih hebat dari yang rambut putih! Lihat, aku sudah bilang kalau aku berbakat mengajar fonetik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560113
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560113,
					"content": "Jadi, tuan Khayyam ... kalau kamu enggak tersesat, sedang apa kamu di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560114,
					"content": "Kenapa? Hehe ... Aku peneliti hutan. Bagi seseorang sepertiku, hutan sudah seperti rumah. Kenapa aku bisa tersesat di rumah sendiri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560115
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560115,
					"content": "Oh ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560116,
					"content": "Hutan ini sudah lama dirusak \"Withering\". Semua jenis tanaman sejak 30 tahun lalu terus berkurang secara drastis dan jamur berbahaya malah semakin banyak ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560117
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560117,
					"content": "Tapi akhir-akhir ini, \"Withering\" malah menghilang. Ada banyak tanaman yang dulu menghilang juga tumbuh kembali sementara perkembangbiakan jamur menjadi lebih tertahan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560118
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560118,
					"content": "Aku baru kali ini saja melihat fenomena ini selama 60 tahun lamanya ... jadi aku ke sini untuk menguji faktanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560119
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560119,
					"content": "Oh gitu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560120,
						730560123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560120,
					"content": "Jadi tentang menguji fakta itu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560121
					]
				},
				{
					"id": 730560121,
					"content": "Haha, itu sudah 60 tahun yang lalu ... jangan harap orang tua sepertiku masih ingat. Tapi aku percaya menghilangnya \"Withering\" berhubungan dengan hal itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560122
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560122,
					"content": "Jadi, selanjutnya aku akan masuk ke dalam gua untuk mengambil beberapa sampel dan menguji tebakanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560126
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560126,
					"content": "Gitu ya ... Memang sih \"Marana\" di dalam guanya sudah enggak ada, tapi kan situasinya masih bahaya loh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560127,
					"content": "Haha, itu tidak ada apa-apanya bagiku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560128
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560128,
					"content": "Ugh, tunggu ... apa yang kamu bilang tadi? Di dalam gua ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560129,
						730560130
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560129,
					"content": "\"Marana\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560131
					]
				},
				{
					"id": 730560131,
					"content": "Hmm ... kalau dipikir-pikir lagi, sepertinya aku jadi butuh bantuan kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560132
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560132,
					"content": "Hehe, nah kan apa kata Paimon juga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560133,
					"content": "Hehe, maafkan aku ... sepertinya aku belum tahu nama kalian berdua?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560134
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560134,
					"content": "#Panggil saja aku {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560135
					]
				},
				{
					"id": 730560135,
					"content": "Dan ini Paimon! Pai — mon —!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560136,
					"content": "Paimon? Paimon ... haha, nama yang menarik ... aku baru pertama kali mendengar ada orang atau mungkin peri yang bernama Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560137
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560137,
					"content": "Ah, maaf, maaf. Aku tidak bermaksud menyinggung ... maksudku makhluk kecil ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560138
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560138,
					"content": "Makhluk kecil apaan! Itu saja sudah menyinggung tahu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560139,
					"content": "Baiklah, sudah jangan ngobrol terus. Para \"Javan\", ayo sekarang ikuti aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560140
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560140,
					"content": "\"Javan\" ...? Apa itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560141
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560141,
					"content": "Itu sebutan kuno dari kampung halamanku, yang artinya \"anak muda yang pemberani\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560142
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560142,
					"content": "Kalau mau lengkap artinya \"anak muda yang tidak berdiam diri saat melihat kejahatan dan tidak mencari keamanan diri sendiri saja saat menghadapi ketidakadilan yang tiada habisnya\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560143
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560143,
					"content": "Hehe, persis! Itulah kami!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560144
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560144,
					"content": "Oh? Percaya diri sekali ya? Haha, ayo ikuti aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560145
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560145,
					"content": "Hm ... Kakek Khayyam yakin bisa mengikuti kami?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560146
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560146,
					"content": "Haha ... jangan meremehkan stamina orang tua seperti aku. Aku sudah mempelajari hutan selama 30 tahun! Maju saja terus, nanti akan kususul kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560130,
					"content": "Withering?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560131
					]
				},
				{
					"id": 730560123,
					"content": "Perlu bantuan kami?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560124
					]
				},
				{
					"id": 730560124,
					"content": "Haha, terima kasih ya anak-anak. Walaupun aku sudah tua, tapi kepalaku masih bisa diandalkan, jangan meremehkanku ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560125
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560125,
					"content": "Lagi pula aku tahu cara menyenangkan hutan, hutan tidak akan menyakitiku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560126
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560111,
					"content": "Tuan Khayyam, apa yang kamu lakukan di sini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560112
					]
				},
				{
					"id": 730560112,
					"content": "Hmm ... pengucapanmu terlalu cepat. Tapi tidak apa-apa ... pelan-pelan saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560113
					],
					"speakerTitle": "Khayyam"
				}
			]
		},
		{
