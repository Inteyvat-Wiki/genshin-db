			"dialogs": [
				{
					"id": 730560701,
					"content": "Kenapa kalian datang ke sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560702
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730560702,
					"content": "Eeeh! Ngagetin saja ih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560703,
					"content": "Kalian tahu namaku. Tapi Aranaga enggak pernah bertemu kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560704
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730560704,
					"content": "Jadi ... kenapa kalian datang ke sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560705,
						730560708
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730560705,
					"content": "Ini sulit dijelaskan ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560706
					]
				},
				{
					"id": 730560706,
					"content": "Walaupun kamu enggak ingat banyak hal, tapi kami enggak ada niatan buruk! Kami bakal terus bantu \"Mawtiyima\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560707,
					"content": "\"Mawtiyima\" ... Kalian tahu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560710
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730560710,
					"content": "Hmm ... Kelihatannya kalian bukan orang jahat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560711
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730560711,
					"content": "Tapi jangan berkeliaran dulu, di sini. Cepat-cepat kalian pergi dulu. Masih memulihkan diri sendiri dulu, hutannya ... jadi, pengunjung jangan jalan-jalan dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560712
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730560712,
					"content": "Heh ... Tunggu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560713,
					"content": "Ada barang yang mau kami berikan padamu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560714
					]
				},
				{
					"id": 730560714,
					"content": "Barang untukku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560715
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730560715,
					"content": "Cepat mana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560716
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730560716,
					"content": "Ini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560717
					]
				},
				{
					"id": 730560717,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560718
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730560718,
					"content": "Ini, kamu ingat enggak? Kamu juga pernah ngasih bunga yang sama ke kami loh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560719
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560719,
