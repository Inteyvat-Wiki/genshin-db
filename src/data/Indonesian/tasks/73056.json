						730560615
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560615,
					"content": "Aku juga tidak bisa melihat mereka ... aku bahkan tidak percaya kalau mereka benar-benar ada, barangkali mereka ... hanya fantasi masa kecilku saja ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560616
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560616,
					"content": "Namun, aku masih harus bertahan. Anak-anak, serahkan ini pada mereka ... selagi masih bisa bertemu mereka, selagi ada kemungkinan keajaiban akan terjadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560614,
					"content": "Mereka juga mungkin sudah lupa sama kamu.",
					"roleType": "TALK_ROLE_PLAYER",
