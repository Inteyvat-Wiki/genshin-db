					"nextDialogs": [
						730560307,
						730560308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560307,
					"content": "Memangnya kenapa, Tuan Khayyam?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560309
					]
				},
				{
					"id": 730560309,
					"content": "\"Iram menghilang bersamaan dengan mawar merah, ke mana perginya cawan sang raja ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
