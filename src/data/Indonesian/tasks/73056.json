			"dialogs": [
				{
					"id": 730560601,
					"content": "Terima kasih, kedua \"Javan\". Terima kasih sudah menemani pria tua sepertiku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560602
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560602,
					"content": "Oh ya, kalau kalian tidak keberatan ... ini kenang-kenangan untuk kalian. Maaf ya karena mungkin benda ini bukan benda yang mahal dan berharga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560603
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560603,
					"content": "Wah ... apa ini? Apa ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560604,
					"content": "Kalian pasti pernah melihat bunga kering ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560605
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560605,
					"content": "Eh — !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560606,
						730560607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560606,
					"content": "Ini ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560608
					]
				},
				{
					"id": 730560608,
					"content": "Benar. Dan kalau aku tidak salah ... mereka juga pasti memberikan hadiah yang sama untukmu, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560609
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560609,
					"content": "Hehe ... aku tahu, pertemuan kita bukan sebuah kebetulan ... aku tidak pernah percaya dengan hal seperti itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560610
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560610,
					"content": "Aku serahkan bunga ini padamu. Tolong berikan itu pada teman kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560611
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560611,
					"content": "Hmm, boleh sih, cuma ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560612,
						730560614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560612,
					"content": "Mereka juga sepertinya sudah lupa padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560613
					]
				},
				{
					"id": 730560613,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
