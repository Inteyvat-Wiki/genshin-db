					"Khayyam",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730560401,
					"content": "Ha! Lihat! Lihat ini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560402
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560402,
					"content": "Eh? Tanaman baru? Kok kamu kayak kegirangan banget kelihatannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560403,
					"content": "Bukan, bukan tanaman baru, ini sih jauh lebih baik! Coba lihat, ini \"benteng rahasia\" kami! Ha! Kok jadi hancur begini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560404
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560404,
					"content": "Eh ...? \"Benteng rahasia\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560405,
					"content": "Haha! Sarjana Omar pulang! Dia pulang membawa rahasia bintang! Irfan, Siman, kalian di mana! Kok tidak menyambutku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560406
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560406,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560407,
					"content": "....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560408
					]
				},
				{
					"id": 730560408,
					"content": "Eh ... *uhuk-uhuk*, maaf anak-anak. Aku ... aku terlalu bahagia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560409
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560409,
					"content": "Kalau sudah tua memang begini, ingatannya akan semakin kacau balau kalau buat urusan saat ini, tapi selalu merindu akan urusan-urusan masa kecil, hehe ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560410
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560410,
					"content": "Irfan dan Siman, mereka adalah temanku, kami bertiga bersama-sama membangun \"benteng\" ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560411
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560411,
					"content": "Waktu itu Irfan adalah musisi hebat, sementara Siman adalah marsekal, dan aku adalah sarjana. Terkadang kami akan saling bertukar peran, namanya juga anak-anak ... kalau sudah bosan pasti langsung main ganti saja, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560412
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560412,
					"content": "Irfan berbakat dalam hal musik; Siman badannya tinggi, kuat, tidak ada yang bisa menang darinya; sementara aku? Haha, cuma lahir di keluarga yang lebih terdidik dan punya Mora sedikit lebih banyak saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560413,
						730560415
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560413,
					"content": "Jadi tempat ini adalah tempat kamu bermain dulu pas kecil?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560414
					]
				},
				{
					"id": 730560414,
					"content": "Bukan, ini adalah negara rahasia kami, aku serius. Kami sudah membuat perjanjian dengan mereka, setelah dewasa kami akan membawa \"prajurit penakluk\" untuk merebut kembali bentengnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560418
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560418,
					"content": "Hehe, sudah 20 tahun berlalu, mungkin mereka sudah lupa ... tempat ini terus aku gunakan untuk meneliti hutan, hingga 30 tahun lalu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560419
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560419,
					"content": "Lalu, bahkan sampai \"Marana\" datang pun, \"prajurit penakluk\" masih belum juga muncul. Hehe, ya iyalah ... bagaimana juga janji di antara bocah-bocah bisa ampuh untuk menghadang maut?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560420
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560420,
					"content": "Tapi ... kalau kamu saja masih bisa ingat sama mereka, mereka juga pasti sama! Jangan pesimis dulu Tuan Khayyam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560421,
					"content": "Pesimis? Tidak juga sih. Ingatan dan \"teman imajinasi\" saat kecil bukan bagian dari dunia orang dewasa. Mungkin memang ada sedikit penyesalan itu, tapi ... waktu tidak bisa diputar kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560422
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560422,
					"content": "\"Teman imajinasi\" ... maksudmu Aranara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560423,
						730560424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560423,
					"content": "Paimon ...! Sst!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560425
					]
				},
				{
					"id": 730560425,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560426
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560426,
					"content": "Haha, hampir saja kelupaan, seingatku kalian ke sini untuk membantuku memetik tanaman baru dan bukan untuk ngobrol, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560427
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560427,
					"content": "Maafkan aku terlalu banyak bicara, ayo kita lanjutkan kerjaan ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560424,
					"content": "Jangan banyak bicara, Paimon!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560425
					]
				},
				{
					"id": 730560415,
					"content": "Ini peninggalanmu dengan mereka ...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560416
					]
				},
				{
					"id": 730560416,
					"content": "Bukan, tidak semuanya. Awalnya kami juga berjanji akan membentuk \"prajurit penakluk\" untuk kembali ke sini ... hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560417
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560417,
					"content": "Saat aku meneliti tentang tanaman di Akademiya, kebetulan aku datang untuk merenovasi tempat ini, aku memindahkan banyak sampah ke sana kemari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560418
					],
					"speakerTitle": "Khayyam"
				}
			]
		},
