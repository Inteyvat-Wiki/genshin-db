			"dialogs": [
				{
					"id": 730560301,
					"content": "Menarik ... tanaman di sini kelihatannya ... sudah tumbuh kembali. \"Mawtiyima\" sudah berfungsi kembali ... menakjubkan.",
					"roleType": "TALK_ROLE_NPC",
