					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560302,
					"content": "Eh ... Tuan Khayyam tahu juga sama \"Mawtiyima\"? Paimon kira cuma Aranara saja yang tahu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560303,
						730560304
					],
					"speakerTitle": "Paimon"
