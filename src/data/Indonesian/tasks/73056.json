					"nextDialogs": [
						730560720,
						730560721
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730560720,
					"content": "Ini ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560722
					]
				},
				{
					"id": 730560722,
					"content": "Kalian menceritakan Aranaga tentang petualangan kalian yang sebelumnya secara rinci, termasuk pengalaman menyelamatkan \"Mawtiyima\" dari Withering.",
