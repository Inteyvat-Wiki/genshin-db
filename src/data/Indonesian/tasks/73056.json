					"content": "Paimon, sst!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560305
					]
				},
				{
					"id": 730560305,
					"content": "\"Aranara\"? Jadi kalian juga pernah melihat mereka ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560306
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560306,
					"content": "Eh ...? Hmm ... ya, yaaa benar.",
