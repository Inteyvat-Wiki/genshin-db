			"dialogs": [
				{
					"id": 752190101,
					"content": "#Ehem! Kamu yang di sana, {NICKNAME} kan? Minta waktunya sebentar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190102
					],
					"speakerTitle": "Huqiru"
				},
				{
					"id": 752190102,
					"content": "Ini ada ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190103
					],
					"speakerTitle": "Huqiru"
				},
				{
					"id": 752190103,
					"content": "Halo, ada yang bisa dibantu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752190104,
					"content": "Haha, tidak kok. Kebetulan ini ada paket buat kalian berdua. Pas aku lagi mikir gimana caranya nyari kalian ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190105
					],
					"speakerTitle": "Huqiru"
				},
				{
					"id": 752190105,
					"content": "Begitu dipikirin langsung muncul, keren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190106
					],
					"speakerTitle": "Huqiru"
				},
				{
					"id": 752190106,
					"content": "Paket! Dari siapa nih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752190107,
					"content": "Dari tempat yang jauh dan sudah pindah tangan berkali-kali. Sempat mampir di Adventurers' Guild, terus diambil sama pembawa pesan Tirai Daun ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190108
					],
					"speakerTitle": "Huqiru"
				},
				{
					"id": 752190108,
					"content": "Natlan belakangan kan tidak kondusif buat rombongan dagang biasa. Paket ini tidak ada nama pengirimnya, tapi kalau lihat tanda tangan ... kayaknya sih dari Fontaine yah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190109
					],
					"speakerTitle": "Huqiru"
				},
				{
					"id": 752190109,
					"content": "Sepertinya kalian punya banyak teman-teman ya di Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190110,
						752190111
					],
					"speakerTitle": "Huqiru"
				},
				{
					"id": 752190110,
					"content": "Diterima ya, makasih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752190112
					]
				},
				{
					"id": 752190111,
					"content": "Asyik! Siniin~",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752190112
					]
				},
				{
					"id": 752190112,
					"content": "Hari ini kayanya lancar nih kerjaan, begitu dapat paket langsung ketemu sama penerimanya. Archon Pyro lagi sayang nih sama aku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190113
					],
					"speakerTitle": "Huqiru"
				},
				{
					"id": 752190113,
					"content": "Ya sudah, aku lanjut kirim barang dulu. Permisi ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190114
					],
					"speakerTitle": "Huqiru"
				},
				{
					"id": 752190114,
					"content": "Lancar-lancar ya pengirimannya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752190115,
					"content": "Hmm, paket dari Fontaine ... enteng dan kecil gini, kata Paimon sih isinya surat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752190116,
					"content": "Buka, buru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752190117,
					"content": "Oh, dari si Charlotte rupanya. Foto dari pas kita ninggalin Fontaine dulu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752190118,
					"content": "Padahal belum lama ya. Tapi rasanya kayak sudah zaman kapan gitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752190119,
					"content": "Simpan yang benar yah fotonya bestie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
