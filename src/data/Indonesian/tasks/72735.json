			},
			"dialogs": [
				{
					"id": 727350101,
					"content": "Hei, siapa yang jadi bos di antara kalian? Maju! Ini waktunya bertarung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350102
					],
					"speakerTitle": "Grand Rook Sennichi"
				},
				{
					"id": 727350102,
					"content": "Aku Grand Rook Sennichi, raksasanya segala raksasa. Grandmaster Hanakado sudah minta kepala bosnya Geng Arataki ... Dan aku ke sini untuk mengambilnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350103
					],
					"speakerTitle": "Grand Rook Sennichi"
				},
				{
					"id": 727350103,
					"content": "Waduh, dia kayaknya ngeri ... Dan kayaknya bukan cuma gertak doang. Kayaknya kali ini lawannya beneran kuat deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727350104,
					"content": "Meracau apa lagi kau ini, HAH? Terus apa maksudnya pakai kata \"Grand\" di depan namamu??? Mau sok keren? Mau nyaingin Tuan Besar ini ya???",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350105
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727350105,
					"content": "Biar Tuan Besar ini yang menumbuk kau jadi kerdil! Raksasanya segala raksasa ... HA!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350106
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727350106,
					"content": "Ti-Tinggi amat! Terus kamu ... kamu ... ONI!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350107
					],
					"speakerTitle": "Grand Rook Sennichi"
				},
				{
					"id": 727350107,
					"content": "A-Apa aku mau dijadikan sarapan? Kenapa ada Oni yang suka main adu kumbang? Ini kan cuma mainan bocah ... Astaga, aku kenapa jadi kebawa-bawa ke sini sih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350108
					],
					"speakerTitle": "Grand Rook Sennichi"
				},
				{
					"id": 727350108,
					"content": "Maaf, ngomong apa barusan? MAINAN BOCAH? Kurang ajar ... LANCANG sekali mulutmu itu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350109
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727350109,
					"content": "Tidak tahu apa-apa soal adu kumbang dia rupanya. Kekeliruan harus diluruskan, dan tentunya veteran adu kumbang, Tuan Besar ini yang akan kasih tahu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350110,
						727350111
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727350110,
					"content": "KASIH TAHU DIA BOS!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727350112
					]
				},
				{
					"id": 727350112,
					"content": "YESSS!!! Sikat dia! KASIH TAHUUU!! Semangat, BAPAK GEMBALA!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727350113,
					"content": "Aduh, gimana ini ... Ya sudahlah, MAJU!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grand Rook Sennichi"
				},
				{
					"id": 727350111,
					"content": "AJARIN DIA SOPAN SANTUN!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727350112
					]
				}
			]
		}
	]
