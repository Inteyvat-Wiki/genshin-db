					"content": "Tanpa jejak, Pahsiv!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830205
					]
				},
				{
					"id": 740830205,
					"content": "#Paimon, Pahsiv! {NICKNAME}, Pahsiv! Kunci, kunci, kunci!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830206
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830206,
					"content": "Alun-alun, barat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830207,
					"content": "Heihei, kamu mau bilang ini, kan? Tenang saja, kita ke sana sekarang yah.",
					"roleType": "TALK_ROLE_NPC",
