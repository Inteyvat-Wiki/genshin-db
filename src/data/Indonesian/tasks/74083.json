			"dialogs": [
				{
					"id": 740831001,
					"content": "Asyik! Kita ketemu lagi kuncinya. Sekarang tinggal cari kunci terakhirnya terus beres deh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831002,
					"content": "Kunci, Kunci, Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831003
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831003,
					"content": "Wah. Pahsiv! Kamu tiba-tiba nongol dari mana sih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831004
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831004,
					"content": "Tanpa jejak, Pahsiv.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831005
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831005,
					"content": "Oke deh ... kamu beneran Melusine terunik yang pernah Paimon lihat ... Oh iya, seingat Paimon kebanyakan Melusine tinggal di Court of Fontaine atau Desa Merusea ... Kok kamu bisa ada di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831006
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831006,
					"content": "Court of Fontaine? Desa Merusea?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831007
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831007,
					"content": "Kamu kelihatannya bingung. Memangnya belum pernah dengar nama-nama ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831008
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831008,
					"content": "Court of Fontaine, Melusine ... Desa Merusea, Melusine ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831009
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831009,
					"content": "Ah ... Erinnyes, Pahsiv, kampung halaman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831010
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831010,
					"content": "Erinnyes, Pahsiv, melindungi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831011
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831011,
					"content": "Tunggu, kamu bilang ini kampung halamanmu? Kamu lagi lindungi kampung halamanmu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831012
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831012,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831013
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831013,
					"content": "Tapi kampung halaman Melusine itu di Desa Merusea, kan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740831014
					]
				},
				{
					"id": 740831014,
					"content": "Iya, aneh banget deh. Memangnya ada Melusine yang lahir di tempat lain? Tapi kayaknya enggak ada Melusine lain di sini, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831015
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831015,
					"content": "Pahsiv, kamu tinggal sendirian di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831016
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831016,
					"content": "Sendirian? Melusine. Tamu itu! Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831017
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831017,
					"content": "Ta-Tamu itu? Masih ada tamu lain? Tamu yang mana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831018
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831018,
					"content": "#Tamu itu! Paimon, Paimon, {NICKNAME}, {NICKNAME}, tamu itu, tamu itu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831019
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831019,
					"content": "Jadi tamu itu siapa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740831020
					]
				},
				{
					"id": 740831020,
					"content": "Pahsiv ... jangan-jangan maksudmu tamu itu ya tamu itu, sama kayak Paimon ya Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831021
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831021,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831022
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831022,
					"content": "Aha! Benar kan ternyata. Apa kata Paimon ... Paimon juga pintar banget.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831023,
						740831024
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831023,
					"content": "Aneh banget namanya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740831025
					]
				},
				{
					"id": 740831025,
					"content": "Tamu itu, Pahsiv, pengetahuan, buagh, bugh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831026
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831026,
					"content": "Hmm ... maksudmu tamu itu ngebantuin kamu belajar pengetahuan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831027
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831027,
					"content": "Pahsiv! Sangat banyak. Bahasa, kebijaksanaan ... sangat banyak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831028
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831028,
					"content": "Ugh, buat Paimon kok rasanya enggak gimana banyak ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831029
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831029,
					"content": "Pahsiv, tamu itu, melindungi, buagh, bugh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831030
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831030,
					"content": "Dia juga bantu kamu lindungi tempat ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831031
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831031,
					"content": "Melusine ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831032
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831032,
					"content": "Atau kamu yang membantunya melindungi tempat ini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740831033
					]
				},
				{
					"id": 740831033,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831034
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831034,
					"content": "Ternyata gitu ... Tamu itu sebenarnya siapa? Kenapa dia butuh bantuanmu buat lindungi tempat ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831035
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831035,
					"content": "Lagian memang terjadi kejadian hal buruk di sini juga, kan? Tulisan yang ada di tablet batu yang kita lihat hancur, terus muncul banyak kotoran ... Apa ada musuh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831036
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831036,
					"content": "Paimon penasaran, Pahsiv! Tapi waktu, sangat sedikit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831037
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831037,
					"content": "Kunci, kunci, kunci, alun-alun, barat. buagh, bugh, buagh, bugh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831038
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831038,
					"content": "Kami usahakan secepatnya!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740831039
					]
				},
				{
					"id": 740831039,
					"content": "#Paimon, Pahsiv! {NICKNAME}, Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831040
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831040,
					"content": "Pahsiv melompat dua kali dengan gembira, lalu buru-buru pergi.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740831041
					]
				},
				{
					"id": 740831041,
					"content": "Kayaknya waktu sudah beneran mepet deh. Untung dua kunci lainnya sudah dapat. Kunci yang ketiga nih terakhir, bisa, bisa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831024,
					"content": "Keren banget namanya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740831025
					]
				}
			]
