			"dialogs": [
				{
					"id": 701060201,
					"content": "Tentang Daging Dingin...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060202
					]
				},
				{
					"id": 701060202,
					"content": "Daging Dingin ini kelihatannya cukup lezat... Dengan ini kita hanya kekurangan 1 bahan masak lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060203
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060203,
					"content": "Apa kamu pernah mendengar tentang Great Snowboar King? Dikatakan bahwa itu adalah binatang yang hidup jauh di dalam pegunungan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060204
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060204,
					"content": "Aku melihat beberapa resep mengatakan bahwa kualitas dagingnya sangat baik untuk dimasak dengan cara apa pun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060205
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060205,
					"content": "Pengembara, aku harus merepotkanmu lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060206
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060206,
					"content": "Bagaimana tentang imbalannya...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060207
					]
				},
				{
					"id": 701060207,
					"content": "Jangan khawatir, aku telah menyiapkan imbalannya. Kalau begitu tolong yah, pengembara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Harris"
				}
			]
		},
