					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060403,
					"content": "Aku sudah berhasil mengumpulkan semuanya, ini dia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060404
					]
				},
				{
					"id": 701060404,
					"content": "Dengan begitu... Bahan masaknya pun sudah terkumpul semua.",
