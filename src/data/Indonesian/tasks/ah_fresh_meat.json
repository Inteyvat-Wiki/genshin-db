			},
			"dialogs": [
				{
					"id": 701060101,
					"content": "Hanya kurang bahan masak ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060102
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060102,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060103
					]
				},
				{
					"id": 701060103,
					"content": "Ah, Pengembara, aku sedang merenung soal sebuah resep kuno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060104
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060104,
					"content": "Belum lama ini, ada sebuah tim ekspedisi yang mendaki gunung salju untuk dijelajahi. Salah satu dari mereka adalah kenalanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060105
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060105,
					"content": "Meskipun mereka tidak banyak menjelajah karena cuaca yang buruk, petualang tersebut mengatakan bahwa mereka menemukan sebuah reruntuhan saat menghindari angin dan salju.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060106
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060106,
					"content": "Mereka menemukan banyak buku-buku dan hal lainnya, mereka juga menemukan sebuah... resep yang masih utuh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060107
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060107,
					"content": "Petualang itu memberiku resep ini, dan memintaku untuk mencoba membuatnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060108
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060108,
					"content": "Sejujurnya, aku bahkan belum pernah mendengar tentang bahan dari resep itu, dan juga cara memasaknya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060109
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060109,
					"content": "Jadi, aku mengubah resepnya sedikit, yang tidak kuubah hanya bahan utamanya saja...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060118
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060118,
					"content": "Kalau kamu bersedia, maukah kamu membantuku mencari beberapa bahan masak langka itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060110,
						701060112
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060110,
					"content": "Serahkan padaku!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060111
					]
				},
				{
					"id": 701060111,
					"content": "Wah, semangat sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060113
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060113,
					"content": "Aku dengar orang lain mengatakan bahwa ada boar kecil yang masuk ke dalam pegunungan salju tersebut dan membeku di sana, menurutku... rasa boar tersebut mungkin saja akan menghasilkan rasa yang baru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060114
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060114,
					"content": "Jadi, aku ingin memintamu untuk mencari anak boar yang telah beku tersebut, dan mengumpulkan 10 Daging Dingin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060115
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060115,
					"content": "Daging Dingin itu maksudmu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060116
					]
				},
				{
					"id": 701060116,
					"content": "Iya, itu nama yang kuberikan untuk dagingnya. Daging boar yang dibekukan untuk menjaga kelezatannya disebut \"Daging Dingin\" kan? Hahaha, bagaimana, namanya kreatif kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060117
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060117,
					"content": "Karena itu aku harap kamu dapat menemukan bahan masak tersebut dan membawakannya padaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060112,
					"content": "Bahan masak apa yang diperlukan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060113
					]
				}
			]
		},
