			},
			"dialogs": [
				{
					"id": 220400101,
					"content": "Cara bisnis seperti ini tidak akan tahan lama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400102
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220400102,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220400103
					]
				},
				{
					"id": 220400103,
					"content": "Maaf, maaf. Aku tiba-tiba keasyikan melamun. Kamu mau membeli pakaian?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400104
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220400104,
					"content": "Meskipun sutra dan satin kualitas tinggi Liyue masih tidak ada stok, tapi kimono dengan model baru masih tersedia banyak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400105
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220400105,
					"content": "Kamu biasanya mengimpor stok dari Liyue?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220400106
					]
				},
				{
					"id": 220400106,
					"content": "Iya, dulunya toko kami selalu mengimpor sutra kualitas tinggi Liyue, misalnya seperti sutra Feiyun Commerce Guild yang terbuat dari Silk Flower.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400107
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220400107,
					"content": "Tapi kondisi Inazuma yang sekarang... Toko ini sudah tidak ada stok sutra seperti itu lagi selama beberapa waktu. Sekarang kami hanya bisa mengandalkan sisa stok dulu untuk terus beroperasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400108
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220400108,
					"content": "Stok sutra-sutra di toko ini, bisa dibilang semakin hari semakin berkurang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400109
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220400109,
					"content": "Aku sendiri sebenarnya berniat mendesain corak baru, atau memakai pewarna baru untuk membuat kain dan baju model baru yang dapat menarik minat pembeli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400110
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220400110,
					"content": "Tapi, aku masih belum kepikiran corak seperti apa yang layak disebut \"inovatif\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400111
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220400111,
					"content": "Pengembara, kamu sudah melihat banyak hal di luar sana. Pernah lihat corak yang benar-benar \"inovatif\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400112
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220400112,
					"content": "Aku tak yakin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220400113
					]
				},
				{
					"id": 220400113,
					"content": "Begitu ya, aku mengerti. Sebenarnya agak tidak enak hati sih, tapi... apa kamu mau bantu aku cari informasi tentang corak unik ke orang-orang asing?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400114
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220400114,
					"content": "Kini tinggal aku saja yang mengurus Ogura, jadi aku tidak bisa lama-lama meninggalkan toko. Aku cuma bisa minta tolong orang untuk cari informasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400115
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220400115,
					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220400116
					]
				},
				{
					"id": 220400116,
					"content": "Bagus, biar kupikirkan dulu... Kamu tanya Nona Tang Wen dan Tuan Ramsay, mungkin mereka punya ide bagus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ogura Mio"
				}
			]
		},
