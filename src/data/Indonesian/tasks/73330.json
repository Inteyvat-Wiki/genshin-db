			"trigger": {
				"objectNames": [
					"Sorush",
					"Markozov",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733300701,
					"content": "Wahai manusia berniat busuk! Enyahlah dari tempat ini sekarang juga. Warisan kaum Pari bukan untuk kalian, dan tidak akan pernah menjadi milik kalian!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300702
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733300702,
					"content": "Pari? WAH! Ada Pari! Luar biasa sekali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300703
					],
					"speakerTitle": "Markozov"
				},
				{
					"id": 733300703,
					"content": "Dan ada juga anak muda yang ... bawa hewan peliharaan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300704
					],
					"speakerTitle": "Markozov"
				},
				{
					"id": 733300704,
					"content": "WOI! Jangan asal bunyi ya! Paimon ini bestie-nya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733300705,
					"content": "\"Bestie\" ... Ah! Sahabat, ya? Betapa indahnya. Dari kecil, aku selalu ingin punya sahabat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300706
					],
					"speakerTitle": "Markozov"
				},
				{
					"id": 733300706,
					"content": "Anak muda. Apa kamu perlu \"bestie\" baru?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300707,
						733300708
					],
					"speakerTitle": "Markozov"
				},
				{
					"id": 733300707,
					"content": "Apa lagi sih ini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733300710
					]
				},
				{
					"id": 733300710,
					"content": "Maksudnya ... Tidak adil juga kan kalau kamu punya dua bestie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300711
					],
					"speakerTitle": "Markozov"
				},
				{
					"id": 733300711,
					"content": "Ketidak-adilan semacam ini tidak boleh dibiarkan. Jadi tolong berikan Pari itu untukku. Jangan khawatir, aku akan memperlakukan dia dengan sangat baik ... sangat berguna, sampai ke batasnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300712
					],
					"speakerTitle": "Markozov"
				},
				{
					"id": 733300712,
					"content": "Kurang ajar, tidak tahu diri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300713
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733300713,
					"content": "Waduh, ini orang otaknya kemasukan air ya! Percuma ngomong sama yang kayak gini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733300714,
					"content": "Ada cara lain untuk membuat dia paham, dan tidak perlu banyak bicara. Oh Yasnapati-ku yang cerdik, tentunya kamu tahu kan maksudnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300715
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733300715,
					"content": "Tahu dong! Kita kasih dia pelajaran, biar paham!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733300716,
					"content": "Diam, Pucat Terbang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733300708,
					"content": "Eh, boleh juga sih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733300709
					]
				},
				{
					"id": 733300709,
					"content": "ENAK SAJA WOI! Bestie kamu cuma satu! P-A-I-M-O-N!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300710
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
