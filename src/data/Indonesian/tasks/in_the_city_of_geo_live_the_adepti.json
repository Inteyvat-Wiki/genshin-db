					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400030701,
					"content": "Aha! Benar kan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030702,
						400030703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030702,
					"content": "Apakah sebaiknya kita mengejarnya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400030704
					]
				},
				{
					"id": 400030704,
					"content": "Tunggu, ada yang lain——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030703,
					"content": "Kita harus mengejarnya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400030704
					]
				}
			]
		},
