			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xinghuo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400030401,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030402
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 400030402,
					"content": "Kalian siapa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030403
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 400030403,
					"content": "Jiayi mengirim kami untuk mencarimu, dia mengatakan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030404,
					"content": "Ternyata begitu, baiklah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030405
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 400030405,
					"content": "Bagian Urusan Sipil berterima kasih atas dukunganmu. Kasusmu sudah dicatat dan akan dijadwalkan untuk investigasi sesegera mungkin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030406
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 400030406,
					"content": "Sampai jumpa lagi di Liyue, pengembara baik hati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030407
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 400030407,
					"content": "#{NICKNAME}, Paimon merasa seperti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030408,
						400030413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030408,
					"content": "Bagian Urusan Sipil tidak menanggapi ini dengan serius.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400030409
					]
				},
				{
					"id": 400030409,
					"content": "Benar! Paimon juga berpikir seperti itu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030410,
					"content": "Penduduk lokal pasti sudah terbiasa dengan masakan yang enak begitu sehingga mereka menganggapnya biasa saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030411,
					"content": "Tapi buat seorang pengembara miskin yang sendirian di hutan belantara, terpaksa hanya bisa makan jamur aneh misterius untuk bertahan hidup...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030412,
					"content": "Bagimu, Lantern Rite adalah yang paling penting dari semua festival!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030416,
					"content": "Ayo kita mulai dengan mengunjungi tempat kemarin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030417,
					"content": "Paimon dengar dari petugas patroli kalau penjahat suka kembali ke tempat kejadian perkara setelah kejahatan itu terjadi. Sepertinya begitulah mental para penjahat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030418,
					"content": "Tapi kejahatan itu belum terjadi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400030419
					]
				},
				{
					"id": 400030419,
					"content": "Makanya kita tidak boleh buang waktu lagi! Kalau orang sudah merusak bahan yang mudah terbakar dan kejahatan terjadi, artinya sudah terlambat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030413,
					"content": "Tapi tetap membutuhkan bantuan kita untuk menyelesaikan masalah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400030414
					]
				},
				{
					"id": 400030414,
					"content": "Paimon juga merasa begitu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030415,
					"content": "Berdasarkan pengalaman, lebih baik kalau kita bisa menyelesaikannya sampai akhir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030416
					],
					"speakerTitle": "Paimon"
				}
			]
		},
