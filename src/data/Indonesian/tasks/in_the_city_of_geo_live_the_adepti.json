				"points": []
			},
			"dialogs": [
				{
					"id": 400030201,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030202
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 400030202,
					"content": "*huff* Aku tidak akan bohong padamu. Bagian Urusan Sipil sangat sibuk karena Lantern Rite. Kami tidak punya orang untuk menyusut kasus ini sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030203
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 400030203,
					"content": "Eh? Bagaimana mungkin-",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030204,
					"content": "Maaf telah mengecewakanmu, dan aku benar-benar menghargai usahamu karena telah melaporkannya. Hm... bagaimana ya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030205
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 400030205,
					"content": "Sepertinya, kita punya satu kelompok kecil yang mungkin bisa menolong. Mereka hanya punya satu tugas hari ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030206
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 400030206,
					"content": "Mereka sekarang sedang membereskan para monster di Guili Plains. Jika kamu bisa menghubungi mereka...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiayi"
				}
			]
		},
		{
			"id": 4000304,
			"completionStepIds": [
				4000304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
