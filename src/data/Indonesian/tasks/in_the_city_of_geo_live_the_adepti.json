			},
			"dialogs": [
				{
					"id": 400030901,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030902,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030903
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400030903,
					"content": "#Hei {NICKNAME}, Paimon merasa orang ini akan susah diajak bicara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030904,
					"content": "Kalau Paimon tebak, Paimon akan mengatakan dia pasti bukan orang baik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030905,
					"content": "Tebakanmu belum tentu benar, tidak bagus menilai yang baik dan yang jahat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030906
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400030906,
					"content": "Meski begitu, tebakanmu benar. Aku adalah roh jahat. Seorang Vigilant Yaksha, pembantai monster dan penakluk iblis - Xiao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030907
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400030908,
					"content": "Aku sepertinya pernah mendengar istilah itu dua hari yang lalu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400030910
					]
				},
				{
					"id": 400030909,
					"content": "Paimon, apakah kamu tahu apa itu Yaksha?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400030910
					]
				},
				{
					"id": 400030907,
					"content": "Vigilant Yaksha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030908,
						400030909
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030910,
					"content": "Ya... Seseorang dari Liyue pernah mengatakan bahwa Yaksha juga adalah salah satu Adeptus yang melindungi Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030911
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030911,
					"content": "Mereka menjaga dunia manusia secara rahasia, melindunginya dari monster dan iblis. Tapi kebanyakan orang bahkan tidak tahu bahwa mereka ada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030912
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030912,
					"content": "... Tunggu, bukankah itu artinya kamu adalah orang baik?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030913,
					"content": "... Tidak. Jangan salah mengira perlindungan Yaksha adalah niat baik terhadap manusia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030914
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400030914,
					"content": "Hmph! Ada banyak manusia di luar sana yang bekerja keras untuk mempersiapkan Lantern Rite, semuanya demi menghormati para pahlawan dalam sejarah Liyue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030915
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030915,
					"content": "... Ternyata di sini kita punya pahlawan sejarah yang sebenarnya dan bertahan sampai hari ini... tapi, dia bahkan tidak menghargai festival itu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030916
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030916,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030917
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400030917,
					"content": "Jadi, tuan Xiao... Eh, Dewa Adeptus...? Kenapa kamu tidak menghentikan orang yang mencurigakan itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030918
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030918,
					"content": "Aku merasakan aura jahat di sini. Aku di sini untuk memeriksanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030919
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400030919,
					"content": "Jika ada sesuatu yang lepas dari belenggu di dunia dewa dan iblis, itu adalah tanggung jawabku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030920
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400030920,
					"content": "Tetapi kali ini, ancaman datang dari dunia fana - duniamu, dan karena itulah, kamu yang akan bertanggung jawab penuh, pengembara dunia fana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030921
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400030921,
					"content": "Saat waktunya tiba, aku harap kamu bertindak dengan cepat dan tegas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030922
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400030922,
					"content": "Aku tidak ingin senjata yang sudah membantai iblis yang tak terhitung jumlahnya menjadi ternoda dengan darah manusia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030923
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400030923,
					"content": "Apa ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030924
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030925,
					"content": "Paimon, apakah kamu mengenalinya?",
