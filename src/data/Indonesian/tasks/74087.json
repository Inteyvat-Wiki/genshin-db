			"dialogs": [
				{
					"id": 740870201,
					"content": "Jadi di sini para peneliti biasa istirahat? Duh ini memangnya layak ya? Institut Penelitian Fontaine pernah tidak sih mempertimbangkan untuk mengutamakan renovasi tempat ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870202
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740870202,
					"content": "Harusnya di sini ada Suar Survei. Sama seperti yang dibilang Nona Chronie, tempat ini butuh renovasi, dan pasokan energi di sini juga terbatas ... atau mungkin bisa dibilang, malah kurang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870203
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 740870203,
					"content": "#Di saat aku menjawab pertanyaan Nona Chronie, kuserahkan kerjaan untuk mengambil Suar Survei itu padamu, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nacker"
				}
			]
		},
		{
			"id": 7408703,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7408702",
