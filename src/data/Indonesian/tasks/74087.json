				"points": []
			},
			"dialogs": [
				{
					"id": 740870301,
					"content": "Dibandingkan dengan area lainnya, sepertinya asrama tidak terlalu terpengaruh ledakan ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870302
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 740870302,
					"content": "Asrama? Tapi aku tidak lihat ada satu pun kasur di sini tuh, jadi gimana para peneliti itu istirahat? Masa mereka tidur di kursi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870303
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740870303,
					"content": "Nona Chronie, gagasanmu tentang \"istirahat\" itu beda dari para peneliti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870304
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 740870304,
					"content": "Sewaktu para peneliti di Institut Penelitian Fontaine bilang mereka butuh istirahat, maksudnya sih cuma berhenti sejenak dari pikiran yang ada di otak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870305
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 740870305,
					"content": "Jadi mereka biasa ke sini, main piano, baca buku, minum satu dua gelas kalau perlu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870306
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 740870306,
					"content": "Uh, tapi kan tidur bisa bikin otak lebih rileks?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870307
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740870307,
					"content": "Kamu benar, tapi ... bagi para peneliti kami, tidur itu buang waktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870308
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 740870308,
					"content": "Tidur itu buang waktu? Tidak, itu penting banget loh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870309
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740870309,
					"content": "Tidur itu kan bisa memotong alur pikiran yang sedang kita pikirkan, jadi ya kalau dalam ranah penelitian sih itu tidak bisa diterima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870310,
						740870311
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 740870310,
					"content": "(Terus mendengarkan ....)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740870312
					]
				},
				{
					"id": 740870312,
					"content": "Serius? Kalau kamu tidak tidur, nanti hidupmu yang bakal tamat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870313
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740870313,
					"content": "Tidak perlu. Institut punya sistem kesehatan yang bagus dan bisa menjamin kesehatan para peneliti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870314
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 740870314,
					"content": "Tapi itu bukan alasan untuk tidak tidur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870315
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740870315,
					"content": "Lalu, kalau para peneliti istirahat, nanti jadi memecah konsentrasi dong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870316
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740870316,
					"content": "Tidak perlu. Toh kalaupun istirahat juga sebenarnya mereka masih memikirkan subjek penelitian juga kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870317
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 740870317,
					"content": "Sama seperti lautan, walau terlihat tenang di luar, di dalamnya masih menggulung dengan ganas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870318
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 740870318,
					"content": "Terkadang, arus air di bawah bahkan lebih kuat daripada yang terlihat di atas air.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870319
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 740870319,
					"content": "Oke aku paham. Jadi maksudnya saat peneliti dari Institut Penelitian Fontaine berada dalam sebuah proyek, mereka harus tetap kerja dan tidak boleh istirahat, ya kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870320
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740870320,
					"content": "Bukan gitu juga sih. Kalau mereka perlu tidur, mereka boleh pulang kapan pun dan tidur kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870321
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 740870321,
					"content": "Jadi bisa dibilang selama peneliti dari Institut Penelitian Fontaine ada di dalam Institut, mereka harus tetap kerja dan tidak boleh istirahat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870322
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740870322,
					"content": "Retorika kamu hebat juga, Nona Chronie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nacker"
				},
				{
					"id": 740870311,
					"content": "(Berhenti Mendengarkan ....)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		}
	]
}