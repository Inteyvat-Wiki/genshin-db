			"dialogs": [
				{
					"id": 708150901,
					"content": "Boneka... layang-layang... kincir angin... lagi-lagi ayah mengirimiku barang-barang seperti ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150902
					],
					"speakerTitle": "Little Liu"
				},
				{
					"id": 708150902,
					"content": "*Huff* Sayangnya aku tidak bisa mengiriminya hadiah yang kusiapkan untuknya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150903
					],
					"speakerTitle": "Little Liu"
				},
				{
					"id": 708150903,
					"content": "Aku akan mengantarkan hadiahmu untuknya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150904
					]
				},
				{
					"id": 708150904,
					"content": "Kamu akan membantuku? Baiklah... Meskipun kamu juga tidak memiliki Vision, tapi sepertinya kamu sama sekali tidak kesulitan untuk menghadapi monster-monster itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150905
					],
					"speakerTitle": "Little Liu"
				},
				{
					"id": 708150905,
					"content": "Hanya ini caranya, mohon bantuannya ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150906
					],
					"speakerTitle": "Little Liu"
				},
				{
					"id": 708150906,
					"content": "*Huff* Seandainya saja... aku bisa sekuat kamu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Little Liu"
