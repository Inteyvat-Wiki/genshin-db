					"Little Liu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708150801,
					"content": "Ngomong-ngomong, mengapa kalian terus mengikutiku? Sudah kubilang aku mau pergi ke Pelabuhan Liyue!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150802
					],
					"speakerTitle": "Little Liu"
				},
				{
					"id": 708150802,
					"content": "Aku akan menghindari monster-monster ini sendiri. Mereka tidak akan menemukanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150803
					],
					"speakerTitle": "Little Liu"
				},
				{
					"id": 708150803,
					"content": "Jangan selalu perlakukan aku seperti anak kecil! Aku sudah dewasa sekarang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150804
					],
					"speakerTitle": "Little Liu"
				},
				{
					"id": 708150804,
					"content": "Ini titipan dari ayahmu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150805
					]
				},
				{
					"id": 708150805,
					"content": "Dari ayahku? Apakah dia memintamu untuk mengirimkannya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150806
					],
					"speakerTitle": "Little Liu"
				},
				{
					"id": 708150806,
					"content": "Pasti sesuatu untuk dimainkan anak-anak... kalau bukan layang-layang ya boneka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150807
					],
					"speakerTitle": "Little Liu"
				},
				{
					"id": 708150807,
					"content": "Kamu tidak menyukainya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150808
					]
				},
				{
					"id": 708150808,
					"content": "... Suka kok, bagaimana mungkin aku tidak menyukai sesuatu yang diberikan ayah untukku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150809
					],
					"speakerTitle": "Little Liu"
				},
				{
					"id": 708150809,
					"content": "Tapi kalau aku selalu menyukai barang-barang seperti ini, bukankah itu berarti aku akan selalu menjadi anak-anak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150810
					],
					"speakerTitle": "Little Liu"
				},
				{
					"id": 708150810,
					"content": "Kalau aku hanya memainkan ini, kapan aku bisa menjadi seorang petualang dan mendapatkan Vision untukku sendiri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150811
					],
					"speakerTitle": "Little Liu"
				},
				{
					"id": 708150811,
					"content": "Kamu menginginkan Vision untuk hal apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150812
					]
				},
				{
					"id": 708150812,
					"content": "Kalau aku punya Vision, aku bisa melakukan banyak hal, entah sesuatu yang menghasilkan uang atau sesuatu yang lain...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150813
					],
					"speakerTitle": "Little Liu"
				},
				{
					"id": 708150813,
					"content": "Lalu ayah juga tidak perlu bekerja di Pelabuhan Liyue sepanjang waktu. Dia bisa kembali dan menghabiskan waktu bersamaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150814
					],
					"speakerTitle": "Little Liu"
				},
				{
					"id": 708150814,
					"content": "Saat ini, aku bahkan tidak bisa pergi ke Pelabuhan Liyue sendirian tanpa adanya Vision ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150815
					],
					"speakerTitle": "Little Liu"
				},
				{
					"id": 708150815,
					"content": "Tapi karena ayah sudah memintamu untuk mengirimiku hadiah, aku mungkin akan memberinya lebih banyak masalah dengan pergi mencarinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150816
					],
					"speakerTitle": "Little Liu"
				},
				{
					"id": 708150816,
					"content": "<color=#00E1FFFF>Aku juga menyiapkan hadiah untuknya</color>, ingin memberikannya kejutan... tapi aku tidak bisa mengantarkannya sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150817
					],
					"speakerTitle": "Little Liu"
				},
				{
					"id": 708150817,
					"content": "<color=#00E1FFFF>Seandainya ada yang bersedia mengantarkannya...</color> Lupakan saja, aku akan kembali saja. Kalian tidak perlu terus mengikutiku lagi, aku tahu jalan pulang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Little Liu"
				}
			]
		},
