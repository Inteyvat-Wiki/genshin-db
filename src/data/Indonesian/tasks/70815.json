				},
				{
					"id": 708151205,
					"content": "Terima kasih, silakan terima ini sebagai terima kasihku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708151206
					],
					"speakerTitle": "Jiayi"
				},
				{
