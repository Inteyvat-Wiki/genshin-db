			"trigger": {
				"objectNames": [
					"Nenek Ruoxin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708150501,
					"content": "Anak ini lari ke mana dia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150502
					],
					"speakerTitle": "Nenek Ruoxin"
				},
				{
					"id": 708150502,
					"content": "Tentang Little Liu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150503
					]
				},
				{
					"id": 708150503,
					"content": "Apakah kalian ke sini untuk mencari Little Liu? *Huff* Sayangnya kalian datang di waktu yang tidak tepat, anak itu entah lari ke mana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150504
					],
					"speakerTitle": "Nenek Ruoxin"
				},
				{
					"id": 708150504,
					"content": "Beberapa hari yang lalu, ayahnya meminta seseorang untuk mengirimkan surat dari Pelabuhan Liyue, katanya dia akan segera kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150505
					],
					"speakerTitle": "Nenek Ruoxin"
				},
				{
					"id": 708150505,
					"content": "Little Liu sangat senang dan berkata bahwa dia akan menyiapkan hadiah untuk ayahnya. Dia mengajak beberapa anak lain untuk memetik buah-buahan dan bunga liar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150506
					],
					"speakerTitle": "Nenek Ruoxin"
				},
				{
					"id": 708150506,
					"content": "Tapi beberapa hari kemudian, ayahnya mengirim kabar bahwa dia memiliki tugas di menit-menit terakhir dan tidak akan dapat kembali untuk sementara waktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150507
					],
					"speakerTitle": "Nenek Ruoxin"
				},
				{
					"id": 708150507,
					"content": "Anaknya langsung ngambek dan bersikeras jika ayahnya tidak kembali maka dia yang akan mengunjunginya ke Pelabuhan Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150508
					],
					"speakerTitle": "Nenek Ruoxin"
				},
				{
					"id": 708150508,
					"content": "Kami pikir dia hanya bercanda, tapi tahu-tahu pagi ini anaknya sudah menghilang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150509
					],
					"speakerTitle": "Nenek Ruoxin"
				},
				{
					"id": 708150509,
					"content": "*huff* Kami sudah mengirim orang untuk mencarinya, tapi jika kamu bersedia, bantulah cari dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150510,
						708150512
					],
					"speakerTitle": "Nenek Ruoxin"
				},
				{
					"id": 708150510,
					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150511
					]
				},
				{
					"id": 708150511,
					"content": "Maaf merepotkanmu... *huff* dasar anak ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nenek Ruoxin"
				},
				{
					"id": 708150512,
					"content": "Menurutmu dia akan ke mana?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150513
					]
				},
				{
					"id": 708150513,
					"content": "Kurasa dia belum pergi terlalu jauh, seharusnya masih ada di sekitaran sini, tapi hutan belantara terlalu berbahaya... Tolong, cepat temukan dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nenek Ruoxin"
				}
			]
		},
