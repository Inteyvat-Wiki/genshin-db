			"dialogs": [
				{
					"id": 708150601,
					"content": "Begitu juga dengan Jiayi, kenapa dia tidak bisa kembali untuk anaknya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150602
					],
					"speakerTitle": "Nenek Ruoxin"
				},
				{
					"id": 708150602,
					"content": "Anaknya jarang sekali melihatnya dalam setahun. Mana ada ayah seperti dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150603,
						708150605
					],
					"speakerTitle": "Nenek Ruoxin"
				},
				{
					"id": 708150603,
					"content": "Dia melakukan ini demi Pelabuhan Liyue ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150604
					]
				},
				{
					"id": 708150604,
					"content": "Dia selalu berkata begitu setiap tahun. Aku sudah tidak ingat berapa kali dia mengatakannya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nenek Ruoxin"
				},
				{
					"id": 708150605,
					"content": "Dia hanya melakukan pekerjaannya...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150606
					]
				},
				{
					"id": 708150606,
					"content": "Merawat putrinya sendiri juga seharusnya tugasnya. Little Liu telah tumbuh dari hari ke hari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150607
					],
					"speakerTitle": "Nenek Ruoxin"
				},
				{
					"id": 708150607,
					"content": "Jangan sampai saat tiba waktunya dia kembali anaknya telah pergi bekerja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150608
					],
					"speakerTitle": "Nenek Ruoxin"
				},
				{
					"id": 708150608,
					"content": "Ayah dan putrinya ini bisa-bisa tidak akan bersama, bukan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nenek Ruoxin"
				}
			]
		},
