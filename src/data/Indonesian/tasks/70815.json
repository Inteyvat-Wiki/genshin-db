					"nextDialogs": [
						708151103
					]
				},
				{
					"id": 708151103,
					"content": "Baguslah, semua yang kuberikan adalah mainan favoritnya. Terima kasih — silakan terimalah ini sebagai tanda terima kasihku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 708151104,
					"content": "Dia lebih suka jika kamu bisa kembali.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708151105
					]
				},
				{
					"id": 708151105,
					"content": "Aku juga ingin kembali, tapi dengan Pelabuhan Liyue dalam kondisi seperti ini, kurasa aku tidak akan bisa pergi untuk sementara waktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708151106
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 708151106,
					"content": "Terima kasih semuanya, kuharap hadiahnya akan sedikit memperbaiki suasana hatinya — semua yang kuberikan adalah mainan favoritnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708151107
					],
					"speakerTitle": "Jiayi"
				},
				{
