			"dialogs": [
				{
					"id": 708150401,
					"content": "*Huff* Aku sedang menghitung hari sebelum aku dapat kembali. Hanya dua atau tiga hari lagi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150402
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 708150402,
					"content": "Dengan semua cuti yang kutabung sampai saat ini, setidaknya aku bisa tinggal bersama Little Liu selama lebih dari seminggu ketika aku kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150403
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 708150403,
					"content": "Tapi hanya dengan satu perintah, semua cuti kami dibatalkan, bahkan orang-orang yang sedang cuti dipanggil kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150404
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 708150404,
					"content": "Berdasarkan pengalamanku, ini berarti aku tidak bisa kembali ke Desa Qingce setidaknya satu bulan lagi. Sungguh sial sekali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiayi"
				}
			]
		},
		{
			"id": 7081505,
			"completionStepIds": [
