			"dialogs": [
				{
					"id": 708150701,
					"content": "Apakah kamu ke sini untuk menangkapku kembali ke Desa Qingce?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150702,
						708150704
					],
					"speakerTitle": "Little Liu"
				},
				{
					"id": 708150702,
					"content": "Nenek Ruoxin khawatir sekali padamu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150703
					]
				},
				{
					"id": 708150703,
					"content": "Huh, jadi kamu memang datang untuk menangkapku, aku tidak akan kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150706
					],
					"speakerTitle": "Little Liu"
				},
				{
					"id": 708150706,
					"content": "Kembali dan beri tahu penduduk desa bahwa aku akan pergi ke Pelabuhan Liyue untuk mencari ayahku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150707
					],
					"speakerTitle": "Little Liu"
				},
				{
					"id": 708150707,
					"content": "Mereka tidak perlu khawatir, begitu aku menemukannya, aku akan berbicara dengannya sebentar baru kembali lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Little Liu"
				},
				{
					"id": 708150704,
					"content": "Kami punya sesuatu untukmu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150705
					]
				},
				{
					"id": 708150705,
					"content": "Aku tidak butuh apa pun dari kalian. Kamu hanya berusaha membujukku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150706
					],
					"speakerTitle": "Little Liu"
				}
			]
		},
		{
			"id": 7081508,
