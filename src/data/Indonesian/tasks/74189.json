					"content": "Tidak ada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890425
					]
				},
				{
					"id": 741890407,
					"content": "Aku masih perlu waktu untuk berpikir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
