					"content": "Tiga.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890411
					]
				},
				{
					"id": 741890411,
					"content": "Benar! Satu langkah lebih dekat untuk mengaktifkan meriam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890414
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890414,
					"content": "Pertanyaan kedua: Berapa banyak karyawan yang ada di The Rusty Rudder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890417,
						741890415,
						741890418
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890417,
					"content": "Satu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890425
					]
				},
				{
					"id": 741890425,
					"content": "Sayang sekali, jawabanmu salah. Mau coba lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890426,
						741890427
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890426,
					"content": "Biar kucoba lagi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890409
					]
				},
				{
					"id": 741890427,
					"content": "Coba kupertimbangkan lagi lebih jauh ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890428
					]
				},
				{
					"id": 741890428,
					"content": "Aku akan menunggu jawabanmu atas pertanyaanku! Kamu bisa temui aku saat sudah siap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Permingeat"
