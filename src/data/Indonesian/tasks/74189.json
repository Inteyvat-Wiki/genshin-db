						741890405
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890405,
					"content": "Apa kamu sudah siap untuk menjawab pertanyaannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890406,
						741890407
					],
					"speakerTitle": "Permingeat"
