					"nextDialogs": [
						741890422
					]
				},
				{
					"id": 741890422,
					"content": "Semua benar! Selamat, kamu boleh mengaktifkan meriamnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890423
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890423,
					"content": "Tunggu dulu, biar kututup dulu telingaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Permingeat"
				},
				{
