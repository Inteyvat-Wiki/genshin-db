					"content": "Kami siap.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890409
					]
				},
				{
					"id": 741890409,
					"content": "Kalau begitu ayo mulai. Pertanyaan pertama, ada berapa banyak meja yang ada di The Rusty Rudder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890410,
						741890412,
						741890413
					],
					"speakerTitle": "Permingeat"
