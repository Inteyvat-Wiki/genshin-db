					"content": "Susu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890425
					]
				},
				{
					"id": 741890418,
					"content": "Aku kan karyawanmu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890425
					]
				},
				{
					"id": 741890412,
