			},
			"dialogs": [
				{
					"id": 741890501,
					"content": "Tolong tunggu sebentar. Apa kamu mau tahu rahasia tentang harta karunnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890502
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890502,
					"content": "Rahasia apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890503
					]
				},
				{
					"id": 741890503,
					"content": "Ini ada hubungannya dengan harta karun dan kunci untuk membuka gerbang. Gimana? Tertarik?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890504,
						741890505
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890504,
					"content": "Kamu tidak minta aku buat lawan monster lagi, kan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890506
					]
				},
				{
					"id": 741890506,
					"content": "Tidak dong! Mana mungkin minta tamu kedai buat kayak gitu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890507
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890507,
					"content": "Kamu lihat tidak meriam di sebelahku dan tumpukan batuan di arah seberang sana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890508
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890508,
					"content": "Aktifkan meriam dan pecahkan batu-batu itu, dan semua harta karun yang tersisa akan menjadi milikmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890509
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890509,
					"content": "Siapa sih yang namain meriamnya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890510
					]
				},
				{
					"id": 741890510,
					"content": "Si pengemudi kapal yang kasih nama. Aku juga tidak terlalu yakin dia dapatnya dari mana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890511,
						741890512
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890511,
					"content": "Sudahlah. Jadi bagian mana yang hilang?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890513
					]
				},
				{
					"id": 741890513,
					"content": "Sepertinya kamu salah info. Semua komponen meriam ini masih utuh dan energinya juga penuh. Aku yang rawat tiap hari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890514
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890514,
					"content": "Tapi sebelum kamu aktifkan meriamnya, aku mau kamu jawab beberapa pertanyaan dulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890515
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890515,
					"content": "Ini permintaan dari si pengemudi kapal. Dia bilang ini bisa jadi hiburan menarik untuk para tamu di kedai, suatu hal yang bisa membuat mereka berhenti dulu minumnya tapi bisa tetap berlama-lama di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890516
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890516,
					"content": "Eh aku tidak yakin sih, tapi boleh deh, tanya saja langsung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890517
					]
				},
				{
					"id": 741890517,
					"content": "Pertanyaan pertama: Berapa banyak meja yang ada di The Rusty Rudder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890518
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890518,
					"content": "Pertanyaan kedua: Berapa banyak karyawan yang ada di The Rusty Rudder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890519
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890519,
					"content": "Pertanyaan ketiga: Apa yang tidak disajikan di The Rusty Rudder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890520
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890520,
					"content": "Nah jadi gitu. Kamu cuma perlu jawab tiga pertanyaan tersebut dengan benar untuk mengaktifkan meriamnya, hancurkan batu-batunya, terus ambil harta karunnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890521
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890521,
					"content": "Terus apa yang terjadi kalau aku sudah dapat harta karunnya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890522
					]
				},
				{
					"id": 741890522,
					"content": "Setelah itu, aku akan cari waktu yang tepat untuk taruh hadiah lain di gua dan menyegelnya dengan bebatuan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890523
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890523,
					"content": "Harta karun itu menunggu untuk diambil oleh tamu yang bisa mengaktifkan meriamnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890524,
						741890525
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890524,
					"content": "Kerja bagus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890528
					]
				},
				{
					"id": 741890528,
					"content": "Begitulah. Kamu boleh cari jawabannya sekarang. Sementara itu, aku akan berada di sini dan menunggumu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890525,
					"content": "Bosmu kelewatan banget.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890526
					]
				},
				{
					"id": 741890526,
					"content": "Memang sulit menyangkal kata-katamu, tapi aku masih belum menemukan cara untuk mengarahkan meriam ke si pengemudi kapal tanpa ketahuan sama dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890527
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890527,
					"content": "Lagian, kalau aku tembak sembarangan ke arah yang salah nanti malah melukai tamu lain di kedai, itu bertentangan dengan prinsip moralku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890528
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890512,
					"content": "Sudahlah. Jadi gimana isi energi meriamnya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890513
					]
				},
				{
					"id": 741890505,
					"content": "Kamu tidak minta aku buat cari sesuatu lagi, kan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890506
					]
				}
			]
		}
	]
}