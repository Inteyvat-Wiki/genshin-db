						700200115
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 700200115,
					"content": "Oke, lokasi musuh sudah ditandai di petamu. Kuserahkan padamu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200116
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700200116,
					"content": "Dada, Valo!",
