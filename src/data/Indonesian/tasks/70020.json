					"nextDialogs": [
						700200111
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700200111,
					"content": "Dada odomu! Kundala dada! Kundala zido, mi dada! Muhe yeye!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200112
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 700200112,
					"content": "Oh... singkatnya dia ingin kita membantunya... mengalahkan musuh yang kuat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200113
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700200113,
					"content": "Ya zido? Ye? Mi?",
