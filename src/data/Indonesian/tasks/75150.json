			},
			"dialogs": [
				{
					"id": 751501301,
					"content": "Apa kalian ingin bertanya sesuatu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501302
					],
					"speakerTitle": "Pelayan Naga Sumber"
				},
				{
					"id": 751501302,
					"content": "Bagaimana cara kita bisa mencapai Jantung Gunung Suci?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751501303
					]
				},
				{
					"id": 751501303,
					"content": "Pintu masuk ke dalam Jantung Gunung Suci terletak di pintu masuk yang baru saja digali .... Turunlah ke kedalaman celah gunung berapi yang dijaga oleh Patung Naga Sumber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501304
					],
					"speakerTitle": "Pelayan Naga Sumber"
				},
				{
					"id": 751501304,
					"content": "Selain itu, siapa pun yang ingin memasuki Jantung Gunung Suci harus mendapatkan \"izin\" terlebih dahulu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501305
					],
					"speakerTitle": "Pelayan Naga Sumber"
				},
				{
					"id": 751501305,
					"content": "Dengan begitu barulah kamu bisa mendapatkan pengakuan dari Patung Naga Sumber yang berjaga di sana ... Jantung Gunung Suci, atau disebut juga Huitzilopochtli ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501306
					],
					"speakerTitle": "Pelayan Naga Sumber"
				},
				{
					"id": 751501306,
					"content": "Aku bisa dapat izin ini dari mana ya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751501307
					]
				},
				{
					"id": 751501307,
					"content": "Menurut perjanjian dan dekrit yang dikeluarkan oleh Tuan Xiuhcoatl, siapa pun yang ingin memasuki ... Jantung Gunung Suci, atau \"Huitzilopochtli\" ... keturunan suku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501308
					],
					"speakerTitle": "Pelayan Naga Sumber"
				},
				{
					"id": 751501308,
					"content": "Silakan pergi ke Chamber of Deliberation untuk mengajukan permohonan, dan tunggu izinnya dikeluarkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501309
					],
					"speakerTitle": "Pelayan Naga Sumber"
				},
				{
					"id": 751501309,
					"content": "Bagaimana dengan sumber energi yang dibutuhkan Patung Naga Sumber?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751501310
					]
				},
				{
					"id": 751501310,
					"content": "Sedang mencari .... Tidak ada data terkait ... mungkin disebabkan karena korosi Abyss di kota yang membuat banyak hal menjadi hilang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501311
					],
					"speakerTitle": "Pelayan Naga Sumber"
				},
				{
					"id": 751501311,
					"content": "Jika kamu bisa membersihkan pengaruh dari Abyss dan mendapatkan kembali datanya, mungkin kamu bisa mendapatkan informasi yang kamu cari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501312
					],
					"speakerTitle": "Pelayan Naga Sumber"
				},
				{
					"id": 751501312,
					"content": "Aku sudah menandai lokasi yang mungkin digunakan untuk menyimpan data. Silakan bersihkan kontaminasi Abyss yang ada di sana dan pulihkan area penyimpanan datanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501313
					],
					"speakerTitle": "Pelayan Naga Sumber"
				},
				{
					"id": 751501313,
					"content": "Apa kalian ingin bertanya sesuatu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501314
					],
					"speakerTitle": "Pelayan Naga Sumber"
				},
				{
					"id": 751501314,
					"content": "Tidak ada pertanyaan lagi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751501315
					]
				},
				{
					"id": 751501315,
					"content": "Baiklah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pelayan Naga Sumber"
				}
			]
		},
