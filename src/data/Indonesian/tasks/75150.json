			"dialogs": [
				{
					"id": 751501501,
					"content": "Ah! Ada Pelayan Naga Sumber ... eh? Tapi kok yang ini kayaknya lebih gede dari lainnya ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751501502,
					"content": "Groar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501503
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751501503,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501504
					],
					"speakerTitle": "Pelayan Naga Sumber"
				},
				{
					"id": 751501504,
					"content": "Hehe, kita udah ketemu lagi aja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751501505,
					"content": "Mohon maaf, tapi informasi tentang kalian belum terekam di database-ku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501506
					],
					"speakerTitle": "Pelayan Naga Sumber"
				},
				{
					"id": 751501506,
					"content": "Tidak disangka ada manusia yang bisa mencapai tempat ini. Setidaknya sudah 500 tahun sejak kejadian seperti ini terakhir kali terjadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501507
					],
					"speakerTitle": "Pelayan Naga Sumber"
				},
				{
					"id": 751501507,
					"content": "Tunggu, kamu bukan Amaru ... atau Ehecatl ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751501508,
					"content": "... Memang benar ada individu yang dipanggil dengan nama tersebut, tapi aku bukan salah satu dari mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501509
					],
					"speakerTitle": "Pelayan Naga Sumber"
				},
				{
					"id": 751501509,
					"content": "Sepertinya ada kesalahpahaman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501510
					],
					"speakerTitle": "Pelayan Naga Sumber"
				},
				{
					"id": 751501510,
					"content": "Aku adalah prototipe yang dibuat oleh Tuan Xiuhcoatl untuk mencatat informasi, jadi aku tidak memiliki nama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501511
					],
					"speakerTitle": "Pelayan Naga Sumber"
				},
				{
					"id": 751501511,
					"content": "Nguuuk ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501512
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751501512,
					"content": "Tunggu, itu salah. Bukannya aku tidak punya nama, tapi aku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501513
					],
					"speakerTitle": "Pelayan Naga Sumber"
				},
				{
					"id": 751501513,
					"content": "Aku adalah satu-satunya Pelayan Naga Sumber yang memiliki kecerdasan, tapi tak bertuan. Setelah kejatuhan Tuan Xiuhcoatl pun, aku masih bertanggung jawab untuk hal-hal dasar ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501514
					],
					"speakerTitle": "Pelayan Naga Sumber"
				},
				{
					"id": 751501514,
					"content": "Seperti catatan pemeliharaan dan informasi kota yang paling mendasar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501515
					],
					"speakerTitle": "Pelayan Naga Sumber"
				},
				{
					"id": 751501515,
					"content": "Tapi, sebagian catatannya hilang karena invasi dari musuh bayangan kita. Jadi sekarang, sudah tidak ada data tentang namaku sendiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501516
					],
					"speakerTitle": "Pelayan Naga Sumber"
				},
				{
					"id": 751501516,
					"content": "Hemmm, kayaknya kita salah orang ... eh, salah robot ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751501517,
					"content": "Tidak apa-apa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501518
					],
					"speakerTitle": "Pelayan Naga Sumber"
				},
				{
					"id": 751501518,
					"content": "Robot ini gede banget, tapi kurang pinter ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751501519,
					"content": "#{NICKNAME}, kayaknya sih dia bukan orang yang sembunyi dalam mesin lalu ngomong sama kita itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751501520,
					"content": "Tapi dia bilang kalau dia yang bertugas menjaga catatan dan lain-lain, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501521
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751501521,
					"content": "Gimana kalau kita tanya-tanya ke dia? Siapa tahu ... dia tahu cara pergi ke Jantung Gunung Suci?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501522,
						751501523
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751501522,
					"content": "Mungkin itu yang dimaksud \"orang itu\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751501524
					]
				},
				{
					"id": 751501524,
					"content": "Groar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751501523,
					"content": "Yah kita coba tanya saja ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751501524
					]
				}
			]
