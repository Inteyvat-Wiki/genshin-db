			"dialogs": [
				{
					"id": 751500901,
					"content": "Halo, jenis pengumpulan data baru terdeteksi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500902
					],
					"speakerTitle": "Pelayan Naga Sumber"
				},
				{
					"id": 751500902,
					"content": "... Entri tentang inti energi \"Mekanisme Sumber\" telah diperbarui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500903
					],
					"speakerTitle": "Pelayan Naga Sumber"
				},
				{
					"id": 751500903,
					"content": "Inti dari Mekanisme Sumber adalah Phlogiston, tapi ini adalah wujud Phlogiston yang sudah dipadatkan dan lebih menyerupai cahaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500904
					],
					"speakerTitle": "Pelayan Naga Sumber"
				},
				{
					"id": 751500904,
					"content": "Pengontrolan reaksi [DATA HILANG] dapat menciptakan Unit Phlogiston yang stabil dan juga dapat mengendalikan pelepasan energi dengan lebih presisi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500905
					],
					"speakerTitle": "Pelayan Naga Sumber"
				},
				{
					"id": 751500905,
					"content": "Energi yang dibutuhkan oleh Mekanisme Sumber bergantung pada ukuran dan kompleksitas logika pemrosesannya. Jumlah Unit Phlogiston yang dibutuhkan oleh Pelayan Naga Sumber adalah [DATA HILANG] ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500906
					],
					"speakerTitle": "Pelayan Naga Sumber"
				},
				{
					"id": 751500906,
					"content": "Sedangkan Patung Naga Sumber yang lebih besar membutuhkan kurang dari itu, tepatnya membutuhkan tiga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500907
					],
					"speakerTitle": "Pelayan Naga Sumber"
				},
				{
					"id": 751500907,
					"content": "\"Informasi adalah energi, dan energi adalah informasi. Medium data yang telah kamu dapatkan terhitung sebagai satu Unit Phlogiston ....\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500908
					],
					"speakerTitle": "Pelayan Naga Sumber"
				},
				{
					"id": 751500908,
					"content": "Jadi satu Unit Phlogiston adalah satu bola api ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751500909
					]
				},
				{
					"id": 751500909,
					"content": "Ya, bisa dibilang begitu. Kalian berhasil memulihkan satu Unit Phlogiston yang terkorupsi oleh Abyss, jadi sekarang aku bisa mengekstraknya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500910
					],
					"speakerTitle": "Pelayan Naga Sumber"
				},
				{
					"id": 751500910,
					"content": "Benda ini juga bisa digunakan sebagai sumber energi alternatif untuk Mekanisme Sumber yang terkorosi Abyss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pelayan Naga Sumber"
				}
			]
		},
