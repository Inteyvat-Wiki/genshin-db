			"dialogs": [
				{
					"id": 751500401,
					"content": "Bagaimana cara kita bisa mencapai Jantung Gunung Suci?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751500402
					]
				},
				{
					"id": 751500402,
					"content": "Pintu masuk ke Jantung-nya sudah dekat. Saat menciptakan ulang pusat kota Tollan, Tuan Xiuhcoatl menggali ke arah bawah untuk mencari sebuah lingkungan eksperimen yang stabil ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500403
					],
					"speakerTitle": "Pelayan Naga Sumber"
				},
				{
					"id": 751500403,
					"content": "Di tempat itulah dia menciptakan senjata pamungkas untuk melawan Abyss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500404
					],
					"speakerTitle": "Pelayan Naga Sumber"
				},
				{
					"id": 751500404,
					"content": "Tapi karena \"penyegelan\", senjata tersebut telah terkontaminasi oleh korosi Abyss yang terdalam. Dan kotanya pun kini telah diambil alih ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500405
					],
					"speakerTitle": "Pelayan Naga Sumber"
				},
				{
					"id": 751500405,
					"content": "Pintu masuk menuju Jantung Gunung Suci berada di bawah retakan di Kota Suci ... tapi di situ jugalah korosi musuh bayangan kita terkonsentrasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pelayan Naga Sumber"
				}
			]
		},
