			"dialogs": [
				{
					"id": 10030601,
					"content": "Bocah, tak lihat aku lagi istirahat ya? Sana pergi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030602
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 10030602,
					"content": "Permisi, kami mau pesan Almond To—",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10030603
					]
				},
				{
					"id": 10030603,
					"content": "Enyah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030604
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 10030604,
					"content": "Astaga. Koki ini ramahnya sudah selevel sama si Wagner yang di Mondstadt ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10030605,
					"content": "Bos Goldet yang minta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10030606
					]
				},
				{
					"id": 10030606,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030607
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 10030607,
					"content": "Baiklah. Bos yang minta, aku bisa apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030608
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 10030608,
					"content": "Tapi aku lagi tidak niat. Jadi tidak bisa bikin makanan serumit Almond Tofu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030609
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 10030609,
					"content": "Loh, Kenapa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10030610,
					"content": "Pendekar pedang harus punya tangan yang stabil. Begitu pula seorang koki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030611
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 10030611,
					"content": "Tapi tanganku ... tanganku tidak stabil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030612
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 10030612,
					"content": "Soalnya waktu itu ada pengelana yang bilang kalau ... penginapan ini ... berhantu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030613
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 10030613,
					"content": "Lalu barusan! Barusan sekali ... aku lihat ada yang aneh ... di dapur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030614
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 10030614,
					"content": "(Koki ini kelihatan garang, tapi dia ketakutan sampai kelihatan payah kalau sudah ngomongin hantu ya.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10030615,
					"content": "Aku jadi kepikiran terus ... bahkan Wangshu Inn saja tidak aman dari hantu. Tanganku jadi gemetaran, tidak bisa buat makanan macam Almond Tofu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030616
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 10030616,
					"content": "#Baiklah, {NICKNAME}. Demi Almond Tofu bermutu tinggi, kita harus periksa dapurnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
