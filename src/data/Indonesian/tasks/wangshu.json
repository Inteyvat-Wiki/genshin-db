					"nextDialogs": [
						10031013
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10031013,
					"content": "Ada lukisan kaligrafi di sini, namanya \"Simbol Kesaksian\". Lukisan itu sudah beredar selama ribuan tahun. Kalian lihat dulu itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031014
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10031014,
					"content": "Setelah itu, kalian bisa keluar dan cari tempat yang bisa kelihatan Simbol Kesaksian yang sama persis dengan yang di lukisan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
