					"nextDialogs": [
						10031007
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10031007,
					"content": "Nah, kalian berdua pergilah. Pastikan si hantu kecil itu tidak menakuti orang sembarangan lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031008
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10031008,
					"content": "Aku bukannya mau main perintah seenaknya, tapi seperti kata Adeptus: \"Jiwa manusia fana lebih lemah dari jiwa Adeptus\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031009
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10031009,
					"content": "Jadi, biar jiwa kalian tidak kenapa-kenapa waktu berurusan dengan Adeptus, lebih baik kalian latihan dulu sama si hantu kecil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031010,
						10031012
