			"trigger": {
				"objectNames": [
					"Verr Goldet"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10030401,
					"content": "Tentang Adeptus di atas ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10030402
					]
				},
				{
					"id": 10030402,
					"content": "Oh? Sudah ketemu Xiao ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030403
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10030403,
					"content": "Hebat. Dia jarang sekali niat ketemu orang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030404
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10030404,
					"content": "Yang barusan itu dia kalau lagi \"niat\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10030405,
					"content": "Iya, Adeptus itu susah sekali ditemui orang loh. Banyak orang yang menghabiskan seumur hidup berdoa pada mereka, tapi tidak pernah satu kali pun melihat mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030406
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10030406,
					"content": "Ketika Archon Geo membangun Liyue dulu, dia meminjam kekuatan para Adeptus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030407
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10030407,
					"content": "Tetapi kebanyakan dari mereka cuma tahu melindungi Liyue dengan cara bertarung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030408
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10030408,
					"content": "Jadi selama ribuan tahun, manusia menguasai Liyue, sementara para Adeptus hidup di pegunungan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030409
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10030409,
					"content": "Ibu bos tahu banyak ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10030410,
					"content": "Salah, aku bukan ibu bos. Aku \"bos\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030411
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10030411,
					"content": "Berhubung kalian sudah dapat restu para Adeptus, urusannya bakal jadi sedikit lebih mudah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030412
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10030412,
					"content": "Saranku sih ... kalian usaha biar Xiao senang, dan semuanya akan baik-baik saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030413
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10030413,
					"content": "Bikin dia senang? Astaga, enggak kebayang deh \"senang\"-nya Vigilany Yaksha itu macam mana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10030414,
					"content": "Haha! Ingin tahu kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030415
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10030415,
					"content": "(Aku sendiri juga belum pernah lihat dia tersenyum.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030416
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10030416,
					"content": "Gini deh, kalian cari kokiku di bawah dan minta dia buatkan Almond Tofu seporsi, lalu tambah masakan lain yang kalian bisa bikin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030417
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10030417,
					"content": "Almond Tofu itu salah satu dari sedikit makanan manusia yang Xiao suka. Masakan yang satunya lagi terserah kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030418
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10030418,
					"content": "#Terserah kami ya ...{NICKNAME}, kamu paling jago masak apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030419,
						10030421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10030419,
					"content": "Satisfying Salad?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10030420
					]
				},
				{
					"id": 10030420,
					"content": "Buat yang tak mungkin gagal saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10030423,
					"content": "Tapi kalau kita mau kasih makan Adeptus, kayaknya Satisfying Salad sudah pilihan paling aman deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10030421,
					"content": "Maha Manjusaka Hot Pyro Slime?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10030422
					]
				},
				{
					"id": 10030422,
					"content": "Waduh, masakan apa lagi tuh? Paimon mau coba dong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030423
					],
					"speakerTitle": "Paimon"
				}
			]
		},
