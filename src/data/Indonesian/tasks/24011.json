					"Iaune"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240110101,
					"content": "Burung camar, oh burung camar. Aku tahu kalian lapar, tapi aku juga belum kenyang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110102
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110102,
					"content": "Ah sudahlah. Kalau kalian senang aku juga senang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110103
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110103,
					"content": "Lagi ngapain nih?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110104
					]
				},
				{
					"id": 240110104,
					"content": "Pengembara? Senang bertemu denganmu. Kalau ada urusan, mohon tunggu sebentar. Kentang gorengku masih belum habis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110105,
						240110107
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110105,
					"content": "Enggak ada urusan kok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110106
					]
				},
				{
					"id": 240110106,
					"content": "Oh gitu. Baiklah, aku makan dulu ya ... harus cepat dihabiskan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110108
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110108,
					"content": "Yah, ini makanan utamanya. Hari ini ada urusan dengan Tuan Roialte, makannya harus cepat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110109
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110109,
					"content": "Aku tidak biasa makan di Palais. Lebih suka keluar cari tempat sepi lalu makan dengan cepat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110110
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110110,
					"content": "Hari ini ya ... Aku tidak tahu kenapa, tapi kentang gorengku diserang terus, dan sudah dikasih sebanyak apa pun juga tidak puas-puas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110111,
						240110112
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110111,
					"content": "Soalnya burungnya banyak, dan kentangnya cuma segitu-gitunya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110113
					]
				},
				{
					"id": 240110113,
					"content": "Betul, tapi aku juga tidak mungkin kasih makan semua burung di laut, ya kan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110114
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110114,
					"content": "Kentang gorengnya punya kamu kan. Jangan dikasih ke burung camar semua lah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240110115,
					"content": "Nanti kelaparan baru tahu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110116,
						240110117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240110116,
					"content": "Terus kenapa kok kayak yang kurang semangat gitu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110118
					]
				},
				{
					"id": 240110118,
					"content": "Apa? Aku ... Sebenarnya iya, sedikit. Memang tidak ada yang luput dari matamu ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110119
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110119,
					"content": "Rasanya ... bingung buat apa aku kerja. Sepanjang hari sibuk tidak karuan di Maison Gestion, tapi rasanya kok tidak ada hasilnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110120
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110120,
					"content": "Tidak membantu orang, juga tidak memudahkan siapa pun. Tuan Roialte bilang berulang kali kalau pekerjaan kami sangat penting, tapi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110121
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110121,
					"content": "Duduk di depan mesin tik, jari bergerak tanpa henti. Demi apa coba? Biar hilang saja satu lagi tombol hurufnya. Lumayan kan, jadi duit buat Estelle ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110122
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110122,
					"content": "Maaf, harusnya aku tidak ngomong gini. Rasanya seperti ... kehilangan arah, terus jalan tanpa tujuan. Mungkin aku perlu lebih banyak waktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110123,
						240110124
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110123,
					"content": "Makan dulu gih.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110125
					]
				},
				{
					"id": 240110125,
					"content": "Kamu benar. Tapi sudah jam segini ... sudah tidak keburu kalau mau beli kentang lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110126
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110126,
					"content": "Ya sudahlah, sisanya buat burung saja. Nanti aku cari makan lagi setelah urusan dengan Tuan Roialte selesai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110127
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110127,
					"content": "Perlu ... ehhh ... setengah hari lah. Tidak terlalu lama kan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110128
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110128,
					"content": "Yakin kuat nahan lapar selama itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110129,
						240110130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240110129,
					"content": "Serahkan padaku lah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110131
					]
				},
				{
					"id": 240110131,
					"content": "Ti-Tidak usah repot-repot. Cuma kentang goreng doang, tidak usah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110132
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110132,
					"content": "Makan yang benar. Mau kerja gimana kalau perut kosong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240110130,
					"content": "Burung camarnya biar aku yang urus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110131
					]
				},
				{
					"id": 240110124,
					"content": "Aku urus burung camarnya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110125
					]
				},
				{
					"id": 240110117,
					"content": "Lagi kurang fit ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110118
					]
				},
				{
					"id": 240110112,
					"content": "Belum kebagian semua.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110113
					]
				},
				{
					"id": 240110107,
					"content": "Ngapain makan kentang goreng di sini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110108
					]
				}
			]
		},
