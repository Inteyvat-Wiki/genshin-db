					"Iaune"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240111301,
					"content": "Burung camar, oh burung camar. Kalau sudah selesai makan kentang gorengnya, tolong pergilah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111302,
						240111303
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111302,
					"content": "Gimana situasinya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240111304
					]
				},
				{
					"id": 240111304,
					"content": "Tidak sama sekali. Waktu burung camarnya menyerang, dia malah sembunyi di belakangku, ketakutan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111305
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111305,
					"content": "Bukan salah dia juga sih. Anjing ras ini tugasnya cuma satu ... yaitu menyanyangi dan disayangi. Tidak tahu cara menyerang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111306
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111306,
					"content": "Tugas kita juga sama kok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240111307
					]
				},
				{
					"id": 240111307,
					"content": "Mungkin ya. Tapi kadang cinta juga bisa berarti sebuah \"hak\". Kalau sudah bicara soal hak, biasanya urusan jadi runyam ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111308
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111308,
					"content": "Maaf jadi ngelantur. Belakangan ini rasanya lelah hati dan jiwa, pikiran jadi kacau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111309
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111309,
					"content": "Tapi sekarang, yang harus dipikirkan adalah bagaimana caranya makan kentang goreng dengan tenang dan damai ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111303,
					"content": "Anjingnya efektif?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240111304
					]
				}
			]
		},
