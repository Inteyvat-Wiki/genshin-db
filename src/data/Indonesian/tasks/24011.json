					"Iaune"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240111201,
					"content": "Eh ... mungkin makan di tempat lain?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240111202
					]
				},
				{
					"id": 240111202,
					"content": "Aku belum ketemu tempat lebih bagus buat makan. Kalau terlalu dekat dengan Palais, takutnya ketemu teman sekantor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111203
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111203,
					"content": "Terus diajak ngobrolin kerjaan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111204
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111204,
					"content": "Tapi kalau terlalu jauh, nanti tidak bisa balik tepat waktu. Bahaya kalau ada hal penting yang kelewat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111205
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111205,
					"content": "Mempertimbangkan dua poin tadi, cuma ini satu-satunya tempat aku bisa makan sendirian dengan tenang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				}
			]
		},
		{
			"id": 2401113,
