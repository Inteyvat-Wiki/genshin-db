				{
					"id": 240111401,
					"content": "Aku usir semua deh burungnya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240111402
					]
				},
				{
					"id": 240111402,
					"content": "Baiklah. Tapi janji ya ... cuma usir saja, oke? Mereka cuma mau makan kentang goreng, bukan berniat merugikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111403
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111403,
					"content": "Yah, aku memang dirugikan sih. Tapi tidak sampai membahayakan jiwa, jadi ... tolong, usir saja ya. Jangan dihajar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				}
			]
