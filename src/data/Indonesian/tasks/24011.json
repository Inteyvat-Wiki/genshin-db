					"nextDialogs": [
						240111503
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111503,
					"content": "Tapi ... Kalau mereka tidak kenyang juga tidak apa-apa, asalkan aku punya waktu menghabiskan kentang gorengnya. Tolong ya.",
