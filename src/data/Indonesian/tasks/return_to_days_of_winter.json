				"objectNames": [
					"Viktor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200290701,
					"content": "Bagaimana? Kamu sudah dapat hadiahnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290702
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290702,
					"content": "Sudah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290703
					]
				},
				{
					"id": 200290703,
					"content": "Oh, kamu memang bisa diandalkan. Coba kulihat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290704
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290704,
					"content": "Ini ... apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290705
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290705,
					"content": "Bonekanya bengkok-bengkok tidak jelas, lalu warnanya juga sedikit aneh ... tapi harum sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290706
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290706,
					"content": "Menurutmu anak kecil akan suka hadiah ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290707,
						200290708
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290707,
					"content": "Ini rekomendasi dari Marjorie sendiri.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290710
					]
				},
				{
					"id": 200290710,
					"content": "Baiklah, hadiah ini juga bagus kok. Tapi suratnya taruh di mana ya ... Oh, taruh di bawahnya saja deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290711,
						200290712
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290711,
					"content": "Kamu bahkan menulis surat untuk Lily?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290713
					]
				},
				{
					"id": 200290713,
					"content": "Bukan apa-apa kok, hanya basa-basi saja, tidak usah dipedulikan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290714
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290714,
					"content": "Baiklah, tolong ambil hadiah ini dan berikan pada Lily. Harusnya dia ada di <color=#00E1FFFF>sekitar alun-alun</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290715
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290715,
					"content": "Huh, kalau aku yang berikan hadiahnya pada Lily secara langsung, Rudolf pasti akan menatapku tajam ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290712,
					"content": "Apa isi suratnya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290713
					]
				},
				{
					"id": 200290708,
					"content": "Kalau begitu kamu kirim saja sendiri hadiah dari Snezhnaya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290709
					]
				},
				{
					"id": 200290709,
					"content": "Aku juga pernah berpikir begitu. Tapi kalau anggota Fatui sepertiku mengirim barang ke Mondstadt, pasti barangnya akan langsung ditahan oleh Knights of Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290710
					],
					"speakerTitle": "Viktor"
				}
			]
		},
