			},
			"dialogs": [
				{
					"id": 200290501,
					"content": "Te-Terima kasih, Pengembara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290502
					],
					"speakerTitle": "Terrified Schuster"
				},
				{
					"id": 200290502,
					"content": "Monster-monster ini terus mengejarku, aku sudah lari sampai sini pun, mereka masih tidak mau melepaskanku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290503
					],
					"speakerTitle": "Terrified Schuster"
				},
				{
					"id": 200290503,
					"content": "Kamu datang untuk memetik Wolfhook?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290504
					]
				},
				{
					"id": 200290504,
					"content": "Eh? Ya, aku ditugaskan Nona Marjorie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290505,
						200290507
					],
					"speakerTitle": "Terrified Schuster"
				},
				{
					"id": 200290505,
					"content": "Kenapa tidak mencari orang lain untuk menemanimu ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290506
					]
				},
				{
					"id": 200290506,
					"content": "Mana mungkin ada yang mau menyelesaikan misi \"memetik tanaman\" seperti ini denganku ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290508
					],
					"speakerTitle": "Terrified Schuster"
				},
				{
					"id": 200290508,
					"content": "Aku tahu sih, tapi Wolfhook hanya ada di Wolvendom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290509
					],
					"speakerTitle": "Terrified Schuster"
				},
				{
					"id": 200290509,
					"content": "Lagi pula Wolfhook yang tumbuh di tempat-tempat aman pasti sudah habis dipetik orang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290510
					],
					"speakerTitle": "Terrified Schuster"
				},
				{
					"id": 200290510,
					"content": "Jadi aku hanya bisa masuk ke bagian dalam untuk memetiknya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290511
					],
					"speakerTitle": "Terrified Schuster"
				},
				{
					"id": 200290511,
					"content": "Nanti saja kita bicarakan itu, bisakah kamu bantu aku membawa Wolfhook ini ke Marjorie?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290512
					],
					"speakerTitle": "Terrified Schuster"
				},
				{
					"id": 200290512,
					"content": "Aku mau istirahat sebentar, tadi aku lari sampai hampir mati ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Terrified Schuster"
				},
				{
					"id": 200290507,
					"content": "Bisa-bisanya kamu lari sampai sejauh ini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290508
					]
				}
			]
		},
