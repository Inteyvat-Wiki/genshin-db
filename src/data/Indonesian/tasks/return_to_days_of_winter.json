						200290903
					]
				},
				{
					"id": 200290903,
					"content": "Baguslah kalau dia senang. Si Rudolf pasti bicara yang tidak-tidak lagi, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290904
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290904,
					"content": "Tanpa kamu bilang pun aku sudah tahu. Tidak ada yang memercayaiku di Mondstadt ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290905
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290905,
					"content": "Kapan kamu berangkat?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290906
					]
				},
				{
					"id": 200290906,
					"content": "Perintah resminya belum keluar. Aku hanya mengemaskan barang-barangku lebih awal, dan menunggu di Goth Grand Hotel. Aku siap pergi kapan saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290907
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290907,
					"content": "Kenapa ekspresimu begitu serius? Kamu mau mengucapkan selamat tinggal ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290908
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290908,
					"content": "Tidak tuh!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290909
					]
				},
				{
					"id": 200290909,
					"content": "Huh, bagus kalau begitu. Kita berdua bukan teman baik, kita hanya partner sementara saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290910
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290910,
					"content": "Suatu hari kalau datang ke Snezhnaya, kamu bisa cari aku. Kita bisa teruskan kerja sama kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290911
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290911,
					"content": "Sudah cukup basa-basinya. Ambillah imbalan ini. Ini adalah \"pertukaran setara\" kita yang terakhir di Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290912
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290912,
					"content": "*huff* Semoga aku tidak diberikan pekerjaan merepotkan sepulangku nanti ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
