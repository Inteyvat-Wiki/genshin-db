			"dialogs": [
				{
					"id": 200290401,
					"content": "Kamu sudah dapat hadiahnya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290402,
						200290406,
						200290409,
						200290412
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290402,
					"content": "Apa yang akan kamu lakukan habis pulang nanti?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290403
					]
				},
				{
					"id": 200290403,
					"content": "Melakukan apa? Hmmm, lihat saja penugasan dari atasanku nanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290404
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290404,
					"content": "Yah kalau nasibku buruk, bisa jadi aku akan dikirimkan ke tempat antah berantah lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290405
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290405,
					"content": "Tapi bagaimanapun juga, yang penting jangan sampai dikirim ke Inazuma ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290406,
					"content": "Kenapa kamu tiba-tiba dipindahtugaskan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290407
					]
				},
				{
					"id": 200290407,
					"content": "Kenapa lagi kalau bukan karena pengorbanan ... Nona Signora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290408
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290408,
					"content": "Haduh, bawahan sepertiku hanya perlu mendengar perintah atasan saja, buat apa berpikir terlalu banyak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290409,
					"content": "Lily pergi ke mana?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290410
					]
				},
				{
					"id": 200290410,
					"content": "Kudengar Rudolf bilang mau membawanya pergi bermain di alun-alun, atau apa begitu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290411
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290411,
					"content": "Huh, dia pasti tidak mau biarkan Lily berbicara dengan Paman Fatui jahat sepertiku._",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290412,
					"content": "Sampai jumpa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290413
					]
				},
				{
					"id": 200290413,
					"content": "Masalah hadiah, kuserahkan padamu ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		},
