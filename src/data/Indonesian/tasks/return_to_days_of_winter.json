			"dialogs": [
				{
					"id": 200291701,
					"content": "Bisakah kamu membantuku berikan hadiah ini pada Lily? Dia harusnya ada di <color=#00E1FFFF>sekitar alun-alun</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200291702
