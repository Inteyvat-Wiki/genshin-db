			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Viktor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200292801,
					"content": "Fiuh, akhirnya aku bisa pulang juga ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200292802
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200292802,
					"content": "Kamu mau pulang kampung, Viktor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200292803
					]
				},
				{
					"id": 200292803,
					"content": "Eh? Oh, ternyata kamu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200292804
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200292804,
					"content": "Benar. Baru-baru ini aku mendapat perintah dari atasanku kalau aku bisa pulang ke Snezhnaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200292805
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200292805,
					"content": "Sepertinya aku akan dipindahkan ke Harbinger lain dan tidak perlu tinggal di Mondstadt sambil menunggu perintah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200292806
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200292806,
					"content": "Tapi aku tidak tahu bakal dipindah ke Harbinger yang mana kali ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290107
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290107,
					"content": "Kira-kira kapan kamu akan pergi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290108
					]
				},
				{
					"id": 200290108,
					"content": "Kata atasanku yang penting bereskan barang-barangku dulu, agar nanti bisa langsung berangkat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290109
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290109,
					"content": "Yah, tapi bagus juga kan? Akhirnya aku bebas dari tatapan-tatapan para suster itu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290110
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290110,
					"content": "Oh ya, Pengembara. Kita sudah bekerja sama selama ini, boleh dong bantu aku sekali lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290111
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290111,
					"content": "Sama seperti biasanya, kamu bantu aku, aku bayar kamu. Pasti tidak akan sia-sia deh, bagaimana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290112,
						200290113
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290112,
					"content": "Kamu mau cerita apa lagi kali ini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290114
					]
				},
				{
					"id": 200290114,
					"content": "Hahaha. Jujur saja, aku sudah kehabisan cerita tentang Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290115
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290115,
					"content": "Kalau kamu bantu aku kali ini, imbalannya akan dalam bentuk Mora. Menarik, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290116
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290116,
					"content": "Kecuali ... kamu mau dengar dongeng anak kecil yang biasa kuceritakan pada Lily ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290117,
						200290118
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290117,
					"content": "Kamu butuh bantuan apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290120
					]
				},
				{
					"id": 200290120,
					"content": "Ah, sebenarnya yang mau kuminta tolong padamu kali ini ada hubungannya dengan Lily.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290121
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290121,
					"content": "Orang di Mondstadt yang sudi mendengar omongan \"Paman Fatui Jahat\" ini hanya Lily saja ... selain kamu ya tentunya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290122
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290122,
					"content": "Sepertinya aku sudah tidak akan kembali ke Mondstadt lagi ... Jadi aku ingin memberikan hadiah kenang-kenangan untuk Lily.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290123
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290123,
					"content": "Tapi kamu tahu sendiri, kan? Kalau aku sendiri yang pergi ke kota membeli barang, akan ada berapa banyak orang menatapku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290124
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290124,
					"content": "Jadi aku mohon bantuanmu untuk hal ini, Pengembara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290125
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290125,
					"content": "Tolong bantu aku pergi ke toko Marjorie dan lihat apakah ada hadiah yang cocok untuk anak kecil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290118,
					"content": "Kamu masih sering menemani Lily main?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290119
					]
				},
				{
					"id": 200290119,
					"content": "Yah, hanya ... hanya kadang-kadang saja ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290120
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290113,
					"content": "Selama kamu di sini, cerita tentang Fatui tidak ada habisnya ya ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290114
					]
				}
			]
		}
	]
