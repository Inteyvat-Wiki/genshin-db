			"dialogs": [
				{
					"id": 200290801,
					"content": "Lily, jangan bicara dengan paman Fatui aneh itu ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290802
					],
					"speakerTitle": "Rudolf"
				},
				{
					"id": 200290802,
					"content": "Kenapa? Paman Fatooey punya banyak celita untukku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290803
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 200290803,
					"content": "Lily, ini hadiah dari Viktor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290804
					]
				},
				{
					"id": 200290804,
					"content": "Wah, hadiah dali Paman Fatooey? Telima kasih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290805
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 200290805,
					"content": "Tunggu, kenapa Fatui memberikan hadiah pada Lily? Mau apa dia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290806
					],
					"speakerTitle": "Rudolf"
				},
				{
					"id": 200290806,
					"content": "Kalena aku sudah belikan makanan enak untuk Paman Fatooey! Jadi dia kasih aku hadiah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290807
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 200290807,
					"content": "Lily, Paman Fatui bukan orang baik ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290808
					],
					"speakerTitle": "Rudolf"
				},
				{
					"id": 200290808,
					"content": "Tapi, Paman Fatooey sudah celita banyak ke aku, dia olang baik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290809,
						200290810
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 200290809,
					"content": "Ini hadiah selamat tinggal dari Viktor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290811
					]
				},
				{
					"id": 200290811,
					"content": "Hiks, kenapa Paman Fatooey \"pelgi\" ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290812
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 200290812,
					"content": "*huff* Baguslah kalau dia pergi. Dia selalu berbicara dengan Lily setiap hari dan membuatku jantungan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290813
					],
					"speakerTitle": "Rudolf"
				},
				{
					"id": 200290813,
					"content": "Papa, aku mau bilang bye-bye ke Paman Fatooey!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290814
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 200290814,
					"content": "Duh. Lily, kamu jangan dekat-dekat sama paman itu ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290815
					],
					"speakerTitle": "Rudolf"
				},
				{
					"id": 200290815,
					"content": "Kenapaaa? Paman Fatooey itu ... dia baik kok sama Lily!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290816
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 200290816,
					"content": "Dia sering cerita, banyak sekali ceritanya! Paman baik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290817
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 200290817,
					"content": "Lily, dengar Papa ya. Ini susah dijelaskan ... *huff* Begini, nanti kalau kamu sudah besar akan Papa jelaskan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rudolf"
				},
				{
					"id": 200290810,
					"content": "Viktor akan meninggalkan Mondstadt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290811
					]
				}
			]
