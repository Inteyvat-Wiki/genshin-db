			"dialogs": [
				{
					"id": 20140201,
					"content": "Harusnya di sini tempatnya. Tapi Sangonomiya benar, kelihatannya tidak ada yang mencurigakan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140202,
					"content": "#Apa mereka sembunyi ya? {NICKNAME}, ayo lihat bakal ketemu apa kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140203,
					"content": "<color=#00E1FFFF>Monumen- monumen Electro</color> ini mencurigakan deh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 201405,
			"completionStepIds": [
				201405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201405",
							"2"
						],
						"stepId": 201405,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Teppei",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20140501,
					"content": "Fiuh ... Akhirnya beres juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140502,
					"content": "Susah juga lawan yang tadi itu. Tapi kenapa bisa ada Thunderhelm Lawachurl segede gitu sih di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140503,
					"content": "Enggak masuk akal deh ... Terus Paimon rasa suasana di sini juga lumayan ngeri ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140504,
					"content": "Intinya, urusan di sini sudah beres, ayo kita pergi ... eh? Teppei? Lagi apa di sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140505,
					"content": "*uhuk* Wow, aku juga kaget. Aku tidak tahu kalau yang sedang memeriksa daerah sini itu kalian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140506
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140506,
					"content": "Aku baru balik dari garis depan, mengantar perbekalan. Lalu sambil pulang sekalian mengamankan area sekitar sini ... *uhuk*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140507
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140507,
					"content": "Kamu enggak apa-apa? Kamu kayaknya lagi kurang sehat ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140508,
					"content": "Tidak apa-apa, palingan juga kena sedikit flu waktu melaut kemarin ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140509
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140509,
					"content": "Saat di jalan, kudengar ada orang yang datang ke pulau untuk menginvestigasi, jadi kupikir sekalian kulihat saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140510
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140510,
					"content": "Jika ada bahaya, siapa tahu aku ada kesempatan bisa jadi pahlawan ... Eh tahunya malah ketemu kalian, sia-sia deh aku ke sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140511
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140511,
					"content": "Teppei, menurutmu ada yang aneh tidak di tempat ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140512,
					"content": "Hmm ... sekarang setelah kamu bilang gitu, memang rasanya agak aneh sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140513
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140513,
					"content": "Mungkin karena hawa Tatarigami di sini lebih pekat. Lokasi ini kan tidak jauh dari kerangka Orobaxi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140514
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140514,
					"content": "Orobaxi? Siapa tuh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140515,
					"content": "Seorang dewa. Lihat, itu kerangkanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140516
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140516,
					"content": "Wuah! Kerangka ular raksasa. Seram amat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140517,
					"content": "Orobaxi membawa nenek moyang kami keluar dari Enkanomiya. Demikianlah asal-usul Pulau Watatsumi yang kalian kenal hari ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140518
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140518,
					"content": "Nenek moyang kami memandang dia sebagai dewa pelindung. Tapi waktu Perang Archon, Orobaxi menyerang Pulau Yashiori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140519
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140519,
					"content": "Raiden Shogun datang dan membunuh Orobaxi dengan Musou no Hitotachi. Tebasan itu juga membentuk jurang yang hari ini dikenal dengan nama Musoujin Gorge.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140520
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140520,
					"content": "Raiden Shogun membuat Musoujin Gorge hanya dengan satu tebasan saja? Wow, hebat banget ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140521
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140521,
					"content": "Iya, tapi Perang Archon itu brutal sekali ... *uhuk* Pulau Yashiori sampai hancur lebur jadi puing-puing. Bahkan ada yang bilang bahwa pada saat itu Shogun sendiri juga turut kehilangan miliknya yang berharga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140522
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140522,
					"content": "Setelah Orobaxi tewas ... *uhuk* hubungan antara Pulau Watatsumi dan Shogun jadi kurang harmonis. Namun, pasukan pemberontak kami bukan dibentuk karena masalah perbedaan kepercayaan seperti itu, kami hanya menentang Dekrit Perburuan Vision.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140523
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140523,
					"content": "Saat Orobaxi hendak menghancurkan peradaban, Shogun maju untuk menghentikannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140524
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140524,
					"content": "Tapi sekarang Shogun menerbitkan Dekrit Perburuan Vision yang merebut ambisi dan impian orang-orang. Sudah saatnya ada orang yang bangkit dan menghentikan Shogun ... *uhuk*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140525
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140525,
					"content": "Baiklah, aku kembali dulu. Aku baru saja berhadapan dengan beberapa samurai elite Shogun, jadi aku mau istirahat dulu sebentar, terus lanjut ke tugas berikutnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140526
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140526,
					"content": "Kamu juga sebaiknya lapor ke Yang Mulia Sangonomiya secepatnya. Jangan berlama-lama di sini — berada di sekitar Tatarigami terlalu lama tidak baik untuk kesehatan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140527
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140527,
					"content": "*uhuk* ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140528,
						20140529
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140528,
					"content": "Kamu jaga kesehatan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140530
					]
				},
				{
					"id": 20140530,
					"content": "Jangan khawatir, badanku ini kuat kok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140531
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140531,
					"content": "Perkembangan Teppei cepat juga ya kalau dia sudah bisa sampai berhadapan dengan para Samurai Shogunate. Paimon kaget juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140532
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140532,
					"content": "#{NICKNAME}, kita lapor dulu ke <color=#00E1FFFF>Kokomi</color> yuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140529,
					"content": "Kamu juga hati-hati.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140530
					]
				}
			]
		},
		{
			"id": 201406,
			"completionStepIds": [
				201406
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
