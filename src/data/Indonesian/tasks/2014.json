						20140802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140802,
					"content": "Ah ... kalian rupanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140803
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140803,
					"content": "Sebentar, aku bangun dulu ... Aneh, belakangan ini rasanya tidak ada tenaga ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140804,
						20140805
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140804,
					"content": "Teppei ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140806
					]
				},
				{
					"id": 20140806,
					"content": "Ah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140807
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140807,
					"content": "Oh iya, aku belum cerita lengkapnya pada kalian. Akhir-akhir ini aku membuat banyak kontribusi besar untuk perang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140808
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140808,
					"content": "Bertempur melawan Pasukan Shogun di laut, menghadapi semua Samurai Shogunate sendirian, menyelamatkan rekan-rekan yang di-disergap ... Segala macam aksi yang, waktu pertama bertemu kamu, aku mimpi saja tidak berani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140809
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140809,
					"content": "*uhuk* Kalau saja aku bisa lebih kuat. Kalau lebih kuat, maka akan lebih banyak lagi yang bisa kulakukan untuk pemberontakan ini. Sebentar, mana senjata rahasiaku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140810,
						20140811
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140810,
					"content": "Ceritakan padaku tentang senjata ini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140812
					]
				},
				{
					"id": 20140812,
					"content": "*uhuk* Tidak lama setelah kamu ditunjuk sebagai Kapten Divisi Swordfish II. Aku bertemu dengan orang-orang misterius yang mengaku kalau mereka mendukung kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140813
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140813,
					"content": "Mereka memberiku ini dan bilang, asalkan aku punya niat untuk jadi lebih kuat, senjata rahasia ini akan merespon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140814
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140814,
					"content": "Haha ... *uhuk* Ini mirip dengan Vision, kan? Aku tidak pernah pakai Vision, jadi aku tidak tahu bedanya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140815
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140815,
					"content": "Ini ... Delusion.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140816
					]
				},
				{
					"id": 20140816,
					"content": "Delu ... sion? *uhuk* Ya ampun, kedengarannya bukan sesuatu yang baik ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140817
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140817,
					"content": "Kalau begitu ... apa bedanya Delusion dengan Vision?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140818
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140818,
					"content": "Delusion bisa memperpendek umur penggunanya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140819
					]
				},
				{
					"id": 20140819,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140820
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140820,
					"content": "Astaga ... Wajar sih, kalau benda yang tak jelas asal-usulnya seperti ini mengandung risiko.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140821
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140821,
					"content": "Beberapa hari terakhir ini, aku memang merasa semakin lama semakin lelah. Dan muncul ... perasaan aneh yang selalu menghantuiku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140822
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140822,
					"content": "Awalnya aku cuma merasa lebih capek dari biasanya setelah bertempur. Aku sama sekali tidak merasa curiga. Tapi waktu pulang hari ini, penglihatanku tiba-tiba jadi kabur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140823
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140823,
					"content": "Benar-benar memalukan ... Aku kira aku sudah hampir mengejarmu, haha ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140824
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140824,
					"content": "Aku memang ... tidak diberkahi oleh para dewa ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140825
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140825,
					"content": "....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140826
					]
				},
				{
					"id": 20140826,
					"content": "#{NICKNAME}, boleh aku minta tolong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140827
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140827,
					"content": "Kalau seragam kita sudah siap, tolong ambilkan punyaku ya ... dan bawakan ke sini, kita pakai sama-sama ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140828
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140828,
					"content": "Kenapa wajahmu begitu? Jangan khawatir, sobat. Kalau aku istirahat, aku pasti akan sehat kembali. Sehat kembali ... setelah istirahat sebentar ....",
					"roleType": "TALK_ROLE_NPC",
