			"dialogs": [
				{
					"id": 240070501,
					"content": "Coba kulihat .... Roda gigi ini bisa dipakai. Kalau bantalannya digergaji ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070502
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070502,
					"content": "Kamu cari ini buat apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240070503
					]
				},
				{
					"id": 240070503,
					"content": "Aku ingin membuat boneka roda gigi sendiri. Sebenarnya ... selama ini aku diam-diam sudah belajar caranya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070504
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070504,
					"content": "Kalau sudah tahu caranya, aku akan bikin mekanisme roda gigi yang lebih raksasa ... kejutan besar buat papa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070505
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070505,
					"content": "Aku baca banyak buku di ruangan ayah. Sudah bikin komponen dasar mengikuti petunjuk di buku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070506
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070506,
					"content": "Aku yakin bisa bikin mekanisme roda gigi kalau terus rajin belajar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070507
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070507,
					"content": "Tapi aku enggak bisa belajar di kota. Nanti ketahuan, terus gagal deh bikin kejutan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070508
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070508,
					"content": "Karena itu, tempat ini jadi markas rahasia penelitian mekanisme roda gigi Lovi, dan aku jadi asistennya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070509
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240070509,
					"content": "Kurangi bicaranya, asisten! Ayo mulai penelitiannya, hari ini kita harus bisa membuat lengan mekanik yang bisa bergerak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070510
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070510,
					"content": "Siap! Mulai penelitiannya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verut"
				}
			]
