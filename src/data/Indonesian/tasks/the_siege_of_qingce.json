					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411300402
					]
				},
				{
					"id": 411300402,
					"content": "Baiklah! Kalau begitu aku akan memanggil yang lain, lalu kita akan segera berangkat. Semakin cepat semakin bagus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300403
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300403,
					"content": "Kita akan berkumpul lagi di tempat ini setelah berhasil membereskan kemah monster-monster tersebut.",
					"roleType": "TALK_ROLE_NPC",
