			"dialogs": [
				{
					"id": 411300601,
					"content": "Bagaimana? Apakah kamu berhasil mengalahkannya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300602
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300602,
					"content": "Sudah beres.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411300603
					]
				},
				{
					"id": 411300603,
					"content": "Baguslah kalau begitu... Dengan begini kita bisa menghela napas lega.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300604
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300604,
					"content": "Terima kasih atas bantuanmu, Pengembara. Terimalah barang ini sebagai bentuk terima kasih kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300605
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300605,
					"content": "Tapi aku masih heran... Kenapa tiba-tiba bisa muncul banyak monster-monster aneh di sekitar Desa Qingce?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300606
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300606,
					"content": "Sudahlah, bagaimanapun juga aku harus segera melaporkan hal ini ke Bagian Urusan Sipil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300607
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300607,
					"content": "Semoga mereka bisa mengirimkan lebih banyak orang ke sini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinglun"
				}
			]
		}
