			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jinglun"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411300101,
					"content": "Pengembara! Di sini, di sini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300102
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300102,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411300103
					]
				},
				{
					"id": 411300103,
					"content": "Ini tentang Desa Qingce lagi. Bebatuan meteorit yang jatuh itu membuat musuh-musuh di sekitar sana menjadi lebih ganas. Mereka terus mengamuk di sekitar jalan besar, dan sekarang mereka hampir mengelilingi seluruh Desa Qingce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300106
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300106,
					"content": "Desa Qingce akan tetap aman selama kami berjaga di sini. Tapi barang-barang persediaan harus tetap datang dari luar sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300107
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300107,
					"content": "Dengan kondisi seperti sekarang, Bagian Urusan Sipil juga tidak bisa mengirimkan banyak orang untuk melindungi barang-barang itu... Bisa gawat kalau ada monster yang menyerang mereka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300108
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300108,
					"content": "Lalu aku dan beberapa rekanku memutuskan... Meskipun kita tidak bisa keluar terlalu jauh dari Desa Qingce, tapi kita masih bisa membereskan monster-monster yang ada di sekitar desa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300109
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300109,
					"content": "Dengan begini kita bisa membantu orang-orang yang mengantar persediaan. Tetapi menurut laporan, monster-monster yang ada di sekitar desa jumlahnya cukup banyak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300110
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300110,
					"content": "Kita butuh waktu yang cukup untuk membereskan semua kemah monster itu. Tapi kalau kita tidak cukup cepat, bisa-bisa terjadi sesuatu ke Desa Qingce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300111
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300111,
					"content": "Pengembara, maukah kamu membantu kami mengatasi sebagian monster itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinglun"
				}
			]
		},
		{
			"id": 4113002,
			"completionStepIds": [
				4113003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4113003",
							"2"
						],
						"stepId": 4113003,
						"stateName": "QUEST_STATE_UNFINISHED"
