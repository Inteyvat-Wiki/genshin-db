				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jinglun"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411300201,
					"content": "Tidak bisa... Kita butuh bala bantuan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300202
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300202,
					"content": "Monster-monster itu sudah kubereskan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411300203
					]
				},
				{
					"id": 411300203,
					"content": "Bagus, terima kasih. Tapi sesuatu yang tidak terduga baru saja terjadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300204
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300204,
					"content": "Tadinya aku berpikir bahwa monster-monster yang ada di sekeliling desa hanyalah monster biasa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300205
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300205,
					"content": "Aku baru saja memimpin sekumpulan orang untuk membereskan sebuah kemah monster, lalu aku sedang beristirahat sejenak sebelum melanjutkan lagi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300206
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300206,
					"content": "Tiba-tiba muncul seekor Stonehide Lawachurl dari hutan di sebelah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300207
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300207,
					"content": "Dia menyerang kita sebelum kita bisa bereaksi, sehingga ada banyak orang yang terluka... Kita hanya bisa mundur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300208
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300208,
					"content": "Monster itu terlalu bahaya untuk dibiarkan begitu saja, Tetapi grup lain yang pergi membereskan kemah monster lainnya belum juga kembali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300209
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300209,
					"content": "Pengembara, maukah kamu membantu kami melawan monster itu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300210,
						411300212
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300210,
					"content": "Serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411300211
					]
				},
				{
					"id": 411300211,
					"content": "Baiklah kalau begitu, aku minta maaf... Padahal ini seharusnya adalah tugas kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300212,
					"content": "Bagaimana kondisi orang yang terluka?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411300213
					]
				},
				{
					"id": 411300213,
					"content": "Untungnya mereka segera diobati sehingga tidak ada luka yang parah... Tapi mereka tidak dapat bergerak bebas untuk sementara waktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300214
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300214,
					"content": "Maka dari itu, hanya kamu yang bisa kumintai tolong, Pengembara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300215
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300215,
					"content": "Maafkan aku... seharusnya ini adalah tugas kami...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinglun"
				}
			]
		},
