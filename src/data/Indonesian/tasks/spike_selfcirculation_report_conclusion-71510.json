			"dialogs": [
				{
					"id": 715100101,
					"content": "Bagaimana? Sukses?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715100102,
						715100103
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715100102,
					"content": "Sukses dong.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715100104
					]
				},
				{
					"id": 715100104,
					"content": "Bagus, bagus. Pursina's Spike tidak bisa sekaligus menutup bukaan, tapi sekali berhasil saja sudah cukup, artinya tindakan lanjutan bisa dijalankan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715100105
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715100105,
					"content": "Artinya, tinggal menunggu waktu saja sampai bukaan itu tertutup seluruhnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715100106
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715100106,
					"content": "Dan masalah kita pun akhirnya selesai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715100107
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715100107,
					"content": "Aku harus catat ini semua. Mungkin saja kan aku bakal jadi orang berpengaruh di Akademi begitu jurnal mengenai Pursina's Spike rampung dan dikumpulkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715100108
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715100108,
					"content": "#Mungkin aku bisa ceritakan kisah ini di biografiku kelak: \"Eksperimen di Chasm Bersama {NICKNAME} Yang Luar Biasa Berbakat\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715100109
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715100109,
					"content": "Aku tunggu hari itu tiba.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715100110
					]
				},
				{
					"id": 715100110,
					"content": "Haha! Yah, aku kurang pandai mengarang cerita sih. Lebih bisa bikin jurnal dan laporan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715100111
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715100111,
					"content": "Kuharap kamu tidak keberatan kalau karyaku nanti kurang sempurna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715100103,
					"content": "Lumpurnya sudah hampir lenyap semua.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715100104
					]
				}
			]
		}
	]
