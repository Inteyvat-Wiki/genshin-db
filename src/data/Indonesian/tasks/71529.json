			"dialogs": [
				{
					"id": 716665101,
					"content": "Luar biasa, aku kalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665102
					],
					"speakerTitle": "\"Memang Gaya dan Berbahaya\""
				},
				{
					"id": 716665102,
					"content": "#Sebuah kehormatan bisa kalah dari seorang {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665103
					],
					"speakerTitle": "\"Memang Gaya dan Berbahaya\""
				},
				{
					"id": 716665103,
					"content": "Ahhh! Jadi begitu ya caranya! Aku mana kepikir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665104
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716665104,
					"content": "Yep, licik mesti dihajar pakai licik lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716665105,
					"content": "Kalau taktik gagal, ubah pola pikir. Ketika bertualang, kita sering dihadapkan pada situasi yang memaksa improvisasi kan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716665106,
					"content": "Masalahnya enggak akan kelar kalau kita ngotot pakai cara lama. Dicoba sampai mampus juga enggak bakal bisa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716665107,
					"content": "Kayaknya Shinobu pernah bilang hal yang sama ... berarti memang gitu ya aturannya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665108
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716665108,
					"content": "Ah, mikirnya nanti lagi lah. Sekarang main adu kumbang dulu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				}
			]
		},
