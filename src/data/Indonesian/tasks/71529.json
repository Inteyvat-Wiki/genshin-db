			},
			"dialogs": [
				{
					"id": 716665001,
					"content": "Ngaco, betulan ngaco ... Kok bisa sih kayak gitu?! Muka Tuan Besar ini ... harus dikemanain?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665002
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716665002,
					"content": "Sebuah kehormatan dapat bertanding denganmu, Tuan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665003
					],
					"speakerTitle": "\"Memang Gaya dan Berbahaya\""
				},
				{
					"id": 716665003,
					"content": "Ya ampun ... Sopan banget!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665004
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716665004,
					"content": "Haha! Bapak Gem{RUBY#[D]\"Raja Oni Pendekar Kumbang Sejati\"}bala, kalah melulu ya begitu ditinggal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716665005,
					"content": "Belum. Selama Raja Oni Pendekar Kumbang Sejati belum menyerah, dia belum kalah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665006
					],
					"speakerTitle": "\"Memang Gaya dan Berbahaya\""
				},
				{
					"id": 716665006,
					"content": "Pertarungan ibarat kehidupan, ada kalanya di atas, ada kalanya di bawah. Ketika di bawah, kita hanya akan terlindas jika menyerah untuk naik kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665007
					],
					"speakerTitle": "\"Memang Gaya dan Berbahaya\""
				},
				{
					"id": 716665007,
					"content": "Mangstab! Keren! Tuan Besar ini BELUM kalah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665008
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716665008,
					"content": "Tetapi terus-menerus membuat alasan juga tidak berguna. Jangan menghabiskan tenaga untuk membual, tapi gunakanlah itu untuk berusaha lebih keras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665009
					],
					"speakerTitle": "\"Memang Gaya dan Berbahaya\""
				},
				{
					"id": 716665009,
					"content": "Pret ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665010
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716665010,
					"content": "Raja Oni, musuh seperti dia bukan bagianmu. Aku sarankan kirim jenderal lain maju, dan pelajari pertempurannya dari pinggir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665011
					],
					"speakerTitle": "Grandmaster Hanakado"
				},
				{
					"id": 716665011,
					"content": "Menyaksikan pertandingan orang adalah latihan. Ada kemampuan yang dipelajari dengan praktik, ada pula yang dikuasai dari mengamati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665012
					],
					"speakerTitle": "Grandmaster Hanakado"
				},
				{
					"id": 716665012,
					"content": "Masuk akal, Grandmaster! Kebetulan sohibku juga datang. Tangan Kanan Raja Oni, maju!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665013
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716665013,
					"content": "#Haha, giliran kita nih! Jangan kasih kendor, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665014,
						716665015
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716665014,
					"content": "Hehe, gampang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716665016
					]
				},
				{
					"id": 716665016,
					"content": "#Jadi aku akan bertanding melawan {NICKNAME} yang legendaris? Aku harus hati-hati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"Memang Gaya dan Berbahaya\""
				},
				{
					"id": 716665015,
					"content": "Duh, ngeri ah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716665016
					]
				}
			]
		},
