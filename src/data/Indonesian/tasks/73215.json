			"dialogs": [
				{
					"id": 732150101,
					"content": "Halo teman Nara-ku! Um ... aku harusnya memberi tahu sesuatu ke kamu, tapi aku lupa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150102
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 732150102,
					"content": "Enggak masalah, bisa ketemu kalian lagi saja kami sudah senang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732150103,
					"content": "Oh, terima kasih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150104,
						732150106
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 732150104,
					"content": "Tentang \"Mawtiyima\" ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732150105
					]
				},
				{
					"id": 732150105,
					"content": "Dia tidak bicara apa-apa lagi, tapi dia baik-baik saja kok. Hutannya juga lagi di tahap pemulihan ... Terima kasih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 732150106,
					"content": "Tentang melupakan ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732150107
					]
				},
				{
					"id": 732150107,
					"content": "Melupakan ...? Oh, karena kekuatan Kusava sudah habis. Maka ingatannya juga akan mengalir. Setetes demi setetes seperti embun ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranaga"
				}
			]
		},
