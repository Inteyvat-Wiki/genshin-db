			"dialogs": [
				{
					"id": 732150201,
					"content": "Halo, halo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150202
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 732150202,
					"content": "Hai kecil! Masih ingat kami tidak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732150203,
					"content": "Dasar kamu Putih Melayang! Siapa yang kamu sebut dengan si kecil! Kamu masih ingat tidak lagu yang aku ajarkan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150204
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 732150204,
					"content": "Tentu saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732150205
					]
				},
				{
					"id": 732150205,
					"content": "Baguslah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150206
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 732150206,
					"content": "Kalau gitu janji ya walaupun misal aku lupa ... kamu harus tetap ingat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranakin"
				}
			]
		},
