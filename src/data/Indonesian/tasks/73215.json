					"nextDialogs": [
						732150604
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 732150604,
					"content": "Apa ini karena Kusava?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732150605
					]
				},
				{
					"id": 732150605,
					"content": "Iya ... Aranaga harusnya pernah bilang ke kalian. Kekuatan ada di dalam ingatan, jadi kalau tidak ada ingatan ya tidak ada kekuatannya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150606
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 732150606,
					"content": "Jadi ... Harusnya sih kita sudah pernah mengalami sesuatu bersama di masa lalu, tapi kita tidak ingat lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150607
					],
					"speakerTitle": "Aragaru"
				},
