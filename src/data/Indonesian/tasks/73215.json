				{
					"id": 732150601,
					"content": "Nara Emas dan Putih Melayang! Kalian ada di sini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150602
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 732150602,
					"content": "Iya! Kami datang ke sini nih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732150603,
					"content": "Hehehe ... Aku mungkin lupa banyak hal, tolong ingatkan aku lagi ya ....",
