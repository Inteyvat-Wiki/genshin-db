			"dialogs": [
				{
					"id": 732150501,
					"content": "Halo! Nara Emas! Dan kamu pasti Putih Melayang yang mungil itu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150502
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 732150502,
					"content": "Huh, Paimon enggak mungil! Ngaca dong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732150503,
					"content": "Hei, aku juga tidak mungil! Oh iya, kalian ngapain datang ke sini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150504
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 732150504,
					"content": "Cuma mau berkunjung saja lihat kalian.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732150505
					]
				},
				{
					"id": 732150505,
					"content": "Iya, kita kan dulu mengalahkan banyak hal jahat, terus nyanyi bersama, bahkan berhasil menyelamatkan \"Moo-yo\" ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732150506,
					"content": "Mawtiyima!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150507
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 732150507,
					"content": "Iya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732150508,
					"content": "Oh ... Maaf ya ... Yang kalian katakan itu pasti benar tapi sayang aku tidak ingat ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150509
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 732150509,
					"content": "Um ...! I-Iya deh enggak apa-apa! Jangan sedih gitu dong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732150510,
					"content": "(Dia benar-benar lupa ....)",
