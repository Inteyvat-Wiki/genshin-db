			},
			"dialogs": [
				{
					"id": 722160101,
					"content": "Kamu sudah datang. Manusia batu itu bilang kalau dia sudah hampir selesai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160102
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160102,
					"content": "Ikutlah dengan diriku. Manusia batu itu ada di sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
		},
		{
			"id": 7221602,
			"completionStepIds": [
				7221602
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7221602",
							"2"
						],
						"stepId": 7221602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ooshima Junpei",
					"Neko",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722160201,
					"content": "Fiuh, sudah hampir selesai. Ternyata ini pekerjaan besar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160202
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722160202,
					"content": "Oh, kalian datang... dan Nona Pendeta juga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160203
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722160203,
					"content": "Bagaimana? Apa sudah selesai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160204
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160204,
					"content": "Sudah, seperti yang bisa kamu lihat, hehe! Sebagai upacara peresmian, aku meninggalkan beberapa bagian yang belum dipahat sambil menunggu kedatangan Nona Pendeta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160205
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722160205,
					"content": "Perhatian sekali kamu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160206
					]
				},
				{
					"id": 722160206,
					"content": "Hehe, tentu saja. Patung kuil sudah seharusnya diperlakukan dengan penuh hormat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160207
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722160207,
					"content": "Miaw miaw, memangnya tindakan mengetuk batu itu sangat penting?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160208
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160208,
					"content": "Yah, bagaimana menjelaskannya ya... Biasanya benda yang dibuat menjadi patung pasti benda yang penting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160209
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722160209,
					"content": "Hei, Paimon... Mungkin kamu bisa membuat patung makanan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160210
					]
				},
				{
					"id": 722160210,
					"content": "Hei! Tidak sopan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722160211,
					"content": "Jadi... kamu membuat patung untuk benda-benda bagus, benar begitu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160212
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160212,
					"content": "Hahaha! Yah, menurutku bahkan lebih dari sekadar bagus! Karena patung bisa disebut juga \"pengingat yang abadi\", hahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160213
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722160213,
					"content": "Bukan, bukan, ini bukan sebuah \"pengingat yang abadi\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160214
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160214,
					"content": "Diriku hanya berharap Hibiki bisa melihat patung ini kalau dia pulang dan tidak menemukan jalan ke sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160215
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160215,
					"content": "Dengan begitu, dia akan tahu harus ke mana dan tidak tersesat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160216
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160216,
					"content": "O-Oh, jadi begitu. Nona Pendeta, kamu sangat peduli dengan \"Hibiki\" ini ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160217
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722160217,
					"content": "Neko...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160218
					]
				},
				{
					"id": 722160218,
					"content": "Hibiki bisa saja kembali kapan pun. Lagi pula, dia dan Domeki bilang akan ada suatu hal bagus yang terjadi setelah batunya selesai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160219
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160219,
					"content": "Baiklah kalau begitu, manusia batu. Apa ada hal lain yang perlu diriku lakukan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160220
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160220,
					"content": "Yah, tidak sih ... Karena kamu sudah di sini, aku bisa memahat bagian terakhirnya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160221
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722160221,
					"content": "Tiga... dua... satu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160222
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722160222,
					"content": "Ke-Kenapa awannya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160223,
						722160224
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722160223,
					"content": "Berubah jadi bentuk kucing...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160225
					]
				},
				{
					"id": 722160225,
					"content": "Itu Hibiki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160226
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160226,
					"content": "Eh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160227
					]
				},
				{
					"id": 722160227,
					"content": "Hibiki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160228
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722160228,
					"content": "Miaw miaw miaw! Pasti itu Hibiki! Benar-benar terjadi hal bagus, seperti katanya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160229
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160229,
					"content": "Sama seperti katanya, yang dia katakan pada diriku! Hal bagus pasti akan terjadi saat batu itu selesai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160230
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160230,
					"content": "Hebat, ini bagus sekali! Yang dia katakan benar-benar terjadi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160231
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160231,
					"content": "Ya, dia pasti akan kembali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160232
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160232,
					"content": "Hoo... Horeee! Hahaha, aku tidak tahu apa yang sebenarnya terjadi, tapi melihat Nona Pendeta sesenang itu, pasti ini hal yang bagus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160233
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722160233,
					"content": "Neko...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160234
					]
				},
				{
					"id": 722160234,
					"content": "Dengan bantuanmu, kuilnya sudah jadi indah kembali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160235
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160235,
					"content": "Kotak Uang-nya sudah diperbaiki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160236
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160236,
					"content": "Rak Kayu Doa-nya juga sudah diperbaiki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160237
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160237,
					"content": "Batunya juga sudah selesai! Sekarang, Hibiki pasti akan kembali, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160238
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160238,
					"content": "Lalu Domeki, Janome, dan semua teman Hibiki juga! Semua pasti akan kembali bersamanya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160239
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160239,
					"content": "Kamu... dirimu adalah orang baik! Lebih baik dari makanan itu! Hibiki pasti menyukaimu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160240
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160240,
					"content": "Diriku akan memanggil semua anak-anak itu berkumpul dan merencanakan penyambutan Hibiki. Dan ... ya tentu saja, tentu saja, juga untuk menyambut orang-orang yang akan datang ke sini. Diriku harus memberikan perintah tentang itu juga ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160241
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160241,
					"content": "Tapi sebelum itu, diriku masih harus mengurus banyak hal lainnya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160242
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160242,
					"content": "Oh, Hibiki... miaw miaw, miaw! Baguslah, bagus sekali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160224,
					"content": "Sebenarnya apa yang terjadi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160225
					]
				}
			]
		},
		{
			"id": 7221603,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7221602",
							"3"
						],
						"stepId": 7221602,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ooshima Junpei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722160301,
					"content": "Haha, Nona Pendeta senang sekali. Dia pasti menganggap orang bernama Hibiki ini sangat penting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160302
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722160302,
					"content": "Masalahnya ... kita tidak tahu dia ada di mana ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7221604,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7221602",
							"3"
						],
						"stepId": 7221602,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Etsuko",
					"Taisuke"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722160401,
					"content": "Benar, nama \"Hibiki\", \"Kuil Asase\", dan \"Domeki\" ... nama-nama ini cukup membingungkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160402,
						722160407
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160402,
					"content": "Kalian berdua muncul dari mana?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160403
					]
				},
				{
					"id": 722160403,
					"content": "Yah, kalian semua membuat keributan besar, tentu saja kita datang ke sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160404
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160404,
					"content": "Tapi, sepertinya ada sesuatu yang harus kalian tahu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160405
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160405,
					"content": "Taisuke, silakan jelaskan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160406
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160406,
					"content": "Ah, tentu saja, Nona Etsuko. Jadi aku akan menjelaskan sesuatu tentang ... Pulau Seirai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160408
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722160408,
					"content": "Sejarah tentang tempat ini sangat tidak jelas, dan meski Adventurers' Guild sudah berusaha mencari informasi tentang pulau ini, kami tidak menemukan banyak hal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160409
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722160409,
					"content": "Menurut informasi yang kita dapatkan, ini adalah tempat berkumpul para bajak laut ratusan tahun lalu. Lalu, Shogunate-lah yang mengusir semua bajak laut itu dan memindahkan penduduk pulau ini ke tempat lain...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160410
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722160410,
					"content": "Kalau tebakanku tepat, \"Domeki\" yang sedang kita bicarakan adalah \"Ako Domeki\", sang pemimpin bajak laut. Dia juga yang bertarung melawan Shogunate secara langsung. Namanya tertulis jelas di catatan sejarah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160411
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722160411,
					"content": "Menurut catatan tersebut, Ako Domeki ini memimpin kru bajak lautnya melawan Shogunate dalam pertempuran di laut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160412
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722160412,
					"content": "Tapi mereka dengan cepat dikalahkan dan harus kabur dari Pulau Seirai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160413
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722160413,
					"content": "Tapi saat pasukan Shogunate mengejar mereka, tiba-tiba ada badai petir yang menyelimuti Pulau Seirai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160414
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722160414,
					"content": "Kru Ako Domeki dan pasukan Shogunate terjebak dalam badai tersebut... lalu hilang tanpa jejak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160415
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722160415,
					"content": "Muncul badai...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160416
					]
				},
				{
					"id": 722160416,
					"content": "Biar kuteruskan dari sini. Misteri terbesar di sini tentu saja munculnya badai tersebut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160417
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160417,
					"content": "Meskipun kru Ako Domeki hampir tersapu bersih oleh badai itu, tapi pasukan yang dikirim Shogunate juga hampir tak bersisa. Yang masih bertahan terpaksa kabur ke Pulau Narukami. Tentu butuh waktu cukup lama untuk memulihkan pasukannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160418
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160418,
					"content": "Jadi waktu kemunculan badai itu sangat pas sekali. Rasanya seperti... ada yang mengendalikannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160419
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160419,
					"content": "Aku yakin kamu masih ingat Batu Penangkal di pulau ini. Batu-batu itu dibuka dengan sengaja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160420
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160420,
					"content": "Dan setelah kita menyegelnya sekali lagi, badai di pulau ini langsung reda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160421
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160421,
					"content": "Aku tidak mau mengambil kesimpulan dulu, tapi instingku mengatakan kalau kedua kejadian ini berhubungan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160422
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160422,
					"content": "Yah, kita bisa tanya ke Nona Neko...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160423
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722160423,
					"content": "Menurutku lupakan sajalah. Di catatannya tertulis kalau Domeki hilang tanpa jejak. Ditulisnya sih begitu, tapi kalau dia terkena badai itu, mungkin dia sudah ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160424
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160424,
					"content": "Kita akan terus menjelajahi pulau ini dan mengumpulkan informasi lain tentang kejadian ini, lalu kita akan melapor kembali ke Adventurers' Guild.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160425
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160425,
					"content": "Hehe, mungkin suatu hari kita akan bekerja sama lagi. Siapa tahu, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160426
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160426,
					"content": "Akan kunantikan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160427
					]
				},
				{
					"id": 722160427,
					"content": "Kami juga menantikannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160428
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160428,
					"content": "Yah, Taisuke, ayo kita siap-siap. Kita harus lanjut menjelajah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160429
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160429,
					"content": "Eh, jadi Nona Etsuko, tentang Nona Neko ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160430
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722160430,
					"content": "Tentu saja kamu tetap bisa berinteraksi dengan kucing itu seperti biasanya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160431
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160431,
					"content": "Yang penting kamu ingat untuk tidak mengatakan hal yang tidak seharusnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160432
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160432,
					"content": "Dia... sepertinya sedang sangat senang sekarang. Kamu jangan sampai membuatnya sedih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160433
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160433,
					"content": "Aku tahu kok. Haha, Nona Etsuko, kamu ini benar-benar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160434
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722160434,
					"content": "... Aku hanya berusaha menyelesaikan tugas kita dengan lebih efisien. Ayo, kita harus mulai kerja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160435
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160435,
					"content": "Pulau Seirai... Sepertinya tempat ini masih penuh dengan misteri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160407,
					"content": "Kamu tahu sesuatu tentang pulau ini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160408
					]
				}
			]
		}
	]
}