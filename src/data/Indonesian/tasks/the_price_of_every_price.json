			"dialogs": [
				{
					"id": 401960101,
					"content": "Halo semuanya! Kami enggak terlambat, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960102,
					"content": "Tidak, kalian datang tepat waktu. Sudah cukup istirahat, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960103
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 401960103,
					"content": "Tetap sibuk membuatmu tetap waspada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960104
					]
				},
				{
					"id": 401960104,
					"content": "Memang sih, cara yang bagus untuk tetap semangat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960105
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960105,
					"content": "Apa kalian semua sudah mulai bersiap-siap?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960106
					]
				},
				{
					"id": 401960106,
					"content": "Kemarin kami menerima kabar dari Tuan Argenteau yang mengonfirmasi waktu dan lokasi transaksi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960107
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960107,
					"content": "Transaksi itu akan berlangsung sore ini. Dan ternyata lokasinya adalah tempat yang sudah sangat kita kenal — restoran Film Fantasyland.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960108
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960108,
					"content": "Oh ya? Dia suka banget sih sama tempat itu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960109,
					"content": "Tapi ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960110
					]
				},
				{
					"id": 401960110,
					"content": "#Sepertinya kita punya kekhawatiran yang sama, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960111
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960111,
					"content": "Benar. Menangkap seseorang di tempat acara yang ramai akan jauh lebih menantang dibandingkan di area terbuka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960112
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 401960112,
					"content": "Penjahat tersebut mungkin akan mencoba membaur dengan keramaian, atau bahkan melarikan diri dengan menyandera orang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960113
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 401960113,
					"content": "Mengingat hal ini, kita harus melakukan persiapan tambahan. Begitu kami menerima kabar kemarin, kami langsung berkoordinasi dengan Marechaussee Phantom dan Pasukan Patroli Khusus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960114
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 401960114,
					"content": "Mm-hmm. Kita akan mengerahkan banyak agen rahasia di lokasi. Jika situasi memburuk, keselamatan warga sipil akan menjadi prioritas utama kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960115
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960115,
					"content": "Tentu saja, semoga semuanya berjalan lancar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960116
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960116,
					"content": "Kulihat ada banyak wajah yang kukenal dari kasus sebelumnya, seperti Kapten Chevreuse dari Pasukan Patroli Khusus. Jadi aku optimis saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960117
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960117,
					"content": "Kalau begitu, kami percaya instingmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960118
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960118,
					"content": "Oh ya, dan ngomong-ngomong, kami juga sudah berkomunikasi dengan Nona Lepine-Pauline dan Nona Navia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960119
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960119,
					"content": "Spina di Rosula akan memberikan dukungan dalam lingkup yang terkendali, jadi tidak perlu khawatir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960120
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 401960120,
					"content": "Satu-satunya masalah ... mungkin Nona Escoffier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960121,
						401960123
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960121,
					"content": "Dia tidak mau melayani penjahat?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960122
					]
				},
				{
					"id": 401960123,
					"content": "Dia ingin memperkenalkan mereka ke talenan miliknya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960124
					]
				},
				{
					"id": 401960122,
					"content": "Ha, akan mudah jika sesederhana itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960125
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960124,
					"content": "Sepertinya itu bukan ide yang buruk ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960125
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960125,
					"content": "Ehem ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960126
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 401960126,
					"content": "Baiklah, cukup bercandanya. Nona Escoffier sudah menegaskan bahwa dia tidak sudi restorannya rugi akibat operasi ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960127
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960127,
					"content": "Tapi, eh ... Haha, firasatku bilang kalau semuanya tidak akan berjalan semulus yang dia harapkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960128
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960128,
					"content": "Apa ada yang bisa kubantu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960129
					]
				},
				{
					"id": 401960129,
					"content": "Sejujurnya, seharusnya kami tidak melibatkanmu sejak awal, dan hal ini sudah cukup merepotkan. Pihak berwenang Fontaine seharusnya bisa menangani sisanya mulai dari sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960130
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960130,
					"content": "Tapi aku yakin kamu ingin tahu bagaimana akhir dari semua ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960131
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960131,
					"content": "Tentu saja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960132
					]
				},
				{
					"id": 401960132,
					"content": "Baiklah kalau begitu, silakan pergi ke lokasi, tapi tetap waspada dan sesuaikan dengan situasi. Kamu tidak perlu melakukan apa-apa — kecuali tentunya kalau keadaan jadi kacau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960133
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960133,
					"content": "Aku akan berusaha sebaik mungkin agar situasi tidak memburuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960134
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960134,
					"content": "Kamu juga ikut terlibat, Kinich?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960135
					]
				},
				{
					"id": 401960135,
					"content": "Tentu saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960136
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960136,
					"content": "Masih banyak pertanyaan yang belum terjawab, tapi berdasarkan informasi yang kita dapat sejauh ini, pelakunya berasal dari Natlan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960137
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960137,
					"content": "Lagi pula, aku sudah menjadi saksi dalam kasus ini. Sebaiknya aku menyelesaikan masalah ini sampai tuntas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960138
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960138,
					"content": "Hehe, nah itu baru Kinich yang kita kenal dan sayang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960139,
					"content": "Kelompok tersebut melanjutkan diskusi mengenai detail operasi dan hal-hal yang perlu diperhatikan.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401960140
					]
				},
				{
					"id": 401960142,
					"content": "Baiklah, sudah cukup basa-basinya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960143
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960143,
					"content": "Operasinya dijadwalkan sore ini. Kalau kita cukup cepat, kita bahkan masih punya waktu untuk minum beberapa cangkir teh sebelum berangkat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960144
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960144,
					"content": "#Oh, ayo kita cari sesuatu buat dimakan juga, {NICKNAME}! Kalau perut kosong enggak mungkin bisa kerja loh ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960145,
					"content": "Kamu biasa cuma jadi penonton, kan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960146
					]
				},
				{
					"id": 401960146,
					"content": "Paimon merhatiin kamu! Itu kerjaan yang penting banget loh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960147
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960147,
					"content": "Baiklah, aku akan pergi ke tempat acara sekarang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960148
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960148,
					"content": "Ajaw sudah berhari-hari mengoceh tentang hidangan khusus acara yang ingin dicobanya. Kurasa aku harus membungkamnya sebelum terlambat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960149
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960149,
					"content": "Sampai ketemu nanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960150
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960150,
					"content": "Aku tidak sabar mendengar bagaimana semuanya berjalan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neuvillette"
				}
			]
		},
