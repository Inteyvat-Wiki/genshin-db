			"dialogs": [
				{
					"id": 401960301,
					"content": "#{NICKNAME}, Kinich, akhirnya kalian kembali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960302,
					"content": "Tadi kami lihat Chevreuse bawa si penjahatnya pergi. Dia kelihatan senang dan puas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960303,
						401960304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960303,
					"content": "Yah, semuanya berjalan lebih mulus dari yang diperkirakan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960305
					]
				},
				{
					"id": 401960305,
					"content": "Kita sudah bersusah payah, tapi ternyata cuma orang yang tidak bisa bertarung, dan cuma bisa lari!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960306,
					"content": "Wriothesley bilang, dia sudah pergi ke Palais Mermonia buat ngelaporin hasilnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960307,
					"content": "Kelihatannya, Marechaussee Phantom lagi siap-siap melakukan penyelidikan mendalam terhadap aktivitas perjudian ilegal. Kedengarannya mereka bakal kewalahan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960308,
					"content": "Tapi yah, itu kan kerjaannya Palais. Bukan urusan kita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960309,
					"content": "Melihat betapa cepatnya Yang Mulia pergi, kutebak sepertinya dia menghindari Kamera-ku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960310
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401960310,
					"content": "*huff* Tapi sepertinya sekarang aku jadi sudah terbiasa dengan hal itu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960311
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401960311,
					"content": "Hei, Charlotte masa sih nyerah gitu saja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960312,
					"content": "Hehe, tidak apa-apa — aku sudah dapat banyak foto bagus di sana. Lebih dari cukup untuk jadi berita utama!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960313
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401960313,
					"content": "Kalau begitu, reporter yang sibuk ini harus segera pergi. Foto-foto ini tidak akan bisa jadi dengan sendirinya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960314
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401960314,
					"content": "Pilih sudut yang paling keren buat Paimon ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960315,
					"content": "Ah, larinya cepat sekali ... mudah-mudahan dia masih dengar yang barusan ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960316,
					"content": "Kamu percayakan saja pada fotografer profesional, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960317
					]
				},
				{
					"id": 401960317,
					"content": "Hehe, benar juga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960318,
					"content": "Tapi apa yang bikin kalian semua lama sekali sampai di sini? Ada kejadian apa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960319,
						401960324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960319,
					"content": "Ajaw membenturkan kepalanya dan mulai menangis.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960320
					]
				},
				{
					"id": 401960320,
					"content": "Apa?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960321
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 401960321,
					"content": "Rumor dan fitnah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960322
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 401960322,
					"content": "Kapan aku — Yang Mulia Raja Naga, K'uhul Ajaw, pernah merengek begitu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960323
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 401960323,
					"content": "Kalau mau tahu, sering sih sebenarnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960329
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960329,
					"content": "Ngomong-ngomong, apa rencana selanjutnya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960330
					]
				},
				{
					"id": 401960330,
					"content": "Hmm ... sejujurnya, aku belum memutuskan sih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960331
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960331,
					"content": "Aku tidak punya urusan mendesak, tapi pengadilan mungkin masih membutuhkanku untuk jadi saksi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960332
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960332,
					"content": "Pistol itu masih menjadi barang bukti penting, jadi mungkin aku harus menunggu sampai kasus ini selesai sebelum bisa mengembalikannya ke Natlan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960333
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960333,
					"content": "Sepertinya aku akan tinggal di sini sebentar lagi untuk menikmati pantainya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960324,
					"content": "Kinich membenturkan kepalanya dan mulai menangis.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960325
					]
				},
				{
					"id": 401960325,
					"content": "Kuiyakan saja deh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960326
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960326,
					"content": "Hahaha! Kinich yang malang! Tidak ada yang menepuk kepalanya, jadi dia pergi menangis sendirian ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960327
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 401960327,
					"content": "Ah, masa sih? Paimon rasa Ajaw yang lebih mungkin nangis ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960328
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960328,
					"content": "Hei, kecil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960329
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 401960304,
					"content": "Lawan kita cukup lemah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960305
					]
				}
			]
		}
	]
